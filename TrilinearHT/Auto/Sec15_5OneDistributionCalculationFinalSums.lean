  have he0 : 0 < e := by rw [he]; linarith
  have he1 : e ≤ 1 := by rw [he]; linarith
  have hσ2 : 0 < σ 2 := hσ3.trans_le h23
  have hσ1 : 0 < σ 1 := hσ2.trans_le h12
  have hσ0 : 0 < σ 0 := hσ1.trans_le h01
  have hσpos : ∀ i, 0 < σ i := fun i => by fin_cases i <;> assumption
  have hσge : ∀ i, σ 3 ≤ σ i := fun i => by
    fin_cases i
    · exact h23.trans (h12.trans h01)
    · exact h23.trans h12
    · exact h23
    · exact le_rfl
