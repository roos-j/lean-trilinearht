      rcases le_total (1 : ℝ) n with h | h
      · calc (1 + n : ℝ) ^ C ≤ (2 * n) ^ C := by gcongr; linarith
          _ = 2 ^ C * (n : ℝ) ^ C := by rw [mul_pow]
          _ ≤ 2 ^ C * ((n : ℝ) ^ C + 1) := by gcongr; linarith
      · calc (1 + n : ℝ) ^ C ≤ 2 ^ C := by
