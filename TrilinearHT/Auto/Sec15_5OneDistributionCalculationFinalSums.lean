open Classical in
/-- Blueprint `eq:core-final` (lines 2810-2816): if the core quantity `C_I` of each cell is at most
the sum of its nonnegative principal quantities `q_{I,c}` over finitely many configurations, and
the powered principal quantities have path sums at most `M_p` at every point (the band sums and the
per-path count estimates), then
`Σ_I |I| min(η, C_I) ≤ η^{1-p} M_p |R|` (subadditivity of `x^p`, `eq:min-power`, `eq:path`). -/
theorem core_final_bound (G : RealDyadicGrid) (root : ℤ × ℤ) (S : Finset (ℤ × ℤ))
    (hS : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G root.1 root.2)
    {κ : Type*} (Cf : ℤ × ℤ → Finset κ) (q : ℤ × ℤ → κ → ℝ) (hq : ∀ I c, 0 ≤ q I c)
    (CI : ℤ × ℤ → ℝ) (hCI : ∀ I ∈ S, CI I ≤ ∑ c ∈ Cf I, q I c) {η p Mp : ℝ} (hη : 0 ≤ η)
    (hp0 : 0 < p) (hp1 : p ≤ 1)
    (hpath : ∀ y, ∑ I ∈ S with y ∈ dyadicGridCell G I.1 I.2, ∑ c ∈ Cf I, q I c ^ p ≤ Mp) :
    ∑ I ∈ S, dyadicGridLength G I.1 * min η (CI I) ≤
      η ^ (1 - p) * (dyadicGridLength G root.1 * Mp) := by
  have hcell : ∀ I ∈ S, dyadicGridLength G I.1 * min η (CI I) ≤
      η ^ (1 - p) * (dyadicGridLength G I.1 * ∑ c ∈ Cf I, q I c ^ p) := by
    intro I hI
    have hr := (dyadicGridLength_pos G I.1).le
    have h1 : min η (CI I) ≤ min η (∑ c ∈ Cf I, q I c) := min_le_min_left η (hCI I hI)
    have h2 := min_sum_le_rpow (Cf I) (q I) (fun c _ => hq I c) hη hp0 hp1
    calc dyadicGridLength G I.1 * min η (CI I)
        ≤ dyadicGridLength G I.1 * (η ^ (1 - p) * ∑ c ∈ Cf I, q I c ^ p) :=
          mul_le_mul_of_nonneg_left (h1.trans h2) hr
      _ = _ := by ring
  have hpath' := cells_sum_le_of_path G root S hS
    (f := fun I => ∑ c ∈ Cf I, q I c ^ p)
    (fun I => Finset.sum_nonneg fun c _ => Real.rpow_nonneg (hq I c) p) hpath
  calc ∑ I ∈ S, dyadicGridLength G I.1 * min η (CI I)
      ≤ ∑ I ∈ S, η ^ (1 - p) * (dyadicGridLength G I.1 * ∑ c ∈ Cf I, q I c ^ p) :=
        Finset.sum_le_sum hcell
    _ = η ^ (1 - p) * ∑ I ∈ S, dyadicGridLength G I.1 * ∑ c ∈ Cf I, q I c ^ p := by
        rw [Finset.mul_sum]
    _ ≤ η ^ (1 - p) * (dyadicGridLength G root.1 * Mp) :=
        mul_le_mul_of_nonneg_left hpath' (Real.rpow_nonneg hη _)

