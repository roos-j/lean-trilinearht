      ε * (K * t₀ ^ (c - ε) / (c - ε) + A * t₀ ^ (-ε) / ε) := by
        rw [← hv1, ← hv2]; gcongr
    _ = c / (c - ε) * (A * t₀ ^ (-ε)) := by
