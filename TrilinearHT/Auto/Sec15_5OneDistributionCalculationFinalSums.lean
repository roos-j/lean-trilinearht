open Classical in
/-- Blueprint lines 2777-2799 for one band (fixed final height, role types, ordered amplitude
bins `σ₀ ≥ σ₁ ≥ σ₂ ≥ σ₃ > 0` and frequency bands): if in every group the tuple counts `N_s^G`
satisfy `eq:total-count` for the two largest-amplitude roles and `eq:applied-sparse`, with
`M'_G ≤ Σ_i M_i^G` and path bounds `Σ_G M_i^G ≤ K σ_i^{-2}`, then the powered principal quantities
`(Q Π_i σ_i N_s^G)^p`, `p = 1 - c/4`, `c = 1/300`, summed over the groups and scales are at most
`Q^p (16/3) L₀^{3/4} B^{1/4} K^{2-c/2}`. -/
theorem core_band_bound {κ σ : Type*} (Gs : Finset κ) (Ss : κ → Finset σ) (N : κ → σ → ℝ)
    (M : Fin 4 → κ → ℝ) (Mx : κ → ℝ) {σa : Fin 4 → ℝ} {L0 Bc K Q : ℝ} (hL0 : 0 < L0)
    (hBc : 0 < Bc) (hK : 0 ≤ K) (hQ : 0 ≤ Q) (hσ3 : 0 < σa 3) (h23 : σa 3 ≤ σa 2)
    (h12 : σa 2 ≤ σa 1) (h01 : σa 1 ≤ σa 0) (hM0 : ∀ i, ∀ G ∈ Gs, 0 ≤ M i G)
    (hMx : ∀ G ∈ Gs, 0 < Mx G ∧ Mx G ≤ ∑ i, M i G)
    (hN0 : ∀ G ∈ Gs, ∀ s ∈ Ss G, 0 ≤ N G s) (hNM : ∀ G ∈ Gs, ∀ s ∈ Ss G, N G s ≤ Mx G ^ 2)
    (htot : ∀ G ∈ Gs, ∑ s ∈ Ss G, N G s ≤ L0 * M 0 G * M 1 G)
    (hpos : ∀ G ∈ Gs, 0 < L0 * M 0 G * M 1 G)
    (hsparse : ∀ G ∈ Gs, ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ (Ss G).filter (fun s => N G s ≤ δ * Mx G ^ 2), N G s ≤
        Bc * δ ^ (1 / 300 : ℝ) * Mx G ^ 2)
    (hsum : ∀ i, ∑ G ∈ Gs, M i G ≤ K * σa i ^ (-2 : ℝ)) :
    ∑ G ∈ Gs, ∑ s ∈ Ss G, (Q * (∏ i, σa i) * N G s) ^ (1 - (1 / 300 : ℝ) / 4) ≤
      Q ^ (1 - (1 / 300 : ℝ) / 4) * (16 / 3 * L0 ^ (3 / 4 : ℝ) * Bc ^ (1 / 4 : ℝ) *
        K ^ (2 - (1 / 300 : ℝ) / 2)) := by
  set c : ℝ := 1 / 300
  set p : ℝ := 1 - c / 4
  have hσpos : ∀ i, 0 < σa i := by
    intro i; fin_cases i
    · exact hσ3.trans_le (h23.trans (h12.trans h01))
    · exact hσ3.trans_le (h23.trans h12)
    · exact hσ3.trans_le h23
    · exact hσ3
  have hPi : 0 ≤ ∏ i, σa i := Finset.prod_nonneg fun i _ => (hσpos i).le
  -- powered counts per group
  have hPG : ∀ G ∈ Gs, ∑ s ∈ Ss G, N G s ^ p ≤ 4 / 3 * (L0 * M 0 G * M 1 G) ^ (3 / 4 : ℝ) *
      Bc ^ (1 / 4 : ℝ) * Mx G ^ ((1 - c) / 2) := fun G hG =>
    powered_count (Ss G) (N G) (hMx G hG).1 (hN0 G hG) (hNM G hG) (htot G hG) (hpos G hG) hBc
      (hsparse G hG) (by norm_num) (by norm_num)
  have hcg := core_count_groups Gs (fun G => ∑ s ∈ Ss G, N G s ^ p) M Mx (c := c) (by norm_num)
    (by norm_num) hL0.le hBc.le hK hσ3 h23 h12 h01 hM0 (fun G hG => ⟨(hMx G hG).1.le,
      (hMx G hG).2⟩) hPG hsum
  -- factor the powers
  have hfac : ∀ G ∈ Gs, ∀ s ∈ Ss G, (Q * (∏ i, σa i) * N G s) ^ p =
      Q ^ p * ((∏ i, σa i) ^ p * N G s ^ p) := by
    intro G hG s hs
    rw [Real.mul_rpow (mul_nonneg hQ hPi) (hN0 G hG s hs), Real.mul_rpow hQ hPi]
    ring
  calc ∑ G ∈ Gs, ∑ s ∈ Ss G, (Q * (∏ i, σa i) * N G s) ^ p =
      Q ^ p * ((∑ G ∈ Gs, ∑ s ∈ Ss G, N G s ^ p) * (∏ i, σa i) ^ p) := by
        rw [Finset.sum_congr rfl fun G hG => Finset.sum_congr rfl fun s hs => hfac G hG s hs]
        simp only [Finset.mul_sum, Finset.sum_mul]
        exact Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun s _ => by ring
    _ ≤ Q ^ p * (16 / 3 * L0 ^ (3 / 4 : ℝ) * Bc ^ (1 / 4 : ℝ) * K ^ (2 - c / 2)) :=
        mul_le_mul_of_nonneg_left hcg (Real.rpow_nonneg hQ _)

open Classical in
/-- Blueprint `eq:core-final` with the separated absolute numerical errors (lines 2766-2816):
if each cell quantity is at most a sum of nonnegative principal quantities plus an absolute error,
and the powered principal quantities have path sums at most `M_p`, then
`Σ_I |I| min(η, C_I) ≤ η^{1-p} M_p |R| + Σ_I |I| err_I` (`eq:min-subadd` for the errors, then
`core_final_bound`). -/
theorem core_final_with_errors (G : RealDyadicGrid) (root : ℤ × ℤ) (S : Finset (ℤ × ℤ))
    (hS : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G root.1 root.2)
    {κ : Type*} (Cf : ℤ × ℤ → Finset κ) (q : ℤ × ℤ → κ → ℝ) (hq : ∀ I c, 0 ≤ q I c)
    (CI err : ℤ × ℤ → ℝ) (herr : ∀ I ∈ S, 0 ≤ err I)
    (hCI : ∀ I ∈ S, CI I ≤ ∑ c ∈ Cf I, q I c + err I) {η p Mp : ℝ} (hη : 0 ≤ η)
    (hp0 : 0 < p) (hp1 : p ≤ 1)
    (hpath : ∀ y, ∑ I ∈ S with y ∈ dyadicGridCell G I.1 I.2, ∑ c ∈ Cf I, q I c ^ p ≤ Mp) :
    ∑ I ∈ S, dyadicGridLength G I.1 * min η (CI I) ≤
      η ^ (1 - p) * (dyadicGridLength G root.1 * Mp) +
        ∑ I ∈ S, dyadicGridLength G I.1 * err I := by
  have hmain := core_final_bound G root S hS Cf q hq (fun I => ∑ c ∈ Cf I, q I c)
    (fun I _ => le_rfl) hη hp0 hp1 hpath
  have hcell : ∀ I ∈ S, dyadicGridLength G I.1 * min η (CI I) ≤
      dyadicGridLength G I.1 * min η (∑ c ∈ Cf I, q I c) + dyadicGridLength G I.1 * err I := by
    intro I hI
    have hr := (dyadicGridLength_pos G I.1).le
    rw [← mul_add]
    refine mul_le_mul_of_nonneg_left ?_ hr
    have h1 : min η (CI I) ≤ min η (∑ c ∈ Cf I, q I c + err I) :=
      min_le_min_left η (hCI I hI)
    refine h1.trans ?_
    rcases le_total η (∑ c ∈ Cf I, q I c) with h | h
    · rw [min_eq_left h, min_eq_left (le_add_of_le_of_nonneg h (herr I hI))]
      linarith [herr I hI]
    · rw [min_eq_right h]
      exact min_le_right _ _
  calc ∑ I ∈ S, dyadicGridLength G I.1 * min η (CI I) ≤
      ∑ I ∈ S, (dyadicGridLength G I.1 * min η (∑ c ∈ Cf I, q I c) +
        dyadicGridLength G I.1 * err I) := Finset.sum_le_sum hcell
    _ = _ + _ := Finset.sum_add_distrib
    _ ≤ _ := add_le_add hmain le_rfl

end Auto

