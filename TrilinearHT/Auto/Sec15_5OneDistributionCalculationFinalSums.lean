open Classical in
/-- Blueprint `eq:core-final` (lines 2810-2816) with point-dependent principal bounds ("integrating
over `x*` uses `eq:path`, including when the point-dependent principal upper bounds vary within a
cell"): if for every cell `I` and every point `y ∈ I` the cell quantity is at most a sum of
nonnegative principal quantities `q_{I,c}(y)` plus an absolute error, and at every point the
powered principal quantities of the cells containing it sum to at most `M_p`, then
`Σ_I |I| min(η, C_I) ≤ η^{1-p} M_p |R| + Σ_I |I| err_I`. -/
theorem core_final_pointwise (G : RealDyadicGrid) (root : ℤ × ℤ) (S : Finset (ℤ × ℤ))
    (hS : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G root.1 root.2)
    {κ : Type*} (Cf : ℤ × ℤ → Finset κ) (q : ℤ × ℤ → κ → ℝ → ℝ) (hq : ∀ I c y, 0 ≤ q I c y)
    (CI err : ℤ × ℤ → ℝ) (herr : ∀ I ∈ S, 0 ≤ err I)
    (hCI : ∀ I ∈ S, ∀ y ∈ dyadicGridCell G I.1 I.2, CI I ≤ ∑ c ∈ Cf I, q I c y + err I)
    {η p Mp : ℝ} (hη : 0 ≤ η) (hp0 : 0 < p) (hp1 : p ≤ 1)
    (hpath : ∀ y, ∑ I ∈ S with y ∈ dyadicGridCell G I.1 I.2, ∑ c ∈ Cf I, q I c y ^ p ≤ Mp) :
    ∑ I ∈ S, dyadicGridLength G I.1 * min η (CI I) ≤
      η ^ (1 - p) * (dyadicGridLength G root.1 * Mp) +
        ∑ I ∈ S, dyadicGridLength G I.1 * err I := by
  -- the cell weights `min(η, C_I) - err_I`, bounded pointwise by the powered principal sums
  set a : ℤ × ℤ → ℝ := fun I => max 0 (min η (CI I) - err I) with ha
  have ha0 : ∀ I, 0 ≤ a I := fun I => le_max_left _ _
  have hpt : ∀ y, ∑ I ∈ S with y ∈ dyadicGridCell G I.1 I.2, a I ≤ η ^ (1 - p) * Mp := by
    intro y
    calc ∑ I ∈ S with y ∈ dyadicGridCell G I.1 I.2, a I ≤
        ∑ I ∈ S with y ∈ dyadicGridCell G I.1 I.2, η ^ (1 - p) * ∑ c ∈ Cf I, q I c y ^ p := by
          refine Finset.sum_le_sum fun I hI => ?_
          obtain ⟨hIS, hyI⟩ := Finset.mem_filter.mp hI
          have h2 := min_sum_le_rpow (Cf I) (q I · y) (fun c _ => hq I c y) hη hp0 hp1
          have h3 : min η (CI I) ≤ min η (∑ c ∈ Cf I, q I c y) + err I := by
            have h1 := hCI I hIS y hyI
            rcases le_total η (∑ c ∈ Cf I, q I c y) with h | h
            · rw [min_eq_left h]
              linarith [min_le_left η (CI I), herr I hIS]
            · rw [min_eq_right h]
              linarith [min_le_right η (CI I)]
          have h4 : 0 ≤ η ^ (1 - p) * ∑ c ∈ Cf I, q I c y ^ p :=
            mul_nonneg (Real.rpow_nonneg hη _)
              (Finset.sum_nonneg fun c _ => Real.rpow_nonneg (hq I c y) p)
          exact max_le h4 (by linarith)
      _ = η ^ (1 - p) * ∑ I ∈ S with y ∈ dyadicGridCell G I.1 I.2, ∑ c ∈ Cf I, q I c y ^ p := by
          rw [Finset.mul_sum]
      _ ≤ η ^ (1 - p) * Mp := mul_le_mul_of_nonneg_left (hpath y) (Real.rpow_nonneg hη _)
  have hmain := cells_sum_le_of_path G root S hS ha0 hpt
  have hcell : ∀ I ∈ S, dyadicGridLength G I.1 * min η (CI I) ≤
      dyadicGridLength G I.1 * a I + dyadicGridLength G I.1 * err I := by
    intro I _
    rw [← mul_add]
    refine mul_le_mul_of_nonneg_left ?_ (dyadicGridLength_pos G I.1).le
    have := le_max_right 0 (min η (CI I) - err I)
    linarith
  calc ∑ I ∈ S, dyadicGridLength G I.1 * min η (CI I) ≤
      ∑ I ∈ S, (dyadicGridLength G I.1 * a I + dyadicGridLength G I.1 * err I) :=
        Finset.sum_le_sum hcell
    _ = _ := Finset.sum_add_distrib
    _ ≤ η ^ (1 - p) * (dyadicGridLength G root.1 * Mp) +
        ∑ I ∈ S, dyadicGridLength G I.1 * err I := by
        refine add_le_add (hmain.trans (le_of_eq ?_)) le_rfl
        ring

/-- Blueprint lines 2774-2801 (`eq:fixed-power`, `eq:powered-count`, Hölder over the groups): for
each group `G` let the tested-tuple counts `N_s^G` along a path satisfy the conclusions of the
tested-counts step (`eq:total-count` for the pair of the two largest amplitudes, `N_s ≤ (M')²`,
`eq:applied-sparse` with constant `B`), and let the label counts obey the path caps
`Σ_G M_i^G ≤ K σ_i^{-2}` for ordered amplitudes `σ₀ ≥ σ₁ ≥ σ₂ ≥ σ₃ > 0`. Then with `p = 1 - c/4`,
`(Σ_G Σ_s (N_s^G)^p) (Π_i σ_i)^p ≤ (16/3) L₀^{3/4} B^{1/4} K^{2-c/2}`
(`powered_count`, `core_count_groups`). -/
theorem path_count_four {κ : Type*} (Gs : Finset κ) (Sc : κ → Finset ℤ) (N : κ → ℤ → ℝ)
    (M : Fin 4 → κ → ℝ) (Mx : κ → ℝ) {σ : Fin 4 → ℝ} {L0 Bc K c : ℝ} (hc0 : 0 < c) (hc1 : c < 1)
    (hL0 : 0 < L0) (hBc : 0 < Bc) (hK : 0 ≤ K) (hσ3 : 0 < σ 3) (h23 : σ 3 ≤ σ 2)
    (h12 : σ 2 ≤ σ 1) (h01 : σ 1 ≤ σ 0) (hM0 : ∀ i, ∀ G ∈ Gs, 0 ≤ M i G)
    (hMx : ∀ G ∈ Gs, 0 < Mx G ∧ Mx G ≤ ∑ i, M i G)
    (hN0 : ∀ G ∈ Gs, ∀ s ∈ Sc G, 0 ≤ N G s)
    (hNM : ∀ G ∈ Gs, ∀ s ∈ Sc G, N G s ≤ Mx G ^ 2)
    (htot : ∀ G ∈ Gs, ∑ s ∈ Sc G, N G s ≤ L0 * M 0 G * M 1 G)
    (hsparse : ∀ G ∈ Gs, ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ (Sc G).filter (fun s => N G s ≤ δ * Mx G ^ 2), N G s ≤ Bc * δ ^ c * Mx G ^ 2)
    (hsum : ∀ i, ∑ G ∈ Gs, M i G ≤ K * σ i ^ (-2 : ℝ)) :
    (∑ G ∈ Gs, ∑ s ∈ Sc G, N G s ^ (1 - c / 4)) * (∏ i, σ i) ^ (1 - c / 4) ≤
      16 / 3 * L0 ^ (3 / 4 : ℝ) * Bc ^ (1 / 4 : ℝ) * K ^ (2 - c / 2) := by
  refine core_count_groups Gs (fun G => ∑ s ∈ Sc G, N G s ^ (1 - c / 4)) M Mx hc0 hc1 hL0.le
    hBc.le hK hσ3 h23 h12 h01 hM0 (fun G hG => ⟨(hMx G hG).1.le, (hMx G hG).2⟩)
    (fun G hG => ?_) hsum
  by_cases hA : 0 < L0 * M 0 G * M 1 G
  · exact powered_count (Sc G) (N G) (hMx G hG).1 (hN0 G hG) (hNM G hG) (htot G hG) hA hBc
      (hsparse G hG) hc0 hc1
  · have hA0 : L0 * M 0 G * M 1 G = 0 := le_antisymm (not_lt.mp hA)
      (mul_nonneg (mul_nonneg hL0.le (hM0 0 G hG)) (hM0 1 G hG))
    have hz : ∀ s ∈ Sc G, N G s = 0 := fun s hs => by
      have h1 := Finset.single_le_sum (hN0 G hG) hs
      have h2 := htot G hG
      linarith [hN0 G hG s hs]
    have hzero : ∑ s ∈ Sc G, N G s ^ (1 - c / 4) = 0 :=
      Finset.sum_eq_zero fun s hs => by
        rw [hz s hs, Real.zero_rpow (by linarith)]
    rw [hzero]
    have := (hMx G hG).1
    positivity

/-- A permutation ordering four amplitudes decreasingly (blueprint line 2783, "temporarily order the
roles so `σ₁ ≥ σ₂ ≥ σ₃ ≥ σ₄`"). -/
noncomputable def descPerm (σ : Fin 4 → ℝ) : Equiv.Perm (Fin 4) :=
  Fin.revPerm.trans (Tuple.sort σ)

theorem descPerm_antitone (σ : Fin 4 → ℝ) {i j : Fin 4} (hij : i ≤ j) :
    σ (descPerm σ j) ≤ σ (descPerm σ i) := by
  have hm := Tuple.monotone_sort σ
  unfold descPerm
  simp only [Equiv.trans_apply, Fin.revPerm_apply]
  exact hm (Fin.rev_le_rev.mpr hij)

/-- Blueprint lines 2774-2801 with the roles ordered by amplitude: `path_count_four` applied after
the permutation ordering the amplitudes decreasingly, using the total count of the pair of the two
largest amplitudes. -/
theorem path_count_four_sorted {κ : Type*} (Gs : Finset κ) (Sc : κ → Finset ℤ)
    (N : κ → ℤ → ℝ) (M : Fin 4 → κ → ℝ) (Mx : κ → ℝ) {σ : Fin 4 → ℝ} {L0 Bc K c : ℝ}
    (hc0 : 0 < c) (hc1 : c < 1) (hL0 : 0 < L0) (hBc : 0 < Bc) (hK : 0 ≤ K)
    (hσ : ∀ i, 0 < σ i) (hM0 : ∀ i, ∀ G ∈ Gs, 0 ≤ M i G)
    (hMx : ∀ G ∈ Gs, 0 < Mx G ∧ Mx G ≤ ∑ i, M i G)
    (hN0 : ∀ G ∈ Gs, ∀ s ∈ Sc G, 0 ≤ N G s)
    (hNM : ∀ G ∈ Gs, ∀ s ∈ Sc G, N G s ≤ Mx G ^ 2)
    (htot : ∀ G ∈ Gs, ∀ i j, i ≠ j → ∑ s ∈ Sc G, N G s ≤ L0 * M i G * M j G)
    (hsparse : ∀ G ∈ Gs, ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ (Sc G).filter (fun s => N G s ≤ δ * Mx G ^ 2), N G s ≤ Bc * δ ^ c * Mx G ^ 2)
    (hsum : ∀ i, ∑ G ∈ Gs, M i G ≤ K * σ i ^ (-2 : ℝ)) :
    (∑ G ∈ Gs, ∑ s ∈ Sc G, N G s ^ (1 - c / 4)) * (∏ i, σ i) ^ (1 - c / 4) ≤
      16 / 3 * L0 ^ (3 / 4 : ℝ) * Bc ^ (1 / 4 : ℝ) * K ^ (2 - c / 2) := by
  set π := descPerm σ
  have hprod : ∏ i, σ i = ∏ i, σ (π i) := (Equiv.prod_comp π σ).symm
  rw [hprod]
  have hne : π 0 ≠ π 1 := fun h => by
    have := π.injective h
    exact absurd this (by decide)
  refine path_count_four Gs Sc N (fun i G => M (π i) G) Mx hc0 hc1 hL0 hBc hK (hσ (π 3))
    (descPerm_antitone σ (by decide)) (descPerm_antitone σ (by decide))
    (descPerm_antitone σ (by decide)) (fun i G hG => hM0 (π i) G hG)
    (fun G hG => ⟨(hMx G hG).1, (hMx G hG).2.trans (le_of_eq
      (Equiv.sum_comp π (fun i => M i G)).symm)⟩) hN0 hNM
    (fun G hG => htot G hG (π 0) (π 1) hne) hsparse (fun i => hsum (π i))

open Classical in
/-- Blueprint lines 2766-2769 (negligible amplitudes, removed in the absolute estimate): if every
term is at most `K Π_j σ_j` with amplitudes `0 ≤ σ_j ≤ S`, the terms with some amplitude below `ε`,
weighted by nonnegative incidence weights `ℓ`, sum to at most `K ε S³ Σ ℓ`. -/
theorem negligible_amplitude_sum {ι : Type*} (T : Finset ι) (σ : ι → Fin 4 → ℝ) (w ℓ : ι → ℝ)
    {K ε Sm : ℝ} (hK : 0 ≤ K) (hε : 0 ≤ ε) (hℓ : ∀ p ∈ T, 0 ≤ ℓ p)
    (hσ0 : ∀ p ∈ T, ∀ j, 0 ≤ σ p j) (hσS : ∀ p ∈ T, ∀ j, σ p j ≤ Sm)
    (hw : ∀ p ∈ T, w p ≤ K * ∏ j, σ p j) :
    ∑ p ∈ T.filter (fun p => ∃ j, σ p j < ε), ℓ p * w p ≤ K * ε * Sm ^ 3 * ∑ p ∈ T, ℓ p := by
  have hone : ∀ p ∈ T.filter (fun p => ∃ j, σ p j < ε), w p ≤ K * ε * Sm ^ 3 := by
    intro p hp
    obtain ⟨hpT, j, hj⟩ := Finset.mem_filter.mp hp
    have hS0 : 0 ≤ Sm := (hσ0 p hpT j).trans (hσS p hpT j)
    have hrest : ∏ i ∈ Finset.univ.erase j, σ p i ≤ Sm ^ 3 := by
      have h := Finset.prod_le_prod₀ (s := Finset.univ.erase j) (f := σ p) (g := fun _ => Sm)
        (fun i _ => hσ0 p hpT i) fun i _ => hσS p hpT i
      rwa [Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ j), Finset.card_univ,
        Fintype.card_fin] at h
    have hr0 : 0 ≤ ∏ i ∈ Finset.univ.erase j, σ p i :=
      Finset.prod_nonneg fun i _ => hσ0 p hpT i
    calc w p ≤ K * ∏ i, σ p i := hw p hpT
      _ = K * (σ p j * ∏ i ∈ Finset.univ.erase j, σ p i) := by
          rw [Finset.mul_prod_erase _ _ (Finset.mem_univ j)]
      _ ≤ K * (ε * Sm ^ 3) :=
          mul_le_mul_of_nonneg_left (mul_le_mul hj.le hrest hr0 hε) hK
      _ = K * ε * Sm ^ 3 := by ring
  calc ∑ p ∈ T.filter (fun p => ∃ j, σ p j < ε), ℓ p * w p
      ≤ ∑ p ∈ T.filter (fun p => ∃ j, σ p j < ε), ℓ p * (K * ε * Sm ^ 3) :=
        Finset.sum_le_sum fun p hp => mul_le_mul_of_nonneg_left (hone p hp)
          (hℓ p (Finset.mem_filter.mp hp).1)
    _ = K * ε * Sm ^ 3 * ∑ p ∈ T.filter (fun p => ∃ j, σ p j < ε), ℓ p := by
        rw [← Finset.sum_mul]; ring
    _ ≤ K * ε * Sm ^ 3 * ∑ p ∈ T, ℓ p := by
        rcases T.eq_empty_or_nonempty with hT | ⟨p, hp⟩
        · simp [hT]
        · have hS0 : 0 ≤ Sm := (hσ0 p hp 0).trans (hσS p hp 0)
          exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum_of_subset_of_nonneg
            (Finset.filter_subset _ _) fun q hq _ => hℓ q hq) (by positivity)

theorem dyBin_mono {x y : ℝ} (hx : 0 < x) (hxy : x ≤ y) : dyBin x ≤ dyBin y :=
  Int.log_mono_right hx hxy

/-- Blueprint lines 2770-2772 (the amplitude bins): if all amplitudes lie in `[ε, S]` (`ε > 0`),
the occupied dyadic amplitude bins number at most `(⌊log₂ S⌋ - ⌊log₂ ε⌋ + 1)⁴`. -/
theorem retained_bins_card {ι : Type*} (T : Finset ι) (σ : ι → Fin 4 → ℝ) {ε Sm : ℝ}
    (hε : 0 < ε) (hσ : ∀ p ∈ T, ∀ j, ε ≤ σ p j ∧ σ p j ≤ Sm) :
    ((T.image fun p j => dyBin (σ p j)).card : ℝ) ≤ ((dyBin Sm + 1 - dyBin ε).toNat : ℝ) ^ 4 := by
  have hsub : (T.image fun p j => dyBin (σ p j)) ⊆
      Fintype.piFinset fun _ : Fin 4 => Finset.Icc (dyBin ε) (dyBin Sm) := by
    intro c hc
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hc
    refine Fintype.mem_piFinset.mpr fun j => Finset.mem_Icc.mpr ⟨?_, ?_⟩
    · exact dyBin_mono hε (hσ p hp j).1
    · exact dyBin_mono (hε.trans_le (hσ p hp j).1) (hσ p hp j).2
  have h := Finset.card_le_card hsub
  rw [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
    Int.card_Icc] at h
  exact_mod_cast h

/-- A geometric series with a polynomial weight `(1 + n)^C`. -/
theorem summable_one_add_pow_mul_geometric {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) (C : ℕ) :
    Summable fun n : ℕ => r ^ n * (1 + n : ℝ) ^ C := by
  rcases hr0.eq_or_lt with h | h
  · subst h
    refine summable_of_ne_finset_zero (s := {0}) fun n hn => ?_
    rw [Finset.mem_singleton] at hn
    simp [zero_pow hn]
  have hs := (summable_nat_add_iff 1).mpr
    (summable_pow_mul_geometric_of_norm_lt_one C (r := r) (by rwa [Real.norm_of_nonneg hr0]))
  refine (hs.mul_left r⁻¹).congr fun n => ?_
  push_cast
  rw [pow_succ]
  field_simp
  ring

/-- Blueprint lines 2803-2808 (the frequency band sums): for ratios `0 ≤ r_μ, r_ν, r_Λ < 1` (here
`2^{-p}`, `2^{-Jp}`, `2^{-Jp}` for `μ = 2^{-u}`, `ν = 2^v`, `Λ = 2^w`), the series
`Σ_{u,v,w ≥ 0} r_μ^u r_ν^v r_Λ^w (1 + u + v)^C` converges; so the powered kernel factors
`μ^p ν^{-Jp} Λ^{-Jp}` times the logarithmic frequency coefficient are summable over all bands. -/
theorem band_series_summable {rμ rν rΛ : ℝ} (h0μ : 0 ≤ rμ) (h1μ : rμ < 1) (h0ν : 0 ≤ rν)
    (h1ν : rν < 1) (h0Λ : 0 ≤ rΛ) (h1Λ : rΛ < 1) (C : ℕ) :
    Summable fun x : ℕ × ℕ × ℕ =>
      rμ ^ x.1 * rν ^ x.2.1 * rΛ ^ x.2.2 * (1 + x.1 + x.2.1 : ℝ) ^ C := by
  have hu := summable_one_add_pow_mul_geometric h0μ h1μ C
  have hv := summable_one_add_pow_mul_geometric h0ν h1ν C
  have hw : Summable fun n : ℕ => rΛ ^ n := summable_geometric_of_lt_one h0Λ h1Λ
  have hvw := hv.mul_of_nonneg hw (fun n => by positivity) fun n => by positivity
  have huvw := hu.mul_of_nonneg hvw (fun n => by positivity) fun x => by positivity
  refine huvw.of_nonneg_of_le (fun x => by positivity) fun x => ?_
  have hb : (1 + x.1 + x.2.1 : ℝ) ^ C ≤ (1 + x.1 : ℝ) ^ C * (1 + x.2.1 : ℝ) ^ C := by
    rw [← mul_pow]
    refine pow_le_pow_left₀ (by positivity) ?_ C
    nlinarith [(Nat.cast_nonneg x.1 : (0 : ℝ) ≤ x.1), (Nat.cast_nonneg x.2.1 : (0 : ℝ) ≤ x.2.1)]
  have h3 : 0 ≤ rμ ^ x.1 * rν ^ x.2.1 * rΛ ^ x.2.2 := by positivity
  calc rμ ^ x.1 * rν ^ x.2.1 * rΛ ^ x.2.2 * (1 + x.1 + x.2.1 : ℝ) ^ C
      ≤ rμ ^ x.1 * rν ^ x.2.1 * rΛ ^ x.2.2 * ((1 + x.1 : ℝ) ^ C * (1 + x.2.1 : ℝ) ^ C) :=
        mul_le_mul_of_nonneg_left hb h3
    _ = rμ ^ x.1 * (1 + x.1 : ℝ) ^ C * (rν ^ x.2.1 * (1 + x.2.1 : ℝ) ^ C * rΛ ^ x.2.2) := by
        ring

/-- Blueprint lines 2791-2797 ("after multiplication by `(Π_i σ_i)^p` ... the amplitude factor"):
if the powered tested counts obey `(Σ_s N_s^p) Y^p ≤ B`, the powered principal quantities
`(V₀ Y N_s)^p` sum to at most `V₀^p B`: the amplitude product `Y = Π_i σ_i` in the bin value
cancels. -/
theorem powered_bin_sum {ι : Type*} (T : Finset ι) (N : ι → ℝ) (hN : ∀ s ∈ T, 0 ≤ N s)
    {V₀ Y B p : ℝ} (hV : 0 ≤ V₀) (hY : 0 ≤ Y) (hcount : (∑ s ∈ T, N s ^ p) * Y ^ p ≤ B) :
    ∑ s ∈ T, (V₀ * Y * N s) ^ p ≤ V₀ ^ p * B := by
  have e : ∑ s ∈ T, (V₀ * Y * N s) ^ p = V₀ ^ p * ((∑ s ∈ T, N s ^ p) * Y ^ p) := by
    rw [Finset.sum_mul, Finset.mul_sum]
    refine Finset.sum_congr rfl fun s hs => ?_
    rw [Real.mul_rpow (mul_nonneg hV hY) (hN s hs), Real.mul_rpow hV hY]
    ring
  rw [e]
  exact mul_le_mul_of_nonneg_left hcount (Real.rpow_nonneg hV p)

