open Classical in
/-- Blueprint lines 2771-2775 (negligible amplitudes): if each incidence `t` (cell, group,
height, type, frequency choice and label tuple) contributes at most `w_t Π_j σ_{t,j}`, with
amplitudes `0 ≤ σ_{t,j} ≤ U` and length-weighted incidence count `Σ_t w_t ≤ W`, then the
incidences with some amplitude below `δ` contribute at most `δ U³ W`
(`C_J D_*^{-B+C₁+3C₀} |R|` with `δ = D_*^{-B}`, `U = P^{C₀}`, `W = D_*^{C₁} |R|`). -/
theorem negligible_amplitudes {τ : Type*} (T : Finset τ) (w : τ → ℝ) (σ : τ → Fin 4 → ℝ)
    (X : τ → ℝ) {U W δ : ℝ} (hw : ∀ t ∈ T, 0 ≤ w t) (hσ0 : ∀ t ∈ T, ∀ j, 0 ≤ σ t j)
    (hσU : ∀ t ∈ T, ∀ j, σ t j ≤ U) (hX : ∀ t ∈ T, X t ≤ w t * ∏ j, σ t j)
    (hW : ∑ t ∈ T, w t ≤ W) (hδ : 0 ≤ δ) (hU0 : 0 ≤ U) :
    ∑ t ∈ T.filter (fun t => ∃ j, σ t j < δ), X t ≤ δ * U ^ 3 * W := by
  have hterm : ∀ t ∈ T.filter (fun t => ∃ j, σ t j < δ), X t ≤ δ * U ^ 3 * w t := by
    intro t ht
    obtain ⟨ht, j, hj⟩ := Finset.mem_filter.mp ht
    refine (hX t ht).trans ?_
    have hprod : ∏ i, σ t i ≤ δ * U ^ 3 := by
      rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ j)]
      have hrest : ∏ i ∈ Finset.univ.erase j, σ t i ≤ U ^ 3 := by
        have hc : (Finset.univ.erase j).card = 3 := by simp
        calc ∏ i ∈ Finset.univ.erase j, σ t i ≤ ∏ _i ∈ Finset.univ.erase j, U := by
              apply Finset.prod_le_prod₀ <;> intro i _
              · exact hσ0 t ht i
              · exact hσU t ht i
          _ = U ^ 3 := by rw [Finset.prod_const, hc]
      have hp0 : 0 ≤ ∏ i ∈ Finset.univ.erase j, σ t i := Finset.prod_nonneg fun i _ => hσ0 t ht i
      calc σ t j * ∏ i ∈ Finset.univ.erase j, σ t i ≤ δ * ∏ i ∈ Finset.univ.erase j, σ t i :=
            mul_le_mul_of_nonneg_right hj.le hp0
        _ ≤ δ * U ^ 3 := mul_le_mul_of_nonneg_left hrest hδ
    calc w t * ∏ i, σ t i ≤ w t * (δ * U ^ 3) := mul_le_mul_of_nonneg_left hprod (hw t ht)
      _ = δ * U ^ 3 * w t := by ring
  calc _ ≤ ∑ t ∈ T.filter (fun t => ∃ j, σ t j < δ), δ * U ^ 3 * w t := Finset.sum_le_sum hterm
    _ ≤ ∑ t ∈ T, δ * U ^ 3 * w t :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) fun t ht _ =>
          mul_nonneg (by positivity) (hw t ht)
    _ = δ * U ^ 3 * ∑ t ∈ T, w t := by rw [Finset.mul_sum]
    _ ≤ δ * U ^ 3 * W := mul_le_mul_of_nonneg_left hW (by positivity)

