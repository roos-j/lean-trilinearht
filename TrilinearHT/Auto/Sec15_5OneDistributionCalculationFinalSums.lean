/-- Blueprint `eq:fixed-power` and `eq:powered-count`: with `ε = c/4`, the distribution constants
are `c/(c-ε) = 4/3`, `1 - ε/c = 3/4`, `ε/c = 1/4`, `2ε(1/c - 1) = (1-c)/2`, and the total count
exponent `3/4 + 3/4 + (1-c)/2` equals `2p` with `p = 1 - ε`. -/
theorem powered_count_exponents {c : ℝ} (hc : 0 < c) :
    c / (c - c / 4) = 4 / 3 ∧ 1 - c / 4 / c = 3 / 4 ∧ c / 4 / c = 1 / 4 ∧
      2 * (c / 4) * (1 / c - 1) = (1 - c) / 2 ∧
      3 / 4 + 3 / 4 + (1 - c) / 2 = 2 * (1 - c / 4) := by
  have hc0 : c ≠ 0 := hc.ne'
  refine ⟨?_, ?_, ?_, ?_, ?_⟩ <;> field_simp <;> ring

/-- Blueprint line 2799: for ordered amplitudes `σ₁ ≥ σ₂ ≥ σ₃ ≥ σ₄ > 0` and `0 < c`,
`σ₁^{-1/2-c/4} σ₂^{-1/2-c/4} σ₃^{1-c/4} σ₄^{3c/4} ≤ 1`. -/
theorem amplitude_factor_le_one {σ₁ σ₂ σ₃ σ₄ c : ℝ} (h4 : 0 < σ₄) (h34 : σ₄ ≤ σ₃)
    (h23 : σ₃ ≤ σ₂) (h12 : σ₂ ≤ σ₁) (hc : 0 < c) :
    σ₁ ^ (-1 / 2 - c / 4) * σ₂ ^ (-1 / 2 - c / 4) * σ₃ ^ (1 - c / 4) * σ₄ ^ (3 * c / 4) ≤ 1 := by
  have h3 : 0 < σ₃ := h4.trans_le h34
  have h2 : 0 < σ₂ := h3.trans_le h23
  have h1 : 0 < σ₁ := h2.trans_le h12
  have e : σ₁ ^ (-1 / 2 - c / 4) * σ₂ ^ (-1 / 2 - c / 4) * σ₃ ^ (1 - c / 4) *
      σ₄ ^ (3 * c / 4) = (σ₂ / σ₁) ^ (1 / 2 + c / 4) * (σ₃ / σ₂) ^ (1 + c / 2) *
        (σ₄ / σ₃) ^ (3 * c / 4) := by
    rw [Real.div_rpow h2.le h1.le, Real.div_rpow h3.le h2.le, Real.div_rpow h4.le h3.le]
    rw [show (-1 / 2 - c / 4 : ℝ) = -(1 / 2 + c / 4) by ring, Real.rpow_neg h1.le,
      Real.rpow_neg h2.le]
    have e2 : σ₂ ^ (1 / 2 + c / 4) * (σ₂ ^ (1 + c / 2))⁻¹ = (σ₂ ^ (1 / 2 + c / 4))⁻¹ := by
      have hadd := Real.rpow_add h2 (1 / 2 + c / 4) (1 / 2 + c / 4)
      rw [show (1 / 2 + c / 4 : ℝ) + (1 / 2 + c / 4) = 1 + c / 2 by ring] at hadd
      have : 0 < σ₂ ^ (1 / 2 + c / 4) := by positivity
      rw [hadd, mul_inv, ← mul_assoc, mul_inv_cancel₀ this.ne', one_mul]
    have e3 : σ₃ ^ (1 + c / 2) * (σ₃ ^ (3 * c / 4))⁻¹ = σ₃ ^ (1 - c / 4) := by
      rw [← Real.rpow_neg h3.le, ← Real.rpow_add h3]; congr 1; ring
    calc _ = (σ₂ ^ (1 / 2 + c / 4) * (σ₂ ^ (1 + c / 2))⁻¹) * (σ₁ ^ (1 / 2 + c / 4))⁻¹ *
          (σ₃ ^ (1 + c / 2) * (σ₃ ^ (3 * c / 4))⁻¹) * σ₄ ^ (3 * c / 4) := by
          rw [e2, e3]; ring
      _ = _ := by ring
  rw [e]
  have r1 : (σ₂ / σ₁) ^ (1 / 2 + c / 4) ≤ 1 :=
    Real.rpow_le_one (by positivity) ((div_le_one h1).mpr h12) (by positivity)
  have r2 : (σ₃ / σ₂) ^ (1 + c / 2) ≤ 1 :=
    Real.rpow_le_one (by positivity) ((div_le_one h2).mpr h23) (by positivity)
  have r3 : (σ₄ / σ₃) ^ (3 * c / 4) ≤ 1 :=
    Real.rpow_le_one (by positivity) ((div_le_one h3).mpr h34) (by positivity)
  have p1 : 0 ≤ (σ₂ / σ₁) ^ (1 / 2 + c / 4) := by positivity
  have p2 : 0 ≤ (σ₃ / σ₂) ^ (1 + c / 2) := by positivity
  have p3 : 0 ≤ (σ₄ / σ₃) ^ (3 * c / 4) := by positivity
  have := mul_le_mul (mul_le_mul r1 r2 p2 zero_le_one) r3 p3 (by norm_num)
  simpa using this

/-! ### The powered core estimate (core-estimate, blueprint lines 2771-2822) -/

/-- Blueprint `eq:powered-count` (lines 2779-2782): `lem:distribution` with `c' = c/4`,
`A = L₀ M_i M_j` and `B = C ℓ L₀¹²` gives
`Σ_s N_s^{1-c/4} ≤ (4/3) A^{3/4} B^{1/4} M^{(1-c)/2}`. -/
theorem powered_count {ι : Type*} (s : Finset ι) (N : ι → ℝ) {M A B c : ℝ} (hM : 0 < M)
    (hN0 : ∀ i ∈ s, 0 ≤ N i) (hNM : ∀ i ∈ s, N i ≤ M ^ 2) (hA : ∑ i ∈ s, N i ≤ A)
    (hApos : 0 < A) (hBpos : 0 < B)
    (hsparse : ∀ δ : ℝ, 0 < δ → δ ≤ 1 → ∑ i ∈ s.filter (fun i => N i ≤ δ * M ^ 2), N i ≤
      B * δ ^ c * M ^ 2) (hc0 : 0 < c) (hc1 : c < 1) :
    ∑ i ∈ s, N i ^ (1 - c / 4) ≤
      4 / 3 * A ^ (3 / 4 : ℝ) * B ^ (1 / 4 : ℝ) * M ^ ((1 - c) / 2) := by
  have h := distribution_power s N hM hN0 hNM hA hApos hBpos hsparse hc0 hc1 (ε := c / 4)
    (by positivity) (by linarith)
  obtain ⟨e1, e2, e3, e4, -⟩ := powered_count_exponents hc0
  rwa [e1, e2, e3, e4] at h

/-- Blueprint lines 2785-2789 (Hölder over groups): for nonnegative `m_i^G` and positive
exponents with `Σ_i β_i ≥ 1`, `Σ_G Π_i (m_i^G)^{β_i} ≤ Π_i (Σ_G m_i^G)^{β_i}`. -/
theorem sum_prod_rpow_le {κ ι : Type*} (I : Finset ι) (Gs : Finset κ) (m : ι → κ → ℝ)
    (β : ι → ℝ) (hm : ∀ i ∈ I, ∀ G ∈ Gs, 0 ≤ m i G) (hβ : ∀ i ∈ I, 0 < β i)
    (hb : 1 ≤ ∑ i ∈ I, β i) :
    ∑ G ∈ Gs, ∏ i ∈ I, m i G ^ β i ≤ ∏ i ∈ I, (∑ G ∈ Gs, m i G) ^ β i := by
  classical
  set S : ι → ℝ := fun i => ∑ G ∈ Gs, m i G
  have hS0 : ∀ i ∈ I, 0 ≤ S i := fun i hi => Finset.sum_nonneg fun G hG => hm i hi G hG
  -- a vanishing total makes every term vanish
  by_cases hz : ∃ i ∈ I, S i = 0
  · obtain ⟨i₀, hi₀, hS⟩ := hz
    have hzero : ∀ G ∈ Gs, m i₀ G = 0 := fun G hG =>
      le_antisymm ((Finset.single_le_sum (fun G' hG' => hm i₀ hi₀ G' hG') hG).trans hS.le)
        (hm i₀ hi₀ G hG)
    have hlhs : ∑ G ∈ Gs, ∏ i ∈ I, m i G ^ β i = 0 := by
      refine Finset.sum_eq_zero fun G hG => Finset.prod_eq_zero hi₀ ?_
      rw [hzero G hG, Real.zero_rpow (hβ i₀ hi₀).ne']
    rw [hlhs]
    exact Finset.prod_nonneg fun i hi => Real.rpow_nonneg (hS0 i hi) _
  push Not at hz
  have hSpos : ∀ i ∈ I, 0 < S i := fun i hi => lt_of_le_of_ne (hS0 i hi) (hz i hi).symm
  set b := ∑ i ∈ I, β i
  have hb0 : 0 < b := by linarith
  set w : ι → ℝ := fun i => β i / b
  have hw0 : ∀ i ∈ I, 0 ≤ w i := fun i hi => (div_pos (hβ i hi) hb0).le
  have hw1 : ∑ i ∈ I, w i = 1 := by
    simp only [w]; rw [← Finset.sum_div]; exact div_self hb0.ne'
  set x : ι → κ → ℝ := fun i G => m i G / S i
  have hx0 : ∀ i ∈ I, ∀ G ∈ Gs, 0 ≤ x i G := fun i hi G hG =>
    div_nonneg (hm i hi G hG) (hS0 i hi)
  have hx1 : ∀ i ∈ I, ∀ G ∈ Gs, x i G ≤ 1 := fun i hi G hG => by
    rw [div_le_one (hSpos i hi)]
    exact Finset.single_le_sum (fun G' hG' => hm i hi G' hG') hG
  -- each normalized term is at most the weighted mean
  have hterm : ∀ G ∈ Gs, ∏ i ∈ I, x i G ^ β i ≤ ∑ i ∈ I, w i * x i G := by
    intro G hG
    calc ∏ i ∈ I, x i G ^ β i ≤ ∏ i ∈ I, x i G ^ w i := by
          refine Finset.prod_le_prod₀ (fun i hi => Real.rpow_nonneg (hx0 i hi G hG) _)
            fun i hi => Real.rpow_le_rpow_of_exponent_ge' (hx0 i hi G hG) (hx1 i hi G hG)
              (hw0 i hi) ?_
          simp only [w]
          rw [div_le_iff₀ hb0]
          exact le_mul_of_one_le_right (hβ i hi).le hb
      _ ≤ ∑ i ∈ I, w i * x i G :=
          Real.geom_mean_le_arith_mean_weighted I w (fun i => x i G) hw0 hw1
            fun i hi => hx0 i hi G hG
  have hsumx : ∑ G ∈ Gs, ∏ i ∈ I, x i G ^ β i ≤ 1 := by
    calc ∑ G ∈ Gs, ∏ i ∈ I, x i G ^ β i ≤ ∑ G ∈ Gs, ∑ i ∈ I, w i * x i G :=
          Finset.sum_le_sum hterm
      _ = ∑ i ∈ I, w i * ∑ G ∈ Gs, x i G := by rw [Finset.sum_comm]; simp_rw [Finset.mul_sum]
      _ = ∑ i ∈ I, w i := by
          refine Finset.sum_congr rfl fun i hi => ?_
          simp only [x]
          rw [← Finset.sum_div, div_self (hSpos i hi).ne', mul_one]
      _ = 1 := hw1
  -- undo the normalization
  have hfact : ∀ G ∈ Gs, ∏ i ∈ I, m i G ^ β i =
      (∏ i ∈ I, S i ^ β i) * ∏ i ∈ I, x i G ^ β i := by
    intro G hG
    rw [← Finset.prod_mul_distrib]
    refine Finset.prod_congr rfl fun i hi => ?_
    simp only [x]
    rw [Real.div_rpow (hm i hi G hG) (hS0 i hi), mul_div_cancel₀]
    exact (Real.rpow_pos_of_pos (hSpos i hi) _).ne'
  rw [Finset.sum_congr rfl hfact, ← Finset.mul_sum]
