    (fun I => ap.z I l) hf

/-! ### The side mass of a basic leaf slot (blueprint lines 2159-2162) -/

/-- The block starts are multiples of `K` above the root. -/
theorem blockOf_dvd (h : ℤ) : (D.S.K : ℤ) ∣ D.blockOf h - A.R.1 := by
  unfold blockOf
  exact ⟨(h - A.R.1) / D.S.K, by ring⟩

/-- At most `K` depths share a block. -/
theorem card_block_le (hK1 : 1 ≤ D.S.K) (Sd : Finset ℕ) (b : ℤ) :
    (Sd.filter fun s : ℕ => D.blockOf (A.R.1 + s) = b).card ≤ D.S.K := by
  refine (Finset.card_le_card (t := Finset.Ico (b - A.R.1).toNat ((b - A.R.1).toNat + D.S.K))
    fun s hs => ?_).trans (by simp)
  obtain ⟨-, hsb⟩ := Finset.mem_filter.mp hs
  have h := D.blockOf_bounds hK1 (A.R.1 + s)
  rw [hsb] at h
  rw [Finset.mem_Ico]
  omega

open Classical in
/-- Blueprint lines 2159-2162 for a basic slot of a leaf (`eq:sides`, `eq:rolling-energy`,
`eq:linear-energy`): the sides of the slot on the used cells of all groups and depths have total
square at most `2 B_var + 2 K B_lin + B_out`, with the rolling bound `B_var` of the two basic
