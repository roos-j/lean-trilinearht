    refine le_trans (Finset.sum_le_sum fun i _ => ?_) (Ψ.jumps_from_le hΨr r t hrt hdis Z)
    refine (columnL2Restriction_norm_sq_le _ (hEm i) _).trans ?_
    refine pow_le_pow_left₀ (norm_nonneg _) ?_ 2
    refine le_trans ?_ (norm_physEmbed_apply_le (W := Fin ap.Mc) _)
