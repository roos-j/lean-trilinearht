/-! ### Global pads of the transfer steps (blueprint lines 2386-2391, 2412-2420) -/

/-- The inherited catalog mask of rank `r` and cell masks `M` on the complete catalog tree. -/
noncomputable def gMask (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (r : ℕ) (M : ℤ × ℤ → A.Vtx → Prop)
    (hM : ∀ c ∈ A.cells, ∀ d ∈ A.cells, dyadicGridCell A.G c.1 c.2 ⊆ dyadicGridCell A.G d.1 d.2 →
      ∀ x, M d x → M c x) : InheritedColumnMask (ap.cumBase catl hR hb).D :=
  (catDepthFamily (G := A.G) (S := A.cells) (Nd := A.treeDepth) (Mc := ap.Mc) hR catl
    (births_tree hb) r M hM).A

/-- The cell masks of a transfer step: the ball masks of the group at level `j` (`none`) or the
cumulative masks of the layer `m` (`some m`), at the pad index `p`. -/
def stepMask (G : A.Grp) (j : ℕ) : Option ℕ → ℕ → ℤ × ℤ → A.Vtx → Prop
  | none, p => fun c => ap.bmask c G j p
  | some m, p => fun c => ap.cmask c m p

theorem stepMask_mono (G : A.Grp) (j : ℕ) (e : Option ℕ) (p : ℕ) :
    ∀ c ∈ A.cells, ∀ d ∈ A.cells, dyadicGridCell A.G c.1 c.2 ⊆ dyadicGridCell A.G d.1 d.2 →
      ∀ x, ap.stepMask G j e p d x → ap.stepMask G j e p c x := by
  intro c hc d hd hcd x hx
  cases e with
  | none => exact ap.bmask_mono hc hd hcd G j p x hx
  | some m => exact ap.cmask_mono hc hd hcd m p x hx

