/-- The global raw transfer step of a descriptor at the depth `h`: helper pads on the helper
catalog of rank `r_H` and complement pads on the catalog of its slot, all with the inherited
masks of the step. -/
noncomputable def gStep (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (e : Bool × ℕ × Option ℕ) (h : ℤ) :
    Bool × (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) ×
      (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) :=
  (e.1, fun p => ((ap.cumBase hcat hR hbh).withMask (ap.gMask hcat hR hbh rH
      (ap.stepMask G (ap.leafJ s (if e.1 then c else d)) e.2.2 p)
      (ap.stepMask_mono G _ e.2.2 p))).proj h,
    fun p => ((ap.cumBase (cat (if e.1 then c else d)) hR (hbc _)).withMask
      (ap.gMask (cat (if e.1 then c else d)) hR (hbc _) e.2.1
        (ap.stepMask G (ap.leafJ s (if e.1 then c else d)) e.2.2 p)
        (ap.stepMask_mono G _ e.2.2 p))).proj h)

/-! ### Single pads after global histories on any catalog (blueprint lines 2390-2391, 2414-2420) -/

/-- A single pad projection composed with a global averaged history on a catalog family. -/
noncomputable def padHistL (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (ls : List (ℕ × Bool))
    (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  (((ap.cumBase catl hR hb).withMask M).proj h).comp
    (globHist (ap.cumBase catl hR hb) Am ls h)

/-- The rows of a single pad jump split over the partition of its left depth. -/
theorem padHist_blk (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    {hr ht : ℤ}
    (hrt : hr ≤ ht) (Ec : Finset (ℤ × ℤ)) (hEc : ∀ I ∈ Ec, I ∈ A.cells)
    (x : ColumnL2 (Fin ap.Mc)) :
    ‖((columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        (((ap.cumBase catl hR hb).withMask M).proj ht -
          ((ap.cumBase catl hR hb).withMask M).proj hr)) x‖ ^ 2
      = ∑ Q : {Q // Q ∈ ((ap.cumBase catl hR hb).partition hr).cells},
        ‖((columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
          (((ap.cumBase catl hR hb).withMask M).proj ht -
            ((ap.cumBase catl hR hb).withMask M).proj hr))
          (columnL2Restriction (dyadicGridCell A.G Q.1.1 Q.1.2)
            (dyadicGridCell_measurable A.G Q.1.1 Q.1.2) x)‖ ^ 2 := by
  set Ψ := (ap.cumBase catl hR hb).withMask M
  set Ψ0 := ap.cumBase catl hR hb
  set E := columnL2Restriction (V := Fin ap.Mc) (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hv := ap.restrict_union_vanish Ec hEc ((Ψ.proj ht - Ψ.proj hr) x)
  rw [ContinuousLinearMap.comp_apply, Ψ0.norm_sq_partition hr _ hv]
  refine Finset.sum_congr rfl fun Q _ => ?_
  have h1 := Ψ.proj_comm_restrict (h' := hr) (h := ht) hrt (Q := Q.1) Q.2
  have h2 := Ψ.proj_comm_restrict (h' := hr) (h := hr) le_rfl (Q := Q.1) Q.2
  have h3 := columnL2Restriction_comm (V := Fin ap.Mc)
    (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)
    (Finset.measurableSet_biUnion Ec fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  congr 2
  rw [ContinuousLinearMap.comp_apply, sub_apply, sub_apply, map_sub, map_sub]
  change (columnL2Restriction _ (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)).comp E
      (Ψ.proj ht x) - (columnL2Restriction _ (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)).comp E
      (Ψ.proj hr x) = _
  rw [h3, ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
    ← ContinuousLinearMap.comp_apply _ (Ψ.proj ht), ← ContinuousLinearMap.comp_apply _ (Ψ.proj hr)]
  change E (((columnL2Restriction _ (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2)).comp
    (Ψ.proj ht)) x) - E (((columnL2Restriction _
      (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2)).comp (Ψ.proj hr)) x) = _
  rw [← h1, ← h2, ← map_sub]
  rfl

/-- Blueprint lem:variation for one single pad (shared by the groups): the single-pad outputs,
restricted at the right endpoints to unions of active cells, have square-summable variation over
disjoint depth intervals. -/
theorem padHist_jump (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D)
    {ι' : Type*} [Fintype ι']
    (ls : List (ℕ × Bool)) (r t : ι' → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (Ec : ι' → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells)
    (z : ColumnL2 (Fin ap.Mc)) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.padHistL catl hR hb M Am ls (A.R.1 + t i) z -
          ap.padHistL catl hR hb M Am ls (A.R.1 + r i) z)‖ ^ 2 ≤
      2 * 1 * (compressionC (ap.cumBase catl hR hb).D ls.length ^ 2 * ‖z‖ ^ 2 +
          ls.length * (∑ m ∈ Finset.range ls.length,
            compressionC (ap.cumBase catl hR hb).D m ^ 2) * ‖z‖ ^ 2) := by
  classical
  set T := Finset.univ.sup t
  have ht : ∀ i, t i ≤ T := fun i => Finset.le_sup (f := t) (Finset.mem_univ i)
  have hone : ∀ (f : Unit × ι' → ColumnL2 (Fin ap.Mc)),
      ‖∑ k, f k‖ ^ 2 ≤ 1 * ∑ G : Unit, ‖∑ k ∈ (Finset.univ : Finset (Unit × ι')).filter
        (fun k => k.1 = G), f k‖ ^ 2 := fun f => by
    simp
  have hone' : ∀ (f : Unit → ColumnL2 (Fin ap.Mc)),
      ‖∑ G, f G‖ ^ 2 ≤ 1 * ∑ G : Unit, ‖∑ G' ∈ (Finset.univ : Finset Unit).filter
        (fun G' => G' = G), f G'‖ ^ 2 := fun f => by
    simp
  have key := certifiedVariation_gen (γ := Unit) T
    (fun _ n => ((ap.cumBase catl hR hb).withMask M).proj (A.R.1 + n))
    (fun _ n _ => ColumnDepthFamily.isStarProjection_proj _ _)
    (fun _ a _ b _ hab => ColumnDepthFamily.proj_nested _ (by omega))
    (fun _ i => columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2))
    (fun _ i y => columnL2Indicator_norm_le _ (Finset.measurableSet_biUnion _ fun I _ =>
      dyadicGridCell_measurable A.G I.1 I.2) y) r t hrt ht hdis
    (fun i => globHist (ap.cumBase catl hR hb) Am ls (A.R.1 + t i) z)
    (fun i => globHist (ap.cumBase catl hR hb) Am ls (A.R.1 + r i) z) z
    (G₀ := compressionC (ap.cumBase catl hR hb).D ls.length ^ 2)
    (J := ls.length * (∑ m ∈ Finset.range ls.length,
      compressionC (ap.cumBase catl hR hb).D m ^ 2) * ‖z‖ ^ 2)
    zero_le_one (fun x => hone _) ?_ (fun i x => hone' _)
    (globHist_jump (ap.cumBase catl hR hb) ap.hP Am ls r t hrt hdis z)
  · refine le_trans (le_of_eq ?_) (key.trans (le_of_eq (by ring)))
    rw [Fintype.sum_prod_type, show (Finset.univ : Finset Unit) = {()} from rfl,
      Finset.sum_singleton]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [padHistL, ContinuousLinearMap.comp_apply, map_sub]
  · intro c hc hB
    have h := globHist_compression (ap.cumBase catl hR hb) ap.hP Am ls
      (fun q : Unit × ι' => A.R.1 + r q.2)
      (fun q => (columnL2Restriction (⋃ I ∈ Ec q.2, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        (((ap.cumBase catl hR hb).withMask M).proj (A.R.1 + t q.2) -
          ((ap.cumBase catl hR hb).withMask M).proj (A.R.1 + r q.2))) hc hB
      (fun q x => ap.padHist_blk catl hR hb M (by have := hrt q.2; omega) (Ec q.2) (hEc q.2) x) z
    refine h.trans (le_of_eq ?_)
    ring

/-- The cumulative single-pad output commutes with the restrictions to cells at most as deep as
its depth. -/
theorem padHistL_commute (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (ls : List (ℕ × Bool))
    (h : ℤ)
    {Q : ℤ × ℤ} (hQ : Q.1 ≤ (ap.cumBase catl hR hb).depth h) :
    (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (ap.padHistL catl hR hb M Am ls h) =
    (ap.padHistL catl hR hb M Am ls h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)) := by
  set rQ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G Q.1 Q.2)
    (dyadicGridCell_measurable A.G Q.1 Q.2)
  have hpad : (((ap.cumBase catl hR hb).withMask M).proj h).comp rQ =
      rQ.comp (((ap.cumBase catl hR hb).withMask M).proj h) :=
    (((ap.cumBase catl hR hb).withMask M).proj_commute_restrict h
      hQ).symm
  have hcum : ∀ m, (opAvg fun p : Fin ap.P =>
      ((ap.cumBase catl hR hb).withMask (Am m p)).proj h).comp rQ =
      rQ.comp (opAvg fun p : Fin ap.P =>
        ((ap.cumBase catl hR hb).withMask (Am m p)).proj h) := fun m =>
    opAvg_commute _ _ fun p =>
      (((ap.cumBase catl hR hb).withMask (Am m p)).proj_commute_restrict h hQ).symm
  have hhist := layerOp_commute _ rQ hcum ls
  unfold padHistL globHist
  rw [← ContinuousLinearMap.comp_assoc, ← hpad, ContinuousLinearMap.comp_assoc,
    ContinuousLinearMap.comp_assoc, hhist]

/-- Blueprint lem:variation for one single pad acting on a basic projection (shared by the
groups). -/
theorem padHist_variation_basic (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (ls : List (ℕ × Bool))
    {ι : Type*} [Fintype ι] (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (htd : ∀ i, t i ≤ A.treeDepth) (Ec : ι → Finset (ℤ × ℤ))
    (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells) {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V)
    (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.padHistL catl hR hb M Am ls (A.R.1 + t i)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + t i) Z)) -
          ap.padHistL catl hR hb M Am ls (A.R.1 + r i)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + r i) Z)))‖ ^ 2 ≤
      2 * (2 * 1 * (compressionC (ap.cumBase catl hR hb).D ls.length ^ 2 +
            ls.length * (∑ m ∈ Finset.range ls.length,
              compressionC (ap.cumBase catl hR hb).D m ^ 2)) *
          compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) + 2 * ‖Z‖ ^ 2 := by
  set B := 2 * 1 * (compressionC (ap.cumBase catl hR hb).D ls.length ^ 2 +
    ls.length * (∑ m ∈ Finset.range ls.length, compressionC (ap.cumBase catl hR hb).D m ^ 2))
  have hB : 0 ≤ B := by
    have : 0 ≤ ∑ m ∈ Finset.range ls.length, compressionC (ap.cumBase catl hR hb).D m ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    positivity
  set E := fun i => columnL2Restriction (V := Fin ap.Mc) (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hEm : ∀ i, MeasurableSet (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2) := fun i =>
    Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2
  have hrows : ∀ x, ∑ i, ‖E i ((ap.padHistL catl hR hb M Am ls (A.R.1 + t i) -
      ap.padHistL catl hR hb M Am ls (A.R.1 + r i)) x)‖ ^ 2 ≤ B * ‖x‖ ^ 2 := by
    intro x
    have h := ap.padHist_jump catl hR hb M Am ls r t hrt hdis Ec hEc x
    refine le_trans (le_of_eq ?_) (h.trans (le_of_eq (by simp only [B]; ring)))
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [sub_apply]
  have hblk : ∀ i x, ‖E i ((ap.padHistL catl hR hb M Am ls (A.R.1 + t i) -
      ap.padHistL catl hR hb M Am ls (A.R.1 + r i)) x)‖ ^ 2 =
      ∑ Q : {Q // Q ∈ (Ψ.partition (A.R.1 + r i)).cells},
        ‖E i ((ap.padHistL catl hR hb M Am ls (A.R.1 + t i) -
          ap.padHistL catl hR hb M Am ls (A.R.1 + r i))
          (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
            (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x))‖ ^ 2 := by
    intro i x
    have hdepth : ∀ Q ∈ (Ψ.partition (A.R.1 + r i)).cells, ∀ h : ℤ, A.R.1 + r i ≤ h →
        h ≤ A.R.1 + t i → Q.1 ≤ (ap.cumBase catl hR hb).depth h := by
      intro Q hQ h h1 h2
      have hQ1 := ((Ψ.mem_partition _ Q).mp hQ).1
      have hle : Ψ.depth (A.R.1 + r i) ≤ A.R.1 + r i := by
        unfold ColumnDepthFamily.depth
        exact max_le (by omega) (min_le_left _ _)
      change Q.1 ≤ max A.R.1 (min h (A.R.1 + A.treeDepth))
      rw [hQ1]
      have := htd i
      exact le_trans hle (le_trans (le_min h1 (by have := hrt i; omega)) (le_max_right _ _))
    have h := Ψ.blk_of_commute (A.R.1 + r i) ((E i).comp
      (ap.padHistL catl hR hb M Am ls (A.R.1 + t i) - ap.padHistL catl hR hb M Am ls (A.R.1 + r i)))
      (fun y => ?_) (fun Q hQ => ?_) x
    · exact h
    · filter_upwards [columnL2Restriction_vanish _ (hEm i)
        ((ap.padHistL catl hR hb M Am ls (A.R.1 + t i) -
          ap.padHistL catl hR hb M Am ls (A.R.1 + r i)) y)] with z hz hzR
      refine hz fun hzE => hzR ?_
      rw [Set.mem_iUnion₂] at hzE
