  (D : ap.LeafSplit)

/-- Blueprint lines 2124, 2460 (`A_{l,G,b} = Z̃ - V` on an actual cell): at a use cell `I` inside a
pre-cell `J` of its block, given the exact frozen synthesis of the lifted decision-cell output on
`J`, the leaf core is the restriction to `I` of the physical embedding of the sum of the core
component subtotals. -/
theorem core_eq_comps (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc))
    (hreg : ¬ (D.usl l ∨ ¬ D.hasDecision I)) {J : ℤ × ℤ}
    (hJ : J ∈ D.cells l G (D.blockOf I.1))
    (hdis : Set.PairwiseDisjoint (D.cells l G (D.blockOf I.1) : Set (ℤ × ℤ))
      fun J => dyadicGridCell A.G J.1 J.2)
    (hIJ : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2)
    (hfz : columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
      ((D.Ms l G).L.op ZU) = (D.Ms l G).frozenEval D.S (D.blockOf I.1) J
        (D.c l G (D.blockOf I.1) J)) :
    D.core l G I ZU = columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2)
      (physEmbed (D.Ms l G).Md (Fin ap.Mc)
        (∑ K ∈ (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) J, ∑ m ∈ K,
          D.c l G (D.blockOf I.1) J m • (D.Ms l G).cellMode J m)) := by
  classical
  set b := D.blockOf I.1
  set Ms := D.Ms l G
  set rI := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
  set rJ := columnL2Restriction (V := Ms.Md) (dyadicGridCell A.G J.1 J.2)
    (dyadicGridCell_measurable A.G J.1 J.2)
  have hcomp : ∀ X : ColumnL2 Ms.Md, rI (physEmbed Ms.Md (Fin ap.Mc) X) =
      rI (physEmbed Ms.Md (Fin ap.Mc) (rJ X)) := by
    intro X
    simp only [rJ]
    rw [physEmbed_restrict]
    exact (DFunLike.congr_fun (columnL2Restriction_comp_of_subset (V := Fin ap.Mc)
      (dyadicGridCell_measurable A.G I.1 I.2) (dyadicGridCell_measurable A.G J.1 J.2) hIJ)
        (physEmbed Ms.Md (Fin ap.Mc) X)).symm
  have hfz' : rJ (Ms.L.op ZU - Ms.blockSide D.S D.hA D.SP b (D.cells l G b) (D.c l G b)) =
      rJ (Ms.frozenEval D.S b J (D.c l G b J) -
        Ms.blockSide D.S D.hA D.SP b (D.cells l G b) (D.c l G b)) := by
    rw [map_sub, map_sub, hfz]
    congr 1
    unfold ModeSystem.frozenEval
    simp only [rJ, map_sum, map_smul, Ms.restrict_cellMode_self]
    rfl
  unfold core lifted linSide
  rw [ite_eq_right_iff.mpr fun h => absurd h hreg]
  change rI (physEmbed Ms.Md (Fin ap.Mc) (Ms.L.op ZU)) -
      rI (physEmbed Ms.Md (Fin ap.Mc) (Ms.blockSide D.S D.hA D.SP b (D.cells l G b)
        (D.c l G b))) = _
  rw [← map_sub, ← map_sub, hcomp, hfz',
    Ms.restrict_frozen_sub_blockSide D.S D.hA D.SP hdis (D.c l G b) hJ]

end LeafSplit

