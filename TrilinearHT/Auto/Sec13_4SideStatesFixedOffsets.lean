open Classical in
/-- `lem:cuts` for finitely many families of nonnegative cell weights with integrated budgets
`Σ_I |I| a_ν(I) ≤ B_ν |R|`: one first-crossing cut of total length at most `ρ |R|` makes all
retained path sums of every family at most `(Σ_ν B_ν)/ρ`. -/
theorem caps_cut (Gd : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (root : ℤ × ℤ)
    (hroot : ∀ I ∈ S, dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd root.1 root.2)
    {ν : Type*} [Fintype ν] (a : ν → ℤ × ℤ → ℝ) (ha : ∀ v, ∀ I ∈ S, 0 ≤ a v I) (B : ν → ℝ)
    (hB : ∀ v, ∑ I ∈ S, dyadicGridLength Gd I.1 * a v I ≤ B v * dyadicGridLength Gd root.1)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ S ∧ dyadicRootLength Gd C ≤ ρ * dyadicGridLength Gd root.1 ∧
      ∀ v x, ∑ I ∈ (S.filter fun I => ¬ ∃ c ∈ C,
          dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd c.1 c.2).filter
          (fun I => x ∈ dyadicGridCell Gd I.1 I.2), a v I ≤ (∑ v, B v) / ρ := by
  obtain ⟨hlen, hcap⟩ := side_caps_of_budgets Gd S a ha root hroot B hB hρ hρ1
  set T := (∑ v, B v) / ρ
  set C := dyadicFirstCrossings Gd S (fun I => ∑ v, a v I) T
  refine ⟨C, fun c hc => (Finset.mem_filter.mp (maximalDyadicCells_subset Gd _ hc)).1, hlen,
    fun v x => ?_⟩
  refine le_trans ?_ (hcap x)
  unfold dyadicRealPathSum
  refine le_trans ?_ (Finset.sum_le_sum_of_subset_of_nonneg (s := (S.filter fun I => ¬ ∃ c ∈ C,
      dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd c.1 c.2).filter
      (fun I => x ∈ dyadicGridCell Gd I.1 I.2)) (fun I hI => ?_)
    fun I hI _ => Finset.sum_nonneg fun v _ => ha v I
      (Finset.mem_filter.mp (Finset.mem_filter.mp hI).1).1)
  · refine Finset.sum_le_sum fun I hI => ?_
    have hIS := (Finset.mem_filter.mp (Finset.mem_filter.mp hI).1).1
    exact Finset.single_le_sum (f := fun v => a v I) (fun v _ => ha v I hIS) (Finset.mem_univ v)
  · have hI' := Finset.mem_filter.mp hI
    have hIS := (Finset.mem_filter.mp hI'.1).1
    have hno := (Finset.mem_filter.mp hI'.1).2
    refine Finset.mem_filter.mpr ⟨?_, hI'.2⟩
    unfold dyadicRetainedCells
    refine Finset.mem_filter.mpr ⟨hIS, ?_⟩
    by_contra hbad
    rw [not_le] at hbad
    obtain ⟨c, hc, hIc⟩ := maximalDyadicCells_covers Gd
      (dyadicBadCells Gd S (fun I => ∑ v, a v I) T) (Finset.mem_filter.mpr ⟨hIS, hbad⟩)
    exact hno ⟨c, hc, hIc⟩

end Auto

