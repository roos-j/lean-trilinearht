        2 * ∑ t ∈ Sd, ∑ G, V G (S.K * (t / S.K)) := by
        simp only [Finset.sum_add_distrib, Finset.mul_sum]
    _ ≤ _ := by
        refine add_le_add (mul_le_mul_of_nonneg_left hroll (by norm_num)) (le_of_eq ?_)
