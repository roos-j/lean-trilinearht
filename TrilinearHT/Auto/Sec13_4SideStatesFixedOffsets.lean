  (D : ap.LeafSplit)

open Classical in
/-- The group-indexed path sums of the used cells are the cell-indexed sums. -/
theorem usedCells_sum (Sc : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp)
    (n : ℕ) {I : ℤ × ℤ} (hI : I ∈ Sc) (hgs : gs I ⊆ gset)
    (hdep : A.R.1 ≤ I.1 ∧ I.1 ≤ A.R.1 + n) (f : Fin 4 → A.Grp → ℝ) :
    ∑ l, ∑ G : {G // G ∈ gset}, ∑ s ∈ Finset.range (n + 1),
      (if I ∈ A.usedCells Sc gs G.1 s then f l G.1 else 0) = ∑ G ∈ gs I, ∑ l, f l G := by
  conv_lhs => rw [Finset.sum_comm]
  have hs : ∀ G : {G // G ∈ gset}, ∀ l, ∑ s ∈ Finset.range (n + 1),
      (if I ∈ A.usedCells Sc gs G.1 s then f l G.1 else 0) =
      if G.1 ∈ gs I then f l G.1 else 0 := by
    intro G l
    rw [Finset.sum_eq_single (I.1 - A.R.1).toNat]
    · unfold ActiveSetup.usedCells
      simp only [Finset.mem_filter, hI, true_and]
      congr 1
      apply propext
      constructor
      · exact fun h => h.2
      · exact fun h => ⟨by omega, h⟩
    · intro s _ hs
      rw [ite_eq_right_iff]
      intro h
      unfold ActiveSetup.usedCells at h
      exact absurd (by have := (Finset.mem_filter.mp h).2.1; omega) hs
    · intro h
      exact absurd (Finset.mem_range.mpr (by omega)) h
  simp_rw [hs]
  have hite : ∀ G : A.Grp, ∑ l, (if G ∈ gs I then f l G else 0) =
      if G ∈ gs I then ∑ l, f l G else 0 := fun G => by split_ifs <;> simp
  simp_rw [hite]
  rw [Finset.sum_coe_sort gset (fun G => if G ∈ gs I then ∑ l, f l G else 0),
    Finset.sum_ite_mem, Finset.inter_eq_right.mpr hgs]

open Classical in
/-- Blueprint `eq:side-cap` (lines 2159-2166) on a search leaf, in cell indexing: if the sides of
every slot on the used cells have total square at most `A_l |R|`, a cut family of total length at
most `ρ |R|` makes the retained path sums of `Σ_{G ∈ g(I)} Σ_l ‖π S_{l,G,I}‖² / |I|` at most
`(Σ_l A_l) / ρ`. -/
theorem leaf_side_paths (cat : Fin 4 → List (CatCol A.Vtx)) (s₀ : ℕ) (Sc : Finset (ℤ × ℤ))
    (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp) (hgs : ∀ I ∈ Sc, gs I ⊆ gset) (n : ℕ)
    (hdep : ∀ I ∈ Sc, A.R.1 ≤ I.1 ∧ I.1 ≤ A.R.1 + n)
    (hSc : ∀ I ∈ Sc, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G A.R.1 A.R.2)
    (Al : Fin 4 → ℝ)
    (hmass : ∀ l, ∑ G : {G // G ∈ gset}, ∑ s ∈ Finset.range (n + 1),
      ∑ I ∈ A.usedCells Sc gs G.1 s, ‖D.side l G.1 I (ap.leafOut cat s₀ I l G.1)
        (ap.leafOut cat s₀ (D.dcell I) l G.1)‖ ^ 2 ≤ Al l * dyadicGridLength A.G A.R.1)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ Sc ∧
      dyadicRootLength A.G C ≤ ρ * dyadicGridLength A.G A.R.1 ∧
      ∀ x : ℝ, ∑ I ∈ (Sc.filter (fun I => ¬ ∃ c ∈ C,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G c.1 c.2)).filter
          (fun I => x ∈ dyadicGridCell A.G I.1 I.2),
        ∑ G ∈ gs I, ∑ l, ‖π (D.side l G I (ap.leafOut cat s₀ I l G)
          (ap.leafOut cat s₀ (D.dcell I) l G))‖ ^ 2 / dyadicGridLength A.G I.1 ≤
        (∑ l, Al l) / ρ := by
  obtain ⟨C, hCS, hlen, hcap⟩ := D.leaf_side_caps_all (fun G : {G // G ∈ gset} => G.1)
    (Finset.range (n + 1)) Sc (fun _ G s => A.usedCells Sc gs G.1 s)
    (fun _ G s => Finset.filter_subset _ _) (fun l G s I => ap.leafOut cat s₀ I l G.1)
    (fun l G s I => ap.leafOut cat s₀ (D.dcell I) l G.1) Al hmass hSc hρ hρ1
  refine ⟨C, hCS, hlen, fun x => le_trans ?_ (hcap x)⟩
  rw [Finset.filter_filter]
  refine Finset.sum_le_sum fun I hI => ?_
  have hIS := (Finset.mem_filter.mp hI).1
  rw [LeafSplit.usedCells_sum Sc gs gset n hIS (hgs I hIS) (hdep I hIS)
    (fun l G => ‖D.side l G I (ap.leafOut cat s₀ I l G)
      (ap.leafOut cat s₀ (D.dcell I) l G)‖ ^ 2 / dyadicGridLength A.G I.1)]
  have hL := dyadicGridLength_pos A.G I.1
  refine Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun l _ => ?_
  have h := norm_physEmbed_apply_le (W := Fin ap.Mc) (D.side l G I (ap.leafOut cat s₀ I l G)
    (ap.leafOut cat s₀ (D.dcell I) l G))
  gcongr

end LeafSplit

