theorem padOutL_commute (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (p : Fin ap.P)
    (ls : List (ℕ × Bool)) (h : ℤ) {Q : ℤ × ℤ} (hQ : Q.1 ≤ (ap.cumBase cat hR hb).depth h) :
    (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
