open Classical in
/-- A function on `Fin d` heterogeneously equal to one on `Fin d'` with values in a set has its
values in that set. -/
theorem fin_heq_mem {d d' : ℕ} (hd : d = d') {f : Fin d → ℝ} {g : Fin d' → ℝ} (hfg : HEq f g)
    {T : Set ℝ} (hg : ∀ k, g k ∈ T) (k : Fin d) : f k ∈ T := by
  subst hd
  rw [eq_of_heq hfg]
  exact hg k

/-- The log-budget `X` of the first-match expansions of a group (`exists_modeSystem`):
`1 + log B_trans(H^6) + log (3 E_ball)` at the ball radius of the group's center scale. -/
noncomputable def modeX {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀}
    (ap : A.AttemptParams) (dB : ℕ) (H : ℝ) (g : ℤ) (j p : ℕ) : ℝ :=
  1 + Real.log (chartTranslationBudget (H ^ 6)) +
    Real.log (3 * ap.ballEdgeH dB (ap.ballRadius g (ap.bbase j + p + 1)))

open Classical in
/-- Blueprint lines 2128-2154 (`offset-selection`, `eq:physical-error`) for one slot, ball level,
rank and pad: offsets for all groups are selected by the first moment before the mode systems
are instantiated at them (by `exists_modeSystem`), and the physical errors of the lifted ball
outputs at the decision cells of their uses have total square at most
`Σ (8 d δ ∫ |Z|² + 2 δ_c² K |U|)`. -/
theorem group_modes_physical (κ : LocalKernelClass) (c₀ : ℕ) :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ (A : ActiveSetup κ c₀) (ap : A.AttemptParams)
      (cat : Fin 4 → List (CatCol A.Vtx))
      (_hT : ∀ l, ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
        d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag)
      (cs : Finset (ℤ × ℤ)) (_hcs : cs ⊆ A.cells) (l : Fin 4) {j p r : ℕ}
      {ι : Type} [Fintype ι] (grp : ι → A.Grp) (cen : ι → Fin ap.K.d0 × A.Vtx × ℤ)
      (_hcen : ∀ i, (grp i).2.1 = some (cen i))
      (_hHed : 2 ≤ ap.Hed) {dB : ℕ} (_hdim : ∀ w : A.Vtx, (A.vtag w).dim ≤ dB)
      (_hC : ∀ (w : A.Vtx) a c, (rationalHeight ((A.vtag w).C a c) : ℝ) ≤ ap.Hed)
      {δ : ℝ} (_hδ : 0 < δ) (_hδ' : δ ≤ 1 / 8) (_hdδ : ∀ w : A.Vtx, 8 * (A.vtag w).dim * δ ≤ 1)
      {H : ℝ} (_hHs : A.Hsrc ≤ H) (_hdz : ∀ w : A.Vtx, ((A.vtag w).dim : ℝ) ≤ Real.log H)
      (_hCz : ∀ (w : A.Vtx) i k,
        (chartRationalHeight ((((-slotCoeff l : ℤ) : ℚ) • (A.vtag w).C) i k) : ℝ) ≤ H)
      (_hHδ : ∀ w : A.Vtx, ((A.vtag w).dim : ℝ) * (bumpConst * 8 ^ 32 * (2 / δ)) ≤ H)
      {δc : ℝ} (_hδc : 0 < δc) (_hδcM : δc ^ 2 * ap.Mc ≤ 1)
      (Us : ι → Finset (ℤ × ℤ)) (xs : ι → ℤ × ℤ → ColumnL2 (Fin ap.Mc)) {Kx : ℝ}
      (_hKx : 0 ≤ Kx)
      (_hK : ∀ i, ∀ U ∈ Us i, ap.Mc * ‖xs i U‖ ^ 2 / dyadicGridLength A.G U.1 ≤ Kx),
      ∃ Ms : ι → ModeSystem A.G ap.Mc,
        (∀ i, (Ms i).zc = A.vtag (cen i).2.1 ∧ (Ms i).δc = δ ∧ (Ms i).cl = slotCoeff l ∧
          (∀ Φ, (Ms i).L.εP Φ = 1) ∧ (Ms i).L.δ = δc ∧
          (∀ n y, (∀ I ∈ maxCells A.G (cs.filter fun I =>
              n ∈ catLabels A.G ap.Mc (cat l) I r (ap.bmask I (grp i) j p)),
                y ∉ dyadicGridCell A.G I.1 I.2) →
            ∀ m, (Ms i).L.own m = n → (Ms i).L.a m y = 0) ∧
          (∀ n y, (∃ I ∈ maxCells A.G (cs.filter fun I =>
              n ∈ catLabels A.G ap.Mc (cat l) I r (ap.bmask I (grp i) j p)),
                y ∈ dyadicGridCell A.G I.1 I.2) →
            (Ms i).L.q n y = ∑ m ∈ Finset.univ.filter (fun m => (Ms i).L.own m = n),
              (Ms i).L.a m y * (Ms i).wave m y - (Ms i).L.s y * catAtom (cat l) n y) ∧
          (∀ m, (Ms i).cellOf m ∈ maxCells A.G (cs.filter fun I =>
            (Ms i).L.own m ∈ catLabels A.G ap.Mc (cat l) I r (ap.bmask I (grp i) j p))) ∧
          (∀ k, (Ms i).dvOf k ≤ dB) ∧ (∀ k, (Ms i).ρ k ∈ Set.Icc (0 : ℝ) 1) ∧
          (Ms i).Λ = Real.exp (D * ap.modeX dB H (cen i).2.2 j p ^ D) ∧
          ∀ y, ((Finset.univ.filter fun m =>
              y ∈ dyadicGridCell A.G ((Ms i).cellOf m).1 ((Ms i).cellOf m).2).card : ℝ) ≤
            ap.Mc * modeCount D (ap.modeX dB H (cen i).2.2 j p) δc dB) ∧
        ∑ i, ∑ U ∈ Us i, ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
            (‖(ap.ballAt (cat l) r j (grp i) U (xs i U) : ℝ → ColumnHilbert (Fin ap.Mc)) y none -
              ((Ms i).L.op (ap.ballAt (cat l) r j (grp i) U (xs i U)) :
                ℝ → ColumnHilbert (Ms i).Md) y none‖ ^ 2) ≤
          ∑ i, ∑ U ∈ Us i, ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
            (8 * (A.vtag (cen i).2.1).dim * δ *
              ‖(ap.ballAt (cat l) r j (grp i) U (xs i U) : ℝ → ColumnHilbert (Fin ap.Mc)) y
                none‖ ^ 2 + 2 * δ ^ 2 * (δc ^ 2 * Kx / δ ^ 2)) := by
  obtain ⟨D, hD, hms⟩ := exists_modeSystem κ c₀
  refine ⟨D, hD, ?_⟩
  intro A ap cat hT cs hcs l j p r ι _ grp cen hcen hHed dB hdim hC δ hδ hδ' hdδ H hHs hdz hCz
    hHδ δc hδc hδcM Us xs Kx hKx hK
  set Zf : ι → ℤ × ℤ → ℝ → ℝ := fun i U y =>
    ‖(ap.ballAt (cat l) r j (grp i) U (xs i U) : ℝ → ColumnHilbert (Fin ap.Mc)) y none‖ ^ 2
  have hKδ : 0 ≤ δc ^ 2 * Kx / δ ^ 2 := by positivity
  obtain ⟨ρ, hρ, hoff⟩ := exists_offsets_physical (fun i => A.vtag (cen i).2.1) hδ hδ'
    (fun i => hdδ _) Us (fun _ U => dyadicGridCell A.G U.1 U.2)
    (fun _ U => dyadicGridCell_measurable A.G U.1 U.2) Zf
    (fun i U => measurable_physCoord_sq _) (fun i U y => sq_nonneg _) hKδ
  have hδ4 : δ < 1 / 4 := by linarith
  have hex : ∀ i, ∃ Ms : ModeSystem A.G ap.Mc, Ms.zc = A.vtag (cen i).2.1 ∧ Ms.δc = δ ∧
      HEq Ms.ρ (ρ i) ∧ Ms.cl = slotCoeff l ∧ (∀ Φ, Ms.L.εP Φ = 1) ∧ Ms.L.δ = δc ∧
      (∀ y, Ms.L.s y = ((centerCut (A.vtag (cen i).2.1) δ (ρ i) y : ℝ) : ℂ) ^ 2) ∧
      (∀ n y, (∀ I ∈ maxCells A.G (cs.filter fun I =>
          n ∈ catLabels A.G ap.Mc (cat l) I r (ap.bmask I (grp i) j p)),
            y ∉ dyadicGridCell A.G I.1 I.2) →
        ∀ m, Ms.L.own m = n → Ms.L.a m y = 0) ∧
      (∀ n y, (∃ I ∈ maxCells A.G (cs.filter fun I =>
          n ∈ catLabels A.G ap.Mc (cat l) I r (ap.bmask I (grp i) j p)),
            y ∈ dyadicGridCell A.G I.1 I.2) →
        Ms.L.q n y = ∑ m ∈ Finset.univ.filter (fun m => Ms.L.own m = n),
          Ms.L.a m y * Ms.wave m y - Ms.L.s y * catAtom (cat l) n y) ∧
      (∀ m, Ms.cellOf m ∈ maxCells A.G (cs.filter fun I =>
        Ms.L.own m ∈ catLabels A.G ap.Mc (cat l) I r (ap.bmask I (grp i) j p))) ∧
      (∀ k, Ms.dvOf k ≤ dB) ∧
      Ms.Λ = Real.exp (D * ap.modeX dB H (cen i).2.2 j p ^ D) ∧
      ∀ y, ((Finset.univ.filter fun m =>
          y ∈ dyadicGridCell A.G (Ms.cellOf m).1 (Ms.cellOf m).2).card : ℝ) ≤
        ap.Mc * modeCount D (ap.modeX dB H (cen i).2.2 j p) δc dB := by
    intro i
    obtain ⟨Ms, h1, h2, h3, h4, h5, -, h7, h8, h9, h10, h11, h12, h13, -, h15⟩ :=
      hms A ap cat hT cs hcs l (G := grp i) (j := j) (p := p) (r := r) (hcen i) hHed hdim hC hδ
        hδ4 (ρ i) (hρ i) hHs (hdz _) (hCz _) (hHδ _) hδc hδcM
    exact ⟨Ms, h1, h2, h3, h4, h7, h8, h9, h10, h11, h12, h13, h5, h15⟩
  choose Ms hMs using hex
  refine ⟨Ms, fun i => ⟨(hMs i).1, (hMs i).2.1, (hMs i).2.2.2.1, (hMs i).2.2.2.2.1,
    (hMs i).2.2.2.2.2.1, (hMs i).2.2.2.2.2.2.2.1, (hMs i).2.2.2.2.2.2.2.2.1,
    (hMs i).2.2.2.2.2.2.2.2.2.1, (hMs i).2.2.2.2.2.2.2.2.2.2.1,
    fin_heq_mem (congrArg ChartTag.dim (hMs i).1) (hMs i).2.2.1 (hρ i),
    (hMs i).2.2.2.2.2.2.2.2.2.2.2.1, (hMs i).2.2.2.2.2.2.2.2.2.2.2.2⟩, ?_⟩
  refine le_trans ?_ hoff
  refine Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun U hU => ?_
  obtain ⟨-, -, -, -, hεP, hLδ, hs, -⟩ := hMs i
  have hpt := ap.ballAt_physical_error (Ms i) hεP (centerCut (A.vtag (cen i).2.1) δ (ρ i)) hs
    (by rw [hLδ]; exact hδc.le) (cat l) r j (grp i) U (xs i U)
  refine lintegral_mono_ae ?_
  rw [ae_restrict_iff' (dyadicGridCell_measurable _ _ _)]
  filter_upwards [hpt] with y hy hyU
  refine ENNReal.ofReal_le_ofReal ((hy hyU).trans ?_)
  rw [hLδ]
  have hδ2 : 0 < δ ^ 2 := by positivity
  have e : 2 * δ ^ 2 * (δc ^ 2 * Kx / δ ^ 2) = 2 * δc ^ 2 * Kx := by field_simp
  rw [e]
  have := hK i U hU
  gcongr

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The data of the core-side-error split of the leaf outputs of an attempt (blueprint
`eq:sides`, `eq:core-side-error`, lines 2120-2135): the block length `K`, the schedule and side
parameters, the mode systems of the slots and groups, the pre-cells of the blocks and the frozen
coefficients, and the slots carrying a basic `U` (whole sides). -/
structure LeafSplit where
  S : ModeSchedule
  hA : 6 ≤ S.A0
  SP : SideParams
  Ms : Fin 4 → A.Grp → ModeSystem A.G ap.Mc
  cells : Fin 4 → A.Grp → ℤ → Finset (ℤ × ℤ)
  c : ∀ l G, ℤ → ℤ × ℤ → (Ms l G).Md → ℂ
  usl : Fin 4 → Prop

namespace LeafSplit
variable {ap} (D : ap.LeafSplit)

/-- The block start of a depth: the largest `R.1 + K β ≤ h`. -/
noncomputable def blockOf (h : ℤ) : ℤ :=
  A.R.1 + D.S.K * ((h - A.R.1) / D.S.K)

/-- The decision cell `u_b` of a cell (its ancestor at depth `b - 4K`). -/
noncomputable def dcell (I : ℤ × ℤ) : ℤ × ℤ := ancAt A.G I (D.blockOf I.1 - 4 * D.S.K)

/-- Whether a cell has a decision cell below the root. -/
def hasDecision (I : ℤ × ℤ) : Prop := A.R.1 ≤ D.blockOf I.1 - 4 * D.S.K

open Classical in
/-- The rolling part `Z_{s} - Z_{u_b}` and the lifted parts of the leaf output `Zout` of slot
`l` and group `G` at a cell `I`, given the output `ZU` at its decision cell. -/
noncomputable def lifted (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc)) :
    ColumnL2 (Fin ap.Mc) :=
  columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
    (physEmbed (D.Ms l G).Md (Fin ap.Mc) ((D.Ms l G).L.op ZU))

/-- The linear side `V_{l,G,b}` on a cell. -/
noncomputable def linSide (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) : ColumnL2 (Fin ap.Mc) :=
  columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
    (physEmbed (D.Ms l G).Md (Fin ap.Mc) ((D.Ms l G).blockSide D.S D.hA D.SP (D.blockOf I.1)
      (D.cells l G (D.blockOf I.1)) (D.c l G (D.blockOf I.1))))

open Classical in
/-- The side part `S_{l,G,s} = Z_s - Z_{u_b} + V_{l,G,b}` (or the whole output for a `U` slot or a
cell without decision cell). -/
noncomputable def side (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (Zout ZU : ColumnL2 (Fin ap.Mc)) :
    ColumnL2 (Fin ap.Mc) :=
  if D.usl l ∨ ¬ D.hasDecision I then Zout else
    Zout - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) ZU + D.linSide l G I

open Classical in
/-- The core part `A_{l,G,b} = Z̃ - V`. -/
noncomputable def core (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc)) :
    ColumnL2 (Fin ap.Mc) :=
  if D.usl l ∨ ¬ D.hasDecision I then 0 else D.lifted l G I ZU - D.linSide l G I

open Classical in
/-- The physical error `E_{l,G,b} = Z_{u_b} - Z̃`. -/
noncomputable def err (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc)) :
    ColumnL2 (Fin ap.Mc) :=
  if D.usl l ∨ ¬ D.hasDecision I then 0 else
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) ZU -
      D.lifted l G I ZU

/-- Blueprint `eq:core-side-error`: the leaf output is the sum of its core, side and error
parts. -/
theorem core_add_side_add_err (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ)
    (Zout ZU : ColumnL2 (Fin ap.Mc)) :
    D.core l G I ZU + D.side l G I Zout ZU + D.err l G I ZU = Zout := by
  unfold core side err
  split_ifs
  · simp
  · abel

end LeafSplit

end AttemptParams

namespace AttemptParams

namespace LeafSplit
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

/-- The pattern form of a leaf at a cell: the sum over the groups of the cell form of the
pattern pieces of the core/side/error split of the outputs `Zout` (with decision-cell outputs
`ZU`). -/
noncomputable def patF (gs : Finset A.Grp) (I : ℤ × ℤ)
    (Zout ZU : Fin 4 → A.Grp → ColumnL2 (Fin ap.Mc)) (σ : Fin 4 → Fin 3) : ℂ :=
  ∑ G ∈ gs, ap.Λc I (patternPiece (fun l => D.core l G I (ZU l G))
    (fun l => D.side l G I (Zout l G) (ZU l G)) (fun l => D.err l G I (ZU l G)) σ)

/-- Blueprint `eq:core-side-error` summed over the groups of a cell: the leaf form is the sum of
the pattern forms over all core/side/error patterns. -/
theorem leaf_pattern_identity (gs : Finset A.Grp) (I : ℤ × ℤ)
    (Zout ZU : Fin 4 → A.Grp → ColumnL2 (Fin ap.Mc)) :
    ∑ G ∈ gs, ap.Λc I (fun l => Zout l G) = ∑ σ, D.patF gs I Zout ZU σ := by
  unfold patF
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun G _ => ?_
  rw [← form_pattern_expand]
  congr 1
  funext l
  exact (D.core_add_side_add_err l G I (Zout l G) (ZU l G)).symm

/-- The physical projection of an attempt's augmented space. -/
noncomputable abbrev π : ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  physEmbed (Fin ap.Mc) (Fin ap.Mc)

end LeafSplit

open Classical in
/-- Blueprint lines 2128-2154 for all four slots of one search leaf (ranks `r_l`, ball levels
`j_l`, top pad): mode systems for every group of a finite family with centers, carrying the
structure of `group_modes_physical`, whose physical lift errors at the decision cells `U_G`
have total square at most the first-moment majorant. -/
theorem leaf_modes (κ : LocalKernelClass) (c₀ : ℕ) :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ (A : ActiveSetup κ c₀) (ap : A.AttemptParams)
      (cat : Fin 4 → List (CatCol A.Vtx))
      (_hT : ∀ l, ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
        d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag)
      (cs : Finset (ℤ × ℤ)) (_hcs : cs ⊆ A.cells) (r j : Fin 4 → ℕ)
      (gset : Finset A.Grp) (cen : A.Grp → Fin ap.K.d0 × A.Vtx × ℤ)
      (_hcen : ∀ G ∈ gset, G.2.1 = some (cen G)) (G₀ : A.Grp) (_hG₀ : G₀ ∈ gset)
      (_hHed : 2 ≤ ap.Hed) {dB : ℕ} (_hdim : ∀ w : A.Vtx, (A.vtag w).dim ≤ dB)
      (_hC : ∀ (w : A.Vtx) a c, (rationalHeight ((A.vtag w).C a c) : ℝ) ≤ ap.Hed)
      {δ : ℝ} (_hδ : 0 < δ) (_hδ' : δ ≤ 1 / 8) (_hdδ : ∀ w : A.Vtx, 8 * (A.vtag w).dim * δ ≤ 1)
      {H : ℝ} (_hHs : A.Hsrc ≤ H) (_hdz : ∀ w : A.Vtx, ((A.vtag w).dim : ℝ) ≤ Real.log H)
      (_hCz : ∀ (l : Fin 4) (w : A.Vtx) i k,
        (chartRationalHeight ((((-slotCoeff l : ℤ) : ℚ) • (A.vtag w).C) i k) : ℝ) ≤ H)
      (_hHδ : ∀ w : A.Vtx, ((A.vtag w).dim : ℝ) * (bumpConst * 8 ^ 32 * (2 / δ)) ≤ H)
      {δc : ℝ} (_hδc : 0 < δc) (_hδcM : δc ^ 2 * ap.Mc ≤ 1)
      (Us : A.Grp → Finset (ℤ × ℤ)) (xs : Fin 4 → A.Grp → ℤ × ℤ → ColumnL2 (Fin ap.Mc))
      {Kx : ℝ} (_hKx : 0 ≤ Kx)
      (_hK : ∀ l, ∀ G ∈ gset, ∀ U ∈ Us G, ap.Mc * ‖xs l G U‖ ^ 2 / dyadicGridLength A.G U.1 ≤ Kx),
      ∃ Ms : Fin 4 → A.Grp → ModeSystem A.G ap.Mc,
        (∀ l, ∀ G ∈ gset, (Ms l G).zc = A.vtag (cen G).2.1 ∧ (Ms l G).δc = δ ∧
          (Ms l G).cl = slotCoeff l ∧ (∀ Φ, (Ms l G).L.εP Φ = 1) ∧ (Ms l G).L.δ = δc ∧
          (∀ n y, (∀ I ∈ maxCells A.G (cs.filter fun I =>
              n ∈ catLabels A.G ap.Mc (cat l) I (r l) (ap.bmask I G (j l) (ap.P - 1))),
                y ∉ dyadicGridCell A.G I.1 I.2) →
            ∀ m, (Ms l G).L.own m = n → (Ms l G).L.a m y = 0) ∧
          (∀ n y, (∃ I ∈ maxCells A.G (cs.filter fun I =>
              n ∈ catLabels A.G ap.Mc (cat l) I (r l) (ap.bmask I G (j l) (ap.P - 1))),
                y ∈ dyadicGridCell A.G I.1 I.2) →
            (Ms l G).L.q n y = ∑ m ∈ Finset.univ.filter (fun m => (Ms l G).L.own m = n),
              (Ms l G).L.a m y * (Ms l G).wave m y - (Ms l G).L.s y * catAtom (cat l) n y) ∧
          (∀ m, (Ms l G).cellOf m ∈ maxCells A.G (cs.filter fun I =>
            (Ms l G).L.own m ∈ catLabels A.G ap.Mc (cat l) I (r l)
              (ap.bmask I G (j l) (ap.P - 1)))) ∧
          (∀ k, (Ms l G).dvOf k ≤ dB) ∧ (∀ k, (Ms l G).ρ k ∈ Set.Icc (0 : ℝ) 1) ∧
          (Ms l G).Λ = Real.exp (D * ap.modeX dB H (cen G).2.2 (j l) (ap.P - 1) ^ D) ∧
          ∀ y, ((Finset.univ.filter fun m =>
              y ∈ dyadicGridCell A.G ((Ms l G).cellOf m).1 ((Ms l G).cellOf m).2).card : ℝ) ≤
            ap.Mc * modeCount D (ap.modeX dB H (cen G).2.2 (j l) (ap.P - 1)) δc dB) ∧
        ∀ l, ∑ G ∈ gset, ∑ U ∈ Us G, ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
            (‖(ap.ballAt (cat l) (r l) (j l) G U (xs l G U) : ℝ → ColumnHilbert (Fin ap.Mc)) y
                none -
              ((Ms l G).L.op (ap.ballAt (cat l) (r l) (j l) G U (xs l G U)) :
                ℝ → ColumnHilbert (Ms l G).Md) y none‖ ^ 2) ≤
          ∑ G ∈ gset, ∑ U ∈ Us G, ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
            (8 * (A.vtag (cen G).2.1).dim * δ *
              ‖(ap.ballAt (cat l) (r l) (j l) G U (xs l G U) : ℝ → ColumnHilbert (Fin ap.Mc)) y
                none‖ ^ 2 + 2 * δ ^ 2 * (δc ^ 2 * Kx / δ ^ 2)) := by
  obtain ⟨D, hD, hgm⟩ := group_modes_physical κ c₀
  refine ⟨D, hD, ?_⟩
  intro A ap cat hT cs hcs r j gset cen hcen G₀ hG₀ hHed dB hdim hC δ hδ hδ' hdδ H hHs hdz hCz
    hHδ δc hδc hδcM Us xs Kx hKx hK
  have hslot : ∀ l : Fin 4, ∃ Ms : gset → ModeSystem A.G ap.Mc,
      (∀ i : gset, (Ms i).zc = A.vtag (cen i.1).2.1 ∧ (Ms i).δc = δ ∧
        (Ms i).cl = slotCoeff l ∧ (∀ Φ, (Ms i).L.εP Φ = 1) ∧ (Ms i).L.δ = δc ∧
        (∀ n y, (∀ I ∈ maxCells A.G (cs.filter fun I =>
            n ∈ catLabels A.G ap.Mc (cat l) I (r l) (ap.bmask I i.1 (j l) (ap.P - 1))),
              y ∉ dyadicGridCell A.G I.1 I.2) →
          ∀ m, (Ms i).L.own m = n → (Ms i).L.a m y = 0) ∧
        (∀ n y, (∃ I ∈ maxCells A.G (cs.filter fun I =>
            n ∈ catLabels A.G ap.Mc (cat l) I (r l) (ap.bmask I i.1 (j l) (ap.P - 1))),
              y ∈ dyadicGridCell A.G I.1 I.2) →
          (Ms i).L.q n y = ∑ m ∈ Finset.univ.filter (fun m => (Ms i).L.own m = n),
            (Ms i).L.a m y * (Ms i).wave m y - (Ms i).L.s y * catAtom (cat l) n y) ∧
        (∀ m, (Ms i).cellOf m ∈ maxCells A.G (cs.filter fun I =>
          (Ms i).L.own m ∈ catLabels A.G ap.Mc (cat l) I (r l)
            (ap.bmask I i.1 (j l) (ap.P - 1)))) ∧
        (∀ k, (Ms i).dvOf k ≤ dB) ∧ (∀ k, (Ms i).ρ k ∈ Set.Icc (0 : ℝ) 1) ∧
        (Ms i).Λ = Real.exp (D * ap.modeX dB H (cen i.1).2.2 (j l) (ap.P - 1) ^ D) ∧
        ∀ y, ((Finset.univ.filter fun m =>
            y ∈ dyadicGridCell A.G ((Ms i).cellOf m).1 ((Ms i).cellOf m).2).card : ℝ) ≤
          ap.Mc * modeCount D (ap.modeX dB H (cen i.1).2.2 (j l) (ap.P - 1)) δc dB) ∧
      ∑ i : gset, ∑ U ∈ Us i.1, ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
          (‖(ap.ballAt (cat l) (r l) (j l) i.1 U (xs l i.1 U) : ℝ → ColumnHilbert (Fin ap.Mc)) y
              none -
            ((Ms i).L.op (ap.ballAt (cat l) (r l) (j l) i.1 U (xs l i.1 U)) :
              ℝ → ColumnHilbert (Ms i).Md) y none‖ ^ 2) ≤
        ∑ i : gset, ∑ U ∈ Us i.1, ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
          (8 * (A.vtag (cen i.1).2.1).dim * δ *
            ‖(ap.ballAt (cat l) (r l) (j l) i.1 U (xs l i.1 U) : ℝ → ColumnHilbert (Fin ap.Mc))
              y none‖ ^ 2 + 2 * δ ^ 2 * (δc ^ 2 * Kx / δ ^ 2)) := fun l =>
    hgm A ap cat hT cs hcs l (j := j l) (p := ap.P - 1) (r := r l) (ι := gset) Subtype.val
      (fun i => cen i.1) (fun i => hcen i.1 i.2) hHed hdim hC hδ hδ' hdδ hHs hdz (hCz l) hHδ hδc
      hδcM (fun i => Us i.1) (fun i => xs l i.1) hKx (fun i U hU => hK l i.1 i.2 U hU)
  choose Ms hMs hsum using hslot
  set Ms' : Fin 4 → A.Grp → ModeSystem A.G ap.Mc := fun l G =>
    if h : G ∈ gset then Ms l ⟨G, h⟩ else Ms l ⟨G₀, hG₀⟩
  have hMs' : ∀ l G (hG : G ∈ gset), Ms' l G = Ms l ⟨G, hG⟩ := fun l G hG =>
    dite_eq_left_of_eq_true (eq_true hG)
  refine ⟨Ms', ?_, ?_⟩
  · intro l G hG
    rw [hMs' l G hG]
    exact hMs l ⟨G, hG⟩
  · intro l
    rw [← Finset.sum_coe_sort gset, ← Finset.sum_coe_sort gset]
    refine le_trans (le_of_eq ?_) (hsum l)
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hMs' l i.1 i.2]

end AttemptParams

end ActiveSetup

/-- Cells of one depth inside a cell `U`: their integrals sum to at most the integral over `U`;
hence cells of at most `K` distinct depths inside `U` have total integral at most `K ∫_U`. -/
theorem lintegral_cells_le (G : RealDyadicGrid) (T : Finset (ℤ × ℤ)) (U : ℤ × ℤ)
    (hT : ∀ I ∈ T, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G U.1 U.2) {K : ℕ}
    (hK : (T.image Prod.fst).card ≤ K) (f : ℝ → ℝ≥0∞) :
    ∑ I ∈ T, ∫⁻ y in dyadicGridCell G I.1 I.2, f y ≤ K * ∫⁻ y in dyadicGridCell G U.1 U.2, f y := by
  classical
  rw [← Finset.sum_fiberwise_of_maps_to (g := Prod.fst) (t := T.image Prod.fst)
    (fun I hI => Finset.mem_image_of_mem _ hI)]
  have hdepth : ∀ d ∈ T.image Prod.fst, ∑ I ∈ T.filter (fun I => I.1 = d),
      ∫⁻ y in dyadicGridCell G I.1 I.2, f y ≤ ∫⁻ y in dyadicGridCell G U.1 U.2, f y := by
    intro d _
    rw [← lintegral_biUnion_finset (fun I _ J _ hIJ => ?_)
      (fun I _ => dyadicGridCell_measurable G I.1 I.2)]
    · exact lintegral_mono_set (Set.iUnion₂_subset fun I hI => hT I (Finset.mem_filter.mp hI).1)
    · rw [Function.onFun, Set.disjoint_iff_inter_eq_empty]
      by_contra hne
      have hI' := (Finset.mem_filter.mp (Finset.mem_coe.mp ‹I ∈ _›)).2
      have hJ' := (Finset.mem_filter.mp (Finset.mem_coe.mp ‹J ∈ _›)).2
      exact hIJ (dyadicGridCell_eq_of_meet G (hI'.trans hJ'.symm)
        (Set.nonempty_iff_ne_empty.mpr hne))
  calc _ ≤ ∑ _d ∈ T.image Prod.fst, ∫⁻ y in dyadicGridCell G U.1 U.2, f y :=
        Finset.sum_le_sum hdepth
    _ = (T.image Prod.fst).card * ∫⁻ y in dyadicGridCell G U.1 U.2, f y := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ K * ∫⁻ y in dyadicGridCell G U.1 U.2, f y := by
        gcongr

theorem ofReal_setIntegral_le {s : Set ℝ} {g : ℝ → ℝ} (hg0 : ∀ y, 0 ≤ g y)
    (hg : AEStronglyMeasurable g (volume.restrict s)) :
    ENNReal.ofReal (∫ y in s, g y) ≤ ∫⁻ y in s, ENNReal.ofReal (g y) := by
  rw [integral_eq_lintegral_of_nonneg_ae (Filter.Eventually.of_forall hg0) hg]
  exact ENNReal.ofReal_toReal_le

open Classical in
/-- Blueprint `eq:physical-error` transferred to the used cells (lines 2149-2154): if every used
cell lies in its decision cell and the used cells below one decision cell have at most `K`
distinct depths, the lift errors integrated over the used cells are at most `K` times those
integrated over the decision cells. -/
theorem leaf_err_energy_le {Mc : ℕ} (G : RealDyadicGrid) {γ : Type*}
    (Ms : Fin 4 → γ → ModeSystem G Mc)
    (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset γ) (gset : Finset γ)
    (hgs : ∀ I ∈ S, gs I ⊆ gset) (dc : ℤ × ℤ → ℤ × ℤ)
    (hdc : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G (dc I).1 (dc I).2) {K : ℕ}
    (hK : ∀ U, ((S.filter fun I => dc I = U).image Prod.fst).card ≤ K)
    (F : Fin 4 → γ → ℤ × ℤ → ColumnL2 (Fin Mc)) :
    ENNReal.ofReal (∑ I ∈ S, ∑ g ∈ gs I, ∑ l, ∫ y in dyadicGridCell G I.1 I.2,
      ‖(F l g (dc I) : ℝ → ColumnHilbert (Fin Mc)) y none -
        ((Ms l g).L.op (F l g (dc I)) : ℝ → ColumnHilbert (Ms l g).Md) y none‖ ^ 2) ≤
      K * ∑ l, ∑ g ∈ gset, ∑ U ∈ (S.filter fun I => g ∈ gs I).image dc,
        ∫⁻ y in dyadicGridCell G U.1 U.2, ENNReal.ofReal
          (‖(F l g U : ℝ → ColumnHilbert (Fin Mc)) y none -
            ((Ms l g).L.op (F l g U) : ℝ → ColumnHilbert (Ms l g).Md) y none‖ ^ 2) := by
  set f : Fin 4 → γ → ℤ × ℤ → ℝ → ℝ := fun l g U y =>
    ‖(F l g U : ℝ → ColumnHilbert (Fin Mc)) y none -
      ((Ms l g).L.op (F l g U) : ℝ → ColumnHilbert (Ms l g).Md) y none‖ ^ 2
  have hf0 : ∀ l g U y, 0 ≤ f l g U y := fun _ _ _ _ => sq_nonneg _
  have hfm : ∀ l g U (s : Set ℝ), AEStronglyMeasurable (f l g U) (volume.restrict s) := by
    intro l g U s
    have h1 := (memLp_column_coord (F l g U) none).aestronglyMeasurable
    have h2 := (memLp_column_coord ((Ms l g).L.op (F l g U)) none).aestronglyMeasurable
    exact ((h1.sub h2).norm.pow 2).restrict
  -- termwise comparison with the lower integrals
  have hstep : ENNReal.ofReal (∑ I ∈ S, ∑ g ∈ gs I, ∑ l, ∫ y in dyadicGridCell G I.1 I.2,
      f l g (dc I) y) ≤ ∑ I ∈ S, ∑ g ∈ gs I, ∑ l, ∫⁻ y in dyadicGridCell G I.1 I.2,
        ENNReal.ofReal (f l g (dc I) y) := by
    rw [ENNReal.ofReal_sum_of_nonneg fun I _ => Finset.sum_nonneg fun g _ =>
      Finset.sum_nonneg fun l _ => setIntegral_nonneg (dyadicGridCell_measurable _ _ _)
        fun y _ => hf0 _ _ _ y]
    refine Finset.sum_le_sum fun I _ => ?_
    rw [ENNReal.ofReal_sum_of_nonneg fun g _ => Finset.sum_nonneg fun l _ =>
      setIntegral_nonneg (dyadicGridCell_measurable _ _ _) fun y _ => hf0 _ _ _ y]
    refine Finset.sum_le_sum fun g _ => ?_
    rw [ENNReal.ofReal_sum_of_nonneg fun l _ =>
      setIntegral_nonneg (dyadicGridCell_measurable _ _ _) fun y _ => hf0 _ _ _ y]
    exact Finset.sum_le_sum fun l _ => ofReal_setIntegral_le (hf0 _ _ _) (hfm _ _ _ _)
  refine hstep.trans ?_
  -- reorganize the sums by slot, group and decision cell
  have hre : ∑ I ∈ S, ∑ g ∈ gs I, ∑ l, ∫⁻ y in dyadicGridCell G I.1 I.2,
      ENNReal.ofReal (f l g (dc I) y) = ∑ l, ∑ g ∈ gset, ∑ I ∈ S.filter (fun I => g ∈ gs I),
        ∫⁻ y in dyadicGridCell G I.1 I.2, ENNReal.ofReal (f l g (dc I) y) := by
    calc _ = ∑ I ∈ S, ∑ l, ∑ g ∈ gs I, ∫⁻ y in dyadicGridCell G I.1 I.2,
          ENNReal.ofReal (f l g (dc I) y) :=
          Finset.sum_congr rfl fun I _ => Finset.sum_comm
      _ = ∑ l, ∑ I ∈ S, ∑ g ∈ gs I, ∫⁻ y in dyadicGridCell G I.1 I.2,
          ENNReal.ofReal (f l g (dc I) y) := Finset.sum_comm
      _ = _ := by
          refine Finset.sum_congr rfl fun l _ => ?_
          refine Finset.sum_comm' fun I g => ?_
          constructor
          · rintro ⟨hI, hg⟩
            exact ⟨Finset.mem_filter.mpr ⟨hI, hg⟩, hgs I hI hg⟩
          · rintro ⟨hI, -⟩
            exact ⟨(Finset.mem_filter.mp hI).1, (Finset.mem_filter.mp hI).2⟩
  rw [hre, Finset.mul_sum]
  simp only [Finset.mul_sum]
  refine Finset.sum_le_sum fun l _ => Finset.sum_le_sum fun g _ => ?_
  rw [← Finset.sum_fiberwise_of_maps_to (g := dc) (t := (S.filter fun I => g ∈ gs I).image dc)
    (fun I hI => Finset.mem_image_of_mem _ hI)]
  refine Finset.sum_le_sum fun U _ => ?_
  have e : ∀ I ∈ (S.filter fun I => g ∈ gs I).filter (fun I => dc I = U),
      ∫⁻ y in dyadicGridCell G I.1 I.2, ENNReal.ofReal (f l g (dc I) y) =
        ∫⁻ y in dyadicGridCell G I.1 I.2, ENNReal.ofReal (f l g U y) := by
    intro I hI
    rw [(Finset.mem_filter.mp hI).2]
  rw [Finset.sum_congr rfl e]
  refine lintegral_cells_le G _ U (fun I hI => ?_) ?_ _
  · have h := Finset.mem_filter.mp hI
    have := hdc I (Finset.mem_filter.mp h.1).1
    rwa [h.2] at this
  · refine le_trans (Finset.card_le_card ?_) (hK U)
    intro d hd
    obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hd
    exact Finset.mem_image.mpr ⟨I, Finset.mem_filter.mpr
      ⟨(Finset.mem_filter.mp (Finset.mem_filter.mp hI).1).1, (Finset.mem_filter.mp hI).2⟩, rfl⟩

/-- The physical coordinate of an augmented vector has integrated square at most its norm
square. -/
theorem lintegral_phys_sq_le {V : Type*} [Fintype V] (s : Set ℝ) (F : ColumnL2 V) :
    ∫⁻ y in s, ENNReal.ofReal (‖(F : ℝ → ColumnHilbert V) y none‖ ^ 2) ≤
      ENNReal.ofReal (‖F‖ ^ 2) := by
  classical
  rw [columnInput_norm_sq_integral, ofReal_integral_eq_lintegral_ofReal
    ((Lp.memLp F).integrable_norm_pow two_ne_zero) (Filter.Eventually.of_forall fun _ => by
      positivity)]
  refine (lintegral_mono fun y => ENNReal.ofReal_le_ofReal ?_).trans'
    (setLIntegral_le_lintegral _ _)
  have : ‖(F : ℝ → ColumnHilbert V) y none‖ ≤ ‖(F : ℝ → ColumnHilbert V) y‖ := by
    rw [EuclideanSpace.norm_eq]
    exact Real.le_sqrt_of_sq_le (Finset.single_le_sum (f := fun i =>
      ‖(F : ℝ → ColumnHilbert V) y i‖ ^ 2) (fun _ _ => by positivity) (Finset.mem_univ none))
  exact pow_le_pow_left₀ (norm_nonneg _) this 2

/-- Blueprint `eq:physical-error` (lines 2149-2154), the majorant on one decision cell: if
`M_c ‖F‖² ≤ K_x |U|`, `d ≤ d_B` and `δ > 0`, the first-moment majorant integrates to at most
`(8 d_B δ / M_c + 2 δ_c²) K_x |U|`. -/
theorem ball_err_majorant_le {V : Type*} [Fintype V] (G : RealDyadicGrid) (U : ℤ × ℤ)
    (F : ColumnL2 V) {Mc : ℕ} (hMc : 0 < Mc) {Kx : ℝ}
    (hK : Mc * ‖F‖ ^ 2 / dyadicGridLength G U.1 ≤ Kx) {d dB : ℕ} (hd : d ≤ dB) {δ δc : ℝ}
    (hδ : 0 < δ) :
    ∫⁻ y in dyadicGridCell G U.1 U.2, ENNReal.ofReal (8 * d * δ *
        ‖(F : ℝ → ColumnHilbert V) y none‖ ^ 2 + 2 * δ ^ 2 * (δc ^ 2 * Kx / δ ^ 2)) ≤
      ENNReal.ofReal ((8 * dB * δ / Mc + 2 * δc ^ 2) * Kx * dyadicGridLength G U.1) := by
  have hU := dyadicGridLength_pos G U.1
  have hMcR : (0 : ℝ) < Mc := by exact_mod_cast hMc
  have hF : ‖F‖ ^ 2 ≤ Kx * dyadicGridLength G U.1 / Mc := by
    rw [le_div_iff₀ hMcR]
    rw [div_le_iff₀ hU] at hK
    linarith
  have hKx : 0 ≤ Kx := le_trans (by positivity) hK
  have e : 2 * δ ^ 2 * (δc ^ 2 * Kx / δ ^ 2) = 2 * δc ^ 2 * Kx := by
    field_simp
  have hsplit : ∀ y, ENNReal.ofReal (8 * d * δ * ‖(F : ℝ → ColumnHilbert V) y none‖ ^ 2 +
      2 * δ ^ 2 * (δc ^ 2 * Kx / δ ^ 2)) = ENNReal.ofReal (8 * d * δ) *
        ENNReal.ofReal (‖(F : ℝ → ColumnHilbert V) y none‖ ^ 2) +
        ENNReal.ofReal (2 * δc ^ 2 * Kx) := fun y => by
    rw [e, ENNReal.ofReal_add (by positivity) (by positivity), ENNReal.ofReal_mul (by positivity)]
  simp_rw [hsplit]
  rw [lintegral_add_right _ measurable_const, lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
    setLIntegral_const, dyadicGridCell_volume]
  calc ENNReal.ofReal (8 * d * δ) * (∫⁻ y in dyadicGridCell G U.1 U.2,
        ENNReal.ofReal (‖(F : ℝ → ColumnHilbert V) y none‖ ^ 2)) +
      ENNReal.ofReal (2 * δc ^ 2 * Kx) * ENNReal.ofReal (dyadicGridLength G U.1)
      ≤ ENNReal.ofReal (8 * dB * δ) * ENNReal.ofReal (Kx * dyadicGridLength G U.1 / Mc) +
        ENNReal.ofReal (2 * δc ^ 2 * Kx) * ENNReal.ofReal (dyadicGridLength G U.1) := by
        gcongr
        exact (lintegral_phys_sq_le _ F).trans (ENNReal.ofReal_le_ofReal hF)
    _ = _ := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 1
        field_simp

