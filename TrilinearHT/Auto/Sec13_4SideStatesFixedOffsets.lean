namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The right side of `rolling_budget` (blueprint `eq:rolling-energy`) for one basic projection. -/
noncomputable def rollBd (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (ls : List (ℕ × Bool)) (M N : ℕ) (τ : ℝ) {CF : ℝ}
    (P : BasicProjection A.G A.R CF) : ℝ :=
  M * (2 * (2 * (1 + τ * N * 1 ^ 2) *
          (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
            ls.length * (∑ m ∈ Finset.range ls.length,
              compressionC (ap.cumBase cat hR hb).D m ^ 2)) *
          compressionC P.Ψ.D 1 ^ 2 * ‖columnL2Restriction (dyadicGridCell A.G A.R.1 A.R.2)
            (dyadicGridCell_measurable A.G A.R.1 A.R.2) P.Z‖ ^ 2) +
        2 * ((1 + τ * N * 1 ^ 2) * ‖columnL2Restriction (dyadicGridCell A.G A.R.1 A.R.2)
            (dyadicGridCell_measurable A.G A.R.1 A.R.2) P.Z‖ ^ 2))

namespace LeafSplit
variable {ap} (D : ap.LeafSplit)

open Classical in
/-- Blueprint lines 2159-2162 (rolling part) on a basic slot of a leaf: on every regular cell
(with decision cell, non-`U` slot) the leaf output minus the restricted decision-cell output is
the restriction of a global rolling difference `W_{G,s}` of the two basic projections, and these
rolling differences have total square at most `2 B_rol(P₁) + 2 B_rol(P₂)` (`eq:rolling-energy`). -/
theorem leaf_rolling_mass (hK1 : 1 ≤ D.S.K) (cat : Fin 4 → List (CatCol A.Vtx)) (s₀ : ℕ)
    (l : Fin 4) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat l, d.birth ∈ A.cells) (hanc : A.AncClosed)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp) (hgrp : Function.Injective grp) (k : ℕ)
    (hPH : ap.bbase (ap.leafJ s₀ l) + ap.P ≤ ap.Hmax) (Sd : Finset ℕ)
    (hSd : ∀ s ∈ Sd, s ≤ A.treeDepth) (Ec : ι → ℕ → Finset (ℤ × ℤ))
    (hEc : ∀ G s, ∀ I ∈ Ec G s, I ∈ A.cells ∧ I.1 = A.R.1 + s)
    (hcert : ∀ G s, ∀ I ∈ Ec G s, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc (cat l) I (ap.leafR s₀ l)
          (ap.bmask I (grp q.1) (ap.leafJ s₀ l) p)).card ≤ N)
    (hz : ∀ I ∈ A.cells, ap.z I l = A.B l I) {CF : ℝ} (P₁ P₂ : BasicProjection A.G A.R CF)
    (hP : ∀ I ∈ A.cells, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
      A.B l I y = P₁.val I y - P₂.val I y)
    (hPN₁ : A.R.1 ≤ P₁.Ψ.N) (hPN₂ : A.R.1 ≤ P₂.Ψ.N) :
    (∀ G s, ∀ I ∈ Ec G s, ¬ (D.usl l ∨ ¬ D.hasDecision I) →
      ap.leafOut cat s₀ I l (grp G) - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (ap.leafOut cat s₀ (D.dcell I) l (grp G)) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        ((ap.projOut (cat l) hR hb (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G)
            ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) P₁ (A.R.1 + s) -
          ap.projOut (cat l) hR hb (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G)
            ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) P₁ (A.R.1 + D.uOf s)) -
         (ap.projOut (cat l) hR hb (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G)
            ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) P₂ (A.R.1 + s) -
          ap.projOut (cat l) hR hb (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G)
            ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) P₂ (A.R.1 + D.uOf s)))) ∧
    ∑ G, ∑ s ∈ Sd, ‖columnL2Restriction
      (⋃ I ∈ (Ec G s).filter (fun I => ¬ (D.usl l ∨ ¬ D.hasDecision I)),
        dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        ((ap.projOut (cat l) hR hb (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G)
            ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) P₁ (A.R.1 + s) -
          ap.projOut (cat l) hR hb (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G)
            ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) P₁ (A.R.1 + D.uOf s)) -
         (ap.projOut (cat l) hR hb (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G)
            ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) P₂ (A.R.1 + s) -
          ap.projOut (cat l) hR hb (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G)
            ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) P₂ (A.R.1 + D.uOf s)))‖ ^ 2 ≤
      2 * ap.rollBd (cat l) hR hb ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) (5 * D.S.K) N τ P₁ +
      2 * ap.rollBd (cat l) hR hb ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l) (5 * D.S.K) N τ
        P₂ := by
  refine ⟨fun G s I hI hreg => ?_, ?_⟩
  · obtain ⟨hIc, hIs⟩ := hEc G s I hI
    have hd : D.hasDecision I := by
      by_contra h; exact hreg (Or.inr h)
    obtain ⟨hU, hUs, hIU⟩ := D.dcell_spec hK1 hanc hIc hIs hd
    rw [ap.leaf_rolling_eq cat s₀ l hR hb (grp G) hIc hU hIU (hz I hIc) (hz _ hU) P₁ P₂
      (hP I hIc) (hP _ hU), hIs, hUs]
  · set ls := (leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l
    set reg : ℤ × ℤ → Prop := fun I => ¬ (D.usl l ∨ ¬ D.hasDecision I)
    have hms : ∀ G s, MeasurableSet (⋃ I ∈ (Ec G s).filter reg, dyadicGridCell A.G I.1 I.2) :=
      fun G s => Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2
    set pO := fun (P : BasicProjection A.G A.R CF) (G : ι) (h : ℤ) =>
      ap.projOut (cat l) hR hb (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G) ls P h
    set nr := fun (P : BasicProjection A.G A.R CF) (G : ι) (s : ℕ) =>
      ‖columnL2Restriction (⋃ I ∈ (Ec G s).filter reg, dyadicGridCell A.G I.1 I.2) (hms G s)
        (pO P G (A.R.1 + s) - pO P G (A.R.1 + D.uOf s))‖
    have hroll : ∀ P : BasicProjection A.G A.R CF, A.R.1 ≤ P.Ψ.N →
        ∑ G, ∑ s ∈ Sd, nr P G s ^ 2 ≤ ap.rollBd (cat l) hR hb ls (5 * D.S.K) N τ P := by
      intro P hPN
      have h := ap.rolling_budget (cat l) t₀ hT hR hb hanc grp hgrp k (ap.leafR s₀ l)
        (ap.leafJ s₀ l) hPH ls Sd D.uOf D.uOf_le (D.sub_uOf_lt hK1) hSd Ec hEc hcert hroot hτ
        hτ1 hHed hN P hPN
      rw [Finset.sum_comm]
      refine le_trans (Finset.sum_le_sum fun s _ => Finset.sum_le_sum fun G _ =>
        columnL2Restriction_norm_sq_mono (hms G s)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
          (Set.biUnion_subset_biUnion_left fun I hI => (Finset.mem_filter.mp hI).1) _) ?_
      unfold rollBd
      exact_mod_cast h
    have h1 := hroll P₁ hPN₁
    have h2 := hroll P₂ hPN₂
    have hpt : ∀ G s, ‖columnL2Restriction (⋃ I ∈ (Ec G s).filter reg,
        dyadicGridCell A.G I.1 I.2) (hms G s)
        ((pO P₁ G (A.R.1 + s) - pO P₁ G (A.R.1 + D.uOf s)) -
          (pO P₂ G (A.R.1 + s) - pO P₂ G (A.R.1 + D.uOf s)))‖ ^ 2 ≤
        2 * nr P₁ G s ^ 2 + 2 * nr P₂ G s ^ 2 := by
      intro G s
      rw [map_sub]
      have := norm_sub_le (columnL2Restriction (⋃ I ∈ (Ec G s).filter reg,
        dyadicGridCell A.G I.1 I.2) (hms G s) (pO P₁ G (A.R.1 + s) - pO P₁ G (A.R.1 + D.uOf s)))
        (columnL2Restriction (⋃ I ∈ (Ec G s).filter reg,
        dyadicGridCell A.G I.1 I.2) (hms G s) (pO P₂ G (A.R.1 + s) - pO P₂ G (A.R.1 + D.uOf s)))
      have h0 := norm_nonneg (columnL2Restriction (⋃ I ∈ (Ec G s).filter reg,
        dyadicGridCell A.G I.1 I.2) (hms G s)
        ((pO P₁ G (A.R.1 + s) - pO P₁ G (A.R.1 + D.uOf s)) -
          (pO P₂ G (A.R.1 + s) - pO P₂ G (A.R.1 + D.uOf s))))
      rw [map_sub] at h0
      have ha := norm_nonneg (columnL2Restriction (⋃ I ∈ (Ec G s).filter reg,
        dyadicGridCell A.G I.1 I.2) (hms G s) (pO P₁ G (A.R.1 + s) - pO P₁ G (A.R.1 + D.uOf s)))
      have hb' := norm_nonneg (columnL2Restriction (⋃ I ∈ (Ec G s).filter reg,
        dyadicGridCell A.G I.1 I.2) (hms G s) (pO P₂ G (A.R.1 + s) - pO P₂ G (A.R.1 + D.uOf s)))
      simp only [nr]
      nlinarith [sq_nonneg (‖columnL2Restriction (⋃ I ∈ (Ec G s).filter reg,
        dyadicGridCell A.G I.1 I.2) (hms G s) (pO P₁ G (A.R.1 + s) - pO P₁ G (A.R.1 + D.uOf s))‖ -
        ‖columnL2Restriction (⋃ I ∈ (Ec G s).filter reg,
        dyadicGridCell A.G I.1 I.2) (hms G s) (pO P₂ G (A.R.1 + s) - pO P₂ G (A.R.1 + D.uOf s))‖)]
    refine (Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun s _ => hpt G s).trans ?_
    simp only [Finset.sum_add_distrib, ← Finset.mul_sum]
    linarith

end LeafSplit

