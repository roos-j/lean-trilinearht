/-- The restriction to a union of cells inside the root vanishes off the root. -/
theorem restrict_union_vanish (Ec : Finset (ℤ × ℤ)) (hEc : ∀ I ∈ Ec, I ∈ A.cells)
    (v : ColumnL2 (Fin ap.Mc)) :
    ∀ᵐ y ∂volume, y ∉ dyadicGridCell A.G A.R.1 A.R.2 →
      (columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion Ec fun I _ => dyadicGridCell_measurable A.G I.1 I.2) v :
          ℝ → ColumnHilbert (Fin ap.Mc)) y = 0 := by
  filter_upwards [columnL2Indicator_coeFn _ (Finset.measurableSet_biUnion Ec fun I _ =>
    dyadicGridCell_measurable A.G I.1 I.2) v] with y hy hyR
  change (columnL2Indicator _ (Finset.measurableSet_biUnion Ec fun I _ =>
    dyadicGridCell_measurable A.G I.1 I.2) v : ℝ → ColumnHilbert (Fin ap.Mc)) y = 0
  rw [hy, Set.indicator_of_notMem]
  intro hmem
  obtain ⟨I, hI, hyI⟩ := Set.mem_iUnion₂.mp hmem
  exact hyR (A.sub I (hEc I hI) hyI)

/-- The interval rows of the attempt variation split orthogonally over the partition at the left
depth. -/
theorem attempt_blk (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r₀ j : ℕ) (G : A.Grp) (p : ℕ) {hr ht : ℤ}
    (hrt : hr ≤ ht) (Ec : Finset (ℤ × ℤ)) (hEc : ∀ I ∈ Ec, I ∈ A.cells)
    (x : ColumnL2 (Fin ap.Mc)) :
    ‖((columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        ((ap.ballFam cat hR hb r₀ j G p).proj ht - (ap.ballFam cat hR hb r₀ j G p).proj hr)) x‖ ^ 2
      = ∑ Q : {Q // Q ∈ ((ap.cumBase cat hR hb).partition hr).cells},
        ‖((columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
          ((ap.ballFam cat hR hb r₀ j G p).proj ht - (ap.ballFam cat hR hb r₀ j G p).proj hr))
          (columnL2Restriction (dyadicGridCell A.G Q.1.1 Q.1.2)
            (dyadicGridCell_measurable A.G Q.1.1 Q.1.2) x)‖ ^ 2 := by
  set Ψ := ap.ballFam cat hR hb r₀ j G p
  set Ψ0 := ap.cumBase cat hR hb
  set E := columnL2Restriction (V := Fin ap.Mc) (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hv := ap.restrict_union_vanish Ec hEc ((Ψ.proj ht - Ψ.proj hr) x)
  rw [ContinuousLinearMap.comp_apply, Ψ0.norm_sq_partition hr _ hv]
  refine Finset.sum_congr rfl fun Q _ => ?_
  have h1 := Ψ.proj_comm_restrict (h' := hr) (h := ht) hrt (Q := Q.1) Q.2
  have h2 := Ψ.proj_comm_restrict (h' := hr) (h := hr) le_rfl (Q := Q.1) Q.2
  have h3 := columnL2Restriction_comm (V := Fin ap.Mc)
    (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)
    (Finset.measurableSet_biUnion Ec fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  congr 2
  rw [ContinuousLinearMap.comp_apply, sub_apply, sub_apply, map_sub, map_sub]
  change (columnL2Restriction _ (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)).comp E
      (Ψ.proj ht x) - (columnL2Restriction _ (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)).comp E
      (Ψ.proj hr x) = _
  rw [h3, ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
    ← ContinuousLinearMap.comp_apply _ (Ψ.proj ht), ← ContinuousLinearMap.comp_apply _ (Ψ.proj hr)]
  change E (((columnL2Restriction _ (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2)).comp
    (Ψ.proj ht)) x) - E (((columnL2Restriction _
      (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2)).comp (Ψ.proj hr)) x) = _
  rw [← h1, ← h2, ← map_sub]
  rfl

open Classical in
/-- Blueprint lem:variation (`eq:variation`, lines 1861-1890) for one ball level, rank and color
of the attempt: the global ball outputs of the groups, restricted at the right endpoints to unions
of certified active cells, have square-summable variation over disjoint depth intervals,
`Σ_{G,[r,t]} ‖1_E (Z_{G,t} - Z_{G,r})‖² ≤ 2 (1 + τN) (C_ls² + |ls| Σ_m C_m²) ‖z‖²`. -/
theorem attempt_variation (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed)
    {ι ι' : Type*} [Fintype ι] [Fintype ι'] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (ls : List (ℕ × Bool)) (r t : ι' → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (Ec : ι → ι' → Finset (ℤ × ℤ))
    (hEc : ∀ G i, ∀ I ∈ Ec G i, I ∈ A.cells ∧ I.1 = A.R.1 + t i)
    (hcert : ∀ G i, ∀ I ∈ Ec G i, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    (z : ColumnL2 (Fin ap.Mc)) :
    ∑ q : ι × ι', ‖columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.globOut cat hR hb r₀ j (grp q.1) ls (A.R.1 + t q.2) z -
          ap.globOut cat hR hb r₀ j (grp q.1) ls (A.R.1 + r q.2) z)‖ ^ 2 ≤
      2 * (1 + τ * N * 1 ^ 2) *
        (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * ‖z‖ ^ 2 +
          ls.length * (∑ m ∈ Finset.range ls.length,
            compressionC (ap.cumBase cat hR hb).D m ^ 2) * ‖z‖ ^ 2) := by
  set Ψ0 := ap.cumBase cat hR hb
  set Am := ap.cumMask cat hR hb
  set T := Finset.univ.sup t
  have ht : ∀ i, t i ≤ T := fun i => Finset.le_sup (f := t) (Finset.mem_univ i)
  have hCw : (0 : ℝ) ≤ 1 + τ * N * 1 ^ 2 := by positivity
  have key := certifiedVariation_avg T ap.hP
    (fun p G n => (ap.ballFam cat hR hb r₀ j (grp G) p).proj (A.R.1 + n))
    (fun p G n _ => ColumnDepthFamily.isStarProjection_proj _ _)
    (fun p G a _ b _ hab => ColumnDepthFamily.proj_nested _ (by omega))
    (fun G i => columnL2Restriction (⋃ I ∈ Ec G i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2))
    (fun G i y => columnL2Indicator_norm_le _ (Finset.measurableSet_biUnion _ fun I _ =>
      dyadicGridCell_measurable A.G I.1 I.2) y) r t hrt ht hdis
    (fun i => globHist Ψ0 Am ls (A.R.1 + t i) z) (fun i => globHist Ψ0 Am ls (A.R.1 + r i) z) z
    (G₀ := compressionC Ψ0.D ls.length ^ 2)
    (J := ls.length * (∑ m ∈ Finset.range ls.length, compressionC Ψ0.D m ^ 2) * ‖z‖ ^ 2) hCw
    (fun p x => ap.attempt_wr1 cat t₀ hT hR hb hanc grp hgrp k r₀ j hPH r t hrt Ec hEc hcert
      hroot hτ hτ1 hHed hN p x)
    ?_
    (fun p i x => ap.attempt_wr2 cat t₀ hT hR hb grp hgrp k r₀ j hPH (A.R.1 + t i)
      (fun G => Ec G i) (fun G => hEc G i) (fun G => hcert G i) hroot hτ hτ1 hHed hN p x)
    (globHist_jump Ψ0 ap.hP Am ls r t hrt hdis z)
  · refine le_trans (le_of_eq ?_) (key.trans (le_of_eq (by ring)))
    rfl
  · intro p c hc hB
    have h := globHist_compression Ψ0 ap.hP Am ls (fun q : ι × ι' => A.R.1 + r q.2)
      (fun q => (columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        ((ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + t q.2) -
          (ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + r q.2))) hc hB
      (fun q x => ap.attempt_blk cat hR hb r₀ j (grp q.1) p (by have := hrt q.2; omega)
        (Ec q.1 q.2) (fun I hI => (hEc q.1 q.2 I hI).1) x) z
    refine h.trans (le_of_eq ?_)
    ring

