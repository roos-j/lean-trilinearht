  have hfil : ∀ G s, (Ec G s).filter (fun I => D.usl l ∨ ¬ D.hasDecision I) = Ec G s :=
    fun G s => Finset.filter_true_of_mem fun _ _ => Or.inl hl
  simp_rw [hfil]
  rw [Finset.sum_comm]
  exact ap.uslot_budget (cat l) t₀ hT hR hb grp hgrp k (ap.leafR s₀ l) (ap.leafJ s₀ l) Sd Tc hTd
