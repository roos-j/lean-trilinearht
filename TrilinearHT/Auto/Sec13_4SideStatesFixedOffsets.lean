namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

theorem globOutL_apply (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool)) (h : ℤ)
    (z : ColumnL2 (Fin ap.Mc)) :
    ap.globOutL cat hR hb r j G ls h z = ap.globOut cat hR hb r j G ls h z := rfl

/-- The global ball outputs of an attempt at depth `h` commute with the restriction to every
dyadic cell of depth at most `h` (and at most the depth of the tree). -/
theorem globOutL_commute (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool)) (h : ℤ)
    {Q : ℤ × ℤ} (hQ : Q.1 ≤ (ap.cumBase cat hR hb).depth h) :
    (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (ap.globOutL cat hR hb r j G ls h) =
    (ap.globOutL cat hR hb r j G ls h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)) := by
  set rQ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G Q.1 Q.2)
    (dyadicGridCell_measurable A.G Q.1 Q.2)
  have hball : ∀ p : Fin ap.P, ((ap.ballFam cat hR hb r j G p).proj h).comp rQ =
      rQ.comp ((ap.ballFam cat hR hb r j G p).proj h) := fun p =>
    ((ap.ballFam cat hR hb r j G p).proj_commute_restrict h hQ).symm
  have hcum : ∀ m, (opAvg fun p : Fin ap.P =>
      ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h).comp rQ =
      rQ.comp (opAvg fun p : Fin ap.P =>
        ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h) := fun m =>
    opAvg_commute _ _ fun p =>
      (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj_commute_restrict h
        hQ).symm
  have hhist := layerOp_commute _ rQ hcum ls
  have hb2 := opAvg_commute _ _ hball
  unfold globOutL globHist
  refine ContinuousLinearMap.ext fun x => ?_
  simp only [ContinuousLinearMap.comp_apply]
  have e1 := DFunLike.congr_fun hhist x
  simp only [ContinuousLinearMap.comp_apply] at e1
  rw [e1]
  have e2 := DFunLike.congr_fun hb2 (layerOp (fun m => opAvg fun p : Fin ap.P =>
    ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h) ls x)
  simp only [ContinuousLinearMap.comp_apply] at e2
  rw [e2]

/-- The restricted jump rows of the global ball outputs between two depths split orthogonally
over the depth partition of a basic family at the left depth. -/
theorem globOut_rows_blk (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r₀ j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool))
    {hr ht : ℤ} (hrt : hr ≤ ht) (htd : ht ≤ A.R.1 + A.treeDepth) (E : Finset (ℤ × ℤ))
    (hE : ∀ I ∈ E, I ∈ A.cells)
    {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V) (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (hRr : A.R.1 ≤ hr) (x : ColumnL2 (Fin ap.Mc)) :
    ‖((columnL2Restriction (⋃ I ∈ E, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        (ap.globOutL cat hR hb r₀ j G ls ht - ap.globOutL cat hR hb r₀ j G ls hr)) x‖ ^ 2 =
      ∑ Q : {Q // Q ∈ (Ψ.partition hr).cells},
        ‖((columnL2Restriction (⋃ I ∈ E, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
          (ap.globOutL cat hR hb r₀ j G ls ht - ap.globOutL cat hR hb r₀ j G ls hr))
          (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
            (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x)‖ ^ 2 := by
  have hEm : MeasurableSet (⋃ I ∈ E, dyadicGridCell A.G I.1 I.2) :=
    Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2
  have hdepth : ∀ Q ∈ (Ψ.partition hr).cells, ∀ h : ℤ, hr ≤ h → h ≤ ht →
      Q.1 ≤ (ap.cumBase cat hR hb).depth h := by
    intro Q hQ h h1 h2
    have hQ1 := ((Ψ.mem_partition _ Q).mp hQ).1
    have hle : Ψ.depth hr ≤ hr := by
      unfold ColumnDepthFamily.depth
      exact max_le (by omega) (min_le_left _ _)
    change Q.1 ≤ max A.R.1 (min h (A.R.1 + A.treeDepth))
    rw [hQ1]
    exact le_trans hle (le_trans (le_min h1 (by omega)) (le_max_right _ _))
  refine Ψ.blk_of_commute hr _ (fun y => ?_) (fun Q hQ => ?_) x
  · filter_upwards [columnL2Restriction_vanish _ hEm
      ((ap.globOutL cat hR hb r₀ j G ls ht - ap.globOutL cat hR hb r₀ j G ls hr) y)]
      with z hz hzR
    refine hz fun hzE => hzR ?_
    rw [Set.mem_iUnion₂] at hzE
    obtain ⟨I, hI, hzI⟩ := hzE
    rw [hΨG]
    exact hΨR (A.sub I (hE I hI) hzI)
  · have h1 := ap.globOutL_commute cat hR hb r₀ j G ls ht (Q := Q) (hdepth Q hQ ht hrt le_rfl)
    have h2 := ap.globOutL_commute cat hR hb r₀ j G ls hr (Q := Q) (hdepth Q hQ hr le_rfl hrt)
    have hc := columnL2Restriction_comm (V := Fin ap.Mc) hEm
      (dyadicGridCell_measurable A.G Q.1 Q.2)
    rw [hΨG, ContinuousLinearMap.comp_assoc, ContinuousLinearMap.sub_comp, ← h1, ← h2,
      ← ContinuousLinearMap.comp_sub,
      ← ContinuousLinearMap.comp_assoc, ← ContinuousLinearMap.comp_assoc, hc]

open Classical in
/-- Blueprint lem:variation (`eq:variation`, lines 1859-1890) for a basic slot: the histories
act on the rank-zero basic projection `P_h F` of a basic column family (the input of the cells of
depth `h`), and the certified variation of the ball outputs over disjoint depth intervals is
bounded by the compressed row constant plus the whole-range constant, times `‖F‖²`. -/
theorem attempt_variation_basic (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed)
    {ι ι' : Type*} [Fintype ι] [Fintype ι'] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (ls : List (ℕ × Bool)) (r t : ι' → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (htd : ∀ i, t i ≤ A.treeDepth)
    (Ec : ι → ι' → Finset (ℤ × ℤ))
    (hEc : ∀ G i, ∀ I ∈ Ec G i, I ∈ A.cells ∧ I.1 = A.R.1 + t i)
    (hcert : ∀ G i, ∀ I ∈ Ec G i, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V) (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ q : ι × ι', ‖columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.globOut cat hR hb r₀ j (grp q.1) ls (A.R.1 + t q.2)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + t q.2) Z)) -
          ap.globOut cat hR hb r₀ j (grp q.1) ls (A.R.1 + r q.2)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + r q.2) Z)))‖ ^ 2 ≤
      2 * (2 * (1 + τ * N * 1 ^ 2) *
          (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
            ls.length * (∑ m ∈ Finset.range ls.length,
              compressionC (ap.cumBase cat hR hb).D m ^ 2)) *
          compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) +
        2 * ((1 + τ * N * 1 ^ 2) * ‖Z‖ ^ 2) := by
  have hC : (0 : ℝ) ≤ 1 + τ * N * 1 ^ 2 := by positivity
  have hBv : 0 ≤ 2 * (1 + τ * N * 1 ^ 2) *
      (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
        ls.length * (∑ m ∈ Finset.range ls.length,
          compressionC (ap.cumBase cat hR hb).D m ^ 2)) := by
    have : 0 ≤ ∑ m ∈ Finset.range ls.length, compressionC (ap.cumBase cat hR hb).D m ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    positivity
  have hrows : ∀ x, ∑ q : ι × ι', ‖((columnL2Restriction (⋃ I ∈ Ec q.1 q.2,
      dyadicGridCell A.G I.1 I.2) (Finset.measurableSet_biUnion _ fun I _ =>
        dyadicGridCell_measurable A.G I.1 I.2)).comp
      (ap.globOutL cat hR hb r₀ j (grp q.1) ls (A.R.1 + t q.2) -
        ap.globOutL cat hR hb r₀ j (grp q.1) ls (A.R.1 + r q.2))) x‖ ^ 2 ≤
      (2 * (1 + τ * N * 1 ^ 2) *
        (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
          ls.length * (∑ m ∈ Finset.range ls.length,
            compressionC (ap.cumBase cat hR hb).D m ^ 2))) * ‖x‖ ^ 2 := by
    intro x
    have h := ap.attempt_variation cat t₀ hT hR hb hanc grp hgrp k r₀ j hPH ls r t hrt hdis Ec
      hEc hcert hroot hτ hτ1 hHed hN x
    exact le_trans (le_of_eq rfl) (h.trans (le_of_eq (by ring)))
  have hjoint : ∑ q : ι × ι', ‖((columnL2Restriction (⋃ I ∈ Ec q.1 q.2,
      dyadicGridCell A.G I.1 I.2) (Finset.measurableSet_biUnion _ fun I _ =>
        dyadicGridCell_measurable A.G I.1 I.2)))
      (ap.globOutL cat hR hb r₀ j (grp q.1) ls (A.R.1 + t q.2) (physEmbed V (Fin ap.Mc)
        ((Ψ.proj (A.R.1 + t q.2) - Ψ.proj (A.R.1 + r q.2)) Z)))‖ ^ 2 ≤
      (1 + τ * N * 1 ^ 2) * ‖Z‖ ^ 2 := by
    rw [Fintype.sum_prod_type, Finset.sum_comm]
    calc _ ≤ ∑ i : ι', (1 + τ * N * 1 ^ 2) *
            ‖physEmbed V (Fin ap.Mc) ((Ψ.proj (A.R.1 + t i) - Ψ.proj (A.R.1 + r i)) Z)‖ ^ 2 :=
          Finset.sum_le_sum fun i _ => ap.globOut_joint cat t₀ hT hR hb grp hgrp k r₀ j hPH ls
            (A.R.1 + t i) (fun G => Ec G i) (fun G => hEc G i) (fun G => hcert G i) hroot hτ
            hτ1 hHed hN _
      _ ≤ ∑ i : ι', (1 + τ * N * 1 ^ 2) *
            ‖(Ψ.proj (A.R.1 + t i) - Ψ.proj (A.R.1 + r i)) Z‖ ^ 2 :=
          Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left
            (pow_le_pow_left₀ (norm_nonneg _) (norm_physEmbed_apply_le _) 2) hC
      _ ≤ _ := by
          rw [← Finset.mul_sum]
          exact mul_le_mul_of_nonneg_left (Ψ.jumps_from_le hΨr r t hrt hdis Z) hC
  have h := basic_variation Ψ
    (fun q : ι × ι' => columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2))
    (fun q h => ap.globOutL cat hR hb r₀ j (grp q.1) ls h)
    (fun q => A.R.1 + r q.2) (fun q => A.R.1 + t q.2) hBv (fun x => hrows x)
    (fun q x => ap.globOut_rows_blk cat hR hb r₀ j (grp q.1) ls (by have := hrt q.2; omega)
      (by have := htd q.2; omega) (Ec q.1 q.2) (fun I hI => (hEc q.1 q.2 I hI).1) Ψ hΨG hΨR
      hΨr (by omega) x) Z hjoint
  exact h

open Classical in
/-- Blueprint line 2149 for a basic slot ("rolling sides have integrated square budget `K G₀|R|`
by `eq:variation`, since the intervals `[u_b, s]` have overlap `O(K)`"): the rolling sides of
the outputs acting on the rank-zero basic projections, restricted to certified cells, have total
square at most `M` times the basic variation bound. -/
theorem attempt_rolling_variation_basic (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (ls : List (ℕ × Bool)) (Sd : Finset ℕ) (u : ℕ → ℕ) (hu : ∀ s, u s ≤ s) {M : ℕ}
    (hM : ∀ s, s - u s < M) (hSd : ∀ s ∈ Sd, s ≤ A.treeDepth) (Ec : ι → ℕ → Finset (ℤ × ℤ))
    (hEc : ∀ G s, ∀ I ∈ Ec G s, I ∈ A.cells ∧ I.1 = A.R.1 + s)
    (hcert : ∀ G s, ∀ I ∈ Ec G s, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V) (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ s ∈ Sd, ∑ G, ‖columnL2Restriction (⋃ I ∈ Ec G s, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + s)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + s) Z)) -
          ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + u s)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + u s) Z)))‖ ^ 2 ≤
      M * (2 * (2 * (1 + τ * N * 1 ^ 2) *
          (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
            ls.length * (∑ m ∈ Finset.range ls.length,
              compressionC (ap.cumBase cat hR hb).D m ^ 2)) *
          compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) +
        2 * ((1 + τ * N * 1 ^ 2) * ‖Z‖ ^ 2)) := by
  set f : ℕ → ℝ := fun s => ∑ G, ‖columnL2Restriction (⋃ I ∈ Ec G s, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
    (ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + s)
        (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + s) Z)) -
      ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + u s)
        (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + u s) Z)))‖ ^ 2
  set W := 2 * (2 * (1 + τ * N * 1 ^ 2) *
      (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
        ls.length * (∑ m ∈ Finset.range ls.length,
          compressionC (ap.cumBase cat hR hb).D m ^ 2)) *
      compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) +
    2 * ((1 + τ * N * 1 ^ 2) * ‖Z‖ ^ 2)
  change ∑ s ∈ Sd, f s ≤ M * W
  have hclass : ∀ c, ∑ s ∈ Sd.filter (fun s => s % M = c), f s ≤ W := by
    intro c
    set Sc := Sd.filter (fun s => s % M = c)
    have h := ap.attempt_variation_basic cat t₀ hT hR hb hanc (ι' := {s // s ∈ Sc}) grp hgrp k r₀
      j hPH ls (fun s => u s.1) (fun s => s.1) (fun s => hu s.1)
      (fun s s' hne => Ioc_disjoint_of_mod u hu hM
        (((Finset.mem_filter.mp s.2).2).trans ((Finset.mem_filter.mp s'.2).2).symm)
        (fun he => hne (Subtype.ext he)))
      (fun s => hSd s.1 (Finset.mem_filter.mp s.2).1)
      (fun G s => Ec G s.1) (fun G s => hEc G s.1) (fun G s => hcert G s.1) hroot hτ hτ1 hHed hN
      Ψ hΨG hΨR hΨr Z
    refine le_trans (le_of_eq ?_) h
    rw [Fintype.sum_prod_type, Finset.sum_comm (s := (Finset.univ : Finset ι))]
    exact (Finset.sum_coe_sort Sc f).symm
  rcases Nat.eq_zero_or_pos M with hM0 | hMpos
  · have hSd0 : Sd = ∅ := by
      by_contra hne
      obtain ⟨s, -⟩ := Finset.nonempty_iff_ne_empty.mpr hne
      have := hM s; omega
    simp [hSd0, hM0]
  calc ∑ s ∈ Sd, f s = ∑ c ∈ Finset.range M, ∑ s ∈ Sd.filter (fun s => s % M = c), f s :=
        (Finset.sum_fiberwise_of_maps_to (fun s _ => Finset.mem_range.mpr (Nat.mod_lt s hMpos))
          f).symm
    _ ≤ ∑ _c ∈ Finset.range M, W := Finset.sum_le_sum fun c _ => hclass c
    _ = M * W := by rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]

end AttemptParams

