    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    (p : Fin ap.P)
    {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V) (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ q : ι × ι', ‖columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + t q.2)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + t q.2) Z)) -
          ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + r q.2)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + r q.2) Z)))‖ ^ 2 ≤
      2 * (2 * (1 + τ * N * 1 ^ 2) *
          (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
            ls.length * (∑ m ∈ Finset.range ls.length,
              compressionC (ap.cumBase cat hR hb).D m ^ 2)) *
          compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) +
        2 * ((1 + τ * N * 1 ^ 2) * ‖Z‖ ^ 2) := by
  have hC : (0 : ℝ) ≤ 1 + τ * N * 1 ^ 2 := by positivity
  have hBv : 0 ≤ 2 * (1 + τ * N * 1 ^ 2) *
      (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
        ls.length * (∑ m ∈ Finset.range ls.length,
          compressionC (ap.cumBase cat hR hb).D m ^ 2)) := by
    have : 0 ≤ ∑ m ∈ Finset.range ls.length, compressionC (ap.cumBase cat hR hb).D m ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    positivity
  set E := fun q : ι × ι' => columnL2Restriction (V := Fin ap.Mc)
    (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hEm : ∀ q : ι × ι', MeasurableSet (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2) :=
    fun q => Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2
  have hrows : ∀ x, ∑ q : ι × ι', ‖E q ((ap.padOutL cat hR hb r₀ j (grp q.1) p ls
      (A.R.1 + t q.2) - ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + r q.2)) x)‖ ^ 2 ≤
      (2 * (1 + τ * N * 1 ^ 2) *
        (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
          ls.length * (∑ m ∈ Finset.range ls.length,
            compressionC (ap.cumBase cat hR hb).D m ^ 2))) * ‖x‖ ^ 2 := by
    intro x
    have h := ap.attempt_variation_pad cat t₀ hT hR hb hanc grp hgrp k r₀ j hPH ls r t hrt hdis
      Ec hEc hcert hroot hτ hτ1 hHed hN p x
    exact le_trans (le_of_eq rfl) (h.trans (le_of_eq (by ring)))
  have hblk : ∀ (q : ι × ι') x, ‖E q ((ap.padOutL cat hR hb r₀ j (grp q.1) p ls
      (A.R.1 + t q.2) - ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + r q.2)) x)‖ ^ 2 =
      ∑ Q : {Q // Q ∈ (Ψ.partition (A.R.1 + r q.2)).cells},
        ‖E q ((ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + t q.2) -
          ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + r q.2))
          (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
            (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x))‖ ^ 2 := by
    intro q x
    have hdepth : ∀ Q ∈ (Ψ.partition (A.R.1 + r q.2)).cells, ∀ h : ℤ, A.R.1 + r q.2 ≤ h →
        h ≤ A.R.1 + t q.2 → Q.1 ≤ (ap.cumBase cat hR hb).depth h := by
      intro Q hQ h h1 h2
      have hQ1 := ((Ψ.mem_partition _ Q).mp hQ).1
      have hle : Ψ.depth (A.R.1 + r q.2) ≤ A.R.1 + r q.2 := by
        unfold ColumnDepthFamily.depth
        exact max_le (by omega) (min_le_left _ _)
      change Q.1 ≤ max A.R.1 (min h (A.R.1 + A.treeDepth))
      rw [hQ1]
      have := htd q.2
      exact le_trans hle (le_trans (le_min h1 (by have := hrt q.2; omega)) (le_max_right _ _))
    have h := Ψ.blk_of_commute (A.R.1 + r q.2) ((E q).comp
      (ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + t q.2) -
        ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + r q.2))) (fun y => ?_)
      (fun Q hQ => ?_) x
    · exact h
    · filter_upwards [columnL2Restriction_vanish _ (hEm q)
        ((ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + t q.2) -
          ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + r q.2)) y)] with z hz hzR
      refine hz fun hzE => hzR ?_
      rw [Set.mem_iUnion₂] at hzE
      obtain ⟨I, hI, hzI⟩ := hzE
      rw [hΨG]
      exact hΨR (A.sub I (hEc q.1 q.2 I hI).1 hzI)
    · have h1 := ap.padOutL_commute cat hR hb r₀ j (grp q.1) p ls (A.R.1 + t q.2) (Q := Q)
        (hdepth Q hQ _ (by have := hrt q.2; omega) le_rfl)
      have h2 := ap.padOutL_commute cat hR hb r₀ j (grp q.1) p ls (A.R.1 + r q.2) (Q := Q)
        (hdepth Q hQ _ le_rfl (by have := hrt q.2; omega))
      have hc := columnL2Restriction_comm (V := Fin ap.Mc) (hEm q)
        (dyadicGridCell_measurable A.G Q.1 Q.2)
      rw [hΨG, ContinuousLinearMap.comp_assoc, ContinuousLinearMap.sub_comp, ← h1, ← h2,
        ← ContinuousLinearMap.comp_sub,
        ← ContinuousLinearMap.comp_assoc, ← ContinuousLinearMap.comp_assoc, hc]
  have hjoint : ∑ q : ι × ι', ‖E q (ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + t q.2)
      (physEmbed V (Fin ap.Mc) ((Ψ.proj (A.R.1 + t q.2) - Ψ.proj (A.R.1 + r q.2)) Z)))‖ ^ 2 ≤
      (1 + τ * N * 1 ^ 2) * ‖Z‖ ^ 2 := by
    rw [Fintype.sum_prod_type, Finset.sum_comm]
    calc _ ≤ ∑ i : ι', (1 + τ * N * 1 ^ 2) *
            ‖physEmbed V (Fin ap.Mc) ((Ψ.proj (A.R.1 + t i) - Ψ.proj (A.R.1 + r i)) Z)‖ ^ 2 :=
          Finset.sum_le_sum fun i _ => ap.pad_joint cat t₀ hT hR hb grp hgrp k r₀ j hPH ls
            (A.R.1 + t i) (fun G => Ec G i) (fun G => hEc G i) (fun G => hcert G i) hroot hτ
            hτ1 hHed hN p _
      _ ≤ ∑ i : ι', (1 + τ * N * 1 ^ 2) *
            ‖(Ψ.proj (A.R.1 + t i) - Ψ.proj (A.R.1 + r i)) Z‖ ^ 2 :=
          Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left
            (pow_le_pow_left₀ (norm_nonneg _) (norm_physEmbed_apply_le _) 2) hC
      _ ≤ _ := by
          rw [← Finset.mul_sum]
          exact mul_le_mul_of_nonneg_left (Ψ.jumps_from_le hΨr r t hrt hdis Z) hC
  exact basic_variation Ψ E (fun q h => ap.padOutL cat hR hb r₀ j (grp q.1) p ls h)
    (fun q => A.R.1 + r q.2) (fun q => A.R.1 + t q.2) hBv (fun x => hrows x) hblk Z hjoint

/-! ### Variation of single cumulative pads over global histories (blueprint lines 2390-2391) -/

/-- A single cumulative pad projection composed with the global history (shared by all groups). -/
noncomputable def cpadOutL (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (p : Fin ap.P) (ls : List (ℕ × Bool)) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h).comp
    (globHist (ap.cumBase cat hR hb) (ap.cumMask cat hR hb) ls h)

/-- The rows of a cumulative pad jump split over the partition of its left depth. -/
theorem cum_blk (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (p : Fin ap.P) {hr ht : ℤ}
    (hrt : hr ≤ ht) (Ec : Finset (ℤ × ℤ)) (hEc : ∀ I ∈ Ec, I ∈ A.cells)
    (x : ColumnL2 (Fin ap.Mc)) :
    ‖((columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj ht -
          ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj hr)) x‖ ^ 2
      = ∑ Q : {Q // Q ∈ ((ap.cumBase cat hR hb).partition hr).cells},
        ‖((columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
          (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj ht -
            ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj hr))
          (columnL2Restriction (dyadicGridCell A.G Q.1.1 Q.1.2)
            (dyadicGridCell_measurable A.G Q.1.1 Q.1.2) x)‖ ^ 2 := by
  set Ψ := (ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)
  set Ψ0 := ap.cumBase cat hR hb
  set E := columnL2Restriction (V := Fin ap.Mc) (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hv := ap.restrict_union_vanish Ec hEc ((Ψ.proj ht - Ψ.proj hr) x)
  rw [ContinuousLinearMap.comp_apply, Ψ0.norm_sq_partition hr _ hv]
  refine Finset.sum_congr rfl fun Q _ => ?_
  have h1 := Ψ.proj_comm_restrict (h' := hr) (h := ht) hrt (Q := Q.1) Q.2
  have h2 := Ψ.proj_comm_restrict (h' := hr) (h := hr) le_rfl (Q := Q.1) Q.2
  have h3 := columnL2Restriction_comm (V := Fin ap.Mc)
    (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)
    (Finset.measurableSet_biUnion Ec fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  congr 2
  rw [ContinuousLinearMap.comp_apply, sub_apply, sub_apply, map_sub, map_sub]
  change (columnL2Restriction _ (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)).comp E
      (Ψ.proj ht x) - (columnL2Restriction _ (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)).comp E
      (Ψ.proj hr x) = _
  rw [h3, ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
    ← ContinuousLinearMap.comp_apply _ (Ψ.proj ht), ← ContinuousLinearMap.comp_apply _ (Ψ.proj hr)]
  change E (((columnL2Restriction _ (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2)).comp
    (Ψ.proj ht)) x) - E (((columnL2Restriction _
      (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2)).comp (Ψ.proj hr)) x) = _
  rw [← h1, ← h2, ← map_sub]
  rfl

/-- Blueprint lem:variation for one cumulative pad (shared by the groups): the single-pad outputs,
restricted at the right endpoints to unions of active cells, have square-summable variation over
disjoint depth intervals. -/
theorem cum_variation_pad (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) {ι' : Type*} [Fintype ι'] (m : ℕ) (p : Fin ap.P)
    (ls : List (ℕ × Bool)) (r t : ι' → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (Ec : ι' → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells)
    (z : ColumnL2 (Fin ap.Mc)) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.cpadOutL cat hR hb m p ls (A.R.1 + t i) z -
          ap.cpadOutL cat hR hb m p ls (A.R.1 + r i) z)‖ ^ 2 ≤
      2 * 1 * (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * ‖z‖ ^ 2 +
          ls.length * (∑ m ∈ Finset.range ls.length,
            compressionC (ap.cumBase cat hR hb).D m ^ 2) * ‖z‖ ^ 2) := by
  classical
  set Ψ0 := ap.cumBase cat hR hb
  set Am := ap.cumMask cat hR hb
  set Ψ := Ψ0.withMask (Am m p)
  set T := Finset.univ.sup t
  have ht : ∀ i, t i ≤ T := fun i => Finset.le_sup (f := t) (Finset.mem_univ i)
  have hone : ∀ (f : Unit × ι' → ColumnL2 (Fin ap.Mc)),
      ‖∑ k, f k‖ ^ 2 ≤ 1 * ∑ G : Unit, ‖∑ k ∈ (Finset.univ : Finset (Unit × ι')).filter
        (fun k => k.1 = G), f k‖ ^ 2 := fun f => by
    simp
  have hone' : ∀ (f : Unit → ColumnL2 (Fin ap.Mc)),
      ‖∑ G, f G‖ ^ 2 ≤ 1 * ∑ G : Unit, ‖∑ G' ∈ (Finset.univ : Finset Unit).filter
        (fun G' => G' = G), f G'‖ ^ 2 := fun f => by
    simp
  have key := certifiedVariation_gen (γ := Unit) T
    (fun _ n => Ψ.proj (A.R.1 + n))
    (fun _ n _ => ColumnDepthFamily.isStarProjection_proj _ _)
    (fun _ a _ b _ hab => ColumnDepthFamily.proj_nested _ (by omega))
    (fun _ i => columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2))
    (fun _ i y => columnL2Indicator_norm_le _ (Finset.measurableSet_biUnion _ fun I _ =>
      dyadicGridCell_measurable A.G I.1 I.2) y) r t hrt ht hdis
    (fun i => globHist Ψ0 Am ls (A.R.1 + t i) z) (fun i => globHist Ψ0 Am ls (A.R.1 + r i) z) z
    (G₀ := compressionC Ψ0.D ls.length ^ 2)
    (J := ls.length * (∑ m ∈ Finset.range ls.length, compressionC Ψ0.D m ^ 2) * ‖z‖ ^ 2)
    zero_le_one (fun x => hone _) ?_ (fun i x => hone' _)
    (globHist_jump Ψ0 ap.hP Am ls r t hrt hdis z)
  · refine le_trans (le_of_eq ?_) (key.trans (le_of_eq (by ring)))
    rw [Fintype.sum_prod_type, show (Finset.univ : Finset Unit) = {()} from rfl,
      Finset.sum_singleton]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [cpadOutL, ContinuousLinearMap.comp_apply, map_sub]
    rfl
  · intro c hc hB
    have h := globHist_compression Ψ0 ap.hP Am ls (fun q : Unit × ι' => A.R.1 + r q.2)
      (fun q => (columnL2Restriction (⋃ I ∈ Ec q.2, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        (Ψ.proj (A.R.1 + t q.2) - Ψ.proj (A.R.1 + r q.2))) hc hB
      (fun q x => ap.cum_blk cat hR hb m p (by have := hrt q.2; omega) (Ec q.2) (hEc q.2) x) z
    refine h.trans (le_of_eq ?_)
    ring

/-- The cumulative single-pad output commutes with the restrictions to cells at most as deep as
its depth. -/
theorem cpadOutL_commute (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (p : Fin ap.P) (ls : List (ℕ × Bool)) (h : ℤ)
    {Q : ℤ × ℤ} (hQ : Q.1 ≤ (ap.cumBase cat hR hb).depth h) :
    (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (ap.cpadOutL cat hR hb m p ls h) =
    (ap.cpadOutL cat hR hb m p ls h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)) := by
  set rQ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G Q.1 Q.2)
    (dyadicGridCell_measurable A.G Q.1 Q.2)
  have hpad : (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h).comp rQ =
      rQ.comp (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h) :=
    (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj_commute_restrict h
      hQ).symm
  have hcum : ∀ m, (opAvg fun p : Fin ap.P =>
      ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h).comp rQ =
      rQ.comp (opAvg fun p : Fin ap.P =>
        ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h) := fun m =>
    opAvg_commute _ _ fun p =>
      (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj_commute_restrict h
        hQ).symm
  have hhist := layerOp_commute _ rQ hcum ls
  unfold cpadOutL globHist
  rw [← ContinuousLinearMap.comp_assoc, ← hpad, ContinuousLinearMap.comp_assoc,
    ContinuousLinearMap.comp_assoc, hhist]

/-- Blueprint lem:variation for one cumulative pad acting on a basic projection (shared by the
groups). -/
theorem cum_variation_basic_pad (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (p : Fin ap.P) (ls : List (ℕ × Bool))
    {ι : Type*} [Fintype ι] (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (htd : ∀ i, t i ≤ A.treeDepth) (Ec : ι → Finset (ℤ × ℤ))
    (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells) {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V)
    (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.cpadOutL cat hR hb m p ls (A.R.1 + t i)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + t i) Z)) -
          ap.cpadOutL cat hR hb m p ls (A.R.1 + r i)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + r i) Z)))‖ ^ 2 ≤
      2 * (2 * 1 * (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
            ls.length * (∑ m ∈ Finset.range ls.length,
              compressionC (ap.cumBase cat hR hb).D m ^ 2)) *
          compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) + 2 * ‖Z‖ ^ 2 := by
  set B := 2 * 1 * (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
    ls.length * (∑ m ∈ Finset.range ls.length, compressionC (ap.cumBase cat hR hb).D m ^ 2))
  have hB : 0 ≤ B := by
    have : 0 ≤ ∑ m ∈ Finset.range ls.length, compressionC (ap.cumBase cat hR hb).D m ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    positivity
  set E := fun i => columnL2Restriction (V := Fin ap.Mc) (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hEm : ∀ i, MeasurableSet (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2) := fun i =>
    Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2
  have hrows : ∀ x, ∑ i, ‖E i ((ap.cpadOutL cat hR hb m p ls (A.R.1 + t i) -
      ap.cpadOutL cat hR hb m p ls (A.R.1 + r i)) x)‖ ^ 2 ≤ B * ‖x‖ ^ 2 := by
    intro x
    have h := ap.cum_variation_pad cat hR hb m p ls r t hrt hdis Ec hEc x
    refine le_trans (le_of_eq ?_) (h.trans (le_of_eq (by simp only [B]; ring)))
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [sub_apply]
  have hblk : ∀ i x, ‖E i ((ap.cpadOutL cat hR hb m p ls (A.R.1 + t i) -
      ap.cpadOutL cat hR hb m p ls (A.R.1 + r i)) x)‖ ^ 2 =
      ∑ Q : {Q // Q ∈ (Ψ.partition (A.R.1 + r i)).cells},
        ‖E i ((ap.cpadOutL cat hR hb m p ls (A.R.1 + t i) -
          ap.cpadOutL cat hR hb m p ls (A.R.1 + r i))
          (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
            (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x))‖ ^ 2 := by
    intro i x
    have hdepth : ∀ Q ∈ (Ψ.partition (A.R.1 + r i)).cells, ∀ h : ℤ, A.R.1 + r i ≤ h →
        h ≤ A.R.1 + t i → Q.1 ≤ (ap.cumBase cat hR hb).depth h := by
      intro Q hQ h h1 h2
      have hQ1 := ((Ψ.mem_partition _ Q).mp hQ).1
      have hle : Ψ.depth (A.R.1 + r i) ≤ A.R.1 + r i := by
        unfold ColumnDepthFamily.depth
        exact max_le (by omega) (min_le_left _ _)
      change Q.1 ≤ max A.R.1 (min h (A.R.1 + A.treeDepth))
      rw [hQ1]
      have := htd i
      exact le_trans hle (le_trans (le_min h1 (by have := hrt i; omega)) (le_max_right _ _))
    have h := Ψ.blk_of_commute (A.R.1 + r i) ((E i).comp
      (ap.cpadOutL cat hR hb m p ls (A.R.1 + t i) - ap.cpadOutL cat hR hb m p ls (A.R.1 + r i)))
      (fun y => ?_) (fun Q hQ => ?_) x
    · exact h
    · filter_upwards [columnL2Restriction_vanish _ (hEm i)
        ((ap.cpadOutL cat hR hb m p ls (A.R.1 + t i) -
          ap.cpadOutL cat hR hb m p ls (A.R.1 + r i)) y)] with z hz hzR
      refine hz fun hzE => hzR ?_
