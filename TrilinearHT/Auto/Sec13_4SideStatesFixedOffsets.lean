open Classical in
/-- The used cells of group `G` at depth `R.1 + s`: the cells of `Sc` at that depth whose groups
contain `G`. -/
noncomputable def usedCells (Sc : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (G : A.Grp)
    (s : ℕ) : Finset (ℤ × ℤ) :=
  Sc.filter fun I => I.1 = A.R.1 + s ∧ G ∈ gs I

