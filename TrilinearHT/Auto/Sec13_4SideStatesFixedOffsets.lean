variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- Blueprint `eq:sides` (line 2125) for a basic slot: the rolling part `Z_s - Z_{u_b}` of the
leaf ball outputs at a used cell `I` and its decision cell `U ⊇ I` is the restriction to `I` of
the difference of the global ball outputs at the two depths. -/
theorem rolling_eq_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool))
    {I U : ℤ × ℤ} (hI : I ∈ A.cells) (hU : U ∈ A.cells)
    (hIU : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G U.1 U.2)
    {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V) (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ap.ballAt cat r j G I (layerOp (ap.cumAt cat I) ls
        (physicalColumnInput (cellLp A.G I (Ψ.currentZ Z I)))) -
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (ap.ballAt cat r j G U (layerOp (ap.cumAt cat U) ls
          (physicalColumnInput (cellLp A.G U (Ψ.currentZ Z U))))) =
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (ap.globOut cat hR hb r j G ls I.1 (physEmbed V (Fin ap.Mc) (Ψ.proj I.1 Z)) -
        ap.globOut cat hR hb r j G ls U.1 (physEmbed V (Fin ap.Mc) (Ψ.proj U.1 Z))) := by
  rw [ap.leaf_ball_eq_globOut cat hR hb r j G ls hI Ψ hΨG hΨR hΨr Z,
    ap.leaf_ball_eq_globOut cat hR hb r j G ls hU Ψ hΨG hΨR hΨr Z, map_sub]
  congr 1
  have h := columnL2Restriction_comp_of_subset (V := Fin ap.Mc)
    (dyadicGridCell_measurable A.G I.1 I.2) (dyadicGridCell_measurable A.G U.1 U.2) hIU
  rw [← ContinuousLinearMap.comp_apply, h]

end AttemptParams

namespace AttemptParams

open Classical in
/-- Blueprint lines 2120-2154 (`eq:sides`, `eq:core-side-error`, `offset-selection`) for one
search leaf: given the block schedule, side parameters, pre-cells and basic `U` slots, there is a
core/side/error split whose mode systems are those of `leaf_modes` (with the catalog structure
on all setup cells), whose frozen coefficients reproduce the lifted decision-cell outputs exactly on
every pre-cell (hence every mode-span projection of the lifted
decision-cell outputs on the pre-cells, and whose physical lift errors at the decision cells obey
the first-moment majorant. -/
theorem exists_leafSplit (κ : LocalKernelClass) (c₀ : ℕ) :
    ∃ Dc : ℕ, 1 ≤ Dc ∧ ∀ (A : ActiveSetup κ c₀) (ap : A.AttemptParams)
      (cat : Fin 4 → List (CatCol A.Vtx))
      (_hT : ∀ l, ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
        d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag)
      (S : ModeSchedule) (_hA : 6 ≤ S.A0) (SP : SideParams)
      (cells : Fin 4 → A.Grp → ℤ → Finset (ℤ × ℤ)) (usl : Fin 4 → Prop) (r j : Fin 4 → ℕ)
      (gset : Finset A.Grp) (cen : A.Grp → Fin ap.K.d0 × A.Vtx × ℤ)
      (_hcen : ∀ G ∈ gset, G.2.1 = some (cen G)) (G₀ : A.Grp) (_hG₀ : G₀ ∈ gset)
      (_hHed : 2 ≤ ap.Hed) {dB : ℕ} (_hdim : ∀ w : A.Vtx, (A.vtag w).dim ≤ dB)
      (_hC : ∀ (w : A.Vtx) a c, (rationalHeight ((A.vtag w).C a c) : ℝ) ≤ ap.Hed)
      {δ : ℝ} (_hδ : 0 < δ) (_hδ' : δ ≤ 1 / 8) (_hdδ : ∀ w : A.Vtx, 8 * (A.vtag w).dim * δ ≤ 1)
      {H : ℝ} (_hHs : A.Hsrc ≤ H) (_hdz : ∀ w : A.Vtx, ((A.vtag w).dim : ℝ) ≤ Real.log H)
      (_hCz : ∀ (l : Fin 4) (w : A.Vtx) i k,
        (chartRationalHeight ((((-slotCoeff l : ℤ) : ℚ) • (A.vtag w).C) i k) : ℝ) ≤ H)
      (_hHδ : ∀ w : A.Vtx, ((A.vtag w).dim : ℝ) * (bumpConst * 8 ^ 32 * (2 / δ)) ≤ H)
      {δc : ℝ} (_hδc : 0 < δc) (_hδcM : δc ^ 2 * ap.Mc ≤ 1)
      (Us : A.Grp → Finset (ℤ × ℤ)) (xs : Fin 4 → A.Grp → ℤ × ℤ → ColumnL2 (Fin ap.Mc))
      {Kx : ℝ} (_hKx : 0 ≤ Kx)
      (_hK : ∀ l, ∀ G ∈ gset, ∀ U ∈ Us G, ap.Mc * ‖xs l G U‖ ^ 2 / dyadicGridLength A.G U.1 ≤ Kx),
      ∃ D : ap.LeafSplit, D.S = S ∧ D.SP = SP ∧ D.cells = cells ∧ D.usl = usl ∧
        (∀ l, ∀ G ∈ gset, (D.Ms l G).zc = A.vtag (cen G).2.1 ∧ (D.Ms l G).δc = δ ∧
          (D.Ms l G).cl = slotCoeff l ∧ (∀ Φ, (D.Ms l G).L.εP Φ = 1) ∧
          (D.Ms l G).L.δ = δc ∧ (∀ k, (D.Ms l G).dvOf k ≤ dB) ∧
          (∀ k, (D.Ms l G).ρ k ∈ Set.Icc (0 : ℝ) 1) ∧
          (D.Ms l G).Λ = Real.exp (Dc * ap.modeX dB H (cen G).2.2 (j l) (ap.P - 1) ^ Dc) ∧
          ∀ y, ((Finset.univ.filter fun m =>
              y ∈ dyadicGridCell A.G ((D.Ms l G).cellOf m).1 ((D.Ms l G).cellOf m).2).card : ℝ) ≤
            ap.Mc * modeCount Dc (ap.modeX dB H (cen G).2.2 (j l) (ap.P - 1)) δc dB) ∧
        (∀ l, ∀ G ∈ gset, ∀ (b : ℤ) (J : ℤ × ℤ), ancAt A.G J (b - 4 * S.K) ∈ A.cells →
          b - 4 * S.K ≤ J.1 →
          columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
              ((D.Ms l G).L.op (ap.ballAt (cat l) (r l) (j l) G (ancAt A.G J (b - 4 * S.K))
                (xs l G (ancAt A.G J (b - 4 * S.K))))) =
