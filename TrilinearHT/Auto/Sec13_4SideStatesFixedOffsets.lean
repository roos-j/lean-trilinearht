/-! ### Size cuts from integrated budgets (blueprint lines 2163-2166) -/

/-- A sum over a union of finite sets of nonnegative terms is at most the sum of the sums. -/
theorem sum_biUnion_le_of_nonneg {α β : Type*} [DecidableEq β] (s : Finset α) (t : α → Finset β)
    (f : β → ℝ) (hf : ∀ b, 0 ≤ f b) :
    ∑ b ∈ s.biUnion t, f b ≤ ∑ a ∈ s, ∑ b ∈ t a, f b := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih =>
    rw [Finset.biUnion_insert, Finset.sum_insert ha]
    have h := Finset.sum_union_inter (s₁ := t a) (s₂ := s.biUnion t) (f := f)
    have h0 : 0 ≤ ∑ b ∈ t a ∩ s.biUnion t, f b := Finset.sum_nonneg fun b _ => hf b
    linarith

open Classical in
/-- Blueprint lines 2163-2166 (`lem:cuts` applied to integrated budgets, per cell): if nonnegative
cell weights `w` of the used cells have total at most `B`, the cells whose weight exceeds
`T |I|` form a cut family of total length at most `B / T`, and every used cell outside it has
weight at most `T |I|`. -/
theorem cut_of_budget (Gd : RealDyadicGrid) {ι : Type*} [Fintype ι] (Sd : Finset ℕ)
    (E : ι → ℕ → Finset (ℤ × ℤ)) (w : ι → ℕ → ℤ × ℤ → ℝ) (hw : ∀ G s I, 0 ≤ w G s I)
    {B T : ℝ} (hT : 0 < T) (hB : ∑ G, ∑ s ∈ Sd, ∑ I ∈ E G s, w G s I ≤ B) :
    ∃ F : Finset (ℤ × ℤ), dyadicRootLength Gd F ≤ B / T ∧
      (∀ c ∈ F, ∃ G, ∃ s ∈ Sd, c ∈ E G s) ∧
      ∀ G, ∀ s ∈ Sd, ∀ I ∈ E G s, I ∉ F → w G s I ≤ T * dyadicGridLength Gd I.1 := by
  set F := (Finset.univ ×ˢ Sd).biUnion fun q : ι × ℕ =>
    (E q.1 q.2).filter fun I => T * dyadicGridLength Gd I.1 < w q.1 q.2 I
  refine ⟨F, ?_, fun c hc => ?_, fun G s hs I hI hIF => ?_⟩
  · unfold dyadicRootLength
    refine (sum_biUnion_le_of_nonneg _ _ _
      fun c : ℤ × ℤ => (dyadicGridLength_pos Gd c.1).le).trans ?_
    rw [le_div_iff₀ hT, Finset.sum_product, Finset.sum_mul]
    refine le_trans (Finset.sum_le_sum fun G _ => ?_) hB
    rw [Finset.sum_mul]
    refine Finset.sum_le_sum fun s _ => ?_
    rw [Finset.sum_mul]
    calc _ ≤ ∑ I ∈ (E G s).filter (fun I => T * dyadicGridLength Gd I.1 < w G s I), w G s I :=
          Finset.sum_le_sum fun I hI => by
            have := (Finset.mem_filter.mp hI).2
            linarith [mul_comm (dyadicGridLength Gd I.1) T]
      _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
          fun I _ _ => hw G s I
  · obtain ⟨q, hq, hc⟩ := Finset.mem_biUnion.mp hc
    exact ⟨q.1, q.2, (Finset.mem_product.mp hq).2, (Finset.mem_filter.mp hc).1⟩
  · by_contra h
    exact hIF (Finset.mem_biUnion.mpr ⟨(G, s), Finset.mem_product.mpr ⟨Finset.mem_univ _, hs⟩,
      Finset.mem_filter.mpr ⟨hI, lt_of_not_ge h⟩⟩)

