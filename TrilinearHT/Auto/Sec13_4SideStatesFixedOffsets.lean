        ∀ l, ∑ G ∈ gset, ∑ U ∈ Us G, ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
            (‖(ap.ballAt (cat l) (r l) (j l) G U (xs l G U) : ℝ → ColumnHilbert (Fin ap.Mc)) y
