theorem leaf_basic_side_mass (hK1 : 1 ≤ D.S.K) (cat : Fin 4 → List (CatCol A.Vtx)) (s₀ : ℕ)
    (l : Fin 4) (hl : ¬ D.usl l) (t₀ : Fin 4)
