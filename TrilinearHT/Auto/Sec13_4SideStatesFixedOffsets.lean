/-- Blueprint lines 2163-2164 (the basic inputs are bounded): the leaf outputs of a basic pattern
have size at most `(S + |L| D_c) √|I|`. -/
theorem leafOut_size (cat : Fin 4 → List (CatCol A.Vtx)) (s : ℕ) (I : ℤ × ℤ) (l : Fin 4)
    (G : A.Grp) {B₀ : ℝ} (hB₀ : 0 ≤ B₀) (hm : MemLp (ap.z I l) 2 (A.μ I))
    (hb : (eLpNorm (ap.z I l) 2 (A.μ I)).toReal ≤ B₀) :
    ‖ap.leafOut cat s I l G‖ ≤ B₀ * Real.sqrt (dyadicGridLength A.G I.1) :=
  ap.leafOut_size_le (cat l) _ _ G I _ hm hB₀ hb

/-- In a basic slot, the leaf output at a cell is the restriction of the difference of the global
outputs of the two basic projections. -/
theorem leafOut_eq_projOut (cat : Fin 4 → List (CatCol A.Vtx)) (s : ℕ) (l : Fin 4)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat l, d.birth ∈ A.cells) (G : A.Grp) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) (hz : ap.z I l = A.B l I) {CF : ℝ} (P₁ P₂ : BasicProjection A.G A.R CF)
    (hP : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → A.B l I y = P₁.val I y - P₂.val I y) :
    ap.leafOut cat s I l G =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (ap.projOut (cat l) hR hb (ap.leafR s l) (ap.leafJ s l) G
            ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₁ I.1 -
          ap.projOut (cat l) hR hb (ap.leafR s l) (ap.leafJ s l) G
            ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₂ I.1) := by
  have hr : ∀ P : BasicProjection A.G A.R CF, P.Ψ.D.root.1 ≤ A.R.1 := fun P =>
    dyadicGridCell_depth_le_of_subset A.G A.R P.Ψ.D.root P.root_sub
  unfold leafOut projOut
  rw [ap.leafIn_eq_sub cat s l I hz P₁ P₂ hP, map_sub, map_sub,
    ap.leaf_ball_eq_globOut (cat l) hR hb _ _ G _ hI P₁.Ψ P₁.grid P₁.root_sub (hr P₁),
    ap.leaf_ball_eq_globOut (cat l) hR hb _ _ G _ hI P₂.Ψ P₂.grid P₂.root_sub (hr P₂)]

/-- Blueprint `eq:sides` (rolling part): on a cell `I` inside a cell `U` (both basic in the slot),
the leaf output at `I` minus the restriction of the leaf output at `U` is the restriction of the
rolling difference of the global outputs of the two basic projections. -/
theorem leaf_rolling_eq (cat : Fin 4 → List (CatCol A.Vtx)) (s : ℕ) (l : Fin 4)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat l, d.birth ∈ A.cells) (G : A.Grp) {I U : ℤ × ℤ}
    (hI : I ∈ A.cells) (hU : U ∈ A.cells)
    (hIU : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G U.1 U.2)
    (hzI : ap.z I l = A.B l I) (hzU : ap.z U l = A.B l U) {CF : ℝ}
    (P₁ P₂ : BasicProjection A.G A.R CF)
    (hPI : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → A.B l I y = P₁.val I y - P₂.val I y)
    (hPU : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G U.1 U.2 → A.B l U y = P₁.val U y - P₂.val U y) :
    ap.leafOut cat s I l G - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (ap.leafOut cat s U l G) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        ((ap.projOut (cat l) hR hb (ap.leafR s l) (ap.leafJ s l) G
            ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₁ I.1 -
          ap.projOut (cat l) hR hb (ap.leafR s l) (ap.leafJ s l) G
            ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₁ U.1) -
         (ap.projOut (cat l) hR hb (ap.leafR s l) (ap.leafJ s l) G
            ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₂ I.1 -
          ap.projOut (cat l) hR hb (ap.leafR s l) (ap.leafJ s l) G
            ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₂ U.1)) := by
  rw [ap.leafOut_eq_projOut cat s l hR hb G hI hzI P₁ P₂ hPI,
    ap.leafOut_eq_projOut cat s l hR hb G hU hzU P₁ P₂ hPU]
  have hc := congrArg (fun T => T (ap.projOut (cat l) hR hb (ap.leafR s l) (ap.leafJ s l) G
            ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₁ U.1 -
          ap.projOut (cat l) hR hb (ap.leafR s l) (ap.leafJ s l) G
            ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₂ U.1))
    (columnL2Restriction_comp_of_subset (V := Fin ap.Mc) (dyadicGridCell_measurable A.G I.1 I.2)
      (dyadicGridCell_measurable A.G U.1 U.2) hIU)
  simp only [ContinuousLinearMap.comp_apply] at hc
  rw [hc, ← map_sub]
  congr 1
  abel

