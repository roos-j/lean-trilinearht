        (fp.basicOut l s mb (grp G) j ls (A.R.1 + t) -
          fp.frozenZ l s mb (grp G) j ls (A.R.1 + ((S.K * (t / S.K) : ℕ) : ℤ) - 4 * S.K))‖ ^ 2 +
