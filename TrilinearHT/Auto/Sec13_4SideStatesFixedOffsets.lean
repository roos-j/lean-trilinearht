    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × (bf.Lab ⊕ Fin fp.Mc))).filter fun q =>
      ∃ I ∈ A.cells, (∃ k', fp.Cert k' (grp q.1) I) ∧
