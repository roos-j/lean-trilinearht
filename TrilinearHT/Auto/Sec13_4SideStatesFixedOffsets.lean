open Classical in
/-- Blueprint `eq:side-cap` (lines 2159-2166) for the basic `B` role of one ball level, rank and
color of the attempt: with the side states `S_{G,s} = Z_{G,s} - Z_{G,u(s)} + V_{G,b(s)}` measured on
the certified active cells of depth `s` (weights `2‖1_I (Z_s - Z_{u(s)})‖²/|I| + 2‖1_I V‖²/|I|`
summed over the groups), one first-crossing cut of total length at most `ρ|R|` makes every retained
path sum of side weights at most `(2 M B_var + 2 K B_lin) / (ρ |R|)`, where `B_var` is the
variation bound (`eq:variation`) and `B_lin` the linear-side energy (`eq:linear-energy`). -/
theorem attempt_side_caps (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (ls : List (ℕ × Bool)) (Sd : Finset ℕ) (u : ℕ → ℕ) (hu : ∀ s, u s ≤ s) {M : ℕ}
    (hM : ∀ s, s - u s < M) (Sc : Finset (ℤ × ℤ)) (Ec : ι → ℕ → Finset (ℤ × ℤ))
    (hsub : ∀ G s, Ec G s ⊆ Sc)
    (hEc : ∀ G s, ∀ I ∈ Ec G s, I ∈ A.cells ∧ I.1 = A.R.1 + s)
    (hcert : ∀ G s, ∀ I ∈ Ec G s, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    (z : ColumnL2 (Fin ap.Mc)) {Vt : ι → Type*} [∀ G, Fintype (Vt G)]
    (Vs : ∀ G, ℤ → ColumnL2 (Vt G)) (blk : ℕ → ℤ) {K : ℕ}
    (hK : ∀ b, (Sd.filter fun s => blk s = b).card ≤ K) (Bs : Finset ℤ)
    (hBs : ∀ s ∈ Sd, blk s ∈ Bs) {Blin : ℝ} (hlin : ∑ G, ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 ≤ Blin)
    (hSc : ∀ I ∈ Sc, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G A.R.1 A.R.2)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    let Bvar := M * (2 * (1 + τ * N * 1 ^ 2) *
      (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * ‖z‖ ^ 2 +
        ls.length * (∑ m ∈ Finset.range ls.length,
          compressionC (ap.cumBase cat hR hb).D m ^ 2) * ‖z‖ ^ 2))
    let a : Bool → ℤ × ℤ → ℝ := fun v I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
      (if v then 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)
          (ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + s) z -
            ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + u s) z)‖ ^ 2
      else 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (Vs G (blk s))‖ ^ 2) /
          dyadicGridLength A.G I.1 else 0
    let T := (2 * Bvar / dyadicGridLength A.G A.R.1 + 2 * (K * Blin) /
      dyadicGridLength A.G A.R.1) / ρ
    dyadicRootLength A.G (dyadicFirstCrossings A.G Sc (fun I => ∑ v, a v I) T) ≤
        ρ * dyadicGridLength A.G A.R.1 ∧
      ∀ x : ℝ, dyadicRealPathSum A.G (dyadicRetainedCells A.G Sc (fun I => ∑ v, a v I) T)
        (fun I => ∑ v, a v I) x ≤ T := by
  intro Bvar a T
  have hL := dyadicGridLength_pos A.G A.R.1
  have hdis : ∀ G s, Set.PairwiseDisjoint (Ec G s : Set (ℤ × ℤ))
      fun I => dyadicGridCell A.G I.1 I.2 := fun G s =>
    cells_pairwiseDisjoint_of_depth A.G (Ec G s) fun I hI => (hEc G s I hI).2
  -- the rolling budget
  have hroll : dyadicWeightedMass A.G Sc (a true) ≤ 2 * Bvar := by
    have hm := cell_weights_mass A.G Sc (V := fun _ => Fin ap.Mc) Sd Ec hsub hdis
      (fun G s => ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + s) z -
        ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + u s) z)
    have hv := ap.attempt_rolling_variation cat t₀ hT hR hb hanc grp hgrp k r₀ j hPH ls Sd u hu
      hM Ec hEc hcert hroot hτ hτ1 hHed hN z
    have e : dyadicWeightedMass A.G Sc (a true) = 2 * dyadicWeightedMass A.G Sc
        (fun I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
          ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2)
            (ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + s) z -
              ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + u s) z)‖ ^ 2 /
            dyadicGridLength A.G I.1 else 0) := by
      unfold dyadicWeightedMass
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [a, ↓reduceIte, Finset.mul_sum]
      refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun s _ => ?_
      split_ifs <;> ring
    rw [e, hm, Finset.sum_comm]
    exact mul_le_mul_of_nonneg_left hv (by norm_num)
  -- the fixed budget
  have hfix : dyadicWeightedMass A.G Sc (a false) ≤ 2 * (K * Blin) := by
    have hm := cell_weights_mass A.G Sc (V := Vt) Sd Ec hsub hdis (fun G s => Vs G (blk s))
    have e : dyadicWeightedMass A.G Sc (a false) = 2 * dyadicWeightedMass A.G Sc
        (fun I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
          ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2) (Vs G (blk s))‖ ^ 2 /
            dyadicGridLength A.G I.1 else 0) := by
      unfold dyadicWeightedMass
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [a, Bool.false_eq_true, ↓reduceIte, Finset.mul_sum]
      refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun s _ => ?_
      split_ifs <;> ring
    rw [e, hm]
    refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
    calc ∑ G, ∑ s ∈ Sd, ‖columnL2Restriction (⋃ I ∈ Ec G s, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
            (Vs G (blk s))‖ ^ 2 ≤ ∑ G, ∑ s ∈ Sd, ‖Vs G (blk s)‖ ^ 2 :=
          Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun s _ =>
            pow_le_pow_left₀ (norm_nonneg _) (columnL2Indicator_norm_le _
              (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
              (Vs G (blk s))) 2
      _ ≤ ∑ G, K * ∑ b ∈ Sd.image blk, ‖Vs G b‖ ^ 2 :=
          Finset.sum_le_sum fun G _ => sum_comp_le_mul Sd blk (fun b => ‖Vs G b‖ ^ 2)
            (fun _ => sq_nonneg _) (fun b => by convert hK b)
      _ ≤ ∑ G, K * ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 := by
          refine Finset.sum_le_sum fun G _ => mul_le_mul_of_nonneg_left
            (Finset.sum_le_sum_of_subset_of_nonneg (fun b hb' => ?_) fun _ _ _ => sq_nonneg _)
            (by positivity)
          obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hb'
          exact hBs s hs
      _ = K * ∑ G, ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 := by rw [Finset.mul_sum]
      _ ≤ K * Blin := mul_le_mul_of_nonneg_left hlin (by positivity)
  have hcaps := side_caps_of_budgets A.G Sc a (fun v I _ => ?_) A.R hSc
    (fun v => if v then 2 * Bvar / dyadicGridLength A.G A.R.1
      else 2 * (K * Blin) / dyadicGridLength A.G A.R.1) (fun v => ?_) hρ hρ1
  · have hsum : (∑ v : Bool, if v then 2 * Bvar / dyadicGridLength A.G A.R.1
        else 2 * (K * Blin) / dyadicGridLength A.G A.R.1) =
        2 * Bvar / dyadicGridLength A.G A.R.1 + 2 * (K * Blin) / dyadicGridLength A.G A.R.1 := by
      rw [Fintype.sum_bool]; simp only [↓reduceIte, Bool.false_eq_true]
    rw [hsum] at hcaps
    exact hcaps
  · refine Finset.sum_nonneg fun G _ => Finset.sum_nonneg fun s _ => ?_
    have := dyadicGridLength_pos A.G I.1
    split_ifs <;> positivity
  · cases v
    · simp only [Bool.false_eq_true, ↓reduceIte]
      rw [div_mul_cancel₀ _ hL.ne']; exact hfix
    · simp only [↓reduceIte]
      rw [div_mul_cancel₀ _ hL.ne']; exact hroll

