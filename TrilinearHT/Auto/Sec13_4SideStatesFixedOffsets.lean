    (fp.retainedV (grp G) (A.R.1 + (b : ℤ)) S.K) (c G (A.R.1 + (b : ℤ)))‖ ^ 2
  -- each term: the rolling part and the side subtotal
  have hterm : ∀ t G, ‖columnL2Restriction (⋃ I ∈ Ec G t, dyadicGridCell A.G I.1 I.2)
