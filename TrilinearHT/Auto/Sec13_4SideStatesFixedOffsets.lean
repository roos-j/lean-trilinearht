open Classical in
/-- Blueprint lines 2163-2166 on one cell (regular or not): if the output has size at most
`B₀ √|I|` and, on a regular cell, the rolling part and the linear side have total square at most
`T |I|`, the physical parts of the core, side and error pieces have size at most
`B_s √|I|` with `B_s = 8 (B₀ + √T)`. -/
theorem cell_piece_sizes (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (Zout ZU : ColumnL2 (Fin ap.Mc))
    {B₀ T : ℝ} (hB₀ : 0 ≤ B₀) (hT : 0 ≤ T)
    (hout : ‖Zout‖ ≤ B₀ * Real.sqrt (dyadicGridLength A.G I.1))
    (hreg : ¬ (D.usl l ∨ ¬ D.hasDecision I) →
      ‖Zout - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) ZU‖ ^ 2 + ‖D.linSide l G I‖ ^ 2 ≤
        T * dyadicGridLength A.G I.1) :
    ‖π (D.core l G I ZU)‖ ≤ 8 * (B₀ + Real.sqrt T) * Real.sqrt (dyadicGridLength A.G I.1) ∧
    ‖π (D.side l G I Zout ZU)‖ ≤ 8 * (B₀ + Real.sqrt T) * Real.sqrt (dyadicGridLength A.G I.1) ∧
