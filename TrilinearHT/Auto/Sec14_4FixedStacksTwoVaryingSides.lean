noncomputable def gPre (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) (h : ℤ) : List (TransferStep (ColumnL2 (Fin ap.Mc))) :=
  ((D.take j).map fun e => ap.gStep cat hcat hR hbc hbh rH s c d G e h).map padStep

open Classical in
/-- The near band sum of the step `j` at the offset `o` of a descriptor list, with the global
steps, inputs and spectators at the depth `h`, in the cell form of `I`. -/
noncomputable def nearTermG (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (a c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {CF : ℝ} (P₁c P₂c P₁d P₂d : BasicProjection A.G A.R CF)
    (I : ℤ × ℤ) (h : ℤ) (xg : Fin 4 → ColumnL2 (Fin ap.Mc)) (xa : ColumnL2 (Fin ap.Mc))
    (j o : ℕ) : ℂ :=
  let st := ap.gSt cat hcat hR hbc hbh rH s c d G D j h
  let R := ap.gRest cat hcat hR hbc hbh rH s c d G D j h
  let H := helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j h) xa
  let V := chainVal ap.P st.1 R (if st.1 then ap.gIn P₁c P₂c h else ap.gIn P₁d P₂d h)
  ∑ p ∈ (Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o - 2 ≤ ap.P),
    ap.Λc I (Function.update (Function.update (Function.update (Function.update xg c
      (chainVal ap.P true R (ap.gIn P₁c P₂c h))) d (chainVal ap.P false R (ap.gIn P₁d P₂d h)))
        a (st.2.1 (p + 1) H - st.2.1 p H)) (if st.1 then c else d)
          (st.2.2 (p + o - 2 + 1) V - st.2.2 (p + o - 2) V))

open Classical in
/-- The global near band sum of the step `j` at the offset `o` is the near band form with the
slots `e` (the complement slot of the step) and `f` (the other complement slot). -/
theorem nearTermG_eq (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) {a b c d : Fin 4} (hab : a ≠ b)
    (hac : a ≠ c) (had : a ≠ d) (hbc' : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {CF : ℝ} (P₁c P₂c P₁d P₂d : BasicProjection A.G A.R CF)
    (I : ℤ × ℤ) (h : ℤ) (xg : Fin 4 → ColumnL2 (Fin ap.Mc)) (xa : ColumnL2 (Fin ap.Mc))
    (j o : ℕ) (z : Fin 4 → ColumnL2 (Fin ap.Mc)) :
    ap.nearTermG cat hcat hR hbc hbh rH s a c d G D P₁c P₂c P₁d P₂d I h xg xa j o =
      ap.nearForm I a b (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).1 then c else d) (if
          (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).1 then d else c) z
        ((Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o - 2 ≤ ap.P))
        (fun p => (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).2.1 (p + 1) (helpPre ap.P (ap.gPre
            cat hcat hR hbc hbh rH s c d G D j h) xa) - (ap.gSt cat hcat hR hbc hbh rH s c d G D j
            h).2.1 p (helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j h) xa))
        (fun p => (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).2.2 (p + o - 2 + 1) (chainVal ap.P
            (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).1 (ap.gRest cat hcat hR hbc hbh rH s c d G
            D j h) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).1 then ap.gIn P₁c P₂c h else
            ap.gIn P₁d P₂d h)) - (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).2.2 (p + o - 2)
            (chainVal ap.P (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).1 (ap.gRest cat hcat hR hbc
            hbh rH s c d G D j h) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).1 then ap.gIn
            P₁c P₂c h else ap.gIn P₁d P₂d h))) (xg b)
        (chainVal ap.P (!(ap.gSt cat hcat hR hbc hbh rH s c d G D j h).1) (ap.gRest cat hcat hR hbc
            hbh rH s c d G D j h) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).1 then ap.gIn
            P₁d P₂d h else ap.gIn P₁c P₂c h)) := by
  unfold nearTermG nearForm
  refine Finset.sum_congr rfl fun p _ => ?_
  congr 1
  funext l
  have hl4 := fin4_last a b c d l hab hac had hbc' hbd hcd
  simp only [Function.update_apply]
  generalize (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).1 = v
  cases v <;> simp only [Bool.false_eq_true, ite_true, ite_false, Bool.not_true,
    Bool.not_false] <;> split_ifs <;> simp_all

/-- The helper masks of a descriptor list are nested in the pad index. -/
theorem hMask_nested (hcat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
