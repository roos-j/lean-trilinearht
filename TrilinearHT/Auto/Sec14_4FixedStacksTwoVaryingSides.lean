section BandCellBound

/-- Blueprint line 2393 (flags): if the current values `Y_c, F_c` have squares at most `C₀² L`
and one frozen value `Y_b` or `F_b` has square more than `4 C₀² L`, the squared differences are at
least `C₀² L`. -/
theorem flag_band_one {E : Type*} [SeminormedAddCommGroup E] {β : Type*} (u : Finset β)
    (Yb Yc : β → E) (Fb Fc : E) {C₀ L : ℝ} (hC₀L : 0 < C₀ ^ 2 * L)
    (hYc : ∑ p ∈ u, ‖Yc p‖ ^ 2 ≤ C₀ ^ 2 * L) (hFc : ‖Fc‖ ^ 2 ≤ C₀ ^ 2 * L)
    (hflag : 4 * (C₀ ^ 2 * L) < ∑ p ∈ u, ‖Yb p‖ ^ 2 ∨ 4 * (C₀ ^ 2 * L) < ‖Fb‖ ^ 2) :
    1 ≤ (∑ p ∈ u, ‖Yb p - Yc p‖ ^ 2 + ‖Fb - Fc‖ ^ 2) / (C₀ ^ 2 * L) := by
  rw [le_div_iff₀ hC₀L, one_mul]
  have hY : ∑ p ∈ u, ‖Yb p‖ ^ 2 ≤ 2 * ∑ p ∈ u, ‖Yb p - Yc p‖ ^ 2 + 2 * ∑ p ∈ u, ‖Yc p‖ ^ 2 := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun p _ => ?_
    have := norm_add_sq_le_two_mul (Yb p - Yc p) (Yc p)
    rwa [sub_add_cancel] at this
  have hF : ‖Fb‖ ^ 2 ≤ 2 * ‖Fb - Fc‖ ^ 2 + 2 * ‖Fc‖ ^ 2 := by
    have := norm_add_sq_le_two_mul (Fb - Fc) Fc
    rwa [sub_add_cancel] at this
  have h1 : 0 ≤ ∑ p ∈ u, ‖Yb p - Yc p‖ ^ 2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
  have h2 : 0 ≤ ‖Fb - Fc‖ ^ 2 := sq_nonneg _
  rcases hflag with h | h <;> linarith

end BandCellBound

