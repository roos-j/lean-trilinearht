/-- The helper masks of the steps of a descriptor list (on the helper catalog). -/
noncomputable def hMask (hcat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) (i : ℕ) (p : Fin ap.P) :
    InheritedColumnMask (ap.cumBase hcat hR hbh).D :=
  ap.gMask hcat hR hbh rH (ap.stepMask G (ap.leafJ s (if (D.getD i (true, 0, none)).1 then c
    else d)) (D.getD i (true, 0, none)).2.2 p)
    (ap.stepMask_mono G _ (D.getD i (true, 0, none)).2.2 p)

/-- The helper pads of a step of the list are the pads of its helper mask. -/
theorem gStep_help (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {i : ℕ} (hi : i < D.length) (h : ℤ) (p : Fin ap.P) :
    (ap.gStep cat hcat hR hbc hbh rH s c d G D[i] h).2.1 p =
      ((ap.cumBase hcat hR hbh).withMask (ap.hMask hcat hR hbh rH s c d G D i p)).proj h := by
  unfold hMask
  simp only [List.getD_eq_getElem _ _ hi]
  rfl

/-- The global helper prefix of the first `j` steps is the global history of their helper
masks. -/
theorem helpPre_global (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) (h : ℤ) :
    ∀ j ≤ D.length, ∀ x : ColumnL2 (Fin ap.Mc),
      helpPre ap.P ((D.take j).map fun e => padStep (ap.gStep cat hcat hR hbc hbh rH s c d G e h))
        x = globHist (ap.cumBase hcat hR hbh) (ap.hMask hcat hR hbh rH s c d G D)
          ((List.range j).map fun i => (i, false)) h x
  | 0, _, x => by simp [helpPre, globHist, layerOp_nil]
  | j + 1, hj, x => by
    have ih := helpPre_global cat hcat hR hbc hbh rH s c d G D h j (by omega) x
    have hlt : j < D.length := by omega
    rw [List.take_succ_eq_append_getElem hlt, List.map_append, List.map_singleton,
      helpPre_append, ih, List.range_succ, List.map_append, List.map_singleton]
    unfold globHist
    rw [layerOp_append]
    simp only [Bool.false_eq_true, ite_false, ContinuousLinearMap.comp_apply, padStep]
    rw [filterAvg_padFam]
    congr 1
    unfold opAvg
    congr 1
    exact Finset.sum_congr rfl fun p _ => ap.gStep_help cat hcat hR hbc hbh rH s c d G D hlt h p

