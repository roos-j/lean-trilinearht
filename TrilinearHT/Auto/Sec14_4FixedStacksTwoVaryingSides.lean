/-- The freeze differences of one offset `n < K` over all cells of that offset. -/
theorem frz_offset (hK1 : 1 ≤ T.D.S.K) (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j o : ℕ)
    {n : ℕ} (hn : n < T.D.S.K) :
    ∑ J ∈ A.cells.filter (fun J => T.offI J = n), T.frzD c d G t t' j o J ≤
      (ap.P + 1) * T.slotVar (cslot c d ((T.desc c d t t').getD j (true, 0, none)).1)
          (4 * T.jmpC c d ((T.desc c d t t').getD j (true, 0, none)).1
            (restIdx ((T.desc c d t t').getD j (true, 0, none)).1
              ((T.desc c d t t').drop (j + 1)) (j + 1)).length) +
        T.slotVar (cslot c d (!((T.desc c d t t').getD j (true, 0, none)).1))
          (T.jmpC c d (!((T.desc c d t t').getD j (true, 0, none)).1)
            (restIdx (!((T.desc c d t t').getD j (true, 0, none)).1)
              ((T.desc c d t t').drop (j + 1)) (j + 1)).length) := by
  rw [T.sum_off_blocks hK1 n]
  simp only [T.frz_cells hK1 c d G t t' j o n]
  rw [Finset.sum_add_distrib, Finset.sum_comm]
  have hsv : ∀ l B, 0 ≤ B → 0 ≤ T.slotVar l B := fun l B hB => by unfold slotVar; positivity
  have hjb := T.jmpC_nonneg c d ((T.desc c d t t').getD j (true, 0, none)).1
    (restIdx ((T.desc c d t t').getD j (true, 0, none)).1 ((T.desc c d t t').drop (j + 1))
      (j + 1)).length
  refine add_le_add ?_ ?_
  · refine (Finset.sum_le_sum fun p _ => T.band_var c d G t t' j o p
      (fun β : {β : Fin (A.treeDepth + 1) // T.D.S.K * (β : ℕ) + n ≤ A.treeDepth} =>
        T.D.S.K * (β.1 : ℕ))
      (fun β => T.D.S.K * (β.1 : ℕ) + n) (fun _ => Nat.le_add_right _ _)
      (fun i i' hne => block_ioc_disjoint hn (fun h => hne (Subtype.ext (Fin.ext h))))
      (fun i => i.2) (fun β => T.offCells n β.1)
      (fun i I hI => (Finset.mem_filter.mp hI).1)).trans ?_
    rw [Finset.sum_const, nsmul_eq_mul]
    refine mul_le_mul_of_nonneg_right ?_ (hsv _ _ (by positivity))
    have : (ap.uo o).card ≤ ap.P + 1 :=
      (Finset.card_le_card (ap.uo_sub o)).trans (by rw [Finset.card_range])
    exact_mod_cast this
  · exact T.other_var c d G t t' j
      (fun β : {β : Fin (A.treeDepth + 1) // T.D.S.K * (β : ℕ) + n ≤ A.treeDepth} =>
        T.D.S.K * (β.1 : ℕ))
      (fun β => T.D.S.K * (β.1 : ℕ) + n) (fun _ => Nat.le_add_right _ _)
      (fun i i' hne => block_ioc_disjoint hn (fun h => hne (Subtype.ext (Fin.ext h))))
      (fun i => i.2) (fun β => T.offCells n β.1)
      (fun i I hI => (Finset.mem_filter.mp hI).1)

