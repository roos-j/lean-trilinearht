/-- Blueprint lines 2384-2394 (the third strong factors in integrated form): the length-weighted
squares of the third strong factors of a leaf are bounded by the side masses, the restoration
differences and the freeze and flag budgets. -/
theorem third_budget (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp)
    (Yf : ℤ × ℤ → Fin 4 → Fin 4 → Fin 4 → ℝ → ℂ)
    (Yb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Fb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Unfl : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → Prop)
    {C₀ B₀ Cy : ℝ} {Lp Jm : ℕ} (hLp : ∀ l, (T.pe l).length ≤ Lp)
    (hJm : ∀ c d i i', (T.desc c d (T.tOf c i) (T.tOf d i')).length ≤ Jm)
    (hy : ∀ I ∈ S, ∀ c d, ¬ T.Ucase I c d →
      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (Yf I c d d)))‖ /
          Real.sqrt (dyadicGridLength A.G I.1) ≤ Cy ∧
      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ /
          Real.sqrt (dyadicGridLength A.G I.1) ≤ Cy)
    {Bs Brst Bfz : ℝ}
    (hBs : ∑ I ∈ S, ∑ G ∈ gs I, ∑ l, ‖T.side l G I‖ ^ 2 ≤ Bs)
    (hBrst : ∑ I ∈ S, ∑ _G ∈ gs I, ∑ c : Fin 4, ∑ d : Fin 4, (if T.Ucase I c d then 0 else
      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (Yf I c d c)) -
          physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ ^ 2 +
      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (Yf I c d d)) -
          physicalColumnInput (V := Fin ap.Mc) (ap.base I d))‖ ^ 2) ≤ Brst)
    (hBfz : ∑ I ∈ S, ∑ G ∈ gs I, ∑ c : Fin 4, ∑ d : Fin 4, (if T.Ucase I c d then 0 else
      ∑ i' ∈ Finset.range (T.pe d).length, ∑ i ∈ Finset.range (T.pe c).length,
        ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
          ∑ o ∈ Finset.range 5, (16 * C₀ ^ 2 * ∑ p ∈ ap.uo o,
            ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2)
              (T.Y c d G (T.tOf c i) (T.tOf d i') j o I.1 p -
                Yb I G c d (T.tOf c i) (T.tOf d i') j o p)‖ ^ 2 +
            C₀ ^ 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2)
              (T.F c d G (T.tOf c i) (T.tOf d i') j I.1 - Fb I G c d (T.tOf c i) (T.tOf d i') j)‖ ^
                  2 +
            (if Unfl I G c d (T.tOf c i) (T.tOf d i') j o then 0 else
              C₀ ^ 4 * dyadicGridLength A.G I.1))) ≤ Bfz) :
    ∑ I ∈ S, dyadicGridLength A.G I.1 * ∑ G ∈ gs I, (6 * ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4,
        ∑ d : Fin 4, T.third I G a b c d Yf Yb Fb Unfl C₀ B₀) ^ 2 ≤
      36 * 256 * 16 * (16 * (localFormUniformConstant κ' * B₀) ^ 2 * Bs +
        Lp ^ 2 * (2 * (1 + 5 * Jm)) * (Lp ^ 2 * (localFormUniformConstant κ' ^ 2 * (2 * Cy ^ 2)) *
          Brst + (2 / (ap.P : ℝ) * localFormUniformConstant κ') ^ 2 * 3 * Bfz)) := by
  have hCκ := localFormUniformConstant_nonneg κ'
  have hLp0 : (0 : ℝ) ≤ Lp := Nat.cast_nonneg Lp
  have hK0 : (0 : ℝ) ≤ Lp ^ 2 * (2 * (1 + 5 * Jm)) := by positivity
  have hD : (0 : ℝ) ≤ (2 / (ap.P : ℝ) * localFormUniformConstant κ') ^ 2 * 3 := by positivity
  set Rst : ℤ × ℤ → Fin 4 → Fin 4 → ℝ := fun I c d => if T.Ucase I c d then 0 else
      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (Yf I c d c)) -
          physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ ^ 2 +
      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (Yf I c d d)) -
          physicalColumnInput (V := Fin ap.Mc) (ap.base I d))‖ ^ 2 with hRst
  set Fz : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → ℝ := fun I G c d => if T.Ucase I c d then 0 else
      ∑ i' ∈ Finset.range (T.pe d).length, ∑ i ∈ Finset.range (T.pe c).length,
        ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
          ∑ o ∈ Finset.range 5, (16 * C₀ ^ 2 * ∑ p ∈ ap.uo o,
            ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2)
              (T.Y c d G (T.tOf c i) (T.tOf d i') j o I.1 p -
                Yb I G c d (T.tOf c i) (T.tOf d i') j o p)‖ ^ 2 +
            C₀ ^ 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2)
              (T.F c d G (T.tOf c i) (T.tOf d i') j I.1 - Fb I G c d (T.tOf c i) (T.tOf d i') j)‖ ^
                  2 +
            (if Unfl I G c d (T.tOf c i) (T.tOf d i') j o then 0 else
              C₀ ^ 4 * dyadicGridLength A.G I.1)) with hFz
  have hRst0 : ∀ I c d, 0 ≤ Rst I c d := fun I c d => by
    simp only [hRst]; split_ifs <;> positivity
  have hFz0 : ∀ I G c d, 0 ≤ Fz I G c d := fun I G c d => by
    simp only [hFz]
    split_ifs
    · exact le_rfl
    · refine Finset.sum_nonneg fun i' _ => Finset.sum_nonneg fun i _ => Finset.sum_nonneg
        fun j _ => Finset.sum_nonneg fun o _ => ?_
      have : 0 ≤ ∑ p ∈ ap.uo o, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2)
          (T.Y c d G (T.tOf c i) (T.tOf d i') j o I.1 p -
            Yb I G c d (T.tOf c i) (T.tOf d i') j o p)‖ ^ 2 :=
        Finset.sum_nonneg fun _ _ => sq_nonneg _
      have := (dyadicGridLength_pos A.G I.1).le
      split_ifs <;> positivity
  -- one tuple
  have htup : ∀ I ∈ S, ∀ G (a b c d : Fin 4), dyadicGridLength A.G I.1 *
      T.third I G a b c d Yf Yb Fb Unfl C₀ B₀ ^ 2 ≤
      2 * (localFormUniformConstant κ' * B₀) ^ 2 * (‖T.side c G I‖ ^ 2 + ‖T.side d G I‖ ^ 2) +
        Lp ^ 2 * (2 * (1 + 5 * Jm)) * (Lp ^ 2 * (localFormUniformConstant κ' ^ 2 *
          (2 * Cy ^ 2)) * Rst I c d + (2 / (ap.P : ℝ) * localFormUniformConstant κ') ^ 2 * 3 *
            Fz I G c d) := by
    intro I hI G a b c d
    have hL := dyadicGridLength_pos A.G I.1
    have h0 : 0 ≤ 2 * (localFormUniformConstant κ' * B₀) ^ 2 *
        (‖T.side c G I‖ ^ 2 + ‖T.side d G I‖ ^ 2) := by positivity
    have h1 : 0 ≤ Lp ^ 2 * (2 * (1 + 5 * Jm)) * (Lp ^ 2 * (localFormUniformConstant κ' ^ 2 *
          (2 * Cy ^ 2)) * Rst I c d + (2 / (ap.P : ℝ) * localFormUniformConstant κ') ^ 2 * 3 *
            Fz I G c d) := by
      have := hRst0 I c d; have := hFz0 I G c d; positivity
    unfold third
    by_cases hV : T.Val a b c d
    · by_cases hU : T.Ucase I c d
      · simp only [hV, hU, ↓reduceIte]
        have e : ∀ l, dyadicGridLength A.G I.1 * T.ns l G I ^ 2 = ‖T.side l G I‖ ^ 2 := by
          intro l
          unfold ns
          rw [div_pow, Real.sq_sqrt hL.le]
          field_simp
        have := add_sq_le_two (T.ns c G I) (T.ns d G I)
        calc dyadicGridLength A.G I.1 * (localFormUniformConstant κ' * B₀ *
              (T.ns c G I + T.ns d G I)) ^ 2
            = (localFormUniformConstant κ' * B₀) ^ 2 * (dyadicGridLength A.G I.1 *
              (T.ns c G I + T.ns d G I) ^ 2) := by ring
          _ ≤ (localFormUniformConstant κ' * B₀) ^ 2 * (dyadicGridLength A.G I.1 *
              (2 * T.ns c G I ^ 2 + 2 * T.ns d G I ^ 2)) := by gcongr
          _ = 2 * (localFormUniformConstant κ' * B₀) ^ 2 * (‖T.side c G I‖ ^ 2 +
              ‖T.side d G I‖ ^ 2) := by rw [← e c, ← e d]; ring
          _ ≤ _ := le_add_of_nonneg_right h1
      · simp only [hV, hU, ↓reduceIte]
        obtain ⟨hyd, hbc⟩ := hy I hI c d hU
        have h := T.strTh_sq c d G I (Yf I c d c) (Yf I c d d) (Yb I G c d) (Fb I G c d)
          (Unfl I G c d) (C₀ := C₀) hLp (hJm c d) hyd hbc
        refine h.trans (le_trans (le_of_eq ?_) (le_add_of_nonneg_left h0))
        simp only [hRst, hFz, hU, ↓reduceIte]
        ring
    · simp only [hV, ↓reduceIte]
      rw [zero_pow two_ne_zero, mul_zero]
      positivity
  set K' : ℝ := Lp ^ 2 * (2 * (1 + 5 * Jm)) with hK'
  set D : ℝ := (2 / (ap.P : ℝ) * localFormUniformConstant κ') ^ 2 * 3 with hDdef
  set E : ℝ := Lp ^ 2 * (localFormUniformConstant κ' ^ 2 * (2 * Cy ^ 2)) with hE
  set W : ℝ := (localFormUniformConstant κ' * B₀) ^ 2 with hW
  have hE0 : 0 ≤ E := by positivity
  have hcell : ∀ I ∈ S, ∀ G, dyadicGridLength A.G I.1 * (6 * ∑ a : Fin 4, ∑ b : Fin 4,
      ∑ c : Fin 4, ∑ d : Fin 4, T.third I G a b c d Yf Yb Fb Unfl C₀ B₀) ^ 2 ≤
      36 * 256 * 16 * (16 * W * ∑ l, ‖T.side l G I‖ ^ 2 +
        K' * (E * ∑ c : Fin 4, ∑ d : Fin 4, Rst I c d + D * ∑ c : Fin 4, ∑ d : Fin 4,
          Fz I G c d)) := by
    intro I hI G
    have hL := (dyadicGridLength_pos A.G I.1).le
    have h1 := sq_sum_fin4_4 (fun a b c d => T.third I G a b c d Yf Yb Fb Unfl C₀ B₀)
    have hsum : ∀ x : Fin 4 → ℝ, ∑ c : Fin 4, ∑ d : Fin 4, (x c + x d) = 8 * ∑ l, x l := by
      intro x
      simp only [Finset.sum_add_distrib, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        nsmul_eq_mul, ← Finset.mul_sum]
      ring
    calc dyadicGridLength A.G I.1 * (6 * ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4, ∑ d : Fin 4,
          T.third I G a b c d Yf Yb Fb Unfl C₀ B₀) ^ 2
        = 36 * (dyadicGridLength A.G I.1 * (∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4,
          ∑ d : Fin 4, T.third I G a b c d Yf Yb Fb Unfl C₀ B₀) ^ 2) := by ring
      _ ≤ 36 * (dyadicGridLength A.G I.1 * (256 * ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4,
          ∑ d : Fin 4, T.third I G a b c d Yf Yb Fb Unfl C₀ B₀ ^ 2)) := by gcongr
      _ = 36 * 256 * ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4, ∑ d : Fin 4,
          dyadicGridLength A.G I.1 * T.third I G a b c d Yf Yb Fb Unfl C₀ B₀ ^ 2 := by
          simp only [Finset.mul_sum]; ring_nf
      _ ≤ 36 * 256 * ∑ _a : Fin 4, ∑ _b : Fin 4, ∑ c : Fin 4, ∑ d : Fin 4,
          (2 * W * (‖T.side c G I‖ ^ 2 + ‖T.side d G I‖ ^ 2) +
            K' * (E * Rst I c d + D * Fz I G c d)) := by
          gcongr with a _ b _ c _ d _
          exact htup I hI G a b c d
      _ = 36 * 256 * 16 * (2 * W * ∑ c : Fin 4, ∑ d : Fin 4,
            (‖T.side c G I‖ ^ 2 + ‖T.side d G I‖ ^ 2) +
          K' * (E * ∑ c : Fin 4, ∑ d : Fin 4, Rst I c d + D * ∑ c : Fin 4, ∑ d : Fin 4,
            Fz I G c d)) := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
            Finset.sum_add_distrib, ← Finset.mul_sum]
          ring
      _ = _ := by rw [hsum (fun l => ‖T.side l G I‖ ^ 2)]; ring
  have hW0 : 0 ≤ W := by positivity
  calc ∑ I ∈ S, dyadicGridLength A.G I.1 * ∑ G ∈ gs I, (6 * ∑ a : Fin 4, ∑ b : Fin 4,
        ∑ c : Fin 4, ∑ d : Fin 4, T.third I G a b c d Yf Yb Fb Unfl C₀ B₀) ^ 2
      ≤ ∑ I ∈ S, ∑ G ∈ gs I, 36 * 256 * 16 * (16 * W * ∑ l, ‖T.side l G I‖ ^ 2 +
        K' * (E * ∑ c : Fin 4, ∑ d : Fin 4, Rst I c d + D * ∑ c : Fin 4, ∑ d : Fin 4,
          Fz I G c d)) := by
        refine Finset.sum_le_sum fun I hI => ?_
        rw [Finset.mul_sum]
        exact Finset.sum_le_sum fun G _ => hcell I hI G
    _ = 36 * 256 * 16 * (16 * W * ∑ I ∈ S, ∑ G ∈ gs I, ∑ l, ‖T.side l G I‖ ^ 2 +
        K' * (E * ∑ I ∈ S, ∑ _G ∈ gs I, ∑ c : Fin 4, ∑ d : Fin 4, Rst I c d +
          D * ∑ I ∈ S, ∑ G ∈ gs I, ∑ c : Fin 4, ∑ d : Fin 4, Fz I G c d)) := by
        simp only [mul_add, Finset.mul_sum, Finset.sum_add_distrib]
    _ ≤ _ := by gcongr

