theorem frz_bound (hK1 : 1 ≤ T.D.S.K) (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j o : ℕ) :
    ∑ J ∈ A.cells, T.frzD c d G t t' j o J ≤
