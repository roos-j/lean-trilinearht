      (ap.hMask hcat hR hbh rH s c d G D j p).labels x ⊆
        (ap.hMask hcat hR hbh rH s c d G D j p').labels x :=
  fun _ _ hpp _ _ => catLabels_mono _ _ _ fun y hy =>
