theorem helpPre_append (P : ℕ) :
    ∀ (l : List (TransferStep E)) (st : TransferStep E) (x : E),
      helpPre P (l ++ [st]) x = filterAvg P st.2.1 (helpPre P l x)
  | [], st, x => rfl
  | a :: l, st, x => by
    simp only [List.cons_append, helpPre]
    exact helpPre_append P l st _

