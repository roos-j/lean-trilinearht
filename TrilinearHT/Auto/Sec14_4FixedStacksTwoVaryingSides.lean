/-- In four slots, a slot distinct from three of four distinct slots is the fourth. -/
theorem fin4_last : ∀ a b c d l : Fin 4, a ≠ b → a ≠ c → a ≠ d → b ≠ c → b ≠ d → c ≠ d →
    l ≠ a → l ≠ c → l ≠ d → l = b := by
  intro a b c d l h1 h2 h3 h4 h5 h6 h7 h8 h9
  omega

