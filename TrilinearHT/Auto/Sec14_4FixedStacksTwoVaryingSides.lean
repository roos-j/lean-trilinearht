/-- Blueprint `eq:stack-energy` for the banded side of one transfer step over all levels: the
`bandStack_energy` of the levels `k < N` plus the `baseStack_energy` of the base level. -/
theorem bandStack_all (hanc : A.AncClosed) {γ : Type*} {V : Type*} [Fintype V]
    (Gs : Finset γ) (Z : γ → ℤ → ColumnL2 V) (ok : γ → ℤ × ℤ → Prop) {B : ℝ}
    (hcap : A.VarCap Gs Z ok B) {K N : ℕ} (hKN : K ≤ 2 ^ N)
    (Bs : Finset ℕ) (U : γ → ℕ → Finset (ℤ × ℤ)) (off : ℤ × ℤ → ℕ)
    (hoff : ∀ (J : ℤ × ℤ) (β m : ℕ), m < K → J.1 = A.R.1 + ((K * β + m : ℕ) : ℤ) → off J = m)
    (hU : ∀ g β, ∀ I ∈ U g β, I ∈ A.cells ∧ I.1 = A.R.1 + (K * β + off I : ℕ) ∧ off I < K)
    (hok : ∀ g ∈ Gs, ∀ β, ∀ I ∈ U g β, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → ok g J)
    {P : ℕ} (Ah : γ → ℕ → ℤ → ColumnL2 V →L[ℂ] ColumnL2 V)
    (hbes : ∀ g h y, ∑ p ∈ Finset.range (P + 1), ‖(Ah g (p + 1) h - Ah g p h) y‖ ^ 2 ≤ ‖y‖ ^ 2)
    (hcomm : ∀ g n h (J : ℤ × ℤ), J.1 ≤ h → J.1 ≤ A.R.1 + A.treeDepth →
      (columnL2Restriction (dyadicGridCell A.G J.1 J.2)
        (dyadicGridCell_measurable A.G J.1 J.2)).comp (Ah g n h) =
        (Ah g n h).comp (columnL2Restriction (dyadicGridCell A.G J.1 J.2)
          (dyadicGridCell_measurable A.G J.1 J.2)))
    {Cj : ℝ} (hCj : 0 ≤ Cj)
    (hJ : ∀ g ∈ Gs, ∀ n, ∀ {ι : Type} [Fintype ι] (r t : ι → ℕ), (∀ i, r i ≤ t i) →
      (∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i'))) →
      ∀ Ec : ι → Finset (ℤ × ℤ), (∀ i, ∀ J ∈ Ec i, J ∈ A.cells) → ∀ x,
      ∑ i, ‖columnL2Restriction (⋃ J ∈ Ec i, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        ((Ah g n (A.R.1 + t i) - Ah g n (A.R.1 + r i)) x)‖ ^ 2 ≤ Cj * ‖x‖ ^ 2)
    (W : γ → ℕ → ColumnL2 V) {EW : ℝ}
    (hEW : ∑ g ∈ Gs, ∑ β ∈ Bs, ‖columnL2Restriction
      (⋃ J ∈ (U g β).image (fun I => ancAt A.G I (A.R.1 + ((K * β : ℕ) : ℤ))),
        dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (W g β)‖ ^ 2 ≤ EW)
    (Sa : γ → ℕ → ℤ → ColumnL2 V)
    (hSa : ∀ g β h, Sa g β h = Z g h - Z g (A.R.1 + ((K * β : ℕ) : ℤ)) + W g β) :
    ∑ k : Fin (N + 1), ∑ g ∈ Gs, ∑ β ∈ Bs, ∑ q ∈ ((U g β).filter fun I => posAct N k (off I)).image
        (fun I => off I / 2 ^ ((k : ℕ) + 1)), ∑ p ∈ Finset.range (P + 1),
      ‖gluedStack A.G ((U g β).filter fun I => posAct N k (off I))
        (fun I => off I / 2 ^ ((k : ℕ) + 1))
        (fun q => posVal (fun n => (Ah g (p + 1) (A.R.1 + (K * β + n : ℕ)) -
          Ah g p (A.R.1 + (K * β + n : ℕ))) (Sa g β (A.R.1 + (K * β + n : ℕ)))) N k q) q‖ ^ 2 ≤
      N * (2 * B + 16 * (P + 2) * (Cj * EW) + 16 * (P + 2) * (N * (Cj * (N * B)))) + EW := by
  have hEWk : ∀ k : Fin (N + 1), ∑ g ∈ Gs, ∑ β ∈ Bs, ‖columnL2Restriction
      (⋃ J ∈ ((U g β).filter fun I => posAct N k (off I)).image
        (fun I => ancAt A.G I (A.R.1 + ((K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (W g β)‖ ^ 2 ≤ EW := by
    intro k
    refine le_trans (Finset.sum_le_sum fun g _ => Finset.sum_le_sum fun β _ => ?_) hEW
    refine columnL2Restriction_norm_sq_mono _ _ ?_ _
    exact Set.biUnion_subset_biUnion_left (Finset.coe_subset.mpr
      (Finset.image_subset_image (Finset.filter_subset _ _)))
  rw [Fin.sum_univ_castSucc]
  refine add_le_add ?_ ?_
  · calc ∑ k : Fin N, _ ≤ ∑ _k : Fin N, (2 * B + 16 * (P + 2) * (Cj * EW) +
          16 * (P + 2) * (N * (Cj * (N * B)))) := by
          refine Finset.sum_le_sum fun k _ => ?_
          have hk : ((Fin.castSucc k : Fin (N + 1)) : ℕ) ≠ N := by
            simp only [Fin.val_castSucc]; exact k.2.ne
          exact A.bandStack_energy hanc Gs Z ok hcap hKN (Fin.castSucc k) hk Bs U off hoff hU hok
            Ah hbes hcomm hCj hJ W (hEWk _) Sa hSa
      _ = _ := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  · exact A.baseStack_energy Gs hKN Bs U off hU Ah hbes hcomm W hEW Sa
      (fun g β => by rw [hSa]; abel)

open Classical in
/-- Blueprint `eq:stack-energy` for the untouched side over all levels: the position levels by
`posStack_energy` and the base level by the block-start energy. -/
theorem posStack_all (hanc : A.AncClosed) {γ : Type*} {V : Type*} [Fintype V]
    (Gs : Finset γ) (Z : γ → ℤ → ColumnL2 V) (ok : γ → ℤ × ℤ → Prop) {B : ℝ}
    (hcap : A.VarCap Gs Z ok B) {K N : ℕ} (hKN : K ≤ 2 ^ N)
    (Bs : Finset ℕ) (U : γ → ℕ → Finset (ℤ × ℤ)) (off : ℤ × ℤ → ℕ)
    (hU : ∀ g β, ∀ I ∈ U g β, I ∈ A.cells ∧ I.1 = A.R.1 + (K * β + off I : ℕ) ∧ off I < K)
    (hok : ∀ g ∈ Gs, ∀ β, ∀ I ∈ U g β, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → ok g J)
    (Sb : γ → ℕ → ℤ → ColumnL2 V)
    (hSb : ∀ g β h h', Sb g β h - Sb g β h' = Z g h - Z g h') {EW : ℝ}
    (hEW : ∑ g ∈ Gs, ∑ β ∈ Bs, ‖columnL2Restriction
      (⋃ J ∈ (U g β).image (fun I => ancAt A.G I (A.R.1 + ((K * β : ℕ) : ℤ))),
        dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (Sb g β (A.R.1 + ((K * β : ℕ) : ℤ)))‖ ^ 2 ≤ EW) :
    ∑ k : Fin (N + 1), ∑ g ∈ Gs, ∑ β ∈ Bs, ∑ q ∈ ((U g β).filter fun I => posAct N k (off I)).image
        (fun I => off I / 2 ^ ((k : ℕ) + 1)),
      ‖gluedStack A.G ((U g β).filter fun I => posAct N k (off I))
        (fun I => off I / 2 ^ ((k : ℕ) + 1))
        (fun q => posVal (fun n => Sb g β (A.R.1 + (K * β + n : ℕ))) N k q) q‖ ^ 2 ≤
      N * B + EW := by
  rw [Fin.sum_univ_castSucc]
  refine add_le_add ?_ ?_
  · calc ∑ k : Fin N, _ ≤ ∑ _k : Fin N, B := by
          refine Finset.sum_le_sum fun k _ => ?_
          have hk : ((Fin.castSucc k : Fin (N + 1)) : ℕ) ≠ N := by
            simp only [Fin.val_castSucc]; exact k.2.ne
          exact A.posStack_energy hanc Gs Z ok hcap (Fin.castSucc k) hk Bs U off hU hok Sb hSb
      _ = _ := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  · refine le_trans (Finset.sum_le_sum fun g _ => Finset.sum_le_sum fun β _ => ?_) hEW
    set U' := (U g β).filter fun I => posAct N (Fin.last N) (off I)
    set db : ℤ := A.R.1 + ((K * β : ℕ) : ℤ)
    have hsel0 : ∀ I ∈ U', off I / 2 ^ (N + 1) = 0 := by
      intro I hI
      have h := (hU g β I (Finset.mem_filter.mp hI).1).2.2
      refine Nat.div_eq_of_lt (lt_of_lt_of_le h (hKN.trans ?_))
      exact Nat.pow_le_pow_right (by norm_num) (Nat.le_succ N)
    have himg : U'.image (fun I => off I / 2 ^ (N + 1)) ⊆ {0} := by
      intro q hq
      obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hq
      rw [hsel0 I hI]; exact Finset.mem_singleton_self 0
    refine (Finset.sum_le_sum_of_subset_of_nonneg himg fun _ _ _ => by positivity).trans ?_
    rw [Finset.sum_singleton]
    refine (gluedStack_norm_sq_le A.G U' _ _ 0 (Finset.measurableSet_biUnion
      ((U g β).image fun I => ancAt A.G I db) fun J _ =>
        dyadicGridCell_measurable A.G J.1 J.2) ?_).trans (le_of_eq ?_)
    · intro y hy
      simp only [selUnion, Set.mem_iUnion] at hy
      obtain ⟨I, hI, -, hyI⟩ := hy
      obtain ⟨hIc, hIdep, -⟩ := hU g β I (Finset.mem_filter.mp hI).1
      have hd : db ≤ I.1 := by rw [hIdep]; simp only [db]; push_cast; omega
      exact Set.mem_biUnion (Finset.mem_image_of_mem _ (Finset.mem_filter.mp hI).1)
        (subset_ancAt A.G I hd hyI)
    · simp only [posVal, Fin.val_last, ite_true, add_zero]
      rfl

end ActiveSetup

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The helper bands of the step `j` after its global helper prefix are the band pads of the helper
masks. -/
theorem gSt_help_band (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {j : ℕ} (hj : j < D.length) (h : ℤ) (n : ℕ)
    (xa : ColumnL2 (Fin ap.Mc)) :
    (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).2.1 n
        (helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j h) xa) =
      ap.bandPads hcat hR hbh (ap.hMask hcat hR hbh rH s c d G D) j n h xa := by
  unfold gSt gPre bandPads
  rw [ContinuousLinearMap.comp_apply, ← ap.helpPre_global cat hcat hR hbc hbh rH s c d G D h j
    hj.le xa, List.map_map]
  simp only [padStep]
  rw [padFam_apply_eq]
  congr 2

/-- At an active cell of depth `h`, the helper bands of a side value have total restricted square
at most the restricted square of the side value (Bessel bands, local pads). -/
theorem help_bands_bessel (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {j : ℕ} (hj : j < D.length) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) (xa : ColumnL2 (Fin ap.Mc)) (u : Finset ℕ)
    (hu : u ⊆ Finset.range (ap.P + 1)) :
    ∑ p ∈ u, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)
        ((ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.1 (p + 1)
          (helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j I.1) xa) -
        (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.1 p
          (helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j I.1) xa))‖ ^ 2 ≤
      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        xa‖ ^ 2 := by
  set rI := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
  set Ah := ap.bandPads hcat hR hbh (ap.hMask hcat hR hbh rH s c d G D) j
  have hN : I.1 ≤ A.R.1 + A.treeDepth :=
    ((dyadicFiniteTree_mem_iff A.G A.R I A.treeDepth).mp (A.cells_mem_tree hI)).2
  have hc : ∀ n, rI (Ah n I.1 xa) = Ah n I.1 (rI xa) := fun n =>
    DFunLike.congr_fun (ap.bandPads_comm hcat hR hbh _ j n I.1 I le_rfl hN) xa
  calc _ = ∑ p ∈ u, ‖(Ah (p + 1) I.1 - Ah p I.1) (rI xa)‖ ^ 2 := by
        refine Finset.sum_congr rfl fun p _ => ?_
        rw [ap.gSt_help_band cat hcat hR hbc hbh rH s c d G D hj, ap.gSt_help_band cat hcat hR hbc
          hbh rH s c d G D hj, map_sub, hc, hc, sub_apply]
    _ ≤ ∑ p ∈ Finset.range (ap.P + 1), ‖(Ah (p + 1) I.1 - Ah p I.1) (rI xa)‖ ^ 2 :=
        Finset.sum_le_sum_of_subset_of_nonneg hu fun _ _ _ => by positivity
    _ ≤ ‖rI xa‖ ^ 2 := ap.bandPads_bessel hcat hR hbh _ j
        (ap.hMask_nested hcat hR hbh rH s c d G D j) I.1 (rI xa)

open Classical in
/-- Blueprint lines 2386-2394 at one use: the global near band sum of the step `j` at the offset
`o` is at most, if the use is unflagged, the near band form with the frozen band family `Y_b` and
frozen complement `F_b`, plus `C_κ (‖W‖/s)(‖x_a‖/s)(4 C₀ δ_Y + C₀ δ_F + [flagged] C₀²)`. -/
theorem near_use (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) {a b c d : Fin 4} (hab : a ≠ b)
    (hac : a ≠ c) (had : a ≠ d) (hbc' : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {CF : ℝ} (P₁c P₂c P₁d P₂d : BasicProjection A.G A.R CF)
    {I : ℤ × ℤ} (hI : I ∈ A.cells) (xg : Fin 4 → ColumnL2 (Fin ap.Mc)) (xa : ColumnL2 (Fin ap.Mc))
    {j : ℕ} (hj : j < D.length) (o : ℕ) (z : Fin 4 → ColumnL2 (Fin ap.Mc))
    (Yb : ℕ → ColumnL2 (Fin ap.Mc)) (Fb : ColumnL2 (Fin ap.Mc)) (Unfl : Prop) {C₀ : ℝ}
    (hC₀ : 0 ≤ C₀)
    (hFc : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (chainVal ap.P (!(ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1) (ap.gRest cat hcat hR
        hbc hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then
        ap.gIn P₁d P₂d I.1 else ap.gIn P₁c P₂c I.1))‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ C₀)
    (hYc : Real.sqrt (∑ p ∈ ((Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o - 2 ≤
        ap.P)), ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1
        I.2) ((fun p => (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.2 (p + o - 2 + 1)
        (chainVal ap.P (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 (ap.gRest cat hcat hR hbc
        hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then ap.gIn
        P₁c P₂c I.1 else ap.gIn P₁d P₂d I.1)) - (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.2
        (p + o - 2) (chainVal ap.P (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 (ap.gRest cat
        hcat hR hbc hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1
        then ap.gIn P₁c P₂c I.1 else ap.gIn P₁d P₂d I.1))) p)‖ ^ 2) / Real.sqrt (dyadicGridLength
        A.G I.1) ≤ C₀)
    (hFb : Unfl → ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G
        I.1 I.2) Fb‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ 2 * C₀) :
    ‖ap.nearTermG cat hcat hR hbc hbh rH s a c d G D P₁c P₂c P₁d P₂d I I.1 xg xa j o‖ ≤
      (if Unfl then ‖ap.nearForm I a b (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then c
          else d) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then d else c) z
          ((Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o - 2 ≤ ap.P)) (fun p =>
          (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.1 (p + 1) (helpPre ap.P (ap.gPre cat
          hcat hR hbc hbh rH s c d G D j I.1) xa) - (ap.gSt cat hcat hR hbc hbh rH s c d G D j
          I.1).2.1 p (helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j I.1) xa)) Yb (xg b)
          Fb‖ else 0) +
        localFormUniformConstant κ' * ((‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2) (xg b)‖ / Real.sqrt (dyadicGridLength A.G I.1))
            * (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1
            I.2) xa‖ / Real.sqrt (dyadicGridLength A.G I.1)) *
          (4 * C₀ * (Real.sqrt (∑ p ∈ ((Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o
              - 2 ≤ ap.P)), ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2) ((fun p => (ap.gSt cat hcat hR hbc hbh rH s c
              d G D j I.1).2.2 (p + o - 2 + 1) (chainVal ap.P (ap.gSt cat hcat hR hbc hbh rH s c d G
              D j I.1).1 (ap.gRest cat hcat hR hbc hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR
              hbc hbh rH s c d G D j I.1).1 then ap.gIn P₁c P₂c I.1 else ap.gIn P₁d P₂d I.1)) -
              (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.2 (p + o - 2) (chainVal ap.P (ap.gSt
              cat hcat hR hbc hbh rH s c d G D j I.1).1 (ap.gRest cat hcat hR hbc hbh rH s c d G D j
              I.1) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then ap.gIn P₁c P₂c I.1
              else ap.gIn P₁d P₂d I.1))) p - Yb p)‖ ^ 2) / Real.sqrt (dyadicGridLength A.G I.1)) +
            C₀ * (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G
                I.1 I.2) ((chainVal ap.P (!(ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1)
                (ap.gRest cat hcat hR hbc hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR hbc hbh rH
                s c d G D j I.1).1 then ap.gIn P₁d P₂d I.1 else ap.gIn P₁c P₂c I.1)) - Fb)‖ /
                Real.sqrt (dyadicGridLength A.G I.1)) + (if Unfl then 0 else C₀ ^ 2))) := by
  rw [ap.nearTermG_eq cat hcat hR hbc hbh rH s hab hac had hbc' hbd hcd G D P₁c P₂c P₁d P₂d I I.1
    xg xa j o z]
  have hC := localFormUniformConstant_nonneg κ'
  have hs : 0 < Real.sqrt (dyadicGridLength A.G I.1) := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G
      I.1)
  -- the helper bands are bounded by the side value
  set st := ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1
  have hu : (Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o - 2 ≤ ap.P) ⊆
      Finset.range (ap.P + 1) := Finset.filter_subset _ _
  have hX := (Real.sqrt_le_sqrt (ap.help_bands_bessel cat hcat hR hbc hbh rH s c d G D hj hI xa
    _ hu)).trans (le_of_eq (Real.sqrt_sq (norm_nonneg _)))
  have hX' := div_le_div_of_nonneg_right hX hs.le
  have hae : a ≠ (if st.1 then c else d) := by split_ifs <;> assumption
  have haf : a ≠ (if st.1 then d else c) := by split_ifs <;> assumption
  have hbe : b ≠ (if st.1 then c else d) := by split_ifs <;> assumption
  have hbf : b ≠ (if st.1 then d else c) := by split_ifs <;> assumption
  have hef : (if st.1 then c else d) ≠ (if st.1 then d else c) := by
    split_ifs
    · exact hcd
    · exact hcd.symm
  have hw : 0 ≤ ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (xg b)‖ / Real.sqrt (dyadicGridLength A.G I.1) := by
    positivity
  have hxa : 0 ≤ ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) xa‖ / Real.sqrt (dyadicGridLength A.G I.1) := by
    positivity
  by_cases hU : Unfl
  · simp only [hU, ite_true, add_zero]
    exact ap.nearForm_unflagged I hab hae haf hbe hbf hef z _ _ _ Yb (xg b) _ Fb hC₀ hX' hFc
      (hFb hU) hYc
  · simp only [hU, ite_false, zero_add]
    refine (ap.nearForm_current_le I hab hae haf hbe hbf hef z _ _ _ (xg b) _ hC₀ hX' hFc
      hYc).trans (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left ?_
        (mul_nonneg hw hxa)) hC)
    exact le_add_of_nonneg_left (add_nonneg (mul_nonneg (by positivity)
      (div_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)))
      (mul_nonneg hC₀ (div_nonneg (norm_nonneg _) (Real.sqrt_nonneg _))))

theorem uo_sub (o : ℕ) : ap.uo o ⊆ Finset.range (ap.P + 1) := Finset.filter_subset _ _

/-- The helper bands of the step `j` of a side value `xa` at the depth `h`. -/
noncomputable def Xband (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) (h : ℤ) (xa : ColumnL2 (Fin ap.Mc)) (p : ℕ) :
    ColumnL2 (Fin ap.Mc) :=
  (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).2.1 (p + 1)
      (helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j h) xa) -
    (ap.gSt cat hcat hR hbc hbh rH s c d G D j h).2.1 p
      (helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j h) xa)

/-- The complement slot of the step `j`. -/
def eSlot (c d : Fin 4) (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) : Fin 4 :=
  if (D.getD j (true, 0, none)).1 then c else d

/-- The other complement slot of the step `j`. -/
def fSlot (c d : Fin 4) (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) : Fin 4 :=
  if (D.getD j (true, 0, none)).1 then d else c

