/-- The admissible slot tuples of the `2+2` estimate: distinct slots, helper side `a ≠ u`. -/
def Val (a b c d : Fin 4) : Prop :=
  a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d ∧ a ≠ T.u

/-- A core slot whose core vanishes (a basic `U` slot, or a cell without decision cell). -/
def Ucase (I : ℤ × ℤ) (c d : Fin 4) : Prop :=
  (T.D.usl c ∨ ¬ T.D.hasDecision I) ∨ (T.D.usl d ∨ ¬ T.D.hasDecision I)

open Classical in
/-- The third strong factor of a slot tuple at a cell and group. -/
noncomputable def third (I : ℤ × ℤ) (G : A.Grp) (a b c d : Fin 4)
    (Yf : ℤ × ℤ → Fin 4 → Fin 4 → Fin 4 → ℝ → ℂ)
    (Yb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Fb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Unfl : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → Prop) (C₀ B₀ : ℝ) : ℝ :=
  if T.Val a b c d then
    (if T.Ucase I c d then localFormUniformConstant κ' * B₀ * (T.ns c G I + T.ns d G I) else
      T.strTh c d G I (Yf I c d c) (Yf I c d d) (Yb I G c d) (Fb I G c d) (Unfl I G c d) C₀)
  else 0

open Classical in
/-- The absolute part of a slot tuple at a cell and group: the pair-small and far parts and the
frozen near band forms. -/
noncomputable def absPart (I : ℤ × ℤ) (G : A.Grp) (a b c d : Fin 4) (τ cF : ℝ)
    (Yb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Fb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Unfl : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → Prop) : ℝ :=
  if T.Val a b c d ∧ ¬ T.Ucase I c d then
    ((T.pe d).length * (T.pe c).length : ℝ) * ((τ + cF) * T.s2 G I) +
      T.nearAbs a b c d G I 0 (Yb I G c d) (Fb I G c d) (Unfl I G c d)
  else 0

