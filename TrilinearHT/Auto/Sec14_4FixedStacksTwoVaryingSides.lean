section GluedStacks
variable (G : RealDyadicGrid) {V : Type*} [Fintype V]

/-! ### Glued stacks (blueprint lines 2409-2411) -/

/-- The union of the cells of `U` selecting the index `i`. -/
def selUnion {ι : Type*} (U : Finset (ℤ × ℤ)) (sel : ℤ × ℤ → ι) (i : ι) : Set ℝ :=
  ⋃ I ∈ U, ⋃ (_ : sel I = i), dyadicGridCell G I.1 I.2

theorem selUnion_measurable {ι : Type*} (U : Finset (ℤ × ℤ)) (sel : ℤ × ℤ → ι) (i : ι) :
    MeasurableSet (selUnion G U sel i) :=
  Finset.measurableSet_biUnion _ fun I _ =>
    MeasurableSet.iUnion fun _ => dyadicGridCell_measurable G I.1 I.2

/-- Blueprint line 2410 ("a fixed stack component may be restricted to the union of use cells
selecting it"): the glued stack of the values `val i`, each restricted to the union of the cells
selecting `i`. -/
noncomputable def gluedStack {ι : Type*} (U : Finset (ℤ × ℤ)) (sel : ℤ × ℤ → ι)
    (val : ι → ColumnL2 V) (i : ι) : ColumnL2 V :=
  columnL2Restriction (selUnion G U sel i) (selUnion_measurable G U sel i) (val i)

theorem cell_sub_selUnion {ι : Type*} {U : Finset (ℤ × ℤ)} (sel : ℤ × ℤ → ι) {I : ℤ × ℤ}
    (hI : I ∈ U) : dyadicGridCell G I.1 I.2 ⊆ selUnion G U sel (sel I) :=
  fun _ hy => Set.mem_biUnion hI (Set.mem_iUnion.mpr ⟨rfl, hy⟩)

/-- Blueprint line 2410 ("which preserves its value there"): on a cell of `U` the glued stack at
its selected index is the selected value. -/
theorem gluedStack_restrict {ι : Type*} {U : Finset (ℤ × ℤ)} (sel : ℤ × ℤ → ι)
    (val : ι → ColumnL2 V) {I : ℤ × ℤ} (hI : I ∈ U) :
    columnL2Restriction (dyadicGridCell G I.1 I.2) (dyadicGridCell_measurable G I.1 I.2)
        (gluedStack G U sel val (sel I)) =
      columnL2Restriction (dyadicGridCell G I.1 I.2) (dyadicGridCell_measurable G I.1 I.2)
        (val (sel I)) := by
  unfold gluedStack
  rw [← ContinuousLinearMap.comp_apply, columnL2Restriction_comp_of_subset _ _
    (cell_sub_selUnion G sel hI)]

/-- Blueprint line 2410 ("and decreases its norm"): the glued stack is bounded by its value on any
larger set. -/
theorem gluedStack_norm_sq_le {ι : Type*} (U : Finset (ℤ × ℤ)) (sel : ℤ × ℤ → ι)
    (val : ι → ColumnL2 V) (i : ι) {Ω : Set ℝ} (hΩ : MeasurableSet Ω)
    (hsub : selUnion G U sel i ⊆ Ω) :
    ‖gluedStack G U sel val i‖ ^ 2 ≤ ‖columnL2Restriction Ω hΩ (val i)‖ ^ 2 :=
  columnL2Restriction_norm_sq_mono _ hΩ hsub (val i)

end GluedStacks

section TwoSlotExpansion
variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-! ### Expanding the two varying sides over positions (blueprint lines 2400-2404, 2423) -/

/-- A multilinear form is biadditive over finite sums in two distinct slots. -/
theorem multilinear_update_two_finsum (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {a b : Fin 4}
    (hab : a ≠ b) (x : Fin 4 → E) {α β : Type*} (sa : Finset α) (sb : Finset β) (f : α → E)
    (g : β → E) :
    Λ (Function.update (Function.update x a (∑ i ∈ sa, f i)) b (∑ j ∈ sb, g j)) =
      ∑ i ∈ sa, ∑ j ∈ sb, Λ (Function.update (Function.update x a (f i)) b (g j)) := by
  have h1 : ∀ v : E, Λ (Function.update (Function.update x a v) b (∑ j ∈ sb, g j)) =
      ∑ j ∈ sb, Λ (Function.update (Function.update x a v) b (g j)) := fun v => by
    have := map_sum (Λ.toLinearMap (Function.update x a v) b) g sb
    simp only [MultilinearMap.toLinearMap_apply] at this
    exact this
  rw [h1]
  rw [← Finset.sum_comm]
  refine Finset.sum_congr rfl fun j _ => ?_
  have := map_sum (Λ.toLinearMap (Function.update x b (g j)) a) f sa
  simp only [MultilinearMap.toLinearMap_apply] at this
  rw [Function.update_comm hab, this]
  exact Finset.sum_congr rfl fun i _ => by rw [Function.update_comm hab]

/-- Blueprint lines 2400-2404 and 2423 at one use: with the two varying sides `W_a, W_b` at the
offset `n < 2^N` of a block starting at `b`, the form is the sum over the configurations of levels
`(k_a, k_b)` of the forms of the position components. -/
theorem form_posComp (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {a b : Fin 4} (hab : a ≠ b)
    (x : Fin 4 → E) (Wa Wb : ℕ → E) (b₀ n N : ℕ) (hn : n < 2 ^ N) :
    Λ (Function.update (Function.update x a (Wa (b₀ + n))) b (Wb (b₀ + n))) =
      ∑ ka : Fin (N + 1), ∑ kb : Fin (N + 1),
        Λ (Function.update (Function.update x a (posComp Wa b₀ n N ka)) b
          (posComp Wb b₀ n N kb)) := by
  rw [← sum_posComp Wa b₀ n N hn, ← sum_posComp Wb b₀ n N hn]
  exact multilinear_update_two_finsum Λ hab x _ _ _ _

end TwoSlotExpansion

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- Blueprint lines 2400-2411 and 2423 at one use: if the restrictions of the two varying sides
to the use are the sums of the selected components of their active configurations, the cell form
is the sum over the pairs of active configurations of the forms of the glued stacks. -/
theorem Λc_stacks_expand {I : ℤ × ℤ} {a b : Fin 4} (hab : a ≠ b) (x : Fin 4 → ColumnL2 (Fin ap.Mc))
    (va vb : ColumnL2 (Fin ap.Mc)) {Ka Kb : Type*} (Sa : Finset Ka) (Sb : Finset Kb)
    (fa : Ka → ColumnL2 (Fin ap.Mc)) (fb : Kb → ColumnL2 (Fin ap.Mc))
    (ga : Ka → Kb → ColumnL2 (Fin ap.Mc)) (gb : Ka → Kb → ColumnL2 (Fin ap.Mc))
    (hga : ∀ k ∈ Sa, ∀ k' ∈ Sb, columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (ga k k') = columnL2Restriction
        (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) (fa k))
    (hgb : ∀ k ∈ Sa, ∀ k' ∈ Sb, columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (gb k k') = columnL2Restriction
        (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) (fb k'))
    (hva : columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) va = ∑ k ∈ Sa, columnL2Restriction
        (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) (fa k))
    (hvb : columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) vb = ∑ k ∈ Sb, columnL2Restriction
        (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) (fb k)) :
    ap.Λc I (Function.update (Function.update x a va) b vb) =
      ∑ ka ∈ Sa, ∑ kb ∈ Sb,
        ap.Λc I (Function.update (Function.update x a (ga ka kb)) b (gb ka kb)) := by
  set rI := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
  have hidem : ∀ y, rI (rI y) = rI y := fun y => by
    rw [← ContinuousLinearMap.comp_apply, columnL2Restriction_idem]
  have e1 : ap.Λc I (Function.update (Function.update x a va) b vb) =
      ap.Λc I (Function.update (Function.update x a (∑ k ∈ Sa, rI (fa k))) b
        (∑ k ∈ Sb, rI (fb k))) := by
    refine ap.Λc_congr_restrict I fun l => ?_
    simp only [Function.update_apply]
    split_ifs with h1 h2
    · rw [hvb, map_sum]; exact Finset.sum_congr rfl fun k _ => (hidem _).symm
    · rw [hva, map_sum]; exact Finset.sum_congr rfl fun k _ => (hidem _).symm
    · rfl
  rw [e1, multilinear_update_two_finsum _ hab]
  refine Finset.sum_congr rfl fun ka hka => Finset.sum_congr rfl fun kb hkb => ?_
  refine ap.Λc_congr_restrict I fun l => ?_
  simp only [Function.update_apply]
  split_ifs with h1 h2
  · rw [hidem, hgb ka hka kb hkb]
  · rw [hidem, hga ka hka kb hkb]
  · rfl

end AttemptParams

end ActiveSetup

section PositionConfigs
variable {E : Type*} [AddCommGroup E]

/-! ### Binary position configurations of a varying side (blueprint lines 2400-2411) -/

/-- The component of level `k ≤ N` at the position index `q` of a sequence on offsets: the base
value at level `N`, otherwise the jump over the aligned interval `[q 2^(k+1), q 2^(k+1) + 2^k]`. -/
def posVal (W : ℕ → E) (N : ℕ) (k : Fin (N + 1)) (q : ℕ) : E :=
  if (k : ℕ) = N then W 0 else W (q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ)) - W (q * 2 ^ ((k : ℕ) + 1))

/-- The level `k` is active at the offset `n`: the base level, or the bit `k` of `n` is set. -/
def posAct (N : ℕ) (k : Fin (N + 1)) (n : ℕ) : Prop := (k : ℕ) = N ∨ n.testBit k = true

instance (N : ℕ) (k : Fin (N + 1)) (n : ℕ) : Decidable (posAct N k n) := by
  unfold posAct; infer_instance

theorem posComp_eq (W : ℕ → E) (n N : ℕ) (k : Fin (N + 1)) :
    posComp W 0 n N k = if posAct N k n then posVal W N k (n / 2 ^ ((k : ℕ) + 1)) else 0 := by
  unfold posComp posAct posVal posInt bitPrefix
  by_cases hk : (k : ℕ) = N
  · simp [hk]
  · by_cases hb : n.testBit k = true
    · simp [hk, hb]
    · simp [hk, hb]

/-- Blueprint lines 2400-2402: a sequence at an offset `n < 2^N` is the sum of the components of
its active levels at their position indices. -/
theorem pos_rep (W : ℕ → E) {n N : ℕ} (hn : n < 2 ^ N) :
    W n = ∑ k ∈ Finset.univ.filter (fun k : Fin (N + 1) => posAct N k n),
      posVal W N k (n / 2 ^ ((k : ℕ) + 1)) := by
  have h := sum_posComp W 0 n N hn
  rw [zero_add] at h
  rw [← h, Finset.sum_filter]
  exact Finset.sum_congr rfl fun k _ => posComp_eq W n N k

/-- The right end of the position of an active level below the base lies at or before the
offset. -/
theorem posEnd_le {n N : ℕ} {k : Fin (N + 1)} (hk : (k : ℕ) ≠ N) (ha : posAct N k n) :
    n / 2 ^ ((k : ℕ) + 1) * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ) ≤ n := by
  have hb : n.testBit k = true := ha.resolve_left hk
  have h := bitPrefix_succ n k
  simp only [hb, ite_true] at h
  have h0 : bitPrefix n k ≤ n := Nat.div_mul_le_self n _
  unfold bitPrefix at h h0
  omega

end PositionConfigs

/-- The union of the cells selecting an index lies in the union of their ancestors at any depth
at most theirs. -/
theorem selUnion_sub_anc (G : RealDyadicGrid) {ι : Type*} [DecidableEq ι] (U : Finset (ℤ × ℤ))
    (sel : ℤ × ℤ → ι) (d : ι → ℤ) (hd : ∀ I ∈ U, d (sel I) ≤ I.1) (q : ι) :
    selUnion G U sel q ⊆ ⋃ J ∈ (U.filter (fun I => sel I = q)).image (fun I => ancAt G I (d q)),
      dyadicGridCell G J.1 J.2 := by
  intro y hy
  simp only [selUnion, Set.mem_iUnion] at hy
  obtain ⟨I, hI, hq, hyI⟩ := hy
  subst hq
  exact Set.mem_biUnion (Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨hI, rfl⟩))
    (subset_ancAt G I (hd I hI) hyI)

namespace ActiveSetup
variable {κ' : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ' c₀)

/-! ### Variation capacities and the energies of position stacks (blueprint lines 2408-2411) -/

/-- A family of global sequences `Z_g` (`g ∈ Gs`) has variation capacity `B` over certified cells
when, for any family of disjoint depth intervals `(r_i, t_i]` below the root and any families of
certified active cells at the right endpoints, the restricted jumps have total square at most
`B` (blueprint lem:variation). -/
def VarCap {γ : Type*} {V : Type*} [Fintype V] (Gs : Finset γ) (Z : γ → ℤ → ColumnL2 V)
    (ok : γ → ℤ × ℤ → Prop) (B : ℝ) : Prop :=
  ∀ {ι : Type} [Fintype ι] (r t : ι → ℕ), (∀ i, r i ≤ t i) →
    (∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i'))) →
    (∀ i, t i ≤ A.treeDepth) → ∀ Ec : γ → ι → Finset (ℤ × ℤ),
    (∀ g i, ∀ J ∈ Ec g i, J ∈ A.cells ∧ J.1 = A.R.1 + t i ∧ ok g J) →
    ∑ g ∈ Gs, ∑ i, ‖columnL2Restriction (⋃ J ∈ Ec g i, dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (Z g (A.R.1 + t i) - Z g (A.R.1 + r i))‖ ^ 2 ≤ B

end ActiveSetup

/-- The intervals of the positions of one level are disjoint. -/
theorem posIoc_disjoint {k q q' : ℕ} (hqq : q ≠ q') :
    Disjoint (Finset.Ioc (q * 2 ^ (k + 1)) (q * 2 ^ (k + 1) + 2 ^ k))
      (Finset.Ioc (q' * 2 ^ (k + 1)) (q' * 2 ^ (k + 1) + 2 ^ k)) := by
  rw [Finset.disjoint_left]
  intro x hx hx'
  simp only [Finset.mem_Ioc] at hx hx'
  have h2 : (2 : ℕ) ^ (k + 1) = 2 * 2 ^ k := by ring
  rcases Nat.lt_or_gt_of_ne hqq with h | h
  · have : (q + 1) * 2 ^ (k + 1) ≤ q' * 2 ^ (k + 1) := Nat.mul_le_mul_right _ h
    nlinarith
  · have : (q' + 1) * 2 ^ (k + 1) ≤ q * 2 ^ (k + 1) := Nat.mul_le_mul_right _ h
    nlinarith

namespace ActiveSetup
variable {κ' : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ' c₀)

open Classical in
/-- Blueprint lines 2408-2411 (`eq:stack-energy` for the positions of one level below the base):
if the side values of block `β` have the jumps of a family `Z_g` of variation capacity `B`, the
glued position stacks of a level `k < N` over the uses of all groups and blocks have total square
at most `B` (the positions of one level are disjoint depth intervals, also across the blocks). -/
theorem posStack_energy (hanc : A.AncClosed) {γ : Type*} {V : Type*} [Fintype V]
    (Gs : Finset γ) (Z : γ → ℤ → ColumnL2 V) (ok : γ → ℤ × ℤ → Prop) {B : ℝ}
    (hcap : A.VarCap Gs Z ok B) {K N : ℕ} (k : Fin (N + 1)) (hk : (k : ℕ) ≠ N)
    (Bs : Finset ℕ) (U : γ → ℕ → Finset (ℤ × ℤ)) (off : ℤ × ℤ → ℕ)
    (hU : ∀ g β, ∀ I ∈ U g β, I ∈ A.cells ∧ I.1 = A.R.1 + (K * β + off I : ℕ) ∧ off I < K)
    (hok : ∀ g ∈ Gs, ∀ β, ∀ I ∈ U g β, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → ok g J)
    (Sb : γ → ℕ → ℤ → ColumnL2 V)
    (hSb : ∀ g β h h', Sb g β h - Sb g β h' = Z g h - Z g h') :
    ∑ g ∈ Gs, ∑ β ∈ Bs, ∑ q ∈ ((U g β).filter fun I => posAct N k (off I)).image
        (fun I => off I / 2 ^ ((k : ℕ) + 1)),
      ‖gluedStack A.G ((U g β).filter fun I => posAct N k (off I))
        (fun I => off I / 2 ^ ((k : ℕ) + 1))
        (fun q => posVal (fun n => Sb g β (A.R.1 + (K * β + n : ℕ))) N k q) q‖ ^ 2 ≤ B := by
  set U' : γ → ℕ → Finset (ℤ × ℤ) := fun g β => (U g β).filter fun I => posAct N k (off I)
  set sel : ℤ × ℤ → ℕ := fun I => off I / 2 ^ ((k : ℕ) + 1)
  set S : Finset (ℕ × ℕ) := Gs.biUnion fun g => Bs.biUnion fun β =>
    ((U' g β).image sel).image fun q => (β, q)
  have hmemS : ∀ g ∈ Gs, ∀ β ∈ Bs, ∀ q ∈ (U' g β).image sel, (β, q) ∈ S := fun g hg β hβ q hq =>
    Finset.mem_biUnion.mpr ⟨g, hg, Finset.mem_biUnion.mpr ⟨β, hβ, Finset.mem_image_of_mem _ hq⟩⟩
  -- every used position ends before its uses
  have huse : ∀ g β, ∀ I ∈ U' g β,
      sel I * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ) ≤ off I := fun g β I hI =>
    posEnd_le hk (Finset.mem_filter.mp hI).2
  have hS : ∀ x ∈ S, ∃ g, ∃ I ∈ U g x.1,
      x.2 * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ) ≤ off I := by
    intro x hx
    obtain ⟨g, -, hg⟩ := Finset.mem_biUnion.mp hx
    obtain ⟨β, -, hβ⟩ := Finset.mem_biUnion.mp hg
    obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hβ
    obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hq
    exact ⟨g, I, (Finset.mem_filter.mp hI).1, huse g β I hI⟩
  let ι := {x : ℕ × ℕ // x ∈ S}
  let r : ι → ℕ := fun x => K * x.1.1 + x.1.2 * 2 ^ ((k : ℕ) + 1)
  let t : ι → ℕ := fun x => K * x.1.1 + (x.1.2 * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ))
  have hrt : ∀ i, r i ≤ t i := fun i => Nat.add_le_add_left (Nat.le_add_right _ _) _
  have hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')) := by
    intro i i' hii
    obtain ⟨g, I, hI, hIt⟩ := hS i.1 i.2
    obtain ⟨g', I', hI', hIt'⟩ := hS i'.1 i'.2
    have hK1 := (hU g _ I hI).2.2
    have hK2 := (hU g' _ I' hI').2.2
    rw [Finset.disjoint_left]
    intro x hx hx'
    simp only [Finset.mem_Ioc, r, t] at hx hx'
    by_cases hβ : i.1.1 = i'.1.1
    · have hq : i.1.2 ≠ i'.1.2 := fun h => hii (Subtype.ext (Prod.ext hβ h))
      have h0 := Finset.disjoint_left.mp (posIoc_disjoint (k := (k : ℕ)) hq)
        (show x - K * i.1.1 ∈ Finset.Ioc _ _ from Finset.mem_Ioc.mpr ⟨by omega, by omega⟩)
      rw [← hβ] at hx'
      exact h0 (Finset.mem_Ioc.mpr ⟨by omega, by omega⟩)
    · rcases Nat.lt_or_gt_of_ne hβ with h | h
      · have : K * i.1.1 + K ≤ K * i'.1.1 := by nlinarith
        omega
      · have : K * i'.1.1 + K ≤ K * i.1.1 := by nlinarith
        omega
  have htd : ∀ i, t i ≤ A.treeDepth := by
    intro i
    obtain ⟨g, I, hI, hIt⟩ := hS i.1 i.2
    obtain ⟨hIc, hIdep, -⟩ := hU g _ I hI
    have := ((dyadicFiniteTree_mem_iff A.G A.R I A.treeDepth).mp (A.cells_mem_tree hIc)).2
    simp only [t]
    omega
  let Ec : γ → ι → Finset (ℤ × ℤ) := fun g i => if g ∈ Gs then
    ((U' g i.1.1).filter fun I => sel I = i.1.2).image fun I => ancAt A.G I (A.R.1 + t i)
    else ∅
  have hdle : ∀ g (β q : ℕ), ∀ I ∈ U' g β, sel I = q →
      A.R.1 + ((K * β + (q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ)) : ℕ) : ℤ) ≤ I.1 := by
    intro g β q I hI hq
    have h1 := huse g β I hI
    rw [hq] at h1
    rw [(hU g β I (Finset.mem_filter.mp hI).1).2.1]
    push_cast
    have : ((q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ) : ℕ) : ℤ) ≤ (off I : ℤ) := by exact_mod_cast h1
    push_cast at this
    linarith
  have hEc : ∀ g i, ∀ J ∈ Ec g i, J ∈ A.cells ∧ J.1 = A.R.1 + t i ∧ ok g J := by
    intro g i J hJ
    simp only [Ec] at hJ
    split_ifs at hJ with hg
    · obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hJ
      obtain ⟨hIU', hIq⟩ := Finset.mem_filter.mp hI
      have hIc := (hU g _ I (Finset.mem_filter.mp hIU').1).1
      have hd := hdle g i.1.1 i.1.2 I hIU' hIq
      have hsub := subset_ancAt A.G I hd
      have hR1 : A.R.1 ≤ A.R.1 + (t i : ℤ) := by omega
      have hJc : ancAt A.G I (A.R.1 + t i) ∈ A.cells :=
        hanc I hIc _ hsub (ancAt_subset (A.sub I hIc) hR1)
      exact ⟨hJc, rfl, hok g hg _ I (Finset.mem_filter.mp hIU').1 _ hJc hsub⟩
    · simp at hJ
  have hcap' := hcap r t hrt hdis htd Ec hEc
  refine le_trans ?_ hcap'
  refine Finset.sum_le_sum fun g hg => ?_
  set F : ι → ℝ := fun i => ‖columnL2Restriction (⋃ J ∈ Ec g i, dyadicGridCell A.G J.1 J.2)
    (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
    (Z g (A.R.1 + t i) - Z g (A.R.1 + r i))‖ ^ 2
  have hterm : ∀ β (hβ : β ∈ Bs), ∀ q (hq : q ∈ (U' g β).image sel),
      ‖gluedStack A.G (U' g β) sel
        (fun q => posVal (fun n => Sb g β (A.R.1 + (K * β + n : ℕ))) N k q) q‖ ^ 2 ≤
      F ⟨(β, q), hmemS g hg β hβ q hq⟩ := by
    intro β hβ q hq
    have hsub := selUnion_sub_anc A.G (U' g β) sel
      (fun q => A.R.1 + ((K * β + (q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ)) : ℕ) : ℤ))
      (fun I hI => hdle g β _ I hI rfl) q
    refine (gluedStack_norm_sq_le A.G _ _ _ q (Finset.measurableSet_biUnion
      (Ec g ⟨(β, q), hmemS g hg β hβ q hq⟩) fun J _ =>
        dyadicGridCell_measurable A.G J.1 J.2) ?_).trans (le_of_eq ?_)
    · refine hsub.trans (le_of_eq ?_)
      simp only [Ec, hg, ite_true]
      rfl
    · simp only [F, posVal, hk, ite_false, hSb]
      rfl
  set F' : ℕ × ℕ → ℝ := fun x => if h : x ∈ S then F ⟨x, h⟩ else 0
  have hF'0 : ∀ x, 0 ≤ F' x := fun x => by
    simp only [F']
    split_ifs <;> positivity
  calc ∑ β ∈ Bs, ∑ q ∈ (U' g β).image sel, ‖gluedStack A.G (U' g β) sel
        (fun q => posVal (fun n => Sb g β (A.R.1 + (K * β + n : ℕ))) N k q) q‖ ^ 2
      ≤ ∑ β ∈ Bs, ∑ q ∈ (U' g β).image sel, F' (β, q) := by
        refine Finset.sum_le_sum fun β hβ => Finset.sum_le_sum fun q hq => ?_
        simp only [F', hmemS g hg β hβ q hq, dite_true]
        exact hterm β hβ q hq
    _ = ∑ x ∈ Bs.biUnion (fun β => ((U' g β).image sel).image fun q => (β, q)), F' x := by
        rw [Finset.sum_biUnion]
        · refine Finset.sum_congr rfl fun β _ => ?_
          rw [Finset.sum_image fun q _ q' _ h => (Prod.ext_iff.mp h).2]
        · intro β _ β' _ hββ
          simp only [Function.onFun]
          rw [Finset.disjoint_left]
          intro x hx hx'
          obtain ⟨q, -, rfl⟩ := Finset.mem_image.mp hx
          obtain ⟨q', -, h⟩ := Finset.mem_image.mp hx'
          exact hββ (Prod.ext_iff.mp h).1.symm
    _ ≤ ∑ x ∈ S, F' x := by
        refine Finset.sum_le_sum_of_subset_of_nonneg (fun x hx => ?_) fun x _ _ => hF'0 x
        obtain ⟨β, hβ, hx⟩ := Finset.mem_biUnion.mp hx
        obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hx
        exact hmemS g hg β hβ q hq
    _ = ∑ i : ι, F i := by
        rw [← Finset.sum_attach S, Finset.univ_eq_attach]
        refine Finset.sum_congr rfl fun i _ => ?_
        simp only [F', i.2, dite_true]

end ActiveSetup

/-- `‖a - b‖² ≤ 2 ‖a‖² + 2 ‖b‖²`. -/
theorem norm_sub_sq_le_two_mul {E : Type*} [SeminormedAddCommGroup E] (a b : E) :
    ‖a - b‖ ^ 2 ≤ 2 * ‖a‖ ^ 2 + 2 * ‖b‖ ^ 2 := by
  have h := norm_sub_le a b
  have h0 := norm_nonneg (a - b)
  nlinarith [sq_nonneg (‖a‖ - ‖b‖), norm_nonneg a, norm_nonneg b]

/-- `‖a + b‖² ≤ 2 ‖a‖² + 2 ‖b‖²`. -/
theorem norm_add_sq_le_two_mul {E : Type*} [SeminormedAddCommGroup E] (a b : E) :
    ‖a + b‖ ^ 2 ≤ 2 * ‖a‖ ^ 2 + 2 * ‖b‖ ^ 2 := by
  have h := norm_add_le a b
  have h0 := norm_nonneg (a + b)
  nlinarith [sq_nonneg (‖a‖ - ‖b‖), norm_nonneg a, norm_nonneg b]

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- The certification of a cell for the group `G` of color `k`: an active cell below it carrying
a successful vertex of color `k` and group `G`. -/
def certOK (k : ℕ) (G : A.Grp) (J : ℤ × ℤ) : Prop :=
  ∃ u' ∈ A.cells, dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G J.1 J.2 ∧
    ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
      ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
      ap.K.grp A.admT A.vtxBound (A.admAt u') x = G

/-- The constant of `attempt_variation_basic` for one basic projection. -/
noncomputable def basicVarB (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (ls : List (ℕ × Bool)) (τ : ℝ) (N : ℕ) {V : Type*}
    [Fintype V] (Ψ : ColumnDepthFamily V) (Z : ColumnL2 V) : ℝ :=
  2 * (2 * (1 + τ * N * 1 ^ 2) *
      (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
        ls.length * (∑ m ∈ Finset.range ls.length,
          compressionC (ap.cumBase cat hR hb).D m ^ 2)) *
      compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) +
    2 * ((1 + τ * N * 1 ^ 2) * ‖Z‖ ^ 2)

open Classical in
/-- Blueprint lem:variation for the leaf outputs of a basic slot: the global outputs of the two
basic projections of the slot, for the groups of one color, have variation capacity
`2 B(P₁) + 2 B(P₂)` over certified cells. -/
theorem varCap_out (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed)
    (Gs : Finset A.Grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (ls : List (ℕ × Bool)) {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆
      Set.Icc ra rb) {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset ({G // G ∈ Gs} × Fin ap.Mc)).filter
      fun q : {G // G ∈ Gs} × Fin ap.Mc =>
      ∃ I ∈ A.cells, ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I q.1.1 j p)).card ≤ N)
    {CF : ℝ} (P₁ P₂ : BasicProjection A.G A.R CF) :
    A.VarCap Gs (fun G h => ap.projOut cat hR hb r₀ j G ls P₁ h -
        ap.projOut cat hR hb r₀ j G ls P₂ h) (ap.certOK k)
      (2 * ap.basicVarB cat hR hb ls τ N P₁.Ψ P₁.Z +
        2 * ap.basicVarB cat hR hb ls τ N P₂.Ψ P₂.Z) := by
  intro ι _ r t hrt hdis htd Ec hEc
  have hroot' : ∀ P : BasicProjection A.G A.R CF, P.Ψ.D.root.1 ≤ A.R.1 := fun P =>
    dyadicGridCell_depth_le_of_subset A.G A.R P.Ψ.D.root P.root_sub
  have hv : ∀ P : BasicProjection A.G A.R CF,
      ∑ q : {G // G ∈ Gs} × ι, ‖columnL2Restriction (⋃ J ∈ Ec q.1.1 q.2,
        dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (ap.projOut cat hR hb r₀ j q.1.1 ls P (A.R.1 + t q.2) -
          ap.projOut cat hR hb r₀ j q.1.1 ls P (A.R.1 + r q.2))‖ ^ 2 ≤
        ap.basicVarB cat hR hb ls τ N P.Ψ P.Z := fun P =>
    ap.attempt_variation_basic cat t₀ hT hR hb hanc (fun G : {G // G ∈ Gs} => G.1)
      Subtype.val_injective k r₀ j hPH ls r t hrt hdis htd (fun G i => Ec G.1 i)
      (fun G i J hJ => ⟨(hEc G.1 i J hJ).1, (hEc G.1 i J hJ).2.1⟩)
      (fun G i J hJ => (hEc G.1 i J hJ).2.2) hroot hτ hτ1 hHed hN P.Ψ P.grid
      P.root_sub (hroot' P) P.Z
  have hsplit : ∀ G i, ‖columnL2Restriction (⋃ J ∈ Ec G i, dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      ((ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + t i) -
          ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + t i)) -
        (ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + r i) -
          ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + r i)))‖ ^ 2 ≤
      2 * ‖columnL2Restriction (⋃ J ∈ Ec G i, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + t i) -
          ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + r i))‖ ^ 2 +
      2 * ‖columnL2Restriction (⋃ J ∈ Ec G i, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + t i) -
          ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + r i))‖ ^ 2 := by
    intro G i
    have e : (ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + t i) -
          ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + t i)) -
        (ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + r i) -
          ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + r i)) =
        (ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + t i) -
          ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + r i)) -
        (ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + t i) -
          ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + r i)) := by abel
    rw [e, map_sub]
    exact norm_sub_sq_le_two_mul _ _
  calc ∑ G ∈ Gs, ∑ i, _ ≤ ∑ G ∈ Gs, ∑ i, (2 * ‖columnL2Restriction
          (⋃ J ∈ Ec G i, dyadicGridCell A.G J.1 J.2)
          (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
          (ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + t i) -
            ap.projOut cat hR hb r₀ j G ls P₁ (A.R.1 + r i))‖ ^ 2 +
        2 * ‖columnL2Restriction (⋃ J ∈ Ec G i, dyadicGridCell A.G J.1 J.2)
          (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
          (ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + t i) -
            ap.projOut cat hR hb r₀ j G ls P₂ (A.R.1 + r i))‖ ^ 2) :=
        Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun i _ => hsplit G i
    _ = 2 * ∑ q : {G // G ∈ Gs} × ι, ‖columnL2Restriction (⋃ J ∈ Ec q.1.1 q.2,
          dyadicGridCell A.G J.1 J.2)
          (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
          (ap.projOut cat hR hb r₀ j q.1.1 ls P₁ (A.R.1 + t q.2) -
            ap.projOut cat hR hb r₀ j q.1.1 ls P₁ (A.R.1 + r q.2))‖ ^ 2 +
        2 * ∑ q : {G // G ∈ Gs} × ι, ‖columnL2Restriction (⋃ J ∈ Ec q.1.1 q.2,
          dyadicGridCell A.G J.1 J.2)
          (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
          (ap.projOut cat hR hb r₀ j q.1.1 ls P₂ (A.R.1 + t q.2) -
            ap.projOut cat hR hb r₀ j q.1.1 ls P₂ (A.R.1 + r q.2))‖ ^ 2 := by
        rw [Fintype.sum_prod_type, Fintype.sum_prod_type, ← Finset.sum_coe_sort Gs,
          Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun G _ => ?_
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    _ ≤ _ := by
        have h1 := hv P₁
        have h2 := hv P₂
        linarith

end AttemptParams

end ActiveSetup

section BandSplit
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-! ### Banded stacks of the transferred side (blueprint lines 2408-2409, 2414-2423) -/

/-- Blueprint lines 2408-2409 ("on the banded side pay at most `P + 1` indices"): with pad
families `A_n` at the two depths `t, r`, Bessel bands at `t`, and a restriction `E` commuting with
the operators at `t`, the band jumps of a side `S` split into the side jump and the pad jumps on
the left value: `Σ_p ‖E(B_p(t) S_t - B_p(r) S_r)‖² ≤ 2 ‖E(S_t - S_r)‖² +
8 Σ_{n ≤ P+1} ‖E((A_n(t) - A_n(r)) S_r)‖²`. -/
theorem band_split {P : ℕ} (At Ar : ℕ → E →L[ℂ] E) (Er : E →L[ℂ] E)
    (hbes : ∀ y, ∑ p ∈ Finset.range (P + 1), ‖(At (p + 1) - At p) y‖ ^ 2 ≤ ‖y‖ ^ 2)
    (hcomm : ∀ n, Er.comp (At n) = (At n).comp Er) (St Sr : E) :
    ∑ p ∈ Finset.range (P + 1), ‖Er ((At (p + 1) - At p) St - (Ar (p + 1) - Ar p) Sr)‖ ^ 2 ≤
      2 * ‖Er (St - Sr)‖ ^ 2 +
        8 * ∑ n ∈ Finset.range (P + 2), ‖Er ((At n - Ar n) Sr)‖ ^ 2 := by
  have hc : ∀ n y, Er (At n y) = At n (Er y) := fun n y => DFunLike.congr_fun (hcomm n) y
  set a : ℕ → E := fun n => Er ((At n - Ar n) Sr)
  have hsplit : ∀ p, Er ((At (p + 1) - At p) St - (Ar (p + 1) - Ar p) Sr) =
      (At (p + 1) - At p) (Er (St - Sr)) + (a (p + 1) - a p) := by
    intro p
    simp only [a, sub_apply, map_sub, hc]
    abel
  have hterm : ∀ p, ‖Er ((At (p + 1) - At p) St - (Ar (p + 1) - Ar p) Sr)‖ ^ 2 ≤
      2 * ‖(At (p + 1) - At p) (Er (St - Sr))‖ ^ 2 +
        (4 * ‖a (p + 1)‖ ^ 2 + 4 * ‖a p‖ ^ 2) := by
    intro p
    rw [hsplit]
    refine (norm_add_sq_le_two_mul _ _).trans ?_
    have := norm_sub_sq_le_two_mul (a (p + 1)) (a p)
    linarith
  calc ∑ p ∈ Finset.range (P + 1), ‖Er ((At (p + 1) - At p) St - (Ar (p + 1) - Ar p) Sr)‖ ^ 2
      ≤ ∑ p ∈ Finset.range (P + 1), (2 * ‖(At (p + 1) - At p) (Er (St - Sr))‖ ^ 2 +
          (4 * ‖a (p + 1)‖ ^ 2 + 4 * ‖a p‖ ^ 2)) := Finset.sum_le_sum fun p _ => hterm p
    _ = 2 * ∑ p ∈ Finset.range (P + 1), ‖(At (p + 1) - At p) (Er (St - Sr))‖ ^ 2 +
          4 * (∑ p ∈ Finset.range (P + 1), ‖a (p + 1)‖ ^ 2 +
            ∑ p ∈ Finset.range (P + 1), ‖a p‖ ^ 2) := by
        simp only [Finset.sum_add_distrib, mul_add, Finset.mul_sum]
    _ ≤ 2 * ‖Er (St - Sr)‖ ^ 2 + 4 * (2 * ∑ n ∈ Finset.range (P + 2), ‖a n‖ ^ 2) := by
        have h1 := hbes (Er (St - Sr))
        have h2 : ∑ p ∈ Finset.range (P + 1), ‖a (p + 1)‖ ^ 2 ≤
            ∑ n ∈ Finset.range (P + 2), ‖a n‖ ^ 2 := by
          rw [Finset.sum_range_succ' (fun n => ‖a n‖ ^ 2) (P + 1)]
          have := norm_nonneg (a 0)
          nlinarith
        have h3 : ∑ p ∈ Finset.range (P + 1), ‖a p‖ ^ 2 ≤
            ∑ n ∈ Finset.range (P + 2), ‖a n‖ ^ 2 :=
          Finset.sum_le_sum_of_subset_of_nonneg (fun x hx => Finset.mem_range.mpr
            (by have := Finset.mem_range.mp hx; omega)) fun n _ _ => by positivity
        nlinarith
    _ = 2 * ‖Er (St - Sr)‖ ^ 2 + 8 * ∑ n ∈ Finset.range (P + 2), ‖a n‖ ^ 2 := by ring

/-- Blueprint lines 2420-2423 (one fixed inner interval for all outer positions using it): if
each used outer row acts on its inner jump as on a common fixed input `X_{π q}`, and the rows of
any subfamily are Bessel with constant `C_j`, the used rows have total square at most
`C_j Σ_{q'} ‖X_{q'}‖²`. -/
theorem rows_fixed_inputs {Q Q' : Type*} [DecidableEq Q'] (Qs : Finset Q) (F : Q → E →L[ℂ] E)
    (used : Q → Prop) [DecidablePred used] (π : Q → Q') (Y : Q → E) (X : Q' → E)
    (hloc : ∀ q ∈ Qs, used q → F q (Y q) = F q (X (π q))) {Cj : ℝ}
    (hJ : ∀ s ⊆ Qs, ∀ x, ∑ q ∈ s, ‖F q x‖ ^ 2 ≤ Cj * ‖x‖ ^ 2) :
    ∑ q ∈ Qs.filter used, ‖F q (Y q)‖ ^ 2 ≤
      Cj * ∑ q' ∈ (Qs.filter used).image π, ‖X q'‖ ^ 2 := by
  calc ∑ q ∈ Qs.filter used, ‖F q (Y q)‖ ^ 2
      = ∑ q ∈ Qs.filter used, ‖F q (X (π q))‖ ^ 2 := Finset.sum_congr rfl fun q hq => by
        rw [hloc q (Finset.mem_filter.mp hq).1 (Finset.mem_filter.mp hq).2]
    _ = ∑ q' ∈ (Qs.filter used).image π, ∑ q ∈ (Qs.filter used).filter (fun q => π q = q'),
          ‖F q (X q')‖ ^ 2 := by
        rw [← Finset.sum_fiberwise_of_maps_to (fun q hq => Finset.mem_image_of_mem π hq)]
        refine Finset.sum_congr rfl fun q' _ => Finset.sum_congr rfl fun q hq => ?_
        rw [(Finset.mem_filter.mp hq).2]
    _ ≤ ∑ q' ∈ (Qs.filter used).image π, Cj * ‖X q'‖ ^ 2 :=
        Finset.sum_le_sum fun q' _ => hJ _ ((Finset.filter_subset _ _).trans
          (Finset.filter_subset _ _)) _
    _ = Cj * ∑ q' ∈ (Qs.filter used).image π, ‖X q'‖ ^ 2 := by rw [Finset.mul_sum]

end BandSplit

section BandBlock
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- Blueprint lines 2414-2423 in one block: the banded position jumps of the transferred side
`S_h = Z_h - Z_b + W` over the positions `q` of one level are bounded by the side jumps, the jumps
of the `P + 2` pad families on the fixed block input `W'` (equal to `W` under the rows), and the
jumps on the fixed inner inputs `X_{k',q'}` of the binary expansion of `Z_{r_q} - Z_b`. -/
theorem band_block {P : ℕ} (Qs : Finset ℕ) (Eq : ℕ → E →L[ℂ] E) (At Ar : ℕ → ℕ → E →L[ℂ] E)
    (hbes : ∀ q ∈ Qs, ∀ y, ∑ p ∈ Finset.range (P + 1), ‖(At q (p + 1) - At q p) y‖ ^ 2 ≤ ‖y‖ ^ 2)
    (hcomm : ∀ q ∈ Qs, ∀ n, (Eq q).comp (At q n) = (At q n).comp (Eq q))
    {Cj : ℝ}
    (hJ : ∀ n, ∀ s ⊆ Qs, ∀ x, ∑ q ∈ s, ‖Eq q ((At q n - Ar q n) x)‖ ^ 2 ≤ Cj * ‖x‖ ^ 2)
    (St Sr Dz : ℕ → E) (W W' : E) (hSr : ∀ q ∈ Qs, Sr q = Dz q + W)
    (hW : ∀ q ∈ Qs, ∀ n, Eq q ((At q n - Ar q n) W) = Eq q ((At q n - Ar q n) W'))
    {Nl : ℕ} (Y : ℕ → ℕ → E) (hY : ∀ q ∈ Qs, Dz q = ∑ k' ∈ Finset.range Nl, Y q k')
    (used : ℕ → ℕ → Prop) [∀ k', DecidablePred (used k')] (hYu : ∀ q k', ¬ used k' q → Y q k' = 0)
    (π : ℕ → ℕ → ℕ) (X : ℕ → ℕ → E)
    (hloc : ∀ k', ∀ q ∈ Qs, used k' q → ∀ n,
      Eq q ((At q n - Ar q n) (Y q k')) = Eq q ((At q n - Ar q n) (X k' (π k' q)))) :
    ∑ q ∈ Qs, ∑ p ∈ Finset.range (P + 1),
        ‖Eq q ((At q (p + 1) - At q p) (St q) - (Ar q (p + 1) - Ar q p) (Sr q))‖ ^ 2 ≤
      2 * ∑ q ∈ Qs, ‖Eq q (St q - Sr q)‖ ^ 2 + 16 * (P + 2) * (Cj * ‖W'‖ ^ 2) +
        16 * (P + 2) * (Nl * (Cj * ∑ k' ∈ Finset.range Nl,
          ∑ q' ∈ (Qs.filter (used k')).image (π k'), ‖X k' q'‖ ^ 2)) := by
  -- the band split at each position
  have h1 : ∀ q ∈ Qs, ∑ p ∈ Finset.range (P + 1),
      ‖Eq q ((At q (p + 1) - At q p) (St q) - (Ar q (p + 1) - Ar q p) (Sr q))‖ ^ 2 ≤
      2 * ‖Eq q (St q - Sr q)‖ ^ 2 + 8 * ∑ n ∈ Finset.range (P + 2),
        ‖Eq q ((At q n - Ar q n) (Sr q))‖ ^ 2 := fun q hq =>
    band_split (At q) (Ar q) (Eq q) (hbes q hq) (hcomm q hq) (St q) (Sr q)
  -- the left value splits into the inner part and the fixed block input
  have h2 : ∀ q ∈ Qs, ∀ n, ‖Eq q ((At q n - Ar q n) (Sr q))‖ ^ 2 ≤
      2 * ‖Eq q ((At q n - Ar q n) W')‖ ^ 2 +
        2 * (Nl * ∑ k' ∈ Finset.range Nl, ‖Eq q ((At q n - Ar q n) (Y q k'))‖ ^ 2) := by
    intro q hq n
    rw [hSr q hq, map_add, map_add, hW q hq n, hY q hq, map_sum, map_sum]
    refine (norm_add_sq_le_two_mul _ _).trans ?_
    rw [add_comm]
    gcongr
    refine (pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2).trans ?_
    refine sq_sum_le_card_mul_sum_sq.trans ?_
    simp
  -- the inner jumps on the fixed inputs
  have h3 : ∀ n, ∀ k' ∈ Finset.range Nl, ∑ q ∈ Qs, ‖Eq q ((At q n - Ar q n) (Y q k'))‖ ^ 2 ≤
      Cj * ∑ q' ∈ (Qs.filter (used k')).image (π k'), ‖X k' q'‖ ^ 2 := by
    intro n k' _
    rw [← Finset.sum_filter_add_sum_filter_not Qs (used k')]
    have hz : ∑ q ∈ Qs.filter (fun q => ¬ used k' q),
        ‖Eq q ((At q n - Ar q n) (Y q k'))‖ ^ 2 = 0 :=
      Finset.sum_eq_zero fun q hq => by
        rw [hYu q k' (Finset.mem_filter.mp hq).2]; simp
    rw [hz, add_zero]
    exact rows_fixed_inputs Qs (fun q => (Eq q).comp (At q n - Ar q n)) (used k') (π k')
      (fun q => Y q k') (X k') (fun q hq hu => hloc k' q hq hu n)
      (fun s hs x => hJ n s hs x)
  have h4 : ∀ n, ∑ q ∈ Qs, ‖Eq q ((At q n - Ar q n) W')‖ ^ 2 ≤ Cj * ‖W'‖ ^ 2 :=
    fun n => hJ n Qs subset_rfl W'
  set T : ℝ := Cj * ∑ k' ∈ Finset.range Nl,
    ∑ q' ∈ (Qs.filter (used k')).image (π k'), ‖X k' q'‖ ^ 2
  have h5 : ∀ n, ∑ q ∈ Qs, ‖Eq q ((At q n - Ar q n) (Sr q))‖ ^ 2 ≤
      2 * (Cj * ‖W'‖ ^ 2) + 2 * (Nl * T) := by
    intro n
    refine (Finset.sum_le_sum fun q hq => h2 q hq n).trans ?_
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum,
      Finset.sum_comm]
    gcongr
    · exact h4 n
    · simp only [T, Finset.mul_sum]
      exact Finset.sum_le_sum fun k' hk' =>
        (h3 n k' hk').trans (le_of_eq (Finset.mul_sum _ _ _))
  calc ∑ q ∈ Qs, ∑ p ∈ Finset.range (P + 1),
        ‖Eq q ((At q (p + 1) - At q p) (St q) - (Ar q (p + 1) - Ar q p) (Sr q))‖ ^ 2
      ≤ ∑ q ∈ Qs, (2 * ‖Eq q (St q - Sr q)‖ ^ 2 + 8 * ∑ n ∈ Finset.range (P + 2),
          ‖Eq q ((At q n - Ar q n) (Sr q))‖ ^ 2) := Finset.sum_le_sum h1
    _ = 2 * ∑ q ∈ Qs, ‖Eq q (St q - Sr q)‖ ^ 2 + 8 * ∑ n ∈ Finset.range (P + 2),
          ∑ q ∈ Qs, ‖Eq q ((At q n - Ar q n) (Sr q))‖ ^ 2 := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, Finset.sum_comm]
    _ ≤ 2 * ∑ q ∈ Qs, ‖Eq q (St q - Sr q)‖ ^ 2 + 8 * ∑ _n ∈ Finset.range (P + 2),
          (2 * (Cj * ‖W'‖ ^ 2) + 2 * (Nl * T)) := by
        gcongr with n
        exact h5 n
    _ = _ := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
        push_cast
        ring

end BandBlock

namespace ActiveSetup
variable {κ' : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ' c₀)

/-- The ancestors at the right end of the position `q` of level `k` (block offset `bo`) of the
cells of `U'` selecting it. -/
noncomputable def posEc (U' : Finset (ℤ × ℤ)) (off : ℤ × ℤ → ℕ) (k bo q : ℕ) :
    Finset (ℤ × ℤ) :=
  (U'.filter fun I => off I / 2 ^ (k + 1) = q).image
    fun I => ancAt A.G I (A.R.1 + ((bo + (q * 2 ^ (k + 1) + 2 ^ k) : ℕ) : ℤ))

open Classical in
/-- Blueprint lines 2408-2411 (`eq:stack-energy` for the positions of one level below the base,
on the ancestors at the right ends): if the family `Z_g` has variation capacity `B`, the jumps of
`Z_g` over the positions of a level `k < N` used by the cells of all groups and blocks, restricted
to the ancestors at the right ends of the cells selecting them, have total square at most `B`. -/
theorem posAnc_energy (hanc : A.AncClosed) {γ : Type*} {V : Type*} [Fintype V]
    (Gs : Finset γ) (Z : γ → ℤ → ColumnL2 V) (ok : γ → ℤ × ℤ → Prop) {B : ℝ}
    (hcap : A.VarCap Gs Z ok B) {K N : ℕ} (k : Fin (N + 1)) (hk : (k : ℕ) ≠ N)
    (Bs : Finset ℕ) (U : γ → ℕ → Finset (ℤ × ℤ)) (off : ℤ × ℤ → ℕ)
    (hU : ∀ g β, ∀ I ∈ U g β, I ∈ A.cells ∧ I.1 = A.R.1 + (K * β + off I : ℕ) ∧ off I < K)
    (hok : ∀ g ∈ Gs, ∀ β, ∀ I ∈ U g β, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → ok g J) :
    ∑ g ∈ Gs, ∑ β ∈ Bs, ∑ q ∈ ((U g β).filter fun I => posAct N k (off I)).image
        (fun I => off I / 2 ^ ((k : ℕ) + 1)),
      ‖columnL2Restriction (⋃ J ∈ A.posEc ((U g β).filter fun I => posAct N k (off I)) off k
          (K * β) q, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (Z g (A.R.1 + ((K * β + (q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ))) : ℕ)) -
          Z g (A.R.1 + ((K * β + q * 2 ^ ((k : ℕ) + 1)) : ℕ)))‖ ^ 2 ≤ B := by
  set U' : γ → ℕ → Finset (ℤ × ℤ) := fun g β => (U g β).filter fun I => posAct N k (off I)
  set sel : ℤ × ℤ → ℕ := fun I => off I / 2 ^ ((k : ℕ) + 1)
  set S : Finset (ℕ × ℕ) := Gs.biUnion fun g => Bs.biUnion fun β =>
    ((U' g β).image sel).image fun q => (β, q)
  have hmemS : ∀ g ∈ Gs, ∀ β ∈ Bs, ∀ q ∈ (U' g β).image sel, (β, q) ∈ S := fun g hg β hβ q hq =>
    Finset.mem_biUnion.mpr ⟨g, hg, Finset.mem_biUnion.mpr ⟨β, hβ, Finset.mem_image_of_mem _ hq⟩⟩
  -- every used position ends before its uses
  have huse : ∀ g β, ∀ I ∈ U' g β,
      sel I * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ) ≤ off I := fun g β I hI =>
    posEnd_le hk (Finset.mem_filter.mp hI).2
  have hS : ∀ x ∈ S, ∃ g, ∃ I ∈ U g x.1,
      x.2 * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ) ≤ off I := by
    intro x hx
    obtain ⟨g, -, hg⟩ := Finset.mem_biUnion.mp hx
    obtain ⟨β, -, hβ⟩ := Finset.mem_biUnion.mp hg
    obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hβ
    obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hq
    exact ⟨g, I, (Finset.mem_filter.mp hI).1, huse g β I hI⟩
  let ι := {x : ℕ × ℕ // x ∈ S}
  let r : ι → ℕ := fun x => K * x.1.1 + x.1.2 * 2 ^ ((k : ℕ) + 1)
  let t : ι → ℕ := fun x => K * x.1.1 + (x.1.2 * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ))
  have hrt : ∀ i, r i ≤ t i := fun i => Nat.add_le_add_left (Nat.le_add_right _ _) _
  have hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')) := by
    intro i i' hii
    obtain ⟨g, I, hI, hIt⟩ := hS i.1 i.2
    obtain ⟨g', I', hI', hIt'⟩ := hS i'.1 i'.2
    have hK1 := (hU g _ I hI).2.2
    have hK2 := (hU g' _ I' hI').2.2
    rw [Finset.disjoint_left]
    intro x hx hx'
    simp only [Finset.mem_Ioc, r, t] at hx hx'
    by_cases hβ : i.1.1 = i'.1.1
    · have hq : i.1.2 ≠ i'.1.2 := fun h => hii (Subtype.ext (Prod.ext hβ h))
      have h0 := Finset.disjoint_left.mp (posIoc_disjoint (k := (k : ℕ)) hq)
        (show x - K * i.1.1 ∈ Finset.Ioc _ _ from Finset.mem_Ioc.mpr ⟨by omega, by omega⟩)
      rw [← hβ] at hx'
      exact h0 (Finset.mem_Ioc.mpr ⟨by omega, by omega⟩)
    · rcases Nat.lt_or_gt_of_ne hβ with h | h
      · have : K * i.1.1 + K ≤ K * i'.1.1 := by nlinarith
        omega
      · have : K * i'.1.1 + K ≤ K * i.1.1 := by nlinarith
        omega
  have htd : ∀ i, t i ≤ A.treeDepth := by
    intro i
    obtain ⟨g, I, hI, hIt⟩ := hS i.1 i.2
    obtain ⟨hIc, hIdep, -⟩ := hU g _ I hI
    have := ((dyadicFiniteTree_mem_iff A.G A.R I A.treeDepth).mp (A.cells_mem_tree hIc)).2
    simp only [t]
    omega
  let Ec : γ → ι → Finset (ℤ × ℤ) := fun g i => if g ∈ Gs then
    ((U' g i.1.1).filter fun I => sel I = i.1.2).image fun I => ancAt A.G I (A.R.1 + t i)
    else ∅
  have hdle : ∀ g (β q : ℕ), ∀ I ∈ U' g β, sel I = q →
      A.R.1 + ((K * β + (q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ)) : ℕ) : ℤ) ≤ I.1 := by
    intro g β q I hI hq
    have h1 := huse g β I hI
    rw [hq] at h1
    rw [(hU g β I (Finset.mem_filter.mp hI).1).2.1]
    push_cast
    have : ((q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ) : ℕ) : ℤ) ≤ (off I : ℤ) := by exact_mod_cast h1
    push_cast at this
    linarith
  have hEc : ∀ g i, ∀ J ∈ Ec g i, J ∈ A.cells ∧ J.1 = A.R.1 + t i ∧ ok g J := by
    intro g i J hJ
    simp only [Ec] at hJ
    split_ifs at hJ with hg
    · obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hJ
      obtain ⟨hIU', hIq⟩ := Finset.mem_filter.mp hI
      have hIc := (hU g _ I (Finset.mem_filter.mp hIU').1).1
      have hd := hdle g i.1.1 i.1.2 I hIU' hIq
      have hsub := subset_ancAt A.G I hd
      have hR1 : A.R.1 ≤ A.R.1 + (t i : ℤ) := by omega
      have hJc : ancAt A.G I (A.R.1 + t i) ∈ A.cells :=
        hanc I hIc _ hsub (ancAt_subset (A.sub I hIc) hR1)
      exact ⟨hJc, rfl, hok g hg _ I (Finset.mem_filter.mp hIU').1 _ hJc hsub⟩
    · simp at hJ
  have hcap' := hcap r t hrt hdis htd Ec hEc
  refine le_trans ?_ hcap'
  refine Finset.sum_le_sum fun g hg => ?_
  set F : ι → ℝ := fun i => ‖columnL2Restriction (⋃ J ∈ Ec g i, dyadicGridCell A.G J.1 J.2)
    (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
    (Z g (A.R.1 + t i) - Z g (A.R.1 + r i))‖ ^ 2
  have hterm : ∀ β (hβ : β ∈ Bs), ∀ q (hq : q ∈ (U' g β).image sel),
      ‖columnL2Restriction (⋃ J ∈ A.posEc (U' g β) off k (K * β) q, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (Z g (A.R.1 + ((K * β + (q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ))) : ℕ)) -
          Z g (A.R.1 + ((K * β + q * 2 ^ ((k : ℕ) + 1)) : ℕ)))‖ ^ 2 =
      F ⟨(β, q), hmemS g hg β hβ q hq⟩ := by
    intro β hβ q hq
    simp only [F, Ec, hg, ite_true]
    rfl
  set F' : ℕ × ℕ → ℝ := fun x => if h : x ∈ S then F ⟨x, h⟩ else 0
  have hF'0 : ∀ x, 0 ≤ F' x := fun x => by
    simp only [F']
    split_ifs <;> positivity
  calc ∑ β ∈ Bs, ∑ q ∈ (U' g β).image sel,
        ‖columnL2Restriction (⋃ J ∈ A.posEc (U' g β) off k (K * β) q, dyadicGridCell A.G J.1 J.2)
          (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
          (Z g (A.R.1 + ((K * β + (q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ))) : ℕ)) -
            Z g (A.R.1 + ((K * β + q * 2 ^ ((k : ℕ) + 1)) : ℕ)))‖ ^ 2
      ≤ ∑ β ∈ Bs, ∑ q ∈ (U' g β).image sel, F' (β, q) := by
        refine Finset.sum_le_sum fun β hβ => Finset.sum_le_sum fun q hq => ?_
        simp only [F', hmemS g hg β hβ q hq, dite_true]
        exact le_of_eq (hterm β hβ q hq)
    _ = ∑ x ∈ Bs.biUnion (fun β => ((U' g β).image sel).image fun q => (β, q)), F' x := by
        rw [Finset.sum_biUnion]
        · refine Finset.sum_congr rfl fun β _ => ?_
          rw [Finset.sum_image fun q _ q' _ h => (Prod.ext_iff.mp h).2]
        · intro β _ β' _ hββ
          simp only [Function.onFun]
          rw [Finset.disjoint_left]
          intro x hx hx'
          obtain ⟨q, -, rfl⟩ := Finset.mem_image.mp hx
          obtain ⟨q', -, h⟩ := Finset.mem_image.mp hx'
          exact hββ (Prod.ext_iff.mp h).1.symm
    _ ≤ ∑ x ∈ S, F' x := by
        refine Finset.sum_le_sum_of_subset_of_nonneg (fun x hx => ?_) fun x _ _ => hF'0 x
        obtain ⟨β, hβ, hx⟩ := Finset.mem_biUnion.mp hx
        obtain ⟨q, hq, rfl⟩ := Finset.mem_image.mp hx
        exact hmemS g hg β hβ q hq
    _ = ∑ i : ι, F i := by
        rw [← Finset.sum_attach S, Finset.univ_eq_attach]
        refine Finset.sum_congr rfl fun i _ => ?_
        simp only [F', i.2, dite_true]

end ActiveSetup

section RestrictCommute
variable {V : Type*} [Fintype V]

/-- An operator commuting with the restrictions to the cells of a family of one depth commutes
with the restriction to their union. -/
theorem union_commute (G : RealDyadicGrid) (Ec : Finset (ℤ × ℤ)) {d : ℤ} (hd : ∀ J ∈ Ec, J.1 = d)
    (T : ColumnL2 V →L[ℂ] ColumnL2 V)
    (hT : ∀ J ∈ Ec, (columnL2Restriction (dyadicGridCell G J.1 J.2)
      (dyadicGridCell_measurable G J.1 J.2)).comp T = T.comp (columnL2Restriction
        (dyadicGridCell G J.1 J.2) (dyadicGridCell_measurable G J.1 J.2))) :
    (columnL2Restriction (⋃ J ∈ Ec, dyadicGridCell G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable G J.1 J.2)).comp T =
      T.comp (columnL2Restriction (⋃ J ∈ Ec, dyadicGridCell G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable G J.1 J.2)) := by
  rw [columnL2Restriction_biUnion Ec (fun J => dyadicGridCell G J.1 J.2)
    (fun J => dyadicGridCell_measurable G J.1 J.2) (sameDepth_pairwiseDisjoint G Ec hd)]
  refine ContinuousLinearMap.ext fun y => ?_
  simp only [ContinuousLinearMap.comp_apply, FunLike.coe_sum, Finset.sum_apply,
    map_sum]
  exact Finset.sum_congr rfl fun J hJ => DFunLike.congr_fun (hT J hJ) y

/-- For `Ω ⊆ C ⊆ D` and an operator commuting with the restriction to `C`, the restriction to `Ω`
of the output does not see the input outside `D`. -/
theorem restrict_sandwich {Ω C D : Set ℝ} (hΩ : MeasurableSet Ω) (hC : MeasurableSet C)
    (hD : MeasurableSet D) (hΩC : Ω ⊆ C) (hCD : C ⊆ D) (T : ColumnL2 V →L[ℂ] ColumnL2 V)
    (hT : (columnL2Restriction C hC).comp T = T.comp (columnL2Restriction C hC))
    (y : ColumnL2 V) :
    columnL2Restriction Ω hΩ (T y) = columnL2Restriction Ω hΩ (T (columnL2Restriction D hD y)) := by
  have hΩC' : (columnL2Restriction (V := V) Ω hΩ).comp (columnL2Restriction C hC) =
      columnL2Restriction Ω hΩ := columnL2Restriction_comp_of_subset hΩ hC hΩC
  have hCD' : (columnL2Restriction (V := V) C hC).comp (columnL2Restriction D hD) =
      columnL2Restriction C hC := columnL2Restriction_comp_of_subset hC hD hCD
  have e1 : ∀ z, columnL2Restriction Ω hΩ (T z) =
      columnL2Restriction Ω hΩ (T (columnL2Restriction C hC z)) := fun z => by
    rw [← DFunLike.congr_fun hΩC' (T z), ContinuousLinearMap.comp_apply,
      ← ContinuousLinearMap.comp_apply (columnL2Restriction C hC) T, hT,
      ContinuousLinearMap.comp_apply]
  rw [e1 y, e1 (columnL2Restriction D hD y), ← ContinuousLinearMap.comp_apply
    (columnL2Restriction C hC) (columnL2Restriction D hD), hCD']

end RestrictCommute

/-- Ancestors of one cell at nested depths are nested. -/
theorem ancAt_mono (G : RealDyadicGrid) (I : ℤ × ℤ) {d₁ d₂ : ℤ} (h₂₁ : d₂ ≤ d₁) (h₁ : d₁ ≤ I.1) :
    dyadicGridCell G (ancAt G I d₁).1 (ancAt G I d₁).2 ⊆
      dyadicGridCell G (ancAt G I d₂).1 (ancAt G I d₂).2 :=
  dyadicGridCell_subset_of_common_point G
    (subset_ancAt G I h₁ (dyadicGridCell_left_mem G I.1 I.2))
    (mem_dyadicIndex G d₂ _) h₂₁

/-- The position intervals of one level, shifted by a block offset, are disjoint. -/
theorem posIoc_disjoint_shift (c : ℕ) {k q q' : ℕ} (hqq : q ≠ q') :
    Disjoint (Finset.Ioc (c + q * 2 ^ (k + 1)) (c + (q * 2 ^ (k + 1) + 2 ^ k)))
      (Finset.Ioc (c + q' * 2 ^ (k + 1)) (c + (q' * 2 ^ (k + 1) + 2 ^ k))) := by
  rw [Finset.disjoint_left]
  intro x hx hx'
  simp only [Finset.mem_Ioc] at hx hx'
  have h0 := Finset.disjoint_left.mp (posIoc_disjoint (k := k) hqq)
    (show x - c ∈ Finset.Ioc _ _ from Finset.mem_Ioc.mpr ⟨by omega, by omega⟩)
  exact h0 (Finset.mem_Ioc.mpr ⟨by omega, by omega⟩)

namespace ActiveSetup
variable {κ' : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ' c₀)

theorem mem_posEc {U' : Finset (ℤ × ℤ)} {off : ℤ × ℤ → ℕ} {k bo q : ℕ} {J : ℤ × ℤ} :
    J ∈ A.posEc U' off k bo q ↔ ∃ I ∈ U', off I / 2 ^ (k + 1) = q ∧
      J = ancAt A.G I (A.R.1 + ((bo + (q * 2 ^ (k + 1) + 2 ^ k) : ℕ) : ℤ)) := by
  unfold posEc
  simp only [Finset.mem_image, Finset.mem_filter]
  constructor
  · rintro ⟨I, ⟨hI, hq⟩, rfl⟩
    exact ⟨I, hI, hq, rfl⟩
  · rintro ⟨I, hI, hq, rfl⟩
    exact ⟨I, ⟨hI, hq⟩, rfl⟩

/-- The pseudo-uses of a level: the ancestors of the uses at the left ends of their positions. -/
noncomputable def posLeft (U' : Finset (ℤ × ℤ)) (off : ℤ × ℤ → ℕ) (k bo : ℕ) :
    Finset (ℤ × ℤ) :=
  U'.image fun I => ancAt A.G I (A.R.1 + ((bo + off I / 2 ^ (k + 1) * 2 ^ (k + 1) : ℕ) : ℤ))

open Classical in
/-- `band_block` for the uses of one group in one block, with the ancestor unions of the
positions and the inner positions of the pseudo-uses `posLeft`. -/
theorem bandStack_block (hanc : A.AncClosed) {V : Type*} [Fintype V] (Zg : ℤ → ColumnL2 V)
    {K N : ℕ} (hKN : K ≤ 2 ^ N) (k : Fin (N + 1)) (hk : (k : ℕ) ≠ N) (β : ℕ)
    (Ug : Finset (ℤ × ℤ)) (off : ℤ × ℤ → ℕ)
    (hoff : ∀ (J : ℤ × ℤ) (m : ℕ), m < K → J.1 = A.R.1 + ((K * β + m : ℕ) : ℤ) → off J = m)
    (hU : ∀ I ∈ Ug, I ∈ A.cells ∧ I.1 = A.R.1 + (K * β + off I : ℕ) ∧ off I < K)
    {P : ℕ} (Ah : ℕ → ℤ → ColumnL2 V →L[ℂ] ColumnL2 V)
    (hbes : ∀ h y, ∑ p ∈ Finset.range (P + 1), ‖(Ah (p + 1) h - Ah p h) y‖ ^ 2 ≤ ‖y‖ ^ 2)
    (hcomm : ∀ n h (J : ℤ × ℤ), J.1 ≤ h → J.1 ≤ A.R.1 + A.treeDepth →
      (columnL2Restriction (dyadicGridCell A.G J.1 J.2)
      (dyadicGridCell_measurable A.G J.1 J.2)).comp (Ah n h) =
        (Ah n h).comp (columnL2Restriction (dyadicGridCell A.G J.1 J.2)
          (dyadicGridCell_measurable A.G J.1 J.2)))
    {Cj : ℝ} (hCj : 0 ≤ Cj) (hJ : ∀ n, ∀ {ι : Type} [Fintype ι] (r t : ι → ℕ), (∀ i, r i ≤ t i) →
