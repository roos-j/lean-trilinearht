section

namespace Auto
open MeasureTheory Metric
open scoped FourierTransform ComplexConjugate ENNReal

namespace ActiveSetup

namespace AttemptParams

namespace TTData
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (T : ap.TTData)

/-- The integrated budget of the squared third strong factors (`third_budget`). -/
noncomputable def thirdBud (Lp Jm : ℕ) (B₀ Cy Bs Brst Bfz : ℝ) : ℝ :=
  36 * 256 * 16 * (16 * (localFormUniformConstant κ' * B₀) ^ 2 * Bs +
    Lp ^ 2 * (2 * (1 + 5 * Jm)) * (Lp ^ 2 * (localFormUniformConstant κ' ^ 2 * (2 * Cy ^ 2)) *
      Brst + (2 / (ap.P : ℝ) * localFormUniformConstant κ') ^ 2 * 3 * Bfz))

/-- The freeze difference energy of one step and offset at a cell: the squared restricted
differences of the current complement bands and other complement from their values at the block
start. -/
noncomputable def frzD (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j o : ℕ) (J : ℤ × ℤ) : ℝ :=
  ∑ p ∈ ap.uo o, ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2)
      (dyadicGridCell_measurable A.G J.1 J.2)
      (T.Y c d G t t' j o J.1 p - T.Y c d G t t' j o (T.D.blockOf J.1) p)‖ ^ 2 +
    ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
      (T.F c d G t t' j J.1 - T.F c d G t t' j (T.D.blockOf J.1))‖ ^ 2

/-- The complement catalog of a step slot (`true` for `c`, `false` for `d`). -/
abbrev cslot (c d : Fin 4) (v : Bool) : Fin 4 := if v then c else d

/-- The inherited complement masks of the steps of a descriptor list on the catalog of the slot
`v`, indexed by the position of the step. -/
noncomputable def cmpMask (c d : Fin 4) (G : A.Grp) (v : Bool) (D : List (Bool × ℕ × Option ℕ))
    (m : ℕ) (p : Fin ap.P) :
    InheritedColumnMask (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D :=
  ap.gMask (T.cat (cslot c d v)) T.hR (T.hbc _) (D.getD m (true, 0, none)).2.1
    (ap.stepMask G (ap.leafJ T.s (cslot c d v)) (D.getD m (true, 0, none)).2.2 p)
    (ap.stepMask_mono G _ (D.getD m (true, 0, none)).2.2 p)

/-- The layer indices (innermost first) of the steps of slot `v` of a list of descriptors starting
at the position `k`. -/
def restIdx (v : Bool) : List (Bool × ℕ × Option ℕ) → ℕ → List (ℕ × Bool)
  | [], _ => []
  | e :: es, k => restIdx v es (k + 1) ++ (if e.1 = v then [(k, false)] else [])

/-- The complement value of slot `v` after global steps is the global history of their masks. -/
theorem chainVal_glob (c d : Fin 4) (G : A.Grp) (v : Bool) (D : List (Bool × ℕ × Option ℕ))
    (h : ℤ) (x : ColumnL2 (Fin ap.Mc)) :
    ∀ (es : List (Bool × ℕ × Option ℕ)) (k : ℕ),
      (∀ i (hi : i < es.length), es[i] = D.getD (k + i) (true, 0, none)) →
      chainVal ap.P v ((es.map fun e => ap.gStep T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G e
        h).map padStep) x =
        globHist (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)) (T.cmpMask c d G v D)
          (restIdx v es k) h x
  | [], k, _ => rfl
  | e :: es, k, hes => by
    have hes' : ∀ i (hi : i < es.length), es[i] = D.getD (k + 1 + i) (true, 0, none) := by
      intro i hi
      have := hes (i + 1) (by simp; omega)
      simp only [List.getElem_cons_succ] at this
      rw [this]; congr 1; omega
    have he : e = D.getD k (true, 0, none) := by
      have := hes 0 (by simp)
      simpa using this
    have ih := chainVal_glob c d G v D h x es (k + 1) hes'
    simp only [List.map_cons, chainVal, restIdx]
    by_cases hv : e.1 = v
    · have hv' : (ap.gStep T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G e h).1 = v := hv
      rw [padStep, ite_eq_left_of_eq_true _ _ (eq_true hv'), ih, ite_eq_left_of_eq_true _ _ (eq_true
          hv)]
      unfold globHist
      rw [layerOp_append]
      simp only [Bool.false_eq_true, ↓reduceIte, ContinuousLinearMap.comp_apply]
      rw [filterAvg_padFam]
      subst he
      subst hv
      rfl
    · have hv' : ¬ (ap.gStep T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G e h).1 = v := hv
      rw [padStep, ite_eq_right_of_eq_false _ _ (eq_false hv'), ih, ite_eq_right_of_eq_false _ _
          (eq_false hv), List.append_nil]

/-- The global complement history of slot `v` after the step `j` of a descriptor list. -/
noncomputable def histOp (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j : ℕ)
    (v : Bool) (h : ℤ) : ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  globHist (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)) (T.cmpMask c d G v D)
    (restIdx v (D.drop (j + 1)) (j + 1)) h

/-- The pad `m` of the step `j` composed with the later complement history of its slot. -/
noncomputable def bandOp (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    (h : ℤ) : ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  (padFamC (fun p : Fin ap.P => ((ap.cumBase (T.cat (cslot c d (D.getD j (true, 0, none)).1)) T.hR
    (T.hbc _)).withMask (T.cmpMask c d G (D.getD j (true, 0, none)).1 D j p)).proj h) m).comp
    (T.histOp c d G D j (D.getD j (true, 0, none)).1 h)

/-- The band `m` of the step `j` after the later complement history. -/
noncomputable def bandDiff (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    (h : ℤ) : ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  T.bandOp c d G D j (m + 1) h - T.bandOp c d G D j m h

theorem gRest_chainVal (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j : ℕ)
    (v : Bool) (h : ℤ) (x : ColumnL2 (Fin ap.Mc)) :
    chainVal ap.P v (ap.gRest T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G D j h) x =
      T.histOp c d G D j v h x := by
  unfold gRest histOp
  refine T.chainVal_glob c d G v D h x _ _ fun i hi => ?_
  rw [List.getElem_drop, List.getD_eq_getElem _ _ (by simp at hi; omega)]

/-- The current complement bands are the bands after the later history applied to the input. -/
theorem Y_eq (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j o : ℕ) (h : ℤ) (p : ℕ) :
    T.Y c d G t t' j o h p = T.bandDiff c d G (T.desc c d t t') j (p + o - 2) h
      (if ((T.desc c d t t').getD j (true, 0, none)).1 then ap.gIn (T.P₁ c) (T.P₂ c) h
        else ap.gIn (T.P₁ d) (T.P₂ d) h) := by
  unfold Y Yfr bandDiff bandOp
  simp only [sub_apply, ContinuousLinearMap.comp_apply]
  rw [T.gRest_chainVal]
  have e : ∀ m (y : ColumnL2 (Fin ap.Mc)),
      (ap.gSt T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G (T.desc c d t t') j h).2.2 m y =
        padFamC (ap.gStep T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G
          ((T.desc c d t t').getD j (true, 0, none)) h).2.2 m y := fun m y =>
    padFam_apply_eq _ m y
  rw [e, e]
  rfl

/-- The current other complement is the later history of its slot applied to its input. -/
theorem F_eq (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j : ℕ) (h : ℤ) :
    T.F c d G t t' j h = T.histOp c d G (T.desc c d t t') j
      (!((T.desc c d t t').getD j (true, 0, none)).1) h
      (if ((T.desc c d t t').getD j (true, 0, none)).1 then ap.gIn (T.P₁ d) (T.P₂ d) h
        else ap.gIn (T.P₁ c) (T.P₂ c) h) := by
  unfold F Ffr
  rw [T.gRest_chainVal]
  rfl

/-- The global histories and band operators at the depth `h` commute with the restrictions to the
active cells at most that deep. -/
theorem histOp_comm (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) (v : Bool)
    (h : ℤ) (Q : ℤ × ℤ) (hQ : Q.1 ≤ h) (hN : h ≤ A.R.1 + A.treeDepth) :
    (T.histOp c d G D j v h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)) =
      (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (T.histOp c d G D j v h) := by
  have hd : ∀ M : InheritedColumnMask (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D,
      Q.1 ≤ ((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).depth h := fun M => by
    change Q.1 ≤ max (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D.root.1
      (min h (A.R.1 + A.treeDepth))
    exact le_max_of_le_right (le_min hQ (by omega))
  set rQ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G Q.1 Q.2)
    (dyadicGridCell_measurable A.G Q.1 Q.2)
  have hpad : ∀ M : InheritedColumnMask (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D,
      (((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).proj h).comp rQ =
        rQ.comp (((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).proj h) :=
    fun M => (((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).proj_commute_restrict
      h (hd M)).symm
  unfold histOp globHist
  exact layerOp_commute _ rQ (fun m => opAvg_commute _ _ fun p => hpad _) _

theorem bandOp_comm (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    (h : ℤ) (Q : ℤ × ℤ) (hQ : Q.1 ≤ h) (hN : h ≤ A.R.1 + A.treeDepth) :
    (T.bandOp c d G D j m h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)) =
      (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (T.bandOp c d G D j m h) := by
  set v := (D.getD j (true, 0, none)).1
  have hd : ∀ M : InheritedColumnMask (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D,
      Q.1 ≤ ((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).depth h := fun M => by
    change Q.1 ≤ max (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D.root.1
      (min h (A.R.1 + A.treeDepth))
    exact le_max_of_le_right (le_min hQ (by omega))
  unfold bandOp
  rw [ContinuousLinearMap.comp_assoc, T.histOp_comm c d G D j v h Q hQ hN,
    ← ContinuousLinearMap.comp_assoc, ← ContinuousLinearMap.comp_assoc]
  congr 1
  unfold padFamC
  split_ifs
  · simp
  · exact (((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask _).proj_commute_restrict h
      (hd _)).symm
  · simp

theorem bandDiff_comm (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    (h : ℤ) (Q : ℤ × ℤ) (hQ : Q.1 ≤ h) (hN : h ≤ A.R.1 + A.treeDepth) :
    (T.bandDiff c d G D j m h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)) =
      (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (T.bandDiff c d G D j m h) := by
  unfold bandDiff
  rw [ContinuousLinearMap.sub_comp, ContinuousLinearMap.comp_sub,
    T.bandOp_comm c d G D j (m + 1) h Q hQ hN, T.bandOp_comm c d G D j m h Q hQ hN]

theorem histOp_contr (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j : ℕ)
    (v : Bool) (h : ℤ) (y : ColumnL2 (Fin ap.Mc)) : ‖T.histOp c d G D j v h y‖ ≤ ‖y‖ :=
  globHist_norm_le _ ap.hP _ _ _ _

theorem bandDiff_contr (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    (h : ℤ) (y : ColumnL2 (Fin ap.Mc)) : ‖T.bandDiff c d G D j m h y‖ ≤ ‖y‖ := by
  set v := (D.getD j (true, 0, none)).1
  set Q : Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) := fun p =>
    ((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask
      (T.cmpMask c d G v D j p)).proj h with hQ
  set z := T.histOp c d G D j v h y
  have hb := padFamC_bessel Q (fun p => ColumnDepthFamily.isStarProjection_proj _ _)
    (fun p p' hpp => ap.gPad_nested _ T.hR (T.hbc _) _ G _ _ hpp h) z
  have e : T.bandDiff c d G D j m h y = (padFamC Q (m + 1) - padFamC Q m) z := by
    unfold bandDiff bandOp
    simp only [sub_apply, ContinuousLinearMap.comp_apply]
    rfl
  rw [e]
  refine le_trans ?_ (T.histOp_contr c d G D j v h y)
  by_cases hm : m < ap.P + 1
  · have h1 := Finset.single_le_sum (f := fun n => ‖(padFamC Q (n + 1) - padFamC Q n) z‖ ^ 2)
      (fun _ _ => sq_nonneg _) (Finset.mem_range.mpr hm)
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp (h1.trans hb)
  · have h1 : padFamC Q (m + 1) = padFamC Q m := by
      unfold padFamC
      have : ¬ m - 1 < ap.P := by omega
      have : ¬ m + 1 - 1 < ap.P := by omega
      simp only [show m + 1 ≠ 0 by omega, show m ≠ 0 by omega, ite_false, *, ↓reduceDIte]
    rw [h1, sub_self, zero_apply, norm_zero]
    exact norm_nonneg _

/-- The fixed-input jump constant of the complement histories of slot `v` with `L` layers. -/
noncomputable def jmpC (c d : Fin 4) (v : Bool) (L : ℕ) : ℝ :=
  2 * (compressionC (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D L ^ 2 +
    L * ∑ m ∈ Finset.range L, compressionC (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D m ^
        2)

theorem jmpC_nonneg (c d : Fin 4) (v : Bool) (L : ℕ) : 0 ≤ T.jmpC c d v L := by
  unfold jmpC
  have : 0 ≤ ∑ m ∈ Finset.range L,
      compressionC (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D m ^ 2 :=
    Finset.sum_nonneg fun _ _ => sq_nonneg _
  positivity

theorem histOp_rows (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j : ℕ)
    (v : Bool) {ι : Type} [Fintype ι] (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (Ec : ι → Finset (ℤ × ℤ)) (x : ColumnL2 (Fin ap.Mc)) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
      ((T.histOp c d G D j v (A.R.1 + t i) - T.histOp c d G D j v (A.R.1 + r i)) x)‖ ^ 2 ≤
      T.jmpC c d v (restIdx v (D.drop (j + 1)) (j + 1)).length * ‖x‖ ^ 2 := by
  set L := (restIdx v (D.drop (j + 1)) (j + 1)).length
  have h := globHist_jump (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)) ap.hP
    (T.cmpMask c d G v D) (restIdx v (D.drop (j + 1)) (j + 1)) r t hrt hdis x
  refine le_trans (Finset.sum_le_sum fun i _ => ?_) (h.trans ?_)
  · refine (columnL2Restriction_norm_sq_le _ _ _).trans (le_of_eq ?_)
    rw [sub_apply]
    rfl
  · unfold jmpC
    have h0 : 0 ≤ compressionC (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D L ^ 2 *
        ‖x‖ ^ 2 := by positivity
    have : 0 ≤ ∑ m ∈ Finset.range L,
        compressionC (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D m ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    have h1 : 0 ≤ (L : ℝ) * (∑ m ∈ Finset.range L,
        compressionC (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D m ^ 2) * ‖x‖ ^ 2 := by
      positivity
    nlinarith

theorem bandOp_rows (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    {ι : Type} [Fintype ι] (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (Ec : ι → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells) (x : ColumnL2 (Fin ap.Mc)) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
      ((T.bandOp c d G D j m (A.R.1 + t i) - T.bandOp c d G D j m (A.R.1 + r i)) x)‖ ^ 2 ≤
      T.jmpC c d (D.getD j (true, 0, none)).1
        (restIdx (D.getD j (true, 0, none)).1 (D.drop (j + 1)) (j + 1)).length * ‖x‖ ^ 2 := by
  set v := (D.getD j (true, 0, none)).1
  have hJ0 := T.jmpC_nonneg c d v (restIdx v (D.drop (j + 1)) (j + 1)).length
  by_cases hm0 : m = 0
  · subst hm0
    have e : ∀ h, T.bandOp c d G D j 0 h = 0 := fun h => by
      unfold bandOp padFamC; simp
    simp only [e, sub_self, zero_apply, map_zero, norm_zero, ne_eq, OfNat.ofNat_ne_zero,
      not_false_eq_true, zero_pow, Finset.sum_const_zero]
    positivity
  by_cases hmP : m - 1 < ap.P
  · have h := ap.padHist_jump (T.cat (cslot c d v)) T.hR (T.hbc _)
      (T.cmpMask c d G v D j ⟨m - 1, hmP⟩) (T.cmpMask c d G v D)
      (restIdx v (D.drop (j + 1)) (j + 1)) r t hrt hdis Ec hEc x
    refine le_trans (le_of_eq (Finset.sum_congr rfl fun i _ => ?_)) (h.trans (le_of_eq ?_))
    · simp only [bandOp, padFamC, hm0, ite_false, hmP, ↓reduceDIte, padHistL, sub_apply]
      rfl
    · unfold jmpC; ring
  · refine le_trans (Finset.sum_le_sum fun i _ => le_of_eq ?_)
      (T.histOp_rows c d G D j v r t hrt hdis Ec x)
    simp only [bandOp, padFamC, hm0, ite_false, hmP, ↓reduceDIte, ContinuousLinearMap.id_comp]
    rfl

theorem bandDiff_rows (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    {ι : Type} [Fintype ι] (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (Ec : ι → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells) (x : ColumnL2 (Fin ap.Mc)) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
      ((T.bandDiff c d G D j m (A.R.1 + t i) - T.bandDiff c d G D j m (A.R.1 + r i)) x)‖ ^ 2 ≤
      4 * T.jmpC c d (D.getD j (true, 0, none)).1
        (restIdx (D.getD j (true, 0, none)).1 (D.drop (j + 1)) (j + 1)).length * ‖x‖ ^ 2 := by
  set rE : ι → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) := fun i =>
    columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have h1 := T.bandOp_rows c d G D j (m + 1) r t hrt hdis Ec hEc x
  have h2 := T.bandOp_rows c d G D j m r t hrt hdis Ec hEc x
  have hpt : ∀ i, ‖rE i ((T.bandDiff c d G D j m (A.R.1 + t i) -
      T.bandDiff c d G D j m (A.R.1 + r i)) x)‖ ^ 2 ≤
      2 * ‖rE i ((T.bandOp c d G D j (m + 1) (A.R.1 + t i) -
        T.bandOp c d G D j (m + 1) (A.R.1 + r i)) x)‖ ^ 2 +
      2 * ‖rE i ((T.bandOp c d G D j m (A.R.1 + t i) -
        T.bandOp c d G D j m (A.R.1 + r i)) x)‖ ^ 2 := by
    intro i
    have e : rE i ((T.bandDiff c d G D j m (A.R.1 + t i) -
        T.bandDiff c d G D j m (A.R.1 + r i)) x) =
        rE i ((T.bandOp c d G D j (m + 1) (A.R.1 + t i) -
          T.bandOp c d G D j (m + 1) (A.R.1 + r i)) x) -
        rE i ((T.bandOp c d G D j m (A.R.1 + t i) -
          T.bandOp c d G D j m (A.R.1 + r i)) x) := by
      unfold bandDiff
      simp only [sub_apply, map_sub]
      abel
    rw [e]
    exact norm_sub_sq_le_two_mul _ _
  calc _ ≤ ∑ i, (2 * ‖rE i ((T.bandOp c d G D j (m + 1) (A.R.1 + t i) -
        T.bandOp c d G D j (m + 1) (A.R.1 + r i)) x)‖ ^ 2 +
      2 * ‖rE i ((T.bandOp c d G D j m (A.R.1 + t i) -
        T.bandOp c d G D j m (A.R.1 + r i)) x)‖ ^ 2) := Finset.sum_le_sum fun i _ => hpt i
    _ = 2 * ∑ i, ‖rE i ((T.bandOp c d G D j (m + 1) (A.R.1 + t i) -
        T.bandOp c d G D j (m + 1) (A.R.1 + r i)) x)‖ ^ 2 +
      2 * ∑ i, ‖rE i ((T.bandOp c d G D j m (A.R.1 + t i) -
        T.bandOp c d G D j m (A.R.1 + r i)) x)‖ ^ 2 := by
        rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    _ ≤ _ := by nlinarith

/-- The variation bound of `op_variation` for the two basic projections of a slot with row
constant `B`. -/
noncomputable def slotVar (l : Fin 4) (B : ℝ) : ℝ :=
  2 * (2 * (B * compressionC (T.P₁ l).Ψ.D 1 ^ 2 * ‖(T.P₁ l).Z‖ ^ 2) + 2 * ‖(T.P₁ l).Z‖ ^ 2) +
    2 * (2 * (B * compressionC (T.P₂ l).Ψ.D 1 ^ 2 * ‖(T.P₂ l).Z‖ ^ 2) + 2 * ‖(T.P₂ l).Z‖ ^ 2)

/-- `op_variation` for the input of a slot (the difference of its two basic projections). -/
theorem slot_variation (l : Fin 4) {ι : Type} [Fintype ι]
    (Op : ℤ → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) (r t : ι → ℕ)
    (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (htd : ∀ i, t i ≤ A.treeDepth) (Ec : ι → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells)
    {B : ℝ} (hB : 0 ≤ B)
    (hrows : ∀ x, ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
      ((Op (A.R.1 + t i) - Op (A.R.1 + r i)) x)‖ ^ 2 ≤ B * ‖x‖ ^ 2)
    (hcomm : ∀ (h : ℤ) (Q : ℤ × ℤ), Q.1 ≤ h → h ≤ A.R.1 + A.treeDepth →
      (Op h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)) =
      (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (Op h))
    (hcontr : ∀ h y, ‖Op h y‖ ≤ ‖y‖) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
      (Op (A.R.1 + t i) (ap.gIn (T.P₁ l) (T.P₂ l) (A.R.1 + t i)) -
        Op (A.R.1 + r i) (ap.gIn (T.P₁ l) (T.P₂ l) (A.R.1 + r i)))‖ ^ 2 ≤ T.slotVar l B := by
  have hr : ∀ P : BasicProjection A.G A.R 1, P.Ψ.D.root.1 ≤ A.R.1 := fun P =>
    dyadicGridCell_depth_le_of_subset A.G A.R P.Ψ.D.root P.root_sub
  have hv : ∀ P : BasicProjection A.G A.R 1, ∑ i, ‖columnL2Restriction
      (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
      (Op (A.R.1 + t i) (physEmbed P.V (Fin ap.Mc) (P.Ψ.proj (A.R.1 + t i) P.Z)) -
        Op (A.R.1 + r i) (physEmbed P.V (Fin ap.Mc) (P.Ψ.proj (A.R.1 + r i) P.Z)))‖ ^ 2 ≤
      2 * (B * compressionC P.Ψ.D 1 ^ 2 * ‖P.Z‖ ^ 2) + 2 * ‖P.Z‖ ^ 2 := fun P =>
    A.op_variation (fun _ => Op) r t hrt hdis htd Ec hEc hB hrows (fun _ => hcomm)
      (fun _ => hcontr) P.Ψ P.grid P.root_sub (hr P) P.Z
  set rE : ι → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) := fun i =>
    columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hpt : ∀ i, ‖rE i (Op (A.R.1 + t i) (ap.gIn (T.P₁ l) (T.P₂ l) (A.R.1 + t i)) -
      Op (A.R.1 + r i) (ap.gIn (T.P₁ l) (T.P₂ l) (A.R.1 + r i)))‖ ^ 2 ≤
      2 * ‖rE i (Op (A.R.1 + t i) (physEmbed (T.P₁ l).V (Fin ap.Mc)
          ((T.P₁ l).Ψ.proj (A.R.1 + t i) (T.P₁ l).Z)) -
        Op (A.R.1 + r i) (physEmbed (T.P₁ l).V (Fin ap.Mc)
          ((T.P₁ l).Ψ.proj (A.R.1 + r i) (T.P₁ l).Z)))‖ ^ 2 +
      2 * ‖rE i (Op (A.R.1 + t i) (physEmbed (T.P₂ l).V (Fin ap.Mc)
          ((T.P₂ l).Ψ.proj (A.R.1 + t i) (T.P₂ l).Z)) -
        Op (A.R.1 + r i) (physEmbed (T.P₂ l).V (Fin ap.Mc)
          ((T.P₂ l).Ψ.proj (A.R.1 + r i) (T.P₂ l).Z)))‖ ^ 2 := by
    intro i
    have e : rE i (Op (A.R.1 + t i) (ap.gIn (T.P₁ l) (T.P₂ l) (A.R.1 + t i)) -
        Op (A.R.1 + r i) (ap.gIn (T.P₁ l) (T.P₂ l) (A.R.1 + r i))) =
        rE i (Op (A.R.1 + t i) (physEmbed (T.P₁ l).V (Fin ap.Mc)
          ((T.P₁ l).Ψ.proj (A.R.1 + t i) (T.P₁ l).Z)) -
          Op (A.R.1 + r i) (physEmbed (T.P₁ l).V (Fin ap.Mc)
          ((T.P₁ l).Ψ.proj (A.R.1 + r i) (T.P₁ l).Z))) -
        rE i (Op (A.R.1 + t i) (physEmbed (T.P₂ l).V (Fin ap.Mc)
          ((T.P₂ l).Ψ.proj (A.R.1 + t i) (T.P₂ l).Z)) -
          Op (A.R.1 + r i) (physEmbed (T.P₂ l).V (Fin ap.Mc)
          ((T.P₂ l).Ψ.proj (A.R.1 + r i) (T.P₂ l).Z))) := by
      unfold gIn
      simp only [map_sub]
      abel
    rw [e]
    exact norm_sub_sq_le_two_mul _ _
  refine (Finset.sum_le_sum fun i _ => hpt i).trans ?_
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
  unfold slotVar
  have h1 := hv (T.P₁ l)
  have h2 := hv (T.P₂ l)
  linarith

open Classical in
/-- The active cells of a given block offset and block. -/
noncomputable def offCells (n β : ℕ) : Finset (ℤ × ℤ) :=
  A.cells.filter fun J => T.offI J = n ∧ T.bk J = β

open Classical in
/-- On the cells of one offset and block, a sum of restricted squares of one vector is the
restricted square on their union. -/
theorem offCells_sum (hK1 : 1 ≤ T.D.S.K) (n β : ℕ) (v : ColumnL2 (Fin ap.Mc)) :
    ∑ J ∈ T.offCells n β, ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2)
      (dyadicGridCell_measurable A.G J.1 J.2) v‖ ^ 2 =
    ‖columnL2Restriction (⋃ J ∈ T.offCells n β, dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2) v‖ ^ 2 := by
  refine sum_norm_sq_restrict_le A.G _ (fun I hI I' hI' hne => ?_) v
  have h1 := Finset.mem_filter.mp hI
  have h2 := Finset.mem_filter.mp hI'
  have hRle : ∀ J ∈ A.cells, A.R.1 ≤ J.1 := fun J hJ => dyadicGridCell_depth_le_of_subset A.G J A.R
    ((dyadicFiniteTree_mem_iff A.G A.R J A.treeDepth).mp (A.cells_mem_tree hJ)).1
  have e1 := (T.bk_offI hK1 (hRle I h1.1)).1
  have e2 := (T.bk_offI hK1 (hRle I' h2.1)).1
  have hd : I.1 = I'.1 := by rw [e1, e2, h1.2.1, h1.2.2, h2.2.1, h2.2.2]
  have hne2 : I.2 ≠ I'.2 := fun h => hne (Prod.ext hd h)
  simp only [Function.onFun]
  rw [hd]
  exact dyadicGridCell_pairwiseDisjoint A.G I'.1 hne2

open Classical in
/-- The depth and block start of the cells of one offset and block. -/
theorem offCells_depth (hK1 : 1 ≤ T.D.S.K) {n β : ℕ} {J : ℤ × ℤ} (hJ : J ∈ T.offCells n β) :
    J.1 = A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ) ∧
      T.D.blockOf J.1 = A.R.1 + ((T.D.S.K * β : ℕ) : ℤ) ∧ n < T.D.S.K := by
  have h1 := Finset.mem_filter.mp hJ
  have hRle : A.R.1 ≤ J.1 := dyadicGridCell_depth_le_of_subset A.G J A.R
    ((dyadicFiniteTree_mem_iff A.G A.R J A.treeDepth).mp (A.cells_mem_tree h1.1)).1
  have e := T.bk_offI hK1 hRle
  rw [h1.2.1, h1.2.2] at e
  exact ⟨e.1, e.2.2, e.2.1⟩

open Classical in
/-- The active cells of one block offset split over their blocks. -/
theorem sum_off_blocks (hK1 : 1 ≤ T.D.S.K) (n : ℕ) (f : ℤ × ℤ → ℝ) :
    ∑ J ∈ A.cells.filter (fun J => T.offI J = n), f J =
      ∑ β : {β : Fin (A.treeDepth + 1) // T.D.S.K * (β : ℕ) + n ≤ A.treeDepth},
        ∑ J ∈ T.offCells n β.1, f J := by
  have hRle : ∀ J ∈ A.cells, A.R.1 ≤ J.1 ∧ J.1 ≤ A.R.1 + A.treeDepth := fun J hJ =>
    ⟨dyadicGridCell_depth_le_of_subset A.G J A.R
      ((dyadicFiniteTree_mem_iff A.G A.R J A.treeDepth).mp (A.cells_mem_tree hJ)).1,
    ((dyadicFiniteTree_mem_iff A.G A.R J A.treeDepth).mp (A.cells_mem_tree hJ)).2⟩
  set img := (Finset.univ : Finset {β : Fin (A.treeDepth + 1) //
    T.D.S.K * (β : ℕ) + n ≤ A.treeDepth}).image (fun β => (β.1 : ℕ)) with himg
  rw [← Finset.sum_image (s := Finset.univ) (g := fun β : {β : Fin (A.treeDepth + 1) //
      T.D.S.K * (β : ℕ) + n ≤ A.treeDepth} => (β.1 : ℕ))
    (f := fun β' => ∑ J ∈ T.offCells n β', f J) (fun β _ β' _ h => Subtype.ext (Fin.ext h))]
  rw [← Finset.sum_fiberwise_of_maps_to (g := T.bk) (t := img) (fun J hJ => ?_)]
  · refine Finset.sum_congr rfl fun β' _ => ?_
    unfold offCells
    rw [Finset.filter_filter]
  · obtain ⟨hJc, hJn⟩ := Finset.mem_filter.mp hJ
    obtain ⟨h1, h2⟩ := hRle J hJc
    have e := T.bk_offI hK1 h1
    rw [hJn] at e
    have hle : T.D.S.K * T.bk J + n ≤ A.treeDepth := by have := e.1; omega
    have hbk : T.bk J < A.treeDepth + 1 := by
      have : T.bk J ≤ T.D.S.K * T.bk J := Nat.le_mul_of_pos_left _ (by omega)
      omega
    exact Finset.mem_image.mpr ⟨⟨⟨T.bk J, hbk⟩, hle⟩, Finset.mem_univ _, rfl⟩

/-- Distinct blocks give disjoint depth intervals of a fixed offset `n < K`. -/
theorem block_ioc_disjoint {K n : ℕ} (hn : n < K) {β β' : ℕ} (hne : β ≠ β') :
    Disjoint (Finset.Ioc (K * β) (K * β + n)) (Finset.Ioc (K * β') (K * β' + n)) := by
  rw [Finset.disjoint_left]
  intro x hx hx'
  simp only [Finset.mem_Ioc] at hx hx'
  rcases Nat.lt_or_gt_of_ne hne with h | h
  · have : K * (β + 1) ≤ K * β' := Nat.mul_le_mul_left K h
    nlinarith
  · have : K * (β' + 1) ≤ K * β := Nat.mul_le_mul_left K h
    nlinarith

open Classical in
/-- The freeze differences on the cells of one offset and block are the restricted differences on
their union between the depth of the offset and the block start. -/
theorem frz_cells (hK1 : 1 ≤ T.D.S.K) (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j o n β : ℕ) :
    ∑ J ∈ T.offCells n β, T.frzD c d G t t' j o J =
      ∑ p ∈ ap.uo o, ‖columnL2Restriction (⋃ J ∈ T.offCells n β, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (T.Y c d G t t' j o (A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ)) p -
          T.Y c d G t t' j o (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) p)‖ ^ 2 +
      ‖columnL2Restriction (⋃ J ∈ T.offCells n β, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (T.F c d G t t' j (A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ)) -
          T.F c d G t t' j (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))‖ ^ 2 := by
  unfold frzD
  rw [Finset.sum_add_distrib, Finset.sum_comm]
  congr 1
  · refine Finset.sum_congr rfl fun p _ => ?_
    rw [← T.offCells_sum hK1 n β]
    refine Finset.sum_congr rfl fun J hJ => ?_
    obtain ⟨e1, e2, -⟩ := T.offCells_depth hK1 hJ
    have ev : T.Y c d G t t' j o J.1 p - T.Y c d G t t' j o (T.D.blockOf J.1) p =
        T.Y c d G t t' j o (A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ)) p -
          T.Y c d G t t' j o (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) p := by
      rw [e2, e1]
    rw [ev]
  · rw [← T.offCells_sum hK1 n β]
    refine Finset.sum_congr rfl fun J hJ => ?_
    obtain ⟨e1, e2, -⟩ := T.offCells_depth hK1 hJ
    have ev : T.F c d G t t' j J.1 - T.F c d G t t' j (T.D.blockOf J.1) =
        T.F c d G t t' j (A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ)) -
          T.F c d G t t' j (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) := by
      rw [e2, e1]
