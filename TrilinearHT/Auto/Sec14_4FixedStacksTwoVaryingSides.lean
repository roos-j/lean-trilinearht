/-! ### Global sides of a leaf (blueprint lines 2161-2162, 2414-2420) -/

/-- The global leaf output of a basic slot with column representation `P₁ - P₂`. -/
noncomputable def gOut (cat : Fin 4 → List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ l, ∀ d ∈ cat l, d.birth ∈ A.cells) (s : ℕ) (l : Fin 4) (G : A.Grp) {CF : ℝ}
    (P₁ P₂ : BasicProjection A.G A.R CF) (h : ℤ) : ColumnL2 (Fin ap.Mc) :=
  ap.projOut (cat l) hR (hb l) (ap.leafR s l) (ap.leafJ s l) G
      ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₁ h -
    ap.projOut (cat l) hR (hb l) (ap.leafR s l) (ap.leafJ s l) G
      ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) P₂ h

/-- The global linear side of slot `l`, group `G` in the block starting at `b`. -/
noncomputable def gV (l : Fin 4) (G : A.Grp) (b : ℤ) : ColumnL2 (Fin ap.Mc) :=
  physEmbed (D.Ms l G).Md (Fin ap.Mc) ((D.Ms l G).blockSide D.S D.hA D.SP b
    (D.cells l G b) (D.c l G b))

open Classical in
/-- The global side of a basic slot in the block starting at `b`: `Z_h - Z_{b - 4K} + V_b` when the
block has a decision cell, the whole output otherwise. -/
noncomputable def gSide (cat : Fin 4 → List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ l, ∀ d ∈ cat l, d.birth ∈ A.cells) (s : ℕ) (l : Fin 4) (G : A.Grp) {CF : ℝ}
    (P₁ P₂ : BasicProjection A.G A.R CF) (b h : ℤ) : ColumnL2 (Fin ap.Mc) :=
  if A.R.1 ≤ b - 4 * D.S.K then
    gOut cat hR hb s l G P₁ P₂ h - gOut cat hR hb s l G P₁ P₂ (b - 4 * D.S.K) + D.gV l G b
  else gOut cat hR hb s l G P₁ P₂ h

end LeafSplit

