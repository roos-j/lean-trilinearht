open Classical in
/-- The frozen near band forms of the unflagged uses of a slot tuple at a cell, summed over the
pairs of positive chains, the steps and the offsets with the transfer coefficients `2/P`. -/
noncomputable def nearAbs (a b c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (z : Fin 4 → ColumnL2 (Fin
    ap.Mc))
    (Yb : List ℕ → List ℕ → ℕ → ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Fb : List ℕ → List ℕ → ℕ → ColumnL2 (Fin ap.Mc)) (Unfl : List ℕ → List ℕ → ℕ → ℕ → Prop) :
    ℝ :=
  ((T.pe d).map fun t' => ((T.pe c).map fun t =>
    ∑ j ∈ Finset.range (T.desc c d t.2 t'.2).length, ∑ o ∈ Finset.range 5,
      2 / (ap.P : ℝ) * (if Unfl t.2 t'.2 j o then ‖ap.nearForm I a b (eSlot c d (T.desc c d
        t.2 t'.2) j) (fSlot c d (T.desc c d t.2 t'.2) j) z (ap.uo o) (T.X c d G t.2 t'.2 j
        I.1 (T.gside a G (T.D.blockOf I.1) I.1)) (Yb t.2 t'.2 j o) (T.side b G I) (Fb t.2
        t'.2 j)‖ else 0)).sum).sum

open Classical in
/-- The third strong factor of a slot tuple at a cell: the restoration factor and, over the pairs of
positive chains, steps and offsets, the freeze differences and the flag. -/
noncomputable def strTh (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (Yfc Yfd : ℝ → ℂ)
    (Yb : List ℕ → List ℕ → ℕ → ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Fb : List ℕ → List ℕ → ℕ → ColumnL2 (Fin ap.Mc)) (Unfl : List ℕ → List ℕ → ℕ → ℕ → Prop)
    (C₀ : ℝ) : ℝ :=
  ((T.pe d).map fun t' => ((T.pe c).map fun t =>
    localFormUniformConstant κ' * ap.rstF I c d Yfc Yfd +
    ∑ j ∈ Finset.range (T.desc c d t.2 t'.2).length, ∑ o ∈ Finset.range 5,
      2 / (ap.P : ℝ) * (localFormUniformConstant κ' * (4 * C₀ * (Real.sqrt (∑ p ∈ ap.uo o,
        ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1
        I.2) (T.Y c d G t.2 t'.2 j o I.1 p - Yb t.2 t'.2 j o p)‖ ^ 2) / Real.sqrt
        (dyadicGridLength A.G I.1)) + C₀ * (‖columnL2Restriction (dyadicGridCell A.G I.1
        I.2) (dyadicGridCell_measurable A.G I.1 I.2) (T.F c d G t.2 t'.2 j I.1 - Fb t.2 t'.2
        j)‖ / Real.sqrt (dyadicGridLength A.G I.1)) + (if Unfl t.2 t'.2 j o then 0 else C₀ ^
        2)))).sum).sum

end TTData

