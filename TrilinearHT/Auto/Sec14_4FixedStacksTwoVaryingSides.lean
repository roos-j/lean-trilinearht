/-- The rolling parts of the global sides at the block starts of one residue class of blocks
modulo `4` (disjoint intervals `(K(β-4), Kβ]`) have certified variation at most `B`. -/
theorem rolling_class (hanc : A.AncClosed) (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells)
    (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp) (Bn : ℕ) (a : Fin 4)
    {okA : A.Grp → ℤ × ℤ → Prop} {BA : ℝ}
    (hcapA : A.VarCap gset (fun G h => LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G
      (T.P₁ a) (T.P₂ a) h) okA BA)
    (hok : ∀ I ∈ S, ∀ G ∈ gs I, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okA G J)
    (hK1 : 1 ≤ T.D.S.K) (ρ : ℕ) :
    ∑ G ∈ gset, ∑ β ∈ (Finset.range Bn).filter (fun β => 4 ≤ β ∧ β % 4 = ρ ∧
        T.D.S.K * β ≤ A.treeDepth),
      ‖columnL2Restriction
        (⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
          (fun I => ancAt A.G I (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G (T.P₁ a) (T.P₂ a)
            (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) -
          LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G (T.P₁ a) (T.P₂ a)
            (A.R.1 + ((T.D.S.K * (β - 4) : ℕ) : ℤ)))‖ ^ 2 ≤ BA := by
  set cls := (Finset.range Bn).filter (fun β => 4 ≤ β ∧ β % 4 = ρ ∧ T.D.S.K * β ≤ A.treeDepth)
    with hcls
  have hRle : ∀ I ∈ A.cells, A.R.1 ≤ I.1 := fun I hI => dyadicGridCell_depth_le_of_subset A.G I A.R
    ((dyadicFiniteTree_mem_iff A.G A.R I A.treeDepth).mp (A.cells_mem_tree hI)).1
  have h := hcapA (ι := {β // β ∈ cls}) (fun β => T.D.S.K * (β.1 - 4)) (fun β => T.D.S.K * β.1)
    (fun β => Nat.mul_le_mul_left _ (Nat.sub_le _ _)) (fun i i' hne => ?_)
    (fun i => (Finset.mem_filter.mp i.2).2.2.2)
    (fun G β => (S.filter fun I => G ∈ gs I ∧ T.bk I = β.1).image
      (fun I => ancAt A.G I (A.R.1 + ((T.D.S.K * β.1 : ℕ) : ℤ)))) ?_
  · refine le_trans (le_of_eq ?_) h
    refine Finset.sum_congr rfl fun G _ => ?_
    rw [← Finset.sum_coe_sort cls]
  · -- disjoint intervals of one residue class
    have h1 := Finset.mem_filter.mp i.2
    have h2 := Finset.mem_filter.mp i'.2
    have hne' : i.1 ≠ i'.1 := fun h => hne (Subtype.ext h)
    rw [Finset.disjoint_left]
    intro x hx hx'
    simp only [Finset.mem_Ioc] at hx hx'
    rcases Nat.lt_or_gt_of_ne hne' with hlt | hlt
    · have : i.1 + 4 ≤ i'.1 := by omega
      have : T.D.S.K * (i.1 + 4) ≤ T.D.S.K * i'.1 := Nat.mul_le_mul_left _ this
      have : T.D.S.K * (i'.1 - 4) ≥ T.D.S.K * i.1 := Nat.mul_le_mul_left _ (by omega)
      omega
    · have : i'.1 + 4 ≤ i.1 := by omega
      have : T.D.S.K * (i.1 - 4) ≥ T.D.S.K * i'.1 := Nat.mul_le_mul_left _ (by omega)
      omega
  · intro G β J hJ
    obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hJ
    obtain ⟨hIS, hG, hbk⟩ := Finset.mem_filter.mp hI
    have hIc := hS hIS
    have e := T.bk_offI hK1 (hRle I hIc)
    rw [hbk] at e
    have hd : A.R.1 + ((T.D.S.K * β.1 : ℕ) : ℤ) ≤ I.1 := by rw [e.1]; push_cast; omega
    have hsub := subset_ancAt A.G I hd
    have hanc' : ancAt A.G I (A.R.1 + ((T.D.S.K * β.1 : ℕ) : ℤ)) ∈ A.cells :=
      hanc I hIc _ hsub (ancAt_subset (A.sub I hIc) (by omega))
    exact ⟨hanc', rfl, hok I hIS G hG _ hanc' hsub⟩

