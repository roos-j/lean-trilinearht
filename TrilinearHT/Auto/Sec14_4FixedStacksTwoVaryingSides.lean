section GlobalStacks
variable {V : Type*} [Fintype V]

/-- Blueprint lines 2414-2420 (fixed linear side `V_{G,b}` under a subsequent averaged history
`T_s`): the base term and the outer bands over disjoint position intervals satisfy
`‖T_b V‖² + Σ_{[r,t]} ‖(T_t - T_r) V‖² ≤ (1 + |ls| Σ_m C_m²) ‖V‖²` (`lem:prefix` with pads
coupled and complements expanded, `globHist_jump`). -/
theorem globHist_stack_linear {ι : Type*} [Fintype ι] (Ψ : ColumnDepthFamily V) {P : ℕ}
    (hP : 0 < P) (Am : ℕ → Fin P → InheritedColumnMask Ψ.D) (ls : List (ℕ × Bool))
    (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i j, i ≠ j → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r j) (t j)))
    (b : ℤ) (Vv : ColumnL2 V) :
    ‖globHist Ψ Am ls b Vv‖ ^ 2 + ∑ i, ‖globHist Ψ Am ls (Ψ.D.root.1 + t i) Vv -
        globHist Ψ Am ls (Ψ.D.root.1 + r i) Vv‖ ^ 2 ≤
      (1 + ls.length * ∑ m ∈ Finset.range ls.length, compressionC Ψ.D m ^ 2) * ‖Vv‖ ^ 2 := by
  have h1 := pow_le_pow_left₀ (norm_nonneg _) (globHist_norm_le Ψ hP Am ls b Vv) 2
  have h2 := globHist_jump Ψ hP Am ls r t hrt hdis Vv
  nlinarith

end GlobalStacks

section RollingStacks
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Blueprint `eq:stack-energy` for a rolling side (lines 2420-2423) with any contraction history
`T_s` whose outer jumps on a fixed input are Bessel with constant `C_j`: with the inner
difference `Z_{r_i} - Z_u = Σ_k Y_{i,k}` and local fixed inputs `X_k`,
`Σ_i ‖E_i (W_{t_i} - W_{r_i})‖² ≤ 2 Σ_i ‖Z_{t_i} - Z_{r_i}‖² + 2 |s| C_j Σ_k ‖X_k‖²`,
`W_s = T_s (Z_s - Z_u)`. -/
theorem stack_energy_rolling_gen {ι κ : Type*} [Fintype ι] (s : Finset κ)
    (Tm : ℕ → H →L[ℂ] H) (hT : ∀ n y, ‖Tm n y‖ ≤ ‖y‖) (r t : ι → ℕ)
    (E : ι → H →L[ℂ] H) (hE : ∀ i y, ‖E i y‖ ≤ ‖y‖) (Z : ℕ → H) (u : ℕ)
    (Y : ι → κ → H) (hY : ∀ i, Z (r i) - Z u = ∑ k ∈ s, Y i k) (X : κ → H)
    (hloc : ∀ i, ∀ k ∈ s, E i (Tm (t i) (Y i k) - Tm (r i) (Y i k)) =
      E i (Tm (t i) (X k) - Tm (r i) (X k)))
    {Cj : ℝ} (hjump : ∀ x : H, ∑ i, ‖Tm (t i) x - Tm (r i) x‖ ^ 2 ≤ Cj * ‖x‖ ^ 2) :
    ∑ i, ‖E i (Tm (t i) (Z (t i) - Z u) - Tm (r i) (Z (r i) - Z u))‖ ^ 2 ≤
      2 * ∑ i, ‖Z (t i) - Z (r i)‖ ^ 2 + 2 * s.card * (Cj * ∑ k ∈ s, ‖X k‖ ^ 2) := by
  have hsplit : ∀ i, E i (Tm (t i) (Z (t i) - Z u) - Tm (r i) (Z (r i) - Z u)) =
      E i (Tm (t i) (Z (t i) - Z (r i))) + ∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k)) := by
    intro i
    rw [← Finset.sum_congr rfl (hloc i), ← map_sum, ← map_add]
    congr 1
    rw [Finset.sum_sub_distrib, ← map_sum, ← map_sum, ← hY i]
    simp only [map_sub]
    abel
  have hsq : ∀ i, ‖E i (Tm (t i) (Z (t i) - Z u) - Tm (r i) (Z (r i) - Z u))‖ ^ 2 ≤
      2 * ‖Z (t i) - Z (r i)‖ ^ 2 +
        2 * (s.card * ∑ k ∈ s, ‖Tm (t i) (X k) - Tm (r i) (X k)‖ ^ 2) := by
    intro i
    rw [hsplit i]
    have h1 := norm_add_le (E i (Tm (t i) (Z (t i) - Z (r i))))
      (∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k)))
    have hd : ‖E i (Tm (t i) (Z (t i) - Z (r i)))‖ ≤ ‖Z (t i) - Z (r i)‖ :=
      (hE i _).trans (hT _ _)
    have h2 : ‖∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k))‖ ^ 2 ≤
        s.card * ∑ k ∈ s, ‖Tm (t i) (X k) - Tm (r i) (X k)‖ ^ 2 := by
      refine (pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2).trans ?_
      refine sq_sum_le_card_mul_sum_sq.trans ?_
      gcongr with k hk
      exact hE i _
    have h0 := norm_nonneg (E i (Tm (t i) (Z (t i) - Z (r i))) +
      ∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k)))
    have hdn := norm_nonneg (E i (Tm (t i) (Z (t i) - Z (r i))))
    nlinarith [sq_nonneg (‖E i (Tm (t i) (Z (t i) - Z (r i)))‖ -
      ‖∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k))‖)]
  calc ∑ i, ‖E i (Tm (t i) (Z (t i) - Z u) - Tm (r i) (Z (r i) - Z u))‖ ^ 2
      ≤ ∑ i, (2 * ‖Z (t i) - Z (r i)‖ ^ 2 +
        2 * (s.card * ∑ k ∈ s, ‖Tm (t i) (X k) - Tm (r i) (X k)‖ ^ 2)) :=
        Finset.sum_le_sum fun i _ => hsq i
    _ = 2 * ∑ i, ‖Z (t i) - Z (r i)‖ ^ 2 + 2 * s.card *
        ∑ k ∈ s, ∑ i, ‖Tm (t i) (X k) - Tm (r i) (X k)‖ ^ 2 := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_comm]
        simp_rw [← Finset.mul_sum]; ring
    _ ≤ 2 * ∑ i, ‖Z (t i) - Z (r i)‖ ^ 2 + 2 * s.card * ∑ k ∈ s, Cj * ‖X k‖ ^ 2 := by
        have : (0 : ℝ) ≤ 2 * s.card := by positivity
        gcongr with k hk
        exact hjump (X k)
    _ = _ := by rw [Finset.mul_sum s (fun k => ‖X k‖ ^ 2) Cj]

end RollingStacks

/-- `stack_energy_rolling_gen` for the attempt's averaged histories (`globHist_jump`). -/
theorem globHist_stack_rolling {V ι κ : Type*} [Fintype V] [Fintype ι] (s : Finset κ)
    (Ψ : ColumnDepthFamily V) {P : ℕ} (hP : 0 < P) (Am : ℕ → Fin P → InheritedColumnMask Ψ.D)
    (ls : List (ℕ × Bool)) (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i j, i ≠ j → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r j) (t j)))
    (E : ι → ColumnL2 V →L[ℂ] ColumnL2 V) (hE : ∀ i y, ‖E i y‖ ≤ ‖y‖) (Z : ℕ → ColumnL2 V)
    (u : ℕ) (Y : ι → κ → ColumnL2 V) (hY : ∀ i, Z (r i) - Z u = ∑ k ∈ s, Y i k)
    (X : κ → ColumnL2 V)
    (hloc : ∀ i, ∀ k ∈ s, E i (globHist Ψ Am ls (Ψ.D.root.1 + t i) (Y i k) -
      globHist Ψ Am ls (Ψ.D.root.1 + r i) (Y i k)) = E i (globHist Ψ Am ls (Ψ.D.root.1 + t i)
        (X k) - globHist Ψ Am ls (Ψ.D.root.1 + r i) (X k))) :
    ∑ i, ‖E i (globHist Ψ Am ls (Ψ.D.root.1 + t i) (Z (t i) - Z u) -
        globHist Ψ Am ls (Ψ.D.root.1 + r i) (Z (r i) - Z u))‖ ^ 2 ≤
      2 * ∑ i, ‖Z (t i) - Z (r i)‖ ^ 2 + 2 * s.card *
        (ls.length * (∑ m ∈ Finset.range ls.length, compressionC Ψ.D m ^ 2) *
          ∑ k ∈ s, ‖X k‖ ^ 2) := by
  have h := stack_energy_rolling_gen s (fun n => globHist Ψ Am ls (Ψ.D.root.1 + n))
    (fun n y => globHist_norm_le Ψ hP Am ls _ y) r t E hE Z u Y hY X hloc
    (Cj := ls.length * ∑ m ∈ Finset.range ls.length, compressionC Ψ.D m ^ 2)
    (fun x => globHist_jump Ψ hP Am ls r t hrt hdis x)
  exact h

section Randomization

/-! ### Rademacher randomization of the stacks (blueprint lines 2421-2423) -/

/-- The sign patterns on a finite set. -/
abbrev SignPattern {ι : Type*} (s : Finset ι) := {u // u ∈ s.powerset}

instance {ι : Type*} (s : Finset ι) : MeasurableSpace (SignPattern s) := ⊤

instance {ι : Type*} (s : Finset ι) : MeasurableSingletonClass (SignPattern s) :=
  ⟨fun _ => MeasurableSpace.measurableSet_top⟩

/-- The uniform probability on sign patterns. -/
noncomputable def signMeasure {ι : Type*} (s : Finset ι) : Measure (SignPattern s) :=
  (2 ^ s.card : ℝ≥0∞)⁻¹ • Measure.count

theorem lintegral_signMeasure {ι : Type*} (s : Finset ι) (f : SignPattern s → ℝ≥0∞) :
    ∫⁻ σ, f σ ∂(signMeasure s) = (2 ^ s.card : ℝ≥0∞)⁻¹ * ∑ σ, f σ := by
  unfold signMeasure
  rw [lintegral_smul_measure, lintegral_count, tsum_fintype, smul_eq_mul]

/-- Blueprint lines 2421-2423 ("two applications of Khintchine give the pointwise moment hypothesis
in `lem:shortblock`"), one sign family: the randomized scalar `Σ_i ε_i x_i(y)` has fourth moment
at most `4 (Σ_i |x_i(y)|²)^{1/2}`, the norm of the deterministic position vector. -/
theorem rademacher_moment_hyp {ι : Type*} [DecidableEq ι] (s : Finset ι) (x : ι → ℝ → ℂ)
    (y : ℝ) :
    (∫⁻ σ, ‖rademacherSum s σ.1 (fun i => x i y)‖ₑ ^ (4 : ℝ) ∂(signMeasure s)) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal 4 * ENNReal.ofReal (Real.sqrt (∑ i ∈ s, ‖x i y‖ ^ 2)) := by
  rw [lintegral_signMeasure]
  have hmean : (2 ^ s.card : ℝ≥0∞)⁻¹ * ∑ σ : SignPattern s,
      ‖rademacherSum s σ.1 (fun i => x i y)‖ₑ ^ (4 : ℝ) =
      ENNReal.ofReal (rademacherMean s fun u =>
        ‖rademacherSum s u (fun i => x i y)‖ ^ (4 : ℝ)) := by
    unfold rademacherMean
    rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_inv_of_pos (by positivity),
      ENNReal.ofReal_sum_of_nonneg fun _ _ => by positivity]
    congr 1
    · norm_num
    · rw [← Finset.sum_coe_sort s.powerset]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
  rw [hmean, ENNReal.ofReal_rpow_of_nonneg (by
    unfold rademacherMean; positivity) (by norm_num), ← ENNReal.ofReal_mul (by norm_num)]
  refine ENNReal.ofReal_le_ofReal ?_
  have h := signs_moment_bound s (fun i => x i y) (p := 4) (by norm_num)
  refine h.trans (le_of_eq ?_)
  rw [show Real.sqrt 4 = 2 by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]]
  ring

end Randomization

