              ((T.desc c d t t').drop (j + 1)) (j + 1)).length) +
        T.slotVar (cslot c d (!((T.desc c d t t').getD j (true, 0, none)).1))
          (T.jmpC c d (!((T.desc c d t t').getD j (true, 0, none)).1)
            (restIdx (!((T.desc c d t t').getD j (true, 0, none)).1)
