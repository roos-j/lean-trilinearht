        have hz : ∀ x : ColumnL2 (Fin ap.Mc), ‖columnL2Restriction (E G β) (hEm G β) x‖ ^ 2 = 0 :=
          fun x => by
            rw [columnL2Restriction_norm_sq, hempty, Measure.restrict_empty, integral_zero_measure]
        rw [hz]
        simp only [htd, and_false, ite_false, zero_add]
        exact mul_nonneg (by norm_num) (sq_nonneg _)
    · have hdec : ¬ A.R.1 ≤ A.R.1 + ((T.D.S.K * β : ℕ) : ℤ) - 4 * T.D.S.K := by
        have : T.D.S.K * β < 4 * T.D.S.K := by nlinarith
        push_cast; omega
      have e : T.gside a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) =
          LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G (T.P₁ a) (T.P₂ a)
