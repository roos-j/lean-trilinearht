/-- The band variation over disjoint depth intervals (`slot_variation` for the band operators). -/
theorem band_var (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j o p : ℕ) {ι : Type} [Fintype ι]
    (r s : ι → ℕ) (hrs : ∀ i, r i ≤ s i)
