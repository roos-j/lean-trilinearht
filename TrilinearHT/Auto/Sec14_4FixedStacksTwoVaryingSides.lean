        have : 4 * T.D.S.K ≤ T.D.S.K * β := by nlinarith
        push_cast; omega
      have hb4 : A.R.1 + ((T.D.S.K * β : ℕ) : ℤ) - 4 * T.D.S.K =
          A.R.1 + ((T.D.S.K * (β - 4) : ℕ) : ℤ) := by
        rw [Nat.mul_sub, Nat.cast_sub (by nlinarith)]; push_cast; ring
      have e : T.gside a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) =
          roll G β + T.D.gV a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) := by
        unfold gside LeafSplit.gSide
        rw [ite_eq_left_of_eq_true _ _ (eq_true hdec), hb4]
      rw [e]
      have h4' : ¬ β < 4 := by omega
      simp only [h4', ite_false, add_zero]
      by_cases htd : T.D.S.K * β ≤ A.treeDepth
      · simp only [h4, htd, and_self, ite_true]
        rw [map_add]
        refine (norm_add_sq_le_two_mul _ _).trans (add_le_add le_rfl ?_)
        exact mul_le_mul_of_nonneg_left (columnL2Restriction_norm_sq_le _ _ _) (by norm_num)
      · have hempty : E G β = ∅ := by
          simp only [hE]
          refine Set.eq_empty_of_forall_notMem fun y hy => ?_
          obtain ⟨J, hJ, -⟩ := Set.mem_iUnion₂.mp hy
          obtain ⟨I, hI, -⟩ := Finset.mem_image.mp hJ
          obtain ⟨hIS, -, hbk⟩ := Finset.mem_filter.mp hI
