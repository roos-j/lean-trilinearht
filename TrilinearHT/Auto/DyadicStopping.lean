/-- A real dyadic grid as in blueprint line 364. Each level is a translated
interval partition; the alignment condition makes each coarse boundary a fine boundary. -/
structure RealDyadicGrid where
  baseLength : ℝ
  baseLength_pos : 0 < baseLength
  origin : ℤ → ℝ
  alignment : ∀ s : ℤ, ∃ k : ℤ, origin s = origin (s + 1) +
    (k : ℝ) * (baseLength * (2 : ℝ) ^ (-(s + 1)))

noncomputable def dyadicGridLength (G : RealDyadicGrid) (s : ℤ) : ℝ :=
  G.baseLength * (2 : ℝ) ^ (-s)

theorem dyadicGridLength_pos (G : RealDyadicGrid) (s : ℤ) : 0 < dyadicGridLength G s :=
  mul_pos G.baseLength_pos (zpow_pos (by norm_num) _)

noncomputable def dyadicGridLeft (G : RealDyadicGrid) (s m : ℤ) : ℝ :=
  G.origin s + (m : ℝ) * dyadicGridLength G s

/-- Half-open cells, with integer depth and position, from blueprint line 364. -/
noncomputable def dyadicGridCell (G : RealDyadicGrid) (s m : ℤ) : Set ℝ :=
  Set.Ico (dyadicGridLeft G s m) (dyadicGridLeft G s m + dyadicGridLength G s)

theorem dyadicGridCell_measurable (G : RealDyadicGrid) (s m : ℤ) :
    MeasurableSet (dyadicGridCell G s m) := measurableSet_Ico

theorem dyadicGridCell_volume (G : RealDyadicGrid) (s m : ℤ) :
    volume (dyadicGridCell G s m) = ENNReal.ofReal (dyadicGridLength G s) := by
  simp [dyadicGridCell, Real.volume_Ico]

/-- The ordinary grid is included in the source's grid class. -/
noncomputable def ordinaryDyadicGrid : RealDyadicGrid where
  baseLength := 1
  baseLength_pos := zero_lt_one
  origin := fun _ => 0
  alignment s := ⟨0, by simp⟩

theorem dyadicGridCell_disjoint_of_lt (G : RealDyadicGrid) (s : ℤ)
    {m n : ℤ} (hmn : m < n) : Disjoint (dyadicGridCell G s m) (dyadicGridCell G s n) := by
  apply Set.disjoint_left.mpr
  intro x hxm hxn
  have hr := dyadicGridLength_pos G s
  have hmn' : (m : ℝ) + 1 ≤ n := by exact_mod_cast (show m + 1 ≤ n by omega)
  have hmul := mul_le_mul_of_nonneg_right hmn' hr.le
  change G.origin s + (m : ℝ) * dyadicGridLength G s ≤ x ∧
    x < G.origin s + (m : ℝ) * dyadicGridLength G s + dyadicGridLength G s at hxm
  change G.origin s + (n : ℝ) * dyadicGridLength G s ≤ x ∧
    x < G.origin s + (n : ℝ) * dyadicGridLength G s + dyadicGridLength G s at hxn
  nlinarith [hxm.2, hxn.1]

theorem dyadicGridCell_pairwiseDisjoint (G : RealDyadicGrid) (s : ℤ) :
    Pairwise (fun m n => Disjoint (dyadicGridCell G s m) (dyadicGridCell G s n)) := by
  intro m n hmn
  rcases lt_or_gt_of_ne hmn with h | h
  · exact dyadicGridCell_disjoint_of_lt G s h
  · exact (dyadicGridCell_disjoint_of_lt G s h).symm

theorem dyadicGridCell_covers (G : RealDyadicGrid) (s : ℤ) (x : ℝ) :
    ∃ m : ℤ, x ∈ dyadicGridCell G s m := by
  let r := dyadicGridLength G s
  let t := (x - G.origin s) / r
  have hr : 0 < r := dyadicGridLength_pos G s
  have ht : t * r = x - G.origin s := div_mul_cancel₀ _ hr.ne'
  have hlo := mul_le_mul_of_nonneg_right (Int.floor_le t) hr.le
  have hhi := mul_lt_mul_of_pos_right (Int.lt_floor_add_one t) hr
  refine ⟨⌊t⌋, ?_⟩
  change G.origin s + (⌊t⌋ : ℝ) * r ≤ x ∧
    x < G.origin s + (⌊t⌋ : ℝ) * r + r
  constructor <;> nlinarith

theorem dyadicGridLength_half (G : RealDyadicGrid) (s : ℤ) :
    dyadicGridLength G (s + 1) * 2 = dyadicGridLength G s := by
  unfold dyadicGridLength
  rw [neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  norm_num
  ring

/-- Each source grid cell is exactly the union of its two consecutive children. -/
theorem dyadicGridCell_children (G : RealDyadicGrid) (s m : ℤ) :
    ∃ n : ℤ, dyadicGridCell G s m =
      dyadicGridCell G (s + 1) n ∪ dyadicGridCell G (s + 1) (n + 1) := by
  obtain ⟨k, hk⟩ := G.alignment s
  refine ⟨k + 2 * m, ?_⟩
  have hr := dyadicGridLength_pos G (s + 1)
  have hh := dyadicGridLength_half G s
  have hleft : dyadicGridLeft G s m = dyadicGridLeft G (s + 1) (k + 2 * m) := by
    unfold dyadicGridLeft
    rw [hk, ← hh]
    push_cast
    change G.origin (s + 1) + (k : ℝ) * dyadicGridLength G (s + 1) +
      (m : ℝ) * (dyadicGridLength G (s + 1) * 2) = _
    ring
  have hnext : dyadicGridLeft G (s + 1) (k + 2 * m + 1) =
      dyadicGridLeft G (s + 1) (k + 2 * m) + dyadicGridLength G (s + 1) := by
    simp only [dyadicGridLeft, Int.cast_add, Int.cast_one]
    ring
  unfold dyadicGridCell
  rw [hleft, hnext, ← hh]
  have he : dyadicGridLeft G (s + 1) (k + 2 * m) +
      dyadicGridLength G (s + 1) + dyadicGridLength G (s + 1) =
      dyadicGridLeft G (s + 1) (k + 2 * m) + dyadicGridLength G (s + 1) * 2 := by ring
  rw [he, Set.Ico_union_Ico_eq_Ico (by linarith) (by linarith)]

open scoped Classical in
/-- The nonnegative path sum through a finite family of dyadic cells. -/
noncomputable def dyadicPathSum (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ≥0∞) (x : ℝ) : ℝ≥0∞ :=
  ∑ c ∈ S, (dyadicGridCell G c.1 c.2).indicator (fun _ => a c) x

theorem dyadicPathSum_measurable (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ≥0∞) : Measurable (dyadicPathSum G S a) := by
  classical
  unfold dyadicPathSum
  exact Finset.measurable_sum _ (fun c _ =>
    measurable_const.indicator (dyadicGridCell_measurable G c.1 c.2))

/-- Blueprint `eq:path`, lines 424–428: summing cell length times weight
is exactly the integral of the path sum on a containing root. -/
theorem dyadicPathIntegral (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ R) :
    (∑ c ∈ S, ENNReal.ofReal (dyadicGridLength G c.1) * a c) =
      ∫⁻ x in R, dyadicPathSum G S a x := by
  classical
  unfold dyadicPathSum
  rw [lintegral_finsetSum _ (fun c _ =>
    measurable_const.indicator (dyadicGridCell_measurable G c.1 c.2))]
  apply Finset.sum_congr rfl
  intro c hc
  rw [lintegral_indicator (dyadicGridCell_measurable G c.1 c.2),
    Measure.restrict_restrict_of_subset (hR c hc), setLIntegral_const,
    dyadicGridCell_volume, mul_comm]

/-- The ordinary real-integral form of blueprint `eq:path`. It holds even
for signed real weights, since the cell family is finite. -/
theorem dyadicPathIntegral_real (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (R : Set ℝ)
    (hR : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ R) :
    (∑ c ∈ S, dyadicGridLength G c.1 * a c) =
      ∫ x in R, ∑ c ∈ S, (dyadicGridCell G c.1 c.2).indicator (fun _ => a c) x := by
  classical
  have hi (c) (hc : c ∈ S) : Integrable
      ((dyadicGridCell G c.1 c.2).indicator (fun _ => a c)) (volume.restrict R) := by
    apply (integrable_indicator_iff (dyadicGridCell_measurable G c.1 c.2)).mpr
    change Integrable _ ((volume.restrict R).restrict (dyadicGridCell G c.1 c.2))
    rw [Measure.restrict_restrict_of_subset (hR c hc)]
    exact integrableOn_const (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)
  rw [integral_finsetSum _ hi]
  apply Finset.sum_congr rfl
  intro c hc
  rw [integral_indicator (dyadicGridCell_measurable G c.1 c.2),
    Measure.restrict_restrict_of_subset (hR c hc), setIntegral_const,
    Measure.real, dyadicGridCell_volume, ENNReal.toReal_ofReal (dyadicGridLength_pos G c.1).le,
    smul_eq_mul]

theorem finite_union_weight_le {ι α : Type*} [DecidableEq α]
    (T : Finset ι) (F : ι → Finset α) (w : α → ℝ) (hw : ∀ x, 0 ≤ w x) :
    (∑ x ∈ T.biUnion F, w x) ≤ ∑ i ∈ T, ∑ x ∈ F i, w x := by
  classical
  induction T using Finset.induction with
  | empty => simp
  | @insert i T hi ih =>
    rw [Finset.biUnion_insert, Finset.sum_insert hi]
    have hsum := Finset.sum_union_inter (s₁ := F i) (s₂ := T.biUnion F) (f := w)
    have hnonneg : 0 ≤ ∑ x ∈ F i ∩ T.biUnion F, w x := Finset.sum_nonneg (fun x _ => hw x)
    linarith

/-- Blueprint path-packing, line 429: every restart generation loses at
least the fixed fraction `1 - ρ` of total root length. -/
theorem restart_generation_decay (g : ℕ → ℝ) {ρ L : ℝ} (hρ : 0 ≤ ρ)
    (hzero : g 0 ≤ L) (hstep : ∀ k, g (k + 1) ≤ ρ * g k) :
    ∀ k, g k ≤ ρ ^ k * L := by
  intro k
  induction k with
  | zero => simpa using hzero
  | succ k ih =>
    calc
      _ ≤ ρ * g k := hstep k
      _ ≤ ρ * (ρ ^ k * L) := mul_le_mul_of_nonneg_left ih hρ
      _ = _ := by rw [pow_succ]; ring

/-- Blueprint path-packing, line 429: the total length over all restart
generations is summable and at most the initial root length divided by `1-ρ`. -/
theorem restart_total_length (g : ℕ → ℝ) (hg : ∀ k, 0 ≤ g k)
    {ρ L : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ < 1)
    (hzero : g 0 ≤ L) (hstep : ∀ k, g (k + 1) ≤ ρ * g k) :
    Summable g ∧ (∑' k, g k) ≤ L / (1 - ρ) := by
  have hmajor := (hasSum_geometric_of_lt_one hρ hρ1).mul_right L
  have hbound := restart_generation_decay g hρ hzero hstep
  have hs : Summable g := Summable.of_nonneg_of_le hg hbound hmajor.summable
  refine ⟨hs, ?_⟩
  calc
    _ ≤ ∑' k, ρ ^ k * L := Summable.tsum_le_tsum hbound hs hmajor.summable
    _ = (1 - ρ)⁻¹ * L := hmajor.tsum_eq
    _ = _ := by rw [div_eq_mul_inv, mul_comm]

/-- Total length of a finite family of dyadic cells. -/
noncomputable def dyadicRootLength (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) : ℝ :=
  ∑ c ∈ S, dyadicGridLength G c.1

theorem dyadicRootLength_nonneg (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    0 ≤ dyadicRootLength G S :=
  Finset.sum_nonneg (fun c _ => (dyadicGridLength_pos G c.1).le)

/-- The source restart bound from the actual per-root exceptional-child
budgets. Taking a union or a subfamily of children can only lower its cost. -/
theorem dyadicRestartPacking (G : RealDyadicGrid) (root : ℤ × ℤ)
    (generation : ℕ → Finset (ℤ × ℤ)) (children : ℕ → ℤ × ℤ → Finset (ℤ × ℤ))
    {ρ : ℝ} (hρ : 0 ≤ ρ) (hρ1 : ρ < 1) (hzero : generation 0 = {root})
    (hnext : ∀ k, generation (k + 1) ⊆ (generation k).biUnion (children k))
    (hchild : ∀ k c, c ∈ generation k →
      dyadicRootLength G (children k c) ≤ ρ * dyadicGridLength G c.1) :
    (∀ k, dyadicRootLength G (generation k) ≤ ρ ^ k * dyadicGridLength G root.1) ∧
    Summable (fun k => dyadicRootLength G (generation k)) ∧
    (∑' k, dyadicRootLength G (generation k)) ≤ dyadicGridLength G root.1 / (1 - ρ) := by
  have hz : dyadicRootLength G (generation 0) ≤ dyadicGridLength G root.1 := by
    simp [hzero, dyadicRootLength]
  have hs (k) : dyadicRootLength G (generation (k + 1)) ≤
      ρ * dyadicRootLength G (generation k) := by
    calc
      _ ≤ dyadicRootLength G ((generation k).biUnion (children k)) :=
        Finset.sum_le_sum_of_subset_of_nonneg (hnext k)
          (fun c _ _ => (dyadicGridLength_pos G c.1).le)
      _ ≤ ∑ c ∈ generation k, dyadicRootLength G (children k c) :=
        finite_union_weight_le _ _ _ (fun c => (dyadicGridLength_pos G c.1).le)
      _ ≤ ∑ c ∈ generation k, ρ * dyadicGridLength G c.1 :=
        Finset.sum_le_sum (fun c hc => hchild k c hc)
      _ = _ := (Finset.mul_sum ..).symm
  exact ⟨restart_generation_decay _ hρ hz hs,
    restart_total_length _ (fun k => dyadicRootLength_nonneg G (generation k)) hρ hρ1 hz hs⟩

open scoped Classical in
/-- Maximal cells of a finite family, ordered by interval containment. -/
noncomputable def maximalDyadicCells (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    Finset (ℤ × ℤ) :=
  S.filter (fun c => ∀ d ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
    dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G c.1 c.2)

theorem maximalDyadicCells_subset (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    maximalDyadicCells G S ⊆ S := by
  classical
  exact Finset.filter_subset _ _

theorem maximalDyadicCells_covers (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    {c : ℤ × ℤ} (hc : c ∈ S) :
    ∃ d ∈ maximalDyadicCells G S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  classical
  let F := fun c : ℤ × ℤ => dyadicGridCell G c.1 c.2
  let T := S.image F
  have hcT : F c ∈ T := Finset.mem_image.mpr ⟨c, hc, rfl⟩
  obtain ⟨I, hcI, hI⟩ := T.finite_toSet.exists_le_maximal hcT
  obtain ⟨d, hd, hdI⟩ := Finset.mem_image.mp hI.1
  refine ⟨d, Finset.mem_filter.mpr ⟨hd, ?_⟩, ?_⟩
  · intro e he hde
    have heT : F e ∈ T := Finset.mem_image.mpr ⟨e, he, rfl⟩
    have hIe : I ⊆ F e := hdI ▸ hde
    change F e ⊆ F d
    rw [hdI]
    exact hI.2 heT hIe
  · change F c ⊆ F d
    rw [hdI]
    exact hcI

/-- Passing to maximal cells preserves exactly the region removed by a
finite stopping family. -/
theorem maximalDyadicCells_union (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    (⋃ c ∈ maximalDyadicCells G S, dyadicGridCell G c.1 c.2) =
      ⋃ c ∈ S, dyadicGridCell G c.1 c.2 := by
  ext x
  simp only [Set.mem_iUnion]
  constructor
  · rintro ⟨c, hc, hx⟩
    exact ⟨c, maximalDyadicCells_subset G S hc, hx⟩
  · rintro ⟨c, hc, hx⟩
    obtain ⟨d, hd, hcd⟩ := maximalDyadicCells_covers G S hc
    exact ⟨d, hd, hcd hx⟩

theorem maximalDyadicCells_length_le (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    dyadicRootLength G (maximalDyadicCells G S) ≤ dyadicRootLength G S :=
  Finset.sum_le_sum_of_subset_of_nonneg (maximalDyadicCells_subset G S)
    (fun c _ _ => (dyadicGridLength_pos G c.1).le)

/-- Blueprint path-packing, line 429: take maximal cells in the union of
several first-stop rules; their length cost is at most the sum of the costs. -/
theorem dyadicCombineStops {ι : Type*} (G : RealDyadicGrid) (T : Finset ι)
    (F : ι → Finset (ℤ × ℤ)) (root : ℤ × ℤ) (budget : ι → ℝ)
    (hF : ∀ i ∈ T, dyadicRootLength G (F i) ≤ budget i * dyadicGridLength G root.1) :
    (⋃ c ∈ maximalDyadicCells G (T.biUnion F), dyadicGridCell G c.1 c.2) =
      (⋃ c ∈ T.biUnion F, dyadicGridCell G c.1 c.2) ∧
    dyadicRootLength G (maximalDyadicCells G (T.biUnion F)) ≤
      (∑ i ∈ T, budget i) * dyadicGridLength G root.1 := by
  refine ⟨maximalDyadicCells_union G _, ?_⟩
  calc
    _ ≤ dyadicRootLength G (T.biUnion F) := maximalDyadicCells_length_le G _
    _ ≤ ∑ i ∈ T, dyadicRootLength G (F i) :=
      finite_union_weight_le T F _ (fun c => (dyadicGridLength_pos G c.1).le)
    _ ≤ ∑ i ∈ T, budget i * dyadicGridLength G root.1 := Finset.sum_le_sum hF
    _ = _ := (Finset.sum_mul ..).symm

theorem dyadicGridCell_left_mem (G : RealDyadicGrid) (s m : ℤ) :
    dyadicGridLeft G s m ∈ dyadicGridCell G s m := by
  exact ⟨le_rfl, lt_add_of_pos_right _ (dyadicGridLength_pos G s)⟩

theorem dyadicGridCell_sameDepth_common_point (G : RealDyadicGrid) (s m n : ℤ)
    {x : ℝ} (hm : x ∈ dyadicGridCell G s m) (hn : x ∈ dyadicGridCell G s n) : m = n := by
  by_contra hne
  exact Set.disjoint_left.mp (dyadicGridCell_pairwiseDisjoint G s hne) hm hn

/-- Every child cell belongs to a parent at the preceding depth. -/
theorem dyadicGridCell_parent (G : RealDyadicGrid) (s n : ℤ) :
    ∃ m : ℤ, dyadicGridCell G (s + 1) n ⊆ dyadicGridCell G s m := by
  let x := dyadicGridLeft G (s + 1) n
  have hx : x ∈ dyadicGridCell G (s + 1) n := dyadicGridCell_left_mem G _ _
  obtain ⟨m, hm⟩ := dyadicGridCell_covers G s x
  obtain ⟨k, hk⟩ := dyadicGridCell_children G s m
  refine ⟨m, ?_⟩
  rw [hk] at hm ⊢
  rcases hm with h | h
  · have hn := dyadicGridCell_sameDepth_common_point G (s + 1) n k hx h
    rw [hn]
    exact Set.subset_union_left
  · have hn := dyadicGridCell_sameDepth_common_point G (s + 1) n (k + 1) hx h
    rw [hn]
    exact Set.subset_union_right

theorem dyadicGridCell_ancestor (G : RealDyadicGrid) {s t : ℤ} (hst : s ≤ t) (n : ℤ) :
    ∃ m : ℤ, dyadicGridCell G t n ⊆ dyadicGridCell G s m := by
  obtain ⟨k, rfl⟩ := Int.le.dest hst
  induction k generalizing n with
  | zero => exact ⟨n, by simp⟩
  | succ k ih =>
    obtain ⟨l, hl⟩ := dyadicGridCell_parent G (s + k) n
    obtain ⟨m, hm⟩ := ih l (by omega)
    refine ⟨m, ?_⟩
    have he : s + (k + 1 : ℕ) = (s + (k : ℤ)) + 1 := by omega
    rw [he]
    exact hl.trans hm

theorem dyadicGridCell_nested_or_disjoint_of_le (G : RealDyadicGrid)
    {s t : ℤ} (hst : s ≤ t) (m n : ℤ) :
    Disjoint (dyadicGridCell G s m) (dyadicGridCell G t n) ∨
      dyadicGridCell G t n ⊆ dyadicGridCell G s m := by
  obtain ⟨p, hp⟩ := dyadicGridCell_ancestor G hst n
  by_cases hpm : p = m
  · exact Or.inr (hpm ▸ hp)
  · exact Or.inl ((dyadicGridCell_pairwiseDisjoint G s (fun h => hpm h.symm)).mono_right hp)

/-- Source dyadic cells are laminar: intersecting cells are nested. -/
theorem dyadicGridCell_laminar (G : RealDyadicGrid) (c d : ℤ × ℤ) :
    Disjoint (dyadicGridCell G c.1 c.2) (dyadicGridCell G d.1 d.2) ∨
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 ∨
      dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G c.1 c.2 := by
  rcases le_total c.1 d.1 with h | h
  · rcases dyadicGridCell_nested_or_disjoint_of_le G h c.2 d.2 with hd | hs
    · exact Or.inl hd
    · exact Or.inr (Or.inr hs)
  · rcases dyadicGridCell_nested_or_disjoint_of_le G h d.2 c.2 with hd | hs
    · exact Or.inl hd.symm
    · exact Or.inr (Or.inl hs)

theorem dyadicGridLength_strictAnti (G : RealDyadicGrid) : StrictAnti (dyadicGridLength G) := by
  intro s t hst
  apply mul_lt_mul_of_pos_left _ G.baseLength_pos
  exact zpow_lt_zpow_right₀ (by norm_num : (1 : ℝ) < 2) (by omega : -t < -s)

theorem dyadicGridCell_injective (G : RealDyadicGrid) :
    Function.Injective (fun c : ℤ × ℤ => dyadicGridCell G c.1 c.2) := by
  intro c d h
  have hv := congrArg (fun I : Set ℝ => (volume I).toReal) h
  simp only [dyadicGridCell_volume,
    ENNReal.toReal_ofReal (dyadicGridLength_pos G _).le] at hv
  have hs := (dyadicGridLength_strictAnti G).injective hv
  have hx := dyadicGridCell_left_mem G c.1 c.2
  have hy : dyadicGridLeft G c.1 c.2 ∈ dyadicGridCell G c.1 d.2 := by
    have hy0 : dyadicGridLeft G c.1 c.2 ∈ dyadicGridCell G d.1 d.2 := by
      change dyadicGridCell G c.1 c.2 = dyadicGridCell G d.1 d.2 at h
      rw [← h]
      exact hx
    simpa only [← hs] using hy0
  exact Prod.ext hs (dyadicGridCell_sameDepth_common_point G c.1 c.2 d.2 hx hy)

/-- Distinct maximal cells are disjoint, the geometric fact used by the
first-crossing cost estimate in `lem:cuts`. -/
theorem maximalDyadicCells_pairwiseDisjoint (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) :
    Set.PairwiseDisjoint (maximalDyadicCells G S : Set (ℤ × ℤ))
      (fun c => dyadicGridCell G c.1 c.2) := by
  classical
  intro c hc d hd hne
  rcases dyadicGridCell_laminar G c d with hdis | hcd | hdc
  · exact hdis
  · have hdc := (Finset.mem_filter.mp hc).2 d (maximalDyadicCells_subset G S hd) hcd
    exact (hne (dyadicGridCell_injective G (Set.Subset.antisymm hcd hdc))).elim
  · have hcd := (Finset.mem_filter.mp hd).2 c (maximalDyadicCells_subset G S hc) hdc
    exact (hne (dyadicGridCell_injective G (Set.Subset.antisymm hcd hdc))).elim

open scoped Classical in
/-- Sum of original data on ancestors, including the current cell. -/
noncomputable def dyadicAncestorSum (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (c : ℤ × ℤ) : ℝ :=
  ∑ d ∈ S.filter (fun d => dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2), a d

open scoped Classical in
noncomputable def dyadicBadCells (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) : Finset (ℤ × ℤ) :=
  S.filter (fun c => T < dyadicAncestorSum G S a c)

/-- First crossings are maximal violating cells; the violating value is
excluded before its summand is included in the retained family. -/
noncomputable def dyadicFirstCrossings (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) : Finset (ℤ × ℤ) :=
  maximalDyadicCells G (dyadicBadCells G S a T)

open scoped Classical in
noncomputable def dyadicRetainedCells (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) : Finset (ℤ × ℤ) :=
  S.filter (fun c => dyadicAncestorSum G S a c ≤ T)

theorem dyadicAncestorSum_nonneg (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (c : ℤ × ℤ) :
    0 ≤ dyadicAncestorSum G S a c := by
  classical
  exact Finset.sum_nonneg (fun d hd => ha d (Finset.mem_filter.mp hd).1)

theorem dyadicAncestorSum_mono (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) {c d : ℤ × ℤ}
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) :
    dyadicAncestorSum G S a d ≤ dyadicAncestorSum G S a c := by
  classical
  apply Finset.sum_le_sum_of_subset_of_nonneg
  · intro e he
    obtain ⟨heS, hde⟩ := Finset.mem_filter.mp he
    exact Finset.mem_filter.mpr ⟨heS, hcd.trans hde⟩
  · intro e he _
    exact ha e (Finset.mem_filter.mp he).1

theorem dyadicFirstCrossings_mem (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) {c : ℤ × ℤ} (hc : c ∈ dyadicFirstCrossings G S a T) :
    c ∈ S ∧ T < dyadicAncestorSum G S a c := by
  classical
  exact Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)

theorem dyadicBadCells_downward (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (T : ℝ)
    {c d : ℤ × ℤ} (hc : c ∈ S) (hd : d ∈ dyadicBadCells G S a T)
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) :
    c ∈ dyadicBadCells G S a T := by
  classical
  refine Finset.mem_filter.mpr ⟨hc, ?_⟩
  exact (Finset.mem_filter.mp hd).2.trans_le (dyadicAncestorSum_mono G S a ha hcd)

/-- Removing a first crossing removes exactly its cell and all original
descendant summands. The data on earlier ancestors are left unchanged. -/
theorem dyadicRetainedCells_iff (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (T : ℝ) (c : ℤ × ℤ) :
    c ∈ dyadicRetainedCells G S a T ↔ c ∈ S ∧
      ¬∃ d ∈ dyadicFirstCrossings G S a T,
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  classical
  constructor
  · intro hc
    obtain ⟨hcS, hcT⟩ := Finset.mem_filter.mp hc
    refine ⟨hcS, ?_⟩
    rintro ⟨d, hd, hcd⟩
    have hdT := (dyadicFirstCrossings_mem G S a T hd).2
    exact (not_lt_of_ge hcT) (hdT.trans_le (dyadicAncestorSum_mono G S a ha hcd))
  · rintro ⟨hc, hno⟩
    apply Finset.mem_filter.mpr
    refine ⟨hc, le_of_not_gt ?_⟩
    intro hbad
    have hcB : c ∈ dyadicBadCells G S a T := Finset.mem_filter.mpr ⟨hc, hbad⟩
    exact hno (maximalDyadicCells_covers G _ hcB)

theorem dyadicFirstCrossings_pairwiseDisjoint (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (T : ℝ) :
    Set.PairwiseDisjoint (dyadicFirstCrossings G S a T : Set (ℤ × ℤ))
      (fun c => dyadicGridCell G c.1 c.2) :=
  maximalDyadicCells_pairwiseDisjoint G _

noncomputable def dyadicWeightedMass (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) : ℝ := ∑ c ∈ S, dyadicGridLength G c.1 * a c

theorem dyadicWeightedMass_nonneg (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) : 0 ≤ dyadicWeightedMass G S a :=
  Finset.sum_nonneg (fun c hc => mul_nonneg (dyadicGridLength_pos G c.1).le (ha c hc))

theorem dyadicWeightedMass_ofReal (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) :
    ENNReal.ofReal (dyadicWeightedMass G S a) =
      ∑ c ∈ S, ENNReal.ofReal (dyadicGridLength G c.1) * ENNReal.ofReal (a c) := by
  unfold dyadicWeightedMass
  rw [ENNReal.ofReal_sum_of_nonneg (fun c hc =>
    mul_nonneg (dyadicGridLength_pos G c.1).le (ha c hc))]
  exact Finset.sum_congr rfl (fun c _ => ENNReal.ofReal_mul (dyadicGridLength_pos G c.1).le)

theorem dyadicAncestorSum_le_path (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) {c : ℤ × ℤ} {x : ℝ}
    (hx : x ∈ dyadicGridCell G c.1 c.2) :
    ENNReal.ofReal (dyadicAncestorSum G S a c) ≤
      dyadicPathSum G S (fun d => ENNReal.ofReal (a d)) x := by
  classical
  unfold dyadicAncestorSum dyadicPathSum
  rw [ENNReal.ofReal_sum_of_nonneg (fun d hd => ha d (Finset.mem_filter.mp hd).1),
    Finset.sum_filter]
  apply Finset.sum_le_sum
  intro d _
  split_ifs with hcd
  · rw [Set.indicator_of_mem (hcd hx)]
  · exact bot_le

/-- Integrating over the disjoint first crossings proves the Markov cost
estimate before division by the positive crossing threshold. -/
theorem dyadicFirstCrossings_weighted_cost (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (R : Set ℝ)
    (hR : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ R) {T : ℝ} (hT : 0 ≤ T) :
    T * dyadicRootLength G (dyadicFirstCrossings G S a T) ≤ dyadicWeightedMass G S a := by
  classical
  let C := dyadicFirstCrossings G S a T
  let f := dyadicPathSum G S (fun d => ENNReal.ofReal (a d))
  have hpoint (c) (hc : c ∈ C) (x) (hx : x ∈ dyadicGridCell G c.1 c.2) :
      ENNReal.ofReal T ≤ f x :=
    (ENNReal.ofReal_le_ofReal (dyadicFirstCrossings_mem G S a T hc).2.le).trans
      (dyadicAncestorSum_le_path G S a ha hx)
  have hsub : (⋃ c ∈ C, dyadicGridCell G c.1 c.2) ⊆ R := by
    intro x hx
    obtain ⟨c, hxc⟩ := Set.mem_iUnion.mp hx
    obtain ⟨hc, hx⟩ := Set.mem_iUnion.mp hxc
    exact hR c (dyadicFirstCrossings_mem G S a T hc).1 hx
  apply (ENNReal.ofReal_le_ofReal_iff (dyadicWeightedMass_nonneg G S a ha)).mp
  calc
    _ = ∑ c ∈ C, ENNReal.ofReal T * ENNReal.ofReal (dyadicGridLength G c.1) := by
      rw [ENNReal.ofReal_mul hT]
      change ENNReal.ofReal T * ENNReal.ofReal (∑ c ∈ C, dyadicGridLength G c.1) = _
      rw [ENNReal.ofReal_sum_of_nonneg (fun c _ => (dyadicGridLength_pos G c.1).le),
        Finset.mul_sum]
    _ = ∑ c ∈ C, ∫⁻ _x in dyadicGridCell G c.1 c.2, ENNReal.ofReal T := by
      apply Finset.sum_congr rfl
      intro c _
      rw [setLIntegral_const, dyadicGridCell_volume]
    _ ≤ ∑ c ∈ C, ∫⁻ x in dyadicGridCell G c.1 c.2, f x :=
      Finset.sum_le_sum (fun c hc =>
        setLIntegral_mono' (dyadicGridCell_measurable G c.1 c.2) (hpoint c hc))
    _ = ∫⁻ x in ⋃ c ∈ C, dyadicGridCell G c.1 c.2, f x :=
      (lintegral_biUnion_finset (dyadicFirstCrossings_pairwiseDisjoint G S a T)
        (fun c _ => dyadicGridCell_measurable G c.1 c.2) f).symm
    _ ≤ ∫⁻ x in R, f x := lintegral_mono_set hsub
    _ = _ := by rw [← dyadicPathIntegral G S _ R hR, ← dyadicWeightedMass_ofReal G S a ha]

theorem dyadicWeights_zero_of_mass_nonpos (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (hW : dyadicWeightedMass G S a ≤ 0) :
    ∀ c ∈ S, a c = 0 := by
  intro c hc
  have hterm : dyadicGridLength G c.1 * a c ≤ dyadicWeightedMass G S a :=
    Finset.single_le_sum (fun d hd => mul_nonneg (dyadicGridLength_pos G d.1).le (ha d hd)) hc
  have hp := dyadicGridLength_pos G c.1
  have hac := ha c hc
  nlinarith

theorem dyadicAncestorSum_zero_of_mass_nonpos (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (hW : dyadicWeightedMass G S a ≤ 0)
    (c : ℤ × ℤ) : dyadicAncestorSum G S a c = 0 := by
  classical
  exact Finset.sum_eq_zero (fun d hd => dyadicWeights_zero_of_mass_nonpos G S a ha hW d
    (Finset.mem_filter.mp hd).1)

/-- Blueprint `lem:cuts`, first assertion: first crossings of `A/ρ` cost
at most `ρ` times the root length, including the zero-energy case. -/
theorem dyadicFirstCrossings_cost (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (root : ℤ × ℤ)
    (hroot : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {A ρ : ℝ} (hρ : 0 < ρ) (_hρ1 : ρ < 1)
    (hW : dyadicWeightedMass G S a ≤ A * dyadicGridLength G root.1) :
    dyadicRootLength G (dyadicFirstCrossings G S a (A / ρ)) ≤
      ρ * dyadicGridLength G root.1 := by
  classical
  have hL := dyadicGridLength_pos G root.1
  have hmass := dyadicWeightedMass_nonneg G S a ha
  have hA : 0 ≤ A := by nlinarith
  by_cases hz : A = 0
  · have hW0 : dyadicWeightedMass G S a ≤ 0 := by simpa only [hz, zero_mul] using hW
    have hC : dyadicFirstCrossings G S a (A / ρ) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro c hc
      have hb := (dyadicFirstCrossings_mem G S a (A / ρ) hc).2
      rw [dyadicAncestorSum_zero_of_mass_nonpos G S a ha hW0 c, hz, zero_div] at hb
      exact lt_irrefl _ hb
    rw [hC]
    simp only [dyadicRootLength, Finset.sum_empty]
    exact mul_nonneg hρ.le hL.le
  · have hAp : 0 < A := lt_of_le_of_ne hA (Ne.symm hz)
    have hT : 0 < A / ρ := div_pos hAp hρ
    have hc := dyadicFirstCrossings_weighted_cost G S a ha _ hroot hT.le
    apply (mul_le_mul_iff_right₀ hT).mp
    calc
      _ ≤ A * dyadicGridLength G root.1 := hc.trans hW
      _ = (A / ρ) * (ρ * dyadicGridLength G root.1) := by field_simp

open scoped Classical in
/-- Real-valued path sum of the original cell weights. -/
noncomputable def dyadicRealPathSum (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (x : ℝ) : ℝ :=
  ∑ c ∈ S.filter (fun c => x ∈ dyadicGridCell G c.1 c.2), a c

/-- Blueprint `lem:cuts`, first assertion: the retained path sum is bounded
at every point, including points below a removed first-crossing cell. -/
theorem dyadicRetainedPathSum_le (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) {T : ℝ} (hT : 0 ≤ T) (x : ℝ) :
    dyadicRealPathSum G (dyadicRetainedCells G S a T) a x ≤ T := by
  classical
  let U := (dyadicRetainedCells G S a T).filter
    (fun c => x ∈ dyadicGridCell G c.1 c.2)
  change ∑ c ∈ U, a c ≤ T
  by_cases hU : U.Nonempty
  · obtain ⟨c, hc, hmax⟩ := Finset.exists_max_image U (fun c => c.1) hU
    obtain ⟨hcR, hxc⟩ := Finset.mem_filter.mp hc
    obtain ⟨_, hcT⟩ := Finset.mem_filter.mp hcR
    apply le_trans _ hcT
    change ∑ d ∈ U, a d ≤ ∑ d ∈ S.filter
      (fun d => dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2), a d
    apply Finset.sum_le_sum_of_subset_of_nonneg
    · intro d hd
      obtain ⟨hdR, hxd⟩ := Finset.mem_filter.mp hd
      refine Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hdR).1, ?_⟩
      rcases dyadicGridCell_nested_or_disjoint_of_le G (hmax d hd) d.2 c.2 with hdis | hsub
      · exact (Set.disjoint_left.mp hdis hxd hxc).elim
      · exact hsub
    · intro d hd _
      exact ha d (Finset.mem_filter.mp hd).1
  · rw [Finset.not_nonempty_iff_eq_empty.mp hU, Finset.sum_empty]
    exact hT

/-- Blueprint `lem:cuts`, complete first assertion with the specified
first-crossing family and the everywhere retained bound. -/
theorem dyadicFirstCrossingCuts (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (a : ℤ × ℤ → ℝ) (ha : ∀ c ∈ S, 0 ≤ a c) (root : ℤ × ℤ)
    (hroot : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {A ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hW : dyadicWeightedMass G S a ≤ A * dyadicGridLength G root.1) :
    dyadicRootLength G (dyadicFirstCrossings G S a (A / ρ)) ≤
        ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, dyadicRealPathSum G (dyadicRetainedCells G S a (A / ρ)) a x ≤ A / ρ := by
  have hmass := dyadicWeightedMass_nonneg G S a ha
  have hL := dyadicGridLength_pos G root.1
  have hA : 0 ≤ A := by nlinarith
  exact ⟨dyadicFirstCrossings_cost G S a ha root hroot hρ hρ1 hW,
    dyadicRetainedPathSum_le G S a ha (div_nonneg hA hρ.le)⟩

/-- Average of a nonnegative energy density on a dyadic cell. -/
noncomputable def dyadicEnergyAverage (G : RealDyadicGrid) (g : ℝ → ℝ≥0∞)
    (c : ℤ × ℤ) : ℝ≥0∞ :=
  (∫⁻ x in dyadicGridCell G c.1 c.2, g x) / ENNReal.ofReal (dyadicGridLength G c.1)

open scoped Classical in
/-- Full squared hull maximum, with value zero for an empty hull. The
energy density is fixed, independently of any later stopping cells. -/
noncomputable def dyadicHullMax (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (x : ℝ) : ℝ≥0∞ :=
  S.sup (fun c => (dyadicGridCell G c.1 c.2).indicator
    (fun _ => dyadicEnergyAverage G g c) x)

theorem dyadicHullMax_measurable (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) : Measurable (dyadicHullMax G S g) := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    change Measurable (fun x : ℝ => (∅ : Finset (ℤ × ℤ)).sup _)
    simp only [Finset.sup_empty]
    exact measurable_const
  | @insert c S hc ih =>
    change Measurable (fun x => (insert c S).sup _)
    simp only [Finset.sup_insert]
    exact (measurable_const.indicator (dyadicGridCell_measurable G c.1 c.2)).sup ih

/-- A positive superlevel set is exactly the union of hull cells whose
fixed energy averages exceed the level. -/
theorem dyadicHullMax_superlevel (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (t : ℝ≥0∞) :
    {x | t < dyadicHullMax G S g x} =
      ⋃ c ∈ S.filter (fun c => t < dyadicEnergyAverage G g c), dyadicGridCell G c.1 c.2 := by
  classical
  ext x
  simp only [Set.mem_ofPred_eq, dyadicHullMax, Finset.lt_sup_iff, Set.mem_iUnion,
    Finset.mem_filter]
  constructor
  · rintro ⟨c, hc, hlt⟩
    by_cases hx : x ∈ dyadicGridCell G c.1 c.2
    · exact ⟨c, ⟨hc, by simpa only [Set.indicator_of_mem hx] using hlt⟩, hx⟩
    · simp only [Set.indicator_of_notMem hx] at hlt
      exact (not_lt_of_ge bot_le hlt).elim
  · rintro ⟨c, ⟨hc, hlt⟩, hx⟩
    exact ⟨c, hc, by simpa only [Set.indicator_of_mem hx] using hlt⟩

/-- Blueprint `lem:cuts`, lines 453–457: the finite dyadic hull maximal
operator has weak (1,1) constant one, even for extended-valued densities. -/
theorem dyadicHullMax_weak (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ R) (t : ℝ≥0∞) :
    t * volume {x | t < dyadicHullMax G S g x} ≤ ∫⁻ x in R, g x := by
  classical
  let B := S.filter (fun c => t < dyadicEnergyAverage G g c)
  let C := maximalDyadicCells G B
  have hCS (c) (hc : c ∈ C) : c ∈ S :=
    (Finset.mem_filter.mp (maximalDyadicCells_subset G B hc)).1
  have hsub : (⋃ c ∈ C, dyadicGridCell G c.1 c.2) ⊆ R := by
    intro x hx
    obtain ⟨c, hc, hx⟩ := Set.mem_iUnion₂.mp hx
    exact hR c (hCS c hc) hx
  have hcell (c) (hc : c ∈ C) :
      t * ENNReal.ofReal (dyadicGridLength G c.1) ≤
        ∫⁻ x in dyadicGridCell G c.1 c.2, g x := by
    have hav := (Finset.mem_filter.mp (maximalDyadicCells_subset G B hc)).2.le
    exact (ENNReal.le_div_iff_mul_le
      (Or.inl (ne_of_gt (ENNReal.ofReal_pos.mpr (dyadicGridLength_pos G c.1))))
      (Or.inl ENNReal.ofReal_ne_top)).mp hav
  rw [dyadicHullMax_superlevel, ← maximalDyadicCells_union G B]
  change t * volume (⋃ c ∈ C, dyadicGridCell G c.1 c.2) ≤ _
  calc
    _ = ∫⁻ _x in ⋃ c ∈ C, dyadicGridCell G c.1 c.2, t := (setLIntegral_const _ _).symm
    _ = ∑ c ∈ C, ∫⁻ _x in dyadicGridCell G c.1 c.2, t :=
      lintegral_biUnion_finset (maximalDyadicCells_pairwiseDisjoint G B)
        (fun c _ => dyadicGridCell_measurable G c.1 c.2) _
    _ ≤ ∑ c ∈ C, ∫⁻ x in dyadicGridCell G c.1 c.2, g x := by
      apply Finset.sum_le_sum
      intro c hc
      simpa only [setLIntegral_const, dyadicGridCell_volume] using hcell c hc
    _ = ∫⁻ x in ⋃ c ∈ C, dyadicGridCell G c.1 c.2, g x :=
      (lintegral_biUnion_finset (maximalDyadicCells_pairwiseDisjoint G B)
        (fun c _ => dyadicGridCell_measurable G c.1 c.2) g).symm
    _ ≤ _ := lintegral_mono_set hsub

/-- The hull maximum vanishes outside the union of its maximal cells. -/
theorem dyadicHullMax_support_bound (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (t : ℝ≥0∞) :
    volume {x | t < dyadicHullMax G S g x} ≤
      volume (⋃ c ∈ maximalDyadicCells G S, dyadicGridCell G c.1 c.2) := by
  classical
  rw [dyadicHullMax_superlevel, maximalDyadicCells_union]
  apply measure_mono
  intro x hx
  obtain ⟨c, hc, hx⟩ := Set.mem_iUnion₂.mp hx
  exact Set.mem_iUnion₂.mpr ⟨c, (Finset.mem_filter.mp hc).1, hx⟩

/-- Blueprint `lem:cuts`, displayed distribution estimate at lines 454–457.
The sum of the hull superlevel measures obeys both the support and energy
bounds, with absolute weak-type constant one. -/
theorem dyadicHullMax_distribution {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ ν ∈ V, ∀ c ∈ S ν, dyadicGridCell G c.1 c.2 ⊆ R)
    {E M t : ℝ≥0∞} (ht0 : t ≠ 0) (htop : t ≠ ∞)
    (hE : ∑ ν ∈ V, ∫⁻ x in R, g ν x ≤ E * volume R)
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (S ν),
      dyadicGridCell G c.1 c.2) ≤ M * volume R) :
    ∑ ν ∈ V, volume {x | t < dyadicHullMax G (S ν) (g ν) x} ≤
      min (M * volume R) (E * volume R / t) := by
  apply le_min
  · exact (Finset.sum_le_sum (fun ν _ => dyadicHullMax_support_bound G (S ν) (g ν) t)).trans hM
  · apply (ENNReal.le_div_iff_mul_le (Or.inl ht0) (Or.inl htop)).mpr
    rw [mul_comm, Finset.mul_sum]
    exact (Finset.sum_le_sum (fun ν hν => dyadicHullMax_weak G (S ν) (g ν) R
      (hR ν hν) t)).trans hE

/-- Layer cake for a bounded nonnegative real function, with the level
integral restricted to its finite range. -/
theorem bounded_layercake {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (f : α → ℝ) (hf : Measurable f) {T : ℝ} (hT : 0 ≤ T)
    (hf0 : ∀ x, 0 ≤ f x) (hfT : ∀ x, f x ≤ T) :
    ∫⁻ x, ENNReal.ofReal (f x) ∂μ =
      ∫⁻ t in Set.Ioc 0 T, μ {x | t < f x} := by
  rw [lintegral_eq_lintegral_meas_lt μ (Filter.Eventually.of_forall hf0) hf.aemeasurable,
    ← Set.Ioc_union_Ioi_eq_Ioi hT, lintegral_union measurableSet_Ioi Set.Ioc_disjoint_Ioi_same]
  have hz : (∫⁻ t in Set.Ioi T, μ {x | t < f x}) = 0 := by
    calc
      _ = ∫⁻ _t in Set.Ioi T, (0 : ℝ≥0∞) := by
        apply setLIntegral_congr_fun measurableSet_Ioi
        intro t ht
        have he : {x | t < f x} = ∅ := by
          ext x
          simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
          exact not_lt_of_ge ((hfT x).trans ht.le)
        change μ {x | t < f x} = 0
        rw [he, measure_empty]
      _ = 0 := by simp
  rw [hz, add_zero]

/-- The reciprocal tail in the weak (1,1) distribution integral gives the
logarithm in blueprint `lem:cuts`, lines 458–462. -/
theorem lintegral_ofReal_reciprocal {a T E : ℝ} (ha : 0 < a) (haT : a ≤ T)
    (hE : 0 ≤ E) :
    ∫⁻ t in Set.Ioc a T, ENNReal.ofReal (E / t) =
      ENNReal.ofReal (E * Real.log (T / a)) := by
  have hc : ContinuousOn (fun t : ℝ => E / t) (Set.Icc a T) :=
    continuousOn_const.div continuousOn_id (fun t ht => ne_of_gt (ha.trans_le ht.1))
  have hi : IntegrableOn (fun t : ℝ => E / t) (Set.Ioc a T) :=
    hc.integrableOn_Icc.mono_set Set.Ioc_subset_Icc_self
  rw [← ofReal_integral_eq_lintegral_ofReal hi]
  · rw [← intervalIntegral.integral_of_le haT]
    simp only [div_eq_mul_inv, intervalIntegral.integral_const_mul,
      integral_inv_of_pos ha (ha.trans_le haT)]
  · exact (ae_restrict_iff' measurableSet_Ioc).mpr
      (Filter.Eventually.of_forall (fun t ht => div_nonneg hE (ha.le.trans ht.1.le)))

/-- Integrating a distribution bounded by `min(M,E/t)` up to `T` gives
the logarithmic truncation bound used in `lem:cuts`. -/
theorem weak_distribution_log_integral (F : ℝ → ℝ≥0∞) {E M T : ℝ}
    (hE : 0 < E) (hM : 0 < M) (hT : 0 ≤ T)
    (hsupport : ∀ t, 0 < t → F t ≤ ENNReal.ofReal M)
    (hweak : ∀ t, 0 < t → F t ≤ ENNReal.ofReal (E / t)) :
    ∫⁻ t in Set.Ioc 0 T, F t ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  let a := E / M
  have ha : 0 < a := div_pos hE hM
  have hMa : M * a = E := mul_div_cancel₀ E (ne_of_gt hM)
  have hratio : 0 ≤ M * T / E := div_nonneg (mul_nonneg hM.le hT) hE.le
  have hlog : 0 ≤ Real.log (2 + M * T / E) := Real.log_nonneg (by linarith)
  have hlow (b : ℝ) (hb : 0 ≤ b) :
      (∫⁻ t in Set.Ioc 0 b, F t) ≤ ENNReal.ofReal (M * b) := by
    calc
      _ ≤ ∫⁻ _t in Set.Ioc 0 b, ENNReal.ofReal M :=
        setLIntegral_mono' measurableSet_Ioc (fun t ht => hsupport t ht.1)
      _ = _ := by rw [setLIntegral_const, Real.volume_Ioc, sub_zero, ENNReal.ofReal_mul hM.le]
  by_cases hTa : T ≤ a
  · apply (hlow T hT).trans
    apply ENNReal.ofReal_le_ofReal
    have hMT : M * T ≤ E := by nlinarith
    nlinarith
  · have haT : a ≤ T := le_of_not_ge hTa
    have hhigh : (∫⁻ t in Set.Ioc a T, F t) ≤ ENNReal.ofReal (E * Real.log (T / a)) := by
      calc
        _ ≤ ∫⁻ t in Set.Ioc a T, ENNReal.ofReal (E / t) :=
          setLIntegral_mono' measurableSet_Ioc (fun t ht => hweak t (ha.trans ht.1))
        _ = _ := lintegral_ofReal_reciprocal ha haT hE.le
    rw [← Set.Ioc_union_Ioc_eq_Ioc ha.le haT,
      lintegral_union measurableSet_Ioc (Set.Ioc_disjoint_Ioc_of_le le_rfl)]
    calc
      _ ≤ ENNReal.ofReal (M * a) + ENNReal.ofReal (E * Real.log (T / a)) :=
        add_le_add (hlow a ha.le) hhigh
      _ = ENNReal.ofReal (E * (1 + Real.log (T / a))) := by
        rw [hMa, ← ENNReal.ofReal_add hE.le
          (mul_nonneg hE.le (Real.log_nonneg ((le_div_iff₀ ha).mpr (by simpa using haT))))]
        congr 1
        ring
      _ ≤ _ := by
        apply ENNReal.ofReal_le_ofReal
        have hr : T / a = M * T / E := by dsimp [a]; field_simp
        have hl : Real.log (T / a) ≤ Real.log (2 + M * T / E) :=
          Real.log_le_log (div_pos (ha.trans_le haT) ha) (by rw [hr]; linarith)
        nlinarith

theorem weak_distribution_log_integral_nonneg (F : ℝ → ℝ≥0∞) {E M T : ℝ}
    (hE : 0 ≤ E) (hM : 0 ≤ M) (hT : 0 ≤ T)
    (hsupport : ∀ t, 0 < t → F t ≤ ENNReal.ofReal M)
    (hweak : ∀ t, 0 < t → F t ≤ ENNReal.ofReal (E / t)) :
    ∫⁻ t in Set.Ioc 0 T, F t ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  by_cases hEp : 0 < E
  · by_cases hMp : 0 < M
    · exact weak_distribution_log_integral F hEp hMp hT hsupport hweak
    · have hMz : M = 0 := le_antisymm (le_of_not_gt hMp) hM
      have hz : (∫⁻ t in Set.Ioc 0 T, F t) ≤ 0 := by
        calc
          _ ≤ ∫⁻ _t in Set.Ioc 0 T, (0 : ℝ≥0∞) :=
            setLIntegral_mono' measurableSet_Ioc (fun t ht => by simpa [hMz] using hsupport t ht.1)
          _ = 0 := by simp
      exact hz.trans bot_le
  · have hEz : E = 0 := le_antisymm (le_of_not_gt hEp) hE
    have hz : (∫⁻ t in Set.Ioc 0 T, F t) ≤ 0 := by
      calc
        _ ≤ ∫⁻ _t in Set.Ioc 0 T, (0 : ℝ≥0∞) :=
          setLIntegral_mono' measurableSet_Ioc (fun t ht => by simpa [hEz] using hweak t ht.1)
        _ = 0 := by simp
    exact hz.trans bot_le

/-- Finite-family layer cake and the weak/support distribution bounds yield
a logarithmic integral estimate, including zero energy and zero support. -/
theorem finite_family_log_integral {α ι : Type*} [MeasurableSpace α]
    (μ : Measure α) (V : Finset ι) (f : ι → α → ℝ)
    (hf : ∀ ν ∈ V, Measurable (f ν)) {E M T : ℝ}
    (hE : 0 ≤ E) (hM : 0 ≤ M) (hT : 0 ≤ T)
    (hf0 : ∀ ν ∈ V, ∀ x, 0 ≤ f ν x) (hfT : ∀ ν ∈ V, ∀ x, f ν x ≤ T)
    (hsupport : ∀ t, 0 < t → ∑ ν ∈ V, μ {x | t < f ν x} ≤ ENNReal.ofReal M)
    (hweak : ∀ t, 0 < t → ∑ ν ∈ V, μ {x | t < f ν x} ≤ ENNReal.ofReal (E / t)) :
    ∑ ν ∈ V, ∫⁻ x, ENNReal.ofReal (f ν x) ∂μ ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  calc
    _ = ∑ ν ∈ V, ∫⁻ t in Set.Ioc 0 T, μ {x | t < f ν x} :=
      Finset.sum_congr rfl (fun ν hν => bounded_layercake μ (f ν) (hf ν hν) hT
        (hf0 ν hν) (hfT ν hν))
    _ = ∫⁻ t in Set.Ioc 0 T, ∑ ν ∈ V, μ {x | t < f ν x} := by
      symm
      apply lintegral_finsetSum
      intro ν _
      exact Antitone.measurable (fun s t hst => measure_mono (fun x hx => hst.trans_lt hx))
    _ ≤ _ := weak_distribution_log_integral_nonneg _ hE hM hT hsupport hweak

/-- Logarithmic integral estimate for a finite family of truncated
extended-valued maxima from their summed distribution bound. -/
theorem truncated_family_log_integral {α ι : Type*} [MeasurableSpace α]
    (μ : Measure α) (V : Finset ι) (m : ι → α → ℝ≥0∞)
    (hm : ∀ ν ∈ V, Measurable (m ν)) {E M T : ℝ}
    (hE : 0 ≤ E) (hM : 0 ≤ M) (hT : 0 ≤ T)
    (hdist : ∀ t, 0 < t → ∑ ν ∈ V, μ {x | ENNReal.ofReal t < m ν x} ≤
      min (ENNReal.ofReal M) (ENNReal.ofReal (E / t))) :
    ∑ ν ∈ V, ∫⁻ x, min (m ν x) (ENNReal.ofReal T) ∂μ ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  let f := fun ν x => (min (m ν x) (ENNReal.ofReal T)).toReal
  have hfin (ν) (x) : min (m ν x) (ENNReal.ofReal T) ≠ ∞ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (min_le_right _ _)
  have hsub (ν) (t : ℝ) (ht : 0 < t) :
      {x | t < f ν x} ⊆ {x | ENNReal.ofReal t < m ν x} := by
    intro x hx
    exact ((ENNReal.ofReal_lt_iff_lt_toReal ht.le (hfin ν x)).mpr hx).trans_le (min_le_left _ _)
  have hdis (t) (ht : 0 < t) : ∑ ν ∈ V, μ {x | t < f ν x} ≤
      min (ENNReal.ofReal M) (ENNReal.ofReal (E / t)) :=
    (Finset.sum_le_sum (fun ν _ => measure_mono (hsub ν t ht))).trans (hdist t ht)
  have hb := finite_family_log_integral μ V f
    (fun ν hν => ((hm ν hν).inf measurable_const).ennreal_toReal) hE hM hT
    (fun _ _ _ => ENNReal.toReal_nonneg)
    (fun _ _ _ => ENNReal.toReal_le_of_le_ofReal hT (min_le_right _ _))
    (fun t ht => (hdis t ht).trans (min_le_left _ _))
    (fun t ht => (hdis t ht).trans (min_le_right _ _))
  simpa only [f, ENNReal.ofReal_toReal (hfin _ _)] using hb

/-- Blueprint `lem:cuts`, lines 458–462: the sum of the integrals of
truncated fixed hull maxima is bounded logarithmically by total energy
and total hull support. This unnormalized form includes zero energy. -/
theorem dyadicHullMax_log_integral {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ ν ∈ V, ∀ c ∈ S ν, dyadicGridCell G c.1 c.2 ⊆ R)
    {E M T : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hT : 0 ≤ T)
    (hE : ∑ ν ∈ V, ∫⁻ x in R, g ν x ≤ ENNReal.ofReal E)
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (S ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal M) :
    ∑ ν ∈ V, ∫⁻ x, min (dyadicHullMax G (S ν) (g ν) x) (ENNReal.ofReal T) ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E))) := by
  apply truncated_family_log_integral volume V (fun ν => dyadicHullMax G (S ν) (g ν))
    (fun ν _ => dyadicHullMax_measurable G (S ν) (g ν)) hE0 hM0 hT
  intro t ht
  apply le_min
  · exact (Finset.sum_le_sum (fun ν _ =>
      dyadicHullMax_support_bound G (S ν) (g ν) (ENNReal.ofReal t))).trans hM
  · rw [ENNReal.ofReal_div_of_pos ht]
    apply (ENNReal.le_div_iff_mul_le
      (Or.inl (ne_of_gt (ENNReal.ofReal_pos.mpr ht))) (Or.inl ENNReal.ofReal_ne_top)).mpr
    rw [mul_comm, Finset.mul_sum]
    exact (Finset.sum_le_sum (fun ν hν =>
      dyadicHullMax_weak G (S ν) (g ν) R (hR ν hν) (ENNReal.ofReal t))).trans hE

/-- Root-normalized form of the logarithmic hull estimate in `lem:cuts`.
The estimate on the whole line also bounds its restriction to the root. -/
theorem dyadicHullMax_log_integral_normalized {ι : Type*} (V : Finset ι)
    (G : RealDyadicGrid) (S : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (root : ℤ × ℤ)
    (hR : ∀ ν ∈ V, ∀ c ∈ S ν, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M T : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hT : 0 ≤ T)
    (hE : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (S ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    ∑ ν ∈ V, ∫⁻ x, min (dyadicHullMax G (S ν) (g ν) x) (ENNReal.ofReal T) ≤
      ENNReal.ofReal (E * (1 + Real.log (2 + M * T / E)) * dyadicGridLength G root.1) := by
  have hL := dyadicGridLength_pos G root.1
  have hb := dyadicHullMax_log_integral V G S g _ hR (mul_nonneg hE0 hL.le)
    (mul_nonneg hM0 hL.le) hT hE hM
  have hr : M * dyadicGridLength G root.1 * T / (E * dyadicGridLength G root.1) = M * T / E := by
    rw [mul_right_comm M _ T, mul_div_mul_right _ _ (ne_of_gt hL)]
  rw [hr] at hb
  convert hb using 1
  congr 1
  ring

open scoped Classical in
/-- Partial squared hull maximum using only ancestors through the current
cell. All energy averages still use the original fixed function. -/
noncomputable def dyadicPartialHullMax (G : RealDyadicGrid) (H : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) (c : ℤ × ℤ) : ℝ≥0∞ :=
  H.sup (fun d => if dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2
    then dyadicEnergyAverage G g d else 0)

theorem dyadicPartialHullMax_mono (G : RealDyadicGrid) (H : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) {c d : ℤ × ℤ}
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) :
    dyadicPartialHullMax G H g d ≤ dyadicPartialHullMax G H g c := by
  classical
  apply Finset.sup_le
  intro e he
  by_cases hde : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G e.1 e.2
  · have hh := Finset.le_sup (f := fun e => if dyadicGridCell G c.1 c.2 ⊆
        dyadicGridCell G e.1 e.2 then dyadicEnergyAverage G g e else 0) he
    simpa only [dyadicPartialHullMax, ite_eq_left hde, ite_eq_left (hcd.trans hde)] using hh
  · simp only [ite_eq_right hde]
    exact bot_le

theorem dyadicPartialHullMax_le_full (G : RealDyadicGrid) (H : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) {c : ℤ × ℤ} {x : ℝ}
    (hx : x ∈ dyadicGridCell G c.1 c.2) :
    dyadicPartialHullMax G H g c ≤ dyadicHullMax G H g x := by
  classical
  apply Finset.sup_le
  intro d hd
  by_cases hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2
  · have hh := Finset.le_sup (f := fun d => (dyadicGridCell G d.1 d.2).indicator
        (fun _ => dyadicEnergyAverage G g d) x) hd
    simpa only [dyadicHullMax, ite_eq_left hcd, Set.indicator_of_mem (hcd hx)] using hh
  · simp only [ite_eq_right hcd]
    exact bot_le

theorem dyadicEnergyAverage_le_partial (G : RealDyadicGrid) (H : Finset (ℤ × ℤ))
    (g : ℝ → ℝ≥0∞) {c : ℤ × ℤ} (hc : c ∈ H) :
    dyadicEnergyAverage G g c ≤ dyadicPartialHullMax G H g c := by
  classical
  have hh := Finset.le_sup (f := fun d => if dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G d.1 d.2 then dyadicEnergyAverage G g d else 0) hc
  simpa only [dyadicPartialHullMax, ite_eq_left (Set.Subset.refl _)] using hh

/-- Before any individual threshold is crossed, the partial sum agrees
with its truncated version, as required by `lem:cuts`, line 463. -/
theorem dyadicPartialHullMax_sum_eq_truncated {ι : Type*} (V : Finset ι)
    (G : RealDyadicGrid) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (c : ℤ × ℤ) {T : ℝ≥0∞} (hT : ∀ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c ≤ T) :
    ∑ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c =
      ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T := by
  exact Finset.sum_congr rfl (fun ν hν => (min_eq_left (hT ν hν)).symm)

/-- A cell is good for both rules if no partial individual maximum exceeds
`T` and the sum of truncated partial maxima does not exceed `U`. -/
def dyadicHullGood {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (T U : ℝ≥0∞) (c : ℤ × ℤ) : Prop :=
  (∀ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c ≤ T) ∧
    ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T ≤ U

open scoped Classical in
/-- The combined first crossings, chosen as maximal cells violating at
least one of the two partial-max rules. -/
noncomputable def dyadicHullCuts {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (T U : ℝ≥0∞) : Finset (ℤ × ℤ) :=
  maximalDyadicCells G (S.filter (fun c => ¬dyadicHullGood V G H g T U c))

theorem dyadicHullGood_ancestor {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (T U : ℝ≥0∞)
    {c d : ℤ × ℤ} (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)
    (hc : dyadicHullGood V G H g T U c) : dyadicHullGood V G H g T U d := by
  refine ⟨fun ν hν => (dyadicPartialHullMax_mono G (H ν) (g ν) hcd).trans (hc.1 ν hν), ?_⟩
  exact (Finset.sum_le_sum (fun ν _ => min_le_min_right T
    (dyadicPartialHullMax_mono G (H ν) (g ν) hcd))).trans hc.2

theorem dyadicRootLength_ofReal_eq_volume (G : RealDyadicGrid) (C : Finset (ℤ × ℤ))
    (hC : Set.PairwiseDisjoint (C : Set (ℤ × ℤ)) (fun c => dyadicGridCell G c.1 c.2)) :
    ENNReal.ofReal (dyadicRootLength G C) = volume (⋃ c ∈ C, dyadicGridCell G c.1 c.2) := by
  rw [measure_biUnion_finset hC (fun c _ => dyadicGridCell_measurable G c.1 c.2)]
  unfold dyadicRootLength
  rw [ENNReal.ofReal_sum_of_nonneg (fun c _ => (dyadicGridLength_pos G c.1).le)]
  exact Finset.sum_congr rfl (fun c _ => (dyadicGridCell_volume G c.1 c.2).symm)

/-- Each removed cell lies on its entirety in the union of the full
individual superlevel sets or the full truncated-sum superlevel set. -/
theorem dyadicHullCuts_cover_bad {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (T U : ℝ≥0∞) :
    (⋃ c ∈ dyadicHullCuts V G S H g T U, dyadicGridCell G c.1 c.2) ⊆
      (⋃ ν ∈ V, {x | T < dyadicHullMax G (H ν) (g ν) x}) ∪
        {x | U < ∑ ν ∈ V, min (dyadicHullMax G (H ν) (g ν) x) T} := by
  classical
  intro x hx
  obtain ⟨c, hc, hxc⟩ := Set.mem_iUnion₂.mp hx
  have hbad := (Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)).2
  by_cases hind : ∀ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c ≤ T
  · apply Or.inr
    have hsum : U < ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T :=
      lt_of_not_ge (fun hs => hbad ⟨hind, hs⟩)
    exact hsum.trans_le (Finset.sum_le_sum (fun ν _ => min_le_min_right T
      (dyadicPartialHullMax_le_full G (H ν) (g ν) hxc)))
  · push Not at hind
    obtain ⟨ν, hν, hνT⟩ := hind
    exact Or.inl (Set.mem_iUnion₂.mpr ⟨ν, hν,
      hνT.trans_le (dyadicPartialHullMax_le_full G (H ν) (g ν) hxc)⟩)

/-- The combined first-crossing length is bounded by the individual weak
cost plus the truncated-sum Markov cost. This proves both stopping rules
in blueprint `lem:cuts`, lines 458 and 463–465, before choosing thresholds. -/
theorem dyadicHullCuts_cost {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (R : Set ℝ) (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ R)
    {E M T U : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hT : 0 < T) (hU : 0 < U)
    (hE : ∑ ν ∈ V, ∫⁻ x in R, g ν x ≤ ENNReal.ofReal E)
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal M) :
    dyadicRootLength G (dyadicHullCuts V G S H g (ENNReal.ofReal T) (ENNReal.ofReal U)) ≤
      E / T + E * (1 + Real.log (2 + M * T / E)) / U := by
  classical
  let B := E * (1 + Real.log (2 + M * T / E))
  have hB : 0 ≤ B := by
    have hr : 0 ≤ M * T / E := div_nonneg (mul_nonneg hM0 hT.le) hE0
    exact mul_nonneg hE0 (by have := Real.log_nonneg (by linarith : 1 ≤ 2 + M * T / E); linarith)
  let F := fun x => ∑ ν ∈ V, min (dyadicHullMax G (H ν) (g ν) x) (ENNReal.ofReal T)
  have hFm : Measurable F := Finset.measurable_sum V (fun ν _ =>
    (dyadicHullMax_measurable G (H ν) (g ν)).inf measurable_const)
  have hFI : (∫⁻ x, F x) ≤ ENNReal.ofReal B := by
    rw [show (∫⁻ x, F x) = ∑ ν ∈ V, ∫⁻ x,
      min (dyadicHullMax G (H ν) (g ν) x) (ENNReal.ofReal T) from
      lintegral_finsetSum V (fun ν _ =>
        (dyadicHullMax_measurable G (H ν) (g ν)).inf measurable_const)]
    exact dyadicHullMax_log_integral V G H g R hR hE0 hM0 hT.le hE hM
  have hi : ∑ ν ∈ V, volume {x | ENNReal.ofReal T < dyadicHullMax G (H ν) (g ν) x} ≤
      ENNReal.ofReal (E / T) := by
    rw [ENNReal.ofReal_div_of_pos hT]
    apply (ENNReal.le_div_iff_mul_le
      (Or.inl (ne_of_gt (ENNReal.ofReal_pos.mpr hT))) (Or.inl ENNReal.ofReal_ne_top)).mpr
    rw [mul_comm, Finset.mul_sum]
    exact (Finset.sum_le_sum (fun ν hν =>
      dyadicHullMax_weak G (H ν) (g ν) R (hR ν hν) (ENNReal.ofReal T))).trans hE
  have hs : volume {x | ENNReal.ofReal U < F x} ≤ ENNReal.ofReal (B / U) := by
    rw [ENNReal.ofReal_div_of_pos hU]
    calc
      _ ≤ volume {x | ENNReal.ofReal U ≤ F x} :=
        measure_mono (Set.ofPred_subset_ofPred.mpr (fun _ hx => le_of_lt hx))
      _ ≤ (∫⁻ x, F x) / ENNReal.ofReal U := meas_ge_le_lintegral_div hFm.aemeasurable
        (ne_of_gt (ENNReal.ofReal_pos.mpr hU)) ENNReal.ofReal_ne_top
      _ ≤ _ := ENNReal.div_le_div_right hFI _
  apply (ENNReal.ofReal_le_ofReal_iff
    (add_nonneg (div_nonneg hE0 hT.le) (div_nonneg hB hU.le))).mp
  have hC : Set.PairwiseDisjoint
      (dyadicHullCuts V G S H g (ENNReal.ofReal T) (ENNReal.ofReal U) : Set (ℤ × ℤ))
      (fun c => dyadicGridCell G c.1 c.2) := by
    unfold dyadicHullCuts
    exact maximalDyadicCells_pairwiseDisjoint G _
  rw [dyadicRootLength_ofReal_eq_volume G _ hC]
  calc
    _ ≤ volume ((⋃ ν ∈ V, {x | ENNReal.ofReal T < dyadicHullMax G (H ν) (g ν) x}) ∪
        {x | ENNReal.ofReal U < F x}) := measure_mono (dyadicHullCuts_cover_bad V G S H g _ _)
    _ ≤ volume (⋃ ν ∈ V, {x | ENNReal.ofReal T < dyadicHullMax G (H ν) (g ν) x}) +
        volume {x | ENNReal.ofReal U < F x} := measure_union_le _ _
    _ ≤ (∑ ν ∈ V, volume {x | ENNReal.ofReal T < dyadicHullMax G (H ν) (g ν) x}) +
        ENNReal.ofReal (B / U) := add_le_add (measure_biUnion_finset_le _ _) hs
    _ ≤ ENNReal.ofReal (E / T) + ENNReal.ofReal (B / U) := add_le_add hi le_rfl
    _ = _ := (ENNReal.ofReal_add (div_nonneg hE0 hT.le) (div_nonneg hB hU.le)).symm

theorem dyadicHullCuts_cost_normalized {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (root : ℤ × ℤ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M T U : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hT : 0 < T) (hU : 0 < U)
    (hE : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    dyadicRootLength G (dyadicHullCuts V G S H g (ENNReal.ofReal T) (ENNReal.ofReal U)) ≤
      (E / T + E * (1 + Real.log (2 + M * T / E)) / U) * dyadicGridLength G root.1 := by
  have hL := dyadicGridLength_pos G root.1
  have hb := dyadicHullCuts_cost V G S H g _ hR (mul_nonneg hE0 hL.le)
    (mul_nonneg hM0 hL.le) hT hU hE hM
  have hr : M * dyadicGridLength G root.1 * T / (E * dyadicGridLength G root.1) = M * T / E := by
    rw [mul_right_comm M _ T, mul_div_mul_right _ _ (ne_of_gt hL)]
  rw [hr] at hb
  exact hb.trans_eq (by ring)

/-- Explicit threshold choices allocate half the cut budget to each rule
in the positive-energy case of `lem:cuts`. -/
theorem dyadicHullCuts_cost_selected_pos {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (root : ℤ × ℤ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M ρ : ℝ} (hE0 : 0 < E) (hM0 : 0 ≤ M) (hρ : 0 < ρ)
    (hE : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    dyadicRootLength G (dyadicHullCuts V G S H g (ENNReal.ofReal (2 * E / ρ))
      (ENNReal.ofReal ((2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ))))) ≤
      ρ * dyadicGridLength G root.1 := by
  have hlog : 0 < 1 + Real.log (2 + 2 * M / ρ) := by
    have hr : 0 ≤ 2 * M / ρ := div_nonneg (by positivity) hρ.le
    have := Real.log_nonneg (by linarith : 1 ≤ 2 + 2 * M / ρ)
    linarith
  have hT : 0 < 2 * E / ρ := by positivity
  have hb := dyadicHullCuts_cost_normalized V G S H g root hR hE0.le hM0 hT
    (mul_pos hT hlog) hE hM
  have hr : M * (2 * E / ρ) / E = 2 * M / ρ := by field_simp
  rw [hr] at hb
  have heq : E / (2 * E / ρ) +
      E * (1 + Real.log (2 + 2 * M / ρ)) /
        ((2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ))) = ρ := by
    have halg (l : ℝ) (hl : 0 < l) : E / (2 * E / ρ) + E * l / ((2 * E / ρ) * l) = ρ := by
      field_simp
      ring
    exact halg _ hlog
  rwa [heq] at hb

theorem dyadicPartialHullMax_zero_of_energy {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ R)
    (hE : ∑ ν ∈ V, ∫⁻ x in R, g ν x ≤ 0) (ν : ι) (hν : ν ∈ V) (c : ℤ × ℤ) :
    dyadicPartialHullMax G (H ν) (g ν) c = 0 := by
  classical
  apply le_antisymm _ bot_le
  apply Finset.sup_le
  intro d hd
  have hz : (∫⁻ x in dyadicGridCell G d.1 d.2, g ν x) = 0 := by
    apply le_antisymm _ bot_le
    exact (lintegral_mono_set (hR ν hν d hd)).trans
      ((Finset.single_le_sum (fun _ _ => bot_le) hν).trans hE)
  simp only [dyadicEnergyAverage, hz, ENNReal.zero_div, ite_self, ENNReal.bot_eq_zero, le_refl]

theorem dyadicHullCuts_empty_of_energy_zero {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞) (R : Set ℝ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ R)
    (hE : ∑ ν ∈ V, ∫⁻ x in R, g ν x ≤ 0) (T U : ℝ≥0∞) :
    dyadicHullCuts V G S H g T U = ∅ := by
  classical
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro c hc
  have hb := (Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)).2
  apply hb
  refine ⟨fun ν hν => ?_, ?_⟩
  · rw [dyadicPartialHullMax_zero_of_energy V G H g R hR hE ν hν c]
    exact bot_le
  · have hz : ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T = 0 := by
      apply Finset.sum_eq_zero
      intro ν hν
      rw [dyadicPartialHullMax_zero_of_energy V G H g R hR hE ν hν c]
      exact min_eq_left bot_le
    exact hz.le.trans bot_le

/-- Blueprint `lem:cuts`: the selected combined first crossings cost at
most `ρ` times the root length, including the zero-energy case. -/
theorem dyadicHullCuts_cost_selected {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (root : ℤ × ℤ)
    (hR : ∀ ν ∈ V, ∀ c ∈ H ν, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M ρ : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hρ : 0 < ρ)
    (hE : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    dyadicRootLength G (dyadicHullCuts V G S H g (ENNReal.ofReal (2 * E / ρ))
      (ENNReal.ofReal ((2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ))))) ≤
      ρ * dyadicGridLength G root.1 := by
  by_cases hEp : 0 < E
  · exact dyadicHullCuts_cost_selected_pos V G S H g root hR hEp hM0 hρ hE hM
  · have hEz : E = 0 := le_antisymm (le_of_not_gt hEp) hE0
    have hz : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤ 0 := by
      simpa only [hEz, zero_mul, ENNReal.ofReal_zero] using hE
    rw [dyadicHullCuts_empty_of_energy_zero V G S H g _ hR hz]
    simpa only [dyadicRootLength, Finset.sum_empty] using
      mul_nonneg hρ.le (dyadicGridLength_pos G root.1).le

open scoped Classical in
/-- Retained cells satisfy both partial-max rules; their equivalence with
deleting whole first-crossing subtrees is proved below. -/
noncomputable def dyadicHullRetained {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (T U : ℝ≥0∞) : Finset (ℤ × ℤ) := S.filter (dyadicHullGood V G H g T U)

theorem dyadicHullRetained_iff {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (T U : ℝ≥0∞) (c : ℤ × ℤ) :
    c ∈ dyadicHullRetained V G S H g T U ↔ c ∈ S ∧
      ¬∃ d ∈ dyadicHullCuts V G S H g T U,
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  classical
  constructor
  · intro hc
    obtain ⟨hcS, hcgood⟩ := Finset.mem_filter.mp hc
    refine ⟨hcS, ?_⟩
    rintro ⟨d, hd, hcd⟩
    have hbad := (Finset.mem_filter.mp (maximalDyadicCells_subset G _ hd)).2
    exact hbad (dyadicHullGood_ancestor V G H g T U hcd hcgood)
  · rintro ⟨hcS, hno⟩
    apply Finset.mem_filter.mpr
    refine ⟨hcS, ?_⟩
    by_contra hbad
    exact hno (maximalDyadicCells_covers G _ (Finset.mem_filter.mpr ⟨hcS, hbad⟩))

/-- Blueprint `eq:hull-cap`: the fixed-function maxima on whole retained
hull cells satisfy the sum threshold at every point, even below a cut. -/
theorem dyadicHullRetained_cap {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (hHS : ∀ ν ∈ V, H ν ⊆ S) (T U : ℝ≥0∞) (x : ℝ) :
    ∑ ν ∈ V, dyadicHullMax G (dyadicHullRetained V G (H ν) H g T U) (g ν) x ≤ U := by
  classical
  let P := (dyadicHullRetained V G S H g T U).filter
    (fun c => x ∈ dyadicGridCell G c.1 c.2)
  by_cases hP : P.Nonempty
  · obtain ⟨c, hc, hmax⟩ := Finset.exists_max_image P (fun c => c.1) hP
    obtain ⟨hcR, hxc⟩ := Finset.mem_filter.mp hc
    have hcgood : dyadicHullGood V G H g T U c := (Finset.mem_filter.mp hcR).2
    have hνbound (ν) (hν : ν ∈ V) :
        dyadicHullMax G (dyadicHullRetained V G (H ν) H g T U) (g ν) x ≤
          dyadicPartialHullMax G (H ν) (g ν) c := by
      apply Finset.sup_le
      intro d hd
      obtain ⟨hdH, hdgood⟩ := Finset.mem_filter.mp hd
      by_cases hxd : x ∈ dyadicGridCell G d.1 d.2
      · rw [Set.indicator_of_mem hxd]
        have hdP : d ∈ P := Finset.mem_filter.mpr
          ⟨Finset.mem_filter.mpr ⟨hHS ν hν hdH, hdgood⟩, hxd⟩
        have hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
          rcases dyadicGridCell_nested_or_disjoint_of_le G (hmax d hdP) d.2 c.2 with hdis | hsub
          · exact (Set.disjoint_left.mp hdis hxd hxc).elim
          · exact hsub
        exact (dyadicEnergyAverage_le_partial G (H ν) (g ν) hdH).trans
          (dyadicPartialHullMax_mono G (H ν) (g ν) hcd)
      · rw [Set.indicator_of_notMem hxd]
        exact bot_le
    calc
      _ ≤ ∑ ν ∈ V, dyadicPartialHullMax G (H ν) (g ν) c := Finset.sum_le_sum hνbound
      _ = ∑ ν ∈ V, min (dyadicPartialHullMax G (H ν) (g ν) c) T :=
        dyadicPartialHullMax_sum_eq_truncated V G H g c hcgood.1
      _ ≤ U := hcgood.2
  · have hzero (ν) (hν : ν ∈ V) :
        dyadicHullMax G (dyadicHullRetained V G (H ν) H g T U) (g ν) x = 0 := by
      apply le_antisymm _ bot_le
      apply Finset.sup_le
      intro d hd
      have hxd : x ∉ dyadicGridCell G d.1 d.2 := by
        intro hx
        obtain ⟨hdH, hdgood⟩ := Finset.mem_filter.mp hd
        exact hP ⟨d, Finset.mem_filter.mpr
          ⟨Finset.mem_filter.mpr ⟨hHS ν hν hdH, hdgood⟩, hx⟩⟩
      rw [Set.indicator_of_notMem hxd]
      exact le_rfl
    have hz := Finset.sum_eq_zero hzero
    exact hz.le.trans bot_le

/-- An explicit source-admissible constant depending only on the cut
fraction, for the hull cap in `lem:cuts`. -/
noncomputable def hullCutConstant (ρ : ℝ) : ℝ := (2 / ρ) * (1 + Real.log (2 / ρ))

theorem hullCutConstant_pos {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    0 < hullCutConstant ρ := by
  have hdiv : 1 ≤ 2 / ρ := (le_div_iff₀ hρ).mpr (by linarith)
  have hlog := Real.log_nonneg hdiv
  exact mul_pos (div_pos (by norm_num) hρ) (by linarith)

theorem hullCutThreshold_le {E M ρ : ℝ} (hE : 0 ≤ E) (hM : 0 ≤ M)
    (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    (2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ)) ≤
      hullCutConstant ρ * E * (1 + Real.log (2 + M)) := by
  have hdiv : 1 ≤ 2 / ρ := (le_div_iff₀ hρ).mpr (by linarith)
  have hlogρ := Real.log_nonneg hdiv
  have hlogM := Real.log_nonneg (by linarith : 1 ≤ 2 + M)
  have hp : 0 < 2 + 2 * M / ρ := by positivity
  have harg : 2 + 2 * M / ρ ≤ (2 / ρ) * (2 + M) := by
    have htwo : 2 ≤ 4 / ρ := (le_div_iff₀ hρ).mpr (by linarith)
    calc
      _ ≤ 4 / ρ + 2 * M / ρ := add_le_add htwo le_rfl
      _ = _ := by ring
  have hl : Real.log (2 + 2 * M / ρ) ≤ Real.log (2 / ρ) + Real.log (2 + M) := by
    have hh := Real.log_le_log hp harg
    rwa [Real.log_mul (ne_of_gt (div_pos (by norm_num) hρ)) (by positivity)] at hh
  have hb : 1 + Real.log (2 + 2 * M / ρ) ≤
      (1 + Real.log (2 / ρ)) * (1 + Real.log (2 + M)) := by
    nlinarith [mul_nonneg hlogρ hlogM]
  calc
    _ ≤ (2 * E / ρ) * ((1 + Real.log (2 / ρ)) * (1 + Real.log (2 + M))) :=
      mul_le_mul_of_nonneg_left hb (by positivity)
    _ = _ := by unfold hullCutConstant; ring

open scoped Classical in
/-- Blueprint `lem:cuts`, hull assertion (`eq:hull-cap`). For fixed energy
densities on finite specified hulls, first-crossing cells of length at most
`ρ |R|` give an everywhere cap `Cρ E (1 + log (2 + M))` on whole retained
hull cells. Only hull summands are removed; the densities are unchanged. -/
theorem dyadicHullFirstCrossingCuts {ι : Type*} (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (g : ι → ℝ → ℝ≥0∞)
    (root : ℤ × ℤ) (hHS : ∀ ν ∈ V, H ν ⊆ S)
    (hS : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M ρ : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hE : ∑ ν ∈ V, ∫⁻ x in dyadicGridCell G root.1 root.2, g ν x ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ S ∧
      Set.PairwiseDisjoint (C : Set (ℤ × ℤ)) (fun c => dyadicGridCell G c.1 c.2) ∧
      dyadicRootLength G C ≤ ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, ∑ ν ∈ V, dyadicHullMax G
        ((H ν).filter (fun c => ¬∃ d ∈ C,
          dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)) (g ν) x ≤
        ENNReal.ofReal (hullCutConstant ρ * E * (1 + Real.log (2 + M))) := by
  classical
  let T := ENNReal.ofReal (2 * E / ρ)
  let U := ENNReal.ofReal ((2 * E / ρ) * (1 + Real.log (2 + 2 * M / ρ)))
  let C := dyadicHullCuts V G S H g T U
  have hR : ∀ ν ∈ V, ∀ c ∈ H ν,
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2 :=
    fun ν hν c hc => hS c (hHS ν hν hc)
  refine ⟨C, ?_, ?_, dyadicHullCuts_cost_selected V G S H g root hR hE0 hM0 hρ hE hM, ?_⟩
  · intro c hc
    exact (Finset.mem_filter.mp (maximalDyadicCells_subset G _ hc)).1
  · exact maximalDyadicCells_pairwiseDisjoint G _
  · intro x
    have hfamily (ν) (hν : ν ∈ V) :
        (H ν).filter (fun c => ¬∃ d ∈ C,
          dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) =
        dyadicHullRetained V G (H ν) H g T U := by
      ext c
      constructor
      · intro hc
        obtain ⟨hcH, hno⟩ := Finset.mem_filter.mp hc
        have hcR := (dyadicHullRetained_iff V G S H g T U c).mpr ⟨hHS ν hν hcH, hno⟩
        exact Finset.mem_filter.mpr ⟨hcH, (Finset.mem_filter.mp hcR).2⟩
      · intro hc
        obtain ⟨hcH, hgood⟩ := Finset.mem_filter.mp hc
        have hcR : c ∈ dyadicHullRetained V G S H g T U :=
          Finset.mem_filter.mpr ⟨hHS ν hν hcH, hgood⟩
        exact Finset.mem_filter.mpr ⟨hcH, ((dyadicHullRetained_iff V G S H g T U c).mp hcR).2⟩
    calc
      _ = ∑ ν ∈ V, dyadicHullMax G (dyadicHullRetained V G (H ν) H g T U) (g ν) x :=
        Finset.sum_congr rfl (fun ν hν => by rw [hfamily ν hν])
      _ ≤ U := dyadicHullRetained_cap V G S H g hHS T U x
      _ ≤ _ := ENNReal.ofReal_le_ofReal (hullCutThreshold_le hE0 hM0 hρ hρ1)

theorem lintegral_enorm_sq_eq_eLpNorm_sq {F : Type*} [NormedAddCommGroup F]
    (f : ℝ → F) (hf : AEStronglyMeasurable f volume) :
    (∫⁻ x, ‖f x‖ₑ ^ (2 : ℕ)) = eLpNorm f 2 volume ^ (2 : ℕ) := by
  rw [eLpNorm_eq_eLpNorm' (by norm_num) (by norm_num) hf]
  simpa only [ENNReal.toReal_ofNat, ENNReal.rpow_two] using
    (lintegral_rpow_enorm_eq_rpow_eLpNorm' (f := f) (μ := volume) (q := (2 : ℝ)) (by norm_num))

open scoped Classical in
/-- The fixed-function L2 version of blueprint `lem:cuts`: total squared
L2 norm and total hull support suffice for the whole-cell retained cap. -/
theorem dyadicHullFirstCrossingCuts_L2 {ι F : Type*} [NormedAddCommGroup F]
    (V : Finset ι) (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (H : ι → Finset (ℤ × ℤ)) (f : ι → ℝ → F)
    (hf : ∀ ν ∈ V, AEStronglyMeasurable (f ν) volume)
    (root : ℤ × ℤ) (hHS : ∀ ν ∈ V, H ν ⊆ S)
    (hS : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {E M ρ : ℝ} (hE0 : 0 ≤ E) (hM0 : 0 ≤ M) (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hE : ∑ ν ∈ V, eLpNorm (f ν) 2 volume ^ (2 : ℕ) ≤
      ENNReal.ofReal (E * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ S ∧
      Set.PairwiseDisjoint (C : Set (ℤ × ℤ)) (fun c => dyadicGridCell G c.1 c.2) ∧
      dyadicRootLength G C ≤ ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, ∑ ν ∈ V, dyadicHullMax G
        ((H ν).filter (fun c => ¬∃ d ∈ C,
          dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)) (fun y => ‖f ν y‖ₑ ^ (2 : ℕ)) x ≤
        ENNReal.ofReal (hullCutConstant ρ * E * (1 + Real.log (2 + M))) := by
  apply dyadicHullFirstCrossingCuts V G S H (fun ν y => ‖f ν y‖ₑ ^ (2 : ℕ)) root
    hHS hS hE0 hM0 hρ hρ1 _ hM
  apply le_trans _ hE
  apply Finset.sum_le_sum
  intro ν hν
  rw [← lintegral_enorm_sq_eq_eLpNorm_sq (f ν) (hf ν hν)]
  exact setLIntegral_le_lintegral _ _

end Auto
