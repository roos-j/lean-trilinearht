theorem norm_intervalInput_le (δ c : ℝ) (T : Finset ℤ) (G : ℤ → ℂ) (y : ℝ) :
    ‖intervalInput δ c T G y‖ ≤ ∑ m ∈ T, ‖G m‖ := by
  unfold intervalInput
