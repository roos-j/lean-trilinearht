/-- The residual of a single catalog projection on a layered history of the slot input is the
average over the pad choices of the residuals of the single-choice tests with that target. -/
theorem resid_layer_avg (cat : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) (l : Fin 4) (r : ℕ)
    (M : A.Vtx → Prop) (ls : List (ℕ × Bool)) (hmH : ls.length ≤ ap.mH) :
    layerOp (ap.cumAt (cat l) I) ls (physicalColumnInput (ap.base I l)) -
        catProj A.G ap.Mc (cat l) I r M
          (layerOp (ap.cumAt (cat l) I) ls (physicalColumnInput (ap.base I l))) =
      (((Finset.univ : Finset (Fin ap.P × (Fin ls.length → Fin ap.P))).card : ℂ))⁻¹ •
        ∑ pc : Fin ap.P × (Fin ls.length → Fin ap.P),
          ((ap.filters cat I).test l r M ls pc.2).resid A.G ap.Mc I ap.mH (cat l) := by
  have h := residual_layerOp_eq_avg A.G ap.Mc I (cat l) ap.hP (fun m => ap.Lc - m + 1)
    (ap.cmask I) l r (fun _ => M) ls ap.mH hmH (ap.base I l)
  simp only [opAvg_const ap.hP] at h
  exact h

/-- Blueprint lines 1807-1811 on a positive chain (the main test of a transfer step removing a ball
filter): the residual of a single ball pad projection on the averaged chain history of the slot
input passes at the level of the chain tests. -/
theorem chain_ball_cellPass (cat : Fin 4 → List (CatCol A.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    {τ : ℕ → ℝ} (l : Fin 4)
    (hpass : ∀ w : ap.TestIdx I l, (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc A.Hsrc
      A.vtag (A.w I) (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l))
    (s : Fin ap.leaves.length)
    (i : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).reverse).length)
    {G : A.Grp} (hG : G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k) (k : Fin ap.P)
    (hmH : (chainHist (ap.chainOf s l i) 0).length ≤ ap.mH) :
    CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag l
      (ap.bmask I G ((leafAt ap.fuel ap.Lc ap.up₀ s).role l) k)
      (layerOp (ap.cumAt (cat l) I) (chainHist (ap.chainOf s l i) 0)
          (physicalColumnInput (ap.base I l)) -
        catProj A.G ap.Mc (cat l) I (ap.Lc + (leafAt ap.fuel ap.Lc ap.up₀ s).role l)
          (ap.bmask I G ((leafAt ap.fuel ap.Lc ap.up₀ s).role l) k)
          (layerOp (ap.cumAt (cat l) I) (chainHist (ap.chainOf s l i) 0)
            (physicalColumnInput (ap.base I l))))
      (τ (ap.Lc + (leafAt ap.fuel ap.Lc ap.up₀ s).role l) *
        ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
          Real.sqrt (dyadicGridLength A.G I.1)) := by
  rw [ap.resid_layer_avg cat I l _ _ _ hmH]
  refine CellPass.avg (A.adm I hI) _ ⟨(⟨0, ap.hP⟩, fun _ => ⟨0, ap.hP⟩), Finset.mem_univ _⟩ _
    fun pc _ => ?_
  have h := hpass (Sum.inr ⟨s, i, Sum.inl (⟨G, hG⟩, k, pc.2)⟩)
  rw [ap.tests_indep (fun _ => []) cat] at h
  exact ResidPass.cellPass (A.adm I hI) (CatTest.residPass h)

/-- Blueprint lines 1807-1811 on a positive chain (the main test of a transfer step removing a
cumulative filter): the residual of a single cumulative pad projection of the `k`-th layer of the
chain on its averaged inner history passes at the level of the chain tests. -/
theorem chain_cum_cellPass (cat : Fin 4 → List (CatCol A.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    {τ : ℕ → ℝ} (l : Fin 4)
    (hpass : ∀ w : ap.TestIdx I l, (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc A.Hsrc
      A.vtag (A.w I) (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l))
    (s : Fin ap.leaves.length)
    (i : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).reverse).length)
    (k : Fin (ap.chainOf s l i).length) (p : Fin ap.P)
    (hmH : (chainHist (ap.chainOf s l i) (k + 1)).length ≤ ap.mH) :
    CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag l (ap.cmask I ((ap.chainOf s l i).getD k 0) p)
      (layerOp (ap.cumAt (cat l) I) (chainHist (ap.chainOf s l i) (k + 1))
          (physicalColumnInput (ap.base I l)) -
        catProj A.G ap.Mc (cat l) I (ap.Lc - (ap.chainOf s l i).getD k 0 + 1)
          (ap.cmask I ((ap.chainOf s l i).getD k 0) p)
          (layerOp (ap.cumAt (cat l) I) (chainHist (ap.chainOf s l i) (k + 1))
            (physicalColumnInput (ap.base I l))))
      (τ (ap.Lc - (ap.chainOf s l i).getD k 0 + 1) *
        ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
          Real.sqrt (dyadicGridLength A.G I.1)) := by
  rw [ap.resid_layer_avg cat I l _ _ _ hmH]
  refine CellPass.avg (A.adm I hI) _ ⟨(⟨0, ap.hP⟩, fun _ => ⟨0, ap.hP⟩), Finset.mem_univ _⟩ _
    fun pc _ => ?_
  have h := hpass (Sum.inr ⟨s, i, Sum.inr ⟨k, p, pc.2⟩⟩)
  rw [ap.tests_indep (fun _ => []) cat] at h
  exact ResidPass.cellPass (A.adm I hI) (CatTest.residPass h)

/-- Blueprint lines 2253 and 1810-1811: if the step helper tests pass at threshold `τ_H` for
every pad choice, the residual of a single helper projection on the side value after `k` averaged
helper steps passes at level `τ_H ‖base‖ / √|I|`. -/
theorem helper_cellPass {I : ℤ × ℤ} (hI : I ∈ A.cells) (hcat : List (CatCol A.Vtx)) (a : Fin 4)
    (rH : ℕ) (Mt : A.Vtx → Prop) (Mst : ℕ → Fin ap.P → A.Vtx → Prop) (k : ℕ) (hk : k ≤ ap.mH)
    (base : ColumnL2 (Fin ap.Mc)) {τH : ℝ}
    (hpass : ∀ c : Fin k → Fin ap.P, (VTest.ofSteps ap.hP a rH Mt Mst k c base).Pass A.G I
      A.csrc A.Hsrc A.vtag (A.w I) τH ap.mH hcat) :
    CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag a Mt
      (operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH (Mst l p))
          (fun _ => false) k base -
        catProj A.G ap.Mc hcat I rH Mt (operatorComplementProduct
          (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH (Mst l p)) (fun _ => false) k
            base))
      (τH * ‖base‖ / Real.sqrt (dyadicGridLength A.G I.1)) := by
  rw [helper_resid_avg A.G ap.Mc I hcat ap.hP a rH Mt Mst k ap.mH hk base]
  refine CellPass.avg (A.adm I hI) _ ⟨fun _ => ⟨0, ap.hP⟩, Finset.mem_univ _⟩ _
    fun c _ => ResidPass.cellPass (A.adm I hI) (VTest.residPass (hpass c))

end AttemptParams

