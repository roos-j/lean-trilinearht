/-- The averaged catalog filters along a list are contractions. -/
theorem norm_applyAll_filtAvg_le (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) :
    ∀ (L : List (ℕ × (Fin ap.P → A.Vtx → Prop))) (y : ColumnL2 (Fin ap.Mc)),
      ‖applyAll (L.map (ap.filtAvg cat I)) y‖ ≤ ‖y‖
  | [], y => le_rfl
  | f :: L, y => by
    rw [List.map_cons, applyAll]
    change ‖filterAvg ap.P (padFam fun p => catProj A.G ap.Mc cat I f.1 (f.2 p))
      (applyAll (L.map (ap.filtAvg cat I)) y)‖ ≤ _
    rw [filterAvg_padFam]
    exact (norm_opAvg_apply_le _ (fun _ z => norm_catProj_le _ _ _ _ _ _ z) _).trans
      (norm_applyAll_filtAvg_le cat I L y)

/-! ### Sources of the remaining other complement of a transfer step (blueprint line 2254) -/

open Classical in
/-- Cumulative masks grow with the pad. -/
theorem cmask_pad_mono {I : ℤ × ℤ} {m p p' : ℕ} (hp : p ≤ p') {x : A.Vtx}
    (hx : ap.cmask I m p x) : ap.cmask I m p' x :=
  ColorSetup.cumMask_mono (K := ap.K) le_rfl (by omega) _ hx

/-! ### The far band terms of one concrete transfer step (blueprint lines 2253-2258) -/

open Classical in
/-- Blueprint lines 2253-2258 for one step of the transfer of a chain pair: the step removes the
filter `f` (the ball filter or a cumulative layer of the positive chain `iu` of slot `u`), the
remaining complement in slot `o` is the composition of a suffix `ys'` of its filters on its basic
argument. Then every far band pair of the step has form at most the bound of `far_term_le` with the
main level `τ_m S_z` and coefficient sums `C_o`. -/
theorem far_side_le (cat : Fin 4 → List (CatCol A.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    (s : Fin ap.leaves.length) {a b u o : Fin 4} (hua : u ≠ a) (huo : u ≠ o) (hub : u ≠ b)
    (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (hTu : ∀ d ∈ cat u, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) u R γ d.birth d.rank d.tag)
    (hTo : ∀ d ∈ cat o, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) o R γ d.birth d.rank d.tag)
    (hcat : List (CatCol A.Vtx))
    (hTa : ∀ d ∈ hcat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) a R γ d.birth d.rank d.tag) (rH : ℕ)
    {G : A.Grp} (hG : G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k)
    (hGs : ∃ v ∈ A.admT.X (A.admAt I), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt I)) v) ∧
      ap.K.grp A.admT A.vtxBound (A.admAt I) v = G)
    (iu : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers u).reverse).length)
    {τ : ℕ → ℝ}
    (hpassU : ∀ w : ap.TestIdx I u, (ap.tests (fun _ => []) I u w).Pass A.G ap.Mc I A.csrc A.Hsrc
      A.vtag (A.w I) (τ (ap.tests (fun _ => []) I u w).r) ap.mH (cat u))
    (hmH : (ap.chainOf s u iu).length ≤ ap.mH) (hHmax : ap.bbase 4 + ap.P ≤ ap.Hmax)
    (f : ℕ × (Fin ap.P → A.Vtx → Prop)) (xs' : List (ℕ × (Fin ap.P → A.Vtx → Prop)))
    (hf : (f :: xs') <:+ ap.slotFilt s u G I (ap.chainOf s u iu))
    (tO : List ℕ) (ys' : List (ℕ × (Fin ap.P → A.Vtx → Prop)))
    (hys : ys' <:+ ap.slotFilt s o G I tO) (hzo : ap.z I o = A.B o I)
    (xa : ColumnL2 (Fin ap.Mc)) {βH : ℝ} (hβH : 0 ≤ βH)
    (hhelp : ∀ k : Fin ap.P, CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag a (f.2 k)
      (xa - catProj A.G ap.Mc hcat I rH (f.2 k) xa) βH)
    {τm Sz : ℝ} (hτm : ∀ r ≤ ap.Lc + 4, τ r ≤ τm) (hτm0 : 0 ≤ τm) (hSz : 0 < Sz)
    (hSzl : ∀ l, ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
      Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    {Nm NH Co : ℝ} (hNm : ∀ l r (M : A.Vtx → Prop),
      ((catLabels A.G ap.Mc (cat l) I r M).card : ℝ) ≤ Nm)
    (hNH : ∀ k, ((catLabels A.G ap.Mc hcat I rH (f.2 k)).card : ℝ) ≤ NH)
    (hCo1 : Real.sqrt Nm * Sz ≤ Co) (hCo2 : Fintype.card A.L * A.Dc ≤ Co)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ ap.Hed)
    (X : Fin 4 → ColumnL2 (Fin ap.Mc)) {p q : ℕ} (hp : p ≤ ap.P) (hq : q ≤ ap.P)
    (hfar : q + 2 < p ∨ p + 2 < q)
    (hXa : X a = padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcat I rH (f.2 k)) (p + 1) xa -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcat I rH (f.2 k)) p xa)
    (hXu : X u = padFam (fun k : Fin ap.P => catProj A.G ap.Mc (cat u) I f.1 (f.2 k)) (q + 1)
        (applyAll (xs'.map (ap.filtAvg (cat u) I)) (physicalColumnInput (ap.base I u))) -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc (cat u) I f.1 (f.2 k)) q
        (applyAll (xs'.map (ap.filtAvg (cat u) I)) (physicalColumnInput (ap.base I u))))
    (hXo : X o = applyAll (ys'.map (ap.filtAvg (cat o) I)) (physicalColumnInput (ap.base I o)))
    {Sa Sb : ℝ} (hSa : 0 < Sa) (hSa' : 2 * ‖xa‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSb : 0 < Sb)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖ap.Λc I X‖ ≤ Real.sqrt Nm * (2 * Sz) * ((βH + βH) * Sz * Sb) +
      (Co * ((τm * Sz + τm * Sz) * Sa * Sb) +
        τ₂ * (2 * Sz) * Sb * Co * (Real.sqrt NH * Sa)) := by
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  set yu := physicalColumnInput (V := Fin ap.Mc) (ap.base I u)
  set yo := physicalColumnInput (V := Fin ap.Mc) (ap.base I o)
  set v := applyAll (xs'.map (ap.filtAvg (cat u) I)) yu
  have hv : ‖v‖ ≤ ‖yu‖ := ap.norm_applyAll_filtAvg_le (cat u) I xs' yu
  have hSv' : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ 2 * Sz := by
    rw [mul_div_assoc]
    exact mul_le_mul_of_nonneg_left ((div_le_div_of_nonneg_right hv hsq.le).trans (hSzl u))
      (by norm_num)
  -- the size of the other complement
  have hSo : eLpNorm (augPhys (X o)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sz := by
    rw [hXo]
    refine (augPhys_normalized_le A.G I _).trans (ENNReal.ofReal_le_ofReal ?_)
    exact (div_le_div_of_nonneg_right (ap.norm_applyAll_filtAvg_le (cat o) I ys' yo)
      hsq.le).trans (hSzl o)
  -- the sources of the other complement
  have hsrcO : ap.SrcData o I (X o) Co := by
    rw [hXo]
    rcases ys' with _ | ⟨g, ys''⟩
    · change ap.SrcData o I yo Co
      simp only [yo, base, hzo]
      exact ap.srcData_basic hI o hCo2
    · rw [List.map_cons, applyAll]
      have hg : ∀ k x, g.2 k x → x ∈ A.admT.X (A.admAt I) := by
        rcases ap.slotFilt_suffix_cons s o G I tO hys with ⟨hg, -⟩ | ⟨k, -, hg, -⟩
        · rw [hg]; exact fun k x hx => ap.bmask_present hx
        · rw [hg]; exact fun k x hx => ap.cmask_present hx
      refine ap.srcData_filt (cat o) o hTo I g hg _ ?_ (hNm o g.1 _) hCo1
      exact (div_le_div_of_nonneg_right (ap.norm_applyAll_filtAvg_le (cat o) I ys'' yo)
        hsq.le).trans (hSzl o)
  obtain ⟨ι, Fo, co, src, tago, hXo', hCo, hpres, hsrc⟩ := hsrcO
  -- the estimate for a removed filter with the required test and mask properties
  have key : (∀ i j : Fin ap.P, i ≤ j → ∀ x, f.2 i x → f.2 j x) →
      (∀ k x, f.2 k x → x ∈ A.admT.X (A.admAt I)) →
      (∀ (k : Fin ap.P) (hk : (k : ℕ) + 1 < ap.P) (w y : A.Vtx), f.2 k w →
        y ∈ A.admT.X (A.admAt I) →
        (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) w y ≤ 1 → f.2 ⟨k + 1, hk⟩ y) →
      (∀ k : Fin ap.P, CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag u (f.2 k)
        (v - catProj A.G ap.Mc (cat u) I f.1 (f.2 k) v) (τm * Sz)) →
      ‖ap.Λc I X‖ ≤ Real.sqrt Nm * (2 * Sz) * ((βH + βH) * Sz * Sb) +
        (Co * ((τm * Sz + τm * Sz) * Sa * Sb) +
          τ₂ * (2 * Sz) * Sb * Co * (Real.sqrt NH * Sa)) := fun hMm hMp hMn hmain =>
    ap.far_term_le hI hua huo hub hao hab hob (cat u) hTu hcat hTa f.1 rH f.2 hMm hMp hMn v xa
      (by positivity) hβH hmain hhelp Fo co src tago hpres hsrc hCo hτ₂ hτ₂1 hHed
      (fun k => hNm u f.1 _) hNH hp hq hfar X hXa hXu hXo' hSz hSa (by positivity) hSb hSa'
      hSv' hSo hXb
  have hlev : ∀ r ≤ ap.Lc + 4, τ r * ‖yu‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ τm * Sz := by
    intro r hr
    rw [mul_div_assoc]
    have h0 : 0 ≤ ‖yu‖ / Real.sqrt (dyadicGridLength A.G I.1) := by positivity
    calc τ r * (‖yu‖ / Real.sqrt (dyadicGridLength A.G I.1))
        ≤ τm * (‖yu‖ / Real.sqrt (dyadicGridLength A.G I.1)) :=
          mul_le_mul_of_nonneg_right (hτm r hr) h0
      _ ≤ τm * Sz := mul_le_mul_of_nonneg_left (hSzl u) hτm0
  set t := ap.chainOf s u iu
  rcases ap.slotFilt_suffix_cons s u G I t hf with ⟨hf1, hx⟩ | ⟨k, hk, hf1, hx⟩
  · -- the ball filter of the slot
    subst hf1
    subst hx
    have hv_eq : v = layerOp (ap.cumAt (cat u) I) (chainHist t 0) yu := by
      rw [layerOp_chainHist, List.drop_zero]
      exact ap.applyAll_cum (cat u) I t yu
    have hmH' : (chainHist t 0).length ≤ ap.mH := by
      unfold chainHist; simpa using hmH
    have hrole := (leafAt ap.fuel ap.Lc ap.up₀ s).role_le u
    refine key (fun i j hij x hx => ap.bmask_pad_mono hij hx)
      (fun k x hx => ap.bmask_present hx) (fun k hk w y hw hy hd => ?_) (fun k => ?_)
    · refine ap.near_bmask hGs ?_ hw hy hd
      have hb : ap.bbase (ap.leafJ s u) ≤ ap.bbase 4 := by
        unfold bbase leafJ
        have : (leafAt ap.fuel ap.Lc ap.up₀ s).role u - 1 ≤ 4 - 1 := by omega
        have := Nat.mul_le_mul_right ap.P (Nat.mul_le_mul_left 10 this)
        omega
      omega
    · rw [hv_eq]
      exact (ap.chain_ball_cellPass cat hI u hpassU s iu hG k hmH').mono
        (hlev _ (by simp only [leafR] at *; omega))
  · -- a cumulative layer of the chain
    subst hf1
    subst hx
    have hv_eq : v = layerOp (ap.cumAt (cat u) I) (chainHist t (k + 1)) yu := by
      rw [layerOp_chainHist]
      exact ap.applyAll_cum (cat u) I (t.drop (k + 1)) yu
    have hmH' : (chainHist t (k + 1)).length ≤ ap.mH := by
      unfold chainHist
      simp only [List.length_map, List.length_reverse, List.length_drop]
      omega
    refine key (fun i j hij x hx => ap.cmask_pad_mono hij hx)
      (fun k x hx => ap.cmask_present hx)
      (fun k hk w y hw hy hd => ap.near_cmask hw hy hd) (fun p => ?_)
    rw [hv_eq]
    exact (ap.chain_cum_cellPass cat hI u hpassU s iu ⟨k, hk⟩ p hmH').mono (hlev _ (by omega))

/-! ### The far defects of one chain pair (blueprint lines 2253-2258) -/

/-- The side value after merged helper steps is a contraction of the side state. -/
theorem norm_chainSide_mergeSteps_le (catc catd hcat : List (CatCol A.Vtx)) (rH : ℕ)
    (I : ℤ × ℤ) :
    ∀ (pre : List (Bool × (ℕ × (Fin ap.P → A.Vtx → Prop)))) (x : ColumnL2 (Fin ap.Mc)),
      ‖chainSide ap.P (((pre.map (ap.toStep catc catd hcat rH I)).map
          fun st => (st.1, padFam st.2.1, padFam st.2.2))) x‖ ≤ ‖x‖
  | [], x => le_rfl
  | e :: pre, x => by
    rw [List.map_cons, List.map_cons, chainSide]
    refine (norm_chainSide_mergeSteps_le catc catd hcat rH I pre _).trans ?_
    change ‖filterAvg ap.P (padFam fun p => catProj A.G ap.Mc hcat I rH (e.2.2 p)) x‖ ≤ _
    rw [filterAvg_padFam]
    exact norm_opAvg_apply_le _ (fun _ z => norm_catProj_le _ _ _ _ _ _ z) x

open Classical in
/-- Blueprint lines 2253-2258 ("the far terms cost at most `D^{-C₃} ‖S_a‖ ‖S_b‖` per cell and
group") for one pair of positive chains of the two complement slots `c, d` of a leaf at one cell:
the far band defects of the rank-ordered transfer steps are at most
`#steps (P + 1)² B_far`, where `B_far` is the step bound of `far_side_le`. -/
theorem chainPair_far_le (cat : Fin 4 → List (CatCol A.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    (s : Fin ap.leaves.length) {a b c d : Fin 4} (hca : c ≠ a) (hcd : c ≠ d) (hcb : c ≠ b)
    (hda : d ≠ a) (hdb : d ≠ b) (hab : a ≠ b)
    (hT : ∀ l, ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag)
    (hcat : List (CatCol A.Vtx))
    (hTa : ∀ d ∈ hcat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) a R γ d.birth d.rank d.tag) (rH : ℕ)
    {G : A.Grp} (hG : G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k)
    (hGs : ∃ v ∈ A.admT.X (A.admAt I), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt I)) v) ∧
      ap.K.grp A.admT A.vtxBound (A.admAt I) v = G)
    (ic : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers c).reverse).length)
    (id : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers d).reverse).length)
    {τ : ℕ → ℝ}
    (hpass : ∀ l (w : ap.TestIdx I l), (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc
      A.Hsrc A.vtag (A.w I) (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l))
    (hmHc : (ap.chainOf s c ic).length ≤ ap.mH) (hmHd : (ap.chainOf s d id).length ≤ ap.mH)
    (hHmax : ap.bbase 4 + ap.P ≤ ap.Hmax) (hzc : ap.z I c = A.B c I)
    (hzd : ap.z I d = A.B d I) (x : Fin 4 → ColumnL2 (Fin ap.Mc)) {βH : ℝ} (hβH : 0 ≤ βH)
    (hhelp : ∀ preM e restM, rankMerge Prod.fst (ap.slotFilt s c G I (ap.chainOf s c ic))
      (ap.slotFilt s d G I (ap.chainOf s d id)) = preM ++ e :: restM → ∀ k : Fin ap.P,
      CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag a (e.2.2 k)
        (operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH
            ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length
              (x a) -
          catProj A.G ap.Mc hcat I rH (e.2.2 k)
            (operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH
              ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length
                (x a))) βH)
    {τm Sz : ℝ} (hτm : ∀ r ≤ ap.Lc + 4, τ r ≤ τm) (hτm0 : 0 ≤ τm) (hSz : 0 < Sz)
    (hSzl : ∀ l, ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
      Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    {Nm NH Co : ℝ} (hNm : ∀ l r (M : A.Vtx → Prop),
      ((catLabels A.G ap.Mc (cat l) I r M).card : ℝ) ≤ Nm)
    (hNH : ∀ (M : A.Vtx → Prop), ((catLabels A.G ap.Mc hcat I rH M).card : ℝ) ≤ NH)
    (hCo1 : Real.sqrt Nm * Sz ≤ Co) (hCo2 : Fintype.card A.L * A.Dc ≤ Co)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ ap.Hed)
    {Sa Sb : ℝ} (hSa : 0 < Sa) (hSa' : 2 * ‖x a‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSb : 0 < Sb)
    (hXb : eLpNorm (augPhys (x b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖chainDefectSel (ap.Λc I) ap.P a c d x (physicalColumnInput (ap.base I c))
        (physicalColumnInput (ap.base I d)) (fun p q => q + 2 < p ∨ p + 2 < q)
        (ap.chainSteps cat hcat rH s c d G I (ap.chainOf s c ic) (ap.chainOf s d id)) (x a)‖ ≤
      (ap.chainSteps cat hcat rH s c d G I (ap.chainOf s c ic) (ap.chainOf s d id)).length *
        ((ap.P + 1) ^ 2 * (Real.sqrt Nm * (2 * Sz) * ((βH + βH) * Sz * Sb) +
          (Co * ((τm * Sz + τm * Sz) * Sa * Sb) +
            τ₂ * (2 * Sz) * Sb * Co * (Real.sqrt NH * Sa)))) := by
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  have hCo0 : 0 ≤ Co := le_trans (by have := A.Dc_nonneg; positivity) hCo2
  refine chainDefectSel_le (ap.Λc I) ap.hP a c d x _ _ _ (by positivity) _ (x a)
    fun pre st rest h p hp q hq hsel => ?_
  rw [ap.chainSteps_eq] at h
  obtain ⟨preM, e, xs', ys', rfl, rfl, rfl, hrm, hcase⟩ := ap.mergeSteps_decomp _ _ _ _ _ _ _ _
    _ _ h
  rw [ap.chainSide_mergeSteps]
  have hxa : ‖operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH
      ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length (x a)‖ ≤
      ‖x a‖ := by
    rw [← ap.chainSide_mergeSteps (cat c) (cat d) hcat rH I preM (x a)]
    exact ap.norm_chainSide_mergeSteps_le _ _ _ _ _ _ _
  have hSa'' : 2 * ‖operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I
      rH ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length (x a)‖ /
      Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa :=
    le_trans (div_le_div_of_nonneg_right (by linarith) hsq.le) hSa'
  rcases hcase with ⟨he1, hxs, hys, -⟩ | ⟨he1, hxs, hys, -⟩
  · -- a filter of slot `c` is removed
    obtain ⟨e1, e2⟩ := e
    simp only at he1
    subst he1
    simp only [toStep, ite_true]
    rw [ap.chainVal_mergeSteps_c, ap.chainVal_mergeSteps_d]
    exact ap.far_side_le cat hI s hca hcd hcb hda.symm hab hdb (hT c) (hT d) hcat hTa rH hG hGs
      ic (hpass c) hmHc hHmax e2 xs' hxs _ ys' hys hzd _ hβH (hhelp preM _ _ hrm) hτm hτm0 hSz
      hSzl hNm (fun k => hNH _) hCo1 hCo2 hτ₂ hτ₂1 hHed _ hp hq hsel
      (by rw [Function.update_of_ne hca.symm, Function.update_self])
      (Function.update_self _ _ _)
      (by rw [Function.update_of_ne hcd.symm, Function.update_of_ne hda,
        Function.update_self])
      hSa hSa'' hSb
      (by rw [Function.update_of_ne hcb.symm, Function.update_of_ne hab.symm,
        Function.update_of_ne hdb.symm, Function.update_of_ne hcb.symm]; exact hXb)
  · -- a filter of slot `d` is removed
    obtain ⟨e1, e2⟩ := e
    simp only at he1
    subst he1
    simp only [toStep, Bool.false_eq_true, ite_false]
    rw [ap.chainVal_mergeSteps_c, ap.chainVal_mergeSteps_d]
    exact ap.far_side_le cat hI s hda hcd.symm hdb hca.symm hab hcb (hT d) (hT c) hcat hTa rH hG
      hGs id (hpass d) hmHd hHmax e2 ys' hys _ xs' hxs hzc _ hβH (hhelp preM _ _ hrm) hτm hτm0
      hSz hSzl hNm (fun k => hNH _) hCo1 hCo2 hτ₂ hτ₂1 hHed _ hp hq hsel
      (by rw [Function.update_of_ne hda.symm, Function.update_self])
      (Function.update_self _ _ _)
      (by rw [Function.update_of_ne hcd, Function.update_of_ne hca, Function.update_of_ne hcd,
        Function.update_self])
      hSa hSa'' hSb
      (by rw [Function.update_of_ne hdb.symm, Function.update_of_ne hab.symm,
        Function.update_of_ne hdb.symm, Function.update_of_ne hcb.symm]; exact hXb)

