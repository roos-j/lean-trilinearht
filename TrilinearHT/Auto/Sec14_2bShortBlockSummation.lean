/-- With the ratio `n_{r+1} ≥ n_r K_t Q E² M_p (L+6) / τ₃²` (the closure growth of
`closure_parameters`), the threshold of rank `r + 1` cancels `√n_r`: `√n_r τ_{r+1} ≤ τ₃`. -/
theorem catTau_ratio {Kt Mp : ℕ} {Q E τ₃ : ℝ} {n : ℕ → ℝ} (hn0 : ∀ r, 0 < n r) (hτ₃ : 0 < τ₃)
    (hQ : 0 ≤ Q) (r : ℕ)
    (hratio : n r * (Kt * Q * E ^ 2 * Mp * (ap.Lc + 6)) / τ₃ ^ 2 ≤ n (r + 1)) :
    Real.sqrt (n r) * ap.catTau Kt Mp Q E n (r + 1) ≤ τ₃ := by
  unfold catTau
  have hK : (0 : ℝ) ≤ Kt * Q * E ^ 2 * Mp * (ap.Lc + 6) := by positivity
  rw [← Real.sqrt_mul (hn0 r).le]
  rw [show τ₃ = Real.sqrt (τ₃ ^ 2) from (Real.sqrt_sq hτ₃.le).symm]
  apply Real.sqrt_le_sqrt
  have hn1 := hn0 (r + 1)
  rw [mul_div_assoc', div_le_iff₀ hn1]
  rw [div_le_iff₀ (by positivity)] at hratio
  nlinarith

theorem catTau_nonneg (Kt Mp : ℕ) (Q E : ℝ) (n : ℕ → ℝ) (r : ℕ) :
    0 ≤ ap.catTau Kt Mp Q E n r := Real.sqrt_nonneg _

theorem catTau_anti {Kt Mp : ℕ} {Q E : ℝ} {n : ℕ → ℝ} (hn0 : ∀ r, 0 < n r) (hnm : Monotone n)
    (hQ : 0 ≤ Q) {r r' : ℕ} (h : r ≤ r') :
    ap.catTau Kt Mp Q E n r' ≤ ap.catTau Kt Mp Q E n r := by
  unfold catTau
  apply Real.sqrt_le_sqrt
  have hK : (0 : ℝ) ≤ Kt * Q * E ^ 2 * Mp * (ap.Lc + 6) := by positivity
  exact div_le_div_of_nonneg_left hK (hn0 r) (hnm h)

