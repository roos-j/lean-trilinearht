    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (one_le_regE2 κ)
  have hE1 : 1 ≤ ENNReal.ofReal (regE2 κ) ^ (1 / 2 : ℝ) :=
    ENNReal.one_le_rpow hE0 (by norm_num)
  have hP := main_prod_le (Cmax := max Cs Cd) (A' := ENNReal.ofReal ((K : ℝ) + 2))
    (E := ENNReal.ofReal (regE2 κ) ^ (1 / 2 : ℝ))
    (Rv := volume (dyadicGridCell G T.root.1 T.root.2)) hab (pexp q R)
    (two_le_pStar hq) (two_le_pReg hq)
    (by unfold pexp; simp) (by unfold pexp; simp)
    (fun j ha hb => by unfold pexp; simp [ha, hb])
