variable {Tg γ : Type*} (F : LeafFilters Tg γ)

/-- Old sources are killed by the lower guard (blueprint line 1850): the bound holds with the
slot-`t` input or any contraction of it. -/
theorem old_le {κ : LocalKernelClass} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft F.G F.I.1 F.I.2)
      (dyadicGridLength F.G F.I.1) wI) {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {mH : ℕ}
    (ls : Fin 4 → List (ℕ × Bool)) {u t gl a : Fin 4} (hut : u ≠ t) (hug : u ≠ gl)
    (hua : u ≠ a) (htg : t ≠ gl) (hta : t ≠ a) (hga : gl ≠ a)
    {τo Sz : ℝ} (hτo : 0 ≤ τo) (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ /
      Real.sqrt (dyadicGridLength F.G F.I.1) ≤ Sz)
    {x : Tg} {φ : ColumnL2 (Fin F.Mc)} (hφ : F.IsSource c₀ H tagOf u x φ)
    {ls' : List (ℕ × Bool)} {m : ℕ} (hls : ls gl = ls' ++ [(m, true)]) (hmH : ls'.length ≤ mH)
    (hpass : ∀ pc : Fin F.P × (Fin ls'.length → Fin F.P),
      (F.test gl (F.rkC m) (F.cm m pc.1) ls' pc.2).Pass F.G F.Mc F.I c₀ H tagOf wI τo mH
        (F.cat gl))
    (htag : ∀ p : ℕ, F.cm m p x) (y : ColumnL2 (Fin F.Mc))
    (hy : ‖y‖ ≤ ‖physicalColumnInput (V := Fin F.Mc) (F.g t)‖) :
    ‖cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc)
      (Function.update (Function.update (F.input ls) u φ) t y)‖ ≤ τo * Sz ^ 3 := by
  obtain ⟨A, hA, hAθ, hAM, hAq, hAe⟩ := hφ
  set X := Function.update (Function.update (F.input ls) u φ) t y
  refine CatTest.form_avg_le hwI (Finset.univ : Finset (Fin F.P × (Fin ls'.length → Fin F.P)))
    ⟨(⟨0, F.hP⟩, fun _ => ⟨0, F.hP⟩), Finset.mem_univ _⟩ _ (fun _ => τo)
