theorem multWith_fourth (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (N : ℕ) (w : Fin 4 → ℤ → ℂ) (j : Fin 4) (m : ℤ) :
    ∫⁻ z, ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (4 : ℝ)
      ∂((P.prod gammaMeasure).prod fastHaar) ≤
      2 * ‖w j m‖ₑ ^ 4 * (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ) := by
  have hm := (D.measurable_multWith_joint N w j m).enorm.pow_const (4 : ℝ)
  rw [lintegral_prod _ hm.aemeasurable]
  rw [lintegral_prod _ (hm.lintegral_prod_right').aemeasurable]
  have hσ : ∀ σ, ∫⁻ γ, ∫⁻ t, ‖D.multWith N w γ σ j m t‖ₑ ^ (4 : ℝ) ∂fastHaar ∂gammaMeasure ≤
      2 * ‖w j m‖ₑ ^ 4 * D.slotMass σ j m ^ (2 : ℝ) := by
    intro σ
    have h4 := lintegral_fastCircle_fourth (Finset.Icc (-(N : ℤ)) N)
      (fun k => w j m * fourierCoeff (slotLift D.δ (D.inp σ) j m) k)
      (fastSlotC_ne_zero j) (fastSlotC_dvd j)
    refine h4.trans ?_
    have hb := fast_bessel_enorm (measurable_slotLift (δ := D.δ) (D.measurable_inp σ) j m)
      (Finset.Icc (-(N : ℤ)) N)
    simp only [norm_mul, mul_pow, ← Finset.mul_sum]
    have hS : 0 ≤ ∑ i ∈ Finset.Icc (-(N : ℤ)) N,
        ‖fourierCoeff (slotLift D.δ (D.inp σ) j m) i‖ ^ 2 :=
      Finset.sum_nonneg fun _ _ => by positivity
    have e1 : ENNReal.ofReal ((‖w j m‖ ^ 2) ^ 2) = ‖w j m‖ₑ ^ 4 := by
      rw [← pow_mul, ENNReal.ofReal_pow (norm_nonneg _), ofReal_norm]
    rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_ofNat,
      ENNReal.ofReal_mul (by positivity), e1, ENNReal.ofReal_pow hS, ENNReal.rpow_two,
      mul_assoc]
    gcongr
    exact hb
  calc ∫⁻ σ, ∫⁻ γ, ∫⁻ t, ‖D.multWith N w γ σ j m t‖ₑ ^ (4 : ℝ) ∂fastHaar ∂gammaMeasure ∂P
      ≤ ∫⁻ σ, 2 * ‖w j m‖ₑ ^ 4 * D.slotMass σ j m ^ (2 : ℝ) ∂P := lintegral_mono hσ
    _ = 2 * ‖w j m‖ₑ ^ 4 * ∫⁻ σ, D.slotMass σ j m ^ (2 : ℝ) ∂P :=
        lintegral_const_mul' _ _ (by simp [ENNReal.mul_eq_top])
    _ ≤ _ := by
        gcongr
        have := ENNReal.rpow_le_rpow (D.slotMass_moment P hmom j m) (by norm_num : (0 : ℝ) ≤ 4)
        rwa [← ENNReal.rpow_mul, show (1 / 4 : ℝ) * 4 = 1 by norm_num, ENNReal.rpow_one] at this

