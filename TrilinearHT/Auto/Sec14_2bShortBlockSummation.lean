    (G : γ) (j : ℕ) (Mtop : Tg → Prop) (hMtop : ∀ (p : Fin F.P) x, F.bm G j p x → Mtop x)
    (hsep : ∀ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB j) Mtop,
