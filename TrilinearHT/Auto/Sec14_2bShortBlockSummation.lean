  obtain ⟨c, hcb, hce⟩ := opAvg_catProj_l2 (G := F.G) (F.cat t) F.I (F.rkB j)
    (fun p : Fin F.P => F.bm G j p) Mtop (fun p x hx => hMtop p x hx) (F.input ls t)
  set X := Function.update (Function.update (F.input ls) u φ) t (F.ball G j t (F.input ls t))
  have hs := Real.sqrt_pos.mpr (dyadicGridLength_pos F.G F.I.1)
  have hsum : ∑ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB j) Mtop, ‖c n‖ ≤
