variable {Tg : Type*}

/-- Catalog ranges grow with the mask. -/
theorem catRange_mask_mono (G : RealDyadicGrid) (Mc : ℕ) (s : List (CatCol Tg)) (I : ℤ × ℤ)
    (r : ℕ) {M M' : Tg → Prop} (h : ∀ x, M x → M' x) :
    catRange G Mc s I r M ≤ catRange G Mc s I r M' := by
  refine Submodule.span_mono fun x hx => ?_
  obtain ⟨n, hn, h1, h2, h3, h4⟩ := hx
  exact ⟨n, hn, h1, h2, h _ h3, h4⟩

end FarHelper

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- A band of a pad family of catalog projections below the top lies in the catalog range of its
pad mask and has norm at most twice the input. -/
theorem padBand_mem (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin ap.P → A.Vtx → Prop) (hMm : ∀ i j : Fin ap.P, i ≤ j → ∀ x, M i x → M j x)
    {q : ℕ} (hq : q < ap.P) (v : ColumnL2 (Fin ap.Mc)) :
    padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (q + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) q v ∈
      catRange A.G ap.Mc cat I r (M ⟨q, hq⟩) ∧
    ‖padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (q + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) q v‖ ≤ 2 * ‖v‖ := by
  rw [padFam_succ _ hq]
  rcases q with _ | q
  · rw [padFam_zero]
    simp only [ContinuousLinearMap.coe_coe, LinearMap.zero_apply, sub_zero]
    exact ⟨Submodule.starProjection_apply_mem _ v,
      (norm_catProj_le _ _ _ _ _ _ v).trans (by linarith [norm_nonneg v])⟩
  · rw [padFam_succ _ (by omega)]
    simp only [ContinuousLinearMap.coe_coe]
    refine ⟨Submodule.sub_mem _ (Submodule.starProjection_apply_mem _ v)
      (catRange_mask_mono A.G ap.Mc cat I r (hMm ⟨q, by omega⟩ ⟨q + 1, hq⟩
        (Fin.mk_le_mk.mpr (Nat.le_succ q)))
        (Submodule.starProjection_apply_mem _ v)), ?_⟩
    refine (norm_sub_le _ _).trans ?_
    have h1 := norm_catProj_le A.G ap.Mc cat I r (M ⟨q + 1, hq⟩) v
    have h2 := norm_catProj_le A.G ap.Mc cat I r (M ⟨q, by omega⟩) v
    linarith

/-- Blueprint lines 2253-2254 (a far band pair with the helper band higher: "expand the lower `c`
band into its main pure sources; their tags lie in both masks writing the higher helper band as a
difference of residuals ... the helper test applies with arbitrary `L²` spectators"): at one cell,
the form with the helper band `Q_{a,p+1} - Q_{a,p}` of a side value in slot `a`, a lower catalog
band `Q_{u,q+1} - Q_{u,q}` (`q + 2 < p`) in slot `u` and two spectators is at most
`(#labels) (2 ‖v‖ / √|I|) (2 β) S_o S_b`, where `β` is the level of the helper tests. -/
theorem far_helper_le {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a)
    (huo : u ≠ o) (hub : u ≠ b) (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (catu : List (CatCol A.Vtx))
    (hT : ∀ d ∈ catu, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) u R γ d.birth d.rank d.tag)
    (r : ℕ) (M : Fin ap.P → A.Vtx → Prop) (hMm : ∀ i j : Fin ap.P, i ≤ j → ∀ x, M i x → M j x)
    (hav : ∀ k x, M k x → A.occAvail x.2.1 x.1) (hcatA : List (CatCol A.Vtx)) (rH : ℕ)
    (xa v : ColumnL2 (Fin ap.Mc)) {β : ℝ}
    (hpass : ∀ k : Fin ap.P, CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag a (M k)
      (xa - catProj A.G ap.Mc hcatA I rH (M k) xa) β) (hβ : 0 ≤ β)
    {p q : ℕ} (hpq : q + 2 < p) (hpP : p ≤ ap.P) (X : Fin 4 → ColumnL2 (Fin ap.Mc))
    (hXa : X a = padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) (p + 1) xa -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) p xa)
    (hXu : X u = padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) (q + 1) v -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) q v)
    {So Sb : ℝ} (hSo : 0 < So) (hSb : 0 < Sb)
    (hXo : eLpNorm (augPhys (X o)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal So)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖ap.Λc I X‖ ≤ (Real.sqrt (catLabels A.G ap.Mc catu I r (M ⟨q, by omega⟩)).card *
      (2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1))) * ((β + β) * So * Sb) := by
  classical
  have hqP : q < ap.P := by omega
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  obtain ⟨hmem, hnorm⟩ := ap.padBand_mem catu I r M hMm hqP v
  obtain ⟨c, -, -, -, hce⟩ := catRange_expansion hmem
  set F := catLabels A.G ap.Mc catu I r (M ⟨q, hqP⟩)
  -- the coefficient bound
  have hcs : ∑ n ∈ F, ‖c n‖ ≤
      Real.sqrt F.card * (2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1)) := by
    refine (catCoeff_l1_le (G := A.G) catu I F c).trans
      (mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _))
    rw [← hce]
    exact div_le_div_of_nonneg_right hnorm (Real.sqrt_nonneg _)
  have hR0 : 0 ≤ (Real.sqrt F.card * (2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1))) *
      ((β + β) * So * Sb) := by positivity
  by_cases hF : F = ∅
  · have hu0 : X u = 0 := by rw [hXu, hce, hF, Finset.sum_empty]
    rw [(ap.Λc I).map_coord_zero u hu0, norm_zero]
    exact hR0
  obtain ⟨n₀, hn₀⟩ := Finset.nonempty_iff_ne_empty.mpr hF
  have hmemF : ∀ n ∈ F, ∃ h : (n : ℕ) < catu.length, M ⟨q, hqP⟩ (catu[(n : ℕ)]).tag := by
    intro n hn
    simp only [F, catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hn
    obtain ⟨h, -, -, hM⟩ := hn
    exact ⟨h, hM⟩
  obtain ⟨hn₀l, -⟩ := hmemF n₀ hn₀
  set tag : Fin ap.Mc → A.Vtx := fun n =>
    if h : (n : ℕ) < catu.length then (catu[(n : ℕ)]).tag else (catu[(n₀ : ℕ)]).tag
  have htagF : ∀ n ∈ F, M ⟨q, hqP⟩ (tag n) := fun n hn => by
    obtain ⟨h, hM⟩ := hmemF n hn
    have htm : tag n = (catu[(n : ℕ)]).tag := dite_eq_left_of_eq_true (eq_true h)
    rw [htm]; exact hM
  have hsrc : ∀ m ∈ F, ∃ A' : QuadraticChartData (A.vtag (tag m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc A' ∧ A'.horizontal = (A.vtag (tag m)).θ ∧
      A'.matrix = (slotCoeff u : ℚ) • (A.vtag (tag m)).C ∧
      A'.quadratic = slotCoeff u * (A.vtag (tag m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom catu m) m) y =
          quadraticChartAtom A' y := by
    intro m hm
    obtain ⟨h, hM⟩ := hmemF m hm
    obtain ⟨A', hA', -, hθ, hMat, hq', he⟩ := catAtom_chart catu u hT (n := m) h
      (hav _ _ hM)
    have htm : tag m = (catu[(m : ℕ)]).tag := dite_eq_left_of_eq_true (eq_true h)
    rw [htm]
    refine ⟨A', hA', hθ, hMat, hq', ?_⟩
    rw [← he]
    exact augPhys_fitColumn_ae (catAtom_admissible catu m I) m
  have hXu' : X u =
      ∑ m ∈ F, c m • fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom catu m) m := by
    rw [hXu, ← hce]
  have hp1 : 1 ≤ p := by omega
  rw [ap.Λc_of_mem hI]
  by_cases hp : p < ap.P
  · have hXa' : X a = (xa - catProj A.G ap.Mc hcatA I rH (M ⟨p - 1, by omega⟩) xa) -
        (xa - catProj A.G ap.Mc hcatA I rH (M ⟨p, hp⟩) xa) := by
      rw [hXa, padFam_succ _ hp]
      obtain ⟨p', rfl⟩ : ∃ p', p = p' + 1 := ⟨p - 1, by omega⟩
      rw [padFam_succ _ (by omega)]
      simp only [ContinuousLinearMap.coe_coe, Nat.add_sub_cancel]
      abel
    have h := CellPass.form_band_le (A.adm I hI) (hpass ⟨p - 1, by omega⟩) (hpass ⟨p, hp⟩)
      hua huo hub hao hab hob F c
      (fun m => fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom catu m) m) tag
      (fun m hm => ⟨hMm _ _ (Fin.mk_le_mk.mpr (by omega)) _ (htagF m hm),
        hMm _ _ (Fin.mk_le_mk.mpr (by omega)) _ (htagF m hm)⟩)
      hsrc X hXu' hXa' hSo hSb hXo hXb
    exact h.trans (mul_le_mul_of_nonneg_right hcs (by positivity))
  · have e1 : padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) (p + 1) =
        LinearMap.id := by
      rw [show p + 1 = ap.P + 1 by omega]; exact padFam_top _
    have e2 : padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) p =
        (catProj A.G ap.Mc hcatA I rH (M ⟨p - 1, by omega⟩) :
          ColumnL2 (Fin ap.Mc) →ₗ[ℂ] ColumnL2 (Fin ap.Mc)) := by
      obtain ⟨p', rfl⟩ : ∃ p', p = p' + 1 := ⟨p - 1, by omega⟩
      exact padFam_succ _ (by omega)
    have hXa' : X a = (xa - catProj A.G ap.Mc hcatA I rH (M ⟨p - 1, by omega⟩) xa) - 0 := by
      rw [hXa, e1, e2, sub_zero]
      rfl
    have h := CellPass.form_band_le (A.adm I hI) (hpass ⟨p - 1, by omega⟩)
      (CellPass.zero (A.adm I hI) A.csrc A.Hsrc A.vtag a (M ⟨p - 1, by omega⟩))
      hua huo hub hao hab hob F c
      (fun m => fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom catu m) m) tag
      (fun m hm => ⟨hMm _ _ (Fin.mk_le_mk.mpr (by omega)) _ (htagF m hm),
        hMm _ _ (Fin.mk_le_mk.mpr (by omega)) _ (htagF m hm)⟩)
      hsrc X hXu' hXa' hSo hSb hXo hXb
    refine h.trans ?_
    calc (∑ m ∈ F, ‖c m‖) * ((β + 0) * So * Sb)
        ≤ (∑ m ∈ F, ‖c m‖) * ((β + β) * So * Sb) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
            (by linarith) hSo.le) hSb.le) (Finset.sum_nonneg fun _ _ => norm_nonneg _)
      _ ≤ _ := mul_le_mul_of_nonneg_right hcs (by positivity)

/-! ### Far bands: the complement band above the helper band (blueprint lines 2254-2256) -/

/-- A band strictly inside the pad family is a difference of two residuals. -/
theorem padBand_resid_lt (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin ap.P → A.Vtx → Prop) {q : ℕ} (hq1 : 1 ≤ q) (hq : q < ap.P)
    (v : ColumnL2 (Fin ap.Mc)) :
    padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (q + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) q v =
      (v - catProj A.G ap.Mc cat I r (M ⟨q - 1, by omega⟩) v) -
        (v - catProj A.G ap.Mc cat I r (M ⟨q, hq⟩) v) := by
  rw [padFam_succ _ hq]
  obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
  rw [padFam_succ _ (by omega)]
  simp only [ContinuousLinearMap.coe_coe, Nat.add_sub_cancel]
  abel

/-- The top band of the pad family is a single residual. -/
theorem padBand_resid_top (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin ap.P → A.Vtx → Prop) (v : ColumnL2 (Fin ap.Mc)) :
    padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (ap.P + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) ap.P v =
      (v - catProj A.G ap.Mc cat I r (M ⟨ap.P - 1, by have := ap.hP; omega⟩) v) - 0 := by
  rw [padFam_top, sub_zero]
  have e2 : padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) ap.P =
      (catProj A.G ap.Mc cat I r (M ⟨ap.P - 1, by have := ap.hP; omega⟩) :
        ColumnL2 (Fin ap.Mc) →ₗ[ℂ] ColumnL2 (Fin ap.Mc)) := by
    have := ap.hP
    unfold padFam
    split_ifs with h1 h2
    · omega
    · rfl
    · omega
  rw [e2]
  rfl

/-- The normalized size of a band of a pad family of catalog projections. -/
theorem padBand_size (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin ap.P → A.Vtx → Prop) (hMm : ∀ i j : Fin ap.P, i ≤ j → ∀ x, M i x → M j x)
    {q : ℕ} (hq : q ≤ ap.P) (v : ColumnL2 (Fin ap.Mc)) {S : ℝ}
    (hS : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ S) :
    eLpNorm (augPhys (padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (q + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) q v)) 2
      (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1)) ≤
      ENNReal.ofReal S := by
  refine (augPhys_normalized_le A.G I _).trans (ENNReal.ofReal_le_ofReal ?_)
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  refine le_trans (div_le_div_of_nonneg_right ?_ hsq.le) hS
  rcases Nat.lt_or_ge q ap.P with hq' | hq'
  · exact (ap.padBand_mem cat I r M hMm hq' v).2
  · have hqe : q = ap.P := by omega
    subst hqe
    rw [ap.padBand_resid_top cat I r M v, sub_zero]
    refine (norm_sub_le _ _).trans ?_
    have := norm_catProj_le A.G ap.Mc cat I r (M ⟨ap.P - 1, by have := ap.hP; omega⟩) v
    linarith

/-- Blueprint lines 2254-2256 (a far band pair with the complement band higher: "expand instead
the lower-rank primal source in position `d` ... a near source lies in both masks of the higher
`c` residual band; the main test applies, keeping the entire lower helper band as an `L²`
spectator. For a far source, expand the helper primal and use the different-tag pair
estimate"): at one cell, with the band `Q_{u,q+1} - Q_{u,q}` of a complement value `v` in slot
`u` (`p + 2 < q`), the helper band of a side value in slot `a`, a combination of pure sources in
slot `o` and a spectator in slot `b`, the form is at most the near part
`(Σ|c|) (2 β) S_a S_b` plus the far part `τ₂ S_v S_b (Σ|c|) (#helper labels) S_a`. -/
theorem far_main_le {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a)
    (huo : u ≠ o) (hub : u ≠ b) (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (catu : List (CatCol A.Vtx)) (r : ℕ) (M : Fin ap.P → A.Vtx → Prop)
    (hMm : ∀ i j : Fin ap.P, i ≤ j → ∀ x, M i x → M j x) (v : ColumnL2 (Fin ap.Mc)) {βm : ℝ}
    (hmain : ∀ k : Fin ap.P, CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag u (M k)
      (v - catProj A.G ap.Mc catu I r (M k) v) βm) (hβm : 0 ≤ βm)
    (hcatA : List (CatCol A.Vtx)) (rH : ℕ) (xa : ColumnL2 (Fin ap.Mc))
    {ι : Type*} (Fo : Finset ι) (co : ι → ℂ) (src : ι → ColumnL2 (Fin ap.Mc)) (tago : ι → A.Vtx)
    (Ys : ι → ℝ → ℂ)
    (hsrc : ∀ m ∈ Fo, ∃ A' : QuadraticChartData (A.vtag (tago m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc A' ∧ A'.horizontal = (A.vtag (tago m)).θ ∧
      A'.matrix = (slotCoeff o : ℚ) • (A.vtag (tago m)).C ∧
      A'.quadratic = slotCoeff o * (A.vtag (tago m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = quadraticChartAtom A' y)
    (hYs : ∀ m ∈ Fo, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = Ys m y)
    {p q : ℕ} (hpq : p + 2 < q) (hqP : q ≤ ap.P) (near : ι → Prop)
    (hnear : ∀ m ∈ Fo, near m → ∀ k : Fin ap.P, q - 1 ≤ k → M k (tago m))
    {τ₂ : ℝ} (hτ₂ : 0 ≤ τ₂) (hfar : ∀ m ∈ Fo, ¬ near m →
      ∀ n ∈ catLabels A.G ap.Mc hcatA I rH (M ⟨p, by omega⟩),
        PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) o a (Ys m)
          (catAtom hcatA n) τ₂)
    (X : Fin 4 → ColumnL2 (Fin ap.Mc))
    (hXa : X a = padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) (p + 1) xa -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) p xa)
    (hXu : X u = padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) (q + 1) v -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) q v)
    (hXo : X o = ∑ m ∈ Fo, co m • src m)
    {Sa Sv Sb : ℝ} (hSa : 0 < Sa) (hSv : 0 < Sv) (hSb : 0 < Sb)
    (hSa' : 2 * ‖xa‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSv' : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sv)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖ap.Λc I X‖ ≤ (∑ m ∈ Fo, ‖co m‖) * ((βm + βm) * Sa * Sb) +
      τ₂ * Sv * Sb * (∑ m ∈ Fo, ‖co m‖) *
        (Real.sqrt (catLabels A.G ap.Mc hcatA I rH (M ⟨p, by omega⟩)).card * Sa) := by
  classical
  have hpP : p < ap.P := by omega
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  rw [ap.Λc_of_mem hI]
  set Λ := cellForm (dyadicGridLength_pos A.G I.1) (A.adm I hI) (Fin ap.Mc)
  -- the spectator sizes
  have hsa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sa := by
    rw [hXa]; exact ap.padBand_size hcatA I rH M hMm hpP.le xa hSa'
  have hsv : eLpNorm (augPhys (X u)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sv := by
    rw [hXu]; exact ap.padBand_size catu I r M hMm hqP v hSv'
  -- the near/far split of the sources
  set Fn := Fo.filter near
  set Ff := Fo.filter fun m => ¬ near m
  have hsplit : X o = (∑ m ∈ Fn, co m • src m) + ∑ m ∈ Ff, co m • src m := by
    rw [hXo, Finset.sum_filter_add_sum_filter_not]
  have hΛ : Λ X = Λ (Function.update X o (∑ m ∈ Fn, co m • src m)) +
      Λ (Function.update X o (∑ m ∈ Ff, co m • src m)) := by
    rw [← Λ.map_update_add, ← hsplit, Function.update_eq_self]
  rw [hΛ]
  refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
  · -- near sources: the main test of slot `u`
    set Y := Function.update X o (∑ m ∈ Fn, co m • src m)
    have hYo : Y o = ∑ m ∈ Fn, co m • src m := Function.update_self _ _ _
    have hYa : Y a = X a := Function.update_of_ne hao _ _
    have hYb : Y b = X b := Function.update_of_ne hob.symm _ _
    have hYu : Y u = X u := Function.update_of_ne huo _ _
    have hFn : ∑ m ∈ Fn, ‖co m‖ ≤ ∑ m ∈ Fo, ‖co m‖ :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        fun _ _ _ => norm_nonneg _
    have hsrcn : ∀ m ∈ Fn, _ := fun m hm => hsrc m (Finset.mem_filter.mp hm).1
    rcases Nat.lt_or_ge q ap.P with hq | hq
    · have hYu' : Y u = (v - catProj A.G ap.Mc catu I r (M ⟨q - 1, by omega⟩) v) -
          (v - catProj A.G ap.Mc catu I r (M ⟨q, hq⟩) v) := by
        rw [hYu, hXu]; exact ap.padBand_resid_lt catu I r M (by omega) hq v
      have h := CellPass.form_band_le (A.adm I hI) (hmain ⟨q - 1, by omega⟩) (hmain ⟨q, hq⟩)
        huo.symm hao.symm hob hua hub hab Fn co src tago
        (fun m hm => ⟨hnear m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 _
          (by simp), hnear m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 _
          (by simp)⟩)
        hsrcn Y hYo hYu' hSa hSb (by rw [hYa]; exact hsa) (by rw [hYb]; exact hXb)
      exact h.trans (mul_le_mul_of_nonneg_right hFn (by positivity))
    · have hqe : q = ap.P := by omega
      have hYu' : Y u = (v - catProj A.G ap.Mc catu I r
          (M ⟨ap.P - 1, by have := ap.hP; omega⟩) v) - 0 := by
        rw [hYu, hXu, hqe]; exact ap.padBand_resid_top catu I r M v
      have h := CellPass.form_band_le (A.adm I hI) (hmain ⟨ap.P - 1, by have := ap.hP; omega⟩)
        (CellPass.zero (A.adm I hI) A.csrc A.Hsrc A.vtag u
          (M ⟨ap.P - 1, by have := ap.hP; omega⟩))
        huo.symm hao.symm hob hua hub hab Fn co src tago
        (fun m hm => ⟨hnear m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 _
          (by simp; omega), hnear m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 _
          (by simp; omega)⟩)
        hsrcn Y hYo hYu' hSa hSb (by rw [hYa]; exact hsa) (by rw [hYb]; exact hXb)
      refine h.trans ?_
      calc (∑ m ∈ Fn, ‖co m‖) * ((βm + 0) * Sa * Sb)
          ≤ (∑ m ∈ Fn, ‖co m‖) * ((βm + βm) * Sa * Sb) :=
            mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
              (by linarith) hSa.le) hSb.le) (Finset.sum_nonneg fun _ _ => norm_nonneg _)
        _ ≤ _ := mul_le_mul_of_nonneg_right hFn (by positivity)
  · -- far sources: the pair estimate against the helper columns
    set Y := Function.update X o (∑ m ∈ Ff, co m • src m)
    have hYo : Y o = ∑ m ∈ Ff, co m • src m := Function.update_self _ _ _
    have hYa : Y a = X a := Function.update_of_ne hao _ _
    have hYb : Y b = X b := Function.update_of_ne hob.symm _ _
    have hYu : Y u = X u := Function.update_of_ne huo _ _
    obtain ⟨hmem, hnorm⟩ := ap.padBand_mem hcatA I rH M hMm hpP xa
    obtain ⟨c', -, -, -, hce⟩ := catRange_expansion hmem
    set Fa := catLabels A.G ap.Mc hcatA I rH (M ⟨p, hpP⟩)
    have hYa' : Y a = ∑ n ∈ Fa, c' n • fitColumn (dyadicGridCell A.G I.1 I.2)
        (catAtom hcatA n) n := by rw [hYa, hXa, ← hce]
    have h := cellForm_pairs_le (A.adm I hI) hao.symm huo.symm hob hua.symm hab hub Ff co src
      Ys (fun m hm => hYs m (Finset.mem_filter.mp hm).1) Fa c'
      (fun n => fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom hcatA n) n)
      (fun n => catAtom hcatA n)
      (fun n _ => augPhys_fitColumn_ae (catAtom_admissible hcatA n I) n)
      (fun m hm n hn => hfar m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 n hn)
      Y hYo hYa' hSv hSb (by rw [hYu]; exact hsv) (by rw [hYb]; exact hXb)
    refine h.trans ?_
    have hFf : ∑ m ∈ Ff, ‖co m‖ ≤ ∑ m ∈ Fo, ‖co m‖ :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        fun _ _ _ => norm_nonneg _
    have hFa : ∑ n ∈ Fa, ‖c' n‖ ≤ Real.sqrt Fa.card * Sa := by
      refine (catCoeff_l1_le (G := A.G) hcatA I Fa c').trans (mul_le_mul_of_nonneg_left ?_
        (Real.sqrt_nonneg _))
      rw [← hce]
      exact (div_le_div_of_nonneg_right hnorm (Real.sqrt_nonneg _)).trans hSa'
    have h0 : 0 ≤ ∑ m ∈ Ff, ‖co m‖ := Finset.sum_nonneg fun _ _ => norm_nonneg _
    have h0' : 0 ≤ ∑ n ∈ Fa, ‖c' n‖ := Finset.sum_nonneg fun _ _ => norm_nonneg _
    have hτSvSb : 0 ≤ τ₂ * Sv * Sb := by positivity
    calc τ₂ * Sv * Sb * (∑ m ∈ Ff, ‖co m‖) * ∑ n ∈ Fa, ‖c' n‖
        ≤ τ₂ * Sv * Sb * (∑ m ∈ Fo, ‖co m‖) * (Real.sqrt Fa.card * Sa) := by
          gcongr

