      volume (dyadicGridCell G T.root.1 T.root.2) := by
  classical
  rw [← measure_biUnion_finset (fun R hR R' hR' hne => ?_)
    (fun R _ => T.measurableSet_mask R _)]
  · exact measure_mono (Set.iUnion₂_subset fun R _ => T.mask_subset_root R _)
  · refine Set.disjoint_left.mpr fun y hy hy' => ?_
    have hr := T.mask_subset_root R _ hy
    have hRF := Finset.mem_filter.mp hR
    have hRF' := Finset.mem_filter.mp hR'
    exact DepthRect.heavy_disjoint (hF R hRF.1) (hRF.2.trans hRF'.2.symm) hne
      ((T.mem_mask_iff hr).mp hy) ((T.mem_mask_iff hr).mp hy')

/-- Within a level, the designated masks are disjoint. -/
theorem sum_desig_mask_le (F : Finset DepthRect) (hF : ∀ R ∈ F, DepthRect.Valid R)
    (key : DepthRect) :
    ∑ R ∈ F.filter (fun R => DepthRect.level R = key), volume (T.mask R (DepthRect.desig R)) ≤
      volume (dyadicGridCell G T.root.1 T.root.2) := by
  classical
  rw [← measure_biUnion_finset (fun R hR R' hR' hne => ?_)
    (fun R _ => T.measurableSet_mask R _)]
  · exact measure_mono (Set.iUnion₂_subset fun R _ => T.mask_subset_root R _)
  · refine Set.disjoint_left.mpr fun y hy hy' => ?_
    have hr := T.mask_subset_root R _ hy
    have hRF := Finset.mem_filter.mp hR
    have hRF' := Finset.mem_filter.mp hR'
    exact DepthRect.desig_disjoint (hF R hRF.1) (hRF.2.trans hRF'.2.symm) hne
      ((T.mem_mask_iff hr).mp hy) ((T.mem_mask_iff hr).mp hy')

theorem volume_mask_le_root (R : DepthRect) (j : Fin 4) :
    volume (T.mask R j) ≤ volume (dyadicGridCell G T.root.1 T.root.2) :=
  measure_mono (T.mask_subset_root R j)

