/-- A residual insertion in slot `r` against the fixed group source in slot `t` (blueprint
line 1853: each residual insertion is tested against that fixed lower-rank source in its
mask). -/
theorem res_le {κ : LocalKernelClass} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft F.G F.I.1 F.I.2)
      (dyadicGridLength F.G F.I.1) wI) {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {mH : ℕ}
    (ls : Fin 4 → List (ℕ × Bool)) {t r a b : Fin 4} (htr : t ≠ r) (hta : t ≠ a)
    (htb : t ≠ b) (hra : r ≠ a) (hrb : r ≠ b) (hab : a ≠ b)
    {τb Sz : ℝ} (hτb : 0 ≤ τb) (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ /
      Real.sqrt (dyadicGridLength F.G F.I.1) ≤ Sz)
    (G : γ) (jr : ℕ) (hmH : (ls r).length ≤ mH)
    (hpass : ∀ pc : Fin F.P × (Fin (ls r).length → Fin F.P),
      (F.test r (F.rkB jr) (F.bm G jr pc.1) (ls r) pc.2).Pass F.G F.Mc F.I c₀ H tagOf wI τb mH
        (F.cat r))
    (Mtop : Tg → Prop) (hMtop : ∀ (p : Fin F.P) x, F.bm G 1 p x → Mtop x)
    (hsrc : ∀ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1) Mtop, ∃ x : Tg,
      F.IsSource c₀ H tagOf t x
        (fitColumn (dyadicGridCell F.G F.I.1 F.I.2) (catAtom (F.cat t) n) n) ∧
      ∀ p : ℕ, F.bm G jr p x)
    (X : Fin 4 → ColumnL2 (Fin F.Mc)) (hXt : X t = F.ball G 1 t (F.input ls t))
    (hXr : X r = F.input ls r - F.ball G jr r (F.input ls r))
    (hXa : ‖X a‖ ≤ ‖physicalColumnInput (V := Fin F.Mc) (F.g a)‖)
    (hXb : ‖X b‖ ≤ ‖physicalColumnInput (V := Fin F.Mc) (F.g b)‖) {Nt : ℝ}
    (hNt : ((catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1) Mtop).card : ℝ) ≤ Nt) :
    ‖cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc) X‖ ≤
      (Real.sqrt Nt * Sz) * (τb * Sz ^ 3) := by
  classical
  obtain ⟨c, hcb, hce⟩ := opAvg_catProj_l2 (G := F.G) (F.cat t) F.I (F.rkB 1)
    (fun p : Fin F.P => F.bm G 1 p) Mtop (fun p x hx => hMtop p x hx) (F.input ls t)
  set Lb := catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1) Mtop
  have hs := Real.sqrt_pos.mpr (dyadicGridLength_pos F.G F.I.1)
  have hB2 : ∑ n ∈ Lb, ‖c n‖ ^ 2 ≤ Sz ^ 2 := by
    have h2 := F.norm_input_le ls t
    have h3 := hSz t
    rw [div_le_iff₀ hs] at h3
    have h4 : ‖F.input ls t‖ ^ 2 ≤ (Sz * Real.sqrt (dyadicGridLength F.G F.I.1)) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) (h2.trans h3) 2
    rw [mul_pow, Real.sq_sqrt (dyadicGridLength_pos F.G F.I.1).le] at h4
    exact le_of_mul_le_mul_right (hcb.trans h4) (dyadicGridLength_pos F.G F.I.1)
  -- the sources indexed by the selected labels
  set tag : Lb → Tg := fun n => Classical.choose (hsrc n.1 n.2) with htagdef
  have htag := fun n : Lb => Classical.choose_spec (hsrc n.1 n.2)
  have hXt' : X t = ∑ n : Lb, c (n : Fin F.Mc) • fitColumn (dyadicGridCell F.G F.I.1 F.I.2)
      (catAtom (F.cat t) (n : Fin F.Mc)) (n : Fin F.Mc) := by
    rw [hXt]
    change opAvg (fun p : Fin F.P => catProj F.G F.Mc (F.cat t) F.I (F.rkB 1) (F.bm G 1 p))
      (F.input ls t) = _
    rw [hce, ← Finset.sum_coe_sort Lb]
  have hB : ∀ pc ∈ (Finset.univ : Finset (Fin F.P × (Fin (ls r).length → Fin F.P))),
      τb * ‖physicalColumnInput (V := Fin F.Mc) (F.g r)‖ /
        Real.sqrt (dyadicGridLength F.G F.I.1) * Sz * Sz ≤ τb * Sz ^ 3 := by
    intro pc _
    have h := hSz r
    rw [mul_div_assoc]
    calc τb * (‖physicalColumnInput (V := Fin F.Mc) (F.g r)‖ /
          Real.sqrt (dyadicGridLength F.G F.I.1)) * Sz * Sz ≤ τb * Sz * Sz * Sz := by gcongr
      _ = τb * Sz ^ 3 := by ring
  have h := CatTest.form_combo_le hwI (Finset.univ : Finset (Fin F.P × (Fin (ls r).length →
      Fin F.P))) ⟨(⟨0, F.hP⟩, fun _ => ⟨0, F.hP⟩), Finset.mem_univ _⟩
    (fun pc => F.test r (F.rkB jr) (F.bm G jr pc.1) (ls r) pc.2) (fun _ => τb)
    (fun pc _ => hpass pc) (fun _ _ => rfl) htr hta htb hra hrb hab Finset.univ
    (fun n : Lb => c (n : Fin F.Mc))
    (fun n : Lb => fitColumn (dyadicGridCell F.G F.I.1 F.I.2) (catAtom (F.cat t) (n : Fin F.Mc))
      (n : Fin F.Mc)) tag
    (fun n _ pc _ => (htag n).2 _) (fun n _ => (htag n).1) X hXt'
    (by rw [hXr]; exact F.ball_resid_eq ls r G jr mH hmH) hSz0 hSz0
    (augPhys_le_of_norm_le F.G F.I hXa (hSz a)) (augPhys_le_of_norm_le F.G F.I hXb (hSz b)) hB
  refine h.trans (mul_le_mul_of_nonneg_right ?_ (by positivity))
  have hsum : ∑ n ∈ Lb, ‖c n‖ ≤ Real.sqrt Nt * Sz :=
    (sum_norm_le_sqrt_card _ c hB2 hSz0.le).trans
      (mul_le_mul_of_nonneg_right (Real.sqrt_le_sqrt hNt) hSz0.le)
  calc ∑ n : Lb, ‖c (n : Fin F.Mc)‖ = ∑ n ∈ Lb, ‖c n‖ :=
        Finset.sum_coe_sort Lb (fun n => ‖c n‖)
    _ ≤ Real.sqrt Nt * Sz := hsum

/-- Blueprint prop:localize at one cell and leaf (lines 1848-1856): the form of the leaf inputs
is the sum over the current groups of the forms of their ball outputs, up to the error of
`leaf_localization` with the old-source, matching, separation and residual bounds. -/
theorem leaf_error {κ : LocalKernelClass} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft F.G F.I.1 F.I.2)
      (dyadicGridLength F.G F.I.1) wI) {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {mH : ℕ}
    (ls : Fin 4 → List (ℕ × Bool)) (hlen : ∀ l, (ls l).length ≤ mH)
    {u t p q : Fin 4} (hut : u ≠ t) (hup : u ≠ p) (huq : u ≠ q) (htp : t ≠ p) (htq : t ≠ q)
    (hpq : p ≠ q) (jr : Fin 4 → ℕ) (hjt : jr t = 1)
    {τo τm τr τ₂ Sz : ℝ} (hτo : 0 ≤ τo) (hτm : 0 ≤ τm) (hτr : 0 ≤ τr) (hτ₂ : 0 ≤ τ₂)
    (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ /
      Real.sqrt (dyadicGridLength F.G F.I.1) ≤ Sz)
    {ι : Type} (S : Finset ι) (a : ι → ℂ) (φ : ι → ColumnL2 (Fin F.Mc)) (tag : ι → Tg)
    (Xs : ι → ℝ → ℂ) (hx : F.input ls u = ∑ v ∈ S, a v • φ v)
    (hsrc : ∀ v ∈ S, F.IsSource c₀ H tagOf u (tag v) (φ v))
    (hXs : ∀ v ∈ S, ∀ᵐ y ∂volume, y ∈ dyadicGridCell F.G F.I.1 F.I.2 → augPhys (φ v) y = Xs v y)
    {γ' : Type} (emb : γ' → γ) (Gs : Finset γ') (grp : ι → Option γ')
    (Mtop : γ → Tg → Prop) (hMtop : ∀ G (p : Fin F.P) x, F.bm G 1 p x → Mtop G x)
    (hold : ∀ v ∈ S, grp v = none → ∃ gl b' : Fin 4, gl ≠ u ∧ gl ≠ t ∧ b' ≠ u ∧ b' ≠ t ∧
      gl ≠ b' ∧ ∃ m : ℕ, ls gl = (ls gl).dropLast ++ [(m, true)] ∧
        (ls gl).dropLast.length ≤ mH ∧
        (∀ pc : Fin F.P × (Fin (ls gl).dropLast.length → Fin F.P),
          (F.test gl (F.rkC m) (F.cm m pc.1) (ls gl).dropLast pc.2).Pass F.G F.Mc F.I c₀ H
            tagOf wI τo mH (F.cat gl)) ∧ ∀ p' : ℕ, F.cm m p' (tag v))
    (hcurM : ∀ v ∈ S, ∀ G₀, grp v = some G₀ → G₀ ∈ Gs ∧ ∀ p' : ℕ, F.bm (emb G₀) 1 p' (tag v))
    (hcurS : ∀ v ∈ S, ∀ G₀, grp v = some G₀ → ∀ G ∈ Gs, G ≠ G₀ →
      ∀ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1) (Mtop (emb G)),
        PairSmall (dyadicGridLeft F.G F.I.1 F.I.2) (dyadicGridLength F.G F.I.1) wI u t (Xs v)
          (catAtom (F.cat t) n) τ₂)
    (hpassM : ∀ G ∈ Gs, ∀ pc : Fin F.P × (Fin (ls t).length → Fin F.P),
      (F.test t (F.rkB (jr t)) (F.bm (emb G) (jr t) pc.1) (ls t) pc.2).Pass F.G F.Mc F.I c₀ H
        tagOf wI τm mH (F.cat t))
    (hpassR : ∀ G ∈ Gs, ∀ l, l ≠ t → ∀ pc : Fin F.P × (Fin (ls l).length → Fin F.P),
      (F.test l (F.rkB (jr l)) (F.bm (emb G) (jr l) pc.1) (ls l) pc.2).Pass F.G F.Mc F.I c₀ H
        tagOf wI τr mH (F.cat l))
    (hressrc : ∀ G ∈ Gs, ∀ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1) (Mtop (emb G)),
      ∃ x : Tg, F.IsSource c₀ H tagOf t x
        (fitColumn (dyadicGridCell F.G F.I.1 F.I.2) (catAtom (F.cat t) n) n) ∧
        ∀ l, l ≠ t → ∀ p' : ℕ, F.bm (emb G) (jr l) p' x) {Nt : ℝ}
    (hNt : ∀ G ∈ Gs,
      ((catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1) (Mtop (emb G))).card : ℝ) ≤ Nt) :
    ‖cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc) (F.input ls) -
      ∑ G ∈ Gs, cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc)
        (fun l => F.ball (emb G) (jr l) l (F.input ls l))‖ ≤
      (∑ v ∈ S, ‖a v‖) * ((Gs.card + 1) * (τo * Sz ^ 3) + τm * Sz ^ 3 +
        Gs.card * (τ₂ * Sz ^ 3 * Real.sqrt Nt)) +
        Gs.card * (3 * ((Real.sqrt Nt * Sz) * (τr * Sz ^ 3))) := by
  set Λ := cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc)
  set x := F.input ls
  set L : γ' → Fin 4 → ColumnL2 (Fin F.Mc) →ₗ[ℂ] ColumnL2 (Fin F.Mc) :=
    fun G l => (F.ball (emb G) (jr l) l).toLinearMap
  have hbx : ∀ G l, ‖L G l (x l)‖ ≤ ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ :=
    fun G l => (F.norm_ball_le _ _ l _).trans (F.norm_input_le ls l)
  have hLt : ∀ G, L G t = (F.ball (emb G) 1 t).toLinearMap := fun G => by
    simp only [L, hjt]
  have hbound := leaf_localization Λ L x hut hup huq htp htq hpq S a φ hx Gs grp
    (εo := τo * Sz ^ 3) (εm := τm * Sz ^ 3) (εs := τ₂ * Sz ^ 3 * Real.sqrt Nt)
    (εr := (Real.sqrt Nt * Sz) * (τr * Sz ^ 3))
    (fun v hv hg => by
      obtain ⟨gl, b', hgu, hgt, hbu, hbt, hgb, m, hls, hmH, hpass, htag⟩ := hold v hv hg
      refine ⟨F.old_le hwI ls hut hgu.symm hbu.symm hgt.symm hbt.symm hgb hτo hSz0 hSz
        (hsrc v hv) hls hmH hpass htag _ (F.norm_input_le ls t), fun G _ => ?_⟩
      exact F.old_le hwI ls hut hgu.symm hbu.symm hgt.symm hbt.symm hgb hτo hSz0 hSz
        (hsrc v hv) hls hmH hpass htag _ (hbx G t))
    (fun v hv G₀ hg => by
      obtain ⟨hG₀, htag⟩ := hcurM v hv G₀ hg
      refine ⟨hG₀, ?_, fun G hG hne => ?_⟩
      · have h := F.match_le (τb := τm) hwI ls hut hup huq htp htq hpq hτm hSz0 hSz (hsrc v hv)
          (emb G₀) 1 (hlen t) (fun pc => by
            have := hpassM G₀ hG₀ pc
            rw [hjt] at this
            exact this) htag
        rw [hLt]
        exact h
      · have h := F.sep_le hwI ls hut hup huq htp htq hpq hτ₂ hSz0 hSz (Xs v) (hXs v hv) (emb G)
          1 (Mtop (emb G)) (hMtop (emb G)) (hcurS v hv G₀ hg G hG hne) (hNt G hG)
        rw [hLt]
        exact h)
    (fun G hG i => by
      have hsrcG : ∀ (r : Fin 4), r ≠ t → ∀ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1)
          (Mtop (emb G)), ∃ x : Tg, F.IsSource c₀ H tagOf t x
            (fitColumn (dyadicGridCell F.G F.I.1 F.I.2) (catAtom (F.cat t) n) n) ∧
            ∀ p' : ℕ, F.bm (emb G) (jr r) p' x := fun r hr n hn => by
        obtain ⟨x, hx1, hx2⟩ := hressrc G hG n hn
        exact ⟨x, hx1, hx2 r hr⟩
      have hLt' : L G t (x t) = F.ball (emb G) 1 t (F.input ls t) := by rw [hLt]; rfl
      fin_cases i
      · change ‖Λ (Function.update (Function.update x t (L G t (x t))) u
          (x u - L G u (x u)))‖ ≤ _
        exact F.res_le hwI ls hut.symm htp htq hup huq hpq hτr hSz0 hSz (emb G) (jr u) (hlen u)
          (hpassR G hG u hut) (Mtop (emb G)) (hMtop (emb G)) (hsrcG u hut) _
          (by rw [Function.update_of_ne hut.symm, Function.update_self]; exact hLt')
          (by rw [Function.update_self]; rfl)
          (by rw [Function.update_of_ne hup.symm, Function.update_of_ne htp.symm]
              exact F.norm_input_le ls p)
          (by rw [Function.update_of_ne huq.symm, Function.update_of_ne htq.symm]
              exact F.norm_input_le ls q) (hNt G hG)
      · change ‖Λ (Function.update (Function.update (Function.update x t (L G t (x t))) u
          (L G u (x u))) p (x p - L G p (x p)))‖ ≤ _
        exact F.res_le hwI ls htp hut.symm htq hup.symm hpq huq hτr hSz0 hSz (emb G) (jr p)
          (hlen p) (hpassR G hG p htp.symm) (Mtop (emb G)) (hMtop (emb G)) (hsrcG p htp.symm) _
          (by rw [Function.update_of_ne htp, Function.update_of_ne hut.symm,
                Function.update_self]; exact hLt')
          (by rw [Function.update_self]; rfl)
          (by rw [Function.update_of_ne hup, Function.update_self]; exact hbx G u)
          (by rw [Function.update_of_ne hpq.symm, Function.update_of_ne huq.symm,
                Function.update_of_ne htq.symm]
              exact F.norm_input_le ls q) (hNt G hG)
      · change ‖Λ (Function.update (Function.update (Function.update (Function.update x t
          (L G t (x t))) u (L G u (x u))) p (L G p (x p))) q (x q - L G q (x q)))‖ ≤ _
        exact F.res_le hwI ls htq hut.symm htp huq.symm hpq.symm hup hτr hSz0 hSz (emb G)
          (jr q) (hlen q) (hpassR G hG q htq.symm) (Mtop (emb G)) (hMtop (emb G))
          (hsrcG q htq.symm) _
          (by rw [Function.update_of_ne htq, Function.update_of_ne htp,
                Function.update_of_ne hut.symm, Function.update_self]; exact hLt')
          (by rw [Function.update_self]; rfl)
          (by rw [Function.update_of_ne huq, Function.update_of_ne hup, Function.update_self]
              exact hbx G u)
          (by rw [Function.update_of_ne hpq, Function.update_self]; exact hbx G p) (hNt G hG))
    (by positivity) (by positivity) (by positivity)
  exact hbound

end LeafFilters


