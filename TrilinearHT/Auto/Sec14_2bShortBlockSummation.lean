theorem ennreal_position_holder {ι : Type*} (s : Finset ι) (x y : ι → ℝ≥0∞) {p : ℝ}
    (hp : 2 < p) :
    ∑ i ∈ s, x i ^ (1 / p) * y i ^ (1 / p) ≤ (s.card : ℝ≥0∞) ^ (1 - 2 / p) *
      ((∑ i ∈ s, x i) ^ (1 / 2 : ℝ) * (∑ i ∈ s, y i) ^ (1 / 2 : ℝ)) ^ (2 / p) := by
  have hp0 : 0 < p := by linarith
  have h1 : 1 < p / 2 := by linarith
  have hH := Real.HolderConjugate.conjExponent h1
  set f : ι → ℝ≥0∞ := fun i => (x i ^ (1 / 2 : ℝ) * y i ^ (1 / 2 : ℝ)) ^ (2 / p)
  have hf : ∀ i, x i ^ (1 / p) * y i ^ (1 / p) = f i := by
    intro i
    simp only [f]
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
    congr 2 <;> field_simp
  simp_rw [hf]
  have h := ENNReal.inner_le_Lp_mul_Lq s f (fun _ => 1) hH
  simp only [mul_one, ENNReal.one_rpow, Finset.sum_const, nsmul_eq_mul] at h
  have hconj : 1 / Real.conjExponent (p / 2) = 1 - 2 / p := by
    unfold Real.conjExponent; field_simp
  have hfp : ∀ i, f i ^ (p / 2) = x i ^ (1 / 2 : ℝ) * y i ^ (1 / 2 : ℝ) := by
    intro i; simp only [f]; rw [← ENNReal.rpow_mul]; field_simp; simp
  simp_rw [hfp] at h
  rw [hconj, show 1 / (p / 2) = 2 / p by field_simp] at h
  refine h.trans ?_
  rw [mul_comm]
  gcongr
  exact ennreal_sum_sqrt_mul_le s x y

