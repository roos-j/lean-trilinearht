/-- An averaged target residual of passing tests (each with the source tag in its mask) bounds
the cell form with a pure source and two spectators (blueprint lines 1813, 1850-1852: the
tests hold for every individual pad choice, hence for averages). -/
theorem CatTest.form_avg_le {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {I : ℤ × ℤ}
    {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {wI : ℝ × ℝ → ℂ} {mH : ℕ}
    {cat : List (CatCol Tg)} {κ : LocalKernelClass}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (tests : ι → CatTest Tg) (τ : ι → ℝ)
    (hpass : ∀ i ∈ s, (tests i).Pass G Mc I c₀ H tagOf wI (τ i) mH cat)
    {r : Fin 4} (hr : ∀ i ∈ s, (tests i).t = r) {x : Tg} (hx : ∀ i ∈ s, (tests i).M x)
    {u a b : Fin 4} (hur : u ≠ r) (hua : u ≠ a) (hub : u ≠ b) (hra : r ≠ a) (hrb : r ≠ b)
    (hab : a ≠ b)
    (A : QuadraticChartData (tagOf x).dim) (hA : QuadraticChartComplexity c₀ H A)
    (hAθ : A.horizontal = (tagOf x).θ) (hAM : A.matrix = (slotCoeff u : ℚ) • (tagOf x).C)
    (hAq : A.quadratic = slotCoeff u * (tagOf x).lam)
    (X : Fin 4 → ColumnL2 (Fin Mc))
    (hXu : ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → augPhys (X u) y = quadraticChartAtom A y)
    (hXr : X r = ((s.card : ℂ))⁻¹ • ∑ i ∈ s, (tests i).resid G Mc I mH cat)
    {Sa Sb B : ℝ} (hSa : 0 < Sa) (hSb : 0 < Sb)
    (hXa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sa)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sb)
    (hB : ∀ i ∈ s, τ i * ‖physicalColumnInput (V := Fin Mc) (tests i).g‖ /
      Real.sqrt (dyadicGridLength G I.1) * Sa * Sb ≤ B) :
    ‖cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc) X‖ ≤ B := by
  have hXe : X = Function.update X r (((s.card : ℂ))⁻¹ •
      ∑ i ∈ s, (tests i).resid G Mc I mH cat) := by
    rw [← hXr, Function.update_eq_self]
  rw [hXe]
  refine norm_map_update_avg_le _ X r s hs _ fun i hi => ?_
  refine le_trans ?_ (hB i hi)
  have hti := hr i hi
  refine (tests i).form_le (hpass i hi) hwI (hx i hi) (by rw [hti]; exact hur) hua hub
    (by rw [hti]; exact hra) (by rw [hti]; exact hrb) hab A hA hAθ hAM hAq _ ?_ ?_ hSa hSb ?_ ?_
  · rw [Function.update_of_ne hur]; exact hXu
  · rw [hti, Function.update_self]
  · rw [Function.update_of_ne hra.symm]; exact hXa
  · rw [Function.update_of_ne hrb.symm]; exact hXb

/-- A combination of pure sources in slot `u` against an averaged test residual in slot `r`
(each source tag in all test masks) with two spectators (blueprint lines 1850-1855). -/
theorem CatTest.form_combo_le {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {I : ℤ × ℤ}
    {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {wI : ℝ × ℝ → ℂ} {mH : ℕ}
    {cat : List (CatCol Tg)} {κ : LocalKernelClass}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (tests : ι → CatTest Tg) (τ : ι → ℝ)
    (hpass : ∀ i ∈ s, (tests i).Pass G Mc I c₀ H tagOf wI (τ i) mH cat)
    {r : Fin 4} (hr : ∀ i ∈ s, (tests i).t = r)
    {u a b : Fin 4} (hur : u ≠ r) (hua : u ≠ a) (hub : u ≠ b) (hra : r ≠ a) (hrb : r ≠ b)
    (hab : a ≠ b) {κs : Type*} (F : Finset κs) (c : κs → ℂ) (src : κs → ColumnL2 (Fin Mc))
    (tag : κs → Tg) (htag : ∀ m ∈ F, ∀ i ∈ s, (tests i).M (tag m))
    (hsrc : ∀ m ∈ F, ∃ A : QuadraticChartData (tagOf (tag m)).dim,
      QuadraticChartComplexity c₀ H A ∧ A.horizontal = (tagOf (tag m)).θ ∧
      A.matrix = (slotCoeff u : ℚ) • (tagOf (tag m)).C ∧
      A.quadratic = slotCoeff u * (tagOf (tag m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → augPhys (src m) y = quadraticChartAtom A y)
    (X : Fin 4 → ColumnL2 (Fin Mc)) (hXu : X u = ∑ m ∈ F, c m • src m)
    (hXr : X r = ((s.card : ℂ))⁻¹ • ∑ i ∈ s, (tests i).resid G Mc I mH cat)
    {Sa Sb B : ℝ} (hSa : 0 < Sa) (hSb : 0 < Sb)
    (hXa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sa)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sb)
    (hB : ∀ i ∈ s, τ i * ‖physicalColumnInput (V := Fin Mc) (tests i).g‖ /
      Real.sqrt (dyadicGridLength G I.1) * Sa * Sb ≤ B) :
    ‖cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc) X‖ ≤ (∑ m ∈ F, ‖c m‖) * B := by
  set Λ := cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc)
  have hXe : X = Function.update X u (∑ m ∈ F, c m • src m) := by
    rw [← hXu, Function.update_eq_self]
  rw [hXe, Λ.map_update_sum, Finset.sum_mul]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m hm => ?_)
  rw [Λ.map_update_smul, smul_eq_mul, norm_mul]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
  obtain ⟨A, hA, hAθ, hAM, hAq, hAe⟩ := hsrc m hm
  exact CatTest.form_avg_le hwI s hs tests τ hpass hr (fun i hi => htag m hm i hi) hur hua hub
    hra hrb hab A hA hAθ hAM hAq _ (by rw [Function.update_self]; exact hAe)
    (by rw [Function.update_of_ne hur.symm]; exact hXr) hSa hSb
    (by rw [Function.update_of_ne hua.symm]; exact hXa)
    (by rw [Function.update_of_ne hub.symm]; exact hXb) hB

namespace LeafFilters
variable {Tg γ : Type*} (F : LeafFilters Tg γ)

/-- The averaged ball filter of group `G` at level `j` in slot `l`. -/
noncomputable def ball (G : γ) (j : ℕ) (l : Fin 4) :
    ColumnL2 (Fin F.Mc) →L[ℂ] ColumnL2 (Fin F.Mc) :=
  opAvg fun p : Fin F.P => catProj F.G F.Mc (F.cat l) F.I (F.rkB j) (F.bm G j p)

theorem norm_input_le (ls : Fin 4 → List (ℕ × Bool)) (l : Fin 4) :
    ‖F.input ls l‖ ≤ ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ := by
  unfold input
  refine norm_layerOp_apply_le _ (fun m x => ?_) (fun m x => ?_) _ _
  · exact norm_opAvg_apply_le _ (fun _ y => norm_catProj_le _ _ _ _ _ _ y) x
  · exact norm_id_sub_opAvg_apply_le F.hP _
      (fun _ y => norm_catProj_complement_le _ _ _ _ _ _ y) x

theorem norm_ball_le (G : γ) (j : ℕ) (l : Fin 4) (x : ColumnL2 (Fin F.Mc)) :
    ‖F.ball G j l x‖ ≤ ‖x‖ :=
  norm_opAvg_apply_le _ (fun _ y => norm_catProj_le _ _ _ _ _ _ y) x

/-- A ball residual of a slot input is an average of single-choice test residuals. -/
theorem ball_resid_eq (ls : Fin 4 → List (ℕ × Bool)) (l : Fin 4) (G : γ) (j : ℕ) (mH : ℕ)
    (hmH : (ls l).length ≤ mH) :
    F.input ls l - F.ball G j l (F.input ls l) =
      (((Finset.univ : Finset (Fin F.P × (Fin (ls l).length → Fin F.P))).card : ℂ))⁻¹ •
        ∑ pc : Fin F.P × (Fin (ls l).length → Fin F.P),
          (F.test l (F.rkB j) (F.bm G j pc.1) (ls l) pc.2).resid F.G F.Mc F.I mH (F.cat l) :=
  residual_layerOp_eq_avg F.G F.Mc F.I (F.cat l) F.hP F.rkC F.cm l (F.rkB j)
    (fun p => F.bm G j p) (ls l) mH hmH (F.g l)

/-- A lower guard input, ending with the residual filter at `m`, is an average of single-choice
test residuals of the cumulative mask at `m`. -/
theorem guard_resid_eq (ls : Fin 4 → List (ℕ × Bool)) (l : Fin 4) {ls' : List (ℕ × Bool)}
    {m : ℕ} (hls : ls l = ls' ++ [(m, true)]) (mH : ℕ) (hmH : ls'.length ≤ mH) :
    F.input ls l =
      (((Finset.univ : Finset (Fin F.P × (Fin ls'.length → Fin F.P))).card : ℂ))⁻¹ •
        ∑ pc : Fin F.P × (Fin ls'.length → Fin F.P),
          (F.test l (F.rkC m) (F.cm m pc.1) ls' pc.2).resid F.G F.Mc F.I mH (F.cat l) := by
  have h := residual_layerOp_eq_avg F.G F.Mc F.I (F.cat l) F.hP F.rkC F.cm l (F.rkC m)
    (fun p => F.cm m p) ls' mH hmH (F.g l)
  simp only at h
  refine Eq.trans ?_ h
  unfold input
  rw [hls, layerOp_append]
  rfl

