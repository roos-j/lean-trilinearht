      exact le_of_mul_le_mul_right (hcb.trans h4) (dyadicGridLength_pos F.G F.I.1)
    refine (sum_norm_le_sqrt_card _ c hB hSz0.le).trans ?_
    exact mul_le_mul_of_nonneg_right (Real.sqrt_le_sqrt hNt) hSz0.le
  have h := cellForm_pair_le hwI hut hua hub hta htb hab
    (catLabels F.G F.Mc (F.cat t) F.I (F.rkB j) Mtop) c
    (fun n => fitColumn (dyadicGridCell F.G F.I.1 F.I.2) (catAtom (F.cat t) n) n)
    (fun n => catAtom (F.cat t) n)
    (fun n _ => augPhys_fitColumn_ae (catAtom_admissible (F.cat t) n F.I) n) Xs hsep X
