/-- The size of a vector whose norm is at most that of a base input. -/
theorem augPhys_le_of_norm_le {Mc : ℕ} (G : RealDyadicGrid) (I : ℤ × ℤ) {x : ColumnL2 (Fin Mc)}
    {g : Lp ℂ 2 (volume : Measure ℝ)} {Sz : ℝ}
    (hx : ‖x‖ ≤ ‖physicalColumnInput (V := Fin Mc) g‖)
    (hSz : ‖physicalColumnInput (V := Fin Mc) g‖ / Real.sqrt (dyadicGridLength G I.1) ≤ Sz) :
    eLpNorm (augPhys x) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sz := by
  refine (augPhys_normalized_le G I x).trans (ENNReal.ofReal_le_ofReal ?_)
  have hs := Real.sqrt_pos.mpr (dyadicGridLength_pos G I.1)
  exact (div_le_div_of_nonneg_right hx hs.le).trans hSz

