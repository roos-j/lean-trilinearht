theorem bbase_one_le {j : ℕ} (hj : 2 ≤ j) : ap.bbase 1 + ap.P ≤ ap.bbase j := by
  unfold bbase
  have : 10 * 1 * ap.P ≤ 10 * (j - 1) * ap.P := by
    apply Nat.mul_le_mul_right; omega
  omega

open Classical in
/-- Blueprint prop:localize at one active cell and one leaf: given an expansion of the upper guard
in pure bounded charts of vertices of its cumulative mask, the leaf form is the sum over the
current groups of the forms of their ball outputs, up to the errors of `leaf_error`. -/
theorem leaf_bound (cat : Fin 4 → List (CatCol A.Vtx))
    (hT : ∀ l, ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag)
    {τ : ℕ → ℝ} {I : ℤ × ℤ} (hI : I ∈ A.cells)
    (hpass : ∀ l (w : ap.TestIdx I l), (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc
      A.Hsrc A.vtag (A.w I) (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l))
    (hsucc : ∀ w ∈ A.admT.X (A.admAt I),
      ap.K.Success (ap.K.colorData (A.admT.st (A.admAt I)) w))
    (hL1 : 1 ≤ ap.Lc) (hfuel : ap.Lc - 1 < 2 ^ ap.fuel) (hmH : ap.fuel ≤ ap.mH)
    (hPH : ap.bbase 1 + ap.P ≤ ap.Hmax) (s : Fin ap.leaves.length)
    {τo τm τr τ₂ Sz Nt : ℝ} (hτo : 0 ≤ τo) (hτm : 0 ≤ τm) (hτr : 0 ≤ τr) (hτ₂ : 0 < τ₂)
    (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ ap.Hed)
    (hτo' : τ (ap.Lc - ((leafAt ap.fuel ap.Lc ap.up₀ s).k - 1) + 1) ≤ τo)
    (hτm' : τ (ap.Lc + 1) ≤ τm) (hτr' : ∀ j, 2 ≤ j → j ≤ 4 → τ (ap.Lc + j) ≤ τr)
    (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
      Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    {ι : Type} (S : Finset ι) (a : ι → ℂ) (φ : ι → ColumnL2 (Fin ap.Mc))
    (hx : (ap.filters cat I).input (leafAt ap.fuel ap.Lc ap.up₀ s).layers
      (leafAt ap.fuel ap.Lc ap.up₀ s).up = ∑ v ∈ S, a v • φ v)
    (hsrc : ∀ v ∈ S, ∃ (x : A.Vtx) (hpad : ℕ),
      hpad ≤ ap.cbase (leafAt ap.fuel ap.Lc ap.up₀ s).k + ap.P ∧
      x ∈ ap.K.cumMask A.admT A.vtxBound (leafAt ap.fuel ap.Lc ap.up₀ s).k hpad (A.admAt I) ∧
      ∃ Ax : QuadraticChartData (A.vtag x).dim, QuadraticChartComplexity A.csrc A.Hsrc Ax ∧
        IsBoundedQuadraticChart Ax ∧ Ax.horizontal = (A.vtag x).θ ∧
        Ax.matrix = (slotCoeff (leafAt ap.fuel ap.Lc ap.up₀ s).up : ℚ) • (A.vtag x).C ∧
        Ax.quadratic = slotCoeff (leafAt ap.fuel ap.Lc ap.up₀ s).up * (A.vtag x).lam ∧
        ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (φ v) y = quadraticChartAtom Ax y)
    (hNt : ∀ G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k,
      ((catLabels A.G ap.Mc (cat (thirdSlot (leafAt ap.fuel ap.Lc ap.up₀ s).up
        (leafAt ap.fuel ap.Lc ap.up₀ s).low)) I (ap.Lc + 1)
          (fun y => ∃ p : Fin ap.P, ap.bmask I G 1 p y)).card : ℝ) ≤ Nt) :
    ‖cellForm (dyadicGridLength_pos A.G I.1) (A.adm I hI) (Fin ap.Mc)
        ((ap.filters cat I).input (leafAt ap.fuel ap.Lc ap.up₀ s).layers) -
      ∑ G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k,
        cellForm (dyadicGridLength_pos A.G I.1) (A.adm I hI) (Fin ap.Mc)
          (fun l => (ap.filters cat I).ball G ((leafAt ap.fuel ap.Lc ap.up₀ s).role l) l
            ((ap.filters cat I).input (leafAt ap.fuel ap.Lc ap.up₀ s).layers l))‖ ≤
      (∑ v ∈ S, ‖a v‖) * (((ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k).card + 1) *
          (τo * Sz ^ 3) + τm * Sz ^ 3 +
          (ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k).card *
            (τ₂ * Sz ^ 3 * Real.sqrt Nt)) +
        (ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k).card *
          (3 * ((Real.sqrt Nt * Sz) * (τr * Sz ^ 3))) := by
  set L := leafAt ap.fuel ap.Lc ap.up₀ s with hLdef
  set F := ap.filters cat I
  have hsL : (s : ℕ) < (searchList ap.fuel ap.Lc ap.up₀).length := s.2
  obtain ⟨-, hk1, hkL, hinv⟩ := leafAt_facts hL1 hfuel hsL
  obtain ⟨hlowup, -, hlow⟩ := hinv
  set u := L.up
  set t := thirdSlot u L.low
  obtain ⟨htu, hlt⟩ := thirdSlot_ne u L.low
  have hut : u ≠ t := Ne.symm htu
  obtain ⟨hpu, hpt, hqu, hqt, hpq⟩ := otherTwo_spec u t hut
  have hlen : ∀ l, (L.layers l).length ≤ ap.mH := fun l => by
    have := searchLeaves_layers_length ap.fuel 1 ap.Lc ap.up₀ none (fun _ => []) L
      (leafAt_mem hsL) l
    simp only [List.length_nil, zero_add] at this
    omega
  have hHmax : ap.cbase L.k + ap.P ≤ ap.Hmax :=
    (ap.cbase_le_bbase L.k 1).trans (le_trans (Nat.le_add_right _ _) hPH)
  -- the source data
  have hsrc' : ∀ v : S, ∃ (x : A.Vtx) (hpad : ℕ), hpad ≤ ap.cbase L.k + ap.P ∧
      x ∈ ap.K.cumMask A.admT A.vtxBound L.k hpad (A.admAt I) ∧
      ∃ Ax : QuadraticChartData (A.vtag x).dim, QuadraticChartComplexity A.csrc A.Hsrc Ax ∧
        IsBoundedQuadraticChart Ax ∧ Ax.horizontal = (A.vtag x).θ ∧
        Ax.matrix = (slotCoeff u : ℚ) • (A.vtag x).C ∧
        Ax.quadratic = slotCoeff u * (A.vtag x).lam ∧
        ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (φ v) y = quadraticChartAtom Ax y :=
    fun v => hsrc v v.2
  choose X hpad hpadle hXm Ax hAx hAb hθ hM hq hae using hsrc'
  set Gs := ap.groupsAt I L.k
  set Mtop : A.Grp → A.Vtx → Prop := fun G y => ∃ p : Fin ap.P, ap.bmask I G 1 p y
  set grp : S → Option A.Grp := fun v =>
    if h : ∃ G ∈ Gs, ∀ p' : ℕ, ap.bmask I G 1 p' (X v) then some (Classical.choose h) else none
  have hgrp : ∀ v G₀, grp v = some G₀ → G₀ ∈ Gs ∧ ∀ p' : ℕ, ap.bmask I G₀ 1 p' (X v) := by
    intro v G₀ hg
    by_cases h : ∃ G ∈ Gs, ∀ p' : ℕ, ap.bmask I G 1 p' (X v)
    · have e : grp v = some (Classical.choose h) := dite_eq_left_of_eq_true (eq_true h)
      rw [e, Option.some_inj] at hg
      subst hg
      exact Classical.choose_spec h
    · have e : grp v = none := dite_eq_right_of_eq_false (eq_false h)
      rw [e] at hg; exact absurd hg (by simp)
  have hx' : F.input L.layers u = ∑ v ∈ S.attach, a v • φ v := by
    rw [Finset.sum_attach S (fun v => a v • φ v)]; exact hx
  have h := F.leaf_error (A.adm I hI) (c₀ := A.csrc) (H := A.Hsrc) (tagOf := A.vtag)
    (mH := ap.mH) L.layers hlen hut hpu.symm hqu.symm hpt.symm hqt.symm hpq L.role L.role_t
    hτo hτm hτr hτ₂.le hSz0 hSz S.attach (fun v => a v) (fun v => φ v) X
    (fun v => quadraticChartAtom (Ax v)) hx'
    (fun v _ => ⟨Ax v, hAx v, hθ v, hM v, hq v, hae v⟩) (fun v _ => hae v) id Gs grp Mtop
    (fun G p y hy => ⟨p, hy⟩)
    (fun v _ hg => by
      have hnot : ¬ ∃ G ∈ Gs, ∀ p' : ℕ, ap.bmask I G 1 p' (X v) := by
        intro hc
        have e : grp v = some (Classical.choose hc) := dite_eq_left_of_eq_true (eq_true hc)
        rw [e] at hg; exact absurd hg (by simp)
      rcases ap.classify I hsucc hk1 hkL (hpadle v) ((hpadle v).trans hHmax) (hXm v) with
        hold | hcur
      · rcases hlow with ⟨-, hℓ⟩ | ⟨g, ls', hg', hlg, -⟩
        · exfalso
          obtain ⟨-, w, hw, hc, -⟩ := hold 0
          have := (ap.K.color_mem A.admT A.admT_X_card_le hw).1
          have : L.k = 1 := hℓ
          omega
        · have hgu : g ≠ u := fun he => hlowup (hg'.trans (congrArg some he))
          have hgt : g ≠ t := fun he => hlt (hg'.trans (congrArg some he))
          obtain ⟨b', hbu, hbt, hgb⟩ := fin4_fourth u t g hut hgu hgt
          refine ⟨g, b', hgu, hgt, hbu, hbt, hgb, L.k - 1, ?_, ?_, fun pc => ?_, hold⟩
          · rw [hlg, List.dropLast_concat]
          · rw [List.length_dropLast]; have := hlen g; omega
          · exact CatTest.pass_mono _ (hpass g (Sum.inl ⟨s, Sum.inl pc⟩)) hτo'
      · exact absurd hcur hnot)
    (fun v _ G₀ hg => hgrp v G₀ hg)
    (fun v _ G₀ hg G hG hne n hn => by
      obtain ⟨hG₀, hxG₀⟩ := hgrp v G₀ hg
      exact ap.sep_pair hI hsucc hG₀ hG hne hPH hτ₂ hτ₂1 hHed hut (hxG₀ 0) (Ax v) (hAx v)
        (hAb v) (hθ v) (hM v) (hq v) (cat t) (hT t) hn (A.adm I hI))
    (fun G hG pc => by
      refine CatTest.pass_mono _ (hpass t (Sum.inl ⟨s, Sum.inr (⟨G, hG⟩, pc.1, pc.2)⟩)) ?_
      change τ (ap.Lc + L.role t) ≤ τm
      rw [L.role_t]; exact hτm')
    (fun G hG l hl pc => by
      refine CatTest.pass_mono _ (hpass l (Sum.inl ⟨s, Sum.inr (⟨G, hG⟩, pc.1, pc.2)⟩)) ?_
      exact hτr' _ (L.role_ge hl) (L.role_le l))
    (fun G _ n hn => by
      obtain ⟨x, ⟨p, hp⟩, hxs⟩ := ap.catColumn_source cat t (hT t) I
        (M := Mtop G) (fun y ⟨_, hp⟩ => ap.bmask_present hp) hn
      refine ⟨x, hxs, fun l hl p' => ?_⟩
      have h1 := ap.bbase_one_le (L.role_ge hl)
      have h2 := p.2
      exact ColorSetup.mask_mono_pad _ _ A.vtxBound (by omega) hp)
    hNt
  rw [Finset.sum_attach S (fun v => ‖a v‖)] at h
  exact h

end AttemptParams

