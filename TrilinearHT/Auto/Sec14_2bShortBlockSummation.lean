/-- Blueprint lines 2353-2357: the exponents `p_* = 2q - 2` and `p = 2p_*/(p_* - 2)` exceed `q`
for `2 < q < 3`, their reciprocals over the four slots sum to one, and the heavy block factor
`A^{1-2/p_*} (K+2)^{1-2/p_*}` with `A = K + 2` is `(K+2)^{2(q-2)/(q-1)}`. -/
theorem shortblock_exponents {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) (K : ℝ) (hK : 0 ≤ K) :
    q < 2 * q - 2 ∧ q < 2 * (2 * q - 2) / (2 * q - 2 - 2) ∧
      2 / (2 * q - 2) + 2 * ((2 * q - 2 - 2) / (2 * (2 * q - 2))) = 1 ∧
      (K + 2) ^ (1 - 2 / (2 * q - 2)) * (K + 2) ^ (1 - 2 / (2 * q - 2)) =
        (K + 2) ^ (2 * (q - 2) / (q - 1)) := by
  have h1 : 0 < 2 * q - 2 - 2 := by linarith
  have h2 : 2 * q - 2 ≠ 0 := by linarith
  have h3 : q - 1 ≠ 0 := by linarith
  have h4 : 2 * q - 2 - 2 ≠ 0 := h1.ne'
  refine ⟨by linarith, ?_, ?_, ?_⟩
  · rw [lt_div_iff₀ h1]; nlinarith
  · field_simp; ring
  · rw [← Real.rpow_add (by linarith)]
    congr 1
    field_simp
    ring

/-- Concavity of `z ↦ z^θ` on a finite sum: `Σ_{i<J} z_i^θ ≤ J^{1-θ} (Σ z_i)^θ` for
`0 < θ ≤ 1`. -/
theorem sum_rpow_le_card_rpow {ι : Type*} (s : Finset ι) (z : ι → ℝ) (hz : ∀ i ∈ s, 0 ≤ z i)
    {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ ≤ 1) :
    ∑ i ∈ s, z i ^ θ ≤ (s.card : ℝ) ^ (1 - θ) * (∑ i ∈ s, z i) ^ θ := by
  have hp : 1 ≤ 1 / θ := by rw [le_div_iff₀ hθ]; linarith
  have h := Real.rpow_sum_le_const_mul_sum_rpow_of_nonneg s hp
    (f := fun i => z i ^ θ) (fun i hi => Real.rpow_nonneg (hz i hi) θ)
  have hzz : ∀ i ∈ s, (z i ^ θ) ^ (1 / θ) = z i := fun i hi => by
    rw [← Real.rpow_mul (hz i hi), mul_one_div_cancel hθ.ne', Real.rpow_one]
  rw [Finset.sum_congr rfl hzz] at h
  have hS0 : 0 ≤ ∑ i ∈ s, z i ^ θ := Finset.sum_nonneg fun i hi => Real.rpow_nonneg (hz i hi) θ
  have hZ0 : 0 ≤ ∑ i ∈ s, z i := Finset.sum_nonneg hz
  have hc0 : (0 : ℝ) ≤ s.card := Nat.cast_nonneg _
  calc ∑ i ∈ s, z i ^ θ = ((∑ i ∈ s, z i ^ θ) ^ (1 / θ)) ^ θ := by
        rw [← Real.rpow_mul hS0, one_div_mul_cancel hθ.ne', Real.rpow_one]
    _ ≤ ((s.card : ℝ) ^ (1 / θ - 1) * ∑ i ∈ s, z i) ^ θ :=
        Real.rpow_le_rpow (Real.rpow_nonneg hS0 _) h hθ.le
    _ = (s.card : ℝ) ^ (1 - θ) * (∑ i ∈ s, z i) ^ θ := by
        rw [Real.mul_rpow (Real.rpow_nonneg hc0 _) hZ0, ← Real.rpow_mul hc0]
        congr 2
        field_simp

/-- Blueprint line 2362: with designated disjointness `Σ_ι |E_{a,ι}| ≤ |R|`,
`Σ_ι |E_{b,ι}| ≤ |R|` and `p ≥ 2`, `Σ_ι |E_{a,ι}|^{1/p} |E_{b,ι}|^{1/p} ≤ J^{1-2/p} |R|^{2/p}`. -/
theorem position_holder_sum {ι : Type*} (s : Finset ι) (x y : ι → ℝ) (hx : ∀ i ∈ s, 0 ≤ x i)
    (hy : ∀ i ∈ s, 0 ≤ y i) {R p : ℝ} (hp : 2 ≤ p) (hxR : ∑ i ∈ s, x i ≤ R)
    (hyR : ∑ i ∈ s, y i ≤ R) :
    ∑ i ∈ s, x i ^ (1 / p) * y i ^ (1 / p) ≤ (s.card : ℝ) ^ (1 - 2 / p) * R ^ (2 / p) := by
  have hp0 : 0 < p := by linarith
  have hθ : 0 < 2 / p := by positivity
  have hθ1 : 2 / p ≤ 1 := by rw [div_le_one hp0]; exact hp
  have hR : 0 ≤ R := (Finset.sum_nonneg hx).trans hxR
  have hpt : ∀ i ∈ s, x i ^ (1 / p) * y i ^ (1 / p) ≤ (x i ^ (2 / p) + y i ^ (2 / p)) / 2 := by
    intro i hi
    have e1 : x i ^ (2 / p) = (x i ^ (1 / p)) ^ 2 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (hx i hi)]; congr 1; push_cast; ring
    have e2 : y i ^ (2 / p) = (y i ^ (1 / p)) ^ 2 := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul (hy i hi)]; congr 1; push_cast; ring
    rw [e1, e2]
    nlinarith [sq_nonneg (x i ^ (1 / p) - y i ^ (1 / p))]
  have hX := sum_rpow_le_card_rpow s x hx hθ hθ1
  have hY := sum_rpow_le_card_rpow s y hy hθ hθ1
  have hXR : (∑ i ∈ s, x i) ^ (2 / p) ≤ R ^ (2 / p) :=
    Real.rpow_le_rpow (Finset.sum_nonneg hx) hxR hθ.le
  have hYR : (∑ i ∈ s, y i) ^ (2 / p) ≤ R ^ (2 / p) :=
    Real.rpow_le_rpow (Finset.sum_nonneg hy) hyR hθ.le
  have hc : 0 ≤ (s.card : ℝ) ^ (1 - 2 / p) := Real.rpow_nonneg (Nat.cast_nonneg _) _
  calc _ ≤ ∑ i ∈ s, (x i ^ (2 / p) + y i ^ (2 / p)) / 2 := Finset.sum_le_sum hpt
    _ = ((∑ i ∈ s, x i ^ (2 / p)) + ∑ i ∈ s, y i ^ (2 / p)) / 2 := by
        rw [← Finset.sum_add_distrib, Finset.sum_div]
    _ ≤ ((s.card : ℝ) ^ (1 - 2 / p) * R ^ (2 / p) + (s.card : ℝ) ^ (1 - 2 / p) * R ^ (2 / p)) / 2
        := by
        gcongr
        · exact hX.trans (mul_le_mul_of_nonneg_left hXR hc)
        · exact hY.trans (mul_le_mul_of_nonneg_left hYR hc)
    _ = _ := by ring

/-- Blueprint lines 2322-2326 (deletion of large windows): `Σ_{e_n > A} e_n ≤ A⁻¹ Σ_n e_n²`. -/
theorem large_window_deletion {ι : Type*} (s : Finset ι) (e : ι → ℝ) {A : ℝ} (hA : 0 < A) :
    ∑ n ∈ s.filter (fun n => A < e n), e n ≤ A⁻¹ * ∑ n ∈ s, e n ^ 2 := by
  classical
  calc ∑ n ∈ s.filter (fun n => A < e n), e n ≤ ∑ n ∈ s.filter (fun n => A < e n), e n ^ 2 / A :=
        Finset.sum_le_sum fun n hn => by
          have h := (Finset.mem_filter.mp hn).2
          rw [le_div_iff₀ hA]; nlinarith
    _ ≤ ∑ n ∈ s, e n ^ 2 / A :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
          fun n _ _ => div_nonneg (sq_nonneg _) hA.le
    _ = A⁻¹ * ∑ n ∈ s, e n ^ 2 := by rw [Finset.mul_sum]; congr 1; ext n; ring

