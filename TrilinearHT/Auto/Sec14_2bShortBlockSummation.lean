/-- The normalized local `L²` norm of a localized interval input. -/
theorem eLpNorm_indicator_intervalInput_le {δ c a r : ℝ} (hδ : 0 < δ) (hc2 : c ≤ 1 / 2)
    (T : Finset ℤ) (G : ℤ → ℂ) (J : Set ℝ) (hJ : MeasurableSet J) :
    eLpNorm (J.indicator (intervalInput δ c T G)) 2 (normalizedIntervalMeasure a r) ≤
      (ENNReal.ofReal r⁻¹ * ∑ m ∈ T.filter
        (fun m : ℤ => (Metric.ball (δ * (m : ℝ)) (c * δ) ∩ J).Nonempty),
          ENNReal.ofReal (2 * (c * δ)) * ‖G m‖ₑ ^ (2 : ℝ)) ^ (1 / 2 : ℝ) := by
  have hm : Measurable (J.indicator (intervalInput δ c T G)) :=
    (measurable_intervalInput δ c T G).indicator hJ
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hm.aestronglyMeasurable]
  simp only [ENNReal.toReal_ofNat]
  gcongr
  unfold normalizedIntervalMeasure
  rw [lintegral_smul_measure, smul_eq_mul]
  gcongr
  calc ∫⁻ y in Set.Icc a (a + r), ‖J.indicator (intervalInput δ c T G) y‖ₑ ^ (2 : ℝ)
      ≤ ∫⁻ y, ‖J.indicator (intervalInput δ c T G) y‖ₑ ^ (2 : ℝ) :=
        setLIntegral_le_lintegral _ _
    _ = ∫⁻ y in J, ‖intervalInput δ c T G y‖ₑ ^ (2 : ℝ) := by
        rw [← lintegral_indicator hJ]
        refine lintegral_congr fun y => ?_
        by_cases hy : y ∈ J
        · simp [hy]
        · simp [hy]
    _ ≤ _ := lintegral_intervalInput_sq_le hδ hc2 T G J hJ

/-- Minkowski's inequality in `L²` for finite sums of nonnegative functions. -/
theorem lintegral_finset_sum_sq_le {α ι : Type*} [MeasurableSpace α] (μ : Measure α)
    (s : Finset ι) (f : ι → α → ℝ≥0∞) (hf : ∀ i, AEMeasurable (f i) μ) :
    (∫⁻ x, (∑ i ∈ s, f i x) ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) ≤
      ∑ i ∈ s, (∫⁻ x, f i x ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    rw [lintegral_congr fun x => ENNReal.zero_rpow_of_pos (by norm_num), lintegral_zero,
      ENNReal.zero_rpow_of_pos (by norm_num)]
  | insert i s hi ih =>
    simp_rw [Finset.sum_insert hi]
    have hs : AEMeasurable (fun x => ∑ k ∈ s, f k x) μ :=
      Finset.aemeasurable_fun_sum _ fun k _ => hf k
    have h := ENNReal.lintegral_Lp_add_le (hf i) hs (by norm_num : (1 : ℝ) ≤ 2)
    exact h.trans (add_le_add le_rfl ih)

namespace BlockData
variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- The localization interval of the second sampling error at a cell. -/
noncomputable def J (I : ℤ × ℤ) : Set ℝ :=
  Set.Icc (D.left I + κ.margin * D.len I - 3 * D.δ) (D.left I + D.len I - κ.margin * D.len I +
    3 * D.δ)

theorem err2_support {I : ℤ × ℤ} (hI : I ∈ D.cells) (z : ℝ × ℝ)
    (hz : D.kernel I z - roundSampledKernel D.δ (D.kernel I) z ≠ 0) (j : Fin 4) :
    realProgressionCoordinate j z ∈ D.J I := by
  have hw := D.admissible I hI
  have hδ := D.δ_pos
  have hsupp : HasLocalProgressionSupport (D.left I + κ.margin * D.len I)
      (D.len I - 2 * (κ.margin * D.len I)) (D.kernel I) := by
    intro z' hz' j'
    have := hw.support z' hz' j'
    rw [Set.mem_Icc]
    unfold left len
    constructor <;> linarith [this.1, this.2]
  by_cases h1 : D.kernel I z = 0
  · rw [h1, zero_sub, neg_ne_zero] at hz
    have h := roundSampled_support hδ hsupp z hz j
    simp only [J, Set.mem_Icc] at h ⊢
    constructor <;> linarith [h.1, h.2]
  · have h := hsupp z h1 j
    simp only [J, Set.mem_Icc] at h ⊢
    constructor <;> linarith [h.1, h.2]

/-- The second sampling error only sees the inputs on `J_I`. -/
theorem err2_local {I : ℤ × ℤ} (hI : I ∈ D.cells) (f : Fin 4 → ℝ → ℂ) :
    D.err2 I f = D.err2 I (fun j => (D.J I).indicator (f j)) := by
  unfold err2
  refine localProgressionForm_congr_support fun z hz j => ?_
  rw [Set.indicator_of_mem (D.err2_support hI z hz j)]

open Classical in
/-- The slow points whose intervals meet `J_I`. -/
noncomputable def TJ (I : ℤ × ℤ) : Finset ℤ :=
  D.T.filter (fun m : ℤ => (Metric.ball (D.δ * (m : ℝ)) (1 / 8 * D.δ) ∩ D.J I).Nonempty)

/-- The windows of the slow points meeting `J_I` lie in the cell. -/
theorem TJ_window_subset {I : ℤ × ℤ} (hI : I ∈ D.cells) {m : ℤ} (hm : m ∈ D.TJ I)
    (j : Fin 4) : D.window j m ⊆ Set.Icc (D.left I) (D.left I + D.len I) := by
  classical
  obtain ⟨-, y, hy1, hy2⟩ := Finset.mem_filter.mp hm
  intro x hx
  have hδ : 8 * D.δ ≤ κ.margin * D.len I := D.δ_small I hI
  have hδ0 := D.δ_pos
  have hl := fastLiftLeft_bounds j
  have hr := fastLift_right_le j
  rw [Metric.mem_ball, Real.dist_eq, abs_lt] at hy1
  simp only [J, Set.mem_Icc] at hy2
  simp only [window, Set.mem_Ico] at hx
  have e1 : D.δ * (m + fastLiftLeft j + fastLiftLen j) ≤ D.δ * m + 4 * D.δ := by nlinarith
  have e2 : D.δ * m - 4 * D.δ ≤ D.δ * (m + fastLiftLeft j) := by nlinarith
  constructor <;> nlinarith [hx.1, hx.2, hy1.1, hy1.2, hy2.1, hy2.2]

/-- The weighted cell sum of `eq:shortblock` (lines 2309-2312): with local masses `Y_j(I)` at
most the total masses `m_j` on each depth and `Σ_s δ / r_s ≤ 1`,
`Σ_I (δ / r_I) Y_a(I)^{1/2} Y_b(I)^{1/2} ≤ m_a^{1/2} m_b^{1/2}`. -/
theorem sum_cells_ab_le (a b : Fin 4) (m : Fin 4 → ℝ)
    (hm : ∀ j, ∫⁻ y, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) ≤ ENNReal.ofReal (m j))
    (hw : ∑ s ∈ D.cells.image Prod.fst, D.δ / dyadicGridLength D.grid s ≤ 1) :
    ∑ I ∈ D.cells, ENNReal.ofReal (D.δ / D.len I) *
      ((∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) ^
        (1 / 2 : ℝ) * (∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
          ENNReal.ofReal (D.Z b y) ^ (2 : ℝ)) ^ (1 / 2 : ℝ)) ≤
      ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) * ENNReal.ofReal (m b) ^ (1 / 2 : ℝ) := by
  classical
  set Y : Fin 4 → ℤ × ℤ → ℝ≥0∞ := fun j I => ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
    ENNReal.ofReal (D.Z j y) ^ (2 : ℝ)
  change ∑ I ∈ D.cells, ENNReal.ofReal (D.δ / D.len I) * (Y a I ^ (1 / 2 : ℝ) *
    Y b I ^ (1 / 2 : ℝ)) ≤ _
  rw [← Finset.sum_fiberwise_of_maps_to (g := Prod.fst) (t := D.cells.image Prod.fst)
    (fun I hI => Finset.mem_image_of_mem _ hI)]
  have hdepth : ∀ s ∈ D.cells.image Prod.fst, ∑ I ∈ D.cells with I.1 = s,
      ENNReal.ofReal (D.δ / D.len I) * (Y a I ^ (1 / 2 : ℝ) * Y b I ^ (1 / 2 : ℝ)) ≤
      ENNReal.ofReal (D.δ / dyadicGridLength D.grid s) * (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) *
        ENNReal.ofReal (m b) ^ (1 / 2 : ℝ)) := by
    intro s _
    have hl : ∀ I ∈ D.cells.filter (fun I => I.1 = s),
        ENNReal.ofReal (D.δ / D.len I) = ENNReal.ofReal (D.δ / dyadicGridLength D.grid s) :=
      fun I hI => by rw [show D.len I = dyadicGridLength D.grid s by
        unfold len; rw [(Finset.mem_filter.mp hI).2]]
    rw [Finset.sum_congr rfl fun I hI => by rw [hl I hI], ← Finset.mul_sum]
    gcongr
    refine (ENNReal.inner_le_Lp_mul_Lq (D.cells.filter fun I => I.1 = s)
      (fun I => Y a I ^ (1 / 2 : ℝ)) (fun I => Y b I ^ (1 / 2 : ℝ))
        Real.HolderConjugate.two_two).trans ?_
    have hsq : ∀ j, ∑ I ∈ D.cells with I.1 = s, (Y j I ^ (1 / 2 : ℝ)) ^ (2 : ℝ) ≤
        ENNReal.ofReal (m j) := by
      intro j
      simp_rw [← ENNReal.rpow_mul]
      norm_num
      exact (D.sum_depth_le s _).trans (hm j)
    gcongr
    · exact hsq a
    · exact hsq b
  refine (Finset.sum_le_sum hdepth).trans ?_
  rw [← Finset.sum_mul]
  calc (∑ s ∈ D.cells.image Prod.fst, ENNReal.ofReal (D.δ / dyadicGridLength D.grid s)) *
        (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) * ENNReal.ofReal (m b) ^ (1 / 2 : ℝ))
      ≤ 1 * (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) * ENNReal.ofReal (m b) ^ (1 / 2 : ℝ)) := by
        gcongr
        rw [← ENNReal.ofReal_sum_of_nonneg fun s _ => by
          have := D.δ_pos; have := dyadicGridLength_pos D.grid s; positivity]
        exact ENNReal.ofReal_le_one.mpr hw
    _ = _ := one_mul _

/-- The localized squared masses of the comparison inputs at a cell. -/
noncomputable def locMass (N : ℕ) (w : Fin 4 → ℤ → ℂ) (I : ℤ × ℤ) (j : Fin 4)
    (z : (Ω × ℝ) × FastCircle) : ℝ≥0∞ :=
  ENNReal.ofReal (D.len I)⁻¹ * ∑ m ∈ D.TJ I, ENNReal.ofReal (D.δ / 4) *
    ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ)

theorem measurable_locMass (N : ℕ) (w : Fin 4 → ℤ → ℂ) (I : ℤ × ℤ) (j : Fin 4) :
    Measurable (D.locMass N w I j) := by
  unfold locMass
  exact measurable_const.mul (Finset.measurable_sum _ fun m _ => measurable_const.mul
    ((D.measurable_multWith_joint N w j m).enorm.pow_const _))

/-- Pointwise second sampling error: `‖H_I^{err}(g)‖ ≤ 4 C_κ (δ / r) Π_j X_j^{1/2}`. -/
theorem err2_pointwise {I : ℤ × ℤ} (hI : I ∈ D.cells) (N : ℕ) (w : Fin 4 → ℤ → ℂ) (γ : ℝ)
    (σ : Ω) (x : FastCircle × FastCircle) :
    ‖D.err2 I (D.gin N w γ σ x)‖ₑ ≤ ENNReal.ofReal (4 * admissibleLipConst κ * (D.δ / D.len I)) *
      ∏ j, D.locMass N w I j ((σ, γ), fastCoord j x) ^ (1 / 2 : ℝ) := by
  classical
  have hδr : 5 * D.δ ≤ κ.margin * D.len I := by
    have := D.δ_small I hI; have := D.δ_pos; unfold len; linarith
  rw [D.err2_local hI]
  have hJ : MeasurableSet (D.J I) := measurableSet_Icc
  refine (roundSampled_form_error (D.len_pos I) (D.admissible I hI) D.δ_pos hδr _
    (fun j => (D.measurable_gin N w γ σ x j).indicator hJ) (fun _ => 2) (fun _ => by norm_num)
    (by norm_num)).trans ?_
  gcongr with j
  refine (eLpNorm_indicator_intervalInput_le D.δ_pos (by norm_num) D.T _ (D.J I) hJ).trans
    (le_of_eq ?_)
  unfold locMass TJ
  congr 2
  refine Finset.sum_congr rfl fun m _ => ?_
  congr 1
  rw [show 2 * (1 / 8 * D.δ) = D.δ / 4 by ring]

/-- The window sum over slow points with windows in the cell. -/
theorem sum_ewin_sq_le_of {I : ℤ × ℤ} (j : Fin 4) (S : Finset ℤ)
    (hS : ∀ m ∈ S, D.window j m ⊆ Set.Icc (D.left I) (D.left I + D.len I)) :
    ∑ m ∈ S, D.ewin j m ^ (2 : ℝ) ≤ (ENNReal.ofReal (16 * D.δ))⁻¹ * 8 *
      ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) := by
  simp_rw [D.ewin_sq]
  rw [← Finset.mul_sum, mul_assoc]
  gcongr
  refine (window_sum_le_of_subset D.δ_pos j _ S _ measurableSet_Icc hS).trans ?_
  gcongr
  unfold fastLiftLenNat; split_ifs <;> norm_num

/-- The `L²` size of the localized masses: `(E ∫ X_j²)^{1/2} ≤ K r⁻¹ ∫_I Z_j²`. -/
theorem locMass_L2 (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (N : ℕ) (w : Fin 4 → ℤ → ℂ) (hw : ∀ j m, ‖w j m‖ₑ ≤ 1) {I : ℤ × ℤ} (hI : I ∈ D.cells)
    (j : Fin 4) :
    (∫⁻ z, D.locMass N w I j z ^ (2 : ℝ) ∂((P.prod gammaMeasure).prod fastHaar)) ^ (1 / 2 : ℝ) ≤
      ENNReal.ofReal (D.len I)⁻¹ * err2Const C4 * ∫⁻ y in Set.Icc (D.left I)
        (D.left I + D.len I), ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) := by
  set ν := (P.prod gammaMeasure).prod fastHaar
  have hδ := D.δ_pos
  have hGm : ∀ m, Measurable fun z : (Ω × ℝ) × FastCircle =>
      ENNReal.ofReal (D.δ / 4) * ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ) := fun m =>
    measurable_const.mul ((D.measurable_multWith_joint N w j m).enorm.pow_const _)
  have hsplit : ∀ z, D.locMass N w I j z ^ (2 : ℝ) = ENNReal.ofReal (D.len I)⁻¹ ^ (2 : ℝ) *
      (∑ m ∈ D.TJ I, ENNReal.ofReal (D.δ / 4) *
        ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ)) ^ (2 : ℝ) := fun z => by
    unfold locMass; rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
  simp_rw [hsplit]
  rw [lintegral_const_mul' _ _ (by simp), ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
    ← ENNReal.rpow_mul, show (2 : ℝ) * (1 / 2) = 1 by norm_num, ENNReal.rpow_one, mul_assoc]
  gcongr
  refine (lintegral_finset_sum_sq_le ν (D.TJ I) _ fun m => (hGm m).aemeasurable).trans ?_
  have hterm : ∀ m ∈ D.TJ I, (∫⁻ z, (ENNReal.ofReal (D.δ / 4) *
      ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ)) ^ (2 : ℝ) ∂ν) ^ (1 / 2 : ℝ) ≤
      ENNReal.ofReal (D.δ / 4) * ((2 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2 *
        D.ewin j m ^ (2 : ℝ)) := by
    intro m _
    have e1 : ∀ z : (Ω × ℝ) × FastCircle, (ENNReal.ofReal (D.δ / 4) *
        ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (2 : ℝ)) ^ (2 : ℝ) =
        ENNReal.ofReal (D.δ / 4) ^ (2 : ℝ) * ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (4 : ℝ) := by
      intro z
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]
      norm_num
    rw [lintegral_congr e1, lintegral_const_mul' _ _ (by simp),
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul,
      show (2 : ℝ) * (1 / 2) = 1 by norm_num, ENNReal.rpow_one]
    gcongr
    have h4 := D.multWith_fourth P hmom N w j m
    have hw4 : ‖w j m‖ₑ ^ 4 ≤ 1 := pow_le_one₀ zero_le (hw j m)
    calc (∫⁻ z, ‖D.multWith N w z.1.2 z.1.1 j m z.2‖ₑ ^ (4 : ℝ) ∂ν) ^ (1 / 2 : ℝ)
        ≤ (2 * (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ)) ^ (1 / 2 : ℝ) := by
          gcongr
          calc _ ≤ 2 * ‖w j m‖ₑ ^ 4 * (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ) := h4
            _ ≤ 2 * 1 * (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ) := by gcongr
            _ = _ := by rw [mul_one]
      _ = 2 ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2 * D.ewin j m ^ (2 : ℝ) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul,
            ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
            show (4 : ℝ) * (1 / 2) = 2 by norm_num, ENNReal.rpow_two, mul_assoc]
  refine (Finset.sum_le_sum hterm).trans ?_
  rw [← Finset.mul_sum, ← Finset.mul_sum]
  calc ENNReal.ofReal (D.δ / 4) * ((2 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2 *
        ∑ m ∈ D.TJ I, D.ewin j m ^ (2 : ℝ))
      ≤ ENNReal.ofReal (D.δ / 4) * ((2 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2 *
          ((ENNReal.ofReal (16 * D.δ))⁻¹ * 8 * ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
            ENNReal.ofReal (D.Z j y) ^ (2 : ℝ))) := by
        gcongr
        exact D.sum_ewin_sq_le_of j _ fun m hm => D.TJ_window_subset hI hm j
    _ = _ := by
        have hscal : ENNReal.ofReal (D.δ / 4) * (ENNReal.ofReal (16 * D.δ))⁻¹ * 8 = 1 / 8 := by
          rw [← ENNReal.ofReal_inv_of_pos (by positivity),
            show (8 : ℝ≥0∞) = ENNReal.ofReal 8 by norm_num, ← ENNReal.ofReal_mul (by positivity),
            ← ENNReal.ofReal_mul (by positivity)]
          rw [show D.δ / 4 * (16 * D.δ)⁻¹ * 8 = 1 / 8 by field_simp; ring]
          rw [ENNReal.ofReal_div_of_pos (by norm_num)]; simp
        unfold err2Const
        calc ENNReal.ofReal (D.δ / 4) * ((2 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2 *
              ((ENNReal.ofReal (16 * D.δ))⁻¹ * 8 * ∫⁻ y in Set.Icc (D.left I)
                (D.left I + D.len I), ENNReal.ofReal (D.Z j y) ^ (2 : ℝ)))
            = (ENNReal.ofReal (D.δ / 4) * (ENNReal.ofReal (16 * D.δ))⁻¹ * 8) *
              ((2 : ℝ≥0∞) ^ (1 / 2 : ℝ) * ENNReal.ofReal C4 ^ 2) * ∫⁻ y in Set.Icc (D.left I)
                (D.left I + D.len I), ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) := by ring
          _ = _ := by rw [hscal, one_div, ENNReal.div_eq_inv_mul]

/-- Blueprint lines 2353-2355 (second sampling error, integrated): at one cell,
`E ∫∫ |I| |H_I^{err}(g)| ≤ 4 C_κ K² (δ / r_I) Y_a^{1/2} Y_b^{1/2}`. -/
theorem err2_cell_bound (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (N : ℕ) (w : Fin 4 → ℤ → ℂ) (hw : ∀ j m, ‖w j m‖ₑ ≤ 1) {I : ℤ × ℤ} (hI : I ∈ D.cells)
    {a b : Fin 4} (hab : a ≠ b)
    (hloc : ∀ j, ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
      ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) ≤ ENNReal.ofReal (D.len I)) :
    ∫⁻ σ, ∫⁻ γ, ∫⁻ x, ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N w γ σ x)‖ₑ
      ∂(fastHaar.prod fastHaar) ∂gammaMeasure ∂P ≤
      ENNReal.ofReal (4 * admissibleLipConst κ) * err2Const C4 ^ 2 *
        (ENNReal.ofReal (D.δ / D.len I) *
          ((∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
            ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) ^ (1 / 2 : ℝ) *
          (∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
            ENNReal.ofReal (D.Z b y) ^ (2 : ℝ)) ^ (1 / 2 : ℝ))) := by
  classical
  have hr := D.len_pos I
  have hδ := D.δ_pos
  have hCκ := admissibleLipConst_nonneg κ
  set Q := P.prod gammaMeasure
  set Y : Fin 4 → ℝ≥0∞ := fun j => ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
    ENNReal.ofReal (D.Z j y) ^ (2 : ℝ)
  set L : Fin 4 → (Ω × ℝ) × (FastCircle × FastCircle) → ℝ≥0∞ := fun j q =>
    D.locMass N w I j (q.1, fastCoord j q.2) ^ (1 / 2 : ℝ)
  have hL : ∀ j, Measurable (L j) := fun j =>
    ((D.measurable_locMass N w I j).comp (measurable_fst.prodMk
      ((continuous_fastCoord _).measurable.comp measurable_snd))).pow_const _
  -- pointwise
  have hpt : ∀ σ γ x, ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N w γ σ x)‖ₑ ≤
      ENNReal.ofReal (4 * admissibleLipConst κ * D.δ) * ∏ j, L j ((σ, γ), x) := by
    intro σ γ x
