    mul_ne_zero (by exact_mod_cast hr.ne') (by exact_mod_cast hδ.ne')
  rw [mul_div_mul_left _ _ hne]

theorem round_form_eq (I : ℤ × ℤ) (hI : I ∈ D.cells) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ j, Measurable (f j)) (hL : ∀ j, MemLp (f j) 2 volume) :
    localProgressionForm (D.len I) (roundSampledKernel D.δ (D.kernel I)) f =
      localProgressionForm (D.len I) (D.kernel I) f - D.err2 I f := by
  have hr := D.len_pos I
  have hw := D.admissible I hI
  have hsupp := admissibleLocalKernel_support hr.le hw
  have hwm : Measurable (D.kernel I) := hw.smooth.continuous.measurable
  have hW := admissibleLocalKernel_norm_le hw
  have h1 := progression_integrable hr hsupp hwm hW f hf hL
  have h2 := progression_integrable (by linarith [D.δ_pos] : 0 < D.len I + 6 * D.δ)
    (roundSampled_support D.δ_pos hsupp) (measurable_roundSampledKernel hwm D.δ)
    (W := localKernelSupBound κ) (fun z => hW _) f hf hL
  unfold err2 localProgressionForm
  rw [← mul_sub, ← integral_sub h1 (by
    convert h1.sub h2 using 1; funext z; simp only [Pi.sub_apply]; ring)]
  congr 1
  refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
  simp only; ring

/-- Blueprint lines 2345-2357 (continuous comparison): for every `σ, γ` the lattice sum of the
multiplied slots is at most `(256/|polygon|) ∫_{T₀²}` of the summed absolute forms of the interval
inputs plus their second sampling errors. -/
theorem norm_latticeSum_interval (ε : ℤ × ℤ → Ω → ℂ) (hε1 : ∀ I σ, ‖ε I σ‖ ≤ 1) (N : ℕ)
    (w : Fin 4 → ℤ → ℂ) (γ : ℝ) (σ : Ω) :
    ‖D.latticeSum ε σ (D.multWith N w γ σ)‖ₑ ≤
      ENNReal.ofReal (256 / (volume (offsetPolygon (1 / 8))).toReal) * ∫⁻ x,
        (ENNReal.ofReal (∑ I ∈ D.cells, D.len I *
          ‖localProgressionForm (D.len I) (D.kernel I) (D.gin N w γ σ x)‖) +
        ∑ I ∈ D.cells, ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N w γ σ x)‖ₑ)
          ∂(fastHaar.prod fastHaar) := by
  set c := 256 / (volume (offsetPolygon (1 / 8 : ℝ))).toReal
  have hc : 0 ≤ c := by unfold c; positivity
  unfold latticeSum
  have hcell : ∀ I ∈ D.cells, ‖(D.len I : ℂ) * ε I σ * ((D.len I : ℂ)⁻¹ ^ 2 *
      ((D.δ ^ 2 : ℝ) : ℂ) * 256 * ∑ n ∈ D.box I, D.kernel I (D.δ * n.1, D.δ * n.2 - D.δ * n.1) *
        fastFormAt (D.multWith N w γ σ) n)‖ₑ ≤ ENNReal.ofReal c * ∫⁻ x,
          (ENNReal.ofReal (D.len I) * ‖localProgressionForm (D.len I) (D.kernel I)
            (D.gin N w γ σ x)‖ₑ + ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N w γ σ x)‖ₑ)
              ∂(fastHaar.prod fastHaar) := by
    intro I hI
    have hr := D.len_pos I
    rw [D.cell_lattice_eq_interval N w γ σ hI, enorm_mul, enorm_mul, enorm_mul]
    have h1 : ‖(D.len I : ℂ)‖ₑ = ENNReal.ofReal (D.len I) := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hr.le]
    have h2 : ‖ε I σ‖ₑ ≤ 1 := by
      rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hε1 I σ)
    have h3 : ‖((c : ℝ) : ℂ)‖ₑ = ENNReal.ofReal c := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hc]
    rw [h1, h3]
    have hint : ∫⁻ x, ‖localProgressionForm (D.len I) (roundSampledKernel D.δ (D.kernel I))
        (D.gin N w γ σ x)‖ₑ ∂(fastHaar.prod fastHaar) ≤ ∫⁻ x,
          (‖localProgressionForm (D.len I) (D.kernel I) (D.gin N w γ σ x)‖ₑ +
            ‖D.err2 I (D.gin N w γ σ x)‖ₑ) ∂(fastHaar.prod fastHaar) := by
      refine lintegral_mono fun x => ?_
      rw [D.round_form_eq I hI _ (D.measurable_gin N w γ σ x) (D.memLp_gin N w γ σ x)]
      exact enorm_sub_le
    calc ENNReal.ofReal (D.len I) * ‖ε I σ‖ₑ * (ENNReal.ofReal c *
          ‖∫ x, localProgressionForm (D.len I) (roundSampledKernel D.δ (D.kernel I))
            (D.gin N w γ σ x) ∂(fastHaar.prod fastHaar)‖ₑ)
        ≤ ENNReal.ofReal (D.len I) * 1 * (ENNReal.ofReal c * ∫⁻ x,
          (‖localProgressionForm (D.len I) (D.kernel I) (D.gin N w γ σ x)‖ₑ +
            ‖D.err2 I (D.gin N w γ σ x)‖ₑ) ∂(fastHaar.prod fastHaar)) := by
          gcongr
          exact (enorm_integral_le_lintegral_enorm _).trans hint
      _ = _ := by
          rw [mul_one, mul_left_comm, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
          congr 1
          refine lintegral_congr fun x => ?_
          ring
  refine (enorm_sum_le _ _).trans ((Finset.sum_le_sum hcell).trans ?_)
  rw [← Finset.mul_sum]
  gcongr
  refine (sum_lintegral_le_lintegral_sum _ _ _).trans (lintegral_mono fun x => ?_)
  rw [Finset.sum_add_distrib]
  gcongr
  rw [ENNReal.ofReal_sum_of_nonneg fun I _ => by have := D.len_pos I; positivity]
  refine le_of_eq (Finset.sum_congr rfl fun I _ => ?_)
  rw [ENNReal.ofReal_mul (D.len_pos I).le, ofReal_norm]

