/-- lem:chartfourier at a given splitting (blueprint §13.1, line 1922): a one-variable chart
whose scale-`r` data admit `eq:weyl-splitting` with sizes and heights at most `B` has, on the
window `|t| ≤ R r`, an exact absolutely convergent expansion into modes
`e(λ_* t² + (β + σ_ℓ·θ) t)` with one common curvature `λ_* = λ + θᵀ M θ`, `|λ_*| r² ≤ D`,
and rational frequency differences `σ_ℓ` of height `D(1+|ℓ|)`, everything quasipolynomial in
`H` and `B`. -/
theorem splitPhase (c₀ : ℕ) (hc : 1 ≤ c₀) (R : ℝ) (hR : 0 ≤ R) :
    ∃ D : ℕ, 1 ≤ D ∧ ∃ DJ : ℕ → ℕ, ∀ {d : ℕ} (H B r : ℝ) (A : QuadraticChartData d),
      QuadraticChartComplexity c₀ H A → 0 < r → 2 ≤ B →
      WeylSplitData B (fun i _ => r * A.horizontal i) A.matrix
        (fun _ _ => r ^ 2 * A.quadratic) →
      let X := 1 + Real.log H + Real.log B
      ∃ M : Matrix (Fin d) (Fin d) ℚ,
        (∀ i j, (rationalHeight (M i j) : ℝ) ≤ Real.exp (D * X ^ D)) ∧
        |A.quadratic + ∑ i, ∑ j, A.horizontal i * (M i j : ℝ) * A.horizontal j| * r ^ 2 ≤
          Real.exp (D * X ^ D) ∧
        ∃ (ι : Type) (_ : Fintype ι) (σ : ι × (Fin (d + d) → ℤ) → Fin d → ℚ),
          (Fintype.card ι : ℝ) ≤ Real.exp (D * X ^ D) ∧
          (∀ p i, (rationalHeight (σ p i) : ℝ) ≤
            Real.exp (D * X ^ D) * (1 + frequencyLength p.2)) ∧
          ∃ a : ι × (Fin (d + d) → ℤ) → ℂ,
            (∀ t : ℝ, |t| ≤ R * r →
              HasSum (fun p => a p *
                  (Real.fourierChar ((∑ i, (σ p i : ℝ) * A.horizontal i) * t) : ℂ))
                ((Real.fourierChar (-((A.quadratic +
                    ∑ i, ∑ j, A.horizontal i * (M i j : ℝ) * A.horizontal j) * t ^ 2 +
                    A.linear * t)) : ℂ) * quadraticChartAtom A t)) ∧
            Summable (fun p => ‖a p‖) ∧ (∑' p, ‖a p‖) ≤ Real.exp (D * X ^ D) ∧
            ∀ J : ℕ,
              (∀ p, ‖a p‖ * (1 + frequencyLength p.2) ^ (J * (d + 1) ^ 2) ≤
                Real.exp (DJ J * X ^ DJ J)) ∧
              ∀ T : ℝ, 1 ≤ T →
                (∑ f : ι, ∑ v ∈ frequencyShell (d + d) T, ‖a (f, v)‖) *
                    T ^ (J * (d + 1) ^ 2) ≤ Real.exp (DJ J * X ^ DJ J) := by
  obtain ⟨Ds, hDs, DJs, hsplit⟩ := splitFourierExpansion c₀ hc 1 R hR
  set Dm : ℕ := Ds + 12 with hDm
  refine ⟨Dm, by omega, DJs, ?_⟩
  intro d H B r A hA hr hB hW X
  set A' := oneVariableChart (dilateQuadraticChart r A) with hA'
  have hA'c : MultivariableQuadraticChartComplexity c₀ H A' :=
    oneVariableChart_complexity (dilateQuadraticChart_complexity hA r)
  have hhor : A'.horizontal = fun i _ => r * A.horizontal i := by
    funext i j; simp [hA', oneVariableChart, dilateQuadraticChart]; ring
  have hquad : A'.quadratic = fun _ _ => r ^ 2 * A.quadratic := by
    funext i j; simp [hA', oneVariableChart, dilateQuadraticChart]; ring
  have hmat : A'.matrix = A.matrix := rfl
  rw [← hhor, ← hquad] at hW
  obtain ⟨U, Q, hQU, hPU, hiso, hQh, hPh, hVs, hΛ⟩ := hW
  have hH1 : 1 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hlogH : 2 ≤ Real.log H := by
    rw [← Real.log_exp 2]; exact Real.log_le_log (Real.exp_pos 2) hA.lower
  have hlogB : 0 ≤ Real.log B := Real.log_nonneg (by linarith)
  have hX3 : 3 ≤ X := by simp only [X]; linarith
  have hX1 : 1 ≤ X := by linarith
  have hQs : Q.IsSymm := isSymm_of_realMatrixOperator_starProjection hQU
  have hiso' := isotropy_matrix_of_starProjection hPU hiso
  obtain ⟨ι, hι, σ, hcard, hσ, hrest⟩ := hsplit (d := d) H B hA.lower hA.dimension hB
    A.matrix Q (fun i j => hA.height i j) hQs hQh hiso'
  obtain ⟨a, hexp, hsumm, htot, hJ⟩ := hrest A' hmat hA'c hVs
  set M := separatedPhaseMatrix A.matrix Q with hMdef
  set lam := A.quadratic + ∑ i, ∑ j, A.horizontal i * (M i j : ℝ) * A.horizontal j with hlam
  set Λe := effectiveReturnQuadratic (A.matrix.map (fun q => (q : ℝ))) A'.quadratic
    A'.horizontal ((1 - Q.map (fun q => (q : ℝ))) * A'.horizontal)
    (Q.map (fun q => (q : ℝ)) * A'.horizontal) with hΛe
  have hΛ00 : Λe 0 0 = r ^ 2 * lam := by
    rw [hΛe, effectiveReturnQuadratic_one, ← separatedPhaseMatrix_cast]
    simp only [hA', oneVariableChart, dilateQuadraticChart, Matrix.map_apply, hlam, hMdef]
    rw [mul_add, Finset.mul_sum]
    congr 1
    · ring
    apply Finset.sum_congr rfl; intro i _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl; intro j _
    ring
  have hup : ∀ {y : ℝ}, y ≤ Real.exp (Ds * X ^ Ds) → y ≤ Real.exp (Dm * X ^ Dm) :=
    fun h => h.trans (exp_poly_le hX1 (by omega) (by rw [hDm]; push_cast; linarith))
  refine ⟨M, ?_, ?_, ι, hι, σ, hup hcard, fun p i => (hσ p i).trans
    (mul_le_mul_of_nonneg_right (hup le_rfl) (by
      have := frequencyLength_nonneg p.2; linarith)), a, ?_, hsumm, hup htot, hJ⟩
  · intro i j
    have h := separatedPhaseMatrix_height (H := H) (B := B) hH1 (by linarith) A.matrix Q
      (fun i j => hA.height i j) hQh i j
    refine h.trans ((split_height_budget hA.lower hB hA.dimension).trans
      (exp_poly_le hX1 (by omega) (by rw [hDm]; push_cast; linarith)))
  · have h := realMatrix_abs_entry_le_norm Λe 0 0
    rw [hΛ00, abs_mul, abs_of_nonneg (by positivity)] at h
    rw [mul_comm]
    have hΛ' := hΛ
    rw [one_sub_map_cast] at hΛ'
    have hBX : B ≤ Real.exp (Dm * X ^ Dm) := by
      rw [← Real.exp_log (by linarith : (0 : ℝ) < B)]
      apply Real.exp_le_exp.mpr
      have : X ≤ X ^ Dm := le_self_pow₀ hX1 (by omega)
      have : (1 : ℝ) ≤ Dm := by rw [hDm]; push_cast; linarith
      simp only [X] at *; nlinarith
    exact (h.trans hΛ').trans hBX
  · intro t ht
    set z : Fin 1 → ℝ := fun _ => t / r with hz
    have hzR : ∀ i, |z i| ≤ R := fun i => by
      simp only [hz, abs_div, abs_of_pos hr]
      rw [div_le_iff₀ hr]; linarith
    have h := hexp z hzR
    have e1 : ∀ p, dotProduct (fun i => (σ p i : ℝ)) (A'.horizontal.mulVec z) =
        (∑ i, (σ p i : ℝ) * A.horizontal i) * t := fun p => by
      simp only [dotProduct, Matrix.mulVec, hA', oneVariableChart, dilateQuadraticChart, hz,
        Fin.sum_univ_one, Finset.sum_mul]
      apply Finset.sum_congr rfl; intro i _
      field_simp
    have e2 : dotProduct z (Λe.mulVec z) + dotProduct A'.linear z = lam * t ^ 2 + A.linear * t := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_one, hz]
      rw [hΛ00]
      simp only [hA', oneVariableChart, dilateQuadraticChart]
      field_simp
    have e3 : multivariableQuadraticChartAtom A' z = quadraticChartAtom A t := by
      rw [hA', oneVariableChart_atom, dilateQuadraticChart_atom]
      congr 1; simp only [hz]; field_simp
    simp_rw [e1] at h
    rw [e2, e3] at h
    exact h

/-- A splitting of the data `(V, C, Λ)` is a splitting of `(V, cC, cΛ)` at size `|c| B`. -/
theorem WeylSplitData.smul {B : ℝ} {d : ℕ} {V : Matrix (Fin d) (Fin 1) ℝ}
    {C : Matrix (Fin d) (Fin d) ℚ} {Λ : Matrix (Fin 1) (Fin 1) ℝ} {c : ℤ} (hc : c ≠ 0)
    (h : WeylSplitData B V C Λ) :
    WeylSplitData (|(c : ℝ)| * B) V ((c : ℚ) • C) ((c : ℝ) • Λ) := by
  obtain ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩ := h
  have hmap : ((c : ℚ) • C).map (fun q => (q : ℝ)) = (c : ℝ) • C.map (fun q => (q : ℝ)) := by
    ext i j; simp
  have hc1 : 1 ≤ |(c : ℝ)| := by
    rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs hc
  have hB0 : 0 ≤ B := le_trans (norm_nonneg _) h6
  have hle : B ≤ |(c : ℝ)| * B := le_mul_of_one_le_left hB0 hc1
  refine ⟨U, Q, h1, h2, fun x hx y hy => ?_, fun i j => (h4 i j).trans hle,
    fun i j => (h5 i j).trans hle, h6.trans hle, ?_⟩
  · rw [hmap, Matrix.transpose_smul, ← smul_sub, realMatrixOperator_smul]
    simp only [smul_apply, inner_smul_right, h3 x hx y hy, mul_zero]
  · rw [hmap, effectiveReturnQuadratic_smul, realMatrixOperator_smul, norm_smul,
      Real.norm_eq_abs]
    exact mul_le_mul_of_nonneg_left h7 (abs_nonneg _)

section BranchChart

variable {d : ℕ}

/-- The branch lift `d_ρ(u) = ρ + {u - ρ}`, with values in `ρ + [0,1)ᵈ`. -/
noncomputable def branchLift (ρ u : Fin d → ℝ) : Fin d → ℝ :=
  fun i => ρ i + Int.fract (u i - ρ i)

/-- The lattice point of the branch: `u - d_ρ(u) = ⌊u - ρ⌋`. -/
theorem branchLift_sub (ρ u : Fin d → ℝ) :
    u - branchLift ρ u = fun i => ((⌊u i - ρ i⌋ : ℤ) : ℝ) := by
  funext i
  simp only [branchLift, Pi.sub_apply, Int.fract]
  ring

/-- Blueprint lines 1906-1908: a cut-off branch of the group-center phase is a chart. If the
amplitude `g` vanishes outside the open branch cube `ρ + (0,1)ᵈ`, the chart with horizontal
`θ`, matrix `-cC`, quadratic `-cλ` and amplitude `g` has atom `g(d_ρ) e(-c p_ρ)` with
`p_ρ(y) = λ y² + (θ y)ᵀ C d_ρ(θ y)`. -/
theorem branchChart_atom (θ : Fin d → ℝ) (C : Matrix (Fin d) (Fin d) ℚ) (lam : ℝ) (c : ℤ)
    (ρ : Fin d → ℝ) {g : (Fin d → ℝ) → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hgc : HasCompactSupport g) (hgs : ∀ w, g w ≠ 0 → ∀ i, ρ i < w i ∧ w i < ρ i + 1)
    (y : ℝ) :
    quadraticChartAtom (mkQuadraticChart θ (-(c : ℝ) * lam) 0 (((-c : ℤ) : ℚ) • C) g hg hgc) y =
      g (branchLift ρ (fun i => θ i * y)) *
        (Real.fourierChar (-(c : ℝ) * (lam * y ^ 2 +
          chartMatrixPhase C (fun i => θ i * y) (branchLift ρ (fun i => θ i * y)))) : ℂ) := by
  set u : Fin d → ℝ := fun i => θ i * y
  set n₀ : Fin d → ℤ := fun i => ⌊u i - ρ i⌋
  rw [quadraticChartAtom, tsum_eq_single n₀]
  · have hrem : chartLatticeRemainder (mkQuadraticChart θ (-(c : ℝ) * lam) 0
        (((-c : ℤ) : ℚ) • C) g hg hgc) y n₀ = branchLift ρ u := by
      funext i
      simp only [chartLatticeRemainder, mkQuadraticChart, branchLift, n₀, Int.fract, u]
      ring
    simp only [quadraticChartLatticeSummand, hrem]
    have hpos : chartHorizontalPosition (mkQuadraticChart θ (-(c : ℝ) * lam) 0
        (((-c : ℤ) : ℚ) • C) g hg hgc) y = u := rfl
    rw [hpos]
    simp only [mkQuadraticChart]
    rw [chartMatrixPhase_intSmul]
    rw [show (Real.fourierChar (-(c : ℝ) * lam * y ^ 2 + 0 * y) : ℂ) *
        (g (branchLift ρ u) * (Real.fourierChar (((-c : ℤ) : ℝ) *
          chartMatrixPhase C u (branchLift ρ u)) : ℂ)) =
        g (branchLift ρ u) * ((Real.fourierChar (-(c : ℝ) * lam * y ^ 2 + 0 * y) : ℂ) *
          (Real.fourierChar (((-c : ℤ) : ℝ) * chartMatrixPhase C u (branchLift ρ u)) : ℂ)) by ring,
      ← fc_add]
    congr 3
    push_cast; ring
  · intro n hn
    simp only [quadraticChartLatticeSummand]
    have : g (chartLatticeRemainder (mkQuadraticChart θ (-(c : ℝ) * lam) 0
        (((-c : ℤ) : ℚ) • C) g hg hgc) y n) = 0 := by
      by_contra hne
      apply hn
      funext i
      have h := hgs _ hne i
      simp only [chartLatticeRemainder, mkQuadraticChart] at h
      have h1 : (n i : ℝ) ≤ u i - ρ i := by simp only [u]; linarith [h.1]
      have h2 : u i - ρ i < (n i : ℝ) + 1 := by simp only [u]; linarith [h.2]
      simp only [n₀]
      rw [eq_comm, Int.floor_eq_iff]
      exact ⟨h1, h2⟩
    change (mkQuadraticChart θ (-(c : ℝ) * lam) 0 (((-c : ℤ) : ℚ) • C) g hg hgc).amplitude _ * _ = 0
    rw [show (mkQuadraticChart θ (-(c : ℝ) * lam) 0 (((-c : ℤ) : ℚ) • C) g hg hgc).amplitude = g
      from rfl, this, zero_mul]

end BranchChart

/-- The cut-off branch chart of a group center `z` in slot multiplier `c` (blueprint
lines 1906-1908). -/
noncomputable def branchChart (z : ChartTag) (c : ℤ) {g : (Fin z.dim → ℝ) → ℂ}
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hgc : HasCompactSupport g) : QuadraticChartData z.dim :=
  mkQuadraticChart z.θ (-(c : ℝ) * z.lam) 0 (((-c : ℤ) : ℚ) • z.C) g hg hgc

/-- Blueprint §13.1, `eq:firstmatch` and `eq:mode-differences` (lines 1913-1922). Let a primary
`Φ` of tag `v` in a slot of multiplier `c` be matched to a group center `z` whose tag is joined
to `v` by an edge (or a short path, `tagEdge_path`) at length `r` and threshold `B`. Then on the
window `|t| ≤ R r` the product of `φ_Φ` with the cut-off demodulation `g(d_ρ) e(-c p_ρ)` is an
exact absolutely convergent sum of modes `e(λ_* t² + γ_ℓ t)` with one common curvature
`λ_* = c(λ_v - λ_z) + θᵀ M θ`, `|λ_*| r² ≤ D₁`, and frequency differences
`γ_ℓ - γ_ℓ' = (σ_ℓ - σ_ℓ')·(θ_v, θ_z)` with rational `σ` of height `D₁(1+|ℓ|)`, where `D₁` is
quasipolynomial in the complexity and `B`. -/
theorem firstMatchExpansion (c₀ : ℕ) (hc : 1 ≤ c₀) (R : ℝ) (hR : 0 ≤ R) :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ (v z : ChartTag) (c : ℤ), c ≠ 0 → |c| ≤ 3 →
    ∀ (H B r : ℝ) (Φ : QuadraticChartData v.dim) (ρ : Fin z.dim → ℝ)
      {g : (Fin z.dim → ℝ) → ℂ} (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hgc : HasCompactSupport g),
      (∀ w, g w ≠ 0 → ∀ i, ρ i < w i ∧ w i < ρ i + 1) →
      Φ.horizontal = v.θ → Φ.matrix = (c : ℚ) • v.C → Φ.quadratic = c * v.lam →
      QuadraticChartComplexity c₀ H (productQuadraticChart Φ (branchChart z c hg hgc)) →
      0 < r → 2 ≤ B → tagEdge B r v z →
      let P := productQuadraticChart Φ (branchChart z c hg hgc)
      let X := 1 + Real.log H + Real.log (3 * B)
      ∃ M : Matrix (Fin (v.dim + z.dim)) (Fin (v.dim + z.dim)) ℚ,
        (∀ i j, (rationalHeight (M i j) : ℝ) ≤ Real.exp (D * X ^ D)) ∧
        |P.quadratic + ∑ i, ∑ j, P.horizontal i * (M i j : ℝ) * P.horizontal j| * r ^ 2 ≤
          Real.exp (D * X ^ D) ∧
        ∃ (ι : Type) (_ : Fintype ι)
          (σ : ι × (Fin ((v.dim + z.dim) + (v.dim + z.dim)) → ℤ) → Fin (v.dim + z.dim) → ℚ),
          (Fintype.card ι : ℝ) ≤ Real.exp (D * X ^ D) ∧
          (∀ p i, (rationalHeight (σ p i) : ℝ) ≤
            Real.exp (D * X ^ D) * (1 + frequencyLength p.2)) ∧
          ∃ a : ι × (Fin ((v.dim + z.dim) + (v.dim + z.dim)) → ℤ) → ℂ,
            (∀ t : ℝ, |t| ≤ R * r →
              HasSum (fun p => a p * (Real.fourierChar ((P.quadratic +
                  ∑ i, ∑ j, P.horizontal i * (M i j : ℝ) * P.horizontal j) * t ^ 2 +
                  (Φ.linear + ∑ i, (σ p i : ℝ) * P.horizontal i) * t) : ℂ))
                (quadraticChartAtom Φ t * (g (branchLift ρ (fun i => z.θ i * t)) *
                  (Real.fourierChar (-(c : ℝ) * (z.lam * t ^ 2 +
                    chartMatrixPhase z.C (fun i => z.θ i * t)
                      (branchLift ρ (fun i => z.θ i * t)))) : ℂ)))) ∧
            Summable (fun p => ‖a p‖) ∧ (∑' p, ‖a p‖) ≤ Real.exp (D * X ^ D) := by
  obtain ⟨D, hD, _DJ, hsp⟩ := splitPhase c₀ hc R hR
  refine ⟨D, hD, ?_⟩
  intro v z c hc0 hc3 H B r Φ ρ g hg hgc hgs hθ hM hq hP hr hB hE P X
  -- the splitting of the product chart
  have hW : WeylSplitData (3 * B) (fun i _ => r * P.horizontal i) P.matrix
      (fun _ _ => r ^ 2 * P.quadratic) := by
    have h := (WeylSplitData.smul hc0 hE).mono (B' := 3 * B) (by
      have hc3' : |(c : ℝ)| ≤ 3 := by rw [← Int.cast_abs]; exact_mod_cast hc3
      exact mul_le_mul_of_nonneg_right hc3' (by linarith))
    have hV : tagDiffV r v z = fun i _ => r * P.horizontal i := by
      funext i j
      simp [tagDiffV, P, productQuadraticChart, branchChart, mkQuadraticChart, hθ]
    have hCm : (c : ℚ) • tagDiffC v z = P.matrix := by
      simp only [tagDiffC, P, productQuadraticChart, branchChart, mkQuadraticChart, hM]
      rw [← chartBlockMatrix_smul]
      congr 1
      ext i j; simp
    have hL : (c : ℝ) • tagDiffΛ r v z = fun _ _ => r ^ 2 * P.quadratic := by
      funext i j
      simp [tagDiffΛ, P, productQuadraticChart, branchChart, mkQuadraticChart, hq]
      ring
    rw [hV, hCm, hL] at h
    exact h
  obtain ⟨M, hMh, hlam, ι, hι, σ, hcard, hσ, a, hexp, hsumm, htot, -⟩ :=
    hsp H (3 * B) r P hP hr (by linarith) hW
  refine ⟨M, hMh, hlam, ι, hι, σ, hcard, hσ, a, fun t ht => ?_, hsumm, htot⟩
  have h := (hexp t ht).mul_left (Real.fourierChar ((P.quadratic +
    ∑ i, ∑ j, P.horizontal i * (M i j : ℝ) * P.horizontal j) * t ^ 2 + P.linear * t) : ℂ)
  have hatom : quadraticChartAtom P t = quadraticChartAtom Φ t *
      (g (branchLift ρ (fun i => z.θ i * t)) * (Real.fourierChar (-(c : ℝ) * (z.lam * t ^ 2 +
        chartMatrixPhase z.C (fun i => z.θ i * t) (branchLift ρ (fun i => z.θ i * t)))) : ℂ)) := by
    rw [productQuadraticChart_atom]
    congr 1
    exact branchChart_atom z.θ z.C z.lam c ρ hg hgc hgs t
  have hlin : P.linear = Φ.linear := by
    simp [P, productQuadraticChart, branchChart, mkQuadraticChart]
  rw [← mul_assoc, ← Circle.coe_mul, ← AddChar.map_add_eq_mul,
    show (P.quadratic + ∑ i, ∑ j, P.horizontal i * (M i j : ℝ) * P.horizontal j) * t ^ 2 +
      P.linear * t + -((P.quadratic + ∑ i, ∑ j, P.horizontal i * (M i j : ℝ) * P.horizontal j) *
        t ^ 2 + P.linear * t) = 0 by ring, AddChar.map_zero_eq_one, Circle.coe_one, one_mul,
    hatom] at h
  convert h using 1
  funext p
  rw [mul_left_comm, ← Circle.coe_mul, ← AddChar.map_add_eq_mul, hlin]
  congr 3
  ring

/-! ### The pointwise lift to modes (blueprint lines 1932-1940) -/

section ModeLift

variable {Pr Md : Type*} [Fintype Pr] [Fintype Md] [DecidableEq Pr]

/-- The pointwise lift at one point: physical output `s F_phys + Σ_Φ F_Φ ε_Φ^{-1/2} q_Φ` and
mode coordinates `√ε_m a_m F_{Φ(m)} ε_{Φ(m)}^{-1/2}`, where `s = (ζ^ρ)²`. -/
noncomputable def modeLift (own : Md → Pr) (s : ℂ) (q : Pr → ℂ) (a : Md → ℂ) (εP : Pr → ℝ)
    (εM : Md → ℝ) (F : ColumnHilbert Pr) : ColumnHilbert Md :=
  WithLp.toLp 2 fun o => match o with
    | none => s * F none + ∑ Φ, F (some Φ) / (Real.sqrt (εP Φ) : ℂ) * q Φ
    | some m => (Real.sqrt (εM m) : ℂ) * a m * F (some (own m)) / (Real.sqrt (εP (own m)) : ℂ)

/-- The augmented mode `ψ_m = (ψ_m^phys, √ε_m e_m)`. -/
noncomputable def augmentedMode [DecidableEq Md] (ψphys : Md → ℂ) (εM : Md → ℝ) (m : Md) :
    ColumnHilbert Md :=
  WithLp.toLp 2 fun o => match o with
    | none => ψphys m
    | some m' => if m' = m then (Real.sqrt (εM m) : ℂ) else 0

/-- The augmented main column `(φ_Φ, √ε_Φ e_Φ)` with coefficient vector `β`. -/
noncomputable def augmentedMain (φ : Pr → ℂ) (εP : Pr → ℝ) (β : Pr → ℂ) : ColumnHilbert Pr :=
  WithLp.toLp 2 fun o => match o with
    | none => ∑ Φ, β Φ * φ Φ
    | some Φ => (Real.sqrt (εP Φ) : ℂ) * β Φ

/-- Blueprint lines 1934-1937: the lift carries every main output exactly to its mode synthesis
`Σ_{Φ,m} β_Φ a_{Φ,m} ψ_m`, provided `q_Φ = Σ_m a_{Φ,m} ψ_m^phys - s φ_Φ`. -/
theorem modeLift_synthesis [DecidableEq Md] (own : Md → Pr) (s : ℂ) (φ : Pr → ℂ)
    (a : Md → ℂ) (ψphys : Md → ℂ) (εP : Pr → ℝ) (hεP : ∀ Φ, 0 < εP Φ) (εM : Md → ℝ)
    (q : Pr → ℂ) (hq : ∀ Φ, q Φ = ∑ m ∈ Finset.univ.filter (fun m => own m = Φ), a m * ψphys m -
      s * φ Φ) (β : Pr → ℂ) :
    modeLift own s q a εP εM (augmentedMain φ εP β) =
      ∑ m, (β (own m) * a m) • augmentedMode ψphys εM m := by
  have hs : ∀ Φ, (Real.sqrt (εP Φ) : ℂ) ≠ 0 := fun Φ => by
    exact_mod_cast (Real.sqrt_pos.mpr (hεP Φ)).ne'
  ext o
  rcases o with _ | m
  · simp only [modeLift, augmentedMain, augmentedMode, WithLp.ofLp_sum, WithLp.ofLp_smul,
      Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    have h1 : ∀ Φ, (Real.sqrt (εP Φ) : ℂ) * β Φ / (Real.sqrt (εP Φ) : ℂ) * q Φ = β Φ * q Φ :=
      fun Φ => by rw [mul_div_cancel_left₀ _ (hs Φ)]
    simp_rw [h1, hq, mul_sub, Finset.sum_sub_distrib]
    have hfib : ∑ Φ, β Φ * ∑ m ∈ Finset.univ.filter (fun m => own m = Φ), a m * ψphys m =
        ∑ m, β (own m) * a m * ψphys m := by
      rw [← Finset.sum_fiberwise Finset.univ own (fun m => β (own m) * a m * ψphys m)]
      apply Finset.sum_congr rfl; intro Φ _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl; intro m hm
      rw [(Finset.mem_filter.mp hm).2]; ring
    rw [hfib]
    have h2 : ∑ i, s * (β i * φ i) = ∑ Φ, β Φ * (s * φ Φ) :=
      Finset.sum_congr rfl fun Φ _ => by ring
    rw [Finset.mul_sum, h2]
    ring
  · simp only [modeLift, augmentedMain, augmentedMode, WithLp.ofLp_sum, WithLp.ofLp_smul,
      Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_ite, mul_zero]
    rw [Finset.sum_ite_eq]
    simp only [Finset.mem_univ, ite_true]
    rw [mul_comm (Real.sqrt (εP (own m)) : ℂ) (β (own m)), ← mul_assoc,
      mul_div_cancel_right₀ _ (hs (own m))]
    ring

end ModeLift

section ModeLiftNorm

variable {Pr Md : Type*} [Fintype Pr] [Fintype Md] [DecidableEq Pr]

theorem columnHilbert_norm_sq {V : Type*} [Fintype V] (x : ColumnHilbert V) :
    ‖x‖ ^ 2 = ‖x none‖ ^ 2 + ∑ v, ‖x (some v)‖ ^ 2 := by
  rw [EuclideanSpace.norm_sq_eq, Fintype.sum_option]

/-- Blueprint lines 1938-1940: the lift has an absolute norm bound, `‖R F‖² ≤ 5 ‖F‖²`, when
`|s| ≤ 1`, the physical corrections satisfy `|q_Φ| ≤ δ` with `δ² Σ_Φ ε_Φ⁻¹ ≤ 1`, and the mode
weights are small: `Σ_{m ∈ Φ} ε_m |a_m|² ≤ ε_Φ`. -/
theorem modeLift_norm_sq_le (own : Md → Pr) {s : ℂ} (hs : ‖s‖ ≤ 1) (q : Pr → ℂ) {δ : ℝ}
    (hq : ∀ Φ, ‖q Φ‖ ≤ δ) (a : Md → ℂ) (εP : Pr → ℝ) (hεP : ∀ Φ, 0 < εP Φ)
    (hδ : δ ^ 2 * ∑ Φ, (εP Φ)⁻¹ ≤ 1) (εM : Md → ℝ) (hεM : ∀ m, 0 ≤ εM m)
    (hw : ∀ Φ, ∑ m ∈ Finset.univ.filter (fun m => own m = Φ), εM m * ‖a m‖ ^ 2 ≤ εP Φ)
    (F : ColumnHilbert Pr) :
    ‖modeLift own s q a εP εM F‖ ^ 2 ≤ 5 * ‖F‖ ^ 2 := by
  set Fp := ∑ Φ, ‖F (some Φ)‖ ^ 2 with hFp
  have hF : ‖F‖ ^ 2 = ‖F none‖ ^ 2 + Fp := columnHilbert_norm_sq F
  have hFp0 : 0 ≤ Fp := Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hsq : ∀ Φ, 0 < Real.sqrt (εP Φ) := fun Φ => Real.sqrt_pos.mpr (hεP Φ)
  rw [columnHilbert_norm_sq]
  -- the mode coordinates
  have hmode : ∑ m, ‖modeLift own s q a εP εM F (some m)‖ ^ 2 ≤ Fp := by
    have he : ∀ m, ‖modeLift own s q a εP εM F (some m)‖ ^ 2 =
        εM m * ‖a m‖ ^ 2 * (‖F (some (own m))‖ ^ 2 / εP (own m)) := by
      intro m
      simp only [modeLift]
      change ‖(Real.sqrt (εM m) : ℂ) * a m * F (some (own m)) /
        (Real.sqrt (εP (own m)) : ℂ)‖ ^ 2 = _
      rw [norm_div, norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
        Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Real.sqrt_nonneg _),
        abs_of_nonneg (Real.sqrt_nonneg _), div_pow, mul_pow, mul_pow, Real.sq_sqrt (hεM m),
        Real.sq_sqrt (hεP _).le]
      ring
    simp_rw [he]
    rw [← Finset.sum_fiberwise Finset.univ own]
    apply Finset.sum_le_sum; intro Φ _
    calc ∑ m ∈ Finset.univ.filter (fun m => own m = Φ),
          εM m * ‖a m‖ ^ 2 * (‖F (some (own m))‖ ^ 2 / εP (own m)) =
        (∑ m ∈ Finset.univ.filter (fun m => own m = Φ), εM m * ‖a m‖ ^ 2) *
          (‖F (some Φ)‖ ^ 2 / εP Φ) := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl; intro m hm
          rw [(Finset.mem_filter.mp hm).2]
      _ ≤ εP Φ * (‖F (some Φ)‖ ^ 2 / εP Φ) :=
          mul_le_mul_of_nonneg_right (hw Φ) (by have := hεP Φ; positivity)
      _ = ‖F (some Φ)‖ ^ 2 := by field_simp [(hεP Φ).ne']
  -- the physical coordinate
  have hphys : ‖modeLift own s q a εP εM F none‖ ≤ ‖F none‖ + Real.sqrt Fp := by
    simp only [modeLift]
    change ‖s * F none + ∑ Φ, F (some Φ) / (Real.sqrt (εP Φ) : ℂ) * q Φ‖ ≤ _
    refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
    · rw [norm_mul]; exact mul_le_of_le_one_left (norm_nonneg _) hs
    · refine (norm_sum_le _ _).trans ?_
      have hterm : ∀ Φ, ‖F (some Φ) / (Real.sqrt (εP Φ) : ℂ) * q Φ‖ ≤
          ‖F (some Φ)‖ * ((Real.sqrt (εP Φ))⁻¹ * |δ|) := by
        intro Φ
        rw [norm_mul, norm_div, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (hsq Φ), div_eq_mul_inv, mul_assoc]
        exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left
          ((hq Φ).trans (le_abs_self δ)) (inv_nonneg.mpr (hsq Φ).le)) (norm_nonneg _)
      refine (Finset.sum_le_sum fun Φ _ => hterm Φ).trans ?_
      refine (Real.sum_mul_le_sqrt_mul_sqrt _ _ _).trans ?_
      have hw2 : ∑ Φ, ((Real.sqrt (εP Φ))⁻¹ * |δ|) ^ 2 ≤ 1 := by
        calc ∑ Φ, ((Real.sqrt (εP Φ))⁻¹ * |δ|) ^ 2 = δ ^ 2 * ∑ Φ, (εP Φ)⁻¹ := by
              rw [Finset.mul_sum]
              apply Finset.sum_congr rfl; intro Φ _
              rw [mul_pow, inv_pow, Real.sq_sqrt (hεP Φ).le, sq_abs]; ring
          _ ≤ 1 := hδ
      calc Real.sqrt (∑ Φ, ‖F (some Φ)‖ ^ 2) *
            Real.sqrt (∑ Φ, ((Real.sqrt (εP Φ))⁻¹ * |δ|) ^ 2) ≤ Real.sqrt Fp * 1 :=
            mul_le_mul_of_nonneg_left (Real.sqrt_le_one.mpr hw2) (Real.sqrt_nonneg _)
        _ = Real.sqrt Fp := mul_one _
  have hph2 : ‖modeLift own s q a εP εM F none‖ ^ 2 ≤ 2 * ‖F none‖ ^ 2 + 2 * Fp := by
    have h := pow_le_pow_left₀ (norm_nonneg _) hphys 2
    have hs2 := Real.sq_sqrt hFp0
    nlinarith [sq_nonneg (‖F none‖ - Real.sqrt Fp)]
  rw [hF]
  have : 0 ≤ ‖F none‖ ^ 2 := sq_nonneg _
  linarith

end ModeLiftNorm

/-! ### Offset averages of the branch cutoff (`eq:offset-mean`) -/

section OffsetMean

/-- The one-dimensional branch profile: one on `[2δ, 1-2δ]`, zero outside `[δ, 1-δ]`. -/
noncomputable def branchProfile (δ s : ℝ) : ℝ := gevreyIntervalCutoff 0 (2 * δ) (1 - 2 * δ) 1 s

theorem branchProfile_mem (δ s : ℝ) : branchProfile δ s ∈ Set.Icc (0 : ℝ) 1 :=
  gevreyIntervalCutoff_mem_Icc _ _ _ _ _

theorem branchProfile_eq_one {δ s : ℝ} (hδ : 0 < δ) (hs : 2 * δ ≤ s) (hs' : s ≤ 1 - 2 * δ) :
    branchProfile δ s = 1 :=
  gevreyIntervalCutoff_eq_one (by linarith) (by linarith) ⟨hs, hs'⟩

theorem branchProfile_continuous (δ : ℝ) : Continuous (branchProfile δ) :=
  (gevreyIntervalCutoff_contDiff 0 0 (2 * δ) (1 - 2 * δ) 1).continuous

/-- The offset average of a function of `{u - ρ}` over `ρ ∈ [0,1]` is its mean over `[0,1]`. -/
theorem integral_fract_shift (f : ℝ → ℝ) (u : ℝ) :
    ∫ ρ in Set.Icc (0 : ℝ) 1, f (Int.fract (u - ρ)) = ∫ s in Set.Icc (0 : ℝ) 1, f s := by
  have hper : Function.Periodic (fun x => f (Int.fract x)) 1 := fun x => by
    simp [Int.fract_add_one]
  rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le zero_le_one,
    MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le zero_le_one]
  rw [intervalIntegral.integral_comp_sub_left (fun x => f (Int.fract x)) u]
  have h1 := hper.intervalIntegral_add_eq (u - 1) 0
  rw [show u - 1 + 1 = u by ring, zero_add] at h1
  rw [show u - 0 = u by ring, h1]
  apply intervalIntegral.integral_congr_ae
  rw [Set.uIoc_of_le zero_le_one]
  filter_upwards [Measure.ae_ne volume (1 : ℝ)] with x hx1 hx
  have h0 : 0 ≤ x := hx.1.le
  have h1 : x < 1 := lt_of_le_of_ne hx.2 hx1
  rw [Int.fract_eq_self.mpr ⟨h0, h1⟩]

end OffsetMean

section OffsetMean2

/-- The uniform offset measure on `[0,1]ᵈ`. -/
noncomputable def offsetMeasure (d : ℕ) : Measure (Fin d → ℝ) :=
  Measure.pi fun _ : Fin d => volume.restrict (Set.Icc (0 : ℝ) 1)

instance offsetMeasure_prob (d : ℕ) : IsProbabilityMeasure (offsetMeasure d) := by
  unfold offsetMeasure
  have : ∀ _ : Fin d, IsProbabilityMeasure (volume.restrict (Set.Icc (0 : ℝ) 1)) := fun _ =>
    ⟨by simp⟩
  infer_instance

/-- The periodic branch cutoff `ζ^ρ(u) = Π_i β({u_i - ρ_i})`. -/
noncomputable def branchCutoffValue {d : ℕ} (δ : ℝ) (ρ u : Fin d → ℝ) : ℝ :=
  ∏ i, branchProfile δ (Int.fract (u i - ρ i))

theorem branchCutoffValue_mem {d : ℕ} (δ : ℝ) (ρ u : Fin d → ℝ) :
    branchCutoffValue δ ρ u ∈ Set.Icc (0 : ℝ) 1 := by
  unfold branchCutoffValue
  refine ⟨Finset.prod_nonneg fun i _ => (branchProfile_mem δ _).1, ?_⟩
  exact Finset.prod_le_one₀ (fun i _ => (branchProfile_mem δ _).1)
    (fun i _ => (branchProfile_mem δ _).2)

theorem one_sub_prod_le_sum {ι : Type*} (s : Finset ι) (x : ι → ℝ) (h0 : ∀ i ∈ s, 0 ≤ x i)
    (h1 : ∀ i ∈ s, x i ≤ 1) : 1 - ∏ i ∈ s, x i ≤ ∑ i ∈ s, (1 - x i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert j s hj ih =>
    rw [Finset.prod_insert hj, Finset.sum_insert hj]
    have hj0 := h0 j (Finset.mem_insert_self j s)
    have hj1 := h1 j (Finset.mem_insert_self j s)
    have ih' := ih (fun i hi => h0 i (Finset.mem_insert_of_mem hi))
      (fun i hi => h1 i (Finset.mem_insert_of_mem hi))
    have hp0 : 0 ≤ ∏ i ∈ s, x i := Finset.prod_nonneg fun i hi => h0 i (Finset.mem_insert_of_mem hi)
    have hp1 : ∏ i ∈ s, x i ≤ 1 := Finset.prod_le_one₀ (fun i hi => h0 i (Finset.mem_insert_of_mem
        hi))
      (fun i hi => h1 i (Finset.mem_insert_of_mem hi))
    nlinarith

theorem profile_mean_bounds {δ : ℝ} (hδ : 0 < δ) (hδ' : δ ≤ 1 / 4) :
    1 - 4 * δ ≤ ∫ s in Set.Icc (0 : ℝ) 1, branchProfile δ s ∧
      ∫ s in Set.Icc (0 : ℝ) 1, (1 - branchProfile δ s ^ 2) ≤ 4 * δ := by
  set A := Set.Icc (2 * δ) (1 - 2 * δ)
  have hA : A ⊆ Set.Icc (0 : ℝ) 1 := fun x hx => ⟨by linarith [hx.1], by linarith [hx.2]⟩
  have hvol : (volume.restrict (Set.Icc (0 : ℝ) 1)).real A = 1 - 4 * δ := by
    rw [measureReal_def, Measure.restrict_apply measurableSet_Icc, Set.inter_eq_left.mpr hA,
      Real.volume_Icc, ENNReal.toReal_ofReal (by linarith)]
    ring
  have hind : ∫ s in Set.Icc (0 : ℝ) 1, A.indicator (fun _ => (1 : ℝ)) s = 1 - 4 * δ := by
    rw [integral_indicator_const _ measurableSet_Icc, smul_eq_mul, mul_one, hvol]
  have hint (f : ℝ → ℝ) (hf : Continuous f) : IntegrableOn f (Set.Icc (0 : ℝ) 1) :=
    hf.integrableOn_Icc
  have hcont := branchProfile_continuous δ
  have hindint : IntegrableOn (A.indicator fun _ => (1 : ℝ)) (Set.Icc (0 : ℝ) 1) :=
    (integrableOn_const (by simp)).indicator measurableSet_Icc
  constructor
  · rw [← hind]
    apply setIntegral_mono hindint (hint _ hcont)
    intro s
    by_cases hs : s ∈ A
    · rw [Set.indicator_of_mem hs, branchProfile_eq_one hδ hs.1 hs.2]
    · rw [Set.indicator_of_notMem hs]; exact (branchProfile_mem δ s).1
  · have h1 : ∫ s in Set.Icc (0 : ℝ) 1, (1 - A.indicator (fun _ => (1 : ℝ)) s) = 4 * δ := by
      rw [integral_sub (integrableOn_const (by simp)) hindint, hind]
      simp
    rw [← h1]
    apply setIntegral_mono (hint _ (continuous_const.sub (hcont.pow 2)))
      ((integrableOn_const (by simp)).sub hindint)
    intro s
    simp only [Pi.sub_apply, Pi.pow_apply]
    by_cases hs : s ∈ A
    · rw [Set.indicator_of_mem hs, branchProfile_eq_one hδ hs.1 hs.2]; norm_num
    · rw [Set.indicator_of_notMem hs]
      have := (branchProfile_mem δ s).1
      nlinarith

/-- Blueprint `eq:offset-mean` (line 1908): translation invariance gives, pointwise in `u`,
`E_ρ ζ^ρ = c_ζ ≥ 1/2` (with `c_ζ` independent of `u`) and `E_ρ |1 - (ζ^ρ)²|² ≤ 4 d δ`,
for `0 < δ` and `8 d δ ≤ 1`. -/
theorem offsetMean {d : ℕ} {δ : ℝ} (hδ : 0 < δ) (hdδ : 8 * d * δ ≤ 1) (hδ' : δ ≤ 1 / 8)
    (u : Fin d → ℝ) :
    ∫ ρ, branchCutoffValue δ ρ u ∂(offsetMeasure d) =
        (∫ s in Set.Icc (0 : ℝ) 1, branchProfile δ s) ^ d ∧
      1 / 2 ≤ (∫ s in Set.Icc (0 : ℝ) 1, branchProfile δ s) ^ d ∧
      ∫ ρ, (1 - branchCutoffValue δ ρ u ^ 2) ^ 2 ∂(offsetMeasure d) ≤ 4 * d * δ := by
  have hcont := branchProfile_continuous δ
  have hfr : ∀ (g : ℝ → ℝ), Continuous g → ∀ i,
      ∫ x in Set.Icc (0 : ℝ) 1, g (Int.fract (u i - x)) = ∫ s in Set.Icc (0 : ℝ) 1, g s :=
    fun g _ i => integral_fract_shift g (u i)
  obtain ⟨hlow, hdef⟩ := profile_mean_bounds hδ (by linarith)
  refine ⟨?_, ?_, ?_⟩
  · unfold branchCutoffValue offsetMeasure
    rw [integral_fintype_prod_eq_prod (fun i x => branchProfile δ (Int.fract (u i - x)))]
    simp_rw [hfr _ hcont]
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  · have hb : -2 ≤ -4 * δ := by linarith
    have hB := one_add_mul_le_pow hb d
    have h1 : 1 / 2 ≤ 1 + (d : ℝ) * (-4 * δ) := by nlinarith
    calc 1 / 2 ≤ 1 + (d : ℝ) * (-4 * δ) := h1
      _ ≤ (1 + -4 * δ) ^ d := hB
      _ ≤ _ := pow_le_pow_left₀ (by linarith) (by linarith) d
  · -- pointwise bound by the coordinate defects
    set g : Fin d → (Fin d → ℝ) → ℝ := fun i ρ => 1 - branchProfile δ (Int.fract (u i - ρ i)) ^ 2
    have hpt : ∀ ρ, (1 - branchCutoffValue δ ρ u ^ 2) ^ 2 ≤ ∑ i, g i ρ := by
      intro ρ
      have hm := branchCutoffValue_mem δ ρ u
      have h0 : 0 ≤ 1 - branchCutoffValue δ ρ u ^ 2 := by nlinarith [hm.1, hm.2]
      have h1 : 1 - branchCutoffValue δ ρ u ^ 2 ≤ 1 := by nlinarith
      have hsq : branchCutoffValue δ ρ u ^ 2 = ∏ i, branchProfile δ (Int.fract (u i - ρ i)) ^ 2 :=
          by
        rw [branchCutoffValue, Finset.prod_pow]
      calc (1 - branchCutoffValue δ ρ u ^ 2) ^ 2 ≤ 1 - branchCutoffValue δ ρ u ^ 2 := by nlinarith
        _ ≤ ∑ i, g i ρ := by
            rw [hsq]
            exact one_sub_prod_le_sum _ _
              (fun i _ => sq_nonneg _)
              (fun i _ => by
                have := branchProfile_mem δ (Int.fract (u i - ρ i))
                nlinarith [this.1, this.2])
    have hmeas : ∀ i, Measurable (g i) := fun i =>
      measurable_const.sub (((hcont.measurable.comp ((measurable_fract (R := ℝ)).comp
        (measurable_const.sub (measurable_pi_apply i)))).pow_const 2))
    have hgi : ∀ i, Integrable (g i) (offsetMeasure d) := fun i =>
      Integrable.of_bound (hmeas i).aestronglyMeasurable 1 (Filter.Eventually.of_forall fun ρ => by
        have := branchProfile_mem δ (Int.fract (u i - ρ i))
        simp only [g, Real.norm_eq_abs]
        rw [abs_le]; constructor <;> nlinarith [this.1, this.2])
    have hmarg : ∀ i, ∫ ρ, g i ρ ∂(offsetMeasure d) ≤ 4 * δ := by
      intro i
      classical
      have hprod : (fun ρ : Fin d → ℝ => g i ρ) = fun ρ => ∏ j, (if j = i then
          (fun x => 1 - branchProfile δ (Int.fract (u i - x)) ^ 2) else fun _ => (1 : ℝ)) (ρ j) :=
              by
        funext ρ
        rw [Finset.prod_eq_single i]
        · simp [g]
        · intro j _ hj; simp [hj]
        · intro h; exact absurd (Finset.mem_univ i) h
      rw [hprod, offsetMeasure, integral_fintype_prod_eq_prod]
      rw [Finset.prod_eq_single i]
      · simp only [ite_true]
        rw [hfr (fun s => 1 - branchProfile δ s ^ 2) (continuous_const.sub (hcont.pow 2)) i]
        exact hdef
      · intro j _ hj; simp [hj]
      · intro h; exact absurd (Finset.mem_univ i) h
    calc ∫ ρ, (1 - branchCutoffValue δ ρ u ^ 2) ^ 2 ∂(offsetMeasure d) ≤
        ∫ ρ, ∑ i, g i ρ ∂(offsetMeasure d) := by
          apply integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => sq_nonneg _)
            (integrable_finsetSum _ fun i _ => hgi i) (Filter.Eventually.of_forall hpt)
      _ = ∑ i, ∫ ρ, g i ρ ∂(offsetMeasure d) := integral_finsetSum _ fun i _ => hgi i
      _ ≤ ∑ _i : Fin d, 4 * δ := Finset.sum_le_sum fun i _ => hmarg i
      _ = 4 * d * δ := by simp; ring

end OffsetMean2

/-- The branch amplitude `w ↦ Π_i β(w_i - ρ_i)`, supported in the open branch cube. -/
noncomputable def branchAmp {d : ℕ} (δ : ℝ) (ρ w : Fin d → ℝ) : ℂ :=
  ∏ i, ((branchProfile δ (w i - ρ i) : ℝ) : ℂ)

theorem branchAmp_smooth {d : ℕ} (δ : ℝ) (ρ : Fin d → ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (branchAmp δ ρ) := by
  unfold branchAmp
  apply contDiff_prod
  intro i _
  exact Complex.ofRealCLM.contDiff.comp ((contDiff_infty.mpr fun n =>
    gevreyIntervalCutoff_contDiff n _ _ _ _).comp ((contDiff_apply ℝ ℝ i).sub contDiff_const))

theorem branchAmp_support {d : ℕ} {δ : ℝ} (hδ : 0 < δ) (_hδ' : δ < 1 / 4) {ρ w : Fin d → ℝ}
    (hw : branchAmp δ ρ w ≠ 0) (i : Fin d) : ρ i < w i ∧ w i < ρ i + 1 := by
  have h : branchProfile δ (w i - ρ i) ≠ 0 := by
    intro h0; apply hw
    exact Finset.prod_eq_zero (Finset.mem_univ i) (by rw [h0]; simp)
  constructor
  · by_contra hc
    exact h (gevreyIntervalCutoff_zero_left (by linarith) (by push Not at hc; linarith))
  · by_contra hc
    exact h (gevreyIntervalCutoff_zero_right (by linarith) (by push Not at hc; linarith))

theorem branchAmp_hasCompactSupport {d : ℕ} {δ : ℝ} (hδ : 0 < δ) (hδ' : δ < 1 / 4)
    (ρ : Fin d → ℝ) : HasCompactSupport (branchAmp δ ρ) := by
  apply HasCompactSupport.intro (isCompact_Icc (a := ρ) (b := fun i => ρ i + 1))
  intro w hw
  by_contra hne
  apply hw
  exact ⟨fun i => (branchAmp_support hδ hδ' hne i).1.le,
    fun i => (branchAmp_support hδ hδ' hne i).2.le⟩

theorem branchAmp_branchLift {d : ℕ} (δ : ℝ) (ρ u : Fin d → ℝ) :
    branchAmp δ ρ (branchLift ρ u) = (branchCutoffValue δ ρ u : ℂ) := by
  simp only [branchAmp, branchLift, branchCutoffValue, add_sub_cancel_left]
  push_cast
  rfl

/-- Blueprint §13.1, `first-match` (line 1936, `THT.Modes.firstMatchExpansionAndLift`), the
expansion part with the explicit periodic Gevrey branch cutoff `ζ^ρ`
(`branchCutoffValue`, offset average `offsetMean`): for a primary `Φ` of tag `v` matched to a
group center `z` with `tagEdge` at length `r`,
`φ_Φ(t) ζ^ρ(t) e(-c p_ρ(t)) = Σ_ℓ a_ℓ e(λ_* t² + γ_ℓ t)` exactly on `|t| ≤ R r`, with one common
curvature, rational frequency differences and quasipolynomial counts and coefficient norms.
The pointwise lift to modes is `modeLift` (`modeLift_synthesis`, `modeLift_norm_sq_le`). -/
theorem firstMatchExpansionAndLift (c₀ : ℕ) (hc : 1 ≤ c₀) (R : ℝ) (hR : 0 ≤ R) :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ (v z : ChartTag) (c : ℤ), c ≠ 0 → |c| ≤ 3 →
    ∀ (H B r δ : ℝ) (hδ : 0 < δ) (hδ' : δ < 1 / 4) (Φ : QuadraticChartData v.dim)
      (ρ : Fin z.dim → ℝ),
      Φ.horizontal = v.θ → Φ.matrix = (c : ℚ) • v.C → Φ.quadratic = c * v.lam →
      QuadraticChartComplexity c₀ H (productQuadraticChart Φ
        (branchChart z c (branchAmp_smooth δ ρ) (branchAmp_hasCompactSupport hδ hδ' ρ))) →
      0 < r → 2 ≤ B → tagEdge B r v z →
      let P := productQuadraticChart Φ
        (branchChart z c (branchAmp_smooth δ ρ) (branchAmp_hasCompactSupport hδ hδ' ρ))
      let X := 1 + Real.log H + Real.log (3 * B)
      ∃ M : Matrix (Fin (v.dim + z.dim)) (Fin (v.dim + z.dim)) ℚ,
        (∀ i j, (rationalHeight (M i j) : ℝ) ≤ Real.exp (D * X ^ D)) ∧
        |P.quadratic + ∑ i, ∑ j, P.horizontal i * (M i j : ℝ) * P.horizontal j| * r ^ 2 ≤
          Real.exp (D * X ^ D) ∧
        ∃ (ι : Type) (_ : Fintype ι)
          (σ : ι × (Fin ((v.dim + z.dim) + (v.dim + z.dim)) → ℤ) → Fin (v.dim + z.dim) → ℚ),
          (Fintype.card ι : ℝ) ≤ Real.exp (D * X ^ D) ∧
          (∀ p i, (rationalHeight (σ p i) : ℝ) ≤
            Real.exp (D * X ^ D) * (1 + frequencyLength p.2)) ∧
          ∃ a : ι × (Fin ((v.dim + z.dim) + (v.dim + z.dim)) → ℤ) → ℂ,
            (∀ t : ℝ, |t| ≤ R * r →
              HasSum (fun p => a p * (Real.fourierChar ((P.quadratic +
                  ∑ i, ∑ j, P.horizontal i * (M i j : ℝ) * P.horizontal j) * t ^ 2 +
                  (Φ.linear + ∑ i, (σ p i : ℝ) * P.horizontal i) * t) : ℂ))
                (quadraticChartAtom Φ t * ((branchCutoffValue δ ρ (fun i => z.θ i * t) : ℂ) *
                  (Real.fourierChar (-(c : ℝ) * (z.lam * t ^ 2 +
                    chartMatrixPhase z.C (fun i => z.θ i * t)
                      (branchLift ρ (fun i => z.θ i * t)))) : ℂ)))) ∧
            Summable (fun p => ‖a p‖) ∧ (∑' p, ‖a p‖) ≤ Real.exp (D * X ^ D) := by
  obtain ⟨D, hD, hfm⟩ := firstMatchExpansion c₀ hc R hR
  refine ⟨D, hD, ?_⟩
  intro v z c hc0 hc3 H B r δ hδ hδ' Φ ρ hθ hM hq hP hr hB hE P X
  obtain ⟨M, hMh, hlam, ι, hι, σ, hcard, hσ, a, hexp, hsumm, htot⟩ :=
    hfm v z c hc0 hc3 H B r Φ ρ (branchAmp_smooth δ ρ) (branchAmp_hasCompactSupport hδ hδ' ρ)
      (fun w hw i => branchAmp_support hδ hδ' hw i) hθ hM hq hP hr hB hE
  refine ⟨M, hMh, hlam, ι, hι, σ, hcard, hσ, a, fun t ht => ?_, hsumm, htot⟩
  have h := hexp t ht
  rwa [branchAmp_branchLift] at h

/-! ### The common progression multiplier and the schedule (blueprint lines 1942-1976) -/

section GaugeCancel

variable {d : ℕ}

/-- The carries `k_j = d_j - (1-j) d_0 - j d_1` of four branch lifts `d_j = d_{ρ_j}(θ y_j)`. -/
noncomputable def gaugeCarry (θ : Fin d → ℝ) (ρ : Fin 4 → Fin d → ℝ) (x t : ℝ) (j : Fin 4) :
    Fin d → ℝ := fun a =>
  branchLift (ρ j) (fun b => θ b * (x + ((j : ℕ) : ℝ) * t)) a -
    (1 - ((j : ℕ) : ℝ)) * branchLift (ρ 0) (fun b => θ b * (x + ((0 : Fin 4) : ℕ) * t)) a -
    ((j : ℕ) : ℝ) * branchLift (ρ 1) (fun b => θ b * (x + ((1 : Fin 4) : ℕ) * t)) a

/-- The carries are integer vectors, for arbitrary offsets. -/
theorem gaugeCarry_int (θ : Fin d → ℝ) (ρ : Fin 4 → Fin d → ℝ) (x t : ℝ) (j : Fin 4)
    (a : Fin d) : ∃ n : ℤ, gaugeCarry θ ρ x t j a = n := by
  have hsub (i : Fin 4) := congrFun (branchLift_sub (ρ i)
    (fun b => θ b * (x + ((i : ℕ) : ℝ) * t))) a
  simp only [Pi.sub_apply] at hsub
  refine ⟨⌊θ a * (x + (((j : ℕ) : ℝ)) * t) - ρ j a⌋ * (-1) +
    (1 - (j : ℕ)) * ⌊θ a * (x + ((0 : Fin 4) : ℕ) * t) - ρ 0 a⌋ +
    (j : ℕ) * ⌊θ a * (x + ((1 : Fin 4) : ℕ) * t) - ρ 1 a⌋, ?_⟩
  have h0 := hsub 0; have h1 := hsub 1; have hj := hsub j
  simp only [gaugeCarry]
  push_cast
  simp only [Fin.isValue, Fin.val_zero, Fin.val_one, Nat.cast_zero, Nat.cast_one] at h0 h1 ⊢
  linear_combination (-1 : ℝ) * hj + (1 - ((j : ℕ) : ℝ)) * h0 + ((j : ℕ) : ℝ) * h1

/-- Blueprint `eq:gauge-cancel` (line 1942): with four offsets, the product of the demodulation
phases `e(c_j p_{ρ_j}(y_j))` of a group center over the four slots is the linear carry
character `e(Σ_j c_j (θ y_j)ᵀ C k_j)`, by the three identities `Σ c_j j^u = 0`. -/
theorem gauge_cancel (θ : Fin d → ℝ) (C : Matrix (Fin d) (Fin d) ℚ) (lam : ℝ)
    (ρ : Fin 4 → Fin d → ℝ) (x t : ℝ) :
    ∑ j : Fin 4, (slotCoeff j : ℝ) * (lam * (x + ((j : ℕ) : ℝ) * t) ^ 2 +
      chartMatrixPhase C (fun a => θ a * (x + ((j : ℕ) : ℝ) * t))
        (branchLift (ρ j) (fun a => θ a * (x + ((j : ℕ) : ℝ) * t)))) =
      ∑ j : Fin 4, (slotCoeff j : ℝ) *
        chartMatrixPhase C (fun a => θ a * (x + ((j : ℕ) : ℝ) * t)) (gaugeCarry θ ρ x t j) := by
  set D0 := branchLift (ρ 0) (fun b => θ b * (x + ((0 : Fin 4) : ℕ) * t))
  set D1 := branchLift (ρ 1) (fun b => θ b * (x + ((1 : Fin 4) : ℕ) * t))
  have h := tag_phase_identity C θ lam x t 0 D0 D1 (fun j => -gaugeCarry θ ρ x t j)
  have hw : ∀ j : Fin 4, (tagWeight 0 j : ℝ) = ((j : ℕ) : ℝ) := by
    intro j; fin_cases j <;> simp [tagWeight, tagPartner]
  have hD : ∀ j : Fin 4, (fun b => D0 b + (tagWeight 0 j : ℝ) * (D1 b - D0 b) -
      (-gaugeCarry θ ρ x t j) b) =
      branchLift (ρ j) (fun a => θ a * (x + ((j : ℕ) : ℝ) * t)) := by
    intro j; funext b
    simp only [hw, Pi.neg_apply, gaugeCarry, D0, D1]
    ring
  simp_rw [hD] at h
  rw [h, ← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl; intro j _
  have : chartMatrixPhase C (fun a => θ a * (x + ((j : ℕ) : ℝ) * t)) (-gaugeCarry θ ρ x t j) =
      -chartMatrixPhase C (fun a => θ a * (x + ((j : ℕ) : ℝ) * t)) (gaugeCarry θ ρ x t j) := by
    simp [chartMatrixPhase, Finset.sum_neg_distrib]
  rw [this]; ring

end GaugeCancel

/-- Blueprint `eq:slope-variation` (line 1966): a mode `e(λ y² + γ y)` with `|λ| r_I² ≤ D` on its
first-match cell `I` has, on a subcell `J` of length `r_J = 2^{-n} r_I`, frequency oscillation
`r_J osc_J ω ≤ 2 D 4^{-n}`, `ω(y) = 2λ y + γ`. -/
theorem slope_variation {lam γ rI D : ℝ} (hrI : 0 < rI) (hlam : |lam| * rI ^ 2 ≤ D) (n : ℕ)
    {a : ℝ} {y y' : ℝ} (hy : y ∈ Set.Icc a (a + rI / 2 ^ n))
    (hy' : y' ∈ Set.Icc a (a + rI / 2 ^ n)) :
    rI / 2 ^ n * |(2 * lam * y' + γ) - (2 * lam * y + γ)| ≤ 2 * D / 4 ^ n := by
  have h2 : (0 : ℝ) < 2 ^ n := by positivity
  have hyy : |y' - y| ≤ rI / 2 ^ n := by
    rw [abs_le]; constructor <;> linarith [hy.1, hy.2, hy'.1, hy'.2]
  have he : (2 * lam * y' + γ) - (2 * lam * y + γ) = 2 * lam * (y' - y) := by ring
  rw [he, abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
  have h4 : (4 : ℝ) ^ n = 2 ^ n * 2 ^ n := by rw [← mul_pow]; norm_num
  calc rI / 2 ^ n * (2 * |lam| * |y' - y|) ≤ rI / 2 ^ n * (2 * |lam| * (rI / 2 ^ n)) := by
        gcongr
    _ = 2 * (|lam| * rI ^ 2) / 4 ^ n := by rw [h4]; field_simp
    _ ≤ 2 * D / 4 ^ n := by gcongr

section ModeSchedule

/-- The parameters of blueprint `eq:mode-parameters` and `eq:lags` (lines 1950-1962). -/
structure ModeSchedule where
  dmax : ℕ
  Dstar : ℝ
  Bstar : ℝ
  Dm : ℝ
  Q0 : ℕ
  Cstar : ℝ
  Rht : ℕ
  Jstar : ℕ
  A0 : ℝ
  H : ℝ
  T : ℝ
  K : ℕ

namespace ModeSchedule

variable (S : ModeSchedule)

/-- `L_h = 6^h`. -/
noncomputable def Lh (h : ℕ) : ℝ := 6 ^ h

/-- `E_h = A₀^{h+1}`. -/
noncomputable def Eh (h : ℕ) : ℝ := S.A0 ^ (h + 1)

/-- `Ξ = D_*^{1000}`. -/
noncomputable def Ξ : ℝ := S.Dstar ^ 1000

/-- The block lags `u_b = b - 4K`, `v_b = b - 2K`, `t_b = b + K` of `eq:lags`. -/
def lagU (b : ℤ) : ℤ := b - 4 * S.K
def lagV (b : ℤ) : ℤ := b - 2 * S.K
def lagT (b : ℤ) : ℤ := b + S.K

/-- The defining inequalities of `eq:mode-parameters`, with absolute constants `Cj, CA, CT, CK`,
a small absolute `δ_*` and the packet width `W` of lem:height at height `H`. -/
structure Valid (Cj CA CT CK : ℕ) (δs W : ℝ) : Prop where
  Cstar_ge : ((10 * S.dmax * S.Dstar) ^ (100 * S.dmax ^ 4) : ℝ) ≤ S.Cstar
  Rht_ge : Real.logb 2 S.Cstar + 30 ≤ S.Rht
  Jstar_ge : Cj * δs⁻¹ ^ 2 * S.dmax * S.Rht * Real.log (2 * S.Dm) ≤ S.Jstar
  A0_ge : (S.Cstar * 6 ^ S.Rht * S.Bstar * S.Dstar) ^ CA ≤ S.A0
  H_gt : (S.dmax * S.Cstar * S.Eh S.Jstar * S.Bstar * Lh S.Jstar * S.Q0 * S.Ξ) ^ 10 < S.H
  T_gt : (S.dmax * S.H) ^ (CT * S.dmax ^ 4) * S.Ξ < S.T
  K_dyadic : ∃ κ : ℕ, S.K = 2 ^ κ
  K_ge : W + 2 * Real.logb 2 S.T + CK * Real.logb 2 S.Dstar ≤ S.K

end ModeSchedule

theorem logb_two_le_two_log {x : ℝ} (hx : 1 ≤ x) : Real.logb 2 x ≤ 2 * Real.log x := by
  rw [Real.logb, div_le_iff₀ (Real.log_pos (by norm_num))]
  have h0 := Real.log_nonneg hx
  have hh : (1 / 2 : ℝ) ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]
  calc Real.log x = 2 * Real.log x * (1 / 2) := by ring
    _ ≤ 2 * Real.log x * Real.log 2 := mul_le_mul_of_nonneg_left hh (by positivity)

set_option maxHeartbeats 1000000 in
-- the explicit parameter bookkeeping is one long declaration and needs more than the default
-- budget
/-- Blueprint `mode-schedule` (line 1976, `THT.Modes.chooseSchedule`): given the main budget
`D_m`, the dimension bound `d_max`, the mode budget `D_*`, the cutoff `B_*`, the clearing
integer `Q₀` and the packet width `W`, the parameters of `eq:mode-parameters` can be chosen in
the displayed order, and all their logarithms are polynomial in
`Λ = d_max + log D_* + log B_* + log D_m + log Q₀ + 1`: `log H ≤ M Λ^{12}`,
`log T ≤ M Λ^{16}`, `K ≤ 2 W + M Λ^{16}`, with `M` depending only on the absolute constants. -/
theorem chooseSchedule (Cj CA CT CK : ℕ) {δs : ℝ} (hδs : 0 < δs) (_hδs1 : δs ≤ 1) :
    ∃ M : ℝ, 0 < M ∧ ∀ (dmax : ℕ) (Dstar Bstar Dm W : ℝ) (Q0 : ℕ), 2 ≤ dmax → 2 ≤ Dstar →
      2 ≤ Bstar → 2 ≤ Dm → 1 ≤ Q0 → 0 ≤ W →
      let Λ := (dmax : ℝ) + Real.log Dstar + Real.log Bstar + Real.log Dm + Real.log Q0 + 1
      ∃ S : ModeSchedule, S.dmax = dmax ∧ S.Dstar = Dstar ∧ S.Bstar = Bstar ∧ S.Dm = Dm ∧
        S.Q0 = Q0 ∧ S.Valid Cj CA CT CK δs W ∧
        Real.log S.H ≤ M * Λ ^ 12 ∧ Real.log S.T ≤ M * Λ ^ 16 ∧ (S.K : ℝ) ≤ 2 * W + M * Λ ^ 16 := by
  -- the constants
  set cJ : ℝ := 1262 * Cj * (δs⁻¹) ^ 2 + 1 with hcJ
  set cA : ℝ := 1564 * CA + 1 with hcA
  set cX : ℝ := cJ * cA + cA + 300 + 2 * cJ + 1003 with hcX
  set cH : ℝ := 10 * cX + 1 with hcH
  set cT : ℝ := CT * (1 + cH) + 1001 with hcT
  have hcJ0 : 1 ≤ cJ := by
    rw [hcJ]; have : 0 ≤ 1262 * (Cj : ℝ) * (δs⁻¹) ^ 2 := by positivity
    linarith
  have hcA0 : 1 ≤ cA := by rw [hcA]; have : (0 : ℝ) ≤ CA := Nat.cast_nonneg _; linarith
  have hcX0 : 0 ≤ cX := by rw [hcX]; positivity
  have hcH0 : 0 ≤ cH := by rw [hcH]; positivity
  have hcT0 : 0 ≤ cT := by rw [hcT]; positivity
  refine ⟨cH + cT + (8 * cT + 4 * CK + 2), by positivity, ?_⟩
  intro dmax Dstar Bstar Dm W Q0 hd hD hB hM hQ hW Λ
  set d : ℝ := ((dmax : ℕ) : ℝ) with hdd
  have hd2 : (2 : ℝ) ≤ d := by rw [hdd]; exact_mod_cast hd
  have hl2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hlD : Real.log 2 ≤ Real.log Dstar := Real.log_le_log (by norm_num) hD
  have hlB : Real.log 2 ≤ Real.log Bstar := Real.log_le_log (by norm_num) hB
  have hlM : Real.log 2 ≤ Real.log Dm := Real.log_le_log (by norm_num) hM
  have hlQ : 0 ≤ Real.log Q0 := Real.log_nonneg (by exact_mod_cast hQ)
  have hΛ : d + 1 ≤ Λ := by simp only [Λ, hdd]; linarith
  have hΛ1 : 1 ≤ Λ := by linarith
  have hdΛ : d ≤ Λ := by linarith
  have hlDΛ : Real.log Dstar ≤ Λ := by simp only [Λ]; linarith
  have hlBΛ : Real.log Bstar ≤ Λ := by simp only [Λ]; linarith
  have hlMΛ : Real.log Dm ≤ Λ := by simp only [Λ]; linarith
  have hlQΛ : Real.log Q0 ≤ Λ := by simp only [Λ]; linarith
  have hldΛ : Real.log d ≤ Λ := (Real.log_le_sub_one_of_pos (by linarith)).trans (by linarith)
  clear_value Λ
