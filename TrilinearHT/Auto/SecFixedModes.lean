          rw [Finset.sum_range_sub (fun i => (harmonic (S i).card : ℝ)), hS0]
          simp
  calc _ ≤ _ := step1
    _ ≤ _ := step2
    _ ≤ A * (harmonic (S n).card : ℝ) := by
        rw [step3]
        exact mul_le_mul_of_nonneg_left step4 (by positivity)

/-- Corollary: `Σ_j |X_j|/|S_j| ≤ A (1 + log M)` when `|S_n| ≤ M`. -/
theorem sum_frac_le_log {α : Type*} [DecidableEq α] (S : ℕ → Finset α) (hS : Monotone S)
    (hS0 : S 0 = ∅) (X : ℕ → Finset α) (hX : ∀ j, X j ⊆ S j) (n A M : ℕ)
    (hA : ∀ x, ((Finset.range n).filter fun j => x ∈ X (j + 1)).card ≤ A)
    (hM : (S n).card ≤ M) :
    ∑ j ∈ Finset.range n, ((X (j + 1)).card : ℝ) / (S (j + 1)).card ≤ A * (1 + Real.log M) := by
  refine (sum_frac_le_harmonic S hS hS0 X hX n A hA).trans
    (mul_le_mul_of_nonneg_left ?_ (by positivity))
  refine (harmonic_le_one_add_log _).trans ?_
  rcases Nat.eq_zero_or_pos (S n).card with h0 | hpos
  · rw [h0]; simp only [Nat.cast_zero, Real.log_zero, add_zero]
    rcases Nat.eq_zero_or_pos M with hM0 | hMpos
    · simp [hM0]
    · have : (1 : ℝ) ≤ M := by exact_mod_cast hMpos
      linarith [Real.log_nonneg this]
  · gcongr

/-- Blueprint line 2091, first term: for `1 ≤ p_h ≤ M` the shifted logarithmic increments
`Σ_{h<n} log(p_{h+Δ}/p_h)` sum to at most `Δ log M`. -/
theorem sum_log_shift_le {p : ℕ → ℝ} {M : ℝ} (hp1 : ∀ h, 1 ≤ p h) (hpM : ∀ h, p h ≤ M)
    (Δ n : ℕ) :
    ∑ h ∈ Finset.range n, (Real.log (p (h + Δ)) - Real.log (p h)) ≤ Δ * Real.log M := by
  have htel : ∀ n, ∑ h ∈ Finset.range n, (Real.log (p (h + Δ)) - Real.log (p h)) =
      ∑ i ∈ Finset.range Δ, (Real.log (p (n + i)) - Real.log (p i)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Finset.sum_range_succ, ih]
      have := Finset.sum_range_sub (fun i => Real.log (p (n + i))) Δ
      simp only [add_zero] at this
      have e : ∑ i ∈ Finset.range Δ, (Real.log (p (n + 1 + i)) - Real.log (p i)) =
          ∑ i ∈ Finset.range Δ, (Real.log (p (n + i)) - Real.log (p i)) +
            ∑ i ∈ Finset.range Δ, (Real.log (p (n + (i + 1))) - Real.log (p (n + i))) := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl; intro i _
        rw [show n + 1 + i = n + (i + 1) by ring]; ring
      rw [e, this]
  rw [htel]
  calc ∑ i ∈ Finset.range Δ, (Real.log (p (n + i)) - Real.log (p i)) ≤
      ∑ _i ∈ Finset.range Δ, Real.log M := by
        apply Finset.sum_le_sum; intro i _
        have h1 := Real.log_nonneg (hp1 i)
        have h2 := Real.log_le_log (by linarith [hp1 (n + i)]) (hpM (n + i))
        linarith
    _ = Δ * Real.log M := by simp

/-- Blueprint line 2091, second term: along a chain `P_i ⊆ C_i ⊆ P_{i+1}` of positive sizes,
`Σ_i log(|C_i|/|P_i|) ≤ log |P_N| - log |P_0|`. -/
theorem sum_log_chain_le {a c : ℕ → ℝ} (ha : ∀ i, 0 < a i) (hac : ∀ i, a i ≤ c i)
    (hca : ∀ i, c i ≤ a (i + 1)) (N : ℕ) :
    ∑ i ∈ Finset.range N, (Real.log (c i) - Real.log (a i)) ≤
      Real.log (a N) - Real.log (a 0) := by
  rw [← Finset.sum_range_sub (fun i => Real.log (a i))]
  apply Finset.sum_le_sum; intro i _
  have := Real.log_le_log (lt_of_lt_of_le (ha i) (hac i)) (hca i)
  linarith

/-- Blueprint `eq:bad-density` (lines 2097-2102): if
`δ N (J + 1) < C N d R log(2D) + C (J + 1) d log(2D)` and the choice of `J` gives
`C d R log(2D) ≤ δ (J + 1)/2`, then `N < 2 C d log(2D)/δ`. -/
theorem chain_length_bound {δ N J C d R ℓ : ℝ} (hδ : 0 < δ) (hJ : 0 < J + 1) (hN : 0 ≤ N)
    (hbad : δ * N * (J + 1) < C * N * d * R * ℓ + C * (J + 1) * d * ℓ)
    (hchoice : C * d * R * ℓ ≤ δ * (J + 1) / 2) : N < 2 * C * d * ℓ / δ := by
  rw [lt_div_iff₀ hδ]
  have h1 : C * N * d * R * ℓ ≤ N * (δ * (J + 1) / 2) := by
    have := mul_le_mul_of_nonneg_left hchoice hN
    nlinarith
  have h2 : δ * N * (J + 1) / 2 < C * (J + 1) * d * ℓ := by nlinarith
  have h3 : N * δ * (J + 1) < 2 * C * d * ℓ * (J + 1) := by nlinarith
  exact lt_of_mul_lt_mul_right (by nlinarith) hJ.le

section LinearSide

variable {H : Type*} [NormedAddCommGroup H]

/-- Blueprint lines 2104-2118, assembly of `eq:linear-energy`: each subtotal
`V_k = Σ_{e ∈ ev k} T_e` is a sum of exact event subtotals that are almost orthogonal
(`‖V_k‖² ≤ c Σ ‖T_e‖²`), each within `ε` of a projection row output `Y_e = P_{E,J} Z̃`, and the rows
over all events are Bessel with total `B` (mode rows per level and class, then
`lem:lift-composition`). With `#events · ε² ≤ B`, `Σ_k ‖V_k‖² ≤ 4 c B`. -/
theorem linear_side_square_energy {κ ε' : Type*} [DecidableEq ε'] (s : Finset κ)
    (ev : κ → Finset ε')
    (hdisj : Set.PairwiseDisjoint (s : Set κ) ev) (V : κ → H) (T Y : ε' → H) {c ε B : ℝ}
    (hc : 0 ≤ c) (hV : ∀ k ∈ s, ‖V k‖ ^ 2 ≤ c * ∑ e ∈ ev k, ‖T e‖ ^ 2)
    (hTY : ∀ k ∈ s, ∀ e ∈ ev k, ‖T e - Y e‖ ≤ ε)
    (hY : ∑ k ∈ s, ∑ e ∈ ev k, ‖Y e‖ ^ 2 ≤ B)
    (hcount : ((s.biUnion ev).card : ℝ) * ε ^ 2 ≤ B) :
    ∑ k ∈ s, ‖V k‖ ^ 2 ≤ 4 * c * B := by
  have hT : ∀ k ∈ s, ∀ e ∈ ev k, ‖T e‖ ^ 2 ≤ 2 * ‖Y e‖ ^ 2 + 2 * ε ^ 2 := by
    intro k hk e he
    have h1 : ‖T e‖ ≤ ‖Y e‖ + ε := by
      have := norm_le_insert' (T e) (Y e)
      linarith [hTY k hk e he, norm_sub_norm_le (T e) (Y e)]
    have h0 : 0 ≤ ‖T e‖ := norm_nonneg _
    nlinarith [sq_nonneg (‖Y e‖ - ε)]
  have hcard : ∑ k ∈ s, ((ev k).card : ℝ) = (s.biUnion ev).card := by
    rw [Finset.card_biUnion hdisj]; push_cast; rfl
  calc ∑ k ∈ s, ‖V k‖ ^ 2 ≤ ∑ k ∈ s, c * ∑ e ∈ ev k, (2 * ‖Y e‖ ^ 2 + 2 * ε ^ 2) := by
        apply Finset.sum_le_sum; intro k hk
        refine (hV k hk).trans (mul_le_mul_of_nonneg_left ?_ hc)
        exact Finset.sum_le_sum fun e he => hT k hk e he
    _ = 2 * c * (∑ k ∈ s, ∑ e ∈ ev k, ‖Y e‖ ^ 2) +
        2 * c * (∑ k ∈ s, ((ev k).card : ℝ) * ε ^ 2) := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl; intro k _
        rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul, mul_add, Finset.mul_sum,
          Finset.mul_sum]
        congr 1
        · apply Finset.sum_congr rfl; intro e _; ring
        · ring
    _ ≤ 2 * c * B + 2 * c * B := by
        rw [← Finset.sum_mul, hcard]
        gcongr
    _ = 4 * c * B := by ring

end LinearSide

/-! ### Side states and fixed offsets (blueprint lines 2123-2166) -/

/-- Blueprint line 2133: the physical error `E = (1 - ζ²) Z_phys - Σ_Φ β_Φ q_Φ` with
`|q_Φ| ≤ δ_c` and `Σ |β_Φ| ≤ S` satisfies `|E|² ≤ 2 |1 - ζ²|² |Z_phys|² + 2 δ_c² S²`. -/
theorem physical_error_sq_le {ι : Type*} (s : Finset ι) (z : ℝ) (Zp : ℂ) (β q : ι → ℂ)
    {δ S : ℝ} (hq : ∀ i ∈ s, ‖q i‖ ≤ δ) (hβ : ∑ i ∈ s, ‖β i‖ ≤ S) (hδ : 0 ≤ δ) :
    ‖((1 - z ^ 2 : ℝ) : ℂ) * Zp - ∑ i ∈ s, β i * q i‖ ^ 2 ≤
      2 * |1 - z ^ 2| ^ 2 * ‖Zp‖ ^ 2 + 2 * δ ^ 2 * S ^ 2 := by
  have hsum : ‖∑ i ∈ s, β i * q i‖ ≤ δ * S := by
    calc ‖∑ i ∈ s, β i * q i‖ ≤ ∑ i ∈ s, ‖β i‖ * δ := by
          refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun i hi => ?_)
          rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hq i hi) (norm_nonneg _)
      _ = (∑ i ∈ s, ‖β i‖) * δ := by rw [Finset.sum_mul]
      _ ≤ S * δ := mul_le_mul_of_nonneg_right hβ hδ
      _ = δ * S := mul_comm _ _
  have h1 : ‖((1 - z ^ 2 : ℝ) : ℂ) * Zp‖ = |1 - z ^ 2| * ‖Zp‖ := by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  have htri := norm_sub_le (((1 - z ^ 2 : ℝ) : ℂ) * Zp) (∑ i ∈ s, β i * q i)
  rw [h1] at htri
  have hn := norm_nonneg (((1 - z ^ 2 : ℝ) : ℂ) * Zp - ∑ i ∈ s, β i * q i)
  have ha : 0 ≤ |1 - z ^ 2| * ‖Zp‖ := by positivity
  have hb : 0 ≤ ‖∑ i ∈ s, β i * q i‖ := norm_nonneg _
  nlinarith [sq_nonneg (|1 - z ^ 2| * ‖Zp‖ - ‖∑ i ∈ s, β i * q i‖)]

/-- Blueprint lines 2135-2139: for each point, the offset mean of the majorant
`B(ρ, y) = 2 |1 - ζ^ρ(y)²|² |Z(y)|² + 2 δ_c² K` is at most `8 d δ_c |Z(y)|² + 2 δ_c² K`
(by `offsetMean`). -/
theorem majorant_offset_mean {d : ℕ} {δ : ℝ} (hδ : 0 < δ) (hdδ : 8 * d * δ ≤ 1)
    (hδ' : δ ≤ 1 / 8) (u : Fin d → ℝ) (Z K : ℝ) :
    ∫ ρ, (2 * |1 - branchCutoffValue δ ρ u ^ 2| ^ 2 * Z + 2 * δ ^ 2 * K) ∂(offsetMeasure d) ≤
      8 * d * δ * |Z| + 2 * δ ^ 2 * K := by
  have hmeas : Measurable fun ρ => branchCutoffValue δ ρ u := by
    unfold branchCutoffValue
    apply Finset.measurable_prod; intro i _
    exact (branchProfile_continuous δ).measurable.comp
      ((measurable_fract (R := ℝ)).comp (measurable_const.sub (measurable_pi_apply i)))
  have hint : Integrable (fun ρ => (1 - branchCutoffValue δ ρ u ^ 2) ^ 2) (offsetMeasure d) := by
    refine Integrable.of_bound
      ((hmeas.pow_const 2).const_sub 1 |>.pow_const 2).aestronglyMeasurable
      1 (Filter.Eventually.of_forall fun ρ => ?_)
    have hm := branchCutoffValue_mem δ ρ u
    have h0 : 0 ≤ 1 - branchCutoffValue δ ρ u ^ 2 := by nlinarith [hm.1, hm.2]
    have h1 : 1 - branchCutoffValue δ ρ u ^ 2 ≤ 1 := by nlinarith [hm.1]
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    nlinarith
  have hmean := (offsetMean hδ hdδ hδ' u).2.2
  have h0 : 0 ≤ ∫ ρ, (1 - branchCutoffValue δ ρ u ^ 2) ^ 2 ∂(offsetMeasure d) :=
    integral_nonneg fun ρ => sq_nonneg _
  simp_rw [sq_abs]
  rw [integral_add ((hint.const_mul 2).mul_const Z) (integrable_const _), integral_const,
    integral_mul_const, integral_const_mul]
  simp only [probReal_univ, smul_eq_mul, one_mul]
  have hZ : Z ≤ |Z| := le_abs_self Z
  nlinarith [abs_nonneg Z]

/-- Blueprint lines 2140-2147 (`eq:physical-error`): if the physical errors are dominated by an
integrable majorant sum `B(ρ)` whose offset mean is at most `M`, then some offset makes
the errors at most `M` (first moment method; no measurable selection of expansions is needed). -/
theorem select_offsets_by_majorant {Ω : Type*} [MeasurableSpace Ω] (μ : Measure Ω)
    [IsProbabilityMeasure μ] (Bsum Esum : Ω → ℝ) (hint : Integrable Bsum μ)
    (hdom : ∀ ρ, Esum ρ ≤ Bsum ρ) {M : ℝ} (hmean : ∫ ρ, Bsum ρ ∂μ ≤ M) :
    ∃ ρ, Esum ρ ≤ M ∧ Bsum ρ ≤ M := by
  obtain ⟨ρ, hρ⟩ := exists_le_integral hint
  exact ⟨ρ, (hdom ρ).trans (hρ.trans hmean), hρ.trans hmean⟩

/-- Blueprint lines 2149-2150 (side caps): a quantity `x_b` attached to each block start and
counted at every `s` with `b ≤ s < b + K` is counted at most `K` times:
`Σ_s Σ_{b ≤ s < b + K} x_b ≤ K Σ_b x_b`. -/
theorem rolling_side_budget (x : ℕ → ℝ) (hx : ∀ b, 0 ≤ x b) (K N : ℕ) :
    ∑ s ∈ Finset.range N, ∑ b ∈ (Finset.range N).filter (fun b => b ≤ s ∧ s < b + K), x b ≤
      K * ∑ b ∈ Finset.range N, x b := by
  classical
  have hswap : ∑ s ∈ Finset.range N, ∑ b ∈ (Finset.range N).filter
      (fun b => b ≤ s ∧ s < b + K), x b =
      ∑ b ∈ Finset.range N, ((Finset.range N).filter (fun s => b ≤ s ∧ s < b + K)).card * x b := by
    simp_rw [Finset.sum_filter]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl; intro b _
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
  rw [hswap, Finset.mul_sum]
  apply Finset.sum_le_sum; intro b _
  apply mul_le_mul_of_nonneg_right _ (hx b)
  have hsub : (Finset.range N).filter (fun s => b ≤ s ∧ s < b + K) ⊆ Finset.Ico b (b + K) := by
    intro s hs
    simp only [Finset.mem_filter] at hs
    exact Finset.mem_Ico.mpr hs.2
  have := Finset.card_le_card hsub
  rw [Nat.card_Ico, Nat.add_sub_cancel_left] at this
  exact_mod_cast this

/-! ### Representatives, component sizes, and first tops (blueprint lines 2171-2231) -/

/-- Blueprint lines 2176-2180: with `F = π(F_late)`, the later predecessor labels `B` carrying
nine tenths of `F`, the earlier ones `A` more than half of `B`, and good primaries `G` nine tenths
of `F`, the three label sets share a primary (more than `7|F|/20` of `A ∩ B`, minus the bad ones).
-/
theorem early_late_good_common {P : Type*} [DecidableEq P] (Fs A B G : Finset P) (hA : A ⊆ Fs)
    (hB : B ⊆ Fs) (hG : G ⊆ Fs) (hBF : 9 * Fs.card ≤ 10 * B.card) (hAB : B.card < 2 * A.card)
    (hGF : 9 * Fs.card ≤ 10 * G.card) : (A ∩ B ∩ G).Nonempty := by
  have h3 := card_inter_three_ge Fs A B G hA hB hG
  apply Finset.card_pos.mp
  omega

/-- Blueprint lines 2180-2181: by stabilization, the joined witnesses of a common later
nonexceptional height-good primary nest the earlier PRE predecessor inside the later one. -/
theorem early_predecessor_nested {Mode P : Type*} [DecidableEq P]
    (π : Mode → P) (Fl El Ee : Finset Mode) (goodP : P → Prop) [DecidablePred goodP]
    (hEe : Ee ⊆ Fl) (hEl : El ⊆ Fl)
    (hBF : 9 * (Fl.image π).card ≤ 10 * (El.image π).card)
    (hAB : (El.image π).card < 2 * (Ee.image π).card)
    (hGF : 9 * (Fl.image π).card ≤ 10 * ((Fl.image π).filter goodP).card)
    (hjoin : ∀ x ∈ Ee, ∀ x' ∈ El, π x = π x' → goodP (π x) → Ee ⊆ El) : Ee ⊆ El := by
  obtain ⟨p, hp⟩ := early_late_good_common (Fl.image π) (Ee.image π) (El.image π)
    ((Fl.image π).filter goodP) (Finset.image_subset_image hEe) (Finset.image_subset_image hEl)
    (Finset.filter_subset _ _) hBF hAB hGF
  obtain ⟨⟨hpA, hpB⟩, hpG⟩ := Finset.mem_inter.mp hp |>.imp_left Finset.mem_inter.mp
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hpA
  obtain ⟨x', hx', hxx'⟩ := Finset.mem_image.mp hpB
  exact hjoin x hx x' hx' hxx'.symm (Finset.mem_filter.mp hpG).2

/-- Blueprint lines 2181-2182: two subsets of `C`, each with more than half of its elements,
intersect. -/
theorem majority_subsets_inter {α : Type*} [DecidableEq α] (A B C : Finset α) (hA : A ⊆ C)
    (hB : B ⊆ C) (hAC : C.card < 2 * A.card) (hBC : C.card < 2 * B.card) :
    (A ∩ B).Nonempty := by
  have e := Finset.card_union_add_card_inter A B
  have c := Finset.card_le_card (Finset.union_subset hA hB)
  apply Finset.card_pos.mp
  omega

/-- Blueprint `eq:representative-separation` (lines 2184-2190): if the affine frequency
difference `2λx + γ` exceeds `θ` at one point of a cell of length `r` and `2|λ| r ≤ θ/2`, it
exceeds `θ/2` everywhere on the cell. -/
theorem affine_separation_on_cell {lam γ a r θ x₀ : ℝ} (hx₀ : x₀ ∈ Set.Icc a (a + r))
    (hlarge : θ < |2 * lam * x₀ + γ|) (hvar : 2 * |lam| * r ≤ θ / 2) :
    ∀ x ∈ Set.Icc a (a + r), θ / 2 < |2 * lam * x + γ| := by
  intro x hx
