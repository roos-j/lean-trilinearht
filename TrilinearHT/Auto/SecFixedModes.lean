  have hH0 : 0 < H := lt_of_lt_of_le (Real.exp_pos 2) hH
  have hB0 : 0 < B := by linarith
  have hlogH : 2 ≤ Real.log H := by rw [Real.le_log_iff_exp_le hH0]; exact hH
  have hlogB : 0 ≤ Real.log B := Real.log_nonneg (by linarith)
  have hX1 : 1 ≤ X := by linarith
  have hd0 : (0 : ℝ) ≤ d := Nat.cast_nonneg d
  have hdX : (d : ℝ) ≤ X := by linarith
  have hd2 : ((d ^ 2 : ℕ) : ℝ) ≤ X ^ 2 := by push_cast; exact pow_le_pow_left₀ hd0 hdX 2
  have hpos : 0 < 4 * H ^ (d ^ 2) * (B ^ (d ^ 2)) ^ 2 *
      (H + (d : ℝ) ^ 2 * ((1 + B) * H * B) + 1) := by positivity
  rw [← Real.exp_log hpos]
  apply Real.exp_le_exp.mpr
  rw [Real.log_mul (by positivity) (by positivity), Real.log_mul (by positivity) (by positivity),
    Real.log_mul (by norm_num) (by positivity), Real.log_pow, Real.log_pow, Real.log_pow]
  have hlast : Real.log (H + (d : ℝ) ^ 2 * ((1 + B) * H * B) + 1) ≤ 6 * X := by
    have h1 : H + (d : ℝ) ^ 2 * ((1 + B) * H * B) + 1 ≤ 4 * (H ^ 4 * B ^ 2) := by
      have hdH : (d : ℝ) ≤ H := hd.trans (Real.log_le_self hH0.le)
      have hH1 : 1 ≤ H := by linarith [Real.add_one_le_exp (2 : ℝ)]
      have : (d : ℝ) ^ 2 ≤ H ^ 2 := pow_le_pow_left₀ hd0 hdH 2
      have hB1 : 1 + B ≤ 2 * B := by linarith
      have hH2 : H ≤ H ^ 4 := le_self_pow₀ hH1 (by norm_num)
      have hH3 : H ^ 3 ≤ H ^ 4 := pow_le_pow_right₀ hH1 (by norm_num)
      have a1 : (d : ℝ) ^ 2 * ((1 + B) * H * B) ≤ H ^ 2 * ((2 * B) * H * B) :=
        mul_le_mul this (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hB1 hH0.le)
          hB0.le) (by positivity) (by positivity)
      have a2 : H ^ 2 * ((2 * B) * H * B) = 2 * (H ^ 3 * B ^ 2) := by ring
      have a3 : H ^ 3 * B ^ 2 ≤ H ^ 4 * B ^ 2 := mul_le_mul_of_nonneg_right hH3 (by positivity)
      have hB2 : 1 ≤ B ^ 2 := by nlinarith
      have hH4 : 1 ≤ H ^ 4 := one_le_pow₀ hH1
      have a4 : H ≤ H ^ 4 * B ^ 2 := by nlinarith
      have a5 : 1 ≤ H ^ 4 * B ^ 2 := by nlinarith
      linarith
    have h2 := Real.log_le_log (by positivity) h1
    rw [Real.log_mul (by norm_num) (by positivity), Real.log_mul (by positivity) (by positivity),
      Real.log_pow, Real.log_pow] at h2
    have hl4 : Real.log 4 ≤ 2 := by
      rw [Real.log_le_iff_le_exp (by norm_num)]
      have h2e : Real.exp 2 = Real.exp 1 ^ 2 := by rw [← Real.exp_nat_mul]; norm_num
      rw [h2e]
      have he : (2.7 : ℝ) ≤ Real.exp 1 := by linarith [Real.exp_one_gt_d9]
      calc (4 : ℝ) ≤ 2.7 ^ 2 := by norm_num
        _ ≤ Real.exp 1 ^ 2 := pow_le_pow_left₀ (by norm_num) he 2
    push_cast at h2
    linarith
  have hl4 : Real.log 4 ≤ 2 := by
    rw [Real.log_le_iff_le_exp (by norm_num)]
    have h2e : Real.exp 2 = Real.exp 1 ^ 2 := by rw [← Real.exp_nat_mul]; norm_num
    rw [h2e]
    have he : (2.7 : ℝ) ≤ Real.exp 1 := by linarith [Real.exp_one_gt_d9]
    calc (4 : ℝ) ≤ 2.7 ^ 2 := by norm_num
      _ ≤ Real.exp 1 ^ 2 := pow_le_pow_left₀ (by norm_num) he 2
  have e1 : ((d ^ 2 : ℕ) : ℝ) * Real.log H ≤ X ^ 3 := by
    calc ((d ^ 2 : ℕ) : ℝ) * Real.log H ≤ X ^ 2 * X :=
