/-! ### Exceptional blocks and the tiny span (blueprint lines 1987-2000) -/

/-- An open interval of length at most four contains at most four integers. -/
theorem card_int_in_open_interval (B : Finset ℤ) (s : ℝ) (hB : ∀ β ∈ B, s < β ∧ (β : ℝ) < s + 4) :
    B.card ≤ 4 := by
  have hsub : B ⊆ Finset.Icc (⌊s⌋ + 1) (⌊s⌋ + 4) := by
    intro β hβ
    obtain ⟨h1, h2⟩ := hB β hβ
    rw [Finset.mem_Icc]
    constructor
    · have := Int.floor_le s
      have : (⌊s⌋ : ℝ) < β := by linarith
      exact_mod_cast this
    · have := Int.lt_floor_add_one s
      have : (β : ℝ) < ⌊s⌋ + 5 := by linarith
      have : β < ⌊s⌋ + 5 := by exact_mod_cast this
      omega
  calc B.card ≤ (Finset.Icc (⌊s⌋ + 1) (⌊s⌋ + 4)).card := Finset.card_le_card hsub
    _ = 4 := by simp

/-- Blueprint lines 1991-1993: if the logarithmic evaluations `x(a)` of all height-`H` vectors
lie in at most `d` packets of width `W`, a block start `b = βK` is exceptional when some
`x(a) ∈ (b - 2K - log₂T, b + K + log₂T)`, and `W + 3K + 2 log₂ T ≤ 4K`, then at most `4d`
blocks are exceptional. -/
theorem exceptional_blocks_count {K L W : ℝ} (hK : 0 < K) (hWK : W + 3 * K + 2 * L ≤ 4 * K)
    (packets : Finset ℝ) (X : Set ℝ) (hX : ∀ x ∈ X, ∃ p ∈ packets, p ≤ x ∧ x ≤ p + W)
    (B : Finset ℤ) (hB : ∀ β ∈ B, ∃ x ∈ X, β * K - 2 * K - L < x ∧ x < β * K + K + L) :
    B.card ≤ 4 * packets.card := by
  classical
  choose! x hxX hx using hB
  choose! p hp hpx using fun β hβ => hX (x β) (hxX β hβ)
  have hmaps : ∀ β ∈ B, p β ∈ packets := fun β hβ => hp β hβ
  rw [Finset.card_eq_sum_card_fiberwise hmaps]
  calc ∑ q ∈ packets, (B.filter fun β => p β = q).card ≤ ∑ _q ∈ packets, 4 := by
        apply Finset.sum_le_sum
        intro q _
        apply card_int_in_open_interval _ ((q - K - L) / K)
        intro β hβ
        obtain ⟨hβB, hβq⟩ := Finset.mem_filter.mp hβ
        obtain ⟨h1, h2⟩ := hx β hβB
        obtain ⟨h3, h4⟩ := hpx β hβB
        rw [hβq] at h3 h4
        constructor
        · rw [div_lt_iff₀ hK]; linarith
        · rw [div_add' _ _ _ hK.ne', lt_div_iff₀ hK]; linarith
    _ = 4 * packets.card := by rw [Finset.sum_const, smul_eq_mul, mul_comm]

/-- The height of a rational vector: the largest entry height. -/
def vecHeight {d : ℕ} (a : Fin d → ℚ) : ℕ := Finset.univ.sup fun i => rationalHeight (a i)

theorem le_vecHeight {d : ℕ} (a : Fin d → ℚ) (i : Fin d) : rationalHeight (a i) ≤ vecHeight a :=
  Finset.le_sup (f := fun i => rationalHeight (a i)) (Finset.mem_univ i)

/-- The evaluation `a · Θ`. -/
noncomputable def ratEval {d : ℕ} (Θ : Fin d → ℝ) (a : Fin d → ℚ) : ℝ := ∑ i, (a i : ℝ) * Θ i

theorem ratEval_add {d : ℕ} (Θ : Fin d → ℝ) (a b : Fin d → ℚ) :
    ratEval Θ (a + b) = ratEval Θ a + ratEval Θ b := by
  simp only [ratEval, Pi.add_apply, Rat.cast_add, add_mul, Finset.sum_add_distrib]

theorem ratEval_smul {d : ℕ} (Θ : Fin d → ℝ) (c : ℚ) (a : Fin d → ℚ) :
    ratEval Θ (c • a) = c * ratEval Θ a := by
  simp only [ratEval, Pi.smul_apply, smul_eq_mul, Rat.cast_mul, Finset.mul_sum]
  apply Finset.sum_congr rfl; intro i _; ring

/-- Blueprint lines 1995-1997: at a nonexceptional block (every height-`H` vector is tiny,
`|a·Θ| ≤ ε`, or large, `|a·Θ| ≥ Λ`), every height-`H` vector in the rational span of the tiny
height-`H` vectors is tiny, provided `(n+1) d! H^{d²+d} ε < Λ` for any spanning family size
`n` (here all tiny vectors of height at most `H`). -/
theorem tiny_span_closed {d : ℕ} (Θ : Fin d → ℝ) {H : ℕ} (hH : 1 ≤ H) {ε Λ : ℝ}
    (hε : 0 ≤ ε)
    (hgap : ∀ a : Fin d → ℚ, vecHeight a ≤ H → |ratEval Θ a| ≤ ε ∨ Λ ≤ |ratEval Θ a|)
    {n : ℕ} (v : Fin n → Fin d → ℚ) (hvH : ∀ i, vecHeight (v i) ≤ H)
    (hvt : ∀ i, |ratEval Θ (v i)| ≤ ε)
    (hsmall : (n : ℝ) * (d.factorial * H ^ (d ^ 2 + d)) * ε < Λ)
    (a : Fin d → ℚ) (ha : a ∈ Submodule.span ℚ (Set.range v)) (haH : vecHeight a ≤ H) :
    |ratEval Θ a| ≤ ε := by
  classical
  rcases hgap a haH with h | h
  · exact h
  exfalso
  -- a basis of the span among the `v i`
  obtain ⟨r, -, e, he, hspan⟩ := rational_spanning_subfamily v
  rw [← hspan] at ha
  -- the family `(a, v (e 0), …)` is dependent
  let w : Fin (r + 1) → Fin d → ℚ := Fin.cons a fun i => v (e i)
  have hw : ∀ i j, rationalHeight (w i j) ≤ H := by
    intro i j
    refine Fin.cases ?_ (fun i => ?_) i
    · exact (le_vecHeight a j).trans haH
    · exact (le_vecHeight (v (e i)) j).trans (hvH (e i))
  have hdep : ¬LinearIndependent ℚ w := by
    intro hli
    have := (linearIndependent_finCons.mp hli).2
    exact this ha
  obtain ⟨c, hc0, hsum, hcb⟩ := rational_small_dependence w hH hw hdep
  -- the coefficient of `a` is nonzero
  have hc00 : c 0 ≠ 0 := by
    intro h0
    apply hc0
    have hrest : ∑ i : Fin r, (c i.succ : ℚ) • v (e i) = 0 := by
      rw [Fin.sum_univ_succ] at hsum
      simpa [w, h0] using hsum
    have := (linearIndependent_iff'.mp he) Finset.univ (fun i => (c i.succ : ℚ)) hrest
    funext i
    refine Fin.cases h0 (fun i => ?_) i
    exact_mod_cast this i (Finset.mem_univ i)
  -- evaluate the relation
  have heval : (c 0 : ℝ) * ratEval Θ a = -∑ i : Fin r, (c i.succ : ℝ) * ratEval Θ (v (e i)) := by
    have := congrArg (ratEval Θ) hsum
    rw [Fin.sum_univ_succ] at this
    simp only [w, Fin.cons_zero, Fin.cons_succ] at this
    have hsumev : ∀ (s : Finset (Fin r)) (f : Fin r → Fin d → ℚ),
        ratEval Θ (∑ i ∈ s, f i) = ∑ i ∈ s, ratEval Θ (f i) := by
      intro s f
      induction s using Finset.induction_on with
      | empty => simp [ratEval]
      | insert j s hj ih => rw [Finset.sum_insert hj, Finset.sum_insert hj, ratEval_add, ih]
    rw [ratEval_add, hsumev, ratEval_smul] at this
    simp only [ratEval_smul] at this
    have h0 : ratEval Θ (0 : Fin d → ℚ) = 0 := by simp [ratEval]
    rw [h0] at this
    push_cast at this
    linarith
  have hc0abs : (1 : ℝ) ≤ |(c 0 : ℝ)| := by
    rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs hc00
  set Bd : ℝ := d.factorial * H ^ (d ^ 2 + d)
  have hbound : |(c 0 : ℝ) * ratEval Θ a| ≤ r * (Bd * ε) := by
    rw [heval, abs_neg]
    refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
    calc ∑ i : Fin r, |(c i.succ : ℝ) * ratEval Θ (v (e i))| ≤ ∑ _i : Fin r, Bd * ε := by
          apply Finset.sum_le_sum; intro i _
          rw [abs_mul]
          apply mul_le_mul _ (hvt (e i)) (abs_nonneg _) (by positivity)
          have := hcb i.succ
          rw [← Int.cast_abs]
          have h' : (|c i.succ| : ℤ) ≤ (d.factorial * H ^ (d ^ 2 + d) : ℕ) := by
            rw [Int.abs_eq_natAbs]; exact_mod_cast this
          have h'' : ((|c i.succ| : ℤ) : ℝ) ≤ ((d.factorial * H ^ (d ^ 2 + d) : ℕ) : ℝ) := by
            exact_mod_cast h'
          simpa [Bd] using h'' 
      _ = r * (Bd * ε) := by simp
  have hr : (r : ℝ) ≤ n := by
    have := Fintype.card_le_of_embedding e
    simp only [Fintype.card_fin] at this
    exact_mod_cast this
  have hlow : Λ ≤ |(c 0 : ℝ) * ratEval Θ a| := by
    rw [abs_mul]
    calc Λ ≤ |ratEval Θ a| := h
      _ ≤ |(c 0 : ℝ)| * |ratEval Θ a| := le_mul_of_one_le_left (abs_nonneg _) hc0abs
  have : (r : ℝ) * (Bd * ε) ≤ n * Bd * ε := by
    rw [← mul_assoc]; exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hr
      (by positivity)) hε
  linarith

/-! ### Height stabilization (lem:stabilize, blueprint lines 2002-2029) -/

/-- If `p^R ∣ q x` with `0 < q < p^(R - Δ)`, then `p^Δ ∣ x`. -/
theorem prime_pow_dvd_of_mul {p : ℕ} (hp : p.Prime) {R Δ q : ℕ} {x : ℤ} (hq : 0 < q)
    (hqR : q < p ^ (R - Δ)) (hΔR : Δ ≤ R) (h : (p : ℤ) ^ R ∣ (q : ℤ) * x) :
    (p : ℤ) ^ Δ ∣ x := by
  -- the exact power of `p` in `q`
  set v := q.factorization p
  have hv : p ^ v ∣ q := Nat.ordProj_dvd q p
  have hnd : ¬p ^ (v + 1) ∣ q := Nat.pow_succ_factorization_not_dvd hq.ne' hp
  clear_value v
  obtain ⟨q', hq'⟩ := hv
  have hcop : Nat.Coprime p q' := by
    rw [Nat.Prime.coprime_iff_not_dvd hp]
    intro hdvd
    apply hnd
    rw [hq', pow_succ]
    exact Nat.mul_dvd_mul_left _ hdvd
  have hvlt : v < R - Δ := by
    by_contra hge
    push Not at hge
    have : p ^ (R - Δ) ≤ q := by
      calc p ^ (R - Δ) ≤ p ^ v := Nat.pow_le_pow_right hp.pos hge
        _ ≤ q := Nat.le_of_dvd hq ⟨q', hq'⟩
    omega
  -- `p^(R - v) ∣ q' x`
  have h1 : (p : ℤ) ^ v * (p : ℤ) ^ (R - v) ∣ (p : ℤ) ^ v * ((q' : ℤ) * x) := by
    rw [← pow_add, Nat.add_sub_cancel' (by omega)]
    have : (q : ℤ) * x = (p : ℤ) ^ v * ((q' : ℤ) * x) := by
      rw [hq']; push_cast; ring
    rw [← this]; exact h
  have hp0 : (p : ℤ) ^ v ≠ 0 := pow_ne_zero _ (by exact_mod_cast hp.ne_zero)
  have h2 := (mul_dvd_mul_iff_left hp0).mp h1
  have hcop' : IsCoprime ((p : ℤ) ^ (R - v)) (q' : ℤ) := by
    apply IsCoprime.pow_left
    rw [Int.isCoprime_iff_gcd_eq_one]
    exact_mod_cast hcop
  have h3 : (p : ℤ) ^ (R - v) ∣ x := hcop'.dvd_of_dvd_mul_left h2
  exact (pow_dvd_pow (p : ℤ) (by omega)).trans h3

/-- Blueprint line 2018: if `q x = 6^R z` with `0 < q < 2^(R - Δ)`, then `6^Δ ∣ x`. -/
theorem six_pow_dvd_of_mul {R Δ q : ℕ} {x z : ℤ} (hq : 0 < q) (hqR : q < 2 ^ (R - Δ))
    (hΔR : Δ ≤ R) (h : (q : ℤ) * x = 6 ^ R * z) : (6 : ℤ) ^ Δ ∣ x := by
  have h2 : ((2 : ℕ) : ℤ) ^ R ∣ (q : ℤ) * x := by
    rw [h, show (6 : ℤ) ^ R = 2 ^ R * 3 ^ R by rw [← mul_pow]; norm_num, mul_assoc]
    exact dvd_mul_right _ _
  have h3 : ((3 : ℕ) : ℤ) ^ R ∣ (q : ℤ) * x := by
    rw [h, show (6 : ℤ) ^ R = 3 ^ R * 2 ^ R by rw [← mul_pow]; norm_num, mul_assoc]
    exact dvd_mul_right _ _
  have hq3 : q < 3 ^ (R - Δ) :=
    hqR.trans_le (Nat.pow_le_pow_left (by norm_num) _)
  have d2 := prime_pow_dvd_of_mul Nat.prime_two hq hqR hΔR h2
  have d3 := prime_pow_dvd_of_mul Nat.prime_three hq hq3 hΔR h3
  have hc : IsCoprime ((2 : ℤ) ^ Δ) ((3 : ℤ) ^ Δ) := by
    apply IsCoprime.pow
    rw [Int.isCoprime_iff_gcd_eq_one]; rfl
  have := hc.mul_dvd (by exact_mod_cast d2) (by exact_mod_cast d3)
  rwa [← mul_pow] at this

/-- Blueprint lines 2016-2018: in the free quotient of `ℤⁿ` by a saturated lattice `Λ`, a
relation `q x ≡ 6^R z (mod Λ)` with `0 < q < 2^(R - Δ)` forces `x ≡ 6^Δ y (mod Λ)` for an integer
vector `y`. -/
theorem quotient_six_pow_dvd {n : ℕ} (Λ : Submodule ℤ (Fin n → ℤ)) (hΛ : IntegerSaturated Λ)
    {R Δ q : ℕ} (hq : 0 < q) (hqR : q < 2 ^ (R - Δ)) (hΔR : Δ ≤ R) (x z : Fin n → ℤ)
    (h : (q : ℤ) • x - (6 : ℤ) ^ R • z ∈ Λ) : ∃ y : Fin n → ℤ, x - (6 : ℤ) ^ Δ • y ∈ Λ := by
  classical
  let := integerSaturated_quotient_free Λ hΛ
  set M := (Fin n → ℤ) ⧸ Λ
  let b := Module.Free.chooseBasis ℤ M
  have hrel : (q : ℤ) • Λ.mkQ x = (6 : ℤ) ^ R • Λ.mkQ z := by
    rw [← map_smul, ← map_smul, ← sub_eq_zero, ← map_sub]
    exact (Submodule.Quotient.mk_eq_zero Λ).mpr h
  -- coordinatewise divisibility
  have hdiv : ∀ i, (6 : ℤ) ^ Δ ∣ b.repr (Λ.mkQ x) i := by
    intro i
    have := congrArg (fun w => b.repr w i) hrel
    simp only [map_smul, Finsupp.smul_apply, smul_eq_mul] at this
    exact six_pow_dvd_of_mul hq hqR hΔR this
  choose c hc using hdiv
  -- the quotient element `Σ c_i b_i`
  set w : M := ∑ i ∈ (b.repr (Λ.mkQ x)).support, c i • b i
  have hw : Λ.mkQ x = (6 : ℤ) ^ Δ • w := by
    conv_lhs => rw [← b.linearCombination_repr (Λ.mkQ x)]
    rw [Finsupp.linearCombination_apply, Finsupp.sum, Finset.smul_sum]
    apply Finset.sum_congr rfl; intro i _
    rw [hc i, smul_smul]
  obtain ⟨y, hy⟩ := Λ.mkQ_surjective w
  refine ⟨y, (Submodule.Quotient.mk_eq_zero Λ).mp ?_⟩
  change Λ.mkQ (x - (6 : ℤ) ^ Δ • y) = 0
  rw [map_sub, map_smul, hy, hw, sub_self]

/-- Blueprint lines 2010-2028 (core of `lem:stabilize`): let `K` be a rational subspace,
`ι` the inclusion of the `ϑ`-coordinates, and `U ⊆ K_B = ι⁻¹ K` spanned by integer generators
`g_i` with entries at most `G`. Suppose `a = Σ_j (β_j/Q) a_j` with `0 < Q < 2^(R-Δ)`, witnesses
`a_j + ι(m_j / 6^(h-R)) ∈ K` and `a + ι(m_h / 6^h) ∈ K`, and that the integer vector
`Q m_h - 6^R Σ_j β_j m_j` (which lies in `K_B`) lies in `U` (this is `U_h = U_{h-R}` together with
its size bound). Then some integer `m'` gives a PRE witness `a + ι(m' / 6^(h-Δ)) ∈ K` with
`|m'| ≤ 6^(R-Δ) Σ_j |β_j/Q| |m_j| + k G`. -/
theorem stabilize_witness {W : Type*} [AddCommGroup W] [Module ℚ W] {n : ℕ}
    (K : Submodule ℚ W) (ι : (Fin n → ℚ) →ₗ[ℚ] W) (U : Submodule ℚ (Fin n → ℚ))
    (hUK : U ≤ K.comap ι) {k : ℕ} (g : Fin k → Fin n → ℤ)
    (hgU : Submodule.span ℚ (Set.range fun i => integerRationalMap n (g i)) = U) {G : ℚ}
    (hG : ∀ i l, |(g i l : ℚ)| ≤ G) {R Δ h Q : ℕ} (hΔR : Δ ≤ R) (hRh : R ≤ h) (hQ : 0 < Q)
    (hQR : Q < 2 ^ (R - Δ)) {J : ℕ} (a : W) (aj : Fin J → W) (β : Fin J → ℤ)
    (ha : a = ∑ j, ((β j : ℚ) / Q) • aj j) (mj : Fin J → Fin n → ℤ)
    (hj : ∀ j, aj j + ι (((6 : ℚ) ^ (h - R))⁻¹ • integerRationalMap n (mj j)) ∈ K)
    (mh : Fin n → ℤ) (hh : a + ι (((6 : ℚ) ^ h)⁻¹ • integerRationalMap n mh) ∈ K)
    {S : ℚ} (hUS : ∀ z : Fin n → ℤ, ι (integerRationalMap n z) ∈ K → (∀ l, |(z l : ℚ)| ≤ S) →
      integerRationalMap n z ∈ U)
    (hzS : ∀ l, |(Q : ℚ) * mh l - 6 ^ R * ∑ j, (β j : ℚ) * mj j l| ≤ S) :
    ∃ m' : Fin n → ℤ, a + ι (((6 : ℚ) ^ (h - Δ))⁻¹ • integerRationalMap n m') ∈ K ∧
      ∀ l, |(m' l : ℚ)| ≤ 6 ^ (R - Δ) * ∑ j, |(β j : ℚ) / Q| * |(mj j l : ℚ)| + k * G := by
  classical
  set φ := integerRationalMap n
  have hφ : ∀ v l, φ v l = v l := fun _ _ => rfl
  set Λ := rationalIntegerIntersection U
  have hΛ := rationalIntegerIntersection_saturated U
  have hQ0 : (Q : ℚ) ≠ 0 := by exact_mod_cast hQ.ne'
  -- step 0: the cleared difference `Q m_h - 6^R Σ β_j m_j` lies in `K_B`, hence in `U`
  set z : Fin n → ℤ := (Q : ℤ) • mh - (6 : ℤ) ^ R • ∑ j, β j • mj j
  have hzl : ∀ l, (z l : ℚ) = (Q : ℚ) * mh l - 6 ^ R * ∑ j, (β j : ℚ) * mj j l := by
    intro l; simp [z, Finset.sum_apply]
  have hzK : ι (φ z) ∈ K := by
    have hT := K.smul_mem ((6 : ℚ) ^ h) (K.sub_mem (K.smul_mem (Q : ℚ) hh)
      (K.sum_mem (t := Finset.univ) fun j _ => K.smul_mem (β j : ℚ) (hj j)))
    convert hT using 1
    have hQa : (Q : ℚ) • a = ∑ j, (β j : ℚ) • aj j := by
      rw [ha, Finset.smul_sum]
      apply Finset.sum_congr rfl; intro j _
      rw [smul_smul, mul_div_cancel₀ _ hQ0]
    have hsplit : (Q : ℚ) • (a + ι (((6 : ℚ) ^ h)⁻¹ • φ mh)) -
        ∑ j, (β j : ℚ) • (aj j + ι (((6 : ℚ) ^ (h - R))⁻¹ • φ (mj j))) =
        ι ((Q : ℚ) • ((6 : ℚ) ^ h)⁻¹ • φ mh -
          ∑ j, (β j : ℚ) • ((6 : ℚ) ^ (h - R))⁻¹ • φ (mj j)) := by
      simp only [smul_add, Finset.sum_add_distrib, hQa, map_sub, map_sum, map_smul]
      abel
    rw [hsplit, ← map_smul]
    congr 1
    ext l
    have h6 : (6 : ℚ) ^ h = 6 ^ (h - R) * 6 ^ R := by
      rw [← pow_add, Nat.sub_add_cancel hRh]
    simp only [Pi.smul_apply, Pi.sub_apply, Finset.sum_apply, smul_eq_mul, hφ, hzl,
      Finset.mul_sum, h6]
    field_simp
    congr 1
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl; intro j _
    field_simp
  have hU : φ z ∈ U := hUS z hzK fun l => by rw [hzl]; exact hzS l
  -- step 1: the `6^Δ`-divisibility in the free quotient
  obtain ⟨y, hy⟩ := quotient_six_pow_dvd Λ hΛ hQ hQR hΔR mh (∑ j, β j • mj j) hU
  have hyU : φ (mh - (6 : ℤ) ^ Δ • y) ∈ U := hy
  have h60 : ∀ e : ℕ, (6 : ℚ) ^ e ≠ 0 := fun e => pow_ne_zero _ (by norm_num)
  -- step 2: `y - 6^(R-Δ) Σ b_j m_j ∈ U`
  set ctr : Fin n → ℚ := (6 : ℚ) ^ (R - Δ) • ∑ j, ((β j : ℚ) / Q) • φ (mj j)
  have hdiff : φ y - ctr ∈ U := by
    have hcomb : φ y - ctr = ((Q : ℚ) * 6 ^ Δ)⁻¹ •
        (φ ((Q : ℤ) • mh - (6 : ℤ) ^ R • ∑ j, β j • mj j) -
          (Q : ℚ) • φ (mh - (6 : ℤ) ^ Δ • y)) := by
      ext l
      have hS : ∀ v : Fin J → Fin n → ℤ, (∑ j, β j • v j) l = ∑ j, β j * v j l := by
        intro v; simp [Finset.sum_apply]
      have hS' : (∑ j, ((β j : ℚ) / Q) • φ (mj j)) l = (∑ j, (β j : ℚ) * mj j l) / Q := by
        rw [Finset.sum_apply, Finset.sum_div]
        apply Finset.sum_congr rfl; intros
        simp only [Pi.smul_apply, smul_eq_mul, hφ]; ring
      simp only [ctr, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, hφ, hS', Pi.sub_apply,
        Pi.smul_apply, hS]
      push_cast
      rw [show (6 : ℚ) ^ R = 6 ^ (R - Δ) * 6 ^ Δ by rw [← pow_add, Nat.sub_add_cancel hΔR]]
      field_simp
      ring
    rw [hcomb]
    exact U.smul_mem _ (U.sub_mem hU (U.smul_mem _ hyU))
  -- step 3: round the coefficients in the generators
  rw [← hgU] at hdiff
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun ℚ).mp hdiff
  set m' : Fin n → ℤ := y - ∑ i, round (c i) • g i
  have hm'φ : φ m' - ctr = ∑ i, (c i - round (c i)) • φ (g i) := by
    simp only [m', map_sub, map_sum, map_zsmul, sub_smul, Finset.sum_sub_distrib, hc]
    simp only [Int.cast_smul_eq_zsmul]
    abel
  have hgmem : ∀ i, φ (g i) ∈ U := fun i => hgU ▸ Submodule.subset_span ⟨i, rfl⟩
  refine ⟨m', ?_, ?_⟩
  · -- `m_h - 6^Δ m' ∈ U ⊆ K_B`
    have hdU : φ mh - (6 : ℚ) ^ Δ • φ m' ∈ U := by
      have he : φ mh - (6 : ℚ) ^ Δ • φ m' = φ (mh - (6 : ℤ) ^ Δ • y) +
          ∑ i, ((6 : ℚ) ^ Δ * round (c i)) • φ (g i) := by
        simp only [m', map_sub, map_sum, map_zsmul, smul_sub, Finset.smul_sum, smul_smul,
          ← Int.cast_smul_eq_zsmul ℚ]
        push_cast
        abel
      rw [he]
      exact U.add_mem hyU (U.sum_mem fun i _ => U.smul_mem _ (hgmem i))
    have hK := K.sub_mem hh (hUK (U.smul_mem ((6 : ℚ) ^ h)⁻¹ hdU))
    convert hK using 1
    rw [add_sub_assoc, ← map_sub]
    congr 2
    rw [smul_sub, sub_sub_cancel, smul_smul]
    congr 1
    rw [show (6 : ℚ) ^ h = 6 ^ (h - Δ) * 6 ^ Δ by
      rw [← pow_add, Nat.sub_add_cancel (hΔR.trans hRh)]]
    field_simp
  · intro l
    have hl := congrFun hm'φ l
    simp only [Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, hφ] at hl
    have hctr : |ctr l| ≤ 6 ^ (R - Δ) * ∑ j, |(β j : ℚ) / Q| * |(mj j l : ℚ)| := by
      simp only [ctr, Pi.smul_apply, Finset.sum_apply, smul_eq_mul, hφ, abs_mul,
        abs_of_pos (by positivity : (0 : ℚ) < 6 ^ (R - Δ))]
      gcongr
      refine (Finset.abs_sum_le_sum_abs _ _).trans (le_of_eq ?_)
      simp [abs_mul]
    have hrest : |∑ i, (c i - round (c i)) * (g i l : ℚ)| ≤ k * G := by
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      calc ∑ i, |(c i - round (c i)) * (g i l : ℚ)| ≤ ∑ _i : Fin k, G := by
            apply Finset.sum_le_sum; intro i _
            rw [abs_mul]
            have h1 : |c i - round (c i)| ≤ 1 := (abs_sub_round _).trans (by norm_num)
            calc |c i - round (c i)| * |(g i l : ℚ)| ≤ 1 * |(g i l : ℚ)| := by
                  gcongr
              _ ≤ G := by rw [one_mul]; exact hG i l
        _ = k * G := by simp
    have : (m' l : ℚ) = ctr l + ∑ i, (c i - round (c i)) * (g i l : ℚ) := by linarith
    rw [this]
    exact (abs_add_le _ _).trans (add_le_add hctr hrest)

/-- Blueprint line 2012: for an increasing family of subspaces of a `d`-dimensional space, at most
`d R` heights `h ≥ R` have `V_{h-R} ≠ V_h`. -/
theorem rank_change_heights_card {M : Type*} [AddCommGroup M] [Module ℚ M]
    [FiniteDimensional ℚ M] (V : ℕ → Submodule ℚ M) (hV : Monotone V) (R N : ℕ) :
    ((Finset.range N).filter fun h => R ≤ h ∧ V (h - R) ≠ V h).card ≤
      Module.finrank ℚ M * R := by
  classical
  set r : ℕ → ℕ := fun i => Module.finrank ℚ (V i)
  have hr : Monotone r := fun i j hij => Submodule.finrank_mono (hV hij)
  set jumps := (Finset.range N).filter fun i => r i < r (i + 1)
  -- few jumps
  have hjumps : jumps.card ≤ Module.finrank ℚ M := by
    calc jumps.card = ∑ i ∈ jumps, 1 := by simp
      _ ≤ ∑ i ∈ Finset.range N, (r (i + 1) - r i) := by
          rw [Finset.sum_filter]
          apply Finset.sum_le_sum; intro i _
          split_ifs with h <;> omega
      _ = r N - r 0 := Finset.sum_range_tsub hr N
      _ ≤ r N := Nat.sub_le _ _
      _ ≤ Module.finrank ℚ M := Submodule.finrank_le _
  -- every bad height follows a jump within `R` steps
  have hsub : ((Finset.range N).filter fun h => R ≤ h ∧ V (h - R) ≠ V h) ⊆
      jumps.biUnion fun i => Finset.Icc (i + 1) (i + R) := by
    intro h hh
    obtain ⟨hhN, hRh, hne⟩ := Finset.mem_filter.mp hh
    rw [Finset.mem_range] at hhN
    have hlt : r (h - R) < r h := by
      have hle : V (h - R) ≤ V h := hV (Nat.sub_le _ _)
      exact Submodule.finrank_lt_finrank_of_lt (lt_of_le_of_ne hle hne)
    by_contra hno
    have hconst : ∀ t, t ≤ R → r (h - R + t) = r (h - R) := by
      intro t
      induction t with
      | zero => intro; rfl
      | succ t ih =>
        intro ht
        rw [← ih (by omega)]
        apply le_antisymm _ (hr (by omega))
        by_contra hgt
        push Not at hgt
        apply hno
        rw [Finset.mem_biUnion]
        refine ⟨h - R + t, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hgt⟩, ?_⟩
        rw [Finset.mem_Icc]; omega
    have := hconst R le_rfl
    rw [Nat.sub_add_cancel hRh] at this
    omega
  calc _ ≤ (jumps.biUnion fun i => Finset.Icc (i + 1) (i + R)).card := Finset.card_le_card hsub
    _ ≤ ∑ i ∈ jumps, (Finset.Icc (i + 1) (i + R)).card := Finset.card_biUnion_le
    _ = jumps.card * R := by simp
    _ ≤ Module.finrank ℚ M * R := Nat.mul_le_mul_right _ hjumps

/-- Blueprint line 2012: at all but `(2d + 1) R` heights `h < N`, two increasing families
`V_i, U_i` of subspaces of a `d`-dimensional space are stable between `h - R` and `h`. -/
theorem stable_heights_card {M : Type*} [AddCommGroup M] [Module ℚ M]
    [FiniteDimensional ℚ M] (V U : ℕ → Submodule ℚ M) (hV : Monotone V) (hU : Monotone U)
    (R N : ℕ) :
    ((Finset.range N).filter fun h => ¬(R ≤ h ∧ V (h - R) = V h ∧ U (h - R) = U h)).card ≤
      (2 * Module.finrank ℚ M + 1) * R := by
  classical
  have hsub : ((Finset.range N).filter fun h => ¬(R ≤ h ∧ V (h - R) = V h ∧ U (h - R) = U h)) ⊆
      Finset.range R ∪ ((Finset.range N).filter fun h => R ≤ h ∧ V (h - R) ≠ V h) ∪
        ((Finset.range N).filter fun h => R ≤ h ∧ U (h - R) ≠ U h) := by
    intro h hh
    obtain ⟨hhN, hbad⟩ := Finset.mem_filter.mp hh
    simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_range]
    by_cases hRh : R ≤ h
    · by_cases hVh : V (h - R) = V h
      · exact Or.inr ⟨Finset.mem_range.mp hhN, hRh, fun hUh => hbad ⟨hRh, hVh, hUh⟩⟩
      · exact Or.inl (Or.inr ⟨Finset.mem_range.mp hhN, hRh, hVh⟩)
    · exact Or.inl (Or.inl (by omega))
  calc _ ≤ _ := Finset.card_le_card hsub
    _ ≤ _ := Finset.card_union_le _ _
    _ ≤ (Finset.range R).card + ((Finset.range N).filter fun h => R ≤ h ∧ V (h - R) ≠ V h).card
        + ((Finset.range N).filter fun h => R ≤ h ∧ U (h - R) ≠ U h).card := by
        gcongr; exact Finset.card_union_le _ _
    _ ≤ R + Module.finrank ℚ M * R + Module.finrank ℚ M * R := by
        gcongr
        · simp
        · exact rank_change_heights_card V hV R N
        · exact rank_change_heights_card U hU R N
    _ = (2 * Module.finrank ℚ M + 1) * R := by ring

/-- The span `U_S` of integer vectors of `K_B = ι⁻¹ K` with entries at most `S` (blueprint
line 2012). -/
def smallKernelSpan {W : Type*} [AddCommGroup W] [Module ℚ W] {n : ℕ} (K : Submodule ℚ W)
    (ι : (Fin n → ℚ) →ₗ[ℚ] W) (S : ℚ) : Submodule ℚ (Fin n → ℚ) :=
  Submodule.span ℚ {v | ∃ z : Fin n → ℤ, v = integerRationalMap n z ∧
    ι (integerRationalMap n z) ∈ K ∧ ∀ l, |(z l : ℚ)| ≤ S}

theorem smallKernelSpan_mono {W : Type*} [AddCommGroup W] [Module ℚ W] {n : ℕ}
    (K : Submodule ℚ W) (ι : (Fin n → ℚ) →ₗ[ℚ] W) : Monotone (smallKernelSpan K ι) := by
  intro S S' hS
  apply Submodule.span_mono
  rintro v ⟨z, rfl, hz, hzS⟩
  exact ⟨z, rfl, hz, fun l => (hzS l).trans hS⟩

theorem smallKernelSpan_le {W : Type*} [AddCommGroup W] [Module ℚ W] {n : ℕ}
    (K : Submodule ℚ W) (ι : (Fin n → ℚ) →ₗ[ℚ] W) (S : ℚ) :
    smallKernelSpan K ι S ≤ K.comap ι := by
  rw [smallKernelSpan, Submodule.span_le]
  rintro v ⟨z, rfl, hz, -⟩
  exact hz

/-- Blueprint line 2027: `U_S` has at most `n` linearly independent integer generators with entries
at most `S`. -/
theorem smallKernelSpan_generators {W : Type*} [AddCommGroup W] [Module ℚ W] {n : ℕ}
    (K : Submodule ℚ W) (ι : (Fin n → ℚ) →ₗ[ℚ] W) (S : ℚ) :
    ∃ k ≤ n, ∃ g : Fin k → Fin n → ℤ,
      Submodule.span ℚ (Set.range fun i => integerRationalMap n (g i)) = smallKernelSpan K ι S ∧
      ∀ i l, |(g i l : ℚ)| ≤ S := by
  classical
  set s : Set (Fin n → ℚ) := {v | ∃ z : Fin n → ℤ, v = integerRationalMap n z ∧
    ι (integerRationalMap n z) ∈ K ∧ ∀ l, |(z l : ℚ)| ≤ S}
  obtain ⟨b, hbs, hspan, hli⟩ := exists_linearIndependent ℚ s
  have hfin : b.Finite := hli.setFinite
  let : Fintype b := hfin.fintype
  set k := Fintype.card b
  have hk : k ≤ n := by
    have := hli.fintype_card_le_finrank
    simpa only [Module.finrank_fin_fun] using this
  let e : Fin k ≃ b := (Fintype.equivFin b).symm
  have hz : ∀ i, ∃ z : Fin n → ℤ, (e i : Fin n → ℚ) = integerRationalMap n z ∧
      ∀ l, |(z l : ℚ)| ≤ S := by
    intro i
    obtain ⟨z, hz, -, hzS⟩ := hbs (e i).2
    exact ⟨z, hz, hzS⟩
  choose g hg hgS using hz
  refine ⟨k, hk, g, ?_, hgS⟩
  rw [smallKernelSpan, ← hspan]
  congr 1
  ext v
  constructor
  · rintro ⟨i, rfl⟩
    change integerRationalMap n (g i) ∈ b
    rw [← hg i]; exact (e i).2
  · intro hv
    refine ⟨e.symm ⟨v, hv⟩, ?_⟩
    simp [← hg]

/-- Blueprint `lem:stabilize` (lines 2002-2029), witness form: at a height `h ≥ R` where the
kernel spans are stable, `U_{S_{h-R}} = U_{S_h}`, a CURRENT relation `a + ι(m_h/6^h) ∈ K`
together with a bounded expansion `a = Σ_j (β_j/Q) a_j` in vectors with height-`(h-R)` witnesses
(the defining basis of the stable `V_{h-R}`) yields a direct PRE witness at height `h - Δ`,
of size at most `6^(R-Δ) Σ_j |β_j/Q| |m_j| + n S_{h-R}`. -/
theorem height_stabilization {W : Type*} [AddCommGroup W] [Module ℚ W] {n : ℕ}
    (K : Submodule ℚ W) (ι : (Fin n → ℚ) →ₗ[ℚ] W) (S : ℕ → ℚ) {R Δ h Q : ℕ} (hΔR : Δ ≤ R)
    (hRh : R ≤ h) (hS0 : 0 ≤ S (h - R))
    (hstable : smallKernelSpan K ι (S (h - R)) = smallKernelSpan K ι (S h))
    (hQ : 0 < Q) (hQR : Q < 2 ^ (R - Δ)) {J : ℕ} (a : W) (aj : Fin J → W) (β : Fin J → ℤ)
    (ha : a = ∑ j, ((β j : ℚ) / Q) • aj j) (mj : Fin J → Fin n → ℤ)
    (hj : ∀ j, aj j + ι (((6 : ℚ) ^ (h - R))⁻¹ • integerRationalMap n (mj j)) ∈ K)
    (mh : Fin n → ℤ) (hh : a + ι (((6 : ℚ) ^ h)⁻¹ • integerRationalMap n mh) ∈ K)
    (hzS : ∀ l, |(Q : ℚ) * mh l - 6 ^ R * ∑ j, (β j : ℚ) * mj j l| ≤ S h) :
    ∃ m' : Fin n → ℤ, a + ι (((6 : ℚ) ^ (h - Δ))⁻¹ • integerRationalMap n m') ∈ K ∧
      ∀ l, |(m' l : ℚ)| ≤ 6 ^ (R - Δ) * ∑ j, |(β j : ℚ) / Q| * |(mj j l : ℚ)| + n * S (h - R) := by
  obtain ⟨k, hk, g, hg, hgS⟩ := smallKernelSpan_generators K ι (S (h - R))
  have hUS : ∀ z : Fin n → ℤ, ι (integerRationalMap n z) ∈ K → (∀ l, |(z l : ℚ)| ≤ S h) →
      integerRationalMap n z ∈ smallKernelSpan K ι (S (h - R)) := by
    intro z hz hzb
    rw [hstable]
    exact Submodule.subset_span ⟨z, rfl, hz, hzb⟩
  obtain ⟨m', hm', hb⟩ := stabilize_witness K ι _ (smallKernelSpan_le K ι _) g hg hgS hΔR hRh
    hQ hQR a aj β ha mj hj mh hh hUS hzS
  refine ⟨m', hm', fun l => (hb l).trans ?_⟩
  gcongr

/-! ### Coherence of the good predicates (blueprint lines 2031-2047) -/

/-- Three subsets of a finite set: `|A| + |B| + |G| ≤ 2 |Ps| + |A ∩ B ∩ G|`. -/
theorem card_inter_three_ge {α : Type*} [DecidableEq α] (Ps A B G : Finset α) (hA : A ⊆ Ps)
    (hB : B ⊆ Ps) (hG : G ⊆ Ps) : A.card + B.card + G.card ≤ 2 * Ps.card + (A ∩ B ∩ G).card := by
  have e1 := Finset.card_union_add_card_inter A B
  have e2 := Finset.card_union_add_card_inter (A ∩ B) G
  have c1 := Finset.card_le_card (Finset.union_subset hA hB)
  have c2 : (A ∩ B ∪ G).card ≤ Ps.card :=
    Finset.card_le_card (Finset.union_subset (fun x hx => hA (Finset.mem_inter.mp hx).1) hG)
  omega

/-- Height-indexed PRE components `E_h(m)` and CURRENT components `F_h(m)` of a finite mode set
with primary labels `π`, abstracting the two graphs of `eq:PRE` and `eq:CURRENT`: components
contain their mode and are determined by any member, PRE refines CURRENT, and both increase with
height. -/
structure ModeComponents (Mode P : Type*) [DecidableEq Mode] [DecidableEq P] where
  E : ℕ → Mode → Finset Mode
  F : ℕ → Mode → Finset Mode
  π : Mode → P
  E_self : ∀ h m, m ∈ E h m
  E_comp : ∀ h m x, x ∈ E h m → E h x = E h m
  F_comp : ∀ h m x, x ∈ F h m → F h x = F h m
  E_le_F : ∀ h m, E h m ⊆ F h m
  E_mono : ∀ h h' m, h ≤ h' → E h m ⊆ E h' m
  F_mono : ∀ h h' m, h ≤ h' → F h m ⊆ F h' m

namespace ModeComponents

variable {Mode P : Type*} [DecidableEq Mode] [DecidableEq P] (C : ModeComponents Mode P)

/-- The primary labels `π(S)`. -/
def labels (S : Finset Mode) : Finset P := S.image C.π

/-- Blueprint `eq:good`: a mode is good at height `h ≥ Δ` when its PRE predecessor carries
nine tenths of the primaries of its CURRENT component, and nine tenths of those primaries are
nonexceptional and good for the primary (`goodP h`). -/
def Good (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)] (h : ℕ) (m : Mode) :
    Prop :=
  Δ ≤ h ∧ 9 * (C.labels (C.F h m)).card ≤ 10 * (C.labels (C.E (h - Δ) m)).card ∧
    9 * (C.labels (C.F h m)).card ≤ 10 * ((C.labels (C.F h m)).filter (goodP h)).card

theorem E_eq_of_mem {h : ℕ} {m x : Mode} (hx : x ∈ C.E h m) : C.E h m = C.E h x :=
  (C.E_comp h m x hx).symm

/-- Blueprint lines 2034-2035: two good modes in one CURRENT component at height `h` have the
same PRE predecessor at `h - Δ`, when good primaries satisfy the conclusion of `lem:stabilize`
(two of their modes in one CURRENT component at `h` are PRE-joined at `h - Δ`). -/
theorem good_same_predecessor (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)]
    (hstab : ∀ h x x', goodP h (C.π x) → C.π x' = C.π x → x' ∈ C.F h x → x' ∈ C.E (h - Δ) x)
    {h : ℕ} {m m' : Mode} (hm : C.Good Δ goodP h m) (hm' : C.Good Δ goodP h m')
    (hmm' : m' ∈ C.F h m) : C.E (h - Δ) m = C.E (h - Δ) m' := by
  classical
  obtain ⟨hΔ, h1, h2⟩ := hm
  obtain ⟨-, h1', h2'⟩ := hm'
  have hF : C.F h m' = C.F h m := C.F_comp h m m' hmm'
  rw [hF] at h1' h2'
  set Ps := C.labels (C.F h m)
  have hsub : ∀ x, C.labels (C.E (h - Δ) x) ⊆ C.labels (C.F h x) := by
    intro x
    exact Finset.image_subset_image ((C.E_le_F _ x).trans (C.F_mono _ _ x (Nat.sub_le _ _)))
  have hA : C.labels (C.E (h - Δ) m) ⊆ Ps := hsub m
  have hB : C.labels (C.E (h - Δ) m') ⊆ Ps := by
    have := hsub m'; rwa [hF] at this
  set A := C.labels (C.E (h - Δ) m)
  set B := C.labels (C.E (h - Δ) m')
  set G := Ps.filter (goodP h)
  -- three subsets of nine tenths of `Ps` intersect
  have hne : ((A ∩ B) ∩ G).Nonempty := by
    have hPs : 0 < Ps.card := by
      apply Finset.card_pos.mpr
      exact ⟨C.π m, Finset.mem_image_of_mem _ (C.E_le_F h m (C.E_self h m))⟩
    have h3 := card_inter_three_ge Ps A B G hA hB (Finset.filter_subset _ _)
    apply Finset.card_pos.mp
    omega
  obtain ⟨p, hp⟩ := hne
  obtain ⟨⟨hpA, hpB⟩, hpG⟩ := Finset.mem_inter.mp hp |>.imp_left Finset.mem_inter.mp
  have hpg := (Finset.mem_filter.mp hpG).2
  obtain ⟨x, hxE, rfl⟩ := Finset.mem_image.mp hpA
  obtain ⟨x', hx'E, hx'p⟩ := Finset.mem_image.mp hpB
  have hxF : x ∈ C.F h m :=
    C.F_mono _ _ m (Nat.sub_le _ _) (C.E_le_F _ m hxE)
  have hx'F : x' ∈ C.F h m :=
    hF ▸ C.F_mono _ _ m' (Nat.sub_le _ _) (C.E_le_F _ m' hx'E)
  have hjoin : x' ∈ C.E (h - Δ) x := by
    apply hstab h x x' hpg hx'p
    rw [C.F_comp h m x hxF]; exact hx'F
  rw [C.E_eq_of_mem hxE, C.E_eq_of_mem hx'E, C.E_eq_of_mem hjoin]

instance (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)] (h : ℕ) (m : Mode) :
    Decidable (C.Good Δ goodP h m) := by
  unfold Good; infer_instance

/-- The predicate `eq:good` depends only on the two components. -/
theorem good_iff_of_components (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)]
    {h : ℕ} {m m' : Mode} (hE : C.E (h - Δ) m = C.E (h - Δ) m') (hF : C.F h m = C.F h m') :
    C.Good Δ goodP h m ↔ C.Good Δ goodP h m' := by
  unfold Good; rw [hE, hF]

/-- Blueprint line 2035: modes in one minimal PRE component have identical predicates at every
height. -/
theorem good_iff_of_minimal_pre (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)]
    {m m' : Mode} (hmm' : m' ∈ C.E 0 m) (h : ℕ) :
    C.Good Δ goodP h m ↔ C.Good Δ goodP h m' := by
  apply C.good_iff_of_components Δ goodP
  · exact C.E_eq_of_mem (C.E_mono 0 _ m (Nat.zero_le _) hmm')
  · exact (C.F_comp h m m' (C.F_mono 0 h m (Nat.zero_le _) (C.E_le_F 0 m hmm'))).symm

/-- The bad heights `h ≤ J` of a mode. -/
def badHeights (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)] (J : ℕ)
    (m : Mode) : Finset ℕ :=
  (Finset.range (J + 1)).filter fun h => ¬C.Good Δ goodP h m

/-- A core mode has at most `δ (J + 1)` bad heights. -/
def Core (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)] (J : ℕ) (δ : ℝ)
    (m : Mode) : Prop :=
  ((C.badHeights Δ goodP J m).card : ℝ) ≤ δ * (J + 1)

/-- The upper heights `eq:upper-heights`, `⌈4δJ⌉ ≤ h ≤ J`. -/
noncomputable def upperHeights (J : ℕ) (δ : ℝ) : Finset ℕ :=
  (Finset.range (J + 1)).filter fun h => ⌈4 * δ * J⌉₊ ≤ h

/-- Blueprint lines 2035-2040: two core modes in one minimal CURRENT component have identical good
predicates on the upper heights. -/
theorem core_good_iff (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)]
    (hstab : ∀ h x x', goodP h (C.π x) → C.π x' = C.π x → x' ∈ C.F h x → x' ∈ C.E (h - Δ) x)
    {J : ℕ} (hJ : 2 ≤ J) {δ : ℝ} (hδ : 0 < δ) (hδJ : ⌈4 * δ * J⌉₊ ≤ J) {m m' : Mode}
    (hm : C.Core Δ goodP J δ m) (hm' : C.Core Δ goodP J δ m') (hmm' : m' ∈ C.F 0 m) :
    ∀ h ∈ upperHeights J δ, C.Good Δ goodP h m ↔ C.Good Δ goodP h m' := by
  classical
  -- a common good height below `⌈4δJ⌉`
  obtain ⟨h0, hh0, hg0, hg0'⟩ : ∃ h0 < ⌈4 * δ * J⌉₊, C.Good Δ goodP h0 m ∧
      C.Good Δ goodP h0 m' := by
    by_contra hno
    push Not at hno
    have hsub : Finset.range ⌈4 * δ * J⌉₊ ⊆ C.badHeights Δ goodP J m ∪
        C.badHeights Δ goodP J m' := by
      intro h hh
      have hhJ : h < J + 1 := by have := Finset.mem_range.mp hh; omega
      simp only [Finset.mem_union, badHeights, Finset.mem_filter, Finset.mem_range]
      by_cases hgm : C.Good Δ goodP h m
      · exact Or.inr ⟨hhJ, hno h (Finset.mem_range.mp hh) hgm⟩
      · exact Or.inl ⟨hhJ, hgm⟩
    have hc := (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
    rw [Finset.card_range] at hc
    have hc' : (⌈4 * δ * J⌉₊ : ℝ) ≤ δ * (J + 1) + δ * (J + 1) := by
      have : (⌈4 * δ * J⌉₊ : ℝ) ≤ ((C.badHeights Δ goodP J m).card : ℝ) +
          (C.badHeights Δ goodP J m').card := by exact_mod_cast hc
      have h1 : ((C.badHeights Δ goodP J m).card : ℝ) ≤ δ * (J + 1) := hm
      have h2 : ((C.badHeights Δ goodP J m').card : ℝ) ≤ δ * (J + 1) := hm'
      linarith
    have hceil := Nat.le_ceil (4 * δ * J)
    have hJr : (2 : ℝ) ≤ J := by exact_mod_cast hJ
    nlinarith
  have hpre := C.good_same_predecessor Δ goodP hstab hg0 hg0'
    (C.F_mono 0 h0 m (Nat.zero_le _) hmm')
  intro h hh
  have hh0h : h0 ≤ h := by
    have := (Finset.mem_filter.mp hh).2; omega
  apply C.good_iff_of_components Δ goodP
  · have hmem : m' ∈ C.E (h - Δ) m := by
      apply C.E_mono (h0 - Δ) _ m (by omega)
      rw [hpre]; exact C.E_self _ m'
    exact C.E_eq_of_mem hmem
  · exact (C.F_comp h m m' (C.F_mono 0 h m (Nat.zero_le _) hmm')).symm

/-- Blueprint line 2045: a core mode has bad proportion at most `2δ` on the upper heights,
for `δ ≤ 1/16` and `J ≥ 2`. -/
theorem core_bad_proportion (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)]
    {J : ℕ} (hJ : 2 ≤ J) {δ : ℝ} (hδ : 0 < δ) (hδ16 : δ ≤ 1 / 16) {m : Mode}
    (hm : C.Core Δ goodP J δ m) :
    ((C.badHeights Δ goodP J m ∩ upperHeights J δ).card : ℝ) ≤
      2 * δ * (upperHeights J δ).card := by
  set c := ⌈4 * δ * J⌉₊
  have hup : upperHeights J δ = Finset.Ico c (J + 1) := by
    ext h
    simp only [upperHeights, Finset.mem_filter, Finset.mem_range, Finset.mem_Ico]
    constructor <;> intro hh <;> omega
  have hJr : (2 : ℝ) ≤ J := by exact_mod_cast hJ
  have hc : (c : ℝ) < 4 * δ * J + 1 := Nat.ceil_lt_add_one (by positivity)
  have hcJ : c ≤ J + 1 := by
    have : (c : ℝ) ≤ J + 1 := by nlinarith
    exact_mod_cast this
  have hcard : ((upperHeights J δ).card : ℝ) = J + 1 - c := by
    rw [hup, Nat.card_Ico, Nat.cast_sub hcJ]; push_cast; ring
  have h1 : ((C.badHeights Δ goodP J m).card : ℝ) ≤ δ * (J + 1) := hm
  have h2 : ((C.badHeights Δ goodP J m ∩ upperHeights J δ).card : ℝ) ≤
      (C.badHeights Δ goodP J m).card := by
    exact_mod_cast Finset.card_le_card Finset.inter_subset_left
  have hkey : 2 * (c : ℝ) ≤ J + 1 := by nlinarith
  rw [hcard]
  nlinarith [mul_le_mul_of_nonneg_left hkey hδ.le]

end ModeComponents

/-! ### Separated mode rows (lem:mode-rows, blueprint lines 2049-2059) -/

/-- Blueprint lines 2054-2055: a quadratic phase difference whose derivative `2αx + β` exceeds
`θ` at one point of a cell `[a, a + r]`, with slope variation `2|α| r ≤ θ/2`, has normalized
oscillatory integral at most `8/(θ r)` on the cell. -/
theorem cell_cross_pair_le (α β γ : ℝ) {a r θ : ℝ} (hr : 0 < r) (hθ : 0 < θ)
    {x₀ : ℝ} (hx₀ : x₀ ∈ Set.Icc a (a + r)) (hlarge : θ ≤ |2 * α * x₀ + β|)
    (hvar : 2 * |α| * r ≤ θ / 2) :
    r⁻¹ * ‖∫ x in Set.Icc a (a + r), fourierWave 1 (α * x ^ 2 + β * x + γ)‖ ≤ 8 / (θ * r) := by
  have hlower : ∀ x ∈ Set.Icc a (a + r), θ / 2 ≤ |2 * α * x + β| := by
    intro x hx
    have hxx : |x - x₀| ≤ r := by
      rw [abs_le]; constructor <;> linarith [hx.1, hx.2, hx₀.1, hx₀.2]
    have hd : |(2 * α * x + β) - (2 * α * x₀ + β)| ≤ θ / 2 := by
      rw [show (2 * α * x + β) - (2 * α * x₀ + β) = 2 * α * (x - x₀) by ring, abs_mul,
        abs_mul, abs_two]
      calc 2 * |α| * |x - x₀| ≤ 2 * |α| * r := by gcongr
        _ ≤ θ / 2 := hvar
    have := abs_sub_abs_le_abs_sub (2 * α * x₀ + β) (2 * α * x + β)
    rw [abs_sub_comm] at this
    linarith
  have h := quadratic_oscillatory_integral_bound α β γ (by linarith) (by positivity) hlower
  calc r⁻¹ * ‖∫ x in Set.Icc a (a + r), fourierWave 1 (α * x ^ 2 + β * x + γ)‖ ≤
        r⁻¹ * (4 / (θ / 2)) := by gcongr
    _ = 8 / (θ * r) := by field_simp; ring

/-- Blueprint line 2055: a cross pairing expanded in a Fourier sum with coefficient sum at most
`D`, terms at most `ε`, and tail at most `τ`, is at most `D ε + τ`. -/
theorem fourier_sum_tail_le {ι : Type*} (s : Finset ι) (c : ι → ℂ) (I : ι → ℂ) (tail : ℂ)
    {D ε τ : ℝ} (hε : 0 ≤ ε) (hc : ∑ k ∈ s, ‖c k‖ ≤ D) (hI : ∀ k ∈ s, ‖I k‖ ≤ ε)
    (htail : ‖tail‖ ≤ τ) : ‖∑ k ∈ s, c k * I k + tail‖ ≤ D * ε + τ := by
  refine (norm_add_le _ _).trans (add_le_add ?_ htail)
  calc ‖∑ k ∈ s, c k * I k‖ ≤ ∑ k ∈ s, ‖c k‖ * ε := by
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k hk => ?_)
        rw [norm_mul]; exact mul_le_mul_of_nonneg_left (hI k hk) (norm_nonneg _)
    _ = (∑ k ∈ s, ‖c k‖) * ε := by rw [Finset.sum_mul]
    _ ≤ D * ε := mul_le_mul_of_nonneg_right hc hε

/-- `Σ ‖γ_n‖ ≤ √|N| (Σ ‖γ_n‖²)^{1/2}`. -/
theorem sum_norm_le_sqrt_card_mul {ν : Type*} (N : Finset ν) (γ : ν → ℂ) :
    ∑ n ∈ N, ‖γ n‖ ≤ Real.sqrt N.card * Real.sqrt (∑ n ∈ N, ‖γ n‖ ^ 2) := by
  have := Real.sum_mul_le_sqrt_mul_sqrt N (fun _ => (1 : ℝ)) (fun n => ‖γ n‖)
  simpa using this

section ModeRows

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Blueprint line 2058: two finite mode combinations with pairwise normalized inner products at
most `ε` on an overlap of length `L` pair to at most `ε L √|M| √|M'| b b'`. -/
theorem mode_combination_cross_le {μ μ' : Type*} (M : Finset μ) (M' : Finset μ')
    (β : μ → ℂ) (β' : μ' → ℂ) (x : μ → μ' → ℂ) {ε L : ℝ} (hεL : 0 ≤ ε * L)
    (hx : ∀ m ∈ M, ∀ m' ∈ M', ‖x m m'‖ ≤ ε * L) :
    ‖∑ m ∈ M, ∑ m' ∈ M', β m * β' m' * x m m'‖ ≤
      ε * L * (Real.sqrt M.card * Real.sqrt (∑ m ∈ M, ‖β m‖ ^ 2)) *
        (Real.sqrt M'.card * Real.sqrt (∑ m' ∈ M', ‖β' m'‖ ^ 2)) := by
  calc ‖∑ m ∈ M, ∑ m' ∈ M', β m * β' m' * x m m'‖ ≤
        ∑ m ∈ M, ∑ m' ∈ M', ‖β m‖ * ‖β' m'‖ * (ε * L) := by
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m hm => ?_)
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m' hm' => ?_)
        rw [norm_mul, norm_mul]
        exact mul_le_mul_of_nonneg_left (hx m hm m' hm') (by positivity)
    _ = ε * L * ((∑ m ∈ M, ‖β m‖) * (∑ m' ∈ M', ‖β' m'‖)) := by
        rw [Finset.sum_mul_sum, Finset.mul_sum]
        apply Finset.sum_congr rfl; intro m _
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl; intro m' _
        ring
    _ ≤ ε * L * ((Real.sqrt M.card * Real.sqrt (∑ m ∈ M, ‖β m‖ ^ 2)) *
          (Real.sqrt M'.card * Real.sqrt (∑ m' ∈ M', ‖β' m'‖ ^ 2))) :=
        mul_le_mul_of_nonneg_left (mul_le_mul (sum_norm_le_sqrt_card_mul M β)
          (sum_norm_le_sqrt_card_mul M' β') (Finset.sum_nonneg fun _ _ => norm_nonneg _)
          (by positivity)) hεL
    _ = _ := by ring

/-- Blueprint lines 2057-2058: almost-orthogonal synthesis. If `|⟨f_e, f_f⟩| ≤ η w_{ef} b_e b_f`
for `e ≠ f`, with symmetric overlaps `w` of multiplicity `Σ_f w_{ef} ≤ D ℓ_e` and diagonal control
`ℓ_e b_e² ≤ D² ‖f_e‖²`, then `‖Σ f_e‖² ≤ (1 + η D³) Σ ‖f_e‖²`. -/
theorem almost_orthogonal_synthesis {κ : Type*} (s : Finset κ) (v : κ → H)
    (b ℓ : κ → ℝ) (w : κ → κ → ℝ) {D η : ℝ} (hη : 0 ≤ η) (hD : 0 ≤ D)
    (hw0 : ∀ e e', 0 ≤ w e e') (hws : ∀ e e', w e e' = w e' e)
    (hcross : ∀ e ∈ s, ∀ e' ∈ s, e ≠ e' → ‖inner ℂ (v e) (v e')‖ ≤ η * w e e' * b e * b e')
    (hmult : ∀ e ∈ s, ∑ e' ∈ s, w e e' ≤ D * ℓ e)
    (hdiag : ∀ e ∈ s, ℓ e * b e ^ 2 ≤ D ^ 2 * ‖v e‖ ^ 2) :
    ‖∑ e ∈ s, v e‖ ^ 2 ≤ (1 + η * D ^ 3) * ∑ e ∈ s, ‖v e‖ ^ 2 := by
  classical
  have hexp : ‖∑ e ∈ s, v e‖ ^ 2 =
      ∑ e ∈ s, ∑ e' ∈ s, RCLike.re (inner ℂ (v e) (v e')) := by
    rw [@norm_sq_eq_re_inner ℂ, sum_inner]
    simp only [inner_sum, map_sum]
  have hpt : ∀ e ∈ s, ∀ e' ∈ s, RCLike.re (inner ℂ (v e) (v e')) ≤
      (if e = e' then ‖v e‖ ^ 2 else 0) + η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2)) := by
    intro e he e' he'
    have hw2 : 0 ≤ η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2)) := by
      have := hw0 e e'; positivity
    split_ifs with hee
    · subst hee
      rw [← @norm_sq_eq_re_inner ℂ]
      linarith
    · have h1 := (RCLike.re_le_norm (inner ℂ (v e) (v e'))).trans (hcross e he e' he' hee)
      have h2 : b e * b e' ≤ (b e ^ 2 + b e' ^ 2) / 2 := by nlinarith [sq_nonneg (b e - b e')]
      have h3 : η * w e e' * b e * b e' ≤ η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2)) := by
        have := mul_le_mul_of_nonneg_left h2 (mul_nonneg hη (hw0 e e'))
        linarith
      linarith
  have hsym : ∑ e ∈ s, ∑ e' ∈ s, w e e' * ((b e ^ 2 + b e' ^ 2) / 2) =
      ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 := by
    have hswap : ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e' ^ 2 = ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl; intro e _
      apply Finset.sum_congr rfl; intro e' _
      rw [hws]
    have hsplit : ∑ e ∈ s, ∑ e' ∈ s, w e e' * ((b e ^ 2 + b e' ^ 2) / 2) =
        (∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 + ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e' ^ 2) / 2 := by
      rw [← Finset.sum_add_distrib, Finset.sum_div]
      apply Finset.sum_congr rfl; intro e _
      rw [← Finset.sum_add_distrib, Finset.sum_div]
      apply Finset.sum_congr rfl; intro e' _
      ring
    rw [hsplit, hswap]; ring
  have hmain : ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 ≤ D ^ 3 * ∑ e ∈ s, ‖v e‖ ^ 2 := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum; intro e he
    rw [← Finset.sum_mul]
    calc (∑ e' ∈ s, w e e') * b e ^ 2 ≤ D * ℓ e * b e ^ 2 :=
          mul_le_mul_of_nonneg_right (hmult e he) (sq_nonneg _)
      _ = D * (ℓ e * b e ^ 2) := by ring
      _ ≤ D * (D ^ 2 * ‖v e‖ ^ 2) := mul_le_mul_of_nonneg_left (hdiag e he) hD
      _ = D ^ 3 * ‖v e‖ ^ 2 := by ring
  calc ‖∑ e ∈ s, v e‖ ^ 2 ≤ ∑ e ∈ s, ∑ e' ∈ s,
        ((if e = e' then ‖v e‖ ^ 2 else 0) + η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2))) := by
        rw [hexp]
        exact Finset.sum_le_sum fun e he => Finset.sum_le_sum fun e' he' => hpt e he e' he'
    _ = ∑ e ∈ s, ‖v e‖ ^ 2 + η * ∑ e ∈ s, ∑ e' ∈ s, w e e' * ((b e ^ 2 + b e' ^ 2) / 2) := by
        simp only [Finset.sum_add_distrib, Finset.sum_ite_eq, Finset.mul_sum]
        congr 1
        apply Finset.sum_congr rfl; intro e he
        simp [he]
    _ ≤ (1 + η * D ^ 3) * ∑ e ∈ s, ‖v e‖ ^ 2 := by
        rw [hsym]
        nlinarith [mul_le_mul_of_nonneg_left hmain hη]

/-- Blueprint line 2057 ("by duality"): row outputs `g_e = P_e F` of orthogonal projections satisfy
`Re⟨g_e, F⟩ = ‖g_e‖²`, so a synthesis bound `‖Σ g_e‖² ≤ C Σ ‖g_e‖²` gives
`Σ ‖g_e‖² ≤ C ‖F‖²`. -/
theorem rows_bessel_of_synthesis {κ : Type*} (s : Finset κ) (g : κ → H) (F : H) {C : ℝ}
    (hC : 0 ≤ C) (hproj : ∀ e ∈ s, RCLike.re (inner ℂ (g e) F) = ‖g e‖ ^ 2)
    (hsyn : ‖∑ e ∈ s, g e‖ ^ 2 ≤ C * ∑ e ∈ s, ‖g e‖ ^ 2) :
    ∑ e ∈ s, ‖g e‖ ^ 2 ≤ C * ‖F‖ ^ 2 := by
  set E := ∑ e ∈ s, ‖g e‖ ^ 2
  have hE0 : 0 ≤ E := Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hE : E = RCLike.re (inner ℂ (∑ e ∈ s, g e) F) := by
    rw [sum_inner, map_sum]
    exact (Finset.sum_congr rfl hproj).symm
  have hle : E ≤ ‖∑ e ∈ s, g e‖ * ‖F‖ := by
    rw [hE]; exact (RCLike.re_le_norm _).trans (norm_inner_le_norm _ _)
  have hsq : E ^ 2 ≤ C * E * ‖F‖ ^ 2 := by
    calc E ^ 2 ≤ (‖∑ e ∈ s, g e‖ * ‖F‖) ^ 2 := pow_le_pow_left₀ hE0 hle 2
      _ = ‖∑ e ∈ s, g e‖ ^ 2 * ‖F‖ ^ 2 := by ring
      _ ≤ C * E * ‖F‖ ^ 2 := mul_le_mul_of_nonneg_right hsyn (sq_nonneg _)
  rcases hE0.eq_or_lt with h0 | hpos
  · rw [← h0]; positivity
  · nlinarith

/-- Blueprint `lem:mode-rows` (lines 2049-2059), assembled: projection-row outputs `g_e = P_e F`
on cells of lengths `ℓ_e` with coefficient norms `b_e`, with cross pairings at most
`η w_{ef} b_e b_f` (`η = D_*^{-199}` from `cell_cross_pair_le`, `fourier_sum_tail_le`,
`mode_combination_cross_le`), overlap multiplicity `D_*` and private-coordinate diagonal control,
satisfy `Σ ‖P_e F‖² ≤ (1 + η D_*³) ‖F‖²`. -/
theorem separated_projection_rows {κ : Type*} (s : Finset κ) (g : κ → H) (F : H)
    (b ℓ : κ → ℝ) (w : κ → κ → ℝ) {D η : ℝ} (hη : 0 ≤ η) (hD : 0 ≤ D)
    (hproj : ∀ e ∈ s, RCLike.re (inner ℂ (g e) F) = ‖g e‖ ^ 2)
    (hw0 : ∀ e e', 0 ≤ w e e') (hws : ∀ e e', w e e' = w e' e)
    (hcross : ∀ e ∈ s, ∀ e' ∈ s, e ≠ e' → ‖inner ℂ (g e) (g e')‖ ≤ η * w e e' * b e * b e')
    (hmult : ∀ e ∈ s, ∑ e' ∈ s, w e e' ≤ D * ℓ e)
    (hdiag : ∀ e ∈ s, ℓ e * b e ^ 2 ≤ D ^ 2 * ‖g e‖ ^ 2) :
    ∑ e ∈ s, ‖g e‖ ^ 2 ≤ (1 + η * D ^ 3) * ‖F‖ ^ 2 :=
  rows_bessel_of_synthesis s g F (by positivity) hproj
    (almost_orthogonal_synthesis s g b ℓ w hη hD hw0 hws hcross hmult hdiag)

end ModeRows

/-! ### Composition with the main histories (lem:lift-composition, blueprint lines 2062-2077) -/

section LiftComposition

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- `joint_bessel_of_wholeRanges` with group Bessel constant `c`: rows that are Bessel with
constant `c` within each group and satisfy `eq:whole-ranges` with constant `C` are jointly
Bessel with constant `C c`. -/
theorem joint_bessel_of_wholeRanges_const {γ κ : Type*} [Fintype γ] [DecidableEq γ]
    (s : Finset κ) (grp : κ → γ) (R : κ → H →L[ℂ] H) {c : ℝ} (hc : 0 ≤ c)
    (hgrp : ∀ G h, ∑ k ∈ s.filter (grp · = G), ‖R k h‖ ^ 2 ≤ c * ‖h‖ ^ 2)
    {C : ℝ} (hC : 0 ≤ C)
    (hwr : ∀ x : κ → H, ‖∑ k ∈ s, ContinuousLinearMap.adjoint (R k) (x k)‖ ^ 2 ≤
      C * ∑ G, ‖∑ k ∈ s.filter (grp · = G), ContinuousLinearMap.adjoint (R k) (x k)‖ ^ 2)
    (h : H) : ∑ k ∈ s, ‖R k h‖ ^ 2 ≤ C * c * ‖h‖ ^ 2 := by
  classical
  set X := ∑ k ∈ s, ‖R k h‖ ^ 2
  set S := ∑ k ∈ s, ContinuousLinearMap.adjoint (R k) (R k h)
  have hX0 : 0 ≤ X := Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hXS : X = RCLike.re (inner ℂ h S) := by
    simp only [S, inner_sum, ContinuousLinearMap.adjoint_inner_right, map_sum, X]
    apply Finset.sum_congr rfl; intro k _
    rw [inner_self_eq_norm_sq_to_K, ← RCLike.ofReal_pow, RCLike.ofReal_re]
  have hSG : ‖S‖ ^ 2 ≤ C * c * X := by
    refine (hwr fun k => R k h).trans ?_
    rw [mul_assoc]
    refine mul_le_mul_of_nonneg_left ?_ hC
    calc ∑ G, ‖∑ k ∈ s.filter (grp · = G), ContinuousLinearMap.adjoint (R k) (R k h)‖ ^ 2 ≤
        ∑ G, c * ∑ k ∈ s.filter (grp · = G), ‖R k h‖ ^ 2 :=
          Finset.sum_le_sum fun G _ => synthesis_le_of_bessel _ R hc (hgrp G) _
      _ = c * X := by
          rw [← Finset.mul_sum]
          congr 1
          exact Finset.sum_fiberwise s grp _
  have hCc : 0 ≤ C * c := mul_nonneg hC hc
  have hXle : X ≤ ‖h‖ * Real.sqrt (C * c * X) := by
    refine hXS.le.trans ((RCLike.re_le_norm _).trans ((norm_inner_le_norm _ _).trans ?_))
    exact mul_le_mul_of_nonneg_left (by
      rw [← Real.sqrt_sq (norm_nonneg S)]; exact Real.sqrt_le_sqrt hSG) (norm_nonneg _)
  rcases eq_or_lt_of_le hX0 with h0 | hpos
  · rw [← h0]; positivity
  · have h1 : X ^ 2 ≤ ‖h‖ ^ 2 * (C * c * X) := by
      have := pow_le_pow_left₀ hX0 hXle 2
      rwa [mul_pow, Real.sq_sqrt (by positivity)] at this
    have h2 : X * X ≤ (C * c * ‖h‖ ^ 2) * X := by nlinarith
    exact le_of_mul_le_mul_right h2 hpos

/-- Blueprint `lem:lift-composition` (lines 2062-2077): mode rows `P_e` that are Bessel with
constant `G₀` within each group, composed with a fixed contractive lift `ℛ_G` and the outer main
ball projections `L_{u_e}` (whose insertion costs `C_c` by `lem:compression`), and whose adjoint
ranges over the groups obey `eq:whole-ranges` with constant `C_w`, become jointly Bessel; inserting
the shared histories `B_e F` by compression (cost `C_h`) and `‖F‖² ≤ N` bounds the joint squared
sum by `C_w G₀ C_c C_h N`. -/
theorem compose_lift_with_main_histories {γ κ : Type*} [Fintype γ] [DecidableEq γ]
    (s : Finset κ) (grp : κ → γ) (P : κ → H →L[ℂ] H) (Rl : γ → H →L[ℂ] H)
    (hRl : ∀ G y, ‖Rl G y‖ ≤ ‖y‖) (L : κ → H →L[ℂ] H) {G₀ Cc Cw Ch N : ℝ} (hG₀ : 0 ≤ G₀)
    (hCc : 0 ≤ Cc) (hCw : 0 ≤ Cw)
    (hrows : ∀ G x, ∑ k ∈ s.filter (grp · = G), ‖P k x‖ ^ 2 ≤ G₀ * ‖x‖ ^ 2)
    (hcompL : ∀ G (Q : κ → H →L[ℂ] H) (c : ℝ), 0 ≤ c →
      (∀ x, ∑ k ∈ s.filter (grp · = G), ‖Q k x‖ ^ 2 ≤ c * ‖x‖ ^ 2) →
      ∀ h, ∑ k ∈ s.filter (grp · = G), ‖Q k (L k h)‖ ^ 2 ≤ c * Cc * ‖h‖ ^ 2)
    (hwr : ∀ x : κ → H, ‖∑ k ∈ s, ContinuousLinearMap.adjoint
        ((P k).comp ((Rl (grp k)).comp (L k))) (x k)‖ ^ 2 ≤
      Cw * ∑ G, ‖∑ k ∈ s.filter (grp · = G), ContinuousLinearMap.adjoint
        ((P k).comp ((Rl (grp k)).comp (L k))) (x k)‖ ^ 2)
    (F : H) (B : κ → H)
    (hhist : ∀ c : ℝ, 0 ≤ c → (∀ h, ∑ k ∈ s, ‖(P k).comp ((Rl (grp k)).comp (L k)) h‖ ^ 2 ≤
        c * ‖h‖ ^ 2) →
      ∑ k ∈ s, ‖(P k).comp ((Rl (grp k)).comp (L k)) (B k)‖ ^ 2 ≤ c * Ch * ‖F‖ ^ 2)
    (hF : ‖F‖ ^ 2 ≤ N) (hCh : 0 ≤ Ch) :
    ∑ k ∈ s, ‖(P k).comp ((Rl (grp k)).comp (L k)) (B k)‖ ^ 2 ≤ Cw * (G₀ * Cc) * Ch * N := by
  classical
  -- one group: the rows `P_e ℛ_G` are Bessel
  have hQ : ∀ G x, ∑ k ∈ s.filter (grp · = G), ‖(P k).comp (Rl (grp k)) x‖ ^ 2 ≤
      G₀ * ‖x‖ ^ 2 := by
    intro G x
    have he : ∑ k ∈ s.filter (grp · = G), ‖(P k).comp (Rl (grp k)) x‖ ^ 2 =
        ∑ k ∈ s.filter (grp · = G), ‖P k (Rl G x)‖ ^ 2 := by
      apply Finset.sum_congr rfl; intro k hk
      rw [(Finset.mem_filter.mp hk).2]; rfl
    rw [he]
    refine (hrows G _).trans (mul_le_mul_of_nonneg_left ?_ hG₀)
    exact pow_le_pow_left₀ (norm_nonneg _) (hRl G x) 2
  -- the outer main ball projection by compression
  have hgrp : ∀ G h, ∑ k ∈ s.filter (grp · = G), ‖(P k).comp ((Rl (grp k)).comp (L k)) h‖ ^ 2 ≤
      G₀ * Cc * ‖h‖ ^ 2 := by
    intro G h
    exact hcompL G (fun k => (P k).comp (Rl (grp k))) G₀ hG₀ (hQ G) h
  -- joint Bessel by the whole ranges
  have hjoint := joint_bessel_of_wholeRanges_const s grp
    (fun k => (P k).comp ((Rl (grp k)).comp (L k))) (mul_nonneg hG₀ hCc) hgrp hCw hwr
  have := hhist (Cw * (G₀ * Cc)) (by positivity) hjoint
  refine this.trans ?_
  exact mul_le_mul_of_nonneg_left hF (by positivity)

end LiftComposition

/-! ### The linear-side energy (prop:linear-side, blueprint lines 2080-2120) -/

/-- `(b - a)/b ≤ H_b - H_a` for harmonic numbers. -/
theorem frac_le_harmonic_sub {a b : ℕ} (hab : a ≤ b) :
    ((b - a : ℕ) : ℝ) / b ≤ (harmonic b : ℝ) - harmonic a := by
  rcases Nat.eq_zero_or_pos b with hb | hb
  · subst hb; obtain rfl : a = 0 := by omega
    simp
  have he : (harmonic b : ℝ) - harmonic a = ∑ i ∈ Finset.Ico a b, ((i + 1 : ℕ) : ℝ)⁻¹ := by
    rw [Finset.sum_Ico_eq_sub _ hab]
    simp [harmonic]
  rw [he]
  calc ((b - a : ℕ) : ℝ) / b = ∑ _i ∈ Finset.Ico a b, (b : ℝ)⁻¹ := by
        rw [Finset.sum_const, Nat.card_Ico, nsmul_eq_mul, div_eq_mul_inv]
    _ ≤ ∑ i ∈ Finset.Ico a b, ((i + 1 : ℕ) : ℝ)⁻¹ := by
        apply Finset.sum_le_sum; intro i hi
        have := (Finset.mem_Ico.mp hi).2
        apply inv_anti₀ (by positivity)
        exact_mod_cast (show i + 1 ≤ b by omega)

/-- Blueprint lines 2093-2094 (elementary fact): if nonempty sets `S_j` increase from `S_0 = ∅`,
`X_j ⊆ S_j`, and each label belongs to at most `A` of the `X_j`, then
`Σ_j |X_j|/|S_j| ≤ A H_{|S_n|}`; enumerate labels by first entry. -/
theorem sum_frac_le_harmonic {α : Type*} [DecidableEq α] (S : ℕ → Finset α) (hS : Monotone S)
    (hS0 : S 0 = ∅) (X : ℕ → Finset α) (hX : ∀ j, X j ⊆ S j) (n A : ℕ)
    (hA : ∀ x, ((Finset.range n).filter fun j => x ∈ X (j + 1)).card ≤ A) :
    ∑ j ∈ Finset.range n, ((X (j + 1)).card : ℝ) / (S (j + 1)).card ≤
      A * (harmonic (S n).card : ℝ) := by
  classical
  -- first entry
  let f : α → ℕ := fun x => if h : ∃ j, x ∈ S j then Nat.find h else 0
  have hf_mem : ∀ x j, x ∈ S j → x ∈ S (f x) ∧ f x ≤ j := by
    intro x j hx
    have h : ∃ j, x ∈ S j := ⟨j, hx⟩
    simp only [f, h, ↓reduceDIte]
    exact ⟨Nat.find_spec h, Nat.find_min' h hx⟩
  have hf_pos : ∀ x j, x ∈ S j → 1 ≤ f x := by
    intro x j hx
    by_contra h0
    have := (hf_mem x j hx).1
    rw [show f x = 0 by omega, hS0] at this
    simp at this
  have hf_not : ∀ x j, x ∈ S j → x ∉ S (f x - 1) := by
    intro x j hx hmem
    have h : ∃ j, x ∈ S j := ⟨j, hx⟩
    have hle := hf_mem x (f x - 1) hmem
    have := hf_pos x j hx
    omega
  -- step 1: replace `|S_{j+1}|` by `|S_{f x}|`
  have step1 : ∑ j ∈ Finset.range n, ((X (j + 1)).card : ℝ) / (S (j + 1)).card ≤
      ∑ j ∈ Finset.range n, ∑ x ∈ X (j + 1), ((S (f x)).card : ℝ)⁻¹ := by
    apply Finset.sum_le_sum; intro j _
    rw [div_eq_mul_inv, ← nsmul_eq_mul, ← Finset.sum_const]
    apply Finset.sum_le_sum; intro x hx
    have hxS := hX _ hx
    obtain ⟨hxf, hfj⟩ := hf_mem x _ hxS
    have hpos : (0 : ℝ) < (S (f x)).card := by exact_mod_cast Finset.card_pos.mpr ⟨x, hxf⟩
    apply inv_anti₀ hpos
    exact_mod_cast Finset.card_le_card (hS hfj)
  -- step 2: exchange the sums
  have step2 : ∑ j ∈ Finset.range n, ∑ x ∈ X (j + 1), ((S (f x)).card : ℝ)⁻¹ ≤
      A * ∑ x ∈ S n, ((S (f x)).card : ℝ)⁻¹ := by
    have hre : ∀ j ∈ Finset.range n, ∑ x ∈ X (j + 1), ((S (f x)).card : ℝ)⁻¹ =
        ∑ x ∈ S n, if x ∈ X (j + 1) then ((S (f x)).card : ℝ)⁻¹ else 0 := by
      intro j hj
      rw [← Finset.sum_filter]
      congr 1
      ext x
      simp only [Finset.mem_filter]
      constructor
      · intro hx
        exact ⟨hS (by have := Finset.mem_range.mp hj; omega) (hX _ hx), hx⟩
      · exact fun h => h.2
    rw [Finset.sum_congr rfl hre, Finset.sum_comm, Finset.mul_sum]
    apply Finset.sum_le_sum; intro x _
    rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
    exact mul_le_mul_of_nonneg_right (by exact_mod_cast hA x) (by positivity)
  -- step 3: group labels by first entry
  have step3 : ∑ x ∈ S n, ((S (f x)).card : ℝ)⁻¹ =
      ∑ i ∈ Finset.range n, ((S (i + 1) \ S i).card : ℝ) / (S (i + 1)).card := by
    have hmaps : ∀ x ∈ S n, f x - 1 ∈ Finset.range n := by
      intro x hx
      have := hf_mem x n hx
      have := hf_pos x n hx
      rw [Finset.mem_range]; omega
    rw [← Finset.sum_fiberwise_of_maps_to hmaps]
    apply Finset.sum_congr rfl; intro i hi
    have hfib : (S n).filter (fun x => f x - 1 = i) = S (i + 1) \ S i := by
      ext x
      simp only [Finset.mem_filter, Finset.mem_sdiff]
