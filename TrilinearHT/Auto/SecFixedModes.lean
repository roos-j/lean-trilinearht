/-- The height of the effective phase matrix is quasipolynomial in `H` and `B`. -/
theorem split_height_budget {H B : ℝ} {d : ℕ} (hH : Real.exp 2 ≤ H) (hB : 2 ≤ B)
    (hd : (d : ℝ) ≤ Real.log H) :
    4 * H ^ (d ^ 2) * (B ^ (d ^ 2)) ^ 2 * (H + (d : ℝ) ^ 2 * ((1 + B) * H * B) + 1) ≤
      Real.exp (11 * (1 + Real.log H + Real.log B) ^ 3) := by
