theorem rhs_combine {T1 T2 T3 T4 T5 b2 b3 b5 e g : ℝ} (h2 : T2 ≤ b2) (h3 : T3 ≤ b3)
    (h5 : T5 ≤ b5) (h14 : 2 * (T1 + T4) = e) (hfinal : 2 * (b2 + b3 + b5) + e ≤ g) :
    2 * (T1 + T2 + T3 + T4 + T5) ≤ g := by
  linarith

/-- Side window energies are monotone in the window (the window sums have nonnegative terms). -/
theorem sideWinE_mono (z : ChartTag) (l : Fin 4) (g : ℝ → ℂ) (a r : ℝ) {K K' : Finset ℤ}
    (hKK' : K ⊆ K') (ρ : Fin z.dim → ℝ) : sideWinE z l g a r K ρ ≤ sideWinE z l g a r K' ρ := by
  unfold sideWinE
  exact Finset.sum_le_sum_of_subset_of_nonneg hKK' fun _ _ _ => sq_nonneg _

/-- The averaged side window energies are monotone in the window. -/
theorem integral_sideWinE_mono (z : ChartTag) (l : Fin 4) {g : ℝ → ℂ} (hg : Measurable g)
    {a r : ℝ} (hr : 0 < r) (hL2 : MemLp g 2 (volume.restrict (Set.Ioc a (a + r))))
    {K K' : Finset ℤ} (hKK' : K ⊆ K') :
    ∫ ρ, sideWinE z l g a r K ρ ∂offsetMeasure z.dim ≤
      ∫ ρ, sideWinE z l g a r K' ρ ∂offsetMeasure z.dim :=
  integral_mono (window_energy_integrable z l hg hr hL2 K).1
    (window_energy_integrable z l hg hr hL2 K').1 fun ρ => sideWinE_mono z l g a r hKK' ρ

theorem prod_ite_one_erase {l : Fin 4} (f : Fin 4 → ℝ) :
    ∏ j, (if j = l then (1 : ℝ) else f j) = ∏ j ∈ Finset.univ.erase l, f j := by
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ l), ite_eq_left_of_eq_true _ _ (eq_true rfl),
    one_mul]
  exact Finset.prod_congr rfl fun j hj =>
    ite_eq_right_iff.mpr fun h => absurd h (Finset.ne_of_mem_erase hj)

