  have hCD : 0 ≤ S.Cstar * S.Dstar := mul_nonneg (by linarith) (by linarith)
  have hA : 6 ^ 30 * (S.Cstar * S.Dstar) ≤ S.A0 := by
    have h1 : (6 : ℝ) ^ 30 ≤ 6 ^ S.Rht * S.Bstar := by
      have : (0 : ℝ) ≤ 6 ^ S.Rht := by positivity
      nlinarith
