  have hF : F ∈ D.goodCls G I j h := Finset.mem_image.mpr ⟨K, Finset.mem_filter.mpr ⟨hK, hg⟩, rfl⟩
  have e : D.repAnc G I j rep hrep d₀ h F = D.repAnchor G I j h (rep h) (hrep h hh) hF := by
    unfold repAnc
