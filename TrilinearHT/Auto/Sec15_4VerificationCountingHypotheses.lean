        Cd.gsz Td l (((D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)).filter
          fun K => roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h
