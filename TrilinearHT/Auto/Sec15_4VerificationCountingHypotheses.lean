      (by have := cutTail_nonneg Cd.z.dim Cd.hδ Cd.Kt; linarith) (hsup i))
  have hc3 : ∏ j, ∑ k ∈ sideOptF l F j, ‖D.c3 G I xs j k‖ =
      ∏ j ∈ Finset.univ.erase l, ∑ m ∈ F j, ‖D.c j G (D.blockOf I.1) (D.preCell I) m.1‖ := by
    rw [Finset.prod_congr rfl fun j _ => D.sum_norm_c3 G I xs l F j]
