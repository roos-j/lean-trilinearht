/-- In a core slot, the filtered sum of the slot values over the component index set is the sum
of the subtotals over the filtered components. -/
theorem slot_sum_core (σ : Fin 4 → Fin 3) {κ : Fin 4 → Type*} (Ks : ∀ l, Finset (κ l))
    (sub : ∀ l, κ l → V) (s e : Fin 4 → V) {l : Fin 4} (hl : σ l = 0)
    (P Q : Option (κ l) → Prop) [DecidablePred P] [DecidablePred Q] :
    ∑ o ∈ ((compIdx σ Ks l).filter P).filter Q, slotVal σ sub s e l o =
      ∑ K ∈ (Ks l).filter (fun K => P (some K) ∧ Q (some K)), sub l K := by
  unfold compIdx slotVal
  simp only [hl, ↓reduceIte, Finset.filter_filter]
  rw [Finset.filter_map, Finset.sum_map]
  rfl

end SlotSum

