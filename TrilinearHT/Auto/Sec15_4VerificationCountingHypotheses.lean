        ((1 + cutTail Cd.z.dim Cd.δ Cd.Kt) ^ 3 *
          ∏ j ∈ Finset.univ.erase l, ∑ m ∈ F j, ‖D.c j G (D.blockOf I.1) (D.preCell I) m.1‖) =
      2 * entryC κ' Td3.J3 Td3.Aw (dyadicGridLength A.G I.1 *
          (D.refT3 G I l a xs + ∑ i, (m₀ i : ℝ) * D.xiH Cd.z h' i)) *
        (Cd.shellU3 Td3 h' l a xs Bf X + Cd.tailU3 Td3 Bf X) *
