    M.biUnion id = (M.image cls).biUnion fun i => (M.filter fun K => cls K = i).biUnion id := by
  ext x
  simp only [Finset.mem_biUnion, Finset.mem_image, Finset.mem_filter, id]
  constructor
  · rintro ⟨K, hK, hx⟩
    exact ⟨cls K, ⟨K, hK, rfl⟩, K, ⟨hK, rfl⟩, hx⟩
  · rintro ⟨-, -, K, ⟨hK, -⟩, hx⟩
