/-- Blueprint lines 2711-2712, conclusion: separation `|u - w| > Σ` for nonzero differences
against every reserved shift, with `(|d| + |b|) ε ≤ Σ`, forces the difference to vanish. -/
theorem pair_difference_eq_zero {u v s₁ s₂ e₁ e₂ w ε Sep : ℝ} {a b c d : ℤ}
    (h₁ : a * u + b * v = s₁ + e₁) (h₂ : c * u + d * v = s₂ + e₂) (hD : a * d - b * c ≠ 0)
    (hw : (d : ℝ) * s₁ - b * s₂ = ((a * d - b * c : ℤ) : ℝ) * w) (he₁ : |e₁| ≤ ε)
    (he₂ : |e₂| ≤ ε) (hsep : u ≠ 0 → Sep < |u - w|) (hS : (|(d : ℝ)| + |(b : ℝ)|) * ε ≤ Sep) :
    u = 0 := by
  by_contra hu
  have := pair_determination h₁ h₂ hD hw he₁ he₂
  linarith [hsep hu]

/-- Blueprint `eq:total-count` (line 2729), first bound: if every pair of labels in roles `i, j`
determines tuples with at most `L` scale occurrences in total, then
`Σ_s N_s ≤ L M_i M_j` (here `M_i M_j` is the number of label pairs). -/
theorem total_count_le {T P σ : Type*} [DecidableEq P] (S : Finset σ) (E : σ → Finset T)
    (proj : T → P) (Pairs : Finset P) (hproj : ∀ s ∈ S, ∀ t ∈ E s, proj t ∈ Pairs) (L : ℕ)
    (hmult : ∀ p ∈ Pairs, ∑ s ∈ S, ((E s).filter fun t => proj t = p).card ≤ L) :
    ∑ s ∈ S, (E s).card ≤ L * Pairs.card := by
  calc ∑ s ∈ S, (E s).card =
        ∑ s ∈ S, ∑ p ∈ Pairs, ((E s).filter fun t => proj t = p).card :=
        Finset.sum_congr rfl fun s hs => Finset.card_eq_sum_card_fiberwise (hproj s hs)
    _ = ∑ p ∈ Pairs, ∑ s ∈ S, ((E s).filter fun t => proj t = p).card := Finset.sum_comm
    _ ≤ ∑ _p ∈ Pairs, L := Finset.sum_le_sum hmult
    _ = L * Pairs.card := by rw [Finset.sum_const, smul_eq_mul, mul_comm]

/-- Blueprint `eq:total-count`, second bound: at one scale, pair determination makes the pair
projection injective, so `N_s ≤ M_i M_j ≤ (M')²`. -/
theorem scale_count_le {T P : Type*} (E : Finset T) (proj : T → P) (Pairs : Finset P)
    (hproj : ∀ t ∈ E, proj t ∈ Pairs) (hinj : Set.InjOn proj E) : E.card ≤ Pairs.card :=
  Finset.card_le_card_of_injOn proj hproj hinj

/-- Blueprint lines 2722-2724 (side incidence by Parseval): if the triples incident to a fixed
core label at one scale have pairwise disjoint frequency windows, each carrying normalized
Fourier mass at least `σ²` of the side function on `I = (a, b]`, then their number `w` satisfies
`w σ² ≤ |I|⁻¹ ∫_I |S|²` (Parseval/Bessel on the interval). -/
theorem side_incidence_count {a b : ℝ} (hab : a < b) {f : ℝ → ℂ}
    (hf : MemLp f 2 (volume.restrict (Set.Ioc a b))) {ι : Type*} (Tr : Finset ι)
    (W : ι → Finset ℤ) (hdis : ∀ t ∈ Tr, ∀ t' ∈ Tr, t ≠ t' → Disjoint (W t) (W t')) {σ : ℝ}
    (hσ : ∀ t ∈ Tr, σ ^ 2 ≤ ∑ k ∈ W t, ‖fourierCoeffOn hab f k‖ ^ 2) :
    (Tr.card : ℝ) * σ ^ 2 ≤ (b - a)⁻¹ * ∫ x in a..b, ‖f x‖ ^ 2 := by
  classical
  have hP := hasSum_sq_fourierCoeffOn hab hf
  have hU : ∑ k ∈ Tr.biUnion W, ‖fourierCoeffOn hab f k‖ ^ 2 ≤
      (b - a)⁻¹ * ∫ x in a..b, ‖f x‖ ^ 2 := by
    have := sum_le_hasSum (Tr.biUnion W) (fun k _ => by positivity) hP
    simpa [smul_eq_mul] using this
  calc (Tr.card : ℝ) * σ ^ 2 = ∑ _t ∈ Tr, σ ^ 2 := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ ∑ t ∈ Tr, ∑ k ∈ W t, ‖fourierCoeffOn hab f k‖ ^ 2 := Finset.sum_le_sum hσ
    _ = ∑ k ∈ Tr.biUnion W, ‖fourierCoeffOn hab f k‖ ^ 2 :=
        (Finset.sum_biUnion fun t ht t' ht' hne => hdis t ht t' ht' hne).symm
    _ ≤ _ := hU

