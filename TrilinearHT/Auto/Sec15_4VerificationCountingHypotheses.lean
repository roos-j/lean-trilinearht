/-- The anchor entry constant `C_{J,A} μ ν^{-J}` is at most `C_{J,A}`. -/
theorem entryC_le_const {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (J A : ℕ) (b : ℝ) :
    entryC κ J A b ≤ kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * 2 ^ (A + 2) := by
  have hk := kerC_nonneg hr hw (J + (A + 2))
  have hν : 1 ≤ max 1 |b| := le_max_left _ _
  have h1 : min 1 |b| / max 1 |b| ^ J ≤ 1 :=
    div_le_one_of_le₀ ((min_le_left _ _).trans (one_le_pow₀ hν))
      (pow_nonneg (zero_le_one.trans hν) J)
  have hC : 0 ≤ kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) := by positivity
  unfold entryC
  calc kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * min 1 |b| / max 1 |b| ^ J * 2 ^ (A + 2)
      = kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * (min 1 |b| / max 1 |b| ^ J) *
          2 ^ (A + 2) := by ring
    _ ≤ kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * 1 * 2 ^ (A + 2) := by gcongr
    _ = _ := by ring

