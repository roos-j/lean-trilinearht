      have e : Cd.threePrin Td3 h' l a xs Bf X (∏ i ∈ Finset.univ.erase l, Gb i) =
          2 * Cd.shellCoef3 Td3 h' l a xs Bf X (Cd.beta3 h' l a xs Bf) *
            ∏ i ∈ Finset.univ.erase l, Gb i := by
        unfold threePrin; rw [ite_eq_left_of_eq_true _ _ (eq_true hP)]
      rw [e]
      have hP1 : ∏ i ∈ Finset.univ.erase l, min (Gb i) ((1 + cutTail Cd.z.dim Cd.δ Cd.Kt) *
          ∑ k ∈ sideOptF l F i, ‖D.c3 G I xs i k‖) ≤ ∏ i ∈ Finset.univ.erase l, Gb i :=
        Finset.prod_le_prod₀ (fun i _ => le_min (hGb i) (mul_nonneg (by linarith)
          (Finset.sum_nonneg fun _ _ => norm_nonneg _))) fun i _ => min_le_left _ _
      have hP2 : ∏ i ∈ Finset.univ.erase l, min (Gb i) ((1 + cutTail Cd.z.dim Cd.δ Cd.Kt) *
          ∑ k ∈ sideOptF l F i, ‖D.c3 G I xs i k‖) ≤ (1 + cutTail Cd.z.dim Cd.δ Cd.Kt) ^ 3 *
          ∏ j ∈ Finset.univ.erase l, ∑ m ∈ F j, ‖D.c j G (D.blockOf I.1) (D.preCell I) m.1‖ := by
        refine (Finset.prod_le_prod₀ (fun i _ => le_min (hGb i) (mul_nonneg (by linarith)
          (Finset.sum_nonneg fun _ _ => norm_nonneg _))) fun i _ => min_le_right _ _).trans
          (le_of_eq ?_)
        rw [Finset.prod_mul_distrib, Finset.prod_const,
          Finset.card_erase_of_mem (Finset.mem_univ l), Finset.card_univ, Fintype.card_fin]
        congr 1
        refine Finset.prod_congr rfl fun j hj => ?_
        rw [D.sum_norm_c3]
        exact ite_eq_right_iff.mpr fun h => absurd h (Finset.ne_of_mem_erase hj)
      have hPm0 : 0 ≤ ∏ i ∈ Finset.univ.erase l, min (Gb i)
          ((1 + cutTail Cd.z.dim Cd.δ Cd.Kt) * ∑ k ∈ sideOptF l F i, ‖D.c3 G I xs i k‖) :=
        Finset.prod_nonneg fun i _ => le_min (hGb i) (mul_nonneg (by linarith)
          (Finset.sum_nonneg fun _ _ => norm_nonneg _))
      have hsh0 : 0 ≤ Cd.shellCoef3 Td3 h' l a xs Bf X (Cd.beta3 h' l a xs Bf) := by
        rw [Cd.shellCoef3_eq]
        exact mul_nonneg (entryC_nonneg hr hw _ _ _) (Cd.shellU3_nonneg Td3 h' l a xs Bf X)
      have htl : Cd.tailCoef3 Td3 Bf X (Cd.beta3 h' l a xs Bf) ≤
          kerC κ' (Td3.J3 + (Td3.Aw + 2)) * (3 + 2) ^ (Td3.J3 + (Td3.Aw + 2)) *
            2 ^ (Td3.Aw + 2) * Cd.tailU3 Td3 Bf X := by
        rw [Cd.tailCoef3_eq]
        exact mul_le_mul_of_nonneg_right (entryC_le_const hr hw _ _ _)
          (Cd.tailU3_nonneg Td3 Bf X)
      have hCk0 : 0 ≤ kerC κ' (Td3.J3 + (Td3.Aw + 2)) * (3 + 2) ^ (Td3.J3 + (Td3.Aw + 2)) *
            2 ^ (Td3.Aw + 2) * Cd.tailU3 Td3 Bf X := by
        have := kerC_nonneg hr hw (Td3.J3 + (Td3.Aw + 2))
        have := Cd.tailU3_nonneg Td3 Bf X
        positivity
      have a1 := mul_le_mul_of_nonneg_left hP1 hsh0
      have a2 := mul_le_mul htl hP2 hPm0 hCk0
      have a3 := mul_le_mul_of_nonneg_right (le_max_left (Cd.err3 Td3 X
        (dyadicGridLength A.G I.1 * Cd.ε / (D.S.Q0 * ((6 ^ h' : ℕ) : ℝ)))
        (dyadicGridLength A.G I.1 * Cd.Λg / (D.S.Q0 * ((6 ^ h' : ℕ) : ℝ)) - Cd.U₀))
        (Cd.err3 Td3 X 0 Cd.U₀)) hS0
      have a4 := mul_nonneg hD3 hS0
      have hβ : D.refT3 G I l a xs + ∑ i, (Cd.refPick3 h' l a xs Bf i : ℝ) * D.xiH Cd.z h' i =
          Cd.beta3 h' l a xs Bf := rfl
      rw [hβ] at key
      refine key.trans ?_
      unfold threeConst
      linear_combination 2 * a1 + 2 * a2 + a3 + a4
    · have hP : ¬ Cd.passes3 h' l a xs Bf := fun h => hμ h.2
      have key := Cd.three_core_small_bound Td3 hK1 hI hh' l a F hF hxs Bf hBf hfull X hp
        (le_of_lt (not_le.mp hμ))
      have e : Cd.threePrin Td3 h' l a xs Bf X (∏ i ∈ Finset.univ.erase l, Gb i) = 0 := by
        unfold threePrin; rw [ite_eq_right_iff.mpr fun h => absurd h hP]
      rw [e, zero_add]
      refine key.trans ?_
      have a3 := mul_le_mul_of_nonneg_right (le_max_left (Cd.err3 Td3 X
        (dyadicGridLength A.G I.1 * Cd.ε / (D.S.Q0 * ((6 ^ h' : ℕ) : ℝ)))
        (dyadicGridLength A.G I.1 * Cd.Λg / (D.S.Q0 * ((6 ^ h' : ℕ) : ℝ)) - Cd.U₀))
        (Cd.err3 Td3 X 0 Cd.U₀)) hS0
      have a4 := mul_nonneg hT3 hS0
      unfold threeConst
      linear_combination a3 + a4
  · have hnoref : Cd.refSet3 h' l a xs Bf = ∅ := Finset.not_nonempty_iff_eq_empty.mp hR
    have hP : ¬ Cd.passes3 h' l a xs Bf := fun h => hR h.1
    have key := Cd.three_core_noref_bound Td3 hK1 hI hh' l a F hF hxs Bf hfull4 X hnoref
    have e : Cd.threePrin Td3 h' l a xs Bf X (∏ i ∈ Finset.univ.erase l, Gb i) = 0 := by
      unfold threePrin; rw [ite_eq_right_iff.mpr fun h => absurd h hP]
    rw [e, zero_add]
    refine key.trans (mul_le_mul_of_nonneg_right ?_ hS0)
    unfold threeConst
    exact (le_max_right _ _).trans ((le_add_of_nonneg_right hD3).trans
      (le_add_of_nonneg_right hT3))

