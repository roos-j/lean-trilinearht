          fun K => roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h
            (some K) ∧ D.coreCls G I h l (some K) = C) ^ 2 ≤
      2 * (2 * D.SP.δs) ^ (Finset.univ.filter fun i => a i = l).card *
