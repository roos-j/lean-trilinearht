theorem side_bin_three {h' : ℕ} (l : Fin 4) (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I))
    (xs : ℝ) (Bf Iw i : ℕ) (X : ColumnL2 (Fin ap.Mc)) (ζ : Fin Cd.z.dim → ℝ)
    (hζ : ∀ k, 36 * ζ k = D.xiH Cd.z h' k) (hb : 0 < Cd.bLam3 h' l a xs Bf Iw X i) :
    (dyadicGridLength A.G I.1) ^ 2 * ((2 : ℝ) ^ dyBin (Cd.bLam3 h' l a xs Bf Iw X i)) ^ 2 ≤
      ∫ ρ, sideWinE Cd.z l (augPhys X) (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1)
        (sideWindow ζ (dyadicGridLength A.G I.1) (2 ^ i) Bf (D.refγ3 G I xs l a)) ρ
          ∂offsetMeasure Cd.z.dim := by
  have hr := dyadicGridLength_pos A.G I.1
  have hX : Measurable (augPhys X) := columnPhys_measurable X
  have hXL : MemLp (augPhys X) 2 (volume.restrict (Set.Ioc (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1))) :=
    (memLp_column_coord X none).restrict _
  have hmono := integral_sideWinE_mono Cd.z l hX hr hXL
    (Cd.fullWin_subset_sideWindow l a xs Bf Iw i ζ hζ)
  have hE0 : 0 ≤ ∫ ρ', sideWinE Cd.z l (augPhys X) (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1) (Cd.fullWin h' l a xs Bf Iw i) ρ' ∂offsetMeasure Cd.z.dim :=
    integral_nonneg fun ρ => Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hd := dyBin_le hb
  have hd0 : (0 : ℝ) ≤ 2 ^ dyBin (Cd.bLam3 h' l a xs Bf Iw X i) := zpow_nonneg (by norm_num) _
  have hsq : (dyadicGridLength A.G I.1 * Cd.bLam3 h' l a xs Bf Iw X i) ^ 2 =
      ∫ ρ', sideWinE Cd.z l (augPhys X) (dyadicGridLeft A.G I.1 I.2)
        (dyadicGridLength A.G I.1) (Cd.fullWin h' l a xs Bf Iw i) ρ' ∂offsetMeasure Cd.z.dim := by
    unfold bLam3
