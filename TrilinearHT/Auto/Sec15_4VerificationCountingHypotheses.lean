/-- The absolute constant `C` of `three_core_sparse_count`. -/
noncomputable def sparseC3 : ℝ := Classical.choose three_core_sparse_count

/-- The absolute reserve constant `C_res` of `three_core_sparse_count`. -/
noncomputable def sparseCres3 : ℝ :=
  Classical.choose (Classical.choose_spec three_core_sparse_count)

theorem sparseC3_spec : 0 < sparseC3 ∧ 0 < sparseCres3 ∧
    ∀ (d : ℕ) (ζ : Fin d → ℝ) (l : Fin 4) (A : Fin 4 → Finset ℝ) (M L : ℝ), 1 ≤ M → 1 ≤ L →
    (∀ i, i ≠ l → ((A i).card : ℝ) ≤ M) →
    ∀ (B Sg Q μ ν R₀ : ℝ), 1 ≤ B → 0 < μ → μ ≤ 1 → 1 ≤ ν → 0 < R₀ →
    ∀ (S : Finset ℤ) (E : ℤ → Finset (Fin 4 → ℝ)),
    (∀ s ∈ S, ∀ x ∈ E s, (∀ i, i ≠ l → x i ∈ A i) ∧ x l = 0) →
    (∀ x, ((S.filter fun s => x ∈ E s).card : ℝ) ≤ L) →
    (∃ w : ℤ → ℝ, (∀ s, 0 ≤ w s) ∧ ∑ s ∈ S, w s ≤ M ∧
      ∀ s ∈ S, ∀ i, i ≠ l → ∀ a, (((E s).filter fun x => x i = a).card : ℝ) ≤ w s) →
    (∀ s ∈ S, ∀ x ∈ E s, ThreeRef ζ l B μ ν (R₀ * 2 ^ s) x) →
    (∀ i, ∀ s ∈ S, ∀ s' ∈ S, ∀ x ∈ E s, ∀ x' ∈ E s', x i ≠ x' i →
      ∀ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
        Sg * max (R₀ * 2 ^ s) (R₀ * 2 ^ s') < |x i - x' i + ∑ k, (n k : ℝ) * ζ k|) →
    (∀ s ∈ S, (E s).Nonempty → ∀ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
      |∑ k, (n k : ℝ) * ζ k| ∉ Set.Icc (μ * (R₀ * 2 ^ s) / 1000) (1000 * ν * (R₀ * 2 ^ s))) →
    sparseCres3 * ((d : ℝ) + 1) ^ 2 * B ≤ Q → 72 * B ≤ Q →
    sparseCres3 * ((d : ℝ) + 1) ^ 2 * ν ≤ Sg → 2 * ν ≤ Sg →
    ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ S.filter (fun s => ((E s).card : ℝ) ≤ δ * M ^ 2), ((E s).card : ℝ) ≤
        sparseC3 * (1 + Real.logb 2 (2 + ((d : ℝ) + 1) ^ 2 * ν / μ)) * L ^ 12 *
          δ ^ (1 / 300 : ℝ) * M ^ 2 :=
  Classical.choose_spec (Classical.choose_spec three_core_sparse_count)

/-- The tested-tuple multiplicity `L₀` of `tested_scale_mult` for three cores. -/
noncomputable def threeMult (d : ℕ) (B μ ν : ℝ) : ℝ :=
  32 * ((4 + d : ℕ) + 1 : ℝ) ^ 4 * (Real.log (2 * (36 * B)) + Real.log (2 * ν / μ))

theorem one_le_threeMult (d : ℕ) {B μ ν : ℝ} (hB : 1 ≤ B) (hμ : 0 < μ) (hμν : μ ≤ ν) :
    1 ≤ threeMult d B μ ν := by
  unfold threeMult
  have h1 : (1 : ℝ) ≤ ((4 + d : ℕ) + 1 : ℝ) := by
    have : (0 : ℝ) ≤ ((4 + d : ℕ) : ℝ) := Nat.cast_nonneg _
    linarith
  have h2 : (1 : ℝ) ≤ ((4 + d : ℕ) + 1 : ℝ) ^ 4 := one_le_pow₀ h1
  have h3 : 1 ≤ Real.log (2 * (36 * B)) := by
    rw [Real.le_log_iff_exp_le (by positivity)]
    have := Real.exp_one_lt_d9
    nlinarith
  have h4 : 0 ≤ Real.log (2 * ν / μ) :=
    Real.log_nonneg (by rw [le_div_iff₀ hμ]; nlinarith)
  nlinarith

