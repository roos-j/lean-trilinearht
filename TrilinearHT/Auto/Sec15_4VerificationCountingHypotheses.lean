theorem three_core_noref_bound (Td3 : Cd.ThreeData) (hK1 : 1 ≤ D.S.K) (hI : I ∈ A.cells)
    {h' : ℕ} (hh' : h' ≤ D.SP.Jst) (l : Fin 4)
