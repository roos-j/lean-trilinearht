namespace LeafSplit
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

/-- The absolute coefficient sum of a component index (`0` for the dummy index). -/
noncomputable def optAbs (G : A.Grp) (I : ℤ × ℤ) (l : Fin 4)
    (o : Option (Finset (D.Ms l G).Md)) : ℝ :=
  match o with
  | some K => ∑ m ∈ K, ‖D.c l G (D.blockOf I.1) (D.preCell I) m‖
  | none => 0

open Classical in
/-- The alive modes of a family of components of a slot on the pre-cell of `I`. -/
noncomputable def selAlive (G : A.Grp) (I : ℤ × ℤ) (l : Fin 4) (M : Finset (Finset (D.Ms l G).Md)) :
    Finset ((D.Ms l G).alive (D.decCell I)) :=
  Finset.univ.filter fun x => x.1 ∈ M.biUnion id

open Classical in
/-- The modes of the core components of a block on its pre-cell are alive at the decision cell,
so the alive selection of a family of core components has exactly their union as its values. -/
theorem image_selAlive (G : A.Grp) (I : ℤ × ℤ) (l : Fin 4) {M : Finset (Finset (D.Ms l G).Md)}
    (hM : M ⊆ (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) :
    (D.selAlive G I l M).image Subtype.val = M.biUnion id := by
  ext m
  simp only [selAlive, Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨x, hx, rfl⟩; exact hx
  · intro hm
    obtain ⟨K, hK, hmK⟩ := Finset.mem_biUnion.mp hm
    obtain ⟨hall, -⟩ := Finset.mem_sdiff.mp (hM hK)
    obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hall
    obtain ⟨z, -, rfl⟩ := Finset.mem_map.mp hmK
    exact ⟨z, hm, rfl⟩

end LeafSplit

namespace LeafSplit
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  {D : ap.LeafSplit}

namespace CellCoreData
variable {I : ℤ × ℤ} {G : A.Grp} (Cd : D.CellCoreData I G)

open Classical in
/-- The torus-size hypothesis of the four-core history bound: for every family of selected core
components `M_l`, every choice of representatives `a` and every torus form of the selected modes
(as in `four_core_tuple_bound`), the truncated torus inputs have `L²(𝓗)` norms at most `G_l(M_l)`
(blueprint `eq:torus-size`). -/
def TorusSizeBound (h' : ℕ) (xs : ℝ) (Gsz : ∀ l, Finset (Finset (D.Ms l G).Md) → ℝ) : Prop :=
  ∀ (M : ∀ l, Finset (Finset (D.Ms l G).Md)) (a : ∀ j, (D.Ms j G).alive (D.decCell I)),
    (∀ l, M l ⊆ (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) →
    ∀ (ρ' : Fin 4 → Fin Cd.z.dim → ℝ)
      (n : ∀ j, (D.Ms j G).alive (D.decCell I) → Fin Cd.z.dim → ℤ)
      (cc : Fin 4 → (Fin Cd.z.dim → ℤ) → ℂ), (∀ j k, ρ' j k ∈ Set.Icc (0 : ℝ) 1) →
      (∀ j, ∀ m ∈ D.selAlive G I j (M j), ∀ i, |(n j m i : ℝ)| ≤
        Fintype.card ((D.Ms j G).alive (D.decCell I)) * D.S.Eh h') →
      (∀ j, ∀ y ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
          (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1),
        ‖∑ m ∈ D.selAlive G I j (M j), D.c j G (D.blockOf I.1) (D.preCell I) m.1 *
            (D.Ms j G).wave m.1 y -
          ((centerCut Cd.z Cd.δ (ρ' j) y : ℂ) * (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) *
            centerPhase Cd.z (ρ' j) y) : ℂ)) *
          ((Real.fourierChar ((D.Ms j G).slope (a j).1 xs * (y - xs)) : ℂ) *
            ∑ m ∈ D.selAlive G I j (M j), D.selC j G I xs m *
              torusCharacter (n j m) (torusMk fun i => D.xiH Cd.z h' i * (y - xs)))‖ ≤
          2 * Real.pi * (Cd.Bc * D.S.Ξ * (2 : ℝ)⁻¹ ^ (2 * D.S.K) +
            Cd.Λ * (2 : ℝ)⁻¹ ^ (8 * D.S.K)) *
            ∑ m ∈ D.selAlive G I j (M j), ‖D.selC j G I xs m‖) →
      (∀ j v, ‖cc j v‖ ≤ 1) →
      (∀ j u, ‖∑ v ∈ frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1)), cc j v *
        torusCharacter (((D.S.Q0 * 6 ^ h' : ℕ) : ℤ) • v) u‖ ≤
          1 + cutTail Cd.z.dim Cd.δ Cd.Kt) →
      (∀ j y, ‖∑ v ∈ frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1)), cc j v *
        torusCharacter (((D.S.Q0 * 6 ^ h' : ℕ) : ℤ) • v)
          (torusMk fun i => D.xiH Cd.z h' i * (y - xs)) -
        (centerCut Cd.z Cd.δ (ρ' j) y : ℂ)‖ ≤ cutTail Cd.z.dim Cd.δ Cd.Kt) →
      ∀ j, (eLpNorm (fun u : torusAnnihilator
          (rationalIntegerIntersection (tinySpan Cd.z.θ Cd.Hh Cd.ε)) =>
        coreG (D.S.Q0 * 6 ^ h') (2 ^ (Cd.Kt + 1)) (fun j => D.selAlive G I j (M j))
          (fun j => D.selC j G I xs) n cc j u) 2
          (torusAnnihilatorHaar (rationalIntegerIntersection
            (tinySpan Cd.z.θ Cd.Hh Cd.ε)))).toReal ≤ Gsz j (M j)

open Classical in
/-- Blueprint lines 2466-2569 for one failure history of the four-core pattern on an attempt leaf
cell: for an assignment `a`, a word `w` of failed heights, a final height `h` and a tuple `p` of
final classes, the form of the masked slot sums of the class tuple is at most the principal
quantity of the four-core test of the class representatives (torus height `h - Δ`, torus sizes
`G(M_l)` of the selected component families `M_l`) plus the absolute error times the coefficient
products of the member component tuples (`four_core_tuple_bound`). -/
theorem four_core_history_bound (hK1 : 1 ≤ D.S.K) (hI : I ∈ A.cells) {n : ℕ}
    (a : Fin n → Fin 4) (w : Fin n → ℕ) {h : ℕ} (hh : h - D.SP.Δ ≤ D.SP.Jst)
    (aRep : ∀ l, Finset (D.Ms l G).Md → (D.Ms l G).alive (D.decCell I))
    (haRep : ∀ l, ∀ K ∈ (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I),
      D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l h (some K) →
      ∀ x : (D.Ms l G).alive (D.decCell I), x.1 ∈ K →
        x ∈ ((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).E (h - D.SP.Δ)
          (aRep l ((D.Ms l G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h K)))
    {xs : ℝ} (hxs : xs ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1)) (Bf : ℕ)
    (hBf : (Bf : ℝ) ≤ Cd.Bp)
    (hfull : ((6 ^ (h - D.SP.Δ) : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) + 4 * (3 *
      (((D.S.Q0 * 6 ^ (h - D.SP.Δ) : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) + Cd.Nb)) ≤ Bf)
    (Gsz : ∀ l, Finset (Finset (D.Ms l G).Md) → ℝ)
    (hGsz : Cd.TorusSizeBound (h - D.SP.Δ) xs Gsz) (s e : Fin 4 → ColumnL2 (Fin ap.Mc))
    (p : ∀ l, Finset (D.Ms l G).Md) :
    ‖ap.Λc I (fun l => ∑ o ∈ ((compIdx (fun _ => 0)
        (fun l => (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) l).filter
          (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h)).filter
          (fun o => D.coreCls G I h l o = p l),
        slotVal (fun _ => 0) (fun l K => D.compSub l G I (D.preCell I) K) s e l o)‖ ≤
      Cd.fourPrin (h - D.SP.Δ) (fun l => aRep l (p l)) xs Bf
        (∏ l, Gsz l (((D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)).filter
          fun K => roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h
            (some K) ∧ D.coreCls G I h l (some K) = p l)) +
      Cd.tupleConst (h - D.SP.Δ) *
        ∑ r ∈ (Fintype.piFinset fun l => (compIdx (fun _ => 0)
          (fun l => (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) l).filter
          (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h)).filter
          (fun r => ∀ l, D.coreCls G I h l (r l) = p l), ∏ l, D.optAbs G I l (r l) := by
  set Ks : ∀ l, Finset (Finset (D.Ms l G).Md) := fun l =>
    (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I) with hKs
  set Mk : ∀ l, Finset (Finset (D.Ms l G).Md) := fun l => (Ks l).filter fun K =>
    roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h (some K) ∧
      D.coreCls G I h l (some K) = p l with hMk
  have hMkKs : ∀ l, Mk l ⊆ Ks l := fun l => Finset.filter_subset _ _
  have hdis : ∀ l, Set.PairwiseDisjoint (Mk l : Set (Finset (D.Ms l G).Md)) id := fun l =>
    ((D.Ms l G).coreComps_pairwiseDisjoint D.S D.hA D.SP _ _).subset
      (Finset.coe_subset.mpr (hMkKs l))
  -- the grouped slot sums are the subtotals of the selected modes
  have hslot : (fun l => ∑ o ∈ ((compIdx (fun _ => 0) Ks l).filter
        (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h)).filter
        (fun o => D.coreCls G I h l o = p l),
        slotVal (fun _ => 0) (fun l K => D.compSub l G I (D.preCell I) K) s e l o) =
      fun l => D.compSub l G I (D.preCell I) ((D.selAlive G I l (Mk l)).image Subtype.val) := by
    funext l
    rw [slot_sum_core (fun _ => 0) Ks _ s e (l := l) rfl, D.image_selAlive G I l (hMkKs l)]
    exact D.sum_compSub l G I (D.preCell I) (Mk l) id (hdis l)
  rw [hslot]
  -- the selected modes lie in the predecessor of the class representative
  have hF : ∀ l, D.selAlive G I l (Mk l) ⊆
      ((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).E (h - D.SP.Δ)
        (aRep l (p l)) := by
    intro l x hx
    obtain ⟨K, hK, hxK⟩ := Finset.mem_biUnion.mp (Finset.mem_filter.mp hx).2
    obtain ⟨hKs, hmask, hcls⟩ := Finset.mem_filter.mp hK
    have := haRep l K hKs hmask.1 x hxK
    have hc : (D.Ms l G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h K = p l := hcls
    rwa [hc] at this
  have key := Cd.four_core_tuple_bound hK1 hI hh (fun l => aRep l (p l))
    (fun l => D.selAlive G I l (Mk l)) hF hxs Bf hBf hfull (fun l => Gsz l (Mk l))
    (hGsz Mk (fun l => aRep l (p l)) hMkKs)
  refine key.trans (le_of_eq ?_)
  congr 2
  -- the coefficient products of the selected modes are the member-tuple sums
  have hsum : ∀ l, ∑ m ∈ D.selAlive G I l (Mk l),
      ‖D.c l G (D.blockOf I.1) (D.preCell I) m.1‖ =
      ∑ o ∈ (Mk l).map Function.Embedding.some, D.optAbs G I l o := by
    intro l
    rw [← Finset.sum_image (f := fun m => ‖D.c l G (D.blockOf I.1) (D.preCell I) m‖)
      (fun x _ y _ hxy => Subtype.val_injective hxy), D.image_selAlive G I l (hMkKs l),
      Finset.sum_biUnion (hdis l), Finset.sum_map]
    rfl
  have hmem : (Fintype.piFinset fun l => (compIdx (fun _ => 0) Ks l).filter
      (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h)).filter
      (fun r => ∀ l, D.coreCls G I h l (r l) = p l) =
      Fintype.piFinset fun l => (Mk l).map Function.Embedding.some := by
    ext r
    simp only [Finset.mem_filter, Fintype.mem_piFinset, compIdx, ↓reduceIte, Finset.mem_map,
      Function.Embedding.some_apply, hMk]
    constructor
    · rintro ⟨h1, h2⟩ l
      obtain ⟨⟨K, hK, hKr⟩, hm⟩ := h1 l
      refine ⟨K, ⟨hK, ?_, ?_⟩, hKr⟩
      · rw [hKr]; exact hm
      · rw [hKr]; exact h2 l
    · intro hr
      refine ⟨fun l => ?_, fun l => ?_⟩
      · obtain ⟨K, ⟨hK, hm, -⟩, hKr⟩ := hr l
        exact ⟨⟨K, hK, hKr⟩, hKr ▸ hm⟩
