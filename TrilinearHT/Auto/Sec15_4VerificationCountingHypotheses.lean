theorem Valid.sparse_reserve (hV : S.Valid Cj CA CT CK δs W) (hCA : 1 ≤ CA) (hd2 : 2 ≤ S.dmax)
    (hD : 2 ≤ S.Dstar) (hB : 2 ≤ S.Bstar) {h : ℕ} (hh : 10 ≤ h) :
    7200000 * ((S.dmax : ℝ) + 1) ^ 2 * 4 * 6 ^ 8 * S.Dstar ^ 5 * S.Eh (h - 10) ≤ S.Eh h := by
