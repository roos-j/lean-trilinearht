/-- Representatives in the PRE predecessors of modes of different CURRENT components at `h`
differ (`E_{h-Δ} ⊆ F_{h-Δ} ⊆ F_h`). -/
theorem pred_ne_of_F_ne {Δ h : ℕ} {m m' a a' : Mode} (ha : a ∈ C.E (h - Δ) m)
    (ha' : a' ∈ C.E (h - Δ) m') (hF : C.F h m ≠ C.F h m') : a ≠ a' := by
  rintro rfl
  have h1 : a ∈ C.F h m := C.F_mono (h - Δ) h m (Nat.sub_le _ _) (C.E_le_F _ m ha)
  have h2 : a ∈ C.F h m' := C.F_mono (h - Δ) h m' (Nat.sub_le _ _) (C.E_le_F _ m' ha')
  exact hF ((C.F_comp h m a h1).symm.trans (C.F_comp h m' a h2))

