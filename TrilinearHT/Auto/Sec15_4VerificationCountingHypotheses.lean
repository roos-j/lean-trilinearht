theorem gsz_role (Td : Cd.TorusData) (hK1 : 1 ≤ D.S.K) {h' : ℕ}
    (hh' : h' ≤ D.SP.Jst) {xs : ℝ} (hxs : xs ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
