  {D : ap.LeafSplit}

namespace CellCoreData
variable {I : ℤ × ℤ} {G : A.Grp} (Cd : D.CellCoreData I G)

open Classical in
/-- Blueprint `eq:size-comparison` (lines 2196-2209) for a final class `C` on the cell: with the
full subtotal `T_F`, its linear side `V_F` (`T_F - V_F = Σ_D A_D` over the units of the class) and
`‖P_{F,I} Z̃ - T_F‖ ≤ ε_c`, the class size obeys
`σ_C² ≤ (2/|I|) (12 (‖P_{F,I} Z̃‖² + ε_c² + ‖V_F‖²) + 2 η_f)`, where `η_f` bounds the squared
floors `(|I|/2)^{1/2} (σ_D - (2/|I|)^{1/2} ‖A_D‖)` of the units. -/
theorem classSigma_sq_le (Td : Cd.TorusData) (hK1 : 1 ≤ D.S.K) (j : Fin 4) (h : ℕ)
    (C : Finset (D.Ms j G).Md)
    (hκ2 : pairConst Cd.z.dim Cd.δ D.S.Ξ Td.Kf * Td.Dn ^ 3 ≤ 1 / 2) {ηf εc : ℝ} (hεc : 0 ≤ εc)
    (hy : ∑ i ∈ classUnits (I := I) j h C,
      (Real.sqrt (dyadicGridLength A.G I.1 / 2) *
        (Cd.unitSize Td j (unitPart (I := I) j (classComps (I := I) j h C) i) -
          Real.sqrt (2 / dyadicGridLength A.G I.1) *
            ‖∑ m ∈ unitPart (I := I) j (classComps (I := I) j h C) i,
              D.c j G (D.blockOf I.1) (D.preCell I) m • (D.Ms j G).cellMode I m‖)) ^ 2 ≤ ηf)
    {TF VF PZ : ColumnL2 (D.Ms j G).Md}
    (hT : TF - VF = ∑ i ∈ classUnits (I := I) j h C,
      ∑ m ∈ unitPart (I := I) j (classComps (I := I) j h C) i,
        D.c j G (D.blockOf I.1) (D.preCell I) m • (D.Ms j G).cellMode I m)
    (hclose : ‖PZ - TF‖ ≤ εc) :
    Cd.classSigma Td j h C ^ 2 ≤
      2 / dyadicGridLength A.G I.1 * (12 * (‖PZ‖ ^ 2 + εc ^ 2 + ‖VF‖ ^ 2) + 2 * ηf) := by
  have hr := dyadicGridLength_pos A.G I.1
  have hMj : classComps (I := I) j h C ⊆
      (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I) :=
    Finset.filter_subset _ _
  set r := dyadicGridLength A.G I.1 with hrdef
  set s := classUnits (I := I) j h C
  set U := unitPart (I := I) j (classComps (I := I) j h C)
  set a : Finset (D.Ms j G).Md → ℝ := fun i =>
    ‖∑ m ∈ U i, D.c j G (D.blockOf I.1) (D.preCell I) m • (D.Ms j G).cellMode I m‖
  set y : Finset (D.Ms j G).Md → ℝ := fun i =>
    Real.sqrt (r / 2) * (Cd.unitSize Td j (U i) - Real.sqrt (2 / r) * a i)
  have hsq : Real.sqrt (2 / r) * Real.sqrt (r / 2) = 1 := by
    rw [← Real.sqrt_mul (by positivity)]
    rw [show 2 / r * (r / 2) = 1 by field_simp]
    exact Real.sqrt_one
  have hunit : ∀ i, Cd.unitSize Td j (U i) = Real.sqrt (2 / r) * (a i + y i) := fun i => by
    simp only [y]
    rw [mul_add, ← mul_assoc, hsq, one_mul]
    ring
  have hδj : 0 < (D.Ms j G).δc := by rw [Cd.hδc j]; exact Cd.hδ
  have hκj : pairConst Cd.z.dim (D.Ms j G).δc D.S.Ξ Td.Kf * Td.Dn ^ 3 ≤ 1 / 2 := by
    rw [Cd.hδc j]; exact hκ2
  have halive : ∀ i ∈ s, ∀ m ∈ U i, dyadicGridCell A.G I.1 I.2 ⊆
      dyadicGridCell A.G ((D.Ms j G).cellOf m).1 ((D.Ms j G).cellOf m).2 := by
    intro i _ m hm
    obtain ⟨K, hK, hmK⟩ := Finset.mem_biUnion.mp hm
    exact cell_subset_cellOf (I := I) hK1 j (hMj (Finset.mem_filter.mp hK).1) hmK
  have hs_sub : s ⊆ ((D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)).image
      ((D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) 0) :=
    Finset.image_subset_image hMj
  have hscard : (s.card : ℝ) ≤ Td.Dn :=
    ((Nat.cast_le.mpr (Finset.card_le_card hs_sub)).trans (Td.hnum j)).trans (min_le_left _ _)
  have hcardc : ∀ i ∈ s, ((U i).card : ℝ) ≤ Td.εw * Td.Dn ^ 2 := by
    intro i hi
    obtain ⟨K, hKM, rfl⟩ := Finset.mem_image.mp hi
