/-- The value of a dyadic bin `(a, b, k)` of `(μ, ν, σ)`: the bound
`C_J W 2^{a+1} 2^{-bJ} Π_j 2^{k_j + 1}` of `eq:principal-core`. -/
noncomputable def binVal (J : ℕ) (c : ℤ × ℤ × (Fin 4 → ℤ)) : ℝ :=
  fourKC κ' J * Cd.W * (2 * (2 : ℝ) ^ c.1) * (((2 : ℝ) ^ c.2.1) ^ J)⁻¹ *
    ∏ j, (2 * (2 : ℝ) ^ c.2.2 j)

/-- The dyadic bin `(⌊log₂ μ⌋, ⌊log₂ ν⌋, ⌊log₂ σ_j⌋)` of a tested four-core tuple. -/
noncomputable def fourBin (h' : ℕ) (a : ∀ j, (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (σ : Fin 4 → ℝ) : ℤ × ℤ × (Fin 4 → ℤ) :=
  (dyBin (fourMu (dyadicGridLength A.G I.1) (Cd.refQ' h' a xs Bf) (Cd.refT' h' a xs Bf)),
    dyBin (fourNu (dyadicGridLength A.G I.1) (Cd.refQ' h' a xs Bf) (Cd.refT' h' a xs Bf)),
    fun j => dyBin (σ j))

open Classical in
/-- Blueprint lines 2576-2582 (`eq:principal-core`) on the attempt leaf cell: the principal
quantity of one final height, `Σ_p c_p Π_j σ_{p,j}` over the tuples of final classes, is at most
the sum over the occupied dyadic bins `(μ, ν, σ)` of the bin value `C_J W μ ν^{-J} Π_j σ_j` times
the number `N` of tested (passing) tuples in the bin (`fourK_mu_nu`, `sum_by_bins`). -/
theorem four_core_binned (hI : I ∈ A.cells) (J : ℕ) {h' : ℕ} {ι : Type*} (T : Finset ι)
    (aR : ι → ∀ j, (D.Ms j G).alive (D.decCell I)) (σ : ι → Fin 4 → ℝ)
    (hσ : ∀ p ∈ T, ∀ j, 0 ≤ σ p j) (xs : ℝ) (Bf : ℕ) :
    ∑ p ∈ T, Cd.fourCf h' (aR p) xs Bf * ∏ j, σ p j ≤
      ∑ c ∈ (T.filter fun p => Cd.passes h' (aR p) xs Bf).image
          (fun p => Cd.fourBin h' (aR p) xs Bf (σ p)),
        Cd.binVal J c * (((T.filter fun p => Cd.passes h' (aR p) xs Bf).filter fun p =>
          Cd.fourBin h' (aR p) xs Bf (σ p) = c).card : ℝ) := by
  have hr := dyadicGridLength_pos A.G I.1
  have hw := A.adm I hI
  have hzero : ∑ p ∈ T, Cd.fourCf h' (aR p) xs Bf * ∏ j, σ p j =
      ∑ p ∈ T.filter (fun p => Cd.passes h' (aR p) xs Bf),
        Cd.fourCf h' (aR p) xs Bf * ∏ j, σ p j := by
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun p _ => ?_
    split_ifs with hP
    · rfl
    · unfold fourCf; rw [ite_eq_right_iff.mpr fun h => absurd h hP, zero_mul]
  rw [hzero]
  refine sum_by_bins (T.filter fun p => Cd.passes h' (aR p) xs Bf)
    (fun p => Cd.fourBin h' (aR p) xs Bf (σ p)) (Cd.binVal J)
    (fun p => Cd.fourCf h' (aR p) xs Bf * ∏ j, σ p j) fun p hp => ?_
  obtain ⟨hpT, hP⟩ := Finset.mem_filter.mp hp
  set μ := fourMu (dyadicGridLength A.G I.1) (Cd.refQ' h' (aR p) xs Bf) (Cd.refT' h' (aR p) xs Bf)
  set ν := fourNu (dyadicGridLength A.G I.1) (Cd.refQ' h' (aR p) xs Bf) (Cd.refT' h' (aR p) xs Bf)
  have hμ : 0 < μ := lt_of_lt_of_le (inv_pos.mpr Cd.hU₀) hP.2
  have hν : 1 ≤ ν := one_le_fourNu _ _ _
  have hK := fourK_mu_nu hr hw J xs (Cd.refQ' h' (aR p) xs Bf) (Cd.refT' h' (aR p) xs Bf)
  change ‖_‖ * ν ^ J ≤ fourKC κ' J * μ at hK
  have hcf : Cd.fourCf h' (aR p) xs Bf ≤ fourKC κ' J * μ * (ν ^ J)⁻¹ * Cd.W := by
    unfold fourCf
    rw [ite_eq_left_of_eq_true _ _ (eq_true hP)]
    have hνJ : 0 < ν ^ J := pow_pos (by linarith) J
    have : ‖fourK (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) xs
        (Cd.refQ' h' (aR p) xs Bf) (Cd.refT' h' (aR p) xs Bf)‖ ≤ fourKC κ' J * μ * (ν ^ J)⁻¹ := by
      rw [← div_eq_mul_inv, le_div_iff₀ hνJ]; exact hK
    exact mul_le_mul_of_nonneg_right this Cd.hW
  have hKC : 0 ≤ fourKC κ' J := by
    have := kernelDerivBound_nonneg κ' 0
    have := kernelDerivBound_nonneg κ' J
    unfold fourKC; positivity
  have hP0 : 0 ≤ ∏ j, σ p j := Finset.prod_nonneg fun j _ => hσ p hpT j
  have hμb : μ ≤ 2 * (2 : ℝ) ^ dyBin μ := le_two_mul_dyBin μ
  have hνb : ((2 : ℝ) ^ dyBin ν) ^ J ≤ ν ^ J :=
    pow_le_pow_left₀ (zpow_nonneg (by norm_num) _) (dyBin_le (by linarith)) J
  have hνi : (ν ^ J)⁻¹ ≤ (((2 : ℝ) ^ dyBin ν) ^ J)⁻¹ :=
    inv_anti₀ (pow_pos (zpow_pos (by norm_num) _) J) hνb
  have hσb : ∏ j, σ p j ≤ ∏ j, (2 * (2 : ℝ) ^ dyBin (σ p j)) :=
    Finset.prod_le_prod₀ (fun j _ => hσ p hpT j) fun j _ => le_two_mul_dyBin (σ p j)
  unfold binVal fourBin
  calc Cd.fourCf h' (aR p) xs Bf * ∏ j, σ p j
      ≤ fourKC κ' J * μ * (ν ^ J)⁻¹ * Cd.W * ∏ j, σ p j :=
        mul_le_mul_of_nonneg_right hcf hP0
    _ ≤ fourKC κ' J * (2 * (2 : ℝ) ^ dyBin μ) * (((2 : ℝ) ^ dyBin ν) ^ J)⁻¹ * Cd.W *
        ∏ j, (2 * (2 : ℝ) ^ dyBin (σ p j)) := by
        have h1 : 0 ≤ (ν ^ J)⁻¹ := inv_nonneg.mpr (pow_nonneg (by linarith) J)
        have hW := Cd.hW
        gcongr
    _ = _ := by ring

