    rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ l),
      Finset.card_univ, Fintype.card_fin]
    congr 1
    refine Finset.prod_congr rfl fun j hj => ?_
    rw [D.sum_norm_c3]
    exact ite_eq_right_iff.mpr fun h => absurd h (Finset.ne_of_mem_erase hj)
  rw [hP] at key
  have hE := entryC_discard hr hw (show 1 ≤ Td3.J3 by have := Td3.hJ3; omega) Td3.Aw hU
    (b := dyadicGridLength A.G I.1 * (D.refT3 G I l a xs + ∑ i, (m₀ i : ℝ) * D.xiH Cd.z h' i))
    (Or.inl (by rw [abs_mul, abs_of_pos hr]; exact hsmall))
