theorem passes_threeRef_bin {h' : ℕ} (Td3 : Cd.ThreeData) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
