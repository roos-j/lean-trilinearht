theorem fullWin_subset_sideWindow {h' : ℕ} (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf Iw i : ℕ)
    (ζ : Fin Cd.z.dim → ℝ) (hζ : ∀ k, 36 * ζ k = D.xiH Cd.z h' k) :
    Cd.fullWin h' l a xs Bf Iw i ⊆
      sideWindow ζ (dyadicGridLength A.G I.1) (2 ^ i) Bf (D.refγ3 G I xs l a) := by
  intro k hk
  obtain ⟨-, n, hn, hkn⟩ := Finset.mem_filter.mp hk
  refine mem_sideWindow.mpr ⟨n, fun p => abs_le_of_mem_frequencyBox hn p, ?_⟩
  have e : 36 * ∑ p, (n p : ℝ) * ζ p = ∑ p, (n p : ℝ) * D.xiH Cd.z h' p := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [← hζ p]; ring
  rw [e, ← sub_eq_add_neg] at *
  have : (0 : ℝ) ≤ 2 ^ i := by positivity
  linarith [hkn]

/-- Blueprint lines 2724-2728 (the side bin of a tested three-core tuple): a positive side window
