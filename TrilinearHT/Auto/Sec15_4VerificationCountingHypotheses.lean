open Classical in
/-- The principal shell coefficient of a three-core tuple with anchored reference frequency `β`
(blueprint `eq:side-windows`): `Σ_{Λ = 2^i ≤ 2^{I_w}} C μ ν^{-J} Λ^{-(A+1)} W |B| b_Λ` with the side
window energies `b_Λ = r⁻¹ (E_ρ Σ_{k ∈ W_Λ} |Ŝ'_ρ(k)|²)^{1/2}` over the full-box windows. -/
noncomputable def shellCoef3 (Td3 : Cd.ThreeData) (h' : ℕ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (X : ColumnL2 (Fin ap.Mc)) (β : ℝ) : ℝ :=
  ∑ i ∈ Finset.range (Td3.Iw + 1), (dyadicGridLength A.G I.1)⁻¹ *
      entryC κ' Td3.J3 Td3.Aw (dyadicGridLength A.G I.1 * β) * 2 ^ (Td3.Aw + 4) *
      ((2 : ℝ) ^ i)⁻¹ ^ (Td3.Aw + 1) * (Cd.W * (frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1))).card) *
    Real.sqrt (∫ ρ', sideWinE Cd.z l (augPhys X) (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1) (Cd.fullWin h' l a xs Bf Td3.Iw i) ρ' ∂offsetMeasure Cd.z.dim)

/-- The coefficient of the shells above `I_w` (blueprint line 2562, "shells above `U₀` are
negligible by the same estimate or ordinary `L²` pairing"). -/
noncomputable def tailCoef3 (Td3 : Cd.ThreeData) (Bf : ℕ) (X : ColumnL2 (Fin ap.Mc)) (β : ℝ) :
    ℝ :=
  (dyadicGridLength A.G I.1)⁻¹ * entryC κ' Td3.J3 Td3.Aw (dyadicGridLength A.G I.1 * β) *
      ((2 : ℝ) ^ Td3.Iw)⁻¹ ^ (Td3.Aw + 2) *
    ((Real.sqrt (frequencyBox Cd.z.dim Bf).card *
        (Cd.W * (frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1))).card)) *
      (Real.sqrt ((frequencyBox Cd.z.dim Bf).card * (2 * 2 ^ Td3.Iw + 1)) *
        Real.sqrt (dyadicGridLength A.G I.1 * ∫ y in (dyadicGridLeft A.G I.1 I.2)..
          dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1, ‖augPhys X y‖ ^ 2))) +
  12 * ((dyadicGridLength A.G I.1)⁻¹ *
      entryC κ' Td3.J3 Td3.Aw (dyadicGridLength A.G I.1 * β) * ((2 : ℝ) ^ Td3.Iw)⁻¹ ^ Td3.Aw) *
    (∫ y in Set.Ico (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1), ‖augPhys X y‖) *
    (Real.sqrt (frequencyBox Cd.z.dim Bf).card *
      (Cd.W * (frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1))).card))

/-- The absolute numerical and coset error constant of a three-core tuple, with the side size as an
extra factor (blueprint `eq:core-numerical`). -/
noncomputable def err3 (Td3 : Cd.ThreeData) (X : ColumnL2 (Fin ap.Mc)) (ε₁ H : ℝ) : ℝ :=
  2 * (2 * localKernelSupBound κ' * (4 * (2 * Real.pi * (Cd.Bc * D.S.Ξ *
      (2 : ℝ)⁻¹ ^ (2 * D.S.K) + Cd.Λ * (2 : ℝ)⁻¹ ^ (8 * D.S.K))) +
      (8 * Cd.z.dim * Cd.δ'' * profR Cd.δ 1 +
      4 * (1 + cutTail Cd.z.dim Cd.δ Cd.Kt) ^ 3 * cutTail Cd.z.dim Cd.δ Cd.Kt +
      (1 + cutTail Cd.z.dim Cd.δ Cd.Kt) ^ 4 * multTail Cd.z.dim Cd.δ'' D.S.Q0 Cd.Cm Cd.Kt)) *
    ((dyadicGridLength A.G I.1)⁻¹ * ∫ y in Set.Icc (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1), ‖augPhys X y‖)) +
  2 * ((frequencyBox (Cd.z.dim + Cd.z.dim) (2 ^ (Cd.Kt + 1))).card *
      (frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1))).card ^ 4 *
    ((dyadicGridLength A.G I.1)⁻¹ * (∫ y in Set.Ico (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1), ‖augPhys X y‖) *
      (nearB κ' ε₁ + 12 * (kerC κ' Td3.J3 * (4 / H) ^ (Td3.J3 - 2)))))

