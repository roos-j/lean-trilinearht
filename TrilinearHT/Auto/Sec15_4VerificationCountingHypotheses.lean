  set sz : Finset (D.Ms l G).Md → ℝ := fun i =>
    Cd.unitSize Td l (unitPart (I := I) l (classComps (I := I) l h C) i) ^ 2 with hsz
  set goodU : ℕ → Finset (D.Ms l G).Md → Prop := fun t i =>
