theorem gsz_nonneg (Td : Cd.TorusData) (l : Fin 4) (M : Finset (Finset (D.Ms l G).Md)) :
    0 ≤ Cd.gsz Td l M := by
  unfold gsz; positivity

open Classical in
/-- Blueprint lines 2466-2569 for one failure history of a three-core pattern (side slot `l`
carrying the side piece `s_l`) on an attempt leaf cell: for an assignment `a` with no failure in
the side role, a word `w` of failed heights, a final height `h` and a tuple `p` of final classes
(`p_l = ∅` for the side), the form of the masked slot sums is at most the principal quantity of the
three-core test of the class representatives (torus height `h - Δ`, torus sizes `G(M_j)` of the
selected component families) plus `threeConst` times the coefficient products over the core roles
of the member component tuples (`three_core_tuple_bound`, `gsz_role`). -/
theorem three_core_history_bound (Td3 : Cd.ThreeData) (Td : Cd.TorusData) (hK1 : 1 ≤ D.S.K)
    (hI : I ∈ A.cells) (l : Fin 4) {n : ℕ} (a : Fin n → Fin 4) (w : Fin n → ℕ) {h : ℕ}
    (hh : h - D.SP.Δ ≤ D.SP.Jst)
    (aRep : ∀ j, Finset (D.Ms j G).Md → (D.Ms j G).alive (D.decCell I))
    (haRep : ∀ j, ∀ K ∈ (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I),
      D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j h (some K) →
      ∀ x : (D.Ms j G).alive (D.decCell I), x.1 ∈ K →
        x ∈ ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).E (h - D.SP.Δ)
          (aRep j ((D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h K)))
    {xs : ℝ} (hxs : xs ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1)) (Bf : ℕ)
    (hBf : (Bf : ℝ) ≤ Cd.Bp)
    (hfull4 : 4 * (((6 ^ (h - D.SP.Δ) : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) + 4 * (3 *
      (((D.S.Q0 * 6 ^ (h - D.SP.Δ) : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) + Cd.Nb))) ≤ Bf)
    (s e : Fin 4 → ColumnL2 (Fin ap.Mc)) (p : ∀ j, Finset (D.Ms j G).Md)
    (hside : roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h none)
    (hpl : p l = ∅) :
    ‖ap.Λc I (fun j => ∑ o ∈ ((compIdx (fun k => if k = l then 1 else 0)
        (fun j => (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) j).filter
          (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h)).filter
          (fun o => D.coreCls G I h j o = p j),
        slotVal (fun k => if k = l then 1 else 0) (fun j K => D.compSub j G I (D.preCell I) K)
          s e j o)‖ ≤
      Cd.threePrin Td3 (h - D.SP.Δ) l (fun j _ => aRep j (p j)) xs Bf (s l)
        (∏ j ∈ Finset.univ.erase l, Cd.gsz Td j
          (((D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)).filter
          fun K => roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h
            (some K) ∧ D.coreCls G I h j (some K) = p j)) +
      Cd.threeConst Td3 (h - D.SP.Δ) l (fun j _ => aRep j (p j)) xs Bf (s l) *
        ∑ r ∈ (Fintype.piFinset fun j => (compIdx (fun k => if k = l then 1 else 0)
          (fun j => (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) j).filter
          (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h)).filter
          (fun r => ∀ j, D.coreCls G I h j (r j) = p j),
          ∏ j ∈ Finset.univ.erase l, D.optAbs G I j (r j) := by
  set σ3 : Fin 4 → Fin 3 := fun k => if k = l then 1 else 0 with hσ3
  have hσl : σ3 l = 1 := by simp [hσ3]
  have hσj : ∀ j, j ≠ l → σ3 j = 0 := fun j hj => by simp [hσ3, hj]
  set Ks : ∀ j, Finset (Finset (D.Ms j G).Md) := fun j =>
    (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I) with hKs
  set Mk : ∀ j, Finset (Finset (D.Ms j G).Md) := fun j => (Ks j).filter fun K =>
    roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h (some K) ∧
      D.coreCls G I h j (some K) = p j with hMk
  have hMkKs : ∀ j, Mk j ⊆ Ks j := fun j => Finset.filter_subset _ _
  have hdis : ∀ j, Set.PairwiseDisjoint (Mk j : Set (Finset (D.Ms j G).Md)) id := fun j =>
    ((D.Ms j G).coreComps_pairwiseDisjoint D.S D.hA D.SP _ _).subset
      (Finset.coe_subset.mpr (hMkKs j))
  -- the side slot carries the side piece; the core slots the subtotals of the selected modes
  have hslot : (fun j => ∑ o ∈ ((compIdx σ3 Ks j).filter
        (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h)).filter
        (fun o => D.coreCls G I h j o = p j),
        slotVal σ3 (fun j K => D.compSub j G I (D.preCell I) K) s e j o) =
      Function.update (fun j => D.compSub j G I (D.preCell I)
        ((D.selAlive G I j (Mk j)).image Subtype.val)) l (s l) := by
    funext j
    by_cases hj : j = l
    · subst hj
      rw [Function.update_self]
      have hidx : ((compIdx σ3 Ks j).filter
          (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h)).filter
          (fun o => D.coreCls G I h j o = p j) = {none} := by
        unfold compIdx
        rw [ite_eq_right_of_eq_false _ _ (eq_false (by rw [hσl]; decide))]
        ext o
        simp only [Finset.mem_filter, Finset.mem_singleton]
        constructor
        · exact fun h => h.1.1
        · rintro rfl
          exact ⟨⟨rfl, hside⟩, by rw [hpl]; rfl⟩
      rw [hidx, Finset.sum_singleton]
      unfold slotVal
      rw [ite_eq_right_of_eq_false _ _ (eq_false (by rw [hσl]; decide)), hσl]
      rfl
    · rw [Function.update_of_ne hj]
      rw [slot_sum_core σ3 Ks _ s e (l := j) (hσj j hj), D.image_selAlive G I j (hMkKs j)]
      exact D.sum_compSub j G I (D.preCell I) (Mk j) id (hdis j)
  rw [hslot]
  -- the selected modes lie in the predecessor of the class representative
  have hF : ∀ j (_ : j ≠ l), D.selAlive G I j (Mk j) ⊆
      ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).E (h - D.SP.Δ)
        (aRep j (p j)) := by
    intro j _ x hx
    obtain ⟨K, hK, hxK⟩ := Finset.mem_biUnion.mp (Finset.mem_filter.mp hx).2
    obtain ⟨hKs, hmask, hcls⟩ := Finset.mem_filter.mp hK
    have := haRep j K hKs hmask.1 x hxK
    have hc : (D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h K = p j := hcls
    rwa [hc] at this
  have key := Cd.three_core_tuple_bound Td3 hK1 hI hh l (fun j _ => aRep j (p j))
    (fun j => D.selAlive G I j (Mk j)) hF hxs Bf hBf hfull4 (s l)
    (fun j => Cd.gsz Td j (Mk j)) (fun j => Cd.gsz_nonneg Td j (Mk j))
    (fun ρc nn hρc hnn hfa cc hcc _ hline i hi => by
      have e : (fun u : torusAnnihilator
          (rationalIntegerIntersection (tinySpan Cd.z.θ Cd.Hh Cd.ε)) =>
          coreG (D.S.Q0 * 6 ^ (h - D.SP.Δ)) (2 ^ (Cd.Kt + 1))
            (sideOptF l fun j => D.selAlive G I j (Mk j)) (D.c3 G I xs) (sideOptN nn) cc i u) =
          fun u : torusAnnihilator (rationalIntegerIntersection (tinySpan Cd.z.θ Cd.Hh Cd.ε)) =>
            ∑ q ∈ frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1)) ×ˢ D.selAlive G I i (Mk i),
            (cc i q.1 * D.selC i G I xs q.2) *
              torusCharacter (((D.S.Q0 * 6 ^ (h - D.SP.Δ) : ℕ) : ℤ) • q.1 + nn i q.2) u :=
        funext fun u => coreG_side _ _ l _ _ _ cc hi u
      rw [e]
      exact Cd.gsz_role Td hK1 hh hxs i (Mk i) (hMkKs i) (aRep i (p i)) (ρc i) (nn i) (cc i)
        (hcc i) (hnn i hi) (hfa i hi) (hline i hi))
  refine key.trans (le_of_eq ?_)
  congr 2
  -- the coefficient products of the selected modes are the member-tuple sums
  have hsum : ∀ j, ∑ m ∈ D.selAlive G I j (Mk j),
      ‖D.c j G (D.blockOf I.1) (D.preCell I) m.1‖ =
      ∑ o ∈ (Mk j).map Function.Embedding.some, D.optAbs G I j o := by
    intro j
    rw [← Finset.sum_image (f := fun m => ‖D.c j G (D.blockOf I.1) (D.preCell I) m‖)
      (fun x _ y _ hxy => Subtype.val_injective hxy), D.image_selAlive G I j (hMkKs j),
      Finset.sum_biUnion (hdis j), Finset.sum_map]
    rfl
  have hmem : (Fintype.piFinset fun j => (compIdx σ3 Ks j).filter
      (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h)).filter
      (fun r => ∀ j, D.coreCls G I h j (r j) = p j) =
      Fintype.piFinset fun j => if j = l then {none} else (Mk j).map Function.Embedding.some := by
    ext r
    simp only [Finset.mem_filter, Fintype.mem_piFinset]
    constructor
    · rintro ⟨h1, h2⟩ j
      by_cases hj : j = l
      · subst hj
        have hc := (h1 j).1
        unfold compIdx at hc
        rw [ite_eq_right_of_eq_false _ _ (eq_false (by rw [hσl]; decide))] at hc
        rw [ite_eq_left_of_eq_true _ _ (eq_true rfl)]
        exact hc
      · rw [ite_eq_right_of_eq_false _ _ (eq_false hj)]
        obtain ⟨hc, hm⟩ := h1 j
        unfold compIdx at hc
        rw [ite_eq_left_of_eq_true _ _ (eq_true (hσj j hj))] at hc
        obtain ⟨K, hK, hKr⟩ := Finset.mem_map.mp hc
        refine Finset.mem_map.mpr ⟨K, Finset.mem_filter.mpr ⟨hK, ?_, ?_⟩, hKr⟩
        · rw [← hKr] at hm; exact hm
        · have h2j := h2 j; rw [← hKr] at h2j; exact h2j
    · intro hr
      refine ⟨fun j => ?_, fun j => ?_⟩
      · by_cases hj : j = l
        · subst hj
          have h0 := hr j
          rw [ite_eq_left_of_eq_true _ _ (eq_true rfl), Finset.mem_singleton] at h0
          rw [h0]
          refine ⟨?_, hside⟩
          unfold compIdx
          rw [ite_eq_right_of_eq_false _ _ (eq_false (by rw [hσl]; decide))]
          exact Finset.mem_singleton_self _
        · have h0 := hr j
          rw [ite_eq_right_of_eq_false _ _ (eq_false hj)] at h0
          obtain ⟨K, hK, hKr⟩ := Finset.mem_map.mp h0
          obtain ⟨hKs, hm, -⟩ := Finset.mem_filter.mp hK
          refine ⟨?_, by rw [← hKr]; exact hm⟩
          unfold compIdx
          rw [ite_eq_left_of_eq_true _ _ (eq_true (hσj j hj))]
          exact Finset.mem_map.mpr ⟨K, hKs, hKr⟩
      · by_cases hj : j = l
        · subst hj
          have h0 := hr j
          rw [ite_eq_left_of_eq_true _ _ (eq_true rfl), Finset.mem_singleton] at h0
          rw [h0, hpl]
          rfl
        · have h0 := hr j
          rw [ite_eq_right_of_eq_false _ _ (eq_false hj)] at h0
          obtain ⟨K, hK, hKr⟩ := Finset.mem_map.mp h0
          obtain ⟨-, -, hc⟩ := Finset.mem_filter.mp hK
          rw [← hKr]
          exact hc
  rw [hmem, sum_piFinset_prod_erase _ l (by simp)]
  exact Finset.prod_congr rfl fun j hj => by
    rw [ite_eq_right_of_eq_false _ _ (eq_false (Finset.ne_of_mem_erase hj))]
    exact hsum j

open Classical in
/-- The principal coefficient of a tested three-core tuple: `2 Σ_{Λ ≤ 2^{I_w}}` (shells) at the
chosen reference if it passes the test, `0` if it is discarded. -/
noncomputable def threeCf (Td3 : Cd.ThreeData) (h' : ℕ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (X : ColumnL2 (Fin ap.Mc)) : ℝ :=
  if Cd.passes3 h' l a xs Bf then
    2 * Cd.shellCoef3 Td3 h' l a xs Bf X (Cd.beta3 h' l a xs Bf)
  else 0

theorem threePrin_eq (Td3 : Cd.ThreeData) (h' : ℕ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (X : ColumnL2 (Fin ap.Mc)) (P : ℝ) :
    Cd.threePrin Td3 h' l a xs Bf X P = Cd.threeCf Td3 h' l a xs Bf X * P := by
  unfold threePrin threeCf
  split_ifs <;> ring

theorem threeCf_nonneg (Td3 : Cd.ThreeData) (hI : I ∈ A.cells) (h' : ℕ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (X : ColumnL2 (Fin ap.Mc)) : 0 ≤ Cd.threeCf Td3 h' l a xs Bf X := by
  have hr := dyadicGridLength_pos A.G I.1
  have hw := A.adm I hI
  unfold threeCf
  split_ifs
  · rw [Cd.shellCoef3_eq]
    have := entryC_nonneg hr hw Td3.J3 Td3.Aw
      (dyadicGridLength A.G I.1 * Cd.beta3 h' l a xs Bf)
    have := Cd.shellU3_nonneg Td3 h' l a xs Bf X
    positivity
  · exact le_rfl

open Classical in
/-- Blueprint lines 2463-2582 for a three-core pattern (side slot `l` carrying the side piece
`s_l`) on an attempt leaf cell and group (`eq:principal-core` before binning, with
`eq:core-numerical`): the form of the expansion of the three core slots into their components is at
most `2⁴ Z / (1 - 4 (2δ_*)^{1/4}) + Σ_r C Π_{j ≠ l} Σ_{m ∈ r_j} |α_m|`, where
`Z = Σ_{h ∈ H} |H|⁻¹ Σ_p c_{h,p} Π_{j ≠ l} σ_{h,p_j}` sums, over the final heights and the tuples of
final classes of the cores, the principal coefficients of the tested representative tuples times
the class sizes (first success `pattern_leaf_bound`; the side never fails, so histories assigning a
failure to the side role are empty; torus sizes `gsz_role`, moments `gsz_masked_le` and
`gsz_masked_sq_moment` with `hmom_of_principal`). -/
theorem three_core_cell (Td3 : Cd.ThreeData) (Td : Cd.TorusData) (hK1 : 1 ≤ D.S.K)
    (hI : I ∈ A.cells) (l : Fin 4)
    (hstab : ∀ j, ∀ h x x', (D.Ms j G).goodP D.S D.SP (D.blockOf I.1) h
      (((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).π x) →
      ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).π x' =
        ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).π x →
      x' ∈ ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).F h x →
      x' ∈ ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).E (h - D.SP.Δ) x)
    (hJ : 2 ≤ D.SP.Jst) (hδ : 0 < D.SP.δs) (hδJ : ⌈4 * D.SP.δs * D.SP.Jst⌉₊ ≤ D.SP.Jst)
    (hδ16 : D.SP.δs ≤ 1 / 16) (hq : (4 : ℝ) * (2 * D.SP.δs) ^ (1 / (4 : ℝ)) < 1)
    (aRep : ℕ → ∀ j, Finset (D.Ms j G).Md → (D.Ms j G).alive (D.decCell I))
    (haRep : ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ j,
      ∀ K ∈ (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I),
      D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j h (some K) →
      ∀ x : (D.Ms j G).alive (D.decCell I), x.1 ∈ K →
        x ∈ ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).E (h - D.SP.Δ)
          (aRep h j ((D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h K)))
    {xs : ℝ} (hxs : xs ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1)) (Bf : ℕ)
    (hBf : (Bf : ℝ) ≤ Cd.Bp)
    (hfull4 : ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs,
      4 * (((6 ^ (h - D.SP.Δ) : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) + 4 * (3 *
      (((D.S.Q0 * 6 ^ (h - D.SP.Δ) : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) + Cd.Nb))) ≤ Bf)
    (s e : Fin 4 → ColumnL2 (Fin ap.Mc)) {Cmax : ℝ}
    (hCmax : ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ p : ∀ j, Finset (D.Ms j G).Md,
      Cd.threeConst Td3 (h - D.SP.Δ) l (fun j _ => aRep h j (p j)) xs Bf (s l) ≤ Cmax) :
    ‖∑ r ∈ Fintype.piFinset (compIdx (fun k => if k = l then 1 else 0)
        (fun j => (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I))),
      ap.Λc I (compSlot (fun k => if k = l then 1 else 0)
        (fun j K => D.compSub j G I (D.preCell I) K) s e r)‖ ≤
      2 ^ 4 * (∑ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs,
        ((ModeComponents.upperHeights D.SP.Jst D.SP.δs).card : ℝ)⁻¹ *
          ∑ p ∈ Fintype.piFinset (fun j => if j = l then {∅} else
            ((D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)).image
              ((D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h)),
            Cd.threeCf Td3 (h - D.SP.Δ) l (fun j _ => aRep h j (p j)) xs Bf (s l) *
              ∏ j, (if j = l then 1 else Cd.classSigma Td j h (p j))) /
          (1 - (4 : ℝ) * (2 * D.SP.δs) ^ (1 / (4 : ℝ))) +
        ∑ r ∈ Fintype.piFinset (compIdx (fun k => if k = l then 1 else 0)
          (fun j => (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I))),
          Cmax * ∏ j ∈ Finset.univ.erase l, D.optAbs G I j (r j) := by
  set H := ModeComponents.upperHeights D.SP.Jst D.SP.δs with hH
  set σ3 : Fin 4 → Fin 3 := fun k => if k = l then 1 else 0 with hσ3
  have hσl : σ3 l = 1 := by simp [hσ3]
  have hσj : ∀ j, j ≠ l → σ3 j = 0 := fun j hj => by simp [hσ3, hj]
  have hHJ : ∀ h ∈ H, h - D.SP.Δ ≤ D.SP.Jst := fun h hh => by
    have := (Finset.mem_filter.mp hh).1
    rw [Finset.mem_range] at this
    omega
  have hρ : (0 : ℝ) ≤ 2 * D.SP.δs := by linarith
  have hoabs : ∀ j (o : Option (Finset (D.Ms j G).Md)), 0 ≤ D.optAbs G I j o := fun j o => by
    cases o with
    | none => exact le_rfl
    | some K => exact Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hidx : compIdx σ3 (fun j => (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1)
      (D.preCell I)) l = {none} := by
    unfold compIdx
    exact ite_eq_right_of_eq_false _ _ (eq_false (by rw [hσl]; decide))
  refine pattern_leaf_bound (ap.Λc I) σ3 (fun j => (D.Ms j G).coreComps D.S D.hA D.SP
      (D.blockOf I.1) (D.preCell I))
    (fun j K => D.compSub j G I (D.preCell I) K) s e H
    (fun j => D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j)
    (D.tuple_success G (D.blockOf I.1) (fun _ _ => D.preCell I) σ3 hJ hδ hδ16)
    (fun h j => D.coreCls G I h j)
    (fun n a w h p => Cd.threePrin Td3 (h - D.SP.Δ) l (fun j _ => aRep h j (p j)) xs Bf (s l)
      (∏ j ∈ Finset.univ.erase l, Cd.gsz Td j
        (((D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)).filter fun K =>
          roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h (some K) ∧
            D.coreCls G I h j (some K) = p j)))
    (fun r => Cmax * ∏ j ∈ Finset.univ.erase l, D.optAbs G I j (r j))
    (fun n a w hw h hh p hp => ?_) hρ hq (fun n a => ?_)
  · -- one history: the side slot keeps its dummy index
    obtain ⟨o, ho, hop⟩ := Finset.mem_image.mp (Fintype.mem_piFinset.mp hp l)
    obtain ⟨hoc, hom⟩ := Finset.mem_filter.mp ho
    rw [hidx, Finset.mem_singleton] at hoc
    subst hoc
    have hpl : p l = ∅ := hop.symm
    have key := Cd.three_core_history_bound Td3 Td hK1 hI l a w (hHJ h hh) (aRep h) (haRep h hh)
      hxs Bf hBf (hfull4 h hh) s e p hom hpl
    refine le_trans key (add_le_add le_rfl ?_)
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun r _ => mul_le_mul_of_nonneg_right (hCmax h hh p)
      (Finset.prod_nonneg fun j _ => hoabs j (r j))
  · -- the moments: no failure is ever assigned to the side role
    by_cases hal : ∃ i, a i = l
    · have hemp : ∀ (w : Fin n → ℕ) h, Fintype.piFinset (fun j => ((compIdx σ3
          (fun j => (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) j).filter
          (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h)).image
            (D.coreCls G I h j)) = ∅ := fun w h =>
        Fintype.piFinset_eq_empty.mpr ⟨l, by
          rw [Finset.image_eq_empty, hidx]
          refine Finset.filter_eq_empty_iff.mpr fun o ho => ?_
          rw [Finset.mem_singleton] at ho
          subst ho
          obtain ⟨i, hi⟩ := hal
          exact fun hm => hm.2.1 i hi trivial⟩
      refine le_trans (le_of_eq (Finset.sum_eq_zero fun w _ => Finset.sum_eq_zero fun h _ => by
        rw [hemp w h, Finset.sum_empty, mul_zero])) ?_
      refine mul_nonneg (mul_nonneg (by norm_num) (Real.rpow_nonneg (pow_nonneg hρ n) _))
        (Finset.sum_nonneg fun h _ => mul_nonneg (inv_nonneg.mpr (Nat.cast_nonneg _))
          (Finset.sum_nonneg fun p _ => mul_nonneg (Cd.threeCf_nonneg Td3 hI _ _ _ _ _ _)
            (Finset.prod_nonneg fun j _ => ?_)))
      split_ifs
      · exact zero_le_one
      · exact Real.sqrt_nonneg _
    · have hm := hmom_of_principal H (m₀ := 4) (by norm_num) a
        (π := fun _ => ∀ j, Finset (D.Ms j G).Md)
        (fun h => Fintype.piFinset fun j => if j = l then {∅} else
          ((D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)).image
            ((D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h))
        (fun w h => Fintype.piFinset fun j => ((compIdx σ3 (fun j => (D.Ms j G).coreComps
            D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) j).filter
          (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h)).image
            (D.coreCls G I h j))
        (fun w h p hp => by
          rw [Fintype.mem_piFinset] at hp ⊢
          intro j
          obtain ⟨o, ho, hop⟩ := Finset.mem_image.mp (hp j)
          have ho' := (Finset.mem_filter.mp ho).1
          by_cases hj : j = l
          · subst hj
            rw [ite_eq_left_of_eq_true _ _ (eq_true rfl)]
            rw [hidx, Finset.mem_singleton] at ho'
            subst ho'
            rw [← hop]
            exact Finset.mem_singleton_self _
          · rw [ite_eq_right_of_eq_false _ _ (eq_false hj)]
            unfold compIdx at ho'
            rw [ite_eq_left_of_eq_true _ _ (eq_true (hσj j hj))] at ho'
            obtain ⟨K, hK, rfl⟩ := Finset.mem_map.mp ho'
            rw [← hop]
            exact Finset.mem_image_of_mem _ hK)
        (fun w h p => Cd.threePrin Td3 (h - D.SP.Δ) l (fun j _ => aRep h j (p j)) xs Bf (s l)
          (∏ j ∈ Finset.univ.erase l, Cd.gsz Td j
            (((D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)).filter fun K =>
              roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h
                (some K) ∧ D.coreCls G I h j (some K) = p j)))
        (fun h p => Cd.threeCf Td3 (h - D.SP.Δ) l (fun j _ => aRep h j (p j)) xs Bf (s l))
        (fun h p _ => Cd.threeCf_nonneg Td3 hI _ _ _ _ _ _)
        (fun h p j w => if j = l then 1 else Cd.gsz Td j
          (((D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)).filter fun K =>
            roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) j) j a w h
              (some K) ∧ D.coreCls G I h j (some K) = p j))
        (fun h p j w => by
          split_ifs
          · exact zero_le_one
          · exact Cd.gsz_nonneg Td j _)
        (fun w h p => by rw [Cd.threePrin_eq, prod_ite_one_erase])
        (fun h p j => if j = l then 1 else Cd.classSigma Td j h (p j))
        (fun h p j => by
          split_ifs
          · exact zero_le_one
          · exact Real.sqrt_nonneg _) hρ
        (fun h hh p _ j w hw => by
          by_cases hj : j = l
          · simp only [hj, ↓reduceIte]
            norm_num
          · simp only [hj, ↓reduceIte]
            exact Cd.gsz_masked_le Td j (hstab j) hJ hδ hδJ a
              (fun i => Fintype.mem_piFinset.mp hw i) hh (p j))
        (fun h hh p _ j => by
          by_cases hj : j = l
          · subst hj
            simp only [↓reduceIte, one_pow, mul_one]
            have hf : (Finset.univ.filter fun i => a i = j) = ∅ :=
              Finset.filter_eq_empty_iff.mpr fun i _ hi => hal ⟨i, hi⟩
            rw [hf, Finset.card_empty, pow_zero, mul_one, Finset.sum_const, Fintype.card_piFinset,
              Finset.prod_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            have hHc : (H.card : ℝ) ≠ 0 :=
              Nat.cast_ne_zero.mpr (upperHeights_nonempty hδ16).card_pos.ne'
            push_cast
            rw [mul_inv_cancel₀ (pow_ne_zero n hHc)]
            norm_num
          · simp only [hj, ↓reduceIte]
            exact Cd.gsz_masked_sq_moment Td j (hstab j) hJ hδ hδJ hδ16 a hh (p j))
      have h4 : ((4 : ℕ) : ℝ) = 4 := by norm_num
      rw [h4] at hm
      exact hm

/-- The side window size `b_Λ = r⁻¹ (E_ρ Σ_{k ∈ W_Λ} |Ŝ'_ρ(k)|²)^{1/2}` of the shell `i` (`Λ = 2^i`)
of a three-core tuple (blueprint line 2558, normalized coefficients). -/
noncomputable def bLam3 (h' : ℕ) (l : Fin 4) (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I))
    (xs : ℝ) (Bf Iw : ℕ) (X : ColumnL2 (Fin ap.Mc)) (i : ℕ) : ℝ :=
  (dyadicGridLength A.G I.1)⁻¹ * Real.sqrt (∫ ρ', sideWinE Cd.z l (augPhys X)
    (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (Cd.fullWin h' l a xs Bf Iw i) ρ'
      ∂offsetMeasure Cd.z.dim)

/-- The value of a dyadic bin `(a, b, i, k)` of `(μ, ν, Λ = 2^i, σ)` for three cores: the bound
`C_{J,A} W |B| 2^{a+1} 2^{-bJ} Λ^{-(A+1)} Π_j 2^{k_j + 1}` of `eq:principal-core`. -/
noncomputable def binVal3 (Td3 : Cd.ThreeData) (c : ℤ × ℤ × ℕ × (Fin 4 → ℤ)) : ℝ :=
  2 * (kerC κ' (Td3.J3 + (Td3.Aw + 2)) * (3 + 2) ^ (Td3.J3 + (Td3.Aw + 2)) * 2 ^ (Td3.Aw + 2)) *
    2 ^ (Td3.Aw + 4) * (Cd.W * (frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1))).card) *
    (2 * (2 : ℝ) ^ c.1) * (((2 : ℝ) ^ c.2.1) ^ Td3.J3)⁻¹ * ((2 : ℝ) ^ c.2.2.1)⁻¹ ^ (Td3.Aw + 1) *
    ∏ j, (2 * (2 : ℝ) ^ c.2.2.2 j)

/-- The dyadic bin of a tested three-core tuple and shell `i`: `(⌊log₂ μ⌋, ⌊log₂ ν⌋, i, ⌊log₂ σ_j⌋)`
with the side amplitude `σ_l = b_Λ`. -/
noncomputable def bin3 (Td3 : Cd.ThreeData) (h' : ℕ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (X : ColumnL2 (Fin ap.Mc)) (σ : Fin 4 → ℝ) (i : ℕ) : ℤ × ℤ × ℕ × (Fin 4 → ℤ) :=
  (dyBin (Cd.mu3 h' l a xs Bf), dyBin (Cd.nu3 h' l a xs Bf), i,
    fun j => if j = l then dyBin (Cd.bLam3 h' l a xs Bf Td3.Iw X i) else dyBin (σ j))

theorem shellCoef3_eq_sum (Td3 : Cd.ThreeData) (h' : ℕ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (X : ColumnL2 (Fin ap.Mc)) :
    Cd.shellCoef3 Td3 h' l a xs Bf X (Cd.beta3 h' l a xs Bf) =
      ∑ i ∈ Finset.range (Td3.Iw + 1),
        kerC κ' (Td3.J3 + (Td3.Aw + 2)) * (3 + 2) ^ (Td3.J3 + (Td3.Aw + 2)) * 2 ^ (Td3.Aw + 2) *
          (Cd.mu3 h' l a xs Bf / Cd.nu3 h' l a xs Bf ^ Td3.J3) * 2 ^ (Td3.Aw + 4) *
          ((2 : ℝ) ^ i)⁻¹ ^ (Td3.Aw + 1) *
          (Cd.W * (frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1))).card) *
          Cd.bLam3 h' l a xs Bf Td3.Iw X i := by
  have hr := dyadicGridLength_pos A.G I.1
  have hb : |dyadicGridLength A.G I.1 * Cd.beta3 h' l a xs Bf| =
      dyadicGridLength A.G I.1 * |Cd.beta3 h' l a xs Bf| := by
    rw [abs_mul, abs_of_pos hr]
  unfold shellCoef3 entryC mu3 nu3 bLam3
  rw [hb]
  exact Finset.sum_congr rfl fun i _ => by ring

open Classical in
/-- Blueprint lines 2576-2582 (`eq:principal-core`, three cores) on the attempt leaf cell: the
principal quantity of one final height, `Σ_p c_p Π_{j ≠ l} σ_{p,j}` over the tuples of final
classes (`σ_{p,l} = 1`), is at most the sum over the occupied dyadic bins `(μ, ν, Λ, σ)` (the side
amplitude `σ_l = b_Λ`) of the bin value `C_{J,A} W |B| μ ν^{-J} Λ^{-(A+1)} Π_j σ_j` times the number
of passing tuples and shells in the bin. Zero factors contribute nothing. -/
theorem three_core_binned (Td3 : Cd.ThreeData) (hI : I ∈ A.cells) (h' : ℕ) (l : Fin 4)
    {ι : Type*} (T : Finset ι) (aR : ι → ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I))
    (σ : ι → Fin 4 → ℝ) (hσ : ∀ p ∈ T, ∀ j, 0 ≤ σ p j) (hσl : ∀ p ∈ T, σ p l = 1) (xs : ℝ)
    (Bf : ℕ) (X : ColumnL2 (Fin ap.Mc)) :
    ∑ p ∈ T, Cd.threeCf Td3 h' l (aR p) xs Bf X * ∏ j, σ p j ≤
      ∑ c ∈ ((T ×ˢ Finset.range (Td3.Iw + 1)).filter fun q => Cd.passes3 h' l (aR q.1) xs Bf ∧
          0 < Cd.bLam3 h' l (aR q.1) xs Bf Td3.Iw X q.2 ∧ ∀ j, j ≠ l → 0 < σ q.1 j).image
          (fun q => Cd.bin3 Td3 h' l (aR q.1) xs Bf X (σ q.1) q.2),
        Cd.binVal3 Td3 c * ((((T ×ˢ Finset.range (Td3.Iw + 1)).filter fun q =>
          Cd.passes3 h' l (aR q.1) xs Bf ∧ 0 < Cd.bLam3 h' l (aR q.1) xs Bf Td3.Iw X q.2 ∧
            ∀ j, j ≠ l → 0 < σ q.1 j).filter fun q =>
          Cd.bin3 Td3 h' l (aR q.1) xs Bf X (σ q.1) q.2 = c).card : ℝ) := by
  have hr := dyadicGridLength_pos A.G I.1
  have hw := A.adm I hI
  set Ck := kerC κ' (Td3.J3 + (Td3.Aw + 2)) * (3 + 2) ^ (Td3.J3 + (Td3.Aw + 2)) *
    2 ^ (Td3.Aw + 2) with hCk
  have hCk0 : 0 ≤ Ck := by have := kerC_nonneg hr hw (Td3.J3 + (Td3.Aw + 2)); positivity
  have hWB : 0 ≤ Cd.W * (frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1))).card :=
    mul_nonneg Cd.hW (Nat.cast_nonneg _)
  have hb0 : ∀ p i, 0 ≤ Cd.bLam3 h' l (aR p) xs Bf Td3.Iw X i := fun p i =>
    mul_nonneg (inv_nonneg.mpr hr.le) (Real.sqrt_nonneg _)
  -- the weight of one tuple and shell
  set w : ι × ℕ → ℝ := fun q => 2 * (Ck * (Cd.mu3 h' l (aR q.1) xs Bf /
      Cd.nu3 h' l (aR q.1) xs Bf ^ Td3.J3) * 2 ^ (Td3.Aw + 4) *
      ((2 : ℝ) ^ q.2)⁻¹ ^ (Td3.Aw + 1) *
      (Cd.W * (frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1))).card) *
      Cd.bLam3 h' l (aR q.1) xs Bf Td3.Iw X q.2) * ∏ j, σ q.1 j with hw'
