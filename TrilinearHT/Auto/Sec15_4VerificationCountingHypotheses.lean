            fun x => x i).card *
          (S.biUnion fun s => (D.threePathE G h xs l cellOf ancOf Iw c κ s).image
            fun x => x j).card) ∧
    (∀ i, i ≠ l → ∑ s ∈ S, ((D.threePathE G h xs l cellOf ancOf Iw c κ s).card : ℝ) ≤
      (S.biUnion fun s => (D.threePathE G h xs l cellOf ancOf Iw c κ s).image
