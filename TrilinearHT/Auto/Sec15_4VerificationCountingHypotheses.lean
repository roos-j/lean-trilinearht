theorem three_core_small_bound (Td3 : Cd.ThreeData) (hK1 : 1 ≤ D.S.K) (hI : I ∈ A.cells)
    {h' : ℕ} (hh' : h' ≤ D.SP.Jst) (l : Fin 4) (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I))
