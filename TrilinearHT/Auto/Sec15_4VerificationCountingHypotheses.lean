variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

open Classical in
/-- A choice of a good mode `m_C` in every final class `C = F_h(x)` of a good mode `x` (the nodes
of `attempt_representatives3`: one good mode per CURRENT component). -/
theorem exists_classMode (b : ℤ) (J : ℤ × ℤ) (h : ℕ) (x₀ : Ms.alive (ancAt Gd J (b - 4 * S.K))) :
    ∃ mC : Finset Ms.Md → Ms.alive (ancAt Gd J (b - 4 * S.K)),
      ∀ x, (Ms.blockComps S hA b J).Good SP.Δ (Ms.goodP S SP b) h x →
        (Ms.blockComps S hA b J).Good SP.Δ (Ms.goodP S SP b) h
            (mC (((Ms.blockComps S hA b J).F h x).map ⟨Subtype.val, Subtype.val_injective⟩)) ∧
          (Ms.blockComps S hA b J).F h
            (mC (((Ms.blockComps S hA b J).F h x).map ⟨Subtype.val, Subtype.val_injective⟩)) =
            (Ms.blockComps S hA b J).F h x := by
  set C := Ms.blockComps S hA b J
  refine ⟨fun K => if hK : ∃ x, C.Good SP.Δ (Ms.goodP S SP b) h x ∧
      (C.F h x).map ⟨Subtype.val, Subtype.val_injective⟩ = K then hK.choose else x₀, ?_⟩
  intro x hx
  have hK : ∃ x', C.Good SP.Δ (Ms.goodP S SP b) h x' ∧
      (C.F h x').map ⟨Subtype.val, Subtype.val_injective⟩ =
        (C.F h x).map ⟨Subtype.val, Subtype.val_injective⟩ := ⟨x, hx, rfl⟩
  simp only [hK, ↓reduceDIte]
  exact ⟨hK.choose_spec.1, Finset.map_injective _ hK.choose_spec.2⟩

end ModeSystem

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

open Classical in
/-- Blueprint lines 2711-2712 at one pre-cell: the representatives of two different final classes
(through their class modes) have different labels `ω_a(x*)`, so the tested tuples of final classes
are counted by their label tuples. -/
theorem class_label_ne (Nd : Finset (ℤ × (ℤ × ℤ) × Ms.Md))
    (hNd : ∀ c ∈ Nd, c.2.1.1 = c.1 - 2 * S.K) (Δ h : ℕ)
    (halive : ∀ c ∈ Nd, c.2.2 ∈ Ms.alive (ancAt Gd c.2.1 (c.1 - 4 * S.K)))
    (hdist : ∀ c (hc : c ∈ Nd) c' (hc' : c' ∈ Nd) (h1 : c.1 = c'.1) (h2 : c.2.1 = c'.2.1),
      c ≠ c' → (⟨c'.2.2, by rw [h1, h2]; exact halive c' hc'⟩ :
        Ms.alive (ancAt Gd c.2.1 (c.1 - 4 * S.K))) ∉
        (Ms.blockComps S hA c.1 c.2.1).F h ⟨c.2.2, halive c hc⟩)
    (rep : ℤ × (ℤ × ℤ) × Ms.Md → Ms.Md) (hrep : ∀ c, rep c ∈ Ms.predOfMode S hA Δ h c)
    (hsepF : ∀ c c', nodeLt3 (Gd := Gd) Ms Nd c c' → rep c ≠ rep c' →
      ∀ z z' : Ms.alive (ancAt Gd c'.2.1 (c'.1 - 4 * S.K)), z.1 ∈ Ms.predOfMode S hA Δ h c →
        z'.1 ∈ Ms.predOfMode S hA Δ h c' → z ∉ (Ms.blockComps S hA c'.1 c'.2.1).F h z')
    (hΛ : 8 * Ms.Λ ≤ S.Ξ) {xs : ℝ} (hxs : ∀ c ∈ Nd, xs ∈ dyadicGridCell Gd c.2.1.1 c.2.1.2)
    {b : ℤ} {J : ℤ × ℤ} (mC : Finset Ms.Md → Ms.alive (ancAt Gd J (b - 4 * S.K)))
    {C C' : Finset Ms.Md}
    (hC : ((Ms.blockComps S hA b J).F h (mC C)).map ⟨Subtype.val, Subtype.val_injective⟩ = C)
    (hC' : ((Ms.blockComps S hA b J).F h (mC C')).map ⟨Subtype.val, Subtype.val_injective⟩ = C')
    (hCC' : C ≠ C') (hc : (b, J, (mC C).1) ∈ Nd) (hc' : (b, J, (mC C').1) ∈ Nd) :
    Ms.slope (rep (b, J, (mC C).1)) xs ≠ Ms.slope (rep (b, J, (mC C').1)) xs := by
  refine Ms.rep_slope_ne S hA Nd hNd Δ h halive hdist rep hrep hsepF hΛ hxs hc hc' ?_
  obtain ⟨a, ha, haE⟩ := Ms.rep_mem_pred S hA Δ h (mC C) (hrep (b, J, (mC C).1))
  obtain ⟨a', ha', haE'⟩ := Ms.rep_mem_pred S hA Δ h (mC C') (hrep (b, J, (mC C').1))
  have hF : (Ms.blockComps S hA b J).F h (mC C) ≠ (Ms.blockComps S hA b J).F h (mC C') :=
    fun hF => hCC' (by rw [← hC, ← hC', hF])
  have hne := (Ms.blockComps S hA b J).pred_ne_of_F_ne haE haE' hF
  intro he
  exact hne (Subtype.ext (by rw [ha, ha', he]))

end ModeSystem

open Classical in
/-- Blueprint lines 2711-2712 and 2780-2781 ("`N_s^G` counts the representative tuples ... at most
once per tuple"): if in every role distinct classes have distinct labels, the tuples of classes are
counted by their label tuples. -/
theorem card_eq_label_image {κ : Fin 4 → Type*} (T : Finset (∀ j, κ j)) (lab : ∀ j, κ j → ℝ)
    (hinj : ∀ p ∈ T, ∀ p' ∈ T, ∀ j, p j ≠ p' j → lab j (p j) ≠ lab j (p' j)) :
    (T.image fun p j => lab j (p j)).card = T.card := by
  refine Finset.card_image_of_injOn fun p hp p' hp' he => ?_
  by_contra hne
  obtain ⟨j, hj⟩ := Function.ne_iff.mp hne
  exact hinj p hp p' hp' j hj (congrFun he j)

