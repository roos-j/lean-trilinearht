open Classical in
/-- Blueprint lines 2711-2712 ("distinct labels in a fixed role and type have distinct values by
`eq:representative-separation` at zero shift"): different representatives on mode nodes whose
pre-cells contain `x*` have different slopes `ω_a(x*)`. -/
theorem rep_slope_ne (Nd : Finset (ℤ × (ℤ × ℤ) × Ms.Md))
    (hNd : ∀ c ∈ Nd, c.2.1.1 = c.1 - 2 * S.K) (Δ h : ℕ)
    (halive : ∀ c ∈ Nd, c.2.2 ∈ Ms.alive (ancAt Gd c.2.1 (c.1 - 4 * S.K)))
    (hdist : ∀ c (hc : c ∈ Nd) c' (hc' : c' ∈ Nd) (h1 : c.1 = c'.1) (h2 : c.2.1 = c'.2.1),
      c ≠ c' → (⟨c'.2.2, by rw [h1, h2]; exact halive c' hc'⟩ :
        Ms.alive (ancAt Gd c.2.1 (c.1 - 4 * S.K))) ∉
        (Ms.blockComps S hA c.1 c.2.1).F h ⟨c.2.2, halive c hc⟩)
    (rep : ℤ × (ℤ × ℤ) × Ms.Md → Ms.Md) (hrep : ∀ c, rep c ∈ Ms.predOfMode S hA Δ h c)
    (hsepF : ∀ c c', nodeLt3 (Gd := Gd) Ms Nd c c' → rep c ≠ rep c' →
      ∀ z z' : Ms.alive (ancAt Gd c'.2.1 (c'.1 - 4 * S.K)), z.1 ∈ Ms.predOfMode S hA Δ h c →
        z'.1 ∈ Ms.predOfMode S hA Δ h c' → z ∉ (Ms.blockComps S hA c'.1 c'.2.1).F h z')
    (hΛ : 8 * Ms.Λ ≤ S.Ξ) {xs : ℝ} (hxs : ∀ c ∈ Nd, xs ∈ dyadicGridCell Gd c.2.1.1 c.2.1.2)
    {c c' : ℤ × (ℤ × ℤ) × Ms.Md} (hc : c ∈ Nd) (hc' : c' ∈ Nd) (hne : rep c ≠ rep c') :
    Ms.slope (rep c) xs ≠ Ms.slope (rep c') xs := by
  intro heq
  have h0 : ∀ i, |((0 : Fin Ms.zc.dim → ℤ) i : ℝ)| ≤ S.Eh h := fun i => by
    simp only [Pi.zero_apply, Int.cast_zero, abs_zero]
    unfold ModeSchedule.Eh
    have : (0 : ℝ) ≤ S.A0 := by linarith [(show (6 : ℝ) ≤ S.A0 from hA)]
    positivity
  have key := Ms.role_label_separation3 S hA Nd hNd Δ h halive hdist rep hrep hsepF hΛ hxs hc
    hc' hne 0 h0 le_rfl le_rfl
  rw [heq, sub_self] at key
  simp only [Pi.zero_apply, Int.cast_zero, zero_mul, Finset.sum_const_zero, zero_div, add_zero,
    abs_zero, max_self] at key
  have := Ξ_nonneg S
  have : 0 ≤ (dyadicGridLength Gd (max c.1 c'.1 + S.K))⁻¹ :=
    inv_nonneg.mpr (dyadicGridLength_pos Gd _).le
  nlinarith

/-- A representative of the node `(b, J, m)` in its predecessor is an alive mode in the PRE
predecessor `E_{h-Δ}(m)`. -/
theorem rep_mem_pred (Δ h : ℕ) {b : ℤ} {J : ℤ × ℤ} (m : Ms.alive (ancAt Gd J (b - 4 * S.K)))
    {a : Ms.Md} (ha : a ∈ Ms.predOfMode S hA Δ h (b, J, m.1)) :
    ∃ a' : Ms.alive (ancAt Gd J (b - 4 * S.K)), a'.1 = a ∧
      a' ∈ (Ms.blockComps S hA b J).E (h - Δ) m := by
  rw [Ms.predOfMode_eq S hA Δ h (c := (b, J, m.1)) m.2] at ha
  obtain ⟨z, hz, rfl⟩ := Finset.mem_map.mp ha
  exact ⟨z, rfl, hz⟩

end ModeSystem

