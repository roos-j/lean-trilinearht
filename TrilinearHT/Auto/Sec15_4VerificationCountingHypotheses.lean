/-- Blueprint lines 2716-2717 (pair determination, four cores): two tested tuples `x, x'` at
scales `s, s'` whose reference equations `Σ x_r + 36 n·ζ = q`, `Σ r x_r + 36 m·ζ = t` hold with
`|q|, |t| ≤ ν R_s` and which agree in roles `i, j`, agree in each other role `k`, given
separation with reserve `288 B ≤ Q`, `8ν ≤ Σ`. -/
theorem four_core_pair_role {d : ℕ} (ζ : Fin d → ℝ) {x x' : Fin 4 → ℝ} {i j k l : Fin 4}
    (hkl : k ≠ l) (hki : k ≠ i) (hkj : k ≠ j) (hli : l ≠ i) (hlj : l ≠ j) (hij : i ≠ j)
    (hxi : x i = x' i) (hxj : x j = x' j) {n m n' m' : Fin d → ℤ} {B Q Sg ν R R' : ℝ}
    (hn : ∀ r, |(n r : ℝ)| ≤ B) (hm : ∀ r, |(m r : ℝ)| ≤ B) (hn' : ∀ r, |(n' r : ℝ)| ≤ B)
    (hm' : ∀ r, |(m' r : ℝ)| ≤ B)
    (hq : |∑ r, x r + 36 * ∑ p, (n p : ℝ) * ζ p| ≤ ν * R)
    (ht : |∑ r : Fin 4, ((r : ℕ) : ℝ) * x r + 36 * ∑ p, (m p : ℝ) * ζ p| ≤ ν * R)
    (hq' : |∑ r, x' r + 36 * ∑ p, (n' p : ℝ) * ζ p| ≤ ν * R')
    (ht' : |∑ r : Fin 4, ((r : ℕ) : ℝ) * x' r + 36 * ∑ p, (m' p : ℝ) * ζ p| ≤ ν * R')
    (hsep : x k ≠ x' k → ∀ N : Fin d → ℤ, (∀ p, |(N p : ℝ)| ≤ Q) →
      Sg * max R R' < |x k - x' k + ∑ p, (N p : ℝ) * ζ p|)
    (hQ : 288 * B ≤ Q) (hSg : 8 * ν ≤ Sg) (hν : 0 ≤ ν) (hR : 0 ≤ R) :
    x k = x' k := by
  have hmax : ν * R ≤ ν * max R R' := mul_le_mul_of_nonneg_left (le_max_left _ _) hν
  have hmax' : ν * R' ≤ ν * max R R' := mul_le_mul_of_nonneg_left (le_max_right _ _) hν
  refine pair_role_of_diff ζ hkl hki hkj hli hlj hij hxi hxj hn hm hn' hm'
    (ε := 2 * ν * max R R') ((abs_sub _ _).trans (by linarith))
    ((abs_sub _ _).trans (by linarith)) hsep hQ ?_
  have := mul_le_mul_of_nonneg_right hSg (le_max_of_le_left hR : 0 ≤ max R R')
  linarith

