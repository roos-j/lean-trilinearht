  have hS := Cd.shellU3_nonneg Td3 h' l a xs Bf X
  have hT := Cd.tailU3_nonneg Td3 Bf X
  have hPi : 0 ≤ (1 + cutTail Cd.z.dim Cd.δ Cd.Kt) ^ 3 *
      ∏ j ∈ Finset.univ.erase l, ∑ m ∈ F j, ‖D.c j G (D.blockOf I.1) (D.preCell I) m.1‖ :=
    mul_nonneg (pow_nonneg (by linarith) 3)
      (Finset.prod_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => norm_nonneg _)
  refine key.trans (add_le_add ?_ le_rfl)
