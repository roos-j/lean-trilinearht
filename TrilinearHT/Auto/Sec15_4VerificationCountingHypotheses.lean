/-- For a core role `i ≠ l` of a three-core tuple, the truncated torus input of the side-option
data is that of the selected modes of the role. -/
theorem coreG_side {d : ℕ} (QL Bx : ℕ) {ι : Fin 4 → Type*} (l : Fin 4) (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) (cc : Fin 4 → (Fin d → ℤ) → ℂ) {i : Fin 4}
    (hi : i ≠ l) (u : StandardTorus d) :
    coreG QL Bx (sideOptF l F) (sideOptC c) (sideOptN n) cc i u =
      ∑ p ∈ frequencyBox d Bx ×ˢ F i, (cc i p.1 * c i p.2) *
        torusCharacter ((QL : ℤ) • p.1 + n i p.2) u := by
  unfold coreG sideOptF
  simp only [hi, ↓reduceIte]
  rw [Finset.sum_product, Finset.sum_product]
  refine Finset.sum_congr rfl fun v _ => ?_
  rw [Finset.sum_map]
  rfl

/-- Sum over a product of index sets with a single index in slot `l` of the products over the
other slots. -/
theorem sum_piFinset_prod_erase {κ : Fin 4 → Type*}
    (T : ∀ j, Finset (κ j)) (l : Fin 4) (hT : (T l).card = 1) (f : ∀ j, κ j → ℝ) :
    ∑ r ∈ Fintype.piFinset T, ∏ j ∈ Finset.univ.erase l, f j (r j) =
      ∏ j ∈ Finset.univ.erase l, ∑ o ∈ T j, f j o := by
  classical
  have h1 : ∀ r : ∀ j, κ j, ∏ j ∈ Finset.univ.erase l, f j (r j) =
      ∏ j, (if j = l then 1 else f j (r j)) := fun r => by
    rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ l), ite_eq_left_of_eq_true _ _ (eq_true rfl),
      one_mul]
    exact (Finset.prod_congr rfl fun j hj =>
      ite_eq_right_iff.mpr fun h => absurd h (Finset.ne_of_mem_erase hj)).symm
  simp_rw [h1]
  rw [← Finset.prod_univ_sum (t := T) (f := fun j o => if j = l then 1 else f j o),
    ← Finset.mul_prod_erase _ _ (Finset.mem_univ l)]
  simp only [↓reduceIte, Finset.sum_const, hT, one_smul, one_mul]
  exact Finset.prod_congr rfl fun j hj => Finset.sum_congr rfl fun o _ =>
    ite_eq_right_iff.mpr fun h => absurd h (Finset.ne_of_mem_erase hj)

