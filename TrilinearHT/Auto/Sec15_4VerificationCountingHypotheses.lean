noncomputable def repAnchor (G : bf.Grp) (I : ℤ × ℤ) (j : Fin 4) (h : ℕ)
    (rep : ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
