    ht' (hsep l) hQ hSg hν hR
  funext r
  rcases hcov r with rfl | rfl | rfl | rfl <;> assumption

/-- Blueprint `eq:triple-test` for four cores (line 2722): the triple omitting the anchor `l'`
has `Σ_{i ≠ l'} (i - l') x_i + 36 (m - l' n)·ζ = t' - l' q'`, between `μ R` and `4 ν R`, with a
witness of size at most `4 B`. -/
theorem four_core_ann {d : ℕ} (ζ : Fin d → ℝ) {x : Fin 4 → ℝ} {B μ ν R : ℝ}
    (hx : FourRef ζ B μ ν R x) {T : Finset (Fin 4)} (hT : T.card = 3) {l : Fin 4} (hl : l ∉ T) :
    ∃ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ 4 * B) ∧
      μ * R ≤ |∑ i ∈ T, (roleCoeff i l : ℝ) * x i + 36 * ∑ k, (n k : ℝ) * ζ k| ∧
      |∑ i ∈ T, (roleCoeff i l : ℝ) * x i + 36 * ∑ k, (n k : ℝ) * ζ k| ≤ 4 * ν * R := by
  obtain ⟨n, m, hn, hm, hq, ht, hj⟩ := hx
  have hTe : T = Finset.univ.erase l := by
    refine (Finset.eq_of_subset_of_card_le (fun a ha => Finset.mem_erase.mpr
      ⟨fun h => hl (by subst h; exact ha), Finset.mem_univ _⟩) ?_)
    rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_fin, hT]
  have hl3 : ((l : ℕ) : ℝ) ≤ 3 := by have := l.isLt; exact_mod_cast (by omega : (l : ℕ) ≤ 3)
  have hl0 : (0 : ℝ) ≤ (l : ℕ) := Nat.cast_nonneg _
  refine ⟨fun p => m p - (l : ℕ) * n p, fun p => ?_, ?_⟩
  · push_cast
    calc |(m p : ℝ) - ((l : ℕ) : ℝ) * n p| ≤ |(m p : ℝ)| + |((l : ℕ) : ℝ) * n p| := abs_sub _ _
      _ = |(m p : ℝ)| + ((l : ℕ) : ℝ) * |(n p : ℝ)| := by rw [abs_mul, abs_of_nonneg hl0]
      _ ≤ B + 3 * B := by
        have := hn p; have := hm p
        have hB : 0 ≤ B := (abs_nonneg _).trans (hn p)
        nlinarith
      _ = 4 * B := by ring
  have heq : ∑ i ∈ T, (roleCoeff i l : ℝ) * x i +
      36 * ∑ k, (((m k - (l : ℕ) * n k : ℤ)) : ℝ) * ζ k =
      (∑ r : Fin 4, ((r : ℕ) : ℝ) * x r + 36 * ∑ p, (m p : ℝ) * ζ p) -
        ((l : ℕ) : ℝ) * (∑ r, x r + 36 * ∑ p, (n p : ℝ) * ζ p) := by
    rw [hTe, Finset.sum_erase _ (by simp [roleCoeff])]
    simp only [roleCoeff]
    push_cast
    simp only [sub_mul, Finset.sum_sub_distrib]
    have e1 : ∑ r, ((l : ℕ) : ℝ) * x r = ((l : ℕ) : ℝ) * ∑ r, x r := (Finset.mul_sum _ _ _).symm
    have e2 : ∑ p, ((l : ℕ) : ℝ) * (n p : ℝ) * ζ p = ((l : ℕ) : ℝ) * ∑ p, (n p : ℝ) * ζ p := by
      rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun p _ => by ring
    rw [e1, e2]; ring
  rw [heq]
  refine ⟨hj l, ?_⟩
  calc _ ≤ |∑ r : Fin 4, ((r : ℕ) : ℝ) * x r + 36 * ∑ p, (m p : ℝ) * ζ p| +
        |((l : ℕ) : ℝ) * (∑ r, x r + 36 * ∑ p, (n p : ℝ) * ζ p)| := abs_sub _ _
    _ ≤ ν * R + 3 * (ν * R) := by
      rw [abs_mul, abs_of_nonneg hl0]
      have : 0 ≤ ν * R := (abs_nonneg _).trans hq
      nlinarith
    _ = 4 * ν * R := by ring

/-- Blueprint `eq:applied-sparse` for four cores (lines 2731-2741): tested four-core tuples with
reference data (`FourRef`), separation of distinct same-role labels against the reserved shifts
`|n| ≤ Q` with gap `Σ max(R_s, R_t)`, the pure-shift gap and scale multiplicity `L` satisfy the
hypotheses of `lem:sparse-count` (pair determination by `four_core_pair`, annular witnesses by
`four_core_ann` with `ν, B` replaced by `4ν, 4B`), hence
`Σ_{N_s ≤ δ M²} N_s ≤ C ℓ L^{12} δ^{1/300} M²`. -/
theorem four_core_sparse_count :
    ∃ C Cres : ℝ, 0 < C ∧ 0 < Cres ∧
    ∀ (d : ℕ) (ζ : Fin d → ℝ) (A : Fin 4 → Finset ℝ) (M L : ℝ), 1 ≤ M → 1 ≤ L →
    (∀ i, ((A i).card : ℝ) ≤ M) →
    ∀ (B Sg Q μ ν R₀ : ℝ), 1 ≤ B → 0 < μ → μ ≤ 1 → 1 ≤ ν → 0 < R₀ →
    ∀ (S : Finset ℤ) (E : ℤ → Finset (Fin 4 → ℝ)),
    (∀ s ∈ S, ∀ x ∈ E s, ∀ i, x i ∈ A i) →
    (∀ x, ((S.filter fun s => x ∈ E s).card : ℝ) ≤ L) →
    (∀ s ∈ S, ∀ x ∈ E s, FourRef ζ B μ ν (R₀ * 2 ^ s) x) →
    (∀ i, ∀ s ∈ S, ∀ s' ∈ S, ∀ x ∈ E s, ∀ x' ∈ E s', x i ≠ x' i →
      ∀ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
        Sg * max (R₀ * 2 ^ s) (R₀ * 2 ^ s') < |x i - x' i + ∑ k, (n k : ℝ) * ζ k|) →
    (∀ s ∈ S, (E s).Nonempty → ∀ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
      |∑ k, (n k : ℝ) * ζ k| ∉ Set.Icc (μ * (R₀ * 2 ^ s) / 1000) (1000 * (4 * ν) * (R₀ * 2 ^ s))) →
    Cres * ((d : ℝ) + 1) ^ 2 * (4 * B) ≤ Q → 288 * B ≤ Q →
    Cres * ((d : ℝ) + 1) ^ 2 * (4 * ν) ≤ Sg → 8 * ν ≤ Sg →
    ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ S.filter (fun s => ((E s).card : ℝ) ≤ δ * M ^ 2), ((E s).card : ℝ) ≤
        C * (1 + Real.logb 2 (2 + ((d : ℝ) + 1) ^ 2 * (4 * ν) / μ)) * L ^ 12 *
          δ ^ (1 / 300 : ℝ) * M ^ 2 := by
  obtain ⟨C, Cres, hC, hCres, hsc⟩ := sparse_count
  refine ⟨C, Cres, hC, hCres, ?_⟩
  intro d ζ A M L hM hL hA B Sg Q μ ν R₀ hB hμ hμ1 hν hR₀ S E hE hmult href hsep hgap hQ hQ'
    hSg hSg' δ hδ0 hδ1
  have hc : (Finset.univ : Finset (Fin 4)).card = 4 := by simp
  refine hsc d ζ Finset.univ (Or.inr hc) A M L hM hL (fun i _ => hA i) (4 * B) Sg Q μ (4 * ν)
    R₀ (by linarith) hμ hμ1 (by linarith) hR₀ S E
    (fun s hs x hx => ⟨fun i _ => hE s hs x hx i, fun i hi => absurd (Finset.mem_univ i) hi⟩)
    (fun i _ j _ hij s hs s' hs' x hx x' hx' hxi hxj => ?_) hmult
    (fun h => by rw [hc] at h; norm_num at h) (fun i _ s hs s' hs' x hx x' hx' => hsep i s hs s'
      hs' x hx x' hx') (fun T _ hT l hl s hs x hx => ?_) hgap hQ hSg δ hδ0 hδ1
  · have hRs : 0 ≤ R₀ * 2 ^ s := by positivity
    exact four_core_pair ζ hij hxi hxj (href s hs x hx) (href s' hs' x' hx')
      (fun r hr N hN => hsep r s hs s' hs' x hx x' hx' hr N hN) hQ' hSg' (by linarith) hRs
  · obtain ⟨n, hn, h1, h2⟩ := four_core_ann ζ (href s hs x hx) hT hl
    exact ⟨n, hn, h1, by linarith⟩

theorem sum_erase_roleCoeff {i j k l : Fin 4} (hkl : k ≠ l) (hki : k ≠ i) (hkj : k ≠ j)
    (hli : l ≠ i) (hlj : l ≠ j) (hij : i ≠ j) (f : Fin 4 → ℝ) (hi : f i = 0) (hj : f j = 0) :
    ∑ r ∈ Finset.univ.erase l, (roleCoeff r l : ℝ) * f r = (roleCoeff k l : ℝ) * f k := by
  rw [Finset.sum_erase _ (by simp [roleCoeff]), fin4_sum_eq hkl hki hkj hli hlj hij]
  simp [hi, hj, roleCoeff]

/-- Blueprint line 2717 ("for three cores the single `T_l` equation determines the remaining
label in the same way"): two three-core tested tuples sharing labels in two distinct core roles
are equal, given separation with reserve `72 B ≤ Q`, `2ν ≤ Σ`. -/
theorem three_core_pair {d : ℕ} (ζ : Fin d → ℝ) {l : Fin 4} {x x' : Fin 4 → ℝ}
    (hxl : x l = 0) (hxl' : x' l = 0) {i j : Fin 4} (hij : i ≠ j) (hil : i ≠ l) (hjl : j ≠ l)
    (hxi : x i = x' i) (hxj : x j = x' j) {B Q Sg μ ν R R' : ℝ}
    (hx : ThreeRef ζ l B μ ν R x) (hx' : ThreeRef ζ l B μ ν R' x')
    (hsep : ∀ r, x r ≠ x' r → ∀ N : Fin d → ℤ, (∀ p, |(N p : ℝ)| ≤ Q) →
      Sg * max R R' < |x r - x' r + ∑ p, (N p : ℝ) * ζ p|)
    (hQ : 72 * B ≤ Q) (hSg : 2 * ν ≤ Sg) (hν : 0 ≤ ν) (hR : 0 ≤ R) : x = x' := by
  obtain ⟨m, hm, -, ht⟩ := hx
  obtain ⟨m', hm', -, ht'⟩ := hx'
  obtain ⟨k₀, l₀, hkl₀, hki₀, hkj₀, hli₀, hlj₀, hcov⟩ := fin4_complement i j hij
  -- the third core role `k`
  obtain ⟨k, hkl, hki, hkj, hcov'⟩ : ∃ k : Fin 4, k ≠ l ∧ k ≠ i ∧ k ≠ j ∧
      ∀ r : Fin 4, r = i ∨ r = j ∨ r = k ∨ r = l := by
    rcases hcov l with h | h | h | h
    · exact absurd h.symm hil
    · exact absurd h.symm hjl
    · subst h
      exact ⟨l₀, hkl₀.symm, hli₀, hlj₀, fun r => by
        rcases hcov r with h | h | h | h <;> simp [h]⟩
    · subst h
      exact ⟨k₀, hkl₀, hki₀, hkj₀, fun r => by
        rcases hcov r with h | h | h | h <;> simp [h]⟩
  obtain ⟨_, β, hβ⟩ := roleCoeff_spec hkl
  have hβ3 : |β| ≤ 6 := by
    have h0 : roleCoeff k l ≠ 0 := by rintro h; rw [h] at hβ; simp at hβ
    have : (1 : ℤ) ≤ |roleCoeff k l| := Int.one_le_abs h0
    have h6 : |roleCoeff k l| * |β| = 6 := by rw [← abs_mul, hβ]; rfl
    nlinarith [abs_nonneg β]
  have hrc1 : (1 : ℝ) ≤ |(roleCoeff k l : ℝ)| := by
    have h0 : roleCoeff k l ≠ 0 := by rintro h; rw [h] at hβ; simp at hβ
    rw [← Int.cast_abs]; exact_mod_cast Int.one_le_abs h0
  have hβr : ((roleCoeff k l : ℤ) : ℝ) * (β : ℝ) = 6 := by exact_mod_cast hβ
  -- the difference equation for role `k`
  have hdiff := sum_erase_roleCoeff hkl hki hkj (fun h => hil h.symm) (fun h => hjl h.symm) hij
    (fun r => x r - x' r) (by simp [hxi]) (by simp [hxj])
  simp only [mul_sub, Finset.sum_sub_distrib] at hdiff
  set N : Fin d → ℤ := fun p => 6 * β * (m p - m' p) with hN
  have hNb : ∀ p, |(N p : ℝ)| ≤ Q := by
    intro p
    simp only [hN]; push_cast
    rw [abs_mul, abs_mul]
    have hb : |(β : ℝ)| ≤ 6 := by exact_mod_cast hβ3
    have e : |(m p : ℝ) - m' p| ≤ 2 * B := (abs_sub _ _).trans (by linarith [hm p, hm' p])
    calc |(6 : ℝ)| * |(β : ℝ)| * |(m p : ℝ) - m' p| ≤ 6 * 6 * (2 * B) := by
          rw [abs_of_pos (by norm_num : (0 : ℝ) < 6)]; gcongr
      _ ≤ Q := by linarith
  have hkey : (roleCoeff k l : ℝ) * (x k - x' k + ∑ p, (N p : ℝ) * ζ p) =
      (∑ i ∈ Finset.univ.erase l, (roleCoeff i l : ℝ) * x i + 36 * ∑ p, (m p : ℝ) * ζ p) -
      (∑ i ∈ Finset.univ.erase l, (roleCoeff i l : ℝ) * x' i + 36 * ∑ p, (m' p : ℝ) * ζ p) := by
    have e : (roleCoeff k l : ℝ) * ∑ p, (N p : ℝ) * ζ p =
        36 * ∑ p, (m p : ℝ) * ζ p - 36 * ∑ p, (m' p : ℝ) * ζ p := by
      rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun p _ => ?_
      simp only [hN]; push_cast
      linear_combination (6 * ((m p : ℝ) - m' p) * ζ p) * hβr
    rw [mul_add, e, mul_sub, ← hdiff]; ring
  have hk : x k = x' k := by
    by_contra hne
    have h1 := hsep k hne N hNb
    have h2 : |x k - x' k + ∑ p, (N p : ℝ) * ζ p| ≤ 2 * ν * max R R' := by
      have := congrArg abs hkey
      rw [abs_mul] at this
      calc _ ≤ |(roleCoeff k l : ℝ)| * |x k - x' k + ∑ p, (N p : ℝ) * ζ p| :=
            le_mul_of_one_le_left (abs_nonneg _) hrc1
        _ = _ := this
        _ ≤ ν * R + ν * R' := (abs_sub _ _).trans (add_le_add ht ht')
        _ ≤ 2 * ν * max R R' := by
          nlinarith [mul_le_mul_of_nonneg_left (le_max_left R R') hν,
            mul_le_mul_of_nonneg_left (le_max_right R R') hν]
    have h3 : 2 * ν * max R R' ≤ Sg * max R R' :=
      mul_le_mul_of_nonneg_right hSg (le_max_of_le_left hR)
    linarith
  funext r
  rcases hcov' r with rfl | rfl | rfl | rfl
  · exact hxi
  · exact hxj
  · exact hk
  · rw [hxl, hxl']

/-- Blueprint `eq:applied-sparse` for three cores and side role `l` (lines 2724-2741): tested
tuples with the `T_l` reference (`ThreeRef`), side incidence weights `w_s` (`Σ w_s ≤ M`),
separation, the pure-shift gap and scale multiplicity `L` satisfy `lem:sparse-count` (pair
determination by `three_core_pair`), hence `Σ_{N_s ≤ δ M²} N_s ≤ C ℓ L^{12} δ^{1/300} M²`. -/
theorem three_core_sparse_count :
    ∃ C Cres : ℝ, 0 < C ∧ 0 < Cres ∧
    ∀ (d : ℕ) (ζ : Fin d → ℝ) (l : Fin 4) (A : Fin 4 → Finset ℝ) (M L : ℝ), 1 ≤ M → 1 ≤ L →
    (∀ i, i ≠ l → ((A i).card : ℝ) ≤ M) →
    ∀ (B Sg Q μ ν R₀ : ℝ), 1 ≤ B → 0 < μ → μ ≤ 1 → 1 ≤ ν → 0 < R₀ →
    ∀ (S : Finset ℤ) (E : ℤ → Finset (Fin 4 → ℝ)),
    (∀ s ∈ S, ∀ x ∈ E s, (∀ i, i ≠ l → x i ∈ A i) ∧ x l = 0) →
    (∀ x, ((S.filter fun s => x ∈ E s).card : ℝ) ≤ L) →
    (∃ w : ℤ → ℝ, (∀ s, 0 ≤ w s) ∧ ∑ s ∈ S, w s ≤ M ∧
      ∀ s ∈ S, ∀ i, i ≠ l → ∀ a, (((E s).filter fun x => x i = a).card : ℝ) ≤ w s) →
    (∀ s ∈ S, ∀ x ∈ E s, ThreeRef ζ l B μ ν (R₀ * 2 ^ s) x) →
    (∀ i, ∀ s ∈ S, ∀ s' ∈ S, ∀ x ∈ E s, ∀ x' ∈ E s', x i ≠ x' i →
      ∀ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
        Sg * max (R₀ * 2 ^ s) (R₀ * 2 ^ s') < |x i - x' i + ∑ k, (n k : ℝ) * ζ k|) →
    (∀ s ∈ S, (E s).Nonempty → ∀ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
      |∑ k, (n k : ℝ) * ζ k| ∉ Set.Icc (μ * (R₀ * 2 ^ s) / 1000) (1000 * ν * (R₀ * 2 ^ s))) →
    Cres * ((d : ℝ) + 1) ^ 2 * B ≤ Q → 72 * B ≤ Q →
    Cres * ((d : ℝ) + 1) ^ 2 * ν ≤ Sg → 2 * ν ≤ Sg →
    ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ S.filter (fun s => ((E s).card : ℝ) ≤ δ * M ^ 2), ((E s).card : ℝ) ≤
        C * (1 + Real.logb 2 (2 + ((d : ℝ) + 1) ^ 2 * ν / μ)) * L ^ 12 *
          δ ^ (1 / 300 : ℝ) * M ^ 2 := by
  obtain ⟨C, Cres, hC, hCres, hsc⟩ := sparse_count
  refine ⟨C, Cres, hC, hCres, ?_⟩
  intro d ζ l A M L hM hL hA B Sg Q μ ν R₀ hB hμ hμ1 hν hR₀ S E hE hmult hw href hsep hgap hQ
    hQ' hSg hSg' δ hδ0 hδ1
  have hc : (Finset.univ.erase l).card = 3 := by simp
  have hmemc : ∀ i, i ∈ Finset.univ.erase l ↔ i ≠ l := fun i => by simp
  obtain ⟨w, hw0, hwsum, hwinc⟩ := hw
  refine hsc d ζ (Finset.univ.erase l) (Or.inl hc) A M L hM hL
    (fun i hi => hA i ((hmemc i).mp hi)) B Sg Q μ ν R₀ hB hμ hμ1 hν hR₀ S E
    (fun s hs x hx => ⟨fun i hi => (hE s hs x hx).1 i ((hmemc i).mp hi), fun i hi => by
      have : i = l := by by_contra h; exact hi ((hmemc i).mpr h)
      rw [this]; exact (hE s hs x hx).2⟩)
    (fun i hi j hj hij s hs s' hs' x hx x' hx' hxi hxj => ?_) hmult
    (fun _ => ⟨w, hw0, hwsum, fun s hs i hi a => hwinc s hs i ((hmemc i).mp hi) a⟩)
    (fun i _ s hs s' hs' x hx x' hx' => hsep i s hs s' hs' x hx x' hx')
    (fun T hT hT3 l' hl' s hs x hx => ?_) hgap hQ hSg δ hδ0 hδ1
  · have hRs : 0 ≤ R₀ * 2 ^ s := by positivity
    exact three_core_pair ζ (hE s hs x hx).2 (hE s' hs' x' hx').2 hij ((hmemc i).mp hi)
      ((hmemc j).mp hj) hxi hxj (href s hs x hx) (href s' hs' x' hx')
      (fun r hr N hN => hsep r s hs s' hs' x hx x' hx' hr N hN) hQ' hSg' (by linarith) hRs
  · have hTe : T = Finset.univ.erase l :=
      Finset.eq_of_subset_of_card_le hT (by rw [hc, hT3])
    have hll : l' = l := by
      by_contra h; exact hl' (hTe ▸ (hmemc l').mpr h)
    subst hTe hll
    exact href s hs x hx

theorem sum_erase_roleCoeff_eq (l : Fin 4) (x : Fin 4 → ℝ) :
    ∑ i ∈ Finset.univ.erase l, (roleCoeff i l : ℝ) * x i =
      ∑ r : Fin 4, ((r : ℕ) : ℝ) * x r - ((l : ℕ) : ℝ) * ∑ r, x r := by
  rw [Finset.sum_erase _ (by simp [roleCoeff]), Finset.mul_sum, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun r _ => ?_
  simp only [roleCoeff]; push_cast; ring

/-- Blueprint lines 2724-2725 (core/side pair, windows): two three-core tested tuples at one
scale `R`, sharing the label of a core role `i`, whose side windows meet (their `Q` values
`Σ x_r + 36 n·ζ` differ by at most `4ΛR` for box shifts `n, n'`) are equal: with the two `T_l`
equations the two other labels solve a two-by-two system of divisor at most `3`, and separation
with `8ν + 48Λ ≤ Σ`, `1152 B ≤ Q` forces equality. -/
theorem side_window_pair {d : ℕ} (ζ : Fin d → ℝ) {l i : Fin 4} (hil : i ≠ l) {x x' : Fin 4 → ℝ}
    (hxl : x l = 0) (hxl' : x' l = 0) (hxi : x i = x' i) {B Q Sg μ ν Λ R : ℝ}
    (hx : ThreeRef ζ l B μ ν R x) (hx' : ThreeRef ζ l B μ ν R x') {n n' : Fin d → ℤ}
    (hn : ∀ p, |(n p : ℝ)| ≤ B) (hn' : ∀ p, |(n' p : ℝ)| ≤ B)
    (hwin : |(∑ r, x r + 36 * ∑ p, (n p : ℝ) * ζ p) -
      (∑ r, x' r + 36 * ∑ p, (n' p : ℝ) * ζ p)| ≤ 4 * Λ * R)
    (hsep : ∀ r, x r ≠ x' r → ∀ N : Fin d → ℤ, (∀ p, |(N p : ℝ)| ≤ Q) →
      Sg * R < |x r - x' r + ∑ p, (N p : ℝ) * ζ p|)
    (hQ : 1152 * B ≤ Q) (hSg : 8 * ν + 48 * Λ ≤ Sg) (hR : 0 ≤ R) : x = x' := by
  obtain ⟨m, hm, -, ht⟩ := hx
  obtain ⟨m', hm', -, ht'⟩ := hx'
  obtain ⟨k₀, l₀, hkl₀, hki₀, hkl₀', hli₀, hll₀, hcov⟩ := fin4_complement i l hil
  have hl3 : ((l : ℕ) : ℝ) ≤ 3 := by have := l.isLt; exact_mod_cast (by omega : (l : ℕ) ≤ 3)
  have hl0 : (0 : ℝ) ≤ (l : ℕ) := Nat.cast_nonneg _
  set M : Fin d → ℤ := fun p => m p + (l : ℕ) * n p with hM
  set M' : Fin d → ℤ := fun p => m' p + (l : ℕ) * n' p with hM'
  have hMb : ∀ (a b : Fin d → ℤ), (∀ p, |(a p : ℝ)| ≤ B) → (∀ p, |(b p : ℝ)| ≤ B) →
      ∀ p, |((a p + (l : ℕ) * b p : ℤ) : ℝ)| ≤ 4 * B := by
    intro a b ha hb p
    push_cast
    calc _ ≤ |(a p : ℝ)| + |((l : ℕ) : ℝ) * b p| := abs_add_le _ _
      _ = |(a p : ℝ)| + ((l : ℕ) : ℝ) * |(b p : ℝ)| := by rw [abs_mul, abs_of_nonneg hl0]
      _ ≤ B + 3 * B := by
        have := ha p; have := hb p
        have hB : 0 ≤ B := (abs_nonneg _).trans (hb p)
        nlinarith
      _ = 4 * B := by ring
  have hid : ∀ (y : Fin 4 → ℝ) (a b : Fin d → ℤ),
      ∑ r : Fin 4, ((r : ℕ) : ℝ) * y r + 36 * ∑ p, ((a p + (l : ℕ) * b p : ℤ) : ℝ) * ζ p =
        (∑ i ∈ Finset.univ.erase l, (roleCoeff i l : ℝ) * y i + 36 * ∑ p, (a p : ℝ) * ζ p) +
          ((l : ℕ) : ℝ) * (∑ r, y r + 36 * ∑ p, (b p : ℝ) * ζ p) := by
    intro y a b
    rw [sum_erase_roleCoeff_eq]
    push_cast
    simp only [add_mul, Finset.sum_add_distrib, mul_assoc, ← Finset.mul_sum]
    ring
  have hTd : |(∑ r : Fin 4, ((r : ℕ) : ℝ) * x r + 36 * ∑ p, (M p : ℝ) * ζ p) -
      (∑ r : Fin 4, ((r : ℕ) : ℝ) * x' r + 36 * ∑ p, (M' p : ℝ) * ζ p)| ≤
      2 * ν * R + 12 * Λ * R := by
    rw [hM, hM', hid, hid]
    have e : ∀ a b c e' : ℝ, (a + ((l : ℕ) : ℝ) * b) - (c + ((l : ℕ) : ℝ) * e') =
        (a - c) + ((l : ℕ) : ℝ) * (b - e') := fun _ _ _ _ => by ring
    rw [e]
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul, abs_of_nonneg hl0]
    have h1 := (abs_sub _ _).trans (add_le_add ht ht')
    have h2 : ((l : ℕ) : ℝ) * |(∑ r, x r + 36 * ∑ p, (n p : ℝ) * ζ p) -
        (∑ r, x' r + 36 * ∑ p, (n' p : ℝ) * ζ p)| ≤ 3 * (4 * Λ * R) :=
      mul_le_mul hl3 hwin (abs_nonneg _) (by norm_num)
    linarith
  have hνR : 0 ≤ ν * R := (abs_nonneg _).trans ht
  have hΛR : 0 ≤ Λ * R := by have := (abs_nonneg _).trans hwin; linarith
  have hrole : ∀ k, k ≠ i → k ≠ l → x k = x' k := by
    intro k hki hkl
    obtain ⟨k', hk'⟩ : ∃ k', k' ≠ k ∧ k' ≠ i ∧ k' ≠ l := by
      rcases hcov k with h | h | h | h
      · exact absurd h hki
      · exact absurd h hkl
      · subst h; exact ⟨l₀, hkl₀.symm, hli₀, hll₀⟩
      · subst h; exact ⟨k₀, hkl₀, hki₀, hkl₀'⟩
    exact pair_role_of_diff ζ hk'.1.symm hki hkl hk'.2.1 hk'.2.2 hil hxi (by rw [hxl, hxl'])
      (B := 4 * B) (n := n) (m := M) (n' := n') (m' := M')
      (fun p => by have := hn p; have := (abs_nonneg _).trans (hn p); linarith)
      (hMb m n hm hn) (fun p => by have := hn' p; have := (abs_nonneg _).trans (hn' p); linarith)
      (hMb m' n' hm' hn') (ε := 2 * ν * R + 12 * Λ * R) (by linarith) hTd
      (fun h N hN => hsep k h N hN) (by linarith) (by nlinarith)
  funext r
  by_cases hri : r = i
  · rw [hri]; exact hxi
  by_cases hrl : r = l
  · rw [hrl, hxl, hxl']
  exact hrole r hri hrl

theorem mem_sideWindow {d : ℕ} {ζ : Fin d → ℝ} {r Λ B : ℝ} {x : Fin 4 → ℝ} {k : ℤ} :
    k ∈ sideWindow ζ r Λ B x ↔ ∃ n : Fin d → ℤ, (∀ p, |(n p : ℝ)| ≤ B) ∧
      |(k : ℝ) - r * (∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p)| ≤ 2 * Λ := by
  simp only [sideWindow, Finset.mem_biUnion, Fintype.mem_piFinset, Finset.mem_Icc,
    Int.ceil_le, Int.le_floor]
  refine exists_congr fun n => and_congr ?_ ?_
  · refine forall_congr' fun p => ?_
    rw [abs_le]
    constructor
    · rintro ⟨h1, h2⟩
