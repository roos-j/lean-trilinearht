theorem four_core_pair {d : ℕ} (ζ : Fin d → ℝ) {x x' : Fin 4 → ℝ} {i j : Fin 4} (hij : i ≠ j)
    (hxi : x i = x' i) (hxj : x j = x' j) {B Q Sg μ ν R R' : ℝ}
    (hx : FourRef ζ B μ ν R x) (hx' : FourRef ζ B μ ν R' x')
    (hsep : ∀ r, x r ≠ x' r → ∀ N : Fin d → ℤ, (∀ p, |(N p : ℝ)| ≤ Q) →
      Sg * max R R' < |x r - x' r + ∑ p, (N p : ℝ) * ζ p|)
    (hQ : 288 * B ≤ Q) (hSg : 8 * ν ≤ Sg) (hν : 0 ≤ ν) (hR : 0 ≤ R) : x = x' := by
  obtain ⟨n, m, hn, hm, hq, ht, -⟩ := hx
  obtain ⟨n', m', hn', hm', hq', ht', -⟩ := hx'
  obtain ⟨k, l, hkl, hki, hkj, hli, hlj, hcov⟩ := fin4_complement i j hij
  have hk := four_core_pair_role ζ hkl hki hkj hli hlj hij hxi hxj hn hm hn' hm' hq ht hq' ht'
    (hsep k) hQ hSg hν hR
