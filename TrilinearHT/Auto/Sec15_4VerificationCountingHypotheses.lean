/-- An integer vector with real entries at most `N` lies in the frequency box of size `N`. -/
theorem mem_frequencyBox_of_abs_le {d N : ℕ} {n : Fin d → ℤ} (h : ∀ i, |(n i : ℝ)| ≤ N) :
    n ∈ frequencyBox d N := by
  refine Fintype.mem_piFinset.mpr fun i => Finset.mem_Icc.mpr ?_
  have := h i
  rw [abs_le] at this
  constructor <;> [exact_mod_cast this.1; exact_mod_cast this.2]

