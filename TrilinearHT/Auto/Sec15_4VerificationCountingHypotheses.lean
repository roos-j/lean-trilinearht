/-- Blueprint lines 2708-2745 for three cores and side role `l` on an attempt
(`eq:total-count`, `eq:applied-sparse`): as in `four_core_tested_counts`, with the `T_l` test
(`ThreeRef`). For the side, each tested triple at scale `s` lies in the side bin: its averaged
window energy of the side `S_s` on the cell `I_s` is at least `r_s² σ_l²` (`b_Λ ≥ σ_l`). Windows of
distinct triples sharing a core label are disjoint (`sideWindow_disjoint`), so Bessel and the
offset average bound the triples incident to a fixed core label by
`w_s = σ_l^{-2} r_s^{-1} ∫_{I_s} |S_s|²`. With `Σ_s w_s ≤ M` this gives, for core roles
`i ≠ j`, `Σ_s N_s ≤ L₀ M_i M_j`, for a core/side pair `Σ_s N_s ≤ M_i Σ_s w_s`, `N_s ≤ M²`, and
`Σ_{N_s ≤ δM²} N_s ≤ C ℓ L₀^{12} δ^{1/300} M²`. -/
theorem three_core_tested_counts (G : A.Grp) (z : ChartTag) (hz : ∀ j, (D.Ms j G).zc = z)
    (Δ h : ℕ) (Nd : ∀ j, Finset (ℤ × (ℤ × ℤ) × (D.Ms j G).Md))
    (hNd : ∀ j, ∀ c ∈ Nd j, c.2.1.1 = c.1 - 2 * D.S.K)
    (halive : ∀ j, ∀ c ∈ Nd j, c.2.2 ∈ (D.Ms j G).alive (ancAt A.G c.2.1 (c.1 - 4 * D.S.K)))
    (hdist : ∀ j, ∀ c (hc : c ∈ Nd j) c' (hc' : c' ∈ Nd j) (h1 : c.1 = c'.1)
      (h2 : c.2.1 = c'.2.1), c ≠ c' → (⟨c'.2.2, by rw [h1, h2]; exact halive j c' hc'⟩ :
        (D.Ms j G).alive (ancAt A.G c.2.1 (c.1 - 4 * D.S.K))) ∉
        ((D.Ms j G).blockComps D.S D.hA c.1 c.2.1).F h ⟨c.2.2, halive j c hc⟩)
    (rep : ∀ j, ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ j c, rep j c ∈ (D.Ms j G).predOfMode D.S D.hA Δ h c)
    (hsepF : ∀ j c c', ModeSystem.nodeLt3 (D.Ms j G) (Nd j) c c' → rep j c ≠ rep j c' →
      ∀ z z' : (D.Ms j G).alive (ancAt A.G c'.2.1 (c'.1 - 4 * D.S.K)),
        z.1 ∈ (D.Ms j G).predOfMode D.S D.hA Δ h c →
        z'.1 ∈ (D.Ms j G).predOfMode D.S D.hA Δ h c' →
        z ∉ ((D.Ms j G).blockComps D.S D.hA c'.1 c'.2.1).F h z')
    (hΛ : ∀ j, 8 * (D.Ms j G).Λ ≤ D.S.Ξ) {y : ℝ}
    (hy : ∀ j, ∀ c ∈ Nd j, y ∈ dyadicGridCell A.G c.2.1.1 c.2.1.2) (cq : ℕ) {Q : ℝ}
    (hcQ : cq * Q ≤ D.S.Eh h) (l : Fin 4) (S : Finset ℤ) (E : ℤ → Finset (Fin 4 → ℝ))
    (hE : ∀ s ∈ S, ∀ x ∈ E s, x l = 0 ∧ ∀ j, j ≠ l → ∃ c ∈ Nd j,
      x j = (D.Ms j G).slope (rep j c) y ∧ c.1 ≤ s ∧ s < c.1 + D.S.K)
    (Al : Fin 4 → Finset ℝ) (hAl : ∀ s ∈ S, ∀ x ∈ E s, ∀ j, j ≠ l → x j ∈ Al j) {M : ℝ}
    (hM : 1 ≤ M) (hAM : ∀ j, j ≠ l → ((Al j).card : ℝ) ≤ M) {B μ ν Λs : ℝ} (hB : 1 ≤ B)
    (hμ : 0 < μ) (hμ1 : μ ≤ 1) (hν : 1 ≤ ν)
    (href : ∀ s ∈ S, ∀ x ∈ E s,
      ThreeRef (D.sepVec z cq h) l B μ ν (A.G.baseLength⁻¹ * 2 ^ s) x)
    (pos : ℤ → ℤ) (X : ℤ → ColumnL2 (Fin ap.Mc)) {σl : ℝ} (hσl : 0 < σl)
    (hbin : ∀ s ∈ S, ∀ x ∈ E s, (dyadicGridLength A.G s) ^ 2 * σl ^ 2 ≤
      ∫ ρ, sideWinE z l (augPhys (X s)) (dyadicGridLeft A.G s (pos s)) (dyadicGridLength A.G s)
        (sideWindow (D.sepVec z cq h) (dyadicGridLength A.G s) Λs B x) ρ ∂offsetMeasure z.dim)
    (hMl : ∑ s ∈ S, (σl ^ 2)⁻¹ * ((dyadicGridLength A.G s)⁻¹ *
      ∫ y in dyadicGridLeft A.G s (pos s)..dyadicGridLeft A.G s (pos s) + dyadicGridLength A.G s,
        ‖augPhys (X s) y‖ ^ 2) ≤ M)
    {ε₀ Λ₀ : ℝ} (hpure : ∀ n : Fin z.dim → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
      |∑ k, (n k : ℝ) * z.θ k| ≤ ε₀ ∨ Λ₀ ≤ |∑ k, (n k : ℝ) * z.θ k|)
    (hsmall : ∀ s ∈ S, (cq : ℝ) / D.S.Q0 / ModeSchedule.Lh h * ε₀ <
      μ * (A.G.baseLength⁻¹ * 2 ^ s) / 1000)
    (hlarge : ∀ s ∈ S, 1000 * (4 * ν) * (A.G.baseLength⁻¹ * 2 ^ s) <
      (cq : ℝ) / D.S.Q0 / ModeSchedule.Lh h * Λ₀)
    (hQ1 : sparseCres3 * ((z.dim : ℝ) + 1) ^ 2 * B ≤ Q) (hQ2 : 1152 * B ≤ Q)
    (hS1 : sparseCres3 * ((z.dim : ℝ) + 1) ^ 2 * ν ≤ D.S.Ξ / 2)
    (hS2 : 8 * ν + 48 * Λs ≤ D.S.Ξ / 2) (hΛs : 0 ≤ Λs) :
    (∀ i j, i ≠ j → i ≠ l → j ≠ l →
      ∑ s ∈ S, ((E s).card : ℝ) ≤ threeMult z.dim B μ ν * (Al i).card * (Al j).card) ∧
    (∀ i, i ≠ l → ∑ s ∈ S, ((E s).card : ℝ) ≤ (Al i).card * ∑ s ∈ S, (σl ^ 2)⁻¹ *
      ((dyadicGridLength A.G s)⁻¹ * ∫ y in dyadicGridLeft A.G s (pos s)..dyadicGridLeft A.G s
        (pos s) + dyadicGridLength A.G s, ‖augPhys (X s) y‖ ^ 2)) ∧
    (∀ i j, i ≠ j → i ≠ l → j ≠ l → ∀ s ∈ S, ((E s).card : ℝ) ≤ M ^ 2) ∧
    ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ S.filter (fun s => ((E s).card : ℝ) ≤ δ * M ^ 2), ((E s).card : ℝ) ≤
        sparseC3 * (1 + Real.logb 2 (2 + ((z.dim : ℝ) + 1) ^ 2 * ν / μ)) *
          threeMult z.dim B μ ν ^ 12 * δ ^ (1 / 300 : ℝ) * M ^ 2 := by
  have hR₀ : 0 < A.G.baseLength⁻¹ := inv_pos.mpr A.G.baseLength_pos
  have hRs : ∀ s : ℤ, 0 ≤ A.G.baseLength⁻¹ * 2 ^ s := fun s => by positivity
  set w : ℤ → ℝ := fun s => (σl ^ 2)⁻¹ * ((dyadicGridLength A.G s)⁻¹ *
    ∫ y in dyadicGridLeft A.G s (pos s)..dyadicGridLeft A.G s (pos s) + dyadicGridLength A.G s,
      ‖augPhys (X s) y‖ ^ 2) with hw
  -- separation of distinct labels in the core roles (the side labels are all `0`)
  have hsep : ∀ i, ∀ s ∈ S, ∀ s' ∈ S, ∀ x ∈ E s, ∀ x' ∈ E s', x i ≠ x' i →
      ∀ n : Fin z.dim → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
        D.S.Ξ / 2 * max (A.G.baseLength⁻¹ * 2 ^ s) (A.G.baseLength⁻¹ * 2 ^ s') <
          |x i - x' i + ∑ k, (n k : ℝ) * D.sepVec z cq h k| := by
    intro i s hs s' hs' x hx x' hx' hne n hn
    have hil : i ≠ l := fun hil => hne (by rw [hil, (hE s hs x hx).1, (hE s' hs' x' hx').1])
    have hL : ∀ t, ∀ a ∈ (if t ∈ S then (E t).image (fun x => x i) else ∅), ∃ c ∈ Nd i,
        a = (D.Ms i G).slope (rep i c) y ∧ c.1 ≤ t ∧ t < c.1 + D.S.K := by
      intro t a ha
      split_ifs at ha with ht
      · obtain ⟨x₀, hx₀, rfl⟩ := Finset.mem_image.mp ha
        exact (hE t ht x₀ hx₀).2 i hil
      · simp at ha
    exact (D.Ms i G).attempt_label_sep' D.S D.hA z (hz i) (Nd i) (hNd i) Δ h (halive i)
      (hdist i) (rep i) (hrep i) (hsepF i) (hΛ i) (hy i)
      (fun t => if t ∈ S then (E t).image (fun x => x i) else ∅) hL cq hcQ s s' (x i)
      (by rw [ite_eq_left_of_eq_true _ _ (eq_true hs)]; exact Finset.mem_image_of_mem _ hx)
      (x' i) (by
        rw [ite_eq_left_of_eq_true _ _ (eq_true hs')]; exact Finset.mem_image_of_mem _ hx')
      hne n hn
  -- multiplicity of a tuple over the scales
  have hmult : ∀ x, ((S.filter fun s => x ∈ E s).card : ℝ) ≤ threeMult z.dim B μ ν := by
    intro x
    refine le_trans ?_ (tested_scale_mult (D.sepVec z cq h) x (Finset.univ.erase l) l
      hB hμ (by linarith) hR₀ S)
    refine Nat.cast_le.mpr (Finset.card_le_card fun s hs => ?_)
    obtain ⟨hsS, hxE⟩ := Finset.mem_filter.mp hs
    exact Finset.mem_filter.mpr ⟨hsS, href s hsS x hxE⟩
  -- pair determination across all scales for two core roles
  have hpair : ∀ i j, i ≠ j → i ≠ l → j ≠ l → ∀ s ∈ S, ∀ s' ∈ S, ∀ x ∈ E s, ∀ x' ∈ E s',
      x i = x' i → x j = x' j → x = x' := fun i j hij hil hjl s hs s' hs' x hx x' hx' hxi hxj =>
    three_core_pair (D.sepVec z cq h) (hE s hs x hx).1 (hE s' hs' x' hx').1 hij hil hjl hxi hxj
      (href s hs x hx) (href s' hs' x' hx')
      (fun r hr N hN => hsep r s hs s' hs' x hx x' hx' hr N hN) (by linarith) (by linarith)
      (by linarith) (hRs s)
  -- side incidence: triples incident to a fixed core label at one scale
  have hinc : ∀ s ∈ S, ∀ i, i ≠ l → ∀ a, (((E s).filter fun x => x i = a).card : ℝ) ≤ w s := by
    intro s hs i hil a
    set r := dyadicGridLength A.G s with hr_def
    have hr : 0 < r := dyadicGridLength_pos A.G s
    have hRr : A.G.baseLength⁻¹ * 2 ^ s = r⁻¹ := baseLength_inv_zpow A.G s
    set a₀ := dyadicGridLeft A.G s (pos s)
    have hgm : Measurable (augPhys (X s)) := columnPhys_measurable (X s)
    have hL2 : MemLp (augPhys (X s)) 2 (volume.restrict (Set.Ioc a₀ (a₀ + r))) :=
      (memLp_column_coord (X s) none).restrict _
    have hdis : ∀ t ∈ (E s).filter (fun x => x i = a), ∀ t' ∈ (E s).filter (fun x => x i = a),
        t ≠ t' → Disjoint (sideWindow (D.sepVec z cq h) r Λs B t)
          (sideWindow (D.sepVec z cq h) r Λs B t') := by
      intro t ht t' ht' hne
      obtain ⟨htE, hti⟩ := Finset.mem_filter.mp ht
      obtain ⟨htE', hti'⟩ := Finset.mem_filter.mp ht'
      have h1 := href s hs t htE
