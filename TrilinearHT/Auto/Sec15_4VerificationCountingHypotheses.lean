      (Cd.refQ' h' a xs Bf) (Cd.refT' h' a xs Bf)‖ * (Cd.W * Gprod)
  else 0

/-- The numerical error constant of a four-core tuple at torus height `h'` (principal case,
`four_core_class_bound`). -/
noncomputable def classConst (h' : ℕ) : ℝ :=
  2 * localKernelSupBound κ' * (4 * (2 * Real.pi * (Cd.Bc * D.S.Ξ * (2 : ℝ)⁻¹ ^ (2 * D.S.K) +
      Cd.Λ * (2 : ℝ)⁻¹ ^ (8 * D.S.K))) + (8 * Cd.z.dim * Cd.δ'' * profR Cd.δ 1 +
