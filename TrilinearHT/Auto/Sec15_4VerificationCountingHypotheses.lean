theorem four_core_tested_counts (G : A.Grp) (z : ChartTag) (hz : ∀ j, (D.Ms j G).zc = z)
    (Δ h : ℕ) (Nd : ∀ j, Finset (ℤ × (ℤ × ℤ) × (D.Ms j G).Md))
    (hNd : ∀ j, ∀ c ∈ Nd j, c.2.1.1 = c.1 - 2 * D.S.K)
    (halive : ∀ j, ∀ c ∈ Nd j, c.2.2 ∈ (D.Ms j G).alive (ancAt A.G c.2.1 (c.1 - 4 * D.S.K)))
    (hdist : ∀ j, ∀ c (hc : c ∈ Nd j) c' (hc' : c' ∈ Nd j) (h1 : c.1 = c'.1)
      (h2 : c.2.1 = c'.2.1), c ≠ c' → (⟨c'.2.2, by rw [h1, h2]; exact halive j c' hc'⟩ :
        (D.Ms j G).alive (ancAt A.G c.2.1 (c.1 - 4 * D.S.K))) ∉
        ((D.Ms j G).blockComps D.S D.hA c.1 c.2.1).F h ⟨c.2.2, halive j c hc⟩)
    (rep : ∀ j, ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ j c, rep j c ∈ (D.Ms j G).predOfMode D.S D.hA Δ h c)
    (hsepF : ∀ j c c', ModeSystem.nodeLt3 (D.Ms j G) (Nd j) c c' → rep j c ≠ rep j c' →
      ∀ z z' : (D.Ms j G).alive (ancAt A.G c'.2.1 (c'.1 - 4 * D.S.K)),
        z.1 ∈ (D.Ms j G).predOfMode D.S D.hA Δ h c →
        z'.1 ∈ (D.Ms j G).predOfMode D.S D.hA Δ h c' →
        z ∉ ((D.Ms j G).blockComps D.S D.hA c'.1 c'.2.1).F h z')
    (hΛ : ∀ j, 8 * (D.Ms j G).Λ ≤ D.S.Ξ) {y : ℝ}
    (hy : ∀ j, ∀ c ∈ Nd j, y ∈ dyadicGridCell A.G c.2.1.1 c.2.1.2) (cq : ℕ) {Q : ℝ}
    (hcQ : cq * Q ≤ D.S.Eh h) (S : Finset ℤ) (E : ℤ → Finset (Fin 4 → ℝ))
    (hE : ∀ s ∈ S, ∀ x ∈ E s, ∀ j, ∃ c ∈ Nd j,
      x j = (D.Ms j G).slope (rep j c) y ∧ c.1 ≤ s ∧ s < c.1 + D.S.K)
    (Al : Fin 4 → Finset ℝ) (hAl : ∀ s ∈ S, ∀ x ∈ E s, ∀ j, x j ∈ Al j) {M : ℝ} (hM : 1 ≤ M)
    (hAM : ∀ j, ((Al j).card : ℝ) ≤ M) {B μ ν : ℝ} (hB : 1 ≤ B) (hμ : 0 < μ) (hμ1 : μ ≤ 1)
    (hν : 1 ≤ ν)
    (href : ∀ s ∈ S, ∀ x ∈ E s, FourRef (D.sepVec z cq h) B μ ν (A.G.baseLength⁻¹ * 2 ^ s) x)
    {ε₀ Λ₀ : ℝ} (hpure : ∀ n : Fin z.dim → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
      |∑ k, (n k : ℝ) * z.θ k| ≤ ε₀ ∨ Λ₀ ≤ |∑ k, (n k : ℝ) * z.θ k|)
    (hsmall : ∀ s ∈ S, (cq : ℝ) / D.S.Q0 / ModeSchedule.Lh h * ε₀ <
      μ * (A.G.baseLength⁻¹ * 2 ^ s) / 1000)
    (hlarge : ∀ s ∈ S, 1000 * (4 * ν) * (A.G.baseLength⁻¹ * 2 ^ s) <
      (cq : ℝ) / D.S.Q0 / ModeSchedule.Lh h * Λ₀)
    (hQ1 : sparseCres4 * ((z.dim : ℝ) + 1) ^ 2 * (4 * B) ≤ Q) (hQ2 : 288 * B ≤ Q)
    (hS1 : sparseCres4 * ((z.dim : ℝ) + 1) ^ 2 * (4 * ν) ≤ D.S.Ξ / 2) (hS2 : 8 * ν ≤ D.S.Ξ / 2) :
    (∀ i j, i ≠ j →
      ∑ s ∈ S, ((E s).card : ℝ) ≤ fourMult z.dim B μ ν * (Al i).card * (Al j).card) ∧
    (∀ s ∈ S, ((E s).card : ℝ) ≤ M ^ 2) ∧
    ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ S.filter (fun s => ((E s).card : ℝ) ≤ δ * M ^ 2), ((E s).card : ℝ) ≤
        sparseC4 * (1 + Real.logb 2 (2 + ((z.dim : ℝ) + 1) ^ 2 * (4 * ν) / μ)) *
          fourMult z.dim B μ ν ^ 12 * δ ^ (1 / 300 : ℝ) * M ^ 2 := by
  have hR₀ : 0 < A.G.baseLength⁻¹ := inv_pos.mpr A.G.baseLength_pos
  have hRs : ∀ s : ℤ, 0 ≤ A.G.baseLength⁻¹ * 2 ^ s := fun s => by positivity
  -- separation of distinct labels in every role
  have hsep : ∀ i, ∀ s ∈ S, ∀ s' ∈ S, ∀ x ∈ E s, ∀ x' ∈ E s', x i ≠ x' i →
      ∀ n : Fin z.dim → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
        D.S.Ξ / 2 * max (A.G.baseLength⁻¹ * 2 ^ s) (A.G.baseLength⁻¹ * 2 ^ s') <
          |x i - x' i + ∑ k, (n k : ℝ) * D.sepVec z cq h k| := by
    intro i s hs s' hs' x hx x' hx' hne n hn
    have hL : ∀ t, ∀ a ∈ (if t ∈ S then (E t).image (fun x => x i) else ∅), ∃ c ∈ Nd i,
        a = (D.Ms i G).slope (rep i c) y ∧ c.1 ≤ t ∧ t < c.1 + D.S.K := by
      intro t a ha
      split_ifs at ha with ht
      · obtain ⟨x₀, hx₀, rfl⟩ := Finset.mem_image.mp ha
        exact hE t ht x₀ hx₀ i
      · simp at ha
    exact (D.Ms i G).attempt_label_sep' D.S D.hA z (hz i) (Nd i) (hNd i) Δ h (halive i)
      (hdist i) (rep i) (hrep i) (hsepF i) (hΛ i) (hy i)
      (fun t => if t ∈ S then (E t).image (fun x => x i) else ∅) hL cq hcQ s s' (x i)
      (by rw [ite_eq_left_of_eq_true _ _ (eq_true hs)]; exact Finset.mem_image_of_mem _ hx) (x' i)
      (by rw [ite_eq_left_of_eq_true _ _ (eq_true hs')]; exact Finset.mem_image_of_mem _ hx')
      hne n hn
  -- multiplicity of a tuple over the scales
  have hT : (Finset.univ.erase (0 : Fin 4)).card = 3 := by
    rw [Finset.card_erase_of_mem (Finset.mem_univ _), Finset.card_univ, Fintype.card_fin]
  have hmult : ∀ x, ((S.filter fun s => x ∈ E s).card : ℝ) ≤ fourMult z.dim B μ ν := by
    intro x
    refine le_trans ?_ (tested_scale_mult (D.sepVec z cq h) x (Finset.univ.erase 0) 0
      (B := 4 * B) (ν := 4 * ν) (by linarith) hμ (by linarith) hR₀ S)
    refine Nat.cast_le.mpr (Finset.card_le_card fun s hs => ?_)
    obtain ⟨hsS, hxE⟩ := Finset.mem_filter.mp hs
    exact Finset.mem_filter.mpr ⟨hsS, four_core_ann _ (href s hsS x hxE) hT
      (Finset.notMem_erase 0 _)⟩
  -- pair determination across all scales
  have hpair : ∀ i j, i ≠ j → ∀ s ∈ S, ∀ s' ∈ S, ∀ x ∈ E s, ∀ x' ∈ E s',
      x i = x' i → x j = x' j → x = x' := fun i j hij s hs s' hs' x hx x' hx' hxi hxj =>
    four_core_pair (D.sepVec z cq h) hij hxi hxj (href s hs x hx) (href s' hs' x' hx')
      (fun r hr N hN => hsep r s hs s' hs' x hx x' hx' hr N hN) hQ2 hS2 (by linarith) (hRs s)
  refine ⟨fun i j hij => total_count_real S E Al (fun s hs x hx => ⟨hAl s hs x hx i,
    hAl s hs x hx j⟩) (hpair i j hij) hmult, fun s hs => ?_, ?_⟩
  · have hc := scale_count_le (E s) (fun x => (x 0, x 1)) (Al 0 ×ˢ Al 1)
      (fun x hx => Finset.mem_product.mpr ⟨hAl s hs x hx 0, hAl s hs x hx 1⟩)
      (fun x hx x' hx' he => by
        simp only [Prod.mk.injEq] at he
        exact hpair 0 1 (by decide) s hs s hs x hx x' hx' he.1 he.2)
    rw [Finset.card_product] at hc
    have hc' : ((E s).card : ℝ) ≤ ((Al 0).card : ℝ) * (Al 1).card := by exact_mod_cast hc
    nlinarith [hAM 0, hAM 1, Nat.cast_nonneg (α := ℝ) (Al 0).card,
      Nat.cast_nonneg (α := ℝ) (Al 1).card]
  · intro δ hδ0 hδ1
    obtain ⟨-, -, hsc⟩ := sparseC4_spec
    have hκ : 0 ≤ (cq : ℝ) / D.S.Q0 / ModeSchedule.Lh h :=
      div_nonneg (div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
        (by unfold ModeSchedule.Lh; positivity)
    have hζ : D.sepVec z cq h = fun k => (cq : ℝ) / D.S.Q0 / ModeSchedule.Lh h * z.θ k := by
      funext k; unfold sepVec; ring
    refine hsc z.dim (D.sepVec z cq h) Al M (fourMult z.dim B μ ν) hM
      (one_le_fourMult z.dim hB hμ (by linarith)) hAM B (D.S.Ξ / 2) Q μ ν
      A.G.baseLength⁻¹ hB hμ hμ1 hν hR₀ S E hAl hmult href hsep (fun s hs _ n hn => ?_)
      hQ1 hQ2 hS1 hS2 δ hδ0 hδ1
    rw [hζ]
    exact pure_shift_gap z.θ hκ hpure (hsmall s hs) (hlarge s hs) n hn

