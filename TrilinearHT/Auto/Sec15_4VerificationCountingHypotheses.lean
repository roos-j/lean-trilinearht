    (X : ColumnL2 (Fin ap.Mc)) {m₀ : Fin Cd.z.dim → ℤ} (hm₀ : m₀ ∈ Cd.refSet3 h' l a xs Bf)
    (hsmall : dyadicGridLength A.G I.1 *
      |D.refT3 G I l a xs + ∑ i, (m₀ i : ℝ) * D.xiH Cd.z h' i| ≤ Cd.U₀⁻¹) :
