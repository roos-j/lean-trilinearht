    linarith
  have hhd : ∀ p ∈ frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1)) ×ˢ D.selAlive G I j M,
      ∀ p' ∈ frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1)) ×ˢ D.selAlive G I j M,
