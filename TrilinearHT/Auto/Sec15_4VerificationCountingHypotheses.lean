  have hlen : ∀ t : ℤ, Gd.baseLength⁻¹ * 2 ^ t = (dyadicGridLength Gd t)⁻¹ := fun t => by
    unfold dyadicGridLength
    rw [mul_inv, zpow_neg, inv_inv]
  have hmono : ∀ t u : ℤ, t ≤ u → dyadicGridLength Gd u ≤ dyadicGridLength Gd t := fun t u htu => by
    unfold dyadicGridLength
