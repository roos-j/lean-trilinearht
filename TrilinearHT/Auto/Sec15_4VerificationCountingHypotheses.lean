      F j ⊆ ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).E h' (a j hj))
    {xs : ℝ} (hxs : xs ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1)) (Bf : ℕ)
    (hfull4 : 4 * (((6 ^ h' : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) + 4 * (3 *
      (((D.S.Q0 * 6 ^ h' : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) + Cd.Nb))) ≤ Bf)
    (X : ColumnL2 (Fin ap.Mc)) (hnoref : Cd.refSet3 h' l a xs Bf = ∅) :
    ‖ap.Λc I (Function.update (fun j => D.compSub j G I (D.preCell I)
        ((F j).image Subtype.val)) l X)‖ ≤
      Cd.err3 Td3 X 0 Cd.U₀ *
        ∏ j ∈ Finset.univ.erase l, ∑ m ∈ F j, ‖D.c j G (D.blockOf I.1) (D.preCell I) m.1‖ := by
  obtain ⟨ρc, hρc, nn, hnn, hfa, hrest⟩ := D.three_core_test_attempt hK1 hI G Cd.z Cd.hz Cd.hδc
    Cd.hcl Cd.hρ Cd.hcount Cd.hΛ Cd.hΛ0 h' l a F hF hxs Cd.hd Cd.hδ Cd.hδ'' Td3.hdδ Td3.hδ8
    Cd.hQ0 Cd.hQ Cd.hCm0 Cd.hCm Cd.Kt X
  have hn' : ∀ j, ∀ k ∈ sideOptF l F j, ∀ i, |(sideOptN nn j k i : ℝ)| ≤ Cd.Nb := by
    intro j k hk i
    by_cases hj : j = l
    · subst hj
