  have hent : ∀ p ∈ frequencyBox Cd.z.dim (2 ^ (Cd.Kt + 1)) ×ˢ D.selAlive G I j M, ∀ i,
      |(((((D.S.Q0 * 6 ^ h' : ℕ) : ℤ) • p.1 + n p.2) i : ℤ) : ℝ)| ≤
