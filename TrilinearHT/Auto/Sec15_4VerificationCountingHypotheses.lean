    (fun i => mul_nonneg (by linarith) (Finset.sum_nonneg fun _ _ => norm_nonneg _))
    (fun _ _ _ _ _ cc _ hsup _ i _ => coreG_L2_le _ _ _ _ _ _ _ i (by linarith) (hsup i))
  rw [Cd.shellCoef3_eq, Cd.tailCoef3_eq] at key
  have hP : ∏ i ∈ Finset.univ.erase l,
      (1 + cutTail Cd.z.dim Cd.δ Cd.Kt) * ∑ k ∈ sideOptF l F i, ‖D.c3 G I xs i k‖ =
      (1 + cutTail Cd.z.dim Cd.δ Cd.Kt) ^ 3 *
