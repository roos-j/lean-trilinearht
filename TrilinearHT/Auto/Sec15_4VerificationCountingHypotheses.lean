    have hR₀ : 0 < A.G.baseLength⁻¹ := inv_pos.mpr A.G.baseLength_pos
    refine three_core_total_abstract (zetaVec z D.S.Q0 h) l S E _ hAl hxl hB1 hμ hμν hR₀
      (Q := D.S.Eh h / ((6 ^ 8 : ℕ) : ℝ)) (Sg := D.S.Ξ / 2) (fun s hs x hx => ?_)
