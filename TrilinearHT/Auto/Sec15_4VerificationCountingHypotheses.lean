  have hM : ∀ _k : Fin 4, M ⊆ (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I) :=
    fun _ => hMj
  have hr := dyadicGridLength_pos A.G I.1
  have hQL : (0 : ℝ) < (D.S.Q0 : ℝ) * ((6 ^ h' : ℕ) : ℝ) := by
    have := Cd.hQ0; positivity
  set cls := (D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) 0 with hcls
  set s := M.image cls with hs
