/-- Every pair of distinct roles has two complementary roles. -/
theorem fin4_complement : ∀ i j : Fin 4, i ≠ j → ∃ k l : Fin 4, k ≠ l ∧ k ≠ i ∧ k ≠ j ∧
    l ≠ i ∧ l ≠ j ∧ ∀ r : Fin 4, r = i ∨ r = j ∨ r = k ∨ r = l := by
  decide

theorem fin4_sum_eq {i j k l : Fin 4} (hkl : k ≠ l) (hki : k ≠ i) (hkj : k ≠ j) (hli : l ≠ i)
    (hlj : l ≠ j) (hij : i ≠ j) (f : Fin 4 → ℝ) : ∑ r, f r = f i + f j + f k + f l := by
  have hu : (Finset.univ : Finset (Fin 4)) = {i, j, k, l} := by
    revert i j k l; decide
  rw [hu, Finset.sum_insert (by simp [hij, hki.symm, hli.symm]),
    Finset.sum_insert (by simp [hkj.symm, hlj.symm]), Finset.sum_pair hkl]
  ring

