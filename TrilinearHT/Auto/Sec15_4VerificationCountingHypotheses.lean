open Classical in
/-- The principal quantity of the three-core test (blueprint `eq:side-windows`): for a passing
tuple `2 Σ_{Λ ≤ 2^{I_w}} C μ ν^{-J} Λ^{-(A+1)} W |B| b_Λ P` at the chosen reference, with `P` a
bound for `Π_{k ≠ l} ‖g_k‖₂`, and `0` for a discarded tuple. The shells above `2^{I_w}` are
negligible and are counted in `threeConst`. -/
noncomputable def threePrin (Td3 : Cd.ThreeData) (h' : ℕ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (X : ColumnL2 (Fin ap.Mc)) (P : ℝ) : ℝ :=
  if Cd.passes3 h' l a xs Bf then
    2 * Cd.shellCoef3 Td3 h' l a xs Bf X (Cd.beta3 h' l a xs Bf) * P
  else 0

/-- The absolute constant of a three-core tuple (blueprint `eq:core-numerical`, with the local side
size as an extra factor): the numerical and coset errors (with or without reference), the
discarded-tuple bound `C_{J,A} U₀⁻¹ (shells + tails) (1 + τ_c)³`, and the shells above `2^{I_w}`
of a passing tuple, `C_{J,A} tails (1 + τ_c)³` (blueprint line 2562). -/
noncomputable def threeConst (Td3 : Cd.ThreeData) (h' : ℕ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (X : ColumnL2 (Fin ap.Mc)) : ℝ :=
  max (Cd.err3 Td3 X (dyadicGridLength A.G I.1 * Cd.ε / (D.S.Q0 * ((6 ^ h' : ℕ) : ℝ)))
      (dyadicGridLength A.G I.1 * Cd.Λg / (D.S.Q0 * ((6 ^ h' : ℕ) : ℝ)) - Cd.U₀))
    (Cd.err3 Td3 X 0 Cd.U₀) +
  2 * (kerC κ' (Td3.J3 + (Td3.Aw + 2)) * (3 + 2) ^ (Td3.J3 + (Td3.Aw + 2)) *
      2 ^ (Td3.Aw + 2) * Cd.U₀⁻¹) *
    (Cd.shellU3 Td3 h' l a xs Bf X + Cd.tailU3 Td3 Bf X) * (1 + cutTail Cd.z.dim Cd.δ Cd.Kt) ^ 3 +
  2 * (kerC κ' (Td3.J3 + (Td3.Aw + 2)) * (3 + 2) ^ (Td3.J3 + (Td3.Aw + 2)) *
      2 ^ (Td3.Aw + 2)) * Cd.tailU3 Td3 Bf X * (1 + cutTail Cd.z.dim Cd.δ Cd.Kt) ^ 3

