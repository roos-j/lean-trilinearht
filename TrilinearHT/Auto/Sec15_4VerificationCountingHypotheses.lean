    · have := D.threePathE_ref hD hΔ z (hz 0) hh hx
      rwa [hR s] at this
    · have := D.three_path_sep G h l Cs rep hrep hΛ z hz (by rw [mul_div_cancel₀ _ hQ6.ne'])
        hpath hanc Iw c κ r s hs s' hs' x hx x' hx' hne N hN
      rwa [hR s, hR s'] at this
