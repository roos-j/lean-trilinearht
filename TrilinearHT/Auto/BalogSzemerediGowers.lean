namespace Auto

open scoped BigOperators Pointwise NNReal

/-- Neighborhood in the first part of a finite bipartite relation. -/
noncomputable def bipartiteNeighborhood {α β : Type*} [Fintype α]
    (E : α → β → Prop) (b : β) : Finset α := by
  classical
  exact Finset.univ.filter (fun a => E a b)

/-- The ordinary counting cardinality of the bipartite edge set. -/
noncomputable def bipartiteEdgeCount {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) : ℕ := by
  classical
  exact ((Finset.univ : Finset (α × β)).filter (fun p => E p.1 p.2)).card

/-- The number of common neighbors of an ordered pair of first-part vertices. -/
noncomputable def bipartiteCodegree {α β : Type*} [Fintype β]
    (E : α → β → Prop) (a a' : α) : ℕ := by
  classical
  exact ((Finset.univ : Finset β).filter (fun b => E a b ∧ E a' b)).card

theorem mem_bipartiteNeighborhood {α β : Type*} [Fintype α]
    (E : α → β → Prop) (a : α) (b : β) : a ∈ bipartiteNeighborhood E b ↔ E a b := by
  classical
  simp [bipartiteNeighborhood]

theorem bipartiteNeighborhood_card_le {α β : Type*} [Fintype α]
    (E : α → β → Prop) (b : β) : (bipartiteNeighborhood E b).card ≤ Fintype.card α :=
  Finset.card_le_univ _

theorem bipartiteCodegree_symm {α β : Type*} [Fintype β]
    (E : α → β → Prop) (a a' : α) : bipartiteCodegree E a a' = bipartiteCodegree E a' a := by
  classical
  unfold bipartiteCodegree
  congr 1
  ext b
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact and_comm

theorem bipartiteCodegree_le {α β : Type*} [Fintype β]
    (E : α → β → Prop) (a a' : α) : bipartiteCodegree E a a' ≤ Fintype.card β := by
  classical
  exact Finset.card_le_univ _

/-- Counting edges by their second-part endpoint gives the neighborhood first moment. -/
theorem bipartite_sum_neighborhood_card {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) :
    ∑ b, (bipartiteNeighborhood E b).card = bipartiteEdgeCount E := by
  classical
  simp only [bipartiteNeighborhood, bipartiteEdgeCount, Finset.card_filter,
    Fintype.sum_prod_type]
  exact Finset.sum_comm

/-- Common-neighbor counts are the second moment of neighborhood size. -/
theorem bipartite_sum_neighborhood_sq {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) :
    ∑ b, (bipartiteNeighborhood E b).card ^ 2 = ∑ a, ∑ a', bipartiteCodegree E a a' := by
  classical
  simp only [bipartiteNeighborhood, bipartiteCodegree, Finset.card_filter, pow_two,
    Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a' _
  apply Finset.sum_congr rfl
  intro b _
  by_cases h : E a b <;> by_cases h' : E a' b <;> simp [h, h']

/-- Finite Cauchy-Schwarz gives the lower second moment used by dependent random choice. -/
theorem bipartite_edge_sq_le_neighborhood_sq {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) :
    (bipartiteEdgeCount E : ℝ) ^ 2 ≤
      (Fintype.card β : ℝ) * ∑ b, ((bipartiteNeighborhood E b).card : ℝ) ^ 2 := by
  classical
  have h := Finset.sum_mul_sq_le_sq_mul_sq (Finset.univ : Finset β)
    (fun _ => (1 : ℝ)) (fun b => ((bipartiteNeighborhood E b).card : ℝ))
  simpa only [one_mul, one_pow, Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    mul_one, ← Nat.cast_sum, bipartite_sum_neighborhood_card] using h

/-- Source first moment, with any common upper bound for the two part sizes. -/
theorem bipartite_first_moment_lower {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) {η : ℝ} {n : ℕ}
    (hedges : η * (n : ℝ) ^ 2 ≤ bipartiteEdgeCount E) :
    η * (n : ℝ) ^ 2 ≤ ∑ b, ((bipartiteNeighborhood E b).card : ℝ) := by
  simpa only [← Nat.cast_sum, bipartite_sum_neighborhood_card] using hedges

/-- Source second moment without division, valid also when the part-size bound is zero. -/
theorem bipartite_second_moment_lower {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) {η : ℝ} {n : ℕ} (hη : 0 ≤ η)
    (hβ : Fintype.card β ≤ n) (hedges : η * (n : ℝ) ^ 2 ≤ bipartiteEdgeCount E) :
    η ^ 2 * (n : ℝ) ^ 4 ≤ (n : ℝ) *
      ∑ b, ((bipartiteNeighborhood E b).card : ℝ) ^ 2 := by
  have h := bipartite_edge_sq_le_neighborhood_sq E
  have hsq := pow_le_pow_left₀ (mul_nonneg hη (sq_nonneg _)) hedges 2
  have hc : (Fintype.card β : ℝ) ≤ n := by exact_mod_cast hβ
  calc
    _ = (η * (n : ℝ) ^ 2) ^ 2 := by ring
    _ ≤ (bipartiteEdgeCount E : ℝ) ^ 2 := hsq
    _ ≤ _ := h.trans (mul_le_mul_of_nonneg_right hc (Finset.sum_nonneg
      (fun _ _ => sq_nonneg _)))

/-! ### Bad-pair averaging -/

/-- Ordered pairs in a finite set whose common-neighbor count is below a threshold. -/
noncomputable def bipartiteBadPairs {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α) : Finset (α × α) := by
  classical
  exact (Y ×ˢ Y).filter (fun p => (bipartiteCodegree E p.1 p.2 : ℝ) < τ)

/-- Bad partners of a specified vertex, with ordered-pair convention. -/
noncomputable def bipartiteBadPartners {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α) (a : α) : Finset α := by
  classical
  exact Y.filter (fun a' => (bipartiteCodegree E a a' : ℝ) < τ)

theorem bipartiteBadPairs_card_eq_sum {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α) :
    (bipartiteBadPairs E τ Y).card = ∑ a ∈ Y, (bipartiteBadPartners E τ Y a).card := by
  classical
  simp only [bipartiteBadPairs, bipartiteBadPartners, Finset.card_filter, Finset.sum_product]

open scoped Classical in
theorem bipartiteBadPairs_neighborhood_card {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (b : β) :
    (bipartiteBadPairs E τ (bipartiteNeighborhood E b)).card =
      ∑ a, ∑ a', if (bipartiteCodegree E a a' : ℝ) < τ then
        (if E a b ∧ E a' b then 1 else 0) else 0 := by
  classical
  simp only [bipartiteBadPairs, bipartiteNeighborhood, Finset.card_filter,
    Finset.sum_product, Finset.sum_filter]
  apply Finset.sum_congr rfl
  intro a _
  by_cases ha : E a b
  · simp only [ha, ite_true, true_and]
    apply Finset.sum_congr rfl
    intro a' _
    by_cases ha' : E a' b <;>
      by_cases hbad : (bipartiteCodegree E a a' : ℝ) < τ <;> simp [ha', hbad]
  · simp [ha]

/-- A bad ordered pair belongs to exactly its codegree many neighborhoods. -/
theorem bipartite_bad_pairs_double_count {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) (τ : ℝ) :
    ∑ b, (bipartiteBadPairs E τ (bipartiteNeighborhood E b)).card =
      ∑ a, ∑ a', if (bipartiteCodegree E a a' : ℝ) < τ then
        bipartiteCodegree E a a' else 0 := by
  classical
  simp_rw [bipartiteBadPairs_neighborhood_card]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro a' _
  by_cases hbad : (bipartiteCodegree E a a' : ℝ) < τ
  · simp only [hbad, ite_true]
    simp only [bipartiteCodegree, Finset.card_filter]
  · simp [hbad]

/-- The total bad-pair count is at most the codegree threshold times the
number of ordered pairs in the first part. -/
theorem bipartite_bad_pairs_sum_le {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) {τ : ℝ} (hτ : 0 ≤ τ) :
    ∑ b, ((bipartiteBadPairs E τ (bipartiteNeighborhood E b)).card : ℝ) ≤
      (Fintype.card α : ℝ) ^ 2 * τ := by
  classical
  calc
    _ = ∑ a, ∑ a', ((if (bipartiteCodegree E a a' : ℝ) < τ then
        bipartiteCodegree E a a' else 0 : ℕ) : ℝ) := by
      exact_mod_cast bipartite_bad_pairs_double_count E τ
    _ ≤ ∑ _a : α, ∑ _a' : α, τ := by
      apply Finset.sum_le_sum
      intro a _
      apply Finset.sum_le_sum
      intro a' _
      split_ifs with hbad
      · exact hbad.le
      · simpa only [Nat.cast_zero] using hτ
    _ = _ := by simp; ring

/-- Blueprint `lem:four-paths`, lines 670-674: select an actual neighborhood
whose squared size minus one hundred times its bad ordered pairs is at least
half the density-squared scale. The zero-size case is handled separately by
the final graph theorem, so the sampling step has a positive size bound. -/
theorem bipartite_dense_neighborhood {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) {η : ℝ} {n : ℕ} (hn : 0 < n) (hη : 0 < η)
    (hα : Fintype.card α ≤ n) (hβ : Fintype.card β ≤ n)
    (hedges : η * (n : ℝ) ^ 2 ≤ bipartiteEdgeCount E) :
    ∃ b : β, η ^ 2 * (n : ℝ) ^ 2 / 2 ≤
      ((bipartiteNeighborhood E b).card : ℝ) ^ 2 -
        100 * ((bipartiteBadPairs E (η ^ 2 * n / 100000)
          (bipartiteNeighborhood E b)).card : ℝ) := by
  classical
  have hnr : (0 : ℝ) < n := by exact_mod_cast hn
  have hm := bipartite_second_moment_lower E hη.le hβ hedges
  have hmoment : η ^ 2 * (n : ℝ) ^ 3 ≤
      ∑ b, ((bipartiteNeighborhood E b).card : ℝ) ^ 2 := by
    apply (mul_le_mul_iff_right₀ hnr).mp
    nlinarith [hm]
  have hbad := bipartite_bad_pairs_sum_le E
    (τ := η ^ 2 * n / 100000) (by positivity)
  have hαr : (Fintype.card α : ℝ) ≤ n := by exact_mod_cast hα
  have hβr : (Fintype.card β : ℝ) ≤ n := by exact_mod_cast hβ
  have hbad' : ∑ b, ((bipartiteBadPairs E (η ^ 2 * n / 100000)
      (bipartiteNeighborhood E b)).card : ℝ) ≤ η ^ 2 * (n : ℝ) ^ 3 / 100000 := by
    apply hbad.trans
    calc
      _ ≤ (n : ℝ) ^ 2 * (η ^ 2 * n / 100000) := by gcongr
      _ = _ := by ring
  have hepos : 0 < bipartiteEdgeCount E := by
    have h : (0 : ℝ) < bipartiteEdgeCount E :=
      (mul_pos hη (sq_pos_of_pos hnr)).trans_le hedges
    exact_mod_cast h
  have hnonempty : (Finset.univ : Finset β).Nonempty := by
    apply Finset.nonempty_of_sum_ne_zero
      (f := fun b => (bipartiteNeighborhood E b).card)
    rw [bipartite_sum_neighborhood_card]
    exact hepos.ne'
  have hsum : (Fintype.card β : ℝ) * (η ^ 2 * (n : ℝ) ^ 2 / 2) ≤
      ∑ b, (((bipartiteNeighborhood E b).card : ℝ) ^ 2 -
        100 * ((bipartiteBadPairs E (η ^ 2 * n / 100000)
          (bipartiteNeighborhood E b)).card : ℝ)) := by
    apply (mul_le_mul_of_nonneg_right hβr (by positivity)).trans
    rw [Finset.sum_sub_distrib, ← Finset.mul_sum]
    nlinarith [mul_nonneg (sq_nonneg η) (pow_nonneg hnr.le 3)]
  have hs : (∑ _b : β, η ^ 2 * (n : ℝ) ^ 2 / 2) ≤
      ∑ b, (((bipartiteNeighborhood E b).card : ℝ) ^ 2 -
        100 * ((bipartiteBadPairs E (η ^ 2 * n / 100000)
          (bipartiteNeighborhood E b)).card : ℝ)) := by simpa using hsum
  obtain ⟨b, _, hb⟩ := Finset.exists_le_of_sum_le hnonempty hs
  exact ⟨b, hb⟩

/-! ### Deleting vertices with many bad partners -/

/-- Retain exactly the vertices with at most one quarter of the neighborhood
as bad partners, as in the source deletion step. -/
noncomputable def bipartiteRetained {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α) : Finset α := by
  classical
  exact Y.filter (fun a => ((bipartiteBadPartners E τ Y a).card : ℝ) ≤ Y.card / 4)

theorem mem_bipartiteRetained {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α) (a : α) :
    a ∈ bipartiteRetained E τ Y ↔ a ∈ Y ∧
      ((bipartiteBadPartners E τ Y a).card : ℝ) ≤ Y.card / 4 := by
  classical
  simp [bipartiteRetained]

theorem bipartiteRetained_subset {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α) : bipartiteRetained E τ Y ⊆ Y := by
  intro a ha
  exact ((mem_bipartiteRetained E τ Y a).mp ha).1

open Classical in
/-- Source deletion count: fewer than `|Y|/25` vertices are deleted when
fewer than `|Y|^2/100` ordered pairs are bad. -/
theorem bipartite_deleted_card_lt {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α)
    (hbad : 100 * ((bipartiteBadPairs E τ Y).card : ℝ) < (Y.card : ℝ) ^ 2) :
    ((Y \ bipartiteRetained E τ Y).card : ℝ) < (Y.card : ℝ) / 25 := by
  classical
  have hY : (0 : ℝ) < Y.card := by
    nlinarith [Nat.cast_nonneg (α := ℝ) Y.card,
      Nat.cast_nonneg (α := ℝ) (bipartiteBadPairs E τ Y).card]
  have hd : ((Y \ bipartiteRetained E τ Y).card : ℝ) * (Y.card : ℝ) / 4 ≤
      ((bipartiteBadPairs E τ Y).card : ℝ) := by
    calc
      _ = ∑ _a ∈ Y \ bipartiteRetained E τ Y, (Y.card : ℝ) / 4 := by simp; ring
      _ ≤ ∑ a ∈ Y \ bipartiteRetained E τ Y, ((bipartiteBadPartners E τ Y a).card : ℝ) := by
        apply Finset.sum_le_sum
        intro a ha
        rcases Finset.mem_sdiff.mp ha with ⟨haY, haN⟩
        exact (lt_of_not_ge (fun h => haN ((mem_bipartiteRetained E τ Y a).mpr
          ⟨haY, h⟩))).le
      _ ≤ ∑ a ∈ Y, ((bipartiteBadPartners E τ Y a).card : ℝ) :=
        Finset.sum_le_sum_of_subset_of_nonneg Finset.sdiff_subset
          (fun _ _ _ => Nat.cast_nonneg _)
      _ = _ := by exact_mod_cast (bipartiteBadPairs_card_eq_sum E τ Y).symm
  apply (mul_lt_mul_iff_right₀ hY).mp
  nlinarith [hd]

/-- At least twenty-four twenty-fifths of the neighborhood remains. -/
theorem bipartiteRetained_card_lower {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α)
    (hbad : 100 * ((bipartiteBadPairs E τ Y).card : ℝ) < (Y.card : ℝ) ^ 2) :
    24 * (Y.card : ℝ) / 25 < (bipartiteRetained E τ Y).card := by
  classical
  have hd := bipartite_deleted_card_lt E τ Y hbad
  have he : ((Y \ bipartiteRetained E τ Y).card : ℝ) +
      (bipartiteRetained E τ Y).card = Y.card := by
    exact_mod_cast Finset.card_sdiff_add_card_eq_card (bipartiteRetained_subset E τ Y)
  linarith

/-- Blueprint `lem:four-paths`, line 675: the selected neighborhood is large,
and the actual retained set has size at least `eta*n/4`. Every retained vertex
has at most a quarter of the original neighborhood as bad partners. -/
theorem bipartite_dense_retained_neighborhood {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) {η : ℝ} {n : ℕ} (hn : 0 < n) (hη : 0 < η)
    (hα : Fintype.card α ≤ n) (hβ : Fintype.card β ≤ n)
    (hedges : η * (n : ℝ) ^ 2 ≤ bipartiteEdgeCount E) :
    ∃ b : β, η * n / 2 ≤ ((bipartiteNeighborhood E b).card : ℝ) ∧
      η * n / 4 ≤ ((bipartiteRetained E (η ^ 2 * n / 100000)
        (bipartiteNeighborhood E b)).card : ℝ) ∧
      ∀ a ∈ bipartiteRetained E (η ^ 2 * n / 100000) (bipartiteNeighborhood E b),
        ((bipartiteBadPartners E (η ^ 2 * n / 100000)
          (bipartiteNeighborhood E b) a).card : ℝ) ≤ (bipartiteNeighborhood E b).card / 4 := by
  obtain ⟨b, hb⟩ := bipartite_dense_neighborhood E hn hη hα hβ hedges
  have hnr : (0 : ℝ) < n := by exact_mod_cast hn
  have hbad0 := Nat.cast_nonneg (α := ℝ)
    (bipartiteBadPairs E (η ^ 2 * n / 100000) (bipartiteNeighborhood E b)).card
  have hY : η * n / 2 ≤ ((bipartiteNeighborhood E b).card : ℝ) := by
    apply le_of_sq_le_sq _ (Nat.cast_nonneg _)
    nlinarith [sq_nonneg (η * (n : ℝ))]
  have hbad : 100 * ((bipartiteBadPairs E (η ^ 2 * n / 100000)
      (bipartiteNeighborhood E b)).card : ℝ) < ((bipartiteNeighborhood E b).card : ℝ) ^ 2 := by
    have hp : 0 < η ^ 2 * (n : ℝ) ^ 2 / 2 := by positivity
    linarith
  have hret := bipartiteRetained_card_lower E (η ^ 2 * n / 100000)
    (bipartiteNeighborhood E b) hbad
  refine ⟨b, hY, ?_, ?_⟩
  · have hx : 0 ≤ η * (n : ℝ) := mul_nonneg hη.le hnr.le
    linarith
  · intro a ha
    exact ((mem_bipartiteRetained E _ _ a).mp ha).2

/-! ### Common middle vertices and four-step paths -/

/-- The common good partners of two retained endpoints inside the original neighborhood. -/
noncomputable def bipartiteCommonGood {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α) (x y : α) : Finset α := by
  classical
  exact Y \ (bipartiteBadPartners E τ Y x ∪ bipartiteBadPartners E τ Y y)

theorem mem_bipartiteCommonGood {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α) (x y u : α) :
    u ∈ bipartiteCommonGood E τ Y x y ↔ u ∈ Y ∧
      τ ≤ (bipartiteCodegree E x u : ℝ) ∧ τ ≤ (bipartiteCodegree E y u : ℝ) := by
  classical
  simp only [bipartiteCommonGood, bipartiteBadPartners, Finset.mem_sdiff,
    Finset.mem_union, Finset.mem_filter]
  constructor
  · rintro ⟨hu, hbad⟩
    exact ⟨hu, le_of_not_gt (fun h => hbad (Or.inl ⟨hu, h⟩)),
      le_of_not_gt (fun h => hbad (Or.inr ⟨hu, h⟩))⟩
  · rintro ⟨hu, hx, hy⟩
    exact ⟨hu, fun h => h.elim (fun h => (not_lt_of_ge hx) h.2)
      (fun h => (not_lt_of_ge hy) h.2)⟩

/-- At least half the original neighborhood is a good partner of both retained endpoints. -/
theorem bipartiteCommonGood_card_lower {α β : Type*} [Fintype β]
    (E : α → β → Prop) (τ : ℝ) (Y : Finset α) {x y : α}
    (hx : x ∈ bipartiteRetained E τ Y) (hy : y ∈ bipartiteRetained E τ Y) :
    (Y.card : ℝ) / 2 ≤ (bipartiteCommonGood E τ Y x y).card := by
  classical
  have hsub : bipartiteBadPartners E τ Y x ∪ bipartiteBadPartners E τ Y y ⊆ Y := by
    intro u hu
    rcases Finset.mem_union.mp hu with hu | hu <;>
      exact (Finset.mem_filter.mp hu).1
  have he : ((bipartiteCommonGood E τ Y x y).card : ℝ) +
      (bipartiteBadPartners E τ Y x ∪ bipartiteBadPartners E τ Y y).card = Y.card := by
    exact_mod_cast Finset.card_sdiff_add_card_eq_card hsub
  have hc : ((bipartiteBadPartners E τ Y x ∪ bipartiteBadPartners E τ Y y).card : ℝ) ≤
      (bipartiteBadPartners E τ Y x).card + (bipartiteBadPartners E τ Y y).card := by
    exact_mod_cast Finset.card_union_le (bipartiteBadPartners E τ Y x)
      (bipartiteBadPartners E τ Y y)
  have hxb := ((mem_bipartiteRetained E τ Y x).mp hx).2
  have hyb := ((mem_bipartiteRetained E τ Y y).mp hy).2
  linarith

/-- Actual four-step paths with fixed endpoints. The three interior vertices
are freely chosen; repeated vertices are permitted. -/
noncomputable def bipartiteFourPaths {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) (x y : α) : Finset (β × α × β) := by
  classical
  exact Finset.univ.filter (fun p =>
    E x p.1 ∧ E p.2.1 p.1 ∧ E p.2.1 p.2.2 ∧ E y p.2.2)

theorem mem_bipartiteFourPaths {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) (x y : α) (p : β × α × β) :
    p ∈ bipartiteFourPaths E x y ↔ E x p.1 ∧ E p.2.1 p.1 ∧ E p.2.1 p.2.2 ∧ E y p.2.2 := by
  classical
  simp [bipartiteFourPaths]

/-- Counting paths by their middle vertex gives the product of the two codegrees. -/
theorem bipartiteFourPaths_card {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) (x y : α) :
    (bipartiteFourPaths E x y).card =
      ∑ u, bipartiteCodegree E x u * bipartiteCodegree E u y := by
  classical
  simp only [bipartiteFourPaths, bipartiteCodegree, Finset.card_filter,
    Fintype.sum_prod_type, Finset.sum_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro u _
  conv_rhs => rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro b _
  apply Finset.sum_congr rfl
  intro c _
  by_cases h1 : E x b <;> by_cases h2 : E u b <;>
    by_cases h3 : E u c <;> by_cases h4 : E y c <;> simp [h1, h2, h3, h4]

/-- Each common good middle vertex contributes at least the square of the
codegree threshold many distinct paths. -/
theorem bipartiteFourPaths_card_lower {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) {τ : ℝ} (hτ : 0 ≤ τ) (Y : Finset α) {x y : α}
    (hx : x ∈ bipartiteRetained E τ Y) (hy : y ∈ bipartiteRetained E τ Y) :
    (Y.card : ℝ) / 2 * τ ^ 2 ≤ (bipartiteFourPaths E x y).card := by
  classical
  apply (mul_le_mul_of_nonneg_right (bipartiteCommonGood_card_lower E τ Y hx hy)
    (sq_nonneg τ)).trans
  calc
    _ = ∑ _u ∈ bipartiteCommonGood E τ Y x y, τ ^ 2 := by simp
    _ ≤ ∑ u ∈ bipartiteCommonGood E τ Y x y,
        (bipartiteCodegree E x u : ℝ) * (bipartiteCodegree E u y : ℝ) := by
      apply Finset.sum_le_sum
      intro u hu
      have hgood := (mem_bipartiteCommonGood E τ Y x y u).mp hu
      rw [pow_two, bipartiteCodegree_symm E u y]
      exact mul_le_mul hgood.2.1 hgood.2.2 hτ (Nat.cast_nonneg _)
    _ ≤ ∑ u, (bipartiteCodegree E x u : ℝ) * (bipartiteCodegree E u y : ℝ) :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
        (fun _ _ _ => mul_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _))
    _ = _ := by exact_mod_cast (bipartiteFourPaths_card E x y).symm

/-- The quantitative path count at the exact source codegree threshold. -/
theorem bipartite_retained_four_paths {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) {η : ℝ} {n : ℕ} (_hη : 0 ≤ η) (Y : Finset α)
    (hY : η * n / 2 ≤ (Y.card : ℝ)) {x y : α}
    (hx : x ∈ bipartiteRetained E (η ^ 2 * n / 100000) Y)
    (hy : y ∈ bipartiteRetained E (η ^ 2 * n / 100000) Y) :
    η ^ 5 * (n : ℝ) ^ 3 / 40000000000 ≤ (bipartiteFourPaths E x y).card := by
  have h := bipartiteFourPaths_card_lower E
    (τ := η ^ 2 * n / 100000) (by positivity) Y hx hy
  calc
    _ = (η * n / 2) / 2 * (η ^ 2 * n / 100000) ^ 2 := by ring
    _ ≤ (Y.card : ℝ) / 2 * (η ^ 2 * n / 100000) ^ 2 := by gcongr
    _ ≤ _ := h

/-! ### Dense four-path theorem and proper colors -/

/-- Blueprint `lem:four-paths`, lines 668-679. Both bounds use the same
universal constant `1/40000000000`; paths may repeat vertices. -/
theorem bipartite_dense_four_paths {α β : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) {η : ℝ} {n : ℕ} (hη : 0 < η)
    (hα : Fintype.card α ≤ n) (hβ : Fintype.card β ≤ n)
    (hedges : η * (n : ℝ) ^ 2 ≤ bipartiteEdgeCount E) :
    ∃ S : Finset α, η * n / 40000000000 ≤ (S.card : ℝ) ∧
      ∀ x ∈ S, ∀ y ∈ S,
        η ^ 5 * (n : ℝ) ^ 3 / 40000000000 ≤ (bipartiteFourPaths E x y).card := by
  by_cases hn : n = 0
  · subst n
    exact ⟨∅, by simp, by simp⟩
  obtain ⟨b, hY, hS, _⟩ := bipartite_dense_retained_neighborhood E
    (Nat.pos_of_ne_zero hn) hη hα hβ hedges
  refine ⟨bipartiteRetained E (η ^ 2 * n / 100000) (bipartiteNeighborhood E b), ?_, ?_⟩
  · have hpos : 0 ≤ η * (n : ℝ) := mul_nonneg hη.le (Nat.cast_nonneg _)
    linarith
  · intro x hx y hy
    exact bipartite_retained_four_paths E hη.le _ hY hx hy

/-- Properness means that an incident color determines the opposite endpoint
at a vertex in either part of a bipartite graph. -/
def ProperBipartiteColoring {α β γ : Type*} (E : α → β → Prop)
    (color : α → β → γ) : Prop :=
  (∀ a b b', E a b → E a b' → color a b = color a b' → b = b') ∧
  (∀ a a' b, E a b → E a' b → color a b = color a' b → a = a')

/-- The ordered colors along a four-step path, including the final endpoint. -/
def bipartitePathColors {α β γ : Type*} (color : α → β → γ)
    (x y : α) (p : β × α × β) : γ × γ × γ × γ :=
  (color x p.1, color p.2.1 p.1, color p.2.1 p.2.2, color y p.2.2)

/-- Blueprint `lem:four-paths`, lines 679-680: a start vertex and four ordered
colors recover all three interior vertices and the final endpoint. -/
theorem bipartite_proper_color_recovery {α β γ : Type*}
    (E : α → β → Prop) (color : α → β → γ) (hproper : ProperBipartiteColoring E color)
    {x y y' : α} {p q : β × α × β}
    (hp : E x p.1 ∧ E p.2.1 p.1 ∧ E p.2.1 p.2.2 ∧ E y p.2.2)
    (hq : E x q.1 ∧ E q.2.1 q.1 ∧ E q.2.1 q.2.2 ∧ E y' q.2.2)
    (hc : bipartitePathColors color x y p = bipartitePathColors color x y' q) :
    p = q ∧ y = y' := by
  rcases p with ⟨b, u, c⟩
  rcases q with ⟨b', u', c'⟩
  have h1 := congrArg Prod.fst hc
  have h2 := congrArg (fun z : γ × γ × γ × γ => z.2.1) hc
  have h3 := congrArg (fun z : γ × γ × γ × γ => z.2.2.1) hc
  have h4 := congrArg (fun z : γ × γ × γ × γ => z.2.2.2) hc
  have hb : b = b' := hproper.1 x b b' hp.1 hq.1 h1
  subst b'
  have hu : u = u' := hproper.2 u u' b hp.2.1 hq.2.1 h2
  subst u'
  have hcc : c = c' := hproper.1 u c c' hp.2.2.1 hq.2.2.1 h3
  subst c'
  exact ⟨rfl, hproper.2 y y' c hp.2.2.2 hq.2.2.2 h4⟩

theorem bipartitePathColors_injOn {α β γ : Type*} [Fintype α] [Fintype β]
    (E : α → β → Prop) (color : α → β → γ) (hproper : ProperBipartiteColoring E color)
    (x y : α) : Set.InjOn (bipartitePathColors color x y) (bipartiteFourPaths E x y) := by
  intro p hp q hq hc
  exact (bipartite_proper_color_recovery E color hproper
    ((mem_bipartiteFourPaths E x y p).mp hp)
    ((mem_bipartiteFourPaths E x y q).mp hq) hc).1

/-! ### Popular sums and the energy graph -/

/-- Number of ordered representations of a group element as a sum of two
elements of the given finite set. -/
def sumRepresentationCount {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (s : G) : ℕ :=
  ((A ×ˢ A).filter (fun p => p.1 + p.2 = s)).card

theorem sumRepresentationCount_le {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (s : G) : sumRepresentationCount A s ≤ A.card := by
  apply Finset.card_le_card_of_injOn Prod.fst
  · intro p hp
    exact (Finset.mem_product.mp (Finset.mem_filter.mp hp).1).1
  · intro p hp q hq he
    apply Prod.ext he
    have hp' := (Finset.mem_filter.mp hp).2
    have hq' := (Finset.mem_filter.mp hq).2
    exact add_left_cancel (he ▸ hp'.trans hq'.symm)

theorem sum_sumRepresentationCount {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) : ∑ s ∈ A + A, sumRepresentationCount A s = A.card ^ 2 := by
  unfold sumRepresentationCount
  rw [Finset.sum_card_fiberwise_eq_card_filter]
  rw [Finset.filter_eq_self.mpr]
  · simp [pow_two]
  · intro p hp
    exact Finset.add_mem_add (Finset.mem_product.mp hp).1 (Finset.mem_product.mp hp).2

theorem addEnergy_eq_sum_representation_sq {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) : Finset.addEnergy A A = ∑ s ∈ A + A, sumRepresentationCount A s ^ 2 :=
  Finset.addEnergy_eq_sum_sq' A A

/-- Popular sums at a real threshold; restricting to the sumset makes this
finite even when the ambient abelian group is infinite. -/
noncomputable def popularSums {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (t : ℝ) : Finset G := by
  classical
  exact (A + A).filter (fun s => t ≤ (sumRepresentationCount A s : ℝ))

theorem mem_popularSums {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (t : ℝ) (s : G) :
    s ∈ popularSums A t ↔ s ∈ A + A ∧ t ≤ (sumRepresentationCount A s : ℝ) := by
  classical
  simp [popularSums]

theorem popularSums_mass_le {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (t : ℝ) :
    ∑ s ∈ popularSums A t, (sumRepresentationCount A s : ℝ) ≤ (A.card : ℝ) ^ 2 := by
  calc
    _ ≤ ∑ s ∈ A + A, (sumRepresentationCount A s : ℝ) :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        (fun _ _ _ => Nat.cast_nonneg _)
    _ = _ := by exact_mod_cast sum_sumRepresentationCount A

theorem popularSums_card_mul_threshold_le {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (t : ℝ) : (popularSums A t).card * t ≤ (A.card : ℝ) ^ 2 := by
  calc
    _ = ∑ _s ∈ popularSums A t, t := by simp
    _ ≤ ∑ s ∈ popularSums A t, (sumRepresentationCount A s : ℝ) := by
      apply Finset.sum_le_sum
      intro s hs
      exact ((mem_popularSums A t s).mp hs).2
    _ ≤ _ := popularSums_mass_le A t

/-- Splitting at the popularity threshold bounds the energy by the popular
mass times `|A|`, plus the threshold times the total representation mass. -/
theorem addEnergy_le_popular_mass {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) {t : ℝ} (ht : 0 ≤ t) :
    (Finset.addEnergy A A : ℝ) ≤
      A.card * (∑ s ∈ popularSums A t, (sumRepresentationCount A s : ℝ)) +
        t * (A.card : ℝ) ^ 2 := by
  classical
  have he : (Finset.addEnergy A A : ℝ) =
      ∑ s ∈ A + A, (sumRepresentationCount A s : ℝ) ^ 2 := by
    exact_mod_cast addEnergy_eq_sum_representation_sq A
  have hm : ∑ s ∈ A + A, (sumRepresentationCount A s : ℝ) = (A.card : ℝ) ^ 2 := by
    exact_mod_cast sum_sumRepresentationCount A
  rw [he, popularSums, Finset.sum_filter]
  rw [← hm, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro s _
  have hr : 0 ≤ (sumRepresentationCount A s : ℝ) := Nat.cast_nonneg _
  have hrn : (sumRepresentationCount A s : ℝ) ≤ A.card := by
    exact_mod_cast sumRepresentationCount_le A s
  split_ifs with hs
  · nlinarith [mul_nonneg ht hr]
  · have hrt := (not_le.mp hs).le
    nlinarith

/-- Blueprint `lem:BSG`, lines 685-692: at threshold `|A|/(2K)`, the popular
sumset has at most `2K|A|` elements. -/
theorem popularSums_card_le {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (hA : A.Nonempty) {K : ℝ} (hK : 0 < K) :
    ((popularSums A ((A.card : ℝ) / (2 * K))).card : ℝ) ≤ 2 * K * A.card := by
  have hn : (0 : ℝ) < A.card := by exact_mod_cast hA.card_pos
  have h := popularSums_card_mul_threshold_le A ((A.card : ℝ) / (2 * K))
  have ht : 0 < (A.card : ℝ) / (2 * K) := by positivity
  apply (mul_le_mul_iff_left₀ ht).mp
  calc
    _ ≤ (A.card : ℝ) ^ 2 := h
    _ = _ := by field_simp

/-- The energy hypothesis forces at least `|A|^2/(2K)` popular ordered pairs. -/
theorem popularSums_mass_lower {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (hA : A.Nonempty) {K : ℝ} (hK : 0 < K)
    (henergy : (A.card : ℝ) ^ 3 / K ≤ Finset.addEnergy A A) :
    (A.card : ℝ) ^ 2 / (2 * K) ≤
      ∑ s ∈ popularSums A ((A.card : ℝ) / (2 * K)), (sumRepresentationCount A s : ℝ) := by
  have hn : (0 : ℝ) < A.card := by exact_mod_cast hA.card_pos
  have h := addEnergy_le_popular_mass A (t := (A.card : ℝ) / (2 * K)) (by positivity)
  apply (mul_le_mul_iff_right₀ hn).mp
  have hid : (A.card : ℝ) * ((A.card : ℝ) ^ 2 / (2 * K)) +
      (A.card : ℝ) / (2 * K) * (A.card : ℝ) ^ 2 = (A.card : ℝ) ^ 3 / K := by ring
  linarith

/-- Graph on two copies of `A`, colored by sums belonging to the popular set. -/
def popularSumGraph {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (t : ℝ) (a b : A) : Prop := (a : G) + (b : G) ∈ popularSums A t

theorem popularSumGraph_edge_count {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (t : ℝ) :
    bipartiteEdgeCount (popularSumGraph A t) =
      ∑ s ∈ popularSums A t, sumRepresentationCount A s := by
  classical
  unfold sumRepresentationCount
  rw [Finset.sum_card_fiberwise_eq_card_filter]
  unfold bipartiteEdgeCount
  apply Finset.card_bij (fun p _ => ((p.1 : G), (p.2 : G)))
  · intro p hp
    exact Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨p.1.property, p.2.property⟩,
      (Finset.mem_filter.mp hp).2⟩
  · intro p _ q _ h
    exact Prod.ext (Subtype.ext (congrArg Prod.fst h)) (Subtype.ext (congrArg Prod.snd h))
  · intro p hp
    rcases Finset.mem_filter.mp hp with ⟨hpA, hpD⟩
    rcases Finset.mem_product.mp hpA with ⟨ha, hb⟩
    refine ⟨(⟨p.1, ha⟩, ⟨p.2, hb⟩), ?_, rfl⟩
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hpD⟩

theorem popularSumGraph_proper {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (t : ℝ) :
    ProperBipartiteColoring (popularSumGraph A t) (fun a b : A => (a : G) + (b : G)) := by
  constructor
  · intro a b b' _ _ h
    exact Subtype.ext (add_left_cancel h)
  · intro a a' b _ _ h
    exact Subtype.ext (add_right_cancel h)

/-- Blueprint `lem:BSG`, lines 685-692: the popular-sum graph has density
at least `1/(2K)`, and addition gives a proper edge coloring. -/
theorem popularSumGraph_dense {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (hA : A.Nonempty) {K : ℝ} (hK : 0 < K)
    (henergy : (A.card : ℝ) ^ 3 / K ≤ Finset.addEnergy A A) :
    (1 / (2 * K)) * (A.card : ℝ) ^ 2 ≤
      bipartiteEdgeCount (popularSumGraph A ((A.card : ℝ) / (2 * K))) := by
  have h := popularSums_mass_lower A hA hK henergy
  have he : (bipartiteEdgeCount (popularSumGraph A ((A.card : ℝ) / (2 * K))) : ℝ) =
      ∑ s ∈ popularSums A ((A.card : ℝ) / (2 * K)), (sumRepresentationCount A s : ℝ) := by
    exact_mod_cast popularSumGraph_edge_count A ((A.card : ℝ) / (2 * K))
  rw [he]
  convert h using 1; ring

/-! ### Encoding paths for distinct differences -/

/-- Alternating four sum colors recovers the difference of the endpoints. -/
theorem sumPathColors_alternating {G : Type*} [AddCommGroup G]
    {A : Finset G} (x y : A) (p : A × A × A) :
    let c := bipartitePathColors (fun a b : A => (a : G) + (b : G)) x y p
    c.1 - c.2.1 + c.2.2.1 - c.2.2.2 = (x : G) - (y : G) := by
  dsimp [bipartitePathColors]
  abel

/-- Blueprint `lem:BSG`, lines 693-697. For one chosen endpoint pair per
difference, all four-step paths inject into ordered quadruples of popular
sums. Consequently the difference count times any uniform path lower bound
is at most the fourth power of the number of popular sums. -/
theorem popularSumGraph_difference_card_bound {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (t : ℝ) (S : Finset A) (L : ℝ)
    (hpaths : ∀ x ∈ S, ∀ y ∈ S, L ≤ (bipartiteFourPaths (popularSumGraph A t) x y).card) :
    (((S.image (fun a : A => (a : G))) - (S.image (fun a : A => (a : G)))).card : ℝ) * L ≤
      ((popularSums A t).card : ℝ) ^ 4 := by
  classical
  let T : Finset G := S.image (fun a : A => (a : G))
  let Δ : Finset G := T - T
  have hend : ∀ d : Δ, ∃ x ∈ S, ∃ y ∈ S, (x : G) - (y : G) = (d : G) := by
    intro d
    rcases Finset.mem_sub.mp d.property with ⟨a, ha, b, hb, hab⟩
    rcases Finset.mem_image.mp ha with ⟨x, hx, rfl⟩
    rcases Finset.mem_image.mp hb with ⟨y, hy, rfl⟩
    exact ⟨x, hx, y, hy, hab⟩
  choose x hx y hy hxy using hend
  let P : Finset (Σ _d : Δ, A × A × A) :=
    Finset.univ.sigma (fun d => bipartiteFourPaths (popularSumGraph A t) (x d) (y d))
  let colors : (Σ _d : Δ, A × A × A) → G × G × G × G := fun p =>
    bipartitePathColors (fun a b : A => (a : G) + (b : G)) (x p.1) (y p.1) p.2
  have hmap : Set.MapsTo colors P
      ((popularSums A t ×ˢ popularSums A t ×ˢ popularSums A t ×ˢ popularSums A t) :
        Finset (G × G × G × G)) := by
    intro p hp
    have hedges := (mem_bipartiteFourPaths _ _ _ _).mp (Finset.mem_sigma.mp hp).2
    exact Finset.mem_product.mpr ⟨hedges.1, Finset.mem_product.mpr
      ⟨hedges.2.1, Finset.mem_product.mpr ⟨hedges.2.2.1, hedges.2.2.2⟩⟩⟩
  have hinj : Set.InjOn colors P := by
    rintro ⟨d, p⟩ hp ⟨d', q⟩ hq hc
    have halt := congrArg (fun c : G × G × G × G => c.1 - c.2.1 + c.2.2.1 - c.2.2.2) hc
    have hd : d = d' := by
      apply Subtype.ext
      rw [← hxy d, ← hxy d']
      simpa only [colors, sumPathColors_alternating] using halt
    subst d'
    have hp' := (Finset.mem_sigma.mp hp).2
    have hq' := (Finset.mem_sigma.mp hq).2
    have heq := bipartitePathColors_injOn (popularSumGraph A t)
      (fun a b : A => (a : G) + (b : G)) (popularSumGraph_proper A t) (x d) (y d) hp' hq' hc
    exact congrArg (Sigma.mk d) heq
  have hcard := Finset.card_le_card_of_injOn colors hmap hinj
  have hlower : (Δ.card : ℝ) * L ≤ (P.card : ℝ) := by
    calc
      _ = ∑ _d : Δ, L := by simp
      _ ≤ ∑ d : Δ, ((bipartiteFourPaths (popularSumGraph A t) (x d) (y d)).card : ℝ) := by
        apply Finset.sum_le_sum
        intro d _
        exact hpaths (x d) (hx d) (y d) (hy d)
      _ = _ := by simp only [P, Finset.card_sigma, Nat.cast_sum]
  change (Δ.card : ℝ) * L ≤ _
  apply hlower.trans
  have hu : (P.card : ℝ) ≤
      ((popularSums A t).card : ℝ) * ((popularSums A t).card *
        ((popularSums A t).card * (popularSums A t).card)) := by
    exact_mod_cast (by simpa only [Finset.card_product] using hcard)
  convert hu using 1; ring

/-! ### Energy to a small difference set -/

/-- Blueprint `lem:BSG`, lines 683-698: if a nonempty finite subset of an
abelian group has additive energy at least `|A|^3/K`, it has a subset of
size at least `|A|/(80000000000 K)` whose difference set has size at most
`10^25 K^10` times its own size. The two numerical constants are universal. -/
theorem balog_szemeredi_gowers {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (hA : A.Nonempty) {K : ℝ} (hK : 1 ≤ K)
    (henergy : (A.card : ℝ) ^ 3 / K ≤ Finset.addEnergy A A) :
    ∃ S : Finset G, S ⊆ A ∧ (A.card : ℝ) / (80000000000 * K) ≤ S.card ∧
      ((S - S).card : ℝ) ≤ (10 : ℝ) ^ 25 * K ^ 10 * S.card := by
  classical
  have hKpos : 0 < K := lt_of_lt_of_le zero_lt_one hK
  have hn : (0 : ℝ) < A.card := by exact_mod_cast hA.card_pos
  let t : ℝ := (A.card : ℝ) / (2 * K)
  let η : ℝ := 1 / (2 * K)
  have hη : 0 < η := by dsimp [η]; positivity
  obtain ⟨S, hS, hpaths⟩ := bipartite_dense_four_paths (popularSumGraph A t) hη
    (n := A.card) (by simp) (by simp) (popularSumGraph_dense A hA hKpos henergy)
  let T : Finset G := S.image (fun a : A => (a : G))
  have hcardT : T.card = S.card := Finset.card_image_of_injective _ Subtype.val_injective
  have hsub : T ⊆ A := by
    intro a ha
    rcases Finset.mem_image.mp ha with ⟨b, _, rfl⟩
    exact b.property
  have hsize : (A.card : ℝ) / (80000000000 * K) ≤ T.card := by
    rw [hcardT]
    convert hS using 1; dsimp [η]; ring
  refine ⟨T, hsub, hsize, ?_⟩
  let L : ℝ := η ^ 5 * (A.card : ℝ) ^ 3 / 40000000000
  have hL : 0 < L := by dsimp [L]; positivity
  have hcount : ((T - T).card : ℝ) * L ≤ ((popularSums A t).card : ℝ) ^ 4 :=
    popularSumGraph_difference_card_bound A t S L hpaths
  have hD : ((popularSums A t).card : ℝ) ≤ 2 * K * A.card := popularSums_card_le A hA hKpos
  have hD4 : ((popularSums A t).card : ℝ) ^ 4 ≤ (2 * K * A.card) ^ 4 := by
    gcongr
  have hfirst : ((T - T).card : ℝ) ≤ 20480000000000 * K ^ 9 * A.card := by
    apply (mul_le_mul_iff_left₀ hL).mp
    calc
      _ ≤ ((popularSums A t).card : ℝ) ^ 4 := hcount
      _ ≤ (2 * K * A.card) ^ 4 := hD4
      _ = _ := by dsimp [L, η]; field_simp; ring
  have hnT : (A.card : ℝ) ≤ 80000000000 * K * T.card := by
    have h := (div_le_iff₀ (show (0 : ℝ) < 80000000000 * K by positivity)).mp hsize
    nlinarith
  calc
    ((T - T).card : ℝ) ≤ 20480000000000 * K ^ 9 * A.card := hfirst
    _ ≤ 20480000000000 * K ^ 9 * (80000000000 * K * T.card) := by
      exact mul_le_mul_of_nonneg_left hnT (by positivity)
    _ = 1638400000000000000000000 * K ^ 10 * T.card := by ring
    _ ≤ (10 : ℝ) ^ 25 * K ^ 10 * T.card := by
      gcongr
      norm_num

/-! ### Function graphs and character energy

These general counting identities supply the exact orthogonality step of
blueprint `lem:derivative-graph`, lines 856-861. Their statements use only
Mathlib and the local graph definitions. Proofs reuse finite-average
identities from the independently verified Gowers-Cauchy-Schwarz module.
-/

/-- The graph of a function restricted to a finite set. -/
def finiteFunctionGraph {G F : Type*} [DecidableEq G] [DecidableEq F]
    (H : Finset G) (ξ : G → F) : Finset (G × F) := H.image (fun h => (h, ξ h))

theorem mem_finiteFunctionGraph {G F : Type*} [DecidableEq G] [DecidableEq F]
    (H : Finset G) (ξ : G → F) (x : G) (y : F) :
    (x, y) ∈ finiteFunctionGraph H ξ ↔ x ∈ H ∧ ξ x = y := by
  simp [finiteFunctionGraph, Finset.mem_image, Prod.mk.injEq]

/-- Shift triples that describe additive parallelograms in a function graph. -/
def graphEnergyTriples {G F : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (H : Finset G) (ξ : G → F) : Finset (G × G × G) :=
  Finset.univ.filter (fun p => p.1 ∈ H ∧ p.1 + p.2.1 ∈ H ∧ p.2.2 ∈ H ∧
    p.2.2 + p.2.1 ∈ H ∧ ξ p.1 - ξ (p.1 + p.2.1) - ξ p.2.2 + ξ (p.2.2 + p.2.1) = 0)

def graphEnergyQuad {G F : Type*} [AddCommGroup G] (ξ : G → F) (p : G × G × G) :
    ((G × F) × (G × F)) × (G × F) × (G × F) :=
  (((p.1, ξ p.1), (p.1 + p.2.1, ξ (p.1 + p.2.1))),
    (p.2.2 + p.2.1, ξ (p.2.2 + p.2.1)), (p.2.2, ξ p.2.2))

/-- The shift-triple count is exactly the standard additive energy of the graph. -/
theorem graphEnergyTriples_card {G F : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (H : Finset G) (ξ : G → F) :
    (graphEnergyTriples H ξ).card =
      Finset.addEnergy (finiteFunctionGraph H ξ) (finiteFunctionGraph H ξ) := by
  unfold Finset.addEnergy
  apply Finset.card_bij (fun p _ => graphEnergyQuad ξ p)
  · intro p hp
    rcases p with ⟨h, u, t⟩
    simp only [graphEnergyTriples, Finset.mem_filter, Finset.mem_univ, true_and] at hp
    rcases hp with ⟨hh, hhu, ht, htu, hfreq⟩
    simp only [graphEnergyQuad, Finset.mem_filter, Finset.mem_product, mem_finiteFunctionGraph]
    refine ⟨⟨⟨⟨hh, trivial⟩, ⟨hhu, trivial⟩⟩, ⟨htu, trivial⟩, ⟨ht, trivial⟩⟩, ?_⟩
    apply Prod.ext
    · change h + (t + u) = (h + u) + t
      abel
    · change ξ h + ξ (t + u) = ξ (h + u) + ξ t
      apply sub_eq_zero.mp
      convert hfreq using 1; abel
  · intro p _ p' _ heq
    rcases p with ⟨h, u, t⟩
    rcases p' with ⟨h', u', t'⟩
    have hh := congrArg (fun z => z.1.1.1) heq
    have hu := congrArg (fun z => z.1.2.1) heq
    have ht := congrArg (fun z => z.2.2.1) heq
    dsimp only [graphEnergyQuad] at hh hu ht
    subst h'
    subst t'
    have huu : u = u' := add_left_cancel hu
    subst u'
    rfl
  · intro p hp
    rcases p with ⟨⟨⟨a, fa⟩, ⟨b, fb⟩⟩, ⟨c, fc⟩, ⟨d, fd⟩⟩
    simp only [Finset.mem_filter, Finset.mem_product, mem_finiteFunctionGraph] at hp
    rcases hp with ⟨⟨⟨⟨ha, rfl⟩, ⟨hb, rfl⟩⟩, ⟨hc, rfl⟩, ⟨hd, rfl⟩⟩, heq⟩
    have hfirst : a + c = b + d := congrArg Prod.fst heq
    have hsecond : ξ a + ξ c = ξ b + ξ d := congrArg Prod.snd heq
    have hab : a + (b - a) = b := by abel
    have hcd : d + (b - a) = c := by
      apply add_left_cancel (a := a)
      calc
        a + (d + (b - a)) = b + d := by abel
        _ = a + c := hfirst.symm
    refine ⟨(a, b - a, d), ?_, ?_⟩
    · simp only [graphEnergyTriples, Finset.mem_filter, Finset.mem_univ, true_and]
      rw [hab, hcd]
      refine ⟨ha, hb, hd, hc, ?_⟩
      have hh := sub_eq_zero.mpr hsecond
      convert hh using 1; abel
    · simp only [graphEnergyQuad, hab, hcd]

open scoped ComplexConjugate

/-- The character associated with a graph point, zero outside the graph's domain. -/
noncomputable def graphPhase {q : ℕ} [NeZero q]
    (H : Finset (ZMod q)) (ξ : ZMod q → ZMod q) (h k : ZMod q) : ℂ :=
  if h ∈ H then ZMod.stdAddChar (ξ h * k) else 0

theorem graph_character_orthogonality {q : ℕ} [NeZero q] (ζ : ZMod q) :
    (𝔼 k, ZMod.stdAddChar (ζ * k)) = if ζ = 0 then 1 else 0 := by
  rw [Fintype.expect_eq_sum_div_card]
  by_cases hζ : ζ = 0
  · simp [hζ, ZMod.card, NeZero.ne (q : ℂ)]
  · have hs : ∑ k, ZMod.stdAddChar (ζ * k) = 0 := by
      simpa only [AddChar.mulShift_apply] using
        AddChar.sum_eq_zero_of_ne_one (ZMod.isPrimitive_stdAddChar q hζ)
    simp [hs, hζ]

theorem graph_stdChar_conj {q : ℕ} [NeZero q] (x : ZMod q) :
    conj (ZMod.stdAddChar x) = ZMod.stdAddChar (-x) := by
  simp only [ZMod.stdAddChar_apply, AddChar.map_neg_eq_inv, ← Circle.coe_inv_eq_conj,
    Circle.coe_inv]

/-- Character orthogonality detects exactly the graph parallelogram relation. -/
theorem graphPhase_orthogonality {q : ℕ} [NeZero q]
    (H : Finset (ZMod q)) (ξ : ZMod q → ZMod q) (h u t : ZMod q) :
    (𝔼 k, (graphPhase H ξ h k * conj (graphPhase H ξ (h + u) k)) *
      conj (graphPhase H ξ t k * conj (graphPhase H ξ (t + u) k))) =
      if (h, u, t) ∈ graphEnergyTriples H ξ then 1 else 0 := by
  classical
  simp only [graphEnergyTriples, Finset.mem_filter, Finset.mem_univ, true_and]
  by_cases hh : h ∈ H <;> by_cases hhu : h + u ∈ H <;>
    by_cases ht : t ∈ H <;> by_cases htu : t + u ∈ H <;>
    simp only [graphPhase, hh, hhu, ht, htu, ite_true, ite_false, mul_zero, zero_mul,
      map_zero, Finset.expect_const_zero, and_false, true_and, false_and]
  simp only [map_mul, graph_stdChar_conj]
  simp_rw [← AddChar.map_add_eq_mul]
  rw [← graph_character_orthogonality]
  apply Finset.expect_congr rfl
  intro k _
  congr 1
  ring

theorem finite_expect_rotate_four {I J K L : Type*}
    [Fintype I] [Fintype J] [Fintype K] [Fintype L] (f : I → J → K → L → ℂ) :
    (𝔼 i, 𝔼 j, 𝔼 k, 𝔼 l, f i j k l) = 𝔼 j, 𝔼 k, 𝔼 l, 𝔼 i, f i j k l := by
  calc
    _ = 𝔼 j, 𝔼 i, 𝔼 k, 𝔼 l, f i j k l := Finset.expect_comm _ _ _
    _ = _ := by
      apply Finset.expect_congr rfl
      intro j _
      rw [Finset.expect_comm]
      apply Finset.expect_congr rfl
      intro k _
      exact Finset.expect_comm _ _ _

/-- A triple indicator average is its exact count divided by the cube of the ambient size. -/
theorem finiteTripleIndicator_average {G : Type*} [Fintype G] [DecidableEq G]
    (T : Finset (G × G × G)) :
    (𝔼 a, 𝔼 b, 𝔼 c, if (a, b, c) ∈ T then (1 : ℂ) else 0) =
      (T.card : ℂ) / (Fintype.card G : ℂ) ^ 3 := by
  have he : (𝔼 p : G × G × G, if p ∈ T then (1 : ℂ) else 0) =
      𝔼 a, 𝔼 b, 𝔼 c, if (a, b, c) ∈ T then (1 : ℂ) else 0 := by
    calc
      _ = 𝔼 a, 𝔼 p : G × G, if (a, p) ∈ T then (1 : ℂ) else 0 := by
        simpa only [Finset.univ_product_univ] using
          Finset.expect_product (Finset.univ : Finset G) (Finset.univ : Finset (G × G))
            (fun p => if p ∈ T then (1 : ℂ) else 0)
      _ = _ := by
        apply Finset.expect_congr rfl
        intro a _
        simpa only [Finset.univ_product_univ] using
          Finset.expect_product (Finset.univ : Finset G) (Finset.univ : Finset G)
            (fun p => if (a, p) ∈ T then (1 : ℂ) else 0)
  rw [← he, Fintype.expect_eq_sum_div_card]
  simp only [Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul,
    mul_one, Fintype.card_prod, Nat.cast_mul]
  congr 1
  ring

/-- The differenced graph characters have exactly normalized additive energy.
This is the character-orthogonality count in `lem:derivative-graph`, lines 856-861. -/
theorem graphPhase_energy {q : ℕ} [NeZero q]
    (H : Finset (ZMod q)) (ξ : ZMod q → ZMod q) :
    (𝔼 k, 𝔼 u, ‖𝔼 h, graphPhase H ξ h k * conj (graphPhase H ξ (h + u) k)‖ ^ 2) =
      (Finset.addEnergy (finiteFunctionGraph H ξ) (finiteFunctionGraph H ξ) : ℝ) /
        (q : ℝ) ^ 3 := by
  apply Complex.ofReal_injective
  simp only [finite_expect_ofReal, finite_expect_norm_sq_eq]
  simp only [Complex.ofReal_div, Complex.ofReal_natCast, Complex.ofReal_pow]
  rw [finite_expect_rotate_four]
  simp only [graphPhase_orthogonality]
  rw [Finset.expect_comm]
  simpa only [ZMod.card, graphEnergyTriples_card] using
    finiteTripleIndicator_average (graphEnergyTriples H ξ)

theorem finiteFunctionGraph_card {G F : Type*} [DecidableEq G] [DecidableEq F]
    (H : Finset G) (ξ : G → F) : (finiteFunctionGraph H ξ).card = H.card :=
  Finset.card_image_of_injective _ (fun _ _ h => congrArg Prod.fst h)

/-- Every subset of a function graph is the same function restricted to its projected domain. -/
theorem finiteFunctionGraph_subset {G F : Type*} [DecidableEq G] [DecidableEq F]
    (H : Finset G) (ξ : G → F) (T : Finset (G × F)) (hT : T ⊆ finiteFunctionGraph H ξ) :
    ∃ H' : Finset G, H' ⊆ H ∧ T = finiteFunctionGraph H' ξ ∧ H'.card = T.card := by
  let H' := T.image Prod.fst
  have hmem (p : G × F) (hp : p ∈ T) : p.1 ∈ H ∧ ξ p.1 = p.2 :=
    (mem_finiteFunctionGraph H ξ p.1 p.2).mp (hT hp)
  refine ⟨H', ?_, ?_, ?_⟩
  · intro x hx
    obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hx
    exact (hmem p hp).1
  · ext p
    rcases p with ⟨x, y⟩
    rw [mem_finiteFunctionGraph]
    constructor
    · intro hp
      exact ⟨Finset.mem_image.mpr ⟨(x, y), hp, rfl⟩, (hmem _ hp).2⟩
    · rintro ⟨hx, rfl⟩
      obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hx
      convert hp using 1
      exact Prod.ext rfl (hmem p hp).2
  · apply Finset.card_image_of_injOn
    intro a ha b hb hab
    exact Prod.ext hab ((hmem a ha).2.symm.trans ((congrArg ξ hab).trans (hmem b hb).2))

/-- BSG preserves the graph structure and the original frequency function on a large domain. -/
theorem graph_balog_szemeredi_gowers {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (H : Finset G) (hH : H.Nonempty) (ξ : G → F)
    {K : ℝ} (hK : 1 ≤ K)
    (henergy : (H.card : ℝ) ^ 3 / K ≤
      Finset.addEnergy (finiteFunctionGraph H ξ) (finiteFunctionGraph H ξ)) :
    ∃ H' : Finset G, H' ⊆ H ∧ (H.card : ℝ) / (80000000000 * K) ≤ H'.card ∧
      ((finiteFunctionGraph H' ξ - finiteFunctionGraph H' ξ).card : ℝ) ≤
        10 ^ 25 * K ^ 10 * H'.card := by
  have hgraph : (finiteFunctionGraph H ξ).Nonempty := hH.image _
  obtain ⟨T, hT, hsize, hdiff⟩ := balog_szemeredi_gowers (finiteFunctionGraph H ξ) hgraph hK
    (by simpa only [finiteFunctionGraph_card] using henergy)
  obtain ⟨H', hsub, heq, hcard⟩ := finiteFunctionGraph_subset H ξ T hT
  refine ⟨H', hsub, ?_, ?_⟩
  · simpa only [finiteFunctionGraph_card, ← hcard] using hsize
  · simpa only [heq, finiteFunctionGraph_card] using hdiff

/-- The vertical fiber of an iterated difference of a finite subset of a product group. -/
def graphVerticalDifferences {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (Γ : Finset (G × F)) (m n : ℕ) : Finset F :=
  ((m • Γ - n • Γ).filter (fun p => p.1 = 0)).image Prod.snd

theorem mem_graphVerticalDifferences {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (Γ : Finset (G × F)) (m n : ℕ) (χ : F) :
    χ ∈ graphVerticalDifferences Γ m n ↔ (0, χ) ∈ m • Γ - n • Γ := by
  simp only [graphVerticalDifferences, Finset.mem_image, Finset.mem_filter]
  constructor
  · rintro ⟨⟨x, y⟩, ⟨hp, hx⟩, rfl⟩
    change x = 0 at hx
    subst x
    exact hp
  · intro hp
    exact ⟨(0, χ), ⟨hp, rfl⟩, rfl⟩

/-- Translating graph points by vertical differences is injective. -/
theorem graphVerticalDifferences_card_mul_le {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (H : Finset G) (ξ : G → F) (m n : ℕ) :
    (finiteFunctionGraph H ξ).card *
      (graphVerticalDifferences (finiteFunctionGraph H ξ) m n).card ≤
      (((m + 1) • finiteFunctionGraph H ξ - n • finiteFunctionGraph H ξ).card) := by
  let Γ := finiteFunctionGraph H ξ
  rw [← Finset.card_product]
  apply Finset.card_le_card_of_injOn (fun p : (G × F) × F => p.1 + (0, p.2))
  · intro p hp
    obtain ⟨hpΓ, hpD⟩ := Finset.mem_product.mp hp
    have hv := (mem_graphVerticalDifferences Γ m n p.2).mp hpD
    obtain ⟨a, ha, b, hb, hab⟩ := Finset.mem_sub.mp hv
    have hm : p.1 + a ∈ (m + 1) • Γ := by
      rw [add_nsmul, one_nsmul, add_comm p.1 a]
      exact Finset.add_mem_add ha hpΓ
    have he : p.1 + (0, p.2) = (p.1 + a) - b := by rw [← hab]; abel
    change p.1 + (0, p.2) ∈ (m + 1) • Γ - n • Γ
    rw [he]
    exact Finset.sub_mem_sub hm hb
  · intro p hp r hr heq
    have hpΓ := (Finset.mem_product.mp hp).1
    have hrΓ := (Finset.mem_product.mp hr).1
    have hpξ := (mem_finiteFunctionGraph H ξ p.1.1 p.1.2).mp hpΓ
    have hrξ := (mem_finiteFunctionGraph H ξ r.1.1 r.1.2).mp hrΓ
    have hfirst : p.1.1 = r.1.1 := by simpa using congrArg Prod.fst heq
    have hgraph : p.1 = r.1 :=
      Prod.ext hfirst (hpξ.2.symm.trans ((congrArg ξ hfirst).trans hrξ.2))
    have hsecond : p.2 = r.2 := by
      have hh := congrArg Prod.snd heq
      change p.1.2 + p.2 = r.1.2 + r.2 at hh
      rw [hgraph] at hh
      exact add_left_cancel hh
    exact Prod.ext hgraph hsecond

/-- Pluennecke-Ruzsa bounds the vertical fiber of every iterated graph difference. -/
theorem graphVerticalDifferences_card_le {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (H : Finset G) (hH : H.Nonempty) (ξ : G → F)
    {K : ℝ} (_hK : 1 ≤ K)
    (hsmall : ((finiteFunctionGraph H ξ - finiteFunctionGraph H ξ).card : ℝ) ≤
      K * H.card) (m n : ℕ) :
    ((graphVerticalDifferences (finiteFunctionGraph H ξ) m n).card : ℝ) ≤ K ^ (m + 1 + n) := by
  let Γ := finiteFunctionGraph H ξ
  have hΓ : Γ.Nonempty := hH.image _
  have hn : (0 : ℝ) < Γ.card := by exact_mod_cast hΓ.card_pos
  have hratio : ((Γ - Γ).card : ℝ) / Γ.card ≤ K := by
    apply (div_le_iff₀ hn).mpr
    simpa only [Γ, finiteFunctionGraph_card] using hsmall
  have h := Finset.pluennecke_ruzsa_inequality_nsmul_sub_nsmul_sub hΓ Γ (m + 1) n
  have hg : ((((m + 1) • Γ - n • Γ).card : ℝ)) ≤
      (((Γ - Γ).card : ℝ) / Γ.card) ^ (m + 1 + n) * Γ.card := by
    simpa only [NNRat.cast_natCast, NNRat.cast_mul, NNRat.cast_pow, NNRat.cast_div] using
      (NNRat.cast_le (K := ℝ)).mpr h
  have hg' : ((((m + 1) • Γ - n • Γ).card : ℝ)) ≤ K ^ (m + 1 + n) * Γ.card := by
    apply hg.trans
    gcongr
  have hc : (Γ.card : ℝ) * (graphVerticalDifferences Γ m n).card ≤
      (((m + 1) • Γ - n • Γ).card : ℝ) := by
    exact_mod_cast graphVerticalDifferences_card_mul_le H ξ m n
  apply (mul_le_mul_iff_left₀ hn).mp
  simpa only [mul_comm] using hc.trans hg'

/-- Blueprint `lem:local-frequency`, lines 883-885: the vertical obstruction set has size `K^17`. -/
theorem graphVerticalDifferences_eight_card_le {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (H : Finset G) (hH : H.Nonempty) (ξ : G → F)
    {K : ℝ} (hK : 1 ≤ K)
    (hsmall : ((finiteFunctionGraph H ξ - finiteFunctionGraph H ξ).card : ℝ) ≤ K * H.card) :
    ((graphVerticalDifferences (finiteFunctionGraph H ξ) 8 8).card : ℝ) ≤ K ^ 17 :=
  graphVerticalDifferences_card_le H hH ξ hK hsmall 8 8

/-- A uniform phase bound on pairwise differences extends linearly to iterated differences. -/
theorem iterated_difference_phase_bound {G E : Type*} [AddCommGroup G] [DecidableEq G]
    [SeminormedAddCommGroup E] (φ : G →+ E) (A : Finset G) (ε : ℝ)
    (hA : ∀ a ∈ A, ∀ b ∈ A, ‖φ (a - b)‖ ≤ ε) (m : ℕ)
    (z : G) (hz : z ∈ m • A - m • A) : ‖φ z‖ ≤ (m : ℝ) * ε := by
  induction m generalizing z with
  | zero =>
      have he : z = 0 := by simpa using hz
      simp [he]
  | succ m ih =>
      rw [add_nsmul, one_nsmul] at hz
      obtain ⟨a, ha, b, hb, rfl⟩ := Finset.mem_sub.mp hz
      obtain ⟨a₁, ha₁, a₂, ha₂, rfl⟩ := Finset.mem_add.mp ha
      obtain ⟨b₁, hb₁, b₂, hb₂, rfl⟩ := Finset.mem_add.mp hb
      have he : (a₁ + a₂) - (b₁ + b₂) = (a₁ - b₁) + (a₂ - b₂) := by abel
      rw [he, map_add]
      calc
        ‖φ (a₁ - b₁) + φ (a₂ - b₂)‖ ≤ ‖φ (a₁ - b₁)‖ + ‖φ (a₂ - b₂)‖ :=
          norm_add_le _ _
        _ ≤ (m : ℝ) * ε + ε := add_le_add
          (ih (a₁ - b₁) (Finset.sub_mem_sub ha₁ hb₁)) (hA a₂ ha₂ b₂ hb₂)
        _ = ((m + 1 : ℕ) : ℝ) * ε := by push_cast; ring

/-- Absence of vertical differences in the doubled difference set implies a graph property. -/
theorem iterated_graph_of_no_vertical {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (Γ : Finset (G × F)) (m : ℕ)
    (hzero : ∀ χ : F, (0, χ) ∈ (m + m) • Γ - (m + m) • Γ → χ = 0) :
    Set.InjOn Prod.fst (↑(m • Γ - m • Γ) : Set (G × F)) := by
  intro p hp r hr heq
  have hv : p - r ∈ (m + m) • Γ - (m + m) • Γ := by
    obtain ⟨a, ha, b, hb, rfl⟩ := Finset.mem_sub.mp hp
    obtain ⟨c, hc, d, hd, rfl⟩ := Finset.mem_sub.mp hr
    have he : (a - b) - (c - d) = (a + d) - (b + c) := by abel
    rw [he, add_nsmul]
    exact Finset.sub_mem_sub (Finset.add_mem_add ha hd) (Finset.add_mem_add hb hc)
  have hid : p - r = (0, p.2 - r.2) := by
    apply Prod.ext
    · change p.1 - r.1 = 0
      exact sub_eq_zero.mpr heq
    · rfl
  rw [hid] at hv
  exact Prod.ext heq (sub_eq_zero.mp (hzero _ hv))

/-- Character separation and one common cube eliminate all vertical eightfold differences. -/
theorem cyclic_graph_cube_no_vertical {G : Type*} [AddCommGroup G] [DecidableEq G]
    {q d : ℕ} [NeZero q] (H H' : Finset G) (ξ : G → ZMod q)
    (hsub : H' ⊆ H) (g : Fin d → ZMod q)
    (hsep : ∀ χ ∈ graphVerticalDifferences (finiteFunctionGraph H ξ) 8 8,
      χ ≠ 0 → ∃ j, (1 / 8 : ℝ) ≤ ‖ZMod.toAddCircle (χ * g j)‖)
    (hcube : ∀ h ∈ H', ∀ h' ∈ H', ∀ j,
      ‖ZMod.toAddCircle ((ξ h - ξ h') * g j)‖ < (1 : ℝ) / 256) :
    ∀ χ : ZMod q, (0, χ) ∈ 8 • finiteFunctionGraph H' ξ - 8 • finiteFunctionGraph H' ξ →
      χ = 0 := by
  intro χ hχ
  have hgraph : finiteFunctionGraph H' ξ ⊆ finiteFunctionGraph H ξ :=
    Finset.image_mono (fun h => (h, ξ h)) hsub
  have hiter : 8 • finiteFunctionGraph H' ξ - 8 • finiteFunctionGraph H' ξ ⊆
      8 • finiteFunctionGraph H ξ - 8 • finiteFunctionGraph H ξ := by gcongr
  have hD := (mem_graphVerticalDifferences (finiteFunctionGraph H ξ) 8 8 χ).mpr (hiter hχ)
  by_contra hn
  obtain ⟨j, hj⟩ := hsep χ hD hn
  let φ : (G × ZMod q) →+ UnitAddCircle :=
    { toFun := fun p => ZMod.toAddCircle (p.2 * g j)
      map_zero' := by simp
      map_add' := by intro a b; simp [add_mul] }
  have hpair : ∀ a ∈ finiteFunctionGraph H' ξ, ∀ b ∈ finiteFunctionGraph H' ξ,
      ‖φ (a - b)‖ ≤ (1 : ℝ) / 256 := by
    intro a ha b hb
    obtain ⟨ha', hea⟩ := (mem_finiteFunctionGraph H' ξ a.1 a.2).mp ha
    obtain ⟨hb', heb⟩ := (mem_finiteFunctionGraph H' ξ b.1 b.2).mp hb
    change ‖ZMod.toAddCircle ((a.2 - b.2) * g j)‖ ≤ (1 : ℝ) / 256
    rw [← hea, ← heb]
    exact (hcube a.1 ha' b.1 hb' j).le
  have hbound := iterated_difference_phase_bound φ (finiteFunctionGraph H' ξ)
    ((1 : ℝ) / 256) hpair 8 (0, χ) hχ
  change ‖ZMod.toAddCircle (χ * g j)‖ ≤ (8 : ℝ) * (1 / 256) at hbound
  linarith

/-- A nonempty graph has zero in every equal-order vertical difference set. -/
theorem graphVerticalDifferences_nonempty {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (H : Finset G) (hH : H.Nonempty)
    (ξ : G → F) (m : ℕ) :
    (graphVerticalDifferences (finiteFunctionGraph H ξ) m m).Nonempty := by
  obtain ⟨h, hh⟩ := hH
  have hg : (h, ξ h) ∈ finiteFunctionGraph H ξ :=
    (mem_finiteFunctionGraph H ξ h (ξ h)).mpr ⟨hh, rfl⟩
  have hm : m • (h, ξ h) ∈ m • finiteFunctionGraph H ξ := Finset.nsmul_mem_nsmul hg
  refine ⟨0, (mem_graphVerticalDifferences _ _ _ _).mpr ?_⟩
  simpa only [sub_self, Prod.zero_eq_mk] using Finset.sub_mem_sub hm hm

/-- The source logarithmic cube refinement makes the fourfold difference set a graph. -/
theorem cyclic_graph_refinement {q : ℕ} [NeZero q]
    (H : Finset (ZMod q)) (hH : H.Nonempty) (ξ : ZMod q → ZMod q) :
    ∃ H' : Finset (ZMod q), H' ⊆ H ∧ H'.Nonempty ∧
      (H.card : ℝ) / (256 : ℝ) ^
        ⌈Real.log (2 * ((graphVerticalDifferences (finiteFunctionGraph H ξ) 8 8).card : ℝ)) /
          Real.log 2⌉₊ ≤ H'.card ∧
      Set.InjOn Prod.fst
        (↑(4 • finiteFunctionGraph H' ξ - 4 • finiteFunctionGraph H' ξ) :
          Set (ZMod q × ZMod q)) := by
  let D := graphVerticalDifferences (finiteFunctionGraph H ξ) 8 8
  obtain ⟨g, hsep⟩ := cyclic_logarithmic_separating_family D
    (graphVerticalDifferences_nonempty H hH ξ 8)
  obtain ⟨H', hsub, hne, hcard, hcube⟩ := cyclic_frequency_dense_cube H hH ξ g
  refine ⟨H', hsub, hne, hcard, ?_⟩
  exact iterated_graph_of_no_vertical (finiteFunctionGraph H' ξ) 4
    (cyclic_graph_cube_no_vertical H H' ξ hsub g hsep hcube)

/-- The cyclic Bohr domain used for the local graph model. -/
noncomputable def graphBohrSet {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (ρ : ℝ) :
    Finset (ZMod q) :=
  Finset.univ.filter (fun u => ∀ s ∈ S, ‖ZMod.toAddCircle (s * u)‖ < ρ)

theorem mem_graphBohrSet {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (ρ : ℝ) (u : ZMod q) :
    u ∈ graphBohrSet S ρ ↔ ∀ s ∈ S, ‖ZMod.toAddCircle (s * u)‖ < ρ := by
  classical
  simp [graphBohrSet]

theorem zero_mem_graphBohrSet {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {ρ : ℝ} (hρ : 0 < ρ) : (0 : ZMod q) ∈ graphBohrSet S ρ := by
  rw [mem_graphBohrSet]
  simpa using fun _ _ => hρ

/-- Dense Bogolyubov with the unit frequency, the source small radius,
and a single polynomial bound for rank plus logarithmic reciprocal radius. -/
theorem cyclic_small_bohr_domain {q : ℕ} [NeZero q]
    (H : Finset (ZMod q)) (hH : H.Nonempty) :
    ∃ S : Finset (ZMod q), ∃ ρ : ℝ, 1 ∈ S ∧ 0 < ρ ∧ ρ < 1 / 100 ∧
      (S.card : ℝ) + Real.log (1 / ρ) ≤
        10 ^ 20 * (1 + Real.log (1 / ((H.card : ℝ) / q))) ^ 4 ∧
      graphBohrSet S ρ ⊆ 2 • H - 2 • H := by
  classical
  let α : ℝ := (H.card : ℝ) / q
  have hq : (0 : ℝ) < q := Nat.cast_pos.mpr (NeZero.pos q)
  have hα : 0 < α := by
    have hh : (0 : ℝ) < H.card := by exact_mod_cast hH.card_pos
    exact div_pos hh hq
  have hα1 : α ≤ 1 := by
    apply (div_le_one hq).mpr
    exact_mod_cast (show H.card ≤ q by simpa only [ZMod.card] using Finset.card_le_univ H)
  obtain ⟨S, hS, hcontain⟩ := bogolyubov_bohr_containment H hH
  let ρ := bogolyubovRadius α S.card
  obtain ⟨hρ, _, _⟩ := bogolyubov_radius_bounds hα hα1 S.card hS
  have hsmall : ρ < 1 / 100 := by
    change α / (1000 * ((S.card : ℝ) + 1)) < 1 / 100
    apply (div_lt_iff₀ (by positivity : (0 : ℝ) < 1000 * ((S.card : ℝ) + 1))).mpr
    nlinarith [Nat.cast_nonneg S.card (α := ℝ)]
  have hlog := bogolyubov_radius_log_bound hα hα1 S.card hS
  have hlog' : Real.log (1 / ρ) ≤ 4 * 10 ^ 18 * bogolyubovLog α := by
    apply le_trans (Real.log_le_log (by positivity : 0 < 1 / ρ) ?_) hlog
    apply div_le_div_of_nonneg_right (by norm_num : (1 : ℝ) ≤ 3) hρ.le
  have hL : 1 ≤ bogolyubovLog α := bogolyubovLog_one_le hα hα1
  have hL4 : 1 ≤ bogolyubovLog α ^ 4 := one_le_pow₀ hL
  have hLpow : bogolyubovLog α ≤ bogolyubovLog α ^ 4 := by
    have hL3 : 1 ≤ bogolyubovLog α ^ 3 := one_le_pow₀ hL
    have hm := mul_le_mul_of_nonneg_left hL3 (by linarith : 0 ≤ bogolyubovLog α)
    nlinarith only [hm]
  refine ⟨insert 1 S, ρ, Finset.mem_insert_self _ _, hρ, hsmall, ?_, ?_⟩
  · have hc : ((insert (1 : ZMod q) S).card : ℝ) ≤ S.card + 1 := by
      exact_mod_cast Finset.card_insert_le (1 : ZMod q) S
    change ((insert (1 : ZMod q) S).card : ℝ) + Real.log (1 / ρ) ≤
      10 ^ 20 * bogolyubovLog α ^ 4
    change (S.card : ℝ) ≤ 10 ^ 14 * bogolyubovLog α ^ 4 at hS
    nlinarith
  · intro u hu
    apply hcontain
    rw [mem_bogolyubovBohrSet]
    intro s hs
    exact (mem_graphBohrSet _ _ _).mp hu s (Finset.mem_insert_of_mem hs)

/-- The first projection of a finite function graph is its domain. -/
theorem finiteFunctionGraph_image_fst {G F : Type*} [DecidableEq G] [DecidableEq F]
    (H : Finset G) (ξ : G → F) : (finiteFunctionGraph H ξ).image Prod.fst = H := by
  simp [finiteFunctionGraph, Finset.image_image, Function.comp_def]

/-- Every point of an iterated domain difference has a frequency lift in the graph difference. -/
theorem graph_difference_lift {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (H : Finset G) (ξ : G → F) (m : ℕ)
    (u : G) (hu : u ∈ m • H - m • H) :
    ∃ v : F, (u, v) ∈ m • finiteFunctionGraph H ξ - m • finiteFunctionGraph H ξ := by
  let φ : G × F →+ G := AddMonoidHom.fst G F
  let Γ := finiteFunctionGraph H ξ
  have he : (m • Γ - m • Γ).image (φ : G × F → G) = m • H - m • H := by
    have hs : (m • Γ - m • Γ).image (φ : G × F → G) =
        (m • Γ).image φ - (m • Γ).image φ :=
      Finset.image_image₂_distrib (map_sub φ)
    rw [hs, Finset.image_nsmul]
    change m • Γ.image Prod.fst - m • Γ.image Prod.fst = _
    rw [finiteFunctionGraph_image_fst]
  have hm : u ∈ (m • Γ - m • Γ).image (φ : G × F → G) := by rw [he]; exact hu
  obtain ⟨p, hp, hpu⟩ := Finset.mem_image.mp hm
  refine ⟨p.2, ?_⟩
  change p.1 = u at hpu
  simpa only [← hpu] using hp

/-- Zero belongs to every equal-order difference of a nonempty set. -/
theorem zero_mem_iterated_difference {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (hA : A.Nonempty) (m : ℕ) : (0 : G) ∈ m • A - m • A := by
  obtain ⟨a, ha⟩ := hA
  have hm : m • a ∈ m • A := Finset.nsmul_mem_nsmul ha
  simpa only [sub_self] using Finset.sub_mem_sub hm hm

/-- Adding two equal-order differences doubles their order. -/
theorem add_mem_doubled_difference {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (m : ℕ) {x y : G} (hx : x ∈ m • A - m • A)
    (hy : y ∈ m • A - m • A) : x + y ∈ (m + m) • A - (m + m) • A := by
  obtain ⟨a, ha, b, hb, rfl⟩ := Finset.mem_sub.mp hx
  obtain ⟨c, hc, d, hd, rfl⟩ := Finset.mem_sub.mp hy
  have he : (a - b) + (c - d) = (a + c) - (b + d) := by abel
  rw [he, add_nsmul]
  exact Finset.sub_mem_sub (Finset.add_mem_add ha hc) (Finset.add_mem_add hb hd)

/-- Padding both sides by the same point embeds a difference set into its double. -/
theorem difference_subset_double_difference {G : Type*} [AddCommGroup G] [DecidableEq G]
    (A : Finset G) (hA : A.Nonempty) : A - A ⊆ 2 • A - 2 • A := by
  intro x hx
  have hz : (0 : G) ∈ 1 • A - 1 • A := zero_mem_iterated_difference A hA 1
  have hx' : x ∈ 1 • A - 1 • A := by simpa only [one_nsmul] using hx
  simpa only [add_zero] using add_mem_doubled_difference A 1 hx' hz

/-- A domain inside a double difference set has a unique frequency lift;
injectivity on the fourfold graph gives the full order-two Freiman identity. -/
theorem local_graph_frequency_lift {G F : Type*} [AddCommGroup G] [DecidableEq G]
    [AddCommGroup F] [DecidableEq F] (H : Finset G) (hH : H.Nonempty) (ξ : G → F)
    (B : Finset G) (hBzero : 0 ∈ B) (hB : B ⊆ 2 • H - 2 • H)
    (hgraph : Set.InjOn Prod.fst
      (↑(4 • finiteFunctionGraph H ξ - 4 • finiteFunctionGraph H ξ) : Set (G × F))) :
    ∃ f : G → F, f 0 = 0 ∧
      (∀ u ∈ B, (u, f u) ∈ 2 • finiteFunctionGraph H ξ - 2 • finiteFunctionGraph H ξ) ∧
      (∀ a ∈ B, ∀ b ∈ B, ∀ c ∈ B, ∀ d ∈ B,
        a + b = c + d → f a + f b = f c + f d) ∧
      ∀ h ∈ H, ∀ h' ∈ H, h - h' ∈ B → f (h - h') = ξ h - ξ h' := by
  classical
  let Γ := finiteFunctionGraph H ξ
  have hΓ : Γ.Nonempty := hH.image (fun h => (h, ξ h))
  have hz : (0 : G × F) ∈ 2 • Γ - 2 • Γ := zero_mem_iterated_difference Γ hΓ 2
  have hinc : 2 • Γ - 2 • Γ ⊆ 4 • Γ - 4 • Γ := by
    intro x hx
    simpa only [add_zero] using add_mem_doubled_difference Γ 2 hx hz
  have hunique : Set.InjOn Prod.fst (↑(2 • Γ - 2 • Γ) : Set (G × F)) :=
    fun _ hp _ hr he => hgraph (hinc hp) (hinc hr) he
  have hex (u : G) : ∃ v : F, u ∈ B → (u, v) ∈ 2 • Γ - 2 • Γ := by
    by_cases hu : u ∈ B
    · obtain ⟨v, hv⟩ := graph_difference_lift H ξ 2 u (hB hu)
      exact ⟨v, fun _ => hv⟩
    · exact ⟨0, fun h => False.elim (hu h)⟩
  choose f hf using hex
  refine ⟨f, ?_, hf, ?_, ?_⟩
  · exact congrArg Prod.snd (hunique (hf 0 hBzero) hz rfl)
  · intro a ha b hb c hc d hd he
    have hab := add_mem_doubled_difference Γ 2 (hf a ha) (hf b hb)
    have hcd := add_mem_doubled_difference Γ 2 (hf c hc) (hf d hd)
    exact congrArg Prod.snd (hgraph hab hcd he)
  · intro h hh h' hh' hu
    have hp : (h - h', ξ h - ξ h') ∈ Γ - Γ :=
      Finset.sub_mem_sub ((mem_finiteFunctionGraph H ξ h (ξ h)).mpr ⟨hh, rfl⟩)
        ((mem_finiteFunctionGraph H ξ h' (ξ h')).mpr ⟨hh', rfl⟩)
    have hp' := difference_subset_double_difference Γ hΓ hp
    exact congrArg Prod.snd (hunique (hf (h - h') hu) hp' rfl)

/-- In odd cyclic groups the unique graph frequency lift can be halved,
retaining Freiman order two, local additivity, and all original graph differences. -/
theorem cyclic_local_frequency_map {q : ℕ} [NeZero q] (hq : Odd q)
    (H : Finset (ZMod q)) (hH : H.Nonempty) (ξ : ZMod q → ZMod q)
    (B : Finset (ZMod q)) (hBzero : 0 ∈ B) (hB : B ⊆ 2 • H - 2 • H)
    (hgraph : Set.InjOn Prod.fst
      (↑(4 • finiteFunctionGraph H ξ - 4 • finiteFunctionGraph H ξ) :
        Set (ZMod q × ZMod q))) :
    ∃ M : ZMod q → ZMod q, M 0 = 0 ∧
      (∀ a ∈ B, ∀ b ∈ B, ∀ c ∈ B, ∀ d ∈ B,
        a + b = c + d → 2 * M a + 2 * M b = 2 * M c + 2 * M d) ∧
      (∀ u ∈ B, ∀ v ∈ B, u + v ∈ B → M (u + v) = M u + M v) ∧
      ∀ h ∈ H, ∀ h' ∈ H, h - h' ∈ B → ξ h - ξ h' = 2 * M (h - h') := by
  obtain ⟨f, hfzero, _, hfreiman, hdiff⟩ :=
    local_graph_frequency_lift H hH ξ B hBzero hB hgraph
  have hunit : IsUnit (2 : ZMod q) := by
    exact (ZMod.isUnit_iff_coprime 2 q).mpr (Nat.coprime_two_left.mpr hq)
  let M : ZMod q → ZMod q := fun u => (2 : ZMod q)⁻¹ * f u
  have hdouble (u : ZMod q) : 2 * M u = f u := by
    dsimp [M]
    rw [← mul_assoc, ZMod.mul_inv_of_unit _ hunit, one_mul]
  refine ⟨M, ?_, ?_, ?_, ?_⟩
  · simp [M, hfzero]
  · intro a ha b hb c hc d hd he
    simpa only [hdouble] using hfreiman a ha b hb c hc d hd he
  · intro u hu v hv huv
    have hf : f u + f v = f (u + v) := by
      simpa only [hfzero, add_zero] using
        hfreiman u hu v hv (u + v) huv 0 hBzero (by simp)
    dsimp [M]
    rw [← hf, mul_add]
  · intro h hh h' hh' hu
    rw [hdouble]
    exact (hdiff h hh h' hh' hu).symm

/-- The exact logarithmic test count gives a polynomial cube-partition cost. -/
theorem logarithmic_cube_partition_cost {x : ℝ} (hx : 1 ≤ x) :
    (256 : ℝ) ^ ⌈Real.log (2 * x) / Real.log 2⌉₊ ≤ 65536 * x ^ 8 := by
  let d := ⌈Real.log (2 * x) / Real.log 2⌉₊
  have hxpos : 0 < x := by linarith
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hnonneg : 0 ≤ Real.log (2 * x) / Real.log 2 := by
    apply div_nonneg (Real.log_nonneg (by linarith)) hlogtwo.le
  have hd : (d : ℝ) ≤ Real.log (2 * x) / Real.log 2 + 1 :=
    (Nat.ceil_lt_add_one hnonneg).le
  have hm := mul_le_mul_of_nonneg_right hd hlogtwo.le
  rw [add_mul, div_mul_cancel₀ _ hlogtwo.ne', one_mul] at hm
  have hpower : (2 : ℝ) ^ d ≤ 4 * x := by
    calc
      (2 : ℝ) ^ d = Real.exp ((d : ℝ) * Real.log 2) := by
        rw [mul_comm, Real.exp_mul, Real.exp_log (by norm_num : (0 : ℝ) < 2),
          Real.rpow_natCast]
      _ ≤ Real.exp (Real.log (2 * x) + Real.log 2) := Real.exp_le_exp.mpr hm
      _ = 4 * x := by
        rw [Real.exp_add, Real.exp_log (by positivity), Real.exp_log (by norm_num)]
        ring
  change (256 : ℝ) ^ d ≤ _
  calc
    (256 : ℝ) ^ d = ((2 : ℝ) ^ d) ^ 8 := by
      rw [← pow_mul, Nat.mul_comm d 8, pow_mul]
      norm_num
    _ ≤ (4 * x) ^ 8 := pow_le_pow_left₀ (by positivity) hpower 8
    _ = 65536 * x ^ 8 := by ring

/-- Graph refinement loses only a fixed polynomial of the difference-set constant. -/
theorem cyclic_graph_refinement_polynomial {q : ℕ} [NeZero q]
    (H : Finset (ZMod q)) (hH : H.Nonempty) (ξ : ZMod q → ZMod q)
    {K : ℝ} (hK : 1 ≤ K)
    (hsmall : ((finiteFunctionGraph H ξ - finiteFunctionGraph H ξ).card : ℝ) ≤
      K * H.card) :
    ∃ H' : Finset (ZMod q), H' ⊆ H ∧ H'.Nonempty ∧
      ((H.card : ℝ) / q) / (65536 * K ^ 136) ≤ (H'.card : ℝ) / q ∧
      Set.InjOn Prod.fst
        (↑(4 • finiteFunctionGraph H' ξ - 4 • finiteFunctionGraph H' ξ) :
          Set (ZMod q × ZMod q)) := by
  let D := graphVerticalDifferences (finiteFunctionGraph H ξ) 8 8
  have hD : 1 ≤ (D.card : ℝ) := by
    exact_mod_cast (graphVerticalDifferences_nonempty H hH ξ 8).card_pos
  have hbound : (D.card : ℝ) ≤ K ^ 17 :=
    graphVerticalDifferences_eight_card_le H hH ξ hK hsmall
  have hcost : (256 : ℝ) ^ ⌈Real.log (2 * (D.card : ℝ)) / Real.log 2⌉₊ ≤
      65536 * K ^ 136 := by
    calc
      _ ≤ 65536 * (D.card : ℝ) ^ 8 := logarithmic_cube_partition_cost hD
      _ ≤ 65536 * (K ^ 17) ^ 8 := by gcongr
      _ = _ := by rw [← pow_mul]
  obtain ⟨H', hsub, hne, hcard, hgraph⟩ := cyclic_graph_refinement H hH ξ
  refine ⟨H', hsub, hne, ?_, hgraph⟩
  have hc : (H.card : ℝ) / (65536 * K ^ 136) ≤ H'.card := by
    exact (div_le_div_of_nonneg_left (Nat.cast_nonneg H.card) (by positivity) hcost).trans hcard
  have hq : (0 : ℝ) ≤ q := Nat.cast_nonneg q
  have hd := div_le_div_of_nonneg_right hc hq
  simpa only [div_right_comm (H.card : ℝ) (65536 * K ^ 136) (q : ℝ)] using hd

/-- Composition of polynomial density with a polynomial loss, with exact exponents. -/
theorem polynomial_density_after_loss {δ α β C D K : ℝ}
    (hδ : 0 < δ) (hC : 0 < C) (hD : 0 < D) (hK : 0 < K)
    (a b n : ℕ) (hα : δ ^ a / C ≤ α)
    (hβ : α / (D * (K / δ ^ b) ^ n) ≤ β) :
    δ ^ (a + b * n) / (C * D * K ^ n) ≤ β := by
  calc
    _ = (δ ^ a / C) / (D * (K / δ ^ b) ^ n) := by
      rw [pow_add, pow_mul, div_pow]
      field_simp
    _ ≤ α / (D * (K / δ ^ b) ^ n) :=
      div_le_div_of_nonneg_right hα (by positivity)
    _ ≤ β := hβ

/-- A polynomial density lower bound gives the corresponding logarithmic upper bound. -/
theorem log_inverse_le_of_power_density {α δ C : ℝ} (hα : 0 < α)
    (hδ : 0 < δ) (hC : 0 < C) (n : ℕ) (h : δ ^ n / C ≤ α) :
    Real.log (1 / α) ≤ Real.log C + (n : ℝ) * Real.log (1 / δ) := by
  have hb : 1 / α ≤ C / δ ^ n := by
    apply (div_le_div_iff₀ hα (pow_pos hδ n)).mpr
    have hh := (div_le_iff₀ hC).mp h
    nlinarith
  have hl := Real.log_le_log (by positivity : 0 < 1 / α) hb
  rw [Real.log_div hC.ne' (pow_pos hδ n).ne', Real.log_pow] at hl
  simpa only [one_div, Real.log_inv, mul_neg, sub_eq_add_neg] using hl

/-! ### Local symmetry of graph frequencies -/

theorem graphBohrSet_mono {q : ℕ} [NeZero q] {S T : Finset (ZMod q)}
    (hST : S ⊆ T) {r ρ : ℝ} (hr : r ≤ ρ) : graphBohrSet T r ⊆ graphBohrSet S ρ := by
  intro x hx
  rw [mem_graphBohrSet] at hx ⊢
  exact fun s hs => (hx s (hST hs)).trans_le hr

theorem graphBohrSet_add {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {r ρ : ℝ} {x y : ZMod q} (hx : x ∈ graphBohrSet S r) (hy : y ∈ graphBohrSet S ρ) :
    x + y ∈ graphBohrSet S (r + ρ) := by
  rw [mem_graphBohrSet] at hx hy ⊢
  intro s hs
  rw [mul_add, map_add]
  exact (norm_add_le _ _).trans_lt (add_lt_add (hx s hs) (hy s hs))

theorem graphBohrSet_neg {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {r : ℝ} {x : ZMod q} (hx : x ∈ graphBohrSet S r) : -x ∈ graphBohrSet S r := by
  rw [mem_graphBohrSet] at hx ⊢
  simpa only [mul_neg, map_neg, norm_neg] using hx

theorem graphBohrSet_sub {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {r ρ : ℝ} {x y : ZMod q} (hx : x ∈ graphBohrSet S r) (hy : y ∈ graphBohrSet S ρ) :
    x - y ∈ graphBohrSet S (r + ρ) := by
  simpa only [sub_eq_add_neg] using graphBohrSet_add S hx (graphBohrSet_neg S hy)

/-- Primitive centered-coordinate weight for the independently stated local graph model. -/
noncomputable def graphBohrWeight {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) : ℝ :=
  ∏ s ∈ S, b ((AddCircle.equivIco (1 : ℝ) (-(1 / 2))
    (ZMod.toAddCircle (s * x)) : ℝ) / r)

noncomputable def graphBohrMass {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) : ℝ := 𝔼 x, graphBohrWeight b S r x

noncomputable def graphBohrMeasure {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) : ℝ :=
  graphBohrWeight b S r x / graphBohrMass b S r

noncomputable def graphBohrNorm {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (x : ZMod q) : ℝ :=
  (S.sup (fun s => ‖ZMod.toAddCircle (s * x)‖₊) : ℝ≥0)

theorem graphBohrWeight_bounds {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) :
    0 ≤ graphBohrWeight b S r x ∧ graphBohrWeight b S r x ≤ 1 :=
  ⟨cyclicBohrWeight_nonneg b hb S r x, cyclicBohrWeight_le_one b hb hb1 S r x⟩

theorem graphBohrWeight_eq_zero_of_notMem {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hsupp : ∀ x, 1 ≤ |x| → b x = 0) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (x : ZMod q) (hx : x ∉ graphBohrSet S r) :
    graphBohrWeight b S r x = 0 := by
  apply cyclicBohrWeight_eq_zero_of_notMem b hsupp S hr x
  intro h
  exact hx ((mem_graphBohrSet S r x).mpr ((mem_cyclicBohrSet S r x).mp h))

theorem graphBohrMass_bounds {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → b x = 1) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) :
    (r / 6) ^ S.card ≤ graphBohrMass b S r ∧ graphBohrMass b S r ≤ 1 :=
  cyclicBohrMass_bounds b hb hb1 hbone S hr hrsmall

theorem graphBohrMeasure_mean_one {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (hβ : 0 < graphBohrMass b S r) :
    (𝔼 x, graphBohrMeasure b S r x) = 1 := cyclicBohrMeasure_mean_one b S r hβ

theorem graphBohrNorm_le_of_mem {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 ≤ r) {x : ZMod q} (hx : x ∈ graphBohrSet S r) :
    graphBohrNorm S x ≤ r := by
  change ((S.sup (fun s => ‖ZMod.toAddCircle (s * x)‖₊) : ℝ≥0) : ℝ) ≤ r
  change S.sup (fun s => ‖ZMod.toAddCircle (s * x)‖₊) ≤ (⟨r, hr⟩ : ℝ≥0)
  apply Finset.sup_le
  intro s hs
  exact_mod_cast ((mem_graphBohrSet S r x).mp hx s hs).le

/-- An explicit inner radius with room for every local-symmetry substitution. -/
noncomputable def localSymmetryInnerRadius (C : ℝ) (d : ℕ) (r ζ : ℝ) : ℝ :=
  r * min 1 (ζ ^ 2) / (1000 * (C + 1) * (d + 1))

theorem localSymmetryInnerRadius_bounds {C r ζ : ℝ} (hC : 0 ≤ C)
    (hr : 0 < r) (hζ : 0 < ζ) (d : ℕ) :
    0 < localSymmetryInnerRadius C d r ζ ∧
      localSymmetryInnerRadius C d r ζ ≤ r / 100 ∧
      2 * C * d * localSymmetryInnerRadius C d r ζ / r ≤ ζ ^ 2 / 2 := by
  have hmin : 0 < min (1 : ℝ) (ζ ^ 2) := lt_min zero_lt_one (sq_pos_of_pos hζ)
  have hden : 0 < 1000 * (C + 1) * ((d : ℝ) + 1) := by positivity
  have hd : (0 : ℝ) ≤ d := Nat.cast_nonneg d
  have hc : 1 ≤ (C + 1) * ((d : ℝ) + 1) := by nlinarith
  refine ⟨div_pos (mul_pos hr hmin) hden, ?_, ?_⟩
  · unfold localSymmetryInnerRadius
    apply (div_le_iff₀ hden).mpr
    have hm := min_le_left (1 : ℝ) (ζ ^ 2)
    nlinarith
  · unfold localSymmetryInnerRadius
    have he : 2 * C * d * (r * min 1 (ζ ^ 2) / (1000 * (C + 1) * (d + 1))) / r =
        (2 * C * d * min 1 (ζ ^ 2)) / (1000 * (C + 1) * (d + 1)) := by
      field_simp
    rw [he]
    apply (div_le_iff₀ hden).mpr
    have hm := min_le_right (1 : ℝ) (ζ ^ 2)
    have hmul := mul_le_mul_of_nonneg_left hm (by positivity : 0 ≤ 2 * C * (d : ℝ))
    nlinarith [sq_nonneg ζ, mul_nonneg hC hd]

theorem graphBohrMass_pos {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → b x = 1) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) : 0 < graphBohrMass b S r :=
  cyclicBohrMass_pos b hb hb1 hbone S hr hrsmall

theorem graphBohrMeasure_nonneg {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (S : Finset (ZMod q)) (r : ℝ)
    (hβ : 0 < graphBohrMass b S r) (x : ZMod q) : 0 ≤ graphBohrMeasure b S r x :=
  cyclicBohrMeasure_nonneg b hb S r hβ x

theorem graphBohrMeasure_eq_zero_of_notMem {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hsupp : ∀ x, 1 ≤ |x| → b x = 0) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (x : ZMod q) (hx : x ∉ graphBohrSet S r) :
    graphBohrMeasure b S r x = 0 := by
  rw [graphBohrMeasure, graphBohrWeight_eq_zero_of_notMem b hsupp S hr x hx, zero_div]

theorem localSymmetryInnerRadius_le_tolerance {C r ζ : ℝ} (hC : 0 < C)
    (hr : 0 < r) (d : ℕ) (hd : 0 < d) :
    localSymmetryInnerRadius C d r ζ ≤ ζ ^ 2 * r / (100 * C * d) := by
  have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
  have hsmall : 0 < 100 * C * (d : ℝ) := by positivity
  have hden : 100 * C * (d : ℝ) ≤ 1000 * (C + 1) * (d + 1) := by
    nlinarith [mul_pos hC hdpos]
  unfold localSymmetryInnerRadius
  calc
    _ ≤ r * ζ ^ 2 / (1000 * (C + 1) * (d + 1)) := by
      apply div_le_div_of_nonneg_right _ (by positivity)
      exact mul_le_mul_of_nonneg_left (min_le_right _ _) hr.le
    _ ≤ r * ζ ^ 2 / (100 * C * d) :=
      div_le_div_of_nonneg_left (by positivity) hsmall hden
    _ = _ := by ring

theorem localSymmetryInnerRadius_domain {C r ζ ρ : ℝ} (hC : 0 ≤ C)
    (hr : 0 < r) (hζ : 0 < ζ) (d : ℕ) (hrρ : r ≤ ρ / 100) :
    r + 2 * localSymmetryInnerRadius C d r ζ < ρ ∧
      8 * localSymmetryInnerRadius C d r ζ < ρ ∧
      3 * localSymmetryInnerRadius C d r ζ < r := by
  have h := (localSymmetryInnerRadius_bounds hC hr hζ d).2.1
  constructor
  · linarith
  · constructor <;> linarith

/-- Averaging all translates of a normalized weight preserves uniform averages. -/
theorem finite_weighted_shift_average {G : Type*} [Fintype G] [AddCommGroup G]
    (μ : G → ℝ) (hμ : (𝔼 u, μ u) = 1) (F : G → ℂ) :
    (𝔼 y, 𝔼 u, (μ u : ℂ) * F (y + u)) = 𝔼 x, F x := by
  have hshift (u : G) : (𝔼 y, F (y + u)) = 𝔼 x, F x :=
    Fintype.expect_equiv (Equiv.addRight u) _ _ (fun _ => rfl)
  rw [Finset.expect_comm]
  simp only [← Finset.mul_expect, hshift, ← Finset.expect_mul,
    ← finite_expect_ofReal, hμ, Complex.ofReal_one, one_mul]

/-- Some weighted translate retains the magnitude of a two-variable uniform correlation. -/
theorem finite_weighted_translation_localization {G : Type*} [Fintype G] [AddCommGroup G]
    (μ : G → ℝ) (hμ : (𝔼 u, μ u) = 1) (F : G → G → ℂ) {ζ : ℝ}
    (hζ : ζ ≤ ‖𝔼 h, 𝔼 x, F h x‖) :
    ∃ y : G, ζ ≤ ‖𝔼 h, 𝔼 u, (μ u : ℂ) * F h (y + u)‖ := by
  have havg : (𝔼 y, 𝔼 h, 𝔼 u, (μ u : ℂ) * F h (y + u)) = 𝔼 h, 𝔼 x, F h x := by
    rw [Finset.expect_comm]
    apply Finset.expect_congr rfl
    intro h _
    exact finite_weighted_shift_average μ hμ (F h)
  have h : ζ ≤ 𝔼 y, ‖𝔼 h, 𝔼 u, (μ u : ℂ) * F h (y + u)‖ := by
    apply hζ.trans
    rw [← havg]
    exact RCLike.norm_expect_le (K := ℂ)
  obtain ⟨y, _, hy⟩ := Finset.exists_le_of_le_expect Finset.univ_nonempty h
  exact ⟨y, hy⟩

/-- Initial correlation in the local-symmetry argument. -/
noncomputable def graphLocalCorrelation {q : ℕ} [NeZero q]
    (w : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b c : ZMod q → ℂ) : ℂ :=
  𝔼 h, 𝔼 x, (w h : ℂ) * c h *
    (a (x + h) * b x * ZMod.stdAddChar (-(2 * M h * x)))

/-- Correlation after localizing the spatial variable by a normalized weight. -/
noncomputable def graphLocalizedCorrelation {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b c : ZMod q → ℂ) : ℂ :=
  𝔼 h, (w h : ℂ) * c h *
    (𝔼 u, (μ u : ℂ) * a (u + h) * b u * ZMod.stdAddChar (-(2 * M h * u)))

/-- The selected translate is absorbed into bounded functions
without changing the graph frequency. -/
theorem graph_correlation_localization {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hμ : (𝔼 u, μ u) = 1) (M : ZMod q → ZMod q)
    (a b c : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1)
    (hc : ∀ x, ‖c x‖ ≤ 1) {ζ : ℝ} (hζ : ζ ≤ ‖graphLocalCorrelation w M a b c‖) :
    ∃ a' b' c' : ZMod q → ℂ, (∀ x, ‖a' x‖ ≤ 1) ∧ (∀ x, ‖b' x‖ ≤ 1) ∧
      (∀ x, ‖c' x‖ ≤ 1) ∧ ζ ≤ ‖graphLocalizedCorrelation w μ M a' b' c'‖ := by
  let F : ZMod q → ZMod q → ℂ := fun h x => (w h : ℂ) * c h *
    (a (x + h) * b x * ZMod.stdAddChar (-(2 * M h * x)))
  obtain ⟨y, hy⟩ := finite_weighted_translation_localization μ hμ F hζ
  let a' : ZMod q → ℂ := fun x => a (x + y)
  let b' : ZMod q → ℂ := fun x => b (x + y)
  let c' : ZMod q → ℂ := fun h => c h * ZMod.stdAddChar (-(2 * M h * y))
  have he : graphLocalizedCorrelation w μ M a' b' c' =
      𝔼 h, 𝔼 u, (μ u : ℂ) * F h (y + u) := by
    unfold graphLocalizedCorrelation
    apply Finset.expect_congr rfl
    intro h _
    rw [Finset.mul_expect]
    apply Finset.expect_congr rfl
    intro u _
    dsimp [a', b', c', F]
    have hchar : ZMod.stdAddChar (-(2 * M h * (y + u))) =
        ZMod.stdAddChar (-(2 * M h * y)) * ZMod.stdAddChar (-(2 * M h * u)) := by
      rw [show -(2 * M h * (y + u)) = -(2 * M h * y) + -(2 * M h * u) by ring,
        AddChar.map_add_eq_mul]
    rw [hchar]
    simp only [add_left_comm, add_comm]
    ring
  refine ⟨a', b', c', (fun x => ha (x + y)), (fun x => hb (x + y)), ?_, ?_⟩
  · intro h
    simpa only [c', norm_mul, ZMod.stdAddChar_apply, Circle.norm_coe, mul_one] using hc h
  · rwa [he]

/-- Weighted Cauchy-Schwarz for a nonnegative weight of uniform mass at most one. -/
theorem finite_weighted_complex_cauchy_schwarz {I : Type*} [Fintype I]
    (w : I → ℝ) (hw : ∀ i, 0 ≤ w i) (hmass : (𝔼 i, w i) ≤ 1)
    (c F : I → ℂ) (hc : ∀ i, ‖c i‖ ≤ 1) :
    ‖𝔼 i, (w i : ℂ) * c i * F i‖ ^ 2 ≤ 𝔼 i, w i * ‖F i‖ ^ 2 := by
  have hnorm : ‖𝔼 i, (w i : ℂ) * c i * F i‖ ≤ 𝔼 i, w i * ‖F i‖ := by
    apply (RCLike.norm_expect_le (K := ℂ)).trans
    apply Finset.expect_le_expect
    intro i _
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_of_nonneg (hw i)]
    have h := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left (hc i) (hw i)) (norm_nonneg (F i))
    simpa only [mul_one] using h
  have hcs := Finset.expect_mul_sq_le_sq_mul_sq (Finset.univ : Finset I)
    (fun i => Real.sqrt (w i)) (fun i => Real.sqrt (w i) * ‖F i‖)
  have h1 (i : I) : Real.sqrt (w i) * (Real.sqrt (w i) * ‖F i‖) = w i * ‖F i‖ := by
    rw [← mul_assoc, ← pow_two, Real.sq_sqrt (hw i)]
  have h2 (i : I) : Real.sqrt (w i) ^ 2 = w i := Real.sq_sqrt (hw i)
  have h3 (i : I) : (Real.sqrt (w i) * ‖F i‖) ^ 2 = w i * ‖F i‖ ^ 2 := by
    rw [mul_pow, h2]
  simp only [h1, h2, h3] at hcs
  have hnonneg : 0 ≤ 𝔼 i, w i * ‖F i‖ ^ 2 :=
    Finset.expect_nonneg (fun i _ => mul_nonneg (hw i) (sq_nonneg _))
  calc
    _ ≤ (𝔼 i, w i * ‖F i‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hnorm 2
    _ ≤ (𝔼 i, w i) * (𝔼 i, w i * ‖F i‖ ^ 2) := hcs
    _ ≤ 1 * (𝔼 i, w i * ‖F i‖ ^ 2) := mul_le_mul_of_nonneg_right hmass hnonneg
    _ = _ := one_mul _

/-- The real nonnegative square left by the first local-symmetry Cauchy-Schwarz step. -/
noncomputable def graphLocalizedSquare {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) : ℝ :=
  𝔼 h, w h * ‖𝔼 u, (μ u : ℂ) * a (u + h) * b u *
    ZMod.stdAddChar (-(2 * M h * u))‖ ^ 2

theorem graphLocalizedSquare_nonneg {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hw : ∀ h, 0 ≤ w h) (M : ZMod q → ZMod q)
    (a b : ZMod q → ℂ) : 0 ≤ graphLocalizedSquare w μ M a b :=
  Finset.expect_nonneg (fun h _ => mul_nonneg (hw h) (sq_nonneg _))

/-- The first weighted Cauchy-Schwarz inequality in the source local-symmetry proof. -/
theorem graph_localized_cauchy_schwarz {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hw : ∀ h, 0 ≤ w h) (hmass : (𝔼 h, w h) ≤ 1)
    (M : ZMod q → ZMod q) (a b c : ZMod q → ℂ) (hc : ∀ h, ‖c h‖ ≤ 1)
    {ζ : ℝ} (hζ : 0 ≤ ζ) (hcorr : ζ ≤ ‖graphLocalizedCorrelation w μ M a b c‖) :
    ζ ^ 2 ≤ graphLocalizedSquare w μ M a b := by
  have h := finite_weighted_complex_cauchy_schwarz w hw hmass c
    (fun h => 𝔼 u, (μ u : ℂ) * a (u + h) * b u * ZMod.stdAddChar (-(2 * M h * u))) hc
  exact (pow_le_pow_left₀ hζ hcorr 2).trans h

/-- Exact complex expansion of the first square, with the differenced frequency phase. -/
theorem graphLocalizedSquare_expansion {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) :
    (graphLocalizedSquare w μ M a b : ℂ) =
      𝔼 h, 𝔼 u, 𝔼 v, (w h * μ u * μ v : ℂ) * b u * conj (b v) *
        a (u + h) * conj (a (v + h)) * ZMod.stdAddChar (-(2 * M h * (u - v))) := by
  unfold graphLocalizedSquare
  rw [finite_expect_ofReal]
  apply Finset.expect_congr rfl
  intro h _
  rw [Complex.ofReal_mul, finite_expect_norm_sq_eq, Finset.mul_expect]
  apply Finset.expect_congr rfl
  intro u _
  rw [Finset.mul_expect]
  apply Finset.expect_congr rfl
  intro v _
  simp only [map_mul, Complex.conj_ofReal]
  have hchar : ZMod.stdAddChar (-(2 * M h * u)) *
      conj (ZMod.stdAddChar (-(2 * M h * v))) =
      ZMod.stdAddChar (-(2 * M h * (u - v))) := by
    rw [graph_stdChar_conj, ← AddChar.map_add_eq_mul]
    congr 1
    ring
  rw [← hchar]
  ring

/-- The alternating graph-frequency expression, before applying the circle embedding. -/
def graphAlternating {q : ℕ} (M : ZMod q → ZMod q) (u v : ZMod q) : ZMod q :=
  M u * v - M v * u

noncomputable def graphAlternatingPhase {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (u v : ZMod q) : UnitAddCircle :=
  ZMod.toAddCircle (graphAlternating M u v)

/-- Local additivity suffices to reconstruct the outer frequency after the three-term shift. -/
theorem graph_local_additive_three {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    (M : ZMod q → ZMod q) {r s ρ : ℝ} (hr : 0 ≤ r) (hs : 0 ≤ s) (hρ : r + 2 * s ≤ ρ)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    {h u v : ZMod q} (hh : h ∈ graphBohrSet S r)
    (hu : u ∈ graphBohrSet S s) (hv : v ∈ graphBohrSet S s) :
    M h = M (h + (u + v)) - M u - M v := by
  have hhρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : r ≤ ρ) hh
  have huρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : s ≤ ρ) hu
  have hvρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : s ≤ ρ) hv
  have huv : u + v ∈ graphBohrSet S (s + s) := graphBohrSet_add S hu hv
  have huvρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S)
    (by linarith : s + s ≤ ρ) huv
  have hz : h + (u + v) ∈ graphBohrSet S (r + (s + s)) := graphBohrSet_add S hh huv
  have hzρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S)
    (by linarith : r + (s + s) ≤ ρ) hz
  rw [hadd h hhρ (u + v) huvρ hzρ, hadd u huρ v hvρ huvρ]
  abel

/-- The bounded amplitude obtained after writing `z=h+u+v`. -/
noncomputable def graphLocalAmplitude {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) (z u : ZMod q) : ℂ :=
  b u * conj (a (z - u)) * ZMod.stdAddChar (2 * M u * u - 2 * M z * u)

/-- Exact algebraic alternating-phase identity on the locally additive domain. -/
theorem graph_local_phase_identity {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) (h u v : ZMod q)
    (hM : M h = M (h + (u + v)) - M u - M v) :
    b u * conj (b v) * a (u + h) * conj (a (v + h)) *
        ZMod.stdAddChar (-(2 * M h * (u - v))) =
      graphLocalAmplitude M a b (h + (u + v)) u *
        conj (graphLocalAmplitude M a b (h + (u + v)) v) *
          ZMod.stdAddChar (-(2 * graphAlternating M u v)) := by
  have hchar : ZMod.stdAddChar (2 * M u * u - 2 * M (h + (u + v)) * u) *
      conj (ZMod.stdAddChar (2 * M v * v - 2 * M (h + (u + v)) * v)) *
      ZMod.stdAddChar (-(2 * graphAlternating M u v)) =
      ZMod.stdAddChar (-(2 * M h * (u - v))) := by
    rw [graph_stdChar_conj, ← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul]
    congr 1
    rw [hM]
    unfold graphAlternating
    ring
  rw [← hchar]
  unfold graphLocalAmplitude
  simp only [map_mul, Complex.conj_conj]
  have huarg : h + (u + v) - u = v + h := by abel
  have hvarg : h + (u + v) - v = u + h := by abel
  rw [huarg, hvarg]
  ring

/-- The reindexed weighted alternating-phase average in the source symmetry argument. -/
noncomputable def graphSymmetryExpression {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) : ℂ :=
  𝔼 z, 𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * (w (z - u - v) : ℂ) *
    graphLocalAmplitude M a b z u * conj (graphLocalAmplitude M a b z v) *
      ZMod.stdAddChar (-(2 * graphAlternating M u v))

/-- Reindexing is valid because every nonzero weighted term lies inside the additive domain. -/
theorem graphLocalizedSquare_symmetry_change {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q)
    (a b : ZMod q → ℂ) {r s ρ : ℝ} (hr : 0 ≤ r) (hs : 0 ≤ s) (hρ : r + 2 * s ≤ ρ)
    (hw : ∀ h, w h ≠ 0 → h ∈ graphBohrSet S r)
    (hμ : ∀ u, μ u ≠ 0 → u ∈ graphBohrSet S s)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y) :
    (graphLocalizedSquare w μ M a b : ℂ) = graphSymmetryExpression w μ M a b := by
  rw [graphLocalizedSquare_expansion, finite_expect_reverse_three]
  unfold graphSymmetryExpression
  rw [finite_expect_reverse_three (fun z u v =>
    (μ u : ℂ) * (μ v : ℂ) * (w (z - u - v) : ℂ) * graphLocalAmplitude M a b z u *
      conj (graphLocalAmplitude M a b z v) * ZMod.stdAddChar (-(2 * graphAlternating M u v)))]
  apply Finset.expect_congr rfl
  intro v _
  apply Finset.expect_congr rfl
  intro u _
  apply Fintype.expect_equiv (Equiv.addRight (u + v))
  intro h
  change (w h * μ u * μ v : ℂ) * b u * conj (b v) * a (u + h) *
      conj (a (v + h)) * ZMod.stdAddChar (-(2 * M h * (u - v))) =
    (μ u : ℂ) * (μ v : ℂ) * (w (h + (u + v) - u - v) : ℂ) *
      graphLocalAmplitude M a b (h + (u + v)) u *
      conj (graphLocalAmplitude M a b (h + (u + v)) v) *
        ZMod.stdAddChar (-(2 * graphAlternating M u v))
  rw [show h + (u + v) - u - v = h by abel]
  by_cases hu : μ u = 0
  · simp [hu]
  by_cases hv : μ v = 0
  · simp [hv]
  by_cases hh : w h = 0
  · simp [hh]
  have hM := graph_local_additive_three S M hr hs hρ hadd (hw h hh) (hμ u hu) (hμ v hv)
  have hp := graph_local_phase_identity M a b h u v hM
  linear_combination (w h * μ u * μ v : ℂ) * hp

theorem graphLocalAmplitude_norm_le {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1) (z u : ZMod q) :
    ‖graphLocalAmplitude M a b z u‖ ≤ 1 := by
  rw [graphLocalAmplitude, norm_mul, norm_mul, Complex.norm_conj,
    ZMod.stdAddChar_apply, Circle.norm_coe, mul_one]
  exact (mul_le_mul (hb u) (ha (z - u)) (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)

/-- The unit-bounded kernel of the alternating-phase correlation. -/
noncomputable def graphSymmetryKernel {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) (z u v : ZMod q) : ℂ :=
  graphLocalAmplitude M a b z u * conj (graphLocalAmplitude M a b z v) *
    ZMod.stdAddChar (-(2 * graphAlternating M u v))

theorem graphSymmetryKernel_norm_le {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1) (z u v : ZMod q) :
    ‖graphSymmetryKernel M a b z u v‖ ≤ 1 := by
  rw [graphSymmetryKernel, norm_mul, norm_mul, Complex.norm_conj,
    ZMod.stdAddChar_apply, Circle.norm_coe, mul_one]
  exact (mul_le_mul (graphLocalAmplitude_norm_le M a b ha hb z u)
    (graphLocalAmplitude_norm_le M a b ha hb z v) (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)

/-- A two-variable normalized weighted average obeys a bound valid on the weight's support. -/
theorem finite_weighted_pair_norm_le {I : Type*} [Fintype I]
    (μ : I → ℝ) (hμ : ∀ i, 0 ≤ μ i) (hmass : (𝔼 i, μ i) = 1)
    (F : I → I → ℂ) {A : ℝ}
    (hF : ∀ u v, μ u ≠ 0 → μ v ≠ 0 → ‖F u v‖ ≤ A) :
    ‖𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * F u v‖ ≤ A := by
  have hp (u v : I) : ‖(μ u : ℂ) * (μ v : ℂ) * F u v‖ ≤ μ u * μ v * A := by
    by_cases hu : μ u = 0
    · simp [hu]
    by_cases hv : μ v = 0
    · simp [hv]
    rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
      Real.norm_of_nonneg (hμ u), Real.norm_of_nonneg (hμ v)]
    exact mul_le_mul_of_nonneg_left (hF u v hu hv) (mul_nonneg (hμ u) (hμ v))
  calc
    _ ≤ 𝔼 u, ‖𝔼 v, (μ u : ℂ) * (μ v : ℂ) * F u v‖ := RCLike.norm_expect_le (K := ℂ)
    _ ≤ 𝔼 u, 𝔼 v, μ u * μ v * A := by
      apply Finset.expect_le_expect
      intro u _
      exact (RCLike.norm_expect_le (K := ℂ)).trans
        (Finset.expect_le_expect (fun v _ => hp u v))
    _ = A := by
      simp only [mul_assoc, ← Finset.mul_expect, ← Finset.expect_mul, hmass, one_mul]

/-- A positive weighted correlation is witnessed at a point carrying nonzero weight. -/
theorem finite_weighted_correlation_select {I : Type*} [Fintype I]
    (w : I → ℝ) (hw : ∀ i, 0 ≤ w i) (hmass : (𝔼 i, w i) ≤ 1)
    (F : I → ℂ) {η : ℝ} (hη : 0 < η) (hcorr : η ≤ ‖𝔼 i, (w i : ℂ) * F i‖) :
    ∃ i, w i ≠ 0 ∧ η ≤ ‖F i‖ := by
  classical
  let T := Finset.univ.filter (fun i => w i ≠ 0)
  have hT : T.Nonempty := by
    by_contra hn
    have he : T = ∅ := Finset.not_nonempty_iff_eq_empty.mp hn
    have hz (i : I) : w i = 0 := by
      by_contra hi
      have hm : i ∈ T := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi⟩
      rw [he] at hm
      exact Finset.notMem_empty i hm
    have hzero : (𝔼 i, (w i : ℂ) * F i) = 0 := by simp [hz]
    rw [hzero, norm_zero] at hcorr
    linarith
  obtain ⟨i, hi, hmax⟩ := Finset.exists_max_image T (fun i => ‖F i‖) hT
  refine ⟨i, (Finset.mem_filter.mp hi).2, hcorr.trans ?_⟩
  calc
    _ ≤ 𝔼 j, w j * ‖F j‖ := by
      apply (RCLike.norm_expect_le (K := ℂ)).trans_eq
      apply Finset.expect_congr rfl
      intro j _
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hw j)]
    _ ≤ 𝔼 j, w j * ‖F i‖ := by
      apply Finset.expect_le_expect
      intro j _
      by_cases hj : w j = 0
      · simp [hj]
      · exact mul_le_mul_of_nonneg_left
          (hmax j (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩)) (hw j)
    _ = (𝔼 j, w j) * ‖F i‖ := (Finset.expect_mul _ _ _).symm
    _ ≤ 1 * ‖F i‖ := mul_le_mul_of_nonneg_right hmass (norm_nonneg _)
    _ = _ := one_mul _

/-- Pairwise shifts of inner Bohr points incur the source weight-replacement error. -/
theorem graphBohrWeight_pair_translation {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L b) (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (hsupp : ∀ x, 1 ≤ |x| → b x = 0) (S : Finset (ZMod q))
    {r s : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) (hs : 0 ≤ s)
    (z u v : ZMod q) (hu : u ∈ graphBohrSet S s) (hv : v ∈ graphBohrSet S s) :
    |graphBohrWeight b S r (z - u - v) - graphBohrWeight b S r z| ≤
      2 * max (L : ℝ) 1 * S.card * s / r := by
  have hn := graphBohrNorm_le_of_mem S (add_nonneg hs hs) (graphBohrSet_add S hu hv)
  have h := cyclicBohrWeight_translation b hLip hb hb1 hsupp S hr hrsmall (z - u - v) (u + v)
  change |graphBohrWeight b S r ((z - u - v) + (u + v)) - graphBohrWeight b S r (z - u - v)| ≤
    max (L : ℝ) 1 * S.card * graphBohrNorm S (u + v) / r at h
  rw [show (z - u - v) + (u + v) = z by abel, abs_sub_comm] at h
  apply h.trans
  calc
    _ ≤ max (L : ℝ) 1 * S.card * (s + s) / r := by
      apply div_le_div_of_nonneg_right _ hr.le
      exact mul_le_mul_of_nonneg_left hn (by positivity)
    _ = _ := by ring

/-- The inner alternating-phase correlation at a fixed outer parameter. -/
noncomputable def graphSymmetryFixedCorrelation {q : ℕ} [NeZero q]
    (μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) (z : ZMod q) : ℂ :=
  𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * graphSymmetryKernel M a b z u v

noncomputable def graphSymmetryWeightedCorrelation {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (a b : ZMod q → ℂ) : ℂ :=
  𝔼 z, (w z : ℂ) * graphSymmetryFixedCorrelation μ M a b z

/-- Replacing the shifted outer weight costs at most its uniform variation on the inner support. -/
theorem graph_symmetry_weight_error {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hμ : ∀ u, 0 ≤ μ u) (hμmass : (𝔼 u, μ u) = 1)
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1) {ε : ℝ}
    (htrans : ∀ z u v, μ u ≠ 0 → μ v ≠ 0 → |w (z - u - v) - w z| ≤ ε) :
    ‖graphSymmetryExpression w μ M a b - graphSymmetryWeightedCorrelation w μ M a b‖ ≤ ε := by
  let F : ZMod q → ZMod q → ZMod q → ℂ := fun z u v =>
    ((w (z - u - v) - w z : ℝ) : ℂ) * graphSymmetryKernel M a b z u v
  have he : graphSymmetryExpression w μ M a b - graphSymmetryWeightedCorrelation w μ M a b =
      𝔼 z, 𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * F z u v := by
    unfold graphSymmetryExpression graphSymmetryWeightedCorrelation graphSymmetryFixedCorrelation
    simp only [Finset.mul_expect, ← Finset.expect_sub_distrib]
    apply Finset.expect_congr rfl
    intro z _
    apply Finset.expect_congr rfl
    intro u _
    apply Finset.expect_congr rfl
    intro v _
    dsimp [F, graphSymmetryKernel]
    push_cast
    ring
  rw [he]
  apply (RCLike.norm_expect_le (K := ℂ)).trans
  apply Finset.expect_le Finset.univ_nonempty
  intro z _
  apply finite_weighted_pair_norm_le μ hμ hμmass (F z)
  intro u v hu hv
  dsimp [F]
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  have h := mul_le_mul_of_nonneg_left (graphSymmetryKernel_norm_le M a b ha hb z u v)
    (abs_nonneg (w (z - u - v) - w z))
  have hle : |w (z - u - v) - w z| * ‖graphSymmetryKernel M a b z u v‖ ≤
      |w (z - u - v) - w z| := by simpa only [mul_one] using h
  exact hle.trans (htrans z u v hu hv)

/-- The weight replacement leaves a large fixed-parameter correlation on the outer support. -/
theorem graph_symmetry_weight_replacement_select {q : ℕ} [NeZero q]
    (w μ : ZMod q → ℝ) (hw : ∀ z, 0 ≤ w z) (hwmass : (𝔼 z, w z) ≤ 1)
    (hμ : ∀ u, 0 ≤ μ u) (hμmass : (𝔼 u, μ u) = 1)
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1) {ζ ε : ℝ}
    (hζ : 0 < ζ) (hε : ε ≤ ζ ^ 2 / 2)
    (hsq : ζ ^ 2 ≤ graphLocalizedSquare w μ M a b)
    (hchange : (graphLocalizedSquare w μ M a b : ℂ) = graphSymmetryExpression w μ M a b)
    (htrans : ∀ z u v, μ u ≠ 0 → μ v ≠ 0 → |w (z - u - v) - w z| ≤ ε) :
    ∃ z, w z ≠ 0 ∧ ζ ^ 2 / 2 ≤ ‖graphSymmetryFixedCorrelation μ M a b z‖ := by
  have herror := graph_symmetry_weight_error w μ hμ hμmass M a b ha hb htrans
  have horiginal : ζ ^ 2 ≤ ‖graphSymmetryExpression w μ M a b‖ := by
    rw [← hchange, Complex.norm_real,
      Real.norm_of_nonneg (graphLocalizedSquare_nonneg w μ hw M a b)]
    exact hsq
  have hcorr : ζ ^ 2 / 2 ≤ ‖graphSymmetryWeightedCorrelation w μ M a b‖ := by
    have h := norm_sub_norm_le (graphSymmetryExpression w μ M a b)
      (graphSymmetryWeightedCorrelation w μ M a b)
    linarith
  exact finite_weighted_correlation_select w hw hwmass
    (graphSymmetryFixedCorrelation μ M a b) (by positivity) hcorr

/-- Source weight replacement and supported selection,
specialized to the actual smooth Bohr weights. -/
theorem graph_bohr_symmetry_select {q : ℕ} [NeZero q] (cutoff : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L cutoff)
    (hb0 : ∀ x, 0 ≤ cutoff x) (hb1 : ∀ x, cutoff x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → cutoff x = 1)
    (hsupp : ∀ x, 1 ≤ |x| → cutoff x = 0) (S : Finset (ZMod q))
    {r s ρ ζ : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) (hs : 0 < s) (hssmall : s < 1 / 8)
    (hρ : r + 2 * s ≤ ρ) (hζ : 0 < ζ)
    (htol : 2 * max (L : ℝ) 1 * S.card * s / r ≤ ζ ^ 2 / 2)
    (M : ZMod q → ZMod q) (a b : ZMod q → ℂ)
    (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (hsq : ζ ^ 2 ≤ graphLocalizedSquare (graphBohrWeight cutoff S r)
      (graphBohrMeasure cutoff S s) M a b) :
    ∃ z, graphBohrWeight cutoff S r z ≠ 0 ∧ z ∈ graphBohrSet S r ∧
      ζ ^ 2 / 2 ≤ ‖graphSymmetryFixedCorrelation (graphBohrMeasure cutoff S s) M a b z‖ := by
  let w := graphBohrWeight cutoff S r
  let μ := graphBohrMeasure cutoff S s
  have hw : ∀ x, 0 ≤ w x := fun x => (graphBohrWeight_bounds cutoff hb0 hb1 S r x).1
  have hwmass : (𝔼 x, w x) ≤ 1 := (graphBohrMass_bounds cutoff hb0 hb1 hbone S hr hrsmall).2
  have hβ := graphBohrMass_pos cutoff hb0 hb1 hbone S hs hssmall
  have hμ : ∀ x, 0 ≤ μ x := graphBohrMeasure_nonneg cutoff hb0 S s hβ
  have hμmass : (𝔼 x, μ x) = 1 := graphBohrMeasure_mean_one cutoff S s hβ
  have hwsupp (x : ZMod q) (hx : w x ≠ 0) : x ∈ graphBohrSet S r := by
    by_contra hn
    exact hx (graphBohrWeight_eq_zero_of_notMem cutoff hsupp S hr x hn)
  have hμsupp (x : ZMod q) (hx : μ x ≠ 0) : x ∈ graphBohrSet S s := by
    by_contra hn
    exact hx (graphBohrMeasure_eq_zero_of_notMem cutoff hsupp S hs x hn)
  have hchange := graphLocalizedSquare_symmetry_change S w μ M a b hr.le hs.le hρ
    hwsupp hμsupp hadd
  have htrans (z u v : ZMod q) (hu : μ u ≠ 0) (hv : μ v ≠ 0) :
      |w (z - u - v) - w z| ≤ 2 * max (L : ℝ) 1 * S.card * s / r :=
    graphBohrWeight_pair_translation cutoff hLip hb0 hb1 hsupp S hr hrsmall hs.le
      z u v (hμsupp u hu) (hμsupp v hv)
  obtain ⟨z, hz, hcorr⟩ := graph_symmetry_weight_replacement_select w μ hw hwmass hμ hμmass
    M a b ha hb hζ htol hsq hchange htrans
  exact ⟨z, hz, hwsupp z hz, hcorr⟩

theorem finite_expect_cycle_three {I J K : Type*} [Fintype I] [Fintype J] [Fintype K]
    (f : I → J → K → ℂ) :
    (𝔼 i, 𝔼 j, 𝔼 k, f i j k) = 𝔼 j, 𝔼 k, 𝔼 i, f i j k := by
  rw [Finset.expect_comm]
  apply Finset.expect_congr rfl
  intro j _
  exact Finset.expect_comm _ _ _

/-- Exact weighted kernel square identity after the second Cauchy-Schwarz step. -/
theorem finite_weighted_kernel_square {I : Type*} [Fintype I]
    (μ : I → ℝ) (A : I → ℂ) (K : I → I → ℂ) :
    ((𝔼 u, μ u * ‖𝔼 v, (μ v : ℂ) * conj (A v) * K u v‖ ^ 2 : ℝ) : ℂ) =
      𝔼 v, 𝔼 v', (μ v : ℂ) * (μ v' : ℂ) * conj (A v) * A v' *
        (𝔼 u, (μ u : ℂ) * K u v * conj (K u v')) := by
  calc
    _ = 𝔼 u, 𝔼 v, 𝔼 v', (μ u : ℂ) * (μ v : ℂ) * (μ v' : ℂ) *
        conj (A v) * A v' * K u v * conj (K u v') := by
      rw [finite_expect_ofReal]
      apply Finset.expect_congr rfl
      intro u _
      rw [Complex.ofReal_mul, finite_expect_norm_sq_eq, Finset.mul_expect]
      apply Finset.expect_congr rfl
      intro v _
      rw [Finset.mul_expect]
      apply Finset.expect_congr rfl
      intro v' _
      simp only [map_mul, Complex.conj_ofReal, Complex.conj_conj]
      ring
    _ = 𝔼 v, 𝔼 v', 𝔼 u, (μ u : ℂ) * (μ v : ℂ) * (μ v' : ℂ) *
        conj (A v) * A v' * K u v * conj (K u v') := finite_expect_cycle_three _
    _ = _ := by
      apply Finset.expect_congr rfl
      intro v _
      apply Finset.expect_congr rfl
      intro v' _
      rw [Finset.mul_expect]
      apply Finset.expect_congr rfl
      intro u _
      ring

/-- A second weighted Cauchy-Schwarz removes both bounded amplitudes from a kernel correlation. -/
theorem finite_weighted_kernel_cauchy_schwarz {I : Type*} [Fintype I]
    (μ : I → ℝ) (hμ : ∀ i, 0 ≤ μ i) (hmass : (𝔼 i, μ i) = 1)
    (A : I → ℂ) (hA : ∀ i, ‖A i‖ ≤ 1) (K : I → I → ℂ) {κ : ℝ} (hκ : 0 ≤ κ)
    (hcorr : κ ≤ ‖𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * A u * conj (A v) * K u v‖) :
    κ ^ 2 ≤ 𝔼 v, 𝔼 v', μ v * μ v' * ‖𝔼 u, (μ u : ℂ) * K u v * conj (K u v')‖ := by
  let F : I → ℂ := fun u => 𝔼 v, (μ v : ℂ) * conj (A v) * K u v
  have he : (𝔼 u, 𝔼 v, (μ u : ℂ) * (μ v : ℂ) * A u * conj (A v) * K u v) =
      𝔼 u, (μ u : ℂ) * A u * F u := by
    apply Finset.expect_congr rfl
    intro u _
    dsimp [F]
    rw [Finset.mul_expect]
    apply Finset.expect_congr rfl
    intro v _
    ring
  rw [he] at hcorr
  have hcs := finite_weighted_complex_cauchy_schwarz μ hμ hmass.le A F hA
  have hlow : κ ^ 2 ≤ 𝔼 u, μ u * ‖F u‖ ^ 2 :=
    (pow_le_pow_left₀ hκ hcorr 2).trans hcs
  have hnonneg : 0 ≤ 𝔼 u, μ u * ‖F u‖ ^ 2 :=
    Finset.expect_nonneg (fun u _ => mul_nonneg (hμ u) (sq_nonneg _))
  have hn : κ ^ 2 ≤ ‖((𝔼 u, μ u * ‖F u‖ ^ 2 : ℝ) : ℂ)‖ := by
    simpa only [Complex.norm_real, Real.norm_of_nonneg hnonneg] using hlow
  rw [show ((𝔼 u, μ u * ‖F u‖ ^ 2 : ℝ) : ℂ) =
      𝔼 v, 𝔼 v', (μ v : ℂ) * (μ v' : ℂ) * conj (A v) * A v' *
        (𝔼 u, (μ u : ℂ) * K u v * conj (K u v')) from finite_weighted_kernel_square μ A K] at hn
  apply hn.trans
  apply (RCLike.norm_expect_le (K := ℂ)).trans
  apply Finset.expect_le_expect
  intro v _
  apply (RCLike.norm_expect_le (K := ℂ)).trans
  apply Finset.expect_le_expect
  intro v' _
  let B := 𝔼 u, (μ u : ℂ) * K u v * conj (K u v')
  have hAA : ‖A v‖ * ‖A v'‖ ≤ 1 :=
    (mul_le_mul (hA v) (hA v') (norm_nonneg _) zero_le_one).trans_eq (one_mul 1)
  calc
    _ = μ v * μ v' * (‖A v‖ * ‖A v'‖) * ‖B‖ := by
      simp only [norm_mul, Complex.norm_conj, Complex.norm_real,
        Real.norm_of_nonneg (hμ v), Real.norm_of_nonneg (hμ v')]
      ring
    _ ≤ μ v * μ v' * 1 * ‖B‖ := mul_le_mul_of_nonneg_right
      (mul_le_mul_of_nonneg_left hAA (mul_nonneg (hμ v) (hμ v'))) (norm_nonneg _)
    _ = _ := by ring

/-- Subtraction of two inner Bohr points is compatible with the locally additive map. -/
theorem graph_local_additive_sub {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    (M : ZMod q → ZMod q) {s ρ : ℝ} (hs : 0 ≤ s) (hρ : 2 * s ≤ ρ)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    {v v' : ZMod q} (hv : v ∈ graphBohrSet S s) (hv' : v' ∈ graphBohrSet S s) :
    M (v - v') = M v - M v' := by
  have hvρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : s ≤ ρ) hv
  have hv'ρ := graphBohrSet_mono (S := S) (Finset.Subset.refl S) (by linarith : s ≤ ρ) hv'
  have hdiff := graphBohrSet_mono (S := S) (Finset.Subset.refl S)
    (by linarith : s + s ≤ ρ) (graphBohrSet_sub S hv hv')
  have h := hadd (v - v') hdiff v' hv'ρ (by simpa only [sub_add_cancel] using hvρ)
  rw [sub_add_cancel] at h
  exact eq_sub_iff_add_eq.mpr h.symm

theorem graph_alternating_character_difference {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (u v v' : ZMod q) (hM : M (v - v') = M v - M v') :
    ZMod.stdAddChar (-(2 * graphAlternating M u v)) *
      conj (ZMod.stdAddChar (-(2 * graphAlternating M u v'))) =
        ZMod.stdAddChar (-(2 * graphAlternating M u (v - v'))) := by
  rw [graph_stdChar_conj, ← AddChar.map_add_eq_mul]
  congr 1
  unfold graphAlternating
  rw [hM]
  ring

/-- Local Fourier coefficient of the doubled alternating phase. -/
noncomputable def graphAlternatingFourier {q : ℕ} [NeZero q]
    (μ : ZMod q → ℝ) (M : ZMod q → ZMod q) (v : ZMod q) : ℂ :=
  𝔼 u, (μ u : ℂ) * ZMod.stdAddChar (-(2 * graphAlternating M u v))

/-- The source second Cauchy-Schwarz conclusion, with the exact fourth-power correlation bound. -/
theorem graph_symmetry_second_cauchy_schwarz {q : ℕ} [NeZero q]
    (S : Finset (ZMod q)) (μ : ZMod q → ℝ) (hμ : ∀ u, 0 ≤ μ u)
    (hμmass : (𝔼 u, μ u) = 1) (M : ZMod q → ZMod q) {s ρ : ℝ}
    (hs : 0 ≤ s) (hρ : 2 * s ≤ ρ) (hμsupp : ∀ u, μ u ≠ 0 → u ∈ graphBohrSet S s)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (a b : ZMod q → ℂ) (ha : ∀ x, ‖a x‖ ≤ 1) (hb : ∀ x, ‖b x‖ ≤ 1)
    (z : ZMod q) {ζ : ℝ}
    (hcorr : ζ ^ 2 / 2 ≤ ‖graphSymmetryFixedCorrelation μ M a b z‖) :
    ζ ^ 4 / 4 ≤ 𝔼 v, 𝔼 v', μ v * μ v' * ‖graphAlternatingFourier μ M (v - v')‖ := by
  let A : ZMod q → ℂ := graphLocalAmplitude M a b z
  let K : ZMod q → ZMod q → ℂ := fun u v => ZMod.stdAddChar (-(2 * graphAlternating M u v))
  have hc : ζ ^ 2 / 2 ≤ ‖𝔼 u, 𝔼 v,
      (μ u : ℂ) * (μ v : ℂ) * A u * conj (A v) * K u v‖ := by
    simpa only [graphSymmetryFixedCorrelation, graphSymmetryKernel, mul_assoc] using hcorr
  have h := finite_weighted_kernel_cauchy_schwarz μ hμ hμmass A
    (graphLocalAmplitude_norm_le M a b ha hb z) K (by positivity : 0 ≤ ζ ^ 2 / 2) hc
  have he : (𝔼 v, 𝔼 v', μ v * μ v' * ‖𝔼 u, (μ u : ℂ) * K u v * conj (K u v')‖) =
      𝔼 v, 𝔼 v', μ v * μ v' * ‖graphAlternatingFourier μ M (v - v')‖ := by
    apply Finset.expect_congr rfl
    intro v _
    apply Finset.expect_congr rfl
    intro v' _
    by_cases hv : μ v = 0
    · simp [hv]
    by_cases hv' : μ v' = 0
    · simp [hv']
    have hM := graph_local_additive_sub S M hs hρ hadd (hμsupp v hv) (hμsupp v' hv')
    have hinner : (𝔼 u, (μ u : ℂ) * K u v * conj (K u v')) =
        graphAlternatingFourier μ M (v - v') := by
      apply Finset.expect_congr rfl
      intro u _
      dsimp [K]
      rw [mul_assoc, graph_alternating_character_difference M u v v' hM]
    rw [hinner]
  rw [he] at h
  convert h using 1; ring

/-- The supported upper level set used in the local-symmetry argument,
 blueprint `lem:local-symmetry`, lines 983-989. -/
noncomputable def weightedUpperLevel {I : Type*} [Fintype I]
    (μ θ : I → ℝ) (τ : ℝ) : Finset I := by
  classical
  exact Finset.univ.filter (fun i => μ i ≠ 0 ∧ τ ≤ θ i)

/-- A normalized weighted average at least twice the threshold gives at least
 the threshold of mass to its supported upper level set. -/
lemma finite_weighted_upper_level_mass {I : Type*} [Fintype I] [DecidableEq I]
    (μ θ : I → ℝ) (hμ : ∀ i, 0 ≤ μ i) (hmass : 𝔼 i, μ i = 1)
    (hθ : ∀ i, θ i ≤ 1) {τ : ℝ} (hτ : 0 ≤ τ)
    (havg : 2 * τ ≤ 𝔼 i, μ i * θ i) :
    τ ≤ 𝔼 i, if i ∈ weightedUpperLevel μ θ τ then μ i else 0 := by
  classical
  have hp (i : I) : μ i * θ i ≤ τ * μ i +
      (if i ∈ weightedUpperLevel μ θ τ then μ i else 0) := by
    by_cases hi : i ∈ weightedUpperLevel μ θ τ
    · simp only [ite_eq_left hi]
      nlinarith [mul_nonneg hτ (hμ i), mul_le_mul_of_nonneg_left (hθ i) (hμ i)]
    · simp only [ite_eq_right hi]
      by_cases hz : μ i = 0
      · simp [hz]
      · have ht : θ i < τ := by
          simpa [weightedUpperLevel, hz] using hi
        nlinarith [mul_le_mul_of_nonneg_left ht.le (hμ i)]
  have h := Finset.expect_le_expect (s := Finset.univ) (fun i _ => hp i)
  rw [Finset.expect_add_distrib, ← Finset.mul_expect, hmass, mul_one] at h
  linarith

/-- A pointwise density cap converts normalized weighted mass to counting density. -/
lemma finite_weighted_set_density {I : Type*} [Fintype I] [DecidableEq I]
    (μ : I → ℝ) (A : Finset I) {β τ : ℝ} (hβ : 0 < β)
    (hcap : ∀ i, μ i ≤ 1 / β)
    (hmass : τ ≤ 𝔼 i, if i ∈ A then μ i else 0) :
    β * τ ≤ (A.card : ℝ) / Fintype.card I := by
  have h : (𝔼 i, if i ∈ A then μ i else 0) ≤
      𝔼 i, if i ∈ A then (1 / β : ℝ) else 0 := by
    apply Finset.expect_le_expect
    intro i _
    split_ifs
    · exact hcap i
    · exact le_rfl
  have he : (𝔼 i, if i ∈ A then (1 / β : ℝ) else 0) =
      ((A.card : ℝ) / Fintype.card I) / β := by
    rw [Fintype.expect_eq_sum_div_card]
    simp only [Finset.sum_ite_mem, Finset.univ_inter,
      Finset.sum_const, nsmul_eq_mul]
    ring
  rw [he] at h
  have := (le_div_iff₀ hβ).mp (hmass.trans h)
  simpa only [mul_comm] using this

/-- Every normalized nonnegative local Fourier coefficient has modulus at most one. -/
lemma graphAlternatingFourier_norm_le {q : ℕ} [NeZero q]
    (μ : ZMod q → ℝ) (hμ : ∀ u, 0 ≤ μ u) (hmass : (𝔼 u, μ u) = 1)
    (M : ZMod q → ZMod q) (v : ZMod q) :
    ‖graphAlternatingFourier μ M v‖ ≤ 1 := by
  unfold graphAlternatingFourier
  calc
    _ ≤ 𝔼 u, ‖(μ u : ℂ) * ZMod.stdAddChar (-(2 * graphAlternating M u v))‖ :=
      RCLike.norm_expect_le (K := ℂ)
    _ = 𝔼 u, μ u := by
      apply Finset.expect_congr rfl
      intro u _
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (hμ u)]
      simp [ZMod.stdAddChar_apply]
    _ = 1 := hmass

/-- Extract the supported local spectrum with its weighted mass and ordinary density;
 blueprint `lem:local-symmetry`, lines 983-989. -/
theorem graph_local_spectrum_set {q : ℕ} [NeZero q]
    (μ : ZMod q → ℝ) (hμ : ∀ u, 0 ≤ μ u) (hmass : (𝔼 u, μ u) = 1)
    {β ζ : ℝ} (hβ : 0 < β) (hcap : ∀ u, μ u ≤ 1 / β) (hζ : 0 < ζ)
    (M : ZMod q → ZMod q)
    (hcorr : ζ ^ 4 / 4 ≤
      𝔼 v, 𝔼 v', μ v * μ v' * ‖graphAlternatingFourier μ M (v - v')‖) :
    ∃ v' : ZMod q, ∃ A : Finset (ZMod q), μ v' ≠ 0 ∧ A.Nonempty ∧
      ζ ^ 4 / 8 ≤ (𝔼 v, if v ∈ A then μ v else 0) ∧
      β * (ζ ^ 4 / 8) ≤ (A.card : ℝ) / q ∧
      ∀ v ∈ A, μ v ≠ 0 ∧ ζ ^ 4 / 8 ≤ ‖graphAlternatingFourier μ M (v - v')‖ := by
  classical
  let F : ZMod q → ℝ := fun v' => 𝔼 v, μ v * ‖graphAlternatingFourier μ M (v - v')‖
  have hF (v') : 0 ≤ F v' := Finset.expect_nonneg (fun v _ => mul_nonneg (hμ v) (norm_nonneg _))
  have he : (𝔼 v, 𝔼 v', μ v * μ v' * ‖graphAlternatingFourier μ M (v - v')‖) =
      𝔼 v', μ v' * F v' := by
    rw [Finset.expect_comm]
    apply Finset.expect_congr rfl
    intro v' _
    dsimp only [F]
    rw [Finset.mul_expect]
    apply Finset.expect_congr rfl
    intro v _
    ring
  rw [he] at hcorr
  have hc : ζ ^ 4 / 4 ≤ ‖𝔼 v', (μ v' : ℂ) * (F v' : ℂ)‖ := by
    have hec : (𝔼 v', (μ v' : ℂ) * (F v' : ℂ)) = ((𝔼 v', μ v' * F v' : ℝ) : ℂ) := by
      rw [finite_expect_ofReal]
      simp only [Complex.ofReal_mul]
    rw [hec, Complex.norm_real, Real.norm_of_nonneg
      (Finset.expect_nonneg (fun v' _ => mul_nonneg (hμ v') (hF v')))]
    exact hcorr
  obtain ⟨v', hv', hv⟩ := finite_weighted_correlation_select μ hμ hmass.le
    (fun v' => (F v' : ℂ)) (by positivity : 0 < ζ ^ 4 / 4) hc
  rw [Complex.norm_real, Real.norm_of_nonneg (hF v')] at hv
  let θ : ZMod q → ℝ := fun v => ‖graphAlternatingFourier μ M (v - v')‖
  let A := weightedUpperLevel μ θ (ζ ^ 4 / 8)
  have hAmass : ζ ^ 4 / 8 ≤ 𝔼 v, if v ∈ A then μ v else 0 :=
    finite_weighted_upper_level_mass μ θ hμ hmass
      (fun v => graphAlternatingFourier_norm_le μ hμ hmass M (v - v'))
      (by positivity) (by dsimp [F] at hv; dsimp [θ]; linarith)
  have hAdensity : β * (ζ ^ 4 / 8) ≤ (A.card : ℝ) / q := by
    simpa only [ZMod.card] using finite_weighted_set_density μ A hβ hcap hAmass
  have hA : A.Nonempty := by
    by_contra hn
    rw [Finset.not_nonempty_iff_eq_empty.mp hn, Finset.card_empty, Nat.cast_zero,
      zero_div] at hAdensity
    have : 0 < β * (ζ ^ 4 / 8) := by positivity
    linarith
  refine ⟨v', A, hv', hA, hAmass, hAdensity, ?_⟩
  intro v hv
  exact (Finset.mem_filter.mp hv).2

/-- Additivity of the alternating phase in its first argument uses only the displayed
 local additivity identity for the frequency map. -/
lemma graphAlternatingPhase_add_left {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (x y z : ZMod q) (hM : M (x + y) = M x + M y) :
    graphAlternatingPhase M (x + y) z =
      graphAlternatingPhase M x z + graphAlternatingPhase M y z := by
  unfold graphAlternatingPhase
  rw [← map_add]
  congr 1
  unfold graphAlternating
  rw [hM]
  ring

/-- The exact local Fourier decay estimate for an alternating graph frequency;
 blueprint `lem:local-symmetry`, lines 990-994. -/
theorem graph_alternating_fourier_decay {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L b) (hb : ∀ a, 0 ≤ b a) (hb1 : ∀ a, b a ≤ 1)
    (hbone : ∀ a, |a| ≤ 1 / 2 → b a = 1) (hsupp : ∀ a, 1 ≤ |a| → b a = 0)
    (S : Finset (ZMod q)) {r ρ : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8)
    (hρ : 3 * r ≤ ρ) (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    {τ : ℝ} (hτ : 0 < τ) (z : ZMod q)
    (hcorr : τ ≤ ‖graphAlternatingFourier (graphBohrMeasure b S r) M z‖)
    (x : ZMod q) (hx : x ∈ graphBohrSet S r) :
    ‖(2 : ℕ) • graphAlternatingPhase M x z‖ ≤
      max (L : ℝ) 1 * S.card * graphBohrNorm S x / (r * graphBohrMass b S r * τ) := by
  let φ : ZMod q → UnitAddCircle := fun u => -(2 • graphAlternatingPhase M u z)
  have hsets (s : ℝ) : cyclicBohrSet S s = graphBohrSet S s := by
    ext u
    rw [mem_cyclicBohrSet, mem_graphBohrSet]
  have hφ : ∀ u ∈ cyclicBohrSet S (3 * r), ∀ v ∈ cyclicBohrSet S (3 * r),
      u + v ∈ cyclicBohrSet S (3 * r) → φ (u + v) = φ u + φ v := by
    intro u hu v hv huv
    rw [hsets] at hu hv huv
    have hm := graphBohrSet_mono (Finset.Subset.refl S) hρ
    have hM := hadd u (hm hu) v (hm hv) (hm huv)
    simp only [φ, graphAlternatingPhase_add_left M u v z hM, smul_add, neg_add]
  have he : weightedCircleAverage (cyclicBohrMeasure b S r) φ =
      graphAlternatingFourier (graphBohrMeasure b S r) M z := by
    apply Finset.expect_congr rfl
    intro u _
    have hp : φ u = ZMod.toAddCircle (-(2 * graphAlternating M u z)) := by
      dsimp [φ, graphAlternatingPhase]
      simp only [map_neg, two_mul, map_add, two_smul]
    rw [hp]
    rfl
  have h := cyclicBohrWeight_local_fourier_decay b hLip hb hb1 hbone hsupp S hr hrsmall
    φ hφ hτ (by rw [he]; exact hcorr) x (by rw [hsets]; exact hx)
  change ‖-(2 • graphAlternatingPhase M x z)‖ ≤ _ at h
  simpa only [norm_neg, cyclicBohrNorm, graphBohrNorm, cyclicBohrMass,
    graphBohrMass, cyclicBohrWeight, graphBohrWeight, circleCutoff, unitCircleCentered] using h

/-- Additivity in the second slot of the alternating phase. -/
lemma graphAlternatingPhase_add_right {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (x y z : ZMod q) (hM : M (y + z) = M y + M z) :
    graphAlternatingPhase M x (y + z) =
      graphAlternatingPhase M x y + graphAlternatingPhase M x z := by
  unfold graphAlternatingPhase
  rw [← map_add]
  congr 1
  unfold graphAlternating
  rw [hM]
  ring

/-- Subtraction in the second slot needs only the corresponding local map identity. -/
lemma graphAlternatingPhase_sub_right {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (x y z : ZMod q) (hM : M (y - z) = M y - M z) :
    graphAlternatingPhase M x (y - z) =
      graphAlternatingPhase M x y - graphAlternatingPhase M x z := by
  unfold graphAlternatingPhase
  rw [← map_sub]
  congr 1
  unfold graphAlternating
  rw [hM]
  ring

/-- Four supported phase estimates extend to the double difference set, with all
 partial sums inside the original domain; blueprint `lem:local-symmetry`, lines 995-999. -/
theorem graph_alternating_fourfold_bound {q : ℕ} [NeZero q]
    (S A : Finset (ZMod q)) {r ρ E : ℝ} (hr : 0 ≤ r) (hρ : 4 * r ≤ ρ)
    (M : ZMod q → ZMod q)
    (hadd : ∀ u ∈ graphBohrSet S ρ, ∀ v ∈ graphBohrSet S ρ,
      u + v ∈ graphBohrSet S ρ → M (u + v) = M u + M v)
    (hA : A ⊆ graphBohrSet S r) (v' : ZMod q) (hv' : v' ∈ graphBohrSet S r)
    (x : ZMod q) (hbound : ∀ v ∈ A, ‖(2 : ℕ) • graphAlternatingPhase M x (v - v')‖ ≤ E)
    (z : ZMod q) (hz : z ∈ (2 : ℕ) • A - (2 : ℕ) • A) :
    ‖(2 : ℕ) • graphAlternatingPhase M x z‖ ≤ 4 * E := by
  rw [two_nsmul] at hz
  obtain ⟨ab, hab, cd, hcd, rfl⟩ := Finset.mem_sub.mp hz
  obtain ⟨a, ha, b, hb, rfl⟩ := Finset.mem_add.mp hab
  obtain ⟨c, hc, d, hd, rfl⟩ := Finset.mem_add.mp hcd
  have hm1 := graphBohrSet_mono (Finset.Subset.refl S) (show r ≤ ρ by linarith)
  have hm2 := graphBohrSet_mono (Finset.Subset.refl S) (show r + r ≤ ρ by linarith)
  have hab := graphBohrSet_add S (hA ha) (hA hb)
  have hcd := graphBohrSet_add S (hA hc) (hA hd)
  have hMab := hadd a (hm1 (hA ha)) b (hm1 (hA hb)) (hm2 hab)
  have hMcd := hadd c (hm1 (hA hc)) d (hm1 (hA hd)) (hm2 hcd)
  have hMsub := graph_local_additive_sub S M (add_nonneg hr hr)
    (show 2 * (r + r) ≤ ρ by linarith) hadd hab hcd
  have hp (v : ZMod q) (hv : v ∈ A) : graphAlternatingPhase M x (v - v') =
      graphAlternatingPhase M x v - graphAlternatingPhase M x v' :=
    graphAlternatingPhase_sub_right M x v v'
      (graph_local_additive_sub S M hr (by linarith) hadd (hA hv) hv')
  have he : graphAlternatingPhase M x ((a + b) - (c + d)) =
      (graphAlternatingPhase M x (a - v') + graphAlternatingPhase M x (b - v')) -
      (graphAlternatingPhase M x (c - v') + graphAlternatingPhase M x (d - v')) := by
    rw [graphAlternatingPhase_sub_right M x _ _ hMsub,
      graphAlternatingPhase_add_right M x a b hMab,
      graphAlternatingPhase_add_right M x c d hMcd, hp a ha, hp b hb, hp c hc, hp d hd]
    abel
  rw [he, smul_sub, smul_add, smul_add]
  have hn := norm_sub_le
    ((2 : ℕ) • graphAlternatingPhase M x (a - v') + 2 • graphAlternatingPhase M x (b - v'))
    ((2 : ℕ) • graphAlternatingPhase M x (c - v') + 2 • graphAlternatingPhase M x (d - v'))
  have habn := norm_add_le ((2 : ℕ) • graphAlternatingPhase M x (a - v'))
    (2 • graphAlternatingPhase M x (b - v'))
  have hcdn := norm_add_le ((2 : ℕ) • graphAlternatingPhase M x (c - v'))
    (2 • graphAlternatingPhase M x (d - v'))
  linarith [hbound a ha, hbound b hb, hbound c hc, hbound d hd]

/-- The local spectrum controls the alternating phase on its entire double difference set. -/
theorem graph_spectrum_difference_decay {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L b) (hb : ∀ a, 0 ≤ b a) (hb1 : ∀ a, b a ≤ 1)
    (hbone : ∀ a, |a| ≤ 1 / 2 → b a = 1) (hsupp : ∀ a, 1 ≤ |a| → b a = 0)
    (S A : Finset (ZMod q)) {r ρ : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8)
    (hρ : 4 * r ≤ ρ) (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (hA : A ⊆ graphBohrSet S r) (v' : ZMod q) (hv' : v' ∈ graphBohrSet S r)
    {τ : ℝ} (hτ : 0 < τ)
    (hcorr : ∀ v ∈ A, τ ≤ ‖graphAlternatingFourier (graphBohrMeasure b S r) M (v - v')‖)
    (x : ZMod q) (hx : x ∈ graphBohrSet S r)
    (z : ZMod q) (hz : z ∈ (2 : ℕ) • A - (2 : ℕ) • A) :
    ‖(2 : ℕ) • graphAlternatingPhase M x z‖ ≤
      4 * (max (L : ℝ) 1 * S.card / (r * graphBohrMass b S r * τ)) * graphBohrNorm S x := by
  have h := graph_alternating_fourfold_bound S A hr.le hρ M hadd hA v' hv' x
    (fun v hv => graph_alternating_fourier_decay b hLip hb hb1 hbone hsupp S hr hrsmall
      (by linarith) M hadd hτ (v - v') (hcorr v hv) x hx) z hz
  convert h using 1; ring

/-- A concrete radius satisfying all three shrinkage constraints in the local-symmetry proof. -/
noncomputable def graphSymmetryRefinedRadius (ρ r ζ D : ℝ) : ℝ :=
  ρ * r * ζ / (1000000 * (D + 1))

/-- The product radius is positive, small in each domain, and small enough for the phase bound. -/
lemma graphSymmetryRefinedRadius_bounds {ρ r ζ D : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ ≤ 1) (hr : 0 < r) (hr1 : r ≤ 1)
    (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) (hD : 0 ≤ D) :
    0 < graphSymmetryRefinedRadius ρ r ζ D ∧
      graphSymmetryRefinedRadius ρ r ζ D ≤ ρ / 100 ∧
      graphSymmetryRefinedRadius ρ r ζ D ≤ r / 100 ∧
      1000000 * D * graphSymmetryRefinedRadius ρ r ζ D ≤ ζ := by
  have hden : 0 < 1000000 * (D + 1) := by positivity
  have hprod : ρ * r ≤ 1 := (mul_le_of_le_one_left hr.le hρ1).trans hr1
  have hrζ : r * ζ ≤ 1 := (mul_le_of_le_one_left hζ.le hr1).trans hζ1
  have hρζ : ρ * ζ ≤ 1 := (mul_le_of_le_one_left hζ.le hρ1).trans hζ1
  dsimp [graphSymmetryRefinedRadius]
  refine ⟨by positivity, ?_, ?_, ?_⟩
  · apply (div_le_iff₀ hden).mpr
    have := mul_le_mul_of_nonneg_left hrζ hρ.le
    nlinarith [mul_nonneg hρ.le hD]
  · apply (div_le_iff₀ hden).mpr
    have := mul_le_mul_of_nonneg_left hρζ hr.le
    nlinarith [mul_nonneg hr.le hD]
  · rw [← mul_div_assoc]
    apply (div_le_iff₀ hden).mpr
    have := mul_le_mul_of_nonneg_left hprod (show 0 ≤ 1000000 * D * ζ by positivity)
    nlinarith

/-- Exact logarithmic cost of the explicit refined radius. -/
lemma graphSymmetryRefinedRadius_log {ρ r ζ D : ℝ}
    (hρ : 0 < ρ) (hr : 0 < r) (hζ : 0 < ζ) (hD : 0 ≤ D) :
    Real.log (1 / graphSymmetryRefinedRadius ρ r ζ D) =
      Real.log (1 / ρ) + Real.log (1 / r) + Real.log (1 / ζ) +
        Real.log 1000000 + Real.log (D + 1) := by
  have hD' : D + 1 ≠ 0 := by positivity
  simp only [graphSymmetryRefinedRadius, one_div, Real.log_inv,
    Real.log_div (mul_ne_zero (mul_ne_zero hρ.ne' hr.ne') hζ.ne')
      (mul_ne_zero (by norm_num : (1000000 : ℝ) ≠ 0) hD'),
    Real.log_mul (mul_ne_zero hρ.ne' hr.ne') hζ.ne',
    Real.log_mul hρ.ne' hr.ne', Real.log_mul (by norm_num : (1000000 : ℝ) ≠ 0) hD']
  ring

/-- Dense Bogolyubov followed by an explicit radius shrinkage, preserving the original
 frequencies and recording the complete rank/logarithmic cost. -/
theorem graph_symmetry_dense_subdomain {q : ℕ} [NeZero q]
    (S A : Finset (ZMod q)) (hA : A.Nonempty) {r ζ D : ℝ}
    (hr : 0 < r) (hr1 : r ≤ 1) (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) (hD : 0 ≤ D) :
    ∃ T : Finset (ZMod q), ∃ s : ℝ, S ⊆ T ∧ 1 ∈ T ∧ 0 < s ∧ s ≤ r / 100 ∧
      1000000 * D * s ≤ ζ ∧ graphBohrSet T s ⊆ (2 : ℕ) • A - (2 : ℕ) • A ∧
      (T.card : ℝ) + Real.log (1 / s) ≤ S.card +
        10 ^ 20 * (1 + Real.log (1 / ((A.card : ℝ) / q))) ^ 4 +
        Real.log (1 / r) + Real.log (1 / ζ) + Real.log 1000000 + Real.log (D + 1) := by
  classical
  obtain ⟨T, ρ, hT1, hρ, hρsmall, hcost, hcontain⟩ := cyclic_small_bohr_domain A hA
  let s := graphSymmetryRefinedRadius ρ r ζ D
  obtain ⟨hs, hsρ, hsr, hsD⟩ := graphSymmetryRefinedRadius_bounds hρ
    (by linarith) hr hr1 hζ hζ1 hD
  refine ⟨S ∪ T, s, Finset.subset_union_left, Finset.mem_union_right S hT1,
    hs, hsr, hsD, ?_, ?_⟩
  · apply Finset.Subset.trans _ hcontain
    exact graphBohrSet_mono Finset.subset_union_right (hsρ.trans (by linarith))
  · have hcard : ((S ∪ T).card : ℝ) ≤ S.card + T.card := by
      exact_mod_cast Finset.card_union_le S T
    have hlog := graphSymmetryRefinedRadius_log hρ hr hζ hD
    change Real.log (1 / s) = _ at hlog
    rw [hlog]
    linarith

/-- In odd cyclic groups, doubling a Bohr domain divides its frequencies by two.
 Here doubling is an image, not the sum of two independently chosen points. -/
theorem graphBohrSet_doubling {q : ℕ} [NeZero q] (hq : Odd q)
    (T : Finset (ZMod q)) (r : ℝ) :
    graphBohrSet (T.image (fun t => (2 : ZMod q)⁻¹ * t)) r =
      (graphBohrSet T r).image (fun u => 2 * u) := by
  classical
  have hunit : IsUnit (2 : ZMod q) :=
    (ZMod.isUnit_iff_coprime 2 q).mpr (Nat.coprime_two_left.mpr hq)
  have hcancel := ZMod.mul_inv_of_unit (2 : ZMod q) hunit
  ext x
  constructor
  · intro hx
    refine Finset.mem_image.mpr ⟨(2 : ZMod q)⁻¹ * x, ?_, ?_⟩
    · rw [mem_graphBohrSet]
      intro t ht
      have h := (mem_graphBohrSet _ _ _).mp hx ((2 : ZMod q)⁻¹ * t)
        (Finset.mem_image.mpr ⟨t, ht, rfl⟩)
      rw [show t * ((2 : ZMod q)⁻¹ * x) = ((2 : ZMod q)⁻¹ * t) * x by ring]
      exact h
    · rw [← mul_assoc, hcancel, one_mul]
  · intro hx
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hx
    rw [mem_graphBohrSet]
    intro t ht
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp ht
    have he : (2 : ZMod q)⁻¹ * a * (2 * u) = a * u := by
      calc
        _ = (2 * (2 : ZMod q)⁻¹) * (a * u) := by ring
        _ = _ := by rw [hcancel, one_mul]
    rw [he]
    exact (mem_graphBohrSet T r u).mp hu a ha

/-- Local doubling in each argument quadruples the circle-valued alternating phase. -/
lemma graphAlternatingPhase_double {q : ℕ} [NeZero q]
    (M : ZMod q → ZMod q) (u v : ZMod q)
    (hu : M (2 * u) = 2 * M u) (hv : M (2 * v) = 2 * M v) :
    graphAlternatingPhase M (2 * u) (2 * v) = (4 : ℕ) • graphAlternatingPhase M u v := by
  unfold graphAlternatingPhase
  rw [← map_nsmul]
  congr 1
  unfold graphAlternating
  rw [hu, hv]
  simp only [nsmul_eq_mul]
  ring

/-- Doubling the small domain controls the phase itself, without dividing a circle norm;
 blueprint `lem:local-symmetry`, lines 1008-1013. -/
theorem graph_symmetry_doubling_domain {q : ℕ} [NeZero q] (hq : Odd q)
    (S T : Finset (ZMod q)) (hST : S ⊆ T) {r s ρ D : ℝ}
    (hsr : s ≤ r) (hρ : 2 * r ≤ ρ) (hr : 0 ≤ r)
    (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (hphase : ∀ u ∈ graphBohrSet T s, ∀ v ∈ graphBohrSet T s,
      ‖(2 : ℕ) • graphAlternatingPhase M u v‖ ≤ 4 * D * s) :
    ∃ S' : Finset (ZMod q), S ⊆ S' ∧ S'.card ≤ S.card + T.card ∧
      ∀ x ∈ graphBohrSet S' s, ∀ y ∈ graphBohrSet S' s,
        ‖graphAlternatingPhase M x y‖ ≤ 8 * D * s := by
  classical
  let U := T.image (fun t => (2 : ZMod q)⁻¹ * t)
  refine ⟨S ∪ U, Finset.subset_union_left, ?_, ?_⟩
  · exact (Finset.card_union_le S U).trans (Nat.add_le_add_left (Finset.card_image_le) _)
  · intro x hx y hy
    have hm := graphBohrSet_mono (S := U) (T := S ∪ U) Finset.subset_union_right (le_refl s)
    have hx' := hm hx
    have hy' := hm hy
    rw [graphBohrSet_doubling hq T s] at hx' hy'
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hx'
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hy'
    have hdouble (w : ZMod q) (hw : w ∈ graphBohrSet T s) : M (2 * w) = 2 * M w := by
      have hw' := graphBohrSet_mono hST hsr hw
      have hm1 := graphBohrSet_mono (Finset.Subset.refl S) (show r ≤ ρ by linarith)
      have hm2 := graphBohrSet_mono (Finset.Subset.refl S) (show r + r ≤ ρ by linarith)
      simpa only [two_mul] using hadd w (hm1 hw') w (hm1 hw') (hm2 (graphBohrSet_add S hw' hw'))
    rw [graphAlternatingPhase_double M u v (hdouble u hu) (hdouble v hv)]
    have he : (4 : ℕ) • graphAlternatingPhase M u v =
        (2 : ℕ) • ((2 : ℕ) • graphAlternatingPhase M u v) := by rw [← mul_smul]; norm_num
    rw [he]
    have hn : ‖(2 : ℕ) • (2 • graphAlternatingPhase M u v)‖ ≤
        (2 : ℕ) * ‖(2 : ℕ) • graphAlternatingPhase M u v‖ := norm_nsmul_le
    norm_num only [Nat.cast_ofNat] at hn
    linarith [hphase u hu v hv]

/-- The dense spectrum estimate yields a smaller symmetric Bohr domain with its explicit
 complexity cost, before the final polynomial simplification in local symmetry. -/
theorem graph_symmetry_from_spectrum {q : ℕ} [NeZero q] (hq : Odd q)
    (S A : Finset (ZMod q)) (hA : A.Nonempty) {r ρ ζ D : ℝ}
    (hr : 0 < r) (hr1 : r ≤ 1) (hρ : 2 * r ≤ ρ)
    (hζ : 0 < ζ) (hζ1 : ζ ≤ 1) (hD : 0 ≤ D) (M : ZMod q → ZMod q)
    (hadd : ∀ x ∈ graphBohrSet S ρ, ∀ y ∈ graphBohrSet S ρ,
      x + y ∈ graphBohrSet S ρ → M (x + y) = M x + M y)
    (hphase : ∀ u ∈ graphBohrSet S r, ∀ v ∈ (2 : ℕ) • A - (2 : ℕ) • A,
      ‖(2 : ℕ) • graphAlternatingPhase M u v‖ ≤ 4 * D * graphBohrNorm S u) :
    ∃ S' : Finset (ZMod q), ∃ s : ℝ, S ⊆ S' ∧ 0 < s ∧ s < r ∧
      (∀ x ∈ graphBohrSet S' s, ∀ y ∈ graphBohrSet S' s,
        ‖graphAlternatingPhase M x y‖ ≤ ζ / 1000) ∧
      (S'.card : ℝ) + Real.log (1 / s) ≤ 2 * S.card +
        10 ^ 20 * (1 + Real.log (1 / ((A.card : ℝ) / q))) ^ 4 +
        Real.log (1 / r) + Real.log (1 / ζ) + Real.log 1000000 + Real.log (D + 1) := by
  obtain ⟨T, s, hST, _, hs, hsr, hsD, hcontain, hcost⟩ :=
    graph_symmetry_dense_subdomain S A hA hr hr1 hζ hζ1 hD
  have hsr' : s ≤ r := hsr.trans (by linarith)
  have hp (u : ZMod q) (hu : u ∈ graphBohrSet T s)
      (v : ZMod q) (hv : v ∈ graphBohrSet T s) :
      ‖(2 : ℕ) • graphAlternatingPhase M u v‖ ≤ 4 * D * s := by
    have huS := graphBohrSet_mono hST (le_refl s) hu
    have huR := graphBohrSet_mono (Finset.Subset.refl S) hsr' huS
    exact (hphase u huR v (hcontain hv)).trans
      (mul_le_mul_of_nonneg_left (graphBohrNorm_le_of_mem S hs.le huS) (by positivity))
  obtain ⟨S', hSS', hcard, hphase'⟩ :=
    graph_symmetry_doubling_domain hq S T hST hsr' hρ hr.le M hadd hp
  refine ⟨S', s, hSS', hs, by linarith, ?_, ?_⟩
  · intro x hx y hy
    have h := hphase' x hx y hy
    nlinarith [mul_nonneg hD hs.le]
  · have hc : (S'.card : ℝ) ≤ S.card + T.card := by exact_mod_cast hcard
    linarith

end Auto
