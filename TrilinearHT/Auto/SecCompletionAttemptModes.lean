    rw [(hcell m).2.2.2 y]; rfl
  let Ms : ModeSystem A.G ap.Mc :=
    { Md := Md
      fin := hMd
      L := L
      zc := A.vtag z
      δc := δ
      ρ := ρ
      cl := slotCoeff l
      cellOf := cellOf
      lamOf := lamOf
      γOf := γOf
      Key := Key
      keyOf := keyOf
      dvOf := dvOf
      θvOf := θvOf
      Bσ := max 1 (Real.exp (D * X ^ D) *
        (1 + 4 * (2 * dB + 1) * max 1 (4 * Real.exp (D * X ^ D) / δc)))
      one_le_Bσ := le_max_left _ _
