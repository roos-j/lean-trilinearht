namespace ColorSetup

variable {V : Type*} [DecidableEq V] (K : ColorSetup V) (T : AdmTree V)

/-- A vertex of the ball mask of a group lies within the winner bound of the group's center
(blueprint eq:ball-mask, first clause): with the group's primary winner `(ρ, z, g)`, its graph
distance `k` from `z` obeys `(g - 1) b₁ - h ≤ b₁ D_ρ(z) - k`. -/
theorem mask_center_dist (Nv : ℕ)
    {G : ℕ × (Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ))} {h : ℕ}
    {I : T.Cell} {b : V} (hb : b ∈ K.mask T Nv G h I) {ρ : Fin K.d0} {z : V} {g : ℤ}
    (hG : G.2.1 = some (ρ, z, g)) :
    ∃ k : ℕ, K.dist.d (T.depth I) z b = k ∧ (g - 1) * K.b1 - h ≤ K.b1 * K.Dp ρ z - k := by
  obtain ⟨-, I₀, -, v₀, -, hgrp, ρ', z', g', m, l, n, ρ'', a, g₂, hc, -, hk, -⟩ := hb
  have e : (K.colorData (T.st I₀) v₀).1 = some (ρ', z', g') := by rw [hc]
  have e' : (K.colorData (T.st I₀) v₀).1 = G.2.1 := by rw [← hgrp]; rfl
  rw [e', hG] at e
  simp only [Option.some.injEq, Prod.mk.injEq] at e
  obtain ⟨rfl, rfl, rfl⟩ := e
  exact hk

end ColorSetup

/-! ### Equal tags are joined (blueprint line 1684: the tag graph contains equal tags) -/

/-- The folding of the doubled coordinates. -/
def foldIdx (d : ℕ) : Fin (d + d) → Fin d := Fin.addCases (motive := fun _ => Fin d) id id

@[simp] theorem foldIdx_castAdd {d : ℕ} (a : Fin d) : foldIdx d (Fin.castAdd d a) = a :=
  Fin.addCases_left (motive := fun _ => Fin d) a

@[simp] theorem foldIdx_natAdd {d : ℕ} (a : Fin d) : foldIdx d (Fin.natAdd d a) = a :=
  Fin.addCases_right (motive := fun _ => Fin d) a

/-- The averaging projection of the doubled coordinates onto the diagonal. -/
def diagAvgQ (d : ℕ) : Matrix (Fin (d + d)) (Fin (d + d)) ℚ :=
  fun i j => if foldIdx d i = foldIdx d j then 1 / 2 else 0

noncomputable def diagAvgR (d : ℕ) : Matrix (Fin (d + d)) (Fin (d + d)) ℝ :=
  fun i j => if foldIdx d i = foldIdx d j then 1 / 2 else 0

theorem diagAvg_sum {d : ℕ} (i : Fin (d + d)) (f : Fin (d + d) → ℝ) :
    ∑ k, diagAvgR d i k * f k =
      (1 / 2) * (f (Fin.castAdd d (foldIdx d i)) + f (Fin.natAdd d (foldIdx d i))) := by
  rw [Fin.sum_univ_add]
  simp only [diagAvgR, foldIdx_castAdd, foldIdx_natAdd, ite_mul, zero_mul, Finset.sum_ite_eq,
    Finset.mem_univ, ↓reduceIte]
  ring

theorem diagAvgQ_map {d : ℕ} : (diagAvgQ d).map (fun q => (q : ℝ)) = diagAvgR d := by
  ext i j; simp only [Matrix.map_apply, diagAvgQ, diagAvgR]; split_ifs <;> norm_num

theorem diagAvgR_mul_self (d : ℕ) : diagAvgR d * diagAvgR d = diagAvgR d := by
  ext i j
  rw [Matrix.mul_apply, diagAvg_sum]
  simp only [diagAvgR, foldIdx_castAdd, foldIdx_natAdd]
  split_ifs <;> norm_num

theorem diagAvgR_transpose (d : ℕ) : (diagAvgR d).transpose = diagAvgR d := by
  ext i j; simp only [Matrix.transpose_apply, diagAvgR, eq_comm]

theorem diagAvg_isStarProjection (d : ℕ) :
    IsStarProjection (realMatrixOperator (diagAvgR d)) := by
  refine ⟨?_, ?_⟩
  · change (realMatrixOperator (diagAvgR d)).comp (realMatrixOperator (diagAvgR d)) = _
    ext x : 1
    rw [ContinuousLinearMap.comp_apply, ← realMatrixOperator_mul_apply, diagAvgR_mul_self]
  · rw [ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric]
    intro x y
    change inner ℝ (realMatrixOperator (diagAvgR d) x) y = inner ℝ x (realMatrixOperator _ y)
    rw [realMatrixOperator_transpose_inner, diagAvgR_transpose]

theorem rationalHeight_half : rationalHeight (1 / 2 : ℚ) = 2 := by
  rw [rationalHeight, show (1 / 2 : ℚ) = mkRat 1 2 by norm_num [Rat.mkRat_eq_div]]; rfl
theorem rationalHeight_neg_half : rationalHeight (-(1 / 2) : ℚ) = 2 := by
  rw [rationalHeight, show (-(1 / 2) : ℚ) = mkRat (-1) 2 by norm_num [Rat.mkRat_eq_div]]; rfl
theorem rationalHeight_zero : rationalHeight (0 : ℚ) = 1 := by simp [rationalHeight]

/-- Equal tags are joined by an edge of every height `B ≥ 2`: the diagonal of the doubled
coordinates is isotropic for the difference form, and the difference data vanish on it. -/
theorem tagEdge_refl {B : ℝ} (hB : 2 ≤ B) (r : ℝ) (v : ChartTag) : tagEdge B r v v := by
  classical
  set P := realMatrixOperator (diagAvgR v.dim)
  obtain ⟨hU, hPU⟩ :=
    isStarProjection_iff_eq_starProjection_range.mp (diagAvg_isStarProjection v.dim)
  set U := P.range
  have hQmap : (1 - diagAvgQ v.dim).map (fun q => (q : ℝ)) = 1 - diagAvgR v.dim := by
    rw [← diagAvgQ_map]; ext i j
    simp only [Matrix.map_apply, Matrix.sub_apply, Matrix.one_apply]; split_ifs <;> simp
  have hQ1map : (1 - (1 - diagAvgQ v.dim)).map (fun q => (q : ℝ)) = diagAvgR v.dim := by
    rw [sub_sub_cancel, diagAvgQ_map]
  -- the diagonal vectors
  have hdiag : ∀ x ∈ U, ∀ i, x.ofLp i = x.ofLp (Fin.castAdd v.dim (foldIdx v.dim i)) := by
    rintro x ⟨w, rfl⟩ i
    change (realMatrixOperator (diagAvgR v.dim) w).ofLp i =
      (realMatrixOperator (diagAvgR v.dim) w).ofLp _
    simp only [realMatrixOperator_apply, Matrix.mulVec, dotProduct]
    rw [diagAvg_sum, diagAvg_sum, foldIdx_castAdd]
  have hV : (1 - diagAvgR v.dim) * tagDiffV r v v = 0 := by
    ext i j
    rw [Matrix.sub_mul, Matrix.one_mul, Matrix.sub_apply, Matrix.mul_apply]
    simp only [tagDiffV]
    rw [diagAvg_sum]
    simp only [Fin.append_left, Fin.append_right, Matrix.zero_apply]
    have : Fin.append v.θ v.θ i = v.θ (foldIdx v.dim i) := by
      refine Fin.addCases (fun a => ?_) (fun a => ?_) i
      · rw [foldIdx_castAdd]; exact Fin.append_left _ _ _
      · rw [foldIdx_natAdd]; exact Fin.append_right _ _ _
    rw [this]; ring
  refine ⟨U, 1 - diagAvgQ v.dim, ?_, ?_, ?_, fun i j => ?_, fun i j => ?_, ?_, ?_⟩
  · rw [hQmap, realMatrixOperator_sub, realMatrixOperator_one, Submodule.starProjection_orthogonal,
      ← hPU]
  · rw [hQ1map]; exact hPU
  · intro x hx y hy
    rw [EuclideanSpace.inner_eq_star_dotProduct]
    simp only [star_trivial, realMatrixOperator_apply, dotProduct, Matrix.mulVec]
    rw [Fin.sum_univ_add]
    simp only [Fin.sum_univ_add, Matrix.sub_apply, Matrix.transpose_apply,
      Matrix.map_apply, tagDiffC, chartBlockMatrix, Fin.addCases_left, Fin.addCases_right]
    have hx' : ∀ a, x.ofLp (Fin.natAdd v.dim a) = x.ofLp (Fin.castAdd v.dim a) := fun a => by
      rw [hdiag x hx (Fin.natAdd v.dim a), foldIdx_natAdd]
    have hy' : ∀ a, y.ofLp (Fin.natAdd v.dim a) = y.ofLp (Fin.castAdd v.dim a) := fun a => by
      rw [hdiag y hy (Fin.natAdd v.dim a), foldIdx_natAdd]
    simp only [hx', hy', Rat.cast_zero, sub_self, zero_mul, Finset.sum_const_zero, add_zero,
      zero_add, Matrix.neg_apply, Rat.cast_neg]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun a _ => ?_
    rw [← add_mul, ← Finset.sum_add_distrib, Finset.sum_eq_zero fun b _ => by ring, zero_mul]
  · simp only [Matrix.sub_apply, Matrix.one_apply, diagAvgQ]
    by_cases h1 : i = j
    · subst h1; simp only [↓reduceIte]; norm_num [rationalHeight_half]; linarith
    · by_cases h2 : foldIdx v.dim i = foldIdx v.dim j
      · simp only [h1, h2, ↓reduceIte]; norm_num [rationalHeight_neg_half]; linarith
      · simp only [h1, h2, ↓reduceIte, sub_zero, rationalHeight_zero]; norm_num; linarith
  · rw [sub_sub_cancel]; simp only [diagAvgQ]
    split_ifs
    · norm_num [rationalHeight_half]; linarith
    · norm_num [rationalHeight_zero]; linarith
  · rw [hQmap, hV]
    have : realMatrixOperator (0 : Matrix (Fin (v.dim + v.dim)) (Fin 1) ℝ) = 0 := by
      ext x i; simp [realMatrixOperator_apply]
    rw [this, norm_zero]; linarith
  · rw [hQmap, hV]
    have hE : effectiveReturnQuadratic ((tagDiffC v v).map fun q => (q : ℝ)) (tagDiffΛ r v v)
        (tagDiffV r v v) ((1 - (1 - diagAvgQ v.dim)).map (fun q => (q : ℝ)) * tagDiffV r v v) 0 =
          0 := by
      ext a b
      fin_cases a; fin_cases b
      simp only [effectiveReturnQuadratic, Matrix.mul_zero, realSymmetricPart]
      simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.zero_apply, Matrix.transpose_zero,
        add_zero, smul_zero, smul_eq_mul]
      simp only [Matrix.mul_apply, Matrix.transpose_apply, Matrix.add_apply, Matrix.smul_apply,
        Matrix.map_apply, tagDiffV, tagDiffC, chartBlockMatrix, Fin.sum_univ_add,
        Fin.append_left, Fin.append_right, Fin.addCases_left, Fin.addCases_right, smul_eq_mul]
      push_cast
      simp only [Matrix.neg_apply, Rat.cast_neg, tagDiffΛ, sub_self, mul_zero,
        Finset.sum_const_zero, add_zero, zero_add]
      simp only [mul_neg, ← neg_add, Finset.sum_neg_distrib, neg_mul]
      ring
    have : realMatrixOperator (0 : Matrix (Fin 1) (Fin 1) ℝ) = 0 := by
      ext x i; simp [realMatrixOperator_apply]
    rw [hE, this, norm_zero]; linarith

/-! ### Primaries of a ball are joined to the group center (blueprint lines 1893-1903) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (ap : A.AttemptParams)

/-- The graph radius of a ball mask around its center. -/
noncomputable def ballRadius (g : ℤ) (h : ℕ) : ℕ :=
  (ap.K.b1 * ap.K.d0 - (g - 1) * ap.K.b1 + h).toNat

/-- The edge height of the ball radius `n` in the tag graph. -/
noncomputable def ballEdgeH (dB n : ℕ) : ℝ :=
  Real.exp (100000 * ((n + 1) * (dB + 1) : ℝ) ^ 8 * Real.log (2 * ap.Hed))

theorem two_le_ballEdgeH (hHed : 2 ≤ ap.Hed) (dB n : ℕ) : 2 ≤ ap.ballEdgeH dB n := by
  unfold ballEdgeH
  have hl : 1 ≤ Real.log (2 * ap.Hed) := by
    rw [Real.le_log_iff_exp_le (by linarith)]
    have := Real.exp_one_lt_d9; linarith
  have h1 : (1 : ℝ) ≤ ((n + 1) * (dB + 1) : ℝ) ^ 8 := one_le_pow₀ (by
    have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    have : (0 : ℝ) ≤ dB := Nat.cast_nonneg dB
    nlinarith)
  have h2 : 1 ≤ 100000 * ((n + 1) * (dB + 1) : ℝ) ^ 8 * Real.log (2 * ap.Hed) := by nlinarith
  calc (2 : ℝ) ≤ Real.exp 1 := by have := Real.add_one_le_exp (1 : ℝ); linarith
    _ ≤ _ := Real.exp_le_exp.mpr h2

open Classical in
/-- Blueprint line 1903 (first match, short-path part of lem:graph): a vertex of the ball mask of
a group at an active cell carries a tag joined to the tag of the group center by an edge at the
cell length, of height `ballEdgeH` of the ball radius. -/
theorem mask_tagEdge_center {I : ℤ × ℤ} (hI : I ∈ A.cells) {G : A.Grp} {h : ℕ} {b : A.Vtx}
    (hb : b ∈ ap.K.mask A.admT A.vtxBound G h (A.admAt I)) {ρ : Fin ap.K.d0} {z : A.Vtx} {g : ℤ}
    (hG : G.2.1 = some (ρ, z, g)) (hHed : 2 ≤ ap.Hed) {dB : ℕ}
    (hdim : ∀ w : A.Vtx, (A.vtag w).dim ≤ dB)
    (hC : ∀ (w : A.Vtx) a c, (rationalHeight ((A.vtag w).C a c) : ℝ) ≤ ap.Hed) :
    tagEdge (ap.ballEdgeH dB (ap.ballRadius g h)) (dyadicGridLength A.G I.1) (A.vtag b)
      (A.vtag z) := by
  obtain ⟨k, hk, hkb⟩ := ColorSetup.mask_center_dist ap.K A.admT A.vtxBound hb hG
  have hDp := ap.K.Dp_le ρ z
  have hkn : k ≤ ap.ballRadius g h := by
    unfold ballRadius
    have : (ap.K.Dp ρ z : ℤ) ≤ ap.K.d0 := by exact_mod_cast hDp
    have hb1 : (0 : ℤ) ≤ ap.K.b1 := Int.natCast_nonneg _
    have : (ap.K.b1 : ℤ) * ap.K.Dp ρ z ≤ ap.K.b1 * ap.K.d0 := by nlinarith
    omega
  have hd : (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) z b ≤ ap.ballRadius g h := by
    change ap.K.dist.d _ z b ≤ _
    rw [hk]; exact_mod_cast hkn
  rw [A.depth_admAt hI] at hd
  rcases A.tagEdge_of_dist (le_trans (by norm_num) hHed) hdim hC hd with he | he
  · rw [he]; exact tagEdge_refl (ap.two_le_ballEdgeH hHed dB _) _ _
  · exact tagEdge_symm he

end AttemptParams

end ActiveSetup

/-! ### Catalog projections as column-tree projections (blueprint lines 470-483, 1805-1809) -/

section CatalogTree

variable (G : RealDyadicGrid) {Tg : Type*} (T : Finset (ℤ × ℤ)) (root : ℤ × ℤ)

theorem fitColumnValue_eq_private {Mc : ℕ} (φ : Fin Mc → ℝ → ℂ) (n : Fin Mc) (y : ℝ) :
    privateColumnValue φ (fun _ => 1) n y = fitColumnValue (φ n) n y := by
  ext i
  simp only [privateColumnValue, fitColumnValue, PiLp.add_apply, PiLp.smul_apply,
    PiLp.single_apply, Real.sqrt_one, Complex.ofReal_one, one_smul]
  congr

/-- The column tree of a catalog: labels `Fin Mc`, the catalog atoms as scalars, the catalog
births (the root beyond the catalog) and private weight one. -/
noncomputable def catTree (hbr : ∀ c ∈ T, dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G root.1 root.2) (hroot : root ∈ T) (s : List (CatCol Tg)) (Mc : ℕ)
    (hb : ∀ d ∈ s, d.birth ∈ T) : ColumnTreeData (Fin Mc) where
  grid := G
  cells := T
  root := root
  below_root := hbr
  birth := fun n => if h : (n : ℕ) < s.length then (s[(n : ℕ)]).birth else root
  birth_mem := fun n => by
    by_cases h : (n : ℕ) < s.length
    · simp only [h, ↓reduceDIte]; exact hb _ (List.getElem_mem h)
    · simp only [h, ↓reduceDIte]; exact hroot
  scalar := fun n => catAtom s n
  scalar_measurable := fun n => catAtom_measurable s n
  privateWeight := fun _ => 1
  privateWeight_pos := fun _ => one_pos
  budget := max 2 Mc
  two_le_budget := le_max_left _ _
  private_lower := fun _ => by
    rw [Real.sqrt_one]
    exact inv_le_one_of_one_le₀ (le_trans (by norm_num) (le_max_left _ _))
  column_bound := fun n => Filter.Eventually.of_forall fun y => by
    refine le_trans ?_ (le_max_left _ _)
    unfold privateColumnValue
    refine (norm_add_le _ _).trans ?_
    simp only [norm_smul]
    norm_num
    linarith [catAtom_bound s n y]
  path_count := fun y => by
    refine le_trans ?_ (le_max_right _ _)
    exact_mod_cast (Finset.card_le_univ _).trans (by simp)

variable {G T root}

open Classical in
/-- The inherited mask of a catalog of rank `r` with cell-dependent vertex masks `M`, which grow
in depth. -/
noncomputable def catMask {hbr : ∀ c ∈ T, dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G root.1 root.2} {hroot : root ∈ T} {s : List (CatCol Tg)} {Mc : ℕ}
    {hb : ∀ d ∈ s, d.birth ∈ T} (r : ℕ) (M : ℤ × ℤ → Tg → Prop)
    (hM : ∀ c ∈ T, ∀ d ∈ T, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      ∀ x, M d x → M c x) :
    InheritedColumnMask (catTree G T root hbr hroot s Mc hb) where
  labels := fun c => catLabels G Mc s c r (M c)
  available := fun c _ n hn => by
    simp only [catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hn
    obtain ⟨hnl, h1, -, -⟩ := hn
    change _ ⊆ dyadicGridCell G (if h : (n : ℕ) < s.length then (s[(n : ℕ)]).birth else root).1
      (if h : (n : ℕ) < s.length then (s[(n : ℕ)]).birth else root).2
    simp only [hnl, ↓reduceDIte]; exact h1
  inherited := fun c hc d hd hcd n hn => by
    simp only [catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hn ⊢
    obtain ⟨hnl, h1, h2, h3⟩ := hn
    exact ⟨hnl, hcd.trans h1, h2, hM c hc d hd hcd _ h3⟩

open Classical in
/-- The catalog projection at a cell of the tree is the column-tree projection of its mask. -/
theorem catProj_eq_cellColumnProjection {hbr : ∀ c ∈ T, dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G root.1 root.2} {hroot : root ∈ T} {s : List (CatCol Tg)} {Mc : ℕ}
    {hb : ∀ d ∈ s, d.birth ∈ T} (r : ℕ) (M : ℤ × ℤ → Tg → Prop)
    (hM : ∀ c ∈ T, ∀ d ∈ T, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      ∀ x, M d x → M c x) {I : ℤ × ℤ} (hI : I ∈ T) :
    catProj G Mc s I r (M I) =
      cellColumnProjection (catTree G T root hbr hroot s Mc hb) (catMask r M hM) hI := by
  unfold catProj cellColumnProjection
  congr 1
  unfold catRange cellColumnRange
  congr 1
  ext x
  constructor
  · rintro ⟨n, hn, h1, h2, h3, rfl⟩
    have hmem : n ∈ (catMask (hb := hb) (hroot := hroot) (hbr := hbr) r M hM).labels I := by
      change n ∈ catLabels G Mc s I r (M I)
      simp only [catLabels, Finset.mem_filter, Finset.mem_univ, true_and]
      exact ⟨hn, h1, h2, h3⟩
    refine ⟨⟨n, hmem⟩, ?_⟩
    refine Lp.ext ?_
    have hadm := catAtom_admissible (G := G) s n I
    filter_upwards [cellColumnLp_coeFn _ _ hI ⟨n, hmem⟩, fitColumn_coeFn hadm n] with y h1 h2
    have e : catAtom s n = (s[(n : ℕ)]).atom := by
      unfold catAtom; rw [dite_eq_left_of_eq_true (eq_true hn)]
    rw [h1, ← e, h2]
    change (dyadicGridCell G I.1 I.2).indicator
      (privateColumnValue (fun m : Fin Mc => catAtom s m) (fun _ => 1) n) y = _
    congr 1
    funext y'
    exact fitColumnValue_eq_private (fun m : Fin Mc => catAtom s m) n y'
  · rintro ⟨⟨n, hmem⟩, rfl⟩
    have hmem' : n ∈ catLabels G Mc s I r (M I) := hmem
    simp only [catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hmem'
    obtain ⟨hn, h1, h2, h3⟩ := hmem'
    refine ⟨n, hn, h1, h2, h3, ?_⟩
    refine Lp.ext ?_
    have hadm := catAtom_admissible (G := G) s n I
    filter_upwards [cellColumnLp_coeFn _ _ hI ⟨n, hmem⟩, fitColumn_coeFn hadm n] with y h1 h2
    have e : catAtom s n = (s[(n : ℕ)]).atom := by
      unfold catAtom; rw [dite_eq_left_of_eq_true (eq_true hn)]
    rw [h1, ← e, h2]
    change _ = (dyadicGridCell G I.1 I.2).indicator
      (privateColumnValue (fun m : Fin Mc => catAtom s m) (fun _ => 1) n) y
    congr 1
    funext y'
    exact (fitColumnValue_eq_private (fun m : Fin Mc => catAtom s m) n y').symm

end CatalogTree

/-! ### The attempt masks grow in depth (blueprint lines 1748, 1807) -/

namespace ColorSetup

variable {V : Type*} [DecidableEq V] {K : ColorSetup V} {T : AdmTree V}

/-- Cumulative masks grow along descent (iterated `cumMask_par`). -/
theorem cumMask_anc {Nv m h : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) {I₀ I : T.Cell}
    (hA : T.Anc I₀ I) : K.cumMask T Nv m h I₀ ⊆ K.cumMask T Nv m h I := by
  obtain ⟨n, rfl⟩ := hA
  induction n generalizing I with
  | zero => exact subset_rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply']
    exact (cumMask_par hN _).trans ih

/-- Ball masks grow along descent: present lists grow, historical centers persist and the
graph distances decrease with depth. -/
theorem mask_anc {Nv : ℕ}
    {G : ℕ × (Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin K.d0 × V × ℤ))} {h : ℕ}
    {I₀ I : T.Cell} (hA : T.Anc I₀ I) : K.mask T Nv G h I₀ ⊆ K.mask T Nv G h I := by
  rintro b ⟨hb, I₁, h₁, v₀, hv₀, hg, ρ, z, g, m, l, n, ρ', a, g₂, hc, hl, ⟨k, hk, hkb⟩, h2, h3⟩
  have hle := T.anc_le hA
  have hdk : K.dist.d (T.depth I) z b ≤ k := hk ▸ K.dist.anti hle.1 z b
  obtain ⟨k', hk'⟩ : ∃ k' : ℕ, K.dist.d (T.depth I) z b = k' :=
    ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hdk)).symm⟩
  have hkk : k' ≤ k := by rw [hk'] at hdk; exact_mod_cast hdk
  refine ⟨hle.2.1 hb, I₁, T.anc_trans h₁ hA, v₀, hv₀, hg, ρ, z, g, m, l, n, ρ', a, g₂, hc, hl,
    ⟨k', hk', ?_⟩, h2, h3⟩
  have : (k' : ℤ) ≤ k := by exact_mod_cast hkk
  linarith

end ColorSetup

namespace ActiveSetup

variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

/-- Nested cells of the setup have admission cells in ancestor relation. -/
theorem admAt_anc {I J : ℤ × ℤ} (hI : I ∈ A.cells) (hJ : J ∈ A.cells)
    (h : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2) :
    A.admT.Anc (A.admAt J) (A.admAt I) := by
  rw [A.admAt_of_mem hI, A.admAt_of_mem hJ]
  exact admTree_anc A.occAvail h

namespace AttemptParams

variable {A} (ap : A.AttemptParams)

open Classical in
theorem cmask_mono {I J : ℤ × ℤ} (hI : I ∈ A.cells) (hJ : J ∈ A.cells)
    (h : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2) (m p : ℕ) (x : A.Vtx)
    (hx : ap.cmask J m p x) : ap.cmask I m p x :=
  ColorSetup.cumMask_anc A.admT_X_card_le (A.admAt_anc hI hJ h) hx

open Classical in
theorem bmask_mono {I J : ℤ × ℤ} (hI : I ∈ A.cells) (hJ : J ∈ A.cells)
    (h : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2) (G : A.Grp) (j p : ℕ)
    (x : A.Vtx) (hx : ap.bmask J G j p x) : ap.bmask I G j p x :=
  ColorSetup.mask_anc (A.admAt_anc hI hJ h) hx

end AttemptParams

