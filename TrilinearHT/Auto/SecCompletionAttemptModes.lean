  rw [columnL2_norm_sq_eq]
  have e1 : ∫ y, ‖((∑ G, ∑ q ∈ T G, ∑ n ∈ L G q, β' G q n •
      fitColumn (dyadicGridCell A.G (u' G q).1 (u' G q).2) (catAtom cat n) n :
        ColumnL2 (Fin ap.Mc)) : ℝ → ColumnHilbert (Fin ap.Mc)) y‖ ^ 2 =
