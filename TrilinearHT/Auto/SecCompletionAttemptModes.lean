theorem measurable_fourierChar_comp {f : ℝ → ℝ} (hf : Measurable f) :
    Measurable fun y => (Real.fourierChar (f y) : ℂ) :=
  (continuous_subtype_val.comp Real.continuous_fourierChar).measurable.comp hf

