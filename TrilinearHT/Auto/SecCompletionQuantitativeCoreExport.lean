/-- `attempt_label_sep` for a common chart tag `z = Ms.zc` (transport of the frequency
dimension). -/
theorem attempt_label_sep' (z : ChartTag) (hz : Ms.zc = z) (Nd : Finset (ℤ × (ℤ × ℤ) × Ms.Md))
    (hNd : ∀ c ∈ Nd, c.2.1.1 = c.1 - 2 * S.K) (Δ h : ℕ)
    (halive : ∀ c ∈ Nd, c.2.2 ∈ Ms.alive (ancAt Gd c.2.1 (c.1 - 4 * S.K)))
    (hdist : ∀ c (hc : c ∈ Nd) c' (hc' : c' ∈ Nd) (h1 : c.1 = c'.1) (h2 : c.2.1 = c'.2.1),
      c ≠ c' → (⟨c'.2.2, by rw [h1, h2]; exact halive c' hc'⟩ :
        Ms.alive (ancAt Gd c.2.1 (c.1 - 4 * S.K))) ∉
        (Ms.blockComps S hA c.1 c.2.1).F h ⟨c.2.2, halive c hc⟩)
    (rep : ℤ × (ℤ × ℤ) × Ms.Md → Ms.Md) (hrep : ∀ c, rep c ∈ Ms.predOfMode S hA Δ h c)
    (hsepF : ∀ c c', nodeLt3 (Gd := Gd) Ms Nd c c' → rep c ≠ rep c' →
      ∀ z z' : Ms.alive (ancAt Gd c'.2.1 (c'.1 - 4 * S.K)), z.1 ∈ Ms.predOfMode S hA Δ h c →
        z'.1 ∈ Ms.predOfMode S hA Δ h c' → z ∉ (Ms.blockComps S hA c'.1 c'.2.1).F h z')
    (hΛ : 8 * Ms.Λ ≤ S.Ξ) {xs : ℝ} (hxs : ∀ c ∈ Nd, xs ∈ dyadicGridCell Gd c.2.1.1 c.2.1.2)
    (L : ℤ → Finset ℝ)
    (hL : ∀ s, ∀ a ∈ L s, ∃ c ∈ Nd, a = Ms.slope (rep c) xs ∧ c.1 ≤ s ∧ s < c.1 + S.K)
    (cq : ℕ) {Q : ℝ} (hcQ : cq * Q ≤ S.Eh h) :
    ∀ s s' : ℤ, ∀ a ∈ L s, ∀ a' ∈ L s', a ≠ a' → ∀ N : Fin z.dim → ℤ,
      (∀ k, |(N k : ℝ)| ≤ Q) →
        S.Ξ / 2 * max (Gd.baseLength⁻¹ * 2 ^ s) (Gd.baseLength⁻¹ * 2 ^ s') <
          |a - a' + ∑ k, (N k : ℝ) * ((cq : ℝ) * (z.θ k / S.Q0 / ModeSchedule.Lh h))| := by
  subst hz
  exact Ms.attempt_label_sep S hA Nd hNd Δ h halive hdist rep hrep hsepF hΛ hxs L hL cq hcQ

