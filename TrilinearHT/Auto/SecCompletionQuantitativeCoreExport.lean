/-- Blueprint lines 2731-2737 (separation reserve on the attempt): labels of representatives at
the scales `s` (cells of depth `s` in the block of their node) satisfy the separation hypothesis
of the finite sparse-count lemma with `ζ = c θ/(Q₀ L_h)`, shifts `|N| ≤ Q` (`c Q ≤ E_h`),
`Σ = Ξ/2` and `R_s = 2^s / r₀`. -/
theorem attempt_label_sep (Nd : Finset (ℤ × (ℤ × ℤ) × Ms.Md))
    (hNd : ∀ c ∈ Nd, c.2.1.1 = c.1 - 2 * S.K) (Δ h : ℕ)
    (halive : ∀ c ∈ Nd, c.2.2 ∈ Ms.alive (ancAt Gd c.2.1 (c.1 - 4 * S.K)))
    (hdist : ∀ c (hc : c ∈ Nd) c' (hc' : c' ∈ Nd) (h1 : c.1 = c'.1) (h2 : c.2.1 = c'.2.1),
      c ≠ c' → (⟨c'.2.2, by rw [h1, h2]; exact halive c' hc'⟩ :
        Ms.alive (ancAt Gd c.2.1 (c.1 - 4 * S.K))) ∉
        (Ms.blockComps S hA c.1 c.2.1).F h ⟨c.2.2, halive c hc⟩)
    (rep : ℤ × (ℤ × ℤ) × Ms.Md → Ms.Md) (hrep : ∀ c, rep c ∈ Ms.predOfMode S hA Δ h c)
    (hsepF : ∀ c c', nodeLt3 (Gd := Gd) Ms Nd c c' → rep c ≠ rep c' →
      ∀ z z' : Ms.alive (ancAt Gd c'.2.1 (c'.1 - 4 * S.K)), z.1 ∈ Ms.predOfMode S hA Δ h c →
        z'.1 ∈ Ms.predOfMode S hA Δ h c' → z ∉ (Ms.blockComps S hA c'.1 c'.2.1).F h z')
    (hΛ : 8 * Ms.Λ ≤ S.Ξ) {xs : ℝ} (hxs : ∀ c ∈ Nd, xs ∈ dyadicGridCell Gd c.2.1.1 c.2.1.2)
    (L : ℤ → Finset ℝ)
    (hL : ∀ s, ∀ a ∈ L s, ∃ c ∈ Nd, a = Ms.slope (rep c) xs ∧ c.1 ≤ s ∧ s < c.1 + S.K)
    (cq : ℕ) {Q : ℝ} (hcQ : cq * Q ≤ S.Eh h) :
    ∀ s s' : ℤ, ∀ a ∈ L s, ∀ a' ∈ L s', a ≠ a' → ∀ N : Fin Ms.zc.dim → ℤ,
      (∀ k, |(N k : ℝ)| ≤ Q) →
        S.Ξ / 2 * max (Gd.baseLength⁻¹ * 2 ^ s) (Gd.baseLength⁻¹ * 2 ^ s') <
          |a - a' + ∑ k, (N k : ℝ) * ((cq : ℝ) * (Ms.zc.θ k / S.Q0 / ModeSchedule.Lh h))| := by
  intro s s' a ha a' ha' hne N hN
  obtain ⟨c, hc, rfl, hcs, hcs'⟩ := hL s a ha
  obtain ⟨c', hc', rfl, hcs2, hcs2'⟩ := hL s' a' ha'
  have hrne : rep c ≠ rep c' := fun h => hne (by rw [h])
  have hlen : ∀ t : ℤ, Gd.baseLength⁻¹ * 2 ^ t = (dyadicGridLength Gd t)⁻¹ := fun t => by
    unfold dyadicGridLength
    rw [mul_inv, zpow_neg, inv_inv]
  have hmono : ∀ t u : ℤ, t ≤ u → dyadicGridLength Gd u ≤ dyadicGridLength Gd t := fun t u htu => by
    unfold dyadicGridLength
    exact mul_le_mul_of_nonneg_left (zpow_le_zpow_right₀ (by norm_num) (by omega))
      Gd.baseLength_pos.le
  have hr1 : dyadicGridLength Gd (max c.1 c'.1 + S.K) ≤ dyadicGridLength Gd s :=
    hmono s _ (by omega)
  have hr2 : dyadicGridLength Gd (max c.1 c'.1 + S.K) ≤ dyadicGridLength Gd s' :=
    hmono s' _ (by omega)
  have hsep := fun (n : Fin Ms.zc.dim → ℤ) (hn : ∀ k, |(n k : ℝ)| ≤ S.Eh h) =>
    Ms.role_label_separation3 S hA Nd hNd Δ h halive hdist rep hrep hsepF hΛ hxs hc hc' hrne n hn
      hr1 hr2
  rw [hlen, hlen]
  refine sep_of_scaled (fun k => Ms.zc.θ k / S.Q0 / ModeSchedule.Lh h) cq hcQ
    (fun n hn => ?_) N hN
  have := hsep n hn
  convert this using 3
  rw [Finset.sum_div]
  refine Finset.sum_congr rfl fun k _ => by ring

end ModeSystem

/-- Blueprint lines 2733-2741 (the pure-shift annulus is excluded): if the pure shifts of the
nonexceptional primary are tiny (`≤ ε₀`) or huge (`≥ Λ₀`) and `ζ = κ ϑ` with
`κ ε₀ < μ R / 1000` and `4000 ν R < κ Λ₀`, then `|n·ζ| ∉ [μ R / 1000, 4000 ν R]`. -/
theorem pure_shift_gap {d : ℕ} (ϑ : Fin d → ℝ) {κ ε₀ Λ₀ μ ν R Q : ℝ} (hκ : 0 ≤ κ)
    (hgap : ∀ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
      |∑ k, (n k : ℝ) * ϑ k| ≤ ε₀ ∨ Λ₀ ≤ |∑ k, (n k : ℝ) * ϑ k|)
    (hsmall : κ * ε₀ < μ * R / 1000) (hlarge : 1000 * (4 * ν) * R < κ * Λ₀)
    (n : Fin d → ℤ) (hn : ∀ k, |(n k : ℝ)| ≤ Q) :
    |∑ k, (n k : ℝ) * (κ * ϑ k)| ∉ Set.Icc (μ * R / 1000) (1000 * (4 * ν) * R) := by
  have e : ∑ k, (n k : ℝ) * (κ * ϑ k) = κ * ∑ k, (n k : ℝ) * ϑ k := by
    rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun k _ => by ring
  rw [e, abs_mul, abs_of_nonneg hκ]
  rintro ⟨h1, h2⟩
  rcases hgap n hn with h | h
  · have : κ * |∑ k, (n k : ℝ) * ϑ k| ≤ κ * ε₀ := mul_le_mul_of_nonneg_left h hκ
    linarith
  · have : κ * Λ₀ ≤ κ * |∑ k, (n k : ℝ) * ϑ k| := mul_le_mul_of_nonneg_left h hκ
    linarith

