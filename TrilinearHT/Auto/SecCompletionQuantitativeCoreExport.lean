  obtain ⟨cc, cm, hcc, hcm, hsup, hb⟩ := four_core_principal hr hw z hd hδ hδ'' ρ hρ hQ0 hQ hCm0
    hCm hL Kt hxs γ F c n f hfi hη hfa hfb V p₀ J hnear hfar hA₀ hB₀ hHU hW hRb
  have hτ := cutTail_nonneg z.dim hδ Kt
