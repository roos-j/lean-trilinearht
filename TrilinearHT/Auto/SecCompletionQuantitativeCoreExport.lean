variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

open Classical in
/-- Blueprint lines 2463-2470 (the core subtotals as physical functions): the physical function of
the subtotal of a core component `K` on a cell `I` inside its pre-cell `J` is a.e.
`1_I Σ_{m ∈ K} c_m wave_m`. -/
theorem augPhys_compSub (l : Fin 4) (G : A.Grp) {I J : ℤ × ℤ}
    (hIJ : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2) (K : Finset (D.Ms l G).Md) :
    augPhys (D.compSub l G I J K) =ᵐ[volume] (dyadicGridCell A.G I.1 I.2).indicator
      (fun y => ∑ m ∈ K, D.c l G (D.blockOf I.1) J m * (D.Ms l G).wave m y) := by
  set X : ColumnL2 (D.Ms l G).Md :=
    ∑ m ∈ K, D.c l G (D.blockOf I.1) J m • (D.Ms l G).cellMode J m
  set z := columnL2Restriction (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2) (physEmbed (D.Ms l G).Md (Fin ap.Mc) X)
  have h1 := physEmbed_coeFn_none (W := Fin ap.Mc) z
  have h2 := columnL2Indicator_coeFn (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2) (physEmbed (D.Ms l G).Md (Fin ap.Mc) X)
  have h3 := physEmbed_coeFn_none (W := Fin ap.Mc) X
  have h4 := (D.Ms l G).cellMode_sum_none J K (D.c l G (D.blockOf I.1) J)
  filter_upwards [h1, h2, h3, h4] with y e1 e2 e3 e4
  unfold augPhys compSub
  rw [e1]
  change (columnL2Indicator (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
    (physEmbed (D.Ms l G).Md (Fin ap.Mc) X) : ℝ → ColumnHilbert (Fin ap.Mc)) y none = _
  rw [e2]
  by_cases hy : y ∈ dyadicGridCell A.G I.1 I.2
  · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy, e3]
    exact e4 (hIJ hy)
  · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]
    rfl

