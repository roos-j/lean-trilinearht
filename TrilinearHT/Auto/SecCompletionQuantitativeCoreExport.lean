  have hEg0 : 0 ≤ 8 * z.dim * δ'' * profR δ 1 + 4 * (1 + cutTail z.dim δ Kt) ^ 3 *
      cutTail z.dim δ Kt + (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt := by
    have := profR_nonneg hδ 1
    have := cutTail_nonneg z.dim hδ Kt
    have : 0 ≤ multTail z.dim δ'' Q0 Cm Kt := by
      unfold multTail; have := profR_nonneg hδ'' (z.dim + z.dim + 1); positivity
    positivity
  have hGl : ∀ u, ‖coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc l u‖ ≤
      (frequencyBox z.dim (2 ^ (Kt + 1))).card := by
    intro u
    unfold coreG
    rw [hFl]
    refine (norm_sum_le _ _).trans ((Finset.sum_le_sum fun p hp => ?_).trans (le_of_eq
      (show ∑ _p ∈ frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ ({k₀} : Finset (ι l)), (1 : ℝ) = _ by
        simp)))
    obtain ⟨-, hp2⟩ := Finset.mem_product.mp hp
    rw [Finset.mem_singleton.mp hp2, hcl, norm_mul, norm_mul, norm_torusCharacter, norm_one,
