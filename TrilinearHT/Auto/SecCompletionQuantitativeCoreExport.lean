        expP2 L (Q0 * L) n x - p₀.2 ∈ rationalIntegerIntersection V)
    (fun x => ∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L)))
    (fun x => ∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
      (z.θ i / (Q0 * L))) J hnear hfar hA₀ hB₀ hHU
  exact four_core_cell_bound hr hw f hfi V (fun i => z.θ i / (Q0 * L)) xs γ
    (frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1))) cm
    (fun q => ((L : ℤ) • fun a => q (Fin.castAdd z.dim a),
