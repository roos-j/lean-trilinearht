    (hfar : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
        (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
      expP2 L (Q0 * L) n x - ((l : ℕ) : ℤ) • expP1 L (Q0 * L) n x - m₀ ∉
        rationalIntegerIntersection V →
      H ≤ |r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
            (z.θ i / (Q0 * L))) - ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i,
              (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L))))|)
    {J : ℕ} (hJ : 2 ≤ J) (A I : ℕ) :
    ∃ cc : Fin 4 → (Fin z.dim → ℤ) → ℂ, ∃ cm : (Fin (z.dim + z.dim) → ℤ) → ℂ,
      (∀ j v, ‖cc j v‖ ≤ 1) ∧ (∀ v, ‖cm v‖ ≤ 1) ∧
      (∀ j u, ‖∑ v ∈ frequencyBox z.dim (2 ^ (Kt + 1)), cc j v *
        torusCharacter (((Q0 * L : ℕ) : ℤ) • v) u‖ ≤ 1 + cutTail z.dim δ Kt) ∧
    ‖localProgressionForm r w
        (Function.update f l (fun y => (centerCut z δ (ρ l) y : ℂ) * f l y))‖ ≤
      2 * localKernelSupBound κ * ((4 * η + (8 * z.dim * δ'' * profR δ 1 +
          4 * (1 + cutTail z.dim δ Kt) ^ 3 * cutTail z.dim δ Kt +
          (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt)) *
        ∏ j, ∑ k ∈ F j, ‖c j k‖) *
        (r⁻¹ * ∫ y in Set.Icc a₀ (a₀ + r), ‖sideSd z (ρ l) l (f l) y‖) +
      ((r⁻¹ * entryC κ J A (r * β₀) * 2 ^ (A + 4) * ∑ i ∈ Finset.range (I + 1),
