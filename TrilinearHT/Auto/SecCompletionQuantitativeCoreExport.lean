      (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j) (fun j p => cc j p.1 * c j p.2)
      (fun j p => (((Q0 * L : ℕ) : ℤ) • p.1 + n j p.2)) zz
    have hF : Fc zz = ∏ j, Function.update f l
        (fun y => (ζ y : ℂ) * (Real.fourierChar (ph y) : ℂ)) j (zz.1 + ((j : ℕ) : ℝ) * zz.2) := by
      rw [← Finset.prod_erase_mul Finset.univ _ (Finset.mem_univ l), Function.update_self,
