      (expP1 L (Q0 * L) n x - p₀.1 ∈ rationalIntegerIntersection V ∧
        expP2 L (Q0 * L) n x - p₀.2 ∈ rationalIntegerIntersection V) →
      r * |(∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L))) -
