open Classical in
/-- Blueprint lines 2482-2486 ("for every character difference needed below"): the differences
`P - p₀` of the expansion frequencies and a reference with entries at most `Bp` have height at
most any integer `Hh ≥ 1` dominating `L B + 12 (QL B + N_b) + Bp`. -/
theorem expP_diff_height_le {d : ℕ} (L QL Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (n : ∀ j, ι j → Fin d → ℤ) {Nb : ℝ} (hNb0 : 0 ≤ Nb)
    (hn : ∀ j, ∀ k ∈ F j, ∀ i, |(n j k i : ℝ)| ≤ Nb)
    (p₀ : (Fin d → ℤ) × (Fin d → ℤ)) {Bp : ℝ} (hp1 : ∀ i, |(p₀.1 i : ℝ)| ≤ Bp)
    (hp2 : ∀ i, |(p₀.2 i : ℝ)| ≤ Bp) {Hh : ℕ} (hH : 1 ≤ Hh)
    (hHb : L * Bx + 12 * (QL * Bx + Nb) + Bp ≤ Hh)
    (x : (Fin (d + d) → ℤ) × ∀ j, (Fin d → ℤ) × ι j)
    (hx : x ∈ frequencyBox (d + d) Bx ×ˢ Fintype.piFinset (fun j => frequencyBox d Bx ×ˢ F j)) :
    vecHeight (fun i => ((expP1 L QL n x - p₀.1) i : ℚ)) ≤ Hh ∧
      vecHeight (fun i => ((expP2 L QL n x - p₀.2) i : ℚ)) ≤ Hh := by
  have he := expP_entries_le L QL Bx F n hn x hx
  have hNb : 0 ≤ (QL * Bx + Nb : ℝ) := by positivity
  constructor
  · refine vecHeight_int_le _ hH fun i => ?_
    have := (he i).1
    simp only [Pi.sub_apply, Int.cast_sub]
    refine (abs_sub _ _).trans ?_
    linarith [hp1 i]
  · refine vecHeight_int_le _ hH fun i => ?_
    have := (he i).2
    simp only [Pi.sub_apply, Int.cast_sub]
    refine (abs_sub _ _).trans ?_
    linarith [hp2 i]

open Classical in
/-- Blueprint lines 2482-2486 and 2519-2524 for the four-core expansion: from the gap `eq:gap` of
`ϑ` at height `Hh`, every expansion term `x` is near the reference `p₀` modulo the tiny span
`K_B ∩ ℤ^d` (`r|ΔA|, r|ΔB| ≤ r ε/(Q₀L)`) or far from it (`r|ΔA|` or `r|ΔB| ≥ r Λ/(Q₀L)`); these are
the `hnear`/`hfar` inputs of `four_core_principal` and `four_core_uniform`. -/
theorem four_coset_of_gap {d : ℕ} (ϑ : Fin d → ℝ) {Hh : ℕ} (hH : 1 ≤ Hh) {ε Λ : ℝ} (hε : 0 ≤ ε)
    (hgap : ∀ a : Fin d → ℚ, vecHeight a ≤ Hh → |ratEval ϑ a| ≤ ε ∨ Λ ≤ |ratEval ϑ a|)
    (hsmall : (3 * Hh ^ 2 : ℝ) ^ d * (d.factorial * Hh ^ (d ^ 2 + d)) * ε < Λ)
    {r : ℝ} (hr : 0 < r) {Q0 L : ℕ} (hQL : (0 : ℝ) < Q0 * L) (Bx : ℕ) (γ : Fin 4 → ℝ)
    {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j)) (n : ∀ j, ι j → Fin d → ℤ) {Nb : ℝ}
    (hNb0 : 0 ≤ Nb) (hn : ∀ j, ∀ k ∈ F j, ∀ i, |(n j k i : ℝ)| ≤ Nb)
    (p₀ : (Fin d → ℤ) × (Fin d → ℤ)) {Bp : ℝ} (hp1 : ∀ i, |(p₀.1 i : ℝ)| ≤ Bp)
    (hp2 : ∀ i, |(p₀.2 i : ℝ)| ≤ Bp)
    (hHb : L * Bx + 12 * ((Q0 * L : ℕ) * Bx + Nb) + Bp ≤ Hh) :
    ∀ x ∈ frequencyBox (d + d) Bx ×ˢ Fintype.piFinset (fun j => frequencyBox d Bx ×ˢ F j),
      ((expP1 L (Q0 * L) n x - p₀.1 ∈ rationalIntegerIntersection (tinySpan ϑ Hh ε) ∧
          expP2 L (Q0 * L) n x - p₀.2 ∈ rationalIntegerIntersection (tinySpan ϑ Hh ε)) →
        r * |(∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L))) -
            (∑ j, γ j + ∑ i, (p₀.1 i : ℝ) * (ϑ i / (Q0 * L)))| ≤ r * ε / (Q0 * L) ∧
          r * |(∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
              (ϑ i / (Q0 * L))) -
            (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (ϑ i / (Q0 * L)))| ≤
            r * ε / (Q0 * L)) ∧
      (¬ (expP1 L (Q0 * L) n x - p₀.1 ∈ rationalIntegerIntersection (tinySpan ϑ Hh ε) ∧
          expP2 L (Q0 * L) n x - p₀.2 ∈ rationalIntegerIntersection (tinySpan ϑ Hh ε)) →
        r * Λ / (Q0 * L) ≤ r * |(∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) *
            (ϑ i / (Q0 * L))) - (∑ j, γ j + ∑ i, (p₀.1 i : ℝ) * (ϑ i / (Q0 * L)))| ∨
          r * Λ / (Q0 * L) ≤ r * |(∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j +
              ∑ i, (expP2 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L))) -
            (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (ϑ i / (Q0 * L)))|) := by
  intro x hx
  obtain ⟨h1, h2⟩ := expP_diff_height_le L (Q0 * L) Bx F n hNb0 hn p₀ hp1 hp2 hH hHb x hx
  exact coset_hyps_of_gap ϑ hH hε hgap hsmall hr hQL _ _ _ _ _ _ h1 h2

/-- Blueprint lines 2487-2495 (the gap structure inside one role for `eq:torus-size`): if the
role frequencies `n_k` have pairwise differences of height at most `Hh`, the gap `eq:gap` of `ϑ`
gives the tiny/huge alternatives of `torus_size_phys` with `ξ = ϑ/(Q₀L)`, tiny threshold
`ε' = 2π r ε/(Q₀L)` and huge threshold `2/ε' ≤ 2π r Λ/(Q₀L)`. -/
theorem role_tiny_huge_of_gap {d : ℕ} (ϑ : Fin d → ℝ) {Hh : ℕ} (hH : 1 ≤ Hh) {ε Λ : ℝ}
    (hε : 0 ≤ ε)
    (hgap : ∀ a : Fin d → ℚ, vecHeight a ≤ Hh → |ratEval ϑ a| ≤ ε ∨ Λ ≤ |ratEval ϑ a|)
    (hsmall : (3 * Hh ^ 2 : ℝ) ^ d * (d.factorial * Hh ^ (d ^ 2 + d)) * ε < Λ)
    {r QL : ℝ} (hr : 0 < r) (hQL : 0 < QL) {ι : Type*} (F : Finset ι) (n : ι → Fin d → ℤ)
    (hh : ∀ k ∈ F, ∀ k' ∈ F, vecHeight (fun i => ((n k - n k') i : ℚ)) ≤ Hh)
    (hεΛ : 2 / (2 * Real.pi * r * ε / QL) ≤ 2 * Real.pi * r * Λ / QL) :
    (∀ k ∈ F, ∀ k' ∈ F, n k - n k' ∈ rationalIntegerIntersection (tinySpan ϑ Hh ε) →
      |2 * Real.pi * r * ∑ i, (n k i : ℝ) * (ϑ i / QL) -
        2 * Real.pi * r * ∑ i, (n k' i : ℝ) * (ϑ i / QL)| ≤ 2 * Real.pi * r * ε / QL) ∧
    (∀ k ∈ F, ∀ k' ∈ F, n k - n k' ∉ rationalIntegerIntersection (tinySpan ϑ Hh ε) →
      2 / (2 * Real.pi * r * ε / QL) ≤ |2 * Real.pi * r * ∑ i, (n k i : ℝ) * (ϑ i / QL) -
        2 * Real.pi * r * ∑ i, (n k' i : ℝ) * (ϑ i / QL)|) := by
  have e : ∀ k k', 2 * Real.pi * r * ∑ i, (n k i : ℝ) * (ϑ i / QL) -
      2 * Real.pi * r * ∑ i, (n k' i : ℝ) * (ϑ i / QL) =
      2 * Real.pi * r * (∑ i, ((n k - n k') i : ℝ) * ϑ i) / QL := fun k k' => by
    rw [← mul_sub, ← Finset.sum_sub_distrib, mul_div_assoc, Finset.sum_div]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [Pi.sub_apply, Int.cast_sub]
    ring
  have hpr : 0 < 2 * Real.pi * r := by positivity
  refine ⟨fun k hk k' hk' hm => ?_, fun k hk k' hk' hm => ?_⟩
  · have g := (gap_coset ϑ hH hε hgap hsmall (n k - n k') (hh k hk k' hk')).1 hm
    rw [e, abs_div, abs_mul, abs_of_pos hpr, abs_of_pos hQL]
    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left g hpr.le) hQL.le
  · have g := (gap_coset ϑ hH hε hgap hsmall (n k - n k') (hh k hk k' hk')).2 hm
    rw [e, abs_div, abs_mul, abs_of_pos hpr, abs_of_pos hQL]
    exact hεΛ.trans (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left g hpr.le) hQL.le)

