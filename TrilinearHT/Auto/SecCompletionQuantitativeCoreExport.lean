          ((W * (frequencyBox z.dim (2 ^ (Kt + 1))).card *
            ∏ i ∈ Finset.univ.erase l, (eLpNorm (fun u : torusAnnihilator
              (rationalIntegerIntersection V) => coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc i u) 2
            (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) *
            Real.sqrt (∑ k ∈ (windowSet N (fun n => r * αN n) I).filter
