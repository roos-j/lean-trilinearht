            (z.θ i / (Q0 * L))) - ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i,
              (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L)))) * zz.2) : ℂ)‖ ≤
      (4 * η + (8 * z.dim * δ'' * profR δ 1 +
          4 * (1 + cutTail z.dim δ Kt) ^ 3 * cutTail z.dim δ Kt +
          (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt)) *
        ∏ j, ∑ k ∈ F j, ‖c j k‖ := by
    intro zz hzz
    have hin : ∀ j : Fin 4, zz.1 + ((j : ℕ) : ℝ) * zz.2 ∈ Set.Icc a₀ (a₀ + r) := fun j => by
      have hs := hw.support zz hzz j
      simp only [realProgressionCoordinate] at hs
      have hm := mul_nonneg κ.margin_pos.le hr.le
      exact ⟨by linarith [hs.1], by linarith [hs.2]⟩
    have h := hprod zz.1 zz.2 hin
    have hre := reanchor_physical l (fun i => z.θ i / (Q0 * L)) xs γ
      (frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1))) cm
      (fun q => ((L : ℤ) • fun a => q (Fin.castAdd z.dim a),
