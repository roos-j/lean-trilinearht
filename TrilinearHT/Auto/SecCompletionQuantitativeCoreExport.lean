    (m₀ : Fin z.dim → ℤ) (N : Finset (Fin z.dim → ℤ))
    (hN : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection V)
    (αN : (Fin z.dim → ℤ) → ℝ) (β₀ : ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |-(r * αN n) - -(r * αN n')|)
    (nref : ((Fin (z.dim + z.dim) → ℤ) × ∀ j, (Fin z.dim → ℤ) × ι j) → Fin z.dim → ℤ)
    {ε₁ H : ℝ} (hε₁ : 0 ≤ ε₁) (hH : 4 ≤ H)
    (hnear : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
