variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

open Classical in
/-- `group_torus_char` over a common chart tag `z = Ms.zc`: the selected wave sum is the gauge of
`z` with transported offsets `ρ'` times the representative phase times
`Σ_m α_m e(φ_m(x*)) χ_{n_m}(ξ (y - x*))`, `ξ = θ_z/(Q₀ 6^h)`, up to the torus-form error. -/
theorem group_torus_char' (z : ChartTag) (hz : Ms.zc = z) {b : ℤ} {J : ℤ × ℤ}
    (hJ : J.1 ≤ b + S.K) {h : ℕ} (a : Ms.alive (ancAt Gd J (b - 4 * S.K)))
    (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K))))
    (hF : F ⊆ (Ms.blockComps S hA b J).E h a) (α : Ms.alive (ancAt Gd J (b - 4 * S.K)) → ℂ)
    {Λ : ℝ} (hΛ : ∀ m ∈ F, |Ms.lamOf m.1| ≤ Λ) :
    ∃ ρ' : Fin z.dim → ℝ, (∀ i, ∃ k, ρ' i = Ms.ρ k) ∧
      (∀ y, Ms.gauge y = (centerCut z Ms.δc ρ' y : ℂ) *
        (Real.fourierChar ((Ms.cl : ℝ) * centerPhase z ρ' y) : ℂ)) ∧
      ∃ n : Ms.alive (ancAt Gd J (b - 4 * S.K)) → Fin z.dim → ℤ,
      (∀ m ∈ F, ∀ i, |(n m i : ℝ)| ≤
        Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) * S.Eh h) ∧
      ∀ x ∈ Set.Icc (dyadicGridLeft Gd J.1 J.2)
          (dyadicGridLeft Gd J.1 J.2 + dyadicGridLength Gd J.1), ∀ y : ℝ,
        ‖∑ m ∈ F, α m * Ms.wave m.1 y -
          ((centerCut z Ms.δc ρ' y : ℂ) * (Real.fourierChar ((Ms.cl : ℝ) *
            centerPhase z ρ' y) : ℂ)) * ((Real.fourierChar (Ms.slope a.1 x * (y - x)) : ℂ) *
            ∑ m ∈ F, α m * (Real.fourierChar (Ms.phase m.1 x) : ℂ) *
              torusCharacter (n m) (torusMk fun i => z.θ i / (S.Q0 * 6 ^ h) * (y - x)))‖ ≤
          2 * Real.pi * (Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) *
            (S.Ξ / dyadicGridLength Gd J.1) * |y - x| + Λ * (y - x) ^ 2) * ∑ m ∈ F, ‖α m‖ := by
  obtain ⟨ρ', e, hρ', hθ, hgauge⟩ := Ms.chart_transport z hz
  obtain ⟨n, hn, hform⟩ := Ms.group_torus_char S hA hJ a F hF α hΛ
  refine ⟨ρ', fun i => ⟨e.symm i, by rw [← hρ' (e.symm i), Equiv.apply_symm_apply]⟩, hgauge,
    fun m i => n m (e.symm i), fun m hm i => hn m hm (e.symm i),
    fun x hx y => ?_⟩
  have hf := hform x hx y
  rw [hgauge] at hf
  have hsum : ∑ m ∈ F, α m * (Real.fourierChar (Ms.phase m.1 x) : ℂ) *
      torusCharacter (fun i => n m (e.symm i)) (torusMk fun i => z.θ i / (S.Q0 * 6 ^ h) * (y - x)) =
      ∑ m ∈ F, α m * (Real.fourierChar (Ms.phase m.1 x) : ℂ) *
      torusCharacter (n m) (torusMk fun i => Ms.zc.θ i / (S.Q0 * 6 ^ h) * (y - x)) := by
    refine Finset.sum_congr rfl fun m _ => ?_
    rw [torusCharacter_mk_line, torusCharacter_mk_line]
    congr 4
    rw [← e.symm.sum_comp]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [← hθ (e.symm i), Equiv.apply_symm_apply]
  rw [hsum]
  exact hf

end ModeSystem

