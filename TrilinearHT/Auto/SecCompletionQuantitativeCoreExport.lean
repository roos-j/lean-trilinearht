variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

open Classical in
/-- Blueprint lines 2463-2469 on a leaf cell and group: the component expansion of a pattern form
is the convergent sum over the trial counts `n`, the assignments `a` of the failed trials to first
failing slots, the words `w` of failed heights and the final upper heights `h`, with weight
`|H|^{-(n+1)}`, of the sums over the tuples of components in the product masks. -/
theorem group_first_success (I : ℤ × ℤ) (G : A.Grp) (Zout ZU : Fin 4 → A.Grp → ColumnL2 (Fin ap.Mc))
    (σ : Fin 4 → Fin 3) (Jp : Fin 4 → A.Grp → ℤ × ℤ) (hJ : 2 ≤ D.SP.Jst) (hδ : 0 < D.SP.δs)
    (hδ16 : D.SP.δs ≤ 1 / 16) :
    HasSum (fun n : ℕ => ∑ a : Fin n → Fin 4,
      ∑ w ∈ Fintype.piFinset (fun _ : Fin n => ModeComponents.upperHeights D.SP.Jst D.SP.δs),
      ∑ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs,
        (((ModeComponents.upperHeights D.SP.Jst D.SP.δs).card : ℝ) ^ (n + 1))⁻¹ •
        ∑ r ∈ (Fintype.piFinset (compIdx σ
            (fun l => (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (Jp l G)))).filter
          (fun r => ∀ l, roleMask (D.slotGood G (D.blockOf I.1) Jp l) l a w h (r l)),
          ap.Λc I (compSlot σ (fun l K => D.compSub l G I (Jp l G) K)
            (fun l => π (D.side l G I (Zout l G) (ZU l G)))
            (fun l => π (D.err l G I (ZU l G))) r))
      (∑ r ∈ Fintype.piFinset (compIdx σ
          (fun l => (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (Jp l G))),
        ap.Λc I (compSlot σ (fun l K => D.compSub l G I (Jp l G) K)
          (fun l => π (D.side l G I (Zout l G) (ZU l G)))
          (fun l => π (D.err l G I (ZU l G))) r)) :=
  first_success_masked _ _ (fun l h o => D.slotGood G (D.blockOf I.1) Jp l h o) _
    (D.tuple_success G (D.blockOf I.1) Jp σ hJ hδ hδ16)

end LeafSplit

