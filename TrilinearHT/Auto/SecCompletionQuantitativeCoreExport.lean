      r * |(∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
          (z.θ i / (Q0 * L))) -
        (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (z.θ i / (Q0 * L)))| ≤ ε₁)
    (hfar : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
        (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
      ¬ (expP1 L (Q0 * L) n x - p₀.1 ∈ rationalIntegerIntersection V ∧
        expP2 L (Q0 * L) n x - p₀.2 ∈ rationalIntegerIntersection V) →
      H ≤ r * |(∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L))) -
        (∑ j, γ j + ∑ i, (p₀.1 i : ℝ) * (z.θ i / (Q0 * L)))| ∨
      H ≤ r * |(∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
          (z.θ i / (Q0 * L))) -
        (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (z.θ i / (Q0 * L)))|)
    (hA₀ : r * |∑ j, γ j + ∑ i, (p₀.1 i : ℝ) * (z.θ i / (Q0 * L))| ≤ U)
    (hB₀ : r * |∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (z.θ i / (Q0 * L))| ≤ U)
    (hHU : 1 ≤ H - U) {W : ℝ} (hW : 0 ≤ W)
    (hRb : ∀ (cm : (Fin (z.dim + z.dim) → ℤ) → ℂ), (∀ v, ‖cm v‖ ≤ 1) →
      ∀ u v : StandardTorus z.dim,
      ‖∑ q ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)), cm q *
        (torusCharacter ((L : ℤ) • fun a => q (Fin.castAdd z.dim a)) u *
          torusCharacter ((L : ℤ) • fun a => q (Fin.natAdd z.dim a)) v)‖ ≤ W) :
    ∃ cc : Fin 4 → (Fin z.dim → ℤ) → ℂ, ∃ cm : (Fin (z.dim + z.dim) → ℤ) → ℂ,
    (∀ j v, ‖cc j v‖ ≤ 1) ∧ (∀ v, ‖cm v‖ ≤ 1) ∧
    (∀ j u, ‖∑ v ∈ frequencyBox z.dim (2 ^ (Kt + 1)), cc j v *
      torusCharacter (((Q0 * L : ℕ) : ℤ) • v) u‖ ≤ 1 + cutTail z.dim δ Kt) ∧
    ‖localProgressionForm r w f‖ ≤
      2 * localKernelSupBound κ * ((4 * η + (8 * z.dim * δ'' * profR δ 1 +
          4 * (1 + cutTail z.dim δ Kt) ^ 3 * cutTail z.dim δ Kt +
          (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt)) *
        ∏ j, ∑ k ∈ F j, ‖c j k‖) +
      (‖fourK a₀ r w xs (∑ j, γ j + ∑ i, (p₀.1 i : ℝ) * (z.θ i / (Q0 * L)))
          (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (z.θ i / (Q0 * L)))‖ *
        (W * ∏ j : Fin 4, (eLpNorm (fun u : torusAnnihilator
          (rationalIntegerIntersection V) => ∑ p ∈ frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j,
            (cc j p.1 * c j p.2) * torusCharacter (((Q0 * L : ℕ) : ℤ) • p.1 + n j p.2) u) 2
          (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) +
        max ((Real.pi * kerC κ 0 + 2 * (2 * 4 * (2 * 4 * (2 * Real.pi * 4 *
            kernelDerivBound κ 0)))) * ε₁) (kerC κ J * ((H - U) ^ J)⁻¹) *
          ∑ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
            (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
