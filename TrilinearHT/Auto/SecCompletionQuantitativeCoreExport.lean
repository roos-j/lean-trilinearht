              (fun i u => coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc i u) m₀ u *
              starRingEnd ℂ (torusCharacter m u)
            ∂torusAnnihilatorHaar (rationalIntegerIntersection V)‖) *
            ∑ k ∈ windowSet N (fun n => r * αN n) I, ‖∫ y in Set.Ico a₀ (a₀ + r),
              sideSd z (ρ l) l (f l) y * Complex.exp (2 * Real.pi * Complex.I * k * y / r)‖)) +
      12 * (r⁻¹ * entryC κ J A (r * β₀) * ((2 : ℝ) ^ I)⁻¹ ^ A) *
        (∫ y in Set.Ico a₀ (a₀ + r), ‖sideSd z (ρ l) l (f l) y‖) *
          ∑ m ∈ N, ‖∫ u, dualSlice V (coreRA V L (Q0 * L) (2 ^ (Kt + 1)) F c n cc cm l) l
              (fun i u => coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc i u) m₀ u *
              starRingEnd ℂ (torusCharacter m u)
            ∂torusAnnihilatorHaar (rationalIntegerIntersection V)‖) +
      (∑ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
          (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
          ‖cm x.1 * ∏ j, (cc j (x.2 j).1 * c j (x.2 j).2)‖) *
        (r⁻¹ * (∫ y in Set.Ico a₀ (a₀ + r), ‖sideSd z (ρ l) l (f l) y‖) *
          (nearB κ ε₁ + 12 * (kerC κ J * (4 / H) ^ (J - 2)))) := by
  set ζ := centerCut z δ (ρ l) with hζ
  set ph : ℝ → ℝ := fun y => ((slotCoeff l : ℤ) : ℝ) * centerPhase z (ρ l) y with hph
  obtain ⟨cc, cm, hcc, hcm, hsup, hprod⟩ := three_core_Fc_approx z hd hδ hδ'' ρ hρ hQ0 hQ hCm0 hCm
    hL Kt xs l γ hγl F c n hFl hcl hnl
    (Function.update f l (fun y => (ζ y : ℂ) * (Real.fourierChar (ph y) : ℂ)))
    (fun y => by rw [Function.update_self]) a₀ (a₀ + r) hη
    (fun j hj y hy => by rw [Function.update_of_ne hj]; exact hfa j hj y hy)
    (fun j hj y hy => by rw [Function.update_of_ne hj]; exact hfb j hj y hy)
  refine ⟨cc, cm, hcc, hcm, hsup, ?_⟩
  set Fc : ℝ × ℝ → ℂ := fun zz =>
    (∏ j ∈ Finset.univ.erase l, f j (realProgressionCoordinate j zz)) *
      ((ζ (realProgressionCoordinate l zz) : ℂ) *
        (Real.fourierChar (ph (realProgressionCoordinate l zz)) : ℂ)) with hFc
  have hcan : ∀ y, (Real.fourierChar (ph y) : ℂ) * (Real.fourierChar (-ph y) : ℂ) = 1 := by
    intro y
    rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul, add_neg_cancel, AddChar.map_zero_eq_one,
      Circle.coe_one]
  have hpt : ∀ zz, w zz * ∏ j, Function.update f l (fun y => (ζ y : ℂ) * f l y) j
