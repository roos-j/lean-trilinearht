section MaskedSuccess

variable {m₀ : ℕ}

open Classical in
/-- The role mask of a component at a final height `h` after the failed trials `w` with the
assignment `a` of trials to first failing roles: good at `h`, bad at its own assigned trials and
good at the trials assigned to later roles. -/
def roleMask {κ : Type*} (good : ℕ → κ → Prop) (j : Fin m₀) {n : ℕ} (a : Fin n → Fin m₀)
    (w : Fin n → ℕ) (h : ℕ) (K : κ) : Prop :=
  good h K ∧ (∀ i, a i = j → ¬ good (w i) K) ∧ (∀ i, j < a i → good (w i) K)

open Classical in
/-- Blueprint lines 2466-2469 (first success, counted): for a tuple of components, the number of
triples `(a, w, h)` of an assignment of `n` failed trials to first failing roles, a word of `n`
heights and a final height, with every role in its mask, is `|S| |H \ S|^n`, `S` the heights at
which all roles are good. -/
theorem masked_count {κ : Fin m₀ → Type*} (H : Finset ℕ) (good : ∀ j, ℕ → κ j → Prop)
    (r : ∀ j, κ j) (n : ℕ) :
    ∑ a : Fin n → Fin m₀, ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
      (if ∀ j, roleMask (good j) j a w h (r j) then (1 : ℝ) else 0) =
      (H.filter fun h => ∀ j, good j h (r j)).card *
        ((H.filter fun h => ¬ ∀ j, good j h (r j)).card : ℝ) ^ n := by
  set bad : Fin m₀ → Finset ℕ := fun j => H.filter fun h => ¬ good j h (r j) with hbad
  -- the condition splits into the final height and the failed trials
  have hsplit : ∀ (a : Fin n → Fin m₀) (w : Fin n → ℕ) (h : ℕ),
      (∀ j, roleMask (good j) j a w h (r j)) ↔ (∀ j, good j h (r j)) ∧
        ∀ i, ¬ good (a i) (w i) (r (a i)) ∧ ∀ j < a i, good j (w i) (r j) := by
    intro a w h
    unfold roleMask
    constructor
    · intro hm
      exact ⟨fun j => (hm j).1, fun i => ⟨(hm (a i)).2.1 i rfl, fun j hj => (hm j).2.2 i hj⟩⟩
    · rintro ⟨hg, hw⟩ j
      exact ⟨hg j, fun i hi => hi ▸ (hw i).1, fun i hi => (hw i).2 j hi⟩
  have hfail : ∀ (a : Fin n → Fin m₀) (w : Fin n → ℕ), w ∈ Fintype.piFinset (fun _ => H) →
      ((∀ i, ¬ good (a i) (w i) (r (a i)) ∧ ∀ j < a i, good j (w i) (r j)) ↔
        w ∈ Fintype.piFinset fun i => failMask H bad (a i)) := by
    intro a w hw
    simp only [Fintype.mem_piFinset] at hw ⊢
    simp only [failMask, hbad, Finset.mem_filter]
    constructor
    · intro h i
      exact ⟨hw i, ⟨hw i, (h i).1⟩, fun j hj hb => hb.2 ((h i).2 j hj)⟩
    · intro h i
      refine ⟨(h i).2.1.2, fun j hj => ?_⟩
      by_contra hng
      exact (h i).2.2 j hj ⟨hw i, hng⟩
  set Sc := H.filter fun h => ∀ j, good j h (r j) with hSc
  have h1 : ∀ (a : Fin n → Fin m₀), ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
      (if ∀ j, roleMask (good j) j a w h (r j) then (1 : ℝ) else 0) =
      (Sc.card : ℝ) * ((Fintype.piFinset fun i => failMask H bad (a i)).card : ℝ) := by
    intro a
    have e : ∀ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
        (if ∀ j, roleMask (good j) j a w h (r j) then (1 : ℝ) else 0) =
        (Sc.card : ℝ) * (if w ∈ Fintype.piFinset fun i => failMask H bad (a i) then 1 else 0) := by
      intro w hw
      have e2 : ∀ h, (∀ j, roleMask (good j) j a w h (r j)) ↔
          (∀ j, good j h (r j)) ∧ w ∈ Fintype.piFinset fun i => failMask H bad (a i) :=
        fun h => (hsplit a w h).trans (and_congr_right fun _ => hfail a w hw)
      rw [Finset.sum_congr rfl fun h _ => if_congr (e2 h) rfl rfl]
      by_cases hw' : w ∈ Fintype.piFinset fun i => failMask H bad (a i)
      · simp only [hw', and_true, ite_true, mul_one]
        rw [Finset.sum_boole]
      · simp only [hw', and_false, ite_false, mul_zero, Finset.sum_const_zero]
    rw [Finset.sum_congr rfl e, ← Finset.mul_sum, Finset.sum_boole]
    have hsub : (Fintype.piFinset (fun _ : Fin n => H)).filter
        (fun w => w ∈ Fintype.piFinset fun i => failMask H bad (a i)) =
        Fintype.piFinset fun i => failMask H bad (a i) := by
      ext w
      simp only [Finset.mem_filter]
      constructor
      · rintro ⟨-, hw⟩; exact hw
      · intro hw
        refine ⟨?_, hw⟩
        simp only [Fintype.mem_piFinset] at hw ⊢
        exact fun i => (Finset.mem_filter.mp (hw i)).1
    rw [hsub]
  rw [Finset.sum_congr rfl fun a _ => h1 a, ← Finset.mul_sum]
  congr 1
  have hdisj : Set.PairwiseDisjoint (↑(Finset.univ : Finset (Fin n → Fin m₀)) : Set (Fin n → Fin
      m₀))
      fun a => Fintype.piFinset fun i => failMask H bad (a i) := by
    intro a _ a' _ hne
    obtain ⟨i, hi⟩ : ∃ i, a i ≠ a' i := by
      by_contra hc
      push Not at hc
      exact hne (funext hc)
    simp only [Function.onFun]
    rw [Finset.disjoint_left]
    intro w hw hw'
    rw [Fintype.mem_piFinset] at hw hw'
    exact Finset.disjoint_left.mp (failMask_disjoint H bad hi) (hw i) (hw' i)
  have hcard := Finset.card_biUnion hdisj
  rw [← failed_words_eq_biUnion] at hcard
  have hset : H.filter (fun h => ∃ j, h ∈ bad j) = H.filter (fun h => ¬ ∀ j, good j h (r j)) := by
    ext h
    simp only [Finset.mem_filter, hbad]
    constructor
    · rintro ⟨hH, j, -, hj⟩; exact ⟨hH, fun hall => hj (hall j)⟩
    · rintro ⟨hH, hn⟩
      push Not at hn
      obtain ⟨j, hj⟩ := hn
      exact ⟨hH, j, hH, hj⟩
  rw [← Nat.cast_sum, ← hcard, Fintype.card_piFinset, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin, hset]
  push_cast
  rfl

open Classical in
/-- Blueprint lines 2463-2469 (the exact common-height selection with failure assignments): if
every tuple of components has a height at which all its roles are good, the sum over the tuples
is the convergent sum over the trial counts `n` of the sums over the assignments `a` of the
failed trials to first failing roles, the words `w` of failed heights and the final heights `h`,
with weight `|H|^{-(n+1)}`, of the sums over the tuples in the product masks. -/
theorem first_success_masked {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] {κ : Fin m₀ → Type*} (T : ∀ j, Finset (κ j)) (H : Finset ℕ)
    (good : ∀ j, ℕ → κ j → Prop) (F : (∀ j, κ j) → E)
    (hp : ∀ r ∈ Fintype.piFinset T, (H.filter fun h => ∀ j, good j h (r j)).Nonempty) :
    HasSum (fun n : ℕ => ∑ a : Fin n → Fin m₀, ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H),
      ∑ h ∈ H, ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
        (fun r => ∀ j, roleMask (good j) j a w h (r j)), F r)
      (∑ r ∈ Fintype.piFinset T, F r) := by
  by_cases hT : (Fintype.piFinset T).Nonempty
  swap
  · rw [Finset.not_nonempty_iff_eq_empty] at hT
    simp only [hT, Finset.filter_empty, Finset.sum_empty, smul_zero, Finset.sum_const_zero]
    exact hasSum_zero
  obtain ⟨r₀, hr₀⟩ := hT
  have hH : 0 < (H.card : ℝ) := by
    obtain ⟨h, hh⟩ := hp r₀ hr₀
    exact_mod_cast Finset.card_pos.mpr ⟨h, (Finset.mem_filter.mp hh).1⟩
  set pr : (∀ j, κ j) → ℝ := fun r =>
    ((H.filter fun h => ∀ j, good j h (r j)).card : ℝ) / H.card with hpr
  have key : ∀ n : ℕ, (∑ a : Fin n → Fin m₀, ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H),
      ∑ h ∈ H, ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
        (fun r => ∀ j, roleMask (good j) j a w h (r j)), F r) =
      ∑ r ∈ Fintype.piFinset T, ((1 - pr r) ^ n * pr r) • F r := by
    intro n
    have e1 : ∀ (a : Fin n → Fin m₀) (w : Fin n → ℕ) (h : ℕ),
        ((H.card : ℝ) ^ (n + 1))⁻¹ • ∑ r ∈ (Fintype.piFinset T).filter
          (fun r => ∀ j, roleMask (good j) j a w h (r j)), F r =
        ∑ r ∈ Fintype.piFinset T, (((H.card : ℝ) ^ (n + 1))⁻¹ *
          (if ∀ j, roleMask (good j) j a w h (r j) then (1 : ℝ) else 0)) • F r := by
      intro a w h
      rw [Finset.sum_filter, Finset.smul_sum]
      refine Finset.sum_congr rfl fun r _ => ?_
      split_ifs <;> simp
    simp only [e1]
    calc ∑ a : Fin n → Fin m₀, ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
          ∑ r ∈ Fintype.piFinset T, (((H.card : ℝ) ^ (n + 1))⁻¹ *
            (if ∀ j, roleMask (good j) j a w h (r j) then (1 : ℝ) else 0)) • F r
        = ∑ a : Fin n → Fin m₀, ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H),
          ∑ r ∈ Fintype.piFinset T, ∑ h ∈ H, (((H.card : ℝ) ^ (n + 1))⁻¹ *
            (if ∀ j, roleMask (good j) j a w h (r j) then (1 : ℝ) else 0)) • F r :=
          Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun w _ => Finset.sum_comm
      _ = ∑ a : Fin n → Fin m₀, ∑ r ∈ Fintype.piFinset T,
          ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H, (((H.card : ℝ) ^ (n + 1))⁻¹ *
            (if ∀ j, roleMask (good j) j a w h (r j) then (1 : ℝ) else 0)) • F r :=
          Finset.sum_congr rfl fun a _ => Finset.sum_comm
      _ = ∑ r ∈ Fintype.piFinset T, ∑ a : Fin n → Fin m₀,
          ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H, (((H.card : ℝ) ^ (n + 1))⁻¹ *
            (if ∀ j, roleMask (good j) j a w h (r j) then (1 : ℝ) else 0)) • F r :=
          Finset.sum_comm
      _ = _ := by
          refine Finset.sum_congr rfl fun r _ => ?_
          simp only [← Finset.sum_smul, ← Finset.mul_sum]
          rw [masked_count H good r n]
          congr 1
          have hc := Finset.card_filter_add_card_filter_not
            (s := H) (fun h => ∀ j, good j h (r j))
          have hc' : ((H.filter fun h => ¬ ∀ j, good j h (r j)).card : ℝ) =
              H.card - (H.filter fun h => ∀ j, good j h (r j)).card := by
            rw [← hc]; push_cast; ring
          rw [hc']
          simp only [hpr]
          field_simp
          rw [div_pow, pow_succ]
          field_simp
  have hsum := first_success_identity (Fintype.piFinset T) pr (fun r hr => div_pos
    (by exact_mod_cast Finset.card_pos.mpr (hp r hr)) hH) (fun r _ => by
      rw [div_le_one hH]; exact_mod_cast Finset.card_filter_le _ _) F
  exact (funext key ▸ hsum : _)

end MaskedSuccess

namespace ModeSystem

variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

open Classical in
/-- The goodness at height `h` of a component of the block `b` on the pre-cell `J`: the goodness of
a mode whose minimal PRE component it is. -/
def compGood (b : ℤ) (J : ℤ × ℤ) (h : ℕ) (K : Finset Ms.Md) : Prop :=
  ∃ x : Ms.alive (ancAt Gd J (b - 4 * S.K)),
    K = ((Ms.blockComps S hA b J).E 0 x).map ⟨Subtype.val, Subtype.val_injective⟩ ∧
      (Ms.blockComps S hA b J).Good SP.Δ (Ms.goodP S SP b) h x

open Classical in
/-- The goodness of a component is that of any mode it is the minimal PRE component of
(`good_iff_of_minimal_pre`). -/
theorem compGood_iff {b : ℤ} {J : ℤ × ℤ} {K : Finset Ms.Md}
    {x : Ms.alive (ancAt Gd J (b - 4 * S.K))}
    (hK : K = ((Ms.blockComps S hA b J).E 0 x).map ⟨Subtype.val, Subtype.val_injective⟩) (h : ℕ) :
    Ms.compGood S hA SP b J h K ↔ (Ms.blockComps S hA b J).Good SP.Δ (Ms.goodP S SP b) h x := by
  constructor
  · rintro ⟨x', hK', hg⟩
    have hE : (Ms.blockComps S hA b J).E 0 x = (Ms.blockComps S hA b J).E 0 x' := by
      rw [hK] at hK'
      exact Finset.map_injective _ hK'
    have hx : x ∈ (Ms.blockComps S hA b J).E 0 x' := by
      rw [← hE]; exact (Ms.blockComps S hA b J).E_self 0 x
    exact ((Ms.blockComps S hA b J).good_iff_of_minimal_pre SP.Δ (Ms.goodP S SP b) hx h).mp hg
  · intro hg
    exact ⟨x, hK, hg⟩

open Classical in
/-- Every core component is the minimal PRE component of a core mode. -/
theorem coreComps_rep {b : ℤ} {J : ℤ × ℤ} {K : Finset Ms.Md}
    (hK : K ∈ Ms.coreComps S hA SP b J) :
    ∃ x : Ms.alive (ancAt Gd J (b - 4 * S.K)),
      K = ((Ms.blockComps S hA b J).E 0 x).map ⟨Subtype.val, Subtype.val_injective⟩ ∧
      (Ms.blockComps S hA b J).Core SP.Δ (Ms.goodP S SP b) SP.Jst SP.δs x := by
  obtain ⟨hall, hside⟩ := Finset.mem_sdiff.mp hK
  obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hall
  refine ⟨x, rfl, ?_⟩
  by_contra hc
  exact hside (Finset.mem_image.mpr ⟨x, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hc⟩, rfl⟩)

open Classical in
/-- Blueprint line 2466 for components: a core component is bad at a proportion at most `2δ` of
the upper heights. -/
theorem coreComp_bad_card {b : ℤ} {J : ℤ × ℤ} {K : Finset Ms.Md}
    (hK : K ∈ Ms.coreComps S hA SP b J) (hJ : 2 ≤ SP.Jst) (hδ : 0 < SP.δs)
    (hδ16 : SP.δs ≤ 1 / 16) :
    (((ModeComponents.upperHeights SP.Jst SP.δs).filter fun h =>
      ¬ Ms.compGood S hA SP b J h K).card : ℝ) ≤
      2 * SP.δs * (ModeComponents.upperHeights SP.Jst SP.δs).card := by
  obtain ⟨x, hKx, hcore⟩ := Ms.coreComps_rep S hA SP hK
  refine le_trans ?_ ((Ms.blockComps S hA b J).core_bad_proportion SP.Δ (Ms.goodP S SP b) hJ hδ
    hδ16 hcore)
  have hsub : (ModeComponents.upperHeights SP.Jst SP.δs).filter
      (fun h => ¬ Ms.compGood S hA SP b J h K) ⊆
      (Ms.blockComps S hA b J).badHeights SP.Δ (Ms.goodP S SP b) SP.Jst x ∩
        ModeComponents.upperHeights SP.Jst SP.δs := by
    intro h hh
    obtain ⟨hup, hng⟩ := Finset.mem_filter.mp hh
    refine Finset.mem_inter.mpr ⟨?_, hup⟩
    unfold ModeComponents.badHeights
    refine Finset.mem_filter.mpr ⟨?_, fun hg => hng ((Ms.compGood_iff S hA SP hKx h).mpr hg)⟩
    exact (Finset.mem_filter.mp hup).1
  exact_mod_cast Finset.card_le_card hsub

end ModeSystem

