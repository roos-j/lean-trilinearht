open Classical in
/-- Blueprint lines 2468-2476 for the four core roles of a grouped tuple on a leaf cell: the
selected wave sums `Σ_{m ∈ F_j} c_m wave_m` (selected modes in the PRE components `E_h(a_j)` of the
representatives, common chart tag `z`, offsets in `[0, 1]`) satisfy the input hypotheses of
`four_core_principal` with `γ_j = ω_{a_j}(x*)`, coefficients `c_m e(φ_m(x*))`, `L = 6^h` and
relative error `η`. -/
theorem four_role_inputs {I : ℤ × ℤ} (G : A.Grp) (z : ChartTag) (hz : ∀ j, (D.Ms j G).zc = z)
    {δ : ℝ} (hδc : ∀ j, (D.Ms j G).δc = δ) (hcl : ∀ j, (D.Ms j G).cl = slotCoeff j)
    (hρ : ∀ j k, (D.Ms j G).ρ k ∈ Set.Icc (0 : ℝ) 1) (h : ℕ) {xs : ℝ}
    (J : Fin 4 → ℤ × ℤ) (hJ : ∀ j, (J j).1 ≤ D.blockOf I.1 + D.S.K)
    (a : ∀ j, (D.Ms j G).alive (ancAt A.G (J j) (D.blockOf I.1 - 4 * D.S.K)))
    (F : ∀ j, Finset ((D.Ms j G).alive (ancAt A.G (J j) (D.blockOf I.1 - 4 * D.S.K))))
    (hF : ∀ j, F j ⊆ ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (J j)).E h (a j))
    {Λ : ℝ} (hΛ : ∀ j, ∀ m ∈ F j, |(D.Ms j G).lamOf m.1| ≤ Λ) {lo hi η : ℝ}
    (hη : ∀ j, ∀ y ∈ Set.Icc lo hi,
      2 * Real.pi * (Fintype.card ((D.Ms j G).alive (ancAt A.G (J j)
        (D.blockOf I.1 - 4 * D.S.K))) * (D.S.Ξ / dyadicGridLength A.G (J j).1) * |y - xs| +
        Λ * (y - xs) ^ 2) ≤ η)
    (hxsJ : ∀ j, xs ∈ Set.Icc (dyadicGridLeft A.G (J j).1 (J j).2)
      (dyadicGridLeft A.G (J j).1 (J j).2 + dyadicGridLength A.G (J j).1)) :
    ∃ ρ' : Fin 4 → Fin z.dim → ℝ, (∀ j k, ρ' j k ∈ Set.Icc (0 : ℝ) 1) ∧
    ∃ n : ∀ j, (D.Ms j G).alive (ancAt A.G (J j) (D.blockOf I.1 - 4 * D.S.K)) → Fin z.dim → ℤ,
      (∀ j, ∀ m ∈ F j, ∀ i, |(n j m i : ℝ)| ≤ Fintype.card ((D.Ms j G).alive
        (ancAt A.G (J j) (D.blockOf I.1 - 4 * D.S.K))) * D.S.Eh h) ∧
      (∀ j, ∀ y ∈ Set.Icc lo hi,
        ‖∑ m ∈ F j, D.c j G (D.blockOf I.1) (J j) m.1 * (D.Ms j G).wave m.1 y -
          ((centerCut z δ (ρ' j) y : ℂ) * (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) *
            centerPhase z (ρ' j) y) : ℂ)) *
          ((Real.fourierChar ((D.Ms j G).slope (a j).1 xs * (y - xs)) : ℂ) *
            ∑ m ∈ F j, (D.c j G (D.blockOf I.1) (J j) m.1 *
              (Real.fourierChar ((D.Ms j G).phase m.1 xs) : ℂ)) *
              torusCharacter (n j m)
                (torusMk fun i => z.θ i / (D.S.Q0 * ((6 ^ h : ℕ) : ℝ)) * (y - xs)))‖ ≤
          η * ∑ m ∈ F j, ‖D.c j G (D.blockOf I.1) (J j) m.1 *
            (Real.fourierChar ((D.Ms j G).phase m.1 xs) : ℂ)‖) ∧
      (∀ j, ∀ y, ‖∑ m ∈ F j, D.c j G (D.blockOf I.1) (J j) m.1 * (D.Ms j G).wave m.1 y‖ ≤
        ∑ m ∈ F j, ‖D.c j G (D.blockOf I.1) (J j) m.1 *
          (Real.fourierChar ((D.Ms j G).phase m.1 xs) : ℂ)‖) := by
  have hrole := fun j => (D.Ms j G).role_input_approx D.S D.hA z (hz j) (hJ j) (a j) (F j) (hF j)
    (fun m => D.c j G (D.blockOf I.1) (J j) m.1) (hΛ j) (hxsJ j) (hη j)
  choose ρ' hρ' hgauge n hn happ hbd using hrole
  refine ⟨ρ', fun j k => ?_, n, hn, fun j y hy => ?_, hbd⟩
  · obtain ⟨k', hk'⟩ := hρ' j k
    rw [hk']; exact hρ j k'
  · have e := happ j y hy
    rw [hδc j, hcl j] at e
    have h6 : ((6 ^ h : ℕ) : ℝ) = 6 ^ h := by push_cast; rfl
    rw [h6]
    exact e

