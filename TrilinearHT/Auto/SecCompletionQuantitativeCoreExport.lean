open Classical in
/-- Blueprint lines 2463-2582 for four core roles on a leaf cell and group: the form of the full
core subtotals is at most `C Z / (1 - m₀ ρ^{1/m₀}) + Σ_r e_r`, if for every failure history the
grouped forms (masked components grouped by the class maps `cls`) are at most principal quantities
`Ψ_p` plus the errors of their member tuples, and the history averages of `Σ_p Ψ_p` obey the moment
bound (`first_success_bound`, `grouped_cell_form`). -/
theorem core_leaf_bound (I : ℤ × ℤ) (G : A.Grp) (J : Fin 4 → ℤ × ℤ)
    (T : ∀ l, Finset (Finset (D.Ms l G).Md))
    (hdis : ∀ l, Set.PairwiseDisjoint (T l : Set (Finset (D.Ms l G).Md)) id) (H : Finset ℕ)
    (good : ∀ l, ℕ → Finset (D.Ms l G).Md → Prop)
    (hp : ∀ r ∈ Fintype.piFinset T, (H.filter fun h => ∀ l, good l h (r l)).Nonempty)
    {ι : Fin 4 → Type*} (cls : ∀ l, Finset (D.Ms l G).Md → ι l)
    (Ψ : (n : ℕ) → (Fin n → Fin 4) → (Fin n → ℕ) → ℕ → (∀ l, ι l) → ℝ)
    (e : (∀ l, Finset (D.Ms l G).Md) → ℝ)
    (hgrp : ∀ n (a : Fin n → Fin 4) w h, ∀ p ∈ Fintype.piFinset
        (fun l => ((T l).filter (roleMask (good l) l a w h)).image (cls l)),
      ‖ap.Λc I (fun l => D.compSub l G I (J l)
        ((((T l).filter (roleMask (good l) l a w h)).filter fun K => cls l K = p l).biUnion id))‖ ≤
        Ψ n a w h p + ∑ r ∈ (Fintype.piFinset fun l =>
          (T l).filter (roleMask (good l) l a w h)).filter
          (fun r => ∀ l, cls l (r l) = p l), e r)
    {C Z ρ : ℝ} (hρ : 0 ≤ ρ) (hq : (4 : ℝ) * ρ ^ (1 / (4 : ℝ)) < 1)
    (hmom : ∀ n (a : Fin n → Fin 4), ∑ w ∈ Fintype.piFinset (fun _ : Fin n => H), ∑ h ∈ H,
      ((H.card : ℝ) ^ (n + 1))⁻¹ * ∑ p ∈ Fintype.piFinset
        (fun l => ((T l).filter (roleMask (good l) l a w h)).image (cls l)), Ψ n a w h p ≤
        C * (ρ ^ n) ^ (1 / (4 : ℝ)) * Z) :
    ‖∑ r ∈ Fintype.piFinset T, ap.Λc I (fun l => D.compSub l G I (J l) (r l))‖ ≤
      C * Z / (1 - (4 : ℝ) * ρ ^ (1 / (4 : ℝ))) + ∑ r ∈ Fintype.piFinset T, e r := by
  have h4 : ((4 : ℕ) : ℝ) = 4 := by norm_num
  have hq' : ((4 : ℕ) : ℝ) * ρ ^ (1 / ((4 : ℕ) : ℝ)) < 1 := by rw [h4]; exact hq
  have hb := first_success_bound (m₀ := 4) T H good
    (fun r => ap.Λc I (fun l => D.compSub l G I (J l) (r l))) e hp
    (fun n a w h => ∑ p ∈ Fintype.piFinset
      (fun l => ((T l).filter (roleMask (good l) l a w h)).image (cls l)), Ψ n a w h p)
    (fun n a w h => ?_) hρ hq' (fun n a => by rw [h4]; exact hmom n a)
  · rw [h4] at hb; exact hb
  have hpf : (Fintype.piFinset T).filter (fun r => ∀ j, roleMask (good j) j a w h (r j)) =
      Fintype.piFinset (fun l => (T l).filter (roleMask (good l) l a w h)) := by
    ext r
    simp only [Finset.mem_filter, Fintype.mem_piFinset]
    constructor
    · rintro ⟨h1, h2⟩ l; exact ⟨h1 l, h2 l⟩
    · intro h; exact ⟨fun l => (h l).1, fun l => (h l).2⟩
  rw [hpf]
  have hg := D.grouped_cell_form I G J (fun l => (T l).filter (roleMask (good l) l a w h)) cls
    (fun l => (hdis l).subset (Finset.coe_subset.mpr (Finset.filter_subset _ _)))
  rw [hg]
  refine (norm_sum_le _ _).trans ?_
  refine (Finset.sum_le_sum fun p hp' => hgrp n a w h p hp').trans (le_of_eq ?_)
  rw [Finset.sum_add_distrib]
  congr 1
  convert sum_fiber_pi (fun l => (T l).filter (roleMask (good l) l a w h)) cls e using 3
  ext r; simp only [Finset.mem_filter]

