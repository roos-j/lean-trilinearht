/-- A quasipolynomial bound is a bound of some positive degree. -/
theorem quasipolynomialBound_iff_exists_degree (f : ℝ → ℝ) :
    QuasipolynomialBound f ↔ ∃ d : ℕ, 1 ≤ d ∧ QuasipolynomialBoundOfDegree d f := by
  constructor
  · rintro ⟨C, hC, d, hd, h⟩
    exact ⟨d, hd, C, hC, h⟩
  · rintro ⟨d, hd, C, hC, h⟩
    exact ⟨C, hC, d, hd, h⟩

/-- Raising the degree of a bound keeps its coefficient. -/
theorem QuasipolynomialBoundOfDegree.mono {d e : ℕ} {f : ℝ → ℝ}
