  refine ⟨C, hC, fun t ht => ⟨(hf t ht).1, (hf t ht).2.trans (Real.exp_le_exp.mpr ?_)⟩⟩
  exact mul_le_mul_of_nonneg_left (logarithmicSize_pow_mono ht hde) (by linarith)

