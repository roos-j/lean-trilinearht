        (⌈Real.exp (α * k ^ θ)⌉₊ : ℝ) ^ ε := by
  filter_upwards [logarithmic_power_eventually_le_rpow C d hθ (mul_pos hα hε)] with k hk
  calc
    Real.exp (C * logarithmicSize (2 * k) ^ d) ≤ Real.exp (α * ε * k ^ θ) :=
      Real.exp_le_exp.mpr hk
    _ = Real.exp (α * k ^ θ) ^ ε := by rw [← Real.exp_mul]; congr 1; ring
    _ ≤ (⌈Real.exp (α * k ^ θ)⌉₊ : ℝ) ^ ε :=
      Real.rpow_le_rpow (Real.exp_pos _).le (Nat.le_ceil _) hε.le

/-- Blueprint Lemma `lem:budget-rules`, lines 85-89: if `D ≤ exp(A k^d)`, `m ≤ B log(2k)` and
`F ≤ (C(m+1) log(2D))^{C(m+1)}`, then `F ≤ exp(K (1 + log(2k))^2)` with a coefficient `K`
depending only on `A, B, C, d`; the exponent `2` is absolute. Here `m` is a count, the fixed
constants `B, C` are positive, `k` and the coefficient `A` are arbitrary reals, and `1 ≤ 2D` is
exactly the condition under which the printed real power has a nonnegative base. -/
theorem compression_overhead_bound {k D A B C F : ℝ} (m d : ℕ) (hB : 0 < B) (hC : 0 < C)
    (hD : 1 ≤ 2 * D) (hDbound : D ≤ Real.exp (A * k ^ d))
    (hmbound : (m : ℝ) ≤ B * Real.log (2 * k))
    (hF : F ≤ (C * ((m : ℝ) + 1) * Real.log (2 * D)) ^ (C * ((m : ℝ) + 1))) :
    F ≤ Real.exp (C * (B + 1) * (C + B + 1 + |A| + d) * logarithmicSize (2 * k) ^ 2) := by
  set u := logarithmicSize (2 * k) with hu_def
  have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
  have hlog2k : 0 ≤ Real.log (2 * k) := by
    by_contra h
    have : B * Real.log (2 * k) < 0 := mul_neg_of_pos_of_neg hB (not_le.mp h)
    linarith
  have hu : 1 ≤ u := by simp only [hu_def, logarithmicSize]; linarith
  have hlogu : Real.log (2 * k) ≤ u := by simp only [hu_def, logarithmicSize]; linarith
  have hD0 : 0 < D := by linarith
  have hlogD2 : 0 ≤ Real.log (2 * D) := Real.log_nonneg hD
  set b := C * ((m : ℝ) + 1) * Real.log (2 * D) with hb
  have hb0 : 0 ≤ b := by positivity
  have he0 : 0 ≤ C * ((m : ℝ) + 1) := by positivity
  refine hF.trans ?_
  rcases le_or_gt b 1 with hb1 | hb1
  · exact (Real.rpow_le_one hb0 hb1 he0).trans (Real.one_le_exp (by positivity))
  have hbpos : 0 < b := by linarith
  have hm1 : (m : ℝ) + 1 ≤ (B + 1) * u := by
    have := mul_le_mul_of_nonneg_left hlogu hB.le
    nlinarith
  have hlogk : Real.log (max 1 |k|) ≤ u := by
    rcases le_total |k| 1 with hk | hk
    · rw [max_eq_left hk, Real.log_one]
      linarith
    · rw [max_eq_right hk]
      have h2k : Real.log |k| ≤ Real.log (2 * k) := by
        rw [← Real.log_abs (2 * k), abs_mul, abs_two]
        exact Real.log_le_log (by linarith) (by linarith)
      linarith
  have hlogD : Real.log D ≤ |A| * max 1 |k| ^ d := by
    have h1 : Real.log D ≤ A * k ^ d := by
      simpa only [Real.log_exp] using Real.log_le_log hD0 hDbound
    have h2 : A * k ^ d ≤ |A| * |k| ^ d := by
      rw [← abs_pow, ← abs_mul]
      exact le_abs_self _
    have h3 : |k| ^ d ≤ max 1 |k| ^ d := pow_le_pow_left₀ (abs_nonneg k) (le_max_right _ _) d
    have h4 := mul_le_mul_of_nonneg_left h3 (abs_nonneg A)
    linarith
  have hlog2 : Real.log 2 ≤ 1 := by
    have := Real.log_le_sub_one_of_pos (show (0 : ℝ) < 2 by norm_num)
    linarith
  set M := max 1 |k| ^ d with hM
  have hM1 : 1 ≤ M := one_le_pow₀ (le_max_left _ _)
  have hlog2D : Real.log (2 * D) ≤ (1 + |A|) * M := by
    rw [Real.log_mul (by norm_num) hD0.ne']
    nlinarith [abs_nonneg A]
  have hlogM : Real.log M ≤ d * u := by
    rw [hM, Real.log_pow]
    exact mul_le_mul_of_nonneg_left hlogk (Nat.cast_nonneg d)
  have hA1 : 0 < 1 + |A| := by positivity
  have hB1 : 0 < B + 1 := by linarith
  have hu0 : 0 < u := by linarith
  have hM0 : 0 < M := by linarith
  have hlogb : Real.log b ≤ (C + B + 1 + |A| + d) * u := by
    have hb' : b ≤ C * ((B + 1) * u) * ((1 + |A|) * M) := by
      rw [hb]
      have h1 : C * ((m : ℝ) + 1) ≤ C * ((B + 1) * u) := mul_le_mul_of_nonneg_left hm1 hC.le
      exact mul_le_mul h1 hlog2D hlogD2 (by positivity)
    calc Real.log b ≤ Real.log (C * ((B + 1) * u) * ((1 + |A|) * M)) :=
          Real.log_le_log hbpos hb'
      _ = Real.log C + (Real.log (B + 1) + Real.log u) + (Real.log (1 + |A|) + Real.log M) := by
          rw [Real.log_mul (by positivity) (by positivity), Real.log_mul hC.ne' (by positivity),
            Real.log_mul hB1.ne' hu0.ne', Real.log_mul hA1.ne' hM0.ne']
      _ ≤ C + B + u + |A| + d * u := by
          have := Real.log_le_sub_one_of_pos hC
          have := Real.log_le_sub_one_of_pos hB1
          have := Real.log_le_sub_one_of_pos hu0
          have := Real.log_le_sub_one_of_pos hA1
          linarith
      _ ≤ (C + B + 1 + |A| + d) * u := by
          have h1 := mul_le_mul_of_nonneg_left hu hC.le
          have h2 := mul_le_mul_of_nonneg_left hu hB.le
          have h3 := mul_le_mul_of_nonneg_left hu (abs_nonneg A)
          nlinarith
  rw [Real.rpow_def_of_pos hbpos]
  apply Real.exp_le_exp.mpr
  calc Real.log b * (C * ((m : ℝ) + 1)) ≤
        ((C + B + 1 + |A| + d) * u) * (C * ((B + 1) * u)) :=
        mul_le_mul hlogb (mul_le_mul_of_nonneg_left hm1 hC.le) he0 (by positivity)
    _ = _ := by ring

/-- Blueprint Lemma `lem:budget-rules`: polynomial majorants add with a
degree independent of their coefficients. Substitute a logarithmic size for `u`. -/
theorem polynomial_majorant_add {u x y C D : ℝ} {d e : ℕ}
    (hu : 1 ≤ u) (hC : 0 ≤ C) (hD : 0 ≤ D)
    (hx : x ≤ C * u ^ d) (hy : y ≤ D * u ^ e) :
    x + y ≤ (C + D) * u ^ (d + e) := by
  have h₁ := mul_le_mul_of_nonneg_left
    (pow_le_pow_right₀ hu (Nat.le_add_right d e)) hC
  have h₂ := mul_le_mul_of_nonneg_left
    (pow_le_pow_right₀ hu (Nat.le_add_left e d)) hD
  nlinarith

/-- Blueprint Lemma `lem:budget-rules`: polynomial majorants multiply. -/
theorem polynomial_majorant_mul {u x y C D : ℝ} {d e : ℕ}
    (hu : 0 ≤ u) (hy0 : 0 ≤ y) (hC : 0 ≤ C)
    (hx : x ≤ C * u ^ d) (hy : y ≤ D * u ^ e) :
    x * y ≤ (C * D) * u ^ (d + e) := by
  calc
    x * y ≤ (C * u ^ d) * (D * u ^ e) := mul_le_mul hx hy hy0 (by positivity)
    _ = _ := by rw [pow_add]; ring

/-- Blueprint Lemma `lem:budget-rules`: polynomial majorants compose,
with degree `e * d` regardless of any auxiliary-parameter dependence of `C,D`. -/
theorem polynomial_majorant_comp {u v x C D : ℝ} {d e : ℕ}
    (hv : 0 ≤ v) (hC : 0 ≤ C) (hx : x ≤ C * v ^ d) (hvbound : v ≤ D * u ^ e) :
    x ≤ C * D ^ d * u ^ (e * d) := by
  calc
    x ≤ C * v ^ d := hx
    _ ≤ C * (D * u ^ e) ^ d := by gcongr
    _ = _ := by rw [mul_pow, ← pow_mul]; ring

/-- Blueprint Lemma `lem:budget-rules`, line 89: every fixed real power of `k` is at most every
positive power of `P = ⌈exp(α k^θ)⌉` once `k` is large. -/
theorem fixed_power_eventually_le_ceiling_power {p α θ ε : ℝ}
    (hα : 0 < α) (hθ : 0 < θ) (hε : 0 < ε) :
    ∀ᶠ k : ℝ in atTop, k ^ p ≤ (⌈Real.exp (α * k ^ θ)⌉₊ : ℝ) ^ ε := by
  filter_upwards [quasipolynomial_overhead_eventually_le_ceiling_power (max p 0) 1 hα hθ hε,
    eventually_ge_atTop (2 : ℝ)] with k hk hk2
  have hk0 : 0 < k := by linarith
  have hlog : Real.log k ≤ logarithmicSize (2 * k) := by
    have := Real.log_le_log hk0 (show k ≤ 2 * k by linarith)
    dsimp [logarithmicSize]
    linarith
  have hlogk : 0 ≤ Real.log k := Real.log_nonneg (by linarith)
  calc
    k ^ p = Real.exp (Real.log k * p) := Real.rpow_def_of_pos hk0 _
    _ ≤ Real.exp (max p 0 * logarithmicSize (2 * k) ^ 1) := by
      apply Real.exp_le_exp.mpr
      have h1 : Real.log k * p ≤ Real.log k * max p 0 :=
        mul_le_mul_of_nonneg_left (le_max_left p 0) hlogk
      have h2 := mul_le_mul_of_nonneg_left hlog (le_max_right p 0)
      rw [pow_one]
      linarith
    _ ≤ _ := hk

end Auto

