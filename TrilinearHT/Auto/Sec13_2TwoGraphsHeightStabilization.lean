namespace Auto
open MeasureTheory Metric
open scoped FourierTransform ComplexConjugate ENNReal

namespace ModeComponents
variable {Mode P : Type*} [Fintype Mode] [DecidableEq Mode] [DecidableEq P]

/-! ### Components of the PRE and CURRENT graphs (blueprint lines 1980-1988) -/

open Classical in
/-- The components of two height-indexed edge relations (`eq:PRE` and `eq:CURRENT`): PRE edges
are CURRENT edges and both grow with height. -/
noncomputable def ofEdges (pre cur : ℕ → Mode → Mode → Prop) (π : Mode → P)
    (hle : ∀ h m m', pre h m m' → cur h m m')
    (hpre : ∀ h h' m m', h ≤ h' → pre h m m' → pre h' m m')
    (hcur : ∀ h h' m m', h ≤ h' → cur h m m' → cur h' m m') : ModeComponents Mode P where
  E h m := Finset.univ.filter fun x => (SimpleGraph.fromRel (pre h)).Reachable m x
  F h m := Finset.univ.filter fun x => (SimpleGraph.fromRel (cur h)).Reachable m x
  π := π
  E_self h m := Finset.mem_filter.mpr ⟨Finset.mem_univ _, SimpleGraph.Reachable.refl m⟩
  E_comp h m x hx := by
    have hx' := (Finset.mem_filter.mp hx).2
    ext y
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨fun hy => hx'.trans hy, fun hy => hx'.symm.trans hy⟩
  F_comp h m x hx := by
    have hx' := (Finset.mem_filter.mp hx).2
    ext y
    simp only [Finset.mem_filter, Finset.mem_univ, true_and]
    exact ⟨fun hy => hx'.trans hy, fun hy => hx'.symm.trans hy⟩
  E_le_F h m := by
    intro x hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
    refine hx.mono ?_
    intro a b hab
    simp only [SimpleGraph.fromRel_adj] at hab ⊢
    exact ⟨hab.1, hab.2.imp (hle h a b) (hle h b a)⟩
  E_mono h h' m hh := by
    intro x hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
    refine hx.mono ?_
    intro a b hab
    simp only [SimpleGraph.fromRel_adj] at hab ⊢
    exact ⟨hab.1, hab.2.imp (hpre h h' a b hh) (hpre h h' b a hh)⟩
  F_mono h h' m hh := by
    intro x hx
    simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
    refine hx.mono ?_
    intro a b hab
    simp only [SimpleGraph.fromRel_adj] at hab ⊢
    exact ⟨hab.1, hab.2.imp (hcur h h' a b hh) (hcur h h' b a hh)⟩

theorem ofEdges_E_of_pre (pre cur : ℕ → Mode → Mode → Prop) (π : Mode → P)
    (hle : ∀ h m m', pre h m m' → cur h m m')
    (hpre : ∀ h h' m m', h ≤ h' → pre h m m' → pre h' m m')
    (hcur : ∀ h h' m m', h ≤ h' → cur h m m' → cur h' m m') {h : ℕ} {m m' : Mode}
    (hmm' : pre h m m') : m' ∈ (ofEdges pre cur π hle hpre hcur).E h m := by
  classical
  by_cases he : m = m'
  · subst he; exact (ofEdges pre cur π hle hpre hcur).E_self h m
  · simp only [ofEdges, Finset.mem_filter, Finset.mem_univ, true_and]
    exact SimpleGraph.Adj.reachable (by simp [SimpleGraph.fromRel_adj, he, hmm'])

end ModeComponents

namespace ModeSchedule
variable (S : ModeSchedule)

/-- The edge relation of `eq:PRE` / `eq:CURRENT` at height `h` with threshold `θr` on the
interval `[a, a + r]`: some integer vector `n` with `|n|_∞ ≤ E_h` brings the frequency difference
within `θr` after the shift `n·ϑ/L_h`. -/
def gapEdge {Mode : Type*} {dz : ℕ} (ω : Mode → ℝ → ℝ) (ϑ : Fin dz → ℝ) (a r θr : ℝ) (h : ℕ)
    (m m' : Mode) : Prop :=
  ∃ n : Fin dz → ℤ, (∀ i, |(n i : ℝ)| ≤ S.Eh h) ∧
    ∀ x ∈ Set.Icc a (a + r), |ω m x - ω m' x + (∑ i, (n i : ℝ) * ϑ i) / Lh h| ≤ θr

theorem gapEdge_succ {Mode : Type*} {dz : ℕ} (hA : 6 ≤ S.A0) (ω : Mode → ℝ → ℝ)
    (ϑ : Fin dz → ℝ) (a r θr : ℝ) {h : ℕ} {m m' : Mode} (he : S.gapEdge ω ϑ a r θr h m m') :
    S.gapEdge ω ϑ a r θr (h + 1) m m' := by
  obtain ⟨n, hn, hx⟩ := he
  refine ⟨fun i => 6 * n i, fun i => ?_, fun x hxI => ?_⟩
  · have hE : 6 * S.Eh h ≤ S.Eh (h + 1) := by
      unfold Eh
      rw [pow_succ _ (h + 1), mul_comm]
      have : 0 ≤ S.A0 ^ (h + 1) := pow_nonneg (by linarith) _
      exact mul_le_mul_of_nonneg_left hA this
    push_cast
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 6)]
    linarith [hn i]
  · have e : (∑ i, (((6 * n i : ℤ)) : ℝ) * ϑ i) / Lh (h + 1) =
        (∑ i, (n i : ℝ) * ϑ i) / Lh h := by
      unfold Lh
      push_cast
      have h6 : ∑ x, 6 * (n x : ℝ) * ϑ x = 6 * ∑ x, (n x : ℝ) * ϑ x := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun _ _ => by ring
      rw [pow_succ, h6]; field_simp
    rw [e]; exact hx x hxI

theorem gapEdge_mono {Mode : Type*} {dz : ℕ} (hA : 6 ≤ S.A0) (ω : Mode → ℝ → ℝ)
    (ϑ : Fin dz → ℝ) (a r θr : ℝ) {h h' : ℕ} (hh : h ≤ h') {m m' : Mode}
    (he : S.gapEdge ω ϑ a r θr h m m') : S.gapEdge ω ϑ a r θr h' m m' := by
  induction h', hh using Nat.le_induction with
  | base => exact he
  | succ h' _ ih => exact S.gapEdge_succ hA ω ϑ a r θr ih

theorem gapEdge_threshold {Mode : Type*} {dz : ℕ} (ω : Mode → ℝ → ℝ) (ϑ : Fin dz → ℝ)
    (a r : ℝ) {θ θ' : ℝ} (hθ : θ ≤ θ') {h : ℕ} {m m' : Mode}
    (he : S.gapEdge ω ϑ a r θ h m m') : S.gapEdge ω ϑ a r θ' h m m' := by
  obtain ⟨n, hn, hx⟩ := he
  exact ⟨n, hn, fun x hx' => (hx x hx').trans hθ⟩

/-- The PRE and CURRENT components on a pre-cell `[a, a + r_v]` (blueprint lines 1980-1988):
PRE uses `Ξ/r_v`, CURRENT `Ξ/r_t` with `r_t ≤ r_v`. -/
noncomputable def preCurrent {Mode P : Type*} [Fintype Mode] [DecidableEq Mode] [DecidableEq P]
    (hA : 6 ≤ S.A0) {dz : ℕ} (ω : Mode → ℝ → ℝ) (ϑ : Fin dz → ℝ) (π : Mode → P)
    (a rv rt : ℝ) (hrt : S.Ξ / rv ≤ S.Ξ / rt) : ModeComponents Mode P :=
  ModeComponents.ofEdges (S.gapEdge ω ϑ a rv (S.Ξ / rv)) (S.gapEdge ω ϑ a rv (S.Ξ / rt)) π
    (fun _ _ _ he => S.gapEdge_threshold ω ϑ a rv hrt he)
    (fun _ _ _ _ hh he => S.gapEdge_mono hA ω ϑ a rv _ hh he)
    (fun _ _ _ _ hh he => S.gapEdge_mono hA ω ϑ a rv _ hh he)

/-! ### Lem:stabilize on the attempt (blueprint lines 2002-2029) -/

/-- A walk in the graph of `gapEdge` sums its witnesses: the endpoint frequencies differ by a
shift with integer vector of size at most `k E_h` up to `k θ`, `k` the length. -/
theorem gapEdge_walk_sum {Mode : Type*} {dz : ℕ} (ω : Mode → ℝ → ℝ) (ϑ : Fin dz → ℝ)
    (a r θr : ℝ) (h : ℕ) :
    ∀ {u v : Mode} (p : (SimpleGraph.fromRel (S.gapEdge ω ϑ a r θr h)).Walk u v),
      ∃ n : Fin dz → ℤ, (∀ i, |(n i : ℝ)| ≤ p.length * S.Eh h) ∧
        ∀ x ∈ Set.Icc a (a + r),
          |ω u x - ω v x + (∑ i, (n i : ℝ) * ϑ i) / Lh h| ≤ p.length * θr := by
  intro u v p
  induction p with
  | nil => exact ⟨0, fun i => by simp, fun x _ => by simp⟩
  | @cons u w v hadj q ih =>
    obtain ⟨n₂, hn₂, hx₂⟩ := ih
    simp only [SimpleGraph.fromRel_adj] at hadj
    obtain ⟨n₁, hn₁, hx₁⟩ : ∃ n₁ : Fin dz → ℤ, (∀ i, |(n₁ i : ℝ)| ≤ S.Eh h) ∧
        ∀ x ∈ Set.Icc a (a + r), |ω u x - ω w x + (∑ i, (n₁ i : ℝ) * ϑ i) / Lh h| ≤ θr := by
      rcases hadj.2 with he | he
      · exact he
      · obtain ⟨n, hn, hx⟩ := he
        refine ⟨-n, fun i => by simpa using hn i, fun x hx' => ?_⟩
        have e : ω u x - ω w x + (∑ i, (((-n) i : ℤ) : ℝ) * ϑ i) / Lh h =
            -(ω w x - ω u x + (∑ i, (n i : ℝ) * ϑ i) / Lh h) := by
          simp only [Pi.neg_apply, Int.cast_neg, neg_mul, Finset.sum_neg_distrib, neg_div]
          ring
        rw [e, abs_neg]; exact hx x hx'
    refine ⟨n₁ + n₂, fun i => ?_, fun x hx' => ?_⟩
    · rw [SimpleGraph.Walk.length_cons, Pi.add_apply, Int.cast_add]
      push_cast
      exact (abs_add_le _ _).trans (by rw [add_mul, one_mul]; linarith [hn₁ i, hn₂ i])
    · rw [SimpleGraph.Walk.length_cons]
      push_cast
      have e : ω u x - ω v x + (∑ i, (((n₁ + n₂) i : ℤ) : ℝ) * ϑ i) / Lh h =
          (ω u x - ω w x + (∑ i, (n₁ i : ℝ) * ϑ i) / Lh h) +
            (ω w x - ω v x + (∑ i, (n₂ i : ℝ) * ϑ i) / Lh h) := by
        simp only [Pi.add_apply, Int.cast_add, add_mul, Finset.sum_add_distrib, add_div]
        ring
      rw [e]
      exact (abs_add_le _ _).trans (by rw [add_mul, one_mul]; linarith [hx₁ x hx', hx₂ x hx'])

/-- Reachability in the graph of `gapEdge` within a finite mode set gives a summed witness with
fewer steps than modes. -/
theorem gapEdge_reachable_sum {Mode : Type*} [Fintype Mode] {dz : ℕ}
    (ω : Mode → ℝ → ℝ) (ϑ : Fin dz → ℝ) (a r θr : ℝ) {h : ℕ} (hθ : 0 ≤ θr) (hE : 0 ≤ S.Eh h)
    {u v : Mode} (huv : (SimpleGraph.fromRel (S.gapEdge ω ϑ a r θr h)).Reachable u v) :
    ∃ n : Fin dz → ℤ, (∀ i, |(n i : ℝ)| ≤ Fintype.card Mode * S.Eh h) ∧
      ∀ x ∈ Set.Icc a (a + r),
        |ω u x - ω v x + (∑ i, (n i : ℝ) * ϑ i) / Lh h| ≤ Fintype.card Mode * θr := by
  classical
  obtain ⟨p⟩ := huv
  set q := p.toPath
  have hlen : (q.1.length : ℝ) ≤ Fintype.card Mode := by
    exact_mod_cast (q.2.length_lt).le
  obtain ⟨n, hn, hx⟩ := S.gapEdge_walk_sum ω ϑ a r θr h q.1
  exact ⟨n, fun i => (hn i).trans (mul_le_mul_of_nonneg_right hlen hE),
    fun x hx' => (hx x hx').trans (mul_le_mul_of_nonneg_right hlen hθ)⟩

end ModeSchedule

/-- A rational vector of height at most `B` in the span of vectors of height at most `B` in
`ℚⁿ` is `Σ_k (β_k / Q) v_{e k}` over a subfamily, with integers `0 < Q` and `|β_k|` at most
`n! (B · B^{n(n+1)})^n`. -/
theorem rational_span_expand_bounded {m n : ℕ} (v : Fin m → Fin n → ℚ) {B : ℕ} (hB : 1 ≤ B)
    (hv : ∀ j i, rationalHeight (v j i) ≤ B) (a : Fin n → ℚ)
    (hah : ∀ i, rationalHeight (a i) ≤ B) (ha : a ∈ Submodule.span ℚ (Set.range v)) :
    ∃ (r : ℕ) (e : Fin r ↪ Fin m) (Q : ℕ) (β : Fin r → ℤ), 0 < Q ∧
      Q ≤ n.factorial * (B * B ^ (n * n + n)) ^ n ∧
      (∀ k, (β k).natAbs ≤ n.factorial * (B * B ^ (n * n + n)) ^ n) ∧
      a = ∑ k, ((β k : ℚ) / Q) • v (e k) := by
  classical
  set A : Matrix (Fin n) (Fin m) ℚ := fun i j => v j i
  have hAcol : ∀ j, A.col j = v j := fun j => rfl
  obtain ⟨r, hrn, hrm, rows, cols, hdet, hspan⟩ := rational_pivot_minor A
  have hy : a ∈ LinearMap.range A.mulVecLin := by
    rw [Matrix.range_mulVecLin]
    have : Set.range A.col = Set.range v := by
      ext x; simp only [Set.mem_range, hAcol]
    rw [this]; exact ha
  set M := A.submatrix rows cols
  set b := a ∘ rows
  have hcr := rational_pivot_cramer_range A rows cols hdet hspan a hy
  -- clearing all denominators of the minor and the right side
  set t : (Fin r × Fin r) ⊕ Fin r → ℚ := fun p => Sum.elim (fun q => M q.1 q.2) b p
  have ht : ∀ p, rationalHeight (t p) ≤ B := by
    rintro (⟨i, k⟩ | i)
    · exact hv _ _
    · exact hah _
  obtain ⟨z, hz⟩ := rational_clear_denominators t ht
  set D0 := rationalCommonDenominator t
  have hD0 : 0 < D0 := rationalCommonDenominator_pos t
  have hD0le : D0 ≤ B ^ (n * n + n) := by
    refine (rationalCommonDenominator_le t ht).trans (pow_le_pow_right₀ hB ?_)
    simp only [Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
    have := Nat.mul_le_mul hrn hrn
    omega
  set Z : Matrix (Fin r) (Fin r) ℤ := fun i k => z (Sum.inl (i, k))
  set w : Fin r → ℤ := fun i => z (Sum.inr i)
  have hZ : (Int.castRingHom ℚ).mapMatrix Z = (D0 : ℚ) • M := by
    ext i k; simp only [RingHom.mapMatrix_apply, Matrix.map_apply, Matrix.smul_apply,
      smul_eq_mul]; exact (hz (Sum.inl (i, k))).1
  have hw : (fun i => (w i : ℚ)) = (D0 : ℚ) • b := by
    funext i; simp only [Pi.smul_apply, smul_eq_mul]; exact (hz (Sum.inr i)).1
  have hK : ∀ p, (z p).natAbs ≤ B * B ^ (n * n + n) := fun p =>
    (hz p).2.trans (Nat.mul_le_mul_left _ hD0le)
  have hdetZ : ((Z.det : ℤ) : ℚ) = (D0 : ℚ) ^ r * M.det := by
    have h0 := RingHom.map_det (Int.castRingHom ℚ) Z
    rw [hZ, Matrix.det_smul, Fintype.card_fin] at h0
    exact h0
  have hcrZ : ∀ k, ((Z.cramer w k : ℤ) : ℚ) = (D0 : ℚ) ^ r * M.cramer b k := by
    intro k
    rw [integerMatrix_cramer_cast, hZ, hw]
    rcases Nat.eq_zero_or_pos r with h0 | hpos
    · subst h0; exact k.elim0
    · rw [Matrix.cramer_smul, map_smul]
      simp only [Pi.smul_apply, smul_eq_mul]
      obtain ⟨r', rfl⟩ : ∃ r', r = r' + 1 := ⟨r - 1, by omega⟩
      simp only [Fintype.card_fin, Nat.add_sub_cancel, LinearMap.smul_apply, Pi.smul_apply,
        smul_eq_mul]
      ring
  have hD0q : (D0 : ℚ) ^ r ≠ 0 := pow_ne_zero _ (by exact_mod_cast hD0.ne')
  have hZdet : Z.det ≠ 0 := by
    intro h0
    have := hdetZ; rw [h0, Int.cast_zero] at this
    exact (mul_ne_zero hD0q hdet) this.symm
  refine ⟨r, ⟨cols, cols.injective⟩, Z.det.natAbs, fun k => Z.det.sign * Z.cramer w k,
    Int.natAbs_pos.mpr hZdet, ?_, fun k => ?_, ?_⟩
  · refine (integerMatrix_det_bound Z (fun i k => hK _)).trans ?_
    exact Nat.mul_le_mul (Nat.factorial_le hrn) (Nat.pow_le_pow_right
      (Nat.mul_pos hB (pow_pos hB _)) hrn)
  · rw [Int.natAbs_mul, Int.natAbs_sign_of_ne_zero hZdet, one_mul]
    refine (integerMatrix_cramer_bound Z w (fun i k => hK _) (fun i => hK _) k).trans ?_
    exact Nat.mul_le_mul (Nat.factorial_le hrn) (Nat.pow_le_pow_right
      (Nat.mul_pos hB (pow_pos hB _)) hrn)
  · -- the expansion
    have hratio : ∀ k, ((Z.det.sign * Z.cramer w k : ℤ) : ℚ) / (Z.det.natAbs : ℚ) =
        M.cramer b k / M.det := by
      intro k
      have hsn : ((Z.det.natAbs : ℕ) : ℚ) = (Z.det.sign : ℚ) * (Z.det : ℚ) := by
        have h1 : ((Z.det.natAbs : ℤ)) = Z.det.sign * Z.det := (Int.sign_mul_self Z.det).symm
        rw [show ((Z.det.natAbs : ℕ) : ℚ) = (((Z.det.natAbs : ℕ) : ℤ) : ℚ) from
          (Int.cast_natCast _).symm, h1, Int.cast_mul]
      have hsign : (Z.det.sign : ℚ) ≠ 0 := by
        rcases lt_or_gt_of_ne hZdet with h | h
        · rw [Int.sign_eq_neg_one_of_neg h]; norm_num
        · rw [Int.sign_eq_one_of_pos h]; norm_num
      rw [hsn, Int.cast_mul, hcrZ, hdetZ, mul_div_mul_left _ _ hsign,
        mul_div_mul_left _ _ hD0q]
    have hsum : a = ∑ k, (M.cramer b k / M.det) • v (cols k) := by
      have h2 : (M.det)⁻¹ • ((A.submatrix id cols).mulVec (M.cramer b)) = a := by
        rw [hcr, smul_smul, inv_mul_cancel₀ hdet, one_smul]
      rw [← h2]
      ext i
      simp only [Pi.smul_apply, Matrix.mulVec, dotProduct, smul_eq_mul, Finset.sum_apply]
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      have hk : A.submatrix id cols i k = v (cols k) i := rfl
      rw [hk]; ring
    rw [hsum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [hratio]; rfl

/-! ### The tiny span of a nonexceptional block (blueprint lines 1995-1997) -/

/-- The tiny vectors of height at most `H`: `|a·Θ| ≤ ε`. -/
def tinySet {d : ℕ} (Θ : Fin d → ℝ) (H : ℕ) (ε : ℝ) : Set (Fin d → ℚ) :=
  {a | vecHeight a ≤ H ∧ |ratEval Θ a| ≤ ε}

/-- The rational span `K_rat` of the tiny vectors. -/
def tinySpan {d : ℕ} (Θ : Fin d → ℝ) (H : ℕ) (ε : ℝ) : Submodule ℚ (Fin d → ℚ) :=
  Submodule.span ℚ (tinySet Θ H ε)

theorem vec_mem_piFinset_of_height {d H : ℕ} {a : Fin d → ℚ} (ha : vecHeight a ≤ H) :
    a ∈ Fintype.piFinset fun _ : Fin d => boundedRationalEnumeration H :=
  Fintype.mem_piFinset.mpr fun i => mem_boundedRationalEnumeration ((le_vecHeight a i).trans ha)

theorem card_piFinset_enum_le (d H : ℕ) (hH : 1 ≤ H) :
    ((Fintype.piFinset fun _ : Fin d => boundedRationalEnumeration H).card : ℝ) ≤
      (3 * H ^ 2 : ℝ) ^ d := by
  rw [Fintype.card_piFinset, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  push_cast
  have h := boundedRationalEnumeration_card H hH
  exact pow_le_pow_left₀ (Nat.cast_nonneg _) (by exact_mod_cast h) d

open Classical in
/-- Blueprint lines 1995-1997: at a nonexceptional block every height-`H` vector of the tiny
span is tiny. -/
theorem tiny_of_mem_tinySpan {d : ℕ} (Θ : Fin d → ℝ) {H : ℕ} (hH : 1 ≤ H) {ε Λ : ℝ}
    (hε : 0 ≤ ε)
    (hgap : ∀ a : Fin d → ℚ, vecHeight a ≤ H → |ratEval Θ a| ≤ ε ∨ Λ ≤ |ratEval Θ a|)
    (hsmall : (3 * H ^ 2 : ℝ) ^ d * (d.factorial * H ^ (d ^ 2 + d)) * ε < Λ)
    {a : Fin d → ℚ} (ha : a ∈ tinySpan Θ H ε) (haH : vecHeight a ≤ H) :
    |ratEval Θ a| ≤ ε := by
  set TF := (Fintype.piFinset fun _ : Fin d => boundedRationalEnumeration H).filter
    fun a => a ∈ tinySet Θ H ε
  set v : Fin TF.card → Fin d → ℚ := fun i => (TF.equivFin.symm i : Fin d → ℚ)
  have hv : ∀ i, v i ∈ tinySet Θ H ε := fun i => (Finset.mem_filter.mp (TF.equivFin.symm i).2).2
  have hrange : Set.range v = tinySet Θ H ε := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩; exact hv i
    · intro hx
      have hxT : x ∈ TF := Finset.mem_filter.mpr ⟨vec_mem_piFinset_of_height hx.1, hx⟩
      exact ⟨TF.equivFin ⟨x, hxT⟩, by simp [v]⟩
  have hcard : (TF.card : ℝ) ≤ (3 * H ^ 2 : ℝ) ^ d :=
    (show (TF.card : ℝ) ≤ ((Fintype.piFinset fun _ : Fin d => boundedRationalEnumeration H).card :
      ℝ) by exact_mod_cast Finset.card_filter_le _ _).trans (card_piFinset_enum_le d H hH)
  have hsmall' : (TF.card : ℝ) * (d.factorial * H ^ (d ^ 2 + d)) * ε < Λ := by
    refine lt_of_le_of_lt ?_ hsmall
    have : (0 : ℝ) ≤ d.factorial * H ^ (d ^ 2 + d) := by positivity
    gcongr
  refine tiny_span_closed Θ hH hε hgap v (fun i => (hv i).1) (fun i => (hv i).2) hsmall' a ?_ haH
  rw [hrange]; exact ha

/-! ### The stabilization core (blueprint lem:stabilize, lines 2002-2029) -/

/-- The embedding `w ↦ (0, w)` of the `ϑ`-coordinates. -/
def zEmb (dv dz : ℕ) : (Fin dz → ℚ) →ₗ[ℚ] (Fin (dv + dz) → ℚ) where
  toFun w := Fin.append (0 : Fin dv → ℚ) w
  map_add' w w' := by
    ext i; refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp [Fin.append_left,
      Fin.append_right]
  map_smul' c w := by
    ext i; refine Fin.addCases (fun j => ?_) (fun j => ?_) i <;> simp [Fin.append_left,
      Fin.append_right]

/-- The witness spans `V_i`: height-`D` vectors `q` with an integer `m`, `|m|_∞ ≤ D E_i`,
such that `q + (0, m/6^i)` lies in `K`. -/
def witnessSpan {dv dz : ℕ} (K : Submodule ℚ (Fin (dv + dz) → ℚ)) (D : ℕ) (E : ℚ) (i : ℕ) :
    Submodule ℚ (Fin (dv + dz) → ℚ) :=
  Submodule.span ℚ {q | vecHeight q ≤ D ∧ ∃ m : Fin dz → ℤ, (∀ l, |(m l : ℚ)| ≤ D * E) ∧
    q + zEmb dv dz (((6 : ℚ) ^ i)⁻¹ • integerRationalMap dz m) ∈ K}

/-- The expansion constant `d! (D · D^{d(d+1)})^d` of `rational_span_expand_bounded`. -/
def expandConst (d D : ℕ) : ℕ := d.factorial * (D * D ^ (d * d + d)) ^ d

open Classical in
/-- Blueprint lem:stabilize, core: if the witness spans and the kernel spans are stable between
`h - R` and `h`, a vector `a` of height at most `D` with a CURRENT relation
`a + (0, m_h/6^h) ∈ K`, `|m_h| ≤ D E_h`, has a witness `m'` at height `h - Δ` of size at most
`6^{R-Δ} J C D E_{h-R} + d_z S_{h-R}`, where `C` is the expansion constant and `J` the number of
height-`D` vectors. -/
theorem stabilize_core {dv dz : ℕ} (K : Submodule ℚ (Fin (dv + dz) → ℚ)) {D : ℕ} (hD : 1 ≤ D)
    (E S : ℕ → ℚ) (hE : ∀ i, 0 ≤ E i) {R Δ h : ℕ} (hΔR : Δ ≤ R) (hRh : R ≤ h)
    (hS0 : 0 ≤ S (h - R))
    (hV : witnessSpan K D (E (h - R)) (h - R) = witnessSpan K D (E h) h)
    (hU : smallKernelSpan K (zEmb dv dz) (S (h - R)) = smallKernelSpan K (zEmb dv dz) (S h))
    (hQR : expandConst (dv + dz) D < 2 ^ (R - Δ))
    (hzS : (expandConst (dv + dz) D : ℚ) * (D * E h) + 6 ^ R * ((3 * D ^ 2) ^ (dv + dz) *
      (expandConst (dv + dz) D * (D * E (h - R)))) ≤ S h)
    {a : Fin (dv + dz) → ℚ} (haD : vecHeight a ≤ D) {mh : Fin dz → ℤ}
    (hmh : ∀ l, |(mh l : ℚ)| ≤ D * E h)
    (hb : a + zEmb dv dz (((6 : ℚ) ^ h)⁻¹ • integerRationalMap dz mh) ∈ K) :
    ∃ m' : Fin dz → ℤ, a + zEmb dv dz (((6 : ℚ) ^ (h - Δ))⁻¹ • integerRationalMap dz m') ∈ K ∧
      ∀ l, |(m' l : ℚ)| ≤ 6 ^ (R - Δ) * ((3 * D ^ 2) ^ (dv + dz) *
        (expandConst (dv + dz) D * (D * E (h - R)))) + dz * S (h - R) := by
  set C := expandConst (dv + dz) D
  -- the generators of `V_{h-R}`
  set GF := (Fintype.piFinset fun _ : Fin (dv + dz) => boundedRationalEnumeration D).filter fun q =>
    vecHeight q ≤ D ∧ ∃ m : Fin dz → ℤ, (∀ l, |(m l : ℚ)| ≤ D * E (h - R)) ∧
      q + zEmb dv dz (((6 : ℚ) ^ (h - R))⁻¹ • integerRationalMap dz m) ∈ K
  set g : Fin GF.card → Fin (dv + dz) → ℚ := fun i => (GF.equivFin.symm i : Fin (dv + dz) → ℚ)
  have hgmem : ∀ i, g i ∈ GF := fun i => (GF.equivFin.symm i).2
  have hspan : Submodule.span ℚ (Set.range g) = witnessSpan K D (E (h - R)) (h - R) := by
    unfold witnessSpan
    congr 1
    ext q
    constructor
    · rintro ⟨i, rfl⟩; exact (Finset.mem_filter.mp (hgmem i)).2
    · intro hq
      have hqT : q ∈ GF := Finset.mem_filter.mpr ⟨vec_mem_piFinset_of_height hq.1, hq⟩
      exact ⟨GF.equivFin ⟨q, hqT⟩, by simp [g]⟩
  have haV : a ∈ witnessSpan K D (E (h - R)) (h - R) := by
    rw [hV]; exact Submodule.subset_span ⟨haD, mh, hmh, hb⟩
  rw [← hspan] at haV
  obtain ⟨r, e, Q, β, hQ, hQle, hβ, hexp⟩ := rational_span_expand_bounded g hD
    (fun i l => (le_vecHeight _ l).trans (Finset.mem_filter.mp (hgmem i)).2.1) a
    (fun l => (le_vecHeight a l).trans haD) haV
  have hw : ∀ k : Fin r, ∃ m : Fin dz → ℤ, (∀ l, |(m l : ℚ)| ≤ D * E (h - R)) ∧
      g (e k) + zEmb dv dz (((6 : ℚ) ^ (h - R))⁻¹ • integerRationalMap dz m) ∈ K :=
    fun k => (Finset.mem_filter.mp (hgmem (e k))).2.2
  choose mj hmj hmjK using hw
  have hr : (r : ℚ) ≤ (3 * D ^ 2 : ℚ) ^ (dv + dz) := by
    have h1 : r ≤ GF.card := by simpa using Fintype.card_le_of_injective e e.injective
    have h2 : (GF.card : ℝ) ≤ (3 * D ^ 2 : ℝ) ^ (dv + dz) :=
      (show (GF.card : ℝ) ≤ ((Fintype.piFinset fun _ : Fin (dv + dz) =>
        boundedRationalEnumeration D).card : ℝ) by exact_mod_cast Finset.card_filter_le _ _).trans
        (card_piFinset_enum_le (dv + dz) D hD)
    have : (r : ℝ) ≤ (3 * D ^ 2 : ℝ) ^ (dv + dz) :=
      (by exact_mod_cast h1 : (r : ℝ) ≤ GF.card).trans h2
    exact_mod_cast this
  have hQ1 : (1 : ℚ) ≤ Q := by exact_mod_cast hQ
  have hβq : ∀ k, |(β k : ℚ)| ≤ C := fun k => by
    have := hβ k
    rw [← Int.cast_abs, Int.abs_eq_natAbs]
    exact_mod_cast this
  -- the weighted witness sum
  have hsumβ : ∀ l, ∑ k, |(β k : ℚ)| * |(mj k l : ℚ)| ≤
      (3 * D ^ 2 : ℚ) ^ (dv + dz) * (C * (D * E (h - R))) := by
    intro l
    calc ∑ k, |(β k : ℚ)| * |(mj k l : ℚ)| ≤ ∑ _k : Fin r, (C : ℚ) * (D * E (h - R)) :=
          Finset.sum_le_sum fun k _ => mul_le_mul (hβq k) (hmj k l) (abs_nonneg _)
            (Nat.cast_nonneg _)
      _ = r * (C * (D * E (h - R))) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ ≤ _ := by
          have : (0 : ℚ) ≤ C * (D * E (h - R)) := by have := hE (h - R); positivity
          gcongr
  have hzS' : ∀ l, |(Q : ℚ) * mh l - 6 ^ R * ∑ j, (β j : ℚ) * mj j l| ≤ S h := by
    intro l
    refine le_trans ?_ hzS
    refine (abs_sub _ _).trans ?_
    gcongr
    · rw [abs_mul, Nat.abs_cast]
      exact mul_le_mul (by exact_mod_cast hQle) (hmh l) (abs_nonneg _) (Nat.cast_nonneg _)
    · rw [abs_mul, abs_of_nonneg (by positivity)]
      gcongr
      refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
      refine le_trans (le_of_eq (Finset.sum_congr rfl fun k _ => abs_mul _ _)) (hsumβ l)
  obtain ⟨m', hm', hm'b⟩ := height_stabilization K (zEmb dv dz) S hΔR hRh hS0 hU hQ
    (lt_of_le_of_lt hQle hQR) a (fun k => g (e k)) β hexp mj hmjK mh hb hzS'
  refine ⟨m', hm', fun l => (hm'b l).trans ?_⟩
  gcongr
  calc ∑ k, |(β k : ℚ) / Q| * |(mj k l : ℚ)| ≤ ∑ k, |(β k : ℚ)| * |(mj k l : ℚ)| := by
        refine Finset.sum_le_sum fun k _ => mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
        rw [abs_div, Nat.abs_cast]
        exact div_le_self (abs_nonneg _) hQ1
    _ ≤ _ := hsumβ l

theorem ratEval_zEmb {dv dz : ℕ} (Θ : Fin (dv + dz) → ℝ) (a : Fin (dv + dz) → ℚ)
    (w : Fin dz → ℚ) :
    ratEval Θ (a + zEmb dv dz w) = ratEval Θ a + ∑ l, (w l : ℝ) * Θ (Fin.natAdd dv l) := by
  unfold ratEval
  simp only [Pi.add_apply, Rat.cast_add, add_mul, Finset.sum_add_distrib]
  congr 1
  rw [Fin.sum_univ_add]
  simp [zEmb, Fin.append_left, Fin.append_right]

/-- The height of `a + (0, m/6^h)` for `|m| ≤ M`, `6^h ≤ M`: at most `3 (D M)²`. -/
theorem vecHeight_shift_le {dv dz : ℕ} {a : Fin (dv + dz) → ℚ} {D : ℕ} (haD : vecHeight a ≤ D)
    {m : Fin dz → ℤ} {h : ℕ} {M : ℕ} (hm : ∀ l, |(m l : ℝ)| ≤ M) (h6 : 6 ^ h ≤ M) :
    (vecHeight (a + zEmb dv dz (((6 : ℚ) ^ h)⁻¹ • integerRationalMap dz m)) : ℝ) ≤
      max (D : ℝ) (3 * ((D : ℝ) * M) ^ 2) := by
  have hcoord : ∀ i, (rationalHeight ((a + zEmb dv dz (((6 : ℚ) ^ h)⁻¹ •
      integerRationalMap dz m)) i) : ℝ) ≤ max (D : ℝ) (3 * ((D : ℝ) * M) ^ 2) := by
    intro i
    refine Fin.addCases (fun j => ?_) (fun l => ?_) i
    · have : (a + zEmb dv dz (((6 : ℚ) ^ h)⁻¹ • integerRationalMap dz m)) (Fin.castAdd dz j) =
          a (Fin.castAdd dz j) := by simp [zEmb, Fin.append_left]
      rw [this]
      exact le_trans (by exact_mod_cast (le_vecHeight a _).trans haD) (le_max_left _ _)
    · have e : (a + zEmb dv dz (((6 : ℚ) ^ h)⁻¹ • integerRationalMap dz m)) (Fin.natAdd dv l) =
          a (Fin.natAdd dv l) + ((m l : ℤ) : ℚ) / ((6 ^ h : ℕ) : ℤ) := by
        simp [zEmb, Fin.append_right, integerRationalMap, div_eq_inv_mul]
      rw [e]
      refine le_trans ?_ (le_max_right _ _)
      refine (rationalHeight_add_le _ _).trans ?_
      have h1 : (rationalHeight (a (Fin.natAdd dv l)) : ℝ) ≤ D := by
        exact_mod_cast (le_vecHeight a _).trans haD
      have h2 : (rationalHeight (((m l : ℤ) : ℚ) / ((6 ^ h : ℕ) : ℤ)) : ℝ) ≤ M := by
        have := rationalHeight_div_int_le (m l) ((6 ^ h : ℕ) : ℤ) (by positivity)
        refine (Nat.cast_le.mpr this).trans ?_
        rw [Nat.cast_max]
        refine max_le ?_ ?_
        · have := hm l
          rw [Nat.cast_natAbs, Int.cast_abs]; exact this
        · simp only [Int.natAbs_natCast]; exact_mod_cast h6
      have h0 : (0 : ℝ) ≤ rationalHeight (a (Fin.natAdd dv l)) := Nat.cast_nonneg _
      have h0' : (0 : ℝ) ≤ rationalHeight (((m l : ℤ) : ℚ) / ((6 ^ h : ℕ) : ℤ)) :=
        Nat.cast_nonneg _
      gcongr
  unfold vecHeight
  rcases Nat.eq_zero_or_pos (dv + dz) with h0 | hpos
  · have : (Finset.univ : Finset (Fin (dv + dz))) = ∅ := by
      rw [Finset.univ_eq_empty_iff]; rw [h0]; exact Fin.isEmpty'
    rw [this, Finset.sup_empty]; simp
  · obtain ⟨i, -, hi⟩ := Finset.exists_mem_eq_sup (Finset.univ : Finset (Fin (dv + dz)))
      ⟨⟨0, hpos⟩, Finset.mem_univ _⟩ (fun i => rationalHeight ((a + zEmb dv dz
        (((6 : ℚ) ^ h)⁻¹ • integerRationalMap dz m)) i))
    rw [hi]; exact hcoord i

namespace ModeSchedule
variable (S : ModeSchedule)

theorem Eh_nonneg (hA : 6 ≤ S.A0) (h : ℕ) : 0 ≤ S.Eh h := by
  unfold Eh; exact pow_nonneg (by linarith) _

open Classical in
/-- Blueprint lem:stabilize (lines 2002-2029) on a pre-cell `[a₀, a₀ + r_v]`: let the modes of
a fixed primary `p` differ in frequency by `a·Θ` with `a` of height at most `D`, let the block be
nonexceptional for `Θ` (`eq:gap` with `T`) and let the witness and kernel spans be stable between
`h - R` and `h`. Then two modes of the primary in one CURRENT component at height `h` are
directly PRE-adjacent at height `h - Δ`. The numeric side conditions are those of
`eq:mode-parameters`. -/
theorem stabilize_pre (hA : 6 ≤ S.A0) {Mode P : Type*} [Fintype Mode] [DecidableEq Mode]
    [DecidableEq P] {dv dz : ℕ} (ω : Mode → ℝ → ℝ) (Θ : Fin (dv + dz) → ℝ) (π : Mode → P)
    (a0 rv rt : ℝ) (hrv : 0 ≤ rv) (hrt : S.Ξ / rv ≤ S.Ξ / rt) (hΞrt : 0 ≤ S.Ξ / rt)
    {D Hn : ℕ} (hD : 1 ≤ D) (hHn : 1 ≤ Hn)
    (p : P) (hsame : ∀ x x', π x = p → π x' = p → ∃ a : Fin (dv + dz) → ℚ, vecHeight a ≤ D ∧
      ∀ y ∈ Set.Icc a0 (a0 + rv), ω x y - ω x' y = ratEval Θ a)
    {Tt : ℝ}
    (hgap : ∀ a : Fin (dv + dz) → ℚ, vecHeight a ≤ Hn →
      |ratEval Θ a| ≤ Tt⁻¹ / rv ∨ Tt / rt ≤ |ratEval Θ a|)
    (hε : 0 ≤ Tt⁻¹ / rv)
    (hsmall : (3 * Hn ^ 2 : ℝ) ^ (dv + dz) * ((dv + dz).factorial * Hn ^ ((dv + dz) ^ 2 +
      (dv + dz))) * (Tt⁻¹ / rv) < Tt / rt)
    (htiny : Tt⁻¹ / rv ≤ S.Ξ / rv)
    (Eq Sk : ℕ → ℚ) (hEq0 : ∀ i, 0 ≤ Eq i) {R Δ h : ℕ} (hΔR : Δ ≤ R) (hRh : R ≤ h)
    (hSk0 : 0 ≤ Sk (h - R))
    (hV : witnessSpan (tinySpan Θ Hn (Tt⁻¹ / rv)) D (Eq (h - R)) (h - R) =
      witnessSpan (tinySpan Θ Hn (Tt⁻¹ / rv)) D (Eq h) h)
    (hU : smallKernelSpan (tinySpan Θ Hn (Tt⁻¹ / rv)) (zEmb dv dz) (Sk (h - R)) =
      smallKernelSpan (tinySpan Θ Hn (Tt⁻¹ / rv)) (zEmb dv dz) (Sk h))
    (hQR : expandConst (dv + dz) D < 2 ^ (R - Δ))
    (hzS : (expandConst (dv + dz) D : ℚ) * (D * Eq h) + 6 ^ R * ((3 * D ^ 2) ^ (dv + dz) *
      (expandConst (dv + dz) D * (D * Eq (h - R)))) ≤ Sk h)
    (hEcur : (Fintype.card Mode : ℝ) * S.Eh h ≤ ((D * Eq h : ℚ) : ℝ))
    (hcurgap : (Fintype.card Mode : ℝ) * (S.Ξ / rt) < Tt / rt)
    {Mh Mp : ℕ} (hMh : (Fintype.card Mode : ℝ) * S.Eh h ≤ Mh) (h6h : 6 ^ h ≤ Mh)
    (hMhH : max (D : ℝ) (3 * ((D : ℝ) * Mh) ^ 2) ≤ Hn)
    (hBp : ((6 ^ (R - Δ) * ((3 * D ^ 2) ^ (dv + dz) * (expandConst (dv + dz) D *
      (D * Eq (h - R)))) + dz * Sk (h - R) : ℚ) : ℝ) ≤ S.Eh (h - Δ))
    (hMp : S.Eh (h - Δ) ≤ Mp) (h6p : 6 ^ (h - Δ) ≤ Mp)
    (hMpH : max (D : ℝ) (3 * ((D : ℝ) * Mp) ^ 2) ≤ Hn) :
    ∀ x x', π x = p → π x' = p →
      x' ∈ (S.preCurrent hA ω (fun l => Θ (Fin.natAdd dv l)) π a0 rv rt hrt).F h x →
      x' ∈ (S.preCurrent hA ω (fun l => Θ (Fin.natAdd dv l)) π a0 rv rt hrt).E (h - Δ) x := by
  intro x x' hπ hπ' hF
  set ϑ : Fin dz → ℝ := fun l => Θ (Fin.natAdd dv l)
  set K := tinySpan Θ Hn (Tt⁻¹ / rv)
  have hReach : (SimpleGraph.fromRel (S.gapEdge ω ϑ a0 rv (S.Ξ / rt) h)).Reachable x x' := by
    simp only [preCurrent, ModeComponents.ofEdges, Finset.mem_filter, Finset.mem_univ,
      true_and] at hF
    exact hF
  obtain ⟨n, hn, hnx⟩ := S.gapEdge_reachable_sum ω ϑ a0 rv (S.Ξ / rt) hΞrt
    (S.Eh_nonneg hA h) hReach
  obtain ⟨a, haD, hdiff⟩ := hsame x x' hπ hπ'
  have hy0 : a0 ∈ Set.Icc a0 (a0 + rv) := ⟨le_rfl, by linarith⟩
  -- the CURRENT relation in `K`
  set b := a + zEmb dv dz (((6 : ℚ) ^ h)⁻¹ • integerRationalMap dz n)
  have hbeval : ratEval Θ b = ω x a0 - ω x' a0 + (∑ l, (n l : ℝ) * ϑ l) / Lh h := by
    rw [ratEval_zEmb, ← hdiff a0 hy0]
    congr 1
    unfold Lh
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp [integerRationalMap, ϑ]
    ring
  have hbH : vecHeight b ≤ Hn := by
    have := vecHeight_shift_le (dv := dv) haD (m := n) (h := h) (M := Mh)
      (fun l => (hn l).trans hMh) h6h
    have h2 : (vecHeight b : ℝ) ≤ Hn := this.trans hMhH
    exact_mod_cast h2
  have hbK : b ∈ K := by
    refine Submodule.subset_span ⟨hbH, ?_⟩
    rcases hgap b hbH with h1 | h1
    · exact h1
    · exfalso
      have := hnx a0 hy0
      rw [← hbeval] at this
      linarith
  have hmh : ∀ l, |(n l : ℚ)| ≤ D * Eq h := by
    intro l
    have h1 : |(n l : ℝ)| ≤ ((D * Eq h : ℚ) : ℝ) := (hn l).trans hEcur
    exact_mod_cast h1
  obtain ⟨m', hm'K, hm'b⟩ := stabilize_core K hD Eq Sk hEq0 hΔR hRh hSk0 hV hU hQR hzS haD hmh
    hbK
  -- the PRE witness is tiny
  set b' := a + zEmb dv dz (((6 : ℚ) ^ (h - Δ))⁻¹ • integerRationalMap dz m')
  have hm'r : ∀ l, |(m' l : ℝ)| ≤ S.Eh (h - Δ) := by
    intro l
    have h1 := hm'b l
    have h2 : |(m' l : ℝ)| ≤ ((6 ^ (R - Δ) * ((3 * D ^ 2) ^ (dv + dz) * (expandConst (dv + dz) D *
        (D * Eq (h - R)))) + dz * Sk (h - R) : ℚ) : ℝ) := by exact_mod_cast h1
    exact h2.trans hBp
  have hb'H : vecHeight b' ≤ Hn := by
    have := vecHeight_shift_le (dv := dv) haD (m := m') (h := h - Δ) (M := Mp)
      (fun l => (hm'r l).trans hMp) h6p
    have h2 : (vecHeight b' : ℝ) ≤ Hn := this.trans hMpH
    exact_mod_cast h2
  have hb'tiny := tiny_of_mem_tinySpan Θ hHn hε hgap hsmall hm'K hb'H
  -- the PRE edge
  refine ModeComponents.ofEdges_E_of_pre _ _ π _ _ _ ⟨m', hm'r, fun y hy => ?_⟩
  have hb'eval : ratEval Θ b' = ω x y - ω x' y + (∑ l, (m' l : ℝ) * ϑ l) / Lh (h - Δ) := by
    rw [ratEval_zEmb, ← hdiff y hy]
    congr 1
    unfold Lh
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl fun l _ => ?_
    simp [integerRationalMap, ϑ]
    ring
  rw [← hb'eval]
  exact hb'tiny.trans htiny

end ModeSchedule

/-- The witness spans increase with height when `E_{i+1} ≥ 6 E_i` (replace `m` by `6m`). -/
theorem witnessSpan_mono {dv dz : ℕ} (K : Submodule ℚ (Fin (dv + dz) → ℚ)) (D : ℕ)
    (Eq : ℕ → ℚ) (hEq : ∀ i, 6 * Eq i ≤ Eq (i + 1)) :
    Monotone fun i => witnessSpan K D (Eq i) i := by
  refine monotone_nat_of_le_succ fun i => Submodule.span_mono ?_
  rintro q ⟨hq, m, hm, hK⟩
  refine ⟨hq, fun l => 6 * m l, fun l => ?_, ?_⟩
  · have h1 := hm l
    push_cast
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℚ) < 6)]
    have h2 : (0 : ℚ) ≤ D := Nat.cast_nonneg D
    have := hEq i
    nlinarith
  · convert hK using 3
    ext l
    simp only [integerRationalMap, LinearMap.coe_mk, AddHom.coe_mk, Pi.smul_apply, smul_eq_mul,
      Int.cast_mul, pow_succ]
    push_cast
    field_simp

/-- Blueprint line 2012 for one primary: all but `(1 + d + d_z) R` heights `h < N` are good for
the primary (the witness spans and the kernel spans are stable between `h - R` and `h`). -/
theorem bad_heights_card {dv dz : ℕ} (K : Submodule ℚ (Fin (dv + dz) → ℚ)) (D : ℕ)
    (Eq Sk : ℕ → ℚ) (hEq : ∀ i, 6 * Eq i ≤ Eq (i + 1)) (hSk : Monotone Sk) (R N : ℕ) :
    ((Finset.range N).filter fun h => ¬(R ≤ h ∧
      witnessSpan K D (Eq (h - R)) (h - R) = witnessSpan K D (Eq h) h ∧
      smallKernelSpan K (zEmb dv dz) (Sk (h - R)) =
        smallKernelSpan K (zEmb dv dz) (Sk h))).card ≤
      (1 + (dv + dz) + dz) * R := by
  classical
  have hV := rank_change_heights_card (fun i => witnessSpan K D (Eq i) i)
    (witnessSpan_mono K D Eq hEq) R N
  have hU := rank_change_heights_card (fun i => smallKernelSpan K (zEmb dv dz) (Sk i))
    (fun i j hij => smallKernelSpan_mono K (zEmb dv dz) (hSk hij)) R N
  simp only [Module.finrank_fin_fun] at hV hU
  have hsub : ((Finset.range N).filter fun h => ¬(R ≤ h ∧
      witnessSpan K D (Eq (h - R)) (h - R) = witnessSpan K D (Eq h) h ∧
      smallKernelSpan K (zEmb dv dz) (Sk (h - R)) =
        smallKernelSpan K (zEmb dv dz) (Sk h))) ⊆
      Finset.range R ∪ ((Finset.range N).filter fun h => R ≤ h ∧
        witnessSpan K D (Eq (h - R)) (h - R) ≠ witnessSpan K D (Eq h) h) ∪
        ((Finset.range N).filter fun h => R ≤ h ∧
          smallKernelSpan K (zEmb dv dz) (Sk (h - R)) ≠
            smallKernelSpan K (zEmb dv dz) (Sk h)) := by
    intro h hh
    obtain ⟨hN, hbad⟩ := Finset.mem_filter.mp hh
    simp only [Finset.mem_union, Finset.mem_range, Finset.mem_filter]
    by_cases hR : R ≤ h
    · by_cases hv : witnessSpan K D (Eq (h - R)) (h - R) = witnessSpan K D (Eq h) h
      · exact Or.inr ⟨Finset.mem_range.mp hN, hR, fun hu => hbad ⟨hR, hv, hu⟩⟩
      · exact Or.inl (Or.inr ⟨Finset.mem_range.mp hN, hR, hv⟩)
    · exact Or.inl (Or.inl (by omega))
  calc _ ≤ (Finset.range R ∪ _ ∪ _).card := Finset.card_le_card hsub
    _ ≤ (Finset.range R).card + _ + _ := (Finset.card_union_le _ _).trans
        (Nat.add_le_add_right (Finset.card_union_le _ _) _)
    _ ≤ R + (dv + dz) * R + dz * R := by rw [Finset.card_range]; omega
    _ = (1 + (dv + dz) + dz) * R := by ring

theorem eval_scaleZ {dv dz Q0 : ℕ} (hQ0 : 0 < Q0) (θv : Fin dv → ℝ) (θz : Fin dz → ℝ)
    (a : Fin (dv + dz) → ℚ) :
    ∑ i, (a i : ℝ) * Fin.append θv θz i =
      ratEval (Fin.append θv fun l => θz l / Q0) (scaleZ dv dz Q0 a) := by
  unfold ratEval scaleZ
  rw [Fin.sum_univ_add, Fin.sum_univ_add]
  simp only [Fin.append_left, Fin.append_right]
  congr 1
  refine Finset.sum_congr rfl fun l _ => ?_
  have : (Q0 : ℝ) ≠ 0 := by exact_mod_cast hQ0.ne'
  push_cast
  field_simp

theorem vecHeight_scaleZ_sub_le {dv dz Q0 : ℕ} (hQ0 : 0 < Q0) {B : ℝ} (hB : 1 ≤ B)
    {a b : Fin (dv + dz) → ℚ} (ha : ∀ i, (rationalHeight (a i) : ℝ) ≤ B)
    (hb : ∀ i, (rationalHeight (b i) : ℝ) ≤ B) :
    (vecHeight (scaleZ dv dz Q0 (a - b)) : ℝ) ≤ 2 * (Q0 * (3 * (B * B) ^ 2)) ^ 2 := by
  have hsub : ∀ i, (rationalHeight ((a - b) i) : ℝ) ≤ 3 * (B * B) ^ 2 := fun i => by
    refine (rationalHeight_sub_le _ _).trans ?_
    have h0 : (0 : ℝ) ≤ rationalHeight (a i) := Nat.cast_nonneg _
    have h0' : (0 : ℝ) ≤ rationalHeight (b i) := Nat.cast_nonneg _
    gcongr
    · exact ha i
    · exact hb i
  have hQ1 : (1 : ℝ) ≤ Q0 := by exact_mod_cast Nat.succ_le_of_lt hQ0
  have hBB : (1 : ℝ) ≤ B * B := by nlinarith
  have hT : (1 : ℝ) ≤ 3 * (B * B) ^ 2 := by
    have : (1 : ℝ) ≤ (B * B) ^ 2 := one_le_pow₀ hBB
    linarith
  have hcoord : ∀ i, (rationalHeight (scaleZ dv dz Q0 (a - b) i) : ℝ) ≤
      2 * (Q0 * (3 * (B * B) ^ 2)) ^ 2 := by
    intro i
    refine Fin.addCases (fun j => ?_) (fun l => ?_) i
    · simp only [scaleZ, Fin.append_left]
      refine (hsub _).trans ?_
      have hX1 : (1 : ℝ) ≤ (Q0 : ℝ) * (3 * (B * B) ^ 2) := one_le_mul_of_one_le_of_one_le hQ1 hT
      calc 3 * (B * B) ^ 2 ≤ (Q0 : ℝ) * (3 * (B * B) ^ 2) :=
            le_mul_of_one_le_left (by positivity) hQ1
        _ ≤ ((Q0 : ℝ) * (3 * (B * B) ^ 2)) ^ 2 := le_self_pow₀ hX1 (by norm_num)
        _ ≤ 2 * ((Q0 : ℝ) * (3 * (B * B) ^ 2)) ^ 2 := by
            nlinarith [sq_nonneg ((Q0 : ℝ) * (3 * (B * B) ^ 2))]
    · simp only [scaleZ, Fin.append_right]
      refine (rationalHeight_mul_le _ _).trans ?_
      have hQh : (rationalHeight (Q0 : ℚ) : ℝ) ≤ Q0 := by
        have := rationalHeight_intCast_bound (Q0 : ℤ) hQ1 (by simp)
        simpa using this
      have h0 : (0 : ℝ) ≤ rationalHeight (Q0 : ℚ) := Nat.cast_nonneg _
      have h0' : (0 : ℝ) ≤ rationalHeight ((a - b) (Fin.natAdd dv l)) := Nat.cast_nonneg _
      gcongr
      exact hsub _
  unfold vecHeight
  rcases Nat.eq_zero_or_pos (dv + dz) with h0 | hpos
  · have : (Finset.univ : Finset (Fin (dv + dz))) = ∅ := by
      rw [Finset.univ_eq_empty_iff]; rw [h0]; exact Fin.isEmpty'
    rw [this, Finset.sup_empty, bot_eq_zero', Nat.cast_zero]; positivity
  · obtain ⟨i, -, hi⟩ := Finset.exists_mem_eq_sup (Finset.univ : Finset (Fin (dv + dz)))
      ⟨⟨0, hpos⟩, Finset.mem_univ _⟩ (fun i => rationalHeight (scaleZ dv dz Q0 (a - b) i))
    rw [hi]; exact hcoord i

/-- The goodness of a primary `p` at height `h` (blueprint lines 2006 and 2031): the block is
nonexceptional for its frequency vector `Θ_p` (`eq:gap` with thresholds `ε, Λ` at height `Hn`),
`R ≤ h`, and its witness and kernel spans are stable between `h - R` and `h`. -/
def primaryGood {P : Type*} {dz : ℕ} (dvOf : P → ℕ) (ΘOf : ∀ p, Fin (dvOf p + dz) → ℝ)
    (Hn D : ℕ) (ε Λ : ℝ) (Eq Sk : ℕ → ℚ) (R h : ℕ) (p : P) : Prop :=
  (∀ a : Fin (dvOf p + dz) → ℚ, vecHeight a ≤ Hn →
      |ratEval (ΘOf p) a| ≤ ε ∨ Λ ≤ |ratEval (ΘOf p) a|) ∧ R ≤ h ∧
    witnessSpan (tinySpan (ΘOf p) Hn ε) D (Eq (h - R)) (h - R) =
      witnessSpan (tinySpan (ΘOf p) Hn ε) D (Eq h) h ∧
    smallKernelSpan (tinySpan (ΘOf p) Hn ε) (zEmb (dvOf p) dz) (Sk (h - R)) =
      smallKernelSpan (tinySpan (ΘOf p) Hn ε) (zEmb (dvOf p) dz) (Sk h)

namespace ModeSchedule
variable (S : ModeSchedule)

/-- Blueprint lem:stabilize for all primaries of a pre-cell at once, in the form required by the
coherence argument (`ModeComponents.good_same_predecessor`, `ModeComponents.core_good_iff`): the
primaries `p` carry frequency vectors `Θ_p = (θ_{v,p}, ϑ)` with a common `ϑ`, two modes of one
primary differ in frequency by `a·Θ_p` with `a` of height at most `D`, and the numeric side
conditions of `eq:mode-parameters` hold at every height `h ≥ R`. Then two modes of a primary
that is good at `h` lying in one CURRENT component at `h` are PRE-adjacent at `h - Δ`. -/
theorem hstab_of_primaryGood (hA : 6 ≤ S.A0) {Mode P : Type*} [Fintype Mode] [DecidableEq Mode]
    [DecidableEq P] {dz : ℕ} (ω : Mode → ℝ → ℝ) (ϑ : Fin dz → ℝ) (π : Mode → P)
    (dvOf : P → ℕ) (θvOf : ∀ p, Fin (dvOf p) → ℝ)
    (a0 rv rt : ℝ) (hrv : 0 ≤ rv) (hrt : S.Ξ / rv ≤ S.Ξ / rt) (hΞrt : 0 ≤ S.Ξ / rt)
    {D Hn : ℕ} (hD : 1 ≤ D) (hHn : 1 ≤ Hn)
    (hsame : ∀ x x', π x' = π x → ∃ a : Fin (dvOf (π x) + dz) → ℚ, vecHeight a ≤ D ∧
      ∀ y ∈ Set.Icc a0 (a0 + rv), ω x y - ω x' y = ratEval (Fin.append (θvOf (π x)) ϑ) a)
    {Tt : ℝ} (hε : 0 ≤ Tt⁻¹ / rv)
    (hsmall : ∀ p, (3 * Hn ^ 2 : ℝ) ^ (dvOf p + dz) * ((dvOf p + dz).factorial *
      Hn ^ ((dvOf p + dz) ^ 2 + (dvOf p + dz))) * (Tt⁻¹ / rv) < Tt / rt)
    (htiny : Tt⁻¹ / rv ≤ S.Ξ / rv)
    (Eq Sk : ℕ → ℚ) (hEq0 : ∀ i, 0 ≤ Eq i) (hSk0 : ∀ i, 0 ≤ Sk i) {R Δ : ℕ} (hΔR : Δ ≤ R)
    (hQR : ∀ p, expandConst (dvOf p + dz) D < 2 ^ (R - Δ))
    (hzS : ∀ p h, R ≤ h → (expandConst (dvOf p + dz) D : ℚ) * (D * Eq h) + 6 ^ R *
      ((3 * D ^ 2) ^ (dvOf p + dz) * (expandConst (dvOf p + dz) D * (D * Eq (h - R)))) ≤ Sk h)
    (hEcur : ∀ h, (Fintype.card Mode : ℝ) * S.Eh h ≤ ((D * Eq h : ℚ) : ℝ))
    (hcurgap : (Fintype.card Mode : ℝ) * (S.Ξ / rt) < Tt / rt)
    (hMh : ∀ h, ∃ Mh : ℕ, (Fintype.card Mode : ℝ) * S.Eh h ≤ Mh ∧ 6 ^ h ≤ Mh ∧
      max (D : ℝ) (3 * ((D : ℝ) * Mh) ^ 2) ≤ Hn)
    (hBp : ∀ p h, R ≤ h → ((6 ^ (R - Δ) * ((3 * D ^ 2) ^ (dvOf p + dz) *
      (expandConst (dvOf p + dz) D * (D * Eq (h - R)))) + dz * Sk (h - R) : ℚ) : ℝ) ≤
        S.Eh (h - Δ))
    (hMp : ∀ h, R ≤ h → ∃ Mp : ℕ, S.Eh (h - Δ) ≤ Mp ∧ 6 ^ (h - Δ) ≤ Mp ∧
      max (D : ℝ) (3 * ((D : ℝ) * Mp) ^ 2) ≤ Hn) :
    ∀ h x x', primaryGood dvOf (fun p => Fin.append (θvOf p) ϑ) Hn D (Tt⁻¹ / rv) (Tt / rt)
      Eq Sk R h (π x) → π x' = π x →
      x' ∈ (S.preCurrent hA ω ϑ π a0 rv rt hrt).F h x →
      x' ∈ (S.preCurrent hA ω ϑ π a0 rv rt hrt).E (h - Δ) x := by
  intro h x x' hg hπ hF
  obtain ⟨hgap, hRh, hV, hU⟩ := hg
  obtain ⟨Mh, hMh1, hMh2, hMh3⟩ := hMh h
  obtain ⟨Mp, hMp1, hMp2, hMp3⟩ := hMp h hRh
  have e : (fun l => Fin.append (θvOf (π x)) ϑ (Fin.natAdd (dvOf (π x)) l)) = ϑ :=
    funext fun l => Fin.append_right _ _ _
  have key := S.stabilize_pre hA ω (Fin.append (θvOf (π x)) ϑ) π a0 rv rt hrv hrt hΞrt hD hHn
    (π x) (fun y y' hy hy' => by
      rw [← hy]; exact hsame y y' (hy'.trans hy.symm)) hgap hε (hsmall _) htiny Eq Sk hEq0
    hΔR hRh (hSk0 _) hV hU (hQR _)
    (hzS _ h hRh) (hEcur h) hcurgap hMh1 hMh2 hMh3 (hBp _ h hRh) hMp1 hMp2 hMp3
  rw [e] at key
  exact key x x' rfl hπ hF

end ModeSchedule

open Classical in
/-- Blueprint lem:stabilize, counting part: for a primary that is nonexceptional at the block,
at most `(1 + d + d_z) R` heights `h < N` are not good for it. -/
theorem primaryGood_bad_card {P : Type*} {dz : ℕ} (dvOf : P → ℕ)
    (ΘOf : ∀ p, Fin (dvOf p + dz) → ℝ) (Hn D : ℕ) (ε Λ : ℝ) (Eq Sk : ℕ → ℚ)
    (hEq : ∀ i, 6 * Eq i ≤ Eq (i + 1)) (hSk : Monotone Sk) (R N : ℕ) (p : P)
    (hgap : ∀ a : Fin (dvOf p + dz) → ℚ, vecHeight a ≤ Hn →
      |ratEval (ΘOf p) a| ≤ ε ∨ Λ ≤ |ratEval (ΘOf p) a|) :
    ((Finset.range N).filter fun h => ¬primaryGood dvOf ΘOf Hn D ε Λ Eq Sk R h p).card ≤
      (1 + (dvOf p + dz) + dz) * R := by
  refine le_trans (Finset.card_le_card ?_) (bad_heights_card (tinySpan (ΘOf p) Hn ε) D Eq Sk
    hEq hSk R N)
  intro h hh
  obtain ⟨hN, hb⟩ := Finset.mem_filter.mp hh
  exact Finset.mem_filter.mpr ⟨hN, fun hg => hb ⟨hgap, hg⟩⟩

/-- Blueprint lines 1913 and 2005: keyed modes (one key = one primary on its first-match cell,
with one curvature and one recentring point) with slopes `ω_m(y) = 2λ_m(y - a_m) + γ_m` and
same-key frequency differences `(a - b)·(θ_v, θ_z)` with entries of height at most `B` differ
in slope by `a'·Θ'` for the normalized vector `Θ' = (θ_v, θ_z/Q₀)`, with `a'` of height at most
`2 (Q₀ · 3 B⁴)²`. -/
theorem keyed_hsame {Md Key : Type*} {dz : ℕ} (θz : Fin dz → ℝ) {Q0 : ℕ} (hQ0 : 0 < Q0)
    (left lamOf γOf : Md → ℝ) (keyOf : Md → Key) (dvOf : Key → ℕ)
    (θvOf : ∀ k, Fin (dvOf k) → ℝ) {B : ℝ} (hB : 1 ≤ B)
    (hlam : ∀ m m', keyOf m = keyOf m' → lamOf m = lamOf m')
    (hleft : ∀ m m', keyOf m = keyOf m' → left m = left m')
    (hdiff : ∀ m m', keyOf m = keyOf m' → ∃ a b : Fin (dvOf (keyOf m) + dz) → ℚ,
      (∀ i, (rationalHeight (a i) : ℝ) ≤ B) ∧ (∀ i, (rationalHeight (b i) : ℝ) ≤ B) ∧
      γOf m - γOf m' = ∑ i, ((a - b) i : ℝ) * Fin.append (θvOf (keyOf m)) θz i)
    (m m' : Md) (hk : keyOf m' = keyOf m) :
    ∃ a : Fin (dvOf (keyOf m) + dz) → ℚ, (vecHeight a : ℝ) ≤ 2 * (Q0 * (3 * (B * B) ^ 2)) ^ 2 ∧
      ∀ y, (2 * lamOf m * (y - left m) + γOf m) - (2 * lamOf m' * (y - left m') + γOf m') =
        ratEval (Fin.append (θvOf (keyOf m)) fun l => θz l / Q0) a := by
  obtain ⟨a, b, ha, hb, hγ⟩ := hdiff m m' hk.symm
  refine ⟨scaleZ (dvOf (keyOf m)) dz Q0 (a - b), vecHeight_scaleZ_sub_le hQ0 hB ha hb,
    fun y => ?_⟩
  rw [← eval_scaleZ hQ0, ← hγ, hlam m m' hk.symm, hleft m m' hk.symm]
  ring

/-- `keyed_hsame` in the form used by `ModeSchedule.hstab_of_primaryGood`: on any set of modes
(e.g. those alive on a pre-cell), with keys as primaries, slopes `ω_m(y) = 2λ_m(y - a_m) + γ_m`
and the integral height bound `D ≥ 2 (Q₀ · 3 B⁴)²`. -/
theorem keyed_hsame_nat {Mode Md Key : Type*} (ι : Mode → Md) {dz : ℕ} (θz : Fin dz → ℝ)
    {Q0 : ℕ} (hQ0 : 0 < Q0) (left lamOf γOf : Md → ℝ) (keyOf : Md → Key) (dvOf : Key → ℕ)
    (θvOf : ∀ k, Fin (dvOf k) → ℝ) {B : ℝ} (hB : 1 ≤ B)
    (hlam : ∀ m m', keyOf m = keyOf m' → lamOf m = lamOf m')
    (hleft : ∀ m m', keyOf m = keyOf m' → left m = left m')
    (hdiff : ∀ m m', keyOf m = keyOf m' → ∃ a b : Fin (dvOf (keyOf m) + dz) → ℚ,
      (∀ i, (rationalHeight (a i) : ℝ) ≤ B) ∧ (∀ i, (rationalHeight (b i) : ℝ) ≤ B) ∧
      γOf m - γOf m' = ∑ i, ((a - b) i : ℝ) * Fin.append (θvOf (keyOf m)) θz i)
    {D : ℕ} (hD : 2 * (Q0 * (3 * (B * B) ^ 2)) ^ 2 ≤ (D : ℝ)) (S : Set ℝ) :
    ∀ x x' : Mode, keyOf (ι x') = keyOf (ι x) →
      ∃ a : Fin (dvOf (keyOf (ι x)) + dz) → ℚ, vecHeight a ≤ D ∧ ∀ y ∈ S,
        (2 * lamOf (ι x) * (y - left (ι x)) + γOf (ι x)) -
          (2 * lamOf (ι x') * (y - left (ι x')) + γOf (ι x')) =
        ratEval (Fin.append (θvOf (keyOf (ι x))) fun l => θz l / Q0) a := by
  intro x x' hk
  obtain ⟨a, ha, hy⟩ := keyed_hsame θz hQ0 left lamOf γOf keyOf dvOf θvOf hB hlam hleft hdiff
    (ι x) (ι x') hk
  exact ⟨a, by exact_mod_cast ha.trans hD, fun y _ => hy y⟩

namespace ModeSchedule
variable (S : ModeSchedule)

/-! ### Persistence of edges across pre-cells (blueprint lines 2084-2086) -/

/-- An edge on a cell persists on a sub-cell with a larger threshold, for modes transported by
`f` with unchanged slopes on the sub-cell. -/
theorem gapEdge_transport {Mode Mode' : Type*} {dz : ℕ} (f : Mode → Mode') (ω : Mode → ℝ → ℝ)
    (ω' : Mode' → ℝ → ℝ) (ϑ : Fin dz → ℝ) {a r a' r' θ θ' : ℝ}
    (hω : ∀ m, ∀ y ∈ Set.Icc a' (a' + r'), ω' (f m) y = ω m y)
    (hsub : Set.Icc a' (a' + r') ⊆ Set.Icc a (a + r)) (hθ : θ ≤ θ') {h : ℕ} {m m' : Mode}
    (he : S.gapEdge ω ϑ a r θ h m m') : S.gapEdge ω' ϑ a' r' θ' h (f m) (f m') := by
  obtain ⟨n, hn, hx⟩ := he
  refine ⟨n, hn, fun x hx' => ?_⟩
  rw [hω m x hx', hω m' x hx']
  exact (hx x (hsub hx')).trans hθ

/-- Reachability in the edge graph transports along `f`. -/
theorem reachable_transport {Mode Mode' : Type*} (f : Mode → Mode') {R : Mode → Mode → Prop}
    {R' : Mode' → Mode' → Prop} (hR : ∀ m m', R m m' → R' (f m) (f m')) {x x' : Mode}
    (hx : (SimpleGraph.fromRel R).Reachable x x') :
    (SimpleGraph.fromRel R').Reachable (f x) (f x') := by
  obtain ⟨p⟩ := hx
  induction p with
  | nil => exact SimpleGraph.Reachable.refl _
  | @cons u v w hadj p ih =>
    refine SimpleGraph.Reachable.trans ?_ ih
    by_cases hfe : f u = f v
    · rw [hfe]
    · simp only [SimpleGraph.fromRel_adj] at hadj ⊢
      exact SimpleGraph.Adj.reachable (by
        simp only [SimpleGraph.fromRel_adj]
        exact ⟨hfe, hadj.2.imp (hR u v) (hR v u)⟩)

/-- Blueprint lines 1984-1986: both graphs on one pre-cell transport to a later pre-cell with the
same thresholds. -/
theorem pre_sub_later_pre (hA : 6 ≤ S.A0) {Mode Mode' P P' : Type*} [Fintype Mode]
    [DecidableEq Mode] [DecidableEq P] [Fintype Mode'] [DecidableEq Mode'] [DecidableEq P']
    {dz : ℕ} (ω : Mode → ℝ → ℝ) (ω' : Mode' → ℝ → ℝ) (ϑ : Fin dz → ℝ) (π : Mode → P)
    (π' : Mode' → P') (f : Mode → Mode') {a rv rt a' rv' rt' : ℝ}
    (hrt : S.Ξ / rv ≤ S.Ξ / rt) (hrt' : S.Ξ / rv' ≤ S.Ξ / rt')
    (hω : ∀ m, ∀ y ∈ Set.Icc a' (a' + rv'), ω' (f m) y = ω m y)
    (hsub : Set.Icc a' (a' + rv') ⊆ Set.Icc a (a + rv)) (hth : S.Ξ / rv ≤ S.Ξ / rv')
    (hth' : S.Ξ / rt ≤ S.Ξ / rt') (h : ℕ) {x x' : Mode} :
    (x' ∈ (S.preCurrent hA ω ϑ π a rv rt hrt).E h x →
      f x' ∈ (S.preCurrent hA ω' ϑ π' a' rv' rt' hrt').E h (f x)) ∧
    (x' ∈ (S.preCurrent hA ω ϑ π a rv rt hrt).F h x →
      f x' ∈ (S.preCurrent hA ω' ϑ π' a' rv' rt' hrt').F h (f x)) := by
  simp only [preCurrent, ModeComponents.ofEdges, Finset.mem_filter, Finset.mem_univ, true_and]
  exact ⟨fun hx => reachable_transport f
      (fun m m' he => S.gapEdge_transport f ω ω' ϑ hω hsub hth he) hx,
    fun hx => reachable_transport f
      (fun m m' he => S.gapEdge_transport f ω ω' ϑ hω hsub hth' he) hx⟩

end ModeSchedule

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc)

/-- Blueprint line 2005 for the frozen modes: two modes of one key differ in slope by `a·Θ'`,
`Θ' = (θ_v, θ_z/Q₀)`, with `a` of height at most `D`. -/
theorem hsame {Q0 : ℕ} (hQ0 : 0 < Q0) {D : ℕ}
    (hD : 2 * (Q0 * (3 * (Ms.Bσ * Ms.Bσ) ^ 2)) ^ 2 ≤ (D : ℝ)) {Mode : Type*} (ι : Mode → Ms.Md)
    (S : Set ℝ) :
    ∀ x x' : Mode, Ms.keyOf (ι x') = Ms.keyOf (ι x) →
      ∃ a : Fin (Ms.dvOf (Ms.keyOf (ι x)) + Ms.zc.dim) → ℚ, vecHeight a ≤ D ∧ ∀ y ∈ S,
        Ms.slope (ι x) y - Ms.slope (ι x') y =
          ratEval (Fin.append (Ms.θvOf (Ms.keyOf (ι x))) fun l => Ms.zc.θ l / Q0) a :=
  keyed_hsame_nat ι Ms.zc.θ hQ0 (fun m => dyadicGridLeft Gd (Ms.cellOf m).1 (Ms.cellOf m).2)
    Ms.lamOf Ms.γOf Ms.keyOf Ms.dvOf Ms.θvOf Ms.one_le_Bσ Ms.key_lam
    (fun m m' h => by rw [Ms.key_cell m m' h]) Ms.key_diff hD S

end ModeSystem

/-! ### The frozen mode graphs on retained pre-cells (blueprint lines 1980-1988) -/

theorem Ξ_nonneg (S : ModeSchedule) : 0 ≤ S.Ξ := by
  unfold ModeSchedule.Ξ; exact Even.pow_nonneg ⟨500, by norm_num⟩ _

/-- The block thresholds `r_t ≤ r_v` give `Ξ/r_v ≤ Ξ/r_t`. -/
theorem Ξ_div_le (S : ModeSchedule) (Gd : RealDyadicGrid) {v t : ℤ} (hvt : v ≤ t) :
    S.Ξ / dyadicGridLength Gd v ≤ S.Ξ / dyadicGridLength Gd t :=
  div_le_div_of_nonneg_left (Ξ_nonneg S) (dyadicGridLength_pos Gd t)
    ((dyadicGridLength_strictAnti Gd).antitone hvt)

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc)

/-- The PRE and CURRENT components of the frozen list at the decision depth `u` on the pre-cell
`J` (depth `J.1 = v`), with CURRENT threshold at depth `t ≥ v` (blueprint lines 1980-1988). -/
noncomputable def preComps (S : ModeSchedule) (hA : 6 ≤ S.A0) (u t : ℤ) (J : ℤ × ℤ)
    (hvt : J.1 ≤ t) : ModeComponents (Ms.alive (ancAt Gd J u)) Ms.Key :=
  S.preCurrent hA (fun x y => Ms.slope x.1 y) (fun l => Ms.zc.θ l / S.Q0)
    (fun x => Ms.keyOf x.1) (dyadicGridLeft Gd J.1 J.2) (dyadicGridLength Gd J.1)
    (dyadicGridLength Gd t) (Ξ_div_le S Gd hvt)

end ModeSystem

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

/-- The frozen mode graphs of the block `b` (`u_b = b - 4K`, `v_b = b - 2K`, `t_b = b + K`) on the
pre-cell `J`. -/
noncomputable def blockComps (b : ℤ) (J : ℤ × ℤ) :
    ModeComponents (Ms.alive (ancAt Gd J (b - 4 * S.K))) Ms.Key :=
  if h : J.1 ≤ b + S.K then Ms.preComps S hA (b - 4 * S.K) (b + S.K) J h
  else Ms.preComps S hA (b - 4 * S.K) J.1 J le_rfl

end ModeSystem

theorem dyadicGridCell_Icc_subset (Gd : RealDyadicGrid) {I J : ℤ × ℤ}
    (h : dyadicGridCell Gd J.1 J.2 ⊆ dyadicGridCell Gd I.1 I.2) :
    Set.Icc (dyadicGridLeft Gd J.1 J.2) (dyadicGridLeft Gd J.1 J.2 + dyadicGridLength Gd J.1) ⊆
      Set.Icc (dyadicGridLeft Gd I.1 I.2) (dyadicGridLeft Gd I.1 I.2 +
        dyadicGridLength Gd I.1) := by
  have hJ := dyadicGridLength_pos Gd J.1
  have hI := dyadicGridLength_pos Gd I.1
  have h1 := closure_mono h
  simp only [dyadicGridCell] at h1
  rwa [closure_Ico (by linarith), closure_Ico (by linarith)] at h1

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

/-- Inclusion of alive sets for nested decision cells. -/
def aliveMap {U U' : ℤ × ℤ}
    (hUU : dyadicGridCell Gd U'.1 U'.2 ⊆ dyadicGridCell Gd U.1 U.2) (y : Ms.alive U) :
    Ms.alive U' :=
  ⟨y.1, (Ms.mem_alive).mpr (hUU.trans ((Ms.mem_alive).mp y.2))⟩

theorem blockComps_eq {b : ℤ} {J : ℤ × ℤ} (h : J.1 ≤ b + S.K) :
    Ms.blockComps S hA b J = Ms.preComps S hA (b - 4 * S.K) (b + S.K) J h := by
  simp only [blockComps, h, ↓reduceDIte]

end ModeSystem

end Auto

