namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

/-- Blueprint lines 1984-1986 and 2178 (persistence): both graphs of the pre-cell `J` of block `b`
transport into those of the pre-cell `J' ⊆ J` of any later block `b' ≥ b`. -/
theorem blockComps_persist {b b' : ℤ} {J J' : ℤ × ℤ} (hJ : J.1 = b - 2 * S.K)
    (hJ' : J'.1 = b' - 2 * S.K) (hbb : b ≤ b')
    (hsub : dyadicGridCell Gd J'.1 J'.2 ⊆ dyadicGridCell Gd J.1 J.2) (h : ℕ)
    (hUU : dyadicGridCell Gd (ancAt Gd J' (b' - 4 * S.K)).1 (ancAt Gd J' (b' - 4 * S.K)).2 ⊆
      dyadicGridCell Gd (ancAt Gd J (b - 4 * S.K)).1 (ancAt Gd J (b - 4 * S.K)).2)
    {x y : Ms.alive (ancAt Gd J (b - 4 * S.K))} :
    (y ∈ (Ms.blockComps S hA b J).E h x →
      Ms.aliveMap hUU y ∈ (Ms.blockComps S hA b' J').E h (Ms.aliveMap hUU x)) ∧
    (y ∈ (Ms.blockComps S hA b J).F h x →
      Ms.aliveMap hUU y ∈ (Ms.blockComps S hA b' J').F h (Ms.aliveMap hUU x)) := by
  have hK : (0 : ℤ) ≤ S.K := Nat.cast_nonneg _
  have h1 : J.1 ≤ b + S.K := by rw [hJ]; omega
  have h2 : J'.1 ≤ b' + S.K := by rw [hJ']; omega
  rw [Ms.blockComps_eq S hA h1, Ms.blockComps_eq S hA h2]
  exact S.pre_sub_later_pre (Mode := Ms.alive (ancAt Gd J (b - 4 * S.K)))
    (Mode' := Ms.alive (ancAt Gd J' (b' - 4 * S.K))) (P := Ms.Key) (P' := Ms.Key) hA
    (fun x y => Ms.slope x.1 y) (fun x y => Ms.slope x.1 y) (fun l => Ms.zc.θ l / S.Q0)
    (fun x => Ms.keyOf x.1) (fun x => Ms.keyOf x.1) (Ms.aliveMap hUU) (Ξ_div_le S Gd h1)
    (Ξ_div_le S Gd h2) (fun _ _ _ => rfl) (dyadicGridCell_Icc_subset Gd hsub)
    (Ξ_div_le S Gd (by rw [hJ, hJ']; omega)) (Ξ_div_le S Gd (by omega)) h

end ModeSystem

