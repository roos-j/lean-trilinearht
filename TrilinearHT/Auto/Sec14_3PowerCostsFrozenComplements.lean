theorem band_stack_le (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ)
    (f : ℕ × (Fin fp.P → bf.Vtx → Prop))
    (hf : ∀ i j : Fin fp.P, i ≤ j → ∀ x, f.2 i x → f.2 j x)
    (xs' : List (ℕ × (Fin fp.P → bf.Vtx → Prop))) (y : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    ∑ q ∈ Finset.range (fp.P + 1),
