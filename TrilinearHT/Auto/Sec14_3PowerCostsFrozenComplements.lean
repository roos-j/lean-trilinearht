/-- Blueprint line 2373 ("Cauchy-Schwarz in groups"): the group sum of three strong factors is at
most the product of their group square-sum roots, the third one bounding each of its terms. -/
theorem group_triple_le {ι : Type*} (s : Finset ι) (x y z : ι → ℝ) :
    ∑ G ∈ s, |x G| * |y G| * |z G| ≤
      Real.sqrt (∑ G ∈ s, x G ^ 2) * Real.sqrt (∑ G ∈ s, y G ^ 2) *
        Real.sqrt (∑ G ∈ s, z G ^ 2) := by
  have hz : ∀ G ∈ s, |z G| ≤ Real.sqrt (∑ G ∈ s, z G ^ 2) := by
    intro G hG
    rw [← Real.sqrt_sq_eq_abs]
    exact Real.sqrt_le_sqrt (Finset.single_le_sum (f := fun G => z G ^ 2)
      (fun _ _ => sq_nonneg _) hG)
  have hcs : ∑ G ∈ s, |x G| * |y G| ≤
      Real.sqrt (∑ G ∈ s, x G ^ 2) * Real.sqrt (∑ G ∈ s, y G ^ 2) := by
    have := Real.sum_mul_le_sqrt_mul_sqrt s (fun G => |x G|) (fun G => |y G|)
    simpa only [sq_abs] using this
  calc ∑ G ∈ s, |x G| * |y G| * |z G| ≤
      ∑ G ∈ s, |x G| * |y G| * Real.sqrt (∑ G ∈ s, z G ^ 2) :=
        Finset.sum_le_sum fun G hG => mul_le_mul_of_nonneg_left (hz G hG) (by positivity)
    _ = (∑ G ∈ s, |x G| * |y G|) * Real.sqrt (∑ G ∈ s, z G ^ 2) := by rw [Finset.sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right hcs (Real.sqrt_nonneg _)

