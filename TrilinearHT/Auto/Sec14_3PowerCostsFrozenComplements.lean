namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-! ### Global transfer steps of a pair of positive chains (blueprint lines 2386-2391) -/

/-- The merged cell-independent descriptors of the filters of a pair of positive chains. -/
def mergeDesc (s : ℕ) (c d : Fin 4) (t t' : List ℕ) : List (Bool × ℕ × Option ℕ) :=
  rankMerge Prod.fst (ap.slotDesc s c t) (ap.slotDesc s d t')

/-- The raw transfer step of a descriptor at a cell. -/
noncomputable def cellStep (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (e : Bool × ℕ × Option ℕ) :
    Bool × (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) ×
      (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) :=
  ap.toStep (cat c) (cat d) hcat rH I
    (e.1, e.2.1, fun p : Fin ap.P => ap.stepMask G (ap.leafJ s (if e.1 then c else d)) e.2.2 p I)

/-- The transfer steps of a pair of positive chains at a cell are the pad steps of the cell steps
of the merged descriptors. -/
theorem chainSteps_eq_desc (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) :
    ap.chainSteps cat hcat rH s c d G I t t' =
      (ap.mergeDesc s c d t t').map fun e => padStep (ap.cellStep cat hcat rH s c d G I e) := by
  unfold chainSteps mergeDesc
  rw [ap.slotFilt_eq, ap.slotFilt_eq, rankMerge_map Prod.fst Prod.fst
    (fun e => (e.1, fun p : Fin ap.P => ap.stepMask G (ap.leafJ s c) e.2 p I))
    (fun e => (e.1, fun p : Fin ap.P => ap.stepMask G (ap.leafJ s d) e.2 p I))
    (fun _ => rfl) (fun _ => rfl), List.map_map, List.map_map]
  refine List.map_congr_left fun e _ => ?_
  simp only [Function.comp_apply, cellStep, padStep]
  cases e.1 <;> rfl

/-- On an active cell the global step at its depth is intertwined with the cell step by the
restriction to the cell. -/
theorem gStep_rel (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (e : Bool × ℕ × Option ℕ) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    StepRel (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2))
      (ap.gStep cat hcat hR hbc hbh rH s c d G e I.1) (ap.cellStep cat hcat rH s c d G I e) := by
  refine ⟨rfl, fun p => ?_, fun p => ?_⟩
  · exact ap.gMask_restrict hcat hR hbh rH _ _ hI
  · have h := ap.gMask_restrict (cat (if e.1 then c else d)) hR (hbc _) e.2.1
      (ap.stepMask G (ap.leafJ s (if e.1 then c else d)) e.2.2 p)
      (ap.stepMask_mono G _ e.2.2 p) hI
    refine h.trans ?_
    unfold cellStep toStep
    cases e.1 <;> rfl

theorem gSteps_rel (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    List.Forall₂ (StepRel (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2)))
      (D.map fun e => ap.gStep cat hcat hR hbc hbh rH s c d G e I.1)
      (D.map fun e => ap.cellStep cat hcat rH s c d G I e) := by
  induction D with
  | nil => exact List.Forall₂.nil
  | cons e D ih =>
    exact List.Forall₂.cons (ap.gStep_rel cat hcat hR hbc hbh rH s c d G e hI) ih

