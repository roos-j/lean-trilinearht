open Classical in
/-- Cells of one depth inside a cell have total length at most its length. -/
theorem sum_length_depth_le (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (J : ℤ × ℤ) (d : ℤ) :
    ∑ I ∈ S.filter (fun I => I.1 = d ∧
        dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2), dyadicGridLength G I.1 ≤
      dyadicGridLength G J.1 := by
  set T := S.filter (fun I => I.1 = d ∧ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2)
  have hdis : Set.PairwiseDisjoint (T : Set (ℤ × ℤ)) fun I => dyadicGridCell G I.1 I.2 :=
    cells_pairwiseDisjoint_of_depth G T fun I hI => (Finset.mem_filter.mp hI).2.1
  have hvol : volume (⋃ I ∈ T, dyadicGridCell G I.1 I.2) =
      ∑ I ∈ T, ENNReal.ofReal (dyadicGridLength G I.1) := by
    rw [measure_biUnion_finset hdis fun I _ => dyadicGridCell_measurable G I.1 I.2]
    exact Finset.sum_congr rfl fun I _ => dyadicGridCell_volume G I.1 I.2
  have hsub : (⋃ I ∈ T, dyadicGridCell G I.1 I.2) ⊆ dyadicGridCell G J.1 J.2 :=
    Set.iUnion₂_subset fun I hI => (Finset.mem_filter.mp hI).2.2
  have hle := measure_mono (μ := volume) hsub
  rw [hvol, dyadicGridCell_volume, ← ENNReal.ofReal_sum_of_nonneg fun I _ =>
    (dyadicGridLength_pos G I.1).le] at hle
  exact (ENNReal.ofReal_le_ofReal_iff (dyadicGridLength_pos G J.1).le).mp hle

