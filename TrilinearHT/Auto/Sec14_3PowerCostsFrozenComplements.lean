/-- The near band form at a use: the band sum of the cell form with the band families `X, Y` in
the slots `a, e`, the side `W` in the slot `b` and the complement `F` in the slot `f`. -/
noncomputable def nearForm (I : ℤ × ℤ) (a b e f : Fin 4) (z : Fin 4 → ColumnL2 (Fin ap.Mc))
    {β : Type*} (u : Finset β) (X Y : β → ColumnL2 (Fin ap.Mc)) (W F : ColumnL2 (Fin ap.Mc)) :
    ℂ :=
  ∑ p ∈ u, ap.Λc I (Function.update (Function.update (Function.update
    (Function.update z f F) a (X p)) b W) e (Y p))

/-- The near band form is additive in the band family `Y` and the complement `F`. -/
theorem nearForm_freeze (I : ℤ × ℤ) {a b e f : Fin 4} (_hae : a ≠ e) (_hbe : b ≠ e) (hef : e ≠ f)
    (haf : a ≠ f) (hbf : b ≠ f) (z : Fin 4 → ColumnL2 (Fin ap.Mc)) {β : Type*} (u : Finset β)
    (X Yc Yb : β → ColumnL2 (Fin ap.Mc)) (W Fc Fb : ColumnL2 (Fin ap.Mc)) :
    ap.nearForm I a b e f z u X Yc W Fc =
      ap.nearForm I a b e f z u X Yb W Fb + ap.nearForm I a b e f z u X (Yc - Yb) W Fc +
        ap.nearForm I a b e f z u X Yc W (Fc - Fb) -
        ap.nearForm I a b e f z u X (Yc - Yb) W (Fc - Fb) := by
  unfold nearForm
  simp only [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun p _ => ?_
  have hre : ∀ (F Y : ColumnL2 (Fin ap.Mc)), Function.update (Function.update (Function.update
      (Function.update z f F) a (X p)) b W) e Y = Function.update (Function.update
        (Function.update (Function.update z a (X p)) b W) e Y) f F := by
    intro F Y
    funext l
    simp only [Function.update_apply]
    split_ifs <;> simp_all
  simp only [hre, Pi.sub_apply]
  exact freeze_four (ap.Λc I) hef _ (Yc p) (Yb p) Fc Fb

