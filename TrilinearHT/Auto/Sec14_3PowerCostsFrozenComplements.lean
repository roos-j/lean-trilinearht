section RankMergeMap
variable {α β : Type*}

/-- Mapping both lists by key-preserving maps commutes with the rank merge. -/
theorem rankMerge_map (key : α → ℕ) (key' : β → ℕ) (f g : α → β) (hf : ∀ x, key' (f x) = key x)
    (hg : ∀ x, key' (g x) = key x) :
    ∀ xs ys : List α, rankMerge key' (xs.map f) (ys.map g) =
      (rankMerge key xs ys).map fun e => (e.1, if e.1 then f e.2 else g e.2)
  | [], ys => by simp [rankMerge, List.map_map, Function.comp_def]
  | x :: xs, [] => by simp [rankMerge, List.map_map, Function.comp_def]
  | x :: xs, y :: ys => by
    simp only [List.map_cons]
    rw [rankMerge, rankMerge, hf, hg]
    split_ifs
    · rw [List.map_cons, ← List.map_cons, rankMerge_map key key' f g hf hg xs (y :: ys)]
      simp
    · rw [List.map_cons, ← List.map_cons, rankMerge_map key key' f g hf hg (x :: xs) ys]
      simp
termination_by xs ys => xs.length + ys.length

end RankMergeMap

section StepIntertwine
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

theorem padFam_intertwine {P : ℕ} (r : E →L[ℂ] E) (Qg Ql : Fin P → E →L[ℂ] E)
    (h : ∀ p, r.comp (Qg p) = (Ql p).comp r) (n : ℕ) (y : E) :
    r (padFam Qg n y) = padFam Ql n (r y) := by
  unfold padFam
  split_ifs with h0 h1
  · simp
  · exact DFunLike.congr_fun (h _) y
  · rfl

theorem filterAvg_intertwine {P : ℕ} (r : E →L[ℂ] E) (Qg Ql : Fin P → E →L[ℂ] E)
    (h : ∀ p, r.comp (Qg p) = (Ql p).comp r) (y : E) :
    r (filterAvg P (padFam Qg) y) = filterAvg P (padFam Ql) (r y) := by
  rw [filterAvg_padFam, filterAvg_padFam]
  exact DFunLike.congr_fun (opAvg_intertwine Qg Ql r h) y

/-- The complement values of intertwined step lists are intertwined. -/
theorem chainVal_intertwine {P : ℕ} (r : E →L[ℂ] E) (v : Bool) :
    ∀ (gs ls : List (Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E))),
      List.Forall₂ (StepRel r) gs ls → ∀ y : E,
      r (chainVal P v (gs.map padStep) y) = chainVal P v (ls.map padStep) (r y)
  | [], [], _, y => rfl
  | sg :: gs, sl :: ls, List.Forall₂.cons hs hrest, y => by
    obtain ⟨h1, -, h3⟩ := hs
    simp only [List.map_cons, chainVal, padStep]
    rw [h1]
    split_ifs
    · rw [filterAvg_intertwine r _ _ h3, chainVal_intertwine r v gs ls hrest y]
    · exact chainVal_intertwine r v gs ls hrest y

/-- The helper prefix of a step list: the helper averages applied in step order. -/
noncomputable def helpPre (P : ℕ) : List (TransferStep E) → E → E
  | [], x => x
  | st :: rest, x => helpPre P rest (filterAvg P st.2.1 x)

theorem helpPre_intertwine {P : ℕ} (r : E →L[ℂ] E) :
    ∀ (gs ls : List (Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E))),
      List.Forall₂ (StepRel r) gs ls → ∀ x : E,
      r (helpPre P (gs.map padStep) x) = helpPre P (ls.map padStep) (r x)
  | [], [], _, x => rfl
  | sg :: gs, sl :: ls, List.Forall₂.cons hs hrest, x => by
    obtain ⟨-, h2, -⟩ := hs
    simp only [List.map_cons, helpPre, padStep]
    rw [helpPre_intertwine r gs ls hrest, filterAvg_intertwine r _ _ h2]

end StepIntertwine

section DefectSteps
variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-! ### The band defects as a sum over the steps (blueprint lines 2252-2258) -/

/-- The selected band defect of one step `st`, with the later steps `rest` and the helper input
`xa` of the step. -/
noncomputable def defTerm (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel]
    (st : TransferStep E) (rest : List (TransferStep E)) (xa : E) : ℂ :=
  ∑ p ∈ Finset.range (P + 1), ∑ q ∈ (Finset.range (P + 1)).filter (sel p),
    (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
      (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
        (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
          (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
            st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))

/-- The selected band defects are the sum over the steps of their defects at the helper prefix
of the earlier steps. -/
theorem chainDefectSel_eq_sum (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel] :
    ∀ (steps : List (TransferStep E)) (xa : E),
      chainDefectSel Λ P a c d x yc yd sel steps xa =
        ∑ j : Fin steps.length, defTerm Λ P a c d x yc yd sel steps[j] (steps.drop (j + 1))
          (helpPre P (steps.take j) xa)
  | [], xa => by simp [chainDefectSel]
  | st :: rest, xa => by
    rw [chainDefectSel, chainDefectSel_eq_sum Λ P a c d x yc yd sel rest (filterAvg P st.2.1 xa)]
    have e : ∀ f : Fin (st :: rest).length → ℂ, ∑ j, f j = f ⟨0, by simp⟩ +
        ∑ j : Fin rest.length, f ⟨j + 1, by simp⟩ := fun f =>
      Fin.sum_univ_succ (n := rest.length) f
    rw [e]
    simp only [zero_add, List.take_zero, helpPre, List.drop_succ_cons, List.take_succ_cons]
    rfl

end DefectSteps

