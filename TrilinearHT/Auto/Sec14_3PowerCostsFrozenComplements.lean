    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun J _ => Finset.sum_congr rfl fun I _ => ?_
    split_ifs <;> ring
  rw [hswap, Finset.mul_sum]
  refine Finset.sum_le_sum fun J hJ => ?_
  -- descendants within `K` depths: at most `K` depths, each of total length at most `|J|`
  have hdesc : ∑ I ∈ S.filter (fun I => dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 ∧
      I.1 < J.1 + K), dyadicGridLength G I.1 ≤ K * dyadicGridLength G J.1 := by
    have hdepth : ∀ I ∈ S.filter (fun I => dyadicGridCell G I.1 I.2 ⊆
        dyadicGridCell G J.1 J.2 ∧ I.1 < J.1 + K),
        I.1 ∈ (Finset.range K).image (fun n : ℕ => J.1 + n) := by
      intro I hI
      obtain ⟨-, hsub, hlt⟩ := Finset.mem_filter.mp hI
      have hge := dyadicGridCell_depth_le_of_subset G I J hsub
      refine Finset.mem_image.mpr ⟨(I.1 - J.1).toNat, Finset.mem_range.mpr (by omega), by omega⟩
    rw [← Finset.sum_fiberwise_of_maps_to hdepth]
    calc ∑ d ∈ (Finset.range K).image (fun n : ℕ => J.1 + n), ∑ I ∈ (S.filter fun I =>
          dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 ∧ I.1 < J.1 + K).filter
            (fun I => I.1 = d), dyadicGridLength G I.1 ≤
        ∑ _d ∈ (Finset.range K).image (fun n : ℕ => J.1 + n), dyadicGridLength G J.1 := by
          refine Finset.sum_le_sum fun d _ => le_trans ?_ (sum_length_depth_le G S J d)
          refine Finset.sum_le_sum_of_subset_of_nonneg (fun I hI => ?_)
            fun I _ _ => (dyadicGridLength_pos G I.1).le
          obtain ⟨hI1, hd⟩ := Finset.mem_filter.mp hI
          obtain ⟨hIS, hsub, -⟩ := Finset.mem_filter.mp hI1
          exact Finset.mem_filter.mpr ⟨hIS, hd, hsub⟩
      _ ≤ K * dyadicGridLength G J.1 := by
          have hcard : (((Finset.range K).image (fun n : ℕ => J.1 + n)).card : ℝ) ≤ K := by
            exact_mod_cast Finset.card_image_le.trans (Finset.card_range K).le
          rw [Finset.sum_const, nsmul_eq_mul]
          exact mul_le_mul_of_nonneg_right hcard (dyadicGridLength_pos G J.1).le
  calc w J * _ ≤ w J * (K * dyadicGridLength G J.1) := mul_le_mul_of_nonneg_left hdesc (hw J hJ)
    _ = K * (dyadicGridLength G J.1 * w J) := by ring

