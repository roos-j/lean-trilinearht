  rw [fp.basic_history l s mb ls hI]
  exact bf.proj_bridge l fp.Mc s mb (fp.crank m) (fun c => fp.cmask c m (p + 1)) _ hI _

/-- Blueprint line 2386 ("their current local `L²` norms are bounded: pad bands are orthogonal at
