/-- Reindexing the offset bands into all bands. -/
theorem sum_uo_le (o : ℕ) (g : ℕ → ℝ) (hg : ∀ n, 0 ≤ g n) :
    ∑ p ∈ ap.uo o, g (p + o - 2) ≤ ∑ n ∈ Finset.range (ap.P + 1), g n := by
  rw [← Finset.sum_image (f := g) (g := fun p => p + o - 2) (fun p hp p' hp' h => by
    have h1 := (Finset.mem_filter.mp hp).2.1
    have h2 := (Finset.mem_filter.mp hp').2.1
    simp only at h
    omega)]
  refine Finset.sum_le_sum_of_subset_of_nonneg (fun n hn => ?_) fun n _ _ => hg n
  obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp hn
  have := (Finset.mem_filter.mp hp).2.2
  exact Finset.mem_range.mpr (by omega)

/-- Blueprint lines 2388-2389 ("their current local `L²` norms are bounded"): at an active cell
where both complement slots are basic with inputs of normalized size at most `C`, the current
complement bands of every step and offset and the current other complement have restricted
squares at most `C² |J|`. -/
theorem cur_bounds {J : ℤ × ℤ} (hJ : J ∈ A.cells) (c d : Fin 4) (G : A.Grp) (t t' : List ℕ)
    (j o : ℕ) {C : ℝ}
    (hzc : ap.z J c = A.B c J)
    (hPc : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G J.1 J.2 →
      A.B c J y = (T.P₁ c).val J y - (T.P₂ c).val J y)
    (hzd : ap.z J d = A.B d J)
    (hPd : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G J.1 J.2 →
      A.B d J y = (T.P₁ d).val J y - (T.P₂ d).val J y)
    (hsc : ‖physicalColumnInput (V := Fin ap.Mc) (ap.base J c)‖ ≤
      C * Real.sqrt (dyadicGridLength A.G J.1))
    (hsd : ‖physicalColumnInput (V := Fin ap.Mc) (ap.base J d)‖ ≤
      C * Real.sqrt (dyadicGridLength A.G J.1)) :
    ∑ p ∈ ap.uo o, ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2)
        (dyadicGridCell_measurable A.G J.1 J.2) (T.Y c d G t t' j o J.1 p)‖ ^ 2 ≤
      C ^ 2 * dyadicGridLength A.G J.1 ∧
    ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
      (T.F c d G t t' j J.1)‖ ^ 2 ≤ C ^ 2 * dyadicGridLength A.G J.1 := by
  set rJ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G J.1 J.2)
    (dyadicGridCell_measurable A.G J.1 J.2) with hrJ
  have hL := dyadicGridLength_pos A.G J.1
  have hJN : J.1 ≤ A.R.1 + A.treeDepth :=
    ((dyadicFiniteTree_mem_iff A.G A.R J A.treeDepth).mp (A.cells_mem_tree hJ)).2
  set Dl := T.desc c d t t' with hDl
  have hV : ∀ (v : Bool) (x : ColumnL2 (Fin ap.Mc)),
      ‖rJ (chainVal ap.P v (ap.gRest T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G Dl j J.1) x)‖ ≤
        ‖rJ x‖ := by
    intro v x
    unfold gRest
    rw [chainVal_intertwine rJ v _ _ (ap.gSteps_rel T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G
      (Dl.drop (j + 1)) hJ) x]
    exact ap.norm_chainVal_cell_le T.cat T.hcat T.rH T.s c d G J v _ _
  have hIn : ∀ b : Bool, ‖rJ (if b then ap.gIn (T.P₁ d) (T.P₂ d) J.1 else
      ap.gIn (T.P₁ c) (T.P₂ c) J.1)‖ ≤ C * Real.sqrt (dyadicGridLength A.G J.1) ∧
      ‖rJ (if b then ap.gIn (T.P₁ c) (T.P₂ c) J.1 else
      ap.gIn (T.P₁ d) (T.P₂ d) J.1)‖ ≤ C * Real.sqrt (dyadicGridLength A.G J.1) := by
    have ec := ap.base_eq_gIn c hJ hzc (T.P₁ c) (T.P₂ c) hPc
    have ed := ap.base_eq_gIn d hJ hzd (T.P₁ d) (T.P₂ d) hPd
    intro b
    cases b
    · simp only [Bool.false_eq_true, ↓reduceIte]
      exact ⟨by rw [← ec]; exact hsc, by rw [← ed]; exact hsd⟩
    · simp only [↓reduceIte]
      exact ⟨by rw [← ed]; exact hsd, by rw [← ec]; exact hsc⟩
  have hC0 : 0 ≤ C * Real.sqrt (dyadicGridLength A.G J.1) := (norm_nonneg _).trans hsc
  constructor
  · unfold Y Yfr
    set e := Dl.getD j (true, 0, none) with he
    set V := chainVal ap.P (ap.gSt T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G Dl j J.1).1
      (ap.gRest T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G Dl j J.1)
      (if (ap.gSt T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G Dl j J.1).1 then
        ap.gIn (T.P₁ c) (T.P₂ c) J.1 else ap.gIn (T.P₁ d) (T.P₂ d) J.1) with hVdef
    set Qg : Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) := fun p =>
      ((ap.cumBase (T.cat (if e.1 then c else d)) T.hR (T.hbc _)).withMask
        (ap.gMask (T.cat (if e.1 then c else d)) T.hR (T.hbc _) e.2.1
          (ap.stepMask G (ap.leafJ T.s (if e.1 then c else d)) e.2.2 p)
          (ap.stepMask_mono G _ e.2.2 p))).proj J.1 with hQg
    have hY : ∀ m (y : ColumnL2 (Fin ap.Mc)),
        (ap.gSt T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G Dl j J.1).2.2 m y =
          padFamC Qg m y := fun m y => padFam_apply_eq Qg m y
    have hVb : ‖rJ V‖ ≤ C * Real.sqrt (dyadicGridLength A.G J.1) :=
      (hV _ _).trans (hIn _).2
    calc ∑ p ∈ ap.uo o, ‖rJ ((ap.gSt T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G Dl j J.1).2.2
          (p + o - 2 + 1) V - (ap.gSt T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G Dl j J.1).2.2
            (p + o - 2) V)‖ ^ 2
        = ∑ p ∈ ap.uo o, ‖rJ ((padFamC Qg (p + o - 2 + 1) - padFamC Qg (p + o - 2)) V)‖ ^ 2 := by
          refine Finset.sum_congr rfl fun p _ => ?_
          rw [hY, hY, sub_apply]
      _ ≤ ∑ n ∈ Finset.range (ap.P + 1), ‖rJ ((padFamC Qg (n + 1) - padFamC Qg n) V)‖ ^ 2 :=
          sum_uo_le (ap := ap) o (fun n => ‖rJ ((padFamC Qg (n + 1) - padFamC Qg n) V)‖ ^ 2)
            fun n => sq_nonneg _
      _ ≤ ‖rJ V‖ ^ 2 := ap.compBand_bessel _ T.hR (T.hbc _) e.2.1 G _ e.2.2 J.1 J le_rfl hJN V
      _ ≤ (C * Real.sqrt (dyadicGridLength A.G J.1)) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hVb 2
      _ = _ := by rw [mul_pow, Real.sq_sqrt hL.le]
  · unfold F Ffr
    have h := (hV (!(ap.gSt T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G Dl j J.1).1) _).trans
      (hIn ((ap.gSt T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G Dl j J.1).1)).1
    calc _ ≤ (C * Real.sqrt (dyadicGridLength A.G J.1)) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) h 2
      _ = _ := by rw [mul_pow, Real.sq_sqrt hL.le]

end TTData

