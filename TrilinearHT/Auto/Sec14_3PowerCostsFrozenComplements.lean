namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- With `‖Y‖ ≤ 2` and `‖U‖ ≤ 2`, the physical base input of a basic slot has norm at most
`4 √|I|`. -/
theorem base_size (I : ℤ × ℤ) (hY : ∀ l, (eLpNorm (A.Y I l) 2 (A.μ I)).toReal ≤ 2)
    (hU : ∀ l, (eLpNorm (A.U l I) 2 (A.μ I)).toReal ≤ 2) (c : Fin 4) (hz : ap.z I c = A.B c I) :
    ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I c)‖ ≤
      4 * Real.sqrt (dyadicGridLength A.G I.1) := by
  have hL := dyadicGridLength_pos A.G I.1
  have hs := Real.sqrt_pos.mpr hL
  have hb : ap.base I c = cellLp A.G I (A.B c I) := by unfold base; rw [hz]
  have hsum : cellLp A.G I (A.Y I c) = cellLp A.G I (A.B c I) +
      cellLp A.G I (if c = A.a ∨ c = A.b then A.U c I else 0) :=
    cellLp_add (A.B_memLp c I) (Y_corr_memLp I c)
  have hV : (eLpNorm (if c = A.a ∨ c = A.b then A.U c I else 0) 2 (A.μ I)).toReal ≤ 2 := by
    split_ifs
    · exact hU c
    · simp
  have hYm : MemLp (A.Y I c) 2 (A.μ I) := (A.B_memLp c I).add (Y_corr_memLp I c)
  have h1 := norm_cellLp_div_le (Mc := ap.Mc) hYm (by norm_num) (hY c)
  have h2 := norm_cellLp_div_le (Mc := ap.Mc) (Y_corr_memLp I c) (by norm_num) hV
  rw [div_le_iff₀ hs] at h1 h2
  have e : physicalColumnInput (V := Fin ap.Mc) (ap.base I c) =
      physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.Y I c)) -
        physicalColumnInput (V := Fin ap.Mc)
          (cellLp A.G I (if c = A.a ∨ c = A.b then A.U c I else 0)) := by
    rw [hb, hsum, physicalColumnInput_add, add_sub_cancel_right]
  rw [e]
  refine (norm_sub_le _ _).trans ?_
  linarith

end AttemptParams

