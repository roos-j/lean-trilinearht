theorem norm_Λc_le (I : ℤ × ℤ) (x : Fin 4 → ColumnL2 (Fin ap.Mc)) :
    ‖ap.Λc I x‖ ≤ localFormUniformConstant κ' *
      ∏ l, (‖x l‖ / Real.sqrt (dyadicGridLength A.G I.1)) := by
