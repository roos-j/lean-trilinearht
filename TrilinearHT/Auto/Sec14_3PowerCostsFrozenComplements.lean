      (Function.update x f F) a (X p)) b W) e (Y p))‖ ≤
      localFormUniformConstant κ' * ((‖rI F‖ / s) * (‖rI W‖ / s) *
        ((‖rI (X p)‖ / s) * (‖rI (Y p)‖ / s))) := by
    intro p
    refine (ap.norm_Λc_le_restrict I _).trans (le_of_eq ?_)
    rw [prod_fin4_distinct hab hae haf hbe hbf hef]
