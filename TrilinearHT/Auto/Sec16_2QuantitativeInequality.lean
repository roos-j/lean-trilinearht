/-- The per-group hypotheses of the principal bins (`four_core_principal_bins`,
`three_core_principal_bins`, blueprint lines 1932-1944 and `eq:mode-parameters`): a common chart
of the roles, the cutoff width `δ`, the coefficients and offsets of the modes, the clearing of the
center by `Q₀`, its entry bound `C_m`, the truncations at `K_t` and `K_f`, the full Fourier norms,
the inverse weights and the mode curvature bound. -/
structure PrinOK (G : bf.Grp) (δ Cm : ℝ) (Kt Kf : ℕ) : Prop where
  hz : ∀ j, (D.Ms j G).zc = (D.Ms 0 G).zc
  hdim : (D.Ms 0 G).zc.dim ≤ D.S.dmax
  hδ : 0 < δ
  hdδ : 8 * (D.Ms 0 G).zc.dim * δ ≤ 1
  hδ8 : δ ≤ 1 / 8
  hδc : ∀ j, (D.Ms j G).δc = δ
  hcl : ∀ j, (D.Ms j G).cl = slotCoeff j
  hρ : ∀ j k, (D.Ms j G).ρ k ∈ Set.Icc (0 : ℝ) 1
  hQC : ∀ a b, ∃ k : ℤ, (D.S.Q0 : ℝ) * ((D.Ms 0 G).zc.C a b : ℝ) = k
  hCm0 : 0 ≤ Cm
  hCm : ∀ a b, |((D.Ms 0 G).zc.C a b : ℝ)| ≤ Cm
  hQB : (D.S.Q0 : ℝ) * 2 ^ (Kt + 1) ≤ D.S.Bstar
  hτc : cutTail (D.Ms 0 G).zc.dim δ Kt ≤ (D.S.Dstar ^ 300)⁻¹
  hτm : multTail (D.Ms 0 G).zc.dim (δ / 2) D.S.Q0 Cm Kt ≤ (D.S.Dstar ^ 300)⁻¹
  hMN : multNorm (D.Ms 0 G).zc.dim (δ / 2) D.S.Q0 Cm ≤ D.S.Dstar
  hCN : cutNorm (D.Ms 0 G).zc.dim δ ≤ D.S.Dstar
  hDg : ∀ j, gaugeSqNorm (D.Ms j G).zc.dim (D.Ms j G).δc ≤ D.S.Dstar
  hKf : ∀ j, 2 * gaugeTail (D.Ms j G).zc.dim (D.Ms j G).δc / 2 ^ Kf * D.S.Dstar ^ 300 ≤ 1
  hQBf : (D.S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ D.S.Bstar
  hεw : ∀ j m, D.S.Dstar⁻¹ ≤ (D.Ms j G).L.εM m
  hΛ : ∀ j, (D.Ms j G).Λ ≤ D.S.Dstar

/-- The constant `K₁ = 2⁴/(1 - 4(2δ_*)^{1/4})` of `eq:principal-core`. -/
noncomputable def K1 : ℝ := 2 ^ 4 / (1 - 4 * (2 * D.SP.δs) ^ (1 / (4 : ℝ)))

/-- The bound `M_τ` of `eq:core-final` for the four-core pattern (`four_core_leaf`). -/
noncomputable def coreM4 (J : ℕ) (U ε K : ℝ) : ℝ :=
  (ModeComponents.upperHeights D.SP.Jst D.SP.δs).card * D.fourTypes.card *
    ((D.K1 * (fourKC κ' J * 2 * 12 ^ 4)) ^ (1 - (1 / 300 : ℝ) / 4) *
      (D.fourCc * K ^ (2 - (1 / 300 : ℝ) / 2)) *
      ((Real.logb 2 (U / ε) + 1) ^ 4 * bandC (1 - (1 / 300 : ℝ) / 4) J))

/-- The bound `M_τ` of `eq:core-final` for the three-core pattern with side role `l`
(`three_core_leaf`). -/
noncomputable def coreM3 (J Aw Iw : ℕ) (U ε K : ℝ) (l : Fin 4) : ℝ :=
  (ModeComponents.upperHeights D.SP.Jst D.SP.δs).card * (D.threeTypes l).card *
    ((D.K1 * (8 * entryCU κ' J Aw * 2 ^ (Aw + 4) * 12 ^ 3)) ^ (1 - (1 / 300 : ℝ) / 4) *
      (D.fourCc * K ^ (2 - (1 / 300 : ℝ) / 2)) *
      ((Iw + 1) * ((Real.logb 2 (U / ε) + 1) ^ 4 * bandC (1 - (1 / 300 : ℝ) / 4) J)))

/-- The absolute errors of `eq:core-final` at a cell: the tuple errors of `eq:core-numerical` and
the negligible amplitudes, over the groups and the patterns with at least three cores. -/
noncomputable def coreE (qG : bf.Grp → ℕ) (gs : ℤ × ℤ → Finset bf.Grp) (J Aw Iw : ℕ)
    (U ε : ℝ) (I : ℤ × ℤ) : ℝ :=
  ∑ G ∈ gs I, ((D.withQ0 (qG G)).fourErr J G I +
      D.K1 * (2 * fourKC κ' J * 12 ^ 4 * ε * U ^ 3 * D.S.Dstar ^ 4)) +
    ∑ l, ∑ G ∈ gs I, ((D.withQ0 (qG G)).threeErr J Aw l G I +
      D.K1 * (8 * entryCU κ' J Aw * 2 ^ (Aw + 4) * 12 ^ 3 * ε * U ^ 3 *
        (D.S.Dstar ^ 3 * (Iw + 1))))

open Classical in
/-- Blueprint lines 2820-2822 (declaration `core-estimate`) on one leaf of the side states: the
weighted active minimum of the patterns with at least three cores over the retained cells `T`
(outside the top-count cuts `Cut j`) is at most `η^{1/1200} |R| (M₄ + Σ_l M₃(l))` plus the
absolute errors `coreE`. The ingredients: the principal bins of every group (per-group side
inputs `D.withQ0 (qG G)`, hypotheses `PrinOK`, stabilization), the leaf anchors from the
type-class representatives `Rr` of `first_top_count_main` (`leafRep`, `leafAnc`, `leafAnc3`),
the path caps from the retained-path top counts and the side cap (`leaf_hcount`,
`four_hcap_leaf`, `three_hcap_leaf`, cap `K = max(1, M_t, K_s)`), and `eq:core-final` for the
four-core pattern and the three-core patterns (`four_core_leaf`, `three_core_leaf`,
`core_leaf_patterns`). -/
theorem leaf_core_estimate {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCA : 1 ≤ CA) (hCT : 4 ≤ CT) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar)
    (hB : 2 ≤ D.S.Bstar) (hQ0 : 1 ≤ D.S.Q0) (hSP : D.SP = D.S.sideParams δs)
    (hdD : (D.S.dmax : ℝ) ≤ D.S.Dstar) (qG : bf.Grp → ℕ) (hqG : ∀ G, 1 ≤ qG G ∧ qG G ≤ D.S.Q0)
    (J : ℕ) (hJ3 : 3 ≤ J) (Aw Iw : ℕ) (hAw : 1 ≤ Aw) (hIw1 : D.U0 ≤ 2 ^ (Iw + 1))
    (hIw2 : (2 : ℝ) ^ Iw ≤ 2 * D.U0) (T : Finset (ℤ × ℤ)) (hTc : T ⊆ A.cells)
    (hTR : ∀ I ∈ T, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G A.R.1 A.R.2)
    (gs : ℤ × ℤ → Finset bf.Grp) (gset : Finset bf.Grp) (hgs : ∀ I ∈ T, gs I ⊆ gset)
    (huse : ∀ I ∈ T, ∀ G ∈ gs I, fp.ActualUse G I) (z : bf.Grp → ChartTag)
    (hGc : ∀ G ∈ gset, (∀ j, 8 * (D.Ms j G).Λ ≤ D.S.Ξ) ∧
      (∀ j, (D.Ms j G).zc = z G) ∧ (z G).dim ≤ D.S.dmax)
    (δ Cm : bf.Grp → ℝ) (Kt Kf : ℕ)
    (hprin : ∀ G ∈ gset, (D.withQ0 (qG G)).PrinOK G (δ G) (Cm G) Kt Kf)
    (hstab : ∀ G ∈ gset, (D.withQ0 (qG G)).Stab) (hK : D.S.Dstar ^ 600 ≤ (2 : ℝ) ^ D.S.K)
    (hJ : 2 ≤ D.SP.Jst) (hδs : 0 < D.SP.δs) (hδ16 : D.SP.δs ≤ 1 / 16)
    (hδJ : ⌈4 * D.SP.δs * D.SP.Jst⌉₊ ≤ D.SP.Jst) (hq : 4 * (2 * D.SP.δs) ^ (1 / (4 : ℝ)) < 1)
    (hcard : ∀ I ∈ T, ∀ G ∈ gset, ∀ j, (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    (Rr : ∀ (j : Fin 4) (h : ℕ) (_ : ℕ × ℕ) (G : {G // G ∈ gset}),
      (D.Ms j G.1).RepClass (D.withQ0 (qG G.1)).S D.hA D.SP 10 h)
    (Bs : Finset ℤ) (hNdR : ∀ j, ∀ h ≤ D.SP.Jst, ∀ t (G : {G // G ∈ gset}) c,
      c ∈ (D.Ms j G.1).succNodes (D.withQ0 (qG G.1)).S D.hA D.SP
        (fp.retainedPairs G.1 Bs D.S.K) h →
      (D.Ms j G.1).nodeType1 (D.withQ0 (qG G.1)).S D.hA 10 h c = t.1 →
      (D.Ms j G.1).nodeType2 (D.withQ0 (qG G.1)).S D.hA 10 h c = t.2 → c ∈ (Rr j h t G).Nd)
    (hTB : ∀ I ∈ T, A.blkStart D.S.K I.1 ∈ Bs) (Cut : Fin 4 → Finset (ℤ × ℤ))
    (hTcut : ∀ I ∈ T, ∀ j, ∀ e ∈ Cut j,
      ¬ dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e.1 e.2)
    (Thr : Finset ℝ) {ε U Mt Ks : ℝ} (hε : 0 < ε) (hεU : ε ≤ U)
    (hThr : ∀ σ, ε ≤ σ → σ ≤ U → (∃ k : ℤ, σ = (2 : ℝ) ^ k) → D.S.Dstar⁻¹ ≤ σ → σ ∈ Thr)
    (hTop : ∀ j y, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs,
      ∀ t ∈ Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1) ×ˢ
        Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1), ∀ σ ∈ Thr,
      (∑ G : {G // G ∈ gset}, (((fp.useInst G.1 D.S.K (Rr j h t G).Nd).filter fun p =>
          (∀ e ∈ Cut j, ¬ dyadicGridCell A.G p.1.1 p.1.2 ⊆ dyadicGridCell A.G e.1 e.2) ∧
          y ∈ dyadicGridCell A.G p.1.1 p.1.2 ∧
            σ ^ 2 ≤ (D.Ms j G.1).nodeSize (D.withQ0 (qG G.1)).S D.hA D.SP (D.c j G.1) h p).image
          fun p => (Rr j h t G).rep p.2).card : ℝ) ≤ Mt * σ ^ (-2 : ℝ))
    (hpathD : ∀ j y, (∑ G : {G // G ∈ gset}, ((D.Ms j G.1).ptSet y).card : ℝ) ≤ D.S.Dstar)
    (hU : ∀ I ∈ T, ∀ G ∈ gs I, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ j,
      ∀ F ∈ (D.withQ0 (qG G)).goodCls G I j h, (D.withQ0 (qG G)).clsSize G I j F ≤ U)
    (hUs : ∀ l, ∀ I ∈ T, ∀ G ∈ gs I, Real.sqrt ((dyadicGridLength A.G I.1)⁻¹ *
