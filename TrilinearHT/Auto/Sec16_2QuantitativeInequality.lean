    (h4 : ∑ I ∈ T, dyadicGridLength Gd I.1 * min η (∑ g ∈ gs I, ‖F (fun _ => 0) I g‖) ≤
      η ^ (1 - (1 - (1 / 300 : ℝ) / 4)) * (dyadicGridLength Gd R.1 * M4) +
        ∑ I ∈ T, dyadicGridLength Gd I.1 * E4 I)
    (h3 : ∀ l, ∑ I ∈ T, dyadicGridLength Gd I.1 *
        min η (∑ g ∈ gs I, ‖F (fun k => if k = l then 1 else 0) I g‖) ≤
      η ^ (1 - (1 - (1 / 300 : ℝ) / 4)) * (dyadicGridLength Gd R.1 * M3 l) +
        ∑ I ∈ T, dyadicGridLength Gd I.1 * E3 l I) :
    ∑ I ∈ T, dyadicGridLength Gd I.1 * min η ‖∑ τ ∈ Finset.univ.filter
        (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧ 3 ≤ patternCount τ 0), ∑ g ∈ gs I, F τ I g‖ ≤
      η ^ (1 / 1200 : ℝ) * (dyadicGridLength Gd R.1 * (M4 + ∑ l, M3 l)) +
        ∑ I ∈ T, dyadicGridLength Gd I.1 * (E4 I + ∑ l, E3 l I) := by
  set P := Finset.univ.filter
    (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧ 3 ≤ patternCount τ 0) with hP
  set x : (Fin 4 → Fin 3) → ℤ × ℤ → ℝ := fun τ I => ∑ g ∈ gs I, ‖F τ I g‖ with hx
  have hx0 : ∀ τ I, 0 ≤ x τ I := fun τ I => Finset.sum_nonneg fun g _ => norm_nonneg _
  have hcf := core_final_patterns Gd T P x (fun τ _ I _ => hx0 τ I)
    (fun I => ‖∑ τ ∈ P, ∑ g ∈ gs I, F τ I g‖)
    (fun I _ => (norm_sum_le _ _).trans (Finset.sum_le_sum fun τ _ => norm_sum_le _ _)) hη
  set f : (Fin 4 → Fin 3) → ℝ := fun τ =>
    ∑ I ∈ T, dyadicGridLength Gd I.1 * min η (x τ I) with hf
  have hf0 : ∀ τ, 0 ≤ f τ := fun τ => Finset.sum_nonneg fun I _ =>
    mul_nonneg (dyadicGridLength_pos Gd I.1).le (le_min hη (hx0 τ I))
