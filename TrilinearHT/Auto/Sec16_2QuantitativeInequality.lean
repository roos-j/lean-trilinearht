theorem before_absorption_combine {ι : Type*} (S : Finset ι) (len : ι → ℝ)
    (hlen : ∀ I ∈ S, 0 ≤ len I) (F : ι → (Fin 4 → Fin 3) → ℂ) {η Ee Ec Es Et : ℝ}
