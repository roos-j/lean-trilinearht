      rw [Finset.sum_add_distrib]
      have hA := Finset.sum_le_sum hpt
      rw [← Finset.mul_sum] at hA
      have hflag' : ∑ I ∈ X', (if T.unfl C₀ I G c d (T.tOf c i) (T.tOf d i') j o then 0 else
