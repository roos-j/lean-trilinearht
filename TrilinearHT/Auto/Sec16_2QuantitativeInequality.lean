      _ ≤ 2 ^ C₄ * η ^ c + (1 + CN) * (C * η ^ c) := by gcongr
      _ ≤ 2 ^ C₄ * η ^ c * (1 + CN) + (1 + CN) * (C * η ^ c) := by nlinarith
      _ = _ := by ring
  calc X ≤ _ := hX
    _ ≤ Cq * ((2 ^ C₄ + C) * η ^ c * (1 + CN)) * R + e := by gcongr
    _ = _ := by ring

