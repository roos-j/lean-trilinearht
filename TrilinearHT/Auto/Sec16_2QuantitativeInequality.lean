/-- The single-side patterns: the side in the slot `l`, cores elsewhere. -/
def sidePat (l : Fin 4) : Fin 4 → Fin 3 := fun k => if k = l then 1 else 0

theorem sidePat_injective : Function.Injective sidePat := by
  unfold sidePat
  decide

theorem sidePat_ne_zero (l : Fin 4) : sidePat l ≠ fun _ => 0 := fun h => by
  have := congrFun h l
  simp [sidePat] at this

open Classical in
