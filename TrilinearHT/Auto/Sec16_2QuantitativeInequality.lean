      ∑ G ∈ pathGroups (A := A) T gs y,
        ((((fp.useInst G D.S.K (D.leafNd gset qG Rr Ts j h t G)).filter fun p =>
          p.1 ∈ T ∧ y ∈ dyadicGridCell A.G p.1.1 p.1.2 ∧
