    (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) {η : ℝ} (hη : 0 ≤ η) :
    ∑ I ∈ T, dyadicGridLength A.G I.1 * min η ‖∑ τ ∈ Finset.univ.filter
