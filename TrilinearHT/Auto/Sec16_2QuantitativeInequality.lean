    fun y h hh j t σ h1 h2 h3 => (hcount y h hh j t σ h1 h2 h3).trans
      (mul_le_mul_of_nonneg_right (le_max_left _ _)
        (Real.rpow_nonneg (le_trans hε.le h1) _))
