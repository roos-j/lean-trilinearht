and `2 C₅ (q-2)/(q-1) ≤ 1/8`, then `P^{-1/2} G₀ (K+2)^{2(q-2)/(q-1)} ≤ C P^{-1/4}`, and with
`P ≥ η^{-α}` this is at most `C η^{α/4}`. -/
theorem block_term_le {P G₀ K C C₅ q α η : ℝ} (hP1 : 1 ≤ P) (hG₀ : G₀ ≤ P ^ (1 / 8 : ℝ))
    (hK0 : 0 ≤ K) (hK : K + 2 ≤ C * P ^ C₅) (hC : 1 ≤ C) (hq2 : 2 < q)
    (hq3 : q < 3) (hq : 2 * C₅ * ((q - 2) / (q - 1)) ≤ 1 / 8) (hη0 : 0 < η)
    (hPη : η ^ (-α) ≤ P) :
    P ^ (-(1 / 2) : ℝ) * G₀ * (K + 2) ^ (2 * (q - 2) / (q - 1)) ≤ C * η ^ (α / 4) := by
  set e := 2 * (q - 2) / (q - 1) with he
  have he0 : 0 ≤ e := by rw [he]; apply div_nonneg <;> linarith
  have he1 : e ≤ 1 := by rw [he, div_le_one (by linarith)]; linarith
  have hP0 : 0 < P := by linarith
  have hCe : (K + 2) ^ e ≤ C * P ^ (1 / 8 : ℝ) := by
    calc (K + 2) ^ e ≤ (C * P ^ C₅) ^ e := Real.rpow_le_rpow (by linarith) hK he0
      _ = C ^ e * P ^ (C₅ * e) := by
          rw [Real.mul_rpow (by linarith) (by positivity), ← Real.rpow_mul hP0.le]
      _ ≤ C * P ^ (1 / 8 : ℝ) := by
          gcongr
          · exact Real.rpow_le_self_of_one_le hC he1
          · rw [he]; have : C₅ * (2 * (q - 2) / (q - 1)) = 2 * C₅ * ((q - 2) / (q - 1)) := by
              ring
            rw [this]; exact hq
  have h1 : P ^ (-(1 / 2) : ℝ) * G₀ * (K + 2) ^ e ≤
      P ^ (-(1 / 2) : ℝ) * P ^ (1 / 8 : ℝ) * (C * P ^ (1 / 8 : ℝ)) := by
    gcongr
  have h2 : P ^ (-(1 / 2) : ℝ) * P ^ (1 / 8 : ℝ) * (C * P ^ (1 / 8 : ℝ)) =
      C * P ^ (-(1 / 4) : ℝ) := by
    rw [mul_comm C, ← mul_assoc, ← Real.rpow_add hP0, ← Real.rpow_add hP0]; norm_num; ring
  have h3 : P ^ (-(1 / 4) : ℝ) ≤ η ^ (α / 4) := by
    have : (η ^ (-α)) ^ (-(1 / 4) : ℝ) = η ^ (α / 4) := by
      rw [← Real.rpow_mul hη0.le]; ring_nf
    rw [← this]
