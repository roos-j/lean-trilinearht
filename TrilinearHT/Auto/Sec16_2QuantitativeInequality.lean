and groups with anchors of the core roles (`three_core_principal_bins`, hypothesis `hPB` in its
conclusion form), the vanishing of the pattern form at the others (`three_form_zero`), and
`three_core_final_side` with `K₁ = 2⁴/(1 - 4(2δ_*)^{1/4})`, the upper heights and the absolute
tuple errors `threeErr`. -/
theorem three_core_leaf {Cj CA CT CK : ℕ} {δs W : ℝ} (hV : D.S.Valid Cj CA CT CK δs W)
    (hCA : 1 ≤ CA) (hCT : 4 ≤ CT) (hd2 : 2 ≤ D.S.dmax) (hD : 2 ≤ D.S.Dstar)
    (hB : 2 ≤ D.S.Bstar) (hQ0 : 1 ≤ D.S.Q0) (hSP : D.SP = D.S.sideParams δs)
    (hdD : (D.S.dmax : ℝ) ≤ D.S.Dstar) (qG : bf.Grp → ℕ) (hqG : ∀ G, 1 ≤ qG G ∧ qG G ≤ D.S.Q0)
    (J : ℕ) (hJ : 1 ≤ J) (Aw Iw : ℕ) (hIw : (2 : ℝ) ^ Iw ≤ 2 * D.U0) (l : Fin 4) (R : ℤ × ℤ)
    (T : Finset (ℤ × ℤ))
    (hT : ∀ I ∈ T, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G R.1 R.2)
    (gs : ℤ × ℤ → Finset bf.Grp) (z : bf.Grp → ChartTag)
    (hGc : ∀ I ∈ T, ∀ G ∈ gs I, (∀ j, 8 * (D.Ms j G).Λ ≤ D.S.Ξ) ∧
      (∀ j, (D.Ms j G).zc = z G) ∧ (z G).dim ≤ D.S.dmax)
    (rep : ℕ → ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ I ∈ T, ∀ G ∈ gs I, ∀ j,
      (D.withQ0 (qG G)).RepOK G j h T (rep h G j))
    (anc : ∀ (I : ℤ × ℤ) (G : bf.Grp), D.AncNe3 G I l → ℕ → ∀ j, j ≠ l →
      Finset (D.Ms j G).Md →
      (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)))
    (hanc : ∀ h (hh : h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs), ∀ I (hI : I ∈ T),
      ∀ G (hG : G ∈ gs I), ∀ (hA : D.AncNe3 G I l) j (hj : j ≠ l) F
      (hF : F ∈ (D.withQ0 (qG G)).goodCls G I j h),
      anc I G hA h j hj F =
        (D.withQ0 (qG G)).repAnchor G I j h (rep h G j) (hrep h hh I hI G hG j).1 hF)
    (hcard : ∀ I ∈ T, ∀ G ∈ gs I, ∀ j, (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    {U ε : ℝ} (hε : 0 < ε) (hεU : ε ≤ U)
    (hU : ∀ I ∈ T, ∀ G ∈ gs I, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ j,
      j ≠ l → ∀ F ∈ (D.withQ0 (qG G)).goodCls G I j h, (D.withQ0 (qG G)).clsSize G I j F ≤ U)
    (hUs : ∀ I ∈ T, ∀ G ∈ gs I, Real.sqrt ((dyadicGridLength A.G I.1)⁻¹ *
      ∫ y in (dyadicGridLeft A.G I.1 I.2)..dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1,
        ‖augPhys ((D.withQ0 (qG G)).toLeaf.sv l G I) y‖ ^ 2) ≤ U)
    {K : ℝ} (hK : 0 ≤ K)
    (hcap : ∀ y, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, 10 ≤ h →
      ∀ c : ℝ × ℝ × ℕ × ℝ × (Fin 4 → ℝ), 0 < c.1 → c.1 ≤ 1 →
      1 ≤ c.2.1 → (∀ i, 0 < threeAmp l c i) →
      (∀ j, ε ≤ threeAmp l c j ∧ threeAmp l c j ≤ U ∧
        ∃ k : ℤ, threeAmp l c j = (2 : ℝ) ^ k) → ∀ κ, (∀ i (hi : i ≠ l),
        ∑ G ∈ pathGroups (A := A) T gs y, (((D.withQ0 (qG G)).threeUsedReps G h y l
          (pathCell A.G T y) (fun s => anc (pathCell A.G T y s) G) Iw c κ
          (pathDepths (A := A) T gs y G) i hi).card : ℝ) ≤ K * threeAmp l c i ^ (-2 : ℝ)) ∧
        ∑ G ∈ pathGroups (A := A) T gs y, ∑ s ∈ pathDepths (A := A) T gs y G,
          (D.withQ0 (qG G)).sideWeight G l (pathCell A.G T y) c.2.2.2.1 s ≤
            K * threeAmp l c l ^ (-2 : ℝ))
    (hq : 4 * (2 * D.SP.δs) ^ (1 / (4 : ℝ)) < 1)
    (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md)
    (hPB : ∀ I ∈ T, ∀ G ∈ gs I, ∀ hA : D.AncNe3 G I l, ∀ y ∈ dyadicGridCell A.G I.1 I.2,
      ‖fp.Λc I (patternPiece (fun l => (D.withQ0 (qG G)).coreAt l G I)
        (fun l => (D.withQ0 (qG G)).toLeaf.sv l G I)
        (fun l => (D.withQ0 (qG G)).errAt L l G I) (fun k => if k = l then 1 else 0))‖ ≤
      2 ^ 4 * (∑ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs,
        ((ModeComponents.upperHeights D.SP.Jst D.SP.δs).card : ℝ)⁻¹ *
          ∑ c ∈ ((D.withQ0 (qG G)).threeTested G I y l (anc I G hA)
              ((D.withQ0 (qG G)).toLeaf.sv l G I) Iw h).image
            ((D.withQ0 (qG G)).threeBinOf G I y l (anc I G hA)
              ((D.withQ0 (qG G)).toLeaf.sv l G I) h),
            threeBinVal κ' J Aw l c *
              ((((D.withQ0 (qG G)).threeTested G I y l (anc I G hA)
                ((D.withQ0 (qG G)).toLeaf.sv l G I) Iw h).filter fun q =>
                  (D.withQ0 (qG G)).threeBinOf G I y l (anc I G hA)
                    ((D.withQ0 (qG G)).toLeaf.sv l G I) h q = c).card : ℝ)) /
        (1 - 4 * (2 * D.SP.δs) ^ (1 / (4 : ℝ))) + (D.withQ0 (qG G)).threeErr J Aw l G I)
    {η : ℝ} (hη : 0 ≤ η) :
    ∑ I ∈ T, dyadicGridLength A.G I.1 * min η (∑ G ∈ gs I,
      ‖fp.Λc I (patternPiece (fun l => (D.withQ0 (qG G)).coreAt l G I)
        (fun l => (D.withQ0 (qG G)).toLeaf.sv l G I)
        (fun l => (D.withQ0 (qG G)).errAt L l G I) (fun k => if k = l then 1 else 0))‖) ≤
      η ^ (1 - (1 - (1 / 300 : ℝ) / 4)) * (dyadicGridLength A.G R.1 *
        ((ModeComponents.upperHeights D.SP.Jst D.SP.δs).card * (D.threeTypes l).card *
          ((2 ^ 4 / (1 - 4 * (2 * D.SP.δs) ^ (1 / (4 : ℝ))) *
            (8 * entryCU κ' J Aw * 2 ^ (Aw + 4) * 12 ^ 3)) ^
          (1 - (1 / 300 : ℝ) / 4) * (D.fourCc * K ^ (2 - (1 / 300 : ℝ) / 2)) *
          ((Iw + 1) * ((Real.logb 2 (U / ε) + 1) ^ 4 * bandC (1 - (1 / 300 : ℝ) / 4) J))))) +
        ∑ I ∈ T, dyadicGridLength A.G I.1 * ∑ G ∈ gs I,
          ((D.withQ0 (qG G)).threeErr J Aw l G I +
            2 ^ 4 / (1 - 4 * (2 * D.SP.δs) ^ (1 / (4 : ℝ))) *
            (8 * entryCU κ' J Aw * 2 ^ (Aw + 4) * 12 ^ 3 * ε * U ^ 3 *
              (D.S.Dstar ^ 3 * (Iw + 1)))) := by
  have hden : 0 < 1 - 4 * (2 * D.SP.δs) ^ (1 / (4 : ℝ)) := by linarith
  refine D.three_core_final_side hV hCA hCT hd2 hD hB hQ0 hSP hdD qG hqG J hJ Aw Iw hIw l R T hT
    gs z hGc (ModeComponents.upperHeights D.SP.Jst D.SP.δs) (fun h hh => ?_) rep hrep anc hanc
    hcard hε hεU hU hUs hK (by positivity) hcap
    (fun I G => ‖fp.Λc I (patternPiece (fun l => (D.withQ0 (qG G)).coreAt l G I)
      (fun l => (D.withQ0 (qG G)).toLeaf.sv l G I)
      (fun l => (D.withQ0 (qG G)).errAt L l G I) (fun k => if k = l then 1 else 0))‖)
    (fun I G => (D.withQ0 (qG G)).threeErr J Aw l G I)
    (fun I G => (D.withQ0 (qG G)).threeErr_nonneg J Aw l G I) (fun I hI G hG y hy => ?_) _
    (fun I _ => le_rfl) hη
  · have := (Finset.mem_filter.mp hh).1
    rw [Finset.mem_range] at this
    omega
  · by_cases hA : D.AncNe3 G I l
    · have hA' : (D.withQ0 (qG G)).AncNe3 G I l := hA
      refine (hPB I hI G hG hA y hy).trans (le_of_eq ?_)
      simp only [threeBinSumA, dite_eq_left hA']
      rw [Finset.mul_sum, Finset.mul_sum, Finset.sum_div]
      congr 1
      refine Finset.sum_congr rfl fun h _ => ?_
      ring
    · have hA' : ¬ (D.withQ0 (qG G)).AncNe3 G I l := hA
      simp only [(D.withQ0 (qG G)).three_form_zero hA', norm_zero, threeBinSumA,
        dite_eq_right hA', mul_zero, Finset.sum_const_zero, zero_add]
      exact (D.withQ0 (qG G)).threeErr_nonneg J Aw l G I

open Classical in
/-- The anchors of the four-core leaf estimate (blueprint line 2467, "let `a_j` be its
representative"): at a cell and group with alive modes of every role at the decision cell, the
representatives `repAnc` of the final classes for the side input of the group, and a default alive
mode for the classes that are not successful. -/
noncomputable def leafAnc (qG : bf.Grp → ℕ)
    (rep : ℕ → ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ G j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ k₁ k₂ c,
      rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c)
    (I : ℤ × ℤ) (G : bf.Grp) (hA : D.AncNe G I) (h : ℕ) (j : Fin 4)
    (F : Finset (D.Ms j G).Md) :
    (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)) :=
  (D.withQ0 (qG G)).repAnc G I j (fun h => rep h G j) (hrep G j)
    ⟨(hA j).choose, (hA j).choose_spec⟩ h F

open Classical in
/-- The anchors of the three-core leaf estimate with side role `l` (alive modes of the core roles
at the decision cell). -/
noncomputable def leafAnc3 (qG : bf.Grp → ℕ)
    (rep : ℕ → ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ G j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ k₁ k₂ c,
      rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c)
    (l : Fin 4) (I : ℤ × ℤ) (G : bf.Grp) (hA : D.AncNe3 G I l) (h : ℕ) (j : Fin 4) (hj : j ≠ l)
    (F : Finset (D.Ms j G).Md) :
    (D.Ms j G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)) :=
  (D.withQ0 (qG G)).repAnc G I j (fun h => rep h G j) (hrep G j)
    ⟨(hA j hj).choose, (hA j hj).choose_spec⟩ h F

open Classical in
/-- On the successful classes the leaf anchors are the representative anchors. -/
theorem leafAnc_eq (qG : bf.Grp → ℕ)
    (rep : ℕ → ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ G j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ k₁ k₂ c,
      rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c)
    {h : ℕ} (hh : h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs) (I : ℤ × ℤ) (G : bf.Grp)
    (hA : D.AncNe G I) (j : Fin 4) {F : Finset (D.Ms j G).Md}
    (hF : F ∈ (D.withQ0 (qG G)).goodCls G I j h)
    (hr : ∀ k₁ k₂ c, rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c) :
    D.leafAnc qG rep hrep I G hA h j F =
      (D.withQ0 (qG G)).repAnchor G I j h (rep h G j) hr hF := by
  have hh' : h ∈ ModeComponents.upperHeights (D.withQ0 (qG G)).SP.Jst
      (D.withQ0 (qG G)).SP.δs := hh
  unfold leafAnc repAnc
  rw [dite_eq_left hh']
  exact dite_eq_left hF

open Classical in
/-- On the successful classes of the core roles the three-core leaf anchors are the
representative anchors. -/
theorem leafAnc3_eq (qG : bf.Grp → ℕ)
    (rep : ℕ → ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ G j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ k₁ k₂ c,
      rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c)
    (l : Fin 4) {h : ℕ} (hh : h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs) (I : ℤ × ℤ)
    (G : bf.Grp) (hA : D.AncNe3 G I l) (j : Fin 4) (hj : j ≠ l) {F : Finset (D.Ms j G).Md}
    (hF : F ∈ (D.withQ0 (qG G)).goodCls G I j h)
    (hr : ∀ k₁ k₂ c, rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c) :
    D.leafAnc3 qG rep hrep l I G hA h j hj F =
      (D.withQ0 (qG G)).repAnchor G I j h (rep h G j) hr hF := by
  have hh' : h ∈ ModeComponents.upperHeights (D.withQ0 (qG G)).SP.Jst
      (D.withQ0 (qG G)).SP.δs := hh
  unfold leafAnc3 repAnc
  rw [dite_eq_left hh']
  exact dite_eq_left hF

/-- The leaf anchors satisfy `AnchorOK` (`repAnc_ok`). -/
theorem leafAnc_ok (qG : bf.Grp → ℕ)
    (rep : ℕ → ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ G j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ k₁ k₂ c,
      rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c)
    {G : bf.Grp} (hstab : (D.withQ0 (qG G)).Stab) (hΔ : D.SP.Δ = 10) (I : ℤ × ℤ)
    (hA : D.AncNe G I) :
    (D.withQ0 (qG G)).AnchorOK G I (D.leafAnc qG rep hrep I G hA) :=
  fun h hh j K hK hg x hx =>
    (D.withQ0 (qG G)).repAnc_ok hstab hΔ G I j (fun h => rep h G j) (hrep G j) _ h hh K hK hg x hx

/-- The three-core leaf anchors satisfy `AnchorOKAt` in the core roles (`repAnc_ok`). -/
theorem leafAnc3_ok (qG : bf.Grp → ℕ)
    (rep : ℕ → ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrep : ∀ G j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ k₁ k₂ c,
      rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c)
    {G : bf.Grp} (hstab : (D.withQ0 (qG G)).Stab) (hΔ : D.SP.Δ = 10) (l : Fin 4) (I : ℤ × ℤ)
    (hA : D.AncNe3 G I l) (j : Fin 4) (hj : j ≠ l) :
    (D.withQ0 (qG G)).AnchorOKAt G I j (fun h => D.leafAnc3 qG rep hrep l I G hA h j hj) :=
  (D.withQ0 (qG G)).repAnc_ok hstab hΔ G I j (fun h => rep h G j) (hrep G j) _

open Classical in
/-- Blueprint `eq:top-count` along the retained paths for the four-core leaf estimate (lines
2783-2800, "the path estimates give `Σ_G M_i^G ≤ C P^C σ_i^{-2}` in every role"): the distinct used
representatives of a role along the path of `y`, with the leaf anchors, are values of the
representatives on use instances at the retained cells containing `y` with `σ_i² ≤ σ_F²`
(`four_usedReps_subset_tops`), so a retained-path count of those at the retained dyadic amplitudes
gives the path caps `hcap` of `four_core_leaf`. -/
theorem four_hcap_leaf (qG : bf.Grp → ℕ) (T : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset bf.Grp)
    (rep : ℕ → ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrepP : ∀ G j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ k₁ k₂ c,
      rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c)
    (hrep : ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ I ∈ T, ∀ G ∈ gs I, ∀ j,
      (D.withQ0 (qG G)).RepOK G j h T (rep h G j))
    (Nd : ∀ (j : Fin 4) (_ : ℕ) (_ : ℕ × ℕ) (G : bf.Grp), Finset (ℤ × (ℤ × ℤ) × (D.Ms j G).Md))
    (hNd : ∀ j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ I ∈ T, ∀ G ∈ gs I,
      ∀ F (hF : F ∈ (D.withQ0 (qG G)).goodCls G I j h),
        (D.withQ0 (qG G)).classNode G I j h hF ∈
          Nd j h ((D.withQ0 (qG G)).classTypeOf G I j h F) G)
    (huse : ∀ I ∈ T, I ∈ A.cells ∧ ∀ G ∈ gs I, fp.ActualUse G I) {ε U K : ℝ}
    (hcount : ∀ y, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ j t σ, ε ≤ σ → σ ≤ U →
      (∃ k : ℤ, σ = (2 : ℝ) ^ k) →
      ∑ G ∈ pathGroups (A := A) T gs y, ((((fp.useInst G D.S.K (Nd j h t G)).filter fun p =>
          p.1 ∈ T ∧ y ∈ dyadicGridCell A.G p.1.1 p.1.2 ∧
            σ ^ 2 ≤ (D.Ms j G).nodeSize (D.withQ0 (qG G)).S D.hA D.SP (D.c j G) h p).image
          fun p => rep h G j t.1 t.2 p.2).card : ℝ) ≤ K * σ ^ (-2 : ℝ)) :
    ∀ y, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, 10 ≤ h →
      ∀ c : ℝ × ℝ × (Fin 4 → ℝ), 0 < c.1 → c.1 ≤ 1 →
      1 ≤ c.2.1 → (∀ i, 0 < c.2.2 i) →
      (∀ j, ε ≤ c.2.2 j ∧ c.2.2 j ≤ U ∧ ∃ k : ℤ, c.2.2 j = (2 : ℝ) ^ k) →
      ∀ κ i, ∑ G ∈ pathGroups (A := A) T gs y,
        (((D.withQ0 (qG G)).fourUsedReps G h y (pathCell A.G T y)
          (fun s => D.leafAnc qG rep hrepP (pathCell A.G T y s) G) c κ
          (pathDepths (A := A) T gs y G) i).card : ℝ) ≤ K * c.2.2 i ^ (-2 : ℝ) := by
  intro y h hh _ c _ _ _ _ hamp κ i
  refine le_trans (Finset.sum_le_sum fun G hG => ?_)
    (hcount y h hh i (κ i) (c.2.2 i) (hamp i).1 (hamp i).2.1 (hamp i).2.2)
  obtain ⟨I₀, hI₀, hGI₀⟩ : ∃ I ∈ T, G ∈ gs I := by
    obtain ⟨I, hI, hGI⟩ := Finset.mem_biUnion.mp hG
    exact ⟨I, (Finset.mem_filter.mp hI).1, hGI⟩
  have hrepG : ∀ j, (D.withQ0 (qG G)).RepOK G j h T (rep h G j) := hrep h hh I₀ hI₀ G hGI₀
  have hsub := (D.withQ0 (qG G)).four_usedReps_subset_tops G h y (pathCell A.G T y) T
    (rep h G) hrepG (S := pathDepths (A := A) T gs y G)
    (fun s hs => ⟨(mem_pathDepths hs).1, (mem_pathDepths hs).2.1⟩)
    (ancOf := fun s => D.leafAnc qG rep hrepP (pathCell A.G T y s) G)
    (fun s _ hs' j F hF => D.leafAnc_eq qG rep hrepP hh _ G hs' j hF (hrepG j).1) c κ i
    (Nd i h (κ i) G) (fun p => rep h G i (κ i).1 (κ i).2 p) (fun _ _ => rfl)
    (fun s hs F hF hty => by
      have := hNd i h hh _ (mem_pathDepths hs).1 G (mem_pathDepths hs).2.2 F hF
      rwa [hty] at this)
    (fun s hs => ⟨(huse _ (mem_pathDepths hs).1).1,
      (huse _ (mem_pathDepths hs).1).2 G (mem_pathDepths hs).2.2⟩)
  exact Nat.cast_le.mpr (Finset.card_le_card hsub)

open Classical in
/-- Blueprint `eq:top-count` and `eq:side-cap` along the retained paths for the three-core leaf
estimate with side role `l`: the core roles as in `four_hcap_leaf` (`three_usedReps_subset_tops`),
and the side role from the retained side cap `Σ_{I ∋ y} Σ_G Σ_l ‖S_{l,G,I}‖²/|I| ≤ K` of the side
estimate (`side_estimate_leaf`), since `M_l^G = σ_l^{-2} Σ_s ‖S_{l,G,s}‖²_{2,I_s}` and the physical
part of a column has normalized square at most its normalized square norm (`physSq_le`). -/
theorem three_hcap_leaf (qG : bf.Grp → ℕ) (T : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset bf.Grp)
    (rep : ℕ → ∀ G j, ℕ → ℕ → ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md)
    (hrepP : ∀ G j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ k₁ k₂ c,
      rep h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c)
    (hrep : ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ I ∈ T, ∀ G ∈ gs I, ∀ j,
      (D.withQ0 (qG G)).RepOK G j h T (rep h G j))
    (Nd : ∀ (j : Fin 4) (_ : ℕ) (_ : ℕ × ℕ) (G : bf.Grp), Finset (ℤ × (ℤ × ℤ) × (D.Ms j G).Md))
    (hNd : ∀ j, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ I ∈ T, ∀ G ∈ gs I,
      ∀ F (hF : F ∈ (D.withQ0 (qG G)).goodCls G I j h),
        (D.withQ0 (qG G)).classNode G I j h hF ∈
          Nd j h ((D.withQ0 (qG G)).classTypeOf G I j h F) G)
    (huse : ∀ I ∈ T, I ∈ A.cells ∧ ∀ G ∈ gs I, fp.ActualUse G I) (l : Fin 4) (Iw : ℕ)
    {ε U K : ℝ}
    (hcount : ∀ y, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ j t σ, ε ≤ σ → σ ≤ U →
      (∃ k : ℤ, σ = (2 : ℝ) ^ k) →
      ∑ G ∈ pathGroups (A := A) T gs y, ((((fp.useInst G D.S.K (Nd j h t G)).filter fun p =>
          p.1 ∈ T ∧ y ∈ dyadicGridCell A.G p.1.1 p.1.2 ∧
            σ ^ 2 ≤ (D.Ms j G).nodeSize (D.withQ0 (qG G)).S D.hA D.SP (D.c j G) h p).image
          fun p => rep h G j t.1 t.2 p.2).card : ℝ) ≤ K * σ ^ (-2 : ℝ))
    (hside : ∀ y, ∑ I ∈ T with y ∈ dyadicGridCell A.G I.1 I.2, ∑ G ∈ gs I,
      (D.toLeafQ qG).s2 G I ≤ K) :
    ∀ y, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, 10 ≤ h →
      ∀ c : ℝ × ℝ × ℕ × ℝ × (Fin 4 → ℝ), 0 < c.1 → c.1 ≤ 1 →
      1 ≤ c.2.1 → (∀ i, 0 < threeAmp l c i) →
      (∀ j, ε ≤ threeAmp l c j ∧ threeAmp l c j ≤ U ∧
        ∃ k : ℤ, threeAmp l c j = (2 : ℝ) ^ k) → ∀ κ, (∀ i (hi : i ≠ l),
        ∑ G ∈ pathGroups (A := A) T gs y, (((D.withQ0 (qG G)).threeUsedReps G h y l
          (pathCell A.G T y) (fun s => D.leafAnc3 qG rep hrepP l (pathCell A.G T y s) G) Iw c κ
          (pathDepths (A := A) T gs y G) i hi).card : ℝ) ≤ K * threeAmp l c i ^ (-2 : ℝ)) ∧
        ∑ G ∈ pathGroups (A := A) T gs y, ∑ s ∈ pathDepths (A := A) T gs y G,
          (D.withQ0 (qG G)).sideWeight G l (pathCell A.G T y) c.2.2.2.1 s ≤
            K * threeAmp l c l ^ (-2 : ℝ) := by
  intro y h hh _ c _ _ _ hσ hamp κ
  refine ⟨fun i hi => ?_, ?_⟩
  · have e : threeAmp l c i = c.2.2.2.2 i := ite_eq_right hi
    rw [e]
    have hai := hamp i
    rw [e] at hai
    refine le_trans (Finset.sum_le_sum fun G hG => ?_)
      (hcount y h hh i (κ i) (c.2.2.2.2 i) hai.1 hai.2.1 hai.2.2)
    obtain ⟨I₀, hI₀, hGI₀⟩ : ∃ I ∈ T, G ∈ gs I := by
      obtain ⟨I, hI, hGI⟩ := Finset.mem_biUnion.mp hG
      exact ⟨I, (Finset.mem_filter.mp hI).1, hGI⟩
    have hrepG : ∀ j, (D.withQ0 (qG G)).RepOK G j h T (rep h G j) := hrep h hh I₀ hI₀ G hGI₀
    have hsub := (D.withQ0 (qG G)).three_usedReps_subset_tops G h y l (pathCell A.G T y) T
      (rep h G) hrepG (S := pathDepths (A := A) T gs y G)
      (fun s hs => ⟨(mem_pathDepths hs).1, (mem_pathDepths hs).2.1⟩)
      (ancOf := fun s => D.leafAnc3 qG rep hrepP l (pathCell A.G T y s) G)
      (fun s _ hs' j hj F hF => D.leafAnc3_eq qG rep hrepP l hh _ G hs' j hj hF (hrepG j).1) Iw
      c κ i hi (Nd i h (κ i) G) (fun p => rep h G i (κ i).1 (κ i).2 p) (fun _ _ => rfl)
      (fun s hs F hF hty => by
        have := hNd i h hh _ (mem_pathDepths hs).1 G (mem_pathDepths hs).2.2 F hF
        rwa [hty] at this)
      (fun s hs => ⟨(huse _ (mem_pathDepths hs).1).1,
        (huse _ (mem_pathDepths hs).1).2 G (mem_pathDepths hs).2.2⟩)
    exact Nat.cast_le.mpr (Finset.card_le_card hsub)
  · have el : threeAmp l c l = c.2.2.2.1 := ite_eq_left rfl
    have hσl : 0 < c.2.2.2.1 := el ▸ hσ l
    have e2 : c.2.2.2.1 ^ (-2 : ℝ) = (c.2.2.2.1 ^ 2)⁻¹ := by
      rw [Real.rpow_neg hσl.le, show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
    rw [el, e2]
    have hW : ∀ G, ∀ s, (D.withQ0 (qG G)).sideWeight G l (pathCell A.G T y) c.2.2.2.1 s ≤
        (c.2.2.2.1 ^ 2)⁻¹ * (D.toLeafQ qG).s2 G (pathCell A.G T y s) := by
      intro G s
      have h1 := physSq_le ((D.toLeafQ qG).sv l G (pathCell A.G T y s))
        (dyadicGridLeft A.G (pathCell A.G T y s).1 (pathCell A.G T y s).2)
        (dyadicGridLength A.G (pathCell A.G T y s).1) (dyadicGridLength_pos A.G _)
      have h2 : (D.toLeafQ qG).ns l G (pathCell A.G T y s) ^ 2 ≤
          (D.toLeafQ qG).s2 G (pathCell A.G T y s) :=
        Finset.single_le_sum (f := fun l' => (D.toLeafQ qG).ns l' G (pathCell A.G T y s) ^ 2)
          (fun _ _ => sq_nonneg _) (Finset.mem_univ l)
      exact mul_le_mul_of_nonneg_left (h1.trans h2) (inv_nonneg.mpr (sq_nonneg _))
    have hre : ∑ G ∈ pathGroups (A := A) T gs y, ∑ s ∈ pathDepths (A := A) T gs y G,
        (D.toLeafQ qG).s2 G (pathCell A.G T y s) =
        ∑ I ∈ T with y ∈ dyadicGridCell A.G I.1 I.2, ∑ G ∈ gs I, (D.toLeafQ qG).s2 G I := by
      unfold pathGroups pathDepths
      convert (path_sum_reindex A.G T gs y (fun I G => (D.toLeafQ qG).s2 G I)).symm
    calc ∑ G ∈ pathGroups (A := A) T gs y, ∑ s ∈ pathDepths (A := A) T gs y G,
          (D.withQ0 (qG G)).sideWeight G l (pathCell A.G T y) c.2.2.2.1 s
        ≤ ∑ G ∈ pathGroups (A := A) T gs y, ∑ s ∈ pathDepths (A := A) T gs y G,
          (c.2.2.2.1 ^ 2)⁻¹ * (D.toLeafQ qG).s2 G (pathCell A.G T y s) :=
          Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun s _ => hW G s
      _ = (c.2.2.2.1 ^ 2)⁻¹ * ∑ I ∈ T with y ∈ dyadicGridCell A.G I.1 I.2, ∑ G ∈ gs I,
          (D.toLeafQ qG).s2 G I := by
          rw [← hre, Finset.mul_sum]
          exact Finset.sum_congr rfl fun G _ => by rw [Finset.mul_sum]
      _ ≤ (c.2.2.2.1 ^ 2)⁻¹ * K := mul_le_mul_of_nonneg_left (hside y) (inv_nonneg.mpr
          (sq_nonneg _))
      _ = K * (c.2.2.2.1 ^ 2)⁻¹ := mul_comm _ _

end SideInput

end ActiveSetup.BasicFamilies.FamParams


namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

/-- A mode lies in its own predecessor set (the identity representatives). -/
theorem self_mem_predOfMode (Δ h : ℕ) (c : ℤ × (ℤ × ℤ) × Ms.Md) :
    c.2.2 ∈ Ms.predOfMode S hA Δ h c := by
  unfold ModeSystem.predOfMode
  split_ifs with hm
  · exact Finset.mem_map_of_mem _ (ModeComponents.E_self _ _ _)
  · exact Finset.mem_singleton_self _

end ModeSystem

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

open Classical in
/-- A final class of a role at a cell lies on a retained pre-cell of its block: its class node is
a successful node over the retained pairs of the blocks `Bs` containing the block of the cell. -/
theorem classNode_mem_succNodes_ret {G : bf.Grp} {I : ℤ × ℤ} {j : Fin 4} {h : ℕ}
    {F : Finset (D.Ms j G).Md} (hF : F ∈ D.goodCls G I j h) {Bs : Finset ℤ}
    (hB : A.blkStart D.S.K I.1 ∈ Bs) :
    D.classNode G I j h hF ∈
      (D.Ms j G).succNodes D.S D.hA D.SP (fp.retainedPairs G Bs D.S.K) h := by
  obtain ⟨K, hK, -⟩ := Finset.mem_image.mp hF
  have hc := (Finset.mem_filter.mp hK).1
  unfold compsAt at hc
  split_ifs at hc with hr
  · exact D.classNode_mem_succNodes hF ((fp.mem_retainedPairs).mpr ⟨hB, hr.2⟩)
  · exact absurd hc (Finset.notMem_empty _)

open Classical in
/-- The representatives of the leaf core estimate: those of the type classes of the groups of
`gset` (`first_top_count_main`), the identity representatives outside `gset`. -/
noncomputable def leafRep (gset : Finset bf.Grp) (qG : bf.Grp → ℕ)
    (Rr : ∀ (j : Fin 4) (h : ℕ) (_ : ℕ × ℕ) (G : {G // G ∈ gset}),
      (D.Ms j G.1).RepClass (D.withQ0 (qG G.1)).S D.hA D.SP 10 h)
    (h : ℕ) (G : bf.Grp) (j : Fin 4) (k₁ k₂ : ℕ) :
    ℤ × (ℤ × ℤ) × (D.Ms j G).Md → (D.Ms j G).Md :=
  if hG : G ∈ gset then (Rr j h (k₁, k₂) ⟨G, hG⟩).rep else fun c => c.2.2

open Classical in
/-- The nodes of the type classes of the leaf representatives (empty outside `gset` and the
types `Ts`). -/
noncomputable def leafNd (gset : Finset bf.Grp) (qG : bf.Grp → ℕ)
    (Rr : ∀ (j : Fin 4) (h : ℕ) (_ : ℕ × ℕ) (G : {G // G ∈ gset}),
      (D.Ms j G.1).RepClass (D.withQ0 (qG G.1)).S D.hA D.SP 10 h)
    (Ts : Finset (ℕ × ℕ)) (j : Fin 4) (h : ℕ) (t : ℕ × ℕ) (G : bf.Grp) :
    Finset (ℤ × (ℤ × ℤ) × (D.Ms j G).Md) :=
  if hG : G ∈ gset ∧ t ∈ Ts then (Rr j h t ⟨G, hG.1⟩).Nd else ∅

theorem leafRep_pred (gset : Finset bf.Grp) (qG : bf.Grp → ℕ)
    (Rr : ∀ (j : Fin 4) (h : ℕ) (_ : ℕ × ℕ) (G : {G // G ∈ gset}),
      (D.Ms j G.1).RepClass (D.withQ0 (qG G.1)).S D.hA D.SP 10 h)
    (G : bf.Grp) (j : Fin 4) (h : ℕ) (k₁ k₂ : ℕ) (c : ℤ × (ℤ × ℤ) × (D.Ms j G).Md) :
    D.leafRep gset qG Rr h G j k₁ k₂ c ∈ (D.Ms j G).predOfMode (D.withQ0 (qG G)).S D.hA 10 h c := by
  unfold leafRep
  split_ifs with hG
  · exact (Rr j h (k₁, k₂) ⟨G, hG⟩).hrep c
  · exact (D.Ms j G).self_mem_predOfMode (D.withQ0 (qG G)).S D.hA 10 h c

open Classical in
/-- The leaf representatives have the properties `RepOK` on the cells `T` (`repOK_of_repClass`)
when the type-class nodes are the successful nodes of their type over the retained pairs of the
blocks `Bs` (as in `first_top_count_main`) and the blocks of the cells of `T` lie in `Bs`. -/
theorem leafRep_repOK (gset : Finset bf.Grp) (qG : bf.Grp → ℕ)
    (Rr : ∀ (j : Fin 4) (h : ℕ) (_ : ℕ × ℕ) (G : {G // G ∈ gset}),
      (D.Ms j G.1).RepClass (D.withQ0 (qG G.1)).S D.hA D.SP 10 h)
    (Bs : Finset ℤ) (hNdR : ∀ j, ∀ h ≤ D.SP.Jst, ∀ t (G : {G // G ∈ gset}) c,
      c ∈ (D.Ms j G.1).succNodes (D.withQ0 (qG G.1)).S D.hA D.SP
        (fp.retainedPairs G.1 Bs D.S.K) h →
      (D.Ms j G.1).nodeType1 (D.withQ0 (qG G.1)).S D.hA 10 h c = t.1 →
      (D.Ms j G.1).nodeType2 (D.withQ0 (qG G.1)).S D.hA 10 h c = t.2 → c ∈ (Rr j h t G).Nd)
    (T : Finset (ℤ × ℤ)) (hTB : ∀ I ∈ T, A.blkStart D.S.K I.1 ∈ Bs)
    {G : bf.Grp} (hG : G ∈ gset) (j : Fin 4) (h : ℕ) (hh : h ≤ D.SP.Jst) :
    (D.withQ0 (qG G)).RepOK G j h T (D.leafRep gset qG Rr h G j) := by
  have e : D.leafRep gset qG Rr h G j = fun k₁ k₂ => (Rr j h (k₁, k₂) ⟨G, hG⟩).rep := by
    funext k₁ k₂
    unfold leafRep
    rw [dite_eq_left hG]
  rw [e]
  refine (D.withQ0 (qG G)).repOK_of_repClass G j h T (fun k₁ k₂ => Rr j h (k₁, k₂) ⟨G, hG⟩)
    fun k₁ k₂ c hc => ?_
  obtain ⟨hcN, htyp⟩ := Finset.mem_filter.mp hc
  obtain ⟨I, hI, F, hF, rfl⟩ := (D.withQ0 (qG G)).mem_classNodes.mp hcN
  exact hNdR j h hh (k₁, k₂) ⟨G, hG⟩ _
    ((D.withQ0 (qG G)).classNode_mem_succNodes_ret hF (hTB I hI))
    htyp.1 htyp.2

open Classical in
/-- The class nodes of the leaf classes lie in the type-class nodes of their type. -/
theorem leafNd_mem (gset : Finset bf.Grp) (qG : bf.Grp → ℕ)
    (Rr : ∀ (j : Fin 4) (h : ℕ) (_ : ℕ × ℕ) (G : {G // G ∈ gset}),
      (D.Ms j G.1).RepClass (D.withQ0 (qG G.1)).S D.hA D.SP 10 h)
    (Bs : Finset ℤ) (hNdR : ∀ j, ∀ h ≤ D.SP.Jst, ∀ t (G : {G // G ∈ gset}) c,
      c ∈ (D.Ms j G.1).succNodes (D.withQ0 (qG G.1)).S D.hA D.SP
        (fp.retainedPairs G.1 Bs D.S.K) h →
      (D.Ms j G.1).nodeType1 (D.withQ0 (qG G.1)).S D.hA 10 h c = t.1 →
      (D.Ms j G.1).nodeType2 (D.withQ0 (qG G.1)).S D.hA 10 h c = t.2 → c ∈ (Rr j h t G).Nd)
    {I : ℤ × ℤ} (hB : A.blkStart D.S.K I.1 ∈ Bs) {G : bf.Grp} (hG : G ∈ gset) (j : Fin 4)
    (h : ℕ) (hh : h ≤ D.SP.Jst) (hcard : (((D.Ms j G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    {F : Finset (D.Ms j G).Md} (hF : F ∈ (D.withQ0 (qG G)).goodCls G I j h) :
    (D.withQ0 (qG G)).classNode G I j h hF ∈
      D.leafNd gset qG Rr (Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1) ×ˢ
        Finset.range (Nat.log 2 ⌊D.S.Dstar⌋₊ + 1)) j h
        ((D.withQ0 (qG G)).classTypeOf G I j h F) G := by
  have hTs := (D.withQ0 (qG G)).classTypeOf_mem G I j h F hcard
  have e : (D.withQ0 (qG G)).classTypeOf G I j h F =
      ((D.Ms j G).nodeType1 (D.withQ0 (qG G)).S D.hA 10 h
        ((D.withQ0 (qG G)).classNode G I j h hF),
      (D.Ms j G).nodeType2 (D.withQ0 (qG G)).S D.hA 10 h
        ((D.withQ0 (qG G)).classNode G I j h hF)) := dite_eq_left hF
  unfold leafNd
  rw [dite_eq_left ⟨hG, hTs⟩]
  exact hNdR j h hh _ ⟨G, hG⟩ _ ((D.withQ0 (qG G)).classNode_mem_succNodes_ret hF hB)
    (congrArg Prod.fst e).symm (congrArg Prod.snd e).symm

open Classical in
/-- Blueprint `eq:top-count` (lines 2212-2229) at the retained dyadic amplitudes of a leaf: from the
retained-path top counts of `first_top_count_main` (thresholds `σ ∈ Thr`, all `σ ≥ D_*^{-1}`, the
cells of `T` outside the top-count cuts `Cut j`) and, for `σ < D_*^{-1}`, the full mode budget
along a path (`usedReps_le_Dstar`, then `D_* ≤ σ^{-2}`), the counts of distinct used
representatives over the groups of the path of `y` are at most `max(1, M_t) σ^{-2}` (the input
`hcount` of `four_hcap_leaf` and `three_hcap_leaf`). -/
theorem leaf_hcount (gset : Finset bf.Grp) (qG : bf.Grp → ℕ)
    (Rr : ∀ (j : Fin 4) (h : ℕ) (_ : ℕ × ℕ) (G : {G // G ∈ gset}),
      (D.Ms j G.1).RepClass (D.withQ0 (qG G.1)).S D.hA D.SP 10 h)
    (Ts : Finset (ℕ × ℕ)) (T : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset bf.Grp)
    (hgs : ∀ I ∈ T, gs I ⊆ gset) (Cut : Fin 4 → Finset (ℤ × ℤ))
    (hTcut : ∀ I ∈ T, ∀ j, ∀ e ∈ Cut j,
      ¬ dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e.1 e.2)
    (Thr : Finset ℝ) {ε U Mt : ℝ} (hε : 0 < ε)
    (hThr : ∀ σ, ε ≤ σ → σ ≤ U → (∃ k : ℤ, σ = (2 : ℝ) ^ k) → D.S.Dstar⁻¹ ≤ σ → σ ∈ Thr)
    (hD1 : 1 ≤ D.S.Dstar)
    (hTop : ∀ j y, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ t ∈ Ts, ∀ σ ∈ Thr,
      (∑ G : {G // G ∈ gset}, (((fp.useInst G.1 D.S.K (Rr j h t G).Nd).filter fun p =>
          (∀ e ∈ Cut j, ¬ dyadicGridCell A.G p.1.1 p.1.2 ⊆ dyadicGridCell A.G e.1 e.2) ∧
          y ∈ dyadicGridCell A.G p.1.1 p.1.2 ∧
            σ ^ 2 ≤ (D.Ms j G.1).nodeSize (D.withQ0 (qG G.1)).S D.hA D.SP (D.c j G.1) h p).image
          fun p => (Rr j h t G).rep p.2).card : ℝ) ≤ Mt * σ ^ (-2 : ℝ))
    (hpathD : ∀ j y, (∑ G : {G // G ∈ gset}, ((D.Ms j G.1).ptSet y).card : ℝ) ≤ D.S.Dstar) :
    ∀ y, ∀ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs, ∀ j t σ, ε ≤ σ → σ ≤ U →
      (∃ k : ℤ, σ = (2 : ℝ) ^ k) →
      ∑ G ∈ pathGroups (A := A) T gs y,
        ((((fp.useInst G D.S.K (D.leafNd gset qG Rr Ts j h t G)).filter fun p =>
          p.1 ∈ T ∧ y ∈ dyadicGridCell A.G p.1.1 p.1.2 ∧
            σ ^ 2 ≤ (D.Ms j G).nodeSize (D.withQ0 (qG G)).S D.hA D.SP (D.c j G) h p).image
          fun p => D.leafRep gset qG Rr h G j t.1 t.2 p.2).card : ℝ) ≤
        max 1 Mt * σ ^ (-2 : ℝ) := by
  intro y h hh j t σ hεσ hσU hdy
  have hσ : 0 < σ := lt_of_lt_of_le hε hεσ
  have hσ2 : (0 : ℝ) ≤ σ ^ (-2 : ℝ) := Real.rpow_nonneg hσ.le _
  have hK : 0 ≤ max 1 Mt * σ ^ (-2 : ℝ) := mul_nonneg (le_trans zero_le_one (le_max_left _ _)) hσ2
  by_cases ht : t ∈ Ts
  swap
  · refine le_of_eq_of_le (Finset.sum_eq_zero fun G _ => ?_) hK
    have : D.leafNd gset qG Rr Ts j h t G = ∅ := by
      unfold leafNd
      exact dite_eq_right fun hG => ht hG.2
    rw [this]
    unfold useInst
    simp
  -- the counts over the groups of the path are counts over `gset`
  set cnt : {G // G ∈ gset} → ℝ := fun G => (((fp.useInst G.1 D.S.K (Rr j h t G).Nd).filter
      fun p => (∀ e ∈ Cut j, ¬ dyadicGridCell A.G p.1.1 p.1.2 ⊆ dyadicGridCell A.G e.1 e.2) ∧
        y ∈ dyadicGridCell A.G p.1.1 p.1.2 ∧
          σ ^ 2 ≤ (D.Ms j G.1).nodeSize (D.withQ0 (qG G.1)).S D.hA D.SP (D.c j G.1) h p).image
      fun p => (Rr j h t G).rep p.2).card with hcnt
