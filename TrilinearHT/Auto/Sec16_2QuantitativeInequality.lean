    dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e.1 e.2) with hS'
  have hS'1 : ∀ I ∈ S', I ∈ Sc := fun I hI => (Finset.mem_filter.mp hI).1
  have hS'C1 : ∀ I ∈ S', ¬ ∃ e ∈ C1, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e.1 e.2 :=
