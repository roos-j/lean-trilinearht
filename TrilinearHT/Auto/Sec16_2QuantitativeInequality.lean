          C₀ ^ 2 * T.D.S.K * ∑ J ∈ A.cells, T.frzD c d G (T.tOf c i) (T.tOf d i') j o J := hflag
      have h17 := mul_le_mul_of_nonneg_left hD (by positivity : (0 : ℝ) ≤ 17 * C₀ ^ 2)
