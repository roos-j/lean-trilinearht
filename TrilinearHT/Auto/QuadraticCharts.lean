/-- The logarithmic size parameter in blueprint Lemma `lem:budget-rules`. -/
noncomputable def logarithmicSize (t : ℝ) : ℝ := 1 + Real.log t

/-- Blueprint Lemma `lem:budget-rules`: an explicit quasipolynomial majorant.
The coefficient and degree are chosen before the universally quantified parameter. -/
def QuasipolynomialBound (f : ℝ → ℝ) : Prop :=
  ∃ C : ℝ, 1 ≤ C ∧ ∃ d : ℕ, 1 ≤ d ∧
    ∀ t : ℝ, 2 ≤ t → 0 ≤ f t ∧ f t ≤ Real.exp (C * logarithmicSize t ^ d)

theorem one_le_logarithmicSize {t : ℝ} (ht : 2 ≤ t) : 1 ≤ logarithmicSize t := by
  have := Real.log_nonneg (show 1 ≤ t by linarith)
  dsimp [logarithmicSize]
  linarith

/-- Increasing the degree of a logarithmic majorant on the source domain. -/
theorem logarithmicSize_pow_mono {t : ℝ} (ht : 2 ≤ t) {d e : ℕ} (hde : d ≤ e) :
    logarithmicSize t ^ d ≤ logarithmicSize t ^ e :=
  pow_le_pow_right₀ (one_le_logarithmicSize ht) hde

/-- Blueprint Lemma `lem:budget-rules`, closure under products. -/
theorem quasipolynomialBound_mul {f g : ℝ → ℝ}
    (hf : QuasipolynomialBound f) (hg : QuasipolynomialBound g) :
    QuasipolynomialBound (fun t => f t * g t) := by
  obtain ⟨C, hC, d, hd, hf⟩ := hf
  obtain ⟨D, hD, e, he, hg⟩ := hg
  refine ⟨C + D, by linarith, d + e, by omega, ?_⟩
  intro t ht
  obtain ⟨hf0, hf1⟩ := hf t ht
  obtain ⟨hg0, hg1⟩ := hg t ht
  refine ⟨mul_nonneg hf0 hg0, ?_⟩
  calc
    f t * g t ≤ Real.exp (C * logarithmicSize t ^ d) *
        Real.exp (D * logarithmicSize t ^ e) := mul_le_mul hf1 hg1 hg0 (by positivity)
    _ = Real.exp (C * logarithmicSize t ^ d + D * logarithmicSize t ^ e) :=
      (Real.exp_add _ _).symm
    _ ≤ Real.exp ((C + D) * logarithmicSize t ^ (d + e)) := by
      apply Real.exp_le_exp.mpr
      have h₁ := mul_le_mul_of_nonneg_left
        (logarithmicSize_pow_mono ht (Nat.le_add_right d e)) (show 0 ≤ C by linarith)
      have h₂ := mul_le_mul_of_nonneg_left
        (logarithmicSize_pow_mono ht (Nat.le_add_left e d)) (show 0 ≤ D by linarith)
      nlinarith

/-- Blueprint Lemma `lem:budget-rules`, closure under sums. -/
theorem quasipolynomialBound_add {f g : ℝ → ℝ}
    (hf : QuasipolynomialBound f) (hg : QuasipolynomialBound g) :
    QuasipolynomialBound (fun t => f t + g t) := by
  obtain ⟨C, hC, d, hd, hf⟩ := hf
  obtain ⟨D, hD, e, he, hg⟩ := hg
  refine ⟨C + D + 1, by linarith, d + e, by omega, ?_⟩
  intro t ht
  obtain ⟨hf0, hf1⟩ := hf t ht
  obtain ⟨hg0, hg1⟩ := hg t ht
  have hu : 1 ≤ logarithmicSize t ^ (d + e) :=
    one_le_pow₀ (one_le_logarithmicSize ht)
  have hC0 : 0 ≤ C := by linarith
  have hD0 : 0 ≤ D := by linarith
  have h₁ : C * logarithmicSize t ^ d ≤ (C + D) * logarithmicSize t ^ (d + e) := by
    calc
      _ ≤ C * logarithmicSize t ^ (d + e) :=
        mul_le_mul_of_nonneg_left (logarithmicSize_pow_mono ht (Nat.le_add_right d e)) hC0
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) (by linarith)
  have h₂ : D * logarithmicSize t ^ e ≤ (C + D) * logarithmicSize t ^ (d + e) := by
    calc
      _ ≤ D * logarithmicSize t ^ (d + e) :=
        mul_le_mul_of_nonneg_left (logarithmicSize_pow_mono ht (Nat.le_add_left e d)) hD0
      _ ≤ _ := mul_le_mul_of_nonneg_right (by linarith) (by linarith)
  have htwo : 2 ≤ Real.exp (logarithmicSize t ^ (d + e)) := by
    have := Real.add_one_le_exp (logarithmicSize t ^ (d + e))
    linarith
  refine ⟨add_nonneg hf0 hg0, ?_⟩
  calc
    f t + g t ≤ 2 * Real.exp ((C + D) * logarithmicSize t ^ (d + e)) := by
      have := Real.exp_le_exp.mpr h₁
      have := Real.exp_le_exp.mpr h₂
      linarith
    _ ≤ Real.exp (logarithmicSize t ^ (d + e)) *
        Real.exp ((C + D) * logarithmicSize t ^ (d + e)) := by gcongr
    _ = Real.exp ((C + D + 1) * logarithmicSize t ^ (d + e)) := by
      rw [← Real.exp_add]
      congr 1
      ring

/-- A nonnegative constant has a quasipolynomial bound (including the empty-sum case). -/
theorem quasipolynomialBound_const {c : ℝ} (hc : 0 ≤ c) :
    QuasipolynomialBound (fun _ => c) := by
  refine ⟨c + 1, by linarith, 1, le_rfl, ?_⟩
  intro t ht
  refine ⟨hc, ?_⟩
  have hu := one_le_logarithmicSize ht
  have hx : c ≤ (c + 1) * logarithmicSize t := by nlinarith
  simpa using (show c ≤ Real.exp ((c + 1) * logarithmicSize t) from
    (by linarith [Real.add_one_le_exp c] : c ≤ Real.exp c).trans (Real.exp_le_exp.mpr hx))

/-- Blueprint Lemma `lem:budget-rules`: any fixed finite sum preserves the bound. -/
theorem quasipolynomialBound_sum {ι : Type*} (s : Finset ι) (f : ι → ℝ → ℝ)
    (hf : ∀ i ∈ s, QuasipolynomialBound (f i)) :
    QuasipolynomialBound (fun t => ∑ i ∈ s, f i t) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using (quasipolynomialBound_const (c := 0) le_rfl)
  | @insert a s ha ih =>
    simpa [Finset.sum_insert, ha] using
      quasipolynomialBound_add (hf a (by simp)) (ih (fun i hi => hf i (by simp [hi])))

/-- Blueprint Lemma `lem:budget-rules`: any fixed finite product preserves the bound. -/
theorem quasipolynomialBound_prod {ι : Type*} (s : Finset ι) (f : ι → ℝ → ℝ)
    (hf : ∀ i ∈ s, QuasipolynomialBound (f i)) :
    QuasipolynomialBound (fun t => ∏ i ∈ s, f i t) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using (quasipolynomialBound_const (c := 1) zero_le_one)
  | @insert a s ha ih =>
    simpa [Finset.prod_insert, ha] using
      quasipolynomialBound_mul (hf a (by simp)) (ih (fun i hi => hf i (by simp [hi])))

/-- Blueprint Lemma `lem:budget-rules`, closure under nonnegative fixed real powers. -/
theorem quasipolynomialBound_rpow {f : ℝ → ℝ} (hf : QuasipolynomialBound f)
    {p : ℝ} (hp : 0 ≤ p) : QuasipolynomialBound (fun t => f t ^ p) := by
  obtain ⟨C, hC, d, hd, hf⟩ := hf
  refine ⟨C * (p + 1), by nlinarith, d, hd, ?_⟩
  intro t ht
  obtain ⟨hf0, hf1⟩ := hf t ht
  refine ⟨Real.rpow_nonneg hf0 p, ?_⟩
  calc
    f t ^ p ≤ Real.exp (C * logarithmicSize t ^ d) ^ p :=
      Real.rpow_le_rpow hf0 hf1 hp
    _ = Real.exp (C * logarithmicSize t ^ d * p) := (Real.exp_mul _ _).symm
    _ ≤ Real.exp (C * (p + 1) * logarithmicSize t ^ d) := by
      apply Real.exp_le_exp.mpr
      have hu : 0 ≤ logarithmicSize t ^ d :=
        pow_nonneg (by linarith [one_le_logarithmicSize ht]) _
      nlinarith

/-- Blueprint Lemma `lem:budget-rules`, closure under composition on its stated domain.
The inner function takes values at least two, so the outer bound is applicable. -/
theorem quasipolynomialBound_comp {f g : ℝ → ℝ}
    (hf : QuasipolynomialBound f) (hg : QuasipolynomialBound g)
    (hg2 : ∀ t, 2 ≤ t → 2 ≤ g t) :
    QuasipolynomialBound (fun t => f (g t)) := by
  obtain ⟨C, hC, d, hd, hf⟩ := hf
  obtain ⟨D, hD, e, he, hg⟩ := hg
  refine ⟨C * (1 + D) ^ d, ?_, e * d, by nlinarith, ?_⟩
  · have := one_le_pow₀ (show 1 ≤ 1 + D by linarith) (n := d)
    nlinarith
  intro t ht
  obtain ⟨hf0, hf1⟩ := hf (g t) (hg2 t ht)
  have hgpos : 0 < g t := by linarith [hg2 t ht]
  have hlog : Real.log (g t) ≤ D * logarithmicSize t ^ e := by
    have := Real.log_le_log hgpos (hg t ht).2
    simpa only [Real.log_exp] using this
  have hu : 1 ≤ logarithmicSize t ^ e := one_le_pow₀ (one_le_logarithmicSize ht)
  have hsize : logarithmicSize (g t) ≤ (1 + D) * logarithmicSize t ^ e := by
    dsimp [logarithmicSize] at hlog hu ⊢
    nlinarith
  refine ⟨hf0, hf1.trans (Real.exp_le_exp.mpr ?_)⟩
  calc
    C * logarithmicSize (g t) ^ d ≤ C * ((1 + D) * logarithmicSize t ^ e) ^ d := by
      gcongr
      linarith [one_le_logarithmicSize (hg2 t ht)]
    _ = C * (1 + D) ^ d * logarithmicSize t ^ (e * d) := by
      rw [mul_pow, ← pow_mul]
      ring

/-- Primitive numerator/denominator height for chart matrices. -/
def chartRationalHeight (q : ℚ) : ℕ := max q.num.natAbs q.den

theorem chartRationalHeight_neg (q : ℚ) : chartRationalHeight (-q) = chartRationalHeight q :=
  rationalHeight_neg q

/-! ### Quadratic chart definitions

Blueprint `def:chart`, lines 625-637. The horizontal frequencies and the
ordinary real quadratic and linear phases are unrestricted. Complexity is
charged only to dimension, rational matrix height, support and cutoff derivatives.
-/

/-- A coordinate mixed derivative, indexed by its ordered coordinate word.
For smooth functions this is the usual multi-index derivative of total order `m`. -/
noncomputable def coordinateWordDerivative {d : ℕ} (m : ℕ)
    (χ : (Fin d → ℝ) → ℂ) (word : Fin m → Fin d) (z : Fin d → ℝ) : ℂ :=
  iteratedFDeriv ℝ m χ z (fun i => Pi.single (word i) 1)

theorem coordinateWordDerivative_zero {d : ℕ} (χ : (Fin d → ℝ) → ℂ)
    (word : Fin 0 → Fin d) (z : Fin d → ℝ) :
    coordinateWordDerivative 0 χ word z = χ z := rfl

/-- The data in the source quadratic chart formula. Smoothness means
`C-infinity`, and imposes no analyticity assumption on the compact cutoff. -/
structure QuadraticChartData (d : ℕ) where
  horizontal : Fin d → ℝ
  quadratic : ℝ
  linear : ℝ
  matrix : Matrix (Fin d) (Fin d) ℚ
  amplitude : (Fin d → ℝ) → ℂ
  smooth : ContDiff ℝ (⊤ : ℕ∞) amplitude
  compact : HasCompactSupport amplitude

/-- The bilinear phase `z^T C w` in a quadratic chart. -/
noncomputable def chartMatrixPhase {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (z w : Fin d → ℝ) : ℝ := ∑ i, ∑ j, z i * (C i j : ℝ) * w j

noncomputable def chartHorizontalPosition {d : ℕ} (A : QuadraticChartData d) (y : ℝ) :
    Fin d → ℝ := fun i => A.horizontal i * y

noncomputable def chartLatticeRemainder {d : ℕ} (A : QuadraticChartData d)
    (y : ℝ) (n : Fin d → ℤ) : Fin d → ℝ :=
  fun i => A.horizontal i * y - (n i : ℝ)

noncomputable def quadraticChartLatticeSummand {d : ℕ} (A : QuadraticChartData d)
    (y : ℝ) (n : Fin d → ℤ) : ℂ :=
  A.amplitude (chartLatticeRemainder A y n) *
    (Real.fourierChar (chartMatrixPhase A.matrix (chartHorizontalPosition A y)
      (chartLatticeRemainder A y n)) : ℂ)

/-- Blueprint `def:chart`, formula (atom): the actual quadratic chart function. -/
noncomputable def quadraticChartAtom {d : ℕ} (A : QuadraticChartData d) (y : ℝ) : ℂ :=
  (Real.fourierChar (A.quadratic * y ^ 2 + A.linear * y) : ℂ) *
    ∑' n : Fin d → ℤ, quadraticChartLatticeSummand A y n

/-- The source complexity convention at one fixed Gevrey order `c₀`.
Coordinate words encode mixed partial derivatives and their length is total order.
The real phase and horizontal parameters deliberately carry no size restrictions. -/
structure QuadraticChartComplexity {d : ℕ} (c₀ : ℕ) (H : ℝ)
    (A : QuadraticChartData d) : Prop where
  lower : Real.exp 2 ≤ H
  dimension : (d : ℝ) ≤ Real.log H
  height : ∀ i j, (chartRationalHeight (A.matrix i j) : ℝ) ≤ H
  support : ∀ z, A.amplitude z ≠ 0 → ∀ i, |z i| ≤ H
  derivative : ∀ (m : ℕ) (word : Fin m → Fin d) (z : Fin d → ℝ),
    ‖coordinateWordDerivative m A.amplitude word z‖ ≤
      H ^ (c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1))

/-- A bounded atom has pointwise supremum norm at most one. -/
def IsBoundedQuadraticChart {d : ℕ} (A : QuadraticChartData d) : Prop :=
  ∀ y : ℝ, ‖quadraticChartAtom A y‖ ≤ 1

theorem quadraticChartComplexity_parameter_pos {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) : 0 < H :=
  (Real.exp_pos 2).trans_le hA.lower

theorem quadraticChartComplexity_amplitude_bound {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (z : Fin d → ℝ) :
    ‖A.amplitude z‖ ≤ H ^ c₀ := by
  simpa only [coordinateWordDerivative_zero, Nat.zero_add, mul_one, Nat.cast_zero,
    zero_add, one_pow] using hA.derivative 0 Fin.elim0 z

theorem norm_quadraticChartLatticeSummand {d : ℕ} (A : QuadraticChartData d)
    (y : ℝ) (n : Fin d → ℤ) :
    ‖quadraticChartLatticeSummand A y n‖ = ‖A.amplitude (chartLatticeRemainder A y n)‖ := by
  rw [quadraticChartLatticeSummand, norm_mul, Circle.norm_coe, mul_one]

theorem norm_quadraticChartAtom {d : ℕ} (A : QuadraticChartData d) (y : ℝ) :
    ‖quadraticChartAtom A y‖ = ‖∑' n : Fin d → ℤ, quadraticChartLatticeSummand A y n‖ := by
  rw [quadraticChartAtom, norm_mul, Circle.norm_coe, one_mul]

/-! ### Quadratic chart lattice sums -/

/-- A finite integer box containing every lattice translate that can
meet a cutoff supported in `[-H,H]^d` at horizontal position `z`. -/
noncomputable def chartLatticeBox {d : ℕ} (H : ℝ) (z : Fin d → ℝ) :
    Finset (Fin d → ℤ) :=
  Fintype.piFinset (fun i => Finset.Icc ⌊z i - H⌋ ⌊z i + H⌋)

theorem mem_chartLatticeBox_of_bound {d : ℕ} {H : ℝ} {z : Fin d → ℝ}
    {n : Fin d → ℤ} (hn : ∀ i, |z i - (n i : ℝ)| ≤ H) :
    n ∈ chartLatticeBox H z := by
  apply Fintype.mem_piFinset.mpr
  intro i
  obtain ⟨hlo, hhi⟩ := abs_le.mp (hn i)
  have hl : z i - H ≤ (n i : ℝ) := by linarith
  have hu : (n i : ℝ) ≤ z i + H := by linarith
  refine Finset.mem_Icc.mpr ⟨?_, Int.le_floor.mpr hu⟩
  simpa using Int.floor_mono hl

theorem chartLatticeBox_card_le {d : ℕ} {H : ℝ} (hH : 0 ≤ H) (z : Fin d → ℝ) :
    ((chartLatticeBox H z).card : ℝ) ≤ (2 * H + 3) ^ d := by
  rw [chartLatticeBox, Fintype.card_piFinset, Nat.cast_prod]
  calc
    _ ≤ ∏ _i : Fin d, (2 * H + 3) := by
      apply Finset.prod_le_prod₀
      · intro i _
        positivity
      · intro i _
        have hh := integer_floor_interval_card_le (show z i - H ≤ z i + H by linarith)
        linarith
    _ = _ := by simp

theorem quadraticChartSummand_eq_zero_off_box {d : ℕ} (A : QuadraticChartData d)
    {H : ℝ} (hχ : ∀ z, A.amplitude z ≠ 0 → ∀ i, |z i| ≤ H)
    (y : ℝ) {n : Fin d → ℤ} (hn : n ∉ chartLatticeBox H (chartHorizontalPosition A y)) :
    quadraticChartLatticeSummand A y n = 0 := by
  have hz : A.amplitude (chartLatticeRemainder A y n) = 0 := by
    by_contra hh
    apply hn
    exact mem_chartLatticeBox_of_bound (hχ _ hh)
  simp only [quadraticChartLatticeSummand, hz, zero_mul]

theorem quadraticChartData_support_bound {d : ℕ} (A : QuadraticChartData d) :
    ∃ H : ℝ, 0 < H ∧ ∀ z, A.amplitude z ≠ 0 → ∀ i, |z i| ≤ H := by
  obtain ⟨H, hH, hbound⟩ := A.compact.isBounded.exists_pos_norm_le
  refine ⟨H, hH, ?_⟩
  intro z hz i
  have hznorm : ‖z‖ ≤ H := hbound z (subset_tsupport A.amplitude hz)
  exact (show |z i| ≤ ‖z‖ by simpa only [Real.norm_eq_abs] using norm_le_pi_norm z i).trans hznorm

/-- Compact support makes the chart's lattice series a genuine finite sum. -/
theorem quadraticChartLatticeSummand_finite_support {d : ℕ} (A : QuadraticChartData d) (y : ℝ) :
    (Function.support (quadraticChartLatticeSummand A y)).Finite := by
  obtain ⟨H, _, hχ⟩ := quadraticChartData_support_bound A
  apply (chartLatticeBox H (chartHorizontalPosition A y)).finite_toSet.subset
  intro n hn
  by_contra hh
  exact hn (quadraticChartSummand_eq_zero_off_box A hχ y hh)

theorem quadraticChartLatticeSummand_summable {d : ℕ} (A : QuadraticChartData d) (y : ℝ) :
    Summable (quadraticChartLatticeSummand A y) :=
  summable_of_hasFiniteSupport (quadraticChartLatticeSummand_finite_support A y)

theorem quadraticChartAtom_eq_sum {d c₀ : ℕ} {H : ℝ} {A : QuadraticChartData d}
    (hA : QuadraticChartComplexity c₀ H A) (y : ℝ) :
    quadraticChartAtom A y = (Real.fourierChar (A.quadratic * y ^ 2 + A.linear * y) : ℂ) *
      ∑ n ∈ chartLatticeBox H (chartHorizontalPosition A y),
        quadraticChartLatticeSummand A y n := by
  rw [quadraticChartAtom, tsum_eq_sum (s := chartLatticeBox H (chartHorizontalPosition A y))
    (fun n hn => quadraticChartSummand_eq_zero_off_box A hA.support y hn)]

/-- Blueprint `def:chart`, lines 635-637: at most `(2H+3)^d` nonzero
lattice summands contribute at a point. -/
theorem quadraticChart_nonzero_summands_card_le {d c₀ : ℕ} {H : ℝ} {A : QuadraticChartData d}
    (hA : QuadraticChartComplexity c₀ H A) (y : ℝ) :
    ((quadraticChartLatticeSummand_finite_support A y).toFinset.card : ℝ) ≤ (2 * H + 3) ^ d := by
  apply le_trans _ (chartLatticeBox_card_le (quadraticChartComplexity_parameter_pos hA).le
    (chartHorizontalPosition A y))
  apply Nat.cast_le.mpr
  apply Finset.card_le_card
  intro n hn
  have hne := (Set.Finite.mem_toFinset _).mp hn
  by_contra hh
  exact hne (quadraticChartSummand_eq_zero_off_box A hA.support y hh)

theorem quadraticChartAtom_norm_le {d c₀ : ℕ} {H : ℝ} {A : QuadraticChartData d}
    (hA : QuadraticChartComplexity c₀ H A) (y : ℝ) :
    ‖quadraticChartAtom A y‖ ≤ (2 * H + 3) ^ d * H ^ c₀ := by
  rw [quadraticChartAtom_eq_sum hA y, norm_mul, Circle.norm_coe, one_mul]
  calc
    _ ≤ ∑ n ∈ chartLatticeBox H (chartHorizontalPosition A y),
        ‖quadraticChartLatticeSummand A y n‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _n ∈ chartLatticeBox H (chartHorizontalPosition A y), H ^ c₀ := by
      apply Finset.sum_le_sum
      intro n _
      rw [norm_quadraticChartLatticeSummand]
      exact quadraticChartComplexity_amplitude_bound hA _
    _ = ((chartLatticeBox H (chartHorizontalPosition A y)).card : ℝ) * H ^ c₀ := by simp
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (chartLatticeBox_card_le (quadraticChartComplexity_parameter_pos hA).le
        (chartHorizontalPosition A y)) (pow_nonneg (quadraticChartComplexity_parameter_pos hA).le _)

/-! ### Quadratic chart normalization -/

/-- Ordinary quadratic phases are zero-dimensional chart atoms. -/
noncomputable def ordinaryQuadraticChart (lam β : ℝ) : QuadraticChartData 0 where
  horizontal := Fin.elim0
  quadratic := lam
  linear := β
  matrix := fun i => Fin.elim0 i
  amplitude := fun _ => 1
  smooth := contDiff_const
  compact := (Set.toFinite _).isCompact

theorem ordinaryQuadraticChart_atom (lam β y : ℝ) :
    quadraticChartAtom (ordinaryQuadraticChart lam β) y =
      (Real.fourierChar (lam * y ^ 2 + β * y) : ℂ) := by
  simp [quadraticChartAtom, quadraticChartLatticeSummand, ordinaryQuadraticChart, chartMatrixPhase]

theorem ordinaryQuadraticChart_complexity (c₀ : ℕ) {H : ℝ} (hH : Real.exp 2 ≤ H)
    (lam β : ℝ) : QuadraticChartComplexity c₀ H (ordinaryQuadraticChart lam β) := by
  have hH1 : 1 ≤ H := by linarith [Real.add_one_le_exp (2 : ℝ)]
  refine ⟨hH, ?_, ?_, ?_, ?_⟩
  · simpa only [Nat.cast_zero] using Real.log_nonneg hH1
  · intro i
    exact Fin.elim0 i
  · intro z _ i
    exact Fin.elim0 i
  · intro m word z
    cases m with
    | zero =>
      simpa [coordinateWordDerivative_zero, ordinaryQuadraticChart] using one_le_pow₀ hH1 (n := c₀)
    | succ m => exact Fin.elim0 (word 0)

theorem ordinaryQuadraticChart_bounded (lam β : ℝ) :
    IsBoundedQuadraticChart (ordinaryQuadraticChart lam β) := by
  intro y
  rw [ordinaryQuadraticChart_atom, Circle.norm_coe]

/-- Scalar sizes are external coefficients; multiplying the cutoff
by a scalar of modulus at most one does not increase complexity. -/
noncomputable def scaleQuadraticChartAmplitude {d : ℕ} (a : ℂ) (A : QuadraticChartData d) :
    QuadraticChartData d where
  horizontal := A.horizontal
  quadratic := A.quadratic
  linear := A.linear
  matrix := A.matrix
  amplitude := fun z => a * A.amplitude z
  smooth := contDiff_const.mul A.smooth
  compact := A.compact.mul_left

theorem coordinateWordDerivative_scaleChart {d : ℕ} (a : ℂ) (A : QuadraticChartData d)
    (m : ℕ) (word : Fin m → Fin d) (z : Fin d → ℝ) :
    coordinateWordDerivative m (scaleQuadraticChartAmplitude a A).amplitude word z =
      a * coordinateWordDerivative m A.amplitude word z := by
  have hf : ContDiffAt ℝ m A.amplitude z := A.smooth.contDiffAt.of_le (by simp)
  unfold coordinateWordDerivative
  change iteratedFDeriv ℝ m (a • A.amplitude) z _ = _
  rw [iteratedFDeriv_const_smul_apply hf]
  rfl

theorem scaleQuadraticChartAmplitude_atom {d : ℕ} (a : ℂ) (A : QuadraticChartData d) (y : ℝ) :
    quadraticChartAtom (scaleQuadraticChartAmplitude a A) y = a * quadraticChartAtom A y := by
  have he : ∀ n, quadraticChartLatticeSummand (scaleQuadraticChartAmplitude a A) y n =
      a * quadraticChartLatticeSummand A y n := by
    intro n
    have hh : chartHorizontalPosition (scaleQuadraticChartAmplitude a A) y =
        chartHorizontalPosition A y := rfl
    have hr : chartLatticeRemainder (scaleQuadraticChartAmplitude a A) y n =
        chartLatticeRemainder A y n := rfl
    change (a * A.amplitude (chartLatticeRemainder (scaleQuadraticChartAmplitude a A) y n)) *
        (Real.fourierChar (chartMatrixPhase A.matrix
          (chartHorizontalPosition (scaleQuadraticChartAmplitude a A) y)
          (chartLatticeRemainder (scaleQuadraticChartAmplitude a A) y n)) : ℂ) =
      a * (A.amplitude (chartLatticeRemainder A y n) *
        (Real.fourierChar (chartMatrixPhase A.matrix (chartHorizontalPosition A y)
          (chartLatticeRemainder A y n)) : ℂ))
    rw [hh, hr, mul_assoc]
  change (Real.fourierChar (A.quadratic * y ^ 2 + A.linear * y) : ℂ) *
      (∑' n, quadraticChartLatticeSummand (scaleQuadraticChartAmplitude a A) y n) =
    a * ((Real.fourierChar (A.quadratic * y ^ 2 + A.linear * y) : ℂ) *
      ∑' n, quadraticChartLatticeSummand A y n)
  rw [tsum_congr he, tsum_mul_left]
  ring

theorem scaleQuadraticChartAmplitude_complexity {d c₀ : ℕ} {H : ℝ} {A : QuadraticChartData d}
    (hA : QuadraticChartComplexity c₀ H A) {a : ℂ} (ha : ‖a‖ ≤ 1) :
    QuadraticChartComplexity c₀ H (scaleQuadraticChartAmplitude a A) := by
  refine ⟨hA.lower, hA.dimension, hA.height, ?_, ?_⟩
  · intro z hz
    apply hA.support z
    intro hh
    exact hz (by simp [scaleQuadraticChartAmplitude, hh])
  · intro m word z
    rw [coordinateWordDerivative_scaleChart, norm_mul]
    exact (mul_le_of_le_one_left (norm_nonneg _) ha).trans (hA.derivative m word z)

noncomputable def chartNormalizationFactor (d c₀ : ℕ) (H : ℝ) : ℝ :=
  (2 * H + 3) ^ d * H ^ c₀

noncomputable def chartNormalizationBudget (c₀ : ℕ) (H : ℝ) : ℝ :=
  Real.exp ((c₀ + 10 : ℝ) * logarithmicSize H ^ 2)

theorem chartNormalizationBudget_quasipolynomial (c₀ : ℕ) :
    QuasipolynomialBound (chartNormalizationBudget c₀) := by
  refine ⟨(c₀ + 10 : ℝ), ?_, 2, by norm_num, ?_⟩
  · have hh := Nat.cast_nonneg (α := ℝ) c₀
    linarith
  · intro H _
    exact ⟨(Real.exp_pos _).le, le_rfl⟩

theorem chartNormalizationFactor_one_le (d c₀ : ℕ) {H : ℝ} (hH : 1 ≤ H) :
    1 ≤ chartNormalizationFactor d c₀ H := by
  have hbase : 1 ≤ 2 * H + 3 := by linarith
  have hleft : 1 ≤ (2 * H + 3) ^ d := one_le_pow₀ hbase
  have hright : 1 ≤ H ^ c₀ := one_le_pow₀ hH
  unfold chartNormalizationFactor
  nlinarith

theorem chartNormalizationFactor_le_budget {d c₀ : ℕ} {H : ℝ} {A : QuadraticChartData d}
    (hA : QuadraticChartComplexity c₀ H A) :
    chartNormalizationFactor d c₀ H ≤ chartNormalizationBudget c₀ H := by
  have hH2 : 2 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hHp : 0 < H := by linarith
  have hlogH : 2 ≤ Real.log H := by
    have hh := Real.log_le_log (Real.exp_pos 2) hA.lower
    rwa [Real.log_exp] at hh
  have hbasep : 0 < 2 * H + 3 := by linarith
  have hlogbase : Real.log (2 * H + 3) ≤ 3 * Real.log H := by
    have hh := Real.log_le_log hbasep (show 2 * H + 3 ≤ 4 * H by linarith)
    rw [Real.log_mul (by norm_num : (4 : ℝ) ≠ 0) hHp.ne'] at hh
    have h4 := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 4)
    norm_num at h4
    linarith
  have hN : 0 < chartNormalizationFactor d c₀ H :=
    mul_pos (pow_pos hbasep _) (pow_pos hHp _)
  have hlogN : Real.log (chartNormalizationFactor d c₀ H) =
      (d : ℝ) * Real.log (2 * H + 3) + (c₀ : ℝ) * Real.log H := by
    rw [chartNormalizationFactor, Real.log_mul (pow_pos hbasep _).ne' (pow_pos hHp _).ne',
      Real.log_pow, Real.log_pow]
  unfold chartNormalizationBudget
  rw [← Real.exp_log hN]
  apply Real.exp_le_exp.mpr
  rw [hlogN]
  unfold logarithmicSize
  have hprod := mul_le_mul hA.dimension hlogbase
    (Real.log_nonneg (show 1 ≤ 2 * H + 3 by linarith)) (show 0 ≤ Real.log H by linarith)
  nlinarith [Nat.cast_nonneg (α := ℝ) c₀,
    mul_nonneg (Nat.cast_nonneg (α := ℝ) c₀) (sq_nonneg (Real.log H)),
    mul_nonneg (Nat.cast_nonneg (α := ℝ) c₀) (show 0 ≤ Real.log H by linarith)]

/-- Blueprint `def:chart`, lines 635-637: normalize to an actual bounded
chart of the same complexity, paying only a quasipolynomial external scalar. -/
theorem quadraticChart_normalize {d c₀ : ℕ} {H : ℝ} {A : QuadraticChartData d}
    (hA : QuadraticChartComplexity c₀ H A) :
    ∃ (N : ℝ) (A' : QuadraticChartData d), 1 ≤ N ∧ N ≤ chartNormalizationBudget c₀ H ∧
      QuadraticChartComplexity c₀ H A' ∧ IsBoundedQuadraticChart A' ∧
      ∀ y, quadraticChartAtom A y = (N : ℂ) * quadraticChartAtom A' y := by
  let N := chartNormalizationFactor d c₀ H
  have hH1 : 1 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hN1 : 1 ≤ N := chartNormalizationFactor_one_le d c₀ hH1
  have hNp : 0 < N := by linarith
  have hNC : (N : ℂ) ≠ 0 := by exact_mod_cast hNp.ne'
  have ha : ‖(N : ℂ)⁻¹‖ ≤ 1 := by
    rw [norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hNp]
    simpa only [one_div] using (div_le_one hNp).mpr hN1
  refine ⟨N, scaleQuadraticChartAmplitude (N : ℂ)⁻¹ A, hN1,
    chartNormalizationFactor_le_budget hA, scaleQuadraticChartAmplitude_complexity hA ha, ?_, ?_⟩
  · intro y
    rw [scaleQuadraticChartAmplitude_atom, norm_mul, norm_inv, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hNp]
    calc
      _ ≤ N⁻¹ * N := mul_le_mul_of_nonneg_left (quadraticChartAtom_norm_le hA y)
        (inv_nonneg.mpr hNp.le)
      _ = 1 := inv_mul_cancel₀ hNp.ne'
  · intro y
    rw [scaleQuadraticChartAmplitude_atom]
    simp [hNC]

/-! ### Quadratic chart conjugation -/

/-- Blueprint `lem:chart-operations`: conjugate the cutoff and negate both
ordinary phases and the rational matrix. -/
noncomputable def conjugateQuadraticChart {d : ℕ} (A : QuadraticChartData d) :
    QuadraticChartData d where
  horizontal := A.horizontal
  quadratic := -A.quadratic
  linear := -A.linear
  matrix := -A.matrix
  amplitude := fun z => star (A.amplitude z)
  smooth := Complex.conjCLE.contDiff.comp A.smooth
  compact := A.compact.comp_left (map_zero Complex.conjCLE)

theorem chartMatrixPhase_neg {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (z w : Fin d → ℝ) : chartMatrixPhase (-C) z w = -chartMatrixPhase C z w := by
  simp [chartMatrixPhase, Finset.sum_neg_distrib]

theorem coordinateWordDerivative_conjugateChart {d : ℕ} (A : QuadraticChartData d)
    (m : ℕ) (word : Fin m → Fin d) (z : Fin d → ℝ) :
    coordinateWordDerivative m (conjugateQuadraticChart A).amplitude word z =
      star (coordinateWordDerivative m A.amplitude word z) := by
  change (iteratedFDeriv ℝ m (Complex.conjCLE ∘ A.amplitude) z) _ = _
  rw [Complex.conjCLE.iteratedFDeriv_comp_left]
  rfl

/-- Conjugation gives exactly the pointwise complex conjugate of the atom. -/
theorem conjugateQuadraticChart_atom {d : ℕ} (A : QuadraticChartData d) (y : ℝ) :
    quadraticChartAtom (conjugateQuadraticChart A) y = star (quadraticChartAtom A y) := by
  have he : ∀ n, quadraticChartLatticeSummand (conjugateQuadraticChart A) y n =
      star (quadraticChartLatticeSummand A y n) := by
    intro n
    have hh : chartHorizontalPosition (conjugateQuadraticChart A) y =
        chartHorizontalPosition A y := rfl
    have hr : chartLatticeRemainder (conjugateQuadraticChart A) y n =
        chartLatticeRemainder A y n := rfl
    change star (A.amplitude _) * (Real.fourierChar (chartMatrixPhase (-A.matrix) _ _) : ℂ)
      = star (A.amplitude _ * (Real.fourierChar _ : ℂ))
    rw [hh, hr, chartMatrixPhase_neg, AddChar.map_neg_eq_inv, Circle.coe_inv_eq_conj]
    exact (map_mul (starRingEnd ℂ) _ _).symm
  unfold quadraticChartAtom
  rw [tsum_congr he]
  have ht : (∑' n : Fin d → ℤ, star (quadraticChartLatticeSummand A y n)) =
      star (∑' n : Fin d → ℤ, quadraticChartLatticeSummand A y n) :=
    Complex.conjCLE.map_tsum.symm
  rw [ht]
  have hp : (conjugateQuadraticChart A).quadratic * y ^ 2 +
      (conjugateQuadraticChart A).linear * y = -(A.quadratic * y ^ 2 + A.linear * y) := by
    dsimp [conjugateQuadraticChart]
    ring
  rw [hp, AddChar.map_neg_eq_inv, Circle.coe_inv_eq_conj]
  exact (map_mul (starRingEnd ℂ) _ _).symm

/-- Blueprint `lem:chart-operations`: conjugation preserves the exact
original dimension, height, support and fixed-order Gevrey budget. -/
theorem conjugateQuadraticChart_complexity {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) :
    QuadraticChartComplexity c₀ H (conjugateQuadraticChart A) where
  lower := hA.lower
  dimension := hA.dimension
  height := by simpa [conjugateQuadraticChart, chartRationalHeight_neg] using hA.height
  support := by
    intro z hz
    apply hA.support z
    simpa [conjugateQuadraticChart] using hz
  derivative := by
    intro m word z
    rw [coordinateWordDerivative_conjugateChart, norm_star]
    exact hA.derivative m word z

/-- Blueprint `lem:chart-operations`: a bounded chart stays bounded under conjugation. -/
theorem conjugateQuadraticChart_bounded {d : ℕ} {A : QuadraticChartData d}
    (hA : IsBoundedQuadraticChart A) : IsBoundedQuadraticChart (conjugateQuadraticChart A) := by
  intro y
  rw [conjugateQuadraticChart_atom, norm_star]
  exact hA y

/-! ### Quadratic chart dilation -/

/-- Blueprint `lem:chart-operations`: a real dilation changes only the
unrestricted horizontal, quadratic and linear frequencies. -/
noncomputable def dilateQuadraticChart {d : ℕ} (a : ℝ) (A : QuadraticChartData d) :
    QuadraticChartData d :=
  { A with horizontal := fun i => A.horizontal i * a
           quadratic := A.quadratic * a ^ 2
           linear := A.linear * a }

/-- The dilated chart is the exact dilated atom, including dilation by zero. -/
theorem dilateQuadraticChart_atom {d : ℕ} (a : ℝ) (A : QuadraticChartData d) (y : ℝ) :
    quadraticChartAtom (dilateQuadraticChart a A) y = quadraticChartAtom A (a * y) := by
  have hh : chartHorizontalPosition (dilateQuadraticChart a A) y =
      chartHorizontalPosition A (a * y) := by
    funext i
    dsimp [chartHorizontalPosition, dilateQuadraticChart]
    ring
  have hr : ∀ n, chartLatticeRemainder (dilateQuadraticChart a A) y n =
      chartLatticeRemainder A (a * y) n := by
    intro n
    funext i
    dsimp [chartLatticeRemainder, dilateQuadraticChart]
    ring
  have hp : (dilateQuadraticChart a A).quadratic * y ^ 2 +
      (dilateQuadraticChart a A).linear * y = A.quadratic * (a * y) ^ 2 +
        A.linear * (a * y) := by
    dsimp [dilateQuadraticChart]
    ring
  unfold quadraticChartAtom
  rw [hp]
  congr 1
  apply tsum_congr
  intro n
  change A.amplitude _ * (Real.fourierChar (chartMatrixPhase A.matrix _ _) : ℂ) =
    A.amplitude _ * (Real.fourierChar (chartMatrixPhase A.matrix _ _) : ℂ)
  rw [hh, hr]

/-- Blueprint `lem:chart-operations`: dilation has no complexity cost,
uniformly over every real dilation parameter. -/
theorem dilateQuadraticChart_complexity {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (a : ℝ) :
    QuadraticChartComplexity c₀ H (dilateQuadraticChart a A) where
  lower := hA.lower
  dimension := hA.dimension
  height := hA.height
  support := hA.support
  derivative := hA.derivative

/-- Blueprint `lem:chart-operations`: dilation preserves pointwise boundedness. -/
theorem dilateQuadraticChart_bounded {d : ℕ} {A : QuadraticChartData d}
    (hA : IsBoundedQuadraticChart A) (a : ℝ) :
    IsBoundedQuadraticChart (dilateQuadraticChart a A) := by
  intro y
  rw [dilateQuadraticChart_atom]
  exact hA (a * y)

/-! ### Quadratic chart products -/

/-- Block-diagonal rational matrix on concatenated finite coordinates. -/
def chartBlockMatrix {d e : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (D : Matrix (Fin e) (Fin e) ℚ) : Matrix (Fin (d + e)) (Fin (d + e)) ℚ :=
  fun i j => Fin.addCases (fun i => Fin.addCases (C i) (fun _ => 0) j)
    (fun i => Fin.addCases (fun _ => 0) (D i) j) i

theorem chartMatrixPhase_block {d e : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (D : Matrix (Fin e) (Fin e) ℚ) (z w : Fin (d + e) → ℝ) :
    chartMatrixPhase (chartBlockMatrix C D) z w =
      chartMatrixPhase C (fun i => z (Fin.castAdd e i)) (fun i => w (Fin.castAdd e i)) +
      chartMatrixPhase D (fun i => z (Fin.natAdd d i)) (fun i => w (Fin.natAdd d i)) := by
  simp [chartMatrixPhase, chartBlockMatrix, Fin.sum_univ_add]

/-- Product of the two cutoffs in their disjoint coordinate blocks. -/
noncomputable def productChartAmplitude {d e : ℕ} (A : QuadraticChartData d)
    (B : QuadraticChartData e) (z : Fin (d + e) → ℝ) : ℂ :=
  A.amplitude (fun i => z (Fin.castAdd e i)) *
    B.amplitude (fun i => z (Fin.natAdd d i))

theorem productChartAmplitude_smooth {d e : ℕ} (A : QuadraticChartData d)
    (B : QuadraticChartData e) : ContDiff ℝ (⊤ : ℕ∞) (productChartAmplitude A B) := by
  exact (A.smooth.comp (contDiff_pi.mpr fun i => contDiff_apply ℝ ℝ (Fin.castAdd e i))).mul
    (B.smooth.comp (contDiff_pi.mpr fun i => contDiff_apply ℝ ℝ (Fin.natAdd d i)))

theorem productChartAmplitude_compact {d e : ℕ} (A : QuadraticChartData d)
    (B : QuadraticChartData e) : HasCompactSupport (productChartAmplitude A B) := by
  obtain ⟨H, hH, hA⟩ := quadraticChartData_support_bound A
  obtain ⟨K, hK, hB⟩ := quadraticChartData_support_bound B
  apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall 0 (max H K))
  intro z hz
  have hn : A.amplitude (fun i => z (Fin.castAdd e i)) ≠ 0 ∧
      B.amplitude (fun i => z (Fin.natAdd d i)) ≠ 0 := mul_ne_zero_iff.mp hz
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg (le_max_of_le_left hH.le)).mpr
  intro i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · exact (hA _ hn.1 j).trans (le_max_left H K)
  · exact (hB _ hn.2 j).trans (le_max_right H K)

/-- Blueprint `lem:chart-operations`: concatenate horizontal coordinates,
add ordinary phases, and take a block-diagonal rational matrix. -/
noncomputable def productQuadraticChart {d e : ℕ} (A : QuadraticChartData d)
    (B : QuadraticChartData e) : QuadraticChartData (d + e) where
  horizontal := Fin.append A.horizontal B.horizontal
  quadratic := A.quadratic + B.quadratic
  linear := A.linear + B.linear
  matrix := chartBlockMatrix A.matrix B.matrix
  amplitude := productChartAmplitude A B
  smooth := productChartAmplitude_smooth A B
  compact := productChartAmplitude_compact A B

theorem productQuadraticChart_summand {d e : ℕ} (A : QuadraticChartData d)
    (B : QuadraticChartData e) (y : ℝ) (n : Fin d → ℤ) (m : Fin e → ℤ) :
    quadraticChartLatticeSummand (productQuadraticChart A B) y (Fin.append n m) =
      quadraticChartLatticeSummand A y n * quadraticChartLatticeSummand B y m := by
  have hl : (fun i => chartLatticeRemainder (productQuadraticChart A B) y
      (Fin.append n m) (Fin.castAdd e i)) = chartLatticeRemainder A y n := by
    funext i
    simp [chartLatticeRemainder, productQuadraticChart]
  have hr : (fun i => chartLatticeRemainder (productQuadraticChart A B) y
      (Fin.append n m) (Fin.natAdd d i)) = chartLatticeRemainder B y m := by
    funext i
    simp [chartLatticeRemainder, productQuadraticChart]
  have hzl : (fun i => chartHorizontalPosition (productQuadraticChart A B) y
      (Fin.castAdd e i)) = chartHorizontalPosition A y := by
    funext i
    simp [chartHorizontalPosition, productQuadraticChart]
  have hzr : (fun i => chartHorizontalPosition (productQuadraticChart A B) y
      (Fin.natAdd d i)) = chartHorizontalPosition B y := by
    funext i
    simp [chartHorizontalPosition, productQuadraticChart]
  change (A.amplitude _ * B.amplitude _) *
    (Real.fourierChar (chartMatrixPhase (chartBlockMatrix A.matrix B.matrix) _ _) : ℂ) = _
  rw [chartMatrixPhase_block, hl, hr, hzl, hzr, AddChar.map_add_eq_mul, Circle.coe_mul]
  simp only [quadraticChartLatticeSummand]
  ring

/-- Blueprint `lem:chart-operations`: the block construction is exactly
pointwise multiplication, with all lattice sums factored legitimately. -/
theorem productQuadraticChart_atom {d e : ℕ} (A : QuadraticChartData d)
    (B : QuadraticChartData e) (y : ℝ) :
    quadraticChartAtom (productQuadraticChart A B) y =
      quadraticChartAtom A y * quadraticChartAtom B y := by
  have hs : (∑' k, quadraticChartLatticeSummand (productQuadraticChart A B) y k) =
      (∑' n, quadraticChartLatticeSummand A y n) *
        ∑' m, quadraticChartLatticeSummand B y m := by
    calc
      _ = ∑' p : (Fin d → ℤ) × (Fin e → ℤ),
          quadraticChartLatticeSummand (productQuadraticChart A B) y
            (Fin.append p.1 p.2) := ((Fin.appendEquiv d e).tsum_eq _).symm
      _ = ∑' p : (Fin d → ℤ) × (Fin e → ℤ),
          quadraticChartLatticeSummand A y p.1 * quadraticChartLatticeSummand B y p.2 :=
        tsum_congr (fun p => productQuadraticChart_summand A B y p.1 p.2)
      _ = _ := (tsum_mul_tsum_of_summable_norm
        (summable_of_hasFiniteSupport (by
          simpa only [Function.HasFiniteSupport, Function.support, norm_ne_zero_iff] using
            quadraticChartLatticeSummand_finite_support A y))
        (summable_of_hasFiniteSupport (by
          simpa only [Function.HasFiniteSupport, Function.support, norm_ne_zero_iff] using
            quadraticChartLatticeSummand_finite_support B y))).symm
  have hp : (productQuadraticChart A B).quadratic * y ^ 2 +
      (productQuadraticChart A B).linear * y =
      (A.quadratic * y ^ 2 + A.linear * y) + (B.quadratic * y ^ 2 + B.linear * y) := by
    dsimp [productQuadraticChart]
    ring
  unfold quadraticChartAtom
  rw [hs, hp, AddChar.map_add_eq_mul, Circle.coe_mul]
  ring

/-! ### Quadratic chart product complexity -/

/-- Coordinate bounds control the multilinear operator norm with the
finite-dimensional cost `d^m`. This includes order and dimension zero. -/
theorem chart_multilinear_norm_le_coordinates {d m : ℕ}
    (T : ContinuousMultilinearMap ℝ (fun _ : Fin m => Fin d → ℝ) ℂ)
    {M : ℝ} (hM : 0 ≤ M)
    (hT : ∀ word : Fin m → Fin d, ‖T (fun i => Pi.single (word i) 1)‖ ≤ M) :
    ‖T‖ ≤ (d : ℝ) ^ m * M := by
  apply ContinuousMultilinearMap.opNorm_le_bound (mul_nonneg (by positivity) hM)
  intro v
  have hv : v = fun i => ∑ j : Fin d, (v i j) • Pi.single j (1 : ℝ) := by
    funext i j
    simp [Pi.smul_apply, Pi.single_apply]
  calc
    ‖T v‖ = ‖∑ word : Fin m → Fin d,
        T (fun i => (v i (word i)) • Pi.single (word i) (1 : ℝ))‖ := by
      conv_lhs => rw [hv]
      rw [T.map_sum]
    _ ≤ ∑ _word : Fin m → Fin d, M * ∏ i, ‖v i‖ := by
      apply (norm_sum_le _ _).trans
      apply Finset.sum_le_sum
      intro word _
      rw [T.map_smul_univ, norm_smul, norm_prod]
      calc
        _ ≤ (∏ i, ‖v i‖) * M := mul_le_mul
          (Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _)
            (fun i _ => norm_le_pi_norm (v i) (word i))) (hT word)
          (norm_nonneg _) (by positivity)
        _ = _ := mul_comm _ _
    _ = ((d : ℝ) ^ m * M) * ∏ i, ‖v i‖ := by
      simp [mul_assoc]

/-- From the source coordinate Gevrey bounds to an operator-norm bound.
The fixed Gevrey order is positive; no increase in that order is needed. -/
theorem chart_cutoff_iteratedFDeriv_bound {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A)
    (hc : 1 ≤ c₀) (m : ℕ) (z : Fin d → ℝ) :
    ‖iteratedFDeriv ℝ m A.amplitude z‖ ≤
      H ^ (2 * c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1)) := by
  have hH : 1 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hd : (d : ℝ) ≤ H := hA.dimension.trans (Real.log_le_self (by linarith))
  have h := chart_multilinear_norm_le_coordinates (iteratedFDeriv ℝ m A.amplitude z)
    (M := H ^ (c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1)))
    (mul_nonneg (pow_nonneg (by linarith) _) (by positivity))
    (hA.derivative m · z)
  refine h.trans ?_
  calc
    _ ≤ H ^ m * (H ^ (c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1))) :=
      mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (Nat.cast_nonneg d) hd m)
        (mul_nonneg (pow_nonneg (by linarith) _) (by positivity))
    _ = H ^ (m + c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1)) := by
      rw [pow_add, mul_assoc]
    _ ≤ _ := mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hH (by nlinarith))
      (by positivity)

/-- Restriction to a chosen coordinate list, allowing repeated coordinates. -/
noncomputable def chartCoordinateRestriction {d D : ℕ} (s : Fin d → Fin D) :
    (Fin D → ℝ) →L[ℝ] (Fin d → ℝ) :=
  ContinuousLinearMap.pi (fun i => ContinuousLinearMap.proj (s i))

theorem chartCoordinateRestriction_norm_le {d D : ℕ} (s : Fin d → Fin D) :
    ‖chartCoordinateRestriction s‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro z
  simp only [one_mul]
  exact (pi_norm_le_iff_of_nonneg (norm_nonneg z)).mpr
    (fun i => norm_le_pi_norm z (s i))

theorem chart_cutoff_restriction_bound {d D c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A)
    (hc : 1 ≤ c₀) (s : Fin d → Fin D) (m : ℕ) (z : Fin D → ℝ) :
    ‖iteratedFDeriv ℝ m (fun x => A.amplitude (fun i => x (s i))) z‖ ≤
      H ^ (2 * c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1)) := by
  change ‖iteratedFDeriv ℝ m (A.amplitude ∘ chartCoordinateRestriction s) z‖ ≤ _
  rw [(chartCoordinateRestriction s).iteratedFDeriv_comp_right A.smooth z (by simp)]
  apply le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _)
  have hp : (∏ _i : Fin m, ‖chartCoordinateRestriction s‖) ≤ 1 := by
    simpa using (Finset.prod_le_prod₀ (s := Finset.univ) (fun _ _ => norm_nonneg _)
      (fun (_i : Fin m) _ => chartCoordinateRestriction_norm_le s))
  calc
    _ ≤ ‖iteratedFDeriv ℝ m A.amplitude (chartCoordinateRestriction s z)‖ * 1 :=
      mul_le_mul_of_nonneg_left hp (norm_nonneg _)
    _ ≤ _ := by simpa only [mul_one] using chart_cutoff_iteratedFDeriv_bound hA hc m _

/-- Leibniz's rule in operator norm, with a geometric derivative majorant. -/
theorem chart_product_derivative_geometric {D m : ℕ}
    {f g : (Fin D → ℝ) → ℂ} (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (z : Fin D → ℝ) {R : ℝ} (hR : 0 ≤ R)
    (hfi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i f z‖ ≤ R ^ (i + 1))
    (hgi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i g z‖ ≤ R ^ (i + 1)) :
    ‖iteratedFDeriv ℝ m (fun x => f x * g x) z‖ ≤ 2 ^ m * R ^ (m + 2) := by
  apply (norm_iteratedFDeriv_mul_le hf hg z (by simp)).trans
  calc
    _ ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * R ^ (m + 2) := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ m := by simpa only [Finset.mem_range, Nat.lt_succ_iff] using hi
      calc
        _ ≤ (m.choose i : ℝ) * R ^ (i + 1) * R ^ (m - i + 1) := by
          gcongr
          · exact hfi i hi'
          · exact hgi (m - i) (Nat.sub_le _ _)
        _ = _ := by
          rw [mul_assoc, ← pow_add]
          congr 2
          omega
    _ = _ := by
      rw [← Finset.sum_mul]
      congr 1
      exact_mod_cast Nat.sum_range_choose m

theorem chart_cutoff_restriction_geometric {d D c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A)
    (hc : 1 ≤ c₀) (s : Fin d → Fin D) (m i : ℕ) (hi : i ≤ m) (z : Fin D → ℝ) :
    ‖iteratedFDeriv ℝ i (fun x => A.amplitude (fun j => x (s j))) z‖ ≤
      (H ^ (2 * c₀) * (m + 1 : ℝ) ^ c₀) ^ (i + 1) := by
  apply (chart_cutoff_restriction_bound hA hc s i z).trans
  rw [mul_pow, ← pow_mul, ← pow_mul]
  apply mul_le_mul_of_nonneg_left _
    (pow_nonneg (quadraticChartComplexity_parameter_pos hA).le _)
  apply pow_le_pow_left₀ (by positivity)
  exact_mod_cast Nat.add_le_add_right hi 1

/-- The elementary scalar estimate preserving the fixed Gevrey order in
the product rule. A sixth power of the old height absorbs all extra factors. -/
theorem chart_product_geometric_budget {H : ℝ} (hH : 2 ≤ H)
    {c₀ : ℕ} (hc : 1 ≤ c₀) (m : ℕ) :
    2 ^ m * (H ^ (2 * c₀) * (m + 1 : ℝ) ^ c₀) ^ (m + 2) ≤
      (H ^ 6) ^ (c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1)) := by
  have hH1 : 1 ≤ H := by linarith
  have htwo : (2 : ℝ) ^ m ≤ H ^ (c₀ * (m + 1)) :=
    (pow_le_pow_left₀ (by norm_num) hH m).trans
      (pow_le_pow_right₀ hH1 (by nlinarith))
  have hm : (m + 1 : ℝ) ≤ H ^ (m + 1) := by
    have hn : (m + 1 : ℝ) ≤ (2 : ℝ) ^ m := by
      exact_mod_cast (m.lt_two_pow_self).succ_le
    exact hn.trans ((pow_le_pow_left₀ (by norm_num) hH m).trans
      (pow_le_pow_right₀ hH1 (by omega)))
  have hm' : (m + 1 : ℝ) ^ c₀ ≤ H ^ (c₀ * (m + 1)) := by
    simpa only [← pow_mul, Nat.mul_comm] using pow_le_pow_left₀ (by positivity) hm c₀
  have hbase : H ^ (2 * c₀ * (m + 2)) ≤ H ^ (4 * (c₀ * (m + 1))) :=
    pow_le_pow_right₀ hH1 (by nlinarith)
  rw [mul_pow, ← pow_mul, ← pow_mul]
  have he : c₀ * (m + 2) = c₀ * (m + 1) + c₀ := by ring
  rw [he, pow_add]
  calc
    _ ≤ H ^ (c₀ * (m + 1)) *
        (H ^ (4 * (c₀ * (m + 1))) *
          ((m + 1 : ℝ) ^ (c₀ * (m + 1)) * H ^ (c₀ * (m + 1)))) := by
      gcongr
    _ = (H ^ 6) ^ (c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1)) := by
      calc
        _ = (H ^ (c₀ * (m + 1)) * H ^ (4 * (c₀ * (m + 1))) *
            H ^ (c₀ * (m + 1))) * (m + 1 : ℝ) ^ (c₀ * (m + 1)) := by ring
        _ = _ := by
          rw [← pow_add, ← pow_add, ← pow_mul]
          congr 2
          omega

/-- The product cutoff retains the same Gevrey order, with height budget `H^6`. -/
theorem productChartAmplitude_derivative_bound {d e c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} {B : QuadraticChartData e}
    (hA : QuadraticChartComplexity c₀ H A) (hB : QuadraticChartComplexity c₀ H B)
    (hc : 1 ≤ c₀) (m : ℕ) (word : Fin m → Fin (d + e)) (z : Fin (d + e) → ℝ) :
    ‖coordinateWordDerivative m (productChartAmplitude A B) word z‖ ≤
      (H ^ 6) ^ (c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1)) := by
  have hH : 2 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hf : ContDiff ℝ (⊤ : ℕ∞)
      (fun x : Fin (d + e) → ℝ => A.amplitude (fun i => x (Fin.castAdd e i))) :=
    A.smooth.comp (chartCoordinateRestriction (Fin.castAdd e)).contDiff
  have hg : ContDiff ℝ (⊤ : ℕ∞)
      (fun x : Fin (d + e) → ℝ => B.amplitude (fun i => x (Fin.natAdd d i))) :=
    B.smooth.comp (chartCoordinateRestriction (Fin.natAdd d)).contDiff
  have h := chart_product_derivative_geometric hf hg z
    (R := H ^ (2 * c₀) * (m + 1 : ℝ) ^ c₀)
    (mul_nonneg (pow_nonneg (by linarith) _) (by positivity))
    (fun i hi => chart_cutoff_restriction_geometric hA hc _ m i hi z)
    (fun i hi => chart_cutoff_restriction_geometric hB hc _ m i hi z)
  change ‖iteratedFDeriv ℝ m (productChartAmplitude A B) z‖ ≤ _ at h
  apply le_trans _ (h.trans (chart_product_geometric_budget hH hc m))
  simpa [coordinateWordDerivative, Pi.norm_single] using
    (iteratedFDeriv ℝ m (productChartAmplitude A B) z).le_opNorm
      (fun i => Pi.single (word i) 1)

/-- Blueprint `lem:chart-operations`: the product of two complexity-`H`
charts has complexity at most `H^6`, uniformly in every real frequency. -/
theorem productQuadraticChart_complexity {d e c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} {B : QuadraticChartData e}
    (hA : QuadraticChartComplexity c₀ H A) (hB : QuadraticChartComplexity c₀ H B)
    (hc : 1 ≤ c₀) : QuadraticChartComplexity c₀ (H ^ 6) (productQuadraticChart A B) := by
  have hH1 : 1 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hHH : H ≤ H ^ 6 := le_self_pow₀ hH1 (by norm_num)
  have hz : (chartRationalHeight (0 : ℚ) : ℝ) ≤ H ^ 6 := by
    simpa [chartRationalHeight] using hH1.trans hHH
  constructor
  · exact hA.lower.trans hHH
  · rw [Nat.cast_add, Real.log_pow]
    norm_num only [Nat.cast_ofNat]
    have hlog : 0 ≤ Real.log H := Real.log_nonneg hH1
    nlinarith [hA.dimension, hB.dimension]
  · intro i j
    refine Fin.addCases (fun i => ?_) (fun i => ?_) i
    · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
      · simpa [productQuadraticChart, chartBlockMatrix] using (hA.height i j).trans hHH
      · simpa [productQuadraticChart, chartBlockMatrix] using hz
    · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
      · simpa [productQuadraticChart, chartBlockMatrix] using hz
      · simpa [productQuadraticChart, chartBlockMatrix] using (hB.height i j).trans hHH
  · intro z hz i
    have hn : A.amplitude (fun i => z (Fin.castAdd e i)) ≠ 0 ∧
        B.amplitude (fun i => z (Fin.natAdd d i)) ≠ 0 := mul_ne_zero_iff.mp hz
    refine Fin.addCases (fun j => ?_) (fun j => ?_) i
    · exact (hA.support _ hn.1 j).trans hHH
    · exact (hB.support _ hn.2 j).trans hHH
  · exact productChartAmplitude_derivative_bound hA hB hc

/-! ### Fixed finite chart products -/

theorem quadraticChartComplexity_mono {d c₀ : ℕ} {H K : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (hHK : H ≤ K) :
    QuadraticChartComplexity c₀ K A where
  lower := hA.lower.trans hHK
  dimension := hA.dimension.trans
    (Real.log_le_log (quadraticChartComplexity_parameter_pos hA) hHK)
  height := fun i j => (hA.height i j).trans hHK
  support := fun z hz i => (hA.support z hz i).trans hHK
  derivative := by
    intro m word z
    exact (hA.derivative m word z).trans (mul_le_mul_of_nonneg_right
      (pow_le_pow_left₀ (quadraticChartComplexity_parameter_pos hA).le hHK _)
      (by positivity))

theorem productQuadraticChart_bounded {d e : ℕ} {A : QuadraticChartData d}
    {B : QuadraticChartData e} (hA : IsBoundedQuadraticChart A)
    (hB : IsBoundedQuadraticChart B) : IsBoundedQuadraticChart (productQuadraticChart A B) := by
  intro y
  rw [productQuadraticChart_atom, norm_mul]
  simpa only [one_mul] using mul_le_mul (hA y) (hB y) (norm_nonneg _) zero_le_one

/-- A finite product of charts of arbitrary, possibly different dimensions.
The empty list is represented by the ordinary constant phase one. -/
noncomputable def finiteQuadraticChartProduct :
    (L : List (Σ d : ℕ, QuadraticChartData d)) → QuadraticChartData ((L.map Sigma.fst).sum)
  | [] => ordinaryQuadraticChart 0 0
  | A :: L => productQuadraticChart A.2 (finiteQuadraticChartProduct L)

/-- Blueprint `lem:chart-operations`: exact multiplication of any finite list of atoms. -/
theorem finiteQuadraticChartProduct_atom (L : List (Σ d : ℕ, QuadraticChartData d)) (y : ℝ) :
    quadraticChartAtom (finiteQuadraticChartProduct L) y =
      (L.map (fun A => quadraticChartAtom A.2 y)).prod := by
  induction L with
  | nil =>
    change quadraticChartAtom (ordinaryQuadraticChart 0 0) y = 1
    rw [ordinaryQuadraticChart_atom]
    simp
  | cons A L ih =>
    change quadraticChartAtom (productQuadraticChart A.2 (finiteQuadraticChartProduct L)) y =
      quadraticChartAtom A.2 y * (L.map (fun B => quadraticChartAtom B.2 y)).prod
    rw [productQuadraticChart_atom, ih]

/-- Blueprint `lem:chart-operations`: bounded atoms have bounded finite products. -/
theorem finiteQuadraticChartProduct_bounded (L : List (Σ d : ℕ, QuadraticChartData d))
    (hL : ∀ A ∈ L, IsBoundedQuadraticChart A.2) :
    IsBoundedQuadraticChart (finiteQuadraticChartProduct L) := by
  induction L with
  | nil => exact ordinaryQuadraticChart_bounded 0 0
  | cons A L ih =>
    exact productQuadraticChart_bounded (hL A (List.mem_cons_self ..))
      (ih (fun B hB => hL B (List.mem_cons_of_mem _ hB)))

/-- Blueprint `lem:chart-operations`: a fixed finite product has a polynomial
height budget, with exponent depending only on the number of factors. -/
theorem finiteQuadraticChartProduct_complexity {c₀ : ℕ} {H : ℝ}
    (hH : Real.exp 2 ≤ H) (hc : 1 ≤ c₀)
    (L : List (Σ d : ℕ, QuadraticChartData d))
    (hL : ∀ A ∈ L, QuadraticChartComplexity c₀ H A.2) :
    QuadraticChartComplexity c₀ (H ^ (6 ^ L.length)) (finiteQuadraticChartProduct L) := by
  have hH1 : 1 ≤ H := by linarith [Real.add_one_le_exp (2 : ℝ)]
  induction L with
  | nil =>
    simp only [List.length_nil, pow_zero, pow_one]
    change QuadraticChartComplexity c₀ H (ordinaryQuadraticChart 0 0)
    exact ordinaryQuadraticChart_complexity c₀ hH 0 0
  | cons A L ih =>
    have ht := ih (fun B hB => hL B (List.mem_cons_of_mem _ hB))
    have ha := quadraticChartComplexity_mono (hL A (List.mem_cons_self ..))
      (le_self_pow₀ hH1 (pow_ne_zero L.length (by decide : (6 : ℕ) ≠ 0)))
    have h := productQuadraticChart_complexity ha ht hc
    change QuadraticChartComplexity c₀ (H ^ (6 ^ (L.length + 1)))
      (productQuadraticChart A.2 (finiteQuadraticChartProduct L))
    rw [pow_succ, pow_mul]
    exact h

/-- The finite-product height budget is quasipolynomial for each fixed list length. -/
theorem finiteChartProductBudget_quasipolynomial (q : ℕ) :
    QuasipolynomialBound (fun H : ℝ => H ^ (6 ^ q)) := by
  refine ⟨(6 ^ q : ℕ) + 1, le_add_of_nonneg_left (Nat.cast_nonneg _), 1, le_rfl, ?_⟩
  intro H hH
  refine ⟨pow_nonneg (by linarith) _, ?_⟩
  have hHp : 0 < H := by linarith
  have hlog : 0 ≤ Real.log H := Real.log_nonneg (by linarith)
  calc
    _ = Real.exp (((6 ^ q : ℕ) : ℝ) * Real.log H) := by
      rw [Real.exp_nat_mul, Real.exp_log hHp]
    _ ≤ _ := by
      apply Real.exp_le_exp.mpr
      simp only [logarithmicSize, pow_one]
      nlinarith [Nat.cast_nonneg (α := ℝ) (6 ^ q)]

/-! ### Chart translation offset reduction -/

/-- Blueprint `lem:chart-operations`, line 646: clear the rational matrix
with a positive common denominator bounded by `H^(d^2)`, for real height budgets. -/
theorem chart_matrix_clear_denominators {d : ℕ} {H : ℝ} (hH : 0 ≤ H)
    (C : Matrix (Fin d) (Fin d) ℚ) (hC : ∀ i j, (chartRationalHeight (C i j) : ℝ) ≤ H) :
    ∃ (P : ℕ) (Z : Matrix (Fin d) (Fin d) ℤ), 0 < P ∧ (P : ℝ) ≤ H ^ (d ^ 2) ∧
      ∀ i j, (Z i j : ℝ) = (P : ℝ) * (C i j : ℝ) := by
  obtain ⟨P, Z, hP, hPB, hZ, _, _⟩ :=
    rationalMatrix_clear_denominators C (fun i j => Nat.le_floor (hC i j))
  refine ⟨P, Z, hP, ?_, fun i j => by exact_mod_cast hZ i j⟩
  have hPB' : (P : ℝ) ≤ (⌊H⌋₊ : ℝ) ^ (d ^ 2) := by exact_mod_cast hPB
  exact hPB'.trans (pow_le_pow_left₀ (Nat.cast_nonneg _) (Nat.floor_le hH) _)

/-- Blueprint `lem:chart-operations`: every real offset is an integer
multiple of the cleared denominator plus a remainder of coordinate size at most
that denominator. The integer part pairs integrally with the rational matrix. -/
theorem chart_translation_offset_reduction {d : ℕ} {H : ℝ} (hH : 0 ≤ H)
    (C : Matrix (Fin d) (Fin d) ℚ) (hC : ∀ i j, (chartRationalHeight (C i j) : ℝ) ≤ H)
    (v : Fin d → ℝ) :
    ∃ (P : ℕ) (m : Fin d → ℤ) (a : Fin d → ℝ),
      0 < P ∧ (P : ℝ) ≤ H ^ (d ^ 2) ∧
      (∀ i, v i = (m i : ℝ) + a i) ∧ (∀ i, |a i| ≤ P) ∧
      ∀ i j, ∃ z : ℤ, (z : ℝ) = (m i : ℝ) * (C i j : ℝ) := by
  obtain ⟨P, Z, hP, hPH, hZ⟩ := chart_matrix_clear_denominators hH C hC
  have hPr : (0 : ℝ) < P := by exact_mod_cast hP
  let k : Fin d → ℤ := fun i => ⌊v i / P⌋
  let m : Fin d → ℤ := fun i => (P : ℤ) * k i
  let a : Fin d → ℝ := fun i => v i - (m i : ℝ)
  refine ⟨P, m, a, hP, hPH, ?_, ?_, ?_⟩
  · intro i
    dsimp [a]
    ring
  · intro i
    have hlo : (k i : ℝ) * P ≤ v i :=
      (le_div_iff₀ hPr).mp (Int.floor_le (v i / P))
    have hhi : v i < ((k i : ℝ) + 1) * P :=
      (div_lt_iff₀ hPr).mp (Int.lt_floor_add_one (v i / P))
    dsimp [a, m]
    push_cast
    apply abs_le.mpr
    constructor <;> nlinarith
  · intro i j
    refine ⟨k i * Z i j, ?_⟩
    simp only [Int.cast_mul, hZ]
    dsimp [m]
    push_cast
    ring

/-- The omitted term in the source translation expansion is an integer phase. -/
theorem chartMatrixPhase_integer_of_coefficients {d : ℕ}
    (C : Matrix (Fin d) (Fin d) ℚ) (m n : Fin d → ℤ)
    (h : ∀ i j, ∃ z : ℤ, (z : ℝ) = (m i : ℝ) * (C i j : ℝ)) :
    ∃ z : ℤ, (z : ℝ) = chartMatrixPhase C (fun i => (m i : ℝ)) (fun i => (n i : ℝ)) := by
  choose Z hZ using h
  refine ⟨∑ i, ∑ j, Z i j * n j, ?_⟩
  simp only [Int.cast_sum, Int.cast_mul, hZ, chartMatrixPhase]

/-- Integer errors do not change the real Fourier character. -/
theorem chart_fourierChar_int (n : ℤ) : (Real.fourierChar (n : ℝ) : ℂ) = 1 := by
  rw [Real.fourierChar_apply]
  have he : ((2 * Real.pi * (n : ℝ) : ℝ) : ℂ) * Complex.I =
      (n : ℂ) * (2 * Real.pi * Complex.I) := by
    push_cast
    ring
  rw [he, Complex.exp_int_mul_two_pi_mul_I]

theorem chart_fourierChar_add_int (x : ℝ) (n : ℤ) :
    (Real.fourierChar (x + n) : ℂ) = Real.fourierChar x := by
  rw [AddChar.map_add_eq_mul, Circle.coe_mul, chart_fourierChar_int, mul_one]

/-! ### Exact chart translation -/

theorem chartMatrixPhase_add_left {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (z z' w : Fin d → ℝ) :
    chartMatrixPhase C (z + z') w = chartMatrixPhase C z w + chartMatrixPhase C z' w := by
  simp [chartMatrixPhase, add_mul, Finset.sum_add_distrib]

theorem chartMatrixPhase_add_right {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (z w w' : Fin d → ℝ) :
    chartMatrixPhase C z (w + w') = chartMatrixPhase C z w + chartMatrixPhase C z w' := by
  simp [chartMatrixPhase, mul_add, Finset.sum_add_distrib]

theorem chartMatrixPhase_sub_right {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (z w w' : Fin d → ℝ) :
    chartMatrixPhase C z (w - w') = chartMatrixPhase C z w - chartMatrixPhase C z w' := by
  simp [chartMatrixPhase, mul_sub, Finset.sum_sub_distrib]

theorem chartMatrixPhase_smul_left {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (r : ℝ) (z w : Fin d → ℝ) :
    chartMatrixPhase C (r • z) w = r * chartMatrixPhase C z w := by
  simp [chartMatrixPhase, Finset.mul_sum, mul_assoc]

theorem chartMatrixPhase_smul_right {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (r : ℝ) (z w : Fin d → ℝ) :
    chartMatrixPhase C z (r • w) = r * chartMatrixPhase C z w := by
  simp [chartMatrixPhase, Finset.mul_sum, mul_assoc, mul_left_comm]

/-- The source translation expansion as an exact equality before discarding
the final integral bilinear term. -/
theorem chartMatrixPhase_translation_identity {d : ℕ}
    (C : Matrix (Fin d) (Fin d) ℚ) (z a m n : Fin d → ℝ) :
    chartMatrixPhase C (z + m + a) (z - n + a) =
      chartMatrixPhase C z (z - n) + chartMatrixPhase C z a + chartMatrixPhase C m z +
        chartMatrixPhase C a (z - n + a) + chartMatrixPhase C m a - chartMatrixPhase C m n := by
  simp only [chartMatrixPhase_add_left, chartMatrixPhase_add_right,
    chartMatrixPhase_sub_right]
  ring

theorem chart_fourierChar_smooth : ContDiff ℝ (⊤ : ℕ∞) (fun x : ℝ =>
    (Real.fourierChar x : ℂ)) := by
  simp only [Real.fourierChar_apply]
  exact ((Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)).mul
    contDiff_const).cexp

/-- The translated, phase-modulated cutoff in the source proof. -/
noncomputable def translatedChartAmplitude {d : ℕ} (A : QuadraticChartData d)
    (a z : Fin d → ℝ) : ℂ :=
  A.amplitude (z + a) * (Real.fourierChar (chartMatrixPhase A.matrix a (z + a)) : ℂ)

theorem translatedChartAmplitude_smooth {d : ℕ} (A : QuadraticChartData d)
    (a : Fin d → ℝ) : ContDiff ℝ (⊤ : ℕ∞) (translatedChartAmplitude A a) := by
  apply (A.smooth.comp (contDiff_id.add contDiff_const)).mul
  apply chart_fourierChar_smooth.comp
  unfold chartMatrixPhase
  fun_prop

theorem translatedChartAmplitude_compact {d : ℕ} (A : QuadraticChartData d)
    (a : Fin d → ℝ) : HasCompactSupport (translatedChartAmplitude A a) :=
  (A.compact.comp_homeomorph (Homeomorph.addRight a)).mul_right

/-- The ordinary constant phase created by translation is unrestricted. -/
noncomputable def chartTranslationConstant {d : ℕ} (A : QuadraticChartData d)
    (t : ℝ) (m : Fin d → ℤ) (a : Fin d → ℝ) : ℝ :=
  A.quadratic * t ^ 2 + A.linear * t + chartMatrixPhase A.matrix (fun i => (m i : ℝ)) a

noncomputable def chartTranslationLinear {d : ℕ} (A : QuadraticChartData d)
    (t : ℝ) (m : Fin d → ℤ) (a : Fin d → ℝ) : ℝ :=
  A.linear + 2 * A.quadratic * t + chartMatrixPhase A.matrix A.horizontal a +
    chartMatrixPhase A.matrix (fun i => (m i : ℝ)) A.horizontal

/-- The translated chart before multiplying by its constant unit phase. -/
noncomputable def shiftedQuadraticChart {d : ℕ} (A : QuadraticChartData d)
    (t : ℝ) (m : Fin d → ℤ) (a : Fin d → ℝ) : QuadraticChartData d where
  horizontal := A.horizontal
  quadratic := A.quadratic
  linear := chartTranslationLinear A t m a
  matrix := A.matrix
  amplitude := translatedChartAmplitude A a
  smooth := translatedChartAmplitude_smooth A a
  compact := translatedChartAmplitude_compact A a

/-- Blueprint `lem:chart-operations`: the translated cutoff and the
unrestricted ordinary phases, with the unit constant absorbed into the cutoff. -/
noncomputable def translateQuadraticChart {d : ℕ} (A : QuadraticChartData d)
    (t : ℝ) (m : Fin d → ℤ) (a : Fin d → ℝ) : QuadraticChartData d :=
  scaleQuadraticChartAmplitude (Real.fourierChar (chartTranslationConstant A t m a))
    (shiftedQuadraticChart A t m a)

theorem chart_translation_phase_identity {d : ℕ} (A : QuadraticChartData d)
    (t y : ℝ) (m n : Fin d → ℤ) (a : Fin d → ℝ) :
    A.quadratic * (y + t) ^ 2 + A.linear * (y + t) +
      chartMatrixPhase A.matrix (y • A.horizontal + (fun i => (m i : ℝ)) + a)
        (y • A.horizontal - (fun i => (n i : ℝ)) + a) +
      chartMatrixPhase A.matrix (fun i => (m i : ℝ)) (fun i => (n i : ℝ)) =
    chartTranslationConstant A t m a +
      (A.quadratic * y ^ 2 + chartTranslationLinear A t m a * y) +
      chartMatrixPhase A.matrix a (y • A.horizontal - (fun i => (n i : ℝ)) + a) +
      chartMatrixPhase A.matrix (y • A.horizontal) (y • A.horizontal - (fun i => (n i : ℝ))) := by
  rw [chartMatrixPhase_translation_identity]
  simp only [chartMatrixPhase_smul_left, chartMatrixPhase_smul_right,
    chartTranslationConstant, chartTranslationLinear]
  ring

/-- Equality of the individual translated lattice terms after multiplication
by the ordinary phase factors. The only discarded phase is proved integral. -/
theorem translatedChart_phased_summand {d : ℕ} (A : QuadraticChartData d)
    (t y : ℝ) (m n : Fin d → ℤ) (a : Fin d → ℝ)
    (hoff : ∀ i, A.horizontal i * t = (m i : ℝ) + a i)
    (hint : ∀ i j, ∃ z : ℤ, (z : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ)) :
    (Real.fourierChar (chartTranslationConstant A t m a) : ℂ) *
      ((Real.fourierChar (A.quadratic * y ^ 2 + chartTranslationLinear A t m a * y) : ℂ) *
        quadraticChartLatticeSummand (shiftedQuadraticChart A t m a) y n) =
    (Real.fourierChar (A.quadratic * (y + t) ^ 2 + A.linear * (y + t)) : ℂ) *
      quadraticChartLatticeSummand A (y + t) (n + m) := by
  let z : Fin d → ℝ := y • A.horizontal
  let w : Fin d → ℝ := z - (fun i => (n i : ℝ))
  have hz : chartHorizontalPosition A (y + t) = z + (fun i => (m i : ℝ)) + a := by
    funext i
    dsimp [chartHorizontalPosition, z]
    nlinarith [hoff i]
  have hw : chartLatticeRemainder A (y + t) (n + m) = w + a := by
    funext i
    dsimp [chartLatticeRemainder, w, z]
    push_cast
    nlinarith [hoff i]
  have hz' : chartHorizontalPosition (shiftedQuadraticChart A t m a) y = z := by
    funext i
    dsimp [chartHorizontalPosition, shiftedQuadraticChart, z]
    ring
  have hw' : chartLatticeRemainder (shiftedQuadraticChart A t m a) y n = w := by
    funext i
    dsimp [chartLatticeRemainder, shiftedQuadraticChart, w, z]
    ring
  obtain ⟨k, hk⟩ := chartMatrixPhase_integer_of_coefficients A.matrix m n hint
  have hp := chart_translation_phase_identity A t y m n a
  change A.quadratic * (y + t) ^ 2 + A.linear * (y + t) +
      chartMatrixPhase A.matrix (z + (fun i => (m i : ℝ)) + a) (w + a) +
      chartMatrixPhase A.matrix (fun i => (m i : ℝ)) (fun i => (n i : ℝ)) =
    chartTranslationConstant A t m a +
      (A.quadratic * y ^ 2 + chartTranslationLinear A t m a * y) +
      chartMatrixPhase A.matrix a (w + a) + chartMatrixPhase A.matrix z w at hp
  have he : (Real.fourierChar (chartTranslationConstant A t m a +
      (A.quadratic * y ^ 2 + chartTranslationLinear A t m a * y) +
      chartMatrixPhase A.matrix a (w + a) + chartMatrixPhase A.matrix z w) : ℂ) =
    Real.fourierChar (A.quadratic * (y + t) ^ 2 + A.linear * (y + t) +
      chartMatrixPhase A.matrix (z + (fun i => (m i : ℝ)) + a) (w + a)) := by
    rw [← hp, ← hk, chart_fourierChar_add_int]
  unfold quadraticChartLatticeSummand
  rw [hz, hw, hz', hw']
  change (Real.fourierChar _ : ℂ) * ((Real.fourierChar _ : ℂ) *
      ((A.amplitude (w + a) * (Real.fourierChar (chartMatrixPhase A.matrix a (w + a)) : ℂ)) *
        (Real.fourierChar (chartMatrixPhase A.matrix z w) : ℂ))) = _
  simp only [AddChar.map_add_eq_mul, Circle.coe_mul] at he ⊢
  linear_combination A.amplitude (w + a) * he

/-- Blueprint `lem:chart-operations`: the constructed chart is exactly
the translated atom. Translation size is unrestricted. -/
theorem translateQuadraticChart_atom {d : ℕ} (A : QuadraticChartData d)
    (t : ℝ) (m : Fin d → ℤ) (a : Fin d → ℝ)
    (hoff : ∀ i, A.horizontal i * t = (m i : ℝ) + a i)
    (hint : ∀ i j, ∃ z : ℤ, (z : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ)) (y : ℝ) :
    quadraticChartAtom (translateQuadraticChart A t m a) y = quadraticChartAtom A (y + t) := by
  rw [translateQuadraticChart, scaleQuadraticChartAmplitude_atom]
  unfold quadraticChartAtom
  have hs : (∑' n, quadraticChartLatticeSummand A (y + t) n) =
      ∑' n, quadraticChartLatticeSummand A (y + t) (n + m) :=
    ((Equiv.addRight m).tsum_eq _).symm
  rw [hs, ← tsum_mul_left, ← tsum_mul_left, ← tsum_mul_left]
  apply tsum_congr
  intro n
  exact translatedChart_phased_summand A t y m n a hoff hint

/-- Translation preserves the pointwise bound independently of its size. -/
theorem translateQuadraticChart_bounded {d : ℕ} {A : QuadraticChartData d}
    (hA : IsBoundedQuadraticChart A) (t : ℝ) (m : Fin d → ℤ) (a : Fin d → ℝ)
    (hoff : ∀ i, A.horizontal i * t = (m i : ℝ) + a i)
    (hint : ∀ i j, ∃ z : ℤ, (z : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ)) :
    IsBoundedQuadraticChart (translateQuadraticChart A t m a) := by
  intro y
  rw [translateQuadraticChart_atom A t m a hoff hint]
  exact hA (y + t)

/-! ### Translated chart cutoff derivatives -/

theorem chart_fourierChar_iteratedDeriv (m : ℕ) (x : ℝ) :
    iteratedDeriv m (fun t : ℝ => (Real.fourierChar t : ℂ)) x =
      (2 * Real.pi * Complex.I) ^ m * (Real.fourierChar x : ℂ) := by
  induction m generalizing x with
  | zero => simp
  | succ m ih =>
    rw [iteratedDeriv_succ, show iteratedDeriv m (fun t : ℝ => (Real.fourierChar t : ℂ)) =
      (fun t => (2 * Real.pi * Complex.I) ^ m * (Real.fourierChar t : ℂ)) from funext ih]
    rw [((Real.hasDerivAt_fourierChar x).const_mul ((2 * Real.pi * Complex.I) ^ m)).deriv]
    rw [pow_succ]
    ring

theorem chart_fourierChar_derivative_norm (m : ℕ) (x : ℝ) :
    ‖iteratedFDeriv ℝ m (fun t : ℝ => (Real.fourierChar t : ℂ)) x‖ =
      (2 * Real.pi) ^ m := by
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, chart_fourierChar_iteratedDeriv,
    norm_mul, norm_pow, Circle.norm_coe, mul_one]
  congr 1
  simp [Real.norm_eq_abs]

/-- A real linear phase on the cutoff coordinates. -/
noncomputable def chartMatrixLeftLinear {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (a : Fin d → ℝ) : (Fin d → ℝ) →L[ℝ] ℝ :=
  ∑ i, ∑ j, (a i * (C i j : ℝ)) • ContinuousLinearMap.proj j

theorem chartMatrixLeftLinear_apply {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (a z : Fin d → ℝ) : chartMatrixLeftLinear C a z = chartMatrixPhase C a z := by
  simp [chartMatrixLeftLinear, chartMatrixPhase]

/-- Every derivative of a shifted linear Fourier phase has a geometric
operator-norm bound, independent of the shift. -/
theorem chart_linear_phase_derivative_bound {d : ℕ} (L : (Fin d → ℝ) →L[ℝ] ℝ)
    (a z : Fin d → ℝ) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun x => (Real.fourierChar (L (x + a)) : ℂ)) z‖ ≤
      (2 * Real.pi * ‖L‖) ^ m := by
  rw [iteratedFDeriv_comp_add_right (f := fun u => (Real.fourierChar (L u) : ℂ)) m a z]
  change ‖iteratedFDeriv ℝ m ((fun t : ℝ => (Real.fourierChar t : ℂ)) ∘ L) (z + a)‖ ≤ _
  rw [L.iteratedFDeriv_comp_right chart_fourierChar_smooth (z + a) (by simp)]
  apply (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
  rw [chart_fourierChar_derivative_norm]
  simp [mul_pow]

/-- The translated and phase-modulated cutoff obeys the same-order Gevrey
bound at budget `T^6`, once `T` controls the old height and phase frequency. -/
theorem translatedChartAmplitude_derivative_bound {d c₀ : ℕ} {H T : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (hHT : H ≤ T) (a : Fin d → ℝ)
    (hphase : 2 * Real.pi * ‖chartMatrixLeftLinear A.matrix a‖ ≤ T)
    (m : ℕ) (word : Fin m → Fin d) (z : Fin d → ℝ) :
    ‖coordinateWordDerivative m (translatedChartAmplitude A a) word z‖ ≤
      (T ^ 6) ^ (c₀ * (m + 1)) * (m + 1 : ℝ) ^ (c₀ * (m + 1)) := by
  have hAT := quadraticChartComplexity_mono hA hHT
  have hT : 2 ≤ T := by linarith [hAT.lower, Real.add_one_le_exp (2 : ℝ)]
  let L := chartMatrixLeftLinear A.matrix a
  let R := T ^ (2 * c₀) * (m + 1 : ℝ) ^ c₀
  have hR : T ≤ R := by
    calc
      T ≤ T ^ (2 * c₀) := le_self_pow₀ (by linarith) (by omega)
      _ ≤ T ^ (2 * c₀) * (m + 1 : ℝ) ^ c₀ :=
        le_mul_of_one_le_right (pow_nonneg (by linarith) _)
          (one_le_pow₀ (by exact_mod_cast Nat.succ_pos m))
  have hfi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i (fun x => A.amplitude (x + a)) z‖ ≤
      R ^ (i + 1) := by
    intro i hi
    rw [iteratedFDeriv_comp_add_right]
    exact chart_cutoff_restriction_geometric hAT hc id m i hi (z + a)
  have hgi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i (fun x => (Real.fourierChar (L (x + a)) : ℂ)) z‖ ≤
      R ^ (i + 1) := by
    intro i _
    apply (chart_linear_phase_derivative_bound L a z i).trans
    calc
      _ ≤ R ^ i := pow_le_pow_left₀ (mul_nonneg (by positivity) (norm_nonneg _))
        (hphase.trans hR) i
      _ ≤ _ := pow_le_pow_right₀ (by linarith) (by omega)
  have hf : ContDiff ℝ (⊤ : ℕ∞) (fun x => A.amplitude (x + a)) :=
    A.smooth.comp (contDiff_id.add contDiff_const)
  have hg : ContDiff ℝ (⊤ : ℕ∞) (fun x => (Real.fourierChar (L (x + a)) : ℂ)) :=
    chart_fourierChar_smooth.comp (L.contDiff.comp (contDiff_id.add contDiff_const))
  have h := chart_product_derivative_geometric hf hg z (by linarith : 0 ≤ R) hfi hgi
  have he : (fun x => A.amplitude (x + a) * (Real.fourierChar (L (x + a)) : ℂ)) =
      translatedChartAmplitude A a := by
    funext x
    rw [chartMatrixLeftLinear_apply]
    rfl
  rw [he] at h
  apply le_trans _ (h.trans (chart_product_geometric_budget hT hc m))
  simpa [coordinateWordDerivative, Pi.norm_single] using
    (iteratedFDeriv ℝ m (translatedChartAmplitude A a) z).le_opNorm
      (fun i => Pi.single (word i) 1)

/-! ### Uniform chart translation complexity -/

theorem chartMatrixLeftLinear_norm_le {d : ℕ} {H P : ℝ}
    (C : Matrix (Fin d) (Fin d) ℚ) (a : Fin d → ℝ) (hH : 0 ≤ H) (hP : 0 ≤ P)
    (hC : ∀ i j, |(C i j : ℝ)| ≤ H) (ha : ∀ i, |a i| ≤ P) :
    ‖chartMatrixLeftLinear C a‖ ≤ (d : ℝ) ^ 2 * P * H := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
  intro z
  rw [chartMatrixLeftLinear_apply, Real.norm_eq_abs]
  calc
    _ ≤ ∑ i, ∑ j, |a i| * |(C i j : ℝ)| * |z j| := by
      apply (Finset.abs_sum_le_sum_abs _ _).trans
      apply Finset.sum_le_sum
      intro i _
      simpa only [abs_mul] using Finset.abs_sum_le_sum_abs
        (fun j => a i * (C i j : ℝ) * z j) Finset.univ
    _ ≤ ∑ _i : Fin d, ∑ _j : Fin d, P * H * ‖z‖ := by
      gcongr with i _ j _
      · exact ha i
      · exact hC i j
      · exact norm_le_pi_norm z j
    _ = ((d : ℝ) ^ 2 * P * H) * ‖z‖ := by simp; ring

/-- An intermediate height controlling support and residual phase frequency. -/
noncomputable def chartTranslationBase (d : ℕ) (H : ℝ) : ℝ := H ^ (d ^ 2 + 6)

theorem chart_translation_base_controls {d c₀ : ℕ} {H P : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A)
    (hP : 0 ≤ P) (hPH : P ≤ H ^ (d ^ 2)) (a : Fin d → ℝ) (ha : ∀ i, |a i| ≤ P) :
    H ≤ chartTranslationBase d H ∧ H + P ≤ chartTranslationBase d H ∧
      2 * Real.pi * ‖chartMatrixLeftLinear A.matrix a‖ ≤ chartTranslationBase d H := by
  have hH3 : 3 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hH1 : 1 ≤ H := by linarith
  have hH0 : 0 ≤ H := by linarith
  have hd : (d : ℝ) ≤ H := hA.dimension.trans (Real.log_le_self hH0)
  have hC : ∀ i j, |(A.matrix i j : ℝ)| ≤ H := by
    intro i j
    have h : |(A.matrix i j : ℝ)| ≤ (chartRationalHeight (A.matrix i j) : ℝ) := by
      exact_mod_cast rational_abs_le_height (A.matrix i j)
    exact h.trans (hA.height i j)
  refine ⟨le_self_pow₀ hH1 (by omega), ?_, ?_⟩
  · have h1 : H ≤ H ^ (d ^ 2 + 1) := le_self_pow₀ hH1 (by omega)
    have h2 : P ≤ H ^ (d ^ 2 + 1) :=
      hPH.trans (pow_le_pow_right₀ hH1 (by omega))
    calc
      H + P ≤ 2 * H ^ (d ^ 2 + 1) := by linarith
      _ ≤ H * H ^ (d ^ 2 + 1) :=
        mul_le_mul_of_nonneg_right (by linarith) (pow_nonneg hH0 _)
      _ = H ^ (d ^ 2 + 2) := by rw [pow_succ]; ring
      _ ≤ _ := pow_le_pow_right₀ hH1 (by omega)
  · have hpi : 2 * Real.pi ≤ H ^ 2 := by nlinarith [Real.pi_lt_four]
    have hn := chartMatrixLeftLinear_norm_le A.matrix a hH0 hP hC ha
    calc
      _ ≤ H ^ 2 * ((d : ℝ) ^ 2 * P * H) :=
        mul_le_mul hpi hn (norm_nonneg _) (sq_nonneg _)
      _ ≤ H ^ 2 * (H ^ 2 * H ^ (d ^ 2) * H) := by
        gcongr
      _ = H ^ (d ^ 2 + 5) := by rw [pow_add]; ring
      _ ≤ _ := pow_le_pow_right₀ hH1 (by omega)

/-- Translation complexity before replacing the dimension by its logarithmic bound. -/
theorem translateQuadraticChart_complexity {d c₀ : ℕ} {H P : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (hP : 0 ≤ P) (hPH : P ≤ H ^ (d ^ 2)) (t : ℝ) (m : Fin d → ℤ)
    (a : Fin d → ℝ) (ha : ∀ i, |a i| ≤ P) :
    QuadraticChartComplexity c₀ ((chartTranslationBase d H) ^ 6)
      (translateQuadraticChart A t m a) := by
  obtain ⟨hHT, hs, hp⟩ := chart_translation_base_controls hA hP hPH a ha
  have hH1 : 1 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hTT : chartTranslationBase d H ≤ (chartTranslationBase d H) ^ 6 :=
    le_self_pow₀ (hH1.trans hHT) (by norm_num)
  have hHT6 := hHT.trans hTT
  apply scaleQuadraticChartAmplitude_complexity (A := shiftedQuadraticChart A t m a)
    (a := (Real.fourierChar (chartTranslationConstant A t m a) : ℂ)) ?_ (by simp)
  constructor
  · exact hA.lower.trans hHT6
  · exact hA.dimension.trans
      (Real.log_le_log (quadraticChartComplexity_parameter_pos hA) hHT6)
  · exact fun i j => (hA.height i j).trans hHT6
  · intro z hz i
    have hn : A.amplitude (z + a) ≠ 0 := (mul_ne_zero_iff.mp hz).1
    have hb := hA.support (z + a) hn i
    have hai := ha i
    have hzi : |z i| ≤ H + P := by
      simp only [Pi.add_apply] at hb
      rcases abs_le.mp hb with ⟨hlo, hhi⟩
      rcases abs_le.mp hai with ⟨alo, ahi⟩
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    exact hzi.trans (hs.trans hTT)
  · exact translatedChartAmplitude_derivative_bound hA hc hHT a hp

/-- A uniform quasipolynomial budget for every real translation. -/
noncomputable def chartTranslationBudget (H : ℝ) : ℝ :=
  Real.exp (100 * logarithmicSize H ^ 3)

theorem chartTranslationBudget_quasipolynomial : QuasipolynomialBound chartTranslationBudget := by
  refine ⟨100, by norm_num, 3, by norm_num, ?_⟩
  intro H _
  exact ⟨(Real.exp_pos _).le, le_rfl⟩

theorem chartTranslationBase_le_budget {d c₀ : ℕ} {H : ℝ} {A : QuadraticChartData d}
    (hA : QuadraticChartComplexity c₀ H A) :
    (chartTranslationBase d H) ^ 6 ≤ chartTranslationBudget H := by
  have hHp := quadraticChartComplexity_parameter_pos hA
  have hH1 : 1 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hlog : 0 ≤ Real.log H := Real.log_nonneg hH1
  have hd2 : (d : ℝ) ^ 2 ≤ Real.log H ^ 2 :=
    pow_le_pow_left₀ (Nat.cast_nonneg _) hA.dimension 2
  have hprod := mul_le_mul_of_nonneg_right hd2 hlog
  unfold chartTranslationBase chartTranslationBudget
  rw [← pow_mul]
  calc
    _ = Real.exp (((d ^ 2 + 6) * 6 : ℕ) * Real.log H) := by
      rw [Real.exp_nat_mul, Real.exp_log hHp]
    _ ≤ _ := by
      apply Real.exp_le_exp.mpr
      simp only [logarithmicSize]
      push_cast
      nlinarith [sq_nonneg (Real.log H), pow_nonneg hlog 3]

/-- Blueprint `lem:chart-operations`: every real translation is represented
by a chart with a quasipolynomial complexity bound independent of the translation.
The Gevrey order is unchanged and boundedness is preserved. -/
theorem quadraticChart_translation_closure {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀) (t : ℝ) :
    ∃ A' : QuadraticChartData d, QuadraticChartComplexity c₀ (chartTranslationBudget H) A' ∧
      (IsBoundedQuadraticChart A → IsBoundedQuadraticChart A') ∧
      ∀ y, quadraticChartAtom A' y = quadraticChartAtom A (y + t) := by
  obtain ⟨P, m, a, hP, hPH, hoff, ha, hint⟩ := chart_translation_offset_reduction
    (quadraticChartComplexity_parameter_pos hA).le A.matrix hA.height
    (fun i => A.horizontal i * t)
  refine ⟨translateQuadraticChart A t m a, ?_, ?_, ?_⟩
  · exact quadraticChartComplexity_mono
      (translateQuadraticChart_complexity hA hc (Nat.cast_nonneg P) hPH t m a ha)
      (chartTranslationBase_le_budget hA)
  · exact fun h => translateQuadraticChart_bounded h t m a hoff hint
  · exact translateQuadraticChart_atom A t m a hoff hint

/-! ### Affine chart closure -/

/-- Blueprint `lem:chart-operations`: any real affine substitution preserves
quadratic charts with one quasipolynomial bound independent of both real
parameters. This includes zero and negative dilation and preserves boundedness. -/
theorem quadraticChart_affine_closure {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (s t : ℝ) :
    ∃ A' : QuadraticChartData d, QuadraticChartComplexity c₀ (chartTranslationBudget H) A' ∧
      (IsBoundedQuadraticChart A → IsBoundedQuadraticChart A') ∧
      ∀ y, quadraticChartAtom A' y = quadraticChartAtom A (s * y + t) := by
  obtain ⟨B, hB, hb, he⟩ := quadraticChart_translation_closure hA hc t
  refine ⟨dilateQuadraticChart s B, dilateQuadraticChart_complexity hB s,
    fun h => dilateQuadraticChart_bounded (hb h) s, ?_⟩
  intro y
  rw [dilateQuadraticChart_atom, he]

/-! ### Several-variable chart formula -/

/-- The several-variable source chart data, lines 656-660. The source uses
one, two or three real variables; the same formula is meaningful in every
finite dimension. Real horizontal and ordinary phase matrices are unrestricted. -/
structure MultivariableQuadraticChartData (k d : ℕ) where
  horizontal : Matrix (Fin d) (Fin k) ℝ
  quadratic : Matrix (Fin k) (Fin k) ℝ
  symmetric : quadratic.IsSymm
  linear : Fin k → ℝ
  matrix : Matrix (Fin d) (Fin d) ℚ
  amplitude : (Fin d → ℝ) → ℂ
  smooth : ContDiff ℝ (⊤ : ℕ∞) amplitude
  compact : HasCompactSupport amplitude

/-- The actual several-variable quadratic atom in the source display. -/
noncomputable def multivariableQuadraticChartAtom {k d : ℕ}
    (A : MultivariableQuadraticChartData k d) (z : Fin k → ℝ) : ℂ :=
  (Real.fourierChar ((∑ i, ∑ j, z i * A.quadratic i j * z j) +
    ∑ i, A.linear i * z i) : ℂ) *
    ∑' n : Fin d → ℤ, A.amplitude (A.horizontal.mulVec z - (fun i => (n i : ℝ))) *
      (Real.fourierChar (chartMatrixPhase A.matrix (A.horizontal.mulVec z)
        (A.horizontal.mulVec z - (fun i => (n i : ℝ)))) : ℂ)

/-- Restricting a several-variable chart to a real line changes only the
unrestricted horizontal and ordinary phase parameters. -/
noncomputable def multivariableChartAlongLine {k d : ℕ}
    (A : MultivariableQuadraticChartData k d) (v : Fin k → ℝ) : QuadraticChartData d where
  horizontal := A.horizontal.mulVec v
  quadratic := ∑ i, ∑ j, v i * A.quadratic i j * v j
  linear := ∑ i, A.linear i * v i
  matrix := A.matrix
  amplitude := A.amplitude
  smooth := A.smooth
  compact := A.compact

/-- The same dimension, rational height and cutoff bounds as the one-variable
definition. Evaluation on the zero line retains precisely this charged data. -/
def MultivariableQuadraticChartComplexity {k d : ℕ} (c₀ : ℕ) (H : ℝ)
    (A : MultivariableQuadraticChartData k d) : Prop :=
  QuadraticChartComplexity c₀ H (multivariableChartAlongLine A 0)

def IsBoundedMultivariableQuadraticChart {k d : ℕ}
    (A : MultivariableQuadraticChartData k d) : Prop :=
  ∀ z, ‖multivariableQuadraticChartAtom A z‖ ≤ 1

theorem multivariableChartAlongLine_complexity {k d c₀ : ℕ} {H : ℝ}
    {A : MultivariableQuadraticChartData k d} (hA : MultivariableQuadraticChartComplexity c₀ H A)
    (v : Fin k → ℝ) : QuadraticChartComplexity c₀ H (multivariableChartAlongLine A v) where
  lower := hA.lower
  dimension := hA.dimension
  height := hA.height
  support := hA.support
  derivative := hA.derivative

/-- Exact line restriction of the source several-variable formula. -/
theorem multivariableChartAlongLine_atom {k d : ℕ}
    (A : MultivariableQuadraticChartData k d) (v : Fin k → ℝ) (y : ℝ) :
    quadraticChartAtom (multivariableChartAlongLine A v) y =
      multivariableQuadraticChartAtom A (y • v) := by
  have hp : (multivariableChartAlongLine A v).quadratic * y ^ 2 +
      (multivariableChartAlongLine A v).linear * y =
      (∑ i, ∑ j, (y • v) i * A.quadratic i j * (y • v) j) +
        ∑ i, A.linear i * (y • v) i := by
    dsimp [multivariableChartAlongLine]
    simp only [Finset.sum_mul]
    congr 1
    · apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      ring
    · apply Finset.sum_congr rfl
      intro i _
      ring
  have hh : chartHorizontalPosition (multivariableChartAlongLine A v) y =
      A.horizontal.mulVec (y • v) := by
    rw [Matrix.mulVec_smul]
    funext i
    dsimp [chartHorizontalPosition, multivariableChartAlongLine]
    ring
  have hr : ∀ n, chartLatticeRemainder (multivariableChartAlongLine A v) y n =
      A.horizontal.mulVec (y • v) - (fun i => (n i : ℝ)) := by
    intro n
    rw [Matrix.mulVec_smul]
    funext i
    dsimp [chartLatticeRemainder, multivariableChartAlongLine]
    ring
  unfold quadraticChartAtom multivariableQuadraticChartAtom
  rw [hp]
  congr 1
  apply tsum_congr
  intro n
  change A.amplitude _ * (Real.fourierChar (chartMatrixPhase A.matrix _ _) : ℂ) = _
  rw [hh, hr]

theorem multivariableChartAlongLine_bounded {k d : ℕ}
    {A : MultivariableQuadraticChartData k d} (hA : IsBoundedMultivariableQuadraticChart A)
    (v : Fin k → ℝ) : IsBoundedQuadraticChart (multivariableChartAlongLine A v) := by
  intro y
  rw [multivariableChartAlongLine_atom]
  exact hA (y • v)

/-- Symmetric part of the rational chart matrix, as in source line 660. -/
def chartSymmetricPart {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) :
    Matrix (Fin d) (Fin d) ℚ := (1 / 2 : ℚ) • (C + C.transpose)

/-- Skew-symmetric part of the rational chart matrix. -/
def chartSkewPart {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) :
    Matrix (Fin d) (Fin d) ℚ := (1 / 2 : ℚ) • (C - C.transpose)

/-- The source alternating matrix `A = C - C^T`. -/
def chartAlternatingMatrix {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) :
    Matrix (Fin d) (Fin d) ℚ := C - C.transpose

theorem chartSymmetricPart_isSymm {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) :
    (chartSymmetricPart C).IsSymm := by
  apply Matrix.IsSymm.ext
  intro i j
  simp [chartSymmetricPart, add_comm]

theorem chartSkewPart_transpose {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) :
    (chartSkewPart C).transpose = -chartSkewPart C := by
  ext i j
  simp [chartSkewPart]
  ring

theorem chartSymmetricPart_add_skew {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) :
    chartSymmetricPart C + chartSkewPart C = C := by
  ext i j
  simp [chartSymmetricPart, chartSkewPart]
  ring

theorem chartAlternatingMatrix_eq_twice_skew {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) :
    chartAlternatingMatrix C = (2 : ℚ) • chartSkewPart C := by
  ext i j
  simp [chartAlternatingMatrix, chartSkewPart]

/-! ### Several-variable lattice finiteness -/

/-- Compact support makes the several-variable lattice sum pointwise finite,
just as in the original one-variable atom formula. -/
theorem multivariableChartLatticeSummand_finite_support {k d : ℕ}
    (A : MultivariableQuadraticChartData k d) (z : Fin k → ℝ) :
    (Function.support (fun n : Fin d → ℤ =>
      A.amplitude (A.horizontal.mulVec z - (fun i => (n i : ℝ))) *
        (Real.fourierChar (chartMatrixPhase A.matrix (A.horizontal.mulVec z)
          (A.horizontal.mulVec z - (fun i => (n i : ℝ)))) : ℂ))).Finite := by
  simpa +unfoldPartialApp only [quadraticChartLatticeSummand, multivariableChartAlongLine,
    chartHorizontalPosition, chartLatticeRemainder, mul_one, Pi.sub_def] using
    quadraticChartLatticeSummand_finite_support (multivariableChartAlongLine A z) 1

/-- The integral lower-left identity block used to encode a horizontal linear phase. -/
def chartCouplingMatrix (d : ℕ) : Matrix (Fin (d + d)) (Fin (d + d)) ℚ :=
  fun i j => Fin.addCases (fun _ => 0)
    (fun a => Fin.addCases (fun b => if a = b then 1 else 0) (fun _ => 0) j) i

theorem chartCouplingMatrix_height (d : ℕ) (i j : Fin (d + d)) :
    chartRationalHeight (chartCouplingMatrix d i j) = 1 := by
  refine Fin.addCases (fun a => ?_) (fun a => ?_) i
  · simp [-Fin.natAdd_eq_addNat, chartCouplingMatrix, chartRationalHeight]
  · refine Fin.addCases (fun b => ?_) (fun b => ?_) j
    · by_cases h : a = b <;>
        simp [-Fin.natAdd_eq_addNat, chartCouplingMatrix, h, chartRationalHeight]
    · simp [-Fin.natAdd_eq_addNat, chartCouplingMatrix, chartRationalHeight]

theorem chartMatrixPhase_coupling {d : ℕ} (z w : Fin (d + d) → ℝ) :
    chartMatrixPhase (chartCouplingMatrix d) z w =
      ∑ i, z (Fin.natAdd d i) * w (Fin.castAdd d i) := by
  simp [-Fin.natAdd_eq_addNat, chartMatrixPhase, chartCouplingMatrix, Fin.sum_univ_add,
    apply_ite, ite_mul]

/-- Couple the two coordinate blocks through the lower-left identity matrix.
 The amplitudes and ordinary phases are those of the product chart. -/
noncomputable def coupledQuadraticChart {d : ℕ} (A B : QuadraticChartData d) :
    QuadraticChartData (d + d) :=
  { productQuadraticChart A B with matrix := chartCouplingMatrix d }

theorem coupledQuadraticChart_summand {d : ℕ} (A B : QuadraticChartData d)
    (y : ℝ) (n m : Fin d → ℤ) :
    quadraticChartLatticeSummand (coupledQuadraticChart A B) y (Fin.append n m) =
      (A.amplitude (chartLatticeRemainder A y n) *
        (Real.fourierChar (y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i) : ℂ)) *
      B.amplitude (chartLatticeRemainder B y m) := by
  have hl : (fun i => chartLatticeRemainder (coupledQuadraticChart A B) y
      (Fin.append n m) (Fin.castAdd d i)) = chartLatticeRemainder A y n := by
    funext i
    simp [-Fin.natAdd_eq_addNat, chartLatticeRemainder, coupledQuadraticChart,
      productQuadraticChart]
  have hr : (fun i => chartLatticeRemainder (coupledQuadraticChart A B) y
      (Fin.append n m) (Fin.natAdd d i)) = chartLatticeRemainder B y m := by
    funext i
    simp [-Fin.natAdd_eq_addNat, chartLatticeRemainder, coupledQuadraticChart,
      productQuadraticChart]
  have hphase :
      chartMatrixPhase (chartCouplingMatrix d)
        (chartHorizontalPosition (coupledQuadraticChart A B) y)
        (chartLatticeRemainder (coupledQuadraticChart A B) y (Fin.append n m)) =
      y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i := by
    simp only [chartMatrixPhase_coupling, chartHorizontalPosition, chartLatticeRemainder,
      coupledQuadraticChart, productQuadraticChart, Fin.append_right, Fin.append_left,
      Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    ring
  change (A.amplitude _ * B.amplitude _) *
    (Real.fourierChar (chartMatrixPhase (chartCouplingMatrix d) _ _) : ℂ) = _
  rw [hphase, hl, hr]
  ring

theorem chartAmplitude_finite_support {d : ℕ} (A : QuadraticChartData d) (y : ℝ) :
    (fun n : Fin d → ℤ => A.amplitude (chartLatticeRemainder A y n)).HasFiniteSupport := by
  apply (quadraticChartLatticeSummand_finite_support A y).subset
  intro n hn
  change A.amplitude (chartLatticeRemainder A y n) *
    (Real.fourierChar (chartMatrixPhase A.matrix (chartHorizontalPosition A y)
      (chartLatticeRemainder A y n)) : ℂ) ≠ 0
  exact mul_ne_zero hn (Circle.coe_ne_zero _)

/-- The coupled chart factors into a phased sum in the first lattice block and
 an ordinary periodization in the second block. -/
theorem coupledQuadraticChart_atom {d : ℕ} (A B : QuadraticChartData d) (y : ℝ) :
    quadraticChartAtom (coupledQuadraticChart A B) y =
      (Real.fourierChar ((A.quadratic + B.quadratic) * y ^ 2 +
        (A.linear + B.linear) * y) : ℂ) *
      (∑' n : Fin d → ℤ, A.amplitude (chartLatticeRemainder A y n) *
        (Real.fourierChar (y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i) : ℂ)) *
      ∑' m : Fin d → ℤ, B.amplitude (chartLatticeRemainder B y m) := by
  let f : (Fin d → ℤ) → ℂ := fun n =>
    A.amplitude (chartLatticeRemainder A y n) *
      (Real.fourierChar (y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i) : ℂ)
  let g : (Fin d → ℤ) → ℂ := fun m => B.amplitude (chartLatticeRemainder B y m)
  have hf : f.HasFiniteSupport := (chartAmplitude_finite_support A y).mul_left _
  have hg : g.HasFiniteSupport := chartAmplitude_finite_support B y
  have hfn : Summable (fun n => ‖f n‖) := summable_of_hasFiniteSupport (by
    simpa only [Function.HasFiniteSupport, Function.support, norm_ne_zero_iff] using hf)
  have hgn : Summable (fun n => ‖g n‖) := summable_of_hasFiniteSupport (by
    simpa only [Function.HasFiniteSupport, Function.support, norm_ne_zero_iff] using hg)
  have hs : (∑' k, quadraticChartLatticeSummand (coupledQuadraticChart A B) y k) =
      (∑' n, f n) * ∑' m, g m := by
    calc
      _ = ∑' p : (Fin d → ℤ) × (Fin d → ℤ),
          quadraticChartLatticeSummand (coupledQuadraticChart A B) y (Fin.append p.1 p.2) :=
        ((Fin.appendEquiv d d).tsum_eq _).symm
      _ = ∑' p : (Fin d → ℤ) × (Fin d → ℤ), f p.1 * g p.2 :=
        tsum_congr fun p => coupledQuadraticChart_summand A B y p.1 p.2
      _ = _ := (tsum_mul_tsum_of_summable_norm hfn hgn).symm
  rw [quadraticChartAtom, hs]
  change _ * ((∑' n, f n) * ∑' m, g m) = _
  exact (mul_assoc _ _ _).symm

/-- A partition of unity in the second block removes that lattice sum exactly. -/
theorem coupledQuadraticChart_atom_of_partition {d : ℕ} (A B : QuadraticChartData d)
    (hB : ∀ z : Fin d → ℝ, ∑' m : Fin d → ℤ, B.amplitude (fun i => z i - (m i : ℝ)) = 1)
    (y : ℝ) :
    quadraticChartAtom (coupledQuadraticChart A B) y =
      (Real.fourierChar ((A.quadratic + B.quadratic) * y ^ 2 +
        (A.linear + B.linear) * y) : ℂ) *
      ∑' n : Fin d → ℤ, A.amplitude (chartLatticeRemainder A y n) *
        (Real.fourierChar (y * ∑ i, B.horizontal i * chartLatticeRemainder A y n i) : ℂ) := by
  rw [coupledQuadraticChart_atom]
  have h := hB (chartHorizontalPosition B y)
  change (∑' m : Fin d → ℤ, B.amplitude (chartLatticeRemainder B y m)) = 1 at h
  rw [h, mul_one]

/-- A finite product of finitely supported series factors without convergence qualifications. -/
theorem finite_support_tsum_product {ι κ : Type*} [Fintype ι]
    (f : ι → κ → ℂ) (hf : ∀ i, (f i).HasFiniteSupport) :
    (∑' k : ι → κ, ∏ i, f i (k i)) = ∏ i, ∑' j, f i j := by
  classical
  let s : ι → Finset κ := fun i => (hf i).toFinset
  have hout (i : ι) (j : κ) (hj : j ∉ s i) : f i j = 0 := by
    by_contra h
    exact hj ((hf i).mem_toFinset.mpr h)
  have hzero (k : ι → κ) (hk : k ∉ Fintype.piFinset s) : (∏ i, f i (k i)) = 0 := by
    by_contra h
    apply hk
    apply Fintype.mem_piFinset.mpr
    intro i
    by_contra hi
    exact h (Finset.prod_eq_zero (Finset.mem_univ i) (hout i (k i) hi))
  rw [tsum_eq_sum (s := Fintype.piFinset s) hzero, ← Finset.prod_univ_sum]
  apply Finset.prod_congr rfl
  intro i _
  exact (tsum_eq_sum (s := s i) (hout i)).symm

/-- Tensor product of a real cutoff, viewed as a complex amplitude. -/
noncomputable def chartCoordinateProduct {d : ℕ} (f : ℝ → ℝ) (z : Fin d → ℝ) : ℂ :=
  ∏ i, (f (z i) : ℂ)

theorem chartCoordinateProduct_smooth {d : ℕ} {f : ℝ → ℝ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) :
    ContDiff ℝ (⊤ : ℕ∞) (chartCoordinateProduct (d := d) f) := by
  apply contDiff_prod
  intro i _
  exact Complex.ofRealCLM.contDiff.comp (hf.comp (contDiff_apply ℝ ℝ i))

theorem chartCoordinateProduct_compact {d : ℕ} {f : ℝ → ℝ}
    (hf : HasCompactSupport f) :
    HasCompactSupport (chartCoordinateProduct (d := d) f) := by
  obtain ⟨H, hH, hbound⟩ := hf.isBounded.exists_pos_norm_le
  apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall 0 H)
  intro z hz
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg hH.le).mpr
  intro i
  have hprod : ∏ j : Fin d, (f (z j) : ℂ) ≠ 0 := hz
  have hfi : f (z i) ≠ 0 := by
    intro h
    exact hprod (Finset.prod_eq_zero (Finset.mem_univ i) (by simp [h]))
  exact hbound _ (subset_tsupport f hfi)

/-- A compact product cutoff multiplied by a real quadratic phase. -/
noncomputable def chartQuadraticAmplitude {d : ℕ}
    (f : ℝ → ℝ) (C : Fin d → Fin d → ℝ) (z : Fin d → ℝ) : ℂ :=
  chartCoordinateProduct f z * (Real.fourierChar (∑ i, ∑ j, C i j * z i * z j) : ℂ)

theorem chartQuadraticAmplitude_smooth {d : ℕ} {f : ℝ → ℝ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (C : Fin d → Fin d → ℝ) :
    ContDiff ℝ (⊤ : ℕ∞) (chartQuadraticAmplitude f C) := by
  apply (chartCoordinateProduct_smooth hf).mul
  apply chart_fourierChar_smooth.comp
  apply ContDiff.sum
  intro i _
  apply ContDiff.sum
  intro j _
  exact (contDiff_const.mul (contDiff_apply ℝ ℝ i)).mul (contDiff_apply ℝ ℝ j)

theorem chartQuadraticAmplitude_compact {d : ℕ} {f : ℝ → ℝ}
    (hf : HasCompactSupport f) (C : Fin d → Fin d → ℝ) :
    HasCompactSupport (chartQuadraticAmplitude f C) :=
  (chartCoordinateProduct_compact hf).mul_right

/-- A zero-matrix chart encoding the periodization of an arbitrary smooth compact amplitude. -/
noncomputable def amplitudeQuadraticChart {d : ℕ} (θ : Fin d → ℝ) (ell : ℝ)
    (f : (Fin d → ℝ) → ℂ) (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hc : HasCompactSupport f) :
    QuadraticChartData d where
  horizontal := θ
  quadratic := ell
  linear := 0
  matrix := 0
  amplitude := f
  smooth := hf
  compact := hc

/-- The source doubled-horizontal chart, with a quadratic cutoff in the first block
 and a tensor partition in the second; blueprint `lem:local-chart`, lines 1069-1076. -/
noncomputable def localizedQuadraticChart {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g) : QuadraticChartData (d + d) :=
  coupledQuadraticChart
    (amplitudeQuadraticChart θ ell (chartQuadraticAmplitude f C)
      (chartQuadraticAmplitude_smooth hf C) (chartQuadraticAmplitude_compact hfc C))
    (amplitudeQuadraticChart v 0 (chartCoordinateProduct g)
      (chartCoordinateProduct_smooth hg) (chartCoordinateProduct_compact hgc))

theorem compact_real_translate_finite_support (g : ℝ → ℝ) (hg : HasCompactSupport g)
    (x : ℝ) : (fun k : ℤ => (g (x - (k : ℝ)) : ℂ)).HasFiniteSupport := by
  classical
  obtain ⟨H, _, hH⟩ := hg.isBounded.exists_pos_norm_le
  apply (Finset.Icc ⌊x - H⌋ ⌊x + H⌋).finite_toSet.subset
  intro k hk
  have hne : g (x - (k : ℝ)) ≠ 0 := by
    intro h
    exact hk (by simp [h])
  have ha : |x - (k : ℝ)| ≤ H := hH _ (subset_tsupport g hne)
  obtain ⟨hlo, hhi⟩ := abs_le.mp ha
  apply Finset.mem_Icc.mpr
  constructor
  · have h : x - H ≤ (k : ℝ) := by linarith
    simpa only [Int.floor_intCast] using Int.floor_mono h
  · apply Int.le_floor.mpr
    linarith

/-- Tensoring a compact one-dimensional partition gives an exact lattice partition. -/
theorem chartCoordinateProduct_periodization {d : ℕ} (g : ℝ → ℝ)
    (hg : HasCompactSupport g) (hpart : ∀ x : ℝ, ∑' k : ℤ, g (x - (k : ℝ)) = 1)
    (z : Fin d → ℝ) :
    (∑' k : Fin d → ℤ, chartCoordinateProduct g (fun i => z i - (k i : ℝ))) = 1 := by
  unfold chartCoordinateProduct
  rw [finite_support_tsum_product (fun i (k : ℤ) => (g (z i - (k : ℝ)) : ℂ))
    (fun i => compact_real_translate_finite_support g hg (z i))]
  simp only [← Complex.ofReal_tsum, hpart, Complex.ofReal_one, Finset.prod_const_one]

/-- The local chart's actual lattice formula after canceling its tensor partition. -/
theorem localizedQuadraticChart_atom {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hpart : ∀ x : ℝ, ∑' k : ℤ, g (x - (k : ℝ)) = 1) (y : ℝ) :
    quadraticChartAtom (localizedQuadraticChart θ v ell C f g hf hg hfc hgc) y =
      (Real.fourierChar (ell * y ^ 2) : ℂ) *
      ∑' k : Fin d → ℤ,
        chartCoordinateProduct f (fun i => θ i * y - (k i : ℝ)) *
          (Real.fourierChar
            ((∑ i, ∑ j, C i j * (θ i * y - (k i : ℝ)) * (θ j * y - (k j : ℝ))) +
              y * ∑ i, v i * (θ i * y - (k i : ℝ))) : ℂ) := by
  unfold localizedQuadraticChart
  rw [coupledQuadraticChart_atom_of_partition _ _
    (chartCoordinateProduct_periodization g hgc hpart)]
  simp only [amplitudeQuadraticChart, chartLatticeRemainder, add_zero, zero_mul,
    chartQuadraticAmplitude]
  congr 1
  apply tsum_congr
  intro k
  rw [AddChar.map_add_eq_mul, Circle.coe_mul]
  exact mul_assoc _ _ _

theorem localizedQuadraticChart_height {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g) (i j : Fin (d + d)) :
    chartRationalHeight ((localizedQuadraticChart θ v ell C f g hf hg hfc hgc).matrix i j) = 1 :=
  chartCouplingMatrix_height d i j

/-- Scaling a cutoff supported in the unit interval gives a compactly supported cutoff. -/
theorem scaled_unit_cutoff_compact (f : ℝ → ℝ) (hsupp : ∀ x, 1 ≤ |x| → f x = 0)
    {r : ℝ} (hr : 0 < r) : HasCompactSupport (fun x => f (x / r)) := by
  apply HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall 0 r)
  intro x hx
  rw [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs]
  by_contra h
  apply hx
  apply hsupp
  rw [abs_div, abs_of_pos hr]
  exact (le_div_iff₀ hr).mpr (by linarith)


/-- A centered lattice representative and a strictly shorter representative must coincide. -/
theorem integer_translate_unique {d : ℕ} (z : Fin d → ℝ) (k l : Fin d → ℤ)
    (hk : ∀ i, |z i - (k i : ℝ)| ≤ 1 / 2)
    (hl : ∀ i, |z i - (l i : ℝ)| < 1 / 2) : k = l := by
  funext i
  have heq : ((k i - l i : ℤ) : ℝ) = (z i - (l i : ℝ)) - (z i - (k i : ℝ)) := by
    push_cast
    ring
  have hr : |((k i - l i : ℤ) : ℝ)| < 1 := by
    rw [heq]
    have h := abs_sub (z i - (l i : ℝ)) (z i - (k i : ℝ))
    linarith [hk i, hl i]
  have hi : |k i - l i| < (1 : ℤ) := by exact_mod_cast hr
  have h := abs_lt.mp hi
  omega

theorem chartCoordinateProduct_coord_lt {d : ℕ} {f : ℝ → ℝ} {r : ℝ}
    (hsupp : ∀ x, r ≤ |x| → f x = 0) (z : Fin d → ℝ)
    (hz : chartCoordinateProduct f z ≠ 0) (i : Fin d) : |z i| < r := by
  by_contra h
  have hfi := hsupp (z i) (le_of_not_gt h)
  exact hz (Finset.prod_eq_zero (Finset.mem_univ i) (by simp [hfi]))

/-- The entire lattice sum is its centered term, including when that term vanishes. -/
theorem localizedQuadraticChart_at_center {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hpart : ∀ x : ℝ, ∑' k : ℤ, g (x - (k : ℝ)) = 1)
    {r : ℝ} (hr : r < 1 / 2) (hsupp : ∀ x, r ≤ |x| → f x = 0)
    (y : ℝ) (k : Fin d → ℤ) (hk : ∀ i, |θ i * y - (k i : ℝ)| ≤ 1 / 2) :
    quadraticChartAtom (localizedQuadraticChart θ v ell C f g hf hg hfc hgc) y =
      (Real.fourierChar (ell * y ^ 2) : ℂ) *
        chartCoordinateProduct f (fun i => θ i * y - (k i : ℝ)) *
        (Real.fourierChar
          ((∑ i, ∑ j, C i j * (θ i * y - (k i : ℝ)) * (θ j * y - (k j : ℝ))) +
            y * ∑ i, v i * (θ i * y - (k i : ℝ))) : ℂ) := by
  rw [localizedQuadraticChart_atom θ v ell C f g hf hg hfc hgc hpart]
  rw [tsum_eq_single k]
  · exact (mul_assoc _ _ _).symm
  · intro l hl
    have hz : chartCoordinateProduct f (fun i => θ i * y - (l i : ℝ)) = 0 := by
      by_contra h
      have hl' (i : Fin d) : |θ i * y - (l i : ℝ)| < 1 / 2 :=
        (chartCoordinateProduct_coord_lt hsupp _ h i).trans hr
      exact hl (integer_translate_unique (fun i => θ i * y) k l hk hl').symm
    rw [hz, zero_mul]

theorem chartCoordinateProduct_norm_le_one {d : ℕ} (f : ℝ → ℝ)
    (hf : ∀ x, |f x| ≤ 1) (z : Fin d → ℝ) : ‖chartCoordinateProduct f z‖ ≤ 1 := by
  calc
    _ = ∏ i, |f (z i)| := by simp [chartCoordinateProduct, norm_prod]
    _ ≤ 1 := Finset.prod_le_one₀ (fun i _ => abs_nonneg _) (fun i _ => hf (z i))

/-- Compact unit cutoffs of width less than one yield a chart bounded on the entire real line. -/
theorem localizedQuadraticChart_bounded {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hpart : ∀ x : ℝ, ∑' k : ℤ, g (x - (k : ℝ)) = 1)
    {r : ℝ} (hr : r < 1 / 2) (hsupp : ∀ x, r ≤ |x| → f x = 0)
    (hunit : ∀ x, |f x| ≤ 1) :
    IsBoundedQuadraticChart (localizedQuadraticChart θ v ell C f g hf hg hfc hgc) := by
  intro y
  let k : Fin d → ℤ := fun i => ⌊θ i * y + 1 / 2⌋
  have hk (i : Fin d) : |θ i * y - (k i : ℝ)| ≤ 1 / 2 := by
    have hlo := Int.floor_le (θ i * y + 1 / 2)
    have hhi := Int.lt_floor_add_one (θ i * y + 1 / 2)
    apply abs_le.mpr
    dsimp [k]
    constructor <;> linarith
  rw [localizedQuadraticChart_at_center θ v ell C f g hf hg hfc hgc hpart hr hsupp y k hk]
  simp only [norm_mul, Circle.norm_coe, one_mul, mul_one]
  exact chartCoordinateProduct_norm_le_one f hunit _


/-- Geometric derivative bounds combine by adding their bases. -/
theorem derivative_product_geometric {E A : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedCommRing A] [NormedAlgebra ℝ A]
    {f g : E → A} (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (x : E) {m : ℕ} {R T : ℝ} (hR : 0 ≤ R) (_hT : 0 ≤ T)
    (hfi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i f x‖ ≤ R ^ i)
    (hgi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i g x‖ ≤ T ^ i) :
    ‖iteratedFDeriv ℝ m (fun y => f y * g y) x‖ ≤ (R + T) ^ m := by
  calc
    _ ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) *
        ‖iteratedFDeriv ℝ i f x‖ * ‖iteratedFDeriv ℝ (m - i) g x‖ :=
      norm_iteratedFDeriv_mul_le hf hg x (by simp)
    _ ≤ ∑ i ∈ Finset.range (m + 1), (m.choose i : ℝ) * R ^ i * T ^ (m - i) := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ m := by simpa only [Finset.mem_range, Nat.lt_succ_iff] using hi
      gcongr
      · exact hfi i hi'
      · exact hgi (m - i) (Nat.sub_le _ _)
    _ = (R + T) ^ m := by
      rw [add_pow]
      apply Finset.sum_congr rfl
      intro i _
      ring

/-- A tensor product of unit zeroth derivatives has a dimension-to-the-order loss. -/
theorem finite_product_derivative_geometric {ι E A : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedCommRing A] [NormedAlgebra ℝ A] [NormOneClass A]
    (u : Finset ι) (f : ι → E → A)
    (hf : ∀ j ∈ u, ContDiff ℝ (⊤ : ℕ∞) (f j))
    (x : E) {m : ℕ} {R : ℝ} (hR : 0 ≤ R)
    (hfi : ∀ j ∈ u, ∀ i ≤ m, ‖iteratedFDeriv ℝ i (f j) x‖ ≤ R ^ i) :
    ‖iteratedFDeriv ℝ m (fun y => ∏ j ∈ u, f j y) x‖ ≤ ((u.card : ℝ) * R) ^ m := by
  classical
  induction u using Finset.induction generalizing m with
  | empty =>
    cases m <;> simp [iteratedFDeriv_succ_const]
  | @insert j u hj ih =>
    have hju : ∀ i ∈ u, ContDiff ℝ (⊤ : ℕ∞) (f i) :=
      fun i hi => hf i (Finset.mem_insert_of_mem hi)
    have hprod : ContDiff ℝ (⊤ : ℕ∞) (fun y => ∏ i ∈ u, f i y) := contDiff_prod hju
    have hinner (k : ℕ) (hk : k ≤ m) :
        ‖iteratedFDeriv ℝ k (fun y => ∏ i ∈ u, f i y) x‖ ≤ ((u.card : ℝ) * R) ^ k :=
      ih hju (fun i hi a ha => hfi i (Finset.mem_insert_of_mem hi) a (ha.trans hk))
    have h := derivative_product_geometric (hf j (Finset.mem_insert_self _ _)) hprod x
      hR (mul_nonneg (Nat.cast_nonneg _) hR)
      (hfi j (Finset.mem_insert_self _ _)) hinner
    simpa only [Finset.prod_insert hj, Finset.card_insert_of_notMem hj, Nat.cast_add,
      Nat.cast_one, add_mul, one_mul, add_comm R] using h

/-- Restricting to one coordinate cannot increase a derivative operator norm. -/
theorem coordinate_composition_derivative_norm {d : ℕ} {A : Type*}
    [NormedAddCommGroup A] [NormedSpace ℝ A] {f : ℝ → A}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (i : Fin d) (z : Fin d → ℝ) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => f (y i)) z‖ ≤
      ‖iteratedDeriv m f (z i)‖ := by
  let L : (Fin d → ℝ) →L[ℝ] ℝ := ContinuousLinearMap.proj i
  have hL : ‖L‖ ≤ 1 := by
    apply L.opNorm_le_bound zero_le_one
    intro y
    simpa only [L, ContinuousLinearMap.proj_apply, one_mul] using norm_le_pi_norm y i
  change ‖iteratedFDeriv ℝ m (f ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right hf z (by simp)]
  apply (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  calc
    _ ≤ ‖iteratedDeriv m f (L z)‖ * 1 := by
      gcongr
      exact Finset.prod_le_one₀ (fun _ _ => norm_nonneg L) (fun _ _ => hL)
    _ = _ := mul_one _

theorem coordinate_projection_derivative_norm {d : ℕ} (z : Fin d → ℝ)
    (hz : ∀ i, |z i| ≤ 1) (i : Fin d) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => y i) z‖ ≤ 1 := by
  apply (coordinate_composition_derivative_norm contDiff_id i z m).trans
  rw [iteratedDeriv_id]
  split_ifs <;> simpa only [Real.norm_eq_abs, abs_one, abs_zero] using
    (by first | exact hz i | norm_num : _ ≤ (1 : ℝ))

/-- A product of two coordinates has geometric derivative bounds throughout the unit cube. -/
theorem coordinate_product_derivative_norm {d : ℕ} (z : Fin d → ℝ)
    (hz : ∀ i, |z i| ≤ 1) (i j : Fin d) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => y i * y j) z‖ ≤ (2 : ℝ) ^ m := by
  simpa only [one_add_one_eq_two] using derivative_product_geometric
    (contDiff_apply ℝ ℝ i) (contDiff_apply ℝ ℝ j) z
    (by norm_num : (0 : ℝ) ≤ 1) (by norm_num : (0 : ℝ) ≤ 1)
    (fun k _ => by simpa only [one_pow] using coordinate_projection_derivative_norm z hz i k)
    (fun k _ => by simpa only [one_pow] using coordinate_projection_derivative_norm z hz j k)

/-- Bounded quadratic coefficients give a uniform operator-derivative bound on the unit cube. -/
theorem bounded_quadratic_derivative_norm {d : ℕ} (C : Fin d → Fin d → ℝ)
    (hC : ∀ i j, |C i j| ≤ 1) (z : Fin d → ℝ) (hz : ∀ i, |z i| ≤ 1) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => ∑ i, ∑ j, C i j * y i * y j) z‖ ≤
      (d : ℝ) ^ 2 * (2 : ℝ) ^ m := by
  have hsm (i j : Fin d) : ContDiff ℝ m (fun y : Fin d → ℝ => C i j * y i * y j) :=
    (contDiff_const.mul (contDiff_apply ℝ ℝ i)).mul (contDiff_apply ℝ ℝ j)
  have hmono (i j : Fin d) :
      ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => C i j * y i * y j) z‖ ≤ (2 : ℝ) ^ m := by
    have he : (fun y : Fin d → ℝ => C i j * y i * y j) =
        (fun y : Fin d → ℝ => C i j • (y i * y j)) := by
      funext y
      simp only [smul_eq_mul, mul_assoc]
    rw [he, iteratedFDeriv_const_smul_apply'
      (((contDiff_apply ℝ ℝ i).mul (contDiff_apply ℝ ℝ j) :
        ContDiff ℝ m (fun y : Fin d → ℝ => y i * y j)).contDiffAt),
      norm_smul, Real.norm_eq_abs]
    calc
      _ ≤ 1 * (2 : ℝ) ^ m := mul_le_mul (hC i j)
        (coordinate_product_derivative_norm z hz i j m) (norm_nonneg _) zero_le_one
      _ = _ := one_mul _
  rw [iteratedFDeriv_fun_sum_apply
    (fun i _ => (ContDiff.sum fun j _ => hsm i j).contDiffAt)]
  calc
    _ ≤ ∑ i, ‖iteratedFDeriv ℝ m (fun y : Fin d → ℝ => ∑ j, C i j * y i * y j) z‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _i : Fin d, ∑ _j : Fin d, (2 : ℝ) ^ m := by
      apply Finset.sum_le_sum
      intro i _
      rw [iteratedFDeriv_fun_sum_apply (fun j _ => (hsm i j).contDiffAt)]
      exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => hmono i j)
    _ = _ := by simp; ring

/-- The Fourier exponential of a bounded quadratic has factorial-geometric derivatives
 on the unit cube; no horizontal frequencies or lattice basis occur in the bound. -/
theorem bounded_quadratic_phase_derivative_norm {d : ℕ} (C : Fin d → Fin d → ℝ)
    (hC : ∀ i j, |C i j| ≤ 1) (z : Fin d → ℝ) (hz : ∀ i, |z i| ≤ 1) (m : ℕ) :
    ‖iteratedFDeriv ℝ m
      (fun y : Fin d → ℝ => (Real.fourierChar (∑ i, ∑ j, C i j * y i * y j) : ℂ)) z‖ ≤
      (m.factorial : ℝ) * (4 * Real.pi * (d + 1 : ℝ) ^ 2) ^ m := by
  let Q : (Fin d → ℝ) → ℝ := fun y => ∑ i, ∑ j, C i j * y i * y j
  have hQ : ContDiff ℝ (⊤ : ℕ∞) Q := by
    apply ContDiff.sum
    intro i _
    apply ContDiff.sum
    intro j _
    exact (contDiff_const.mul (contDiff_apply ℝ ℝ i)).mul (contDiff_apply ℝ ℝ j)
  have hpi : 1 ≤ 2 * Real.pi := by linarith [Real.pi_gt_three]
  have houter (i : ℕ) (hi : i ≤ m) :
      ‖iteratedFDeriv ℝ i (fun t : ℝ => (Real.fourierChar t : ℂ)) (Q z)‖ ≤
        (2 * Real.pi) ^ m := by
    rw [chart_fourierChar_derivative_norm]
    exact pow_le_pow_right₀ hpi hi
  have hinner (i : ℕ) (hi : 1 ≤ i) (_him : i ≤ m) :
      ‖iteratedFDeriv ℝ i Q z‖ ≤ (2 * (d + 1 : ℝ) ^ 2) ^ i := by
    apply (bounded_quadratic_derivative_norm C hC z hz i).trans
    rw [mul_pow]
    have hd : 1 ≤ (d + 1 : ℝ) ^ 2 := by
      have := Nat.cast_nonneg (α := ℝ) d
      nlinarith
    have hp : (d : ℝ) ^ 2 ≤ ((d + 1 : ℝ) ^ 2) ^ i := by
      calc
        _ ≤ (d + 1 : ℝ) ^ 2 := by have := Nat.cast_nonneg (α := ℝ) d; nlinarith
        _ ≤ _ := le_self_pow₀ hd (by omega)
    nlinarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 2) i]
  have h := norm_iteratedFDeriv_comp_le (n := m) chart_fourierChar_smooth hQ
    (by simp) z houter hinner
  change ‖iteratedFDeriv ℝ m
    (fun y : Fin d → ℝ => (Real.fourierChar (∑ i, ∑ j, C i j * y i * y j) : ℂ)) z‖ ≤ _ at h
  convert h using 1
  rw [mul_assoc (m.factorial : ℝ), ← mul_pow]
  congr 2
  ring

/-- Uniform one-variable geometric bounds yield an operator-norm tensor cutoff bound. -/
theorem chartCoordinateProduct_derivative_geometric {d : ℕ} {f : ℝ → ℝ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (z : Fin d → ℝ) {m : ℕ} {R : ℝ} (hR : 0 ≤ R)
    (hfi : ∀ i ≤ m, ∀ x : ℝ, |iteratedDeriv i f x| ≤ R ^ i) :
    ‖iteratedFDeriv ℝ m (chartCoordinateProduct (d := d) f) z‖ ≤ ((d : ℝ) * R) ^ m := by
  have hs (j : Fin d) : ContDiff ℝ (⊤ : ℕ∞) (fun y : Fin d → ℝ => f (y j)) :=
    hf.comp (contDiff_apply ℝ ℝ j)
  have hd (j : Fin d) (i : ℕ) (hi : i ≤ m) :
      ‖iteratedFDeriv ℝ i (fun y : Fin d → ℝ => f (y j)) z‖ ≤ R ^ i := by
    apply (coordinate_composition_derivative_norm hf j z i).trans
    simpa only [Real.norm_eq_abs] using hfi i hi (z j)
  have hp := finite_product_derivative_geometric Finset.univ
    (fun j (y : Fin d → ℝ) => f (y j)) (fun j _ => hs j) z hR (fun j _ => hd j)
  have he : chartCoordinateProduct (d := d) f =
      Complex.ofRealLI ∘ (fun y : Fin d → ℝ => ∏ j, f (y j)) := by
    funext y
    simp only [chartCoordinateProduct, Function.comp_apply, Complex.ofRealLI_apply,
      Complex.ofReal_prod]
  rw [he, Complex.ofRealLI.norm_iteratedFDeriv_comp_left
    ((contDiff_prod (fun j _ => hs j)).contDiffAt) (by simp)]
  simpa only [Finset.card_univ, Fintype.card_fin] using hp


/-- Coordinate restriction cannot increase an iterated derivative operator norm. -/
theorem chart_restriction_derivative_norm {d D : ℕ} {f : (Fin d → ℝ) → ℂ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (s : Fin d → Fin D) (z : Fin D → ℝ) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y => f (fun i => y (s i))) z‖ ≤
      ‖iteratedFDeriv ℝ m f (fun i => z (s i))‖ := by
  change ‖iteratedFDeriv ℝ m (f ∘ chartCoordinateRestriction s) z‖ ≤ _
  rw [(chartCoordinateRestriction s).iteratedFDeriv_comp_right hf z (by simp)]
  apply (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
  have hp : (∏ _i : Fin m, ‖chartCoordinateRestriction s‖) ≤ 1 :=
    Finset.prod_le_one₀ (fun _ _ => norm_nonneg _) (fun _ _ => chartCoordinateRestriction_norm_le s)
  calc
    _ ≤ ‖iteratedFDeriv ℝ m f (chartCoordinateRestriction s z)‖ * 1 :=
      mul_le_mul_of_nonneg_left hp (norm_nonneg _)
    _ = _ := mul_one _

theorem bounded_quadratic_phase_derivative_geometric {d : ℕ}
    (C : Fin d → Fin d → ℝ) (hC : ∀ i j, |C i j| ≤ 1)
    (z : Fin d → ℝ) (hz : ∀ i, |z i| ≤ 1) (m i : ℕ) (hi : i ≤ m) :
    ‖iteratedFDeriv ℝ i
      (fun y : Fin d → ℝ => (Real.fourierChar (∑ j, ∑ k, C j k * y j * y k) : ℂ)) z‖ ≤
      (4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ)) ^ i := by
  apply (bounded_quadratic_phase_derivative_norm C hC z hz i).trans
  have hfact : (i.factorial : ℝ) ≤ (m + 1 : ℝ) ^ i := by
    calc
      _ ≤ (i : ℝ) ^ i := by exact_mod_cast Nat.factorial_le_pow i
      _ ≤ _ := pow_le_pow_left₀ (Nat.cast_nonneg _) (by exact_mod_cast Nat.le_succ_of_le hi) _
  calc
    _ ≤ (m + 1 : ℝ) ^ i * (4 * Real.pi * (d + 1 : ℝ) ^ 2) ^ i :=
      mul_le_mul_of_nonneg_right hfact (by positivity)
    _ = _ := (mul_comm _ _).trans (mul_pow _ _ _).symm

/-- The quadratic cutoff has geometric bounds up to a chosen order inside the unit cube. -/
theorem chartQuadraticAmplitude_derivative_geometric {d : ℕ} {f : ℝ → ℝ}
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (C : Fin d → Fin d → ℝ)
    (hC : ∀ i j, |C i j| ≤ 1) (z : Fin d → ℝ) (hz : ∀ i, |z i| ≤ 1)
    {m i : ℕ} (hi : i ≤ m) {R : ℝ} (hR : 0 ≤ R)
    (hfi : ∀ j ≤ m, ∀ x : ℝ, |iteratedDeriv j f x| ≤ R ^ j) :
    ‖iteratedFDeriv ℝ i (chartQuadraticAmplitude f C) z‖ ≤
      ((d : ℝ) * R + 4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ)) ^ i := by
  have hphase : ContDiff ℝ (⊤ : ℕ∞)
      (fun y : Fin d → ℝ => (Real.fourierChar (∑ j, ∑ k, C j k * y j * y k) : ℂ)) := by
    apply chart_fourierChar_smooth.comp
    apply ContDiff.sum
    intro j _
    apply ContDiff.sum
    intro k _
    exact (contDiff_const.mul (contDiff_apply ℝ ℝ j)).mul (contDiff_apply ℝ ℝ k)
  exact derivative_product_geometric (chartCoordinateProduct_smooth hf) hphase z
    (mul_nonneg (Nat.cast_nonneg _) hR) (by positivity)
    (fun j hj => chartCoordinateProduct_derivative_geometric hf z hR
      (fun k hk => hfi k (hk.trans (hj.trans hi))))
    (fun j hj => bounded_quadratic_phase_derivative_geometric C hC z hz m j (hj.trans hi))

/-- The actual doubled amplitude and all its derivatives are supported in the unit cube. -/
theorem localizedQuadraticChart_amplitude_support {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hfs : ∀ x, 1 ≤ |x| → f x = 0) (hgs : ∀ x, 1 ≤ |x| → g x = 0) :
    tsupport (localizedQuadraticChart θ v ell C f g hf hg hfc hgc).amplitude ⊆
      Metric.closedBall 0 1 := by
  apply closure_minimal _ Metric.isClosed_closedBall
  intro z hz
  change (chartCoordinateProduct f (fun i => z (Fin.castAdd d i)) *
      (Real.fourierChar _) : ℂ) *
    chartCoordinateProduct g (fun i => z (Fin.natAdd d i)) ≠ 0 at hz
  have hfz := (mul_ne_zero_iff.mp (mul_ne_zero_iff.mp hz).1).1
  have hgz := (mul_ne_zero_iff.mp hz).2
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg zero_le_one).mpr
  intro i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · exact (chartCoordinateProduct_coord_lt hfs _ hfz j).le
  · exact (chartCoordinateProduct_coord_lt hgs _ hgz j).le

/-- Operator-norm derivatives of the actual doubled chart amplitude have a uniform
 geometric bound. Compact support removes the need for any restriction on the evaluation point. -/
theorem localizedQuadraticChart_amplitude_derivative_geometric {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hfc : HasCompactSupport f) (hgc : HasCompactSupport g)
    (hfs : ∀ x, 1 ≤ |x| → f x = 0) (hgs : ∀ x, 1 ≤ |x| → g x = 0)
    (hC : ∀ i j, |C i j| ≤ 1) (z : Fin (d + d) → ℝ) (m : ℕ)
    {R T : ℝ} (hR : 0 ≤ R) (hT : 0 ≤ T)
    (hfi : ∀ i ≤ m, ∀ x : ℝ, |iteratedDeriv i f x| ≤ R ^ i)
    (hgi : ∀ i ≤ m, ∀ x : ℝ, |iteratedDeriv i g x| ≤ T ^ i) :
    ‖iteratedFDeriv ℝ m
      (localizedQuadraticChart θ v ell C f g hf hg hfc hgc).amplitude z‖ ≤
      ((d : ℝ) * R + 4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ) + (d : ℝ) * T) ^ m := by
  let A := localizedQuadraticChart θ v ell C f g hf hg hfc hgc
  by_cases hz : ‖z‖ ≤ 1
  · have hzL (i : Fin d) : |z (Fin.castAdd d i)| ≤ 1 :=
      (norm_le_pi_norm z (Fin.castAdd d i)).trans hz
    have hleft : ContDiff ℝ (⊤ : ℕ∞)
        (fun y : Fin (d + d) → ℝ => chartQuadraticAmplitude f C (fun i => y (Fin.castAdd d i))) :=
      (chartQuadraticAmplitude_smooth hf C).comp
        (chartCoordinateRestriction (Fin.castAdd d)).contDiff
    have hright : ContDiff ℝ (⊤ : ℕ∞)
        (fun y : Fin (d + d) → ℝ => chartCoordinateProduct g (fun i => y (Fin.natAdd d i))) :=
      (chartCoordinateProduct_smooth hg).comp (chartCoordinateRestriction (Fin.natAdd d)).contDiff
    apply derivative_product_geometric hleft hright z (by positivity)
      (mul_nonneg (Nat.cast_nonneg _) hT)
    · intro i hi
      apply (chart_restriction_derivative_norm (chartQuadraticAmplitude_smooth hf C)
        (Fin.castAdd d) z i).trans
      exact chartQuadraticAmplitude_derivative_geometric hf C hC _ hzL hi hR hfi
    · intro i hi
      apply (chart_restriction_derivative_norm (chartCoordinateProduct_smooth hg)
        (Fin.natAdd d) z i).trans
      exact chartCoordinateProduct_derivative_geometric hg _ hT (fun j hj => hgi j (hj.trans hi))
  · have hzero : iteratedFDeriv ℝ m A.amplitude z = 0 := by
      by_contra h
      have hs := support_iteratedFDeriv_subset (𝕜 := ℝ) (f := A.amplitude) m h
      have hb := localizedQuadraticChart_amplitude_support θ v ell C f g hf hg hfc hgc hfs hgs hs
      exact hz (by simpa only [Metric.mem_closedBall, dist_zero_right] using hb)
    change ‖iteratedFDeriv ℝ m A.amplitude z‖ ≤ _
    rw [hzero, norm_zero]
    positivity

/-- Unit zeroth derivatives remove the dimension-dependent loss in a Gevrey product. -/
theorem gevrey_derivative_geometric (f : ℝ → ℝ) (K : ℕ) (hK : 1 ≤ K)
    (hunit : ∀ x, |f x| ≤ 1)
    (hderiv : ∀ i x, |iteratedDeriv i f x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)))
    (m i : ℕ) (hi : i ≤ m) (x : ℝ) :
    |iteratedDeriv i f x| ≤ (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) ^ i := by
  by_cases hi0 : i = 0
  · simpa only [hi0, iteratedDeriv_zero, pow_zero] using hunit x
  have hKr : (1 : ℝ) ≤ K := by exact_mod_cast hK
  have hbase : 1 ≤ (K : ℝ) * (m + 1 : ℝ) := by
    have := Nat.cast_nonneg (α := ℝ) m
    nlinarith
  calc
    _ ≤ ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)) := hderiv i x
    _ ≤ ((K : ℝ) * (m + 1 : ℝ)) ^ (K * (i + 1)) := by
      gcongr
    _ ≤ ((K : ℝ) * (m + 1 : ℝ)) ^ ((2 * K) * i) :=
      pow_le_pow_right₀ hbase (by nlinarith [Nat.one_le_iff_ne_zero.mpr hi0])
    _ = _ := pow_mul _ _ _

/-- Scaling a unit cutoff contributes exactly one inverse-radius factor per derivative. -/
theorem scaled_gevrey_derivative_geometric (f : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (K : ℕ) (hK : 1 ≤ K)
    (hunit : ∀ x, |f x| ≤ 1)
    (hderiv : ∀ i x, |iteratedDeriv i f x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)))
    {r : ℝ} (hr : 0 < r) (m i : ℕ) (hi : i ≤ m) (x : ℝ) :
    |iteratedDeriv i (fun y => f (y / r)) x| ≤
      ((((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) / r) ^ i := by
  have he : (fun y : ℝ => f (y / r)) = (fun y : ℝ => f (r⁻¹ * y)) := by
    funext y
    rw [div_eq_mul_inv, mul_comm]
  rw [he, iteratedDeriv_comp_const_mul (hf.of_le (by simp)) r⁻¹]
  simp only [abs_mul, abs_pow, abs_inv, abs_of_pos hr]
  calc
    _ ≤ r⁻¹ ^ i * (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) ^ i :=
      mul_le_mul_of_nonneg_left (gevrey_derivative_geometric f K hK hunit hderiv m i hi _)
        (by positivity)
    _ = _ := by rw [div_pow, inv_pow]; ring

/-- The geometric amplitude base fits one fixed Gevrey order, uniformly in dimension and radius. -/
theorem local_chart_derivative_budget (d K m : ℕ) (hK : 1 ≤ K)
    {r : ℝ} (hr : 0 < r) (hr1 : r ≤ 1) :
    ((d : ℝ) * (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) / r) +
      4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ) +
      (d : ℝ) * ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) ^ m ≤
    (100 * (K + 1 : ℝ) * (d + 1 : ℝ) / r) ^ ((2 * K + 2) * (m + 1)) *
      (m + 1 : ℝ) ^ ((2 * K + 2) * (m + 1)) := by
  let A : ℝ := 100 * (K + 1 : ℝ) * (d + 1 : ℝ) / r
  let T : ℝ := A * (m + 1 : ℝ)
  have hKr : (1 : ℝ) ≤ K := by exact_mod_cast hK
  have hd : (0 : ℝ) ≤ d := Nat.cast_nonneg _
  have hm : (1 : ℝ) ≤ m + 1 := by have := Nat.cast_nonneg (α := ℝ) m; linarith
  have hnum : 100 * (K + 1 : ℝ) * (d + 1 : ℝ) ≤ A := by
    dsimp [A]
    apply (le_div_iff₀ hr).mpr
    exact mul_le_of_le_one_right (by positivity) hr1
  have hA3 : 3 ≤ A := by nlinarith
  have hAK : (K : ℝ) ≤ A := by nlinarith
  have hAd : (d + 1 : ℝ) ≤ A := by nlinarith
  have hApi : 4 * Real.pi ≤ A := by nlinarith [Real.pi_lt_four]
  have hAr : (d : ℝ) / r ≤ A := by
    dsimp [A]
    apply (div_le_div_iff_of_pos_right hr).mpr
    nlinarith
  have hT : A ≤ T := le_mul_of_one_le_right (by linarith) hm
  have hT1 : 1 ≤ T := by linarith
  have hB : ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) ≤ T ^ (2 * K) :=
    pow_le_pow_left₀ (by positivity) (mul_le_mul_of_nonneg_right hAK (by linarith)) _
  have hfirst : (d : ℝ) * (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) / r) ≤
      T ^ (2 * K + 1) := by
    calc
      _ = ((d : ℝ) / r) * ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) := by ring
      _ ≤ T * T ^ (2 * K) := mul_le_mul (hAr.trans hT) hB (by positivity) (by linarith)
      _ = _ := by rw [pow_succ]; ring
  have hthird : (d : ℝ) * ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) ≤
      T ^ (2 * K + 1) := by
    calc
      _ ≤ T * T ^ (2 * K) :=
        mul_le_mul (by linarith) hB (by positivity) (by linarith)
      _ = _ := by rw [pow_succ]; ring
  have hsecond : 4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ) ≤ T ^ (2 * K + 1) := by
    calc
      _ ≤ A * A ^ 2 * (m + 1 : ℝ) := by gcongr
      _ ≤ T ^ 3 := by
        dsimp [T]
        have hm3 : (m + 1 : ℝ) ≤ (m + 1 : ℝ) ^ 3 := le_self_pow₀ hm (by norm_num)
        nlinarith [mul_le_mul_of_nonneg_left hm3 (show 0 ≤ A ^ 3 by positivity)]
      _ ≤ _ := pow_le_pow_right₀ hT1 (by omega)
  have hsum : (d : ℝ) * (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) / r) +
      4 * Real.pi * (d + 1 : ℝ) ^ 2 * (m + 1 : ℝ) +
      (d : ℝ) * ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K) ≤ T ^ (2 * K + 2) := by
    calc
      _ ≤ 3 * T ^ (2 * K + 1) := by linarith
      _ ≤ T * T ^ (2 * K + 1) :=
        mul_le_mul_of_nonneg_right (by linarith) (pow_nonneg (by linarith) _)
      _ = _ := by rw [show 2 * K + 2 = (2 * K + 1) + 1 by omega, pow_succ]; ring
  calc
    _ ≤ (T ^ (2 * K + 2)) ^ m := pow_le_pow_left₀ (by positivity) hsum _
    _ = T ^ ((2 * K + 2) * m) := (pow_mul _ _ _).symm
    _ ≤ T ^ ((2 * K + 2) * (m + 1)) := pow_le_pow_right₀ hT1 (Nat.mul_le_mul_left _ (Nat.le_succ m))
    _ = _ := by rw [show T = A * (m + 1 : ℝ) from rfl, mul_pow]

/-- Blueprint `lem:local-chart`, line 1082: the doubled amplitude has one fixed
 Gevrey order and explicit polynomial dependence on dimension and inverse radius. -/
theorem localizedQuadraticChart_gevrey_bound {d : ℕ}
    (θ v : Fin d → ℝ) (ell : ℝ) (C : Fin d → Fin d → ℝ) (f g : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (hgc : HasCompactSupport g) (hfs : ∀ x, 1 ≤ |x| → f x = 0)
    (hgs : ∀ x, 1 ≤ |x| → g x = 0) (hC : ∀ i j, |C i j| ≤ 1)
    (K : ℕ) (hK : 1 ≤ K) (hfu : ∀ x, |f x| ≤ 1) (hgu : ∀ x, |g x| ≤ 1)
    (hfderiv : ∀ i x, |iteratedDeriv i f x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)))
    (hgderiv : ∀ i x, |iteratedDeriv i g x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)))
    {r : ℝ} (hr : 0 < r) (hr1 : r ≤ 1) (m : ℕ)
    (word : Fin m → Fin (d + d)) (z : Fin (d + d) → ℝ) :
    ‖coordinateWordDerivative m
      (localizedQuadraticChart θ v ell C (fun x => f (x / r)) g
        (hf.comp (contDiff_id.div_const r)) hg (scaled_unit_cutoff_compact f hfs hr) hgc).amplitude
      word z‖ ≤
      (100 * (K + 1 : ℝ) * (d + 1 : ℝ) / r) ^ ((2 * K + 2) * (m + 1)) *
        (m + 1 : ℝ) ^ ((2 * K + 2) * (m + 1)) := by
  let A := localizedQuadraticChart θ v ell C (fun x => f (x / r)) g
    (hf.comp (contDiff_id.div_const r)) hg (scaled_unit_cutoff_compact f hfs hr) hgc
  have hs (x : ℝ) (hx : 1 ≤ |x|) : f (x / r) = 0 := by
    apply hfs
    rw [abs_div, abs_of_pos hr]
    exact (le_div_iff₀ hr).mpr (by linarith)
  have h := localizedQuadraticChart_amplitude_derivative_geometric θ v ell C
    (fun x => f (x / r)) g (hf.comp (contDiff_id.div_const r)) hg
    (scaled_unit_cutoff_compact f hfs hr) hgc hs hgs hC z m
    (R := (((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K)) / r)
    (T := ((K : ℝ) * (m + 1 : ℝ)) ^ (2 * K))
    (by positivity) (by positivity)
    (fun i hi x => scaled_gevrey_derivative_geometric f hf K hK hfu hfderiv hr m i hi x)
    (fun i hi x => gevrey_derivative_geometric g K hK hgu hgderiv m i hi x)
  have hword : ‖coordinateWordDerivative m A.amplitude word z‖ ≤
      ‖iteratedFDeriv ℝ m A.amplitude z‖ := by
    simpa [coordinateWordDerivative, Pi.norm_single] using
      (iteratedFDeriv ℝ m A.amplitude z).le_opNorm (fun i => Pi.single (word i) 1)
  exact hword.trans (h.trans (local_chart_derivative_budget d K m hK hr hr1))

theorem gevrey_derivative_bound_mono (f : ℝ → ℝ) {K L : ℕ} (hK : 1 ≤ K) (hKL : K ≤ L)
    (h : ∀ i x, |iteratedDeriv i f x| ≤
      ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1))) (i : ℕ) (x : ℝ) :
    |iteratedDeriv i f x| ≤ ((L : ℝ) * (i + 1 : ℝ)) ^ (L * (i + 1)) := by
  have hL : (1 : ℝ) ≤ L := by exact_mod_cast hK.trans hKL
  have hi : (1 : ℝ) ≤ i + 1 := by have := Nat.cast_nonneg (α := ℝ) i; linarith
  calc
    _ ≤ ((K : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)) := h i x
    _ ≤ ((L : ℝ) * (i + 1 : ℝ)) ^ (K * (i + 1)) := by gcongr
    _ ≤ _ := pow_le_pow_right₀ (by nlinarith) (Nat.mul_le_mul_right _ hKL)


noncomputable def modulateQuadraticChart {d : ℕ} (A : QuadraticChartData d) (b : ℝ) :
    QuadraticChartData d := { A with linear := A.linear + b }
theorem modulateQuadraticChart_atom {d : ℕ} (A : QuadraticChartData d) (b y : ℝ) :
    quadraticChartAtom (modulateQuadraticChart A b) y =
      (Real.fourierChar (b * y) : ℂ) * quadraticChartAtom A y := by
  unfold quadraticChartAtom modulateQuadraticChart
  have he : A.quadratic * y ^ 2 + (A.linear + b) * y =
      b * y + (A.quadratic * y ^ 2 + A.linear * y) := by ring
  rw [he, AddChar.map_add_eq_mul, Circle.coe_mul]
  exact mul_assoc _ _ _
theorem modulateQuadraticChart_complexity {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (b : ℝ) :
    QuadraticChartComplexity c₀ H (modulateQuadraticChart A b) :=
  ⟨hA.lower, hA.dimension, hA.height, hA.support, hA.derivative⟩
theorem modulateQuadraticChart_bounded {d : ℕ} {A : QuadraticChartData d}
    (hA : IsBoundedQuadraticChart A) (b : ℝ) :
    IsBoundedQuadraticChart (modulateQuadraticChart A b) := by
  intro y
  rw [modulateQuadraticChart_atom, norm_mul, Circle.norm_coe, one_mul]
  exact hA y

theorem translated_chart_power_budget {P X : ℝ} (hP : 100000 ≤ P)
    (n : ℕ) (hnP : (n : ℝ) ≤ P) (hX0 : 0 ≤ X) (hX : X ≤ P ^ 22) :
    chartTranslationBudget (Real.exp ((n : ℝ) * X ^ n)) ≤
      Real.exp (P ^ (66 * n + 4)) := by
  have hP0 : 0 ≤ P := by linarith
  have hP1 : 1 ≤ P := by linarith
  have he : (n : ℝ) * X ^ n ≤ P ^ (22 * n + 1) := by
    calc
      _ ≤ P * (P ^ 22) ^ n :=
        mul_le_mul hnP (pow_le_pow_left₀ hX0 hX n) (pow_nonneg hX0 n) hP0
      _ = _ := by rw [← pow_mul, pow_succ]; ring
  have hp : 1 ≤ P ^ (22 * n + 1) := one_le_pow₀ hP1
  unfold chartTranslationBudget logarithmicSize
  rw [Real.log_exp]
  apply Real.exp_le_exp.mpr
  calc
    100 * (1 + (n : ℝ) * X ^ n) ^ 3 ≤ 100 * (2 * P ^ (22 * n + 1)) ^ 3 := by
      gcongr
      linarith
    _ = 800 * P ^ ((22 * n + 1) * 3) := by rw [mul_pow, ← pow_mul]; ring
    _ ≤ P * P ^ ((22 * n + 1) * 3) :=
      mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    _ = P ^ (66 * n + 4) := by
      rw [← pow_succ']
      congr 1
      omega
theorem uniform_translated_chart_budget (n : ℕ) (R : ℝ)
    (hR : 100000 ≤ R) (hnR : (n : ℝ) ≤ R) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ B : ℝ, 1 ≤ B → ∀ X : ℝ, 0 ≤ X →
      X ≤ (R * B ^ 8) ^ 22 →
      chartTranslationBudget (Real.exp ((n : ℝ) * X ^ n)) ≤
        Real.exp ((C : ℝ) * B ^ C) ∧
      (R * B ^ 8) ^ 34 ≤ (C : ℝ) * B ^ C := by
  let N := max 34 (66 * n + 4)
  obtain ⟨c, hc⟩ := exists_nat_ge (R ^ N)
  let C := c + 8 * N + 1
  refine ⟨C, by dsimp [C]; omega, ?_⟩
  intro B hB X hX0 hX
  have hR0 : 0 ≤ R := by linarith
  have hRP : R ≤ R * B ^ 8 := by
    simpa only [mul_one] using mul_le_mul_of_nonneg_left (one_le_pow₀ hB (n := 8)) hR0
  have hP : 100000 ≤ R * B ^ 8 := hR.trans hRP
  have hP1 : 1 ≤ R * B ^ 8 := by linarith
  have hcC : (c : ℝ) ≤ C := by
    exact_mod_cast (show c ≤ C by dsimp [C]; omega)
  have hNC : 8 * N ≤ C := by dsimp [C]; omega
  have hcommon : (R * B ^ 8) ^ N ≤ (C : ℝ) * B ^ C := by
    rw [mul_pow, ← pow_mul]
    exact mul_le_mul (hc.trans hcC) (pow_le_pow_right₀ hB hNC)
      (by positivity) (by positivity)
  have h34 : (R * B ^ 8) ^ 34 ≤ (C : ℝ) * B ^ C :=
    (pow_le_pow_right₀ hP1 (le_max_left _ _)).trans hcommon
  refine ⟨?_, h34⟩
  apply (translated_chart_power_budget hP n (hnR.trans hRP) hX0 hX).trans
  apply Real.exp_le_exp.mpr
  exact (pow_le_pow_right₀ hP1 (le_max_right _ _)).trans hcommon

theorem inverse_half_parameter_budget (C : ℕ) :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ δ : ℝ, 0 < δ → δ < 1 →
      Real.exp ((C : ℝ) * (1 + Real.log (2 / δ)) ^ C) ≤
        Real.exp ((D : ℝ) * (1 + Real.log (1 / δ)) ^ D) := by
  let D := C * 2 ^ C + C + 1
  refine ⟨D, by omega, ?_⟩
  intro δ hδ hδ1
  let B := 1 + Real.log (1 / δ)
  have hinv : 1 ≤ 1 / δ := (le_div_iff₀ hδ).mpr (by linarith only [hδ1])
  have hB : 1 ≤ B := by
    have hh := Real.log_nonneg hinv
    dsimp [B]
    linarith only [hh]
  have hl : Real.log (2 / δ) = Real.log 2 + Real.log (1 / δ) := by
    rw [show 2 / δ = 2 * (1 / δ) by ring,
      Real.log_mul (by norm_num) (by positivity)]
  have hlog2 := Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)
  have hu : 1 + Real.log (2 / δ) ≤ 2 * B := by
    rw [hl]
    dsimp [B] at *
    linarith only [hB, hlog2]
  have hCD : C ≤ D := by dsimp [D]; omega
  have hcoef : (C : ℝ) * 2 ^ C ≤ D := by
    have hh : C * 2 ^ C ≤ D := by dsimp [D]; omega
    exact_mod_cast hh
  apply Real.exp_le_exp.mpr
  calc
    _ ≤ (C : ℝ) * (2 * B) ^ C := by
      gcongr
      rw [hl]
      have h1 := Real.log_nonneg hinv
      have h2 : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
      linarith only [h1, h2]
    _ = ((C : ℝ) * 2 ^ C) * B ^ C := by rw [mul_pow]; ring
    _ ≤ (D : ℝ) * B ^ D :=
      mul_le_mul hcoef (pow_le_pow_right₀ hB hCD) (by positivity) (by positivity)

noncomputable def fractionalPhaseQuadraticChart {d : ℕ} (A : QuadraticChartData d) :
    QuadraticChartData d :=
  { A with quadratic := Int.fract A.quadratic, linear := Int.fract A.linear }
theorem fractionalPhaseQuadraticChart_atom_int {d : ℕ} (A : QuadraticChartData d) (n : ℤ) :
    quadraticChartAtom (fractionalPhaseQuadraticChart A) (n : ℝ) =
      quadraticChartAtom A (n : ℝ) := by
  have hp : Int.fract A.quadratic * (n : ℝ) ^ 2 + Int.fract A.linear * n +
      ((⌊A.quadratic⌋ * n ^ 2 + ⌊A.linear⌋ * n : ℤ) : ℝ) =
      A.quadratic * (n : ℝ) ^ 2 + A.linear * n := by
    simp only [Int.fract]
    push_cast
    ring
  have he : (Real.fourierChar (A.quadratic * (n : ℝ) ^ 2 + A.linear * n) : ℂ) =
      Real.fourierChar (Int.fract A.quadratic * (n : ℝ) ^ 2 + Int.fract A.linear * n) := by
    rw [← hp, chart_fourierChar_add_int]
  unfold quadraticChartAtom
  rw [he]
  rfl
theorem fractionalPhaseQuadraticChart_complexity {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) :
    QuadraticChartComplexity c₀ H (fractionalPhaseQuadraticChart A) :=
  ⟨hA.lower, hA.dimension, hA.height, hA.support, hA.derivative⟩
theorem chart_horizontal_integer_reduction {d : ℕ} {H : ℝ} (hH : 0 ≤ H)
    (C : Matrix (Fin d) (Fin d) ℚ) (hC : ∀ i j, (chartRationalHeight (C i j) : ℝ) ≤ H)
    (v : Fin d → ℝ) :
    ∃ (P : ℕ) (m : Fin d → ℤ) (a : Fin d → ℝ),
      0 < P ∧ (P : ℝ) ≤ H ^ (d ^ 2) ∧
      (∀ i, v i = (m i : ℝ) + a i) ∧ (∀ i, a i ∈ Set.Ico (0 : ℝ) P) ∧
      ∀ i j, ∃ z : ℤ, (z : ℝ) = (m i : ℝ) * (C i j : ℝ) := by
  obtain ⟨P, Z, hP, hPH, hZ⟩ := chart_matrix_clear_denominators hH C hC
  have hPr : (0 : ℝ) < P := Nat.cast_pos.mpr hP
  let k : Fin d → ℤ := fun i => ⌊v i / P⌋
  let m : Fin d → ℤ := fun i => (P : ℤ) * k i
  let a : Fin d → ℝ := fun i => v i - (m i : ℝ)
  refine ⟨P, m, a, hP, hPH, ?_, ?_, ?_⟩
  · intro i
    dsimp [a]
    ring
  · intro i
    have hlo : (k i : ℝ) * P ≤ v i :=
      (le_div_iff₀ hPr).mp (Int.floor_le (v i / P))
    have hhi : v i < ((k i : ℝ) + 1) * P :=
      (div_lt_iff₀ hPr).mp (Int.lt_floor_add_one (v i / P))
    dsimp [a, m]
    push_cast
    constructor <;> nlinarith only [hlo, hhi]
  · intro i j
    refine ⟨k i * Z i j, ?_⟩
    simp only [Int.cast_mul, hZ]
    dsimp [m]
    push_cast
    ring
noncomputable def integerHorizontalQuadraticChart {d : ℕ} (A : QuadraticChartData d)
    (m : Fin d → ℤ) (a : Fin d → ℝ) : QuadraticChartData d :=
  { A with
    horizontal := a
    quadratic := A.quadratic + chartMatrixPhase A.matrix (fun i => (m i : ℝ)) a }
theorem integerHorizontalQuadraticChart_phased_summand {d : ℕ} (A : QuadraticChartData d)
    (m : Fin d → ℤ) (a : Fin d → ℝ)
    (hoff : ∀ i, A.horizontal i = (m i : ℝ) + a i)
    (hint : ∀ i j, ∃ z : ℤ, (z : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ))
    (n : ℤ) (k : Fin d → ℤ) :
    (Real.fourierChar ((integerHorizontalQuadraticChart A m a).quadratic * (n : ℝ) ^ 2 +
      (integerHorizontalQuadraticChart A m a).linear * n) : ℂ) *
      quadraticChartLatticeSummand (integerHorizontalQuadraticChart A m a) (n : ℝ) k =
    (Real.fourierChar (A.quadratic * (n : ℝ) ^ 2 + A.linear * n) : ℂ) *
      quadraticChartLatticeSummand A (n : ℝ) (k + fun i => m i * n) := by
  let w : Fin d → ℝ := (n : ℝ) • a - (fun i => (k i : ℝ))
  have hz : chartHorizontalPosition A (n : ℝ) =
      (n : ℝ) • a + (n : ℝ) • (fun i => (m i : ℝ)) := by
    funext i
    dsimp [chartHorizontalPosition]
    rw [hoff i]
    ring
  have hw : chartLatticeRemainder A (n : ℝ) (k + fun i => m i * n) = w := by
    funext i
    dsimp [chartLatticeRemainder, w]
    rw [hoff i]
    push_cast
    ring
  have hz' : chartHorizontalPosition (integerHorizontalQuadraticChart A m a) (n : ℝ) =
      (n : ℝ) • a := by
    funext i
    dsimp [chartHorizontalPosition, integerHorizontalQuadraticChart]
    ring
  have hw' : chartLatticeRemainder (integerHorizontalQuadraticChart A m a) (n : ℝ) k = w := by
    funext i
    dsimp [chartLatticeRemainder, integerHorizontalQuadraticChart, w]
    ring
  obtain ⟨r, hr⟩ := chartMatrixPhase_integer_of_coefficients A.matrix m k hint
  have hp : A.quadratic * (n : ℝ) ^ 2 + A.linear * n +
      chartMatrixPhase A.matrix ((n : ℝ) • a + (n : ℝ) • (fun i => (m i : ℝ))) w +
        ((n * r : ℤ) : ℝ) =
      (A.quadratic + chartMatrixPhase A.matrix (fun i => (m i : ℝ)) a) * (n : ℝ) ^ 2 +
        A.linear * n + chartMatrixPhase A.matrix ((n : ℝ) • a) w := by
    dsimp [w]
    simp only [chartMatrixPhase_add_left, chartMatrixPhase_smul_left,
      chartMatrixPhase_sub_right, chartMatrixPhase_smul_right]
    rw [← hr]
    push_cast
    ring
  have he : (Real.fourierChar
      ((A.quadratic + chartMatrixPhase A.matrix (fun i => (m i : ℝ)) a) * (n : ℝ) ^ 2 +
        A.linear * n + chartMatrixPhase A.matrix ((n : ℝ) • a) w) : ℂ) =
      Real.fourierChar (A.quadratic * (n : ℝ) ^ 2 + A.linear * n +
        chartMatrixPhase A.matrix ((n : ℝ) • a + (n : ℝ) • (fun i => (m i : ℝ))) w) := by
    rw [← hp, chart_fourierChar_add_int]
  unfold quadraticChartLatticeSummand
  rw [hz, hw, hz', hw']
  change (Real.fourierChar _ : ℂ) * (A.amplitude w *
      (Real.fourierChar (chartMatrixPhase A.matrix ((n : ℝ) • a) w) : ℂ)) =
    (Real.fourierChar _ : ℂ) * (A.amplitude w *
      (Real.fourierChar
        (chartMatrixPhase A.matrix ((n : ℝ) • a + (n : ℝ) • (fun i => (m i : ℝ))) w) : ℂ))
  dsimp only [integerHorizontalQuadraticChart]
  simp only [AddChar.map_add_eq_mul, Circle.coe_mul] at he ⊢
  linear_combination A.amplitude w * he
theorem integerHorizontalQuadraticChart_atom_int {d : ℕ} (A : QuadraticChartData d)
    (m : Fin d → ℤ) (a : Fin d → ℝ)
    (hoff : ∀ i, A.horizontal i = (m i : ℝ) + a i)
    (hint : ∀ i j, ∃ z : ℤ, (z : ℝ) = (m i : ℝ) * (A.matrix i j : ℝ)) (n : ℤ) :
    quadraticChartAtom (integerHorizontalQuadraticChart A m a) (n : ℝ) =
      quadraticChartAtom A (n : ℝ) := by
  unfold quadraticChartAtom
  have hs : (∑' k, quadraticChartLatticeSummand A (n : ℝ) k) =
      ∑' k, quadraticChartLatticeSummand A (n : ℝ) (k + fun i => m i * n) :=
    ((Equiv.addRight (fun i => m i * n)).tsum_eq _).symm
  rw [hs, ← tsum_mul_left, ← tsum_mul_left]
  exact tsum_congr (fun k => integerHorizontalQuadraticChart_phased_summand A m a hoff hint n k)
theorem integerHorizontalQuadraticChart_complexity {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A)
    (m : Fin d → ℤ) (a : Fin d → ℝ) :
    QuadraticChartComplexity c₀ H (integerHorizontalQuadraticChart A m a) :=
  ⟨hA.lower, hA.dimension, hA.height, hA.support, hA.derivative⟩
/-- Blueprint `lem:inverse`, line 1197: reduce all unrestricted real parameters
at integer samples, without changing the rational matrix, cutoff, or complexity.
The reduced chart need only retain the original atom's integer values. -/
theorem quadraticChart_reduce_integer_parameters {d c₀ : ℕ} {H : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) :
    ∃ (P : ℕ) (B : QuadraticChartData d),
      0 < P ∧ (P : ℝ) ≤ H ^ (d ^ 2) ∧ QuadraticChartComplexity c₀ H B ∧
      B.quadratic ∈ Set.Ico (0 : ℝ) 1 ∧ B.linear ∈ Set.Ico (0 : ℝ) 1 ∧
      (∀ i, B.horizontal i ∈ Set.Ico (0 : ℝ) P) ∧
      B.matrix = A.matrix ∧ B.amplitude = A.amplitude ∧
      ∀ n : ℤ, quadraticChartAtom B (n : ℝ) = quadraticChartAtom A (n : ℝ) := by
  obtain ⟨P, m, a, hP, hPH, hoff, ha, hint⟩ :=
    chart_horizontal_integer_reduction (quadraticChartComplexity_parameter_pos hA).le
      A.matrix hA.height A.horizontal
  let B := fractionalPhaseQuadraticChart (integerHorizontalQuadraticChart A m a)
  refine ⟨P, B, hP, hPH,
    fractionalPhaseQuadraticChart_complexity (integerHorizontalQuadraticChart_complexity hA m a),
    ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩,
    ⟨Int.fract_nonneg _, Int.fract_lt_one _⟩, ha, rfl, rfl, ?_⟩
  intro n
  exact (fractionalPhaseQuadraticChart_atom_int _ n).trans
    (integerHorizontalQuadraticChart_atom_int A m a hoff hint n)

noncomputable def floorChartAlpha {d : ℕ} (A : QuadraticChartData d) : ℝ :=
  2 * A.quadratic + chartMatrixPhase A.matrix A.horizontal A.horizontal
def floorChartTailMatrix : Matrix (Fin 2) (Fin 2) ℚ :=
  fun i j => if i = 1 ∧ j = 0 then -1 else 0
noncomputable def floorChartAmplitude {d : ℕ} (A : QuadraticChartData d)
    (η ρ : ℝ → ℂ) (z : Fin (d + 2) → ℝ) : ℂ :=
  let w := fun i : Fin d => z (Fin.castAdd 2 i)
  let h := z (Fin.natAdd d (0 : Fin 2))
  let r := z (Fin.natAdd d (1 : Fin 2))
  A.amplitude (fun i => w i - A.horizontal i * h) * η h * ρ r *
    (Real.fourierChar (-h * chartMatrixPhase A.matrix A.horizontal w +
      (A.quadratic + chartMatrixPhase A.matrix A.horizontal A.horizontal) * h ^ 2 -
        A.linear * h) : ℂ)
theorem floorChartAmplitude_smooth {d : ℕ} (A : QuadraticChartData d)
    (η ρ : ℝ → ℂ) (hη : ContDiff ℝ (⊤ : ℕ∞) η) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ) :
    ContDiff ℝ (⊤ : ℕ∞) (floorChartAmplitude A η ρ) := by
  unfold floorChartAmplitude
  apply ContDiff.mul
  · apply ContDiff.mul
    · apply ContDiff.mul
      · apply A.smooth.comp
        apply contDiff_pi.mpr
        intro i
        fun_prop
      · exact hη.comp (contDiff_apply ℝ ℝ (Fin.natAdd d (0 : Fin 2)))
    · exact hρ.comp (contDiff_apply ℝ ℝ (Fin.natAdd d (1 : Fin 2)))
  · apply chart_fourierChar_smooth.comp
    unfold chartMatrixPhase
    fun_prop
theorem floorChartAmplitude_compact {d : ℕ} (A : QuadraticChartData d)
    (η ρ : ℝ → ℂ)
    (hη : ∀ x, η x ≠ 0 → x ∈ Set.Ioo (0 : ℝ) 1)
    (hρ : ∀ x, ρ x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1) :
    HasCompactSupport (floorChartAmplitude A η ρ) := by
  obtain ⟨H, hH, hA⟩ := quadraticChartData_support_bound A
  apply HasCompactSupport.of_support_subset_isCompact
    (isCompact_closedBall 0 (H + ‖A.horizontal‖ + 1))
  intro z hz
  change floorChartAmplitude A η ρ z ≠ 0 at hz
  simp only [floorChartAmplitude, mul_ne_zero_iff] at hz
  rcases hz with ⟨⟨⟨ha, hh⟩, hr⟩, _⟩
  have hh' := hη _ hh
  have hr' := hρ _ hr
  have hhabs : |z (Fin.natAdd d (0 : Fin 2))| ≤ 1 := by
    rw [abs_le]
    constructor <;> linarith [hh'.1, hh'.2]
  have hrabs : |z (Fin.natAdd d (1 : Fin 2))| ≤ 1 :=
    (abs_lt.mpr hr').le
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg (by positivity : 0 ≤ H + ‖A.horizontal‖ + 1)).mpr
  intro i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · have hu : |A.horizontal j| ≤ ‖A.horizontal‖ := by
      simpa only [Real.norm_eq_abs] using norm_le_pi_norm A.horizontal j
    calc
      ‖z (Fin.castAdd 2 j)‖ =
          |(z (Fin.castAdd 2 j) - A.horizontal j * z (Fin.natAdd d (0 : Fin 2))) +
            A.horizontal j * z (Fin.natAdd d (0 : Fin 2))| := by
        rw [Real.norm_eq_abs]
        congr 1
        ring
      _ ≤ |z (Fin.castAdd 2 j) - A.horizontal j * z (Fin.natAdd d (0 : Fin 2))| +
          |A.horizontal j| * |z (Fin.natAdd d (0 : Fin 2))| := by
        simpa only [abs_mul] using abs_add_le
          (z (Fin.castAdd 2 j) - A.horizontal j * z (Fin.natAdd d (0 : Fin 2)))
          (A.horizontal j * z (Fin.natAdd d (0 : Fin 2)))
      _ ≤ H + ‖A.horizontal‖ * 1 :=
        add_le_add (hA _ ha j) (mul_le_mul hu hhabs (abs_nonneg _) (norm_nonneg _))
      _ ≤ _ := by linarith
  · fin_cases j
    · change |z (Fin.natAdd d (0 : Fin 2))| ≤ _
      linarith only [hhabs, hH, norm_nonneg A.horizontal]
    · change |z (Fin.natAdd d (1 : Fin 2))| ≤ _
      linarith only [hrabs, hH, norm_nonneg A.horizontal]
noncomputable def floorInterpolatedChart {d : ℕ} (A : QuadraticChartData d)
    (η ρ : ℝ → ℂ) (hηsm : ContDiff ℝ (⊤ : ℕ∞) η) (hρsm : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hη : ∀ x, η x ≠ 0 → x ∈ Set.Ioo (0 : ℝ) 1)
    (hρ : ∀ x, ρ x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1) : QuadraticChartData (d + 2) where
  horizontal := Fin.append A.horizontal ![1, floorChartAlpha A]
  quadratic := A.quadratic
  linear := A.linear
  matrix := chartBlockMatrix A.matrix floorChartTailMatrix
  amplitude := floorChartAmplitude A η ρ
  smooth := floorChartAmplitude_smooth A η ρ hηsm hρsm
  compact := floorChartAmplitude_compact A η ρ hη hρ

theorem floorChartTailMatrix_phase (z w : Fin 2 → ℝ) :
    chartMatrixPhase floorChartTailMatrix z w = -z 1 * w 0 := by
  simp [chartMatrixPhase, floorChartTailMatrix, Fin.sum_univ_two]
theorem floorInterpolatedChart_phased_summand {d : ℕ} (A : QuadraticChartData d)
    (η ρ : ℝ → ℂ) (hηsm : ContDiff ℝ (⊤ : ℕ∞) η) (hρsm : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hη : ∀ x, η x ≠ 0 → x ∈ Set.Ioo (0 : ℝ) 1)
    (hρ : ∀ x, ρ x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1)
    (v : ℝ) (n : Fin d → ℤ) (m k : ℤ) :
    (Real.fourierChar (A.quadratic * v ^ 2 + A.linear * v) : ℂ) *
      quadraticChartLatticeSummand (floorInterpolatedChart A η ρ hηsm hρsm hη hρ)
        v (Fin.append n ![m, k]) =
    η (v - m) * ρ (floorChartAlpha A * v - k) *
      ((Real.fourierChar (A.quadratic * (m : ℝ) ^ 2 + A.linear * m) : ℂ) *
        quadraticChartLatticeSummand A (m : ℝ) n) := by
  let B := floorInterpolatedChart A η ρ hηsm hρsm hη hρ
  have hw : (fun i : Fin d =>
      chartLatticeRemainder B v (Fin.append n ![m, k]) (Fin.castAdd 2 i)) =
      v • A.horizontal - (fun i => (n i : ℝ)) := by
    funext i
    simp [B, chartLatticeRemainder, floorInterpolatedChart, mul_comm]
  have hz : (fun i : Fin d => chartHorizontalPosition B v (Fin.castAdd 2 i)) =
      v • A.horizontal := by
    funext i
    simp [B, chartHorizontalPosition, floorInterpolatedChart, mul_comm]
  have hshear : (fun i : Fin d =>
      (v • A.horizontal - (fun i => (n i : ℝ))) i - A.horizontal i * (v - m)) =
      chartLatticeRemainder A (m : ℝ) n := by
    funext i
    dsimp [chartLatticeRemainder]
    ring
  have hp : A.quadratic * v ^ 2 + A.linear * v +
      (chartMatrixPhase A.matrix (v • A.horizontal)
        (v • A.horizontal - (fun i => (n i : ℝ))) -
          floorChartAlpha A * v * (v - m)) +
      (-(v - m) * chartMatrixPhase A.matrix A.horizontal
        (v • A.horizontal - (fun i => (n i : ℝ))) +
        (A.quadratic + chartMatrixPhase A.matrix A.horizontal A.horizontal) * (v - m) ^ 2 -
        A.linear * (v - m)) =
      A.quadratic * (m : ℝ) ^ 2 + A.linear * m +
        chartMatrixPhase A.matrix ((m : ℝ) • A.horizontal)
          ((m : ℝ) • A.horizontal - (fun i => (n i : ℝ))) := by
    simp only [floorChartAlpha, chartMatrixPhase_smul_left,
      chartMatrixPhase_sub_right, chartMatrixPhase_smul_right]
    ring
  have he := congrArg (fun t => (Real.fourierChar t : ℂ)) hp
  unfold quadraticChartLatticeSummand
  change _ * (floorChartAmplitude A η ρ _ *
    (Real.fourierChar (chartMatrixPhase (chartBlockMatrix A.matrix floorChartTailMatrix)
      (chartHorizontalPosition B v) (chartLatticeRemainder B v (Fin.append n ![m, k]))) : ℂ)) = _
  rw [chartMatrixPhase_block, hw, hz, floorChartTailMatrix_phase]
  simp only [floorChartAmplitude]
  simp only [B, chartLatticeRemainder, chartHorizontalPosition, floorInterpolatedChart,
    Fin.append_left, Fin.append_right, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_fin_one, one_mul]
  have hs : (fun i => A.horizontal i * v - (n i : ℝ) - A.horizontal i * (v - (m : ℝ))) =
      (fun i => A.horizontal i * (m : ℝ) - (n i : ℝ)) := by
    funext i
    ring
  rw [hs]
  simp only [AddChar.map_add_eq_mul, Circle.coe_mul] at he
  simp only [chartMatrixPhase_smul_left, chartMatrixPhase_sub_right,
    chartMatrixPhase_smul_right] at he
  -- Normalize the remaining phase vectors without expanding their finite sums.
  have hmz : (fun i => A.horizontal i * (m : ℝ)) = (m : ℝ) • A.horizontal := by
    funext i; simp [mul_comm]
  have hmw : (fun i => A.horizontal i * (m : ℝ) - (n i : ℝ)) =
      (m : ℝ) • A.horizontal - (fun i => (n i : ℝ)) := by
    funext i; simp [mul_comm]
  have hvw : (fun i => A.horizontal i * v - (n i : ℝ)) =
      v • A.horizontal - (fun i => (n i : ℝ)) := by
    funext i; simp [mul_comm]
  change (Real.fourierChar (A.quadratic * v ^ 2 + A.linear * v) : ℂ) *
    ((A.amplitude (fun i => A.horizontal i * (m : ℝ) - (n i : ℝ)) *
      η (v - m) * ρ (floorChartAlpha A * v - k) *
      (Real.fourierChar (-(v - m) * chartMatrixPhase A.matrix A.horizontal
        (fun i => A.horizontal i * v - (n i : ℝ)) +
        (A.quadratic + chartMatrixPhase A.matrix A.horizontal A.horizontal) * (v - m) ^ 2 -
        A.linear * (v - m)) : ℂ)) *
      (Real.fourierChar (chartMatrixPhase A.matrix (v • A.horizontal)
        (v • A.horizontal - (fun i => (n i : ℝ))) +
        -(floorChartAlpha A * v) * (v - m)) : ℂ)) =
    η (v - m) * ρ (floorChartAlpha A * v - k) *
      ((Real.fourierChar (A.quadratic * (m : ℝ) ^ 2 + A.linear * m) : ℂ) *
        (A.amplitude (fun i => A.horizontal i * (m : ℝ) - (n i : ℝ)) *
          (Real.fourierChar (chartMatrixPhase A.matrix
            (fun i => A.horizontal i * (m : ℝ))
            (fun i => A.horizontal i * (m : ℝ) - (n i : ℝ))) : ℂ)))
  rw [hmz, hmw, hvw]
  simp only [neg_mul, ← sub_eq_add_neg, AddChar.map_add_eq_mul, Circle.coe_mul]
  simp only [chartMatrixPhase_smul_left, chartMatrixPhase_sub_right,
    chartMatrixPhase_smul_right]
  simp only [neg_mul] at he
  linear_combination
    (A.amplitude ((m : ℝ) • A.horizontal - (fun i => (n i : ℝ))) *
      η (v - m) * ρ (floorChartAlpha A * v - k)) * he

theorem floorInterpolatedChart_atom {d : ℕ} (A : QuadraticChartData d)
    (η ρ : ℝ → ℂ) (hηsm : ContDiff ℝ (⊤ : ℕ∞) η) (hρsm : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hη : ∀ x, η x ≠ 0 → x ∈ Set.Ioo (0 : ℝ) 1)
    (hρ : ∀ x, ρ x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1)
    (hpartition : ∀ r : ℝ, ∑' k : ℤ, ρ (r - k) = 1) (v : ℝ) :
    quadraticChartAtom (floorInterpolatedChart A η ρ hηsm hρsm hη hρ) v =
      η (Int.fract v) * quadraticChartAtom A (⌊v⌋ : ℝ) := by
  let B := floorInterpolatedChart A η ρ hηsm hρsm hη hρ
  let E : ((Fin d → ℤ) × (ℤ × ℤ)) ≃ (Fin (d + 2) → ℤ) :=
    (Equiv.prodCongr (Equiv.refl _) (finTwoArrowEquiv ℤ).symm).trans (Fin.appendEquiv d 2)
  let F : (Fin (d + 2) → ℤ) → ℂ := fun l =>
    (Real.fourierChar (A.quadratic * v ^ 2 + A.linear * v) : ℂ) *
      quadraticChartLatticeSummand B v l
  have hF : Summable F := (quadraticChartLatticeSummand_summable B v).mul_left _
  have hFE : Summable (fun p => F (E p)) := hF.comp_injective E.injective
  have hs : quadraticChartAtom B v =
      ∑' n : Fin d → ℤ, ∑' m : ℤ, ∑' k : ℤ, F (E (n, (m, k))) := by
    change _ * ∑' l, quadraticChartLatticeSummand B v l = _
    rw [← tsum_mul_left]
    change (∑' l, F l) = _
    rw [← E.tsum_eq F, hFE.tsum_prod]
    exact tsum_congr (fun n => (hFE.prod_factor n).tsum_prod)
  change quadraticChartAtom B v = _
  rw [hs]
  have hterm (n : Fin d → ℤ) (m k : ℤ) :
      F (E (n, (m, k))) = η (v - m) * ρ (floorChartAlpha A * v - k) *
        ((Real.fourierChar (A.quadratic * (m : ℝ) ^ 2 + A.linear * m) : ℂ) *
          quadraticChartLatticeSummand A (m : ℝ) n) :=
    floorInterpolatedChart_phased_summand A η ρ hηsm hρsm hη hρ v n m k
  have hsum (n : Fin d → ℤ) (m : ℤ) :
      (∑' k : ℤ, F (E (n, (m, k)))) =
        η (v - m) * ((Real.fourierChar (A.quadratic * (m : ℝ) ^ 2 + A.linear * m) : ℂ) *
          quadraticChartLatticeSummand A (m : ℝ) n) := by
    simp_rw [hterm]
    rw [tsum_mul_right, tsum_mul_left, hpartition, mul_one]
  simp_rw [hsum]
  have hsingle (n : Fin d → ℤ) :
      (∑' m : ℤ, η (v - m) *
        ((Real.fourierChar (A.quadratic * (m : ℝ) ^ 2 + A.linear * m) : ℂ) *
          quadraticChartLatticeSummand A (m : ℝ) n)) =
      η (v - (⌊v⌋ : ℝ)) *
        ((Real.fourierChar (A.quadratic * (⌊v⌋ : ℝ) ^ 2 + A.linear * (⌊v⌋ : ℝ)) : ℂ) *
          quadraticChartLatticeSummand A (⌊v⌋ : ℝ) n) := by
    apply tsum_eq_single ⌊v⌋
    intro m hm
    have hzero : η (v - (m : ℝ)) = 0 := by
      by_contra hn
      have hx := hη _ hn
      have heq : ⌊v⌋ = m := Int.floor_eq_iff.mpr ⟨by linarith [hx.1], by linarith [hx.2]⟩
      exact hm heq.symm
    rw [hzero, zero_mul]
  simp_rw [hsingle]
  rw [tsum_mul_left, tsum_mul_left]
  rfl
theorem floorInterpolatedChart_bounded {d : ℕ} (A : QuadraticChartData d)
    (η ρ : ℝ → ℂ) (hηsm : ContDiff ℝ (⊤ : ℕ∞) η) (hρsm : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hη : ∀ x, η x ≠ 0 → x ∈ Set.Ioo (0 : ℝ) 1)
    (hρ : ∀ x, ρ x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1)
    (hpartition : ∀ r : ℝ, ∑' k : ℤ, ρ (r - k) = 1)
    (hηbound : ∀ x, ‖η x‖ ≤ 1)
    (hA : ∀ n : ℤ, ‖quadraticChartAtom A (n : ℝ)‖ ≤ 1) :
    IsBoundedQuadraticChart (floorInterpolatedChart A η ρ hηsm hρsm hη hρ) := by
  intro v
  rw [floorInterpolatedChart_atom A η ρ hηsm hρsm hη hρ hpartition, norm_mul]
  calc
    _ ≤ 1 * 1 := mul_le_mul (hηbound _) (hA _) (norm_nonneg _) zero_le_one
    _ = 1 := one_mul 1

theorem derivative_product_with_prefactors {E F : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedCommRing F] [NormedAlgebra ℝ F]
    {f g : E → F} (hf : ContDiff ℝ (⊤ : ℕ∞) f) (hg : ContDiff ℝ (⊤ : ℕ∞) g)
    (z : E) {m : ℕ} {M N R T : ℝ} (hM : 0 ≤ M) (_hN : 0 ≤ N)
    (hR : 0 ≤ R) (_hT : 0 ≤ T)
    (hfi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i f z‖ ≤ M * R ^ i)
    (hgi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i g z‖ ≤ N * T ^ i) :
    ‖iteratedFDeriv ℝ m (fun y => f y * g y) z‖ ≤ M * N * (R + T) ^ m := by
  apply (norm_iteratedFDeriv_mul_le hf hg z (by simp)).trans
  calc
    _ ≤ ∑ i ∈ Finset.range (m + 1),
        M * N * ((m.choose i : ℝ) * R ^ i * T ^ (m - i)) := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ m := by simpa only [Finset.mem_range, Nat.lt_succ_iff] using hi
      calc
        _ ≤ (m.choose i : ℝ) * (M * R ^ i) * (N * T ^ (m - i)) := by
          gcongr
          · exact hfi i hi'
          · exact hgi (m - i) (Nat.sub_le _ _)
        _ = _ := by ring
    _ = _ := by
      rw [← Finset.mul_sum, add_pow]
      congr 1
      apply Finset.sum_congr rfl
      intro i _
      ring
theorem linear_derivative_norm_bound {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (L : E →L[ℝ] ℝ) {T : ℝ} (hT : 1 ≤ T) (hL : ‖L‖ ≤ T)
    (z : E) (hz : ‖z‖ ≤ T) (m : ℕ) :
    ‖iteratedFDeriv ℝ m L z‖ ≤ T ^ 2 := by
  have h0 : 0 ≤ T := by linarith
  change ‖iteratedFDeriv ℝ m ((id : ℝ → ℝ) ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right (contDiff_id : ContDiff ℝ (⊤ : ℕ∞) id) z (by simp)]
  apply (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_id]
  by_cases hm0 : m = 0
  · subst m
    simp only [↓reduceIte, Real.norm_eq_abs, Fin.prod_univ_zero, mul_one]
    exact (L.le_opNorm z).trans (by nlinarith [mul_le_mul hL hz (norm_nonneg z) h0])
  · by_cases hm1 : m = 1
    · subst m
      norm_num
      exact hL.trans (by nlinarith)
    · simp [hm0, hm1, sq_nonneg]
theorem linear_product_derivative_bound {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (L K : E →L[ℝ] ℝ) {T : ℝ} (hT : 1 ≤ T) (hL : ‖L‖ ≤ T) (hK : ‖K‖ ≤ T)
    (z : E) (hz : ‖z‖ ≤ T) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (fun y => L y * K y) z‖ ≤ T ^ 4 * 2 ^ m := by
  have h := derivative_product_with_prefactors (m := m) L.contDiff K.contDiff z
    (sq_nonneg T) (sq_nonneg T) (by norm_num : (0 : ℝ) ≤ 1) (by norm_num : (0 : ℝ) ≤ 1)
    (fun i _ => by simpa using linear_derivative_norm_bound L hT hL z hz i)
    (fun i _ => by simpa using linear_derivative_norm_bound K hT hK z hz i)
  convert h using 1
  ring
theorem quadratic_linear_phase_derivative_geometric {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (L K J : E →L[ℝ] ℝ) {T : ℝ} (hT : 1 ≤ T)
    (hL : ‖L‖ ≤ T) (hK : ‖K‖ ≤ T) (hJ : ‖J‖ ≤ T)
    (z : E) (hz : ‖z‖ ≤ T) (m i : ℕ) (hi : i ≤ m) :
    ‖iteratedFDeriv ℝ i (fun y => (Real.fourierChar (L y * K y + J y) : ℂ)) z‖ ≤
      (8 * Real.pi * T ^ 4 * (m + 1 : ℝ)) ^ i := by
  let Q : E → ℝ := fun y => L y * K y + J y
  have hQ : ContDiff ℝ (⊤ : ℕ∞) Q := (L.contDiff.mul K.contDiff).add J.contDiff
  have hT0 : 0 ≤ T := by linarith
  have hT4 : 1 ≤ T ^ 4 := one_le_pow₀ hT
  have hT24 : T ^ 2 ≤ T ^ 4 := pow_le_pow_right₀ hT (by omega)
  have hinner (j : ℕ) (hj : 1 ≤ j) (_hji : j ≤ i) :
      ‖iteratedFDeriv ℝ j Q z‖ ≤ (4 * T ^ 4) ^ j := by
    dsimp only [Q]
    change ‖iteratedFDeriv ℝ j ((fun y => L y * K y) + (J : E → ℝ)) z‖ ≤ _
    rw [iteratedFDeriv_add_apply (L.contDiff.mul K.contDiff).contDiffAt J.contDiff.contDiffAt]
    calc
      _ ≤ ‖iteratedFDeriv ℝ j (fun y => L y * K y) z‖ +
          ‖iteratedFDeriv ℝ j J z‖ := norm_add_le _ _
      _ ≤ T ^ 4 * 2 ^ j + T ^ 2 :=
        add_le_add (linear_product_derivative_bound L K hT hL hK z hz j)
          (linear_derivative_norm_bound J hT hJ z hz j)
      _ ≤ (2 * T ^ 4) * 2 ^ j := by
        have hp : (1 : ℝ) ≤ 2 ^ j := one_le_pow₀ (by norm_num)
        nlinarith only [hT24, mul_le_mul_of_nonneg_left hp (pow_nonneg hT0 4)]
      _ ≤ (2 * T ^ 4) ^ j * 2 ^ j :=
        mul_le_mul_of_nonneg_right (le_self_pow₀ (by linarith) (by omega)) (by positivity)
      _ = _ := by rw [← mul_pow]; congr 1; ring
  have houter (j : ℕ) (hj : j ≤ i) :
      ‖iteratedFDeriv ℝ j (fun t : ℝ => (Real.fourierChar t : ℂ)) (Q z)‖ ≤
        (2 * Real.pi) ^ i := by
    rw [chart_fourierChar_derivative_norm]
    exact pow_le_pow_right₀ (by linarith [Real.pi_gt_three]) hj
  have h := norm_iteratedFDeriv_comp_le (n := i) chart_fourierChar_smooth hQ
    (by simp) z houter hinner
  have hf : (i.factorial : ℝ) ≤ (m + 1 : ℝ) ^ i :=
    (by exact_mod_cast Nat.factorial_le_pow i : (i.factorial : ℝ) ≤ (i : ℝ) ^ i).trans
      (pow_le_pow_left₀ (Nat.cast_nonneg i) (by exact_mod_cast Nat.le_succ_of_le hi) i)
  apply h.trans
  calc
    _ ≤ (m + 1 : ℝ) ^ i * (2 * Real.pi) ^ i * (4 * T ^ 4) ^ i := by gcongr
    _ = _ := by rw [← mul_pow, ← mul_pow]; congr 1; ring
theorem four_factor_derivative_geometric {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E]
    (f g h k : E → ℂ) (hf : ContDiff ℝ (⊤ : ℕ∞) f)
    (hg : ContDiff ℝ (⊤ : ℕ∞) g) (hh : ContDiff ℝ (⊤ : ℕ∞) h)
    (hk : ContDiff ℝ (⊤ : ℕ∞) k) (z : E) {m : ℕ} {R : ℝ} (hR : 0 ≤ R)
    (hfi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i f z‖ ≤ R ^ (i + 1))
    (hgi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i g z‖ ≤ R ^ (i + 1))
    (hhi : ∀ i ≤ m, ‖iteratedFDeriv ℝ i h z‖ ≤ R ^ (i + 1))
    (hki : ∀ i ≤ m, ‖iteratedFDeriv ℝ i k z‖ ≤ R ^ (i + 1)) :
    ‖iteratedFDeriv ℝ m (fun y => f y * g y * h y * k y) z‖ ≤
      R ^ 4 * (4 * R) ^ m := by
  have hfg (i : ℕ) (hi : i ≤ m) :
      ‖iteratedFDeriv ℝ i (fun y => f y * g y) z‖ ≤ R ^ 2 * (2 * R) ^ i := by
    have hp := derivative_product_with_prefactors (m := i) hf hg z hR hR hR hR
      (fun j hj => by simpa [pow_succ, mul_comm] using hfi j (hj.trans hi))
      (fun j hj => by simpa [pow_succ, mul_comm] using hgi j (hj.trans hi))
    convert hp using 1
    all_goals ring
  have hhk (i : ℕ) (hi : i ≤ m) :
      ‖iteratedFDeriv ℝ i (fun y => h y * k y) z‖ ≤ R ^ 2 * (2 * R) ^ i := by
    have hp := derivative_product_with_prefactors (m := i) hh hk z hR hR hR hR
      (fun j hj => by simpa [pow_succ, mul_comm] using hhi j (hj.trans hi))
      (fun j hj => by simpa [pow_succ, mul_comm] using hki j (hj.trans hi))
    convert hp using 1
    all_goals ring
  have hp := derivative_product_with_prefactors (m := m) (hf.mul hg) (hh.mul hk) z
    (sq_nonneg R) (sq_nonneg R) (by positivity : 0 ≤ 2 * R) (by positivity : 0 ≤ 2 * R)
    hfg hhk
  have he : (fun y => f y * g y * h y * k y) =
      (fun y => (f y * g y) * (h y * k y)) := by funext y; ring
  rw [he]
  convert hp using 1
  ring

theorem four_factor_gevrey_budget {T : ℝ} (hT : 4 ≤ T) (a m : ℕ) (ha : 1 ≤ a) :
    (T ^ a * (m + 1 : ℝ) ^ a) ^ 4 * (4 * (T ^ a * (m + 1 : ℝ) ^ a)) ^ m ≤
      T ^ ((5 * a) * (m + 1)) * (m + 1 : ℝ) ^ ((5 * a) * (m + 1)) := by
  have hT1 : 1 ≤ T := by linarith
  have hm : (1 : ℝ) ≤ m + 1 := by have := Nat.cast_nonneg (α := ℝ) m; linarith
  calc
    _ ≤ (T ^ a * (m + 1 : ℝ) ^ a) ^ 4 * (T * (T ^ a * (m + 1 : ℝ) ^ a)) ^ m := by
      gcongr
    _ = T ^ (4 * a + (a + 1) * m) * (m + 1 : ℝ) ^ (4 * a + a * m) := by
      simp only [mul_pow, ← pow_mul]
      ring
    _ ≤ _ := by
      apply mul_le_mul
      · exact pow_le_pow_right₀ hT1 (by nlinarith)
      · exact pow_le_pow_right₀ hm (by nlinarith)
      · positivity
      · positivity

noncomputable def floorChartShear {d : ℕ} (A : QuadraticChartData d) :
    (Fin (d + 2) → ℝ) →L[ℝ] (Fin d → ℝ) :=
  ContinuousLinearMap.pi fun i =>
    ContinuousLinearMap.proj (Fin.castAdd 2 i) -
      A.horizontal i • ContinuousLinearMap.proj (Fin.natAdd d (0 : Fin 2))
theorem floorChartShear_apply {d : ℕ} (A : QuadraticChartData d) (z : Fin (d + 2) → ℝ) :
    floorChartShear A z =
      fun i => z (Fin.castAdd 2 i) - A.horizontal i * z (Fin.natAdd d (0 : Fin 2)) := rfl
theorem floorChartShear_norm_le {d : ℕ} (A : QuadraticChartData d) :
    ‖floorChartShear A‖ ≤ 1 + ‖A.horizontal‖ := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by positivity)
  intro z
  apply (pi_norm_le_iff_of_nonneg (by positivity : 0 ≤ (1 + ‖A.horizontal‖) * ‖z‖)).mpr
  intro i
  change ‖z (Fin.castAdd 2 i) - A.horizontal i * z (Fin.natAdd d (0 : Fin 2))‖ ≤ _
  calc
    _ ≤ ‖z (Fin.castAdd 2 i)‖ + ‖A.horizontal i * z (Fin.natAdd d (0 : Fin 2))‖ :=
      norm_sub_le _ _
    _ ≤ ‖z‖ + ‖A.horizontal‖ * ‖z‖ := by
      rw [norm_mul]
      exact add_le_add (norm_le_pi_norm z _) (mul_le_mul (norm_le_pi_norm A.horizontal _)
        (norm_le_pi_norm z _) (norm_nonneg _) (norm_nonneg _))
    _ = _ := by ring
theorem chart_cutoff_linear_geometric {d D c₀ : ℕ} {H T : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A)
    (hc : 1 ≤ c₀) (hHT : H ≤ T) (L : (Fin D → ℝ) →L[ℝ] (Fin d → ℝ))
    (hL : ‖L‖ ≤ T) (m i : ℕ) (hi : i ≤ m) (z : Fin D → ℝ) :
    ‖iteratedFDeriv ℝ i (A.amplitude ∘ L) z‖ ≤
      (T ^ (2 * c₀ + 1) * (m + 1 : ℝ) ^ c₀) ^ (i + 1) := by
  have hAT := quadraticChartComplexity_mono hA hHT
  have hT : 1 ≤ T := by linarith [hAT.lower, Real.add_one_le_exp (2 : ℝ)]
  rw [L.iteratedFDeriv_comp_right A.smooth z (by simp)]
  apply (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _).trans
  calc
    _ ≤ (T ^ (2 * c₀ * (i + 1)) * (i + 1 : ℝ) ^ (c₀ * (i + 1))) * T ^ i := by
      apply mul_le_mul (chart_cutoff_iteratedFDeriv_bound hAT hc i (L z))
      · simpa using Finset.prod_le_prod₀ (s := Finset.univ)
          (fun _ _ => norm_nonneg L) (fun (_ : Fin i) _ => hL)
      · positivity
      · positivity
    _ ≤ (T ^ (2 * c₀ * (i + 1)) * (m + 1 : ℝ) ^ (c₀ * (i + 1))) * T ^ (i + 1) := by
      gcongr
      omega
    _ = _ := by
      simp only [mul_pow, ← pow_mul]
      rw [mul_right_comm, ← pow_add]
      congr 1
      congr 1
      ring
noncomputable def floorChartPhaseLinear {d : ℕ} (A : QuadraticChartData d) :
    (Fin (d + 2) → ℝ) →L[ℝ] ℝ :=
  -(chartMatrixLeftLinear A.matrix A.horizontal).comp
      (chartCoordinateRestriction (Fin.castAdd 2)) +
    (A.quadratic + chartMatrixPhase A.matrix A.horizontal A.horizontal) •
      ContinuousLinearMap.proj (Fin.natAdd d (0 : Fin 2))
noncomputable def floorChartPhaseTail {d : ℕ} (A : QuadraticChartData d) :
    (Fin (d + 2) → ℝ) →L[ℝ] ℝ :=
  (-A.linear) • ContinuousLinearMap.proj (Fin.natAdd d (0 : Fin 2))
theorem floorChartPhase_eq {d : ℕ} (A : QuadraticChartData d) (z : Fin (d + 2) → ℝ) :
    z (Fin.natAdd d (0 : Fin 2)) * floorChartPhaseLinear A z + floorChartPhaseTail A z =
    -z (Fin.natAdd d (0 : Fin 2)) *
      chartMatrixPhase A.matrix A.horizontal (fun i => z (Fin.castAdd 2 i)) +
    (A.quadratic + chartMatrixPhase A.matrix A.horizontal A.horizontal) *
      z (Fin.natAdd d (0 : Fin 2)) ^ 2 - A.linear * z (Fin.natAdd d (0 : Fin 2)) := by
  have hw : chartCoordinateRestriction (Fin.castAdd 2 : Fin d → Fin (d + 2)) z =
      (fun i => z (Fin.castAdd 2 i)) := rfl
  simp only [floorChartPhaseLinear, floorChartPhaseTail, add_apply,
    neg_apply, ContinuousLinearMap.comp_apply, smul_apply,
    ContinuousLinearMap.proj_apply, smul_eq_mul, chartMatrixLeftLinear_apply,
    hw]
  ring
theorem floorChartAmplitude_derivative_local {d c₀ K : ℕ} {H T : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (hT : 32 ≤ T) (hHT : H ≤ T)
    (η ρ : ℝ → ℂ) (hη : ContDiff ℝ (⊤ : ℕ∞) η) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hηd : ∀ i x, ‖iteratedDeriv i η x‖ ≤ T ^ (K * (i + 1)) * (i + 1 : ℝ) ^ (K * (i + 1)))
    (hρd : ∀ i x, ‖iteratedDeriv i ρ x‖ ≤ T ^ (K * (i + 1)) * (i + 1 : ℝ) ^ (K * (i + 1)))
    (hS : ‖floorChartShear A‖ ≤ T) (hL : ‖floorChartPhaseLinear A‖ ≤ T)
    (hJ : ‖floorChartPhaseTail A‖ ≤ T)
    (z : Fin (d + 2) → ℝ) (hz : ‖z‖ ≤ T) (m : ℕ) :
    ‖iteratedFDeriv ℝ m (floorChartAmplitude A η ρ) z‖ ≤
      T ^ ((5 * (2 * c₀ + K + 6)) * (m + 1)) *
      (m + 1 : ℝ) ^ ((5 * (2 * c₀ + K + 6)) * (m + 1)) := by
  let a := 2 * c₀ + K + 6
  let R := T ^ a * (m + 1 : ℝ) ^ a
  let h : Fin (d + 2) := Fin.natAdd d (0 : Fin 2)
  let r : Fin (d + 2) := Fin.natAdd d (1 : Fin 2)
  let f := A.amplitude ∘ floorChartShear A
  let g := fun y : Fin (d + 2) → ℝ => η (y h)
  let b := fun y : Fin (d + 2) → ℝ => ρ (y r)
  let p := fun y : Fin (d + 2) → ℝ =>
    (Real.fourierChar (y h * floorChartPhaseLinear A y + floorChartPhaseTail A y) : ℂ)
  have hT1 : 1 ≤ T := by linarith
  have hm1 : (1 : ℝ) ≤ m + 1 := by have := Nat.cast_nonneg (α := ℝ) m; linarith
  have hR1 : 1 ≤ R := one_le_mul_of_one_le_of_one_le (one_le_pow₀ hT1) (one_le_pow₀ hm1)
  have hbase (u w : ℕ) (hu : u ≤ a) (hw : w ≤ a) :
      T ^ u * (m + 1 : ℝ) ^ w ≤ R :=
    mul_le_mul (pow_le_pow_right₀ hT1 hu) (pow_le_pow_right₀ hm1 hw)
      (by positivity) (by positivity)
  have hf : ContDiff ℝ (⊤ : ℕ∞) f := A.smooth.comp (floorChartShear A).contDiff
  have hg : ContDiff ℝ (⊤ : ℕ∞) g := hη.comp (contDiff_apply ℝ ℝ h)
  have hb : ContDiff ℝ (⊤ : ℕ∞) b := hρ.comp (contDiff_apply ℝ ℝ r)
  have hp : ContDiff ℝ (⊤ : ℕ∞) p :=
    chart_fourierChar_smooth.comp
      (((contDiff_apply ℝ ℝ h).mul (floorChartPhaseLinear A).contDiff).add
        (floorChartPhaseTail A).contDiff)
  have hfi (i : ℕ) (hi : i ≤ m) : ‖iteratedFDeriv ℝ i f z‖ ≤ R ^ (i + 1) :=
    (chart_cutoff_linear_geometric hA hc hHT (floorChartShear A) hS m i hi z).trans
      (pow_le_pow_left₀ (by positivity) (hbase _ _ (by dsimp [a]; omega) (by dsimp [a]; omega)) _)
  have hcut (q : ℝ → ℂ) (hq : ContDiff ℝ (⊤ : ℕ∞) q)
      (hd : ∀ i x, ‖iteratedDeriv i q x‖ ≤ T ^ (K * (i + 1)) * (i + 1 : ℝ) ^ (K * (i + 1)))
      (j : Fin (d + 2)) (i : ℕ) (hi : i ≤ m) :
      ‖iteratedFDeriv ℝ i (fun y : Fin (d + 2) → ℝ => q (y j)) z‖ ≤ R ^ (i + 1) := by
    apply (coordinate_composition_derivative_norm hq j z i).trans
    apply (hd i (z j)).trans
    calc
      _ ≤ T ^ (K * (i + 1)) * (m + 1 : ℝ) ^ (K * (i + 1)) := by gcongr
      _ = (T ^ K * (m + 1 : ℝ) ^ K) ^ (i + 1) := by rw [mul_pow, ← pow_mul, ← pow_mul]
      _ ≤ _ := pow_le_pow_left₀ (by positivity)
        (hbase K K (by dsimp [a]; omega) (by dsimp [a]; omega)) _
  have hproj : ‖(ContinuousLinearMap.proj h : (Fin (d + 2) → ℝ) →L[ℝ] ℝ)‖ ≤ T := by
    apply le_trans _ hT1
    apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
    intro y
    simpa only [ContinuousLinearMap.proj_apply, one_mul] using norm_le_pi_norm y h
  have hphasebase : 8 * Real.pi * T ^ 4 * (m + 1 : ℝ) ≤ R := by
    calc
      _ ≤ T * T ^ 4 * (m + 1 : ℝ) := by
        gcongr
        linarith [Real.pi_lt_four]
      _ = T ^ 5 * (m + 1 : ℝ) ^ 1 := by ring
      _ ≤ _ := hbase 5 1 (by dsimp [a]; omega) (by dsimp [a]; omega)
  have hpi (i : ℕ) (hi : i ≤ m) : ‖iteratedFDeriv ℝ i p z‖ ≤ R ^ (i + 1) := by
    have hbound := quadratic_linear_phase_derivative_geometric (E := Fin (d + 2) → ℝ) (T := T)
      (ContinuousLinearMap.proj h : (Fin (d + 2) → ℝ) →L[ℝ] ℝ)
      (floorChartPhaseLinear A) (floorChartPhaseTail A) hT1 hproj hL hJ z hz m i hi
    exact hbound.trans ((pow_le_pow_left₀ (by positivity) hphasebase i).trans
      (pow_le_pow_right₀ hR1 (by omega)))
  have he : floorChartAmplitude A η ρ = (fun y => f y * g y * b y * p y) := by
    funext y
    dsimp only [f, g, b, p, Function.comp_apply]
    rw [floorChartPhase_eq]
    rfl
  rw [he]
  exact (four_factor_derivative_geometric f g b p hf hg hb hp z (by linarith)
    hfi (hcut η hη hηd h) (hcut ρ hρ hρd r) hpi).trans
      (four_factor_gevrey_budget (by linarith) a m (by dsimp [a]; omega))
theorem floorChartAmplitude_support_subset {d : ℕ} (A : QuadraticChartData d)
    (η ρ : ℝ → ℂ) {H : ℝ} (hH : 0 < H)
    (hA : ∀ z, A.amplitude z ≠ 0 → ∀ i, |z i| ≤ H)
    (hη : ∀ x, η x ≠ 0 → x ∈ Set.Ioo (0 : ℝ) 1)
    (hρ : ∀ x, ρ x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1) :
    tsupport (floorChartAmplitude A η ρ) ⊆
      Metric.closedBall 0 (H + ‖A.horizontal‖ + 1) := by
  apply closure_minimal _ Metric.isClosed_closedBall
  intro z hz
  change floorChartAmplitude A η ρ z ≠ 0 at hz
  simp only [floorChartAmplitude, mul_ne_zero_iff] at hz
  rcases hz with ⟨⟨⟨ha, hh⟩, hr⟩, _⟩
  have hh' := hη _ hh
  have hr' := hρ _ hr
  have hhabs : |z (Fin.natAdd d (0 : Fin 2))| ≤ 1 := by
    rw [abs_le]
    constructor <;> linarith [hh'.1, hh'.2]
  have hrabs : |z (Fin.natAdd d (1 : Fin 2))| ≤ 1 :=
    (abs_lt.mpr hr').le
  rw [Metric.mem_closedBall, dist_zero_right]
  apply (pi_norm_le_iff_of_nonneg (by positivity : 0 ≤ H + ‖A.horizontal‖ + 1)).mpr
  intro i
  refine Fin.addCases (fun j => ?_) (fun j => ?_) i
  · have hu : |A.horizontal j| ≤ ‖A.horizontal‖ := by
      simpa only [Real.norm_eq_abs] using norm_le_pi_norm A.horizontal j
    calc
      ‖z (Fin.castAdd 2 j)‖ =
          |(z (Fin.castAdd 2 j) - A.horizontal j * z (Fin.natAdd d (0 : Fin 2))) +
            A.horizontal j * z (Fin.natAdd d (0 : Fin 2))| := by
        rw [Real.norm_eq_abs]
        congr 1
        ring
      _ ≤ |z (Fin.castAdd 2 j) - A.horizontal j * z (Fin.natAdd d (0 : Fin 2))| +
          |A.horizontal j| * |z (Fin.natAdd d (0 : Fin 2))| := by
        simpa only [abs_mul] using abs_add_le
          (z (Fin.castAdd 2 j) - A.horizontal j * z (Fin.natAdd d (0 : Fin 2)))
          (A.horizontal j * z (Fin.natAdd d (0 : Fin 2)))
      _ ≤ H + ‖A.horizontal‖ * 1 :=
        add_le_add (hA _ ha j) (mul_le_mul hu hhabs (abs_nonneg _) (norm_nonneg _))
      _ ≤ _ := by linarith
  · fin_cases j
    · change |z (Fin.natAdd d (0 : Fin 2))| ≤ _
      linarith only [hhabs, hH, norm_nonneg A.horizontal]
    · change |z (Fin.natAdd d (1 : Fin 2))| ≤ _
      linarith only [hrabs, hH, norm_nonneg A.horizontal]
theorem floorChartAmplitude_derivative_bound {d c₀ K : ℕ} {H T : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (hT : 32 ≤ T) (hHT : H ≤ T) (hsupp : H + ‖A.horizontal‖ + 1 ≤ T)
    (η ρ : ℝ → ℂ) (hη : ContDiff ℝ (⊤ : ℕ∞) η) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hηs : ∀ x, η x ≠ 0 → x ∈ Set.Ioo (0 : ℝ) 1)
    (hρs : ∀ x, ρ x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1)
    (hηd : ∀ i x, ‖iteratedDeriv i η x‖ ≤ T ^ (K * (i + 1)) * (i + 1 : ℝ) ^ (K * (i + 1)))
    (hρd : ∀ i x, ‖iteratedDeriv i ρ x‖ ≤ T ^ (K * (i + 1)) * (i + 1 : ℝ) ^ (K * (i + 1)))
    (hS : ‖floorChartShear A‖ ≤ T) (hL : ‖floorChartPhaseLinear A‖ ≤ T)
    (hJ : ‖floorChartPhaseTail A‖ ≤ T)
    (m : ℕ) (word : Fin m → Fin (d + 2)) (z : Fin (d + 2) → ℝ) :
    ‖coordinateWordDerivative m (floorChartAmplitude A η ρ) word z‖ ≤
      T ^ ((5 * (2 * c₀ + K + 6)) * (m + 1)) *
      (m + 1 : ℝ) ^ ((5 * (2 * c₀ + K + 6)) * (m + 1)) := by
  have hderiv : ‖iteratedFDeriv ℝ m (floorChartAmplitude A η ρ) z‖ ≤
      T ^ ((5 * (2 * c₀ + K + 6)) * (m + 1)) *
      (m + 1 : ℝ) ^ ((5 * (2 * c₀ + K + 6)) * (m + 1)) := by
    by_cases hz : z ∈ tsupport (floorChartAmplitude A η ρ)
    · have hb := floorChartAmplitude_support_subset A η ρ
        (quadraticChartComplexity_parameter_pos hA) hA.support hηs hρs hz
      rw [Metric.mem_closedBall, dist_zero_right] at hb
      exact floorChartAmplitude_derivative_local hA hc hT hHT η ρ hη hρ hηd hρd
        hS hL hJ z (hb.trans hsupp) m
    · have he : iteratedFDeriv ℝ m (floorChartAmplitude A η ρ) z = 0 := by
        by_contra hn
        exact hz (support_iteratedFDeriv_subset m hn)
      rw [he, norm_zero]
      positivity
  apply le_trans _ hderiv
  simpa [coordinateWordDerivative, Pi.norm_single] using
    (iteratedFDeriv ℝ m (floorChartAmplitude A η ρ) z).le_opNorm
      (fun i => Pi.single (word i) 1)

theorem chart_coordinate_projection_norm_le {D : ℕ} (i : Fin D) :
    ‖(ContinuousLinearMap.proj i : (Fin D → ℝ) →L[ℝ] ℝ)‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro z
  simpa only [ContinuousLinearMap.proj_apply, one_mul] using norm_le_pi_norm z i

theorem floorChartPhaseLinear_norm_le {d : ℕ} (A : QuadraticChartData d) :
    ‖floorChartPhaseLinear A‖ ≤ ‖chartMatrixLeftLinear A.matrix A.horizontal‖ +
      |A.quadratic + chartMatrixPhase A.matrix A.horizontal A.horizontal| := by
  unfold floorChartPhaseLinear
  apply (norm_add_le _ _).trans
  rw [norm_neg, norm_smul, Real.norm_eq_abs]
  apply add_le_add
  · apply (ContinuousLinearMap.opNorm_comp_le _ _).trans
    exact (mul_le_mul_of_nonneg_left (chartCoordinateRestriction_norm_le _)
      (norm_nonneg _)).trans_eq (mul_one _)
  · exact (mul_le_mul_of_nonneg_left (chart_coordinate_projection_norm_le _)
      (abs_nonneg _)).trans_eq (mul_one _)

theorem floorChartPhaseTail_norm_le {d : ℕ} (A : QuadraticChartData d) :
    ‖floorChartPhaseTail A‖ ≤ |A.linear| := by
  unfold floorChartPhaseTail
  rw [norm_smul, Real.norm_eq_abs, abs_neg]
  exact (mul_le_mul_of_nonneg_left (chart_coordinate_projection_norm_le _)
    (abs_nonneg _)).trans_eq (mul_one _)

theorem floor_chart_parameter_controls {d c₀ : ℕ} {H P : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A)
    (hP : 0 ≤ P) (hPH : P ≤ H ^ (d ^ 2)) (hθ : ∀ i, |A.horizontal i| ≤ P)
    (hlam : |A.quadratic| ≤ 1) (hβ : |A.linear| ≤ 1) :
    32 ≤ (chartTranslationBase d H) ^ 6 ∧ H ≤ (chartTranslationBase d H) ^ 6 ∧
    H + ‖A.horizontal‖ + 1 ≤ (chartTranslationBase d H) ^ 6 ∧
    ‖floorChartShear A‖ ≤ (chartTranslationBase d H) ^ 6 ∧
    ‖floorChartPhaseLinear A‖ ≤ (chartTranslationBase d H) ^ 6 ∧
    ‖floorChartPhaseTail A‖ ≤ (chartTranslationBase d H) ^ 6 := by
  let B := chartTranslationBase d H
  obtain ⟨hHB, hs, hp⟩ := chart_translation_base_controls hA hP hPH A.horizontal hθ
  have hH3 : 3 ≤ H := by linarith [hA.lower, Real.add_one_le_exp (2 : ℝ)]
  have hB3 : 3 ≤ B := hH3.trans hHB
  have hB1 : 1 ≤ B := by linarith
  have hB0 : 0 ≤ B := by linarith
  have hθP : ‖A.horizontal‖ ≤ P :=
    (pi_norm_le_iff_of_nonneg hP).mpr (fun i => by simpa only [Real.norm_eq_abs] using hθ i)
  have hθB : ‖A.horizontal‖ ≤ B := by linarith only [hθP, hs, hH3]
  have hLB : ‖chartMatrixLeftLinear A.matrix A.horizontal‖ ≤ B := by
    have hpi : 1 ≤ 2 * Real.pi := by linarith [Real.pi_gt_three]
    exact (le_mul_of_one_le_left (norm_nonneg _) hpi).trans hp
  have hphase : |chartMatrixPhase A.matrix A.horizontal A.horizontal| ≤ B ^ 2 := by
    rw [← chartMatrixLeftLinear_apply, ← Real.norm_eq_abs]
    exact ((chartMatrixLeftLinear A.matrix A.horizontal).le_opNorm A.horizontal).trans
      (by simpa only [pow_two] using mul_le_mul hLB hθB (norm_nonneg _) hB0)
  have hB6 : B ≤ B ^ 6 := le_self_pow₀ hB1 (by norm_num)
  refine ⟨?_, hHB.trans hB6, ?_, ?_, ?_, ?_⟩
  · have hx : (3 : ℝ) ^ 6 ≤ B ^ 6 := pow_le_pow_left₀ (by norm_num) hB3 6
    norm_num at hx
    linarith only [hx]
  · calc
      _ ≤ B + 1 := by linarith only [hθP, hs]
      _ ≤ B ^ 2 := by nlinarith only [hB3]
      _ ≤ _ := pow_le_pow_right₀ hB1 (by norm_num)
  · exact (floorChartShear_norm_le A).trans ((by linarith only [hθP, hs, hH3] :
      1 + ‖A.horizontal‖ ≤ B).trans hB6)
  · calc
      _ ≤ ‖chartMatrixLeftLinear A.matrix A.horizontal‖ +
          |A.quadratic + chartMatrixPhase A.matrix A.horizontal A.horizontal| :=
        floorChartPhaseLinear_norm_le A
      _ ≤ B + (1 + B ^ 2) :=
        add_le_add hLB ((abs_add_le _ _).trans (add_le_add hlam hphase))
      _ ≤ B ^ 3 := by
        nlinarith only [hB3, sq_nonneg B,
          mul_nonneg (sub_nonneg.mpr hB3) (sq_nonneg B)]
      _ ≤ _ := pow_le_pow_right₀ hB1 (by norm_num)
  · exact (floorChartPhaseTail_norm_le A).trans (hβ.trans (one_le_pow₀ hB1))
theorem floorInterpolatedChart_complexity {d c₀ K : ℕ} {H P T : ℝ}
    {A : QuadraticChartData d} (hA : QuadraticChartComplexity c₀ H A) (hc : 1 ≤ c₀)
    (hP : 0 ≤ P) (hPH : P ≤ H ^ (d ^ 2)) (hθ : ∀ i, |A.horizontal i| ≤ P)
    (hlam : |A.quadratic| ≤ 1) (hβ : |A.linear| ≤ 1)
    (hBT : (chartTranslationBase d H) ^ 6 ≤ T)
    (η ρ : ℝ → ℂ) (hη : ContDiff ℝ (⊤ : ℕ∞) η) (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ)
    (hηs : ∀ x, η x ≠ 0 → x ∈ Set.Ioo (0 : ℝ) 1)
    (hρs : ∀ x, ρ x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1)
    (hηd : ∀ i x, ‖iteratedDeriv i η x‖ ≤ T ^ (K * (i + 1)) * (i + 1 : ℝ) ^ (K * (i + 1)))
    (hρd : ∀ i x, ‖iteratedDeriv i ρ x‖ ≤ T ^ (K * (i + 1)) * (i + 1 : ℝ) ^ (K * (i + 1))) :
    QuadraticChartComplexity (5 * (2 * c₀ + K + 6)) T
      (floorInterpolatedChart A η ρ hη hρ hηs hρs) := by
  obtain ⟨h32, hH, hs, hS, hL, hJ⟩ :=
    floor_chart_parameter_controls hA hP hPH hθ hlam hβ
  have hHT := hH.trans hBT
  have hT1 : 1 ≤ T := by linarith [h32.trans hBT]
  have hz : (chartRationalHeight (0 : ℚ) : ℝ) ≤ T := by
    simpa [chartRationalHeight] using hT1
  have ht (i j : Fin 2) : (chartRationalHeight (floorChartTailMatrix i j) : ℝ) ≤ T := by
    unfold floorChartTailMatrix
    split_ifs <;> simpa [chartRationalHeight] using hT1
  constructor
  · exact hA.lower.trans hHT
  · have hlogH : 2 ≤ Real.log H := by
      have hh := Real.log_le_log (Real.exp_pos (2 : ℝ)) hA.lower
      simpa only [Real.log_exp] using hh
    have hlogB : Real.log H ≤ Real.log (chartTranslationBase d H) :=
      Real.log_le_log (quadraticChartComplexity_parameter_pos hA)
        (chart_translation_base_controls hA hP hPH A.horizontal hθ).1
    have hlogT := Real.log_le_log (by positivity :
      0 < (chartTranslationBase d H) ^ 6) hBT
    rw [Real.log_pow] at hlogT
    push_cast
    norm_num only [Nat.cast_ofNat] at hlogT
    linarith only [hA.dimension, hlogH, hlogB, hlogT]
  · intro i j
    refine Fin.addCases (fun i => ?_) (fun i => ?_) i
    · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
      · simpa [floorInterpolatedChart, chartBlockMatrix] using (hA.height i j).trans hHT
      · simpa [floorInterpolatedChart, chartBlockMatrix] using hz
    · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
      · simpa [floorInterpolatedChart, chartBlockMatrix] using hz
      · simpa [floorInterpolatedChart, chartBlockMatrix] using ht i j
  · intro z hz' i
    have hb := floorChartAmplitude_support_subset A η ρ
      (quadraticChartComplexity_parameter_pos hA) hA.support hηs hρs
      (subset_tsupport _ hz')
    rw [Metric.mem_closedBall, dist_zero_right] at hb
    exact (norm_le_pi_norm z i).trans (hb.trans (hs.trans hBT))
  · exact floorChartAmplitude_derivative_bound hA hc (h32.trans hBT) hHT (hs.trans hBT)
      η ρ hη hρ hηs hρs hηd hρd (hS.trans hBT) (hL.trans hBT) (hJ.trans hBT)

theorem complex_ofReal_iteratedDeriv_norm (f : ℝ → ℝ)
    (hf : ContDiff ℝ (⊤ : ℕ∞) f) (m : ℕ) (x : ℝ) :
    ‖iteratedDeriv m (fun y => (f y : ℂ)) x‖ = |iteratedDeriv m f x| := by
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  change ‖iteratedFDeriv ℝ m (Complex.ofRealLI ∘ f) x‖ = _
  rw [Complex.ofRealLI.norm_iteratedFDeriv_comp_left hf.contDiffAt (by simp),
    norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs]

theorem quadraticChart_uniform_floor_interpolation (c₀ : ℕ) (hc : 1 ≤ c₀) :
    ∃ (c₁ : ℕ) (B : ℝ), 1 ≤ c₁ ∧ 8 ≤ B ∧
      ∀ (d : ℕ) (H ε : ℝ) (A : QuadraticChartData d),
        QuadraticChartComplexity c₀ H A →
        (∃ P : ℝ, 0 ≤ P ∧ P ≤ H ^ (d ^ 2) ∧ ∀ i, |A.horizontal i| ≤ P) →
        |A.quadratic| ≤ 1 → |A.linear| ≤ 1 →
        (∀ n : ℤ, ‖quadraticChartAtom A (n : ℝ)‖ ≤ 1) →
        0 < ε → ε ≤ 1 / 2 →
        ∃ (η : ℝ → ℝ) (A' : QuadraticChartData (d + 2)),
          ContDiff ℝ (⊤ : ℕ∞) η ∧ (∀ x, η x ∈ Set.Icc (0 : ℝ) 1) ∧
          tsupport η ⊆ Set.Ioo (0 : ℝ) 1 ∧
          (∀ x ∈ Set.Icc ε (1 - ε), η x = 1) ∧
          QuadraticChartComplexity c₁ (chartTranslationBudget H * (B / ε)) A' ∧
          IsBoundedQuadraticChart A' ∧
          ∀ v : ℝ, quadraticChartAtom A' v =
            (η (Int.fract v) : ℂ) * quadraticChartAtom A (⌊v⌋ : ℝ) := by
  obtain ⟨B₀, hB₀, hcut⟩ := exists_uniform_gevrey_endpoint_cutoffs
  obtain ⟨ρ, hρsm, hρnonneg, hρc, hρs, hρpart, C, hC, hρd⟩ := existsGevreyPartition
  let K := max 20 C
  let B := B₀ + (C : ℝ)
  have hBB₀ : B₀ ≤ B := by dsimp [B]; linarith [Nat.cast_nonneg (α := ℝ) C]
  have hB8 : 8 ≤ B := hB₀.trans hBB₀
  have hCB : (C : ℝ) ≤ B := by dsimp [B]; linarith only [hB₀]
  refine ⟨5 * (2 * c₀ + K + 6), B, by omega, hB8, ?_⟩
  intro d H ε A hA hhor hlam hβ hAb hε hεh
  obtain ⟨P, hP, hPH, hθ⟩ := hhor
  obtain ⟨η, hηsm, hηunit, hηc, hηs, hηone, hηd⟩ := hcut ε hε hεh
  let T := chartTranslationBudget H * (B / ε)
  have hbase : (chartTranslationBase d H) ^ 6 ≤ chartTranslationBudget H :=
    chartTranslationBase_le_budget hA
  have hbase32 : 32 ≤ chartTranslationBudget H :=
    (floor_chart_parameter_controls hA hP hPH hθ hlam hβ).1.trans hbase
  have hε1 : ε ≤ 1 := by linarith only [hεh]
  have hBε : B ≤ B / ε :=
    (le_div_iff₀ hε).mpr (mul_le_of_le_one_right (by linarith only [hB8]) hε1)
  have hBε1 : 1 ≤ B / ε := by linarith only [hB8, hBε]
  have hbudget : chartTranslationBudget H ≤ T :=
    le_mul_of_one_le_right (by linarith only [hbase32]) hBε1
  have hεT : B / ε ≤ T :=
    le_mul_of_one_le_left (by linarith only [hBε1]) (by linarith only [hbase32])
  have hT1 : 1 ≤ T := by linarith only [hBε1, hεT]
  have hT0 : 0 ≤ T := by linarith only [hT1]
  have hB₀εT : B₀ / ε ≤ T :=
    ((div_le_div_iff_of_pos_right hε).mpr hBB₀).trans hεT
  have hCT : (C : ℝ) ≤ T := hCB.trans (hBε.trans hεT)
  let ηc : ℝ → ℂ := fun x => (η x : ℂ)
  let ρc : ℝ → ℂ := fun x => (ρ x : ℂ)
  have hηcsm : ContDiff ℝ (⊤ : ℕ∞) ηc := Complex.ofRealCLM.contDiff.comp hηsm
  have hρsm' : ContDiff ℝ (⊤ : ℕ∞) ρ := contDiff_infty.mpr hρsm
  have hρcsm : ContDiff ℝ (⊤ : ℕ∞) ρc := Complex.ofRealCLM.contDiff.comp hρsm'
  have hηcs : ∀ x, ηc x ≠ 0 → x ∈ Set.Ioo (0 : ℝ) 1 := by
    intro x hx
    exact hηs (subset_tsupport η
      (by simpa only [ηc, Function.mem_support, Complex.ofReal_ne_zero] using hx))
  have hρcs : ∀ x, ρc x ≠ 0 → x ∈ Set.Ioo (-1 : ℝ) 1 := by
    intro x hx
    exact hρs (subset_tsupport ρ
      (by simpa only [ρc, Function.mem_support, Complex.ofReal_ne_zero] using hx))
  have hηcd (n : ℕ) (x : ℝ) :
      ‖iteratedDeriv n ηc x‖ ≤ T ^ (K * (n + 1)) * (n + 1 : ℝ) ^ (K * (n + 1)) := by
    rw [complex_ofReal_iteratedDeriv_norm η hηsm]
    apply (hηd n x).trans
    have hn1 : (1 : ℝ) ≤ n + 1 := by have := Nat.cast_nonneg (α := ℝ) n; linarith
    apply mul_le_mul
    · exact (pow_le_pow_left₀ (by positivity) hB₀εT _).trans
        (pow_le_pow_right₀ hT1 (Nat.mul_le_mul_right _ (le_max_left 20 C)))
    · exact pow_le_pow_right₀ hn1 (Nat.mul_le_mul_right _ (le_max_left 20 C))
    · positivity
    · positivity
  have hρcd (n : ℕ) (x : ℝ) :
      ‖iteratedDeriv n ρc x‖ ≤ T ^ (K * (n + 1)) * (n + 1 : ℝ) ^ (K * (n + 1)) := by
    rw [complex_ofReal_iteratedDeriv_norm ρ hρsm']
    apply (hρd n x).trans
    rw [mul_pow]
    have hn1 : (1 : ℝ) ≤ n + 1 := by have := Nat.cast_nonneg (α := ℝ) n; linarith
    apply mul_le_mul
    · exact (pow_le_pow_left₀ (Nat.cast_nonneg _) hCT _).trans
        (pow_le_pow_right₀ hT1 (Nat.mul_le_mul_right _ (le_max_right 20 C)))
    · exact pow_le_pow_right₀ hn1 (Nat.mul_le_mul_right _ (le_max_right 20 C))
    · positivity
    · positivity
  have hpart : ∀ r : ℝ, ∑' k : ℤ, ρc (r - k) = 1 := by
    intro r
    simp only [ρc, ← Complex.ofReal_tsum, hρpart, Complex.ofReal_one]
  let A' := floorInterpolatedChart A ηc ρc hηcsm hρcsm hηcs hρcs
  refine ⟨η, A', hηsm, hηunit, hηs, hηone, ?_, ?_, ?_⟩
  · exact floorInterpolatedChart_complexity hA hc hP hPH hθ hlam hβ
      (hbase.trans hbudget) ηc ρc hηcsm hρcsm hηcs hρcs hηcd hρcd
  · apply floorInterpolatedChart_bounded A ηc ρc hηcsm hρcsm hηcs hρcs hpart _ hAb
    intro x
    simpa only [ηc, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hηunit x).1]
      using (hηunit x).2
  · exact fun v => floorInterpolatedChart_atom A ηc ρc hηcsm hρcsm hηcs hρcs hpart v

theorem monomial_uniform_natural_envelope (a : ℝ) (n : ℕ) :
    ∃ D : ℕ, 1 ≤ D ∧ n ≤ D ∧ a ≤ (D : ℝ) ∧
      ∀ X : ℝ, 1 ≤ X → a * X ^ n ≤ (D : ℝ) * X ^ D := by
  obtain ⟨k, hk⟩ := exists_nat_ge a
  let D := k + n + 1
  have hkD : (k : ℝ) ≤ D := by exact_mod_cast (show k ≤ D by dsimp [D]; omega)
  refine ⟨D, by dsimp [D]; omega, by dsimp [D]; omega, hk.trans hkD, ?_⟩
  intro X hX
  exact mul_le_mul (hk.trans hkD)
    (pow_le_pow_right₀ hX (by dsimp [D]; omega)) (by positivity) (by positivity)

theorem uniform_floor_inverse_budget (C : ℕ) (hC : 1 ≤ C) (B : ℝ) (hB : 8 ≤ B) :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ X : ℝ, 1 ≤ X →
      let H := Real.exp ((C : ℝ) * X ^ C)
      let T := chartTranslationBudget H * (8 * B * H)
      T ≤ Real.exp ((D : ℝ) * X ^ D) ∧
      chartTranslationBudget T ≤ Real.exp ((D : ℝ) * X ^ D) ∧
      2 * H ≤ Real.exp ((D : ℝ) * X ^ D) := by
  let A := 100 * (1 + (C : ℝ)) ^ 3 + |Real.log (8 * B)| + (C : ℝ) + 1
  have hCr : (1 : ℝ) ≤ C := by exact_mod_cast hC
  have hA1 : 1 ≤ A := by
    dsimp [A]
    have hp : 0 ≤ 100 * (1 + (C : ℝ)) ^ 3 := by positivity
    linarith only [hp, abs_nonneg (Real.log (8 * B)), hCr]
  let A₂ := 100 * (1 + A) ^ 3
  have hAA₂ : A ≤ A₂ := by
    dsimp [A₂]
    nlinarith [sq_nonneg A, pow_nonneg (by linarith : 0 ≤ A) 3]
  obtain ⟨D, hD, hnD, hcoef, henvelope⟩ := monomial_uniform_natural_envelope A₂ (9 * C)
  refine ⟨D, hD, fun X hX => ?_⟩
  let H := Real.exp ((C : ℝ) * X ^ C)
  let T := chartTranslationBudget H * (8 * B * H)
  have hX0 : 0 ≤ X := by linarith
  have hXC : 1 ≤ X ^ C := one_le_pow₀ hX
  have hH1 : 1 ≤ H := Real.one_le_exp_iff.mpr (by positivity)
  have hHp : 0 < H := Real.exp_pos _
  have hlogH : Real.log H = (C : ℝ) * X ^ C := Real.log_exp _
  have hBP : 0 < 8 * B := by linarith only [hB]
  have htrans1 : 1 ≤ chartTranslationBudget H := by
    apply Real.one_le_exp_iff.mpr
    unfold logarithmicSize
    have hl : 0 ≤ Real.log H := Real.log_nonneg hH1
    positivity
  have hT2H : 2 * H ≤ T := by
    calc
      _ ≤ 8 * B * H := mul_le_mul_of_nonneg_right (by linarith only [hB]) hHp.le
      _ ≤ _ := le_mul_of_one_le_left (by positivity) htrans1
  have hT1 : 1 ≤ T := by linarith only [hT2H, hH1]
  have hTp : 0 < T := by linarith only [hT1]
  have hlogT : Real.log T =
      100 * (1 + (C : ℝ) * X ^ C) ^ 3 + Real.log (8 * B) + (C : ℝ) * X ^ C := by
    dsimp only [T, chartTranslationBudget]
    rw [Real.log_mul (Real.exp_ne_zero _) (mul_ne_zero hBP.ne' hHp.ne'),
      Real.log_mul hBP.ne' hHp.ne']
    simp only [logarithmicSize, Real.log_exp, hlogH, H]
    ring
  have hlogbound : Real.log T ≤ A * X ^ (3 * C) := by
    rw [hlogT]
    have hfirst : 1 + (C : ℝ) * X ^ C ≤ (1 + (C : ℝ)) * X ^ C := by
      nlinarith only [hXC]
    have hpow : X ^ C ≤ X ^ (3 * C) := pow_le_pow_right₀ hX (by omega)
    have hx3 : 1 ≤ X ^ (3 * C) := one_le_pow₀ hX
    calc
      _ ≤ 100 * ((1 + (C : ℝ)) * X ^ C) ^ 3 +
          |Real.log (8 * B)| * X ^ (3 * C) + (C : ℝ) * X ^ (3 * C) := by
        apply add_le_add
        · apply add_le_add
          · gcongr
          · exact (le_abs_self _).trans
              (le_mul_of_one_le_right (abs_nonneg _) hx3)
        · exact mul_le_mul_of_nonneg_left hpow (Nat.cast_nonneg _)
      _ ≤ A * X ^ (3 * C) := by
        dsimp [A]
        rw [mul_pow, ← pow_mul, show C * 3 = 3 * C by omega]
        nlinarith only [pow_nonneg hX0 (3 * C)]
  have hlogbound₂ : 100 * logarithmicSize T ^ 3 ≤ A₂ * X ^ (9 * C) := by
    have hinner : 1 + Real.log T ≤ (1 + A) * X ^ (3 * C) := by
      have hx3 : 1 ≤ X ^ (3 * C) := one_le_pow₀ hX
      nlinarith only [hlogbound, hx3]
    have hlogpos : 0 ≤ logarithmicSize T := by
      unfold logarithmicSize
      linarith [Real.log_nonneg hT1]
    calc
      _ ≤ 100 * ((1 + A) * X ^ (3 * C)) ^ 3 := by
        gcongr
        exact hinner
      _ = _ := by
        dsimp [A₂]
        rw [mul_pow, ← pow_mul, show 3 * C * 3 = 9 * C by omega]
        ring
  have hsmall : Real.log T ≤ (D : ℝ) * X ^ D := by
    apply hlogbound.trans
    apply le_trans _ (henvelope X hX)
    exact mul_le_mul hAA₂ (pow_le_pow_right₀ hX (by omega)) (by positivity)
      (by dsimp [A₂]; positivity)
  have hTfinal : T ≤ Real.exp ((D : ℝ) * X ^ D) := by
    rw [← Real.exp_log hTp]
    exact Real.exp_le_exp.mpr hsmall
  refine ⟨hTfinal, ?_, hT2H.trans hTfinal⟩
  exact Real.exp_le_exp.mpr (hlogbound₂.trans (henvelope X hX))

theorem quadraticChartAtom_measurable {d : ℕ} (A : QuadraticChartData d) :
    Measurable (quadraticChartAtom A) := by
  have hc (n : Fin d → ℤ) : Continuous (fun y => quadraticChartLatticeSummand A y n) := by
    unfold quadraticChartLatticeSummand chartMatrixPhase chartHorizontalPosition
      chartLatticeRemainder
    apply Continuous.mul
    · exact A.smooth.continuous.comp (by fun_prop)
    · fun_prop
  unfold quadraticChartAtom
  apply Measurable.mul
  · fun_prop
  · exact Measurable.tsum (fun n => (hc n).measurable)
noncomputable def inverseDecompositionBudget (C : ℕ) (t : ℝ) : ℝ :=
  2 * (Real.exp 2 + Real.exp ((C : ℝ) * (1 + Real.log (4 * t ^ 2)) ^ C))

theorem inverseDecompositionBudget_quasipolynomial {C : ℕ} (hC : 1 ≤ C) :
    QuasipolynomialBound (inverseDecompositionBudget C) := by
  have hcore : QuasipolynomialBound
      (fun t : ℝ => Real.exp ((C : ℝ) * (1 + Real.log (4 * t ^ 2)) ^ C)) := by
    let K := 3 + Real.log (4 : ℝ)
    have hK : 0 ≤ K := by dsimp [K]; positivity
    refine ⟨max 1 ((C : ℝ) * K ^ C), le_max_left _ _, C, hC, ?_⟩
    intro t ht
    have ht0 : 0 < t := by linarith
    have hX := one_le_logarithmicSize ht
    have hl : 0 ≤ Real.log t := Real.log_nonneg (by linarith)
    have hlog4 : 0 ≤ Real.log (4 : ℝ) := Real.log_nonneg (by norm_num)
    have he : 1 + Real.log (4 * t ^ 2) = 1 + Real.log 4 + 2 * Real.log t := by
      rw [Real.log_mul (by norm_num) (pow_ne_zero _ ht0.ne'), Real.log_pow]
      norm_num
      ring
    have hs : 0 ≤ 1 + Real.log (4 * t ^ 2) := by rw [he]; positivity
    have hb : 1 + Real.log (4 * t ^ 2) ≤ K * logarithmicSize t := by
      rw [he]
      dsimp [K, logarithmicSize]
      nlinarith only [hl, hlog4, mul_nonneg hl hlog4]
    refine ⟨(Real.exp_pos _).le, Real.exp_le_exp.mpr ?_⟩
    calc
      (C : ℝ) * (1 + Real.log (4 * t ^ 2)) ^ C ≤
          (C : ℝ) * (K * logarithmicSize t) ^ C := by gcongr
      _ = ((C : ℝ) * K ^ C) * logarithmicSize t ^ C := by rw [mul_pow]; ring
      _ ≤ max 1 ((C : ℝ) * K ^ C) * logarithmicSize t ^ C :=
        mul_le_mul_of_nonneg_right (le_max_right _ _) (pow_nonneg (by linarith only [hX]) _)
  exact quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num : (0 : ℝ) ≤ 2))
    (quasipolynomialBound_add (quasipolynomialBound_const (Real.exp_pos 2).le) hcore)

theorem inverseDecompositionBudget_at_reciprocal (C : ℕ) (τ : ℝ) :
    inverseDecompositionBudget C (1 / τ) =
      2 * (Real.exp 2 + Real.exp ((C : ℝ) * (1 + Real.log (1 / (τ / 2) ^ 2)) ^ C)) := by
  unfold inverseDecompositionBudget
  have he : 4 * (1 / τ) ^ 2 = 1 / (τ / 2) ^ 2 := by ring
  rw [he]
theorem quasipolynomialBound_of_le {f g : ℝ → ℝ} (hg : QuasipolynomialBound g)
    (hf0 : ∀ t, 2 ≤ t → 0 ≤ f t) (hfg : ∀ t, 2 ≤ t → f t ≤ g t) :
    QuasipolynomialBound f := by
  obtain ⟨C, hC, d, hd, hg⟩ := hg
  exact ⟨C, hC, d, hd, fun t ht => ⟨hf0 t ht, (hfg t ht).trans (hg t ht).2⟩⟩

theorem quasipolynomialBound_id : QuasipolynomialBound (fun t : ℝ => t) := by
  refine ⟨1, le_rfl, 1, le_rfl, ?_⟩
  intro t ht
  refine ⟨by linarith, ?_⟩
  rw [one_mul, pow_one]
  calc
    t = Real.exp (Real.log t) := (Real.exp_log (by linarith)).symm
    _ ≤ Real.exp (logarithmicSize t) := Real.exp_le_exp.mpr (by
      unfold logarithmicSize
      linarith)

theorem quasipolynomialBound_logarithmicSize : QuasipolynomialBound logarithmicSize := by
  apply quasipolynomialBound_of_le quasipolynomialBound_id
  · intro t ht
    exact le_trans zero_le_one (one_le_logarithmicSize ht)
  · intro t ht
    have hh := Real.log_le_sub_one_of_pos (show 0 < t by linarith)
    dsimp [logarithmicSize]
    linarith only [hh]

theorem quasipolynomialBound_natPow {f : ℝ → ℝ} (hf : QuasipolynomialBound f) (n : ℕ) :
    QuasipolynomialBound (fun t => f t ^ n) := by
  simpa only [Real.rpow_natCast] using
    (quasipolynomialBound_rpow hf (Nat.cast_nonneg (α := ℝ) n))

/-- A power whose exponent is polynomial in logarithmic size preserves
quasipolynomial growth. -/
theorem quasipolynomialBound_logPower {f g : ℝ → ℝ}
    (hf : QuasipolynomialBound f) {C : ℝ} (hC : 1 ≤ C) (n : ℕ)
    (hg0 : ∀ t, 2 ≤ t → 0 ≤ g t)
    (hg : ∀ t, 2 ≤ t → g t ≤ C * logarithmicSize t ^ n) :
    QuasipolynomialBound (fun t => f t ^ g t) := by
  obtain ⟨D, hD, e, he, hf⟩ := hf
  refine ⟨D * C, by nlinarith only [hC, hD], e + n, by omega, ?_⟩
  intro t ht
  have hL : 0 ≤ logarithmicSize t := le_trans zero_le_one (one_le_logarithmicSize ht)
  refine ⟨Real.rpow_nonneg (hf t ht).1 _, ?_⟩
  calc
    f t ^ g t ≤ Real.exp (D * logarithmicSize t ^ e) ^ g t :=
      Real.rpow_le_rpow (hf t ht).1 (hf t ht).2 (hg0 t ht)
    _ = Real.exp (D * logarithmicSize t ^ e * g t) := (Real.exp_mul _ _).symm
    _ ≤ Real.exp (D * C * logarithmicSize t ^ (e + n)) := by
      apply Real.exp_le_exp.mpr
      calc
        D * logarithmicSize t ^ e * g t ≤
            D * logarithmicSize t ^ e * (C * logarithmicSize t ^ n) :=
          mul_le_mul_of_nonneg_left (hg t ht) (by positivity)
        _ = _ := by rw [pow_add]; ring

noncomputable def shortReturnAlternatingBudget (t : ℝ) : ℝ :=
  2 * logarithmicSize t ^ 2 * t

noncomputable def shortReturnRadiusBudget (t : ℝ) : ℝ :=
  t + 100 * (t + shortReturnAlternatingBudget t + 1)

noncomputable def shortReturnGapBudget (t : ℝ) : ℝ :=
  16 * (100 * (logarithmicSize t + 1)) ^ (10 * (logarithmicSize t + 1))

noncomputable def shortReturnInitialScaleBudget (t : ℝ) : ℝ :=
  100 + 100 * t * (logarithmicSize t + 4) * shortReturnRadiusBudget t

noncomputable def shortReturnScaleBudget (t : ℝ) : ℝ :=
  shortReturnInitialScaleBudget t *
    shortReturnGapBudget t ^ (logarithmicSize t + 1)

noncomputable def shortReturnRowBudget (t : ℝ) : ℝ :=
  2 + shortReturnScaleBudget t

noncomputable def shortReturnProjectionBudget (t : ℝ) : ℝ :=
  (2 * shortReturnRowBudget t) ^ (8 * (logarithmicSize t + 1) ^ (4 : ℕ))

noncomputable def shortReturnGramBudget (t : ℝ) : ℝ :=
  2 + logarithmicSize t * shortReturnRowBudget t ^ 2

noncomputable def shortReturnSlowBudget (t : ℝ) : ℝ :=
  2 + (logarithmicSize t ^ 2 * shortReturnRowBudget t) *
    (logarithmicSize t ^ 2 *
      (2 * shortReturnGramBudget t) ^ (2 * (logarithmicSize t + 1) ^ (4 : ℕ)) *
        (3 * logarithmicSize t * t * shortReturnRowBudget t))

noncomputable def shortReturnTimeInverseBudget (t : ℝ) : ℝ :=
  (1 + 4 * shortReturnScaleBudget t) ^ logarithmicSize t * shortReturnScaleBudget t

noncomputable def shortReturnQuadraticBudget (t : ℝ) : ℝ :=
  9 * (t + 3 * logarithmicSize t * shortReturnSlowBudget t *
    shortReturnAlternatingBudget t * shortReturnSlowBudget t +
      3 * logarithmicSize t * shortReturnSlowBudget t * shortReturnAlternatingBudget t) *
    shortReturnTimeInverseBudget t

noncomputable def shortReturnSplittingBudget (t : ℝ) : ℝ :=
  2 + shortReturnProjectionBudget t + shortReturnSlowBudget t + shortReturnQuadraticBudget t

theorem shortReturnAlternatingBudget_quasipolynomial :
    QuasipolynomialBound shortReturnAlternatingBudget :=
  quasipolynomialBound_mul
    (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
      (quasipolynomialBound_natPow quasipolynomialBound_logarithmicSize 2))
    quasipolynomialBound_id

theorem shortReturnRadiusBudget_quasipolynomial :
    QuasipolynomialBound shortReturnRadiusBudget :=
  quasipolynomialBound_add quasipolynomialBound_id
    (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
      (quasipolynomialBound_add
        (quasipolynomialBound_add quasipolynomialBound_id
          shortReturnAlternatingBudget_quasipolynomial)
        (quasipolynomialBound_const (by norm_num))))

theorem shortReturnGapBudget_quasipolynomial :
    QuasipolynomialBound shortReturnGapBudget := by
  apply quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
  apply quasipolynomialBound_logPower
    (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
      (quasipolynomialBound_add quasipolynomialBound_logarithmicSize
        (quasipolynomialBound_const (by norm_num)))) (C := 20) (by norm_num) 1
  · intro t ht
    have hh := one_le_logarithmicSize ht
    positivity
  · intro t ht
    have hh := one_le_logarithmicSize ht
    simp only [pow_one]
    linarith only [hh]

theorem shortReturnScaleBudget_quasipolynomial :
    QuasipolynomialBound shortReturnScaleBudget := by
  apply quasipolynomialBound_mul
  · exact quasipolynomialBound_add (quasipolynomialBound_const (by norm_num))
      (quasipolynomialBound_mul
        (quasipolynomialBound_mul
          (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
            quasipolynomialBound_id)
          (quasipolynomialBound_add quasipolynomialBound_logarithmicSize
            (quasipolynomialBound_const (by norm_num))))
        shortReturnRadiusBudget_quasipolynomial)
  · apply quasipolynomialBound_logPower shortReturnGapBudget_quasipolynomial
      (C := 2) (by norm_num) 1
    · intro t ht
      have hh := one_le_logarithmicSize ht
      positivity
    · intro t ht
      have hh := one_le_logarithmicSize ht
      simp only [pow_one]
      linarith only [hh]

theorem shortReturnRowBudget_quasipolynomial :
    QuasipolynomialBound shortReturnRowBudget :=
  quasipolynomialBound_add (quasipolynomialBound_const (by norm_num))
    shortReturnScaleBudget_quasipolynomial

theorem logarithmicSize_add_one_pow_four {t : ℝ} (ht : 2 ≤ t) :
    (logarithmicSize t + 1) ^ 4 ≤ 16 * logarithmicSize t ^ 4 := by
  have hh := one_le_logarithmicSize ht
  calc
    (logarithmicSize t + 1) ^ 4 ≤ (2 * logarithmicSize t) ^ 4 := by
      gcongr
      linarith only [hh]
    _ = _ := by ring

theorem shortReturnProjectionBudget_quasipolynomial :
    QuasipolynomialBound shortReturnProjectionBudget := by
  apply quasipolynomialBound_logPower
    (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
      shortReturnRowBudget_quasipolynomial) (C := 128) (by norm_num) 4
  · intro t ht
    positivity
  · intro t ht
    have hh := logarithmicSize_add_one_pow_four ht
    linarith only [hh]

theorem shortReturnGramBudget_quasipolynomial :
    QuasipolynomialBound shortReturnGramBudget :=
  quasipolynomialBound_add (quasipolynomialBound_const (by norm_num))
    (quasipolynomialBound_mul quasipolynomialBound_logarithmicSize
      (quasipolynomialBound_natPow shortReturnRowBudget_quasipolynomial 2))

theorem shortReturnSlowBudget_quasipolynomial :
    QuasipolynomialBound shortReturnSlowBudget := by
  have hE : QuasipolynomialBound (fun t =>
      (2 * shortReturnGramBudget t) ^ (2 * (logarithmicSize t + 1) ^ (4 : ℕ))) := by
    apply quasipolynomialBound_logPower
      (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
        shortReturnGramBudget_quasipolynomial) (C := 32) (by norm_num) 4
    · intro t ht
      positivity
    · intro t ht
      have hh := logarithmicSize_add_one_pow_four ht
      linarith only [hh]
  exact quasipolynomialBound_add (quasipolynomialBound_const (by norm_num))
    (quasipolynomialBound_mul
      (quasipolynomialBound_mul
        (quasipolynomialBound_natPow quasipolynomialBound_logarithmicSize 2)
        shortReturnRowBudget_quasipolynomial)
      (quasipolynomialBound_mul
        (quasipolynomialBound_mul
          (quasipolynomialBound_natPow quasipolynomialBound_logarithmicSize 2) hE)
        (quasipolynomialBound_mul
          (quasipolynomialBound_mul
            (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
              quasipolynomialBound_logarithmicSize) quasipolynomialBound_id)
          shortReturnRowBudget_quasipolynomial)))

theorem shortReturnTimeInverseBudget_quasipolynomial :
    QuasipolynomialBound shortReturnTimeInverseBudget := by
  apply quasipolynomialBound_mul _ shortReturnScaleBudget_quasipolynomial
  apply quasipolynomialBound_logPower
    (quasipolynomialBound_add (quasipolynomialBound_const (by norm_num))
      (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
        shortReturnScaleBudget_quasipolynomial)) (C := 1) le_rfl 1
  · intro t ht
    exact le_trans zero_le_one (one_le_logarithmicSize ht)
  · intro t ht
    simp

theorem shortReturnQuadraticBudget_quasipolynomial :
    QuasipolynomialBound shortReturnQuadraticBudget := by
  have hterm : QuasipolynomialBound (fun t =>
      3 * logarithmicSize t * shortReturnSlowBudget t * shortReturnAlternatingBudget t) :=
    quasipolynomialBound_mul
      (quasipolynomialBound_mul
        (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
          quasipolynomialBound_logarithmicSize) shortReturnSlowBudget_quasipolynomial)
      shortReturnAlternatingBudget_quasipolynomial
  exact quasipolynomialBound_mul
    (quasipolynomialBound_mul (quasipolynomialBound_const (by norm_num))
      (quasipolynomialBound_add
        (quasipolynomialBound_add quasipolynomialBound_id
          (quasipolynomialBound_mul hterm shortReturnSlowBudget_quasipolynomial)) hterm))
    shortReturnTimeInverseBudget_quasipolynomial

theorem shortReturnSplittingBudget_quasipolynomial :
    QuasipolynomialBound shortReturnSplittingBudget :=
  quasipolynomialBound_add
    (quasipolynomialBound_add
      (quasipolynomialBound_add (quasipolynomialBound_const (by norm_num))
        shortReturnProjectionBudget_quasipolynomial) shortReturnSlowBudget_quasipolynomial)
    shortReturnQuadraticBudget_quasipolynomial

theorem quasipolynomialBound_nonneg {f : ℝ → ℝ} (hf : QuasipolynomialBound f)
    {t : ℝ} (ht : 2 ≤ t) : 0 ≤ f t := by
  obtain ⟨C, hC, d, hd, hf⟩ := hf
  exact (hf t ht).1

theorem shortReturnRowBudget_two_le {t : ℝ} (ht : 2 ≤ t) :
    2 ≤ shortReturnRowBudget t := by
  have hh := quasipolynomialBound_nonneg shortReturnScaleBudget_quasipolynomial ht
  dsimp [shortReturnRowBudget]
  linarith only [hh]

theorem shortReturnGramBudget_two_le {t : ℝ} (ht : 2 ≤ t) :
    2 ≤ shortReturnGramBudget t := by
  have hh := one_le_logarithmicSize ht
  dsimp [shortReturnGramBudget]
  exact le_add_of_nonneg_right (by positivity)

theorem shortReturnSlowBudget_two_le {t : ℝ} (ht : 2 ≤ t) :
    2 ≤ shortReturnSlowBudget t := by
  have hL := one_le_logarithmicSize ht
  have hB := shortReturnRowBudget_two_le ht
  have hG := shortReturnGramBudget_two_le ht
  unfold shortReturnSlowBudget
  exact le_add_of_nonneg_right (by positivity)

theorem shortReturnSplittingBudget_two_le {t : ℝ} (ht : 2 ≤ t) :
    2 ≤ shortReturnSplittingBudget t := by
  have hP := quasipolynomialBound_nonneg shortReturnProjectionBudget_quasipolynomial ht
  have hS := quasipolynomialBound_nonneg shortReturnSlowBudget_quasipolynomial ht
  have hQ := quasipolynomialBound_nonneg shortReturnQuadraticBudget_quasipolynomial ht
  dsimp [shortReturnSplittingBudget]
  linarith only [hP, hS, hQ]

theorem shortReturnRadius_reciprocal_bound {t a M N : ℝ} (ht : 2 ≤ t)
    (ha : 0 < a) (hM0 : 0 ≤ M) (hN0 : 0 ≤ N)
    (haT : a⁻¹ ≤ t) (hM : M ≤ t) (hN : N ≤ shortReturnAlternatingBudget t) :
    let r := min a (100 * (M + N + 1))⁻¹
    0 < r ∧ r ≤ a ∧ r⁻¹ ≤ shortReturnRadiusBudget t := by
  intro r
  have hp : 0 < 100 * (M + N + 1) := by positivity
  refine ⟨lt_min ha (inv_pos.mpr hp), min_le_left _ _, ?_⟩
  have hA0 := quasipolynomialBound_nonneg shortReturnAlternatingBudget_quasipolynomial ht
  by_cases hh : a ≤ (100 * (M + N + 1))⁻¹
  · dsimp [r]
    rw [min_eq_left hh]
    exact haT.trans (by
      unfold shortReturnRadiusBudget
      exact le_add_of_nonneg_right (by positivity))
  · dsimp [r]
    rw [min_eq_right (le_of_not_ge hh), inv_inv]
    unfold shortReturnRadiusBudget
    linarith only [hM, hN, ht]

theorem shortReturnInitialScale_reciprocal_bound {t P r : ℝ} (ht : 2 ≤ t)
    (hP : 0 < P) (hr : 0 < r) (hPt : P ≤ t)
    (hrT : r⁻¹ ≤ shortReturnRadiusBudget t) {d k : ℕ}
    (hd : (d : ℝ) ≤ logarithmicSize t) (hk : k ≤ 3) :
    let b := min (1 / 100 : ℝ) (r / (100 * P * (d + k + 1)))
    0 < b ∧ b⁻¹ ≤ shortReturnInitialScaleBudget t := by
  intro b
  have hden : 0 < 100 * P * (d + k + 1 : ℝ) := by positivity
  have hL := one_le_logarithmicSize ht
  have hR := quasipolynomialBound_nonneg shortReturnRadiusBudget_quasipolynomial ht
  have hkr : (k : ℝ) ≤ 3 := by exact_mod_cast hk
  refine ⟨lt_min (by norm_num) (div_pos hr hden), ?_⟩
  by_cases hh : (1 / 100 : ℝ) ≤ r / (100 * P * (d + k + 1))
  · dsimp [b]
    rw [min_eq_left hh]
    norm_num
    unfold shortReturnInitialScaleBudget
    exact le_add_of_nonneg_right (by positivity)
  · dsimp [b]
    rw [min_eq_right (le_of_not_ge hh), inv_div, div_eq_mul_inv]
    have hdim : (d + k + 1 : ℝ) ≤ logarithmicSize t + 4 := by linarith only [hd, hkr]
    have hm : 100 * P * (d + k + 1 : ℝ) * r⁻¹ ≤
        100 * t * (logarithmicSize t + 4) * shortReturnRadiusBudget t := by
      gcongr
    exact hm.trans (by unfold shortReturnInitialScaleBudget; linarith)

theorem shortReturnGapBudget_one_le {t : ℝ} (ht : 2 ≤ t) :
    1 ≤ shortReturnGapBudget t := by
  have hL := one_le_logarithmicSize ht
  have hb : 1 ≤ 100 * (logarithmicSize t + 1) := by linarith only [hL]
  have he : 0 ≤ 10 * (logarithmicSize t + 1) := by positivity
  have hh := Real.one_le_rpow hb he
  unfold shortReturnGapBudget
  linarith only [hh]

theorem shortReturnGapBudget_bound {t : ℝ} (ht : 2 ≤ t) {d : ℕ}
    (hd : (d : ℝ) ≤ logarithmicSize t) :
    16 * (100 * (d : ℝ)) ^ (10 * d) ≤ shortReturnGapBudget t := by
  have hL := one_le_logarithmicSize ht
  have hb : 1 ≤ 100 * (logarithmicSize t + 1) := by linarith only [hL]
  unfold shortReturnGapBudget
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  calc
    (100 * (d : ℝ)) ^ (10 * d) =
        (100 * (d : ℝ)) ^ (10 * (d : ℝ)) := by
      rw [← Real.rpow_natCast]
      norm_cast
    _ ≤ (100 * (logarithmicSize t + 1)) ^ (10 * (d : ℝ)) :=
      Real.rpow_le_rpow (by positivity) (by linarith only [hd]) (by positivity)
    _ ≤ _ := Real.rpow_le_rpow_of_exponent_le hb (by linarith only [hd])

theorem shortReturnScale_reciprocal_bound {t c g b : ℝ} (ht : 2 ≤ t)
    (hg0 : 0 ≤ g) {d : ℕ} (hd : (d : ℝ) ≤ logarithmicSize t)
    (hcT : c⁻¹ ≤ shortReturnInitialScaleBudget t)
    (hgT : g ≤ shortReturnGapBudget t)
    (hb : b⁻¹ ≤ c⁻¹ * g ^ (d + 1)) :
    b⁻¹ ≤ shortReturnScaleBudget t := by
  have hL := one_le_logarithmicSize ht
  have hR := quasipolynomialBound_nonneg shortReturnRadiusBudget_quasipolynomial ht
  have hI : 0 ≤ shortReturnInitialScaleBudget t := by
    unfold shortReturnInitialScaleBudget
    positivity
  have hp : g ^ (d + 1) ≤
      shortReturnGapBudget t ^ (logarithmicSize t + 1) := by
    calc
      g ^ (d + 1) = g ^ ((d : ℝ) + 1) := by
        rw [← Real.rpow_natCast]
        norm_cast
      _ ≤ shortReturnGapBudget t ^ ((d : ℝ) + 1) :=
        Real.rpow_le_rpow hg0 hgT (by positivity)
      _ ≤ _ := Real.rpow_le_rpow_of_exponent_le (shortReturnGapBudget_one_le ht)
        (add_le_add hd le_rfl)
  exact hb.trans (mul_le_mul hcT hp (pow_nonneg hg0 _) hI)

