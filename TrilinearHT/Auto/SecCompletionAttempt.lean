namespace AttemptParams

variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} (ap : A.AttemptParams)

theorem tests_r_le (cat : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) (l : Fin 4)
    (w : ap.TestIdx I l) : (ap.tests cat I l w).r ≤ ap.Lc + 4 := by
  rcases w with (⟨s, (⟨p, c⟩ | ⟨G, p, c⟩)⟩ | ⟨s, i, (⟨G, p, c⟩ | ⟨k, p, c⟩)⟩)
  · change ap.Lc - ((leafAt ap.fuel ap.Lc ap.up₀ s).k - 1) + 1 ≤ _; omega
  · change ap.Lc + (leafAt ap.fuel ap.Lc ap.up₀ s).role l ≤ _
    have := (leafAt ap.fuel ap.Lc ap.up₀ s).role_le l; omega
  · change ap.Lc + (leafAt ap.fuel ap.Lc ap.up₀ s).role l ≤ _
    have := (leafAt ap.fuel ap.Lc ap.up₀ s).role_le l; omega
  · change ap.Lc - (ap.chainOf s l i).getD k 0 + 1 ≤ _; omega

/-- The catalog thresholds `τ_r = (K_t Q E² M_p (L+6) / n_r)^{1/2}` of the count sequence `n`. -/
noncomputable def catTau (Kt Mp : ℕ) (Q E : ℝ) (n : ℕ → ℝ) (r : ℕ) : ℝ :=
  Real.sqrt (Kt * Q * E ^ 2 * Mp * (ap.Lc + 6) / n r)

open Classical in
/-- Blueprint lem:closure with the rank counts (lines 1826-1831): for a count sequence `n`, the
thresholds `catTau` give attempt catalogs passing all named tests at the cells of `L`, made of
same-tag templates, whose labels of rank `r ≤ L + 5` at any cell lying in at most `M_p` cells of
`L` number at most `n_r`. -/
theorem catalogs_counted (L : List (ℤ × ℤ)) (hL : ∀ I ∈ L, I ∈ A.cells) (hnd : L.Nodup)
    (hord : ∀ i j (hi : i < L.length) (hj : j < L.length), i < j →
      ¬ dyadicGridCell A.G L[i].1 L[i].2 ⊆ dyadicGridCell A.G L[j].1 L[j].2)
    {D : ℕ} (hst : SameTagBound κ (A.csrc + 1) D) {Kt Mp : ℕ} (hKt1 : 1 ≤ Kt) (hMp1 : 1 ≤ Mp)
    (hKt : ∀ I l, Fintype.card (ap.TestIdx I l) ≤ Kt) {Tmax : ℕ}
    (hMc : L.length * Tmax ≤ ap.Mc) (n : ℕ → ℝ) (hn0 : ∀ r, 0 < n r) (hnm : Monotone n)
    (hT : n (ap.Lc + 4) ≤ Tmax) :
    ∃ cat : Fin 4 → List (CatCol A.Vtx), ∀ l,
      (∀ I ∈ L, ∀ w, (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc A.Hsrc A.vtag (A.w I)
        (ap.catTau Kt Mp (4 ^ ap.mH * projectionPrefixConstant Tmax ^ (2 * ap.mH))
          (2 * Real.exp (D * (1 + Real.log A.Hsrc) ^ D)) n (ap.tests (fun _ => []) I l w).r)
        ap.mH (cat l)) ∧
      (∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
        d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag) ∧
      (∀ I, (L.toFinset.filter fun I' : ℤ × ℤ =>
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2).card ≤ Mp →
        ∀ r ≤ ap.Lc + 5, ∀ M, ((catLabels A.G ap.Mc (cat l) I r M).card : ℝ) ≤ n r) ∧
      (∀ d ∈ cat l, d.birth ∈ L) ∧ (cat l).length ≤ L.length * Tmax := by
  classical
  set Q : ℝ := 4 ^ ap.mH * projectionPrefixConstant Tmax ^ (2 * ap.mH) with hQ
  set E : ℝ := 2 * Real.exp (D * (1 + Real.log A.Hsrc) ^ D) with hE
  have hQ0 : 0 < Q := by
    have := projectionPrefixConstant_one_le Tmax; positivity
  have hE0 : 0 < E := by positivity
  set K : ℝ := Kt * Q * E ^ 2 * Mp * (ap.Lc + 6) with hK
  have hKt0 : (1 : ℝ) ≤ Kt := by exact_mod_cast hKt1
  have hMp0 : (1 : ℝ) ≤ Mp := by exact_mod_cast hMp1
  have hK0 : 0 < K := by positivity
  set τ := ap.catTau Kt Mp Q E n with hτ
  have hτ0 : ∀ r, 0 < τ r := fun r => Real.sqrt_pos.mpr (div_pos hK0 (hn0 r))
  -- the scaled squared thresholds
  have hτE : ∀ r, (τ r / E) ^ 2 = Kt * Q * Mp * (ap.Lc + 6) / n r := fun r => by
    change (Real.sqrt (K / n r) / E) ^ 2 = _
    rw [sqrt_div_sq hK0.le (hn0 r), hK]
    field_simp
  have hH : Real.exp 2 ≤ A.Hsrc := A.exp_two_le_Hsrc
  obtain ⟨cat, hcat⟩ := ap.catalogs_exist L hL hnd hord hst hH τ (fun l I w => hτ0 _)
    (Tmax := Tmax) hMc (fun l I _ => by
      have hterm : ∀ r ∈ Finset.univ.image (fun w => (ap.tests (fun _ => []) I l w).r),
          Fintype.card (ap.TestIdx I l) * Q / (τ r / E) ^ 2 ≤ n (ap.Lc + 4) / (ap.Lc + 6) := by
        intro r hr
        obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hr
        have hrle := ap.tests_r_le (fun _ => []) I l w
        rw [hτE]
        have hc : (Fintype.card (ap.TestIdx I l) : ℝ) ≤ Kt := by exact_mod_cast hKt I l
        have hnr := hn0 (ap.tests (fun _ => []) I l w).r
        have hnle := hnm hrle
        rw [div_div_eq_mul_div, div_le_div_iff₀ (by positivity) (by positivity)]
        calc (Fintype.card (ap.TestIdx I l) : ℝ) * Q * n (ap.tests (fun _ => []) I l w).r *
              (ap.Lc + 6) ≤ Kt * Q * n (ap.Lc + 4) * (ap.Lc + 6) := by gcongr
          _ ≤ n (ap.Lc + 4) * (Kt * Q * Mp * (ap.Lc + 6)) := by
            have := hn0 (ap.Lc + 4)
            have : 0 ≤ Kt * Q * n (ap.Lc + 4) * (ap.Lc + 6) := by positivity
            nlinarith
      have hsub : Finset.univ.image (fun w => (ap.tests (fun _ => []) I l w).r) ⊆
          Finset.range (ap.Lc + 5) := fun r hr => by
        obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hr
        exact Finset.mem_range.mpr (by have := ap.tests_r_le (fun _ => []) I l w; omega)
      have hcard : ((Finset.univ.image (fun w => (ap.tests (fun _ => []) I l w).r)).card : ℝ) ≤
          ap.Lc + 5 := by
        have := Finset.card_le_card hsub
        rw [Finset.card_range] at this
        exact_mod_cast this
      calc ∑ r ∈ Finset.univ.image (fun w => (ap.tests (fun _ => []) I l w).r),
            Fintype.card (ap.TestIdx I l) * Q / (τ r / E) ^ 2
          ≤ ∑ r ∈ Finset.univ.image (fun w => (ap.tests (fun _ => []) I l w).r),
              n (ap.Lc + 4) / (ap.Lc + 6) := Finset.sum_le_sum hterm
        _ = (Finset.univ.image (fun w => (ap.tests (fun _ => []) I l w).r)).card *
              (n (ap.Lc + 4) / (ap.Lc + 6)) := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ (ap.Lc + 5) * (n (ap.Lc + 4) / (ap.Lc + 6)) := by
            gcongr; exact (div_pos (hn0 _) (by positivity)).le
        _ < n (ap.Lc + 4) := by
            have := hn0 (ap.Lc + 4)
            rw [mul_div_assoc', div_lt_iff₀ (by positivity)]
            nlinarith
        _ ≤ Tmax := hT)
  refine ⟨cat, fun l => ?_⟩
  obtain ⟨hpass, hbirth, hcount, hlen⟩ := hcat l
  refine ⟨fun I hI w => CatTest.pass_mono_order _ (hpass I hI w) (Nat.le_succ _),
    fun d hd => ?_, fun I hMpI r hr M => ?_, fun d hd => (hbirth d hd).1, hlen⟩
  · obtain ⟨-, w, hr, -, R, hR, γ, hd'⟩ := hbirth d hd
    exact ⟨R, hR, γ, by rw [hr]; exact hd'⟩
  -- the per-rank counts
  have hcnt : ∀ b ∈ (L.toFinset.filter fun I' : ℤ × ℤ =>
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2) ×ˢ Finset.range (r + 1),
      (((cat l).filter (fun d => decide (d.birth = b.1 ∧ d.rank = b.2))).length : ℝ) ≤
        n r / (Mp * (ap.Lc + 6)) := by
    intro b hb
    simp only [Finset.mem_product, Finset.mem_filter, List.mem_toFinset, Finset.mem_range] at hb
    rcases hcount b.1 hb.1.1 b.2 with h | h
    · have hτb := hτE b.2
      have hnb := hn0 b.2
      have hc : (Fintype.card (ap.TestIdx b.1 l) : ℝ) ≤ Kt := by exact_mod_cast hKt b.1 l
      have hpos : 0 < (τ b.2 / E) ^ 2 := by have := hτ0 b.2; positivity
      have h' := (le_div_iff₀ hpos).mpr h
      refine h'.trans ?_
      rw [hτb, div_div_eq_mul_div, div_le_div_iff₀ (by positivity) (by positivity)]
      have hnbr := hnm (show b.2 ≤ r by omega)
      calc (Fintype.card (ap.TestIdx b.1 l) : ℝ) * Q * n b.2 * (Mp * (ap.Lc + 6))
          ≤ Kt * Q * n r * (Mp * (ap.Lc + 6)) := by gcongr
        _ = n r * (Kt * Q * Mp * (ap.Lc + 6)) := by ring
    · exact absurd h (not_le.mpr (div_pos (hτ0 _) hE0))
  have h1 := card_catLabels_le A.G ap.Mc (cat l) I r M L.toFinset
    fun d hd => List.mem_toFinset.mpr (hbirth d hd).1
  have h2 : ((catLabels A.G ap.Mc (cat l) I r M).card : ℝ) ≤
      ∑ b ∈ (L.toFinset.filter fun I' : ℤ × ℤ =>
        dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2) ×ˢ Finset.range (r + 1),
        (((cat l).filter (fun d => decide (d.birth = b.1 ∧ d.rank = b.2))).length : ℝ) := by
    exact_mod_cast h1
  refine h2.trans ((Finset.sum_le_sum hcnt).trans ?_)
  rw [Finset.sum_const, Finset.card_product, Finset.card_range, nsmul_eq_mul]
  have hA : ((L.toFinset.filter fun I' : ℤ × ℤ =>
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2).card : ℝ) ≤ Mp := by
    exact_mod_cast hMpI
  have hr' : ((r + 1 : ℕ) : ℝ) ≤ ap.Lc + 6 := by
    have : r + 1 ≤ ap.Lc + 6 := by omega
    exact_mod_cast this
  have hnr := hn0 r
  rw [Nat.cast_mul, mul_div_assoc', div_le_iff₀ (by positivity)]
  have : (0 : ℝ) ≤ n r := hnr.le
  calc ((L.toFinset.filter fun I' : ℤ × ℤ =>
        dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2).card : ℝ) *
        ((r + 1 : ℕ) : ℝ) * n r ≤ Mp * (ap.Lc + 6) * n r := by gcongr
    _ = n r * (Mp * (ap.Lc + 6)) := by ring

