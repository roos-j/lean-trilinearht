def IsMonotoneColoring {V : Type*} [DecidableEq V] (T : AdmTree V) (dist : DepthDistance V)
    (D b1 b2 : ℕ) (S : Finset T.Cell) (cellSet : T.Cell → Set ℝ) (R : Set ℝ)
