namespace LeafFilters

variable {Tg γ : Type*} (F : LeafFilters Tg γ)

theorem norm_layerOp_le (l : Fin 4) (ls : List (ℕ × Bool)) (X : ColumnL2 (Fin F.Mc)) :
    ‖layerOp (F.cum l) ls X‖ ≤ ‖X‖ := by
  refine norm_layerOp_apply_le _ (fun m x => ?_) (fun m x => ?_) _ _
  · exact norm_opAvg_apply_le _ (fun _ y => norm_catProj_le _ _ _ _ _ _ y) x
  · exact norm_id_sub_opAvg_apply_le F.hP _
      (fun _ y => norm_catProj_complement_le _ _ _ _ _ _ y) x

/-- Blueprint line 1835: an upper guard whose last layer is a cumulative filter at the split `h`
expands in the catalog columns of its masks, with square-summable coefficients. -/
theorem upper_expansion (ls : Fin 4 → List (ℕ × Bool)) (u : Fin 4) {ls' : List (ℕ × Bool)}
    {h : ℕ} (hls : ls u = ls' ++ [(h, false)]) :
    ∃ a : Fin F.Mc → ℂ,
      (∑ n ∈ catLabels F.G F.Mc (F.cat u) F.I (F.rkC h) (fun x => ∃ p : Fin F.P, F.cm h p x),
          ‖a n‖ ^ 2) * dyadicGridLength F.G F.I.1 ≤
        ‖physicalColumnInput (V := Fin F.Mc) (F.g u)‖ ^ 2 ∧
      F.input ls u = ∑ n ∈ catLabels F.G F.Mc (F.cat u) F.I (F.rkC h)
          (fun x => ∃ p : Fin F.P, F.cm h p x),
        a n • fitColumn (dyadicGridCell F.G F.I.1 F.I.2) (catAtom (F.cat u) n) n := by
  set X := layerOp (F.cum u) ls' (physicalColumnInput (V := Fin F.Mc) (F.g u))
  obtain ⟨a, ha, hx⟩ := opAvg_catProj_l2 (G := F.G) (F.cat u) F.I (F.rkC h)
    (fun p : Fin F.P => F.cm h p) (fun x => ∃ p : Fin F.P, F.cm h p x)
    (fun p x hx => ⟨p, hx⟩) X
  refine ⟨a, ha.trans (pow_le_pow_left₀ (norm_nonneg _) (F.norm_layerOp_le u ls' _) 2), ?_⟩
  rw [← hx]
  unfold input
  rw [hls, layerOp_append]
  rfl

end LeafFilters

/-! ### The basic upper guard: expansion in vertex charts -/

theorem cellLp_add {G : RealDyadicGrid} {I : ℤ × ℤ} {f g : ℝ → ℂ}
    (hf : MemLp f 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)))
    (hg : MemLp g 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))) :
    cellLp G I (f + g) = cellLp G I f + cellLp G I g := by
  refine Lp.ext ?_
  filter_upwards [cellLp_ae (hf.add hg), cellLp_ae hf, cellLp_ae hg,
    Lp.coeFn_add (cellLp G I f) (cellLp G I g)] with y h1 h2 h3 h4
  rw [h1, h4, Pi.add_apply, h2, h3]
  by_cases hy : y ∈ dyadicGridCell G I.1 I.2 <;> simp [Set.indicator, hy]

theorem cellLp_smul {G : RealDyadicGrid} {I : ℤ × ℤ} {f : ℝ → ℂ}
    (hf : MemLp f 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))) (c : ℂ) :
    cellLp G I (c • f) = c • cellLp G I f := by
  refine Lp.ext ?_
  filter_upwards [cellLp_ae (hf.const_smul c), cellLp_ae hf,
    Lp.coeFn_smul c (cellLp G I f)] with y h1 h2 h3
  rw [h1, h3, Pi.smul_apply, h2]
  by_cases hy : y ∈ dyadicGridCell G I.1 I.2 <;> simp [Set.indicator, hy]

theorem cellLp_sum {G : RealDyadicGrid} {I : ℤ × ℤ} {ι : Type*} (s : Finset ι) (c : ι → ℂ)
    (f : ι → ℝ → ℂ) (hf : ∀ v ∈ s, MemLp (f v) 2 (normalizedIntervalMeasure
      (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1))) :
    cellLp G I (∑ v ∈ s, c v • f v) = ∑ v ∈ s, c v • cellLp G I (f v) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    refine Lp.ext ?_
    filter_upwards [cellLp_ae (G := G) (I := I) (f := 0) (MemLp.zero),
      Lp.coeFn_zero ℂ 2 (volume : Measure ℝ)] with y h1 h2
    rw [h1, h2]; simp
  | insert v s hv ih =>
    rw [Finset.sum_insert hv, Finset.sum_insert hv]
    have hs : MemLp (∑ w ∈ s, c w • f w) 2 (normalizedIntervalMeasure
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) :=
      memLp_finsetSum' s fun w hw => (hf w (Finset.mem_insert_of_mem hw)).const_smul _
    rw [cellLp_add ((hf v (Finset.mem_insert_self v s)).const_smul _) hs,
      cellLp_smul (hf v (Finset.mem_insert_self v s)),
      ih fun w hw => hf w (Finset.mem_insert_of_mem hw)]

theorem physicalColumnInput_sum {V : Type*} [Fintype V] {ι : Type*} (s : Finset ι) (c : ι → ℂ)
    (f : ι → Lp ℂ 2 (volume : Measure ℝ)) :
    physicalColumnInput (V := V) (∑ v ∈ s, c v • f v) =
      ∑ v ∈ s, c v • physicalColumnInput (V := V) (f v) := by
  classical
  have h := map_sum ((ContinuousLinearMap.toSpanSingleton ℂ
    (EuclideanSpace.single (none : Option V) (1 : ℂ))).compLpL 2 (volume : Measure ℝ))
    (fun v => c v • f v) s
  simp only [map_smul] at h
  exact h

theorem memLp_normalized_of_bound {a r : ℝ} (hr : 0 < r) {f : ℝ → ℂ} (hf : Measurable f)
    {C : ℝ} (hC : ∀ x, ‖f x‖ ≤ C) : MemLp f 2 (normalizedIntervalMeasure a r) := by
  have := normalizedIntervalMeasure_probability a hr
  exact MemLp.of_bound hf.aestronglyMeasurable C (Filter.Eventually.of_forall hC)

