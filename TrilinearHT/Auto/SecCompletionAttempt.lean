/-- On cell inputs the cell form is the local form of the functions. -/
theorem cellForm_cellLp {κ : LocalKernelClass} {G : RealDyadicGrid} {I : ℤ × ℤ}
    {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) w)
    (Mc : ℕ) {f : Fin 4 → ℝ → ℂ}
    (hf : ∀ l, MemLp (f l) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))) :
    cellForm (dyadicGridLength_pos G I.1) hw (Fin Mc)
        (fun l => physicalColumnInput (cellLp G I (f l))) =
      localProgressionForm (dyadicGridLength G I.1) w f := by
  rw [cellForm_apply]
  exact localProgressionForm_congr_cell hw fun l => augPhys_cellLp (hf l)

