/-! ### Structural facts for the leaves of an attempt -/

/-- Each split adds one layer to one slot, so the layers grow by at most the search depth. -/
theorem searchLeaves_layers_length :
    ∀ (fuel ℓ h : ℕ) (up : Fin 4) (low : Option (Fin 4)) (ls : Fin 4 → List (ℕ × Bool)),
      ∀ L ∈ searchLeaves fuel ℓ h up low ls, ∀ l, (L.layers l).length ≤ (ls l).length + fuel := by
  intro fuel
  induction fuel with
  | zero =>
    intro ℓ h up low ls L hL l
    simp only [searchLeaves, List.mem_singleton] at hL
    subst hL; simp
  | succ fuel ih =>
    intro ℓ h up low ls L hL l
    simp only [searchLeaves] at hL
    split_ifs at hL with hlt
    · have key : ∀ b : Bool, ((Function.update ls (thirdSlot up low)
          (ls (thirdSlot up low) ++ [((ℓ + h) / 2, b)])) l).length ≤ (ls l).length + 1 := by
        intro b
        by_cases hl : l = thirdSlot up low
        · subst hl; simp
        · rw [Function.update_of_ne hl]; omega
      rcases List.mem_append.mp hL with hL | hL
      · have := ih _ _ _ _ _ L hL l; have := key false; omega
      · have := ih _ _ _ _ _ L hL l; have := key true; omega
    · rw [List.mem_singleton] at hL; subst hL; simp

theorem CatTest.pass_mono {Tg : Type*} (w : CatTest Tg) {G : RealDyadicGrid} {Mc : ℕ}
    {I : ℤ × ℤ} {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {wI : ℝ × ℝ → ℂ} {τ τ' : ℝ}
    {mH : ℕ} {cat : List (CatCol Tg)} (h : w.Pass G Mc I c₀ H tagOf wI τ mH cat) (hτ : τ ≤ τ') :
    w.Pass G Mc I c₀ H tagOf wI τ' mH cat := by
  intro x hx u a b hut hua hub hta htb hab A hA hAθ hAM hAq z hzu hzt hza hzb hza2 hzb2
  refine (h x hx hut hua hub hta htb hab A hA hAθ hAM hAq z hzu hzt hza hzb hza2 hzb2).trans ?_
  have hs := Real.sqrt_nonneg (dyadicGridLength G I.1)
  gcongr

