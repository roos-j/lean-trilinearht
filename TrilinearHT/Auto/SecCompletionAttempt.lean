    hτo hτm hτr hτ₂.le hSz0 hSz S.attach (fun v => a v) (fun v => φ v) X
    (fun v => quadraticChartAtom (Ax v)) hx'
    (fun v _ => ⟨Ax v, hAx v, hθ v, hM v, hq v, hae v⟩) (fun v _ => hae v) id Gs grp Mtop
