  have hgrp : ∀ v G₀, grp v = some G₀ → G₀ ∈ Gs ∧ ∀ p' : ℕ, ap.bmask I G₀ 1 p' (X v) := by
    intro v G₀ hg
    by_cases h : ∃ G ∈ Gs, ∀ p' : ℕ, ap.bmask I G 1 p' (X v)
    · have e : grp v = some (Classical.choose h) := dite_eq_left_of_eq_true (eq_true h)
