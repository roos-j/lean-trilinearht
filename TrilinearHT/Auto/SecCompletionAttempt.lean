/-- Square-summed coefficients bounded by the normalized input size are bounded in `ℓ¹` by the
square root of their number. -/
theorem sum_norm_le_of_l2 {ι : Type*} (S : Finset ι) (a : ι → ℂ) {X r Sz : ℝ} (hr : 0 < r)
    (hSz0 : 0 ≤ Sz) (hl2 : (∑ n ∈ S, ‖a n‖ ^ 2) * r ≤ X ^ 2) (hX : 0 ≤ X)
    (hSz : X / Real.sqrt r ≤ Sz) : ∑ n ∈ S, ‖a n‖ ≤ Real.sqrt S.card * Sz := by
  refine sum_norm_le_sqrt_card S a ?_ hSz0
  have hs := Real.sqrt_pos.mpr hr
  rw [div_le_iff₀ hs] at hSz
  have h4 : X ^ 2 ≤ (Sz * Real.sqrt r) ^ 2 := pow_le_pow_left₀ hX hSz 2
  rw [mul_pow, Real.sq_sqrt hr.le] at h4
  exact le_of_mul_le_mul_right (hl2.trans h4) hr

