open Classical in
/-- Blueprint prop:localize for an attempt with its counted catalogs (lines 1820-1856): there are
slot catalogs of same-tag templates such that, on a set of successful active cells of path
multiplicity at most `M_p`, the weighted cell minima of the slot inputs are at most the weighted
minima of the leaf main terms plus `Σ|I| · #leaves · 5 (D + 2)(S⁴ + |L| D_c S³) τ₃`. -/
theorem attempt_localization (L : List (ℤ × ℤ)) (hL : ∀ I ∈ L, I ∈ A.cells) (hnd : L.Nodup)
    (hord : ∀ i j (hi : i < L.length) (hj : j < L.length), i < j →
      ¬ dyadicGridCell A.G L[i].1 L[i].2 ⊆ dyadicGridCell A.G L[j].1 L[j].2)
    {D : ℕ} (hst : SameTagBound κ (A.csrc + 1) D) {Kt Mp : ℕ} (hKt1 : 1 ≤ Kt) (hMp1 : 1 ≤ Mp)
    (hKt : ∀ I l, Fintype.card (ap.TestIdx I l) ≤ Kt) {Tmax : ℕ}
    (hMc : L.length * Tmax ≤ ap.Mc) (n : ℕ → ℝ) (hn1 : ∀ r, 1 ≤ n r) (hnm : Monotone n)
    (hT : n (ap.Lc + 4) ≤ Tmax) {τ₃ : ℝ} (hτ₃ : 0 < τ₃) (hτ₃1 : τ₃ ≤ 1)
    (hratio : ∀ r ≤ ap.Lc + 1, n r * (Kt * (4 ^ ap.mH * projectionPrefixConstant Tmax ^ (2 * ap.mH))
      * (2 * Real.exp (D * (1 + Real.log A.Hsrc) ^ D)) ^ 2 * Mp * (ap.Lc + 6)) / τ₃ ^ 2 ≤
        n (r + 1))
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log (τ₃ / n (ap.Lc + 1))⁻¹) ^ A.Dg) ≤
      ap.Hed)
    (cs : Finset (ℤ × ℤ)) (hcsL : ∀ I ∈ cs, I ∈ L)
    (hMp : ∀ I ∈ cs, (L.toFinset.filter fun I' : ℤ × ℤ =>
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2).card ≤ Mp)
    (hsucc : ∀ I ∈ cs, ∀ w ∈ A.admT.X (A.admAt I),
      ap.K.Success (ap.K.colorData (A.admT.st (A.admAt I)) w))
    (hLcol : ∀ I ∈ cs, ∀ w ∈ A.admT.X (A.admAt I),
      ap.K.color A.admT A.vtxBound (A.admAt I) w ≤ ap.Lc)
    (hzB : ∀ I ∈ cs, ap.z I ap.up₀ = A.B ap.up₀ I)
    (hz : ∀ I ∈ cs, ∀ l, MemLp (ap.z I l) 2 (A.μ I))
    (hL1 : 1 ≤ ap.Lc) (hfuel : ap.Lc - 1 < 2 ^ ap.fuel) (hmH : ap.fuel ≤ ap.mH)
    (hPH : ap.bbase 1 + ap.P ≤ ap.Hmax) {Sz η : ℝ} (hη : 0 ≤ η) (hSz0 : 0 < Sz)
    (hSz : ∀ I ∈ cs, ∀ l, ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
      Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz) :
    ∃ cat : Fin 4 → List (CatCol A.Vtx), (∀ l,
      (∀ I ∈ L, ∀ w, (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc A.Hsrc A.vtag (A.w I)
        (ap.catTau Kt Mp (4 ^ ap.mH * projectionPrefixConstant Tmax ^ (2 * ap.mH))
          (2 * Real.exp (D * (1 + Real.log A.Hsrc) ^ D)) n (ap.tests (fun _ => []) I l w).r)
        ap.mH (cat l)) ∧
      (∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
        d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag) ∧
      (∀ I, (L.toFinset.filter fun I' : ℤ × ℤ =>
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G I'.1 I'.2).card ≤ Mp →
        ∀ r ≤ ap.Lc + 5, ∀ M, ((catLabels A.G ap.Mc (cat l) I r M).card : ℝ) ≤ n r) ∧
      (∀ d ∈ cat l, d.birth ∈ L) ∧ (cat l).length ≤ L.length * Tmax) ∧ ∀ cs' ⊆ cs,
      ∑ I ∈ cs', dyadicGridLength A.G I.1 * min η ‖A.Hf I (ap.z I)‖ ≤
        ∑ s ∈ Finset.range ap.leaves.length, ∑ I ∈ cs', dyadicGridLength A.G I.1 *
            min η ‖∑ G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k,
              ap.Λc I (fun l => (ap.filters cat I).ball G
                ((leafAt ap.fuel ap.Lc ap.up₀ s).role l) l
                ((ap.filters cat I).input (leafAt ap.fuel ap.Lc ap.up₀ s).layers l))‖ +
          (∑ I ∈ cs', dyadicGridLength A.G I.1) * (ap.leaves.length *
            (5 * (A.vtxBound + 2) * (Sz ^ 4 + Fintype.card A.L * A.Dc * Sz ^ 3) * τ₃)) := by
  set Q : ℝ := 4 ^ ap.mH * projectionPrefixConstant Tmax ^ (2 * ap.mH) with hQ
  set E : ℝ := 2 * Real.exp (D * (1 + Real.log A.Hsrc) ^ D) with hE
  have hQ0 : 0 ≤ Q := by have := projectionPrefixConstant_one_le Tmax; positivity
  have hn0 : ∀ r, 0 < n r := fun r => lt_of_lt_of_le one_pos (hn1 r)
  obtain ⟨cat, hcat⟩ := ap.catalogs_counted L hL hnd hord hst hKt1 hMp1 hKt hMc n hn0 hnm hT
  set τ := ap.catTau Kt Mp Q E n with hτ
  have hτ0 : ∀ r, 0 ≤ τ r := fun r => ap.catTau_nonneg _ _ _ _ _ r
  have hrat : ∀ r ≤ ap.Lc + 1, Real.sqrt (n r) * τ (r + 1) ≤ τ₃ := fun r hr =>
    ap.catTau_ratio hn0 hτ₃ hQ0 r (hratio r hr)
  have hτle : ∀ r ≤ ap.Lc + 1, τ (r + 1) ≤ τ₃ := fun r hr => by
    have h1 : 1 ≤ Real.sqrt (n r) := Real.one_le_sqrt.mpr (hn1 r)
    have := hτ0 (r + 1)
    nlinarith [hrat r hr]
  set τ₂ := τ₃ / n (ap.Lc + 1)
  have hτ₂ : 0 < τ₂ := div_pos hτ₃ (hn0 _)
  have hτ₂1 : τ₂ ≤ 1 := (div_le_one (hn0 _)).mpr (hτ₃1.trans (hn1 _))
  refine ⟨cat, fun l => ⟨(hcat l).1, (hcat l).2.1, (hcat l).2.2.1, (hcat l).2.2.2⟩,
    fun cs' hcs' => ?_⟩
  have h := ap.localized_sum cat (fun l => (hcat l).2.1) (τ := τ) cs'
    (fun I hI => hL I (hcsL I (hcs' hI))) (fun I hI l w => (hcat l).1 I (hcsL I (hcs' hI)) w)
    (fun I hI => hsucc I (hcs' hI)) (fun I hI => hLcol I (hcs' hI)) (fun I hI => hzB I (hcs' hI))
    (fun I hI => hz I (hcs' hI)) hL1 hfuel hmH hPH (τo := fun k => τ (ap.Lc - (k - 1) + 1))
    (Nu := fun k => n (ap.Lc - k + 1)) (τm := τ (ap.Lc + 1)) (τr := τ (ap.Lc + 2)) (τ₂ := τ₂)
    (Nt := n (ap.Lc + 1)) hη (fun k => hτ0 _) (hτ0 _) (hτ0 _) hτ₂ hτ₂1 hHed
    (fun k _ _ => le_rfl) le_rfl
    (fun j hj2 hj4 => ap.catTau_anti hn0 hnm hQ0 (by omega)) hSz0 (fun I hI => hSz I (hcs' hI))
    (fun I hI s => (hcat _).2.2.1 I (hMp I (hcs' hI)) _ (by omega) _)
    (fun I hI s G _ => (hcat _).2.2.1 I (hMp I (hcs' hI)) _ (by omega) _)
  have hcs0 : 0 ≤ ∑ I ∈ cs', dyadicGridLength A.G I.1 :=
    Finset.sum_nonneg fun I _ => (dyadicGridLength_pos A.G I.1).le
  refine h.trans (add_le_add (le_refl _) (mul_le_mul_of_nonneg_left ?_ hcs0))
  refine (Finset.sum_le_card_nsmul _ _ _ fun s hs => ?_).trans
    (by rw [Finset.card_range, nsmul_eq_mul])
  have hsL : s < ap.leaves.length := Finset.mem_range.mp hs
  obtain ⟨-, hk1, hkL, -⟩ := leafAt_facts (up₀ := ap.up₀) hL1 hfuel hsL
  set k := (leafAt ap.fuel ap.Lc ap.up₀ s).k
  have hku : ap.Lc - (k - 1) + 1 = (ap.Lc - k + 1) + 1 := by omega
  have hNt1 := hn1 (ap.Lc + 1)
  have hsNt : Real.sqrt (n (ap.Lc + 1)) ≤ n (ap.Lc + 1) := by
    rw [Real.sqrt_le_left (by linarith)]; nlinarith
  have hNuNt : Real.sqrt (n (ap.Lc - k + 1)) ≤ Real.sqrt (n (ap.Lc + 1)) :=
    Real.sqrt_le_sqrt (hnm (by omega))
  have hNuL : Real.sqrt (n (ap.Lc - k + 1)) ≤ Real.sqrt (n ap.Lc) :=
    Real.sqrt_le_sqrt (hnm (by omega))
  have hτ₂n : n (ap.Lc + 1) * τ₂ = τ₃ := by
    simp only [τ₂]; field_simp
  have hsu0 := Real.sqrt_nonneg (n (ap.Lc - k + 1))
  have hst0 := Real.sqrt_nonneg (n (ap.Lc + 1))
  refine A.leafErr_le (by positivity) hSz0.le (hτ0 _) ?_ ?_ ?_ ?_ ?_ ?_ ?_
  · rw [hku]; exact hrat _ (by omega)
  · rw [hku]; exact hτle _ (by omega)
  · exact (mul_le_mul_of_nonneg_right hNuL (hτ0 _)).trans (hrat _ (by omega))
  · exact hτle _ (by omega)
  · calc Real.sqrt (n (ap.Lc - k + 1)) * (Real.sqrt (n (ap.Lc + 1)) * τ₂)
        ≤ Real.sqrt (n (ap.Lc + 1)) * (Real.sqrt (n (ap.Lc + 1)) * τ₂) := by gcongr
      _ = n (ap.Lc + 1) * τ₂ := by
          rw [← mul_assoc, Real.mul_self_sqrt (by linarith)]
      _ = τ₃ := hτ₂n
  · calc Real.sqrt (n (ap.Lc + 1)) * τ₂ ≤ n (ap.Lc + 1) * τ₂ := by gcongr
      _ = τ₃ := hτ₂n
  · exact hrat _ (by omega)

