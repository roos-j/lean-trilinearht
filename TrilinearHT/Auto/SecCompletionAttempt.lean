theorem card_groupsAt_le (I : ℤ × ℤ) (k : ℕ) : (ap.groupsAt I k).card ≤ A.vtxBound := by
  classical
  unfold groupsAt
  exact Finset.card_image_le.trans ((Finset.card_filter_le _ _).trans (A.admT_X_card_le _))

/-- The cell form of an attempt (zero off the cells). -/
noncomputable def Λc (I : ℤ × ℤ) : MultilinearMap ℂ (fun _ : Fin 4 => ColumnL2 (Fin ap.Mc)) ℂ :=
  if h : I ∈ A.cells then cellForm (dyadicGridLength_pos A.G I.1) (A.adm I h) (Fin ap.Mc) else 0

theorem Λc_of_mem {I : ℤ × ℤ} (h : I ∈ A.cells) :
    ap.Λc I = cellForm (dyadicGridLength_pos A.G I.1) (A.adm I h) (Fin ap.Mc) :=
  dite_eq_left_of_eq_true (eq_true h)

open Classical in
/-- Blueprint prop:localize (lines 1838-1856) for an attempt, summed over a set of active cells
without failed vertices: the weighted cell minima of the local forms of the slot inputs are at
most the weighted minima of the leaf main terms (sums over the current groups of the forms of their
ball outputs) plus the weighted leaf errors. -/
theorem localized_sum (cat : Fin 4 → List (CatCol A.Vtx))
    (hT : ∀ l, ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag)
    {τ : ℕ → ℝ} (cs : Finset (ℤ × ℤ)) (hcs : cs ⊆ A.cells)
    (hpass : ∀ I ∈ cs, ∀ l (w : ap.TestIdx I l), (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I
      A.csrc A.Hsrc A.vtag (A.w I) (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l))
    (hsucc : ∀ I ∈ cs, ∀ w ∈ A.admT.X (A.admAt I),
      ap.K.Success (ap.K.colorData (A.admT.st (A.admAt I)) w))
