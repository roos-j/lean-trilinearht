theorem LocalValid.take {s : List Dt} (h : LocalValid rk rkW δ P Q θ m g s) (n : ℕ) :
    LocalValid rk rkW δ P Q θ m g (s.take n) := by
  intro j hj
  have hjn : j < n := by rw [List.length_take] at hj; omega
  have hjs : j < s.length := by rw [List.length_take] at hj; omega
  obtain ⟨w, hw, hgain⟩ := h j hjs
  refine ⟨w, by rw [hw, List.getElem_take], ?_⟩
  rwa [List.take_take, List.take_take, min_eq_left (by omega : j + 1 ≤ n),
    min_eq_left (by omega : j ≤ n)]

omit [CompleteSpace H] [Fintype W] in
theorem LocalValid.append {s : List Dt} (h : LocalValid rk rkW δ P Q θ m g s) {d : Dt} {w : W}
    (hw : rkW w = rk d)
    (hgain : δ (rkW w) * ‖g w‖ < ‖(P w (s ++ [d]) - P w s)
      (operatorComplementProduct (fun l => Q w l s) (θ w) m (g w))‖) :
    LocalValid rk rkW δ P Q θ m g (s ++ [d]) := by
  intro j hj
  rw [List.length_append, List.length_singleton] at hj
  by_cases hjs : j < s.length
  · obtain ⟨w', hw', hg'⟩ := h j hjs
    refine ⟨w', by rw [hw', List.getElem_append_left hjs], ?_⟩
    rwa [List.take_append_of_le_length (by omega), List.take_append_of_le_length (by omega)]
  · have hj' : j = s.length := by omega
    subst hj'
    refine ⟨w, by rw [hw, List.getElem_append_right (le_refl _)]; simp, ?_⟩
    rw [List.take_append_of_le_length le_rfl, List.take_length]
    rw [show s.length + 1 = (s ++ [d]).length by simp, List.take_length]
    exact hgain

/-- The insertions of one rank in a valid sequence (blueprint lines 1827-1829). -/
theorem LocalValid.rank_count (hP : ∀ w s, IsStarProjection (P w s))
    (hP1 : ∀ w s d, (P w s).comp (P w (s ++ [d])) = P w s)
    (hQ : ∀ w l, ∀ s, IsStarProjection (Q w l s))
    (hQ1 : ∀ w l s d, (Q w l s).comp (Q w l (s ++ [d])) = Q w l s)
    {s : List Dt} (h : LocalValid rk rkW δ P Q θ m g s) (r : ℕ) (hδ : 0 < δ r) :
    (((Finset.range s.length).filter (fun j => ∃ hj : j < s.length, rk s[j] = r)).card : ℝ) *
      δ r ^ 2 ≤ Fintype.card W * (4 ^ m * projectionPrefixConstant s.length ^ (2 * m)) := by
  classical
  set T := s.length
  set S0 := (Finset.range T).filter (fun j => ∃ hj : j < T, rk s[j] = r)
  set S := S0.image (· + 1)
  have hcard : S.card = S0.card := Finset.card_image_of_injective _ (fun a b h => by omega)
  have hex : ∀ n ∈ S, ∃ w : W, rkW w = r ∧
      δ r * ‖g w‖ < ‖(P w (s.take n) - P w (s.take (n - 1)))
        (operatorComplementProduct (fun l => Q w l (s.take (n - 1))) (θ w) m (g w))‖ := by
    intro n hn
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hn
    obtain ⟨-, hjT, hr⟩ := Finset.mem_filter.mp hj
    obtain ⟨w, hw, hg⟩ := h j hjT
    refine ⟨w, hw.trans hr, ?_⟩
    rw [← hw.trans hr]
    simpa using hg
  rcases S.eq_empty_or_nonempty with hSe | ⟨n₀, hn₀⟩
  · rw [← hcard, hSe, Finset.card_empty, Nat.cast_zero, zero_mul]
    exact mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (by positivity)
      (pow_nonneg (le_trans zero_le_one (projectionPrefixConstant_one_le _)) _))
  obtain ⟨w₀, -⟩ := hex n₀ hn₀
  let wit : ℕ → W := fun n => if hn : n ∈ S then Classical.choose (hex n hn) else w₀
  have hwit : ∀ n (hn : n ∈ S), wit n = Classical.choose (hex n hn) := fun n hn => by
    simp only [wit, hn, ↓reduceDIte]
  have hS : ∀ n ∈ S, 1 ≤ n ∧ n ≤ T := by
    intro n hn
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hn
    have := Finset.mem_range.mp (Finset.mem_filter.mp hj).1
    omega
  have key := catalog_rank_count (𝕜 := ℂ) T m (fun w l n => Q w l (s.take n))
    (fun w l _ n _ => hQ w l (s.take n))
    (fun w l _ i _ j _ hij => prefix_nest (Q w l) (hQ w l) (hQ1 w l) s hij) θ
    (fun w n => P w (s.take n)) (fun w n _ => hP w (s.take n))
    (fun w i _ j _ hij => prefix_nest (P w) (hP w) (hP1 w) s hij) g S hS wit hδ (by
      intro n hn
      rw [hwit n hn]
      exact (Classical.choose_spec (hex n hn)).2)
  rw [← hcard]
  exact key

/-- The cap argument (blueprint lines 1829-1831): if the rank counts allowed at the cap `T_max`
sum to less than `T_max`, every valid sequence is shorter than `T_max`. -/
theorem LocalValid.length_lt (hP : ∀ w s, IsStarProjection (P w s))
    (hP1 : ∀ w s d, (P w s).comp (P w (s ++ [d])) = P w s)
    (hQ : ∀ w l, ∀ s, IsStarProjection (Q w l s))
    (hQ1 : ∀ w l s d, (Q w l s).comp (Q w l (s ++ [d])) = Q w l s)
    (Rset : Finset ℕ) (hrk : ∀ d, rk d ∈ Rset) (hδ : ∀ r ∈ Rset, 0 < δ r) {Tmax : ℕ}
    (hcap : ∑ r ∈ Rset, Fintype.card W * (4 ^ m * projectionPrefixConstant Tmax ^ (2 * m)) /
      δ r ^ 2 < (Tmax : ℝ)) {s : List Dt} (h : LocalValid rk rkW δ P Q θ m g s) :
    s.length < Tmax := by
  classical
  by_contra hlt
  push Not at hlt
  set s' := s.take Tmax
  have hs' : s'.length = Tmax := by simp [s', List.length_take, min_eq_left hlt]
  have hv := h.take Tmax
  set f : ℕ → ℕ := fun j => if hj : j < s'.length then rk s'[j] else 0
  have hmaps : ∀ j ∈ Finset.range s'.length, f j ∈ Rset := by
    intro j hj
    have hj' := Finset.mem_range.mp hj
    simp only [f, hj', ↓reduceDIte]
    exact hrk _
  have hsum := Finset.card_eq_sum_card_fiberwise hmaps
  have hfib : ∀ r, (Finset.range s'.length).filter (fun j => f j = r) =
      (Finset.range s'.length).filter (fun j => ∃ hj : j < s'.length, rk s'[j] = r) := by
    intro r
    refine Finset.filter_congr fun j hj => ?_
    have hj' := Finset.mem_range.mp hj
    simp only [f, hj', ↓reduceDIte, exists_true_left]
  have hL : 0 ≤ Fintype.card W * (4 ^ m * projectionPrefixConstant Tmax ^ (2 * m)) :=
    mul_nonneg (Nat.cast_nonneg _) (mul_nonneg (by positivity)
      (pow_nonneg (le_trans zero_le_one (projectionPrefixConstant_one_le _)) _))
  have e0 : s'.length = ∑ r ∈ Rset, ((Finset.range s'.length).filter (fun j => f j = r)).card :=
    (Finset.card_range _).symm.trans hsum
  have e : projectionPrefixConstant s'.length = projectionPrefixConstant Tmax := by rw [hs']
  have hle : (Tmax : ℝ) ≤ ∑ r ∈ Rset,
      Fintype.card W * (4 ^ m * projectionPrefixConstant Tmax ^ (2 * m)) / δ r ^ 2 := by
    calc (Tmax : ℝ) = (s'.length : ℝ) := by rw [hs']
      _ = ((∑ r ∈ Rset, ((Finset.range s'.length).filter (fun j => f j = r)).card : ℕ) : ℝ) :=
          congrArg Nat.cast e0
      _ = ∑ r ∈ Rset, (((Finset.range s'.length).filter (fun j => f j = r)).card : ℝ) := by
          push_cast; rfl
      _ ≤ _ := by
          refine Finset.sum_le_sum fun r hr => ?_
          rw [hfib r, le_div_iff₀ (pow_pos (hδ r hr) 2)]
          have hc := hv.rank_count hP hP1 hQ hQ1 r (hδ r hr)
          rw [e] at hc
          exact hc
  linarith

/-- Blueprint lem:closure (lines 1820-1831), local form: if every failed test at a valid state
admits a justified insertion and the cap is not attained, some valid sequence passes all
tests. -/
theorem local_closure (hP : ∀ w s, IsStarProjection (P w s))
    (hP1 : ∀ w s d, (P w s).comp (P w (s ++ [d])) = P w s)
    (hQ : ∀ w l, ∀ s, IsStarProjection (Q w l s))
    (hQ1 : ∀ w l s d, (Q w l s).comp (Q w l (s ++ [d])) = Q w l s)
    (Rset : Finset ℕ) (hrk : ∀ d, rk d ∈ Rset) (hδ : ∀ r ∈ Rset, 0 < δ r) {Tmax : ℕ}
    (hcap : ∑ r ∈ Rset, Fintype.card W * (4 ^ m * projectionPrefixConstant Tmax ^ (2 * m)) /
      δ r ^ 2 < (Tmax : ℝ)) (Pass : W → List Dt → Prop)
    (hgain : ∀ s, LocalValid rk rkW δ P Q θ m g s → ∀ w, ¬ Pass w s → ∃ d, rkW w = rk d ∧
      δ (rkW w) * ‖g w‖ < ‖(P w (s ++ [d]) - P w s)
        (operatorComplementProduct (fun l => Q w l s) (θ w) m (g w))‖) :
    ∃ s, LocalValid rk rkW δ P Q θ m g s ∧ (∀ w, Pass w s) ∧ s.length < Tmax := by
  classical
  have hbd : ∀ s, LocalValid rk rkW δ P Q θ m g s → s.length < Tmax := fun s h =>
    h.length_lt hP hP1 hQ hQ1 Rset hrk hδ hcap
  set E : ℕ → Prop := fun n => ∃ s, LocalValid rk rkW δ P Q θ m g s ∧ s.length = n
  have hE0 : E 0 := ⟨[], fun j hj => absurd hj (by simp), rfl⟩
  set n₀ := Nat.findGreatest E Tmax
  obtain ⟨s, hs, hsl⟩ : E n₀ := Nat.findGreatest_spec (Nat.zero_le _) hE0
  refine ⟨s, hs, fun w => ?_, hbd s hs⟩
  by_contra hw
  obtain ⟨d, hd, hgd⟩ := hgain s hs w hw
  have hv := hs.append hd hgd
  have hlen : (s ++ [d]).length = n₀ + 1 := by simp [hsl]
  have hle : n₀ + 1 ≤ Tmax := by have := hbd _ hv; omega
  have := Nat.le_findGreatest hle (show E (n₀ + 1) from ⟨_, hv, hlen⟩)
  omega

end LocalClosure

/-! ### Catalog columns and their projections (blueprint lines 1805-1809) -/

/-- A catalog column: a bounded measurable atom with its birth cell, rank and tag (private
weight one). -/
structure CatCol (Tg : Type*) where
  atom : ℝ → ℂ
  meas : Measurable atom
  bound : ∀ y, ‖atom y‖ ≤ 1
  birth : ℤ × ℤ
  rank : ℕ
  tag : Tg

section CatalogProjections

variable (G : RealDyadicGrid) {Tg : Type*} (Mc : ℕ)

/-- The available catalog columns at the cell `I` of rank at most `r` with tag in the mask `M`,
restricted to `I`, on the preallocated labels `Fin Mc`. -/
def catSel (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    Set (ColumnL2 (Fin Mc)) :=
  {x | ∃ (n : Fin Mc) (hn : (n : ℕ) < s.length),
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G (s[(n : ℕ)]).birth.1 (s[(n : ℕ)]).birth.2 ∧
      (s[(n : ℕ)]).rank ≤ r ∧ M (s[(n : ℕ)]).tag ∧
        fitColumn (dyadicGridCell G I.1 I.2) (s[(n : ℕ)]).atom n = x}

/-- The catalog range at a cell. -/
noncomputable def catRange (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    Submodule ℂ (ColumnL2 (Fin Mc)) :=
  Submodule.span ℂ (catSel G Mc s I r M)

theorem catSel_finite (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    (catSel G Mc s I r M).Finite := by
  classical
  refine (Set.finite_range fun n : Fin Mc => if h : (n : ℕ) < s.length then
    fitColumn (dyadicGridCell G I.1 I.2) (s[(n : ℕ)]).atom n else 0).subset ?_
  rintro x ⟨n, hn, -, -, -, rfl⟩
  exact ⟨n, by simp only [hn, ↓reduceDIte]⟩

instance (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    FiniteDimensional ℂ (catRange G Mc s I r M) :=
  FiniteDimensional.span_of_finite ℂ (catSel_finite G Mc s I r M)

/-- The catalog projection at a cell. -/
noncomputable def catProj (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    ColumnL2 (Fin Mc) →L[ℂ] ColumnL2 (Fin Mc) :=
  (catRange G Mc s I r M).starProjection

theorem catProj_isStarProjection (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    IsStarProjection (catProj G Mc s I r M) := isStarProjection_starProjection

theorem catSel_mono (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) : catSel G Mc s I r M ⊆ catSel G Mc (s ++ [d]) I r M := by
  rintro x ⟨n, hn, h1, h2, h3, rfl⟩
  have hn' : (n : ℕ) < (s ++ [d]).length := by simp; omega
  have e : (s ++ [d])[(n : ℕ)]'hn' = s[(n : ℕ)]'hn := List.getElem_append_left hn
  exact ⟨n, hn', by rw [e]; exact ⟨h1, h2, h3, rfl⟩⟩

theorem catRange_mono (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) : catRange G Mc s I r M ≤ catRange G Mc (s ++ [d]) I r M :=
  Submodule.span_mono (catSel_mono G Mc s d I r M)

/-- Catalog projections are nested in the insertion index. -/
theorem catProj_nest (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) :
    (catProj G Mc s I r M).comp (catProj G Mc (s ++ [d]) I r M) = catProj G Mc s I r M :=
  Submodule.starProjection_comp_starProjection_of_le (catRange_mono G Mc s d I r M)

/-- Vectors whose coordinates from the label `n` on vanish. -/
def FreshFrom (n : ℕ) (x : ColumnL2 (Fin Mc)) : Prop :=
  ∀ m : Fin Mc, n ≤ (m : ℕ) → ∀ᵐ y ∂volume, (x : ℝ → ColumnHilbert (Fin Mc)) y (some m) = 0

variable {G Mc}

theorem FreshFrom.add {n : ℕ} {x x' : ColumnL2 (Fin Mc)} (h : FreshFrom Mc n x)
    (h' : FreshFrom Mc n x') : FreshFrom Mc n (x + x') := fun m hm => by
  filter_upwards [h m hm, h' m hm, Lp.coeFn_add x x'] with y hx hx' hy
  rw [hy, Pi.add_apply, PiLp.add_apply, hx, hx', add_zero]

theorem FreshFrom.smul {n : ℕ} {x : ColumnL2 (Fin Mc)} (h : FreshFrom Mc n x) (c : ℂ) :
    FreshFrom Mc n (c • x) := fun m hm => by
  filter_upwards [h m hm, Lp.coeFn_smul c x] with y hx hy
  rw [hy, Pi.smul_apply, PiLp.smul_apply, hx, smul_zero]

theorem FreshFrom.sub {n : ℕ} {x x' : ColumnL2 (Fin Mc)} (h : FreshFrom Mc n x)
    (h' : FreshFrom Mc n x') : FreshFrom Mc n (x - x') := by
  rw [sub_eq_add_neg, ← neg_one_smul ℂ x']
  exact h.add (h'.smul _)

theorem freshFrom_zero (n : ℕ) : FreshFrom Mc n (0 : ColumnL2 (Fin Mc)) := fun m _ => by
  filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin Mc)) 2 volume] with y hy
  rw [hy]; rfl

/-- The catalog ranges have vanishing coordinates beyond the current length. -/
theorem catRange_freshFrom (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    {x : ColumnL2 (Fin Mc)} (hx : x ∈ catRange G Mc s I r M) : FreshFrom Mc s.length x := by
  intro m hm
  refine Submodule.span_induction (R := ℂ) (M := ColumnL2 (Fin Mc)) (p := fun x _ =>
    ∀ᵐ y ∂volume, (x : ℝ → ColumnHilbert (Fin Mc)) y (some m) = 0) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨n, hn, -, -, -, rfl⟩
    have hne : m ≠ n := fun he => by rw [he] at hm; omega
    by_cases h : FitAdmissible (dyadicGridCell G I.1 I.2) (s[(n : ℕ)]).atom
    · filter_upwards [fitColumn_coeFn h n] with y hy
      rw [hy]
      by_cases hys : y ∈ dyadicGridCell G I.1 I.2
      · rw [Set.indicator_of_mem hys, fitColumnValue_some]
        simp only [hne, ↓reduceIte]
      · rw [Set.indicator_of_notMem hys]; rfl
    · unfold fitColumn
      simp only [h, ↓reduceDIte]
      filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin Mc)) 2 volume] with y hy
      rw [hy]; rfl
  · exact freshFrom_zero (Mc := Mc) s.length m hm
  · intro x y _ _ hx hy
    filter_upwards [hx, hy, Lp.coeFn_add x y] with z hx hy hz
    rw [hz, Pi.add_apply, PiLp.add_apply, hx, hy, add_zero]
  · intro c x _ hx
    filter_upwards [hx, Lp.coeFn_smul c x] with z hx hz
    rw [hz, Pi.smul_apply, PiLp.smul_apply, hx, smul_zero]

theorem catProj_freshFrom (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    (x : ColumnL2 (Fin Mc)) : FreshFrom Mc s.length (catProj G Mc s I r M x) :=
  catRange_freshFrom s I r M (Submodule.starProjection_apply_mem _ x)

theorem FreshFrom.mono {n n' : ℕ} (hn : n ≤ n') {x : ColumnL2 (Fin Mc)} (h : FreshFrom Mc n x) :
    FreshFrom Mc n' x := fun m hm => h m (hn.trans hm)

/-- Physical inputs have no private coordinates. -/
theorem physicalColumnInput_freshFrom (f : Lp ℂ 2 (volume : Measure ℝ)) (n : ℕ) :
    FreshFrom Mc n (physicalColumnInput (V := Fin Mc) f) := fun m _ => by
  classical
  filter_upwards [physicalColumnInput_coeFn (V := Fin Mc) f] with y hy
  rw [hy]
  simp

/-- The column of an appended catalog entry lies in the new range when it qualifies. -/
theorem fitColumn_mem_catRange (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) (hlen : s.length < Mc)
    (hI : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) (hr : d.rank ≤ r)
    (hM : M d.tag) :
    fitColumn (dyadicGridCell G I.1 I.2) d.atom (⟨s.length, hlen⟩ : Fin Mc) ∈
      catRange G Mc (s ++ [d]) I r M := by
  refine Submodule.subset_span ⟨⟨s.length, hlen⟩, by simp, ?_⟩
  have e : (s ++ [d])[s.length]'(by simp) = d := by simp
  simp only [e]
  exact ⟨hI, hr, hM, by trivial⟩

/-- The gain of an insertion (blueprint line 1825): the target projection grows on a vector
without fresh coordinates by at least the residual moment of the new column. -/
theorem catProj_gain (s : List (CatCol Tg)) (d : CatCol Tg) (I : ℤ × ℤ) (r : ℕ)
    (M : Tg → Prop) (hlen : s.length < Mc)
    (hI : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) (hr : d.rank ≤ r)
    (hM : M d.tag) (X : ColumnL2 (Fin Mc)) (hX : FreshFrom Mc s.length X) :
    ‖∫ y in dyadicGridCell G I.1 I.2, conj (d.atom y) *
        ((X - catProj G Mc s I r M X : ColumnL2 (Fin Mc)) : ℝ → ColumnHilbert (Fin Mc)) y none‖ ≤
      2 * Real.sqrt (dyadicGridLength G I.1) *
        ‖(catProj G Mc (s ++ [d]) I r M - catProj G Mc s I r M) X‖ := by
  set u := fitColumn (dyadicGridCell G I.1 I.2) d.atom (⟨s.length, hlen⟩ : Fin Mc) with hu
  set Pn := catProj G Mc (s ++ [d]) I r M
  set Po := catProj G Mc s I r M
  have hadm : FitAdmissible (dyadicGridCell G I.1 I.2) d.atom :=
    ⟨dyadicGridCell_measurable _ _ _, by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top,
      d.meas, d.bound⟩
  have hmem := fitColumn_mem_catRange s d I r M hlen hI hr hM
  -- the inner product with the residual
  have hfresh : FreshFrom Mc s.length (X - Po X) := hX.sub (catProj_freshFrom s I r M X)
  have hin := inner_fitColumn hadm (⟨s.length, hlen⟩ : Fin Mc) (X - Po X)
    (hfresh ⟨s.length, hlen⟩ le_rfl)
  rw [← hin]
  -- the inner product only sees the increment
  have hPu : Pn u = u := Submodule.starProjection_eq_self_iff.mpr hmem
  have key : inner ℂ u (X - Po X) = inner ℂ u ((Pn - Po) X) := by
    rw [sub_apply, inner_sub_right, inner_sub_right]
    congr 1
    calc inner ℂ u X = inner ℂ (Pn u) X := by rw [hPu]
      _ = inner ℂ u (Pn X) := Submodule.inner_starProjection_left_eq_right _ u X
  rw [key]
  have hcs := norm_inner_le_norm (𝕜 := ℂ) u ((Pn - Po) X)
  have hnorm := norm_fitColumn_sq_le hadm (⟨s.length, hlen⟩ : Fin Mc)
  rw [measureReal_def, dyadicGridCell_volume,
    ENNReal.toReal_ofReal (dyadicGridLength_pos G I.1).le] at hnorm
  have hu2 : ‖u‖ ≤ 2 * Real.sqrt (dyadicGridLength G I.1) := by
    rw [← Real.sqrt_sq (norm_nonneg u)]
    calc Real.sqrt (‖u‖ ^ 2) ≤ Real.sqrt (4 * dyadicGridLength G I.1) := Real.sqrt_le_sqrt hnorm
      _ = 2 * Real.sqrt (dyadicGridLength G I.1) := by
          rw [Real.sqrt_mul (by norm_num), show (4 : ℝ) = 2 ^ 2 by norm_num,
            Real.sqrt_sq (by norm_num)]
  exact hcs.trans (mul_le_mul_of_nonneg_right hu2 (norm_nonneg _))

end CatalogProjections

/-! ### Catalog tests at a cell and their closure (blueprint lines 1809-1831) -/

/-- A named catalog test (blueprint eq:catalog-test, lines 1809-1815): the residual slot `t`,
the target rank and tag mask, a history of at most `m` catalog filters (ranks, masks and
complement flags) and the base. -/
structure CatTest (Tg : Type*) where
  t : Fin 4
  r : ℕ
  M : Tg → Prop
  m : ℕ
  hr : ℕ → ℕ
  hM : ℕ → Tg → Prop
  θ : ℕ → Bool
  g : Lp ℂ 2 (volume : Measure ℝ)

namespace CatTest

variable (G : RealDyadicGrid) {Tg : Type*} (Mc : ℕ) (I : ℤ × ℤ) (w : CatTest Tg)

/-- The history factor of index `l` (the identity beyond the history length). -/
noncomputable def Q (s : List (CatCol Tg)) (l : ℕ) :
    ColumnL2 (Fin Mc) →L[ℂ] ColumnL2 (Fin Mc) :=
  if l < w.m then catProj G Mc s I (w.hr l) (w.hM l) else ContinuousLinearMap.id ℂ _

/-- The history value on the base. -/
noncomputable def hist (mH : ℕ) (s : List (CatCol Tg)) : ColumnL2 (Fin Mc) :=
  operatorComplementProduct (fun l => w.Q G Mc I s l) w.θ mH (physicalColumnInput w.g)

/-- The target residual of the history value. -/
noncomputable def resid (mH : ℕ) (s : List (CatCol Tg)) : ColumnL2 (Fin Mc) :=
  w.hist G Mc I mH s - catProj G Mc s I w.r w.M (w.hist G Mc I mH s)

theorem Q_isStarProjection (s : List (CatCol Tg)) (l : ℕ) :
    IsStarProjection (w.Q G Mc I s l) := by
  unfold Q; split_ifs
  · exact catProj_isStarProjection G Mc s I _ _
  · exact IsStarProjection.one _

theorem Q_nest (s : List (CatCol Tg)) (d : CatCol Tg) (l : ℕ) :
    (w.Q G Mc I s l).comp (w.Q G Mc I (s ++ [d]) l) = w.Q G Mc I s l := by
  unfold Q; split_ifs
  · exact catProj_nest G Mc s d I _ _
  · rfl

variable {G Mc I w}

theorem freshFrom_complementProduct (s : List (CatCol Tg)) (θ : ℕ → Bool) (n : ℕ)
    (hn : s.length ≤ n) : ∀ (k : ℕ) {x : ColumnL2 (Fin Mc)}, FreshFrom Mc n x →
      FreshFrom Mc n (operatorComplementProduct (fun l => w.Q G Mc I s l) θ k x)
  | 0, x, hx => hx
  | k + 1, x, hx => by
    have ih := freshFrom_complementProduct s θ n hn k hx
    set y := operatorComplementProduct (fun l => w.Q G Mc I s l) θ k x
    have hQ : FreshFrom Mc n (w.Q G Mc I s k y) := by
      unfold Q; split_ifs
      · exact (catProj_freshFrom s I _ _ y).mono hn
      · exact ih
    change FreshFrom Mc n ((if θ k then ContinuousLinearMap.id ℂ _ - w.Q G Mc I s k else
      w.Q G Mc I s k) y)
    split_ifs
    · rw [sub_apply]; exact ih.sub hQ
    · exact hQ

theorem hist_freshFrom (mH : ℕ) (s : List (CatCol Tg)) :
    FreshFrom Mc s.length (w.hist G Mc I mH s) :=
  freshFrom_complementProduct s w.θ s.length le_rfl mH (physicalColumnInput_freshFrom _ _)

end CatTest

/-- The physical coordinate of an augmented vector is measurable. -/
theorem columnPhys_measurable {V : Type*} [Fintype V] (x : ColumnL2 V) :
    Measurable fun y => (x : ℝ → ColumnHilbert V) y none := by
  have hev : Continuous fun x : ColumnHilbert V => x.ofLp none :=
    (continuous_apply none).comp (PiLp.continuous_ofLp 2 _)
  exact hev.measurable.comp (Lp.stronglyMeasurable _).measurable

theorem columnPhys_memLp_normalized {V : Type*} [Fintype V] (x : ColumnL2 V) (a₀ r : ℝ) :
    MemLp (fun y => (x : ℝ → ColumnHilbert V) y none) 2 (normalizedIntervalMeasure a₀ r) :=
  ((memLp_column_coord x none).restrict _).smul_measure ENNReal.ofReal_ne_top

/-- Integrals against the normalized measure of a cell are averages over the cell. -/
theorem integral_normalized_cell (G : RealDyadicGrid) (I : ℤ × ℤ) (f : ℝ → ℂ) :
    ∫ y, f y ∂(normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) =
      (dyadicGridLength G I.1 : ℂ)⁻¹ * ∫ y in dyadicGridCell G I.1 I.2, f y := by
  rw [integral_normalizedIntervalMeasure_eq (dyadicGridLength_pos G I.1)]
  congr 1
  exact setIntegral_congr_set Ico_ae_eq_Icc.symm

/-- The template column `ρ(d) e(R·d/9) e(γ y)` of a tag in slot `t`, born at `I` with rank `r`
(blueprint lines 1800-1803). -/
noncomputable def templateCol {Tg : Type*} (v : ChartTag) (t : Fin 4) (R : Fin v.dim → ℕ)
    (γ : ℝ) (I : ℤ × ℤ) (r : ℕ) (x : Tg) : CatCol Tg where
  atom := fun y => quadraticChartAtom (tagTemplateData v.θ v.C v.lam t R) y *
    (Real.fourierChar (γ * y) : ℂ)
  meas := (quadraticChartAtom_measurable _).mul
    ((continuous_subtype_val.comp (Real.continuous_fourierChar.comp
      (continuous_const.mul continuous_id))).measurable)
  bound := fun y => by
    rw [norm_mul, Circle.norm_coe, mul_one]
    exact tagTemplate_norm_le _ _ _ _ _ y
  birth := I
  rank := r
  tag := x

namespace CatTest

variable {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ} {I : ℤ × ℤ} (w : CatTest Tg)

/-- The test passes: every pure source column whose tag lies in the mask has form norm at most
`τ ‖base‖_{2,I}` against the target residual and two normalized `L²` spectators (blueprint
eq:catalog-test; `‖g‖ / √|I|` is the normalized norm of the base on its cell). -/
def Pass (G : RealDyadicGrid) (Mc : ℕ) (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ) (tagOf : Tg → ChartTag)
    (wI : ℝ × ℝ → ℂ) (τ : ℝ) (mH : ℕ) (s : List (CatCol Tg)) : Prop :=
  ∀ x, w.M x → ∀ {u a b : Fin 4}, u ≠ w.t → u ≠ a → u ≠ b → w.t ≠ a → w.t ≠ b → a ≠ b →
    ∀ A : QuadraticChartData (tagOf x).dim, QuadraticChartComplexity c₀ H A →
      A.horizontal = (tagOf x).θ → A.matrix = (slotCoeff u : ℚ) • (tagOf x).C →
      A.quadratic = slotCoeff u * (tagOf x).lam →
    ∀ z : Fin 4 → ℝ → ℂ, z u = quadraticChartAtom A →
      z w.t = (fun y => (w.resid G Mc I mH s : ℝ → ColumnHilbert (Fin Mc)) y none) →
      Measurable (z a) → Measurable (z b) →
      eLpNorm (z a) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≤ 1 →
      eLpNorm (z b) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≤ 1 →
      ‖localProgressionForm (dyadicGridLength G I.1) wI z‖ ≤
        τ * ‖physicalColumnInput (V := Fin Mc) w.g‖ / Real.sqrt (dyadicGridLength G I.1)

/-- A failed test is repaired by inserting a same-tag template at the cell (blueprint lines
1823-1825): the target projection grows on the old history value by more than
`τ / (2 H₀)` times the base norm. -/
theorem gain {κ : LocalKernelClass} {c₀ : ℕ} {D : ℕ}
    (hst : ∀ (H : ℝ), Real.exp 2 ≤ H → ∀ (v : ChartTag), 1 ≤ v.dim →
      ∀ {i j a b : Fin 4}, i ≠ j → i ≠ a → i ≠ b → j ≠ a → j ≠ b → a ≠ b →
      ∀ (A : QuadraticChartData v.dim), QuadraticChartComplexity c₀ H A →
      A.horizontal = v.θ → A.matrix = (slotCoeff i : ℚ) • v.C →
      A.quadratic = slotCoeff i * v.lam →
      ∀ {a₀ r : ℝ}, 0 < r → ∀ {w : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r w →
      ∀ (z : Fin 4 → ℝ → ℂ), z i = quadraticChartAtom A → Measurable (z j) →
      Measurable (z a) → Measurable (z b) → MemLp (z j) 2 (normalizedIntervalMeasure a₀ r) →
      eLpNorm (z a) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
      eLpNorm (z b) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
      ∃ R ∈ residueBox v.dim 9, ∃ γ : ℝ,
        ‖localProgressionForm r w z‖ ≤ Real.exp (D * (1 + Real.log H) ^ D) *
          ‖∫ y, z j y * (starRingEnd ℂ) (quadraticChartAtom
            (tagTemplateData v.θ v.C v.lam j R) y * (Real.fourierChar (γ * y) : ℂ))
              ∂(normalizedIntervalMeasure a₀ r)‖)
    {H : ℝ} (hH : Real.exp 2 ≤ H) {tagOf : Tg → ChartTag} (hdim : ∀ x, 1 ≤ (tagOf x).dim)
    {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {τ : ℝ} {mH : ℕ} {s : List (CatCol Tg)} (hlen : s.length < Mc)
    (hfail : ¬ w.Pass G Mc I c₀ H tagOf wI τ mH s) :
    ∃ d : CatCol Tg, d.rank = w.r ∧ d.birth = I ∧ w.M d.tag ∧
      (∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
        d = templateCol (tagOf d.tag) w.t R γ I w.r d.tag) ∧
      τ / (2 * Real.exp (D * (1 + Real.log H) ^ D)) * ‖physicalColumnInput (V := Fin Mc) w.g‖ <
        ‖(catProj G Mc (s ++ [d]) I w.r w.M - catProj G Mc s I w.r w.M)
          (operatorComplementProduct (fun l => w.Q G Mc I s l) w.θ mH
            (physicalColumnInput w.g))‖ := by
  set H₀ := Real.exp (D * (1 + Real.log H) ^ D) with hH₀
  set r := dyadicGridLength G I.1 with hr_def
  have hr : 0 < r := dyadicGridLength_pos G I.1
  unfold Pass at hfail
  push Not at hfail
  obtain ⟨x, hx, u, a, b, hut, hua, hub, hta, htb, hab, A, hA, hAθ, hAM, hAq, z, hzu, hzt, hza,
    hzb, hza2, hzb2, hlt⟩ := hfail
  have hztm : Measurable (z w.t) := by rw [hzt]; exact columnPhys_measurable _
  have hzt2 : MemLp (z w.t) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) r) := by
    rw [hzt]; exact columnPhys_memLp_normalized _ _ _
  obtain ⟨R, hR, γ, hbd⟩ := hst H hH (tagOf x) (hdim x) hut hua hub hta htb hab A hA hAθ hAM hAq
    hr hwI z hzu hztm hza hzb hzt2 hza2 hzb2
  set d : CatCol Tg := templateCol (tagOf x) w.t R γ I w.r x with hd
  refine ⟨d, rfl, rfl, hx, ⟨R, hR, γ, rfl⟩, ?_⟩
  have hgain := catProj_gain (G := G) s d I w.r w.M hlen subset_rfl le_rfl hx
    (w.hist G Mc I mH s) (hist_freshFrom mH s)
  -- the moment as an average over the cell
  have hmom : ∫ y, z w.t y * (starRingEnd ℂ) (quadraticChartAtom
      (tagTemplateData (tagOf x).θ (tagOf x).C (tagOf x).lam w.t R) y *
        (Real.fourierChar (γ * y) : ℂ)) ∂(normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) r) =
      (r : ℂ)⁻¹ * ∫ y in dyadicGridCell G I.1 I.2, conj (d.atom y) *
        ((w.hist G Mc I mH s - catProj G Mc s I w.r w.M (w.hist G Mc I mH s) : ColumnL2 (Fin Mc)) :
          ℝ → ColumnHilbert (Fin Mc)) y none := by
    rw [integral_normalized_cell G I]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    simp only [hzt]
    rw [mul_comm]
    rfl
  have hn : ‖((r : ℂ)⁻¹)‖ = r⁻¹ := by
    rw [norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr]
  rw [hmom, norm_mul, hn] at hbd
  have hsq : 0 < Real.sqrt r := Real.sqrt_pos.mpr hr
  have hH₀ : 0 < H₀ := Real.exp_pos _
  set q := ‖(catProj G Mc (s ++ [d]) I w.r w.M - catProj G Mc s I w.r w.M)
    (w.hist G Mc I mH s)‖ with hq
  change _ < q
  have h1 : ‖localProgressionForm r wI z‖ ≤ H₀ * (r⁻¹ * (2 * Real.sqrt r * q)) :=
    hbd.trans (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hgain
      (inv_nonneg.mpr hr.le)) hH₀.le)
  have e : r⁻¹ * (2 * Real.sqrt r * q) = 2 * q / Real.sqrt r := by
    rw [show r⁻¹ = (Real.sqrt r * Real.sqrt r)⁻¹ by rw [Real.mul_self_sqrt hr.le]]
    field_simp
  rw [e] at h1
  have h2 : τ * ‖physicalColumnInput (V := Fin Mc) w.g‖ / Real.sqrt r <
      H₀ * (2 * q / Real.sqrt r) := hlt.trans_le h1
  rw [mul_div_assoc', div_lt_div_iff_of_pos_right hsq] at h2
  rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
  linarith

end CatTest

theorem projectionPrefixConstant_mono {T T' : ℕ} (h : T ≤ T') :
    projectionPrefixConstant T ≤ projectionPrefixConstant T' := by
  unfold projectionPrefixConstant
  have : Nat.clog 2 (T + 1) ≤ Nat.clog 2 (T' + 1) := Nat.clog_mono_right 2 (by omega)
  have : (Nat.clog 2 (T + 1) : ℝ) ≤ Nat.clog 2 (T' + 1) := by exact_mod_cast this
  linarith

/-- Blueprint lem:closure at one active cell (lines 1820-1831): for finitely many named tests
at the cell, inserting same-tag templates born at the cell closes the catalog: every test
passes, fewer than `T_max` columns are inserted, and the insertions of each rank number at most
`|W| 4^m L^{2m} (2H₀/τ_r)²`, provided this allowance summed over the ranks stays below `T_max`. -/
theorem cell_closure {κ : LocalKernelClass} {c₀ : ℕ} {D : ℕ}
    (hst : ∀ (H : ℝ), Real.exp 2 ≤ H → ∀ (v : ChartTag), 1 ≤ v.dim →
      ∀ {i j a b : Fin 4}, i ≠ j → i ≠ a → i ≠ b → j ≠ a → j ≠ b → a ≠ b →
      ∀ (A : QuadraticChartData v.dim), QuadraticChartComplexity c₀ H A →
      A.horizontal = v.θ → A.matrix = (slotCoeff i : ℚ) • v.C →
      A.quadratic = slotCoeff i * v.lam →
      ∀ {a₀ r : ℝ}, 0 < r → ∀ {w : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r w →
      ∀ (z : Fin 4 → ℝ → ℂ), z i = quadraticChartAtom A → Measurable (z j) →
      Measurable (z a) → Measurable (z b) → MemLp (z j) 2 (normalizedIntervalMeasure a₀ r) →
      eLpNorm (z a) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
      eLpNorm (z b) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
      ∃ R ∈ residueBox v.dim 9, ∃ γ : ℝ,
        ‖localProgressionForm r w z‖ ≤ Real.exp (D * (1 + Real.log H) ^ D) *
          ‖∫ y, z j y * (starRingEnd ℂ) (quadraticChartAtom
            (tagTemplateData v.θ v.C v.lam j R) y * (Real.fourierChar (γ * y) : ℂ))
              ∂(normalizedIntervalMeasure a₀ r)‖)
    {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ} {H : ℝ} (hH : Real.exp 2 ≤ H)
    {tagOf : Tg → ChartTag} (hdim : ∀ x, 1 ≤ (tagOf x).dim) {I : ℤ × ℤ} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {W : Type*} [Fintype W] (tests : W → CatTest Tg) (mH : ℕ) (τ : ℕ → ℝ)
    (hτ : ∀ w, 0 < τ (tests w).r) (s₀ : List (CatCol Tg)) {Tmax : ℕ}
    (hMc : s₀.length + Tmax ≤ Mc)
    (hcap : ∑ r ∈ Finset.univ.image (fun w => (tests w).r),
      Fintype.card W * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) /
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 < (Tmax : ℝ)) :
    ∃ s : List (CatCol Tg), (∀ d ∈ s, d.birth = I ∧ ∃ w, d.rank = (tests w).r ∧
        (tests w).M d.tag ∧ ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (tagOf d.tag) (tests w).t R γ I (tests w).r d.tag) ∧ s.length < Tmax ∧
      (∀ w, (tests w).Pass G Mc I c₀ H tagOf wI (τ (tests w).r) mH (s₀ ++ s)) ∧
      ∀ r, (((Finset.range s.length).filter
        (fun j => ∃ hj : j < s.length, s[j].rank = r)).card : ℝ) *
          (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 ≤
        Fintype.card W * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ≤ 0 := by
  classical
  set H₀ := Real.exp (D * (1 + Real.log H) ^ D) with hH₀
  have hH₀p : 0 < H₀ := Real.exp_pos _
  -- the insertable columns
  let Dt := {d : CatCol Tg // d.birth = I ∧ ∃ w, d.rank = (tests w).r ∧ (tests w).M d.tag ∧
    ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (tagOf d.tag) (tests w).t R γ I (tests w).r d.tag}
  let cat : List Dt → List (CatCol Tg) := fun s => s₀ ++ s.map Subtype.val
  have hcat : ∀ (s : List Dt) (d : Dt), cat (s ++ [d]) = cat s ++ [d.1] := by
    intro s d; simp only [cat, List.map_append, List.map_cons, List.map_nil, List.append_assoc]
  set Rset := Finset.univ.image (fun w => (tests w).r)
  set δ : ℕ → ℝ := fun r => τ r / (2 * H₀)
  set P : W → List Dt → ColumnL2 (Fin Mc) →L[ℂ] ColumnL2 (Fin Mc) :=
    fun w s => catProj G Mc (cat s) I (tests w).r (tests w).M
  set Q : W → ℕ → List Dt → ColumnL2 (Fin Mc) →L[ℂ] ColumnL2 (Fin Mc) :=
    fun w l s => (tests w).Q G Mc I (cat s) l
  have hP : ∀ w s, IsStarProjection (P w s) := fun w s => catProj_isStarProjection _ _ _ _ _ _
  have hP1 : ∀ w s d, (P w s).comp (P w (s ++ [d])) = P w s := fun w s d => by
    simp only [P, hcat]; exact catProj_nest _ _ _ _ _ _ _
  have hQ : ∀ w l s, IsStarProjection (Q w l s) := fun w l s =>
    CatTest.Q_isStarProjection _ _ _ _ _ _
  have hQ1 : ∀ w l s d, (Q w l s).comp (Q w l (s ++ [d])) = Q w l s := fun w l s d => by
    simp only [Q, hcat]; exact CatTest.Q_nest _ _ _ _ _ _ _
  have hrk : ∀ d : Dt, d.1.rank ∈ Rset := fun d => by
    obtain ⟨w, hw, -⟩ := d.2.2
    exact Finset.mem_image.mpr ⟨w, Finset.mem_univ _, hw.symm⟩
  have hδ : ∀ r ∈ Rset, 0 < δ r := fun r hr => by
    obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hr
    exact div_pos (hτ w) (by positivity)
  have hbd : ∀ s : List Dt, LocalValid (fun d : Dt => d.1.rank) (fun w => (tests w).r) δ P Q
      (fun w => (tests w).θ) mH (fun w => physicalColumnInput (tests w).g) s →
      s.length < Tmax := fun s h =>
    h.length_lt hP hP1 hQ hQ1 Rset hrk hδ hcap
  obtain ⟨s, hs, hpass, hlen⟩ := local_closure (rk := fun d : Dt => d.1.rank)
    (rkW := fun w => (tests w).r) (δ := δ) (P := P) (Q := Q) (θ := fun w => (tests w).θ)
    (m := mH) (g := fun w => physicalColumnInput (tests w).g) hP hP1 hQ hQ1 Rset hrk hδ hcap
    (fun w s => (tests w).Pass G Mc I c₀ H tagOf wI (τ (tests w).r) mH (cat s)) (by
      intro s hs w hw
      have hlen : (cat s).length < Mc := by
        have := hbd s hs
        simp only [cat, List.length_append, List.length_map]
        omega
      obtain ⟨d, hdr, hdb, hdM, hdt, hg⟩ := (tests w).gain hst hH hdim hwI hlen hw
      refine ⟨⟨d, hdb, w, hdr, hdM, hdt⟩, hdr.symm, ?_⟩
      simp only [P, Q, hcat]
      exact hg)
  refine ⟨s.map Subtype.val, fun d hd => ?_, by simpa using hlen, hpass, fun r => ?_⟩
  · obtain ⟨d', -, rfl⟩ := List.mem_map.mp hd
    exact d'.2
  · by_cases hr : δ r ≤ 0
    · exact Or.inr hr
    · left
      have hc := hs.rank_count hP hP1 hQ hQ1 r (lt_of_not_ge hr)
      have hL : projectionPrefixConstant s.length ≤ projectionPrefixConstant Tmax :=
        projectionPrefixConstant_mono hlen.le
      have hL0 : 0 ≤ projectionPrefixConstant s.length :=
        le_trans zero_le_one (projectionPrefixConstant_one_le _)
      refine le_trans (le_of_eq ?_) (hc.trans (mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hL0 hL _) (by positivity))
        (Nat.cast_nonneg _)))
      simp only [List.length_map, List.getElem_map]
      rfl

/-! ### The catalog over the tree (blueprint lines 1820-1831) -/

section TreeClosure

variable {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ}

variable (G Mc) in
theorem catSel_mono_append (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) :
    catSel G Mc s I r M ⊆ catSel G Mc (s ++ t) I r M := by
  rintro x ⟨n, hn, h1, h2, h3, rfl⟩
  have hn' : (n : ℕ) < (s ++ t).length := by simp; omega
  have e : (s ++ t)[(n : ℕ)]'hn' = s[(n : ℕ)]'hn := List.getElem_append_left hn
  exact ⟨n, hn', by rw [e]; exact ⟨h1, h2, h3, rfl⟩⟩

/-- Columns born at cells not containing `I` do not change the catalog at `I`. -/
theorem catSel_append_irrel (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    catSel G Mc (s ++ t) I r M = catSel G Mc s I r M := by
  ext x
  constructor
  · rintro ⟨n, hn, h1, h2, h3, rfl⟩
    by_cases hns : (n : ℕ) < s.length
    · have e : (s ++ t)[(n : ℕ)]'hn = s[(n : ℕ)]'hns := List.getElem_append_left hns
      rw [e] at h1 h2 h3 ⊢
      exact ⟨n, hns, h1, h2, h3, rfl⟩
    · exfalso
      have hmem : (s ++ t)[(n : ℕ)]'hn ∈ t := by
        rw [List.getElem_append_right (by omega)]
        exact List.getElem_mem _
      exact ht _ hmem h1
  · intro hx
    exact catSel_mono_append G Mc s t I r M hx

theorem catProj_append_irrel (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    catProj G Mc (s ++ t) I r M = catProj G Mc s I r M := by
  have h : catRange G Mc (s ++ t) I r M = catRange G Mc s I r M := by
    unfold catRange; rw [catSel_append_irrel s t I r M ht]
  unfold catProj
  ext x : 1
  exact starProjection_congr h x

theorem CatTest.resid_append_irrel (w : CatTest Tg) (I : ℤ × ℤ) (mH : ℕ)
    (s t : List (CatCol Tg))
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    w.resid G Mc I mH (s ++ t) = w.resid G Mc I mH s := by
  have hQ : (fun l => w.Q G Mc I (s ++ t) l) = fun l => w.Q G Mc I s l := by
    funext l; unfold CatTest.Q; split_ifs
    · exact catProj_append_irrel s t I _ _ ht
    · rfl
  unfold CatTest.resid CatTest.hist
  rw [hQ, catProj_append_irrel s t I _ _ ht]

theorem CatTest.pass_append_irrel (w : CatTest Tg) (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ)
    (tagOf : Tg → ChartTag) (wI : ℝ × ℝ → ℂ) (τ : ℝ) (mH : ℕ) (s t : List (CatCol Tg))
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    w.Pass G Mc I c₀ H tagOf wI τ mH (s ++ t) ↔ w.Pass G Mc I c₀ H tagOf wI τ mH s := by
  unfold CatTest.Pass
  rw [w.resid_append_irrel I mH s t ht]

theorem card_range_filter_getElem {α : Type*} (s : List α) (p : α → Prop) [DecidablePred p] :
    ((Finset.range s.length).filter (fun j => ∃ hj : j < s.length, p s[j])).card =
      (s.filter (fun d => decide (p d))).length := by
  induction s using List.reverseRecOn with
  | nil => simp
  | append_singleton s d ih =>
    rw [show Finset.range (s ++ [d]).length = insert s.length (Finset.range s.length) by
      rw [List.length_append, List.length_singleton, Finset.range_add_one], Finset.filter_insert]
    have hcongr : (Finset.range s.length).filter (fun j => ∃ hj : j < (s ++ [d]).length,
        p (s ++ [d])[j]) =
          (Finset.range s.length).filter (fun j => ∃ hj : j < s.length, p s[j]) := by
      refine Finset.filter_congr fun j hj => ?_
      have hjs := Finset.mem_range.mp hj
      constructor
      · rintro ⟨_, h⟩; exact ⟨hjs, by rwa [List.getElem_append_left hjs] at h⟩
      · rintro ⟨_, h⟩; exact ⟨by simp; omega, by rwa [List.getElem_append_left hjs]⟩
    have hlast : (s ++ [d])[s.length]'(by simp) = d := by simp
    rw [hcongr]
    by_cases hd : p d
    · have hc : ∃ hj : s.length < (s ++ [d]).length, p (s ++ [d])[s.length] :=
        ⟨by simp, by rw [hlast]; exact hd⟩
      rw [ite_eq_left hc, Finset.card_insert_of_notMem (by simp), ih]
      simp [List.filter_append, hd]
    · have hc : ¬ ∃ hj : s.length < (s ++ [d]).length, p (s ++ [d])[s.length] := by
        rintro ⟨_, h⟩; rw [hlast] at h; exact hd h
      rw [ite_eq_right hc, ih]
      simp [List.filter_append, hd]

end TreeClosure

/-- The conclusion of `sameTagTemplateTest` for a fixed exponent `D`. -/
def SameTagBound (κ : LocalKernelClass) (c₀ D : ℕ) : Prop :=
  ∀ (H : ℝ), Real.exp 2 ≤ H → ∀ (v : ChartTag), 1 ≤ v.dim →
    ∀ {i j a b : Fin 4}, i ≠ j → i ≠ a → i ≠ b → j ≠ a → j ≠ b → a ≠ b →
    ∀ (A : QuadraticChartData v.dim), QuadraticChartComplexity c₀ H A →
    A.horizontal = v.θ → A.matrix = (slotCoeff i : ℚ) • v.C →
    A.quadratic = slotCoeff i * v.lam →
    ∀ {a₀ r : ℝ}, 0 < r → ∀ {w : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r w →
    ∀ (z : Fin 4 → ℝ → ℂ), z i = quadraticChartAtom A → Measurable (z j) →
    Measurable (z a) → Measurable (z b) → MemLp (z j) 2 (normalizedIntervalMeasure a₀ r) →
    eLpNorm (z a) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
    eLpNorm (z b) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
    ∃ R ∈ residueBox v.dim 9, ∃ γ : ℝ,
      ‖localProgressionForm r w z‖ ≤ Real.exp (D * (1 + Real.log H) ^ D) *
        ‖∫ y, z j y * (starRingEnd ℂ) (quadraticChartAtom
          (tagTemplateData v.θ v.C v.lam j R) y * (Real.fourierChar (γ * y) : ℂ))
            ∂(normalizedIntervalMeasure a₀ r)‖

theorem sameTagBound_exists (κ : LocalKernelClass) (c₀ : ℕ) (hc : 1 ≤ c₀) :
    ∃ D : ℕ, 1 ≤ D ∧ SameTagBound κ c₀ D :=
  sameTagTemplateTest κ c₀ hc

/-- Blueprint lem:closure over a finite tree (lines 1820-1831): processing the cells with
ancestors first and closing the catalog at each cell (`cell_closure`) gives one catalog that
passes all tests at all cells; the columns born at a cell are its own insertions, with the rank
counts of `cell_closure`. -/
theorem tree_closure {κ : LocalKernelClass} {c₀ D : ℕ} (hst : SameTagBound κ c₀ D)
    {G : RealDyadicGrid} {Tg : Type*} {H : ℝ} (hH : Real.exp 2 ≤ H) {tagOf : Tg → ChartTag}
    (hdim : ∀ x, 1 ≤ (tagOf x).dim) (L : List (ℤ × ℤ)) (hnd : L.Nodup)
    (hord : ∀ i j (hi : i < L.length) (hj : j < L.length), i < j →
      ¬ dyadicGridCell G L[i].1 L[i].2 ⊆ dyadicGridCell G L[j].1 L[j].2)
    (wI : ℤ × ℤ → ℝ × ℝ → ℂ)
    (hwI : ∀ I ∈ L, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)
      (wI I))
    (W : ℤ × ℤ → Type*) [∀ I, Fintype (W I)] (tests : ∀ I, W I → CatTest Tg) (mH : ℕ)
    (τ : ℕ → ℝ) (hτ : ∀ I w, 0 < τ (tests I w).r) {Tmax Mc : ℕ} (hMc : L.length * Tmax ≤ Mc)
    (hcap : ∀ I ∈ L, ∑ r ∈ Finset.univ.image (fun w => (tests I w).r),
      Fintype.card (W I) * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) /
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 < (Tmax : ℝ)) :
    ∃ cat : List (CatCol Tg),
      (∀ I ∈ L, ∀ w, (tests I w).Pass G Mc I c₀ H tagOf (wI I) (τ (tests I w).r) mH cat) ∧
      (∀ d ∈ cat, d.birth ∈ L ∧ ∃ w, d.rank = (tests d.birth w).r ∧ (tests d.birth w).M d.tag ∧
        ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (tagOf d.tag) (tests d.birth w).t R γ d.birth (tests d.birth w).r d.tag) ∧
      (∀ I ∈ L, ∀ r, ((cat.filter (fun d => decide (d.birth = I ∧ d.rank = r))).length : ℝ) *
          (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 ≤
        Fintype.card (W I) * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨
        τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D)) ≤ 0) ∧
      cat.length ≤ L.length * Tmax := by
  classical
  set δ : ℕ → ℝ := fun r => τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))
  -- the invariant after the first `n` cells
  set c : ℕ → ℤ × ℤ := fun i => L.getD i (0, 0) with hc
  have hcL : ∀ i (hi : i < L.length), c i = L[i] := fun i hi => by
    simp only [hc, List.getD_eq_getElem _ _ hi]
  have key : ∀ n, n ≤ L.length → ∃ cat : List (CatCol Tg),
      (∀ i < n, ∀ w, (tests (c i) w).Pass G Mc (c i) c₀ H tagOf (wI (c i))
        (τ (tests (c i) w).r) mH cat) ∧
      (∀ d ∈ cat, ∃ i < n, d.birth = c i ∧
        ∃ w, d.rank = (tests d.birth w).r ∧ (tests d.birth w).M d.tag ∧
          ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
            d = templateCol (tagOf d.tag) (tests d.birth w).t R γ d.birth (tests d.birth w).r
              d.tag) ∧
      (∀ i < n, ∀ r, ((cat.filter (fun d => decide (d.birth = c i ∧ d.rank = r))).length : ℝ) *
          δ r ^ 2 ≤ Fintype.card (W (c i)) *
            (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨ δ r ≤ 0) ∧
      cat.length ≤ n * Tmax := by
    intro n
    induction n with
    | zero =>
      intro _
      exact ⟨[], fun i hi => absurd hi (Nat.not_lt_zero _), fun d hd => absurd hd (by simp),
        fun i hi => absurd hi (Nat.not_lt_zero _), by simp⟩
    | succ n ih =>
      intro hn
      obtain ⟨cat, hpass, hbirth, hcount, hlen⟩ := ih (by omega)
      set I := c n with hI
      have hIL : I ∈ L := by rw [hI, hcL n (by omega)]; exact List.getElem_mem _
      obtain ⟨s, hs, hslen, hspass, hscount⟩ := cell_closure hst hH hdim (hwI I hIL) (tests I) mH
        τ (hτ I) cat (Tmax := Tmax) (Mc := Mc) (by
          have := Nat.mul_le_mul_right Tmax hn
          rw [Nat.succ_mul] at this
          omega) (hcap I hIL)
      have hinj : ∀ i j, i < L.length → j < L.length → c i = c j → i = j := by
        intro i j hi hj he
        rw [hcL i hi, hcL j hj] at he
        exact (List.Nodup.getElem_inj_iff hnd).mp he
      -- the earlier cells are not affected
      have hirr : ∀ i < n, ∀ d ∈ s,
          ¬ dyadicGridCell G (c i).1 (c i).2 ⊆ dyadicGridCell G d.birth.1 d.birth.2 := by
        intro i hi d hd
        rw [(hs d hd).1, hI, hcL i (by omega), hcL n (by omega)]
        exact hord i n (by omega) (by omega) hi
      -- the births of the old catalog are earlier cells
      have hold : ∀ d ∈ cat, d.birth ≠ I := by
        intro d hd he
        obtain ⟨i, hi, hdi, -⟩ := hbirth d hd
        have := hinj i n (by omega) (by omega) (hdi.symm.trans he)
        omega
      refine ⟨cat ++ s, fun i hi w => ?_, fun d hd => ?_, fun i hi r => ?_, ?_⟩
      · by_cases hin : i < n
        · exact ((tests _ w).pass_append_irrel _ c₀ H tagOf _ _ mH cat s (hirr i hin)).mpr
            (hpass i hin w)
        · have hi' : i = n := by omega
          subst hi'
          exact hspass w
      · rcases List.mem_append.mp hd with hd | hd
        · obtain ⟨i, hi, h1, h2⟩ := hbirth d hd
          exact ⟨i, by omega, h1, h2⟩
        · obtain ⟨h1, h2⟩ := hs d hd
          refine ⟨n, by omega, h1, ?_⟩
          rw [h1]; exact h2
      · rw [List.filter_append, List.length_append]
        by_cases hin : i < n
        · have h0 : (s.filter (fun d => decide (d.birth = c i ∧ d.rank = r))).length = 0 := by
            rw [List.length_eq_zero_iff, List.filter_eq_nil_iff]
            intro d hd
            simp only [decide_eq_true_eq, not_and]
            intro he
            rw [(hs d hd).1] at he
            have := hinj n i (by omega) (by omega) he
            omega
          rw [h0, Nat.add_zero]
          exact hcount i hin r
        · have hi' : i = n := by omega
          subst hi'
          have h0 : (cat.filter (fun d => decide (d.birth = I ∧ d.rank = r))).length = 0 := by
            rw [List.length_eq_zero_iff, List.filter_eq_nil_iff]
            intro d hd
            simp only [decide_eq_true_eq, not_and]
            intro he
            exact absurd he (hold d hd)
          rw [h0, Nat.zero_add]
          have hfs : s.filter (fun d => decide (d.birth = I ∧ d.rank = r)) =
              s.filter (fun d => decide (d.rank = r)) := by
            refine List.filter_congr fun d hd => ?_
            simp [(hs d hd).1]
          rw [hfs, ← card_range_filter_getElem s (fun d => d.rank = r)]
          exact hscount r
      · rw [List.length_append, Nat.succ_mul]
        omega
  obtain ⟨cat, hpass, hbirth, hcount, hlen⟩ := key L.length le_rfl
  refine ⟨cat, fun I hI => ?_, fun d hd => ?_, fun I hI r => ?_, hlen⟩
  · obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hI
    rw [← hcL i hi]
    exact hpass i hi
  · obtain ⟨i, hi, h1, h2⟩ := hbirth d hd
    exact ⟨by rw [h1, hcL i hi]; exact List.getElem_mem _, h2⟩
  · obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hI
    rw [← hcL i hi]
    exact hcount i hi r

/-! ### Expansion of catalog outputs into columns (blueprint lemma coeff, lines 488-497) -/

section CatalogExpansion

variable {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ}

open scoped Classical in
/-- The labels of the selected catalog columns at a cell. -/
noncomputable def catLabels (G : RealDyadicGrid) (Mc : ℕ) (s : List (CatCol Tg)) (I : ℤ × ℤ)
    (r : ℕ) (M : Tg → Prop) : Finset (Fin Mc) :=
  Finset.univ.filter fun n : Fin Mc => ∃ hn : (n : ℕ) < s.length,
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G (s[(n : ℕ)]).birth.1 (s[(n : ℕ)]).birth.2 ∧
      (s[(n : ℕ)]).rank ≤ r ∧ M (s[(n : ℕ)]).tag

/-- The atom of a label (zero beyond the catalog). -/
noncomputable def catAtom (s : List (CatCol Tg)) (n : ℕ) : ℝ → ℂ :=
  if h : n < s.length then (s[n]).atom else 0

theorem catAtom_measurable (s : List (CatCol Tg)) (n : ℕ) : Measurable (catAtom s n) := by
  unfold catAtom; split_ifs
  · exact (s[n]).meas
  · exact measurable_const

theorem catAtom_bound (s : List (CatCol Tg)) (n : ℕ) (y : ℝ) : ‖catAtom s n y‖ ≤ 1 := by
  unfold catAtom; split_ifs
  · exact (s[n]).bound y
  · simp

theorem catAtom_admissible (s : List (CatCol Tg)) (n : ℕ) (I : ℤ × ℤ) :
    FitAdmissible (dyadicGridCell G I.1 I.2) (catAtom s n) :=
  ⟨dyadicGridCell_measurable _ _ _, by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top,
    catAtom_measurable s n, catAtom_bound s n⟩

theorem catRange_exists_coeff {s : List (CatCol Tg)} {I : ℤ × ℤ} {r : ℕ} {M : Tg → Prop}
    {x : ColumnL2 (Fin Mc)} (hx : x ∈ catRange G Mc s I r M) :
    ∃ c : Fin Mc → ℂ, x = ∑ n ∈ catLabels G Mc s I r M,
      c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n := by
  classical
  refine Submodule.span_induction (R := ℂ) (M := ColumnL2 (Fin Mc)) (p := fun x _ =>
    ∃ c : Fin Mc → ℂ, x = ∑ n ∈ catLabels G Mc s I r M,
      c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n) ?_ ?_ ?_ ?_ hx
  · rintro x ⟨i, hi, h1, h2, h3, rfl⟩
    refine ⟨Pi.single i (1 : ℂ), ?_⟩
    have hmem : i ∈ catLabels G Mc s I r M :=
      Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi, h1, h2, h3⟩
    rw [Finset.sum_eq_single i]
    · simp [catAtom, hi]
    · intro b _ hb; simp [hb]
    · intro h; exact absurd hmem h
  · exact ⟨0, by simp⟩
  · rintro x y _ _ ⟨c, rfl⟩ ⟨d, rfl⟩
    exact ⟨c + d, by simp [add_smul, Finset.sum_add_distrib]⟩
  · rintro a x _ ⟨c, rfl⟩
    exact ⟨a • c, by simp [Finset.smul_sum, smul_smul]⟩

/-- The pointwise form of a combination of catalog columns on the cell. -/
theorem catCombination_coeFn (s : List (CatCol Tg)) (I : ℤ × ℤ) (F : Finset (Fin Mc))
    (c : Fin Mc → ℂ) :
    ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
      ((∑ n ∈ F, c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n :
        ColumnL2 (Fin Mc)) : ℝ → ColumnHilbert (Fin Mc)) y =
        ∑ n ∈ F, c n • fitColumnValue (catAtom s n) n y := by
  have hcol : ∀ n : Fin Mc, ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
      ((c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n : ColumnL2 (Fin Mc)) :
        ℝ → ColumnHilbert (Fin Mc)) y = c n • fitColumnValue (catAtom s n) n y := by
    intro n
    filter_upwards [Lp.coeFn_smul (c n) (fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n),
      fitColumn_coeFn (catAtom_admissible (G := G) s n I) n] with y h1 h2 hys
    rw [h1, Pi.smul_apply, h2, Set.indicator_of_mem hys]
  have hall : ∀ᵐ y ∂volume, ∀ n ∈ F, y ∈ dyadicGridCell G I.1 I.2 →
      ((c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n : ColumnL2 (Fin Mc)) :
        ℝ → ColumnHilbert (Fin Mc)) y = c n • fitColumnValue (catAtom s n) n y :=
    (Filter.eventually_all_finset _).mpr fun n _ => hcol n
  filter_upwards [hall, Lp.coeFn_fun_finsetSum F
    (fun n => c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n)] with y hy hsum hys
  rw [hsum]
  exact Finset.sum_congr rfl fun n hn => hy n hn hys

/-- Blueprint lemma coeff (private-coordinate recovery): a vector of a catalog range is, on its
cell, the combination `Σ c_n ψ_n` of the selected atoms, and each coefficient satisfies
`|c_n|² |I| ≤ ‖x‖²` (private weights one). -/
theorem catRange_expansion {s : List (CatCol Tg)} {I : ℤ × ℤ} {r : ℕ} {M : Tg → Prop}
    {x : ColumnL2 (Fin Mc)} (hx : x ∈ catRange G Mc s I r M) :
    ∃ c : Fin Mc → ℂ, (∀ n, ‖c n‖ ^ 2 * dyadicGridLength G I.1 ≤ ‖x‖ ^ 2) ∧
      (∀ n ∉ catLabels G Mc s I r M, c n = 0) ∧
      (∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
        (x : ℝ → ColumnHilbert (Fin Mc)) y none =
          ∑ n ∈ catLabels G Mc s I r M, c n * catAtom s n y) ∧
      x = ∑ n ∈ catLabels G Mc s I r M,
        c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n := by
  classical
  obtain ⟨c, hc⟩ := catRange_exists_coeff hx
  set F := catLabels G Mc s I r M
  have hco := catCombination_coeFn (G := G) s I F c
  rw [← hc] at hco
  set c' : Fin Mc → ℂ := fun n => if n ∈ F then c n else 0 with hc'
  refine ⟨c', fun m => ?_, fun n hn => by simp only [hc', hn, ↓reduceIte], ?_, ?_⟩
  rotate_left 2
  · rw [hc]
    refine Finset.sum_congr rfl fun n hn => ?_
    simp only [hc', hn, ↓reduceIte]
  · -- the private coordinate `m` on the cell is `c' m`
    have hpriv : ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
        (x : ℝ → ColumnHilbert (Fin Mc)) y (some m) = c' m := by
      filter_upwards [hco] with y hy hys
      rw [hy hys, columnHilbert_sum_apply]
      simp only [PiLp.smul_apply, fitColumnValue_some, smul_eq_mul, mul_ite, mul_one, mul_zero]
      rw [Finset.sum_ite_eq]
    have hle : ∫ y in dyadicGridCell G I.1 I.2, ‖c' m‖ ^ 2 ≤
        ∫ y, ‖(x : ℝ → ColumnHilbert (Fin Mc)) y‖ ^ 2 := by
      calc ∫ y in dyadicGridCell G I.1 I.2, ‖c' m‖ ^ 2
          = ∫ y in dyadicGridCell G I.1 I.2,
              ‖(x : ℝ → ColumnHilbert (Fin Mc)) y (some m)‖ ^ 2 := by
            refine setIntegral_congr_ae (dyadicGridCell_measurable _ _ _) ?_
            filter_upwards [hpriv] with y hy hys
            rw [hy hys]
        _ ≤ ∫ y in dyadicGridCell G I.1 I.2, ‖(x : ℝ → ColumnHilbert (Fin Mc)) y‖ ^ 2 := by
            refine setIntegral_mono_on ?_ ?_ (dyadicGridCell_measurable _ _ _) fun y _ => ?_
            · exact ((memLp_column_coord x (some m)).integrable_norm_pow two_ne_zero).integrableOn
            · exact ((Lp.memLp x).integrable_norm_pow two_ne_zero).integrableOn
            · have : ‖(x : ℝ → ColumnHilbert (Fin Mc)) y (some m)‖ ≤
                  ‖(x : ℝ → ColumnHilbert (Fin Mc)) y‖ := by
                rw [EuclideanSpace.norm_eq]
                exact Real.le_sqrt_of_sq_le (Finset.single_le_sum (f := fun i =>
                  ‖(x : ℝ → ColumnHilbert (Fin Mc)) y i‖ ^ 2) (fun _ _ => by positivity)
                  (Finset.mem_univ (some m)))
              exact pow_le_pow_left₀ (norm_nonneg _) this 2
        _ ≤ _ := setIntegral_le_integral ((Lp.memLp x).integrable_norm_pow two_ne_zero)
            (Filter.Eventually.of_forall fun _ => by positivity)
    rw [setIntegral_const, smul_eq_mul, measureReal_def, dyadicGridCell_volume,
      ENNReal.toReal_ofReal (dyadicGridLength_pos G I.1).le] at hle
    rw [columnInput_norm_sq_integral, mul_comm]
    exact hle
  · filter_upwards [hco] with y hy hys
    rw [hy hys, columnHilbert_sum_apply]
    refine Finset.sum_congr rfl fun n hn => ?_
    simp only [PiLp.smul_apply, fitColumnValue_none, smul_eq_mul, hc', hn, ↓reduceIte]

end CatalogExpansion


/-! ### The cell form on augmented inputs -/

/-- The progression coordinates pull null sets back to null sets of the plane. -/
theorem realProgressionCoordinate_preimage_null (j : Fin 4) {N : Set ℝ} (hN : volume N = 0) :
    (volume : Measure (ℝ × ℝ)) (realProgressionCoordinate j ⁻¹' N) = 0 := by
  obtain ⟨N', hNN', hN'm, hN'0⟩ := exists_measurable_superset_of_null hN
  refine measure_mono_null (Set.preimage_mono hNN') ?_
  have hm : MeasurableSet (realProgressionCoordinate j ⁻¹' N') :=
    (continuous_realProgressionCoordinate j).measurable hN'm
  rw [Measure.volume_eq_prod, Measure.measure_prod_null hm]
  by_cases hj : (j : ℝ) = 0
  · -- the slice is all of `ℝ` over `N'` and empty elsewhere
    filter_upwards [measure_eq_zero_iff_ae_notMem.mp hN'0] with x hx
    have : Prod.mk x ⁻¹' (realProgressionCoordinate j ⁻¹' N') = ∅ := by
      ext t
      simp only [Set.mem_preimage, realProgressionCoordinate, hj, zero_mul, add_zero,
        Set.mem_empty_iff_false, iff_false]
      exact hx
    simp only [this, measure_empty, Pi.zero_apply]
  · refine Filter.Eventually.of_forall fun x => ?_
    have : Prod.mk x ⁻¹' (realProgressionCoordinate j ⁻¹' N') =
        (fun t => (j : ℝ) * t) ⁻¹' ((fun u => u + x) ⁻¹' N') := by
      ext t
      simp only [Set.mem_preimage, realProgressionCoordinate]
      rw [add_comm]
    change volume (Prod.mk x ⁻¹' (realProgressionCoordinate j ⁻¹' N')) = 0
    rw [this, Real.volume_preimage_mul_left hj, measure_preimage_add_right]
    simp [hN'0]

/-- The local form depends only on the almost-everywhere classes of its inputs. -/
theorem localProgressionForm_congr_ae (r : ℝ) (w : ℝ × ℝ → ℂ) {f g : Fin 4 → ℝ → ℂ}
    (h : ∀ j, f j =ᵐ[volume] g j) : localProgressionForm r w f = localProgressionForm r w g := by
  unfold localProgressionForm
  congr 1
  refine integral_congr_ae ?_
  have hj : ∀ j, ∀ᵐ z : ℝ × ℝ ∂volume,
      f j (realProgressionCoordinate j z) = g j (realProgressionCoordinate j z) := by
    intro j
    have hN := (h j)
    rw [Filter.EventuallyEq, ae_iff] at hN
    rw [ae_iff]
    exact realProgressionCoordinate_preimage_null j hN
  filter_upwards [ae_all_iff.mpr hj] with z hz
  simp only [hz]

/-- The physical coordinate of an augmented vector. -/
noncomputable def augPhys {V : Type*} [Fintype V] (x : ColumnL2 V) : ℝ → ℂ :=
  fun y => (x : ℝ → ColumnHilbert V) y none

theorem augPhys_add {V : Type*} [Fintype V] (x x' : ColumnL2 V) :
    augPhys (x + x') =ᵐ[volume] augPhys x + augPhys x' := by
  filter_upwards [Lp.coeFn_add x x'] with y hy
  simp only [augPhys, hy, Pi.add_apply, PiLp.add_apply]

theorem augPhys_smul {V : Type*} [Fintype V] (c : ℂ) (x : ColumnL2 V) :
    augPhys (c • x) =ᵐ[volume] c • augPhys x := by
  filter_upwards [Lp.coeFn_smul c x] with y hy
  simp only [augPhys, hy, Pi.smul_apply, PiLp.smul_apply]

theorem apply_update_augPhys {V : Type*} [Fintype V] (x : Fin 4 → ColumnL2 V) (k : Fin 4)
    (a : ColumnL2 V) (l : Fin 4) :
    augPhys (Function.update x k a l) = Function.update (fun l => augPhys (x l)) k (augPhys a) l :=
  by by_cases h : l = k <;> simp [Function.update, h]

/-- Blueprint eq:local on a cell, as a multilinear form on augmented inputs (only physical
coordinates enter). -/
noncomputable def cellForm {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (V : Type*) [Fintype V] :
    MultilinearMap ℂ (fun _ : Fin 4 => ColumnL2 V) ℂ where
  toFun x := localProgressionForm r w (fun l => augPhys (x l))
  map_update_add' := by
    intro inst x k a b
    obtain rfl : inst = instDecidableEqFin 4 := Subsingleton.elim _ _
    have hm : ∀ l, Measurable (augPhys (x l)) := fun l => columnPhys_measurable (x l)
    have hfin : ∀ l, eLpNorm (augPhys (x l)) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ :=
      fun l => (columnPhys_memLp_normalized (x l) a₀ r).eLpNorm_ne_top
    have e : localProgressionForm r w (fun l => augPhys (Function.update x k (a + b) l)) =
        localProgressionForm r w
          (Function.update (fun l => augPhys (x l)) k (augPhys a + augPhys b)) := by
      refine localProgressionForm_congr_ae r w fun l => ?_
      rw [apply_update_augPhys]
      by_cases h : l = k
      · subst h; simp only [Function.update_self]; exact augPhys_add a b
      · simp only [Function.update_of_ne h]; rfl
    have hadd := localProgressionForm_update_add_two (g₁ := augPhys a) (g₂ := augPhys b) hr hw
      hm hfin k (columnPhys_measurable a) (columnPhys_measurable b)
      (columnPhys_memLp_normalized a a₀ r).eLpNorm_ne_top
      (columnPhys_memLp_normalized b a₀ r).eLpNorm_ne_top
    rw [e, hadd]
    congr 1
    · congr 1; funext l; rw [apply_update_augPhys]
    · congr 1; funext l; rw [apply_update_augPhys]
  map_update_smul' := by
    intro inst x k c a
    obtain rfl : inst = instDecidableEqFin 4 := Subsingleton.elim _ _
    have e : localProgressionForm r w (fun l => augPhys (Function.update x k (c • a) l)) =
        localProgressionForm r w (Function.update (fun l => augPhys (x l)) k (c • augPhys a)) := by
      refine localProgressionForm_congr_ae r w fun l => ?_
      rw [apply_update_augPhys]
      by_cases h : l = k
      · subst h; simp only [Function.update_self]; exact augPhys_smul c a
      · simp only [Function.update_of_ne h]; rfl
    rw [e, localProgressionForm_update_const_smul, smul_eq_mul]
    congr 2
    funext l; rw [apply_update_augPhys]

theorem cellForm_apply {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) {V : Type*} [Fintype V] (x : Fin 4 → ColumnL2 V) :
    cellForm hr hw V x = localProgressionForm r w (fun l => augPhys (x l)) := rfl

/-! ### Template columns are pure sources (blueprint lines 1798-1803) -/

/-- Changing the linear modulation of a chart multiplies its atom by a character. -/
theorem quadraticChartAtom_modulate {d : ℕ} (A : QuadraticChartData d) (γ : ℝ) (y : ℝ) :
    quadraticChartAtom { A with linear := A.linear + γ } y =
      quadraticChartAtom A y * (Real.fourierChar (γ * y) : ℂ) := by
  unfold quadraticChartAtom
  have e : A.quadratic * y ^ 2 + (A.linear + γ) * y = (A.quadratic * y ^ 2 + A.linear * y) +
      γ * y := by ring
  have hS : (∑' n : Fin d → ℤ, quadraticChartLatticeSummand
      { A with linear := A.linear + γ } y n) =
        ∑' n : Fin d → ℤ, quadraticChartLatticeSummand A y n :=
    rfl
  simp only [e, AddChar.map_add_eq_mul, Circle.coe_mul]
  rw [hS]
  ring

/-- The complexity of a chart does not see its linear modulation. -/
theorem QuadraticChartComplexity.modulate {d c₀ : ℕ} {H : ℝ} {A : QuadraticChartData d}
    (h : QuadraticChartComplexity c₀ H A) (β : ℝ) :
    QuadraticChartComplexity c₀ H { A with linear := β } :=
  ⟨h.lower, h.dimension, h.height, h.support, h.derivative⟩

/-- A template column is the atom of a pure chart of its tag in its slot, with arbitrary
linear modulation and the template complexity. -/
theorem templateCol_chart {Tg : Type*} (v : ChartTag) (t : Fin 4) {R : Fin v.dim → ℕ}
    (hR : R ∈ residueBox v.dim 9) (γ : ℝ) (I : ℤ × ℤ) (r : ℕ) (x : Tg) {W : ℝ}
    (hW : Real.exp 2 ≤ W) (hdW : (v.dim : ℝ) ≤ Real.log W)
    (hMW : ∀ a b, (chartRationalHeight (((slotCoeff t : ℚ) • v.C) a b) : ℝ) ≤ W)
    (hBW : (v.dim : ℝ) * (tagKρ : ℝ) ^ (2 * tagKρ) + 2 * Real.pi * v.dim ≤ W) :
    ∃ A : QuadraticChartData v.dim, QuadraticChartComplexity (2 * tagKρ) W A ∧
      A.horizontal = v.θ ∧ A.matrix = (slotCoeff t : ℚ) • v.C ∧
      A.quadratic = slotCoeff t * v.lam ∧
      (templateCol v t R γ I r x : CatCol Tg).atom = quadraticChartAtom A := by
  obtain ⟨hc, -, hθ, hM, hq⟩ := tagTemplate_column v t hR hW hdW hMW hBW
  set T := tagTemplateData v.θ v.C v.lam t R
  refine ⟨{ T with linear := T.linear + γ }, hc.modulate _, hθ, hM, hq, ?_⟩
  funext y
  rw [quadraticChartAtom_modulate]
  rfl

/-! ### Cumulative masks (blueprint lines 1804-1807) -/

namespace ColorSetup

variable {V : Type*} [DecidableEq V] (K : ColorSetup V) (T : AdmTree V)

/-- The cumulative mask `U_{m,h}(I)`: present vertices within graph distance `h` of a present
vertex of color at most `m` (blueprint line 1806). -/
def cumMask (Nv m h : ℕ) (I : T.Cell) : Set V :=
  {b | b ∈ T.X I ∧ ∃ w ∈ T.X I, K.color T Nv I w ≤ m ∧ K.dist.d (T.depth I) w b ≤ h}

variable {K T}

theorem cumMask_mono {Nv m m' h h' : ℕ} (hm : m ≤ m') (hh : h ≤ h') (I : T.Cell) :
    K.cumMask T Nv m h I ⊆ K.cumMask T Nv m' h' I := by
  rintro b ⟨hb, w, hw, hc, hd⟩
  exact ⟨hb, w, hw, hc.trans hm, hd.trans (by exact_mod_cast hh)⟩

/-- Neighbor closure at pad `h + 1` (blueprint line 1807). -/
theorem cumMask_neighbor {Nv m h : ℕ} {I : T.Cell} {b b' : V} (hb : b ∈ K.cumMask T Nv m h I)
    (hb' : b' ∈ T.X I) (hd : K.dist.d (T.depth I) b b' ≤ 1) :
    b' ∈ K.cumMask T Nv m (h + 1) I := by
  obtain ⟨-, w, hw, hc, hwb⟩ := hb
  refine ⟨hb', w, hw, hc, ?_⟩
  calc K.dist.d (T.depth I) w b' ≤ K.dist.d (T.depth I) w b + K.dist.d (T.depth I) b b' :=
        K.dist.triangle _ _ _ _
    _ ≤ h + 1 := add_le_add hwb hd
    _ = ((h + 1 : ℕ) : ℕ∞) := by push_cast; rfl

/-- A vertex of the cumulative mask at `m + 1` is old (in the mask at `m`) or within the pad of a
vertex of color exactly `m + 1` (blueprint line 1850). -/
theorem cumMask_succ {Nv m h : ℕ} {I : T.Cell} {b : V} (hb : b ∈ K.cumMask T Nv (m + 1) h I) :
    b ∈ K.cumMask T Nv m h I ∨
      ∃ w ∈ T.X I, K.color T Nv I w = m + 1 ∧ K.dist.d (T.depth I) w b ≤ h := by
  obtain ⟨hbI, w, hw, hc, hd⟩ := hb
  rcases Nat.lt_or_ge (K.color T Nv I w) (m + 1) with hlt | hge
  · exact Or.inl ⟨hbI, w, hw, by omega, hd⟩
  · exact Or.inr ⟨w, hw, by omega, hd⟩

/-- Cumulative masks increase in depth (blueprint line 1807). -/
theorem cumMask_par {Nv m h : ℕ} (hN : ∀ I, (T.X I).card ≤ Nv) (I : T.Cell) :
    K.cumMask T Nv m h (T.par I) ⊆ K.cumMask T Nv m h I := by
  rintro b ⟨hb, w, hw, hc, hd⟩
  have hle := T.st_le_par I
  refine ⟨hle.2.1 hb, w, hle.2.1 hw, (K.color_anti T hN hw).trans hc, ?_⟩
  exact (K.dist.anti hle.1 w b).trans hd

end ColorSetup

/-! ### Averaged histories (blueprint lines 1807, 1813: histories include every pad choice) -/

section AveragedHistories

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- A complement product only depends on its first `m` layers. -/
theorem operatorComplementProduct_congr {A B : ℕ → H →L[ℂ] H} (θ : ℕ → Bool) (m : ℕ)
    (h : ∀ l < m, A l = B l) :
    operatorComplementProduct A θ m = operatorComplementProduct B θ m := by
  induction m with
  | zero => rfl
  | succ m ih =>
    simp only [operatorComplementProduct]
    rw [ih fun l hl => h l (by omega), h m (by omega)]

/-- The uniform average of finitely many operators. -/
noncomputable def opAvg {P : ℕ} (Q : Fin P → H →L[ℂ] H) : H →L[ℂ] H :=
  (P : ℂ)⁻¹ • ∑ p, Q p

theorem id_sub_opAvg {P : ℕ} (hP : 0 < P) (Q : Fin P → H →L[ℂ] H) :
    ContinuousLinearMap.id ℂ H - opAvg Q = opAvg fun p => ContinuousLinearMap.id ℂ H - Q p := by
  unfold opAvg
  rw [Finset.sum_sub_distrib, smul_sub, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    ← Nat.cast_smul_eq_nsmul ℂ, smul_smul, inv_mul_cancel₀ (by exact_mod_cast hP.ne'), one_smul]

/-- The choice extension of a function on `Fin m`. -/
def choiceExt {P m : ℕ} (hP : 0 < P) (c : Fin m → Fin P) (l : ℕ) : Fin P :=
  if h : l < m then c ⟨l, h⟩ else ⟨0, hP⟩

/-- A complement product of averaged layers is the average over all choice functions of the
complement products of single layers. -/
theorem complementProduct_opAvg {P : ℕ} (hP : 0 < P) (Q : ℕ → Fin P → H →L[ℂ] H)
    (θ : ℕ → Bool) (m : ℕ) (z : H) :
    operatorComplementProduct (fun l => opAvg (Q l)) θ m z =
      ((P : ℂ) ^ m)⁻¹ • ∑ c : Fin m → Fin P,
        operatorComplementProduct (fun l => Q l (choiceExt hP c l)) θ m z := by
  induction m with
  | zero =>
    simp [operatorComplementProduct]
  | succ m ih =>
    have hP' : (P : ℂ) ≠ 0 := by exact_mod_cast hP.ne'
    -- the last layer as an average
    set F : (H →L[ℂ] H) → H →L[ℂ] H := fun X =>
      if θ m then ContinuousLinearMap.id ℂ H - X else X with hF
    have hlast : F (opAvg (Q m)) = opAvg fun p => F (Q m p) := by
      simp only [hF]; split_ifs
      · exact id_sub_opAvg hP (Q m)
      · rfl
    have hstep : ∀ (B : ℕ → H →L[ℂ] H) (w : H),
        operatorComplementProduct B θ (m + 1) w = F (B m) (operatorComplementProduct B θ m w) :=
      fun B w => rfl
    rw [hstep, ih, hlast]
    -- distribute the last average over the choices
    simp only [opAvg, smul_apply, sum_apply, map_smul, map_sum]
    rw [← (Fin.snocEquiv (fun _ : Fin (m + 1) => Fin P)).sum_comp]
    rw [Fintype.sum_prod_type]
    simp only [Finset.smul_sum, smul_smul]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun c _ => ?_
    rw [hstep]
    have h1 : choiceExt hP ((Fin.snocEquiv fun _ : Fin (m + 1) => Fin P) (p, c)) m = p := by
      simp [choiceExt, Fin.snocEquiv, Fin.snoc]
    have h2 : operatorComplementProduct (fun l => Q l (choiceExt hP
        ((Fin.snocEquiv fun _ : Fin (m + 1) => Fin P) (p, c)) l)) θ m =
        operatorComplementProduct (fun l => Q l (choiceExt hP c l)) θ m := by
      refine operatorComplementProduct_congr θ m fun l hl => ?_
      have : choiceExt hP ((Fin.snocEquiv fun _ : Fin (m + 1) => Fin P) (p, c)) l =
          choiceExt hP c l := by
        simp only [choiceExt, Fin.snocEquiv, Equiv.coe_fn_mk, hl, show l < m + 1 by omega,
          ↓reduceDIte]
        rw [show (⟨l, _⟩ : Fin (m + 1)) = Fin.castSucc ⟨l, hl⟩ from rfl, Fin.snoc_castSucc]
      rw [this]
    simp only [h1, h2]
    congr 1
    rw [pow_succ, mul_inv]

end AveragedHistories

/-- The local form is multilinear: scaling the inputs scales the form by the product. -/
theorem localProgressionForm_smul (r : ℝ) (w : ℝ × ℝ → ℂ) (f : Fin 4 → ℝ → ℂ)
    (c : Fin 4 → ℂ) :
    localProgressionForm r w (fun j => c j • f j) =
      (∏ j, c j) * localProgressionForm r w f := by
  simp only [localProgressionForm, Pi.smul_apply, smul_eq_mul, Finset.prod_mul_distrib]
  rw [show (fun z : ℝ × ℝ => w z * ((∏ j, c j) * ∏ j, f j (realProgressionCoordinate j z))) =
    fun z => (∏ j, c j) * (w z * ∏ j, f j (realProgressionCoordinate j z)) by
      funext z; ring, integral_const_mul]
  ring

/-! ### Applying a passing test (blueprint eq:catalog-test with spectators) -/

/-- An admissible local form only sees its inputs on the cell. -/
theorem localProgressionForm_congr_cell {κ : LocalKernelClass} {G : RealDyadicGrid}
    {I : ℤ × ℤ} {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) w)
    {f g : Fin 4 → ℝ → ℂ} (h : ∀ j, ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → f j y = g j y) :
    localProgressionForm (dyadicGridLength G I.1) w f =
      localProgressionForm (dyadicGridLength G I.1) w g := by
  have hr := dyadicGridLength_pos G I.1
  have hin : ∀ z, w z ≠ 0 → ∀ j, realProgressionCoordinate j z ∈ dyadicGridCell G I.1 I.2 := by
    intro z hz j
    obtain ⟨h1, h2⟩ := hw.support z hz j
    have hm := κ.margin_pos
    have : 0 < κ.margin * dyadicGridLength G I.1 := mul_pos hm hr
    exact ⟨by linarith, by linarith⟩
  have e1 : localProgressionForm (dyadicGridLength G I.1) w f =
      localProgressionForm (dyadicGridLength G I.1) w
        (fun j => (dyadicGridCell G I.1 I.2).indicator (f j)) :=
    localProgressionForm_congr_support fun z hz j => by rw [Set.indicator_of_mem (hin z hz j)]
  have e2 : localProgressionForm (dyadicGridLength G I.1) w g =
      localProgressionForm (dyadicGridLength G I.1) w
        (fun j => (dyadicGridCell G I.1 I.2).indicator (g j)) :=
    localProgressionForm_congr_support fun z hz j => by rw [Set.indicator_of_mem (hin z hz j)]
  rw [e1, e2]
  refine localProgressionForm_congr_ae _ _ fun j => ?_
  filter_upwards [h j] with y hy
  by_cases hyI : y ∈ dyadicGridCell G I.1 I.2
  · rw [Set.indicator_of_mem hyI, Set.indicator_of_mem hyI, hy hyI]
  · rw [Set.indicator_of_notMem hyI, Set.indicator_of_notMem hyI]

theorem fin4_cover_of_distinct : ∀ u t a b l : Fin 4, u ≠ t → u ≠ a → u ≠ b → t ≠ a → t ≠ b →
    a ≠ b → l = u ∨ l = t ∨ l = a ∨ l = b := by decide

/-- A passing test bounds the cell form with a pure source of a tag in the mask in slot `u`, the
target residual in slot `t`, and two spectators of normalized sizes `S_a, S_b`. -/
theorem CatTest.form_le {Tg : Type*} (w : CatTest Tg) {G : RealDyadicGrid} {Mc : ℕ}
    {I : ℤ × ℤ} {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {wI : ℝ × ℝ → ℂ} {τ : ℝ} {mH : ℕ}
    {cat : List (CatCol Tg)} (hpass : w.Pass G Mc I c₀ H tagOf wI τ mH cat)
    {κ : LocalKernelClass}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {x : Tg} (hx : w.M x) {u a b : Fin 4} (hut : u ≠ w.t) (hua : u ≠ a) (hub : u ≠ b)
    (hta : w.t ≠ a) (htb : w.t ≠ b) (hab : a ≠ b)
    (A : QuadraticChartData (tagOf x).dim) (hA : QuadraticChartComplexity c₀ H A)
    (hAθ : A.horizontal = (tagOf x).θ) (hAM : A.matrix = (slotCoeff u : ℚ) • (tagOf x).C)
    (hAq : A.quadratic = slotCoeff u * (tagOf x).lam)
    (X : Fin 4 → ColumnL2 (Fin Mc))
    (hXu : ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → augPhys (X u) y = quadraticChartAtom A y)
    (hXt : X w.t = w.resid G Mc I mH cat) {Sa Sb : ℝ} (hSa : 0 < Sa) (hSb : 0 < Sb)
    (hXa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sa)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc) X‖ ≤
      τ * ‖physicalColumnInput (V := Fin Mc) w.g‖ / Real.sqrt (dyadicGridLength G I.1) *
        Sa * Sb := by
  classical
  set μ := normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)
  have hcover : ∀ l : Fin 4, l = u ∨ l = w.t ∨ l = a ∨ l = b := fun l =>
    fin4_cover_of_distinct u w.t a b l hut hua hub hta htb hab
  -- the normalized inputs
  set z : Fin 4 → ℝ → ℂ := fun l => if l = u then quadraticChartAtom A
    else if l = w.t then augPhys (X w.t) else if l = a then (Sa : ℂ)⁻¹ • augPhys (X a)
    else (Sb : ℂ)⁻¹ • augPhys (X b) with hz
  set c : Fin 4 → ℂ := fun l => if l = a then (Sa : ℂ) else if l = b then (Sb : ℂ) else 1 with hc
  have hzu : z u = quadraticChartAtom A := by simp [hz]
  have hzt : z w.t = augPhys (X w.t) := by simp [hz, Ne.symm hut]
  have hza : z a = (Sa : ℂ)⁻¹ • augPhys (X a) := by simp [hz, Ne.symm hua, Ne.symm hta]
  have hzb : z b = (Sb : ℂ)⁻¹ • augPhys (X b) := by
    simp [hz, Ne.symm hub, Ne.symm htb, Ne.symm hab]
  have hscale : ∀ (S : ℝ) (f : ℝ → ℂ), 0 < S → eLpNorm f 2 μ ≤ ENNReal.ofReal S →
      eLpNorm ((S : ℂ)⁻¹ • f) 2 μ ≤ 1 := by
    intro S f hS hf
    rw [eLpNorm_const_smul]
    have hn : ‖((S : ℂ))⁻¹‖ₑ = ENNReal.ofReal S⁻¹ := by
      rw [← ofReal_norm, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hS]
    rw [hn]
    calc ENNReal.ofReal S⁻¹ * eLpNorm f 2 μ ≤ ENNReal.ofReal S⁻¹ * ENNReal.ofReal S :=
          by gcongr
      _ = 1 := by
          rw [← ENNReal.ofReal_mul (inv_pos.mpr hS).le, inv_mul_cancel₀ hS.ne', ENNReal.ofReal_one]
  have hpass' := hpass x hx hut hua hub hta htb hab A hA hAθ hAM hAq z hzu
    (by rw [hzt, hXt]; rfl)
    (by rw [hza]; exact (columnPhys_measurable _).const_smul _)
    (by rw [hzb]; exact (columnPhys_measurable _).const_smul _)
    (by rw [hza]; exact hscale Sa _ hSa hXa)
    (by rw [hzb]; exact hscale Sb _ hSb hXb)
  -- rescale
  have hform : cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc) X =
      (Sa * Sb : ℂ) * localProgressionForm (dyadicGridLength G I.1) wI z := by
    rw [cellForm_apply]
    have e : localProgressionForm (dyadicGridLength G I.1) wI (fun l => augPhys (X l)) =
        localProgressionForm (dyadicGridLength G I.1) wI (fun l => c l • z l) := by
      refine localProgressionForm_congr_cell hwI fun l => ?_
      filter_upwards [hXu] with y hy hyI
      rcases hcover l with rfl | rfl | rfl | rfl
      · have h1 : c l = 1 := by simp only [hc, hua, hub, ↓reduceIte]
        rw [Pi.smul_apply, h1, one_smul, hzu]
        exact hy hyI
      · have h1 : c w.t = 1 := by simp only [hc, hta, htb, ↓reduceIte]
        rw [Pi.smul_apply, h1, one_smul, hzt]
      · have h1 : c l = Sa := by simp only [hc, ↓reduceIte]
        rw [Pi.smul_apply, h1, hza, Pi.smul_apply, smul_smul,
          mul_inv_cancel₀ (by exact_mod_cast hSa.ne'), one_smul]
      · have h1 : c l = Sb := by simp only [hc, Ne.symm hab, ↓reduceIte]
        rw [Pi.smul_apply, h1, hzb, Pi.smul_apply, smul_smul,
          mul_inv_cancel₀ (by exact_mod_cast hSb.ne'), one_smul]
    rw [e, localProgressionForm_smul]
    congr 1
    have huniv : (Finset.univ : Finset (Fin 4)) = {u, w.t, a, b} := by
      ext l
      simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, true_iff]
      exact hcover l
    rw [huniv, Finset.prod_insert (by simp [hut, hua, hub]),
      Finset.prod_insert (by simp [hta, htb]), Finset.prod_insert (by simp [hab]),
      Finset.prod_singleton]
    simp only [hc, hua, hub, hta, htb, Ne.symm hab, ↓reduceIte, one_mul]
  rw [hform, norm_mul]
  have hn : ‖((Sa * Sb : ℝ) : ℂ)‖ = Sa * Sb := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (mul_pos hSa hSb)]
  push_cast at hn
  rw [hn]
  calc Sa * Sb * ‖localProgressionForm (dyadicGridLength G I.1) wI z‖ ≤
      Sa * Sb * (τ * ‖physicalColumnInput (V := Fin Mc) w.g‖ /
        Real.sqrt (dyadicGridLength G I.1)) :=
        mul_le_mul_of_nonneg_left hpass' (by positivity)
    _ = _ := by ring

/-! ### The guarded color search (blueprint prop:localize, lines 1848-1849) -/

section GuardedSearch

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The operator of a list of split layers `(m, residual?)`, applied in order. -/
noncomputable def layerOp (Cum : ℕ → H →L[ℂ] H) (ls : List (ℕ × Bool)) : H →L[ℂ] H :=
  ls.foldl (fun A x => (if x.2 then ContinuousLinearMap.id ℂ H - Cum x.1 else Cum x.1).comp A)
    (ContinuousLinearMap.id ℂ H)

theorem layerOp_nil (Cum : ℕ → H →L[ℂ] H) : layerOp Cum [] = ContinuousLinearMap.id ℂ H := rfl

theorem layerOp_append (Cum : ℕ → H →L[ℂ] H) (ls : List (ℕ × Bool)) (x : ℕ × Bool) :
    layerOp Cum (ls ++ [x]) =
      (if x.2 then ContinuousLinearMap.id ℂ H - Cum x.1 else Cum x.1).comp (layerOp Cum ls) := by
  simp [layerOp, List.foldl_append]

/-- The third slot: the least slot that is not a current guard. -/
def thirdSlot (up : Fin 4) (low : Option (Fin 4)) : Fin 4 :=
  if (0 : Fin 4) ≠ up ∧ low ≠ some 0 then 0
  else if (1 : Fin 4) ≠ up ∧ low ≠ some 1 then 1
  else if (2 : Fin 4) ≠ up ∧ low ≠ some 2 then 2 else 3

theorem thirdSlot_ne (up : Fin 4) (low : Option (Fin 4)) :
    thirdSlot up low ≠ up ∧ low ≠ some (thirdSlot up low) := by
  revert up low
  decide

/-- A leaf of the search: its color, its guards and the layers of each slot. -/
structure SearchLeaf where
  k : ℕ
  hi : ℕ
  up : Fin 4
  low : Option (Fin 4)
  layers : Fin 4 → List (ℕ × Bool)

/-- The guarded binary search over the colors `[ℓ, h]` (blueprint lines 1848-1849): split at
`m = ⌊(ℓ+h)/2⌋` with the cumulative filter of the third slot; the positive branch makes it the
upper guard with `[ℓ, m]`, the residual branch the lower guard with `[m+1, h]`. -/
def searchLeaves : ℕ → ℕ → ℕ → Fin 4 → Option (Fin 4) → (Fin 4 → List (ℕ × Bool)) →
    List SearchLeaf
  | 0, ℓ, h, up, low, ls => [⟨ℓ, h, up, low, ls⟩]
  | fuel + 1, ℓ, h, up, low, ls =>
      if ℓ < h then
        searchLeaves fuel ℓ ((ℓ + h) / 2) (thirdSlot up low) low
            (Function.update ls (thirdSlot up low)
              (ls (thirdSlot up low) ++ [((ℓ + h) / 2, false)])) ++
          searchLeaves fuel ((ℓ + h) / 2 + 1) h up (some (thirdSlot up low))
            (Function.update ls (thirdSlot up low)
              (ls (thirdSlot up low) ++ [((ℓ + h) / 2, true)]))
      else [⟨ℓ, h, up, low, ls⟩]

/-- Blueprint prop:localize, lines 1841-1843: the search is an exact expansion over its leaves. -/
theorem searchLeaves_form (Λ : MultilinearMap ℂ (fun _ : Fin 4 => H) ℂ)
    (Cum : Fin 4 → ℕ → H →L[ℂ] H) (z : Fin 4 → H) :
    ∀ (fuel ℓ h : ℕ) (up : Fin 4) (low : Option (Fin 4)) (ls : Fin 4 → List (ℕ × Bool)),
      Λ (fun l => layerOp (Cum l) (ls l) (z l)) =
        ((searchLeaves fuel ℓ h up low ls).map
          fun L => Λ (fun l => layerOp (Cum l) (L.layers l) (z l))).sum := by
  intro fuel
  induction fuel with
  | zero => intro ℓ h up low ls; simp [searchLeaves]
  | succ fuel ih =>
    intro ℓ h up low ls
    simp only [searchLeaves]
    split_ifs with hlt
    · rw [List.map_append, List.sum_append, ← ih, ← ih]
      set s := thirdSlot up low
      set m := (ℓ + h) / 2
      have h1 : (fun l => layerOp (Cum l) (Function.update ls s (ls s ++ [(m, false)]) l) (z l)) =
          Function.update (fun l => layerOp (Cum l) (ls l) (z l)) s
            (Cum s m (layerOp (Cum s) (ls s) (z s))) := by
        funext l
        by_cases hl : l = s
        · subst hl; simp [layerOp_append]
        · simp [Function.update_of_ne hl]
      have h2 : (fun l => layerOp (Cum l) (Function.update ls s (ls s ++ [(m, true)]) l) (z l)) =
          Function.update (fun l => layerOp (Cum l) (ls l) (z l)) s
            (layerOp (Cum s) (ls s) (z s) - Cum s m (layerOp (Cum s) (ls s) (z s))) := by
        funext l
        by_cases hl : l = s
        · subst hl; simp [layerOp_append]
        · simp [Function.update_of_ne hl]
      rw [h1, h2, ← Λ.map_update_add, add_sub_cancel, Function.update_eq_self]
    · simp

/-- The guard invariant (blueprint line 1848): the upper guard ends with the positive filter at
the upper end of the interval (or is the initial basic slot with no filter at the top color),
the lower guard ends with the residual filter just below the lower end (or there is none at the
bottom color), and the guards differ. -/
def SearchInv (up₀ : Fin 4) (ℓ₀ h₀ : ℕ) (ℓ h : ℕ) (up : Fin 4) (low : Option (Fin 4))
    (ls : Fin 4 → List (ℕ × Bool)) : Prop :=
  low ≠ some up ∧
    ((∃ ls', ls up = ls' ++ [(h, false)]) ∨ (up = up₀ ∧ ls up = [] ∧ h = h₀)) ∧
    ((low = none ∧ ℓ = ℓ₀) ∨ ∃ g ls', low = some g ∧ ls g = ls' ++ [(ℓ - 1, true)] ∧ 1 ≤ ℓ)

theorem searchLeaves_inv {up₀ : Fin 4} {ℓ₀ h₀ : ℕ} :
    ∀ (fuel ℓ h : ℕ) (up : Fin 4) (low : Option (Fin 4)) (ls : Fin 4 → List (ℕ × Bool)),
      SearchInv up₀ ℓ₀ h₀ ℓ h up low ls → ∀ L ∈ searchLeaves fuel ℓ h up low ls,
        SearchInv up₀ ℓ₀ h₀ L.k L.hi L.up L.low L.layers := by
  intro fuel
  induction fuel with
  | zero =>
    intro ℓ h up low ls hI L hL
    simp only [searchLeaves, List.mem_singleton] at hL
    subst hL; exact hI
  | succ fuel ih =>
    intro ℓ h up low ls hI L hL
    simp only [searchLeaves] at hL
    split_ifs at hL with hlt
    · obtain ⟨hne, hup, hlow⟩ := hI
      set s := thirdSlot up low with hs
      obtain ⟨hsu, hls⟩ := thirdSlot_ne up low
      rw [← hs] at hsu hls
      rcases List.mem_append.mp hL with hL | hL
      · refine ih _ _ _ _ _ ?_ L hL
        refine ⟨hls, Or.inl ⟨ls s, by simp⟩, ?_⟩
        rcases hlow with ⟨hl, hℓ⟩ | ⟨g, ls', hg, hgl, hℓ⟩
        · exact Or.inl ⟨hl, hℓ⟩
        · refine Or.inr ⟨g, ls', hg, ?_, hℓ⟩
          have hgs : g ≠ s := fun he => hls (by rw [hg, he])
          rw [Function.update_of_ne hgs]; exact hgl
      · refine ih _ _ _ _ _ ?_ L hL
        refine ⟨fun he => hsu (Option.some_injective _ he), ?_, Or.inr ⟨s, ls s, rfl, ?_, by omega⟩⟩
        · rw [Function.update_of_ne hsu.symm]; exact hup
        · simp
    · rw [List.mem_singleton] at hL; subst hL; exact hI

/-- With enough fuel every leaf is a single color. -/
theorem searchLeaves_single :
    ∀ (fuel ℓ h : ℕ) (up : Fin 4) (low : Option (Fin 4)) (ls : Fin 4 → List (ℕ × Bool)),
      ℓ ≤ h → h - ℓ < 2 ^ fuel → ∀ L ∈ searchLeaves fuel ℓ h up low ls, L.k = L.hi := by
  intro fuel
  induction fuel with
  | zero =>
    intro ℓ h up low ls hℓ hf L hL
    simp only [searchLeaves, List.mem_singleton] at hL; subst hL; simp at hf ⊢; omega
  | succ fuel ih =>
    intro ℓ h up low ls hℓ hf L hL
    simp only [searchLeaves] at hL
    rw [pow_succ] at hf
    split_ifs at hL with hlt
    · rcases List.mem_append.mp hL with hL | hL
      · exact ih _ _ _ _ _ (by omega) (by omega) L hL
      · exact ih _ _ _ _ _ (by omega) (by omega) L hL
    · rw [List.mem_singleton] at hL; subst hL; simp; omega

/-- The leaves enumerate the colors in increasing order. -/
theorem searchLeaves_colors :
    ∀ (fuel ℓ h : ℕ) (up : Fin 4) (low : Option (Fin 4)) (ls : Fin 4 → List (ℕ × Bool)),
      ℓ ≤ h → h - ℓ < 2 ^ fuel →
        (searchLeaves fuel ℓ h up low ls).map SearchLeaf.k = List.range' ℓ (h - ℓ + 1) := by
  intro fuel
  induction fuel with
  | zero =>
    intro ℓ h up low ls hℓ hf
    simp at hf
    have : h = ℓ := by omega
    subst this
    simp [searchLeaves]
  | succ fuel ih =>
    intro ℓ h up low ls hℓ hf
    simp only [searchLeaves]
    rw [pow_succ] at hf
    split_ifs with hlt
    · rw [List.map_append, ih _ _ _ _ _ (by omega) (by omega),
        ih _ _ _ _ _ (by omega) (by omega)]
      rw [show h - ℓ + 1 = ((ℓ + h) / 2 - ℓ + 1) + (h - ((ℓ + h) / 2 + 1) + 1) by omega]
      conv_rhs => rw [← List.range'_append_1]
      rw [show ℓ + ((ℓ + h) / 2 - ℓ + 1) = (ℓ + h) / 2 + 1 by omega]
    · have : h = ℓ := by omega
      subst this
      simp

end GuardedSearch

/-! ### Enabling lemmas for the leaf bounds -/

section LayerHistories

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- A complement product only depends on its first `m` layers and flags. -/
theorem operatorComplementProduct_congr₂ {A B : ℕ → H →L[ℂ] H} {θ θ' : ℕ → Bool} (m : ℕ)
    (h : ∀ l < m, A l = B l ∧ θ l = θ' l) :
    operatorComplementProduct A θ m = operatorComplementProduct B θ' m := by
  induction m with
  | zero => rfl
  | succ m ih =>
    simp only [operatorComplementProduct]
    rw [ih fun l hl => h l (by omega), (h m (by omega)).1, (h m (by omega)).2]

/-- The layer operator is the complement product of its layers. -/
theorem layerOp_eq_complementProduct (Cum : ℕ → H →L[ℂ] H) (ls : List (ℕ × Bool)) :
    layerOp Cum ls = operatorComplementProduct (fun l => Cum (ls.getD l (0, false)).1)
      (fun l => (ls.getD l (0, false)).2) ls.length := by
  induction ls using List.reverseRecOn with
  | nil => rfl
  | append_singleton ls x ih =>
    rw [layerOp_append, ih, List.length_append, List.length_singleton]
    change _ = (if ((ls ++ [x]).getD ls.length (0, false)).2 then
        ContinuousLinearMap.id ℂ H - Cum ((ls ++ [x]).getD ls.length (0, false)).1
      else Cum ((ls ++ [x]).getD ls.length (0, false)).1).comp
        (operatorComplementProduct (fun l => Cum ((ls ++ [x]).getD l (0, false)).1)
          (fun l => ((ls ++ [x]).getD l (0, false)).2) ls.length)
    have hx : (ls ++ [x]).getD ls.length (0, false) = x := by simp
    rw [hx, operatorComplementProduct_congr₂
      (B := fun l => Cum ((ls ++ [x]).getD l (0, false)).1)
      (θ' := fun l => ((ls ++ [x]).getD l (0, false)).2) ls.length fun l hl => by
        simp only [List.getD_append _ _ _ _ hl, and_self]]

/-- A form with an averaged input in one slot is bounded by any bound of its terms. -/
theorem norm_map_update_avg_le {V : Type*} [AddCommGroup V] [Module ℂ V]
    (Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ) (x : Fin 4 → V) (g : Fin 4) {ι : Type*}
    (s : Finset ι) (hs : s.Nonempty) (y : ι → V) {B : ℝ}
    (hB : ∀ i ∈ s, ‖Λ (Function.update x g (y i))‖ ≤ B) :
    ‖Λ (Function.update x g (((s.card : ℂ))⁻¹ • ∑ i ∈ s, y i))‖ ≤ B := by
  rw [Λ.map_update_smul, Λ.map_update_sum, smul_eq_mul, norm_mul, norm_inv, Complex.norm_natCast]
  have hc : (0 : ℝ) < s.card := by exact_mod_cast hs.card_pos
  rw [inv_mul_le_iff₀ hc]
  calc ‖∑ i ∈ s, Λ (Function.update x g (y i))‖ ≤ ∑ i ∈ s, ‖Λ (Function.update x g (y i))‖ :=
        norm_sum_le _ _
    _ ≤ ∑ _i ∈ s, B := Finset.sum_le_sum hB
    _ = s.card * B := by rw [Finset.sum_const, nsmul_eq_mul]

end LayerHistories

/-- An averaged target residual of passing tests (each with the source tag in its mask) bounds
the cell form with a pure source and two spectators (blueprint lines 1813, 1850-1852: the
tests hold for every individual pad choice, hence for averages). -/
theorem CatTest.form_avg_le {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {I : ℤ × ℤ}
    {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {wI : ℝ × ℝ → ℂ} {mH : ℕ}
    {cat : List (CatCol Tg)} {κ : LocalKernelClass}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (tests : ι → CatTest Tg) (τ : ι → ℝ)
    (hpass : ∀ i ∈ s, (tests i).Pass G Mc I c₀ H tagOf wI (τ i) mH cat)
    {r : Fin 4} (hr : ∀ i ∈ s, (tests i).t = r) {x : Tg} (hx : ∀ i ∈ s, (tests i).M x)
    {u a b : Fin 4} (hur : u ≠ r) (hua : u ≠ a) (hub : u ≠ b) (hra : r ≠ a) (hrb : r ≠ b)
    (hab : a ≠ b)
    (A : QuadraticChartData (tagOf x).dim) (hA : QuadraticChartComplexity c₀ H A)
    (hAθ : A.horizontal = (tagOf x).θ) (hAM : A.matrix = (slotCoeff u : ℚ) • (tagOf x).C)
    (hAq : A.quadratic = slotCoeff u * (tagOf x).lam)
    (X : Fin 4 → ColumnL2 (Fin Mc))
    (hXu : ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → augPhys (X u) y = quadraticChartAtom A y)
    (hXr : X r = ((s.card : ℂ))⁻¹ • ∑ i ∈ s, (tests i).resid G Mc I mH cat)
    {Sa Sb B : ℝ} (hSa : 0 < Sa) (hSb : 0 < Sb)
    (hXa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sa)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sb)
    (hB : ∀ i ∈ s, τ i * ‖physicalColumnInput (V := Fin Mc) (tests i).g‖ /
      Real.sqrt (dyadicGridLength G I.1) * Sa * Sb ≤ B) :
    ‖cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc) X‖ ≤ B := by
  have hXe : X = Function.update X r (((s.card : ℂ))⁻¹ •
      ∑ i ∈ s, (tests i).resid G Mc I mH cat) := by
    rw [← hXr, Function.update_eq_self]
  rw [hXe]
  refine norm_map_update_avg_le _ X r s hs _ fun i hi => ?_
  refine le_trans ?_ (hB i hi)
  have hti := hr i hi
  refine (tests i).form_le (hpass i hi) hwI (hx i hi) (by rw [hti]; exact hur) hua hub
    (by rw [hti]; exact hra) (by rw [hti]; exact hrb) hab A hA hAθ hAM hAq _ ?_ ?_ hSa hSb ?_ ?_
  · rw [Function.update_of_ne hur]; exact hXu
  · rw [hti, Function.update_self]
  · rw [Function.update_of_ne hra.symm]; exact hXa
  · rw [Function.update_of_ne hrb.symm]; exact hXb

/-! ### Leaf inputs as averages of test residuals -/

section ResidualAverages

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Identity layers with unflagged complements beyond `n` do not change a complement product. -/
theorem operatorComplementProduct_id_tail (A : ℕ → H →L[ℂ] H) (θ : ℕ → Bool) (n : ℕ)
    (hA : ∀ l, n ≤ l → A l = ContinuousLinearMap.id ℂ H) (hθ : ∀ l, n ≤ l → θ l = false) :
    ∀ k, operatorComplementProduct A θ (n + k) = operatorComplementProduct A θ n
  | 0 => rfl
  | k + 1 => by
    rw [show n + (k + 1) = n + k + 1 by omega]
    change (if θ (n + k) then ContinuousLinearMap.id ℂ H - A (n + k) else A (n + k)).comp
      (operatorComplementProduct A θ (n + k)) = _
    rw [hθ _ (by omega), hA _ (by omega), operatorComplementProduct_id_tail A θ n hA hθ k]
    rfl

end ResidualAverages

namespace CatTest

variable {Tg : Type*}

/-- The single-choice test of a layered history: target slot `t`, target rank `r` and mask,
history layers `ls` with layer ranks `rk` and pad masks `msk` at the pad choice `c`. -/
def ofLayers (t : Fin 4) (r : ℕ) (M : Tg → Prop) (rk : ℕ → ℕ) (msk : ℕ → ℕ → Tg → Prop)
    {P : ℕ} (hP : 0 < P) (ls : List (ℕ × Bool)) (c : Fin ls.length → Fin P)
    (g : Lp ℂ 2 (volume : Measure ℝ)) : CatTest Tg where
  t := t
  r := r
  M := M
  m := ls.length
  hr := fun i => rk (ls.getD i (0, false)).1
  hM := fun i => msk (ls.getD i (0, false)).1 (choiceExt hP c i)
  θ := fun i => if i < ls.length then (ls.getD i (0, false)).2 else false
  g := g

end CatTest

/-- Blueprint lines 1813, 1850: the residual of an averaged target filter on a layered history
of averaged catalog filters is the uniform average over the target pads and the history pad
choices of the residuals of the single-choice tests. -/
theorem residual_layerOp_eq_avg {Tg : Type*} (G : RealDyadicGrid) (Mc : ℕ) (I : ℤ × ℤ)
    (cat : List (CatCol Tg)) {P : ℕ} (hP : 0 < P) (rk : ℕ → ℕ) (msk : ℕ → ℕ → Tg → Prop)
    (t : Fin 4) (r : ℕ) (Mt : Fin P → Tg → Prop) (ls : List (ℕ × Bool)) (mH : ℕ)
    (hmH : ls.length ≤ mH) (g : Lp ℂ 2 (volume : Measure ℝ)) :
    let Cum : ℕ → ColumnL2 (Fin Mc) →L[ℂ] ColumnL2 (Fin Mc) := fun m =>
      opAvg fun p : Fin P => catProj G Mc cat I (rk m) (msk m p)
    let X := layerOp Cum ls (physicalColumnInput g)
    X - opAvg (fun p : Fin P => catProj G Mc cat I r (Mt p)) X =
      (((Finset.univ : Finset (Fin P × (Fin ls.length → Fin P))).card : ℂ))⁻¹ •
        ∑ pc : Fin P × (Fin ls.length → Fin P),
          (CatTest.ofLayers t r (Mt pc.1) rk msk hP ls pc.2 g).resid G Mc I mH cat := by
  intro Cum X
  set n := ls.length with hn
  have hP' : (P : ℂ) ≠ 0 := by exact_mod_cast hP.ne'
  -- the single-choice histories
  have hhist : ∀ (M : Tg → Prop) (c : Fin n → Fin P),
      (CatTest.ofLayers t r M rk msk hP ls c g).hist G Mc I mH cat =
        operatorComplementProduct (fun i => catProj G Mc cat I (rk (ls.getD i (0, false)).1)
          (msk (ls.getD i (0, false)).1 (choiceExt hP c i))) (fun i => (ls.getD i (0, false)).2)
          n (physicalColumnInput g) := by
    intro M c
    unfold CatTest.hist
    set w := CatTest.ofLayers t r M rk msk hP ls c g
    have htail := operatorComplementProduct_id_tail (fun l => w.Q G Mc I cat l) w.θ n
      (fun l hl => by
        change (if l < n then _ else _) = _
        rw [ite_eq_right (by omega)])
      (fun l hl => by change (if l < n then _ else false) = false; rw [ite_eq_right (by omega)])
      (mH - n)
    rw [show mH = n + (mH - n) by omega, htail]
    rw [operatorComplementProduct_congr₂ (B := fun i => catProj G Mc cat I
        (rk (ls.getD i (0, false)).1) (msk (ls.getD i (0, false)).1 (choiceExt hP c i)))
      (θ' := fun i => (ls.getD i (0, false)).2) n fun i hi => by
        refine ⟨?_, ?_⟩
        · change (if i < n then _ else _) = _
          rw [ite_eq_left hi]; rfl
        · change (if i < n then _ else false) = _
          rw [ite_eq_left hi]]
    rfl
  -- the history as an average over the pad choices
  have hX : X = (((P : ℂ) ^ n))⁻¹ • ∑ c : Fin n → Fin P,
      operatorComplementProduct (fun i => catProj G Mc cat I (rk (ls.getD i (0, false)).1)
        (msk (ls.getD i (0, false)).1 (choiceExt hP c i))) (fun i => (ls.getD i (0, false)).2)
        n (physicalColumnInput g) := by
    change layerOp Cum ls (physicalColumnInput g) = _
    rw [layerOp_eq_complementProduct]
    exact complementProduct_opAvg hP (fun i p => catProj G Mc cat I (rk (ls.getD i (0, false)).1)
      (msk (ls.getD i (0, false)).1 p)) _ n _
  -- assemble
  set hc : (Fin n → Fin P) → ColumnL2 (Fin Mc) := fun c =>
    operatorComplementProduct (fun i => catProj G Mc cat I (rk (ls.getD i (0, false)).1)
      (msk (ls.getD i (0, false)).1 (choiceExt hP c i))) (fun i => (ls.getD i (0, false)).2)
      n (physicalColumnInput g) with hhc
  set T : Fin P → ColumnL2 (Fin Mc) →L[ℂ] ColumnL2 (Fin Mc) := fun p =>
    catProj G Mc cat I r (Mt p) with hT
  have hcard : ((Finset.univ : Finset (Fin P × (Fin n → Fin P))).card : ℂ) = P * P ^ n := by
    rw [Finset.card_univ, Fintype.card_prod, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin]
    push_cast; ring
  have hres : ∀ (p : Fin P) (c : Fin n → Fin P),
      (CatTest.ofLayers t r (Mt p) rk msk hP ls c g).resid G Mc I mH cat =
        hc c - T p (hc c) := by
    intro p c
    unfold CatTest.resid
    rw [hhist]
    rfl
  rw [hcard, Fintype.sum_prod_type]
  simp only [hres]
  calc X - opAvg T X = (P : ℂ)⁻¹ • ∑ p : Fin P, (X - T p X) := by
        unfold opAvg
        rw [smul_apply, sum_apply, Finset.sum_sub_distrib, smul_sub, Finset.sum_const,
          Finset.card_univ, Fintype.card_fin, ← Nat.cast_smul_eq_nsmul ℂ, smul_smul,
          inv_mul_cancel₀ hP', one_smul]
    _ = (P : ℂ)⁻¹ • ∑ p : Fin P, (((P : ℂ) ^ n)⁻¹ • ∑ c : Fin n → Fin P,
          (hc c - T p (hc c))) := by
        congr 1
        refine Finset.sum_congr rfl fun p _ => ?_
        rw [hX, map_smul, map_sum, ← smul_sub, ← Finset.sum_sub_distrib]
    _ = _ := by
        rw [mul_inv, mul_smul]
        simp only [Finset.smul_sum]
        rfl

/-! ### Expansion of averaged catalog filters (blueprint lines 1850, 1835) -/

theorem catLabels_mono {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} (s : List (CatCol Tg))
    (I : ℤ × ℤ) (r : ℕ) {M M' : Tg → Prop} (h : ∀ x, M x → M' x) :
    catLabels G Mc s I r M ⊆ catLabels G Mc s I r M' := by
  classical
  intro n hn
  simp only [catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hn ⊢
  obtain ⟨hn, h1, h2, h3⟩ := hn
  exact ⟨hn, h1, h2, h _ h3⟩

theorem norm_catProj_le {Tg : Type*} (G : RealDyadicGrid) (Mc : ℕ) (s : List (CatCol Tg))
    (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) (X : ColumnL2 (Fin Mc)) :
    ‖catProj G Mc s I r M X‖ ≤ ‖X‖ :=
  Submodule.norm_starProjection_apply_le _ X

/-- The output of an averaged catalog filter with masks increasing in the pad is a combination
of the columns of the largest mask, with coefficients at most `‖X‖ / √|I|` (private-coordinate
recovery, blueprint line 1835). -/
theorem opAvg_catProj_expansion {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ}
    (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) {P : ℕ} (M : Fin P → Tg → Prop) (Mtop : Tg → Prop)
    (hM : ∀ p x, M p x → Mtop x) (X : ColumnL2 (Fin Mc)) :
    ∃ a : Fin Mc → ℂ, (∀ n, ‖a n‖ * Real.sqrt (dyadicGridLength G I.1) ≤ ‖X‖) ∧
      opAvg (fun p => catProj G Mc s I r (M p)) X =
        ∑ n ∈ catLabels G Mc s I r Mtop,
          a n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n := by
  classical
  have hr := dyadicGridLength_pos G I.1
  have hsq := Real.sqrt_pos.mpr hr
  have hexp := fun p : Fin P => catRange_expansion (G := G) (s := s) (I := I) (r := r)
    (M := M p) (Submodule.starProjection_apply_mem (catRange G Mc s I r (M p)) X)
  choose c hcb hc0 _hcphys hcx using hexp
  set F := catLabels G Mc s I r Mtop
  have hsub : ∀ p, catLabels G Mc s I r (M p) ⊆ F := fun p => catLabels_mono s I r (hM p)
  refine ⟨fun n => (P : ℂ)⁻¹ * ∑ p, c p n, fun n => ?_, ?_⟩
  · -- the coefficient bound
    have hcn : ∀ p, ‖c p n‖ * Real.sqrt (dyadicGridLength G I.1) ≤ ‖X‖ := by
      intro p
      have h1 := hcb p n
      have h2 := norm_catProj_le G Mc s I r (M p) X
      have h3 : (‖c p n‖ * Real.sqrt (dyadicGridLength G I.1)) ^ 2 ≤ ‖X‖ ^ 2 := by
        rw [mul_pow, Real.sq_sqrt hr.le]
        exact h1.trans (pow_le_pow_left₀ (norm_nonneg _) h2 2)
      exact (pow_le_pow_iff_left₀ (by positivity) (norm_nonneg _) two_ne_zero).mp h3
    rcases Nat.eq_zero_or_pos P with hP | hP
    · subst hP; simp [norm_nonneg]
    · rw [norm_mul, norm_inv, Complex.norm_natCast]
      have hPr : (0 : ℝ) < P := by exact_mod_cast hP
      calc (P : ℝ)⁻¹ * ‖∑ p, c p n‖ * Real.sqrt (dyadicGridLength G I.1)
          ≤ (P : ℝ)⁻¹ * ∑ p, ‖c p n‖ * Real.sqrt (dyadicGridLength G I.1) := by
            rw [mul_assoc, ← Finset.sum_mul]
            exact mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (norm_sum_le _ _)
              hsq.le) (by positivity)
        _ ≤ (P : ℝ)⁻¹ * ∑ _p : Fin P, ‖X‖ :=
            mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun p _ => hcn p) (by positivity)
        _ = ‖X‖ := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, ← mul_assoc,
              inv_mul_cancel₀ hPr.ne', one_mul]
  · -- the vector identity
    unfold opAvg
    rw [smul_apply, sum_apply]
    have hext : ∀ p, catProj G Mc s I r (M p) X = ∑ n ∈ F,
        c p n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n := by
      intro p
      change (catRange G Mc s I r (M p)).starProjection X = _
      rw [hcx p]
      refine Finset.sum_subset (hsub p) fun n _ hn => ?_
      rw [hc0 p n hn, zero_smul]
    simp only [hext]
    rw [Finset.sum_comm, Finset.smul_sum]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [← Finset.sum_smul, smul_smul]

/-! ### Square-summed coefficients of catalog combinations (blueprint line 1835) -/

/-- The coefficients of a combination of catalog columns on a cell are square summable with
`Σ |c_n|² |I| ≤ ‖x‖²` (orthonormal private coordinates of weight one). -/
theorem catCombination_l2_le {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} (s : List (CatCol Tg))
    (I : ℤ × ℤ) (F : Finset (Fin Mc)) (c : Fin Mc → ℂ) :
    (∑ n ∈ F, ‖c n‖ ^ 2) * dyadicGridLength G I.1 ≤
      ‖(∑ n ∈ F, c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n :
        ColumnL2 (Fin Mc))‖ ^ 2 := by
  classical
  set x : ColumnL2 (Fin Mc) := ∑ n ∈ F, c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n
  have hco := catCombination_coeFn (G := G) s I F c
  have hpriv : ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → ∀ m ∈ F,
      (x : ℝ → ColumnHilbert (Fin Mc)) y (some m) = c m := by
    filter_upwards [hco] with y hy hys m hm
    rw [hy hys, columnHilbert_sum_apply]
    simp only [PiLp.smul_apply, fitColumnValue_some, smul_eq_mul, mul_ite, mul_one, mul_zero]
    rw [Finset.sum_ite_eq, ite_eq_left hm]
  have hr := dyadicGridLength_pos G I.1
  have hle : ∫ y in dyadicGridCell G I.1 I.2, (∑ n ∈ F, ‖c n‖ ^ 2) ≤
      ∫ y, ‖(x : ℝ → ColumnHilbert (Fin Mc)) y‖ ^ 2 := by
    calc ∫ y in dyadicGridCell G I.1 I.2, (∑ n ∈ F, ‖c n‖ ^ 2)
        = ∫ y in dyadicGridCell G I.1 I.2,
            ∑ n ∈ F, ‖(x : ℝ → ColumnHilbert (Fin Mc)) y (some n)‖ ^ 2 := by
          refine setIntegral_congr_ae (dyadicGridCell_measurable _ _ _) ?_
          filter_upwards [hpriv] with y hy hys
          exact Finset.sum_congr rfl fun n hn => by rw [hy hys n hn]
      _ ≤ ∫ y in dyadicGridCell G I.1 I.2, ‖(x : ℝ → ColumnHilbert (Fin Mc)) y‖ ^ 2 := by
          refine setIntegral_mono_on ?_ ?_ (dyadicGridCell_measurable _ _ _) fun y _ => ?_
          · exact (integrable_finsetSum _ fun n _ =>
              ((memLp_column_coord x (some n)).integrable_norm_pow two_ne_zero)).integrableOn
          · exact ((Lp.memLp x).integrable_norm_pow two_ne_zero).integrableOn
          · rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg fun _ _ => by positivity)]
            calc ∑ n ∈ F, ‖(x : ℝ → ColumnHilbert (Fin Mc)) y (some n)‖ ^ 2
                = ∑ i ∈ F.map ⟨some, Option.some_injective _⟩,
                    ‖(x : ℝ → ColumnHilbert (Fin Mc)) y i‖ ^ 2 := by rw [Finset.sum_map]; rfl
              _ ≤ ∑ i, ‖(x : ℝ → ColumnHilbert (Fin Mc)) y i‖ ^ 2 :=
                  Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
                    fun _ _ _ => by positivity
      _ ≤ _ := setIntegral_le_integral ((Lp.memLp x).integrable_norm_pow two_ne_zero)
          (Filter.Eventually.of_forall fun _ => by positivity)
  rw [setIntegral_const, smul_eq_mul, measureReal_def, dyadicGridCell_volume,
    ENNReal.toReal_ofReal hr.le] at hle
  rw [columnInput_norm_sq_integral, mul_comm]
  exact hle

/-- Square-summed coefficients of an averaged catalog filter output. -/
theorem opAvg_catProj_l2 {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ}
    (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) {P : ℕ} (M : Fin P → Tg → Prop) (Mtop : Tg → Prop)
    (hM : ∀ p x, M p x → Mtop x) (X : ColumnL2 (Fin Mc)) :
    ∃ a : Fin Mc → ℂ,
      (∑ n ∈ catLabels G Mc s I r Mtop, ‖a n‖ ^ 2) * dyadicGridLength G I.1 ≤ ‖X‖ ^ 2 ∧
      opAvg (fun p => catProj G Mc s I r (M p)) X =
        ∑ n ∈ catLabels G Mc s I r Mtop,
          a n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n := by
  classical
  have hr := dyadicGridLength_pos G I.1
  have hexp := fun p : Fin P => catRange_expansion (G := G) (s := s) (I := I) (r := r)
    (M := M p) (Submodule.starProjection_apply_mem (catRange G Mc s I r (M p)) X)
  choose c _hcb hc0 _hcphys hcx using hexp
  set F := catLabels G Mc s I r Mtop
  have hsub : ∀ p, catLabels G Mc s I r (M p) ⊆ F := fun p => catLabels_mono s I r (hM p)
  have hext : ∀ p, catProj G Mc s I r (M p) X = ∑ n ∈ F,
      c p n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n := by
    intro p
    change (catRange G Mc s I r (M p)).starProjection X = _
    rw [hcx p]
    refine Finset.sum_subset (hsub p) fun n _ hn => ?_
    rw [hc0 p n hn, zero_smul]
  refine ⟨fun n => (P : ℂ)⁻¹ * ∑ p, c p n, ?_, ?_⟩
  · rcases Nat.eq_zero_or_pos P with hP | hP
    · subst hP; simp [norm_nonneg]
    have hPr : (0 : ℝ) < P := by exact_mod_cast hP
    -- each pad output
    have hp : ∀ p, (∑ n ∈ F, ‖c p n‖ ^ 2) * dyadicGridLength G I.1 ≤ ‖X‖ ^ 2 := by
      intro p
      refine (catCombination_l2_le (G := G) s I F (c p)).trans ?_
      rw [← hext p]
      exact pow_le_pow_left₀ (norm_nonneg _) (norm_catProj_le _ _ _ _ _ _ X) 2
    -- convexity of the square
    have hconv : ∀ n, ‖(P : ℂ)⁻¹ * ∑ p, c p n‖ ^ 2 ≤ (P : ℝ)⁻¹ * ∑ p, ‖c p n‖ ^ 2 := by
      intro n
      rw [norm_mul, norm_inv, Complex.norm_natCast, mul_pow]
      have hcs : ‖∑ p, c p n‖ ^ 2 ≤ P * ∑ p, ‖c p n‖ ^ 2 := by
        calc ‖∑ p, c p n‖ ^ 2 ≤ (∑ p, ‖c p n‖) ^ 2 :=
              pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2
          _ ≤ (Finset.univ : Finset (Fin P)).card * ∑ p, ‖c p n‖ ^ 2 :=
              sq_sum_le_card_mul_sum_sq
          _ = P * ∑ p, ‖c p n‖ ^ 2 := by rw [Finset.card_univ, Fintype.card_fin]
      calc (P : ℝ)⁻¹ ^ 2 * ‖∑ p, c p n‖ ^ 2 ≤ (P : ℝ)⁻¹ ^ 2 * (P * ∑ p, ‖c p n‖ ^ 2) :=
            mul_le_mul_of_nonneg_left hcs (by positivity)
        _ = (P : ℝ)⁻¹ * ∑ p, ‖c p n‖ ^ 2 := by field_simp
    calc (∑ n ∈ F, ‖(P : ℂ)⁻¹ * ∑ p, c p n‖ ^ 2) * dyadicGridLength G I.1
        ≤ (∑ n ∈ F, (P : ℝ)⁻¹ * ∑ p, ‖c p n‖ ^ 2) * dyadicGridLength G I.1 :=
          mul_le_mul_of_nonneg_right (Finset.sum_le_sum fun n _ => hconv n) hr.le
      _ = (P : ℝ)⁻¹ * ∑ p, (∑ n ∈ F, ‖c p n‖ ^ 2) * dyadicGridLength G I.1 := by
          rw [← Finset.mul_sum, Finset.sum_comm, mul_assoc, Finset.sum_mul]
      _ ≤ (P : ℝ)⁻¹ * ∑ _p : Fin P, ‖X‖ ^ 2 :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun p _ => hp p) (by positivity)
      _ = ‖X‖ ^ 2 := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, ← mul_assoc,
            inv_mul_cancel₀ hPr.ne', one_mul]
  · unfold opAvg
    rw [smul_apply, sum_apply]
    simp only [hext]
    rw [Finset.sum_comm, Finset.smul_sum]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [← Finset.sum_smul, smul_smul]

/-- Cauchy-Schwarz for the coefficient sums: `Σ |a_n| ≤ √N · ‖X‖ / √|I|`. -/
theorem sum_norm_le_sqrt_card {ι : Type*} (F : Finset ι) (a : ι → ℂ) {B : ℝ}
    (h : ∑ n ∈ F, ‖a n‖ ^ 2 ≤ B ^ 2) (hB : 0 ≤ B) :
    ∑ n ∈ F, ‖a n‖ ≤ Real.sqrt F.card * B := by
  have hcs := sq_sum_le_card_mul_sum_sq (s := F) (f := fun n => ‖a n‖)
  have h2 : (∑ n ∈ F, ‖a n‖) ^ 2 ≤ (Real.sqrt F.card * B) ^ 2 := by
    rw [mul_pow, Real.sq_sqrt (Nat.cast_nonneg _)]
    exact hcs.trans (mul_le_mul_of_nonneg_left h (Nat.cast_nonneg _))
  exact (pow_le_pow_iff_left₀ (Finset.sum_nonneg fun _ _ => norm_nonneg _)
    (by positivity) two_ne_zero).mp h2

/-! ### Spectator sizes and pair separation at a leaf -/

/-- The normalized size of the physical part of an augmented vector on a cell is at most
`‖x‖ / √|I|`. -/
theorem augPhys_normalized_le {V : Type*} [Fintype V] (G : RealDyadicGrid) (I : ℤ × ℤ)
    (x : ColumnL2 V) :
    eLpNorm (augPhys x) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal (‖x‖ / Real.sqrt (dyadicGridLength G I.1)) := by
  have hr := dyadicGridLength_pos G I.1
  refine eLpNorm_normalized_le_of_integral hr ((memLp_column_coord x none).restrict _)
    (by positivity) ?_
  rw [div_pow, Real.sq_sqrt hr.le, div_mul_cancel₀ _ hr.ne', columnInput_norm_sq_integral]
  refine (setIntegral_mono_on ((memLp_column_coord x none).integrable_norm_pow
    two_ne_zero).integrableOn ((Lp.memLp x).integrable_norm_pow two_ne_zero).integrableOn
    measurableSet_Ico fun y _ => ?_).trans (setIntegral_le_integral
      ((Lp.memLp x).integrable_norm_pow two_ne_zero)
      (Filter.Eventually.of_forall fun _ => by positivity))
  have : ‖(x : ℝ → ColumnHilbert V) y none‖ ≤ ‖(x : ℝ → ColumnHilbert V) y‖ := by
    rw [EuclideanSpace.norm_eq]
    exact Real.le_sqrt_of_sq_le (Finset.single_le_sum (f := fun i =>
      ‖(x : ℝ → ColumnHilbert V) y i‖ ^ 2) (fun _ _ => by positivity) (Finset.mem_univ none))
  exact pow_le_pow_left₀ (norm_nonneg _) this 2

/-- Pair separation at a leaf (blueprint line 1852): a pure source in slot `u` against a
combination of pure columns in slot `t`, each pair separated in the sense of `PairSmall`, with
two spectators of normalized sizes `S_a, S_b`. -/
theorem cellForm_pair_le {G : RealDyadicGrid} {I : ℤ × ℤ} {κ : LocalKernelClass}
    {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {Mc : ℕ} {u t a b : Fin 4} (hut : u ≠ t) (hua : u ≠ a) (hub : u ≠ b) (hta : t ≠ a)
    (htb : t ≠ b) (hab : a ≠ b) {ι : Type*} (F : Finset ι) (c : ι → ℂ)
    (col : ι → ColumnL2 (Fin Mc)) (Y : ι → ℝ → ℂ)
    (hcol : ∀ m ∈ F, ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → augPhys (col m) y = Y m y)
    (Xs : ℝ → ℂ) {τ₂ : ℝ}
    (hsep : ∀ m ∈ F, PairSmall (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI u t Xs
      (Y m) τ₂)
    (X : Fin 4 → ColumnL2 (Fin Mc))
    (hXu : ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → augPhys (X u) y = Xs y)
    (hXt : X t = ∑ m ∈ F, c m • col m) {Sa Sb : ℝ} (hSa : 0 < Sa) (hSb : 0 < Sb)
    (hXa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sa)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc) X‖ ≤
      τ₂ * Sa * Sb * ∑ m ∈ F, ‖c m‖ := by
  classical
  set Λ := cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc)
  have hcover : ∀ l : Fin 4, l = u ∨ l = t ∨ l = a ∨ l = b := fun l =>
    fin4_cover_of_distinct u t a b l hut hua hub hta htb hab
  have hXe : X = Function.update X t (∑ m ∈ F, c m • col m) := by
    rw [← hXt, Function.update_eq_self]
  rw [hXe, Λ.map_update_sum, Finset.mul_sum]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m hm => ?_)
  rw [Λ.map_update_smul, smul_eq_mul, norm_mul, mul_comm (‖c m‖)]
  refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
  -- one separated pair
  set z : Fin 4 → ℝ → ℂ := fun l => if l = a then (Sa : ℂ)⁻¹ • augPhys (X a)
    else if l = b then (Sb : ℂ)⁻¹ • augPhys (X b) else 0 with hz
  have hsm := hsep m hm z (fun l => by
    simp only [hz]; split_ifs
    · exact (columnPhys_measurable _).const_smul _
    · exact (columnPhys_measurable _).const_smul _
    · exact measurable_const) (fun l hlu hlt => by
    have hscale : ∀ (S : ℝ) (f : ℝ → ℂ), 0 < S → eLpNorm f 2 (normalizedIntervalMeasure
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≤ ENNReal.ofReal S →
        eLpNorm ((S : ℂ)⁻¹ • f) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
          (dyadicGridLength G I.1)) ≤ 1 := by
      intro S f hS hf
      rw [eLpNorm_const_smul]
      have hn : ‖((S : ℂ))⁻¹‖ₑ = ENNReal.ofReal S⁻¹ := by
        rw [← ofReal_norm, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hS]
      rw [hn]
      calc ENNReal.ofReal S⁻¹ * eLpNorm f 2 _ ≤ ENNReal.ofReal S⁻¹ * ENNReal.ofReal S := by
            gcongr
        _ = 1 := by
            rw [← ENNReal.ofReal_mul (inv_pos.mpr hS).le, inv_mul_cancel₀ hS.ne',
              ENNReal.ofReal_one]
    rcases hcover l with rfl | rfl | rfl | rfl
    · exact absurd rfl hlu
    · exact absurd rfl hlt
    · simp only [hz, ↓reduceIte]; exact hscale Sa _ hSa hXa
    · simp only [hz, Ne.symm hab, ↓reduceIte]; exact hscale Sb _ hSb hXb)
  -- rescale and compare on the cell
  have hform : Λ (Function.update X t (col m)) = (Sa * Sb : ℂ) *
      localProgressionForm (dyadicGridLength G I.1) wI (slotPair z u t Xs (Y m)) := by
    rw [cellForm_apply]
    set cc : Fin 4 → ℂ := fun l => if l = a then (Sa : ℂ) else if l = b then (Sb : ℂ) else 1
    have e : localProgressionForm (dyadicGridLength G I.1) wI
        (fun l => augPhys (Function.update X t (col m) l)) =
        localProgressionForm (dyadicGridLength G I.1) wI
          (fun l => cc l • slotPair z u t Xs (Y m) l) := by
      refine localProgressionForm_congr_cell hwI fun l => ?_
      filter_upwards [hXu, hcol m hm] with y hy1 hy2 hyI
      rcases hcover l with rfl | rfl | rfl | rfl
      · simp only [cc, hua, hub, ↓reduceIte, one_smul, slotPair_left hut,
          Function.update_of_ne hut]
        exact hy1 hyI
      · simp only [cc, hta, htb, ↓reduceIte, one_smul, Function.update_self, slotPair]
        exact hy2 hyI
      · simp only [cc, ↓reduceIte, slotPair, Function.update_of_ne hua.symm,
          Function.update_of_ne hta.symm, hz, Pi.smul_apply, smul_smul]
        rw [mul_inv_cancel₀ (by exact_mod_cast hSa.ne'), one_smul]
      · simp only [cc, Ne.symm hab, ↓reduceIte, slotPair, Function.update_of_ne hub.symm,
          Function.update_of_ne htb.symm, hz, Pi.smul_apply, smul_smul]
        rw [mul_inv_cancel₀ (by exact_mod_cast hSb.ne'), one_smul]
    rw [e, localProgressionForm_smul]
    congr 1
    have huniv : (Finset.univ : Finset (Fin 4)) = {u, t, a, b} := by
      ext l
      simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_singleton, true_iff]
      exact hcover l
    rw [huniv, Finset.prod_insert (by simp [hut, hua, hub]),
      Finset.prod_insert (by simp [hta, htb]), Finset.prod_insert (by simp [hab]),
      Finset.prod_singleton]
    simp only [cc, hua, hub, hta, htb, Ne.symm hab, ↓reduceIte, one_mul]
  rw [hform, norm_mul]
  have hn : ‖((Sa : ℂ) * Sb)‖ = Sa * Sb := by
    rw [norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_pos hSa, abs_of_pos hSb]
  rw [hn]
  calc Sa * Sb * ‖localProgressionForm (dyadicGridLength G I.1) wI (slotPair z u t Xs (Y m))‖
      ≤ Sa * Sb * τ₂ := mul_le_mul_of_nonneg_left hsm (by positivity)
    _ = τ₂ * Sa * Sb := by ring

/-- A combination of pure sources in slot `u` against an averaged test residual in slot `r`
(each source tag in all test masks) with two spectators (blueprint lines 1850-1855). -/
theorem CatTest.form_combo_le {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {I : ℤ × ℤ}
    {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {wI : ℝ × ℝ → ℂ} {mH : ℕ}
    {cat : List (CatCol Tg)} {κ : LocalKernelClass}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (tests : ι → CatTest Tg) (τ : ι → ℝ)
    (hpass : ∀ i ∈ s, (tests i).Pass G Mc I c₀ H tagOf wI (τ i) mH cat)
    {r : Fin 4} (hr : ∀ i ∈ s, (tests i).t = r)
    {u a b : Fin 4} (hur : u ≠ r) (hua : u ≠ a) (hub : u ≠ b) (hra : r ≠ a) (hrb : r ≠ b)
    (hab : a ≠ b) {κs : Type*} (F : Finset κs) (c : κs → ℂ) (src : κs → ColumnL2 (Fin Mc))
    (tag : κs → Tg) (htag : ∀ m ∈ F, ∀ i ∈ s, (tests i).M (tag m))
    (hsrc : ∀ m ∈ F, ∃ A : QuadraticChartData (tagOf (tag m)).dim,
      QuadraticChartComplexity c₀ H A ∧ A.horizontal = (tagOf (tag m)).θ ∧
      A.matrix = (slotCoeff u : ℚ) • (tagOf (tag m)).C ∧
      A.quadratic = slotCoeff u * (tagOf (tag m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → augPhys (src m) y = quadraticChartAtom A y)
    (X : Fin 4 → ColumnL2 (Fin Mc)) (hXu : X u = ∑ m ∈ F, c m • src m)
    (hXr : X r = ((s.card : ℂ))⁻¹ • ∑ i ∈ s, (tests i).resid G Mc I mH cat)
    {Sa Sb B : ℝ} (hSa : 0 < Sa) (hSb : 0 < Sb)
    (hXa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sa)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sb)
    (hB : ∀ i ∈ s, τ i * ‖physicalColumnInput (V := Fin Mc) (tests i).g‖ /
      Real.sqrt (dyadicGridLength G I.1) * Sa * Sb ≤ B) :
    ‖cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc) X‖ ≤ (∑ m ∈ F, ‖c m‖) * B := by
  set Λ := cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc)
  have hXe : X = Function.update X u (∑ m ∈ F, c m • src m) := by
    rw [← hXu, Function.update_eq_self]
  rw [hXe, Λ.map_update_sum, Finset.sum_mul]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m hm => ?_)
  rw [Λ.map_update_smul, smul_eq_mul, norm_mul]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
  obtain ⟨A, hA, hAθ, hAM, hAq, hAe⟩ := hsrc m hm
  exact CatTest.form_avg_le hwI s hs tests τ hpass hr (fun i hi => htag m hm i hi) hur hua hub
    hra hrb hab A hA hAθ hAM hAq _ (by rw [Function.update_self]; exact hAe)
    (by rw [Function.update_of_ne hur.symm]; exact hXr) hSa hSb
    (by rw [Function.update_of_ne hua.symm]; exact hXa)
    (by rw [Function.update_of_ne hub.symm]; exact hXb) hB

/-! ### Contractions -/

section Contractions

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

theorem norm_opAvg_apply_le {P : ℕ} (Q : Fin P → H →L[ℂ] H) (hQ : ∀ p x, ‖Q p x‖ ≤ ‖x‖)
    (x : H) : ‖opAvg Q x‖ ≤ ‖x‖ := by
  unfold opAvg
  rw [smul_apply, sum_apply, norm_smul, norm_inv, Complex.norm_natCast]
  rcases Nat.eq_zero_or_pos P with hP | hP
  · subst hP; simp
  · have hPr : (0 : ℝ) < P := by exact_mod_cast hP
    rw [inv_mul_le_iff₀ hPr]
    calc ‖∑ p, Q p x‖ ≤ ∑ p, ‖Q p x‖ := norm_sum_le _ _
      _ ≤ ∑ _p : Fin P, ‖x‖ := Finset.sum_le_sum fun p _ => hQ p x
      _ = P * ‖x‖ := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]

theorem norm_id_sub_opAvg_apply_le {P : ℕ} (hP : 0 < P) (Q : Fin P → H →L[ℂ] H)
    (hQ : ∀ p x, ‖x - Q p x‖ ≤ ‖x‖) (x : H) :
    ‖(ContinuousLinearMap.id ℂ H - opAvg Q) x‖ ≤ ‖x‖ := by
  rw [id_sub_opAvg hP]
  exact norm_opAvg_apply_le _ (fun p y => by simpa using hQ p y) x

/-- A layered product of contractions whose complements are contractions is a contraction. -/
theorem norm_layerOp_apply_le (Cum : ℕ → H →L[ℂ] H) (h1 : ∀ m x, ‖Cum m x‖ ≤ ‖x‖)
    (h2 : ∀ m x, ‖(ContinuousLinearMap.id ℂ H - Cum m) x‖ ≤ ‖x‖) (ls : List (ℕ × Bool))
    (x : H) : ‖layerOp Cum ls x‖ ≤ ‖x‖ := by
  induction ls using List.reverseRecOn with
  | nil => simp [layerOp_nil]
  | append_singleton ls y ih =>
    rw [layerOp_append, ContinuousLinearMap.comp_apply]
    split_ifs
    · exact (h2 _ _).trans ih
    · exact (h1 _ _).trans ih

end Contractions

theorem norm_catProj_complement_le {Tg : Type*} (G : RealDyadicGrid) (Mc : ℕ)
    (s : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) (X : ColumnL2 (Fin Mc)) :
    ‖X - catProj G Mc s I r M X‖ ≤ ‖X‖ := by
  have h := Submodule.starProjection_orthogonal_val (K := catRange G Mc s I r M) X
  change ‖X - (catRange G Mc s I r M).starProjection X‖ ≤ ‖X‖
  rw [← h]
  exact Submodule.norm_starProjection_apply_le _ X

/-! ### The leaf of an attempt (blueprint prop:localize, lines 1848-1856) -/

/-- The data of the filters of an attempt at one cell: slot catalogs, the number `P` of pads,
the ranks and pad masks of the cumulative splits `m` and of the ball levels `j` of each group,
and the bases of the four slots. -/
structure LeafFilters (Tg γ : Type*) where
  G : RealDyadicGrid
  I : ℤ × ℤ
  Mc : ℕ
  cat : Fin 4 → List (CatCol Tg)
  P : ℕ
  hP : 0 < P
  rkC : ℕ → ℕ
  cm : ℕ → ℕ → Tg → Prop
  rkB : ℕ → ℕ
  bm : γ → ℕ → ℕ → Tg → Prop
  g : Fin 4 → Lp ℂ 2 (volume : Measure ℝ)

namespace LeafFilters

variable {Tg γ : Type*} (F : LeafFilters Tg γ)

/-- The averaged cumulative filter of slot `l` at the split `m`. -/
noncomputable def cum (l : Fin 4) (m : ℕ) : ColumnL2 (Fin F.Mc) →L[ℂ] ColumnL2 (Fin F.Mc) :=
  opAvg fun p : Fin F.P => catProj F.G F.Mc (F.cat l) F.I (F.rkC m) (F.cm m p)

/-- The averaged ball filter of group `G` at level `j` in slot `l`. -/
noncomputable def ball (G : γ) (j : ℕ) (l : Fin 4) :
    ColumnL2 (Fin F.Mc) →L[ℂ] ColumnL2 (Fin F.Mc) :=
  opAvg fun p : Fin F.P => catProj F.G F.Mc (F.cat l) F.I (F.rkB j) (F.bm G j p)

/-- The input of slot `l` at a leaf with layers `ls`. -/
noncomputable def input (ls : Fin 4 → List (ℕ × Bool)) (l : Fin 4) : ColumnL2 (Fin F.Mc) :=
  layerOp (F.cum l) (ls l) (physicalColumnInput (F.g l))

theorem norm_input_le (ls : Fin 4 → List (ℕ × Bool)) (l : Fin 4) :
    ‖F.input ls l‖ ≤ ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ := by
  unfold input
  refine norm_layerOp_apply_le _ (fun m x => ?_) (fun m x => ?_) _ _
  · exact norm_opAvg_apply_le _ (fun _ y => norm_catProj_le _ _ _ _ _ _ y) x
  · exact norm_id_sub_opAvg_apply_le F.hP _
      (fun _ y => norm_catProj_complement_le _ _ _ _ _ _ y) x

theorem norm_ball_le (G : γ) (j : ℕ) (l : Fin 4) (x : ColumnL2 (Fin F.Mc)) :
    ‖F.ball G j l x‖ ≤ ‖x‖ :=
  norm_opAvg_apply_le _ (fun _ y => norm_catProj_le _ _ _ _ _ _ y) x

/-- The single-choice test of a filter residual in slot `l` on its layers `ls`. -/
noncomputable def test (l : Fin 4) (r : ℕ) (M : Tg → Prop) (ls : List (ℕ × Bool))
    (c : Fin ls.length → Fin F.P) : CatTest Tg :=
  CatTest.ofLayers l r M F.rkC F.cm F.hP ls c (F.g l)

/-- A ball residual of a slot input is an average of single-choice test residuals. -/
theorem ball_resid_eq (ls : Fin 4 → List (ℕ × Bool)) (l : Fin 4) (G : γ) (j : ℕ) (mH : ℕ)
    (hmH : (ls l).length ≤ mH) :
    F.input ls l - F.ball G j l (F.input ls l) =
      (((Finset.univ : Finset (Fin F.P × (Fin (ls l).length → Fin F.P))).card : ℂ))⁻¹ •
        ∑ pc : Fin F.P × (Fin (ls l).length → Fin F.P),
          (F.test l (F.rkB j) (F.bm G j pc.1) (ls l) pc.2).resid F.G F.Mc F.I mH (F.cat l) :=
  residual_layerOp_eq_avg F.G F.Mc F.I (F.cat l) F.hP F.rkC F.cm l (F.rkB j)
    (fun p => F.bm G j p) (ls l) mH hmH (F.g l)

/-- A lower guard input, ending with the residual filter at `m`, is an average of single-choice
test residuals of the cumulative mask at `m`. -/
theorem guard_resid_eq (ls : Fin 4 → List (ℕ × Bool)) (l : Fin 4) {ls' : List (ℕ × Bool)}
    {m : ℕ} (hls : ls l = ls' ++ [(m, true)]) (mH : ℕ) (hmH : ls'.length ≤ mH) :
    F.input ls l =
      (((Finset.univ : Finset (Fin F.P × (Fin ls'.length → Fin F.P))).card : ℂ))⁻¹ •
        ∑ pc : Fin F.P × (Fin ls'.length → Fin F.P),
          (F.test l (F.rkC m) (F.cm m pc.1) ls' pc.2).resid F.G F.Mc F.I mH (F.cat l) := by
  have h := residual_layerOp_eq_avg F.G F.Mc F.I (F.cat l) F.hP F.rkC F.cm l (F.rkC m)
    (fun p => F.cm m p) ls' mH hmH (F.g l)
  simp only at h
  refine Eq.trans ?_ h
  unfold input
  rw [hls, layerOp_append]
  rfl

end LeafFilters

theorem augPhys_fitColumn_ae {Mc : ℕ} {s : Set ℝ} {ψ : ℝ → ℂ} (h : FitAdmissible s ψ)
    (n : Fin Mc) : ∀ᵐ y ∂volume, y ∈ s → augPhys (fitColumn s ψ n) y = ψ y := by
  filter_upwards [fitColumn_coeFn h n] with y hy hys
  simp only [augPhys, hy, Set.indicator_of_mem hys, fitColumnValue_none]

/-- The size of a vector whose norm is at most that of a base input. -/
theorem augPhys_le_of_norm_le {Mc : ℕ} (G : RealDyadicGrid) (I : ℤ × ℤ) {x : ColumnL2 (Fin Mc)}
    {g : Lp ℂ 2 (volume : Measure ℝ)} {Sz : ℝ}
    (hx : ‖x‖ ≤ ‖physicalColumnInput (V := Fin Mc) g‖)
    (hSz : ‖physicalColumnInput (V := Fin Mc) g‖ / Real.sqrt (dyadicGridLength G I.1) ≤ Sz) :
    eLpNorm (augPhys x) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sz := by
  refine (augPhys_normalized_le G I x).trans (ENNReal.ofReal_le_ofReal ?_)
  have hs := Real.sqrt_pos.mpr (dyadicGridLength_pos G I.1)
  exact (div_le_div_of_nonneg_right hx hs.le).trans hSz

namespace LeafFilters

variable {Tg γ : Type*} (F : LeafFilters Tg γ)

/-- The source condition: a pure chart of the tag in slot `u` equal to the vector on the cell. -/
def IsSource (c₀ : ℕ) (H : ℝ) (tagOf : Tg → ChartTag) (u : Fin 4) (x : Tg)
    (φ : ColumnL2 (Fin F.Mc)) : Prop :=
  ∃ A : QuadraticChartData (tagOf x).dim, QuadraticChartComplexity c₀ H A ∧
    A.horizontal = (tagOf x).θ ∧ A.matrix = (slotCoeff u : ℚ) • (tagOf x).C ∧
    A.quadratic = slotCoeff u * (tagOf x).lam ∧
    ∀ᵐ y ∂volume, y ∈ dyadicGridCell F.G F.I.1 F.I.2 → augPhys φ y = quadraticChartAtom A y

/-- Old sources are killed by the lower guard (blueprint line 1850): the bound holds with the
slot-`t` input or any contraction of it. -/
theorem old_le {κ : LocalKernelClass} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft F.G F.I.1 F.I.2)
      (dyadicGridLength F.G F.I.1) wI) {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {mH : ℕ}
    (ls : Fin 4 → List (ℕ × Bool)) {u t gl a : Fin 4} (hut : u ≠ t) (hug : u ≠ gl)
    (hua : u ≠ a) (htg : t ≠ gl) (hta : t ≠ a) (hga : gl ≠ a)
    {τo Sz : ℝ} (hτo : 0 ≤ τo) (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ /
      Real.sqrt (dyadicGridLength F.G F.I.1) ≤ Sz)
    {x : Tg} {φ : ColumnL2 (Fin F.Mc)} (hφ : F.IsSource c₀ H tagOf u x φ)
    {ls' : List (ℕ × Bool)} {m : ℕ} (hls : ls gl = ls' ++ [(m, true)]) (hmH : ls'.length ≤ mH)
    (hpass : ∀ pc : Fin F.P × (Fin ls'.length → Fin F.P),
      (F.test gl (F.rkC m) (F.cm m pc.1) ls' pc.2).Pass F.G F.Mc F.I c₀ H tagOf wI τo mH
        (F.cat gl))
    (htag : ∀ p : ℕ, F.cm m p x) (y : ColumnL2 (Fin F.Mc))
    (hy : ‖y‖ ≤ ‖physicalColumnInput (V := Fin F.Mc) (F.g t)‖) :
    ‖cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc)
      (Function.update (Function.update (F.input ls) u φ) t y)‖ ≤ τo * Sz ^ 3 := by
  obtain ⟨A, hA, hAθ, hAM, hAq, hAe⟩ := hφ
  set X := Function.update (Function.update (F.input ls) u φ) t y
  refine CatTest.form_avg_le hwI (Finset.univ : Finset (Fin F.P × (Fin ls'.length → Fin F.P)))
    ⟨(⟨0, F.hP⟩, fun _ => ⟨0, F.hP⟩), Finset.mem_univ _⟩ _ (fun _ => τo)
    (fun pc _ => hpass pc) (r := gl) (fun _ _ => rfl) (fun pc _ => htag _) hug hut hua
    htg.symm hga hta A hA hAθ hAM hAq X ?_ ?_ hSz0 hSz0 ?_ ?_ ?_
  · simp only [X, Function.update_of_ne hut, Function.update_self]; exact hAe
  · simp only [X, Function.update_of_ne htg.symm, Function.update_of_ne hug.symm]
    exact F.guard_resid_eq ls gl hls mH hmH
  · simp only [X, Function.update_self]
    exact augPhys_le_of_norm_le F.G F.I hy (hSz t)
  · simp only [X, Function.update_of_ne hta.symm, Function.update_of_ne hua.symm]
    exact augPhys_le_of_norm_le F.G F.I (F.norm_input_le ls a) (hSz a)
  · intro pc _
    have h := hSz gl
    have hs := Real.sqrt_pos.mpr (dyadicGridLength_pos F.G F.I.1)
    change τo * ‖physicalColumnInput (V := Fin F.Mc) (F.g gl)‖ /
      Real.sqrt (dyadicGridLength F.G F.I.1) * Sz * Sz ≤ τo * Sz ^ 3
    rw [mul_div_assoc]
    calc τo * (‖physicalColumnInput (V := Fin F.Mc) (F.g gl)‖ /
          Real.sqrt (dyadicGridLength F.G F.I.1)) * Sz * Sz ≤ τo * Sz * Sz * Sz := by gcongr
      _ = τo * Sz ^ 3 := by ring

/-- The matching difference of a current source against its group's first ball projection
(blueprint line 1851). -/
theorem match_le {κ : LocalKernelClass} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft F.G F.I.1 F.I.2)
      (dyadicGridLength F.G F.I.1) wI) {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {mH : ℕ}
    (ls : Fin 4 → List (ℕ × Bool)) {u t a b : Fin 4} (hut : u ≠ t) (hua : u ≠ a)
    (hub : u ≠ b) (hta : t ≠ a) (htb : t ≠ b) (hab : a ≠ b)
    {τb Sz : ℝ} (hτb : 0 ≤ τb) (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ /
      Real.sqrt (dyadicGridLength F.G F.I.1) ≤ Sz)
    {x : Tg} {φ : ColumnL2 (Fin F.Mc)} (hφ : F.IsSource c₀ H tagOf u x φ) (G₀ : γ) (j : ℕ)
    (hmH : (ls t).length ≤ mH)
    (hpass : ∀ pc : Fin F.P × (Fin (ls t).length → Fin F.P),
      (F.test t (F.rkB j) (F.bm G₀ j pc.1) (ls t) pc.2).Pass F.G F.Mc F.I c₀ H tagOf wI τb mH
        (F.cat t))
    (htag : ∀ p : ℕ, F.bm G₀ j p x) :
    ‖cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc)
      (Function.update (Function.update (F.input ls) u φ) t
        (F.input ls t - F.ball G₀ j t (F.input ls t)))‖ ≤ τb * Sz ^ 3 := by
  obtain ⟨A, hA, hAθ, hAM, hAq, hAe⟩ := hφ
  set X := Function.update (Function.update (F.input ls) u φ) t
    (F.input ls t - F.ball G₀ j t (F.input ls t))
  refine CatTest.form_avg_le hwI (Finset.univ : Finset (Fin F.P × (Fin (ls t).length → Fin F.P)))
    ⟨(⟨0, F.hP⟩, fun _ => ⟨0, F.hP⟩), Finset.mem_univ _⟩ _ (fun _ => τb)
    (fun pc _ => hpass pc) (r := t) (fun _ _ => rfl) (fun pc _ => htag _) hut hua hub
    hta htb hab A hA hAθ hAM hAq X ?_ ?_ hSz0 hSz0 ?_ ?_ ?_
  · simp only [X, Function.update_of_ne hut, Function.update_self]; exact hAe
  · simp only [X, Function.update_self]
    exact F.ball_resid_eq ls t G₀ j mH hmH
  · simp only [X, Function.update_of_ne hta.symm, Function.update_of_ne hua.symm]
    exact augPhys_le_of_norm_le F.G F.I (F.norm_input_le ls a) (hSz a)
  · simp only [X, Function.update_of_ne htb.symm, Function.update_of_ne hub.symm]
    exact augPhys_le_of_norm_le F.G F.I (F.norm_input_le ls b) (hSz b)
  · intro pc _
    have h := hSz t
    change τb * ‖physicalColumnInput (V := Fin F.Mc) (F.g t)‖ /
      Real.sqrt (dyadicGridLength F.G F.I.1) * Sz * Sz ≤ τb * Sz ^ 3
    rw [mul_div_assoc]
    calc τb * (‖physicalColumnInput (V := Fin F.Mc) (F.g t)‖ /
          Real.sqrt (dyadicGridLength F.G F.I.1)) * Sz * Sz ≤ τb * Sz * Sz * Sz := by gcongr
      _ = τb * Sz ^ 3 := by ring

/-- The separation of a current source from the first ball outputs of the other groups
(blueprint line 1852). -/
theorem sep_le {κ : LocalKernelClass} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft F.G F.I.1 F.I.2)
      (dyadicGridLength F.G F.I.1) wI)
    (ls : Fin 4 → List (ℕ × Bool)) {u t a b : Fin 4} (hut : u ≠ t) (hua : u ≠ a)
    (hub : u ≠ b) (hta : t ≠ a) (htb : t ≠ b) (hab : a ≠ b) {τ₂ Sz : ℝ} (hτ₂ : 0 ≤ τ₂)
    (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ /
      Real.sqrt (dyadicGridLength F.G F.I.1) ≤ Sz)
    {φ : ColumnL2 (Fin F.Mc)} (Xs : ℝ → ℂ)
    (hφ : ∀ᵐ y ∂volume, y ∈ dyadicGridCell F.G F.I.1 F.I.2 → augPhys φ y = Xs y)
    (G : γ) (j : ℕ) (Mtop : Tg → Prop) (hMtop : ∀ (p : Fin F.P) x, F.bm G j p x → Mtop x)
    (hsep : ∀ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB j) Mtop,
      PairSmall (dyadicGridLeft F.G F.I.1 F.I.2) (dyadicGridLength F.G F.I.1) wI u t Xs
        (catAtom (F.cat t) n) τ₂) {Nt : ℝ}
    (hNt : ((catLabels F.G F.Mc (F.cat t) F.I (F.rkB j) Mtop).card : ℝ) ≤ Nt) :
    ‖cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc)
      (Function.update (Function.update (F.input ls) u φ) t
        (F.ball G j t (F.input ls t)))‖ ≤ τ₂ * Sz ^ 3 * Real.sqrt Nt := by
  obtain ⟨c, hcb, hce⟩ := opAvg_catProj_l2 (G := F.G) (F.cat t) F.I (F.rkB j)
    (fun p : Fin F.P => F.bm G j p) Mtop (fun p x hx => hMtop p x hx) (F.input ls t)
  set X := Function.update (Function.update (F.input ls) u φ) t (F.ball G j t (F.input ls t))
  have hs := Real.sqrt_pos.mpr (dyadicGridLength_pos F.G F.I.1)
  have hsum : ∑ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB j) Mtop, ‖c n‖ ≤
      Real.sqrt Nt * Sz := by
    have hB : ∑ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB j) Mtop, ‖c n‖ ^ 2 ≤ Sz ^ 2 := by
      have h2 := F.norm_input_le ls t
      have h3 := hSz t
      rw [div_le_iff₀ hs] at h3
      have h4 : ‖F.input ls t‖ ^ 2 ≤ (Sz * Real.sqrt (dyadicGridLength F.G F.I.1)) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) (h2.trans h3) 2
      rw [mul_pow, Real.sq_sqrt (dyadicGridLength_pos F.G F.I.1).le] at h4
      exact le_of_mul_le_mul_right (hcb.trans h4) (dyadicGridLength_pos F.G F.I.1)
    refine (sum_norm_le_sqrt_card _ c hB hSz0.le).trans ?_
    exact mul_le_mul_of_nonneg_right (Real.sqrt_le_sqrt hNt) hSz0.le
  have h := cellForm_pair_le hwI hut hua hub hta htb hab
    (catLabels F.G F.Mc (F.cat t) F.I (F.rkB j) Mtop) c
    (fun n => fitColumn (dyadicGridCell F.G F.I.1 F.I.2) (catAtom (F.cat t) n) n)
    (fun n => catAtom (F.cat t) n)
    (fun n _ => augPhys_fitColumn_ae (catAtom_admissible (F.cat t) n F.I) n) Xs hsep X
    (by simp only [X, Function.update_of_ne hut, Function.update_self]; exact hφ)
    (by simp only [X, Function.update_self]; exact hce) hSz0 hSz0
    (by simp only [X, Function.update_of_ne hta.symm, Function.update_of_ne hua.symm]
        exact augPhys_le_of_norm_le F.G F.I (F.norm_input_le ls a) (hSz a))
    (by simp only [X, Function.update_of_ne htb.symm, Function.update_of_ne hub.symm]
        exact augPhys_le_of_norm_le F.G F.I (F.norm_input_le ls b) (hSz b))
  refine h.trans ?_
  calc τ₂ * Sz * Sz * ∑ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB j) Mtop, ‖c n‖ ≤
      τ₂ * Sz * Sz * (Real.sqrt Nt * Sz) := mul_le_mul_of_nonneg_left hsum (by positivity)
    _ = τ₂ * Sz ^ 3 * Real.sqrt Nt := by ring

end LeafFilters

