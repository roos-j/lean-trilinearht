/-- Blueprint prop:localize at one active cell and one leaf, with the expansion of the upper guard:
a catalog filter (coefficients square summable over its `Nu` labels) or the basic slot (vertex
charts with coefficients at most `D_c`). -/
theorem leaf_main (cat : Fin 4 → List (CatCol A.Vtx))
    (hT : ∀ l, ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag)
    {τ : ℕ → ℝ} {I : ℤ × ℤ} (hI : I ∈ A.cells)
    (hpass : ∀ l (w : ap.TestIdx I l), (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc
      A.Hsrc A.vtag (A.w I) (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l))
    (hsucc : ∀ w ∈ A.admT.X (A.admAt I),
      ap.K.Success (ap.K.colorData (A.admT.st (A.admAt I)) w))
    (hLcol : ∀ w ∈ A.admT.X (A.admAt I), ap.K.color A.admT A.vtxBound (A.admAt I) w ≤ ap.Lc)
    (hzB : ap.z I ap.up₀ = A.B ap.up₀ I)
    (hL1 : 1 ≤ ap.Lc) (hfuel : ap.Lc - 1 < 2 ^ ap.fuel) (hmH : ap.fuel ≤ ap.mH)
    (hPH : ap.bbase 1 + ap.P ≤ ap.Hmax) (s : Fin ap.leaves.length)
    {τo τm τr τ₂ Sz Nt Nu : ℝ} (hτo : 0 ≤ τo) (hτm : 0 ≤ τm) (hτr : 0 ≤ τr) (hτ₂ : 0 < τ₂)
    (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ ap.Hed)
    (hτo' : τ (ap.Lc - ((leafAt ap.fuel ap.Lc ap.up₀ s).k - 1) + 1) ≤ τo)
    (hτm' : τ (ap.Lc + 1) ≤ τm) (hτr' : ∀ j, 2 ≤ j → j ≤ 4 → τ (ap.Lc + j) ≤ τr)
    (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
      Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    (hNu : ((catLabels A.G ap.Mc (cat (leafAt ap.fuel ap.Lc ap.up₀ s).up) I
      (ap.Lc - (leafAt ap.fuel ap.Lc ap.up₀ s).k + 1)
        (fun x => ∃ p : Fin ap.P, ap.cmask I (leafAt ap.fuel ap.Lc ap.up₀ s).k p x)).card : ℝ) ≤
      Nu)
    (hNt : ∀ G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k,
      ((catLabels A.G ap.Mc (cat (thirdSlot (leafAt ap.fuel ap.Lc ap.up₀ s).up
        (leafAt ap.fuel ap.Lc ap.up₀ s).low)) I (ap.Lc + 1)
          (fun y => ∃ p : Fin ap.P, ap.bmask I G 1 p y)).card : ℝ) ≤ Nt) :
    ‖cellForm (dyadicGridLength_pos A.G I.1) (A.adm I hI) (Fin ap.Mc)
        ((ap.filters cat I).input (leafAt ap.fuel ap.Lc ap.up₀ s).layers) -
      ∑ G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k,
        cellForm (dyadicGridLength_pos A.G I.1) (A.adm I hI) (Fin ap.Mc)
          (fun l => (ap.filters cat I).ball G ((leafAt ap.fuel ap.Lc ap.up₀ s).role l) l
            ((ap.filters cat I).input (leafAt ap.fuel ap.Lc ap.up₀ s).layers l))‖ ≤
      (Real.sqrt Nu * Sz + Fintype.card A.L * A.Dc) *
          (((ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k).card + 1) *
          (τo * Sz ^ 3) + τm * Sz ^ 3 +
          (ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k).card *
            (τ₂ * Sz ^ 3 * Real.sqrt Nt)) +
        (ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k).card *
          (3 * ((Real.sqrt Nt * Sz) * (τr * Sz ^ 3))) := by
  set L := leafAt ap.fuel ap.Lc ap.up₀ s with hLdef
  set F := ap.filters cat I
  have hsL : (s : ℕ) < (searchList ap.fuel ap.Lc ap.up₀).length := s.2
  obtain ⟨hkhi, hk1, hkL, hinv⟩ := leafAt_facts hL1 hfuel hsL
  have hr := dyadicGridLength_pos A.G I.1
  have hE : 0 ≤ ((ap.groupsAt I L.k).card + 1) * (τo * Sz ^ 3) + τm * Sz ^ 3 +
      (ap.groupsAt I L.k).card * (τ₂ * Sz ^ 3 * Real.sqrt Nt) := by
    have := hτ₂.le; positivity
  have hLD : (0 : ℝ) ≤ Fintype.card A.L * A.Dc := mul_nonneg (Nat.cast_nonneg _) A.Dc_nonneg
  have hNu0 : (0 : ℝ) ≤ Nu := le_trans (Nat.cast_nonneg _) hNu
  rcases hinv.2.1 with ⟨ls', hls'⟩ | ⟨hup, hnil, hhi⟩
  · -- the catalog case
    rw [← hkhi] at hls'
    obtain ⟨a, hl2, hxe⟩ := F.upper_expansion L.layers L.up hls'
    set S := catLabels A.G ap.Mc (cat L.up) I (ap.Lc - L.k + 1)
      (fun x => ∃ p : Fin ap.P, ap.cmask I L.k p x)
    have h := ap.leaf_bound cat hT hI hpass hsucc hL1 hfuel hmH hPH s hτo hτm hτr hτ₂ hτ₂1 hHed
      hτo' hτm' hτr' hSz0 hSz S a
      (fun n => fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom (cat L.up) n) n) hxe
      (fun n hn => by
        have hn' := hn
        simp only [S, catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hn'
        obtain ⟨hnl, -, -, p, hp⟩ := hn'
        have hav := A.occAvail_of_mem (ap.cmask_present hp)
        obtain ⟨Ax, hAx, hAb, hθ, hM, hq, he⟩ := catAtom_chart (cat L.up) L.up (hT L.up) hnl hav
        refine ⟨_, ap.cbase L.k + p + 1,
          Nat.add_le_add_left (Nat.succ_le_of_lt p.2) _, hp, Ax, hAx, hAb, hθ, hM, hq, ?_⟩
        filter_upwards [augPhys_fitColumn_ae (catAtom_admissible (G := A.G) (cat L.up) n I) n]
          with y hy hyI
        exact (hy hyI).trans (congrFun he y))
      hNt
    refine h.trans ?_
    have hsum : ∑ n ∈ S, ‖a n‖ ≤ Real.sqrt Nu * Sz :=
      (sum_norm_le_of_l2 S a hr hSz0.le hl2 (norm_nonneg _) (hSz L.up)).trans
        (mul_le_mul_of_nonneg_right (Real.sqrt_le_sqrt hNu) hSz0.le)
    gcongr
    linarith
  · -- the basic case
    have hk : L.k = ap.Lc := hkhi.trans hhi
    have hxe : F.input L.layers L.up = ∑ v ∈ Finset.univ.filter (fun v => A.coef ap.up₀ I v ≠ 0),
        A.coef ap.up₀ I v • physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.φ I v)) := by
      change layerOp (F.cum L.up) (L.layers L.up)
        (physicalColumnInput (cellLp A.G I (ap.z I L.up))) = _
      rw [hnil, layerOp_nil, hup, hzB]
      exact A.basic_expansion ap.Mc I ap.up₀
    have h := ap.leaf_bound cat hT hI hpass hsucc hL1 hfuel hmH hPH s hτo hτm hτr hτ₂ hτ₂1 hHed
      hτo' hτm' hτr' hSz0 hSz _ _ _ hxe
      (fun v hv => by
        have hcv : A.coef ap.up₀ I v ≠ 0 := (Finset.mem_filter.mp hv).2
        set x := A.basicVtx hI ap.up₀ v
        have hxX := A.basicVtx_mem hI hcv
        obtain ⟨-, hsub, hav⟩ := A.basicVtx_anc hI hcv
        obtain ⟨hc, hb, hθ, hM, hq⟩ := A.vchart_source (x := x) hav
        obtain ⟨-, -, he⟩ := A.vchart_spec x hav
        have hφ : A.φ I v = A.φ x.2.1 v :=
          A.nested_cons I hI _ hav.1 hsub v ⟨ap.up₀, hcv⟩ ⟨ap.up₀, hav.2⟩
        refine ⟨x, 0, Nat.zero_le _, ⟨hxX, x, hxX, by rw [hk]; exact hLcol x hxX, ?_⟩,
          (A.vchart x).2, hc, hb, hθ, by rw [hup]; exact hM, by rw [hup]; exact hq, ?_⟩
        · rw [ap.K.dist.self]; exact zero_le
        · filter_upwards [augPhys_cellLp (Mc := ap.Mc) (A.φ_memLp I v)] with y hy hyI
          exact (hy hyI).trans (by rw [hφ]; exact congrFun he y))
      hNt
    refine h.trans ?_
    have hsum : ∑ v ∈ Finset.univ.filter (fun v => A.coef ap.up₀ I v ≠ 0),
        ‖A.coef ap.up₀ I v‖ ≤ Fintype.card A.L * A.Dc := by
      refine (Finset.sum_le_card_nsmul _ _ A.Dc fun v _ => A.coef_le _ _ _).trans ?_
      rw [nsmul_eq_mul]
      exact mul_le_mul_of_nonneg_right (by exact_mod_cast Finset.card_le_univ _) A.Dc_nonneg
    gcongr
    have := Real.sqrt_nonneg Nu
    nlinarith

