variable {Tg γ : Type*} (F : LeafFilters Tg γ)

/-- Blueprint prop:localize at one cell and leaf (lines 1848-1856): the form of the leaf inputs
is the sum over the current groups of the forms of their ball outputs, up to the error of
`leaf_localization` with the old-source, matching, separation and residual bounds. -/
theorem leaf_error {κ : LocalKernelClass} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft F.G F.I.1 F.I.2)
      (dyadicGridLength F.G F.I.1) wI) {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {mH : ℕ}
    (ls : Fin 4 → List (ℕ × Bool)) (hlen : ∀ l, (ls l).length ≤ mH)
    {u t p q : Fin 4} (hut : u ≠ t) (hup : u ≠ p) (huq : u ≠ q) (htp : t ≠ p) (htq : t ≠ q)
    (hpq : p ≠ q) (jr : Fin 4 → ℕ) (hjt : jr t = 1)
    {τo τm τr τ₂ Sz : ℝ} (hτo : 0 ≤ τo) (hτm : 0 ≤ τm) (hτr : 0 ≤ τr) (hτ₂ : 0 ≤ τ₂)
    (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ /
      Real.sqrt (dyadicGridLength F.G F.I.1) ≤ Sz)
    {ι : Type} (S : Finset ι) (a : ι → ℂ) (φ : ι → ColumnL2 (Fin F.Mc)) (tag : ι → Tg)
    (Xs : ι → ℝ → ℂ) (hx : F.input ls u = ∑ v ∈ S, a v • φ v)
    (hsrc : ∀ v ∈ S, F.IsSource c₀ H tagOf u (tag v) (φ v))
    (hXs : ∀ v ∈ S, ∀ᵐ y ∂volume, y ∈ dyadicGridCell F.G F.I.1 F.I.2 → augPhys (φ v) y = Xs v y)
    {γ' : Type} (emb : γ' → γ) (Gs : Finset γ') (grp : ι → Option γ')
    (Mtop : γ → Tg → Prop) (hMtop : ∀ G (p : Fin F.P) x, F.bm G 1 p x → Mtop G x)
    (hold : ∀ v ∈ S, grp v = none → ∃ gl b' : Fin 4, gl ≠ u ∧ gl ≠ t ∧ b' ≠ u ∧ b' ≠ t ∧
      gl ≠ b' ∧ ∃ m : ℕ, ls gl = (ls gl).dropLast ++ [(m, true)] ∧
        (ls gl).dropLast.length ≤ mH ∧
        (∀ pc : Fin F.P × (Fin (ls gl).dropLast.length → Fin F.P),
          (F.test gl (F.rkC m) (F.cm m pc.1) (ls gl).dropLast pc.2).Pass F.G F.Mc F.I c₀ H
            tagOf wI τo mH (F.cat gl)) ∧ ∀ p' : ℕ, F.cm m p' (tag v))
    (hcurM : ∀ v ∈ S, ∀ G₀, grp v = some G₀ → G₀ ∈ Gs ∧ ∀ p' : ℕ, F.bm (emb G₀) 1 p' (tag v))
    (hcurS : ∀ v ∈ S, ∀ G₀, grp v = some G₀ → ∀ G ∈ Gs, G ≠ G₀ →
      ∀ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1) (Mtop (emb G)),
        PairSmall (dyadicGridLeft F.G F.I.1 F.I.2) (dyadicGridLength F.G F.I.1) wI u t (Xs v)
          (catAtom (F.cat t) n) τ₂)
    (hpassM : ∀ G ∈ Gs, ∀ pc : Fin F.P × (Fin (ls t).length → Fin F.P),
      (F.test t (F.rkB (jr t)) (F.bm (emb G) (jr t) pc.1) (ls t) pc.2).Pass F.G F.Mc F.I c₀ H
        tagOf wI τm mH (F.cat t))
    (hpassR : ∀ G ∈ Gs, ∀ l, l ≠ t → ∀ pc : Fin F.P × (Fin (ls l).length → Fin F.P),
      (F.test l (F.rkB (jr l)) (F.bm (emb G) (jr l) pc.1) (ls l) pc.2).Pass F.G F.Mc F.I c₀ H
        tagOf wI τr mH (F.cat l))
    (hressrc : ∀ G ∈ Gs, ∀ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1) (Mtop (emb G)),
      ∃ x : Tg, F.IsSource c₀ H tagOf t x
        (fitColumn (dyadicGridCell F.G F.I.1 F.I.2) (catAtom (F.cat t) n) n) ∧
        ∀ l, l ≠ t → ∀ p' : ℕ, F.bm (emb G) (jr l) p' x) {Nt : ℝ}
    (hNt : ∀ G ∈ Gs,
      ((catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1) (Mtop (emb G))).card : ℝ) ≤ Nt) :
    ‖cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc) (F.input ls) -
      ∑ G ∈ Gs, cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc)
        (fun l => F.ball (emb G) (jr l) l (F.input ls l))‖ ≤
      (∑ v ∈ S, ‖a v‖) * ((Gs.card + 1) * (τo * Sz ^ 3) + τm * Sz ^ 3 +
        Gs.card * (τ₂ * Sz ^ 3 * Real.sqrt Nt)) +
        Gs.card * (3 * ((Real.sqrt Nt * Sz) * (τr * Sz ^ 3))) := by
  set Λ := cellForm (dyadicGridLength_pos F.G F.I.1) hwI (Fin F.Mc)
  set x := F.input ls
  set L : γ' → Fin 4 → ColumnL2 (Fin F.Mc) →ₗ[ℂ] ColumnL2 (Fin F.Mc) :=
    fun G l => (F.ball (emb G) (jr l) l).toLinearMap
  have hbx : ∀ G l, ‖L G l (x l)‖ ≤ ‖physicalColumnInput (V := Fin F.Mc) (F.g l)‖ :=
    fun G l => (F.norm_ball_le _ _ l _).trans (F.norm_input_le ls l)
  have hLt : ∀ G, L G t = (F.ball (emb G) 1 t).toLinearMap := fun G => by
    simp only [L, hjt]
  have hbound := leaf_localization Λ L x hut hup huq htp htq hpq S a φ hx Gs grp
    (εo := τo * Sz ^ 3) (εm := τm * Sz ^ 3) (εs := τ₂ * Sz ^ 3 * Real.sqrt Nt)
    (εr := (Real.sqrt Nt * Sz) * (τr * Sz ^ 3))
    (fun v hv hg => by
      obtain ⟨gl, b', hgu, hgt, hbu, hbt, hgb, m, hls, hmH, hpass, htag⟩ := hold v hv hg
      refine ⟨F.old_le hwI ls hut hgu.symm hbu.symm hgt.symm hbt.symm hgb hτo hSz0 hSz
        (hsrc v hv) hls hmH hpass htag _ (F.norm_input_le ls t), fun G _ => ?_⟩
      exact F.old_le hwI ls hut hgu.symm hbu.symm hgt.symm hbt.symm hgb hτo hSz0 hSz
        (hsrc v hv) hls hmH hpass htag _ (hbx G t))
    (fun v hv G₀ hg => by
      obtain ⟨hG₀, htag⟩ := hcurM v hv G₀ hg
      refine ⟨hG₀, ?_, fun G hG hne => ?_⟩
      · have h := F.match_le (τb := τm) hwI ls hut hup huq htp htq hpq hτm hSz0 hSz (hsrc v hv)
          (emb G₀) 1 (hlen t) (fun pc => by
            have := hpassM G₀ hG₀ pc
            rw [hjt] at this
            exact this) htag
        rw [hLt]
        exact h
      · have h := F.sep_le hwI ls hut hup huq htp htq hpq hτ₂ hSz0 hSz (Xs v) (hXs v hv) (emb G)
          1 (Mtop (emb G)) (hMtop (emb G)) (hcurS v hv G₀ hg G hG hne) (hNt G hG)
        rw [hLt]
        exact h)
    (fun G hG i => by
      have hsrcG : ∀ (r : Fin 4), r ≠ t → ∀ n ∈ catLabels F.G F.Mc (F.cat t) F.I (F.rkB 1)
          (Mtop (emb G)), ∃ x : Tg, F.IsSource c₀ H tagOf t x
            (fitColumn (dyadicGridCell F.G F.I.1 F.I.2) (catAtom (F.cat t) n) n) ∧
            ∀ p' : ℕ, F.bm (emb G) (jr r) p' x := fun r hr n hn => by
        obtain ⟨x, hx1, hx2⟩ := hressrc G hG n hn
        exact ⟨x, hx1, hx2 r hr⟩
      have hLt' : L G t (x t) = F.ball (emb G) 1 t (F.input ls t) := by rw [hLt]; rfl
      fin_cases i
      · change ‖Λ (Function.update (Function.update x t (L G t (x t))) u
          (x u - L G u (x u)))‖ ≤ _
        exact F.res_le hwI ls hut.symm htp htq hup huq hpq hτr hSz0 hSz (emb G) (jr u) (hlen u)
          (hpassR G hG u hut) (Mtop (emb G)) (hMtop (emb G)) (hsrcG u hut) _
          (by rw [Function.update_of_ne hut.symm, Function.update_self]; exact hLt')
          (by rw [Function.update_self]; rfl)
          (by rw [Function.update_of_ne hup.symm, Function.update_of_ne htp.symm]
              exact F.norm_input_le ls p)
          (by rw [Function.update_of_ne huq.symm, Function.update_of_ne htq.symm]
              exact F.norm_input_le ls q) (hNt G hG)
      · change ‖Λ (Function.update (Function.update (Function.update x t (L G t (x t))) u
          (L G u (x u))) p (x p - L G p (x p)))‖ ≤ _
        exact F.res_le hwI ls htp hut.symm htq hup.symm hpq huq hτr hSz0 hSz (emb G) (jr p)
          (hlen p) (hpassR G hG p htp.symm) (Mtop (emb G)) (hMtop (emb G)) (hsrcG p htp.symm) _
          (by rw [Function.update_of_ne htp, Function.update_of_ne hut.symm,
                Function.update_self]; exact hLt')
          (by rw [Function.update_self]; rfl)
          (by rw [Function.update_of_ne hup, Function.update_self]; exact hbx G u)
          (by rw [Function.update_of_ne hpq.symm, Function.update_of_ne huq.symm,
                Function.update_of_ne htq.symm]
              exact F.norm_input_le ls q) (hNt G hG)
      · change ‖Λ (Function.update (Function.update (Function.update (Function.update x t
          (L G t (x t))) u (L G u (x u))) p (L G p (x p))) q (x q - L G q (x q)))‖ ≤ _
        exact F.res_le hwI ls htq hut.symm htp huq.symm hpq.symm hup hτr hSz0 hSz (emb G)
          (jr q) (hlen q) (hpassR G hG q htq.symm) (Mtop (emb G)) (hMtop (emb G))
          (hsrcG q htq.symm) _
          (by rw [Function.update_of_ne htq, Function.update_of_ne htp,
                Function.update_of_ne hut.symm, Function.update_self]; exact hLt')
          (by rw [Function.update_self]; rfl)
          (by rw [Function.update_of_ne huq, Function.update_of_ne hup, Function.update_self]
              exact hbx G u)
          (by rw [Function.update_of_ne hpq, Function.update_self]; exact hbx G p) (hNt G hG))
    (by positivity) (by positivity) (by positivity)
  exact hbound

end LeafFilters

/-- A default search leaf. -/
def dfltLeaf : SearchLeaf := ⟨0, 0, 0, none, fun _ => []⟩

/-- The leaves of the guarded search over the colors `[1, Lc]` from the basic guard `up₀`. -/
def searchList (fuel Lc : ℕ) (up₀ : Fin 4) : List SearchLeaf :=
  searchLeaves fuel 1 Lc up₀ none fun _ => []

/-- The `s`-th leaf. -/
def leafAt (fuel Lc : ℕ) (up₀ : Fin 4) (s : ℕ) : SearchLeaf :=
  (searchList fuel Lc up₀).getD s dfltLeaf

theorem list_sum_map_eq_sum_range {α M : Type*} [AddCommMonoid M] (f : α → M) (d : α) :
    ∀ l : List α, (l.map f).sum = ∑ s ∈ Finset.range l.length, f (l.getD s d)
  | [] => by simp
  | a :: l => by
    rw [List.map_cons, List.sum_cons, list_sum_map_eq_sum_range f d l, List.length_cons,
      Finset.sum_range_succ']
    simp [add_comm]

/-- Blueprint prop:localize (lines 1838-1856), summed over cells: with the guarded color search
(the same leaves on every cell), the weighted cell minima are at most the weighted minima of the
leaf main terms plus the weighted leaf errors. -/
theorem search_cell_min {ιc : Type*} (cells : Finset ιc) (wt : ιc → ℝ) (hwt : ∀ I, 0 ≤ wt I)
    {η : ℝ} (hη : 0 ≤ η) {V : ιc → Type*} [∀ I, NormedAddCommGroup (V I)]
    [∀ I, InnerProductSpace ℂ (V I)]
    (Λ : ∀ I, MultilinearMap ℂ (fun _ : Fin 4 => V I) ℂ)
    (Cum : ∀ I, Fin 4 → ℕ → V I →L[ℂ] V I) (z : ∀ I, Fin 4 → V I) (fuel Lc : ℕ) (up₀ : Fin 4)
    (Main : ιc → ℕ → ℂ) (err : ιc → ℕ → ℝ)
    (hleaf : ∀ I ∈ cells, ∀ s ∈ Finset.range (searchList fuel Lc up₀).length,
      ‖Λ I (fun l => layerOp (Cum I l) ((leafAt fuel Lc up₀ s).layers l) (z I l)) - Main I s‖ ≤
        err I s) :
    ∑ I ∈ cells, wt I * min η ‖Λ I (z I)‖ ≤
      ∑ s ∈ Finset.range (searchList fuel Lc up₀).length,
          ∑ I ∈ cells, wt I * min η ‖Main I s‖ +
        ∑ I ∈ cells, wt I * ∑ s ∈ Finset.range (searchList fuel Lc up₀).length, err I s := by
  refine cell_min_leaves cells wt hwt hη (fun I => Λ I (z I))
    (Finset.range (searchList fuel Lc up₀).length)
    (fun I s => Λ I (fun l => layerOp (Cum I l) ((leafAt fuel Lc up₀ s).layers l) (z I l)))
    (fun I _ => ?_) Main err hleaf
  have h := searchLeaves_form (Λ I) (Cum I) (z I) fuel 1 Lc up₀ none fun _ => []
  simp only [layerOp_nil, ContinuousLinearMap.id_apply] at h
  change Λ I (fun l => z I l) = _
  rw [h, list_sum_map_eq_sum_range _ dfltLeaf]
  rfl

/-! ### Cell inputs as `L²` classes -/

open scoped Classical in
/-- The `L²` class of `1_I f` (zero if not square integrable). -/
noncomputable def cellLp (G : RealDyadicGrid) (I : ℤ × ℤ) (f : ℝ → ℂ) :
    Lp ℂ 2 (volume : Measure ℝ) :=
  if h : MemLp ((dyadicGridCell G I.1 I.2).indicator f) 2 volume then h.toLp _ else 0

theorem memLp_cell_indicator {G : RealDyadicGrid} {I : ℤ × ℤ} {f : ℝ → ℂ}
    (hf : MemLp f 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))) :
    MemLp ((dyadicGridCell G I.1 I.2).indicator f) 2 volume := by
  have hr := dyadicGridLength_pos G I.1
  have hres : MemLp f 2 (volume.restrict (Set.Icc (dyadicGridLeft G I.1 I.2)
      (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1))) := by
    have h := hf.smul_measure (c := ENNReal.ofReal (dyadicGridLength G I.1))
      ENNReal.ofReal_ne_top
    unfold normalizedIntervalMeasure at h
    rwa [smul_smul, ← ENNReal.ofReal_mul hr.le, mul_inv_cancel₀ hr.ne', ENNReal.ofReal_one,
      one_smul] at h
  have hres' : MemLp f 2 (volume.restrict (dyadicGridCell G I.1 I.2)) :=
    hres.mono_measure (Measure.restrict_mono Set.Ico_subset_Icc_self le_rfl)
  exact (memLp_indicator_iff_restrict (dyadicGridCell_measurable _ _ _).nullMeasurableSet).mpr hres'

theorem cellLp_ae {G : RealDyadicGrid} {I : ℤ × ℤ} {f : ℝ → ℂ}
    (hf : MemLp f 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))) :
    (cellLp G I f : ℝ → ℂ) =ᵐ[volume] (dyadicGridCell G I.1 I.2).indicator f := by
  unfold cellLp
  rw [dite_eq_left_of_eq_true (eq_true (memLp_cell_indicator hf))]
  exact MemLp.coeFn_toLp _

/-- The physical part of the augmented cell input is the function on the cell. -/
theorem augPhys_cellLp {Mc : ℕ} {G : RealDyadicGrid} {I : ℤ × ℤ} {f : ℝ → ℂ}
    (hf : MemLp f 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))) :
    ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
      augPhys (physicalColumnInput (V := Fin Mc) (cellLp G I f)) y = f y := by
  filter_upwards [physicalColumnInput_ae (V := Fin Mc) (cellLp G I f), cellLp_ae hf]
    with y h1 h2 hy
  simp only [augPhys]
  rw [h1.2, h2, Set.indicator_of_mem hy]

/-- The size of the augmented cell input is the normalized `L²` norm on the cell. -/
theorem norm_cellLp_div_le {Mc : ℕ} {G : RealDyadicGrid} {I : ℤ × ℤ} {f : ℝ → ℂ}
    (hf : MemLp f 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))) {S : ℝ} (hS : 0 ≤ S)
    (hfS : (eLpNorm f 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1))).toReal ≤ S) :
    ‖physicalColumnInput (V := Fin Mc) (cellLp G I f)‖ /
      Real.sqrt (dyadicGridLength G I.1) ≤ S := by
  have hr := dyadicGridLength_pos G I.1
  have hs := Real.sqrt_pos.mpr hr
  rw [div_le_iff₀ hs]
  have hsq : ‖physicalColumnInput (V := Fin Mc) (cellLp G I f)‖ ^ 2 ≤
      (S * Real.sqrt (dyadicGridLength G I.1)) ^ 2 := by
    rw [columnInput_norm_sq_integral, mul_pow, Real.sq_sqrt hr.le]
    have e1 : ∫ y, ‖(physicalColumnInput (V := Fin Mc) (cellLp G I f) :
        ℝ → ColumnHilbert (Fin Mc)) y‖ ^ 2 = ∫ y in dyadicGridCell G I.1 I.2, ‖f y‖ ^ 2 := by
      rw [← integral_indicator (dyadicGridCell_measurable _ _ _)]
      refine integral_congr_ae ?_
      filter_upwards [physicalColumnInput_ae (V := Fin Mc) (cellLp G I f), cellLp_ae hf]
        with y h1 h2
      rw [h1.1, h2]
      by_cases hy : y ∈ dyadicGridCell G I.1 I.2
      · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy]
      · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]; simp
    rw [e1]
    have hn := sqrt_normalized_le_of_eLpNorm hr hS (by
      rw [← ENNReal.ofReal_toReal hf.eLpNorm_ne_top]
      exact ENNReal.ofReal_le_ofReal hfS)
    rw [Real.sqrt_le_iff] at hn
    have h2 := hn.2
    rw [inv_mul_le_iff₀ hr] at h2
    have e2 : ∫ y in dyadicGridCell G I.1 I.2, ‖f y‖ ^ 2 =
        ∫ y in Set.Ico (dyadicGridLeft G I.1 I.2)
          (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1), ‖f y‖ ^ 2 := rfl
    rw [e2]
    linarith
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (by positivity) two_ne_zero).mp hsq


/-! ### Mask facts of an attempt (blueprint lem:masks, lines 1760-1762) -/

namespace ColorSetup

variable {V : Type*} [DecidableEq V] (K : ColorSetup V) (T : AdmTree V)

/-- Ball masks increase with the pad. -/
theorem mask_mono_pad (Nv : ℕ) {G : ℕ × (Option (Fin K.d0 × V × ℤ) × ℕ × (ℕ × ℕ) ×
    Option (Fin K.d0 × V × ℤ))} {h h' : ℕ} (hh : h ≤ h') {I : T.Cell} {b : V}
    (hb : b ∈ K.mask T Nv G h I) : b ∈ K.mask T Nv G h' I := by
  obtain ⟨hbI, I₀, hI₀, v₀, hv₀, hgrp, hpred⟩ := hb
  refine ⟨hbI, I₀, hI₀, v₀, hv₀, hgrp, ?_⟩
  obtain ⟨ρ, z, g, m, l, n, ρ', a, g₂, hc, hl, ⟨k, hk, hkg⟩, h2, h3⟩ := hpred
  refine ⟨ρ, z, g, m, l, n, ρ', a, g₂, hc, hl, ⟨k, hk, ?_⟩, h2.trans (by exact_mod_cast hh), ?_⟩
  · have : (h : ℤ) ≤ h' := by exact_mod_cast hh
    linarith
  · refine h3.trans ?_
    have hR : (0 : ℝ) ≤ 10 * K.Rl l := by unfold Rl; positivity
    exact mul_le_mul_of_nonneg_left (by exact_mod_cast hh) hR

end ColorSetup

namespace ActiveSetup

variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

open Classical in
/-- A present vertex within pad `h ≤ H_max` of a successful current center lies in the ball
mask of its group (blueprint lem:masks, first assertion). -/
theorem mem_mask_of_near (Hed : ℝ) (Hmax : ℕ) (ωp ωh : Fin A.cd0 → A.Vtx → Fin (A.cd0 + 1))
    {I : A.admT.Cell} {w b : A.Vtx} (hw : w ∈ A.admT.X I)
    (hs : (A.colorSetup Hed Hmax ωp ωh).Success
      ((A.colorSetup Hed Hmax ωp ωh).colorData (A.admT.st I) w))
    (hb : b ∈ A.admT.X I) {h : ℕ} (hd : (A.tagDist Hed).d (A.admT.depth I) b w ≤ h)
    (hh : h ≤ Hmax) :
    b ∈ (A.colorSetup Hed Hmax ωp ωh).mask A.admT A.vtxBound
      ((A.colorSetup Hed Hmax ωp ωh).grp A.admT A.vtxBound I w) h I := by
  obtain ⟨δ, hδ⟩ : ∃ δ : ℕ, (A.tagDist Hed).d (A.admT.depth I) b w = δ :=
    ⟨_, (ENat.natCast_toNat (ne_top_of_le_ne_top (by simp) hd)).symm⟩
  have hδh : δ ≤ h := by rw [hδ] at hd; exact_mod_cast hd
  exact (A.masks Hed Hmax ωp ωh).1 I w hw hs b hb h δ hδ hδh hh

open Classical in
/-- Distinct current groups of one color have separated masks at the current cell (blueprint
lem:masks, last assertion). -/
theorem mask_sep (Hed : ℝ) (Hmax : ℕ) (ωp ωh : Fin A.cd0 → A.Vtx → Fin (A.cd0 + 1))
    {I : A.admT.Cell} {w₁ w₂ : A.Vtx} (hw₁ : w₁ ∈ A.admT.X I) (hw₂ : w₂ ∈ A.admT.X I)
    (hs₁ : (A.colorSetup Hed Hmax ωp ωh).Success
      ((A.colorSetup Hed Hmax ωp ωh).colorData (A.admT.st I) w₁))
    (hs₂ : (A.colorSetup Hed Hmax ωp ωh).Success
      ((A.colorSetup Hed Hmax ωp ωh).colorData (A.admT.st I) w₂))
    (hcol : (A.colorSetup Hed Hmax ωp ωh).color A.admT A.vtxBound I w₁ =
      (A.colorSetup Hed Hmax ωp ωh).color A.admT A.vtxBound I w₂)
    (hne : (A.colorSetup Hed Hmax ωp ωh).grp A.admT A.vtxBound I w₁ ≠
      (A.colorSetup Hed Hmax ωp ωh).grp A.admT A.vtxBound I w₂)
    {h h' : ℕ} (hh : h ≤ Hmax) (hh' : h' ≤ Hmax) {b b' : A.Vtx}
    (hb : b ∈ (A.colorSetup Hed Hmax ωp ωh).mask A.admT A.vtxBound
      ((A.colorSetup Hed Hmax ωp ωh).grp A.admT A.vtxBound I w₁) h I)
    (hb' : b' ∈ (A.colorSetup Hed Hmax ωp ωh).mask A.admT A.vtxBound
      ((A.colorSetup Hed Hmax ωp ωh).grp A.admT A.vtxBound I w₂) h' I) :
    ¬ (A.tagDist Hed).d (A.admT.depth I) b b' ≤ 1 :=
  (A.masks Hed Hmax ωp ωh).2.2.2 I I I I w₁ w₂ (A.admT.anc_refl I) (A.admT.anc_refl I)
    (A.admT.anc_refl I) hw₁ hw₂ hs₁ hs₂ hcol hne h h' hh hh' b b' hb hb'

/-- Vertices at graph distance greater than one carry tags not joined by an edge. -/
theorem not_tagEdge_of_dist (Hed : ℝ) {s : ℤ} {b b' : A.Vtx}
    (h : ¬ (A.tagDist Hed).d s b b' ≤ 1) :
    ¬ tagEdge Hed (dyadicGridLength A.G s) (A.vtag b) (A.vtag b') := fun he =>
  h (graphDist_le_one_of_edge (edge := A.tagGraphEdge Hed) (Or.inl he))

end ActiveSetup

/-! ### Roles at a leaf -/

/-- The two slots other than `u` and `t`, in increasing order. -/
def otherTwo (u t : Fin 4) : Fin 4 × Fin 4 :=
  if (0 : Fin 4) ≠ u ∧ (0 : Fin 4) ≠ t then
    (0, if (1 : Fin 4) ≠ u ∧ (1 : Fin 4) ≠ t then 1 else if (2 : Fin 4) ≠ u ∧ (2 : Fin 4) ≠ t
      then 2 else 3)
  else if (1 : Fin 4) ≠ u ∧ (1 : Fin 4) ≠ t then
    (1, if (2 : Fin 4) ≠ u ∧ (2 : Fin 4) ≠ t then 2 else 3)
  else (2, 3)

theorem otherTwo_spec (u t : Fin 4) (h : u ≠ t) :
    (otherTwo u t).1 ≠ u ∧ (otherTwo u t).1 ≠ t ∧ (otherTwo u t).2 ≠ u ∧
      (otherTwo u t).2 ≠ t ∧ (otherTwo u t).1 ≠ (otherTwo u t).2 := by
  revert u t
  decide

/-- The role level of a slot at a leaf: the third slot `t` carries the first ball level, the
upper guard the second, the two remaining slots the third and fourth (blueprint line 1853). -/
def SearchLeaf.role (L : SearchLeaf) (l : Fin 4) : ℕ :=
  if l = thirdSlot L.up L.low then 1 else if l = L.up then 2
  else if l = (otherTwo L.up (thirdSlot L.up L.low)).1 then 3 else 4

theorem SearchLeaf.role_t (L : SearchLeaf) : L.role (thirdSlot L.up L.low) = 1 := by
  simp [SearchLeaf.role]

theorem SearchLeaf.role_ge (L : SearchLeaf) {l : Fin 4} (hl : l ≠ thirdSlot L.up L.low) :
    2 ≤ L.role l := by
  unfold SearchLeaf.role; simp only [hl, ↓reduceIte]; split_ifs <;> omega

theorem SearchLeaf.role_le (L : SearchLeaf) (l : Fin 4) : L.role l ≤ 4 := by
  unfold SearchLeaf.role; split_ifs <;> omega

/-! ### The parameters, masks, filters and tests of an attempt -/

/-- The signed positive chains of a layer list given outermost first: each complement layer
`1 - C` contributes either nothing or `-C`. -/
def posExpand : List (ℕ × Bool) → List (ℤ × List ℕ)
  | [] => [(1, [])]
  | (m, false) :: rest => (posExpand rest).map fun t => (t.1, m :: t.2)
  | (m, true) :: rest => posExpand rest ++ (posExpand rest).map fun t => (-t.1, m :: t.2)

/-- The number of signed positive chains is at most `2^n`. -/
theorem posExpand_length_le : ∀ ls : List (ℕ × Bool), (posExpand ls).length ≤ 2 ^ ls.length
  | [] => by simp [posExpand]
  | (m, false) :: rest => by
    simp only [posExpand, List.length_map, List.length_cons, pow_succ]
    have := posExpand_length_le rest; omega
  | (m, true) :: rest => by
    simp only [posExpand, List.length_append, List.length_map, List.length_cons, pow_succ]
    have := posExpand_length_le rest; omega

/-- The signed positive chains are no longer than the layer list. -/
theorem posExpand_mem_length : ∀ (ls : List (ℕ × Bool)), ∀ t ∈ posExpand ls,
    t.2.length ≤ ls.length
  | [], t, ht => by simp only [posExpand, List.mem_singleton] at ht; subst ht; simp
  | (m, false) :: rest, t, ht => by
    simp only [posExpand, List.mem_map] at ht
    obtain ⟨t', ht', rfl⟩ := ht
    simp only [List.length_cons]
    have := posExpand_mem_length rest t' ht'; omega
  | (m, true) :: rest, t, ht => by
    simp only [posExpand, List.mem_append, List.mem_map] at ht
    rcases ht with ht | ⟨t', ht', rfl⟩
    · have := posExpand_mem_length rest t ht; simp only [List.length_cons]; omega
    · simp only [List.length_cons]
      have := posExpand_mem_length rest t' ht'; omega

namespace ActiveSetup

variable {κ : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ c₀)

/-- The admission cell of a cell of the setup (the top otherwise). -/
noncomputable def admAt (I : ℤ × ℤ) : A.admT.Cell := by
  classical
  exact if h : I ∈ A.cells then
    (some ⟨I, A.cells_mem_tree h⟩ : Option (AdmCell A.G A.R A.treeDepth)) else
    (none : Option (AdmCell A.G A.R A.treeDepth))

/-- The groups of the attempt: a color with its complete color data. -/
abbrev Grp := ℕ × (Option (Fin A.cd0 × A.Vtx × ℤ) × ℕ × (ℕ × ℕ) × Option (Fin A.cd0 × A.Vtx × ℤ))

/-- The parameters of an attempt: the edge threshold, the pad bound, the delays, the number of
pads, the number of colors, the search depth, the initial upper guard, the label capacity, the
history bound and the slot inputs on the cells. -/
structure AttemptParams where
  Hed : ℝ
  Hmax : ℕ
  ωp : Fin A.cd0 → A.Vtx → Fin (A.cd0 + 1)
  ωh : Fin A.cd0 → A.Vtx → Fin (A.cd0 + 1)
  P : ℕ
  hP : 0 < P
  Lc : ℕ
  fuel : ℕ
  up₀ : Fin 4
  Mc : ℕ
  mH : ℕ
  z : ℤ × ℤ → Fin 4 → ℝ → ℂ

namespace AttemptParams

variable {A} (ap : A.AttemptParams)

/-- The color data of the attempt. -/
noncomputable abbrev K : ColorSetup A.Vtx := A.colorSetup ap.Hed ap.Hmax ap.ωp ap.ωh

/-- The base pad of the cumulative split `m` (blueprint line 1807). -/
def cbase (m : ℕ) : ℕ := 10 * ap.P * (ap.Lc - m + 1)

/-- The base pad of the ball level `j` (blueprint line 1807). -/
def bbase (j : ℕ) : ℕ := 20 * ap.P * (ap.Lc + 1) + 10 * (j - 1) * ap.P

open Classical in
/-- The cumulative masks of the cell `I` at the split `m` and pad index `p`. -/
def cmask (I : ℤ × ℤ) (m p : ℕ) : A.Vtx → Prop := fun x =>
  x ∈ ap.K.cumMask A.admT A.vtxBound m (ap.cbase m + p + 1) (A.admAt I)

open Classical in
/-- The ball masks of the cell `I` for the group `G` at level `j` and pad index `p`. -/
def bmask (I : ℤ × ℤ) (G : A.Grp) (j p : ℕ) : A.Vtx → Prop := fun x =>
  x ∈ ap.K.mask A.admT A.vtxBound G (ap.bbase j + p + 1) (A.admAt I)

/-- The base inputs of the cell `I`. -/
noncomputable def base (I : ℤ × ℤ) (l : Fin 4) : Lp ℂ 2 (volume : Measure ℝ) :=
  cellLp A.G I (ap.z I l)

/-- The filters of the cell `I` for slot catalogs `cat`. -/
noncomputable def filters (cat : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) :
    LeafFilters A.Vtx A.Grp where
  G := A.G
  I := I
  Mc := ap.Mc
  cat := cat
  P := ap.P
  hP := ap.hP
  rkC := fun m => ap.Lc - m + 1
  cm := ap.cmask I
  rkB := fun j => ap.Lc + j
  bm := ap.bmask I
  g := ap.base I

open Classical in
/-- The current groups of the cell `I` at the color `k`. -/
noncomputable def groupsAt (I : ℤ × ℤ) (k : ℕ) : Finset A.Grp :=
  ((A.admT.X (A.admAt I)).filter fun w => ap.K.color A.admT A.vtxBound (A.admAt I) w = k).image
    (ap.K.grp A.admT A.vtxBound (A.admAt I))

/-- The leaves of the search of the attempt. -/
def leaves : List SearchLeaf := searchList ap.fuel ap.Lc ap.up₀

/-- The base tests of slot `l` at the cell `I`: for every leaf, the lower-guard tests and the
ball tests of every current group, at every pad and every pad choice of the history. -/
abbrev BaseIdx (I : ℤ × ℤ) (l : Fin 4) : Type :=
  Σ s : Fin ap.leaves.length,
    (Fin ap.P × (Fin ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).dropLast.length → Fin ap.P)) ⊕
    ({G // G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k} × Fin ap.P ×
      (Fin ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).length → Fin ap.P))

/-- The base tests of slot `l` at the cell `I`. -/
noncomputable def baseTests (cat : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) (l : Fin 4) :
    ap.BaseIdx I l → CatTest A.Vtx
  | ⟨s, Sum.inl (p, c)⟩ =>
      (ap.filters cat I).test l (ap.Lc - ((leafAt ap.fuel ap.Lc ap.up₀ s).k - 1) + 1)
        (ap.cmask I ((leafAt ap.fuel ap.Lc ap.up₀ s).k - 1) p)
        ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).dropLast c
  | ⟨s, Sum.inr (G, p, c)⟩ =>
      (ap.filters cat I).test l (ap.Lc + (leafAt ap.fuel ap.Lc ap.up₀ s).role l)
        (ap.bmask I G.1 ((leafAt ap.fuel ap.Lc ap.up₀ s).role l) p)
        ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l) c

/-- The inner history of a positive chain (outermost first) after removing its `k` outermost
layers, as positive layers, innermost first. -/
def chainHist (ch : List ℕ) (k : ℕ) : List (ℕ × Bool) :=
  ((ch.drop k).reverse).map fun m => (m, false)

/-- The `i`-th signed positive chain of slot `l` of the leaf `s` (blueprint line 2241). -/
def chainOf (s : ℕ) (l : Fin 4) (i : ℕ) : List ℕ :=
  ((posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).reverse).getD i (1, [])).2

/-- The chain tests of slot `l` at the cell `I` (blueprint lines 1807-1812, the required
histories of the transfer in lines 2240-2256): for every leaf and positive chain of its
complement expansion, the ball tests of every current group on the whole chain and the tests of
every cumulative layer of the chain on its inner part, at every pad and pad choice. -/
abbrev ChainIdx (I : ℤ × ℤ) (l : Fin 4) : Type :=
  Σ s : Fin ap.leaves.length,
    Σ i : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).reverse).length,
      ({G // G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k} × Fin ap.P ×
        (Fin (chainHist (ap.chainOf s l i) 0).length → Fin ap.P)) ⊕
      (Σ k : Fin (ap.chainOf s l i).length,
        Fin ap.P × (Fin (chainHist (ap.chainOf s l i) (k + 1)).length → Fin ap.P))

/-- The chain tests of slot `l` at the cell `I`. -/
noncomputable def chainTests (cat : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) (l : Fin 4) :
    ap.ChainIdx I l → CatTest A.Vtx
  | ⟨s, i, Sum.inl (G, p, c)⟩ =>
      (ap.filters cat I).test l (ap.Lc + (leafAt ap.fuel ap.Lc ap.up₀ s).role l)
        (ap.bmask I G.1 ((leafAt ap.fuel ap.Lc ap.up₀ s).role l) p)
        (chainHist (ap.chainOf s l i) 0) c
  | ⟨s, i, Sum.inr ⟨k, p, c⟩⟩ =>
      (ap.filters cat I).test l (ap.Lc - (ap.chainOf s l i).getD k 0 + 1)
        (ap.cmask I ((ap.chainOf s l i).getD k 0) p)
        (chainHist (ap.chainOf s l i) (k + 1)) c

/-- The named tests of slot `l` at the cell `I`: the base tests and the chain tests. -/
abbrev TestIdx (I : ℤ × ℤ) (l : Fin 4) : Type := ap.BaseIdx I l ⊕ ap.ChainIdx I l

/-- The tests of slot `l` at the cell `I`. -/
noncomputable def tests (cat : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) (l : Fin 4) :
    ap.TestIdx I l → CatTest A.Vtx :=
  Sum.elim (ap.baseTests cat I l) (ap.chainTests cat I l)

theorem tests_t (cat : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) (l : Fin 4)
    (w : ap.TestIdx I l) : (ap.tests cat I l w).t = l := by
  rcases w with (⟨s, (⟨p, c⟩ | ⟨G, p, c⟩)⟩ | ⟨s, i, (⟨G, p, c⟩ | ⟨k, p, c⟩)⟩) <;> rfl

end AttemptParams

