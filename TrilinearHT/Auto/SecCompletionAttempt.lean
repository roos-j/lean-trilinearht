theorem φ_memLp (I : ℤ × ℤ) (v : A.L) : MemLp (A.φ I v) 2 (normalizedIntervalMeasure
    (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1)) :=
  memLp_normalized_of_bound (dyadicGridLength_pos A.G I.1) (A.φ_meas I v) (A.φ_bound I v)

/-- The basic argument of slot `l` on a cell as a combination of its chart inputs. -/
theorem basic_expansion (Mc : ℕ) (I : ℤ × ℤ) (l : Fin 4) :
    physicalColumnInput (V := Fin Mc) (cellLp A.G I (A.B l I)) =
      ∑ v ∈ Finset.univ.filter (fun v => A.coef l I v ≠ 0),
        A.coef l I v • physicalColumnInput (V := Fin Mc) (cellLp A.G I (A.φ I v)) := by
  classical
  have e : A.B l I = ∑ v ∈ Finset.univ.filter (fun v => A.coef l I v ≠ 0),
      A.coef l I v • A.φ I v := by
    funext x
    simp only [B, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun v _ => ?_
    split_ifs with h
    · rfl
    · simp only [not_not] at h; simp [h]
  rw [e, cellLp_sum _ _ _ fun v _ => A.φ_memLp I v, physicalColumnInput_sum]

/-- The vertex of a basic occurrence at a cell: its label with its admission cell. -/
noncomputable def basicVtx {I : ℤ × ℤ} (hI : I ∈ A.cells) (l : Fin 4) (v : A.L) : A.Vtx :=
  ((l, v), admCellOf A.occAvail ⟨I, A.cells_mem_tree hI⟩ (l, v))

theorem basicVtx_anc {I : ℤ × ℤ} (hI : I ∈ A.cells) {l : Fin 4} {v : A.L}
    (hv : A.coef l I v ≠ 0) :
    (admAnc A.occAvail ⟨I, A.cells_mem_tree hI⟩ (l, v)).Nonempty ∧
      dyadicGridCell A.G I.1 I.2 ⊆
        dyadicGridCell A.G (A.basicVtx hI l v).2.1.1 (A.basicVtx hI l v).2.1.2 ∧
      A.occAvail (A.basicVtx hI l v).2.1 (l, v) := by
  have hne : (admAnc A.occAvail ⟨I, A.cells_mem_tree hI⟩ (l, v)).Nonempty :=
    ⟨⟨I, A.cells_mem_tree hI⟩, (mem_admAnc A.occAvail).mpr ⟨subset_rfl, hI, hv⟩⟩
  exact ⟨hne, (mem_admAnc A.occAvail).mp (admCellOf_spec A.occAvail hne).1⟩

/-- The vertex of a basic occurrence is present at the cell. -/
theorem basicVtx_mem {I : ℤ × ℤ} (hI : I ∈ A.cells) {l : Fin 4} {v : A.L}
    (hv : A.coef l I v ≠ 0) : A.basicVtx hI l v ∈ A.admT.X (A.admAt I) := by
  classical
  have e : A.admAt I = some ⟨I, A.cells_mem_tree hI⟩ := by
    unfold admAt; exact dite_eq_left_of_eq_true (eq_true hI)
  rw [e]
  change A.basicVtx hI l v ∈ admPresent A.occAvail _
  exact (mem_admPresent A.occAvail).mpr ⟨(A.basicVtx_anc hI hv).1, rfl⟩

/-- The chart input of a basic occurrence is a pure source of its vertex in its slot. -/
theorem basic_source (ap : A.AttemptParams) (cat : Fin 4 → List (CatCol A.Vtx)) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) {l : Fin 4} {v : A.L} (hv : A.coef l I v ≠ 0) :
    (ap.filters cat I).IsSource A.csrc A.Hsrc A.vtag l (A.basicVtx hI l v)
      (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.φ I v))) := by
  obtain ⟨-, hsub, hav⟩ := A.basicVtx_anc hI hv
  obtain ⟨hc, -, hθ, hM, hq⟩ := A.vchart_source (x := A.basicVtx hI l v) hav
  obtain ⟨-, -, he⟩ := A.vchart_spec (A.basicVtx hI l v) hav
  have hφ : A.φ I v = A.φ (A.basicVtx hI l v).2.1 v :=
    A.nested_cons I hI _ hav.1 hsub v ⟨l, hv⟩ ⟨l, hav.2⟩
  refine ⟨(A.vchart (A.basicVtx hI l v)).2, hc, hθ, hM, hq, ?_⟩
  filter_upwards [augPhys_cellLp (Mc := ap.Mc) (A.φ_memLp I v)] with y hy hyI
  exact (hy hyI).trans (by rw [hφ]; exact congrFun he y)

