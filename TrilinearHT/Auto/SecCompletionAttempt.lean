  omega

open Classical in
/-- Blueprint prop:localize at one active cell and one leaf: given an expansion of the upper guard
in pure bounded charts of vertices of its cumulative mask, the leaf form is the sum over the
current groups of the forms of their ball outputs, up to the errors of `leaf_error`. -/
theorem leaf_bound (cat : Fin 4 → List (CatCol A.Vtx))
    (hT : ∀ l, ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag)
    {τ : ℕ → ℝ} {I : ℤ × ℤ} (hI : I ∈ A.cells)
    (hpass : ∀ l (w : ap.TestIdx I l), (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc
      A.Hsrc A.vtag (A.w I) (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l))
    (hsucc : ∀ w ∈ A.admT.X (A.admAt I),
      ap.K.Success (ap.K.colorData (A.admT.st (A.admAt I)) w))
    (hL1 : 1 ≤ ap.Lc) (hfuel : ap.Lc - 1 < 2 ^ ap.fuel) (hmH : ap.fuel ≤ ap.mH)
    (hPH : ap.bbase 1 + ap.P ≤ ap.Hmax) (s : Fin ap.leaves.length)
    {τo τm τr τ₂ Sz Nt : ℝ} (hτo : 0 ≤ τo) (hτm : 0 ≤ τm) (hτr : 0 ≤ τr) (hτ₂ : 0 < τ₂)
    (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ ap.Hed)
    (hτo' : τ (ap.Lc - ((leafAt ap.fuel ap.Lc ap.up₀ s).k - 1) + 1) ≤ τo)
    (hτm' : τ (ap.Lc + 1) ≤ τm) (hτr' : ∀ j, 2 ≤ j → j ≤ 4 → τ (ap.Lc + j) ≤ τr)
    (hSz0 : 0 < Sz)
    (hSz : ∀ l, ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
      Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    {ι : Type} (S : Finset ι) (a : ι → ℂ) (φ : ι → ColumnL2 (Fin ap.Mc))
    (hx : (ap.filters cat I).input (leafAt ap.fuel ap.Lc ap.up₀ s).layers
      (leafAt ap.fuel ap.Lc ap.up₀ s).up = ∑ v ∈ S, a v • φ v)
    (hsrc : ∀ v ∈ S, ∃ (x : A.Vtx) (hpad : ℕ),
      hpad ≤ ap.cbase (leafAt ap.fuel ap.Lc ap.up₀ s).k + ap.P ∧
