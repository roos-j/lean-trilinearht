theorem tests_indep (cat cat' : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) (l : Fin 4)
    (w : ap.TestIdx I l) : ap.tests cat I l w = ap.tests cat' I l w := by
  rcases w with (⟨s, (⟨p, c⟩ | ⟨G, p, c⟩)⟩ | ⟨s, i, (⟨G, p, c⟩ | ⟨k, p, c⟩)⟩) <;> rfl

/-- Blueprint lem:closure for an attempt: if the trial cap is not attained at any active cell,
there are slot catalogs passing all named tests at all active cells, whose columns are same-tag
templates of their slot born at active cells, with the rank counts of `tree_closure`. -/
theorem catalogs_exist (L : List (ℤ × ℤ)) (hL : ∀ I ∈ L, I ∈ A.cells) (hnd : L.Nodup)
    (hord : ∀ i j (hi : i < L.length) (hj : j < L.length), i < j →
      ¬ dyadicGridCell A.G L[i].1 L[i].2 ⊆ dyadicGridCell A.G L[j].1 L[j].2)
    {c₀' D : ℕ} (hst : SameTagBound κ c₀' D) {H' : ℝ} (hH' : Real.exp 2 ≤ H') (τ : ℕ → ℝ)
    (hτ : ∀ l I w, 0 < τ (ap.tests (fun _ => []) I l w).r) {Tmax : ℕ}
    (hMc : L.length * Tmax ≤ ap.Mc)
    (hcap : ∀ l, ∀ I ∈ L, ∑ r ∈ Finset.univ.image (fun w => (ap.tests (fun _ => []) I l w).r),
      Fintype.card (ap.TestIdx I l) *
          (4 ^ ap.mH * projectionPrefixConstant Tmax ^ (2 * ap.mH)) /
        (τ r / (2 * Real.exp (D * (1 + Real.log H') ^ D))) ^ 2 < (Tmax : ℝ)) :
    ∃ cat : Fin 4 → List (CatCol A.Vtx), ∀ l,
      (∀ I ∈ L, ∀ w, (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I c₀' H' A.vtag (A.w I)
        (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l)) ∧
      (∀ d ∈ cat l, d.birth ∈ L ∧ ∃ w, d.rank = (ap.tests (fun _ => []) d.birth l w).r ∧
        (ap.tests (fun _ => []) d.birth l w).M d.tag ∧
        ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (A.vtag d.tag) l R γ d.birth
            (ap.tests (fun _ => []) d.birth l w).r d.tag) ∧
      (∀ I ∈ L, ∀ r, (((cat l).filter (fun d => decide (d.birth = I ∧ d.rank = r))).length : ℝ) *
          (τ r / (2 * Real.exp (D * (1 + Real.log H') ^ D))) ^ 2 ≤
        Fintype.card (ap.TestIdx I l) *
          (4 ^ ap.mH * projectionPrefixConstant Tmax ^ (2 * ap.mH)) ∨
        τ r / (2 * Real.exp (D * (1 + Real.log H') ^ D)) ≤ 0) ∧
      (cat l).length ≤ L.length * Tmax := by
  have h := fun l : Fin 4 => tree_closure (G := A.G) (Mc := ap.Mc) hst hH' (tagOf := A.vtag)
    (fun x => A.vchart_dim x) L hnd
    hord A.w (fun I hI => A.adm I (hL I hI)) (fun I => ap.TestIdx I l)
    (fun I => ap.tests (fun _ => []) I l) ap.mH τ (fun I w => hτ l I w) hMc (hcap l)
  choose cat hcat using h
  refine ⟨cat, fun l => ?_⟩
  obtain ⟨h1, h2, h3, h4⟩ := hcat l
  refine ⟨h1, fun d hd => ?_, h3, h4⟩
  obtain ⟨hb, w, hr, hM, R, hR, γ, hd'⟩ := h2 d hd
  refine ⟨hb, w, hr, hM, R, hR, γ, ?_⟩
  rwa [ap.tests_t] at hd'

