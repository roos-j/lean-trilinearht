    (hsl : |(2 * lam * (x - a) + γ) - ωa + s| ≤ θ) :
    ‖(Real.fourierChar (lam * (y - a) ^ 2 + γ * (y - a)) : ℂ) -
        (Real.fourierChar (lam * (x - a) ^ 2 + γ * (x - a)) : ℂ) *
