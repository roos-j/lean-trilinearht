/-! ### Certified variation with general histories (blueprint lines 1879-1905, 2149) -/

section CertifiedVariationGen

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- `certifiedVariation` with the histories `B'` replaced by arbitrary vectors: the left histories
`Br i` enter only through the compression estimate for the ball rows, and the right histories
`Bt i` only through the jump bound `Σ_i ‖Bt i - Br i‖² ≤ J`. Then
`Σ_{G,i} ‖E (L_{t} Bt - L_{r} Br)‖² ≤ 2 C_w (G₀ ‖F‖² + J)`. This is the form used for the
attempt (blueprint line 2149), whose histories are products of global nested projections. -/
theorem certifiedVariation_gen {γ ι : Type*} [Fintype γ] [DecidableEq γ] [Fintype ι] (T : ℕ)
    (L : γ → ℕ → H →L[ℂ] H) (hL : ∀ G, ∀ n ≤ T, IsStarProjection (L G n))
    (hLnest : ∀ G, ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (L G i).comp (L G j) = L G i)
    (E : γ → ι → H →L[ℂ] H) (hE : ∀ G i y, ‖E G i y‖ ≤ ‖y‖)
    (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i) (ht : ∀ i, t i ≤ T)
    (hdis : ∀ i j, i ≠ j → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r j) (t j)))
    (Bt Br : ι → H) (F : H) {Cw G₀ J : ℝ} (hCw : 0 ≤ Cw)
    (hwr1 : ∀ x : γ × ι → H, ‖∑ k, ContinuousLinearMap.adjoint
        ((E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2))) (x k)‖ ^ 2 ≤
      Cw * ∑ G, ‖∑ k ∈ (Finset.univ : Finset (γ × ι)).filter (fun k => k.1 = G),
        ContinuousLinearMap.adjoint ((E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2))) (x k)‖ ^ 2)
    (hcomp1 : ∀ c : ℝ, 0 ≤ c → (∀ h, ∑ k : γ × ι,
        ‖(E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2)) h‖ ^ 2 ≤ c * ‖h‖ ^ 2) →
      ∑ k : γ × ι, ‖(E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2)) (Br k.2)‖ ^ 2 ≤
        c * G₀ * ‖F‖ ^ 2)
    (hwr2 : ∀ i, ∀ x : γ → H, ‖∑ G, ContinuousLinearMap.adjoint
        ((E G i).comp (L G (t i))) (x G)‖ ^ 2 ≤
      Cw * ∑ G, ‖∑ G' ∈ (Finset.univ : Finset γ).filter (fun G' => G' = G),
        ContinuousLinearMap.adjoint ((E G' i).comp (L G' (t i))) (x G')‖ ^ 2)
    (hjump : ∑ i, ‖Bt i - Br i‖ ^ 2 ≤ J) :
    ∑ k : γ × ι, ‖E k.1 k.2 (L k.1 (t k.2) (Bt k.2) - L k.1 (r k.2) (Br k.2))‖ ^ 2 ≤
      2 * Cw * (G₀ * ‖F‖ ^ 2 + J) := by
  set R1 : γ × ι → H →L[ℂ] H := fun k => (E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2))
  have hgrp1 : ∀ G h, ∑ k ∈ (Finset.univ : Finset (γ × ι)).filter (fun k => k.1 = G),
      ‖R1 k h‖ ^ 2 ≤ ‖h‖ ^ 2 := by
    intro G h
    rw [sum_filter_fst (fun k => ‖R1 k h‖ ^ 2) G]
    calc ∑ i, ‖R1 (G, i) h‖ ^ 2 ≤ ∑ i, ‖(L G (t i) - L G (r i)) h‖ ^ 2 :=
          Finset.sum_le_sum fun i _ => pow_le_pow_left₀ (norm_nonneg _)
            (by simp only [R1, ContinuousLinearMap.comp_apply]; exact hE G i _) 2
      _ ≤ ‖h‖ ^ 2 := projection_interval_differences_bessel (L G) T (hL G) (hLnest G) r t hrt
          ht hdis h
  have hjoint1 : ∀ h, ∑ k : γ × ι, ‖R1 k h‖ ^ 2 ≤ Cw * ‖h‖ ^ 2 :=
    fun h => joint_bessel_of_wholeRanges Finset.univ Prod.fst R1 hgrp1 hCw hwr1 h
  have hterm1 := hcomp1 Cw hCw hjoint1
  have hjoint2 : ∀ i y, ∑ G, ‖(E G i).comp (L G (t i)) y‖ ^ 2 ≤ Cw * ‖y‖ ^ 2 := by
    intro i y
    apply joint_bessel_of_wholeRanges Finset.univ id (fun G => (E G i).comp (L G (t i))) _ hCw
      (hwr2 i) y
    intro G h
    rw [Finset.sum_filter, Finset.sum_eq_single G (fun b _ hb => by simp [hb])
      (fun h' => absurd (Finset.mem_univ G) h')]
    simp only [id, ite_true, ContinuousLinearMap.comp_apply]
    exact pow_le_pow_left₀ (norm_nonneg _) ((hE G i _).trans
      (starProjection_norm_apply_le _ (hL G (t i) (ht i)) _)) 2
  have hterm2 : ∑ k : γ × ι, ‖E k.1 k.2 (L k.1 (t k.2) (Bt k.2 - Br k.2))‖ ^ 2 ≤ Cw * J := by
    rw [Fintype.sum_prod_type, Finset.sum_comm]
    calc ∑ i, ∑ G, ‖E G i (L G (t i) (Bt i - Br i))‖ ^ 2 ≤
        ∑ i, Cw * ‖Bt i - Br i‖ ^ 2 := Finset.sum_le_sum fun i _ => hjoint2 i _
      _ = Cw * ∑ i, ‖Bt i - Br i‖ ^ 2 := by rw [Finset.mul_sum]
      _ ≤ _ := mul_le_mul_of_nonneg_left hjump hCw
  have hsplit : ∀ k : γ × ι, E k.1 k.2 (L k.1 (t k.2) (Bt k.2) - L k.1 (r k.2) (Br k.2)) =
      R1 k (Br k.2) + E k.1 k.2 (L k.1 (t k.2) (Bt k.2 - Br k.2)) := by
    intro k
    simp only [R1, ContinuousLinearMap.comp_apply, sub_apply, map_sub]
    abel
  calc ∑ k : γ × ι, ‖E k.1 k.2 (L k.1 (t k.2) (Bt k.2) - L k.1 (r k.2) (Br k.2))‖ ^ 2
      ≤ ∑ k : γ × ι, (2 * ‖R1 k (Br k.2)‖ ^ 2 +
          2 * ‖E k.1 k.2 (L k.1 (t k.2) (Bt k.2 - Br k.2))‖ ^ 2) := by
        apply Finset.sum_le_sum; intro k _
        rw [hsplit]
        have := norm_add_le (R1 k (Br k.2)) (E k.1 k.2 (L k.1 (t k.2) (Bt k.2 - Br k.2)))
        have h0 := norm_nonneg (R1 k (Br k.2) + E k.1 k.2 (L k.1 (t k.2) (Bt k.2 - Br k.2)))
        nlinarith [sq_nonneg (‖R1 k (Br k.2)‖ - ‖E k.1 k.2 (L k.1 (t k.2) (Bt k.2 - Br k.2))‖)]
    _ = 2 * ∑ k : γ × ι, ‖R1 k (Br k.2)‖ ^ 2 +
        2 * ∑ k : γ × ι, ‖E k.1 k.2 (L k.1 (t k.2) (Bt k.2 - Br k.2))‖ ^ 2 := by
        rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    _ ≤ 2 * (Cw * G₀ * ‖F‖ ^ 2) + 2 * (Cw * J) :=
        add_le_add (mul_le_mul_of_nonneg_left hterm1 (by norm_num))
          (mul_le_mul_of_nonneg_left hterm2 (by norm_num))
    _ = _ := by ring

end CertifiedVariationGen

/-! ### Masks inherited from the deepest active ancestor (blueprint lines 1879-1890) -/

section DeepestAncestor

variable (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))

open Classical in
/-- The cells of `S` containing the cell `c`. -/
noncomputable def ancIn (c : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  S.filter fun d => dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2

theorem mem_ancIn {c d : ℤ × ℤ} :
    d ∈ ancIn G S c ↔ d ∈ S ∧ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  classical
  unfold ancIn; rw [Finset.mem_filter]

open Classical in
/-- The deepest cell of `S` containing `c` (the cell `c` itself if there is none). -/
noncomputable def deepestIn (c : ℤ × ℤ) : ℤ × ℤ :=
  if h : (ancIn G S c).Nonempty then
    Classical.choose ((ancIn G S c).exists_max_image Prod.fst h)
  else c

theorem deepestIn_spec {c : ℤ × ℤ} (h : (ancIn G S c).Nonempty) :
    deepestIn G S c ∈ ancIn G S c ∧ ∀ d ∈ ancIn G S c, d.1 ≤ (deepestIn G S c).1 := by
  unfold deepestIn
  rw [dite_eq_left_of_eq_true (eq_true h)]
  exact Classical.choose_spec ((ancIn G S c).exists_max_image Prod.fst h)

/-- Two cells containing a common cell are nested according to their depths. -/
theorem dyadicGridCell_subset_of_common {c d d' : ℤ × ℤ}
    (hd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)
    (hd' : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d'.1 d'.2) (hle : d'.1 ≤ d.1) :
    dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G d'.1 d'.2 := by
  rcases dyadicGridCell_nested_or_disjoint_of_le G hle d'.2 d.2 with hdis | hs
  · exfalso
    have hy := dyadicGridCell_left_mem G c.1 c.2
    exact Set.disjoint_left.mp hdis (hd' hy) (hd hy)
  · exact hs

theorem deepestIn_of_mem {c : ℤ × ℤ} (hc : c ∈ S) : deepestIn G S c = c := by
  have hne : (ancIn G S c).Nonempty := ⟨c, (mem_ancIn G S).mpr ⟨hc, subset_rfl⟩⟩
  obtain ⟨hm, hmax⟩ := deepestIn_spec G S hne
  obtain ⟨-, hsub⟩ := (mem_ancIn G S).mp hm
  have h1 := hmax c ((mem_ancIn G S).mpr ⟨hc, subset_rfl⟩)
  have h2 := dyadicGridCell_depth_le_of_subset G c _ hsub
  have he : (deepestIn G S c).1 = c.1 := le_antisymm h2 h1
  have hp := dyadicGridCell_sameDepth_common_point G c.1 c.2 (deepestIn G S c).2
    (dyadicGridCell_left_mem G c.1 c.2) (by
      have := hsub (dyadicGridCell_left_mem G c.1 c.2); rwa [he] at this)
  exact Prod.ext he hp.symm

/-- Deepest ancestors are monotone: a finer cell has a finer (or equal) deepest ancestor. -/
theorem deepestIn_mono {c d : ℤ × ℤ} (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)
    (hd : (ancIn G S d).Nonempty) :
    (ancIn G S c).Nonempty ∧ dyadicGridCell G (deepestIn G S c).1 (deepestIn G S c).2 ⊆
      dyadicGridCell G (deepestIn G S d).1 (deepestIn G S d).2 := by
  obtain ⟨hmd, -⟩ := deepestIn_spec G S hd
  obtain ⟨hdS, hdsub⟩ := (mem_ancIn G S).mp hmd
  have hmc : deepestIn G S d ∈ ancIn G S c := (mem_ancIn G S).mpr ⟨hdS, hcd.trans hdsub⟩
  have hc : (ancIn G S c).Nonempty := ⟨_, hmc⟩
  obtain ⟨hmc', hmax⟩ := deepestIn_spec G S hc
  obtain ⟨-, hcsub⟩ := (mem_ancIn G S).mp hmc'
  exact ⟨hc, dyadicGridCell_subset_of_common G hcsub (hcd.trans hdsub) (hmax _ hmc)⟩

theorem deepestIn_mem {c : ℤ × ℤ} (h : (ancIn G S c).Nonempty) :
    deepestIn G S c ∈ S ∧ dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G (deepestIn G S c).1 (deepestIn G S c).2 :=
  (mem_ancIn G S).mp (deepestIn_spec G S h).1

/-- Masks monotone in depth on `S` extend to all cells below a root of `S` by inheritance from
the deepest ancestor in `S`. -/
theorem extMask_mono {Tg : Type*} {root : ℤ × ℤ} (hroot : root ∈ S) (M : ℤ × ℤ → Tg → Prop)
    (hM : ∀ c ∈ S, ∀ d ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      ∀ x, M d x → M c x)
    {c d : ℤ × ℤ} (hd : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G root.1 root.2)
    (hcd : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2) (x : Tg)
    (hx : M (deepestIn G S d) x) : M (deepestIn G S c) x := by
  have hdn : (ancIn G S d).Nonempty := ⟨root, (mem_ancIn G S).mpr ⟨hroot, hd⟩⟩
  obtain ⟨hcn, hsub⟩ := deepestIn_mono G S hcd hdn
  exact hM _ (deepestIn_mem G S hcn).1 _ (deepestIn_mem G S hdn).1 hsub x hx

end DeepestAncestor

/-! ### Nested depth projections of a catalog on the complete tree (blueprint lines 1879-1890) -/

section CatalogDepthFamily

variable {G : RealDyadicGrid} {S : Finset (ℤ × ℤ)} {R : ℤ × ℤ} {Nd : ℕ} {Tg : Type*} {Mc : ℕ}

theorem dyadicFiniteTree_below (G : RealDyadicGrid) (R : ℤ × ℤ) (Nd : ℕ) :
    ∀ c ∈ dyadicFiniteTree G R Nd, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G R.1 R.2 :=
  fun c hc => ((dyadicFiniteTree_mem_iff G R c Nd).mp hc).1

theorem root_mem_dyadicFiniteTree (G : RealDyadicGrid) (R : ℤ × ℤ) (Nd : ℕ) :
    R ∈ dyadicFiniteTree G R Nd :=
  (dyadicFiniteTree_mem_iff G R R Nd).mpr ⟨subset_rfl, by omega⟩

/-- The catalog column tree on the complete finite tree below `R` of depth `Nd`. -/
noncomputable def catFullTree (G : RealDyadicGrid) (R : ℤ × ℤ) (Nd : ℕ) (s : List (CatCol Tg))
    (Mc : ℕ) (hb : ∀ d ∈ s, d.birth ∈ dyadicFiniteTree G R Nd) : ColumnTreeData (Fin Mc) :=
  catTree G (dyadicFiniteTree G R Nd) R (dyadicFiniteTree_below G R Nd)
    (root_mem_dyadicFiniteTree G R Nd) s Mc hb

/-- The nested depth projections of a catalog of rank `r` whose masks `M`, monotone in depth on
the active cells `S`, are inherited on the complete tree from the deepest active ancestor. -/
noncomputable def catDepthFamily (hR : R ∈ S) (s : List (CatCol Tg))
    (hb : ∀ d ∈ s, d.birth ∈ dyadicFiniteTree G R Nd) (r : ℕ) (M : ℤ × ℤ → Tg → Prop)
    (hM : ∀ c ∈ S, ∀ d ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      ∀ x, M d x → M c x) : ColumnDepthFamily (Fin Mc) where
  D := catFullTree G R Nd s Mc hb
  A := catMask r (fun c => M (deepestIn G S c)) fun c _ d hd hcd x hx =>
    extMask_mono G S hR M hM (dyadicFiniteTree_below G R Nd d hd) hcd x hx
  N := R.1 + Nd
  root_le := by change R.1 ≤ R.1 + Nd; omega
  complete := fun c hc hN => (dyadicFiniteTree_mem_iff G R c Nd).mpr ⟨hc, hN⟩

/-- On an active cell of depth `h`, the depth projection `P_h` followed by the restriction to the
cell is the catalog projection of the cell. -/
theorem catDepthFamily_restrict (hR : R ∈ S) (s : List (CatCol Tg))
    (hb : ∀ d ∈ s, d.birth ∈ dyadicFiniteTree G R Nd) (r : ℕ) (M : ℤ × ℤ → Tg → Prop)
    (hM : ∀ c ∈ S, ∀ d ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      ∀ x, M d x → M c x) {I : ℤ × ℤ} (hI : I ∈ S) (hIT : I ∈ dyadicFiniteTree G R Nd) :
    (columnL2Restriction (dyadicGridCell G I.1 I.2) (dyadicGridCell_measurable G I.1 I.2)).comp
      ((catDepthFamily (Mc := Mc) hR s hb r M hM).proj I.1) = catProj G Mc s I r (M I) := by
  set Ψ := catDepthFamily (Mc := Mc) hR s hb r M hM
  have hIR := (dyadicFiniteTree_mem_iff G R I Nd).mp hIT
  have hRI : R.1 ≤ I.1 := dyadicGridCell_depth_le_of_subset G I R hIR.1
  have hIN : I.1 ≤ R.1 + Nd := hIR.2
  have hQ : I ∈ (Ψ.partition I.1).cells := Ψ.depth_of_mem hRI hIN rfl hIR.1
  have hcat : catProj G Mc s I r (M I) =
      cellColumnProjection Ψ.D Ψ.A ((Ψ.partition I.1).subset hQ) := by
    have h := catProj_eq_cellColumnProjection (G := G) (T := dyadicFiniteTree G R Nd) (root := R)
      (hbr := dyadicFiniteTree_below G R Nd) (hroot := root_mem_dyadicFiniteTree G R Nd)
      (s := s) (Mc := Mc) (hb := hb) r (fun c => M (deepestIn G S c))
      (fun c _ d hd hcd x hx => extMask_mono G S hR M hM (dyadicFiniteTree_below G R Nd d hd)
        hcd x hx) hIT
    simp only [deepestIn_of_mem G S hI] at h
    exact h
  refine ContinuousLinearMap.ext fun z => Lp.ext ?_
  have hres := (catProj_restrict G Mc s I r (M I)).2
  rw [← hres]
  simp only [ContinuousLinearMap.comp_apply]
  change (columnL2Indicator _ (dyadicGridCell_measurable G I.1 I.2) (Ψ.proj I.1 z) :
      ℝ → ColumnHilbert (Fin Mc)) =ᵐ[volume] (columnL2Indicator _
      (dyadicGridCell_measurable G I.1 I.2) (catProj G Mc s I r (M I) z) :
      ℝ → ColumnHilbert (Fin Mc))
  have hae := Ψ.proj_ae_cell I.1 z hQ
  rw [← hcat] at hae
  have hae' := (ae_restrict_iff' (dyadicGridCell_measurable G I.1 I.2)).mp hae
  filter_upwards [columnL2Indicator_coeFn _ (dyadicGridCell_measurable G I.1 I.2) (Ψ.proj I.1 z),
    columnL2Indicator_coeFn _ (dyadicGridCell_measurable G I.1 I.2)
      (catProj G Mc s I r (M I) z), hae'] with y h1 h2 h3
  rw [h1, h2]
  by_cases hy : y ∈ dyadicGridCell G I.1 I.2
  · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy]; exact h3 hy
  · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]

end CatalogDepthFamily

/-! ### Whole endpoint ranges for vectors of catalog ranges (blueprint lines 1777-1789) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- Blueprint lem:whole-ranges (lines 1777-1789) in vector form: group vectors that are sums of
elements of catalog ranges on certified active cells, with the group's ball masks at heights at
most `H_max`, are almost orthogonal across the groups of one color. -/
theorem catRange_wholeRanges (cat : List (CatCol A.Vtx)) (t : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t R γ d.birth d.rank d.tag)
    {ι κ : Type*} [Fintype ι] (grp : ι → A.Grp) (hgrp : Function.Injective grp) (k : ℕ)
    (T : ι → Finset κ) (u : ι → κ → ℤ × ℤ) (hu : ∀ G, ∀ q ∈ T G, u G q ∈ A.cells)
    (rk hq : ι → κ → ℕ) (hqH : ∀ G q, hq G q ≤ ap.Hmax) (w : ι → κ → ColumnL2 (Fin ap.Mc))
    (hw : ∀ G, ∀ q ∈ T G, w G q ∈ catRange A.G ap.Mc cat (u G q) (rk G q)
      (fun x => x ∈ ap.K.mask A.admT A.vtxBound (grp G) (hq G q) (A.admAt (u G q))))
    (hcert : ∀ G, ∀ q ∈ T G, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G (u G q).1 (u G q).2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun p => ∃ q ∈ T p.1,
      y ∈ dyadicGridCell A.G (u p.1 q).1 (u p.1 q).2 ∧
        p.2 ∈ catLabels A.G ap.Mc cat (u p.1 q) (rk p.1 q)
          (fun x => x ∈ ap.K.mask A.admT A.vtxBound (grp p.1) (hq p.1 q)
            (A.admAt (u p.1 q)))).card ≤ N) :
    ‖∑ G, ∑ q ∈ T G, w G q‖ ^ 2 ≤ (1 + τ * N * 1 ^ 2) * ∑ G, ‖∑ q ∈ T G, w G q‖ ^ 2 := by
  have hex : ∀ G q, ∃ β : Fin ap.Mc → ℂ, q ∈ T G → w G q = ∑ n ∈ catLabels A.G ap.Mc cat
      (u G q) (rk G q) (fun x => x ∈ ap.K.mask A.admT A.vtxBound (grp G) (hq G q)
        (A.admAt (u G q))), β n • fitColumn (dyadicGridCell A.G (u G q).1 (u G q).2)
          (catAtom cat n) n := by
    intro G q
    by_cases h : q ∈ T G
    · obtain ⟨β, hβ⟩ := catRange_exists_coeff (hw G q h)
      exact ⟨β, fun _ => hβ⟩
    · exact ⟨0, fun h' => absurd h' h⟩
  choose β hβ using hex
  set L : ι → κ → Finset (Fin ap.Mc) := fun G q => catLabels A.G ap.Mc cat (u G q) (rk G q)
    (fun x => x ∈ ap.K.mask A.admT A.vtxBound (grp G) (hq G q) (A.admAt (u G q)))
  have hS : ∀ G, ∑ q ∈ T G, w G q = ∑ q ∈ T G, ∑ n ∈ L G q, β G q n •
      fitColumn (dyadicGridCell A.G (u G q).1 (u G q).2) (catAtom cat n) n :=
    fun G => Finset.sum_congr rfl fun q hq' => hβ G q hq'
  set occ : ι → Fin ap.Mc → Finset (ℤ × ℤ) := fun G v =>
    ((T G).filter fun q => v ∈ L G q).image (u G)
  set cc : ι → Fin ap.Mc → ℤ × ℤ → ℂ := fun G v I =>
    ∑ q ∈ (T G).filter (fun q => v ∈ L G q ∧ u G q = I), β G q v
  have hae : ∀ G, ((∑ q ∈ T G, ∑ n ∈ L G q, β G q n •
      fitColumn (dyadicGridCell A.G (u G q).1 (u G q).2) (catAtom cat n) n :
        ColumnL2 (Fin ap.Mc)) : ℝ → ColumnHilbert (Fin ap.Mc)) =ᵐ[volume]
      groupOutput (fun v : Fin ap.Mc => catAtom cat v) (fun _ => 1)
        (occCoef A.G occ cc G) := fun G =>
    sum_fitColumns_ae A.G cat (T G) (u G) (L G) (β G)
  have hall : ∀ᵐ y ∂volume, ∀ G, ((∑ q ∈ T G, ∑ n ∈ L G q, β G q n •
