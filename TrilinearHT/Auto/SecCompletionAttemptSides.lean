namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- `eq:whole-ranges` for the interval rows of the attempt variation (blueprint lines 1883-1885:
"their adjoints lie in sums of whole ball ranges at the two endpoints; a right certificate
certifies every needed earlier endpoint"). -/
theorem attempt_wr1 (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed)
    {ι ι' : Type*} [Fintype ι] [DecidableEq ι] [Fintype ι'] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (r t : ι' → ℕ) (hrt : ∀ i, r i ≤ t i) (Ec : ι → ι' → Finset (ℤ × ℤ))
    (hEc : ∀ G i, ∀ I ∈ Ec G i, I ∈ A.cells ∧ I.1 = A.R.1 + t i)
    (hcert : ∀ G i, ∀ I ∈ Ec G i, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    (p : Fin ap.P) (x : ι × ι' → ColumnL2 (Fin ap.Mc)) :
    ‖∑ q : ι × ι', ContinuousLinearMap.adjoint
        ((columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
          ((ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + t q.2) -
            (ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + r q.2))) (x q)‖ ^ 2 ≤
      (1 + τ * N * 1 ^ 2) * ∑ G, ‖∑ q ∈ (Finset.univ : Finset (ι × ι')).filter
        (fun q => q.1 = G), ContinuousLinearMap.adjoint
          ((columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
            (Finset.measurableSet_biUnion _ fun I _ =>
              dyadicGridCell_measurable A.G I.1 I.2)).comp
            ((ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + t q.2) -
              (ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + r q.2))) (x q)‖ ^ 2 := by
  set F : ι × ι' → ColumnL2 (Fin ap.Mc) := fun q => ContinuousLinearMap.adjoint
    ((columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
      ((ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + t q.2) -
        (ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + r q.2))) (x q) with hF
  -- the index of the catalog vectors
  set T : ι → Finset ((Σ _ : ι', ℤ × ℤ) × Bool) := fun G =>
    ((Finset.univ : Finset ι').sigma (Ec G)) ×ˢ Finset.univ
  set u : ι → (Σ _ : ι', ℤ × ℤ) × Bool → ℤ × ℤ := fun _ q =>
    if q.2 then q.1.2 else ancAt A.G q.1.2 (A.R.1 + r q.1.1)
  set w : ι → (Σ _ : ι', ℤ × ℤ) × Bool → ColumnL2 (Fin ap.Mc) := fun G q =>
    if q.2 then catProj A.G ap.Mc cat q.1.2 r₀ (ap.bmask q.1.2 (grp G) j p) (x (G, q.1.1))
    else -catProj A.G ap.Mc cat (ancAt A.G q.1.2 (A.R.1 + r q.1.1)) r₀
      (ap.bmask (ancAt A.G q.1.2 (A.R.1 + r q.1.1)) (grp G) j p)
        (columnL2Restriction (dyadicGridCell A.G q.1.2.1 q.1.2.2)
          (dyadicGridCell_measurable A.G q.1.2.1 q.1.2.2) (x (G, q.1.1)))
  -- each group term is the sum of its catalog vectors
  have hFG : ∀ G i, F (G, i) = ∑ I ∈ Ec G i, (w G ⟨⟨i, I⟩, true⟩ + w G ⟨⟨i, I⟩, false⟩) := by
    intro G i
    simp only [hF, ContinuousLinearMap.adjoint_comp, map_sub, ColumnDepthFamily.proj_adjoint,
      columnL2Restriction_adjoint, ContinuousLinearMap.comp_apply]
    rw [ap.ballFam_interval_decomp cat hR hb hanc r₀ j (grp G) p (by omega)
      (by have := hrt i; omega) (Ec G i) (hEc G i) (x (G, i))]
    refine Finset.sum_congr rfl fun I _ => ?_
    simp only [w, ↓reduceIte, sub_eq_add_neg]
    rfl
  have hTsum : ∀ G, ∑ q ∈ T G, w G q =
      ∑ i, ∑ I ∈ Ec G i, (w G ⟨⟨i, I⟩, true⟩ + w G ⟨⟨i, I⟩, false⟩) := by
    intro G
    simp only [T, Finset.sum_product, Finset.sum_sigma, Fintype.sum_bool]
  have hgroup : ∀ G, ∑ q ∈ (Finset.univ : Finset (ι × ι')).filter (fun q => q.1 = G), F q =
      ∑ q ∈ T G, w G q := by
    intro G
    rw [sum_filter_fst_eq F G, hTsum]
    exact Finset.sum_congr rfl fun i _ => hFG G i
  have htotal : ∑ q : ι × ι', F q = ∑ G, ∑ q ∈ T G, w G q := by
    rw [Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun G _ => ?_
    rw [hTsum]
