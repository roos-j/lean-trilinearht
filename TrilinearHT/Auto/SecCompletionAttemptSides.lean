/-- Blueprint lines 2723-2724 (multiplicity via `lem:height`): for a fixed tuple `x`, triple `T`
and anchor `l`, the scales `s` at which some box shift `|n| ≤ B` gives the triple test
`μ R_s ≤ |Σ_{i ∈ T} (i - l) x_i + 36 n·ζ| ≤ ν R_s` number at most
`32 (d + 5)⁴ (log(72 B) + log(2ν/μ))`: these are bounded-height rational evaluations of the vector
`(x, ζ)`. -/
theorem tested_scale_mult {d : ℕ} (ζ : Fin d → ℝ) (x : Fin 4 → ℝ) (T : Finset (Fin 4))
    (l : Fin 4) {B μ ν R₀ : ℝ} (hB : 1 ≤ B) (hμ : 0 < μ) (hμν : μ ≤ ν) (hR₀ : 0 < R₀)
    (S : Finset ℤ) :
    ((S.filter fun s => ∃ n : Fin d → ℤ, (∀ p, |(n p : ℝ)| ≤ B) ∧
        μ * (R₀ * 2 ^ s) ≤ |∑ i ∈ T, (roleCoeff i l : ℝ) * x i + 36 * ∑ p, (n p : ℝ) * ζ p| ∧
        |∑ i ∈ T, (roleCoeff i l : ℝ) * x i + 36 * ∑ p, (n p : ℝ) * ζ p| ≤ ν * (R₀ * 2 ^ s)).card
      : ℝ) ≤ 32 * ((4 + d : ℕ) + 1 : ℝ) ^ 4 * (Real.log (2 * (36 * B)) + Real.log (2 * ν / μ)) := by
  classical
  obtain ⟨N, hN, hcard⟩ := rational_frequency_scale_count (d := 4 + d) (u := 1) (B := 36 * B)
