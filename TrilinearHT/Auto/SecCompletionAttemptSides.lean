      2 * Real.pi * (θ * |y - x| + |lam| * (y - x) ^ 2) := by
  have hmul : (Real.fourierChar (lam * (x - a) ^ 2 + γ * (x - a)) : ℂ) *
      (Real.fourierChar ((ωa - s) * (y - x)) : ℂ) =
      (Real.fourierChar ((lam * (x - a) ^ 2 + γ * (x - a)) + (ωa - s) * (y - x)) : ℂ) := by
    rw [Real.fourierChar.map_add_eq_mul (lam * (x - a) ^ 2 + γ * (x - a)) ((ωa - s) * (y - x)),
      Circle.coe_mul]
