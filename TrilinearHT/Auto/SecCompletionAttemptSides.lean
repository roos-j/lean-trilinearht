    have hper := fun h' {x y : Ms.alive (ancAt Gd c.2 (c.1 - 4 * S.K))} =>
      Ms.blockComps_persist S hA (hNd c hc) (hNd c' hc') hlt.le hsub h' hUU (x := x) (y := y)
    set C := Ms.blockComps S hA c.1 c.2
    set C' := Ms.blockComps S hA c'.1 c'.2
    obtain ⟨y1, hy1E, hy1⟩ := Finset.mem_map.mp hz
    obtain ⟨y2, hy2E, hy2⟩ := Finset.mem_map.mp hz'
    have hfy : Ms.aliveMap hUU y1 = z := Subtype.ext hy1
    have hy2z : y2 = z' := Subtype.ext hy2
    subst hy2z
    -- the link: the earlier mode lies in the later CURRENT component
    have hlink : Ms.aliveMap hUU (mOf c) ∈ C'.F h (mOf c') := by
      have h1 : z ∈ C'.E (h - Δ) (Ms.aliveMap hUU (mOf c)) := by
        rw [← hfy]; exact (hper (h - Δ)).1 hy1E
      have h1' : Ms.aliveMap hUU (mOf c) ∈ C'.F h z := by
        have : Ms.aliveMap hUU (mOf c) ∈ C'.E (h - Δ) z := by
          rw [C'.E_comp _ _ z h1]; exact C'.E_self _ _
        exact C'.F_mono _ h _ (Nat.sub_le _ _) (C'.E_le_F _ _ this)
      have h2 : C'.F h z = C'.F h (mOf c') := by
        rw [C'.F_comp h y2 z hzF]
        exact C'.F_comp h (mOf c') y2
          (C'.F_mono _ h _ (Nat.sub_le _ _) (C'.E_le_F _ _ hy2E))
      rw [← h2]; exact h1'
    have htype : (C'.labels (C'.E (h - Δ) (mOf c'))).card <
        2 * (C.labels (C.E (h - Δ) (mOf c))).card := by
      refine ModeComponents.card_lt_two_mul_of_log2_eq ?_
        ((htype1 c hc).trans (htype1 c' hc').symm)
      exact Finset.card_pos.mpr ⟨_, Finset.mem_image_of_mem _ (C.E_self _ _)⟩
    have hnest' := ModeComponents.predecessor_nesting C C' (Ms.aliveMap hUU)
      (fun x => by simp only [C, C', blockComps_π]; rfl)
      (fun h' x y hy => (hper h').1 hy) (fun h' x y hy => (hper h').2 hy) Δ (Ms.goodP S SP c'.1)
      (hstab c' hc') (hgood c' hc') hlink htype
    intro y hy
    obtain ⟨y1, hy1, rfl⟩ := Finset.mem_map.mp hy
    exact Finset.mem_map.mpr ⟨Ms.aliveMap hUU y1,
      hnest' (Finset.mem_image_of_mem _ hy1), rfl⟩
  -- predecessors meeting along a path are nested
  have hnest : ∀ c c', lt c c' → (E c ∩ E c').Nonempty → E c ⊆ E c' := by
    intro c c' hcc' hmeet
    obtain ⟨y, hy⟩ := hmeet
    obtain ⟨hy1, hy2⟩ := Finset.mem_inter.mp hy
    obtain ⟨y2, hy2E, rfl⟩ := Finset.mem_map.mp hy2
    exact hlinked c c' hcc' y2 y2 hy1 (Finset.mem_map_of_mem _ hy2E)
      ((Ms.blockComps S hA c'.1 c'.2).E_le_F h y2 (ModeComponents.E_self _ h y2))
  have hmaj : ∀ c c', lt c c' → E c ⊆ E c' → (E c').card < 2 * (E c).card := by
    intro c c' hcc' _
    exact ModeComponents.card_lt_two_mul_of_log2_eq (Finset.card_pos.mpr (hne c))
      ((htype2 c hcc'.1).trans (htype2 c' hcc'.2.1).symm)
  refine ⟨hereditaryRep E lt d hd dflt, ?_⟩
  exact ⟨hereditaryRep_mem E lt d hd dflt hne,
    hereditaryRep_inherit E lt d hd dflt hpath hnest hmaj,
    fun c c' hcc' hrep => hereditaryRep_disjoint E lt d hd dflt hpath hnest hmaj hcc' hrep,
    fun c c' hcc' hrep z z' hz hz' hzF => hrep (hereditaryRep_inherit E lt d hd dflt hpath hnest
      hmaj c c' hcc' (hlinked c c' hcc' z z' hz hz' hzF)).symm⟩

end ModeSystem

/-! ### Separation of representative frequencies (`eq:representative-separation`, 2184-2192) -/

namespace ModeComponents

variable {Mode P : Type*} [Fintype Mode] [DecidableEq Mode] [DecidableEq P]

theorem ofEdges_F_of_cur (pre cur : ℕ → Mode → Mode → Prop) (π : Mode → P)
    (hle : ∀ h m m', pre h m m' → cur h m m')
    (hpre : ∀ h h' m m', h ≤ h' → pre h m m' → pre h' m m')
    (hcur : ∀ h h' m m', h ≤ h' → cur h m m' → cur h' m m') {h : ℕ} {m m' : Mode}
    (hmm' : cur h m m') : m' ∈ (ofEdges pre cur π hle hpre hcur).F h m := by
  classical
  by_cases he : m = m'
  · subst he
    exact (ofEdges pre cur π hle hpre hcur).E_le_F h m
      ((ofEdges pre cur π hle hpre hcur).E_self h m)
  · simp only [ofEdges, Finset.mem_filter, Finset.mem_univ, true_and]
    exact SimpleGraph.Adj.reachable (by simp [SimpleGraph.fromRel_adj, he, hmm'])

end ModeComponents

namespace ModeSchedule

variable (S : ModeSchedule)

/-- Blueprint line 2192: without a gap edge at height `h`, every allowed shift leaves the affine
frequency difference above `θ` at some point, hence above `θ/2` on the whole cell when its
variation over the cell is at most `θ/2` (`eq:slope-variation`). -/
theorem sep_of_not_gapEdge {Mode : Type*} {dz : ℕ} (ω : Mode → ℝ → ℝ) (ϑ : Fin dz → ℝ)
    (a r θr : ℝ) {h : ℕ} {m m' : Mode} (hne : ¬ S.gapEdge ω ϑ a r θr h m m') {lam γ : ℝ}
    (haff : ∀ x, ω m x - ω m' x = 2 * lam * x + γ) (hvar : 2 * |lam| * r ≤ θr / 2)
    (n : Fin dz → ℤ) (hn : ∀ i, |(n i : ℝ)| ≤ S.Eh h) :
    ∀ x ∈ Set.Icc a (a + r), θr / 2 < |ω m x - ω m' x + (∑ i, (n i : ℝ) * ϑ i) / Lh h| := by
  have hx0 : ∃ x₀ ∈ Set.Icc a (a + r),
      θr < |ω m x₀ - ω m' x₀ + (∑ i, (n i : ℝ) * ϑ i) / Lh h| := by
    by_contra hno
    push Not at hno
    exact hne ⟨n, hn, hno⟩
  obtain ⟨x₀, hx₀, hlarge⟩ := hx0
  set c := (∑ i, (n i : ℝ) * ϑ i) / Lh h
  have hsep := affine_separation_on_cell (lam := lam) (γ := γ + c) hx₀ (by
    rw [haff] at hlarge; rwa [add_assoc] at hlarge) hvar
  intro x hx
  have := hsep x hx
  rw [haff, add_assoc]
  exact this

end ModeSchedule

namespace ModeSystem

variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

/-- Blueprint `eq:representative-separation` (lines 2184-2192): two modes alive on the pre-cell
`J'` of block `b'` that lie in different CURRENT components at height `h` have, for every allowed
shift `n`, frequency difference above `Ξ / (2 r_{t_{b'}})` on the whole pre-cell, when the
curvature difference obeys `eq:slope-variation`; on actual cells `I, I'` of length at least
`r_{t_{b'}}` this is at least `(Ξ/2) max(|I|⁻¹, |I'|⁻¹)`. -/
theorem representative_separation {b' : ℤ} {J' : ℤ × ℤ} (hJ' : J'.1 = b' - 2 * S.K) {h : ℕ}
    {z z' : Ms.alive (ancAt Gd J' (b' - 4 * S.K))}
    (hzF : z ∉ (Ms.blockComps S hA b' J').F h z')
    (hvar : 2 * |Ms.lamOf z'.1 - Ms.lamOf z.1| * dyadicGridLength Gd J'.1 ≤
      S.Ξ / dyadicGridLength Gd (b' + S.K) / 2)
    (n : Fin Ms.zc.dim → ℤ) (hn : ∀ i, |(n i : ℝ)| ≤ S.Eh h) {rI rI' : ℝ}
    (hrI : dyadicGridLength Gd (b' + S.K) ≤ rI) (hrI' : dyadicGridLength Gd (b' + S.K) ≤ rI') :
    ∀ x ∈ Set.Icc (dyadicGridLeft Gd J'.1 J'.2) (dyadicGridLeft Gd J'.1 J'.2 +
        dyadicGridLength Gd J'.1),
      S.Ξ / 2 * max rI⁻¹ rI'⁻¹ < |Ms.slope z'.1 x - Ms.slope z.1 x +
        (∑ i, (n i : ℝ) * (Ms.zc.θ i / S.Q0)) / ModeSchedule.Lh h| := by
  have hK : (0 : ℤ) ≤ S.K := Nat.cast_nonneg _
  have h1 : J'.1 ≤ b' + S.K := by rw [hJ']; omega
  have hrt := dyadicGridLength_pos Gd (b' + S.K)
  -- no CURRENT edge between the two modes
  have hne : ¬ S.gapEdge
      (fun (x : Ms.alive (ancAt Gd J' (b' - 4 * S.K))) (y : ℝ) => Ms.slope x.1 y)
      (fun l => Ms.zc.θ l / S.Q0)
      (dyadicGridLeft Gd J'.1 J'.2) (dyadicGridLength Gd J'.1)
      (S.Ξ / dyadicGridLength Gd (b' + S.K)) h z' z := by
    intro hedge
    apply hzF
    rw [Ms.blockComps_eq S hA h1]
    unfold preComps ModeSchedule.preCurrent
    exact ModeComponents.ofEdges_F_of_cur _ _ _ _ _ _ hedge
  have hsep := S.sep_of_not_gapEdge
    (fun (x : Ms.alive (ancAt Gd J' (b' - 4 * S.K))) (y : ℝ) => Ms.slope x.1 y)
    (fun l => Ms.zc.θ l / S.Q0)
    (dyadicGridLeft Gd J'.1 J'.2) (dyadicGridLength Gd J'.1)
    (S.Ξ / dyadicGridLength Gd (b' + S.K)) hne (lam := Ms.lamOf z'.1 - Ms.lamOf z.1)
    (γ := -2 * Ms.lamOf z'.1 * dyadicGridLeft Gd (Ms.cellOf z'.1).1 (Ms.cellOf z'.1).2 +
      Ms.γOf z'.1 + 2 * Ms.lamOf z.1 * dyadicGridLeft Gd (Ms.cellOf z.1).1 (Ms.cellOf z.1).2 -
      Ms.γOf z.1) (fun x : ℝ => by simp only [slope]; ring) hvar n hn
  intro x hx
  refine lt_of_le_of_lt ?_ (hsep x hx)
  have hΞ := Ξ_nonneg S
  have hmax : max rI⁻¹ rI'⁻¹ ≤ (dyadicGridLength Gd (b' + S.K))⁻¹ :=
    max_le (inv_anti₀ hrt hrI) (inv_anti₀ hrt hrI')
  calc S.Ξ / 2 * max rI⁻¹ rI'⁻¹ ≤ S.Ξ / 2 * (dyadicGridLength Gd (b' + S.K))⁻¹ :=
        mul_le_mul_of_nonneg_left hmax (div_nonneg hΞ (by norm_num))
    _ = S.Ξ / dyadicGridLength Gd (b' + S.K) / 2 := by ring

end ModeSystem

