            simp only [Finset.sum_const, Nat.card_Ico, nsmul_eq_mul]
            rw [← Finset.sum_mul]
            norm_num [Finset.sum_range_succ]
    · calc ∑ t ∈ (Finset.Icc 1 T).filter (fun t => ¬ t < 12), ∑ u ∈ Finset.Ico 1 t, Y u t ≤
