/-- Blueprint `eq:applied-sparse` for three cores and side role `l` (lines 2724-2741): tested
tuples with the `T_l` reference (`ThreeRef`), side incidence weights `w_s` (`Σ w_s ≤ M`),
separation, the pure-shift gap and scale multiplicity `L` satisfy `lem:sparse-count` (pair
determination by `three_core_pair`), hence `Σ_{N_s ≤ δ M²} N_s ≤ C ℓ L^{12} δ^{1/300} M²`. -/
theorem three_core_sparse_count :
    ∃ C Cres : ℝ, 0 < C ∧ 0 < Cres ∧
    ∀ (d : ℕ) (ζ : Fin d → ℝ) (l : Fin 4) (A : Fin 4 → Finset ℝ) (M L : ℝ), 1 ≤ M → 1 ≤ L →
    (∀ i, i ≠ l → ((A i).card : ℝ) ≤ M) →
    ∀ (B Sg Q μ ν R₀ : ℝ), 1 ≤ B → 0 < μ → μ ≤ 1 → 1 ≤ ν → 0 < R₀ →
    ∀ (S : Finset ℤ) (E : ℤ → Finset (Fin 4 → ℝ)),
    (∀ s ∈ S, ∀ x ∈ E s, (∀ i, i ≠ l → x i ∈ A i) ∧ x l = 0) →
    (∀ x, ((S.filter fun s => x ∈ E s).card : ℝ) ≤ L) →
    (∃ w : ℤ → ℝ, (∀ s, 0 ≤ w s) ∧ ∑ s ∈ S, w s ≤ M ∧
      ∀ s ∈ S, ∀ i, i ≠ l → ∀ a, (((E s).filter fun x => x i = a).card : ℝ) ≤ w s) →
    (∀ s ∈ S, ∀ x ∈ E s, ThreeRef ζ l B μ ν (R₀ * 2 ^ s) x) →
    (∀ i, ∀ s ∈ S, ∀ s' ∈ S, ∀ x ∈ E s, ∀ x' ∈ E s', x i ≠ x' i →
      ∀ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
        Sg * max (R₀ * 2 ^ s) (R₀ * 2 ^ s') < |x i - x' i + ∑ k, (n k : ℝ) * ζ k|) →
    (∀ s ∈ S, (E s).Nonempty → ∀ n : Fin d → ℤ, (∀ k, |(n k : ℝ)| ≤ Q) →
      |∑ k, (n k : ℝ) * ζ k| ∉ Set.Icc (μ * (R₀ * 2 ^ s) / 1000) (1000 * ν * (R₀ * 2 ^ s))) →
    Cres * ((d : ℝ) + 1) ^ 2 * B ≤ Q → 72 * B ≤ Q →
    Cres * ((d : ℝ) + 1) ^ 2 * ν ≤ Sg → 2 * ν ≤ Sg →
    ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ∑ s ∈ S.filter (fun s => ((E s).card : ℝ) ≤ δ * M ^ 2), ((E s).card : ℝ) ≤
        C * (1 + Real.logb 2 (2 + ((d : ℝ) + 1) ^ 2 * ν / μ)) * L ^ 12 *
          δ ^ (1 / 300 : ℝ) * M ^ 2 := by
  obtain ⟨C, Cres, hC, hCres, hsc⟩ := sparse_count
  refine ⟨C, Cres, hC, hCres, ?_⟩
  intro d ζ l A M L hM hL hA B Sg Q μ ν R₀ hB hμ hμ1 hν hR₀ S E hE hmult hw href hsep hgap hQ
    hQ' hSg hSg' δ hδ0 hδ1
  have hc : (Finset.univ.erase l).card = 3 := by simp
  have hmemc : ∀ i, i ∈ Finset.univ.erase l ↔ i ≠ l := fun i => by simp
  obtain ⟨w, hw0, hwsum, hwinc⟩ := hw
  refine hsc d ζ (Finset.univ.erase l) (Or.inl hc) A M L hM hL
    (fun i hi => hA i ((hmemc i).mp hi)) B Sg Q μ ν R₀ hB hμ hμ1 hν hR₀ S E
    (fun s hs x hx => ⟨fun i hi => (hE s hs x hx).1 i ((hmemc i).mp hi), fun i hi => by
      have : i = l := by by_contra h; exact hi ((hmemc i).mpr h)
      rw [this]; exact (hE s hs x hx).2⟩)
    (fun i hi j hj hij s hs s' hs' x hx x' hx' hxi hxj => ?_) hmult
    (fun _ => ⟨w, hw0, hwsum, fun s hs i hi a => hwinc s hs i ((hmemc i).mp hi) a⟩)
    (fun i _ s hs s' hs' x hx x' hx' => hsep i s hs s' hs' x hx x' hx')
    (fun T hT hT3 l' hl' s hs x hx => ?_) hgap hQ hSg δ hδ0 hδ1
  · have hRs : 0 ≤ R₀ * 2 ^ s := by positivity
    exact three_core_pair ζ (hE s hs x hx).2 (hE s' hs' x' hx').2 hij ((hmemc i).mp hi)
      ((hmemc j).mp hj) hxi hxj (href s hs x hx) (href s' hs' x' hx')
      (fun r hr N hN => hsep r s hs s' hs' x hx x' hx' hr N hN) hQ' hSg' (by linarith) hRs
  · have hTe : T = Finset.univ.erase l :=
      Finset.eq_of_subset_of_card_le hT (by rw [hc, hT3])
    have hll : l' = l := by
      by_contra h; exact hl' (hTe ▸ (hmemc l').mpr h)
    subst hTe hll
    exact href s hs x hx

theorem sum_erase_roleCoeff_eq (l : Fin 4) (x : Fin 4 → ℝ) :
    ∑ i ∈ Finset.univ.erase l, (roleCoeff i l : ℝ) * x i =
      ∑ r : Fin 4, ((r : ℕ) : ℝ) * x r - ((l : ℕ) : ℝ) * ∑ r, x r := by
  rw [Finset.sum_erase _ (by simp [roleCoeff]), Finset.mul_sum, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun r _ => ?_
  simp only [roleCoeff]; push_cast; ring

/-- Blueprint lines 2724-2725 (core/side pair, windows): two three-core tested tuples at one
scale `R`, sharing the label of a core role `i`, whose side windows meet (their `Q` values
`Σ x_r + 36 n·ζ` differ by at most `4ΛR` for box shifts `n, n'`) are equal: with the two `T_l`
equations the two other labels solve a two-by-two system of divisor at most `3`, and separation
with `8ν + 48Λ ≤ Σ`, `1152 B ≤ Q` forces equality. -/
theorem side_window_pair {d : ℕ} (ζ : Fin d → ℝ) {l i : Fin 4} (hil : i ≠ l) {x x' : Fin 4 → ℝ}
    (hxl : x l = 0) (hxl' : x' l = 0) (hxi : x i = x' i) {B Q Sg μ ν Λ R : ℝ}
    (hx : ThreeRef ζ l B μ ν R x) (hx' : ThreeRef ζ l B μ ν R x') {n n' : Fin d → ℤ}
    (hn : ∀ p, |(n p : ℝ)| ≤ B) (hn' : ∀ p, |(n' p : ℝ)| ≤ B)
    (hwin : |(∑ r, x r + 36 * ∑ p, (n p : ℝ) * ζ p) -
      (∑ r, x' r + 36 * ∑ p, (n' p : ℝ) * ζ p)| ≤ 4 * Λ * R)
    (hsep : ∀ r, x r ≠ x' r → ∀ N : Fin d → ℤ, (∀ p, |(N p : ℝ)| ≤ Q) →
      Sg * R < |x r - x' r + ∑ p, (N p : ℝ) * ζ p|)
    (hQ : 1152 * B ≤ Q) (hSg : 8 * ν + 48 * Λ ≤ Sg) (hR : 0 ≤ R) : x = x' := by
  obtain ⟨m, hm, -, ht⟩ := hx
  obtain ⟨m', hm', -, ht'⟩ := hx'
  obtain ⟨k₀, l₀, hkl₀, hki₀, hkl₀', hli₀, hll₀, hcov⟩ := fin4_complement i l hil
  have hl3 : ((l : ℕ) : ℝ) ≤ 3 := by have := l.isLt; exact_mod_cast (by omega : (l : ℕ) ≤ 3)
  have hl0 : (0 : ℝ) ≤ (l : ℕ) := Nat.cast_nonneg _
  set M : Fin d → ℤ := fun p => m p + (l : ℕ) * n p with hM
  set M' : Fin d → ℤ := fun p => m' p + (l : ℕ) * n' p with hM'
  have hMb : ∀ (a b : Fin d → ℤ), (∀ p, |(a p : ℝ)| ≤ B) → (∀ p, |(b p : ℝ)| ≤ B) →
      ∀ p, |((a p + (l : ℕ) * b p : ℤ) : ℝ)| ≤ 4 * B := by
    intro a b ha hb p
    push_cast
    calc _ ≤ |(a p : ℝ)| + |((l : ℕ) : ℝ) * b p| := abs_add_le _ _
      _ = |(a p : ℝ)| + ((l : ℕ) : ℝ) * |(b p : ℝ)| := by rw [abs_mul, abs_of_nonneg hl0]
      _ ≤ B + 3 * B := by
        have := ha p; have := hb p
        have hB : 0 ≤ B := (abs_nonneg _).trans (hb p)
        nlinarith
      _ = 4 * B := by ring
  have hid : ∀ (y : Fin 4 → ℝ) (a b : Fin d → ℤ),
      ∑ r : Fin 4, ((r : ℕ) : ℝ) * y r + 36 * ∑ p, ((a p + (l : ℕ) * b p : ℤ) : ℝ) * ζ p =
        (∑ i ∈ Finset.univ.erase l, (roleCoeff i l : ℝ) * y i + 36 * ∑ p, (a p : ℝ) * ζ p) +
          ((l : ℕ) : ℝ) * (∑ r, y r + 36 * ∑ p, (b p : ℝ) * ζ p) := by
    intro y a b
    rw [sum_erase_roleCoeff_eq]
    push_cast
    simp only [add_mul, Finset.sum_add_distrib, mul_assoc, ← Finset.mul_sum]
    ring
  have hTd : |(∑ r : Fin 4, ((r : ℕ) : ℝ) * x r + 36 * ∑ p, (M p : ℝ) * ζ p) -
      (∑ r : Fin 4, ((r : ℕ) : ℝ) * x' r + 36 * ∑ p, (M' p : ℝ) * ζ p)| ≤
      2 * ν * R + 12 * Λ * R := by
    rw [hM, hM', hid, hid]
    have e : ∀ a b c e' : ℝ, (a + ((l : ℕ) : ℝ) * b) - (c + ((l : ℕ) : ℝ) * e') =
        (a - c) + ((l : ℕ) : ℝ) * (b - e') := fun _ _ _ _ => by ring
    rw [e]
    refine (abs_add_le _ _).trans ?_
    rw [abs_mul, abs_of_nonneg hl0]
    have h1 := (abs_sub _ _).trans (add_le_add ht ht')
    have h2 : ((l : ℕ) : ℝ) * |(∑ r, x r + 36 * ∑ p, (n p : ℝ) * ζ p) -
        (∑ r, x' r + 36 * ∑ p, (n' p : ℝ) * ζ p)| ≤ 3 * (4 * Λ * R) :=
      mul_le_mul hl3 hwin (abs_nonneg _) (by norm_num)
    linarith
  have hνR : 0 ≤ ν * R := (abs_nonneg _).trans ht
  have hΛR : 0 ≤ Λ * R := by have := (abs_nonneg _).trans hwin; linarith
  have hrole : ∀ k, k ≠ i → k ≠ l → x k = x' k := by
    intro k hki hkl
    obtain ⟨k', hk'⟩ : ∃ k', k' ≠ k ∧ k' ≠ i ∧ k' ≠ l := by
      rcases hcov k with h | h | h | h
      · exact absurd h hki
      · exact absurd h hkl
      · subst h; exact ⟨l₀, hkl₀.symm, hli₀, hll₀⟩
      · subst h; exact ⟨k₀, hkl₀, hki₀, hkl₀'⟩
    exact pair_role_of_diff ζ hk'.1.symm hki hkl hk'.2.1 hk'.2.2 hil hxi (by rw [hxl, hxl'])
      (B := 4 * B) (n := n) (m := M) (n' := n') (m' := M')
      (fun p => by have := hn p; have := (abs_nonneg _).trans (hn p); linarith)
      (hMb m n hm hn) (fun p => by have := hn' p; have := (abs_nonneg _).trans (hn' p); linarith)
      (hMb m' n' hm' hn') (ε := 2 * ν * R + 12 * Λ * R) (by linarith) hTd
      (fun h N hN => hsep k h N hN) (by linarith) (by nlinarith)
  funext r
  by_cases hri : r = i
  · rw [hri]; exact hxi
  by_cases hrl : r = l
  · rw [hrl, hxl, hxl']
  exact hrole r hri hrl

/-- The side window of a tested tuple (blueprint line 2564, `b_Λ`): the integer frequencies `k`
with `|k + r(Q + 36 n·ζ)| ≤ 2Λ` for some box shift `|n| ≤ B`, where `Q = Σ x_r`. -/
noncomputable def sideWindow {d : ℕ} (ζ : Fin d → ℝ) (r Λ B : ℝ) (x : Fin 4 → ℝ) : Finset ℤ :=
  (Fintype.piFinset fun _ : Fin d => Finset.Icc (-⌊B⌋) ⌊B⌋).biUnion fun n =>
    Finset.Icc ⌈-(r * (∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p)) - 2 * Λ⌉
      ⌊-(r * (∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p)) + 2 * Λ⌋

theorem mem_sideWindow {d : ℕ} {ζ : Fin d → ℝ} {r Λ B : ℝ} {x : Fin 4 → ℝ} {k : ℤ} :
    k ∈ sideWindow ζ r Λ B x ↔ ∃ n : Fin d → ℤ, (∀ p, |(n p : ℝ)| ≤ B) ∧
      |(k : ℝ) + r * (∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p)| ≤ 2 * Λ := by
  simp only [sideWindow, Finset.mem_biUnion, Fintype.mem_piFinset, Finset.mem_Icc,
    Int.ceil_le, Int.le_floor]
  refine exists_congr fun n => and_congr ?_ ?_
  · refine forall_congr' fun p => ?_
    rw [abs_le]
    constructor
    · rintro ⟨h1, h2⟩
      have : ((-n p : ℤ) : ℝ) ≤ B := Int.le_floor.mp (by omega)
      push_cast at this
      exact ⟨by linarith, h2⟩
    · rintro ⟨h1, h2⟩
      have : -n p ≤ ⌊B⌋ := Int.le_floor.mpr (by push_cast; linarith)
      exact ⟨by omega, h2⟩
  · rw [abs_le]; constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith

/-- Blueprint lines 2724-2726: at one scale `R = r⁻¹`, the side windows of distinct three-core
tested tuples sharing a core label are disjoint (`side_window_pair`). -/
theorem sideWindow_disjoint {d : ℕ} (ζ : Fin d → ℝ) {l i : Fin 4} (hil : i ≠ l)
    {x x' : Fin 4 → ℝ} (hxl : x l = 0) (hxl' : x' l = 0) (hxi : x i = x' i) (hne : x ≠ x')
    {B Q Sg μ ν Λ r : ℝ} (hr : 0 < r)
    (hx : ThreeRef ζ l B μ ν r⁻¹ x) (hx' : ThreeRef ζ l B μ ν r⁻¹ x')
    (hsep : ∀ j, x j ≠ x' j → ∀ N : Fin d → ℤ, (∀ p, |(N p : ℝ)| ≤ Q) →
      Sg * r⁻¹ < |x j - x' j + ∑ p, (N p : ℝ) * ζ p|)
    (hQ : 1152 * B ≤ Q) (hSg : 8 * ν + 48 * Λ ≤ Sg) :
    Disjoint (sideWindow ζ r Λ B x) (sideWindow ζ r Λ B x') := by
  rw [Finset.disjoint_left]
  intro k hk hk'
  obtain ⟨n, hn, h1⟩ := mem_sideWindow.mp hk
  obtain ⟨n', hn', h2⟩ := mem_sideWindow.mp hk'
  refine hne (side_window_pair ζ hil hxl hxl' hxi hx hx' hn hn' ?_ hsep hQ hSg
    (inv_nonneg.mpr hr.le))
  have h3 : |r * ((∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p) -
      (∑ i, x' i + 36 * ∑ p, (n' p : ℝ) * ζ p))| ≤ 4 * Λ := by
    have e : r * ((∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p) -
        (∑ i, x' i + 36 * ∑ p, (n' p : ℝ) * ζ p)) =
        ((k : ℝ) + r * (∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p)) -
          ((k : ℝ) + r * (∑ i, x' i + 36 * ∑ p, (n' p : ℝ) * ζ p)) := by ring
    rw [e]
    exact (abs_sub _ _).trans (by linarith)
  rw [abs_mul, abs_of_pos hr] at h3
  calc _ = r⁻¹ * (r * |(∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p) -
        (∑ i, x' i + 36 * ∑ p, (n' p : ℝ) * ζ p)|) := by field_simp
    _ ≤ r⁻¹ * (4 * Λ) := mul_le_mul_of_nonneg_left h3 (inv_nonneg.mpr hr.le)
    _ = 4 * Λ * r⁻¹ := by ring

/-- Blueprint lines 2726-2728 (side incidence): if the tested triples `Tr` incident to one core
label at one scale have pairwise disjoint side windows, and each has averaged window energy
`E_ρ Σ_{k ∈ W_t} F_ρ(k) ≥ σ²`, where for every offset `ρ` the window sums are bounded by the
normalized energy `G_ρ` (Parseval), then `|Tr| σ² ≤ E_ρ G_ρ`; this is `w_s σ²`. -/
theorem side_incidence_le {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω) [IsProbabilityMeasure P]
    {τ : Type*} (Tr : Finset τ) (W : τ → Finset ℤ)
    (hdis : ∀ t ∈ Tr, ∀ t' ∈ Tr, t ≠ t' → Disjoint (W t) (W t')) (F : Ω → ℤ → ℝ)
    (hFi : ∀ k, Integrable (fun ρ => F ρ k) P) (G : Ω → ℝ)
    (hG : Integrable G P) (hpars : ∀ ρ (U : Finset ℤ), ∑ k ∈ U, F ρ k ≤ G ρ) {σ : ℝ}
    (hσ : ∀ t ∈ Tr, σ ^ 2 ≤ ∫ ρ, ∑ k ∈ W t, F ρ k ∂P) :
    (Tr.card : ℝ) * σ ^ 2 ≤ ∫ ρ, G ρ ∂P := by
  classical
  calc (Tr.card : ℝ) * σ ^ 2 = ∑ _t ∈ Tr, σ ^ 2 := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ ∑ t ∈ Tr, ∫ ρ, ∑ k ∈ W t, F ρ k ∂P := Finset.sum_le_sum hσ
    _ = ∫ ρ, ∑ t ∈ Tr, ∑ k ∈ W t, F ρ k ∂P :=
        (integral_finsetSum _ fun t _ => integrable_finsetSum _ fun k _ => hFi k).symm
    _ = ∫ ρ, ∑ k ∈ Tr.biUnion W, F ρ k ∂P := by
        congr 1; funext ρ
        exact (Finset.sum_biUnion fun t ht t' ht' hne => hdis t ht t' ht' hne).symm
    _ ≤ ∫ ρ, G ρ ∂P := integral_mono (integrable_finsetSum _ fun k _ => hFi k) hG
        fun ρ => hpars ρ _

