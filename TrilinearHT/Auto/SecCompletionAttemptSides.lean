`θ |y - x*| + |λ_m| (y - x*)²`. -/
theorem mode_phase_reduction {lam a γ ωa s θ x y : ℝ}
    (hsl : |(2 * lam * (x - a) + γ) - ωa + s| ≤ θ) :
    |(lam * (y - a) ^ 2 + γ * (y - a)) - (lam * (x - a) ^ 2 + γ * (x - a)) - (ωa - s) * (y - x)|
      ≤ θ * |y - x| + |lam| * (y - x) ^ 2 := by
  rw [quad_phase_sub]
  have e : (2 * lam * (x - a) + γ) * (y - x) + lam * (y - x) ^ 2 - (ωa - s) * (y - x) =
      ((2 * lam * (x - a) + γ) - ωa + s) * (y - x) + lam * (y - x) ^ 2 := by ring
  rw [e]
  refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
  · rw [abs_mul]; exact mul_le_mul_of_nonneg_right hsl (abs_nonneg _)
  · rw [abs_mul, abs_of_nonneg (sq_nonneg (y - x))]

/-- The exponential form of `mode_phase_reduction`: with `e(t) = exp(2πit)`,
`|e(φ_m(y)) - e(φ_m(x*)) e((ω_a(x*) - s)(y - x*))| ≤ 2π (θ |y - x*| + |λ_m| (y - x*)²)`. -/
