/-! ### Exceptional roots and restarts (prop:normalized, blueprint lines 2838-2843) -/

/-- Blueprint lines 2839-2840 ("choose their thresholds so the union of exceptional roots has
length at most `|R|/4`") with path-packing line 429 ("for several rules take maximal cells in
their union and add their length bounds"): finitely many cut families of lengths at most
`ρ_i |R|` with `Σ ρ_i ≤ ρ` have maximal union cells of total length at most `ρ |R|`. -/
theorem exceptional_roots_le (G : RealDyadicGrid) {ι : Type*} (T : Finset ι)
    (F : ι → Finset (ℤ × ℤ)) (ρs : ι → ℝ) (root : ℤ × ℤ)
    (hF : ∀ i ∈ T, dyadicRootLength G (F i) ≤ ρs i * dyadicGridLength G root.1) {ρ : ℝ}
    (hρ : ∑ i ∈ T, ρs i ≤ ρ) :
    dyadicRootLength G (maximalDyadicCells G (T.biUnion F)) ≤ ρ * dyadicGridLength G root.1 := by
  classical
  have hw : ∀ c : ℤ × ℤ, 0 ≤ dyadicGridLength G c.1 := fun c => (dyadicGridLength_pos G c.1).le
  calc dyadicRootLength G (maximalDyadicCells G (T.biUnion F)) ≤
      dyadicRootLength G (T.biUnion F) :=
        Finset.sum_le_sum_of_subset_of_nonneg (maximalDyadicCells_subset G _) fun c _ _ => hw c
    _ ≤ ∑ i ∈ T, dyadicRootLength G (F i) := finite_union_weight_le T F _ hw
    _ ≤ ∑ i ∈ T, ρs i * dyadicGridLength G root.1 := Finset.sum_le_sum hF
    _ = (∑ i ∈ T, ρs i) * dyadicGridLength G root.1 := by rw [Finset.sum_mul]
    _ ≤ ρ * dyadicGridLength G root.1 :=
        mul_le_mul_of_nonneg_right hρ (dyadicGridLength_pos G root.1).le

/-- Blueprint lines 2841-2843 ("the root packing ... gives total length at most `4|R|/3`; on a
finite tree this recursion terminates, so a retained-attempt estimate sums with this fixed
factor"): if each restart root `c` of generation `k` contributes at most `A |c|` and has
exceptional children of total length at most `|c|/4`, then the contributions over all restart
generations sum to at most `(4/3) A |R|` (for any number of generations). -/
theorem restart_attempt_sum (G : RealDyadicGrid) (root : ℤ × ℤ)
    (generation : ℕ → Finset (ℤ × ℤ)) (children : ℕ → ℤ × ℤ → Finset (ℤ × ℤ))
    (hzero : generation 0 = {root})
    (hnext : ∀ k, generation (k + 1) ⊆ (generation k).biUnion (children k))
    (hchild : ∀ k c, c ∈ generation k →
      dyadicRootLength G (children k c) ≤ 1 / 4 * dyadicGridLength G c.1)
    (contrib : ℕ → ℤ × ℤ → ℝ) {A : ℝ} (hA : 0 ≤ A)
    (hcontrib : ∀ k, ∀ c ∈ generation k, contrib k c ≤ A * dyadicGridLength G c.1) (n : ℕ) :
    ∑ k ∈ Finset.range n, ∑ c ∈ generation k, contrib k c ≤
      4 / 3 * A * dyadicGridLength G root.1 := by
  obtain ⟨-, hsum, htot⟩ := dyadicRestartPacking G root generation children (by norm_num)
    (by norm_num) hzero hnext hchild
  have h1 : ∑ k ∈ Finset.range n, ∑ c ∈ generation k, contrib k c ≤
      A * ∑ k ∈ Finset.range n, dyadicRootLength G (generation k) := by
    rw [Finset.mul_sum]
    refine Finset.sum_le_sum fun k _ => ?_
    unfold dyadicRootLength
    rw [Finset.mul_sum]
    exact Finset.sum_le_sum fun c hc => hcontrib k c hc
  have h2 : ∑ k ∈ Finset.range n, dyadicRootLength G (generation k) ≤
      ∑' k, dyadicRootLength G (generation k) :=
    hsum.sum_le_tsum _ fun k _ => dyadicRootLength_nonneg G _
  have h3 : dyadicGridLength G root.1 / (1 - 1 / 4) = 4 / 3 * dyadicGridLength G root.1 := by
    ring
  rw [h3] at htot
  calc _ ≤ A * ∑ k ∈ Finset.range n, dyadicRootLength G (generation k) := h1
    _ ≤ A * (4 / 3 * dyadicGridLength G root.1) :=
        mul_le_mul_of_nonneg_left (h2.trans htot) hA
    _ = _ := by ring

/-! ### Cores, sides and errors in the active form (blueprint lines 2461-2462, 2845-2848) -/

section CoreSideDecomposition

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- The pattern piece: slot `l` takes the core part (`0`), the side part (`1`) or the physical
error (`2`). -/
def patternPiece (a s e : Fin 4 → V) (σ : Fin 4 → Fin 3) : Fin 4 → V :=
  fun l => ![a l, s l, e l] (σ l)

/-- Blueprint `eq:core-side-error` in a 4-linear form: with `Z_l = A_l + S_l + E_l`,
`H(Z) = Σ_σ H(pieces σ)` over all core/side/error patterns. -/
theorem form_pattern_expand (Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ) (a s e : Fin 4 → V) :
    Λ (fun l => a l + s l + e l) = ∑ σ : Fin 4 → Fin 3, Λ (patternPiece a s e σ) := by
  have h : (fun l => a l + s l + e l) = fun l => ∑ j : Fin 3, ![a l, s l, e l] j := by
    funext l; simp [Fin.sum_univ_three, add_assoc]
  rw [h, MultilinearMap.map_sum]
  rfl

open Classical in
/-- The number of slots of a pattern carrying a given part. -/
noncomputable def patternCount (σ : Fin 4 → Fin 3) (j : Fin 3) : ℕ :=
  (Finset.univ.filter fun l => σ l = j).card

open Classical in
/-- Blueprint lines 2461-2462 and 2845-2848: the patterns split into those containing a physical
error, those with at least three cores and no error, those with at least three sides and no
error, and those with exactly two cores and two sides. -/
theorem form_pattern_split (F : (Fin 4 → Fin 3) → ℂ) :
    ∑ σ, F σ = ∑ σ ∈ Finset.univ.filter (fun σ => ∃ l, σ l = 2), F σ +
      ∑ σ ∈ Finset.univ.filter (fun σ => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 0), F σ +
      ∑ σ ∈ Finset.univ.filter (fun σ => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1), F σ +
      ∑ σ ∈ Finset.univ.filter (fun σ => (∀ l, σ l ≠ 2) ∧ patternCount σ 0 = 2 ∧
        patternCount σ 1 = 2), F σ := by
  have hcount : ∀ σ : Fin 4 → Fin 3, (∀ l, σ l ≠ 2) →
      patternCount σ 0 + patternCount σ 1 = 4 := by
    intro σ hσ
    unfold patternCount
    rw [← Finset.card_union_of_disjoint (Finset.disjoint_filter.mpr fun l _ h0 h1 => by
      rw [h0] at h1; exact absurd h1 (by decide))]
    have : Finset.univ.filter (fun l => σ l = 0) ∪ Finset.univ.filter (fun l => σ l = 1) =
        (Finset.univ : Finset (Fin 4)) := by
      ext l
      simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and, iff_true]
      have h2 : (σ l).val ≠ 2 := fun h => hσ l (Fin.ext h)
      have h3 := (σ l).isLt
      by_cases h0 : (σ l).val = 0
      · left; exact Fin.ext h0
      · right; exact Fin.ext (by simp only [Fin.val_one]; omega)
    rw [this]; rfl
  simp only [Finset.sum_filter, ← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun σ _ => ?_
  by_cases he : ∃ l, σ l = 2
  · have hne : ¬ ∀ l, σ l ≠ 2 := fun h => by obtain ⟨l, hl⟩ := he; exact h l hl
    simp [he, hne]
  · have hn : ∀ l, σ l ≠ 2 := fun l hl => he ⟨l, hl⟩
    have hc := hcount σ hn
    rw [ite_eq_right_iff.mpr (fun h => absurd h he), zero_add]
    by_cases h0 : 3 ≤ patternCount σ 0
    · have h1 : ¬ 3 ≤ patternCount σ 1 := by omega
      have h2 : ¬ (patternCount σ 0 = 2 ∧ patternCount σ 1 = 2) := by omega
      simp [hn, h0, h1, h2]
    · by_cases h1 : 3 ≤ patternCount σ 1
      · have h2 : ¬ (patternCount σ 0 = 2 ∧ patternCount σ 1 = 2) := by omega
        simp [hn, h0, h1, h2]
      · have h2 : patternCount σ 0 = 2 ∧ patternCount σ 1 = 2 := by omega
        simp [hn, h2]

end CoreSideDecomposition

section CoreSideRestore

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

open Classical in
/-- Blueprint lines 2461-2462 ("for terms with exactly two sides, replace the two core
complements by their whole current `Z` arguments; corrections have at least three sides"): for a
pattern `σ` without errors, the form of its pieces equals the form with the core slots restored
to `Z_l = A_l + S_l + E_l` minus the correction patterns, each of which contains an error or has
more sides than `σ`. -/
theorem form_restore_cores (Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ) (a s e : Fin 4 → V)
    (σ : Fin 4 → Fin 3) (hσ : ∀ l, σ l ≠ 2) :
    Λ (patternPiece a s e σ) = Λ (fun l => if σ l = 0 then a l + s l + e l else s l) -
      ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
        Λ (patternPiece a s e τ) := by
  set A : Fin 4 → Finset (Fin 3) := fun l => if σ l = 0 then Finset.univ else {1}
  have hval : (fun l => if σ l = 0 then a l + s l + e l else s l) =
      fun l => ∑ j ∈ A l, ![a l, s l, e l] j := by
    funext l
    simp only [A]
    split_ifs
    · simp [Fin.sum_univ_three, add_assoc]
    · simp
  have hexp : Λ (fun l => if σ l = 0 then a l + s l + e l else s l) =
      ∑ τ ∈ Fintype.piFinset A, Λ (patternPiece a s e τ) := by
    rw [hval, MultilinearMap.map_sum_finset]
    rfl
  have hσmem : σ ∈ Fintype.piFinset A := by
    rw [Fintype.mem_piFinset]
    intro l
    simp only [A]
    split_ifs with h
    · exact Finset.mem_univ _
    · have h2 := hσ l
      have : σ l = 1 := by
        have hl := (σ l).isLt
        exact Fin.ext (by
          have h0 : (σ l).val ≠ 0 := fun hv => h (Fin.ext hv)
          have h2' : (σ l).val ≠ 2 := fun hv => h2 (Fin.ext hv)
          simp only [Fin.val_one]; omega)
      rw [this]; exact Finset.mem_singleton_self _
  have hpi : Fintype.piFinset A = insert σ (Finset.univ.filter fun τ : Fin 4 → Fin 3 =>
      τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1) := by
    ext τ
    simp only [Fintype.mem_piFinset, Finset.mem_insert, Finset.mem_filter, Finset.mem_univ,
      true_and, A]
    constructor
    · intro hτ
      by_cases hts : τ = σ
      · exact Or.inl hts
      · refine Or.inr ⟨hts, fun l hl => ?_⟩
        have := hτ l
        rw [hl] at this
        simpa using this
    · rintro (rfl | ⟨-, hτ⟩) l
      · exact (Fintype.mem_piFinset.mp hσmem) l
      · split_ifs with h
        · exact Finset.mem_univ _
        · have h2 := hσ l
          have : σ l = 1 := by
            have hl := (σ l).isLt
            exact Fin.ext (by
              have h0 : (σ l).val ≠ 0 := fun hv => h (Fin.ext hv)
              have h2' : (σ l).val ≠ 2 := fun hv => h2 (Fin.ext hv)
              simp only [Fin.val_one]; omega)
          rw [hτ l this]; exact Finset.mem_singleton_self _
  rw [hexp, hpi, Finset.sum_insert (by simp)]
  ring

open Classical in
/-- The corrections of `form_restore_cores` contain an error or more sides than the pattern. -/
theorem restore_correction_sides (σ τ : Fin 4 → Fin 3) (hσ : ∀ l, σ l ≠ 2) (hne : τ ≠ σ)
    (hτ : ∀ l, σ l = 1 → τ l = 1) :
    (∃ l, τ l = 2) ∨ patternCount σ 1 < patternCount τ 1 := by
  by_cases he : ∃ l, τ l = 2
  · exact Or.inl he
  · right
    push Not at he
    obtain ⟨l, hl⟩ := Function.ne_iff.mp hne
    have hσl : σ l = 0 := by
      have h2 := hσ l
      by_contra h0
      have : σ l = 1 := by
        have hl' := (σ l).isLt
        exact Fin.ext (by
          have h0' : (σ l).val ≠ 0 := fun hv => h0 (Fin.ext hv)
          have h2' : (σ l).val ≠ 2 := fun hv => h2 (Fin.ext hv)
          simp only [Fin.val_one]; omega)
      exact hl (by rw [this, hτ l this])
    have hτl : τ l = 1 := by
      have h2 := he l
      have hl' := (τ l).isLt
      exact Fin.ext (by
        have h0' : (τ l).val ≠ 0 := fun hv => hl (Fin.ext (by rw [hv, hσl]; rfl))
        have h2' : (τ l).val ≠ 2 := fun hv => h2 (Fin.ext hv)
        simp only [Fin.val_one]; omega)
    unfold patternCount
    refine Finset.card_lt_card ⟨fun x hx => ?_, fun hsub => ?_⟩
    · simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hx ⊢
      exact hτ x hx
    · have := hsub (Finset.mem_filter.mpr ⟨Finset.mem_univ l, hτl⟩)
      simp only [Finset.mem_filter, Finset.mem_univ, true_and] at this
      rw [hσl] at this
      exact absurd this (by decide)

end CoreSideRestore

/-! ### Power costs of three strong factors (side-estimate, blueprint lines 2370-2378) -/

open Classical in
/-- Blueprint lines 2373-2378 (`eq:three-sides` integrated along paths): cell weights `a, b, c ≥ 0`
whose squares have retained path sums at most `C_a, C_b, C_c` everywhere satisfy
`Σ_I |I| (a_I b_I c_I)^p ≤ (C_a C_b C_c)^{p/2} |R|` for `2/3 < p`. -/
theorem power_cost_bound (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (a b c : ℤ × ℤ → ℝ)
    (ha : ∀ I ∈ S, 0 ≤ a I) (hb : ∀ I ∈ S, 0 ≤ b I) (hc : ∀ I ∈ S, 0 ≤ c I) (root : ℤ × ℤ)
    (hR : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G root.1 root.2) {Ca Cb Cc : ℝ}
    (hCa : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), a I ^ 2 ≤ Ca)
    (hCb : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), b I ^ 2 ≤ Cb)
    (hCc : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), c I ^ 2 ≤ Cc)
    {p : ℝ} (hp : 2 / 3 < p) :
    ∑ I ∈ S, dyadicGridLength G I.1 * (a I * b I * c I) ^ p ≤
      Ca ^ (p / 2) * Cb ^ (p / 2) * Cc ^ (p / 2) * dyadicGridLength G root.1 := by
  have hp0 : 0 ≤ p / 2 := by linarith
  set f : ℝ → ℝ := fun x => ∑ I ∈ S, (dyadicGridCell G I.1 I.2).indicator
    (fun _ => (a I * b I * c I) ^ p) x
  rw [dyadicPathIntegral_real G S _ (dyadicGridCell G root.1 root.2) hR]
  have hpt : ∀ x, f x ≤ Ca ^ (p / 2) * Cb ^ (p / 2) * Cc ^ (p / 2) := by
    intro x
    have hfx : f x = ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2),
        (a I * b I * c I) ^ p := by
      simp only [f, Finset.sum_filter, Set.indicator_apply]
    rw [hfx]
    have hT := three_sides_power (S.filter fun I => x ∈ dyadicGridCell G I.1 I.2) a b c
      (fun I hI => ha I (Finset.mem_filter.mp hI).1) (fun I hI => hb I (Finset.mem_filter.mp hI).1)
      (fun I hI => hc I (Finset.mem_filter.mp hI).1) hp
    refine hT.trans ?_
    have h0a : 0 ≤ ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), a I ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    have h0b : 0 ≤ ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), b I ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    have h0c : 0 ≤ ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), c I ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    have h1 := Real.rpow_le_rpow h0a (hCa x) hp0
    have h2 := Real.rpow_le_rpow h0b (hCb x) hp0
    have h3 := Real.rpow_le_rpow h0c (hCc x) hp0
    have hCa0 : 0 ≤ Ca := h0a.trans (hCa x)
    have hCb0 : 0 ≤ Cb := h0b.trans (hCb x)
    exact mul_le_mul (mul_le_mul h1 h2 (Real.rpow_nonneg h0b _) (Real.rpow_nonneg hCa0 _)) h3
      (Real.rpow_nonneg h0c _) (mul_nonneg (Real.rpow_nonneg hCa0 _) (Real.rpow_nonneg hCb0 _))
  have hint : IntegrableOn f (dyadicGridCell G root.1 root.2) := by
    refine integrable_finsetSum _ fun I hI => ?_
    apply (integrable_indicator_iff (dyadicGridCell_measurable G I.1 I.2)).mpr
    change Integrable _ ((volume.restrict _).restrict (dyadicGridCell G I.1 I.2))
    rw [Measure.restrict_restrict_of_subset (hR I hI)]
    exact integrableOn_const (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)
  calc ∫ x in dyadicGridCell G root.1 root.2, f x ≤
      ∫ _x in dyadicGridCell G root.1 root.2, Ca ^ (p / 2) * Cb ^ (p / 2) * Cc ^ (p / 2) :=
        setIntegral_mono_on hint (integrableOn_const (by
          rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top))
          (dyadicGridCell_measurable G root.1 root.2) fun x _ => hpt x
    _ = _ := by
        rw [setIntegral_const, smul_eq_mul, Measure.real, dyadicGridCell_volume,
          ENNReal.toReal_ofReal (dyadicGridLength_pos G root.1).le]
        ring

/-- Blueprint line 2373 ("Cauchy-Schwarz in groups"): the group sum of three strong factors is at
most the product of their group square-sum roots, the third one bounding each of its terms. -/
theorem group_triple_le {ι : Type*} (s : Finset ι) (x y z : ι → ℝ) :
    ∑ G ∈ s, |x G| * |y G| * |z G| ≤
      Real.sqrt (∑ G ∈ s, x G ^ 2) * Real.sqrt (∑ G ∈ s, y G ^ 2) *
        Real.sqrt (∑ G ∈ s, z G ^ 2) := by
  have hz : ∀ G ∈ s, |z G| ≤ Real.sqrt (∑ G ∈ s, z G ^ 2) := by
    intro G hG
    rw [← Real.sqrt_sq_eq_abs]
    exact Real.sqrt_le_sqrt (Finset.single_le_sum (f := fun G => z G ^ 2)
      (fun _ _ => sq_nonneg _) hG)
  have hcs : ∑ G ∈ s, |x G| * |y G| ≤
      Real.sqrt (∑ G ∈ s, x G ^ 2) * Real.sqrt (∑ G ∈ s, y G ^ 2) := by
    have := Real.sum_mul_le_sqrt_mul_sqrt s (fun G => |x G|) (fun G => |y G|)
    simpa only [sq_abs] using this
  calc ∑ G ∈ s, |x G| * |y G| * |z G| ≤
      ∑ G ∈ s, |x G| * |y G| * Real.sqrt (∑ G ∈ s, z G ^ 2) :=
        Finset.sum_le_sum fun G hG => mul_le_mul_of_nonneg_left (hz G hG) (by positivity)
    _ = (∑ G ∈ s, |x G| * |y G|) * Real.sqrt (∑ G ∈ s, z G ^ 2) := by rw [Finset.sum_mul]
    _ ≤ _ := mul_le_mul_of_nonneg_right hcs (Real.sqrt_nonneg _)

open Classical in
/-- Path caps integrate to square budgets: `Σ_{I ∋ x} a_I ≤ C` everywhere gives
`Σ_I |I| a_I ≤ C |R|` (blueprint `eq:path`). -/
theorem integrated_cap_le (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (a : ℤ × ℤ → ℝ)
    (root : ℤ × ℤ) (hR : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G root.1 root.2)
    {C : ℝ} (hC : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), a I ≤ C) :
    ∑ I ∈ S, dyadicGridLength G I.1 * a I ≤ C * dyadicGridLength G root.1 := by
  set f : ℝ → ℝ := fun x => ∑ I ∈ S, (dyadicGridCell G I.1 I.2).indicator (fun _ => a I) x
  rw [dyadicPathIntegral_real G S _ (dyadicGridCell G root.1 root.2) hR]
  have hpt : ∀ x, f x ≤ C := by
    intro x
    have hfx : f x = ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), a I := by
      simp only [f, Finset.sum_filter, Set.indicator_apply]
    rw [hfx]; exact hC x
  have hint : IntegrableOn f (dyadicGridCell G root.1 root.2) := by
    refine integrable_finsetSum _ fun I hI => ?_
    apply (integrable_indicator_iff (dyadicGridCell_measurable G I.1 I.2)).mpr
    change Integrable _ ((volume.restrict _).restrict (dyadicGridCell G I.1 I.2))
    rw [Measure.restrict_restrict_of_subset (hR I hI)]
    exact integrableOn_const (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)
  calc ∫ x in dyadicGridCell G root.1 root.2, f x ≤ ∫ _x in dyadicGridCell G root.1 root.2, C :=
        setIntegral_mono_on hint (integrableOn_const (by
          rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top))
          (dyadicGridCell_measurable G root.1 root.2) fun x _ => hpt x
    _ = _ := by
        rw [setIntegral_const, smul_eq_mul, Measure.real, dyadicGridCell_volume,
          ENNReal.toReal_ofReal (dyadicGridLength_pos G root.1).le]
        ring

open Classical in
/-- Blueprint lines 2380-2381 (the transferred main term with restored complements): terms
bounded at each cell by `η a_I b_I` (pair-smallness and contractions, `a, b` the two normalized
side sizes) with path caps `Σ_{I ∋ x} a_I² ≤ C_a`, `Σ_{I ∋ x} b_I² ≤ C_b` have absolute
length-weighted sum at most `η √(C_a C_b) |R|`. -/
theorem pair_small_main_bound (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (a b t : ℤ × ℤ → ℝ)
    {η : ℝ} (hη : 0 ≤ η)
    (ht : ∀ I ∈ S, |t I| ≤ η * (a I * b I)) (root : ℤ × ℤ)
    (hR : ∀ I ∈ S, dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G root.1 root.2) {Ca Cb : ℝ}
    (hCa : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), a I ^ 2 ≤ Ca)
    (hCb : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell G I.1 I.2), b I ^ 2 ≤ Cb) :
    ∑ I ∈ S, dyadicGridLength G I.1 * |t I| ≤
      η * (Real.sqrt Ca * Real.sqrt Cb) * dyadicGridLength G root.1 := by
  have hL := fun I : ℤ × ℤ => (dyadicGridLength_pos G I.1).le
  have hLr := (dyadicGridLength_pos G root.1).le
  have hA := integrated_cap_le G S (fun I => a I ^ 2) root hR hCa
  have hB := integrated_cap_le G S (fun I => b I ^ 2) root hR hCb
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt S (fun I => Real.sqrt (dyadicGridLength G I.1) * a I)
    (fun I => Real.sqrt (dyadicGridLength G I.1) * b I)
  have hsq : ∀ I : ℤ × ℤ, (Real.sqrt (dyadicGridLength G I.1)) ^ 2 = dyadicGridLength G I.1 :=
    fun I => Real.sq_sqrt (hL I)
  simp only [mul_pow, hsq] at hcs
  have hab : ∑ I ∈ S, dyadicGridLength G I.1 * (a I * b I) ≤
      Real.sqrt (Ca * dyadicGridLength G root.1) * Real.sqrt (Cb * dyadicGridLength G root.1) := by
    have e : ∑ I ∈ S, dyadicGridLength G I.1 * (a I * b I) = ∑ I ∈ S,
        Real.sqrt (dyadicGridLength G I.1) * a I * (Real.sqrt (dyadicGridLength G I.1) * b I) := by
      refine Finset.sum_congr rfl fun I _ => ?_
      rw [show Real.sqrt (dyadicGridLength G I.1) * a I * (Real.sqrt (dyadicGridLength G I.1) * b I)
        = (Real.sqrt (dyadicGridLength G I.1)) ^ 2 * (a I * b I) by ring, hsq I]
    rw [e]
    exact hcs.trans (mul_le_mul (Real.sqrt_le_sqrt hA) (Real.sqrt_le_sqrt hB)
      (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
  have hCa0 : 0 ≤ Ca := (Finset.sum_nonneg fun _ _ => sq_nonneg _).trans (hCa 0)
  have hCb0 : 0 ≤ Cb := (Finset.sum_nonneg fun _ _ => sq_nonneg _).trans (hCb 0)
  have e2 : Real.sqrt (Ca * dyadicGridLength G root.1) * Real.sqrt (Cb * dyadicGridLength G root.1)
      = Real.sqrt Ca * Real.sqrt Cb * dyadicGridLength G root.1 := by
    rw [Real.sqrt_mul hCa0, Real.sqrt_mul hCb0,
      show Real.sqrt Ca * Real.sqrt (dyadicGridLength G root.1) *
        (Real.sqrt Cb * Real.sqrt (dyadicGridLength G root.1)) = Real.sqrt Ca * Real.sqrt Cb *
          (Real.sqrt (dyadicGridLength G root.1) * Real.sqrt (dyadicGridLength G root.1)) by ring,
      Real.mul_self_sqrt hLr]
  calc ∑ I ∈ S, dyadicGridLength G I.1 * |t I| ≤
      ∑ I ∈ S, dyadicGridLength G I.1 * (η * (a I * b I)) :=
        Finset.sum_le_sum fun I hI => mul_le_mul_of_nonneg_left (ht I hI) (hL I)
    _ = η * ∑ I ∈ S, dyadicGridLength G I.1 * (a I * b I) := by
        rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun I _ => by ring
    _ ≤ η * (Real.sqrt Ca * Real.sqrt Cb * dyadicGridLength G root.1) := by
        rw [← e2]; exact mul_le_mul_of_nonneg_left hab hη
    _ = _ := by ring

open Classical in
/-- Cells of one depth inside a cell have total length at most its length. -/
theorem sum_length_depth_le (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (J : ℤ × ℤ) (d : ℤ) :
    ∑ I ∈ S.filter (fun I => I.1 = d ∧
        dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2), dyadicGridLength G I.1 ≤
      dyadicGridLength G J.1 := by
  set T := S.filter (fun I => I.1 = d ∧ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2)
  have hdis : Set.PairwiseDisjoint (T : Set (ℤ × ℤ)) fun I => dyadicGridCell G I.1 I.2 :=
    cells_pairwiseDisjoint_of_depth G T fun I hI => (Finset.mem_filter.mp hI).2.1
  have hvol : volume (⋃ I ∈ T, dyadicGridCell G I.1 I.2) =
      ∑ I ∈ T, ENNReal.ofReal (dyadicGridLength G I.1) := by
    rw [measure_biUnion_finset hdis fun I _ => dyadicGridCell_measurable G I.1 I.2]
    exact Finset.sum_congr rfl fun I _ => dyadicGridCell_volume G I.1 I.2
  have hsub : (⋃ I ∈ T, dyadicGridCell G I.1 I.2) ⊆ dyadicGridCell G J.1 J.2 :=
    Set.iUnion₂_subset fun I hI => (Finset.mem_filter.mp hI).2.2
  have hle := measure_mono (μ := volume) hsub
  rw [hvol, dyadicGridCell_volume, ← ENNReal.ofReal_sum_of_nonneg fun I _ =>
    (dyadicGridLength_pos G I.1).le] at hle
  exact (ENNReal.ofReal_le_ofReal_iff (dyadicGridLength_pos G J.1).le).mp hle

open Classical in
/-- Blueprint lines 2388-2392 ("propagating the event through its block costs at most `K` in
integrated square energy"): a weight `w ≥ 0` on cells, propagated to all descendants in `S` at most
`K` depths below, has length-weighted sum at most `K` times the original one. -/
theorem flag_propagation_le (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (w : ℤ × ℤ → ℝ)
    (hw : ∀ J ∈ S, 0 ≤ w J) (K : ℕ) :
    ∑ I ∈ S, dyadicGridLength G I.1 * ∑ J ∈ S.filter (fun J =>
        dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 ∧ I.1 < J.1 + K), w J ≤
      K * ∑ J ∈ S, dyadicGridLength G J.1 * w J := by
  have hswap : ∑ I ∈ S, dyadicGridLength G I.1 * ∑ J ∈ S.filter (fun J =>
      dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 ∧ I.1 < J.1 + K), w J =
      ∑ J ∈ S, w J * ∑ I ∈ S.filter (fun I =>
        dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 ∧ I.1 < J.1 + K),
          dyadicGridLength G I.1 := by
    simp only [Finset.mul_sum, Finset.sum_filter]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun J _ => Finset.sum_congr rfl fun I _ => ?_
    split_ifs <;> ring
  rw [hswap, Finset.mul_sum]
  refine Finset.sum_le_sum fun J hJ => ?_
  -- descendants within `K` depths: at most `K` depths, each of total length at most `|J|`
  have hdesc : ∑ I ∈ S.filter (fun I => dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 ∧
      I.1 < J.1 + K), dyadicGridLength G I.1 ≤ K * dyadicGridLength G J.1 := by
    have hdepth : ∀ I ∈ S.filter (fun I => dyadicGridCell G I.1 I.2 ⊆
        dyadicGridCell G J.1 J.2 ∧ I.1 < J.1 + K),
        I.1 ∈ (Finset.range K).image (fun n : ℕ => J.1 + n) := by
      intro I hI
      obtain ⟨-, hsub, hlt⟩ := Finset.mem_filter.mp hI
      have hge := dyadicGridCell_depth_le_of_subset G I J hsub
      refine Finset.mem_image.mpr ⟨(I.1 - J.1).toNat, Finset.mem_range.mpr (by omega), by omega⟩
    rw [← Finset.sum_fiberwise_of_maps_to hdepth]
    calc ∑ d ∈ (Finset.range K).image (fun n : ℕ => J.1 + n), ∑ I ∈ (S.filter fun I =>
          dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2 ∧ I.1 < J.1 + K).filter
            (fun I => I.1 = d), dyadicGridLength G I.1 ≤
        ∑ _d ∈ (Finset.range K).image (fun n : ℕ => J.1 + n), dyadicGridLength G J.1 := by
          refine Finset.sum_le_sum fun d _ => le_trans ?_ (sum_length_depth_le G S J d)
          refine Finset.sum_le_sum_of_subset_of_nonneg (fun I hI => ?_)
            fun I _ _ => (dyadicGridLength_pos G I.1).le
          obtain ⟨hI1, hd⟩ := Finset.mem_filter.mp hI
          obtain ⟨hIS, hsub, -⟩ := Finset.mem_filter.mp hI1
          exact Finset.mem_filter.mpr ⟨hIS, hd, hsub⟩
      _ ≤ K * dyadicGridLength G J.1 := by
          have hcard : (((Finset.range K).image (fun n : ℕ => J.1 + n)).card : ℝ) ≤ K := by
            exact_mod_cast Finset.card_image_le.trans (Finset.card_range K).le
          rw [Finset.sum_const, nsmul_eq_mul]
          exact mul_le_mul_of_nonneg_right hcard (dyadicGridLength_pos G J.1).le
  calc w J * _ ≤ w J * (K * dyadicGridLength G J.1) := mul_le_mul_of_nonneg_left hdesc (hw J hJ)
    _ = K * (dyadicGridLength G J.1 * w J) := by ring

/-! ### Fixed stacks for the attempt histories (`eq:stack-energy`, blueprint lines 2394-2423) -/

section GlobalStacks

variable {V : Type*} [Fintype V]

theorem globHist_norm_le (Ψ : ColumnDepthFamily V) {P : ℕ} (hP : 0 < P)
    (Am : ℕ → Fin P → InheritedColumnMask Ψ.D) (ls : List (ℕ × Bool)) (h : ℤ) (z : ColumnL2 V) :
    ‖globHist Ψ Am ls h z‖ ≤ ‖z‖ := by
  unfold globHist
  refine norm_layerOp_apply_le _ (fun m x => ?_) (fun m x => ?_) _ _
  · exact norm_opAvg_apply_le _ (fun p y => starProjection_norm_apply_le _
      ((Ψ.withMask (Am m p)).isStarProjection_proj h) y) x
  · exact norm_id_sub_opAvg_apply_le hP _ (fun p y => norm_sub_starProjection_le _
      ((Ψ.withMask (Am m p)).isStarProjection_proj h) y) x

/-- Blueprint lines 2414-2420 (fixed linear side `V_{G,b}` under a subsequent averaged history
`T_s`): the base term and the outer bands over disjoint position intervals satisfy
`‖T_b V‖² + Σ_{[r,t]} ‖(T_t - T_r) V‖² ≤ (1 + |ls| Σ_m C_m²) ‖V‖²` (`lem:prefix` with pads
coupled and complements expanded, `globHist_jump`). -/
theorem globHist_stack_linear {ι : Type*} [Fintype ι] (Ψ : ColumnDepthFamily V) {P : ℕ}
    (hP : 0 < P) (Am : ℕ → Fin P → InheritedColumnMask Ψ.D) (ls : List (ℕ × Bool))
    (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i j, i ≠ j → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r j) (t j)))
    (b : ℤ) (Vv : ColumnL2 V) :
    ‖globHist Ψ Am ls b Vv‖ ^ 2 + ∑ i, ‖globHist Ψ Am ls (Ψ.D.root.1 + t i) Vv -
        globHist Ψ Am ls (Ψ.D.root.1 + r i) Vv‖ ^ 2 ≤
      (1 + ls.length * ∑ m ∈ Finset.range ls.length, compressionC Ψ.D m ^ 2) * ‖Vv‖ ^ 2 := by
  have h1 := pow_le_pow_left₀ (norm_nonneg _) (globHist_norm_le Ψ hP Am ls b Vv) 2
  have h2 := globHist_jump Ψ hP Am ls r t hrt hdis Vv
  nlinarith

end GlobalStacks

section RollingStacks

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Blueprint `eq:stack-energy` for a rolling side (lines 2420-2423) with any contraction history
`T_s` whose outer jumps on a fixed input are Bessel with constant `C_j`: with the inner
difference `Z_{r_i} - Z_u = Σ_k Y_{i,k}` and local fixed inputs `X_k`,
`Σ_i ‖E_i (W_{t_i} - W_{r_i})‖² ≤ 2 Σ_i ‖Z_{t_i} - Z_{r_i}‖² + 2 |s| C_j Σ_k ‖X_k‖²`,
`W_s = T_s (Z_s - Z_u)`. -/
theorem stack_energy_rolling_gen {ι κ : Type*} [Fintype ι] (s : Finset κ)
    (Tm : ℕ → H →L[ℂ] H) (hT : ∀ n y, ‖Tm n y‖ ≤ ‖y‖) (r t : ι → ℕ)
    (E : ι → H →L[ℂ] H) (hE : ∀ i y, ‖E i y‖ ≤ ‖y‖) (Z : ℕ → H) (u : ℕ)
    (Y : ι → κ → H) (hY : ∀ i, Z (r i) - Z u = ∑ k ∈ s, Y i k) (X : κ → H)
    (hloc : ∀ i, ∀ k ∈ s, E i (Tm (t i) (Y i k) - Tm (r i) (Y i k)) =
      E i (Tm (t i) (X k) - Tm (r i) (X k)))
    {Cj : ℝ} (hjump : ∀ x : H, ∑ i, ‖Tm (t i) x - Tm (r i) x‖ ^ 2 ≤ Cj * ‖x‖ ^ 2) :
    ∑ i, ‖E i (Tm (t i) (Z (t i) - Z u) - Tm (r i) (Z (r i) - Z u))‖ ^ 2 ≤
      2 * ∑ i, ‖Z (t i) - Z (r i)‖ ^ 2 + 2 * s.card * (Cj * ∑ k ∈ s, ‖X k‖ ^ 2) := by
  have hsplit : ∀ i, E i (Tm (t i) (Z (t i) - Z u) - Tm (r i) (Z (r i) - Z u)) =
      E i (Tm (t i) (Z (t i) - Z (r i))) + ∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k)) := by
    intro i
    rw [← Finset.sum_congr rfl (hloc i), ← map_sum, ← map_add]
    congr 1
    rw [Finset.sum_sub_distrib, ← map_sum, ← map_sum, ← hY i]
    simp only [map_sub]
    abel
  have hsq : ∀ i, ‖E i (Tm (t i) (Z (t i) - Z u) - Tm (r i) (Z (r i) - Z u))‖ ^ 2 ≤
      2 * ‖Z (t i) - Z (r i)‖ ^ 2 +
        2 * (s.card * ∑ k ∈ s, ‖Tm (t i) (X k) - Tm (r i) (X k)‖ ^ 2) := by
    intro i
    rw [hsplit i]
    have h1 := norm_add_le (E i (Tm (t i) (Z (t i) - Z (r i))))
      (∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k)))
    have hd : ‖E i (Tm (t i) (Z (t i) - Z (r i)))‖ ≤ ‖Z (t i) - Z (r i)‖ :=
      (hE i _).trans (hT _ _)
    have h2 : ‖∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k))‖ ^ 2 ≤
        s.card * ∑ k ∈ s, ‖Tm (t i) (X k) - Tm (r i) (X k)‖ ^ 2 := by
      refine (pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2).trans ?_
      refine sq_sum_le_card_mul_sum_sq.trans ?_
      gcongr with k hk
      exact hE i _
    have h0 := norm_nonneg (E i (Tm (t i) (Z (t i) - Z (r i))) +
      ∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k)))
    have hdn := norm_nonneg (E i (Tm (t i) (Z (t i) - Z (r i))))
    nlinarith [sq_nonneg (‖E i (Tm (t i) (Z (t i) - Z (r i)))‖ -
      ‖∑ k ∈ s, E i (Tm (t i) (X k) - Tm (r i) (X k))‖)]
  calc ∑ i, ‖E i (Tm (t i) (Z (t i) - Z u) - Tm (r i) (Z (r i) - Z u))‖ ^ 2
      ≤ ∑ i, (2 * ‖Z (t i) - Z (r i)‖ ^ 2 +
        2 * (s.card * ∑ k ∈ s, ‖Tm (t i) (X k) - Tm (r i) (X k)‖ ^ 2)) :=
        Finset.sum_le_sum fun i _ => hsq i
    _ = 2 * ∑ i, ‖Z (t i) - Z (r i)‖ ^ 2 + 2 * s.card *
        ∑ k ∈ s, ∑ i, ‖Tm (t i) (X k) - Tm (r i) (X k)‖ ^ 2 := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_comm]
        simp_rw [← Finset.mul_sum]; ring
    _ ≤ 2 * ∑ i, ‖Z (t i) - Z (r i)‖ ^ 2 + 2 * s.card * ∑ k ∈ s, Cj * ‖X k‖ ^ 2 := by
        have : (0 : ℝ) ≤ 2 * s.card := by positivity
        gcongr with k hk
        exact hjump (X k)
    _ = _ := by rw [Finset.mul_sum s (fun k => ‖X k‖ ^ 2) Cj]

end RollingStacks

/-- `stack_energy_rolling_gen` for the attempt's averaged histories (`globHist_jump`). -/
theorem globHist_stack_rolling {V ι κ : Type*} [Fintype V] [Fintype ι] (s : Finset κ)
    (Ψ : ColumnDepthFamily V) {P : ℕ} (hP : 0 < P) (Am : ℕ → Fin P → InheritedColumnMask Ψ.D)
    (ls : List (ℕ × Bool)) (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i j, i ≠ j → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r j) (t j)))
    (E : ι → ColumnL2 V →L[ℂ] ColumnL2 V) (hE : ∀ i y, ‖E i y‖ ≤ ‖y‖) (Z : ℕ → ColumnL2 V)
    (u : ℕ) (Y : ι → κ → ColumnL2 V) (hY : ∀ i, Z (r i) - Z u = ∑ k ∈ s, Y i k)
    (X : κ → ColumnL2 V)
    (hloc : ∀ i, ∀ k ∈ s, E i (globHist Ψ Am ls (Ψ.D.root.1 + t i) (Y i k) -
      globHist Ψ Am ls (Ψ.D.root.1 + r i) (Y i k)) = E i (globHist Ψ Am ls (Ψ.D.root.1 + t i)
        (X k) - globHist Ψ Am ls (Ψ.D.root.1 + r i) (X k))) :
    ∑ i, ‖E i (globHist Ψ Am ls (Ψ.D.root.1 + t i) (Z (t i) - Z u) -
        globHist Ψ Am ls (Ψ.D.root.1 + r i) (Z (r i) - Z u))‖ ^ 2 ≤
      2 * ∑ i, ‖Z (t i) - Z (r i)‖ ^ 2 + 2 * s.card *
        (ls.length * (∑ m ∈ Finset.range ls.length, compressionC Ψ.D m ^ 2) *
          ∑ k ∈ s, ‖X k‖ ^ 2) := by
  have h := stack_energy_rolling_gen s (fun n => globHist Ψ Am ls (Ψ.D.root.1 + n))
    (fun n y => globHist_norm_le Ψ hP Am ls _ y) r t E hE Z u Y hY X hloc
    (Cj := ls.length * ∑ m ∈ Finset.range ls.length, compressionC Ψ.D m ^ 2)
    (fun x => globHist_jump Ψ hP Am ls r t hrt hdis x)
  exact h

/-! ### Rademacher randomization of the stacks (blueprint lines 2421-2423) -/

section Randomization

/-- The sign patterns on a finite set. -/
abbrev SignPattern {ι : Type*} (s : Finset ι) := {u // u ∈ s.powerset}

instance {ι : Type*} (s : Finset ι) : MeasurableSpace (SignPattern s) := ⊤

instance {ι : Type*} (s : Finset ι) : MeasurableSingletonClass (SignPattern s) :=
  ⟨fun _ => MeasurableSpace.measurableSet_top⟩

theorem card_signPattern {ι : Type*} (s : Finset ι) :
    Fintype.card (SignPattern s) = 2 ^ s.card := by
  rw [Fintype.card_coe, Finset.card_powerset]

/-- The uniform probability on sign patterns. -/
noncomputable def signMeasure {ι : Type*} (s : Finset ι) : Measure (SignPattern s) :=
  (2 ^ s.card : ℝ≥0∞)⁻¹ • Measure.count

theorem lintegral_signMeasure {ι : Type*} (s : Finset ι) (f : SignPattern s → ℝ≥0∞) :
    ∫⁻ σ, f σ ∂(signMeasure s) = (2 ^ s.card : ℝ≥0∞)⁻¹ * ∑ σ, f σ := by
  unfold signMeasure
  rw [lintegral_smul_measure, lintegral_count, tsum_fintype, smul_eq_mul]

instance {ι : Type*} (s : Finset ι) : IsProbabilityMeasure (signMeasure s) := by
  constructor
  have h := lintegral_signMeasure s (fun _ => 1)
  rw [lintegral_one, Finset.sum_const, Finset.card_univ, card_signPattern, nsmul_eq_mul,
    mul_one] at h
  rw [h]
  push_cast
  exact ENNReal.inv_mul_cancel (by positivity) (by simp)

/-- Blueprint lines 2421-2423 ("two applications of Khintchine give the pointwise moment hypothesis
in `lem:shortblock`"), one sign family: the randomized scalar `Σ_i ε_i x_i(y)` has fourth moment
at most `4 (Σ_i |x_i(y)|²)^{1/2}`, the norm of the deterministic position vector. -/
theorem rademacher_moment_hyp {ι : Type*} [DecidableEq ι] (s : Finset ι) (x : ι → ℝ → ℂ)
    (y : ℝ) :
    (∫⁻ σ, ‖rademacherSum s σ.1 (fun i => x i y)‖ₑ ^ (4 : ℝ) ∂(signMeasure s)) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal 4 * ENNReal.ofReal (Real.sqrt (∑ i ∈ s, ‖x i y‖ ^ 2)) := by
  rw [lintegral_signMeasure]
  have hmean : (2 ^ s.card : ℝ≥0∞)⁻¹ * ∑ σ : SignPattern s,
      ‖rademacherSum s σ.1 (fun i => x i y)‖ₑ ^ (4 : ℝ) =
      ENNReal.ofReal (rademacherMean s fun u =>
        ‖rademacherSum s u (fun i => x i y)‖ ^ (4 : ℝ)) := by
    unfold rademacherMean
    rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_inv_of_pos (by positivity),
      ENNReal.ofReal_sum_of_nonneg fun _ _ => by positivity]
    congr 1
    · norm_num
    · rw [← Finset.sum_coe_sort s.powerset]
      refine Finset.sum_congr rfl fun σ _ => ?_
      rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]
  rw [hmean, ENNReal.ofReal_rpow_of_nonneg (by
    unfold rademacherMean; positivity) (by norm_num), ← ENNReal.ofReal_mul (by norm_num)]
  refine ENNReal.ofReal_le_ofReal ?_
  have h := signs_moment_bound s (fun i => x i y) (p := 4) (by norm_num)
  refine h.trans (le_of_eq ?_)
  rw [show Real.sqrt 4 = 2 by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]]
  ring

end Randomization

/-! ### Joint hull caps for the two stacks (blueprint lines 2425-2433) -/

theorem dyadicHullMax_mono (G : RealDyadicGrid) {S T : Finset (ℤ × ℤ)} (hST : S ⊆ T)
    (g : ℝ → ℝ≥0∞) (x : ℝ) : dyadicHullMax G S g x ≤ dyadicHullMax G T g x := by
  unfold dyadicHullMax
  exact Finset.sup_mono hST

open Classical in
/-- Blueprint lines 2428-2431 ("apply the hull part of `lem:cuts` to the two energies in
`eq:stack-energy` ... combine these cuts"): two families of fixed functions with total square
energies `E_a |R|`, `E_b |R|` on hulls of total support `M |R|` admit one family of cut
cells of total length at most `ρ |R|` after which the squared hull maxima on the retained hulls
have the joint caps `C_{ρ/2} E_a (1 + log(2+M))` and `C_{ρ/2} E_b (1 + log(2+M))` everywhere. -/
theorem two_hull_caps {ι F : Type*} [NormedAddCommGroup F] (V : Finset ι) (G : RealDyadicGrid)
    (S : Finset (ℤ × ℤ)) (H : ι → Finset (ℤ × ℤ)) (fa fb : ι → ℝ → F)
    (hfa : ∀ ν ∈ V, AEStronglyMeasurable (fa ν) volume)
    (hfb : ∀ ν ∈ V, AEStronglyMeasurable (fb ν) volume)
    (root : ℤ × ℤ) (hHS : ∀ ν ∈ V, H ν ⊆ S)
    (hS : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    {Ea Eb M ρ : ℝ} (hEa : 0 ≤ Ea) (hEb : 0 ≤ Eb) (hM0 : 0 ≤ M) (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hea : ∑ ν ∈ V, eLpNorm (fa ν) 2 volume ^ (2 : ℕ) ≤
      ENNReal.ofReal (Ea * dyadicGridLength G root.1))
    (heb : ∑ ν ∈ V, eLpNorm (fb ν) 2 volume ^ (2 : ℕ) ≤
      ENNReal.ofReal (Eb * dyadicGridLength G root.1))
    (hM : ∑ ν ∈ V, volume (⋃ c ∈ maximalDyadicCells G (H ν),
      dyadicGridCell G c.1 c.2) ≤ ENNReal.ofReal (M * dyadicGridLength G root.1)) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ S ∧
      dyadicRootLength G (maximalDyadicCells G C) ≤ ρ * dyadicGridLength G root.1 ∧
      (∀ x : ℝ, ∑ ν ∈ V, dyadicHullMax G
        ((H ν).filter (fun c => ¬∃ d ∈ C,
          dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)) (fun y => ‖fa ν y‖ₑ ^ (2 : ℕ)) x ≤
        ENNReal.ofReal (hullCutConstant (ρ / 2) * Ea * (1 + Real.log (2 + M)))) ∧
      ∀ x : ℝ, ∑ ν ∈ V, dyadicHullMax G
        ((H ν).filter (fun c => ¬∃ d ∈ C,
          dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2)) (fun y => ‖fb ν y‖ₑ ^ (2 : ℕ)) x ≤
        ENNReal.ofReal (hullCutConstant (ρ / 2) * Eb * (1 + Real.log (2 + M))) := by
  obtain ⟨Ca, hCaS, -, hCa, hcapa⟩ := dyadicHullFirstCrossingCuts_L2 V G S H fa hfa root hHS hS
    hEa hM0 (half_pos hρ) (by linarith) hea hM
  obtain ⟨Cb, hCbS, -, hCb, hcapb⟩ := dyadicHullFirstCrossingCuts_L2 V G S H fb hfb root hHS hS
    hEb hM0 (half_pos hρ) (by linarith) heb hM
  refine ⟨Ca ∪ Cb, Finset.union_subset hCaS hCbS, ?_, fun x => ?_, fun x => ?_⟩
  · have h := exceptional_roots_le G (Finset.univ : Finset Bool) (fun v => if v then Ca else Cb)
      (fun _ => ρ / 2) root (fun v _ => by cases v <;> simpa using (by assumption)) (ρ := ρ)
      (by simp; ring_nf; rfl)
    have hU : (Finset.univ : Finset Bool).biUnion (fun v => if v then Ca else Cb) = Ca ∪ Cb := by
      ext c; simp
    rwa [hU] at h
  · refine le_trans (Finset.sum_le_sum fun ν _ => dyadicHullMax_mono G ?_ _ x) (hcapa x)
    intro c hc
    obtain ⟨hcH, hno⟩ := Finset.mem_filter.mp hc
    exact Finset.mem_filter.mpr ⟨hcH, fun ⟨d, hd, hcd⟩ =>
      hno ⟨d, Finset.mem_union_left _ hd, hcd⟩⟩
  · refine le_trans (Finset.sum_le_sum fun ν _ => dyadicHullMax_mono G ?_ _ x) (hcapb x)
    intro c hc
    obtain ⟨hcH, hno⟩ := Finset.mem_filter.mp hc
    exact Finset.mem_filter.mpr ⟨hcH, fun ⟨d, hd, hcd⟩ =>
      hno ⟨d, Finset.mem_union_right _ hd, hcd⟩⟩

/-! ### The coupled-band estimate (`eq:near-band`, blueprint lines 2433-2445) -/

theorem energyAverage_le_hullMax (G : RealDyadicGrid) {S : Finset (ℤ × ℤ)} {c : ℤ × ℤ}
    (hc : c ∈ S) (g : ℝ → ℝ≥0∞) {x : ℝ} (hx : x ∈ dyadicGridCell G c.1 c.2) :
    dyadicEnergyAverage G g c ≤ dyadicHullMax G S g x := by
  classical
  unfold dyadicHullMax
  refine le_trans (le_of_eq ?_) (Finset.le_sup (f := fun c => (dyadicGridCell G c.1 c.2).indicator
    (fun _ => dyadicEnergyAverage G g c) x) hc)
  rw [Set.indicator_of_mem hx]

/-- Blueprint lines 2433-2445 (`eq:near-band`): for each index `ν`, sparse pieces `Q` lying in
the retained hull `H_ν`, with disjoint remainders `E_Q ⊆ Q ∩ R` of length at least `7|Q|/8`, and
terms bounded by `C |Q| a_Q b_Q` with the root sizes `a_Q² = ⨍_Q g_a`, `b_Q² = ⨍_Q g_b` (from
`lem:shortblock` on the pieces), sum to at most `(8/7) C √(AB) |R|` when the hull maxima have the
joint caps `Σ_ν m_{a,ν} ≤ A`, `Σ_ν m_{b,ν} ≤ B` on `R`. -/
theorem near_band_estimate (G : RealDyadicGrid) {N : Type*} (Ns : Finset N)
    (Hs : N → Finset (ℤ × ℤ)) (Qs : N → Finset (ℤ × ℤ)) (hQH : ∀ ν ∈ Ns, Qs ν ⊆ Hs ν)
    (E : N → ℤ × ℤ → Set ℝ) (hEm : ∀ ν Q, MeasurableSet (E ν Q)) {R : Set ℝ}
    (hRm : MeasurableSet R)
    (hdis : ∀ ν ∈ Ns, (Qs ν : Set (ℤ × ℤ)).PairwiseDisjoint (E ν))
    (hEQ : ∀ ν ∈ Ns, ∀ Q ∈ Qs ν, E ν Q ⊆ dyadicGridCell G Q.1 Q.2 ∩ R)
    (hvol : ∀ ν ∈ Ns, ∀ Q ∈ Qs ν, 7 * ENNReal.ofReal (dyadicGridLength G Q.1) ≤ 8 * volume (E ν Q))
    (ga gb : N → ℝ → ℝ≥0∞) {A B : ℝ≥0∞}
    (hA : ∀ x ∈ R, ∑ ν ∈ Ns, dyadicHullMax G (Hs ν) (ga ν) x ≤ A)
    (hB : ∀ x ∈ R, ∑ ν ∈ Ns, dyadicHullMax G (Hs ν) (gb ν) x ≤ B)
    (term : N → ℤ × ℤ → ℝ≥0∞) (C : ℝ≥0∞)
    (hterm : ∀ ν ∈ Ns, ∀ Q ∈ Qs ν, term ν Q ≤ C * (ENNReal.ofReal (dyadicGridLength G Q.1) *
      ((dyadicEnergyAverage G (ga ν) Q) ^ (1 / 2 : ℝ) *
        (dyadicEnergyAverage G (gb ν) Q) ^ (1 / 2 : ℝ)))) :
    7 * ∑ ν ∈ Ns, ∑ Q ∈ Qs ν, term ν Q ≤ 8 * C * ((A * B) ^ (1 / 2 : ℝ) * volume R) := by
  classical
  -- index the pieces by pairs to separate the families
  set Qs' : N → Finset (N × (ℤ × ℤ)) := fun ν => (Qs ν).map ⟨fun Q => (ν, Q), fun _ _ h =>
    (Prod.ext_iff.mp h).2⟩
  have hsum : ∀ (f : N × (ℤ × ℤ) → ℝ≥0∞), ∑ ν ∈ Ns, ∑ q ∈ Qs' ν, f q =
      ∑ ν ∈ Ns, ∑ Q ∈ Qs ν, f (ν, Q) := fun f =>
    Finset.sum_congr rfl fun ν _ => Finset.sum_map _ _ _
  have h := near_band_total Ns Qs' (fun q => ENNReal.ofReal (dyadicGridLength G q.2.1))
    (fun q => (dyadicEnergyAverage G (ga q.1) q.2) ^ (1 / 2 : ℝ))
    (fun q => (dyadicEnergyAverage G (gb q.1) q.2) ^ (1 / 2 : ℝ)) (fun q => E q.1 q.2)
    (fun q => hEm q.1 q.2) hRm ?_ ?_ ?_ (fun ν x => dyadicHullMax G (Hs ν) (ga ν) x)
    (fun ν x => dyadicHullMax G (Hs ν) (gb ν) x) ?_ hA hB (fun q => term q.1 q.2) C ?_
  · rwa [hsum] at h
  · intro ν hν q₁ hq₁ q₂ hq₂ hne
    obtain ⟨Q₁, hQ₁, rfl⟩ := Finset.mem_map.mp hq₁
    obtain ⟨Q₂, hQ₂, rfl⟩ := Finset.mem_map.mp hq₂
    exact hdis ν hν hQ₁ hQ₂ fun h => hne (by subst h; rfl)
  · intro ν hν q hq
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_map.mp hq
    exact (hEQ ν hν Q hQ).trans Set.inter_subset_right
  · intro ν hν q hq
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_map.mp hq
    exact hvol ν hν Q hQ
  · intro ν hν q hq x hx
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_map.mp hq
    have hxQ := ((hEQ ν hν Q hQ) hx).1
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
    exact mul_le_mul' (ENNReal.rpow_le_rpow (energyAverage_le_hullMax G (hQH ν hν hQ) _ hxQ)
      (by norm_num)) (ENNReal.rpow_le_rpow (energyAverage_le_hullMax G (hQH ν hν hQ) _ hxQ)
      (by norm_num))
  · intro ν hν q hq
    obtain ⟨Q, hQ, rfl⟩ := Finset.mem_map.mp hq
    exact hterm ν hν Q hQ

/-! ### Sparse pieces as short-block trees (blueprint lines 2433-2437) -/

section PieceTree

variable (G : RealDyadicGrid)

/-- The internal cells of a piece: the root and all cells between it and the summation cells. -/
noncomputable def pieceInternal (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ)) : Finset (ℤ × ℤ) :=
  insert Q (C.biUnion fun c =>
    (Finset.range ((c.1 - Q.1).toNat + 1)).image fun n : ℕ => ancAt G c (Q.1 + n))

open Classical in
/-- The leaves of a piece: children of internal cells that are not internal. -/
noncomputable def pieceLeaves (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ)) : Finset (ℤ × ℤ) :=
  ((pieceInternal G Q C).biUnion (dyadicChildren G)).filter fun d => d ∉ pieceInternal G Q C

variable {G}

theorem mem_pieceInternal {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)}
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {d : ℤ × ℤ} :
    d ∈ pieceInternal G Q C ↔ d = Q ∨ ∃ c ∈ C, dyadicGridCell G c.1 c.2 ⊆
      dyadicGridCell G d.1 d.2 ∧ dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G Q.1 Q.2 := by
  unfold pieceInternal
  simp only [Finset.mem_insert, Finset.mem_biUnion, Finset.mem_image, Finset.mem_range]
  refine or_congr Iff.rfl ⟨?_, ?_⟩
  · rintro ⟨c, hc, n, hn, rfl⟩
    have hQc := dyadicGridCell_depth_le_of_subset G c Q (hC c hc)
    refine ⟨c, hc, subset_ancAt G c (by omega), ancAt_subset (hC c hc) (by omega)⟩
  · rintro ⟨c, hc, hcd, hdQ⟩
    have h1 := dyadicGridCell_depth_le_of_subset G c d hcd
    have h2 := dyadicGridCell_depth_le_of_subset G d Q hdQ
    refine ⟨c, hc, (d.1 - Q.1).toNat, by omega, ?_⟩
    have he : Q.1 + ((d.1 - Q.1).toNat : ℤ) = d.1 := by omega
    rw [he]
    exact ancAt_eq_of_subset hcd

/-- Internal cells are closed under ancestors below the root. -/
theorem pieceInternal_anc {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)}
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {d e : ℤ × ℤ}
    (hd : d ∈ pieceInternal G Q C) (hde : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G e.1 e.2)
    (heQ : dyadicGridCell G e.1 e.2 ⊆ dyadicGridCell G Q.1 Q.2) : e ∈ pieceInternal G Q C := by
  rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, hc, hcd, -⟩
  · -- `e` contains the root and lies inside it
    have h1 := dyadicGridCell_depth_le_of_subset G d e hde
    have h2 := dyadicGridCell_depth_le_of_subset G e d heQ
    have : e = d := dyadicGridCell_eq_of_meet G (by omega)
      ⟨_, dyadicGridCell_left_mem G e.1 e.2, heQ (dyadicGridCell_left_mem G e.1 e.2)⟩
    rw [this]; exact Finset.mem_insert_self _ _
  · exact (mem_pieceInternal hC).mpr (Or.inr ⟨c, hc, hcd.trans hde, heQ⟩)

theorem pieceInternal_sub {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)}
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {d : ℤ × ℤ}
    (hd : d ∈ pieceInternal G Q C) : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G Q.1 Q.2 := by
  rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, -, -, hdQ⟩
  · exact subset_rfl
  · exact hdQ

end PieceTree

section PieceTree2

variable {G : RealDyadicGrid}

theorem mem_pieceLeaves {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)} {L : ℤ × ℤ} :
    L ∈ pieceLeaves G Q C ↔ L ∉ pieceInternal G Q C ∧
      ∃ d ∈ pieceInternal G Q C, L ∈ dyadicChildren G d := by
  classical
  unfold pieceLeaves
  rw [Finset.mem_filter, Finset.mem_biUnion]
  tauto

/-- Blueprint lines 2433-2437 ("complete pieces by children immediately below their included
cells, including missing branches ... each piece has at most `K` internal depths and leaves at
most one step below"): a root `Q` with summation cells `C` inside it, at most `K` depths below,
forms a short-block tree. -/
noncomputable def pieceTree (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ))
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {K : ℕ} (hK : 1 ≤ K)
    (hdepth : ∀ c ∈ C, c.1 < Q.1 + K) : ShortBlockTree G K where
  root := Q
  first := Q.1
  internal := pieceInternal G Q C
  leaves := pieceLeaves G Q C
  internal_depth := by
    intro d hd
    rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, hc, hcd, hdQ⟩
    · constructor <;> omega
    · have h1 := dyadicGridCell_depth_le_of_subset G c d hcd
      have h2 := dyadicGridCell_depth_le_of_subset G d Q hdQ
      have h3 := hdepth c hc
      constructor <;> omega
  leaf_depth := by
    intro L hL
    obtain ⟨-, d, hd, hLd⟩ := mem_pieceLeaves.mp hL
    have h0 := dyadicChildren_depth G d L hLd
    rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, hc, hcd, hdQ⟩
    · constructor <;> omega
    · have h1 := dyadicGridCell_depth_le_of_subset G c d hcd
      have h2 := dyadicGridCell_depth_le_of_subset G d Q hdQ
      have h3 := hdepth c hc
      constructor <;> omega
  internal_subset := fun d hd => pieceInternal_sub hC hd
  leaf_subset := by
    intro L hL
    obtain ⟨-, d, hd, hLd⟩ := mem_pieceLeaves.mp hL
    exact (dyadicChildren_subset G d L hLd).trans (pieceInternal_sub hC hd)
  leaf_disjoint := by
    intro L hL L' hL' hne
    rw [Function.onFun, Set.disjoint_iff_inter_eq_empty]
    by_contra hmeet
    have hm : (dyadicGridCell G L.1 L.2 ∩ dyadicGridCell G L'.1 L'.2).Nonempty :=
      Set.nonempty_iff_ne_empty.mpr hmeet
    obtain ⟨hLI, d, hd, hLd⟩ := mem_pieceLeaves.mp hL
    obtain ⟨hLI', d', hd', hLd'⟩ := mem_pieceLeaves.mp hL'
    have hdQ := pieceInternal_sub hC hd
    have hdQ' := pieceInternal_sub hC hd'
    have e1 := dyadicChildren_depth G d L hLd
    have e2 := dyadicChildren_depth G d' L' hLd'
    rcases lt_trichotomy L.1 L'.1 with h | h | h
    · -- `L' ⊊ L`: `L` contains the parent `d'` of `L'`, so `L` is internal
      have hsub := dyadicGridCell_nested_of_meet G h.le hm
      have hdL : dyadicGridCell G d'.1 d'.2 ⊆ dyadicGridCell G L.1 L.2 :=
        dyadicGridCell_subset_of_common G (dyadicChildren_subset G d' L' hLd') hsub (by omega)
      exact hLI (pieceInternal_anc hC hd' hdL ((dyadicChildren_subset G d L hLd).trans hdQ))
    · exact hne (dyadicGridCell_eq_of_meet G h hm)
    · have hm' : (dyadicGridCell G L'.1 L'.2 ∩ dyadicGridCell G L.1 L.2).Nonempty := by
        rwa [Set.inter_comm] at hm
      have hsub := dyadicGridCell_nested_of_meet G h.le hm'
      have hdL : dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G L'.1 L'.2 :=
        dyadicGridCell_subset_of_common G (dyadicChildren_subset G d L hLd) hsub (by omega)
      exact hLI' (pieceInternal_anc hC hd hdL ((dyadicChildren_subset G d' L' hLd').trans hdQ'))
  leaf_cover := by
    classical
    intro x hx
    set T := (pieceInternal G Q C).filter fun d => x ∈ dyadicGridCell G d.1 d.2
    have hT : T.Nonempty := ⟨Q, Finset.mem_filter.mpr ⟨Finset.mem_insert_self _ _, hx⟩⟩
    obtain ⟨d, hdT, hmax⟩ := T.exists_max_image Prod.fst hT
    obtain ⟨hd, hxd⟩ := Finset.mem_filter.mp hdT
    obtain ⟨L, hLd, hxL⟩ := dyadicChildren_cover G d hxd
    refine Set.mem_iUnion₂.mpr ⟨L, mem_pieceLeaves.mpr ⟨fun hLI => ?_, d, hd, hLd⟩, hxL⟩
    have := hmax L (Finset.mem_filter.mpr ⟨hLI, hxL⟩)
    have := dyadicChildren_depth G d L hLd
    omega
  internal_leaf := by
    intro d hd L hL hmeet
    obtain ⟨hLI, p, hp, hLp⟩ := mem_pieceLeaves.mp hL
    by_contra hle
    push Not at hle
    have hsub := dyadicGridCell_nested_of_meet G hle (by rwa [Set.inter_comm] at hmeet)
    exact hLI (pieceInternal_anc hC hd hsub
      ((dyadicChildren_subset G p L hLp).trans (pieceInternal_sub hC hp)))

theorem pieceTree_internal_sup {Q : ℤ × ℤ} {C : Finset (ℤ × ℤ)}
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) {K : ℕ} (hK : 1 ≤ K)
    (hdepth : ∀ c ∈ C, c.1 < Q.1 + K) : C ⊆ (pieceTree Q C hC hK hdepth).internal := by
  intro c hc
  exact (mem_pieceInternal hC).mpr (Or.inr ⟨c, hc, subset_rfl, hC c hc⟩)

end PieceTree2

/-- Blueprint line 2436 ("a child's squared average is at most twice its parent's"):
`∫_L g ≤ 2 |L| ⨍_p g` for a child `L` of `p`. -/
theorem child_lintegral_le (G : RealDyadicGrid) {p L : ℤ × ℤ} (hL : L ∈ dyadicChildren G p)
    (g : ℝ → ℝ≥0∞) :
    ∫⁻ x in dyadicGridCell G L.1 L.2, g x ≤
      2 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G g p := by
  have hd := dyadicChildren_depth G p L hL
  have hlen : dyadicGridLength G p.1 = 2 * dyadicGridLength G L.1 := by
    rw [hd, ← dyadicGridLength_half G p.1]; ring
  have hp := dyadicGridLength_pos G p.1
  have hpne : ENNReal.ofReal (dyadicGridLength G p.1) ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp
  calc ∫⁻ x in dyadicGridCell G L.1 L.2, g x ≤ ∫⁻ x in dyadicGridCell G p.1 p.2, g x :=
        lintegral_mono_set (dyadicChildren_subset G p L hL)
    _ = ENNReal.ofReal (dyadicGridLength G p.1) * dyadicEnergyAverage G g p := by
        unfold dyadicEnergyAverage
        rw [ENNReal.mul_div_cancel hpne ENNReal.ofReal_ne_top]
    _ = 2 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G g p := by
        rw [hlen, ENNReal.ofReal_mul (by norm_num)]
        norm_num

/-- Blueprint lines 2445-2449 (exported side estimate in the active-cell minimum): with
`|H_I| ≤ x_I + y_I`, the power-cost part `x_I ≥ 0` (after the group sum) and the absolute part
`y_I ≥ 0`, `Σ_I |I| min(η, |H_I|) ≤ η^{1-p} Σ_I |I| x_I^p + Σ_I |I| y_I` (`eq:min-power` and
subadditivity of the minimum). -/
theorem min_power_split {ι : Type*} (S : Finset ι) (len x y h : ι → ℝ) (hlen : ∀ I ∈ S, 0 ≤ len I)
    (hx : ∀ I ∈ S, 0 ≤ x I) (hy : ∀ I ∈ S, 0 ≤ y I) (hh : ∀ I ∈ S, |h I| ≤ x I + y I) {η p : ℝ}
    (hη : 0 ≤ η) (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    ∑ I ∈ S, len I * min η |h I| ≤
      η ^ (1 - p) * ∑ I ∈ S, len I * x I ^ p + ∑ I ∈ S, len I * y I := by
  rw [Finset.mul_sum, ← Finset.sum_add_distrib]
  refine Finset.sum_le_sum fun I hI => ?_
  have h1 : min η |h I| ≤ min η (x I) + y I := by
    rcases le_total η (x I) with hle | hle
    · rw [min_eq_left hle]
      exact (min_le_left _ _).trans (by linarith [hy I hI])
    · rw [min_eq_right hle]
      exact (min_le_right _ _).trans (hh I hI)
  have h2 := min_le_rpow_mul hη (hx I hI) hp0 hp1
  have hl := hlen I hI
  calc len I * min η |h I| ≤ len I * (η ^ (1 - p) * x I ^ p + y I) :=
        mul_le_mul_of_nonneg_left (h1.trans (by linarith)) hl
    _ = η ^ (1 - p) * (len I * x I ^ p) + len I * y I := by ring

/-! ### Exact common-height selection (common-height, blueprint lines 2464-2476) -/

/-- Blueprint lines 2466-2467 ("the first-success rule has total weight exactly one for every
tuple, hence gives an exact identity in expectation for the finite multilinear expansion"): for a
finite family of tuples `τ` with one-trial success proportions `p_τ ∈ (0, 1]`, the expansion
`Σ_τ F_τ` is the sum over trial counts `n` of `Σ_τ (1 - p_τ)^n p_τ F_τ`. -/
theorem first_success_identity {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] (T : Finset ι) (pr : ι → ℝ) (hp0 : ∀ τ ∈ T, 0 < pr τ)
    (hp1 : ∀ τ ∈ T, pr τ ≤ 1) (F : ι → E) :
    HasSum (fun n : ℕ => ∑ τ ∈ T, ((1 - pr τ) ^ n * pr τ) • F τ) (∑ τ ∈ T, F τ) := by
  have h : ∀ τ ∈ T, HasSum (fun n : ℕ => ((1 - pr τ) ^ n * pr τ) • F τ) (F τ) := by
    intro τ hτ
    have := (first_success_weights_sum (hp0 τ hτ) (hp1 τ hτ)).smul_const (F τ)
    simpa only [one_smul] using this
  exact hasSum_sum h

/-- Blueprint line 2466 ("success probability is at least `1 - 2 m₀ δ_*`"): if each of `m₀` roles
has bad proportion at most `2δ` among the sampled heights, the one-trial success proportion of a
tuple is at least `1 - 2 m₀ δ`, positive when `2 m₀ δ < 1`. -/
theorem success_proportion_pos {α : Type*} [DecidableEq α] (H : Finset α) (hH : H.Nonempty)
    {m₀ : ℕ} (bad : Fin m₀ → Finset α) {δ : ℝ}
    (hbad : ∀ j, ((bad j ∩ H).card : ℝ) ≤ 2 * δ * H.card) (hδ : 2 * m₀ * δ < 1) :
    0 < ((H.filter fun h => ∀ j, h ∉ bad j).card : ℝ) / H.card := by
  have hc : (0 : ℝ) < H.card := by exact_mod_cast hH.card_pos
  have h := all_good_proportion H bad hbad
  apply div_pos _ hc
  have : 0 < (1 - m₀ * (2 * δ)) * H.card := mul_pos (by linarith) hc
  linarith

/-! ### Torus norms (frequency-tests, `eq:torus-size`, blueprint lines 2482-2495) -/

open Classical in
/-- Blueprint lines 2487-2490 (cell averages against Haar norms): for a trigonometric sum
`g(t) = Σ_k c_k e^{i φ_k t}` on the normalized cell `[0,1]` whose frequency differences are tiny
(`|φ_k - φ_{k'}| ≤ ε`) on the related pairs and huge (`|φ_k - φ_{k'}| ≥ 2/ε`) otherwise, the cell
average of `|g|²` differs from the coset sum `Σ_{k ~ k'} c_k c̄_{k'}` (its Haar norm on the
annihilator torus) by at most `ε (Σ_k |c_k|)²`. -/
theorem cell_average_close {ι : Type*} (F : Finset ι) (c : ι → ℂ) (φ : ι → ℝ)
    (rel : ι → ι → Prop) {ε : ℝ} (hε : 0 < ε)
    (htiny : ∀ k ∈ F, ∀ k' ∈ F, rel k k' → |φ k - φ k'| ≤ ε)
    (hhuge : ∀ k ∈ F, ∀ k' ∈ F, ¬ rel k k' → 2 / ε ≤ |φ k - φ k'|) :
    ‖(∫ t in (0 : ℝ)..1, ∑ k ∈ F, ∑ k' ∈ F, c k * starRingEnd ℂ (c k') *
        Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))) -
      ∑ k ∈ F, ∑ k' ∈ F, (if rel k k' then c k * starRingEnd ℂ (c k') else 0)‖ ≤
      ε * (∑ k ∈ F, ‖c k‖) ^ 2 := by
  have hint : ∀ k k', IntervalIntegrable (fun t : ℝ => c k * starRingEnd ℂ (c k') *
      Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))) volume 0 1 := fun k k' =>
    (by fun_prop : Continuous fun t : ℝ => c k * starRingEnd ℂ (c k') *
      Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))).intervalIntegrable _ _
  have hI : (∫ t in (0 : ℝ)..1, ∑ k ∈ F, ∑ k' ∈ F, c k * starRingEnd ℂ (c k') *
      Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))) = ∑ k ∈ F, ∑ k' ∈ F,
        ∫ t in (0 : ℝ)..1, c k * starRingEnd ℂ (c k') *
          Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ)) := by
    rw [intervalIntegral.integral_finsetSum fun k _ =>
      (continuous_finsetSum _ fun k' _ => (by fun_prop : Continuous fun t : ℝ =>
        c k * starRingEnd ℂ (c k') * Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ)))
        ).intervalIntegrable _ _]
    exact Finset.sum_congr rfl fun k _ =>
      intervalIntegral.integral_finsetSum fun k' _ => hint k k'
  rw [hI]
  rw [← Finset.sum_sub_distrib]
  simp_rw [← Finset.sum_sub_distrib]
  have hterm : ∀ k ∈ F, ∀ k' ∈ F,
      ‖(∫ t in (0 : ℝ)..1, c k * starRingEnd ℂ (c k') *
        Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))) -
        (if rel k k' then c k * starRingEnd ℂ (c k') else 0)‖ ≤ ε * (‖c k‖ * ‖c k'‖) := by
    intro k hk k' hk'
    rw [intervalIntegral.integral_const_mul]
    have hcc : ‖c k * starRingEnd ℂ (c k')‖ = ‖c k‖ * ‖c k'‖ := by
      rw [norm_mul, RCLike.norm_conj]
    split_ifs with hr
    · rw [← mul_sub_one, norm_mul, hcc, mul_comm]
      refine mul_le_mul_of_nonneg_right ((character_average_tiny _).trans (htiny k hk k' hk' hr))
        (by positivity)
    · rw [sub_zero, norm_mul, hcc, mul_comm]
      refine mul_le_mul_of_nonneg_right ?_ (by positivity)
      have hh := hhuge k hk k' hk' hr
      have hne : φ k - φ k' ≠ 0 := by
