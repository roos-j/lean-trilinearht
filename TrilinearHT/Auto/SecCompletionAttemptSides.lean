      rw [Finset.sum_sigma', Finset.sum_sigma']
      refine Finset.sum_bij' (fun x _ => ⟨x.2, x.1⟩) (fun x _ => ⟨x.2, x.1⟩) ?_ ?_ ?_ ?_ ?_
      · intro x hx
        simp only [Finset.mem_sigma, Finset.mem_Icc, Finset.mem_Ioc, Finset.mem_Ico] at hx ⊢
        omega
      · intro x hx
        simp only [Finset.mem_sigma, Finset.mem_Icc, Finset.mem_Ioc, Finset.mem_Ico] at hx ⊢
        omega
      · intro x _; rfl
      · intro x _; rfl
      · intro x _; rfl
    rw [hswap]
    have hsplit := Finset.sum_filter_add_sum_filter_not (Finset.Icc 1 T) (fun t => t < 12)
      (fun t => ∑ u ∈ Finset.Ico 1 t, Y u t)
    rw [← hsplit]
    refine add_le_add ?_ ?_
    · calc ∑ t ∈ (Finset.Icc 1 T).filter (· < 12), ∑ u ∈ Finset.Ico 1 t, Y u t ≤
