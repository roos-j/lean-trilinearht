/-- Blueprint `eq:bad-density` (line 2102), the absorption step: the chain inequality with
`δ (J+1)` at least twice the per-link cost gives `k + 1 ≤ 20 (log M + A_e (1 + log M)) / δ`. -/
theorem chain_length_of_bound {δ Δ l Ae Ah Y x : ℝ} (hδ : 0 < δ) (hY : 0 < Y)
    (hx : 0 ≤ x) (hJ : 2 * (Δ + 10 * Δ * l + 10 * Ah * (1 + l)) ≤ δ * Y)
    (h : δ * x * Y ≤ x * Δ + 10 * (x * Δ * l + Y * l) + 10 * ((Y * Ae + x * Ah) * (1 + l))) :
    x ≤ 20 * (l + Ae * (1 + l)) / δ := by
  rw [le_div_iff₀ hδ]
  have h1 : x * (δ * Y) ≤ 2 * (x * (Δ + 10 * Δ * l + 10 * Ah * (1 + l))) +
      2 * (10 * Y * (l + Ae * (1 + l))) - x * (δ * Y) := by nlinarith
  have h2 : x * (2 * (Δ + 10 * Δ * l + 10 * Ah * (1 + l))) ≤ x * (δ * Y) :=
    mul_le_mul_of_nonneg_left hJ hx
  have h3 : x * (δ * Y) ≤ 20 * Y * (l + Ae * (1 + l)) := by nlinarith
  have h4 : x * δ * Y ≤ 20 * (l + Ae * (1 + l)) * Y := by nlinarith
  exact le_of_mul_le_mul_right (by linarith) hY

namespace ModeSystem

variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

open Classical in
/-- Blueprint lines 2084-2108 for one group: splitting the blocks into three classes whose
starts differ by at least `3K`, the side events have chains of length at most
`L = ⌊20 (log |M| + A_e (1 + log |M|)) / δ_*⌋` (`eq:bad-density`), so their mode rows are
Bessel with constant `3 (L + 1) (1 + η D³)`. -/
theorem group_event_rows (Bs : Finset ℤ) (cells : ℤ → Finset (ℤ × ℤ))
    (hdepth : ∀ b ∈ Bs, ∀ J ∈ cells b, J.1 = b - 2 * S.K) (cls : ℤ → Fin 3)
    (hsep : ∀ b ∈ Bs, ∀ b' ∈ Bs, cls b = cls b' → b < b' → b + 3 * S.K ≤ b') {Ae Ah : ℕ}
    (hAe : ∀ (p : Ms.Key) (T : Finset ℤ), (∀ b ∈ T, ∀ b' ∈ T, b < b' → b + 3 * S.K ≤ b') →
      (T.filter fun b => ¬ Ms.nonexcAt S SP b p).card ≤ Ae)
    (hAh : ∀ (b : ℤ) (p : Ms.Key), Ms.nonexcAt S SP b p →
      ((Finset.range (SP.Jst + 1)).filter fun h => ¬ Ms.goodP S SP b h p).card ≤ Ah)
    (hδs : 0 < SP.δs)
    (hJ : 2 * (SP.Δ + 10 * SP.Δ * Real.log (Fintype.card Ms.Md) +
      10 * Ah * (1 + Real.log (Fintype.card Ms.Md))) ≤ SP.δs * (SP.Jst + 1))
    (hδ : 0 < Ms.δc) (hΛ : 8 * Ms.Λ ≤ S.Ξ) (hΞ : 0 < S.Ξ) (hQ0 : 0 < S.Q0) (Kf : ℕ)
    (hbox : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Eh 0) {ε D : ℝ} (hε : 0 < ε)
    (hεw : ∀ m, ε ≤ Ms.L.εM m) (hD0 : 0 ≤ D) (hD1 : (Fintype.card Ms.Md : ℝ) ≤ D)
    (hD2 : (Fintype.card Ms.Md : ℝ) ≤ ε * D ^ 2)
    [inst : ∀ (J : ℤ × ℤ) (E : Finset Ms.Md),
      (Submodule.span ℂ ((Ms.cellMode J) '' (E : Set Ms.Md))).HasOrthogonalProjection]
    (F : ColumnL2 Ms.Md) :
    ∑ e ∈ Ms.events S hA SP Bs cells,
        ‖(Submodule.span ℂ ((Ms.cellMode e.2.1) '' (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 ≤
      3 * ((⌊20 * (Real.log (Fintype.card Ms.Md) + Ae * (1 + Real.log (Fintype.card Ms.Md))) /
        SP.δs⌋₊ + 1) * ((1 + pairConst Ms.zc.dim Ms.δc S.Ξ Kf * D ^ 3) * ‖F‖ ^ 2)) := by
  set ev := Ms.events S hA SP Bs cells
  set l := Real.log (Fintype.card Ms.Md)
  set L := ⌊20 * (l + Ae * (1 + l)) / SP.δs⌋₊
  have hl : 0 ≤ l := Real.log_natCast_nonneg _
  have hclass : ∀ i : Fin 3, ∑ e ∈ ev.filter (fun e => cls e.1 = i),
      ‖(Submodule.span ℂ ((Ms.cellMode e.2.1) '' (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 ≤
        (L + 1) * ((1 + pairConst Ms.zc.dim Ms.δc S.Ξ Kf * D ^ 3) * ‖F‖ ^ 2) := by
    intro i
    set s := ev.filter (fun e => cls e.1 = i)
    have hmem : ∀ e ∈ s, e.1 ∈ Bs ∧ e.2.1 ∈ cells e.1 ∧
        e.2.2 ∈ Ms.sideEvents S hA SP e.1 e.2.1 ∧ cls e.1 = i := by
      intro e he
      obtain ⟨he1, he2⟩ := Finset.mem_filter.mp he
      exact ⟨(Ms.mem_events S hA SP he1).1, (Ms.mem_events S hA SP he1).2.1,
        (Ms.mem_events S hA SP he1).2.2, he2⟩
    refine Ms.class_rows S hA SP s (fun e he => (hmem e he).2.2.1)
      (fun e he => hdepth e.1 (hmem e he).1 e.2.1 (hmem e he).2.1) (L := L) ?_ hδ hΛ hΞ hQ0 Kf
      hbox hε hεw hD0 hD1 hD2 (inst := fun e => inst e.2.1 e.2.2) F
    intro k e hc
    have hb := Ms.chain_events_bound S hA SP s (fun e he => (hmem e he).2.2.1)
      (fun e he => hdepth e.1 (hmem e he).1 e.2.1 (hmem e he).2.1)
      (fun e he e' he' hlt => hsep e.1 (hmem e he).1 e'.1 (hmem e' he').1
        (((hmem e he).2.2.2).trans ((hmem e' he').2.2.2).symm) hlt) hAe hAh hc
    have hx := chain_length_of_bound (δ := SP.δs) (Δ := (SP.Δ : ℝ)) (l := l) (Ae := (Ae : ℝ))
      (Ah := (Ah : ℝ)) (Y := (SP.Jst : ℝ) + 1) (x := ((k + 1 : ℕ) : ℝ)) hδs (by positivity)
      (by positivity) hJ hb
    have hk : (k : ℝ) ≤ 20 * (l + Ae * (1 + l)) / SP.δs := by push_cast at hx; linarith
    exact Nat.le_floor hk
  have hsplit : ∑ e ∈ ev, ‖(Submodule.span ℂ ((Ms.cellMode e.2.1) ''
      (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 =
      ∑ i : Fin 3, ∑ e ∈ ev.filter (fun e => cls e.1 = i), ‖(Submodule.span ℂ
        ((Ms.cellMode e.2.1) '' (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 :=
    (Finset.sum_fiberwise ev (fun e => cls e.1) _).symm
  rw [hsplit]
  refine (Finset.sum_le_sum fun i _ => hclass i).trans (le_of_eq ?_)
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  push_cast
  ring

end ModeSystem

/-! ### Side caps from integrated budgets (blueprint lines 2159-2166, `eq:side-cap`) -/

/-- Blueprint `eq:side-cap` via `lem:cuts`: finitely many families of nonnegative cell weights with
integrated budgets `Σ_I |I| a_ν(I) ≤ A_ν |R|` are capped simultaneously by one first-crossing cut
at `(Σ_ν A_ν)/ρ`, of total length at most `ρ |R|`. -/
theorem side_caps_of_budgets (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) {ν : Type*} [Fintype ν]
    (a : ν → ℤ × ℤ → ℝ) (ha : ∀ v, ∀ c ∈ S, 0 ≤ a v c) (root : ℤ × ℤ)
    (hroot : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    (A : ν → ℝ) (hW : ∀ v, dyadicWeightedMass G S (a v) ≤ A v * dyadicGridLength G root.1)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    dyadicRootLength G (dyadicFirstCrossings G S (fun c => ∑ v, a v c) ((∑ v, A v) / ρ)) ≤
        ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, dyadicRealPathSum G (dyadicRetainedCells G S (fun c => ∑ v, a v c)
        ((∑ v, A v) / ρ)) (fun c => ∑ v, a v c) x ≤ (∑ v, A v) / ρ := by
  refine dyadicFirstCrossingCuts G S _ (fun c hc => Finset.sum_nonneg fun v _ => ha v c hc) root
    hroot hρ hρ1 ?_
  calc dyadicWeightedMass G S (fun c => ∑ v, a v c) = ∑ v, dyadicWeightedMass G S (a v) := by
        unfold dyadicWeightedMass
        simp_rw [Finset.mul_sum]
        exact Finset.sum_comm
    _ ≤ ∑ v, A v * dyadicGridLength G root.1 := Finset.sum_le_sum fun v _ => hW v
    _ = (∑ v, A v) * dyadicGridLength G root.1 := by rw [Finset.sum_mul]

/-- Squared restrictions to disjoint cells add up to at most the squared norm. -/
theorem sum_norm_sq_restrict_le {V : Type*} [Fintype V] (Gd : RealDyadicGrid)
    (C : Finset (ℤ × ℤ))
    (hC : Set.PairwiseDisjoint (C : Set (ℤ × ℤ)) fun I => dyadicGridCell Gd I.1 I.2)
    (v : ColumnL2 V) :
    ∑ I ∈ C, ‖columnL2Restriction (dyadicGridCell Gd I.1 I.2)
      (dyadicGridCell_measurable Gd I.1 I.2) v‖ ^ 2 =
      ‖columnL2Restriction (⋃ I ∈ C, dyadicGridCell Gd I.1 I.2)
        (Finset.measurableSet_biUnion C fun I _ => dyadicGridCell_measurable Gd I.1 I.2) v‖ ^ 2 :=
      by
  rw [columnL2Restriction_biUnion C (fun I => dyadicGridCell Gd I.1 I.2)
    (fun I => dyadicGridCell_measurable Gd I.1 I.2) hC, sum_apply]
  refine (columnL2_norm_sq_sum_disjoint C _ (fun I => dyadicGridCell Gd I.1 I.2) hC
    fun I => ?_).symm
  filter_upwards [columnL2Indicator_coeFn _ (dyadicGridCell_measurable Gd I.1 I.2) v]
    with y hy hyI
  change (columnL2Indicator _ (dyadicGridCell_measurable Gd I.1 I.2) v :
    ℝ → ColumnHilbert V) y = 0
  rw [hy, Set.indicator_of_notMem hyI]

open Classical in
/-- The cell weights `a_I = Σ_G Σ_s 1_{I ∈ E_{G,s}} ‖1_I D_{G,s}‖² / |I|` of finitely many vectors
measured on unions of disjoint cells: their integrated mass is the total squared restricted norm
(`eq:path` for the side states). -/
theorem cell_weights_mass (Gd : RealDyadicGrid) (Sc : Finset (ℤ × ℤ)) {ι : Type*} [Fintype ι]
    {V : ι → Type*} [∀ G, Fintype (V G)] (Sd : Finset ℕ) (Ec : ι → ℕ → Finset (ℤ × ℤ))
    (hsub : ∀ G s, Ec G s ⊆ Sc)
    (hdis : ∀ G s, Set.PairwiseDisjoint (Ec G s : Set (ℤ × ℤ)) fun I => dyadicGridCell Gd I.1 I.2)
    (D : ∀ G, ℕ → ColumnL2 (V G)) :
    dyadicWeightedMass Gd Sc (fun I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
        ‖columnL2Restriction (dyadicGridCell Gd I.1 I.2) (dyadicGridCell_measurable Gd I.1 I.2)
          (D G s)‖ ^ 2 / dyadicGridLength Gd I.1 else 0) =
      ∑ G, ∑ s ∈ Sd, ‖columnL2Restriction (⋃ I ∈ Ec G s, dyadicGridCell Gd I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable Gd I.1 I.2)
          (D G s)‖ ^ 2 := by
  unfold dyadicWeightedMass
  have hcell : ∀ I : ℤ × ℤ, dyadicGridLength Gd I.1 * (∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
      ‖columnL2Restriction (dyadicGridCell Gd I.1 I.2) (dyadicGridCell_measurable Gd I.1 I.2)
        (D G s)‖ ^ 2 / dyadicGridLength Gd I.1 else 0) =
      ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then ‖columnL2Restriction (dyadicGridCell Gd I.1 I.2)
        (dyadicGridCell_measurable Gd I.1 I.2) (D G s)‖ ^ 2 else 0 := by
    intro I
    have hI := (dyadicGridLength_pos Gd I.1).ne'
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun G _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun s _ => ?_
    split_ifs
    · field_simp
    · simp
  simp_rw [hcell]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun G _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun s _ => ?_
  rw [← Finset.sum_filter, ← sum_norm_sq_restrict_le Gd (Ec G s) (hdis G s) (D G s)]
  congr 1
  ext I
  simp only [Finset.mem_filter, and_iff_right_iff_imp]
  exact fun h => hsub G s h

/-- A sum over indices through a map whose fibers have at most `K` elements is at most `K` times
the sum over the image (a fixed side `V_{G,b}` is counted at most `K` times, line 2159). -/
theorem sum_comp_le_mul {α β : Type*} [DecidableEq β] (S : Finset α) (blk : α → β)
    (f : β → ℝ) (hf : ∀ b, 0 ≤ f b) {K : ℕ} (hK : ∀ b, (S.filter fun s => blk s = b).card ≤ K) :
    ∑ s ∈ S, f (blk s) ≤ K * ∑ b ∈ S.image blk, f b := by
  rw [Finset.sum_comp, Finset.mul_sum]
  refine Finset.sum_le_sum fun b _ => ?_
  rw [nsmul_eq_mul]
  exact mul_le_mul_of_nonneg_right (by exact_mod_cast hK b) (hf b)

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- Blueprint `eq:side-cap` (lines 2159-2166) for the basic `B` role of one ball level, rank and
color of the attempt: with the side states `S_{G,s} = Z_{G,s} - Z_{G,u(s)} + V_{G,b(s)}` measured on
the certified active cells of depth `s` (weights `2‖1_I (Z_s - Z_{u(s)})‖²/|I| + 2‖1_I V‖²/|I|`
summed over the groups), one first-crossing cut of total length at most `ρ|R|` makes every retained
path sum of side weights at most `(2 M B_var + 2 K B_lin) / (ρ |R|)`, where `B_var` is the
variation bound (`eq:variation`) and `B_lin` the linear-side energy (`eq:linear-energy`). -/
theorem attempt_side_caps (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (ls : List (ℕ × Bool)) (Sd : Finset ℕ) (u : ℕ → ℕ) (hu : ∀ s, u s ≤ s) {M : ℕ}
    (hM : ∀ s, s - u s < M) (Sc : Finset (ℤ × ℤ)) (Ec : ι → ℕ → Finset (ℤ × ℤ))
    (hsub : ∀ G s, Ec G s ⊆ Sc)
    (hEc : ∀ G s, ∀ I ∈ Ec G s, I ∈ A.cells ∧ I.1 = A.R.1 + s)
    (hcert : ∀ G s, ∀ I ∈ Ec G s, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    (z : ColumnL2 (Fin ap.Mc)) {Vt : ι → Type*} [∀ G, Fintype (Vt G)]
    (Vs : ∀ G, ℤ → ColumnL2 (Vt G)) (blk : ℕ → ℤ) {K : ℕ}
    (hK : ∀ b, (Sd.filter fun s => blk s = b).card ≤ K) (Bs : Finset ℤ)
    (hBs : ∀ s ∈ Sd, blk s ∈ Bs) {Blin : ℝ} (hlin : ∑ G, ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 ≤ Blin)
    (hSc : ∀ I ∈ Sc, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G A.R.1 A.R.2)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    let Bvar := M * (2 * (1 + τ * N * 1 ^ 2) *
      (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * ‖z‖ ^ 2 +
        ls.length * (∑ m ∈ Finset.range ls.length,
          compressionC (ap.cumBase cat hR hb).D m ^ 2) * ‖z‖ ^ 2))
    let a : Bool → ℤ × ℤ → ℝ := fun v I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
      (if v then 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)
          (ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + s) z -
            ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + u s) z)‖ ^ 2
      else 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (Vs G (blk s))‖ ^ 2) /
          dyadicGridLength A.G I.1 else 0
    let T := (2 * Bvar / dyadicGridLength A.G A.R.1 + 2 * (K * Blin) /
      dyadicGridLength A.G A.R.1) / ρ
    dyadicRootLength A.G (dyadicFirstCrossings A.G Sc (fun I => ∑ v, a v I) T) ≤
        ρ * dyadicGridLength A.G A.R.1 ∧
      ∀ x : ℝ, dyadicRealPathSum A.G (dyadicRetainedCells A.G Sc (fun I => ∑ v, a v I) T)
        (fun I => ∑ v, a v I) x ≤ T := by
  intro Bvar a T
  have hL := dyadicGridLength_pos A.G A.R.1
  have hdis : ∀ G s, Set.PairwiseDisjoint (Ec G s : Set (ℤ × ℤ))
      fun I => dyadicGridCell A.G I.1 I.2 := fun G s =>
    cells_pairwiseDisjoint_of_depth A.G (Ec G s) fun I hI => (hEc G s I hI).2
  -- the rolling budget
  have hroll : dyadicWeightedMass A.G Sc (a true) ≤ 2 * Bvar := by
    have hm := cell_weights_mass A.G Sc (V := fun _ => Fin ap.Mc) Sd Ec hsub hdis
      (fun G s => ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + s) z -
        ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + u s) z)
    have hv := ap.attempt_rolling_variation cat t₀ hT hR hb hanc grp hgrp k r₀ j hPH ls Sd u hu
      hM Ec hEc hcert hroot hτ hτ1 hHed hN z
    have e : dyadicWeightedMass A.G Sc (a true) = 2 * dyadicWeightedMass A.G Sc
        (fun I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
          ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2)
            (ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + s) z -
              ap.globOut cat hR hb r₀ j (grp G) ls (A.R.1 + u s) z)‖ ^ 2 /
            dyadicGridLength A.G I.1 else 0) := by
      unfold dyadicWeightedMass
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [a, ↓reduceIte, Finset.mul_sum]
      refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun s _ => ?_
      split_ifs <;> ring
    rw [e, hm, Finset.sum_comm]
    exact mul_le_mul_of_nonneg_left hv (by norm_num)
  -- the fixed budget
  have hfix : dyadicWeightedMass A.G Sc (a false) ≤ 2 * (K * Blin) := by
    have hm := cell_weights_mass A.G Sc (V := Vt) Sd Ec hsub hdis (fun G s => Vs G (blk s))
    have e : dyadicWeightedMass A.G Sc (a false) = 2 * dyadicWeightedMass A.G Sc
        (fun I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
          ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2) (Vs G (blk s))‖ ^ 2 /
            dyadicGridLength A.G I.1 else 0) := by
      unfold dyadicWeightedMass
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [a, Bool.false_eq_true, ↓reduceIte, Finset.mul_sum]
      refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun s _ => ?_
      split_ifs <;> ring
    rw [e, hm]
    refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
    calc ∑ G, ∑ s ∈ Sd, ‖columnL2Restriction (⋃ I ∈ Ec G s, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
            (Vs G (blk s))‖ ^ 2 ≤ ∑ G, ∑ s ∈ Sd, ‖Vs G (blk s)‖ ^ 2 :=
          Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun s _ =>
            pow_le_pow_left₀ (norm_nonneg _) (columnL2Indicator_norm_le _
              (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
              (Vs G (blk s))) 2
      _ ≤ ∑ G, K * ∑ b ∈ Sd.image blk, ‖Vs G b‖ ^ 2 :=
          Finset.sum_le_sum fun G _ => sum_comp_le_mul Sd blk (fun b => ‖Vs G b‖ ^ 2)
            (fun _ => sq_nonneg _) (fun b => by convert hK b)
      _ ≤ ∑ G, K * ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 := by
          refine Finset.sum_le_sum fun G _ => mul_le_mul_of_nonneg_left
            (Finset.sum_le_sum_of_subset_of_nonneg (fun b hb' => ?_) fun _ _ _ => sq_nonneg _)
            (by positivity)
          obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hb'
          exact hBs s hs
      _ = K * ∑ G, ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 := by rw [Finset.mul_sum]
      _ ≤ K * Blin := mul_le_mul_of_nonneg_left hlin (by positivity)
  have hcaps := side_caps_of_budgets A.G Sc a (fun v I _ => ?_) A.R hSc
    (fun v => if v then 2 * Bvar / dyadicGridLength A.G A.R.1
      else 2 * (K * Blin) / dyadicGridLength A.G A.R.1) (fun v => ?_) hρ hρ1
  · have hsum : (∑ v : Bool, if v then 2 * Bvar / dyadicGridLength A.G A.R.1
        else 2 * (K * Blin) / dyadicGridLength A.G A.R.1) =
        2 * Bvar / dyadicGridLength A.G A.R.1 + 2 * (K * Blin) / dyadicGridLength A.G A.R.1 := by
      rw [Fintype.sum_bool]; simp only [↓reduceIte, Bool.false_eq_true]
    rw [hsum] at hcaps
    exact hcaps
  · refine Finset.sum_nonneg fun G _ => Finset.sum_nonneg fun s _ => ?_
    have := dyadicGridLength_pos A.G I.1
    split_ifs <;> positivity
  · cases v
    · simp only [Bool.false_eq_true, ↓reduceIte]
      rw [div_mul_cancel₀ _ hL.ne']; exact hfix
    · simp only [↓reduceIte]
      rw [div_mul_cancel₀ _ hL.ne']; exact hroll

end AttemptParams

end ActiveSetup

/-! ### Catalog tests on fixed vector bases: the helper closure (lines 1815-1831) -/

structure VTest (Tg : Type*) (Mc : ℕ) where
  t : Fin 4
  r : ℕ
  M : Tg → Prop
  m : ℕ
  hr : ℕ → ℕ
  hM : ℕ → Tg → Prop
  θ : ℕ → Bool
  base : ColumnL2 (Fin Mc)

namespace VTest

variable (G : RealDyadicGrid) {Tg : Type*} (Mc : ℕ) (I : ℤ × ℤ) (w : VTest Tg Mc)

/-- The history factor of index `l` (the identity beyond the history length). -/
noncomputable def Q (s : List (CatCol Tg)) (l : ℕ) :
    ColumnL2 (Fin Mc) →L[ℂ] ColumnL2 (Fin Mc) :=
  if l < w.m then catProj G Mc s I (w.hr l) (w.hM l) else ContinuousLinearMap.id ℂ _

/-- The history value on the base. -/
noncomputable def hist (mH : ℕ) (s : List (CatCol Tg)) : ColumnL2 (Fin Mc) :=
  operatorComplementProduct (fun l => w.Q G Mc I s l) w.θ mH (w.base)

/-- The target residual of the history value. -/
noncomputable def resid (mH : ℕ) (s : List (CatCol Tg)) : ColumnL2 (Fin Mc) :=
  w.hist G Mc I mH s - catProj G Mc s I w.r w.M (w.hist G Mc I mH s)

theorem Q_isStarProjection (s : List (CatCol Tg)) (l : ℕ) :
    IsStarProjection (w.Q G Mc I s l) := by
  unfold Q; split_ifs
  · exact catProj_isStarProjection G Mc s I _ _
  · exact IsStarProjection.one _

theorem Q_nest (s : List (CatCol Tg)) (d : CatCol Tg) (l : ℕ) :
    (w.Q G Mc I s l).comp (w.Q G Mc I (s ++ [d]) l) = w.Q G Mc I s l := by
  unfold Q; split_ifs
  · exact catProj_nest G Mc s d I _ _
  · rfl

variable {G Mc I w}

theorem freshFrom_complementProduct (s : List (CatCol Tg)) (θ : ℕ → Bool) (n : ℕ)
    (hn : s.length ≤ n) : ∀ (k : ℕ) {x : ColumnL2 (Fin Mc)}, FreshFrom Mc n x →
      FreshFrom Mc n (operatorComplementProduct (fun l => w.Q G Mc I s l) θ k x)
  | 0, x, hx => hx
  | k + 1, x, hx => by
    have ih := freshFrom_complementProduct s θ n hn k hx
    set y := operatorComplementProduct (fun l => w.Q G Mc I s l) θ k x
    have hQ : FreshFrom Mc n (w.Q G Mc I s k y) := by
      unfold Q; split_ifs
      · exact (catProj_freshFrom s I _ _ y).mono hn
      · exact ih
    change FreshFrom Mc n ((if θ k then ContinuousLinearMap.id ℂ _ - w.Q G Mc I s k else
      w.Q G Mc I s k) y)
    split_ifs
    · rw [sub_apply]; exact ih.sub hQ
    · exact hQ

theorem hist_freshFrom (mH : ℕ) (s : List (CatCol Tg)) (hb : FreshFrom Mc s.length w.base) :
    FreshFrom Mc s.length (w.hist G Mc I mH s) :=
  freshFrom_complementProduct s w.θ s.length le_rfl mH hb

end VTest

namespace VTest

variable {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ} {I : ℤ × ℤ} (w : VTest Tg Mc)

/-- The test passes: every pure source column whose tag lies in the mask has form norm at most
`τ ‖base‖_{2,I}` against the target residual and two normalized `L²` spectators (blueprint
eq:catalog-test; `‖g‖ / √|I|` is the normalized norm of the base on its cell). -/
def Pass (G : RealDyadicGrid) (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ) (tagOf : Tg → ChartTag)
    (wI : ℝ × ℝ → ℂ) (τ : ℝ) (mH : ℕ) (s : List (CatCol Tg)) : Prop :=
  ∀ x, w.M x → ∀ {u a b : Fin 4}, u ≠ w.t → u ≠ a → u ≠ b → w.t ≠ a → w.t ≠ b → a ≠ b →
    ∀ A : QuadraticChartData (tagOf x).dim, QuadraticChartComplexity c₀ H A →
      A.horizontal = (tagOf x).θ → A.matrix = (slotCoeff u : ℚ) • (tagOf x).C →
      A.quadratic = slotCoeff u * (tagOf x).lam →
    ∀ z : Fin 4 → ℝ → ℂ, z u = quadraticChartAtom A →
      z w.t = (fun y => (w.resid G Mc I mH s : ℝ → ColumnHilbert (Fin Mc)) y none) →
      Measurable (z a) → Measurable (z b) →
      eLpNorm (z a) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≤ 1 →
      eLpNorm (z b) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≤ 1 →
      ‖localProgressionForm (dyadicGridLength G I.1) wI z‖ ≤
        τ * ‖w.base‖ / Real.sqrt (dyadicGridLength G I.1)

/-- A failed test is repaired by inserting a same-tag template at the cell (blueprint lines
1823-1825): the target projection grows on the old history value by more than
`τ / (2 H₀)` times the base norm. -/
theorem gain {κ : LocalKernelClass} {c₀ : ℕ} {D : ℕ}
    (hst : ∀ (H : ℝ), Real.exp 2 ≤ H → ∀ (v : ChartTag), 1 ≤ v.dim →
      ∀ {i j a b : Fin 4}, i ≠ j → i ≠ a → i ≠ b → j ≠ a → j ≠ b → a ≠ b →
      ∀ (A : QuadraticChartData v.dim), QuadraticChartComplexity c₀ H A →
      A.horizontal = v.θ → A.matrix = (slotCoeff i : ℚ) • v.C →
      A.quadratic = slotCoeff i * v.lam →
      ∀ {a₀ r : ℝ}, 0 < r → ∀ {w : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r w →
      ∀ (z : Fin 4 → ℝ → ℂ), z i = quadraticChartAtom A → Measurable (z j) →
      Measurable (z a) → Measurable (z b) → MemLp (z j) 2 (normalizedIntervalMeasure a₀ r) →
      eLpNorm (z a) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
      eLpNorm (z b) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
      ∃ R ∈ residueBox v.dim 9, ∃ γ : ℝ,
        ‖localProgressionForm r w z‖ ≤ Real.exp (D * (1 + Real.log H) ^ D) *
          ‖∫ y, z j y * (starRingEnd ℂ) (quadraticChartAtom
            (tagTemplateData v.θ v.C v.lam j R) y * (Real.fourierChar (γ * y) : ℂ))
              ∂(normalizedIntervalMeasure a₀ r)‖)
    {H : ℝ} (hH : Real.exp 2 ≤ H) {tagOf : Tg → ChartTag} (hdim : ∀ x, 1 ≤ (tagOf x).dim)
    {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {τ : ℝ} {mH : ℕ} {s : List (CatCol Tg)} (hlen : s.length < Mc)
    (hfresh : FreshFrom Mc s.length w.base) (hfail : ¬ w.Pass G I c₀ H tagOf wI τ mH s) :
    ∃ d : CatCol Tg, d.rank = w.r ∧ d.birth = I ∧ w.M d.tag ∧
      (∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
        d = templateCol (tagOf d.tag) w.t R γ I w.r d.tag) ∧
      τ / (2 * Real.exp (D * (1 + Real.log H) ^ D)) * ‖w.base‖ <
        ‖(catProj G Mc (s ++ [d]) I w.r w.M - catProj G Mc s I w.r w.M)
          (operatorComplementProduct (fun l => w.Q G Mc I s l) w.θ mH
            (w.base))‖ := by
  set H₀ := Real.exp (D * (1 + Real.log H) ^ D) with hH₀
  set r := dyadicGridLength G I.1 with hr_def
  have hr : 0 < r := dyadicGridLength_pos G I.1
  unfold Pass at hfail
  push Not at hfail
  obtain ⟨x, hx, u, a, b, hut, hua, hub, hta, htb, hab, A, hA, hAθ, hAM, hAq, z, hzu, hzt, hza,
    hzb, hza2, hzb2, hlt⟩ := hfail
  have hztm : Measurable (z w.t) := by rw [hzt]; exact columnPhys_measurable _
  have hzt2 : MemLp (z w.t) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) r) := by
    rw [hzt]; exact columnPhys_memLp_normalized _ _ _
  obtain ⟨R, hR, γ, hbd⟩ := hst H hH (tagOf x) (hdim x) hut hua hub hta htb hab A hA hAθ hAM hAq
    hr hwI z hzu hztm hza hzb hzt2 hza2 hzb2
  set d : CatCol Tg := templateCol (tagOf x) w.t R γ I w.r x with hd
  refine ⟨d, rfl, rfl, hx, ⟨R, hR, γ, rfl⟩, ?_⟩
  have hgain := catProj_gain (G := G) s d I w.r w.M hlen subset_rfl le_rfl hx
    (w.hist G Mc I mH s) (hist_freshFrom mH s hfresh)
  -- the moment as an average over the cell
  have hmom : ∫ y, z w.t y * (starRingEnd ℂ) (quadraticChartAtom
      (tagTemplateData (tagOf x).θ (tagOf x).C (tagOf x).lam w.t R) y *
        (Real.fourierChar (γ * y) : ℂ)) ∂(normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2) r) =
      (r : ℂ)⁻¹ * ∫ y in dyadicGridCell G I.1 I.2, conj (d.atom y) *
        ((w.hist G Mc I mH s - catProj G Mc s I w.r w.M (w.hist G Mc I mH s) : ColumnL2 (Fin Mc)) :
          ℝ → ColumnHilbert (Fin Mc)) y none := by
    rw [integral_normalized_cell G I]
    congr 1
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    simp only [hzt]
    rw [mul_comm]
    rfl
  have hn : ‖((r : ℂ)⁻¹)‖ = r⁻¹ := by
    rw [norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr]
  rw [hmom, norm_mul, hn] at hbd
  have hsq : 0 < Real.sqrt r := Real.sqrt_pos.mpr hr
  have hH₀ : 0 < H₀ := Real.exp_pos _
  set q := ‖(catProj G Mc (s ++ [d]) I w.r w.M - catProj G Mc s I w.r w.M)
    (w.hist G Mc I mH s)‖ with hq
  change _ < q
  have h1 : ‖localProgressionForm r wI z‖ ≤ H₀ * (r⁻¹ * (2 * Real.sqrt r * q)) :=
    hbd.trans (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hgain
      (inv_nonneg.mpr hr.le)) hH₀.le)
  have e : r⁻¹ * (2 * Real.sqrt r * q) = 2 * q / Real.sqrt r := by
    rw [show r⁻¹ = (Real.sqrt r * Real.sqrt r)⁻¹ by rw [Real.mul_self_sqrt hr.le]]
    field_simp
  rw [e] at h1
  have h2 : τ * ‖w.base‖ / Real.sqrt r <
      H₀ * (2 * q / Real.sqrt r) := hlt.trans_le h1
  rw [mul_div_assoc', div_lt_div_iff_of_pos_right hsq] at h2
  rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
  linarith

end VTest

/-- Blueprint lem:closure at one active cell (lines 1820-1831): for finitely many named tests
at the cell, inserting same-tag templates born at the cell closes the catalog: every test
passes, fewer than `T_max` columns are inserted, and the insertions of each rank number at most
`|W| 4^m L^{2m} (2H₀/τ_r)²`, provided this allowance summed over the ranks stays below `T_max`. -/
theorem vcell_closure {κ : LocalKernelClass} {c₀ : ℕ} {D : ℕ}
    (hst : ∀ (H : ℝ), Real.exp 2 ≤ H → ∀ (v : ChartTag), 1 ≤ v.dim →
      ∀ {i j a b : Fin 4}, i ≠ j → i ≠ a → i ≠ b → j ≠ a → j ≠ b → a ≠ b →
      ∀ (A : QuadraticChartData v.dim), QuadraticChartComplexity c₀ H A →
      A.horizontal = v.θ → A.matrix = (slotCoeff i : ℚ) • v.C →
      A.quadratic = slotCoeff i * v.lam →
      ∀ {a₀ r : ℝ}, 0 < r → ∀ {w : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r w →
      ∀ (z : Fin 4 → ℝ → ℂ), z i = quadraticChartAtom A → Measurable (z j) →
      Measurable (z a) → Measurable (z b) → MemLp (z j) 2 (normalizedIntervalMeasure a₀ r) →
      eLpNorm (z a) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
      eLpNorm (z b) 2 (normalizedIntervalMeasure a₀ r) ≤ 1 →
      ∃ R ∈ residueBox v.dim 9, ∃ γ : ℝ,
        ‖localProgressionForm r w z‖ ≤ Real.exp (D * (1 + Real.log H) ^ D) *
          ‖∫ y, z j y * (starRingEnd ℂ) (quadraticChartAtom
            (tagTemplateData v.θ v.C v.lam j R) y * (Real.fourierChar (γ * y) : ℂ))
              ∂(normalizedIntervalMeasure a₀ r)‖)
    {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ} {H : ℝ} (hH : Real.exp 2 ≤ H)
    {tagOf : Tg → ChartTag} (hdim : ∀ x, 1 ≤ (tagOf x).dim) {I : ℤ × ℤ} {wI : ℝ × ℝ → ℂ}
    (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)
    {W : Type*} [Fintype W] (tests : W → VTest Tg Mc) (mH : ℕ) (τ : ℕ → ℝ)
    (hτ : ∀ w, 0 < τ (tests w).r) (s₀ : List (CatCol Tg)) {Tmax : ℕ}
    (hMc : s₀.length + Tmax ≤ Mc) (hfresh : ∀ w, FreshFrom Mc s₀.length (tests w).base)
    (hcap : ∑ r ∈ Finset.univ.image (fun w => (tests w).r),
      Fintype.card W * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) /
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 < (Tmax : ℝ)) :
    ∃ s : List (CatCol Tg), (∀ d ∈ s, d.birth = I ∧ ∃ w, d.rank = (tests w).r ∧
        (tests w).M d.tag ∧ ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (tagOf d.tag) (tests w).t R γ I (tests w).r d.tag) ∧ s.length < Tmax ∧
      (∀ w, (tests w).Pass G I c₀ H tagOf wI (τ (tests w).r) mH (s₀ ++ s)) ∧
      ∀ r, (((Finset.range s.length).filter
        (fun j => ∃ hj : j < s.length, s[j].rank = r)).card : ℝ) *
          (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 ≤
        Fintype.card W * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ≤ 0 := by
  classical
  set H₀ := Real.exp (D * (1 + Real.log H) ^ D) with hH₀
  have hH₀p : 0 < H₀ := Real.exp_pos _
  -- the insertable columns
  let Dt := {d : CatCol Tg // d.birth = I ∧ ∃ w, d.rank = (tests w).r ∧ (tests w).M d.tag ∧
    ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (tagOf d.tag) (tests w).t R γ I (tests w).r d.tag}
  let cat : List Dt → List (CatCol Tg) := fun s => s₀ ++ s.map Subtype.val
  have hcat : ∀ (s : List Dt) (d : Dt), cat (s ++ [d]) = cat s ++ [d.1] := by
    intro s d; simp only [cat, List.map_append, List.map_cons, List.map_nil, List.append_assoc]
  set Rset := Finset.univ.image (fun w => (tests w).r)
  set δ : ℕ → ℝ := fun r => τ r / (2 * H₀)
  set P : W → List Dt → ColumnL2 (Fin Mc) →L[ℂ] ColumnL2 (Fin Mc) :=
    fun w s => catProj G Mc (cat s) I (tests w).r (tests w).M
  set Q : W → ℕ → List Dt → ColumnL2 (Fin Mc) →L[ℂ] ColumnL2 (Fin Mc) :=
    fun w l s => (tests w).Q G Mc I (cat s) l
  have hP : ∀ w s, IsStarProjection (P w s) := fun w s => catProj_isStarProjection _ _ _ _ _ _
  have hP1 : ∀ w s d, (P w s).comp (P w (s ++ [d])) = P w s := fun w s d => by
    simp only [P, hcat]; exact catProj_nest _ _ _ _ _ _ _
  have hQ : ∀ w l s, IsStarProjection (Q w l s) := fun w l s =>
    VTest.Q_isStarProjection _ _ _ _ _ _
  have hQ1 : ∀ w l s d, (Q w l s).comp (Q w l (s ++ [d])) = Q w l s := fun w l s d => by
    simp only [Q, hcat]; exact VTest.Q_nest _ _ _ _ _ _ _
  have hrk : ∀ d : Dt, d.1.rank ∈ Rset := fun d => by
    obtain ⟨w, hw, -⟩ := d.2.2
    exact Finset.mem_image.mpr ⟨w, Finset.mem_univ _, hw.symm⟩
  have hδ : ∀ r ∈ Rset, 0 < δ r := fun r hr => by
    obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hr
    exact div_pos (hτ w) (by positivity)
  have hbd : ∀ s : List Dt, LocalValid (fun d : Dt => d.1.rank) (fun w => (tests w).r) δ P Q
      (fun w => (tests w).θ) mH (fun w => (tests w).base) s →
      s.length < Tmax := fun s h =>
    h.length_lt hP hP1 hQ hQ1 Rset hrk hδ hcap
  obtain ⟨s, hs, hpass, hlen⟩ := local_closure (rk := fun d : Dt => d.1.rank)
    (rkW := fun w => (tests w).r) (δ := δ) (P := P) (Q := Q) (θ := fun w => (tests w).θ)
    (m := mH) (g := fun w => (tests w).base) hP hP1 hQ hQ1 Rset hrk hδ hcap
    (fun w s => (tests w).Pass G I c₀ H tagOf wI (τ (tests w).r) mH (cat s)) (by
      intro s hs w hw
      have hlen : (cat s).length < Mc := by
        have := hbd s hs
        simp only [cat, List.length_append, List.length_map]
        omega
      obtain ⟨d, hdr, hdb, hdM, hdt, hg⟩ := (tests w).gain hst hH hdim hwI hlen
        ((hfresh w).mono (by simp only [cat, List.length_append]; omega)) hw
      refine ⟨⟨d, hdb, w, hdr, hdM, hdt⟩, hdr.symm, ?_⟩
      simp only [P, Q, hcat]
      exact hg)
  refine ⟨s.map Subtype.val, fun d hd => ?_, by simpa using hlen, hpass, fun r => ?_⟩
  · obtain ⟨d', -, rfl⟩ := List.mem_map.mp hd
    exact d'.2
  · by_cases hr : δ r ≤ 0
    · exact Or.inr hr
    · left
      have hc := hs.rank_count hP hP1 hQ hQ1 r (lt_of_not_ge hr)
      have hL : projectionPrefixConstant s.length ≤ projectionPrefixConstant Tmax :=
        projectionPrefixConstant_mono hlen.le
      have hL0 : 0 ≤ projectionPrefixConstant s.length :=
        le_trans zero_le_one (projectionPrefixConstant_one_le _)
      refine le_trans (le_of_eq ?_) (hc.trans (mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hL0 hL _) (by positivity))
        (Nat.cast_nonneg _)))
      simp only [List.length_map, List.getElem_map]
      rfl

section VTreeClosure

variable {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ}


theorem VTest.resid_append_irrel (w : VTest Tg Mc) (I : ℤ × ℤ) (mH : ℕ)
    (s t : List (CatCol Tg))
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    w.resid G Mc I mH (s ++ t) = w.resid G Mc I mH s := by
  have hQ : (fun l => w.Q G Mc I (s ++ t) l) = fun l => w.Q G Mc I s l := by
    funext l; unfold VTest.Q; split_ifs
    · exact catProj_append_irrel s t I _ _ ht
    · rfl
  unfold VTest.resid VTest.hist
  rw [hQ, catProj_append_irrel s t I _ _ ht]

theorem VTest.pass_append_irrel (w : VTest Tg Mc) (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ)
    (tagOf : Tg → ChartTag) (wI : ℝ × ℝ → ℂ) (τ : ℝ) (mH : ℕ) (s t : List (CatCol Tg))
    (ht : ∀ d ∈ t, ¬ dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2) :
    w.Pass G I c₀ H tagOf wI τ mH (s ++ t) ↔ w.Pass G I c₀ H tagOf wI τ mH s := by
  unfold VTest.Pass
  rw [w.resid_append_irrel I mH s t ht]

/-- Blueprint lem:closure over a finite tree (lines 1820-1831): processing the cells with
ancestors first and closing the catalog at each cell (`cell_closure`) gives one catalog that
passes all tests at all cells; the columns born at a cell are its own insertions, with the rank
counts of `cell_closure`. -/
theorem vtree_closure {κ : LocalKernelClass} {c₀ D : ℕ} (hst : SameTagBound κ c₀ D)
    {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ} {H : ℝ} (hH : Real.exp 2 ≤ H)
    {tagOf : Tg → ChartTag}
    (hdim : ∀ x, 1 ≤ (tagOf x).dim) (L : List (ℤ × ℤ)) (hnd : L.Nodup)
    (hord : ∀ i j (hi : i < L.length) (hj : j < L.length), i < j →
      ¬ dyadicGridCell G L[i].1 L[i].2 ⊆ dyadicGridCell G L[j].1 L[j].2)
    (wI : ℤ × ℤ → ℝ × ℝ → ℂ)
    (hwI : ∀ I ∈ L, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)
      (wI I))
    (W : ℤ × ℤ → Type*) [∀ I, Fintype (W I)] (tests : ∀ I, W I → VTest Tg Mc) (mH : ℕ)
    (τ : ℕ → ℝ) (hτ : ∀ I w, 0 < τ (tests I w).r) {Tmax : ℕ}
    (s₀ : List (CatCol Tg)) (hMc : s₀.length + L.length * Tmax ≤ Mc)
    (hfresh : ∀ I w, FreshFrom Mc s₀.length (tests I w).base)
    (hcap : ∀ I ∈ L, ∑ r ∈ Finset.univ.image (fun w => (tests I w).r),
      Fintype.card (W I) * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) /
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 < (Tmax : ℝ)) :
    ∃ cat : List (CatCol Tg),
      (∀ I ∈ L, ∀ w, (tests I w).Pass G I c₀ H tagOf (wI I) (τ (tests I w).r) mH (s₀ ++ cat)) ∧
      (∀ d ∈ cat, d.birth ∈ L ∧ ∃ w, d.rank = (tests d.birth w).r ∧ (tests d.birth w).M d.tag ∧
        ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (tagOf d.tag) (tests d.birth w).t R γ d.birth (tests d.birth w).r d.tag) ∧
      (∀ I ∈ L, ∀ r, ((cat.filter (fun d => decide (d.birth = I ∧ d.rank = r))).length : ℝ) *
          (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 ≤
        Fintype.card (W I) * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨
        τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D)) ≤ 0) ∧
      cat.length ≤ L.length * Tmax := by
  classical
  set δ : ℕ → ℝ := fun r => τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))
  -- the invariant after the first `n` cells
  set c : ℕ → ℤ × ℤ := fun i => L.getD i (0, 0) with hc
  have hcL : ∀ i (hi : i < L.length), c i = L[i] := fun i hi => by
    simp only [hc, List.getD_eq_getElem _ _ hi]
  have key : ∀ n, n ≤ L.length → ∃ cat : List (CatCol Tg),
      (∀ i < n, ∀ w, (tests (c i) w).Pass G (c i) c₀ H tagOf (wI (c i))
        (τ (tests (c i) w).r) mH (s₀ ++ cat)) ∧
      (∀ d ∈ cat, ∃ i < n, d.birth = c i ∧
        ∃ w, d.rank = (tests d.birth w).r ∧ (tests d.birth w).M d.tag ∧
          ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
            d = templateCol (tagOf d.tag) (tests d.birth w).t R γ d.birth (tests d.birth w).r
              d.tag) ∧
      (∀ i < n, ∀ r, ((cat.filter (fun d => decide (d.birth = c i ∧ d.rank = r))).length : ℝ) *
          δ r ^ 2 ≤ Fintype.card (W (c i)) *
            (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨ δ r ≤ 0) ∧
      cat.length ≤ n * Tmax := by
    intro n
    induction n with
    | zero =>
      intro _
      exact ⟨[], fun i hi => absurd hi (Nat.not_lt_zero _), fun d hd => absurd hd (by simp),
        fun i hi => absurd hi (Nat.not_lt_zero _), by simp⟩
    | succ n ih =>
      intro hn
      obtain ⟨cat, hpass, hbirth, hcount, hlen⟩ := ih (by omega)
      set I := c n with hI
      have hIL : I ∈ L := by rw [hI, hcL n (by omega)]; exact List.getElem_mem _
      obtain ⟨s, hs, hslen, hspass, hscount⟩ := vcell_closure hst hH hdim (hwI I hIL) (tests I) mH
        τ (hτ I) (s₀ ++ cat) (Tmax := Tmax) (Mc := Mc) (by
          have := Nat.mul_le_mul_right Tmax hn
          rw [Nat.succ_mul] at this
          simp only [List.length_append]
          omega) (fun w => (hfresh I w).mono (by simp)) (hcap I hIL)
      have hinj : ∀ i j, i < L.length → j < L.length → c i = c j → i = j := by
        intro i j hi hj he
        rw [hcL i hi, hcL j hj] at he
        exact (List.Nodup.getElem_inj_iff hnd).mp he
      -- the earlier cells are not affected
      have hirr : ∀ i < n, ∀ d ∈ s,
          ¬ dyadicGridCell G (c i).1 (c i).2 ⊆ dyadicGridCell G d.birth.1 d.birth.2 := by
        intro i hi d hd
        rw [(hs d hd).1, hI, hcL i (by omega), hcL n (by omega)]
        exact hord i n (by omega) (by omega) hi
      -- the births of the old catalog are earlier cells
      have hold : ∀ d ∈ cat, d.birth ≠ I := by
        intro d hd he
        obtain ⟨i, hi, hdi, -⟩ := hbirth d hd
        have := hinj i n (by omega) (by omega) (hdi.symm.trans he)
        omega
      refine ⟨cat ++ s, fun i hi w => ?_, fun d hd => ?_, fun i hi r => ?_, ?_⟩
      · by_cases hin : i < n
        · rw [← List.append_assoc]
          exact ((tests _ w).pass_append_irrel _ c₀ H tagOf _ _ mH (s₀ ++ cat) s
            (hirr i hin)).mpr (hpass i hin w)
        · have hi' : i = n := by omega
          subst hi'
          rw [← List.append_assoc]
          exact hspass w
      · rcases List.mem_append.mp hd with hd | hd
        · obtain ⟨i, hi, h1, h2⟩ := hbirth d hd
          exact ⟨i, by omega, h1, h2⟩
        · obtain ⟨h1, h2⟩ := hs d hd
          refine ⟨n, by omega, h1, ?_⟩
          rw [h1]; exact h2
      · rw [List.filter_append, List.length_append]
        by_cases hin : i < n
        · have h0 : (s.filter (fun d => decide (d.birth = c i ∧ d.rank = r))).length = 0 := by
            rw [List.length_eq_zero_iff, List.filter_eq_nil_iff]
            intro d hd
            simp only [decide_eq_true_eq, not_and]
            intro he
            rw [(hs d hd).1] at he
            have := hinj n i (by omega) (by omega) he
            omega
          rw [h0, Nat.add_zero]
          exact hcount i hin r
        · have hi' : i = n := by omega
          subst hi'
          have h0 : (cat.filter (fun d => decide (d.birth = I ∧ d.rank = r))).length = 0 := by
            rw [List.length_eq_zero_iff, List.filter_eq_nil_iff]
            intro d hd
            simp only [decide_eq_true_eq, not_and]
            intro he
            exact absurd he (hold d hd)
          rw [h0, Nat.zero_add]
          have hfs : s.filter (fun d => decide (d.birth = I ∧ d.rank = r)) =
              s.filter (fun d => decide (d.rank = r)) := by
            refine List.filter_congr fun d hd => ?_
            simp [(hs d hd).1]
          rw [hfs, ← card_range_filter_getElem s (fun d => d.rank = r)]
          exact hscount r
      · rw [List.length_append, Nat.succ_mul]
        omega
  obtain ⟨cat, hpass, hbirth, hcount, hlen⟩ := key L.length le_rfl
  refine ⟨cat, fun I hI => ?_, fun d hd => ?_, fun I hI r => ?_, hlen⟩
  · obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hI
    rw [← hcL i hi]
    exact hpass i hi
  · obtain ⟨i, hi, h1, h2⟩ := hbirth d hd
    exact ⟨by rw [h1, hcL i hi]; exact List.getElem_mem _, h2⟩
  · obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.mp hI
    rw [← hcL i hi]
    exact hcount i hi r

/-! ### Expansion of catalog outputs into columns (blueprint lemma coeff, lines 488-497) -/
end VTreeClosure

/-! ### Helper instantiation on whole side states (blueprint lines 2167-2169) -/

section HelperRanks

variable {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ}

/-- Columns of rank above `r` do not change the catalog selections of rank at most `r`. -/
theorem catSel_append_highRank (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    (ht : ∀ d ∈ t, r < d.rank) : catSel G Mc (s ++ t) I r M = catSel G Mc s I r M := by
  ext x
  constructor
  · rintro ⟨n, hn, h1, h2, h3, rfl⟩
    by_cases hns : (n : ℕ) < s.length
    · have e : (s ++ t)[(n : ℕ)]'hn = s[(n : ℕ)]'hns := List.getElem_append_left hns
      rw [e] at h1 h2 h3 ⊢
      exact ⟨n, hns, h1, h2, h3, rfl⟩
    · exfalso
      have hmem : (s ++ t)[(n : ℕ)]'hn ∈ t := by
        rw [List.getElem_append_right (by omega)]
        exact List.getElem_mem _
      have := ht _ hmem
      omega
  · intro hx
    exact catSel_mono_append G Mc s t I r M hx

theorem catProj_append_highRank (s t : List (CatCol Tg)) (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop)
    (ht : ∀ d ∈ t, r < d.rank) : catProj G Mc (s ++ t) I r M = catProj G Mc s I r M := by
  have h : catRange G Mc (s ++ t) I r M = catRange G Mc s I r M := by
    unfold catRange; rw [catSel_append_highRank s t I r M ht]
  unfold catProj
  ext x : 1
  exact starProjection_congr h x

/-- Main tests whose target and history ranks lie below every inserted column keep passing. -/
theorem CatTest.pass_append_highRank (w : CatTest Tg) (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ)
    (tagOf : Tg → ChartTag) (wI : ℝ × ℝ → ℂ) (τ : ℝ) (mH : ℕ) (s t : List (CatCol Tg))
    (ht : ∀ d ∈ t, w.r < d.rank ∧ ∀ l < w.m, w.hr l < d.rank) :
    w.Pass G Mc I c₀ H tagOf wI τ mH (s ++ t) ↔ w.Pass G Mc I c₀ H tagOf wI τ mH s := by
  have hQ : (fun l => w.Q G Mc I (s ++ t) l) = fun l => w.Q G Mc I s l := by
    funext l; unfold CatTest.Q; split_ifs with hl
    · exact catProj_append_highRank s t I _ _ fun d hd => (ht d hd).2 l hl
    · rfl
  have hres : w.resid G Mc I mH (s ++ t) = w.resid G Mc I mH s := by
    unfold CatTest.resid CatTest.hist
    rw [hQ, catProj_append_highRank s t I _ _ fun d hd => (ht d hd).1]
  unfold CatTest.Pass
  rw [hres]

end HelperRanks

/-- Blueprint "Helper instantiation" (lines 2167-2169) with lem:closure for the reserved helper
rank: given a main catalog `s₀` and, at the cells of a list ordered with ancestors first, finitely
many helper tests of rank `r_H` on fixed whole bases whose private coordinates are disjoint from
the fresh labels, there is a helper catalog of rank-`r_H` same-tag templates such that all helper
tests pass, every main test whose ranks lie below `r_H` still passes, and the helper insertions
at each cell are counted as in `lem:closure`. -/
theorem helper_instantiation {κ : LocalKernelClass} {c₀ D : ℕ} (hst : SameTagBound κ c₀ D)
    {G : RealDyadicGrid} {Tg : Type*} {Mc : ℕ} {H : ℝ} (hH : Real.exp 2 ≤ H)
    {tagOf : Tg → ChartTag} (hdim : ∀ x, 1 ≤ (tagOf x).dim) (L : List (ℤ × ℤ)) (hnd : L.Nodup)
    (hord : ∀ i j (hi : i < L.length) (hj : j < L.length), i < j →
      ¬ dyadicGridCell G L[i].1 L[i].2 ⊆ dyadicGridCell G L[j].1 L[j].2)
    (wI : ℤ × ℤ → ℝ × ℝ → ℂ)
    (hwI : ∀ I ∈ L, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)
      (wI I))
    (W : ℤ × ℤ → Type*) [∀ I, Fintype (W I)] (tests : ∀ I, W I → VTest Tg Mc) (mH : ℕ)
    (τ : ℕ → ℝ) (hτ : ∀ I w, 0 < τ (tests I w).r) {rH : ℕ} (hrH : ∀ I w, (tests I w).r = rH)
    {Tmax : ℕ} (s₀ : List (CatCol Tg)) (hMc : s₀.length + L.length * Tmax ≤ Mc)
    (hfresh : ∀ I w, FreshFrom Mc s₀.length (tests I w).base)
    (hcap : ∀ I ∈ L, ∑ r ∈ Finset.univ.image (fun w => (tests I w).r),
      Fintype.card (W I) * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) /
        (τ r / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 < (Tmax : ℝ))
    {Wm : Type*} (main : Wm → ℤ × ℤ × CatTest Tg)
    (hmain : ∀ i, (main i).2.2.r < rH ∧ ∀ l < (main i).2.2.m, (main i).2.2.hr l < rH)
    (τm : Wm → ℝ) (hpass : ∀ i, (main i).2.2.Pass G Mc (main i).1 c₀ H tagOf (wI (main i).1)
      (τm i) mH s₀) :
    ∃ hcat : List (CatCol Tg),
      (∀ I ∈ L, ∀ w, (tests I w).Pass G I c₀ H tagOf (wI I) (τ rH) mH (s₀ ++ hcat)) ∧
      (∀ i, (main i).2.2.Pass G Mc (main i).1 c₀ H tagOf (wI (main i).1) (τm i) mH
        (s₀ ++ hcat)) ∧
      (∀ d ∈ hcat, d.birth ∈ L ∧ d.rank = rH ∧ ∃ w, (tests d.birth w).M d.tag ∧
        ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
          d = templateCol (tagOf d.tag) (tests d.birth w).t R γ d.birth rH d.tag) ∧
      (∀ I ∈ L, ((hcat.filter (fun d => decide (d.birth = I ∧ d.rank = rH))).length : ℝ) *
          (τ rH / (2 * Real.exp (D * (1 + Real.log H) ^ D))) ^ 2 ≤
        Fintype.card (W I) * (4 ^ mH * projectionPrefixConstant Tmax ^ (2 * mH)) ∨
        τ rH / (2 * Real.exp (D * (1 + Real.log H) ^ D)) ≤ 0) ∧
      hcat.length ≤ L.length * Tmax := by
  obtain ⟨hcat, hp, hb, hc, hl⟩ := vtree_closure hst hH hdim L hnd hord wI hwI W tests mH τ hτ
    s₀ hMc hfresh hcap
  have hrank : ∀ d ∈ hcat, d.birth ∈ L ∧ d.rank = rH ∧ ∃ w, (tests d.birth w).M d.tag ∧
      ∃ R ∈ residueBox (tagOf d.tag).dim 9, ∃ γ : ℝ,
        d = templateCol (tagOf d.tag) (tests d.birth w).t R γ d.birth rH d.tag := by
    intro d hd
    obtain ⟨hdL, w, hdr, hM, R, hR, γ, hdt⟩ := hb d hd
    refine ⟨hdL, hdr.trans (hrH _ w), w, hM, R, hR, γ, ?_⟩
    rw [← hrH _ w]; exact hdt
  refine ⟨hcat, fun I hI w => ?_, fun i => ?_, hrank, fun I hI => ?_, hl⟩
  · have := hp I hI w
    rwa [hrH I w] at this
  · refine ((main i).2.2.pass_append_highRank _ c₀ H tagOf _ _ mH s₀ hcat fun d hd => ?_).mpr
      (hpass i)
    rw [(hrank d hd).2.1]
    exact hmain i
  · exact hc I hI rH


/-! ### Hereditary representatives (blueprint lines 2172-2191) -/

section HereditaryRepresentatives

variable {ι α : Type*} (E : ι → Finset α) (lt : ι → ι → Prop) (d : ι → ℕ)
  (hd : ∀ c c', lt c c' → d c < d c') (dflt : α)

open Classical in
/-- Blueprint lines 2181-2182 ("process pre-cells chronologically: inherit an earlier
representative when its predecessor is contained, otherwise pick any mode"): the representative
of `c'` is that of some earlier `c` with `E c ⊆ E c'`, if there is one, and otherwise a fixed
element of `E c'`. -/
noncomputable def hereditaryRep {ι α : Type*} (E : ι → Finset α) (lt : ι → ι → Prop)
    (d : ι → ℕ) (hd : ∀ c c', lt c c' → d c < d c') (dflt : α) (c' : ι) : α :=
  if h : ∃ c, lt c c' ∧ E c ⊆ E c' then hereditaryRep E lt d hd dflt (Classical.choose h)
  else if hne : (E c').Nonempty then Classical.choose hne else dflt
termination_by d c'
decreasing_by exact hd _ _ (Classical.choose_spec h).1

open Classical in
theorem hereditaryRep_eq (c' : ι) : hereditaryRep E lt d hd dflt c' =
    if h : ∃ c, lt c c' ∧ E c ⊆ E c' then hereditaryRep E lt d hd dflt (Classical.choose h)
    else if hne : (E c').Nonempty then Classical.choose hne else dflt := by
  rw [hereditaryRep]

/-- Representatives lie in their predecessor sets. -/
theorem hereditaryRep_mem (hne : ∀ c, (E c).Nonempty) (c : ι) :
    hereditaryRep E lt d hd dflt c ∈ E c := by
  induction hn : d c using Nat.strong_induction_on generalizing c with
  | _ n ih =>
    rw [hereditaryRep_eq]
    split_ifs with h h'
    · have hs := Classical.choose_spec h
      exact hs.2 (ih _ (hn ▸ hd _ _ hs.1) _ rfl)
    · exact Classical.choose_spec h'
    · exact absurd (hne c) h'

/-- Blueprint lines 2181-2183 (consistency of the representatives): if earlier predecessors
meeting a later one on a common path are nested in it (`hnest`), predecessors nested in a later
one carry more than half of it (`hmaj`), and the earlier cells of a cell are pairwise comparable
(`hpath`), then a predecessor contained in a later one has the same representative. -/
theorem hereditaryRep_inherit [DecidableEq α]
    (hpath : ∀ a b c, lt a c → lt b c → a = b ∨ lt a b ∨ lt b a)
    (hnest : ∀ c c', lt c c' → (E c ∩ E c').Nonempty → E c ⊆ E c')
    (hmaj : ∀ c c', lt c c' → E c ⊆ E c' → (E c').card < 2 * (E c).card) :
    ∀ c c', lt c c' → E c ⊆ E c' →
      hereditaryRep E lt d hd dflt c' = hereditaryRep E lt d hd dflt c := by
  intro c c' hcc' hsub
  induction hn : d c' using Nat.strong_induction_on generalizing c c' with
  | _ n ih =>
    have hex : ∃ c₀, lt c₀ c' ∧ E c₀ ⊆ E c' := ⟨c, hcc', hsub⟩
    rw [hereditaryRep_eq, dite_eq_left_of_eq_true (eq_true hex)]
    set c₀ := Classical.choose hex
    have hc₀ := Classical.choose_spec hex
    -- `c` and `c₀` are comparable, and their predecessors meet, hence are nested
    obtain ⟨x, hx⟩ := majority_subsets_inter (E c) (E c₀) (E c') hsub hc₀.2
      (hmaj c c' hcc' hsub) (hmaj c₀ c' hc₀.1 hc₀.2)
    have hmeet : (E c ∩ E c₀).Nonempty := ⟨x, hx⟩
    rcases hpath c c₀ c' hcc' hc₀.1 with he | hlt | hlt
    · rw [he]
    · exact ih (d c₀) (hn ▸ hd _ _ hc₀.1) c c₀ hlt (hnest c c₀ hlt hmeet) rfl
    · exact (ih (d c) (hn ▸ hd _ _ hcc') c₀ c hlt
        (hnest c₀ c hlt (by rwa [Finset.inter_comm] at hmeet)) rfl).symm

/-- Blueprint line 2183 ("different representatives on comparable cells"): comparable cells with
different representatives have disjoint predecessors. -/
theorem hereditaryRep_disjoint [DecidableEq α]
    (hpath : ∀ a b c, lt a c → lt b c → a = b ∨ lt a b ∨ lt b a)
    (hnest : ∀ c c', lt c c' → (E c ∩ E c').Nonempty → E c ⊆ E c')
    (hmaj : ∀ c c', lt c c' → E c ⊆ E c' → (E c').card < 2 * (E c).card) {c c' : ι}
    (hcc' : lt c c') (hne : hereditaryRep E lt d hd dflt c ≠ hereditaryRep E lt d hd dflt c') :
    Disjoint (E c) (E c') := by
  rw [Finset.disjoint_iff_inter_eq_empty]
  by_contra h
  exact hne (hereditaryRep_inherit E lt d hd dflt hpath hnest hmaj c c' hcc'
    (hnest c c' hcc' (Finset.nonempty_iff_ne_empty.mpr h))).symm

end HereditaryRepresentatives

namespace ModeComponents

variable {Mode Mode' P : Type*} [DecidableEq Mode] [DecidableEq Mode'] [DecidableEq P]

/-- Blueprint lines 2176-2181 (nesting of predecessors along a link): let `f` transport an earlier
component system `C` into a later one `C'` on a descendant pre-cell, preserving primaries, PRE
components and CURRENT components. If `m` is good at `h` in `C`, `m'` is good at `h` in `C'`,
`f m` lies in the later CURRENT component of `m'`, the later system stabilizes good primaries,
and the later predecessor has fewer than twice the primaries of the earlier one (equal first type
coordinates), then the earlier PRE predecessor is transported into the later one. -/
theorem predecessor_nesting (C : ModeComponents Mode P) (C' : ModeComponents Mode' P)
    (f : Mode → Mode') (hπ : ∀ x, C'.π (f x) = C.π x)
    (hE : ∀ h x y, y ∈ C.E h x → f y ∈ C'.E h (f x))
    (hF : ∀ h x y, y ∈ C.F h x → f y ∈ C'.F h (f x))
    (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)]
    (hstab : ∀ h z z', goodP h (C'.π z) → C'.π z' = C'.π z → z' ∈ C'.F h z →
      z' ∈ C'.E (h - Δ) z)
    {h : ℕ} {m : Mode} {m' : Mode'} (hm' : C'.Good Δ goodP h m')
    (hlink : f m ∈ C'.F h m')
    (htype : (C'.labels (C'.E (h - Δ) m')).card < 2 * (C.labels (C.E (h - Δ) m)).card) :
    (C.E (h - Δ) m).image f ⊆ C'.E (h - Δ) m' := by
  set Fl := C'.F h m'
  set El := C'.E (h - Δ) m'
  set Ee := (C.E (h - Δ) m).image f
  have hFm : C'.F h (f m) = Fl := C'.F_comp h m' (f m) hlink
  have hEe : Ee ⊆ Fl := by
    intro z hz
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hz
    have hyF : y ∈ C.F h m := C.F_mono (h - Δ) h m (Nat.sub_le _ _) (C.E_le_F _ m hy)
    rw [← hFm]
    exact hF h m y hyF
  have hEl : El ⊆ Fl := (C'.E_le_F _ m').trans (C'.F_mono _ _ m' (Nat.sub_le _ _))
  have hlab : Ee.image C'.π = C.labels (C.E (h - Δ) m) := by
    simp only [Ee, Finset.image_image, labels]
    congr 1
    funext x
    exact hπ x
  obtain ⟨-, hBF, hGF⟩ := hm'
  refine early_predecessor_nested C'.π Fl El Ee (goodP h) hEe hEl hBF ?_ hGF ?_
  · change (C'.labels El).card < 2 * (Ee.image C'.π).card
    rw [hlab]
    exact htype
  · intro x hx x' hx' hxx' hg
    -- the common good primary joins `x` to the later predecessor
    have hxEl : x ∈ El := by
      have h1 := hstab h x' x (hxx' ▸ hg) hxx' (by
        rw [C'.F_comp h m' x' (hEl hx'), ← C'.F_comp h m' x (hEe hx)]
        exact C'.E_le_F h x (C'.E_self h x))
      have h2 : C'.E (h - Δ) x' = El := C'.E_comp _ m' x' hx'
      rw [h2] at h1
      exact h1
    obtain ⟨y₀, hy₀, rfl⟩ := Finset.mem_image.mp hx
    intro z hz
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hz
    have hyy : y ∈ C.E (h - Δ) y₀ := by rw [C.E_comp _ m y₀ hy₀]; exact hy
    have h3 := hE _ y₀ y hyy
    have h4 : C'.E (h - Δ) (f y₀) = El := C'.E_comp _ m' (f y₀) hxEl
    rw [h4] at h3
    exact h3

/-- The type coordinates (blueprint line 2174): sizes with equal `⌊log₂ ·⌋` differ by less than
a factor two. -/
theorem card_lt_two_mul_of_log2_eq {a b : ℕ} (ha : 0 < a)
    (hlog : Nat.log 2 a = Nat.log 2 b) : b < 2 * a := by
  have h1 := Nat.lt_pow_succ_log_self (b := 2) (by norm_num) b
  have h2 := Nat.pow_log_le_self 2 ha.ne'
  rw [← hlog, pow_succ] at h1
  omega

