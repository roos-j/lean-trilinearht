/-- `6^h E_0 ≤ E_h` (`E_h = A₀^{h+1}`, `A₀ ≥ 6`). -/
theorem six_pow_mul_Eh_zero_le (hA : 6 ≤ S.A0) (h : ℕ) : (6 : ℝ) ^ h * S.Eh 0 ≤ S.Eh h := by
  unfold Eh
  rw [zero_add, pow_one, pow_succ]
  exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by norm_num) hA h) (by linarith)

/-- Blueprint line 2055 ("all retained shifts are allowed: `E_h ≥ B_* L_h`"): a separation at
height `h` for all shifts `|n| ≤ E_h` scaled by `L_h` gives the separation for all shifts
`|n'| ≤ E_0` at some point of a nonempty set. -/
theorem sep_height_zero (hA : 6 ≤ S.A0) {dz : ℕ} (ϑ : Fin dz → ℝ) {h : ℕ} {θ : ℝ}
    {f : ℝ → ℝ} {X : Set ℝ} (hX : X.Nonempty)
    (hsep : ∀ n : Fin dz → ℤ, (∀ i, |(n i : ℝ)| ≤ S.Eh h) →
      ∀ x ∈ X, θ < |f x + (∑ i, (n i : ℝ) * ϑ i) / Lh h|)
    (n' : Fin dz → ℤ) (hn' : ∀ i, |(n' i : ℝ)| ≤ S.Eh 0) :
    ∃ x ∈ X, θ ≤ |f x + ∑ i, (n' i : ℝ) * ϑ i| := by
  obtain ⟨x, hx⟩ := hX
  refine ⟨x, hx, ?_⟩
  have hL : Lh h = (6 : ℝ) ^ h := rfl
  have hpos : (0 : ℝ) < 6 ^ h := by positivity
  have h1 := hsep (fun i => 6 ^ h * n' i) (fun i => by
    push_cast
    rw [abs_mul, abs_of_pos hpos]
    exact (mul_le_mul_of_nonneg_left (hn' i) hpos.le).trans (S.six_pow_mul_Eh_zero_le hA h)) x hx
  have e : (∑ i, ((6 ^ h * n' i : ℤ) : ℝ) * ϑ i) / Lh h = ∑ i, (n' i : ℝ) * ϑ i := by
    rw [hL, Finset.sum_div]
    refine Finset.sum_congr rfl fun i _ => ?_
    push_cast
    field_simp
  rw [e] at h1
  exact h1.le

end ModeSchedule

open Classical in
/-- Blueprint lines 2226-2227 ("Markov's inequality and first crossings of their partial top
counts"): tops `t ∈ T` on cells `cell t ∈ S` with total length `Σ_t |cell t| ≤ M |R|` are cut at the
first crossings of `M/ρ`, at cost `ρ|R|`, after which every point lies in at most `M/ρ` retained
tops. -/
theorem tops_count_cut (G : RealDyadicGrid) (S : Finset (ℤ × ℤ)) {ι : Type*} (T : Finset ι)
    (cell : ι → ℤ × ℤ) (hT : ∀ t ∈ T, cell t ∈ S) (root : ℤ × ℤ)
    (hroot : ∀ c ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2) {M ρ : ℝ}
    (hρ : 0 < ρ) (hρ1 : ρ < 1)
    (hM : ∑ t ∈ T, dyadicGridLength G (cell t).1 ≤ M * dyadicGridLength G root.1) :
    dyadicRootLength G (dyadicFirstCrossings G S (fun I => ((T.filter fun t => cell t = I).card
        : ℝ)) (M / ρ)) ≤ ρ * dyadicGridLength G root.1 ∧
      ∀ x : ℝ, ((T.filter fun t => cell t ∈ dyadicRetainedCells G S
        (fun I => ((T.filter fun t => cell t = I).card : ℝ)) (M / ρ) ∧
          x ∈ dyadicGridCell G (cell t).1 (cell t).2).card : ℝ) ≤ M / ρ := by
  set a : ℤ × ℤ → ℝ := fun I => ((T.filter fun t => cell t = I).card : ℝ)
  have hmass : dyadicWeightedMass G S a = ∑ t ∈ T, dyadicGridLength G (cell t).1 := by
    unfold dyadicWeightedMass
    simp only [a]
    rw [← Finset.sum_fiberwise_of_maps_to (s := T) (t := S) (g := cell) hT]
    refine Finset.sum_congr rfl fun I _ => ?_
    rw [Finset.sum_congr rfl fun t ht => by rw [(Finset.mem_filter.mp ht).2], Finset.sum_const,
      nsmul_eq_mul, mul_comm]
  obtain ⟨hcost, hpath⟩ := dyadicFirstCrossingCuts G S a (fun _ _ => Nat.cast_nonneg _) root
    hroot hρ hρ1 (hmass.le.trans hM)
  refine ⟨hcost, fun x => le_trans (le_of_eq ?_) (hpath x)⟩
  set Rt := dyadicRetainedCells G S a (M / ρ)
  unfold dyadicRealPathSum
  simp only [a]
  rw [← Nat.cast_sum]
  congr 1
  rw [Finset.card_eq_sum_card_fiberwise (f := cell) (t := Rt.filter fun c =>
    x ∈ dyadicGridCell G c.1 c.2) (fun t ht => by
      obtain ⟨-, h1, h2⟩ := Finset.mem_filter.mp ht
      exact Finset.mem_filter.mpr ⟨h1, h2⟩)]
  refine Finset.sum_congr rfl fun I hI => ?_
  obtain ⟨hIR, hxI⟩ := Finset.mem_filter.mp hI
  congr 1
  ext t
  simp only [Finset.mem_filter]
  constructor
  · rintro ⟨⟨ht, -⟩, he⟩; exact ⟨ht, he⟩
  · rintro ⟨ht, he⟩; exact ⟨⟨ht, he ▸ hIR, he ▸ hxI⟩, he⟩

