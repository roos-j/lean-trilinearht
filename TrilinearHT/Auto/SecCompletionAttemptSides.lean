section LowerAlmostOrthogonal

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- The lower half of `almost_orthogonal_synthesis` (blueprint line 2201, "two-sided almost
orthogonality"): `(1 - η D³) Σ ‖v_e‖² ≤ ‖Σ v_e‖²`. -/
theorem almost_orthogonal_synthesis_lower {κ : Type*} (s : Finset κ) (v : κ → H)
    (b ℓ : κ → ℝ) (w : κ → κ → ℝ) {D η : ℝ} (hη : 0 ≤ η) (hD : 0 ≤ D)
    (hw0 : ∀ e e', 0 ≤ w e e') (hws : ∀ e e', w e e' = w e' e)
    (hcross : ∀ e ∈ s, ∀ e' ∈ s, e ≠ e' → ‖inner ℂ (v e) (v e')‖ ≤ η * w e e' * b e * b e')
    (hmult : ∀ e ∈ s, ∑ e' ∈ s, w e e' ≤ D * ℓ e)
    (hdiag : ∀ e ∈ s, ℓ e * b e ^ 2 ≤ D ^ 2 * ‖v e‖ ^ 2) :
    (1 - η * D ^ 3) * ∑ e ∈ s, ‖v e‖ ^ 2 ≤ ‖∑ e ∈ s, v e‖ ^ 2 := by
  classical
  have hexp : ‖∑ e ∈ s, v e‖ ^ 2 =
      ∑ e ∈ s, ∑ e' ∈ s, RCLike.re (inner ℂ (v e) (v e')) := by
    rw [@norm_sq_eq_re_inner ℂ, sum_inner]
    simp only [inner_sum, map_sum]
  have hpt : ∀ e ∈ s, ∀ e' ∈ s,
      (if e = e' then ‖v e‖ ^ 2 else 0) - η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2)) ≤
        RCLike.re (inner ℂ (v e) (v e')) := by
    intro e he e' he'
    have hw2 : 0 ≤ η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2)) := by
      have := hw0 e e'; positivity
    split_ifs with hee
    · subst hee
      rw [← @norm_sq_eq_re_inner ℂ]
      linarith
    · have h1 := (neg_le_of_abs_le (RCLike.abs_re_le_norm (inner ℂ (v e) (v e')))).trans'
        (neg_le_neg (hcross e he e' he' hee))
      have h2 : b e * b e' ≤ (b e ^ 2 + b e' ^ 2) / 2 := by nlinarith [sq_nonneg (b e - b e')]
      have h3 : η * w e e' * b e * b e' ≤ η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2)) := by
        have := mul_le_mul_of_nonneg_left h2 (mul_nonneg hη (hw0 e e'))
        linarith
      linarith
  have hsym : ∑ e ∈ s, ∑ e' ∈ s, w e e' * ((b e ^ 2 + b e' ^ 2) / 2) =
      ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 := by
    have hswap : ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e' ^ 2 = ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl; intro e _
      apply Finset.sum_congr rfl; intro e' _
      rw [hws]
    have hsplit : ∑ e ∈ s, ∑ e' ∈ s, w e e' * ((b e ^ 2 + b e' ^ 2) / 2) =
        (∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 + ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e' ^ 2) / 2 := by
      rw [← Finset.sum_add_distrib, Finset.sum_div]
      apply Finset.sum_congr rfl; intro e _
      rw [← Finset.sum_add_distrib, Finset.sum_div]
      apply Finset.sum_congr rfl; intro e' _
      ring
    rw [hsplit, hswap]; ring
  have hmain : ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 ≤ D ^ 3 * ∑ e ∈ s, ‖v e‖ ^ 2 := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum; intro e he
    rw [← Finset.sum_mul]
    calc (∑ e' ∈ s, w e e') * b e ^ 2 ≤ D * ℓ e * b e ^ 2 :=
          mul_le_mul_of_nonneg_right (hmult e he) (sq_nonneg _)
      _ = D * (ℓ e * b e ^ 2) := by ring
      _ ≤ D * (D ^ 2 * ‖v e‖ ^ 2) := mul_le_mul_of_nonneg_left (hdiag e he) hD
      _ = D ^ 3 * ‖v e‖ ^ 2 := by ring
  calc (1 - η * D ^ 3) * ∑ e ∈ s, ‖v e‖ ^ 2 ≤
      ∑ e ∈ s, ‖v e‖ ^ 2 - η * ∑ e ∈ s, ∑ e' ∈ s, w e e' * ((b e ^ 2 + b e' ^ 2) / 2) := by
        rw [hsym]
        nlinarith [mul_le_mul_of_nonneg_left hmain hη]
    _ = ∑ e ∈ s, ∑ e' ∈ s,
        ((if e = e' then ‖v e‖ ^ 2 else 0) - η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2))) := by
        simp only [Finset.sum_sub_distrib, Finset.sum_ite_eq, Finset.mul_sum]
        congr 1
        apply Finset.sum_congr rfl; intro e he
        simp [he]
    _ ≤ ‖∑ e ∈ s, v e‖ ^ 2 := by
        rw [hexp]
        exact Finset.sum_le_sum fun e he => Finset.sum_le_sum fun e' he' => hpt e he e' he'

/-- The lower half of `subtotals_almost_orthogonal`: subtotals over disjoint components with
small mutual pairings satisfy `(1 - η D³) Σ_j ‖T_j‖² ≤ ‖Σ_j T_j‖²`. -/
theorem subtotals_almost_orthogonal_lower {μ ι : Type*} (s : Finset ι) (E : ι → Finset μ)
    (Ψ : μ → H) (β : μ → ℂ) {η L ε D : ℝ} (hη : 0 ≤ η) (hL : 0 ≤ L) (hε : 0 < ε) (hD : 0 ≤ D)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → ∀ m ∈ E i, ∀ m' ∈ E j,
      ‖inner ℂ (Ψ m) (Ψ m')‖ ≤ η * L)
    (hpriv : ∀ i ∈ s, ε * L * ∑ m ∈ E i, ‖β m‖ ^ 2 ≤ ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2)
    (hnum : (s.card : ℝ) ≤ D) (hcard : ∀ i ∈ s, ((E i).card : ℝ) ≤ ε * D ^ 2) :
    (1 - η * D ^ 3) * ∑ i ∈ s, ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 ≤
      ‖∑ i ∈ s, ∑ m ∈ E i, β m • Ψ m‖ ^ 2 := by
  classical
  set b : ι → ℝ := fun i => Real.sqrt (E i).card * Real.sqrt (∑ m ∈ E i, ‖β m‖ ^ 2)
  refine almost_orthogonal_synthesis_lower s (fun i => ∑ m ∈ E i, β m • Ψ m) b (fun _ => L)
    (fun _ _ => L) hη hD (fun _ _ => hL) (fun _ _ => rfl) (fun i hi j hj hij => ?_)
    (fun i _ => ?_) (fun i hi => ?_)
  · have hin : inner ℂ (∑ m ∈ E i, β m • Ψ m) (∑ m ∈ E j, β m • Ψ m) =
        ∑ m ∈ E i, ∑ m' ∈ E j, (starRingEnd ℂ) (β m) * β m' * inner ℂ (Ψ m) (Ψ m') := by
      rw [sum_inner]
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [inner_sum]
      refine Finset.sum_congr rfl fun m' _ => ?_
      rw [inner_smul_left, inner_smul_right]; ring
    rw [hin]
    have h := mode_combination_cross_le (E i) (E j) (fun m => (starRingEnd ℂ) (β m)) β
      (fun m m' => inner ℂ (Ψ m) (Ψ m')) (mul_nonneg hη hL) (hpair i hi j hj hij)
    simp only [RCLike.norm_conj] at h
    refine h.trans (le_of_eq ?_)
    simp only [b]
  · rw [Finset.sum_const, nsmul_eq_mul]
    exact mul_le_mul_of_nonneg_right hnum hL
  · have h1 := hpriv i hi
    have hs0 : 0 ≤ ∑ m ∈ E i, ‖β m‖ ^ 2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
    have hb2 : b i ^ 2 = (E i).card * ∑ m ∈ E i, ‖β m‖ ^ 2 := by
      simp only [b]; rw [mul_pow, Real.sq_sqrt (Nat.cast_nonneg _), Real.sq_sqrt hs0]
    rw [hb2]
    have hc0 : (0 : ℝ) ≤ (E i).card := Nat.cast_nonneg _
    have h3 : L * ∑ m ∈ E i, ‖β m‖ ^ 2 ≤ ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 / ε := by
      rw [le_div_iff₀ hε]; linarith
    calc L * ((E i).card * ∑ m ∈ E i, ‖β m‖ ^ 2) =
        (E i).card * (L * ∑ m ∈ E i, ‖β m‖ ^ 2) := by ring
      _ ≤ (E i).card * (‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 / ε) := mul_le_mul_of_nonneg_left h3 hc0
      _ ≤ ε * D ^ 2 * (‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 / ε) :=
          mul_le_mul_of_nonneg_right (hcard i hi) (div_nonneg (sq_nonneg _) hε.le)
      _ = D ^ 2 * ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 := by field_simp

end LowerAlmostOrthogonal

section ComponentSizes

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Blueprint `eq:size-comparison` (lines 2196-2209), first assertion, at one actual cell: the core
subtotals `A_D = Σ_{m core in D} α_m Ψ_m` of the minimal CURRENT components `D ⊆ F` (pairwise
almost orthogonal, `η D³ ≤ 1/2`) with coefficient floors `y_D` (`Σ y_D² ≤ η_f`) satisfy
`σ_F² = Σ_D (‖A_D‖ + y_D)² ≤ 12 (‖P_F Z̃‖² + ε² + ‖V_F‖²) + 2 η_f`, when the full subtotal is
`T_F = V_F + Σ_D A_D` and `‖P_F Z̃ - T_F‖ ≤ ε`. -/
theorem component_sizes {μ ι : Type*} (s : Finset ι) (Dc : ι → Finset μ) (Ψ : μ → H)
    (α : μ → ℂ) {η L ε D : ℝ} (hη : 0 ≤ η) (hL : 0 ≤ L) (hε : 0 < ε) (hD : 0 ≤ D)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → ∀ m ∈ Dc i, ∀ m' ∈ Dc j,
      ‖inner ℂ (Ψ m) (Ψ m')‖ ≤ η * L)
    (hpriv : ∀ i ∈ s, ε * L * ∑ m ∈ Dc i, ‖α m‖ ^ 2 ≤ ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2)
    (hnum : (s.card : ℝ) ≤ D) (hcard : ∀ i ∈ s, ((Dc i).card : ℝ) ≤ ε * D ^ 2)
    (hηD : η * D ^ 3 ≤ 1 / 2) (y : ι → ℝ) {ηf : ℝ} (hy : ∑ i ∈ s, y i ^ 2 ≤ ηf)
    {TF VF PZ : H} {εc : ℝ} (hεc : 0 ≤ εc)
    (hT : TF - VF = ∑ i ∈ s, ∑ m ∈ Dc i, α m • Ψ m) (hclose : ‖PZ - TF‖ ≤ εc) :
    ∑ i ∈ s, (‖∑ m ∈ Dc i, α m • Ψ m‖ + y i) ^ 2 ≤
      12 * (‖PZ‖ ^ 2 + εc ^ 2 + ‖VF‖ ^ 2) + 2 * ηf := by
  have hlow := subtotals_almost_orthogonal_lower s Dc Ψ α hη hL hε hD hpair hpriv hnum hcard
  rw [← hT] at hlow
  have ha : ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 ≤ 2 * ‖TF - VF‖ ^ 2 := by
    have h0 : 0 ≤ ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 := Finset.sum_nonneg fun _ _ => by positivity
    nlinarith
  have hTn : |‖TF - VF‖| ≤ ‖PZ‖ + εc + ‖VF‖ := by
    rw [abs_of_nonneg (norm_nonneg _)]
    calc ‖TF - VF‖ ≤ ‖TF‖ + ‖VF‖ := norm_sub_le _ _
      _ ≤ ‖PZ‖ + εc + ‖VF‖ := by
          have := norm_le_insert' TF PZ
          have h2 : ‖TF - PZ‖ ≤ εc := by rw [norm_sub_rev]; exact hclose
          linarith
  have h := component_size_comparison s (fun i => ‖∑ m ∈ Dc i, α m • Ψ m‖) y (c := 2)
    (by norm_num) ha hy hTn (norm_nonneg _) hεc (norm_nonneg _)
  refine h.trans (le_of_eq ?_)
  ring

/-- Blueprint `eq:size-comparison`, second assertion: the side subtotals `V_F` of distinct CURRENT
components of a linear side `V = Σ_F V_F` satisfy `Σ_F ‖V_F‖² ≤ 2 ‖V‖²` (`η D³ ≤ 1/2`). -/
theorem side_subtotals_le {μ ι : Type*} (s : Finset ι) (Dc : ι → Finset μ) (Ψ : μ → H)
    (α : μ → ℂ) {η L ε D : ℝ} (hη : 0 ≤ η) (hL : 0 ≤ L) (hε : 0 < ε) (hD : 0 ≤ D)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → ∀ m ∈ Dc i, ∀ m' ∈ Dc j,
      ‖inner ℂ (Ψ m) (Ψ m')‖ ≤ η * L)
    (hpriv : ∀ i ∈ s, ε * L * ∑ m ∈ Dc i, ‖α m‖ ^ 2 ≤ ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2)
    (hnum : (s.card : ℝ) ≤ D) (hcard : ∀ i ∈ s, ((Dc i).card : ℝ) ≤ ε * D ^ 2)
    (hηD : η * D ^ 3 ≤ 1 / 2) :
    ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 ≤ 2 * ‖∑ i ∈ s, ∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 := by
  have hlow := subtotals_almost_orthogonal_lower s Dc Ψ α hη hL hε hD hpair hpriv hnum hcard
  have h0 : 0 ≤ ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 := Finset.sum_nonneg fun _ _ => by positivity
  nlinarith

end ComponentSizes

namespace ModeSystem

variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)

/-- Blueprint prop:tops (lines 2219-2221, `lem:mode-rows` on the tops): rows on cells with mode
sets such that overlapping distinct rows meet in one of their cells, have disjoint mode sets, and
are separated there at threshold `Ξ'` for every allowed shift (from
`eq:representative-separation`), are Bessel with constant `1 + η D³`. -/
theorem tops_rows {s : Finset Ms.Event} (hδ : 0 < Ms.δc) (h1 : ∀ e ∈ s, e.2.2.Nonempty)
    (h2 : ∀ e ∈ s, ∀ m ∈ e.2.2,
      Ms.evCell e ⊆ dyadicGridCell Gd (Ms.cellOf m).1 (Ms.cellOf m).2) {Ξ' : ℝ}
    (htop : ∀ e ∈ s, ∀ e' ∈ s, e ≠ e' → (Ms.evCell e ∩ Ms.evCell e').Nonempty →
      ∃ c : ℤ × ℤ, Ms.evCell e ∩ Ms.evCell e' = dyadicGridCell Gd c.1 c.2 ∧
        Disjoint e.2.2 e'.2.2 ∧ ∀ m ∈ e.2.2, ∀ m' ∈ e'.2.2,
          ∀ n : Fin Ms.zc.dim → ℤ, (∀ i, |(n i : ℝ)| ≤ S.Eh 0) →
            ∃ x ∈ Set.Icc (dyadicGridLeft Gd c.1 c.2)
              (dyadicGridLeft Gd c.1 c.2 + dyadicGridLength Gd c.1),
              Ξ' / dyadicGridLength Gd c.1 ≤ |Ms.slope m x - Ms.slope m' x +
                ∑ i, (n i : ℝ) * (Ms.zc.θ i / S.Q0)|)
    (hΛ : 8 * Ms.Λ ≤ Ξ') (hΞ : 0 < Ξ')
    (hQ0 : 0 < S.Q0) (Kf : ℕ) (hbox : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Eh 0) {ε D : ℝ}
    (hε : 0 < ε) (hεw : ∀ m, ε ≤ Ms.L.εM m) (hD0 : 0 ≤ D)
    (hD1 : (Fintype.card Ms.Md : ℝ) ≤ D) (hD2 : (Fintype.card Ms.Md : ℝ) ≤ ε * D ^ 2)
    [inst : ∀ e, (Submodule.span ℂ ((Ms.evMode e) '' (e.2.2 : Set Ms.Md))).HasOrthogonalProjection]
    (F : ColumnL2 Ms.Md) :
    ∑ e ∈ s, ‖(Submodule.span ℂ ((Ms.evMode e) '' (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 ≤
      (1 + pairConst Ms.zc.dim Ms.δc Ξ' Kf * D ^ 3) * ‖F‖ ^ 2 := by
  classical
  refine @modeWave_rows _ _ _ _ Ms.zc _ hδ Ms.ρ Ms.cl Ms.lamOf
    (fun m => dyadicGridLeft Gd (Ms.cellOf m).1 (Ms.cellOf m).2) Ms.γOf Ms.L.εM s Ms.evCell
