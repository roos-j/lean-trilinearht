variable {V W : Type*} [Fintype V] [Fintype W]

/-- `blk_of_cell_local` with the locality stated on an equal grid. -/
theorem ColumnDepthFamily.blk_of_cell_local' {F : Type*} [NormedAddCommGroup F]
    [NormedSpace ℂ F] (Ψ : ColumnDepthFamily V) {G' : RealDyadicGrid} (hG : Ψ.D.grid = G')
    (h : ℤ) {U : ℤ × ℤ}
    (hU : dyadicGridCell G' U.1 U.2 ⊆ dyadicGridCell G' Ψ.D.root.1 Ψ.D.root.2)
    (hUd : Ψ.depth h ≤ U.1) (R : ColumnL2 W →L[ℂ] F)
    (hR : R.comp (columnL2Restriction (dyadicGridCell G' U.1 U.2)
      (dyadicGridCell_measurable G' U.1 U.2)) = R) (x : ColumnL2 W) :
    ‖R x‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition h).cells},
      ‖R (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x)‖ ^ 2 := by
  subst hG
  exact Ψ.blk_of_cell_local h hU hUd R hR x

end CellLocalRows2

