    (columnL2Indicator s hs (physEmbed V W x) : ℝ → ColumnHilbert W)
  filter_upwards [physEmbed_coeFn (W := W) (columnL2Indicator s hs x),
    columnL2Indicator_coeFn s hs x, columnL2Indicator_coeFn s hs (physEmbed V W x),
    physEmbed_coeFn (W := W) x] with y h1 h2 h3 h4
  rw [h1, h3, h2]
  by_cases hy : y ∈ s
  · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy, h4]
  · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]; simp

/-- Blueprint lines 1805 and 1879-1890 for a rank-zero innermost factor: rows that are Bessel for
all inputs and split orthogonally over the cells of the depth partition of a basic column family
remain Bessel after inserting the physical part of its depth projection, at the cost of one
compression constant. -/
theorem basic_insert {ι F : Type*} [Fintype ι] [NormedAddCommGroup F] [NormedSpace ℂ F]
    (Ψ : ColumnDepthFamily V) (d : ι → ℤ) (R : ι → ColumnL2 W →L[ℂ] F) {B : ℝ} (hB : 0 ≤ B)
    (hR : ∀ x, ∑ i, ‖R i x‖ ^ 2 ≤ B * ‖x‖ ^ 2)
    (hblk : ∀ i x, ‖R i x‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition (d i)).cells},
      ‖R i (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x)‖ ^ 2) (Z : ColumnL2 V) :
    ∑ i, ‖R i (physEmbed V W (Ψ.proj (d i) Z))‖ ^ 2 ≤
      B * compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2 := by
  have h := globHist_compression Ψ (P := 1) Nat.one_pos (fun _ _ => Ψ.A) [(0, false)] d
    (fun i => (R i).comp (physEmbed V W)) hB
    (fun x => by
      refine le_trans ?_ (mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (norm_nonneg _) (norm_physEmbed_apply_le (W := W) x) 2) hB)
      exact hR _)
    (fun i x => by
      simp only [ContinuousLinearMap.comp_apply]
      rw [hblk i]
      simp_rw [physEmbed_restrict])
    Z
  refine le_trans (le_of_eq ?_) h
  refine Finset.sum_congr rfl fun i _ => ?_
  have e : globHist Ψ (P := 1) (fun _ _ => Ψ.A) [(0, false)] (d i) = Ψ.proj (d i) := by
    unfold globHist
    rw [show ([(0, false)] : List (ℕ × Bool)) = [] ++ [(0, false)] from rfl, layerOp_append,
      layerOp_nil]
    ext1 x
    simp [opAvg]
    rfl
  rw [e]
  rfl

