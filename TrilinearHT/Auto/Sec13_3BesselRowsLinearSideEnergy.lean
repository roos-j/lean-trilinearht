theorem leaf_ball_eq_globOut (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool))
    {I : ℤ × ℤ} (hI : I ∈ A.cells) {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V)
    (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ap.ballAt cat r j G I (layerOp (ap.cumAt cat I) ls
        (physicalColumnInput (cellLp A.G I (Ψ.currentZ Z I)))) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (ap.globOut cat hR hb r j G ls I.1 (physEmbed V (Fin ap.Mc) (Ψ.proj I.1 Z))) := by
  rw [ap.globOut_restrict cat hR hb r j G ls hI,
    ap.ballAt_layer_restrict cat r j G I ls (physEmbed V (Fin ap.Mc) (Ψ.proj I.1 Z))]
  have hIR := A.sub I hI
  have hroot : Ψ.D.root.1 ≤ I.1 :=
    le_trans hΨr (dyadicGridCell_depth_le_of_subset A.G I A.R hIR)
  have h := Ψ.restrict_physEmbed_proj (W := Fin ap.Mc) (I := I)
    (by rw [hΨG]; exact hIR.trans hΨR) hroot Z
  rw [hΨG] at h
  rw [h]

end AttemptParams

