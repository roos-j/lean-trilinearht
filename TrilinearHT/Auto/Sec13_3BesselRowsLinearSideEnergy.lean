/-- Corollary: `Σ_j |X_j|/|S_j| ≤ A (1 + log M)` when `|S_n| ≤ M`. -/
theorem sum_frac_le_log {α : Type*} [DecidableEq α] (S : ℕ → Finset α) (hS : Monotone S)
    (hS0 : S 0 = ∅) (X : ℕ → Finset α) (hX : ∀ j, X j ⊆ S j) (n A M : ℕ)
