        apply Finset.sum_le_sum; intro i _
        have h1 := Real.log_nonneg (hp1 i)
        have h2 := Real.log_le_log (by linarith [hp1 (n + i)]) (hpM (n + i))
        linarith
    _ = Δ * Real.log M := by simp

