/-- Rows local to one cell `U` below the root of a depth family, of depth at least its partition
depth, split over the partition (only the partition cell containing `U` contributes). -/
theorem ColumnDepthFamily.blk_of_cell_local {F : Type*} [NormedAddCommGroup F]
    [NormedSpace ℂ F] (Ψ : ColumnDepthFamily V) (h : ℤ) {U : ℤ × ℤ}
    (hU : dyadicGridCell Ψ.D.grid U.1 U.2 ⊆ dyadicGridCell Ψ.D.grid Ψ.D.root.1 Ψ.D.root.2)
    (hUd : Ψ.depth h ≤ U.1) (R : ColumnL2 W →L[ℂ] F)
    (hR : R.comp (columnL2Restriction (dyadicGridCell Ψ.D.grid U.1 U.2)
      (dyadicGridCell_measurable Ψ.D.grid U.1 U.2)) = R) (x : ColumnL2 W) :
    ‖R x‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition h).cells},
      ‖R (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x)‖ ^ 2 := by
  classical
  have hmU := dyadicGridCell_measurable Ψ.D.grid U.1 U.2
  -- the partition cell containing `U`
  have hroot : Ψ.D.root.1 ≤ U.1 := le_trans (Ψ.root_le_depth h) hUd
  obtain ⟨m, hUm, hmR⟩ := ancestor_below_root Ψ.D.grid Ψ.D.root U hU (Ψ.root_le_depth h) hUd
  have hQ0 : (Ψ.depth h, m) ∈ (Ψ.partition h).cells := (Ψ.mem_partition h _).mpr ⟨rfl, hmR⟩
  have hval : ∀ Q : {Q // Q ∈ (Ψ.partition h).cells},
      R (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x) =
      if Q.1 = (Ψ.depth h, m) then R x else 0 := by
    intro Q
    have hQ1 := ((Ψ.mem_partition h Q.1).mp Q.2).1
    have hmQ := dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2
    split_ifs with he
    · have hsub : dyadicGridCell Ψ.D.grid U.1 U.2 ⊆ dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2 := by
        rw [he]; exact hUm
      rw [← hR, ContinuousLinearMap.comp_apply, ← ContinuousLinearMap.comp_apply
        (columnL2Restriction _ hmU), columnL2Restriction_comp_of_subset hmU hmQ hsub,
        ← ContinuousLinearMap.comp_apply R, hR]
    · have hdis : Disjoint (dyadicGridCell Ψ.D.grid U.1 U.2)
          (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2) := by
        have hd := (Ψ.partition h).disjoint Q.2 hQ0 he
        exact Set.disjoint_of_subset_left hUm hd.symm
      rw [← hR, ContinuousLinearMap.comp_apply, ← ContinuousLinearMap.comp_apply
        (columnL2Restriction _ hmU), columnL2Restriction_comp_disjoint hmU hmQ hdis]
      simp
  simp_rw [hval]
  rw [Finset.sum_eq_single ⟨(Ψ.depth h, m), hQ0⟩ (fun Q _ hne => by
    rw [ite_eq_right_iff.mpr (fun he => absurd (Subtype.ext he) hne)]; simp) (by simp)]
  simp

end CellLocalRows

