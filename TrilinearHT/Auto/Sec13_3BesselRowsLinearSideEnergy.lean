theorem physEmbed_restrict (s : Set ℝ) (hs : MeasurableSet s) (x : ColumnL2 V) :
    physEmbed V W (columnL2Restriction s hs x) = columnL2Restriction s hs (physEmbed V W x) := by
  classical
