section DeepestAncestor
variable (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))

theorem deepestIn_of_mem {c : ℤ × ℤ} (hc : c ∈ S) : deepestIn G S c = c := by
  have hne : (ancIn G S c).Nonempty := ⟨c, (mem_ancIn G S).mpr ⟨hc, subset_rfl⟩⟩
  obtain ⟨hm, hmax⟩ := deepestIn_spec G S hne
  obtain ⟨-, hsub⟩ := (mem_ancIn G S).mp hm
  have h1 := hmax c ((mem_ancIn G S).mpr ⟨hc, subset_rfl⟩)
  have h2 := dyadicGridCell_depth_le_of_subset G c _ hsub
  have he : (deepestIn G S c).1 = c.1 := le_antisymm h2 h1
  have hp := dyadicGridCell_sameDepth_common_point G c.1 c.2 (deepestIn G S c).2
    (dyadicGridCell_left_mem G c.1 c.2) (by
      have := hsub (dyadicGridCell_left_mem G c.1 c.2); rwa [he] at this)
  exact Prod.ext he hp.symm

end DeepestAncestor

section CatalogDepthFamily
variable {G : RealDyadicGrid} {S : Finset (ℤ × ℤ)} {R : ℤ × ℤ} {Nd : ℕ} {Tg : Type*} {Mc : ℕ}

/-- On an active cell of depth `h`, the depth projection `P_h` followed by the restriction to the
cell is the catalog projection of the cell. -/
theorem catDepthFamily_restrict (hR : R ∈ S) (s : List (CatCol Tg))
    (hb : ∀ d ∈ s, d.birth ∈ dyadicFiniteTree G R Nd) (r : ℕ) (M : ℤ × ℤ → Tg → Prop)
    (hM : ∀ c ∈ S, ∀ d ∈ S, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      ∀ x, M d x → M c x) {I : ℤ × ℤ} (hI : I ∈ S) (hIT : I ∈ dyadicFiniteTree G R Nd) :
    (columnL2Restriction (dyadicGridCell G I.1 I.2) (dyadicGridCell_measurable G I.1 I.2)).comp
      ((catDepthFamily (Mc := Mc) hR s hb r M hM).proj I.1) = catProj G Mc s I r (M I) := by
  set Ψ := catDepthFamily (Mc := Mc) hR s hb r M hM
  have hIR := (dyadicFiniteTree_mem_iff G R I Nd).mp hIT
  have hRI : R.1 ≤ I.1 := dyadicGridCell_depth_le_of_subset G I R hIR.1
  have hIN : I.1 ≤ R.1 + Nd := hIR.2
  have hQ : I ∈ (Ψ.partition I.1).cells := Ψ.depth_of_mem hRI hIN rfl hIR.1
  have hcat : catProj G Mc s I r (M I) =
      cellColumnProjection Ψ.D Ψ.A ((Ψ.partition I.1).subset hQ) := by
    have h := catProj_eq_cellColumnProjection (G := G) (T := dyadicFiniteTree G R Nd) (root := R)
      (hbr := dyadicFiniteTree_below G R Nd) (hroot := root_mem_dyadicFiniteTree G R Nd)
      (s := s) (Mc := Mc) (hb := hb) r (fun c => M (deepestIn G S c))
      (fun c _ d hd hcd x hx => extMask_mono G S hR M hM (dyadicFiniteTree_below G R Nd d hd)
        hcd x hx) hIT
    simp only [deepestIn_of_mem G S hI] at h
    exact h
  refine ContinuousLinearMap.ext fun z => Lp.ext ?_
  have hres := (catProj_restrict G Mc s I r (M I)).2
  rw [← hres]
  simp only [ContinuousLinearMap.comp_apply]
  change (columnL2Indicator _ (dyadicGridCell_measurable G I.1 I.2) (Ψ.proj I.1 z) :
      ℝ → ColumnHilbert (Fin Mc)) =ᵐ[volume] (columnL2Indicator _
      (dyadicGridCell_measurable G I.1 I.2) (catProj G Mc s I r (M I) z) :
      ℝ → ColumnHilbert (Fin Mc))
  have hae := Ψ.proj_ae_cell I.1 z hQ
  rw [← hcat] at hae
  have hae' := (ae_restrict_iff' (dyadicGridCell_measurable G I.1 I.2)).mp hae
  filter_upwards [columnL2Indicator_coeFn _ (dyadicGridCell_measurable G I.1 I.2) (Ψ.proj I.1 z),
    columnL2Indicator_coeFn _ (dyadicGridCell_measurable G I.1 I.2)
      (catProj G Mc s I r (M I) z), hae'] with y h1 h2 h3
  rw [h1, h2]
  by_cases hy : y ∈ dyadicGridCell G I.1 I.2
  · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy]; exact h3 hy
  · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]

end CatalogDepthFamily





namespace ActiveSetup
variable {κ' : LocalKernelClass} {c₀ : ℕ} (A : ActiveSetup κ' c₀)

/-! ### The global ball outputs and histories of an attempt (blueprint lines 1857-1890) -/


namespace AttemptParams
variable {A} (ap : A.AttemptParams)

theorem ballFam_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (p : ℕ) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      ((ap.ballFam cat hR hb r j G p).proj I.1) = catProj A.G ap.Mc cat I r (ap.bmask I G j p) ∧
    ((ap.ballFam cat hR hb r j G p).proj I.1).comp
      (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)) =
        catProj A.G ap.Mc cat I r (ap.bmask I G j p) := by
  have h1 := catDepthFamily_restrict (G := A.G) (S := A.cells) (Nd := A.treeDepth) (Mc := ap.Mc)
    hR cat (births_tree hb) r (fun c => ap.bmask c G j p)
    (fun _ hc _ hd hcd x hx => ap.bmask_mono hc hd hcd G j p x hx) hI (A.cells_mem_tree hI)
  refine ⟨h1, ?_⟩
  have h2 := congrArg ContinuousLinearMap.adjoint h1
  rw [ContinuousLinearMap.adjoint_comp, columnL2Restriction_adjoint, catProj_adjoint,
    ColumnDepthFamily.proj_adjoint] at h2
  exact h2

theorem cumMask_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (p : Fin ap.P) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj I.1) =
        catProj A.G ap.Mc cat I (ap.Lc - m + 1) (ap.cmask I m p) :=
  catDepthFamily_restrict (G := A.G) (S := A.cells) (Nd := A.treeDepth) (Mc := ap.Mc)
    hR cat (births_tree hb) (ap.Lc - m + 1) (fun c => ap.cmask c m p)
    (fun _ hc _ hd hcd x hx => ap.cmask_mono hc hd hcd m p x hx) hI (A.cells_mem_tree hI)

/-- On an active cell the global ball output is the actual output of the cell. -/
theorem globOut_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool))
    {I : ℤ × ℤ} (hI : I ∈ A.cells) (z : ColumnL2 (Fin ap.Mc)) :
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (ap.globOut cat hR hb r j G ls I.1 z) =
      ap.ballAt cat r j G I (layerOp (ap.cumAt cat I) ls z) := by
  set rI := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
  have hball : rI.comp (opAvg (fun p : Fin ap.P => (ap.ballFam cat hR hb r j G p).proj I.1)) =
      (ap.ballAt cat r j G I).comp rI := by
    unfold ballAt
    refine opAvg_intertwine _ _ _ fun p => ?_
    obtain ⟨h1, h2⟩ := ap.ballFam_restrict cat hR hb r j G p hI
    rw [h1, (catProj_restrict A.G ap.Mc cat I r (ap.bmask I G j p)).1]
  have hcum : ∀ m, rI.comp (opAvg fun p : Fin ap.P =>
      ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj I.1) =
        (ap.cumAt cat I m).comp rI := by
    intro m
    unfold cumAt
    refine opAvg_intertwine _ _ _ fun p => ?_
    rw [ap.cumMask_restrict cat hR hb m p hI,
      (catProj_restrict A.G ap.Mc cat I (ap.Lc - m + 1) (ap.cmask I m p)).1]
  have hhist := layerOp_intertwine _ (ap.cumAt cat I) rI hcum ls
  have hcomm : (layerOp (ap.cumAt cat I) ls).comp rI = rI.comp (layerOp (ap.cumAt cat I) ls) :=
    layerOp_commute _ rI (fun m => by
      unfold cumAt
      refine opAvg_commute _ _ fun p => ?_
      have h := catProj_restrict A.G ap.Mc cat I (ap.Lc - m + 1) (ap.cmask I m p)
      rw [h.1, h.2]) ls
  have hballr : (ap.ballAt cat r j G I).comp rI = ap.ballAt cat r j G I := by
    unfold ballAt
    refine ContinuousLinearMap.ext fun x => ?_
    simp only [ContinuousLinearMap.comp_apply, opAvg, smul_apply, FunLike.coe_sum,
      Finset.sum_apply]
    congr 1
    refine Finset.sum_congr rfl fun p _ => ?_
    exact DFunLike.congr_fun (catProj_restrict A.G ap.Mc cat I r (ap.bmask I G j p)).1 x
  unfold globOut globHist
  rw [← ContinuousLinearMap.comp_apply rI, hball, ContinuousLinearMap.comp_apply,
    ← ContinuousLinearMap.comp_apply rI, hhist, ContinuousLinearMap.comp_apply,
    ← ContinuousLinearMap.comp_apply _ rI, hcomm, ← ContinuousLinearMap.comp_apply,
    ← ContinuousLinearMap.comp_assoc, hballr]
  rfl

end AttemptParams

end ActiveSetup

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The ball rows of one interval on a union of active right-endpoint cells: the depth increment
applied to the restriction is the sum over the cells of the catalog projection at the cell minus
the catalog projection at its left-endpoint ancestor. -/
theorem ballFam_interval_decomp (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed) (r j : ℕ) (G : A.Grp) (p : ℕ)
    {hr ht : ℤ} (hR1 : A.R.1 ≤ hr) (hrt : hr ≤ ht) (Ec : Finset (ℤ × ℤ))
    (hEc : ∀ I ∈ Ec, I ∈ A.cells ∧ I.1 = ht) (y : ColumnL2 (Fin ap.Mc)) :
    ((ap.ballFam cat hR hb r j G p).proj ht - (ap.ballFam cat hR hb r j G p).proj hr)
      (columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion Ec fun I _ => dyadicGridCell_measurable A.G I.1 I.2) y) =
      ∑ I ∈ Ec, (catProj A.G ap.Mc cat I r (ap.bmask I G j p) y -
        catProj A.G ap.Mc cat (ancAt A.G I hr) r (ap.bmask (ancAt A.G I hr) G j p)
          (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2) y)) := by
  set Ψ := ap.ballFam cat hR hb r j G p
  rw [columnL2Restriction_biUnion Ec (fun I => dyadicGridCell A.G I.1 I.2)
    (fun I => dyadicGridCell_measurable A.G I.1 I.2)
    (cells_pairwiseDisjoint_of_depth A.G Ec fun I hI => (hEc I hI).2),
    sum_apply, map_sum]
  refine Finset.sum_congr rfl fun I hI => ?_
  obtain ⟨hIc, hId⟩ := hEc I hI
  set rI := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
  have hIJ : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G (ancAt A.G I hr).1
      (ancAt A.G I hr).2 := subset_ancAt A.G I (by omega)
  have hJc : ancAt A.G I hr ∈ A.cells :=
    hanc I hIc _ hIJ (ancAt_subset (A.sub I hIc) hR1)
  set rJ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G (ancAt A.G I hr).1
    (ancAt A.G I hr).2) (dyadicGridCell_measurable A.G (ancAt A.G I hr).1 (ancAt A.G I hr).2)
  have h1 : (Ψ.proj ht).comp rI = catProj A.G ap.Mc cat I r (ap.bmask I G j p) := by
    rw [← hId]; exact (ap.ballFam_restrict cat hR hb r j G p hIc).2
  have h2 : (Ψ.proj hr).comp rI = (catProj A.G ap.Mc cat (ancAt A.G I hr) r
      (ap.bmask (ancAt A.G I hr) G j p)).comp rI := by
    calc (Ψ.proj hr).comp rI = (Ψ.proj hr).comp (rJ.comp rI) := by
          rw [columnL2Restriction_comp_of_subset' _ _ hIJ]
      _ = ((Ψ.proj hr).comp rJ).comp rI := (ContinuousLinearMap.comp_assoc _ _ _).symm
      _ = _ := congrArg (fun T => T.comp rI) (ap.ballFam_restrict cat hR hb r j G p hJc).2
  rw [sub_apply, ← ContinuousLinearMap.comp_apply (Ψ.proj ht) rI, h1,
    ← ContinuousLinearMap.comp_apply (Ψ.proj hr) rI, h2, ContinuousLinearMap.comp_apply]

/-- The right-endpoint ball rows on a union of active cells of their depth. -/
theorem ballFam_right_decomp (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (p : ℕ) {ht : ℤ}
    (Ec : Finset (ℤ × ℤ)) (hEc : ∀ I ∈ Ec, I ∈ A.cells ∧ I.1 = ht) (y : ColumnL2 (Fin ap.Mc)) :
    (ap.ballFam cat hR hb r j G p).proj ht
      (columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion Ec fun I _ => dyadicGridCell_measurable A.G I.1 I.2) y) =
      ∑ I ∈ Ec, catProj A.G ap.Mc cat I r (ap.bmask I G j p) y := by
  rw [columnL2Restriction_biUnion Ec (fun I => dyadicGridCell A.G I.1 I.2)
    (fun I => dyadicGridCell_measurable A.G I.1 I.2)
    (cells_pairwiseDisjoint_of_depth A.G Ec fun I hI => (hEc I hI).2), sum_apply, map_sum]
  refine Finset.sum_congr rfl fun I hI => ?_
  obtain ⟨hIc, hId⟩ := hEc I hI
  have h1 := (ap.ballFam_restrict cat hR hb r j G p hIc).2
  rw [← hId, ← ContinuousLinearMap.comp_apply, h1]

open Classical in
/-- `eq:whole-ranges` for the interval rows of the attempt variation (blueprint lines 1883-1885:
"their adjoints lie in sums of whole ball ranges at the two endpoints; a right certificate
certifies every needed earlier endpoint"). -/
theorem attempt_wr1 (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed)
    {ι ι' : Type*} [Fintype ι] [DecidableEq ι] [Fintype ι'] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (r t : ι' → ℕ) (hrt : ∀ i, r i ≤ t i) (Ec : ι → ι' → Finset (ℤ × ℤ))
    (hEc : ∀ G i, ∀ I ∈ Ec G i, I ∈ A.cells ∧ I.1 = A.R.1 + t i)
    (hcert : ∀ G i, ∀ I ∈ Ec G i, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    (p : Fin ap.P) (x : ι × ι' → ColumnL2 (Fin ap.Mc)) :
    ‖∑ q : ι × ι', ContinuousLinearMap.adjoint
        ((columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
          ((ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + t q.2) -
            (ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + r q.2))) (x q)‖ ^ 2 ≤
      (1 + τ * N * 1 ^ 2) * ∑ G, ‖∑ q ∈ (Finset.univ : Finset (ι × ι')).filter
        (fun q => q.1 = G), ContinuousLinearMap.adjoint
          ((columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
            (Finset.measurableSet_biUnion _ fun I _ =>
              dyadicGridCell_measurable A.G I.1 I.2)).comp
            ((ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + t q.2) -
              (ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + r q.2))) (x q)‖ ^ 2 := by
  set F : ι × ι' → ColumnL2 (Fin ap.Mc) := fun q => ContinuousLinearMap.adjoint
    ((columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
      ((ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + t q.2) -
        (ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + r q.2))) (x q) with hF
  -- the index of the catalog vectors
  set T : ι → Finset ((Σ _ : ι', ℤ × ℤ) × Bool) := fun G =>
    ((Finset.univ : Finset ι').sigma (Ec G)) ×ˢ Finset.univ
  set u : ι → (Σ _ : ι', ℤ × ℤ) × Bool → ℤ × ℤ := fun _ q =>
    if q.2 then q.1.2 else ancAt A.G q.1.2 (A.R.1 + r q.1.1)
  set w : ι → (Σ _ : ι', ℤ × ℤ) × Bool → ColumnL2 (Fin ap.Mc) := fun G q =>
    if q.2 then catProj A.G ap.Mc cat q.1.2 r₀ (ap.bmask q.1.2 (grp G) j p) (x (G, q.1.1))
    else -catProj A.G ap.Mc cat (ancAt A.G q.1.2 (A.R.1 + r q.1.1)) r₀
      (ap.bmask (ancAt A.G q.1.2 (A.R.1 + r q.1.1)) (grp G) j p)
        (columnL2Restriction (dyadicGridCell A.G q.1.2.1 q.1.2.2)
          (dyadicGridCell_measurable A.G q.1.2.1 q.1.2.2) (x (G, q.1.1)))
  -- each group term is the sum of its catalog vectors
  have hFG : ∀ G i, F (G, i) = ∑ I ∈ Ec G i, (w G ⟨⟨i, I⟩, true⟩ + w G ⟨⟨i, I⟩, false⟩) := by
    intro G i
    simp only [hF, ContinuousLinearMap.adjoint_comp, map_sub, ColumnDepthFamily.proj_adjoint,
      columnL2Restriction_adjoint, ContinuousLinearMap.comp_apply]
    rw [ap.ballFam_interval_decomp cat hR hb hanc r₀ j (grp G) p (by omega)
      (by have := hrt i; omega) (Ec G i) (hEc G i) (x (G, i))]
    refine Finset.sum_congr rfl fun I _ => ?_
    simp only [w, ↓reduceIte, sub_eq_add_neg]
    rfl
  have hTsum : ∀ G, ∑ q ∈ T G, w G q =
      ∑ i, ∑ I ∈ Ec G i, (w G ⟨⟨i, I⟩, true⟩ + w G ⟨⟨i, I⟩, false⟩) := by
    intro G
    simp only [T, Finset.sum_product, Finset.sum_sigma, Fintype.sum_bool]
  have hgroup : ∀ G, ∑ q ∈ (Finset.univ : Finset (ι × ι')).filter (fun q => q.1 = G), F q =
      ∑ q ∈ T G, w G q := by
    intro G
    rw [sum_filter_fst_eq F G, hTsum]
    exact Finset.sum_congr rfl fun i _ => hFG G i
  have htotal : ∑ q : ι × ι', F q = ∑ G, ∑ q ∈ T G, w G q := by
    rw [Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun G _ => ?_
    rw [hTsum]
    exact Finset.sum_congr rfl fun i _ => hFG G i
  change ‖∑ q : ι × ι', F q‖ ^ 2 ≤ (1 + τ * N * 1 ^ 2) * ∑ G,
    ‖∑ q ∈ (Finset.univ : Finset (ι × ι')).filter (fun q => q.1 = G), F q‖ ^ 2
  rw [htotal]
  simp only [hgroup]
  -- the cells of the vectors are active and certified
  have hu : ∀ G, ∀ q ∈ T G, u G q ∈ A.cells ∧
      dyadicGridCell A.G q.1.2.1 q.1.2.2 ⊆ dyadicGridCell A.G (u G q).1 (u G q).2 := by
    intro G q hq
    obtain ⟨hq1, -⟩ := Finset.mem_product.mp hq
    obtain ⟨-, hI⟩ := Finset.mem_sigma.mp hq1
    obtain ⟨hIc, hId⟩ := hEc G q.1.1 q.1.2 hI
    rcases q with ⟨⟨i, I⟩, b⟩
    cases b
    · have hIJ := subset_ancAt A.G I (d := A.R.1 + r i) (by
        have := hrt i; simp only at hId; omega)
      exact ⟨hanc I hIc _ hIJ (ancAt_subset (A.sub I hIc) (by omega)), hIJ⟩
    · exact ⟨hIc, subset_rfl⟩
  refine ap.catRange_wholeRanges cat t₀ hT grp hgrp k T u (fun G q hq => (hu G q hq).1)
    (fun _ _ => r₀) (fun _ _ => ap.bbase j + p + 1) (fun _ _ => by have := p.2; omega) w
    ?_ ?_ hroot hτ hτ1 hHed ?_
  · intro G q _
    rcases q with ⟨⟨i, I⟩, b⟩
    cases b
    · exact Submodule.neg_mem _ (Submodule.starProjection_apply_mem _ _)
    · exact Submodule.starProjection_apply_mem _ _
  · intro G q hq
    obtain ⟨hq1, -⟩ := Finset.mem_product.mp hq
    obtain ⟨-, hI⟩ := Finset.mem_sigma.mp hq1
    obtain ⟨u', hu', hsub, hx⟩ := hcert G q.1.1 q.1.2 hI
    exact ⟨u', hu', hsub.trans (hu G q hq).2, hx⟩
  · intro y
    refine le_trans (Finset.card_le_card fun q hq => ?_) (hN y)
    obtain ⟨-, e, he, hy, hv⟩ := Finset.mem_filter.mp hq
