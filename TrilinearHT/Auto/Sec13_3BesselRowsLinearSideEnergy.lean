section CellLocalRows
variable {V W : Type*} [Fintype V] [Fintype W]

/-- Rows local to one cell `U` below the root of a depth family, of depth at least its partition
depth, split over the partition (only the partition cell containing `U` contributes). -/
theorem ColumnDepthFamily.blk_of_cell_local {F : Type*} [NormedAddCommGroup F]
    [NormedSpace ℂ F] (Ψ : ColumnDepthFamily V) (h : ℤ) {U : ℤ × ℤ}
    (hU : dyadicGridCell Ψ.D.grid U.1 U.2 ⊆ dyadicGridCell Ψ.D.grid Ψ.D.root.1 Ψ.D.root.2)
    (hUd : Ψ.depth h ≤ U.1) (R : ColumnL2 W →L[ℂ] F)
    (hR : R.comp (columnL2Restriction (dyadicGridCell Ψ.D.grid U.1 U.2)
      (dyadicGridCell_measurable Ψ.D.grid U.1 U.2)) = R) (x : ColumnL2 W) :
    ‖R x‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition h).cells},
      ‖R (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x)‖ ^ 2 := by
  classical
  have hmU := dyadicGridCell_measurable Ψ.D.grid U.1 U.2
  -- the partition cell containing `U`
  have hroot : Ψ.D.root.1 ≤ U.1 := le_trans (Ψ.root_le_depth h) hUd
  obtain ⟨m, hUm, hmR⟩ := ancestor_below_root Ψ.D.grid Ψ.D.root U hU (Ψ.root_le_depth h) hUd
  have hQ0 : (Ψ.depth h, m) ∈ (Ψ.partition h).cells := (Ψ.mem_partition h _).mpr ⟨rfl, hmR⟩
  have hval : ∀ Q : {Q // Q ∈ (Ψ.partition h).cells},
      R (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x) =
      if Q.1 = (Ψ.depth h, m) then R x else 0 := by
    intro Q
    have hQ1 := ((Ψ.mem_partition h Q.1).mp Q.2).1
    have hmQ := dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2
    split_ifs with he
    · have hsub : dyadicGridCell Ψ.D.grid U.1 U.2 ⊆ dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2 := by
        rw [he]; exact hUm
      rw [← hR, ContinuousLinearMap.comp_apply, ← ContinuousLinearMap.comp_apply
        (columnL2Restriction _ hmU), columnL2Restriction_comp_of_subset hmU hmQ hsub,
        ← ContinuousLinearMap.comp_apply R, hR]
    · have hdis : Disjoint (dyadicGridCell Ψ.D.grid U.1 U.2)
          (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2) := by
        have hd := (Ψ.partition h).disjoint Q.2 hQ0 he
        exact Set.disjoint_of_subset_left hUm hd.symm
      rw [← hR, ContinuousLinearMap.comp_apply, ← ContinuousLinearMap.comp_apply
        (columnL2Restriction _ hmU), columnL2Restriction_comp_disjoint hmU hmQ hdis]
      simp
  simp_rw [hval]
  rw [Finset.sum_eq_single ⟨(Ψ.depth h, m), hQ0⟩ (fun Q _ hne => by
    rw [ite_eq_right_iff.mpr (fun he => absurd (Subtype.ext he) hne)]; simp) (by simp)]
  simp

end CellLocalRows

section CellLocalRows2
variable {V W : Type*} [Fintype V] [Fintype W]

/-- `blk_of_cell_local` with the locality stated on an equal grid. -/
theorem ColumnDepthFamily.blk_of_cell_local' {F : Type*} [NormedAddCommGroup F]
    [NormedSpace ℂ F] (Ψ : ColumnDepthFamily V) {G' : RealDyadicGrid} (hG : Ψ.D.grid = G')
    (h : ℤ) {U : ℤ × ℤ}
    (hU : dyadicGridCell G' U.1 U.2 ⊆ dyadicGridCell G' Ψ.D.root.1 Ψ.D.root.2)
    (hUd : Ψ.depth h ≤ U.1) (R : ColumnL2 W →L[ℂ] F)
    (hR : R.comp (columnL2Restriction (dyadicGridCell G' U.1 U.2)
      (dyadicGridCell_measurable G' U.1 U.2)) = R) (x : ColumnL2 W) :
    ‖R x‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition h).cells},
      ‖R (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x)‖ ^ 2 := by
  subst hG
  exact Ψ.blk_of_cell_local h hU hUd R hR x

end CellLocalRows2

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- Blueprint lines 2062-2108 (lift composition with the main histories) for a basic slot: the
lifted event rows of all groups, applied to the actual leaf ball outputs at their decision cells
(whose inputs are the current basic projections of a column family), are jointly Bessel in the
basic input. -/
theorem attempt_event_rows_basic (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp) (hgrp : Function.Injective grp) (k r j : ℕ)
    (Ms : ι → ModeSystem A.G ap.Mc) (ev : ∀ G, Finset (Ms G).Event) (Kd : ℤ)
    (hu : ∀ G, ∀ e ∈ ev G, ancAt A.G e.2.1 (e.1 - Kd) ∈ A.cells)
    (hJu : ∀ G, ∀ e ∈ ev G, e.1 - Kd ≤ e.2.1.1)
    [inst : ∀ G (e : (Ms G).Event), (Submodule.span ℂ
      (((Ms G).evMode e) '' (e.2.2 : Set (Ms G).Md))).HasOrthogonalProjection]
    {c : ℝ} (hc : 0 ≤ c)
    (hrows : ∀ G (F : ColumnL2 (Ms G).Md), ∑ e ∈ ev G, ‖(Submodule.span ℂ
      (((Ms G).evMode e) '' (e.2.2 : Set (Ms G).Md))).starProjection F‖ ^ 2 ≤ c * ‖F‖ ^ 2)
    (hcert : ∀ G, ∀ e ∈ ev G, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G (ancAt A.G e.2.1 (e.1 - Kd)).1
        (ancAt A.G e.2.1 (e.1 - Kd)).2 ∧
      ∃ w ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) w) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') w = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') w = grp G)
    (hPH : ap.bbase j + ap.P ≤ ap.Hmax) {ra rb : ℝ}
    (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r (ap.bmask I (grp q.1) j p)).card ≤ N)
    (ls : List (ℕ × Bool)) {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V)
    (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ G, ∑ e ∈ ev G, ‖(Submodule.span ℂ
        (((Ms G).evMode e) '' (e.2.2 : Set (Ms G).Md))).starProjection
        ((Ms G).L.op (ap.ballAt cat r j (grp G) (ancAt A.G e.2.1 (e.1 - Kd))
          (layerOp (ap.cumAt cat (ancAt A.G e.2.1 (e.1 - Kd))) ls
            (physicalColumnInput (cellLp A.G (ancAt A.G e.2.1 (e.1 - Kd))
              (Ψ.currentZ Z (ancAt A.G e.2.1 (e.1 - Kd))))))))‖ ^ 2 ≤
      (1 + τ * N * 1 ^ 2) * (c * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2) *
        compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * compressionC Ψ.D 1 ^ 2 *
          ‖Z‖ ^ 2 := by
  set κi := Σ G : ι, {e // e ∈ ev G}
  set u : κi → ℤ × ℤ := fun i => ancAt A.G i.2.1.2.1 (i.2.1.1 - Kd)
  set Fs := ∀ G : ι, ColumnL2 (Ms G).Md
  set Rw : κi → ColumnL2 (Fin ap.Mc) →L[ℂ] Fs := fun i =>
    (ContinuousLinearMap.single ℂ (fun G : ι => ColumnL2 (Ms G).Md) i.1).comp
      ((Submodule.span ℂ (((Ms i.1).evMode i.2.1) ''
        (i.2.1.2.2 : Set (Ms i.1).Md))).starProjection.comp
          ((Ms i.1).L.op.comp ((ap.ballAt cat r j (grp i.1) (u i)).comp
            (layerOp (ap.cumAt cat (u i)) ls))))
  have hnorm : ∀ i x, ‖Rw i x‖ = ‖(Submodule.span ℂ (((Ms i.1).evMode i.2.1) ''
      (i.2.1.2.2 : Set (Ms i.1).Md))).starProjection ((Ms i.1).L.op (ap.ballAt cat r j (grp i.1)
        (u i) (layerOp (ap.cumAt cat (u i)) ls x)))‖ := by
    intro i x
    simp only [Rw, ContinuousLinearMap.comp_apply, ContinuousLinearMap.single_apply]
    exact Pi.norm_single _
  have hB : 0 ≤ (1 + τ * N * 1 ^ 2) * (c * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2) *
      compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 := by
    have h1 : (0 : ℝ) ≤ 1 + τ * N * 1 ^ 2 := by positivity
    have h2 : 0 ≤ c * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2 :=
      mul_nonneg (mul_nonneg hc (by norm_num)) (sq_nonneg _)
    exact mul_nonneg (mul_nonneg h1 h2) (sq_nonneg _)
  have hsum : ∀ (f : κi → ℝ), ∑ i, f i = ∑ G, ∑ e ∈ ev G, (if h : e ∈ ev G then f ⟨G, ⟨e, h⟩⟩
      else 0) := by
    intro f
    rw [Fintype.sum_sigma]
    refine Finset.sum_congr rfl fun G _ => ?_
    rw [← Finset.sum_coe_sort (ev G)]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [dite_eq_left_of_eq_true (eq_true e.2)]
  have hrowsB : ∀ x, ∑ i, ‖Rw i x‖ ^ 2 ≤ ((1 + τ * N * 1 ^ 2) *
      (c * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2) *
        compressionC (ap.cumBase cat hR hb).D ls.length ^ 2) * ‖x‖ ^ 2 := by
    intro x
    have h := ap.attempt_event_rows cat t₀ hT hR hb grp hgrp k r j Ms ev Kd hu hJu hc hrows
      hcert hPH hroot hτ hτ1 hHed hN ls x
    refine le_trans (le_of_eq ?_) h
    rw [hsum]
    refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun e he => ?_
    rw [dite_eq_left_of_eq_true (eq_true he), hnorm]
  have hcellloc : ∀ i, (Rw i).comp (columnL2Restriction (dyadicGridCell A.G (u i).1 (u i).2)
      (dyadicGridCell_measurable A.G (u i).1 (u i).2)) = Rw i := by
    intro i
    refine ContinuousLinearMap.ext fun x => ?_
    simp only [Rw, ContinuousLinearMap.comp_apply]
    rw [← ap.ballAt_layer_restrict cat r j (grp i.1) (u i) ls x]
  have huR : ∀ i, dyadicGridCell A.G (u i).1 (u i).2 ⊆ dyadicGridCell A.G A.R.1 A.R.2 :=
    fun i => A.sub _ (hu i.1 i.2.1 i.2.2)
  have hblk : ∀ i x, ‖Rw i x‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition (u i).1).cells},
      ‖Rw i (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x)‖ ^ 2 := by
    intro i x
    have hd : Ψ.depth (u i).1 ≤ (u i).1 := by
      have hr : Ψ.D.root.1 ≤ (u i).1 :=
        le_trans hΨr (dyadicGridCell_depth_le_of_subset A.G (u i) A.R (huR i))
      unfold ColumnDepthFamily.depth
      exact max_le hr (min_le_left _ _)
    exact Ψ.blk_of_cell_local' hΨG (u i).1 ((huR i).trans hΨR) hd (Rw i) (hcellloc i) x
  have hins := basic_insert (W := Fin ap.Mc) Ψ (fun i => (u i).1) Rw hB hrowsB hblk Z
  refine le_trans (le_of_eq ?_) hins
  rw [hsum]
  refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun e he => ?_
  rw [dite_eq_left_of_eq_true (eq_true he), hnorm]
  have hIR := huR ⟨G, ⟨e, he⟩⟩
  have hroot' : Ψ.D.root.1 ≤ (u ⟨G, ⟨e, he⟩⟩).1 :=
    le_trans hΨr (dyadicGridCell_depth_le_of_subset A.G _ A.R hIR)
  have h := Ψ.restrict_physEmbed_proj (W := Fin ap.Mc) (I := u ⟨G, ⟨e, he⟩⟩)
    (by rw [hΨG]; exact hIR.trans hΨR) hroot' Z
  rw [hΨG] at h
  rw [ap.ballAt_layer_restrict cat r j (grp G) (u ⟨G, ⟨e, he⟩⟩) ls
    (physEmbed V (Fin ap.Mc) (Ψ.proj (u ⟨G, ⟨e, he⟩⟩).1 Z)), h]

open Classical in
/-- Blueprint prop:linear-side (`eq:linear-energy`, lines 2080-2118) for a basic slot (inputs
the current basic projections of a column family at the decision cells), one role, ball level and
color of the attempt: the exact side subtotals `V_{G,b}` of all groups and blocks have total
square at most twice the almost-orthogonality constant times the joint event-row bound of
`lem:lift-composition` plus the squared complementary errors. The frozen coefficients are those
of the lifted ball outputs at the decision cells `u_b` (`frozen_proj_eq`), and the event rows of
each group are Bessel with constant `c` (by `class_rows` over the three classes). -/
theorem attempt_linear_side_basic (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp) (hgrp : Function.Injective grp) (k r j : ℕ)
    (S : ModeSchedule) (hA : 6 ≤ S.A0) (SP : SideParams) (Ms : ι → ModeSystem A.G ap.Mc)
    (Bs : ι → Finset ℤ) (cells : ι → ℤ → Finset (ℤ × ℤ))
    (hdepth : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, J.1 = b - 2 * S.K)
    (hu : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, ancAt A.G J (b - 4 * S.K) ∈ A.cells)
    (c : ∀ G, ℤ → ℤ × ℤ → (Ms G).Md → ℂ) (ls : List (ℕ × Bool))
    {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V) (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V)
    [inst : ∀ G (J : ℤ × ℤ) (E : Finset (Ms G).Md),
      (Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).HasOrthogonalProjection]
    (hfrozen : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, ∀ E ∈ (Ms G).sideEvents S hA SP b J,
      (Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
          ((Ms G).frozenEval S b J (c G b J)) =
        (Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
          ((Ms G).L.op (ap.ballAt cat r j (grp G) (ancAt A.G J (b - 4 * S.K))
            (layerOp (ap.cumAt cat (ancAt A.G J (b - 4 * S.K))) ls
              (physicalColumnInput (cellLp A.G (ancAt A.G J (b - 4 * S.K))
                (Ψ.currentZ Z (ancAt A.G J (b - 4 * S.K)))))))))
    {cR : ℝ} (hcR : 0 ≤ cR)
    (hrows : ∀ G (F : ColumnL2 (Ms G).Md), ∑ e ∈ (Ms G).events S hA SP (Bs G) (cells G),
      ‖(Submodule.span ℂ (((Ms G).cellMode e.2.1) '' (e.2.2 : Set (Ms G).Md))).starProjection
        F‖ ^ 2 ≤ cR * ‖F‖ ^ 2)
    (hcert : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G (ancAt A.G J (b - 4 * S.K)).1
        (ancAt A.G J (b - 4 * S.K)).2 ∧
      ∃ w ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) w) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') w = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') w = grp G)
    (hPH : ap.bbase j + ap.P ≤ ap.Hmax) {ra rb : ℝ}
    (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r (ap.bmask I (grp q.1) j p)).card ≤ N)
    (hδ : ∀ G, 0 < (Ms G).δc) (hΛ : ∀ G, 8 * (Ms G).Λ ≤ S.Ξ) (hΞ : 0 < S.Ξ) (hQ0 : 0 < S.Q0)
    (Kf : ℕ) (hbox : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Eh 0) {ε D κ : ℝ} (hε : 0 < ε)
    (hεw : ∀ G m, ε ≤ (Ms G).L.εM m) (hD0 : 0 ≤ D)
    (hD1 : ∀ G, (Fintype.card (Ms G).Md : ℝ) ≤ D)
    (hD2 : ∀ G, (Fintype.card (Ms G).Md : ℝ) ≤ ε * D ^ 2)
    (hκ : ∀ G, pairConst (Ms G).zc.dim (Ms G).δc S.Ξ Kf ≤ κ) (hκ0 : 0 ≤ κ) :
    ∑ G, ∑ b ∈ Bs G, ‖(Ms G).blockSide S hA SP b (cells G b) (c G b)‖ ^ 2 ≤
      2 * (1 + κ * D ^ 3) * ((1 + τ * N * 1 ^ 2) * (cR * 5 *
        compression1 (ap.cumBase cat hR hb).D ^ 2) *
          compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * compressionC Ψ.D 1 ^ 2 *
            ‖Z‖ ^ 2 +
        ∑ G, ∑ b ∈ Bs G, ∑ J ∈ cells G b, ∑ E ∈ (Ms G).sideEvents S hA SP b J,
          (Ms G).eventErr S Kf ε b J E (c G b J) ^ 2) := by
  set ev := fun G => (Ms G).events S hA SP (Bs G) (cells G)
  have hevm := fun G e (he : e ∈ ev G) => (Ms G).mem_events S hA SP he
  -- the joint event rows
  have hjoint := ap.attempt_event_rows_basic cat t₀ hT hR hb grp hgrp k r j Ms ev (4 * S.K)
    (fun G e he => hu G e.1 (hevm G e he).1 e.2.1 (hevm G e he).2.1)
    (fun G e he => by
      have := hdepth G e.1 (hevm G e he).1 e.2.1 (hevm G e he).2.1
      have hK : (0 : ℤ) ≤ S.K := Nat.cast_nonneg _
      omega)
    (inst := fun G e => inst G e.2.1 e.2.2) hcR hrows
    (fun G e he => hcert G e.1 (hevm G e he).1 e.2.1 (hevm G e he).2.1)
    hPH hroot hτ hτ1 hHed hN ls Ψ hΨG hΨR hΨr Z
  -- one group
  have hgroup : ∀ G, ∑ b ∈ Bs G, ‖(Ms G).blockSide S hA SP b (cells G b) (c G b)‖ ^ 2 ≤
      2 * (1 + κ * D ^ 3) * (∑ e ∈ ev G, ‖(Submodule.span ℂ (((Ms G).cellMode e.2.1) ''
          (e.2.2 : Set (Ms G).Md))).starProjection ((Ms G).L.op (ap.ballAt cat r j (grp G)
            (ancAt A.G e.2.1 (e.1 - 4 * S.K)) (layerOp (ap.cumAt cat
              (ancAt A.G e.2.1 (e.1 - 4 * S.K))) ls
