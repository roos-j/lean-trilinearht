/-- Blueprint `eq:bad-density` (line 2102), the absorption step: the chain inequality with
`δ (J+1)` at least twice the per-link cost gives `k + 1 ≤ 20 (log M + A_e (1 + log M)) / δ`. -/
theorem chain_length_of_bound {δ Δ l Ae Ah Y x : ℝ} (hδ : 0 < δ) (hY : 0 < Y)
    (hx : 0 ≤ x) (hJ : 2 * (Δ + 10 * Δ * l + 10 * Ah * (1 + l)) ≤ δ * Y)
    (h : δ * x * Y ≤ x * Δ + 10 * (x * Δ * l + Y * l) + 10 * ((Y * Ae + x * Ah) * (1 + l))) :
    x ≤ 20 * (l + Ae * (1 + l)) / δ := by
  rw [le_div_iff₀ hδ]
  have h1 : x * (δ * Y) ≤ 2 * (x * (Δ + 10 * Δ * l + 10 * Ah * (1 + l))) +
      2 * (10 * Y * (l + Ae * (1 + l))) - x * (δ * Y) := by nlinarith
  have h2 : x * (2 * (Δ + 10 * Δ * l + 10 * Ah * (1 + l))) ≤ x * (δ * Y) :=
    mul_le_mul_of_nonneg_left hJ hx
  have h3 : x * (δ * Y) ≤ 20 * Y * (l + Ae * (1 + l)) := by nlinarith
  have h4 : x * δ * Y ≤ 20 * (l + Ae * (1 + l)) * Y := by nlinarith
  exact le_of_mul_le_mul_right (by linarith) hY

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

open Classical in
/-- Blueprint lines 2084-2108 for one group: splitting the blocks into three classes whose
starts differ by at least `3K`, the side events have chains of length at most
`L = ⌊20 (log |M| + A_e (1 + log |M|)) / δ_*⌋` (`eq:bad-density`), so their mode rows are
Bessel with constant `3 (L + 1) (1 + η D³)`. -/
theorem group_event_rows (Bs : Finset ℤ) (cells : ℤ → Finset (ℤ × ℤ))
    (hdepth : ∀ b ∈ Bs, ∀ J ∈ cells b, J.1 = b - 2 * S.K) (cls : ℤ → Fin 3)
    (hsep : ∀ b ∈ Bs, ∀ b' ∈ Bs, cls b = cls b' → b < b' → b + 3 * S.K ≤ b') {Ae Ah : ℕ}
    (hAe : ∀ (p : Ms.Key) (T : Finset ℤ), (∀ b ∈ T, ∀ b' ∈ T, b < b' → b + 3 * S.K ≤ b') →
      (T.filter fun b => ¬ Ms.nonexcAt S SP b p).card ≤ Ae)
    (hAh : ∀ (b : ℤ) (p : Ms.Key), Ms.nonexcAt S SP b p →
      ((Finset.range (SP.Jst + 1)).filter fun h => ¬ Ms.goodP S SP b h p).card ≤ Ah)
    (hδs : 0 < SP.δs)
    (hJ : 2 * (SP.Δ + 10 * SP.Δ * Real.log (Fintype.card Ms.Md) +
      10 * Ah * (1 + Real.log (Fintype.card Ms.Md))) ≤ SP.δs * (SP.Jst + 1))
    (hδ : 0 < Ms.δc) (hΛ : 8 * Ms.Λ ≤ S.Ξ) (hΞ : 0 < S.Ξ) (hQ0 : 0 < S.Q0) (Kf : ℕ)
    (hbox : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Eh 0) {ε D : ℝ} (hε : 0 < ε)
    (hεw : ∀ m, ε ≤ Ms.L.εM m) (hD0 : 0 ≤ D) (hD1 : ∀ y, ((Ms.ptSet y).card : ℝ) ≤ D)
    (hD2 : ∀ y, ((Ms.ptSet y).card : ℝ) ≤ ε * D ^ 2)
    [inst : ∀ (J : ℤ × ℤ) (E : Finset Ms.Md),
      (Submodule.span ℂ ((Ms.cellMode J) '' (E : Set Ms.Md))).HasOrthogonalProjection]
    (F : ColumnL2 Ms.Md) :
    ∑ e ∈ Ms.events S hA SP Bs cells,
        ‖(Submodule.span ℂ ((Ms.cellMode e.2.1) '' (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 ≤
      3 * ((⌊20 * (Real.log (Fintype.card Ms.Md) + Ae * (1 + Real.log (Fintype.card Ms.Md))) /
        SP.δs⌋₊ + 1) * ((1 + pairConst Ms.zc.dim Ms.δc S.Ξ Kf * D ^ 3) * ‖F‖ ^ 2)) := by
  set ev := Ms.events S hA SP Bs cells
  set l := Real.log (Fintype.card Ms.Md)
  set L := ⌊20 * (l + Ae * (1 + l)) / SP.δs⌋₊
  have hl : 0 ≤ l := Real.log_natCast_nonneg _
  have hclass : ∀ i : Fin 3, ∑ e ∈ ev.filter (fun e => cls e.1 = i),
      ‖(Submodule.span ℂ ((Ms.cellMode e.2.1) '' (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 ≤
        (L + 1) * ((1 + pairConst Ms.zc.dim Ms.δc S.Ξ Kf * D ^ 3) * ‖F‖ ^ 2) := by
    intro i
    set s := ev.filter (fun e => cls e.1 = i)
    have hmem : ∀ e ∈ s, e.1 ∈ Bs ∧ e.2.1 ∈ cells e.1 ∧
        e.2.2 ∈ Ms.sideEvents S hA SP e.1 e.2.1 ∧ cls e.1 = i := by
      intro e he
      obtain ⟨he1, he2⟩ := Finset.mem_filter.mp he
      exact ⟨(Ms.mem_events S hA SP he1).1, (Ms.mem_events S hA SP he1).2.1,
        (Ms.mem_events S hA SP he1).2.2, he2⟩
    refine Ms.class_rows S hA SP s (fun e he => (hmem e he).2.2.1)
      (fun e he => hdepth e.1 (hmem e he).1 e.2.1 (hmem e he).2.1) (L := L) ?_ hδ hΛ hΞ hQ0 Kf
      hbox hε hεw hD0 hD1 hD2 (inst := fun e => inst e.2.1 e.2.2) F
    intro k e hc
    have hb := Ms.chain_events_bound S hA SP s (fun e he => (hmem e he).2.2.1)
      (fun e he => hdepth e.1 (hmem e he).1 e.2.1 (hmem e he).2.1)
      (fun e he e' he' hlt => hsep e.1 (hmem e he).1 e'.1 (hmem e' he').1
        (((hmem e he).2.2.2).trans ((hmem e' he').2.2.2).symm) hlt) (M := Fintype.card Ms.Md)
      (fun U => Finset.card_image_le.trans (Finset.card_le_univ _)) (fun p T _ hT => hAe p T hT)
      hAh hc
    have hx := chain_length_of_bound (δ := SP.δs) (Δ := (SP.Δ : ℝ)) (l := l) (Ae := (Ae : ℝ))
      (Ah := (Ah : ℝ)) (Y := (SP.Jst : ℝ) + 1) (x := ((k + 1 : ℕ) : ℝ)) hδs (by positivity)
      (by positivity) hJ hb
    have hk : (k : ℝ) ≤ 20 * (l + Ae * (1 + l)) / SP.δs := by push_cast at hx; linarith
    exact Nat.le_floor hk
  have hsplit : ∑ e ∈ ev, ‖(Submodule.span ℂ ((Ms.cellMode e.2.1) ''
      (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 =
      ∑ i : Fin 3, ∑ e ∈ ev.filter (fun e => cls e.1 = i), ‖(Submodule.span ℂ
        ((Ms.cellMode e.2.1) '' (e.2.2 : Set Ms.Md))).starProjection F‖ ^ 2 :=
    (Finset.sum_fiberwise ev (fun e => cls e.1) _).symm
  rw [hsplit]
  refine (Finset.sum_le_sum fun i _ => hclass i).trans (le_of_eq ?_)
  rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  push_cast
  ring

end ModeSystem

