    (hPH : ap.bbase j + ap.P ≤ ap.Hmax) {ra rb : ℝ}
    (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r (ap.bmask I (grp q.1) j p)).card ≤ N)
    (ls : List (ℕ × Bool)) {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V)
    (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ G, ∑ e ∈ ev G, ‖(Submodule.span ℂ
        (((Ms G).evMode e) '' (e.2.2 : Set (Ms G).Md))).starProjection
        ((Ms G).L.op (ap.ballAt cat r j (grp G) (ancAt A.G e.2.1 (e.1 - Kd))
          (layerOp (ap.cumAt cat (ancAt A.G e.2.1 (e.1 - Kd))) ls
            (physicalColumnInput (cellLp A.G (ancAt A.G e.2.1 (e.1 - Kd))
              (Ψ.currentZ Z (ancAt A.G e.2.1 (e.1 - Kd))))))))‖ ^ 2 ≤
      (1 + τ * N * 1 ^ 2) * (c * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2) *
        compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * compressionC Ψ.D 1 ^ 2 *
          ‖Z‖ ^ 2 := by
  set κi := Σ G : ι, {e // e ∈ ev G}
  set u : κi → ℤ × ℤ := fun i => ancAt A.G i.2.1.2.1 (i.2.1.1 - Kd)
  set Fs := ∀ G : ι, ColumnL2 (Ms G).Md
  set Rw : κi → ColumnL2 (Fin ap.Mc) →L[ℂ] Fs := fun i =>
    (ContinuousLinearMap.single ℂ (fun G : ι => ColumnL2 (Ms G).Md) i.1).comp
      ((Submodule.span ℂ (((Ms i.1).evMode i.2.1) ''
        (i.2.1.2.2 : Set (Ms i.1).Md))).starProjection.comp
          ((Ms i.1).L.op.comp ((ap.ballAt cat r j (grp i.1) (u i)).comp
            (layerOp (ap.cumAt cat (u i)) ls))))
  have hnorm : ∀ i x, ‖Rw i x‖ = ‖(Submodule.span ℂ (((Ms i.1).evMode i.2.1) ''
      (i.2.1.2.2 : Set (Ms i.1).Md))).starProjection ((Ms i.1).L.op (ap.ballAt cat r j (grp i.1)
        (u i) (layerOp (ap.cumAt cat (u i)) ls x)))‖ := by
    intro i x
    simp only [Rw, ContinuousLinearMap.comp_apply, ContinuousLinearMap.single_apply]
    exact Pi.norm_single _
  have hB : 0 ≤ (1 + τ * N * 1 ^ 2) * (c * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2) *
      compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 := by
    have h1 : (0 : ℝ) ≤ 1 + τ * N * 1 ^ 2 := by positivity
    have h2 : 0 ≤ c * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2 :=
      mul_nonneg (mul_nonneg hc (by norm_num)) (sq_nonneg _)
    exact mul_nonneg (mul_nonneg h1 h2) (sq_nonneg _)
  have hsum : ∀ (f : κi → ℝ), ∑ i, f i = ∑ G, ∑ e ∈ ev G, (if h : e ∈ ev G then f ⟨G, ⟨e, h⟩⟩
      else 0) := by
    intro f
    rw [Fintype.sum_sigma]
    refine Finset.sum_congr rfl fun G _ => ?_
    rw [← Finset.sum_coe_sort (ev G)]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [dite_eq_left_of_eq_true (eq_true e.2)]
  have hrowsB : ∀ x, ∑ i, ‖Rw i x‖ ^ 2 ≤ ((1 + τ * N * 1 ^ 2) *
      (c * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2) *
        compressionC (ap.cumBase cat hR hb).D ls.length ^ 2) * ‖x‖ ^ 2 := by
    intro x
    have h := ap.attempt_event_rows cat t₀ hT hR hb grp hgrp k r j Ms ev Kd hu hJu hc hrows
      hcert hPH hroot hτ hτ1 hHed hN ls x
    refine le_trans (le_of_eq ?_) h
    rw [hsum]
    refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun e he => ?_
    rw [dite_eq_left_of_eq_true (eq_true he), hnorm]
  have hcellloc : ∀ i, (Rw i).comp (columnL2Restriction (dyadicGridCell A.G (u i).1 (u i).2)
      (dyadicGridCell_measurable A.G (u i).1 (u i).2)) = Rw i := by
    intro i
    refine ContinuousLinearMap.ext fun x => ?_
    simp only [Rw, ContinuousLinearMap.comp_apply]
    rw [← ap.ballAt_layer_restrict cat r j (grp i.1) (u i) ls x]
  have huR : ∀ i, dyadicGridCell A.G (u i).1 (u i).2 ⊆ dyadicGridCell A.G A.R.1 A.R.2 :=
    fun i => A.sub _ (hu i.1 i.2.1 i.2.2)
  have hblk : ∀ i x, ‖Rw i x‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition (u i).1).cells},
