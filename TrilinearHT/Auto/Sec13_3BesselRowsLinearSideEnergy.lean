/-! ### Linear sides from bounded frozen event projections (blueprint lines 2112-2118, 2160) -/

open Classical in
/-- Blueprint `eq:linear-energy` from any bound `B_ev` on the frozen event projections of all
groups: `Σ_{G,b} ‖V_{G,b}‖² ≤ 2 (1 + κ D³) (B_ev + Σ eventErr²)`. -/
theorem linear_side_of_events {Gd : RealDyadicGrid} {Mc : ℕ} {ι : Type*} [Fintype ι]
    (Ms : ι → ModeSystem Gd Mc) (S : ModeSchedule) (hA : 6 ≤ S.A0) (SP : SideParams)
    (Bs : ι → Finset ℤ) (cells : ι → ℤ → Finset (ℤ × ℤ))
    (hdepth : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, J.1 = b - 2 * S.K)
    (c : ∀ G, ℤ → ℤ × ℤ → (Ms G).Md → ℂ)
    [inst : ∀ G (J : ℤ × ℤ) (E : Finset (Ms G).Md),
      (Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).HasOrthogonalProjection]
    (hδ : ∀ G, 0 < (Ms G).δc) (hΛ : ∀ G, 8 * (Ms G).Λ ≤ S.Ξ) (hΞ : 0 < S.Ξ) (hQ0 : 0 < S.Q0)
    (Kf : ℕ) (hbox : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Eh 0) {ε D κ : ℝ} (hε : 0 < ε)
    (hεw : ∀ G m, ε ≤ (Ms G).L.εM m) (hD0 : 0 ≤ D)
    (hD1 : ∀ G, (Fintype.card (Ms G).Md : ℝ) ≤ D)
    (hD2 : ∀ G, (Fintype.card (Ms G).Md : ℝ) ≤ ε * D ^ 2)
    (hκ : ∀ G, pairConst (Ms G).zc.dim (Ms G).δc S.Ξ Kf ≤ κ) (hκ0 : 0 ≤ κ) {Bev : ℝ}
    (hev : ∑ G, ∑ b ∈ Bs G, ∑ J ∈ cells G b, ∑ E ∈ (Ms G).sideEvents S hA SP b J,
      ‖(Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
        ((Ms G).frozenEval S b J (c G b J))‖ ^ 2 ≤ Bev) :
    ∑ G, ∑ b ∈ Bs G, ‖(Ms G).blockSide S hA SP b (cells G b) (c G b)‖ ^ 2 ≤
      2 * (1 + κ * D ^ 3) * (Bev + ∑ G, ∑ b ∈ Bs G, ∑ J ∈ cells G b,
        ∑ E ∈ (Ms G).sideEvents S hA SP b J, (Ms G).eventErr S Kf ε b J E (c G b J) ^ 2) := by
  have hgroup : ∀ G, ∑ b ∈ Bs G, ‖(Ms G).blockSide S hA SP b (cells G b) (c G b)‖ ^ 2 ≤
      2 * (1 + κ * D ^ 3) * (∑ b ∈ Bs G, ∑ J ∈ cells G b, ∑ E ∈ (Ms G).sideEvents S hA SP b J,
        ‖(Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
          ((Ms G).frozenEval S b J (c G b J))‖ ^ 2 +
        ∑ b ∈ Bs G, ∑ J ∈ cells G b, ∑ E ∈ (Ms G).sideEvents S hA SP b J,
          (Ms G).eventErr S Kf ε b J E (c G b J) ^ 2) := by
    intro G
    have h := (Ms G).group_side_energy S hA SP (Bs G) (cells G) (hdepth G) (c G)
      (inst := inst G) (hδ G) (hΛ G) hΞ hQ0 Kf hbox hε (hεw G) hD0 (hD1 G) (hD2 G)
    refine h.trans ?_
    have hcoef : 2 * (1 + pairConst (Ms G).zc.dim (Ms G).δc S.Ξ Kf * D ^ 3) ≤
        2 * (1 + κ * D ^ 3) := by
      have := mul_le_mul_of_nonneg_right (hκ G) (pow_nonneg hD0 3)
      linarith
    refine (mul_le_mul_of_nonneg_right hcoef (Finset.sum_nonneg fun b _ =>
      Finset.sum_nonneg fun J _ => Finset.sum_nonneg fun E _ => by positivity)).trans
      (mul_le_mul_of_nonneg_left (le_of_eq ?_) (by positivity))
    simp only [← Finset.sum_add_distrib]
  have hc0 : 0 ≤ 2 * (1 + κ * D ^ 3) := by positivity
  refine (Finset.sum_le_sum fun G _ => hgroup G).trans ?_
  rw [← Finset.mul_sum, Finset.sum_add_distrib]
  exact mul_le_mul_of_nonneg_left (add_le_add hev le_rfl) hc0

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- Blueprint lines 2104-2108 for a basic slot whose input is the difference of two current basic
projections (`ColumnRepBelow`): the frozen event projections of all groups have total square at
most twice the sum of the two joint event-row bounds. -/
theorem events_diff_bound (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp) (hgrp : Function.Injective grp) (k r j : ℕ)
    (S : ModeSchedule) (hA : 6 ≤ S.A0) (SP : SideParams) (Ms : ι → ModeSystem A.G ap.Mc)
    (Bs : ι → Finset ℤ) (cells : ι → ℤ → Finset (ℤ × ℤ))
    (hdepth : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, J.1 = b - 2 * S.K)
    (hu : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, ancAt A.G J (b - 4 * S.K) ∈ A.cells)
    (c : ∀ G, ℤ → ℤ × ℤ → (Ms G).Md → ℂ) (ls : List (ℕ × Bool))
    {V₁ V₂ : Type} [Fintype V₁] [Fintype V₂] (Ψ₁ : ColumnDepthFamily V₁)
    (Ψ₂ : ColumnDepthFamily V₂) (hΨG₁ : Ψ₁.D.grid = A.G) (hΨG₂ : Ψ₂.D.grid = A.G)
    (hΨR₁ : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ₁.D.root.1 Ψ₁.D.root.2)
    (hΨR₂ : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ₂.D.root.1 Ψ₂.D.root.2)
    (hΨr₁ : Ψ₁.D.root.1 ≤ A.R.1) (hΨr₂ : Ψ₂.D.root.1 ≤ A.R.1) (Z₁ : ColumnL2 V₁)
    (Z₂ : ColumnL2 V₂)
    [inst : ∀ G (J : ℤ × ℤ) (E : Finset (Ms G).Md),
      (Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).HasOrthogonalProjection]
    (hfrozen : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, ∀ E ∈ (Ms G).sideEvents S hA SP b J,
      (Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
          ((Ms G).frozenEval S b J (c G b J)) =
        (Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
          ((Ms G).L.op (ap.ballAt cat r j (grp G) (ancAt A.G J (b - 4 * S.K))
            (layerOp (ap.cumAt cat (ancAt A.G J (b - 4 * S.K))) ls
              (physicalColumnInput (cellLp A.G (ancAt A.G J (b - 4 * S.K))
                (Ψ₁.currentZ Z₁ (ancAt A.G J (b - 4 * S.K)))) -
               physicalColumnInput (cellLp A.G (ancAt A.G J (b - 4 * S.K))
                (Ψ₂.currentZ Z₂ (ancAt A.G J (b - 4 * S.K)))))))))
    {cR : ℝ} (hcR : 0 ≤ cR)
    (hrows : ∀ G (F : ColumnL2 (Ms G).Md), ∑ e ∈ (Ms G).events S hA SP (Bs G) (cells G),
      ‖(Submodule.span ℂ (((Ms G).cellMode e.2.1) '' (e.2.2 : Set (Ms G).Md))).starProjection
        F‖ ^ 2 ≤ cR * ‖F‖ ^ 2)
    (hcert : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G (ancAt A.G J (b - 4 * S.K)).1
        (ancAt A.G J (b - 4 * S.K)).2 ∧
      ∃ w ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) w) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') w = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') w = grp G)
    (hPH : ap.bbase j + ap.P ≤ ap.Hmax) {ra rb : ℝ}
    (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r (ap.bmask I (grp q.1) j p)).card ≤ N) :
    ∑ G, ∑ b ∈ Bs G, ∑ J ∈ cells G b, ∑ E ∈ (Ms G).sideEvents S hA SP b J,
      ‖(Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
        ((Ms G).frozenEval S b J (c G b J))‖ ^ 2 ≤
      2 * ((1 + τ * N * 1 ^ 2) * (cR * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2) *
          compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * compressionC Ψ₁.D 1 ^ 2 *
            ‖Z₁‖ ^ 2) +
        2 * ((1 + τ * N * 1 ^ 2) * (cR * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2) *
          compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * compressionC Ψ₂.D 1 ^ 2 *
            ‖Z₂‖ ^ 2) := by
  have hevm := fun G e (he : e ∈ (Ms G).events S hA SP (Bs G) (cells G)) =>
    (Ms G).mem_events S hA SP he
  have h1 := ap.attempt_event_rows_basic cat t₀ hT hR hb grp hgrp k r j Ms
    (fun G => (Ms G).events S hA SP (Bs G) (cells G)) (4 * S.K)
    (fun G e he => hu G e.1 (hevm G e he).1 e.2.1 (hevm G e he).2.1)
    (fun G e he => by
      have := hdepth G e.1 (hevm G e he).1 e.2.1 (hevm G e he).2.1
      have hK : (0 : ℤ) ≤ S.K := Nat.cast_nonneg _
      omega)
    (inst := fun G e => inst G e.2.1 e.2.2) hcR hrows
    (fun G e he => hcert G e.1 (hevm G e he).1 e.2.1 (hevm G e he).2.1)
    hPH hroot hτ hτ1 hHed hN ls Ψ₁ hΨG₁ hΨR₁ hΨr₁ Z₁
  have h2 := ap.attempt_event_rows_basic cat t₀ hT hR hb grp hgrp k r j Ms
    (fun G => (Ms G).events S hA SP (Bs G) (cells G)) (4 * S.K)
    (fun G e he => hu G e.1 (hevm G e he).1 e.2.1 (hevm G e he).2.1)
    (fun G e he => by
      have := hdepth G e.1 (hevm G e he).1 e.2.1 (hevm G e he).2.1
      have hK : (0 : ℤ) ≤ S.K := Nat.cast_nonneg _
      omega)
    (inst := fun G e => inst G e.2.1 e.2.2) hcR hrows
    (fun G e he => hcert G e.1 (hevm G e he).1 e.2.1 (hevm G e he).2.1)
    hPH hroot hτ hτ1 hHed hN ls Ψ₂ hΨG₂ hΨR₂ hΨr₂ Z₂
  rw [Finset.sum_congr rfl fun G _ => (Ms G).sum_events S hA SP (Bs G) (cells G) _] at h1 h2
  set a1 : ∀ G, ℤ → ℤ × ℤ → Finset (Ms G).Md → ColumnL2 (Ms G).Md := fun G b J E =>
    (Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
      ((Ms G).L.op (ap.ballAt cat r j (grp G) (ancAt A.G J (b - 4 * S.K))
        (layerOp (ap.cumAt cat (ancAt A.G J (b - 4 * S.K))) ls
          (physicalColumnInput (cellLp A.G (ancAt A.G J (b - 4 * S.K))
            (Ψ₁.currentZ Z₁ (ancAt A.G J (b - 4 * S.K))))))))
  set a2 : ∀ G, ℤ → ℤ × ℤ → Finset (Ms G).Md → ColumnL2 (Ms G).Md := fun G b J E =>
    (Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
      ((Ms G).L.op (ap.ballAt cat r j (grp G) (ancAt A.G J (b - 4 * S.K))
        (layerOp (ap.cumAt cat (ancAt A.G J (b - 4 * S.K))) ls
          (physicalColumnInput (cellLp A.G (ancAt A.G J (b - 4 * S.K))
            (Ψ₂.currentZ Z₂ (ancAt A.G J (b - 4 * S.K))))))))
  have hpt : ∀ G, ∀ b ∈ Bs G, ∀ J ∈ cells G b, ∀ E ∈ (Ms G).sideEvents S hA SP b J,
      ‖(Submodule.span ℂ (((Ms G).cellMode J) '' (E : Set (Ms G).Md))).starProjection
        ((Ms G).frozenEval S b J (c G b J))‖ ^ 2 ≤
      2 * ‖a1 G b J E‖ ^ 2 + 2 * ‖a2 G b J E‖ ^ 2 := by
    intro G b hb J hJ E hE
    rw [hfrozen G b hb J hJ E hE, map_sub, map_sub, map_sub, map_sub]
    change ‖a1 G b J E - a2 G b J E‖ ^ 2 ≤ _
    have := norm_sub_le (a1 G b J E) (a2 G b J E)
    nlinarith [norm_nonneg (a1 G b J E), norm_nonneg (a2 G b J E),
      norm_nonneg (a1 G b J E - a2 G b J E), sq_nonneg (‖a1 G b J E‖ - ‖a2 G b J E‖)]
  calc _ ≤ ∑ G, ∑ b ∈ Bs G, ∑ J ∈ cells G b, ∑ E ∈ (Ms G).sideEvents S hA SP b J,
        (2 * ‖a1 G b J E‖ ^ 2 + 2 * ‖a2 G b J E‖ ^ 2) :=
        Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun b hb => Finset.sum_le_sum fun J hJ =>
          Finset.sum_le_sum fun E hE => hpt G b hb J hJ E hE
    _ = 2 * ∑ G, ∑ b ∈ Bs G, ∑ J ∈ cells G b, ∑ E ∈ (Ms G).sideEvents S hA SP b J,
          ‖a1 G b J E‖ ^ 2 + 2 * ∑ G, ∑ b ∈ Bs G, ∑ J ∈ cells G b,
          ∑ E ∈ (Ms G).sideEvents S hA SP b J, ‖a2 G b J E‖ ^ 2 := by
        simp only [Finset.sum_add_distrib, Finset.mul_sum]
    _ ≤ _ := by
        gcongr
        · exact h1
        · exact h2

/-! ### The linear sides of a basic leaf slot (blueprint lines 2104-2118, 2160) -/

/-- The layered leaf input of a basic slot at a cell of the root, as the layered difference of the
two root-restricted basic projections. -/
theorem leafIn_eq_sub_root (cat : Fin 4 → List (CatCol A.Vtx)) (s : ℕ) (l : Fin 4) {U : ℤ × ℤ}
    (hU : U ∈ A.cells) (hz : ap.z U l = A.B l U) {CF : ℝ} (P₁ P₂ : BasicProjection A.G A.R CF)
    (hP : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G U.1 U.2 → A.B l U y = P₁.val U y - P₂.val U y)
    (hPN₁ : A.R.1 ≤ P₁.Ψ.N) (hPN₂ : A.R.1 ≤ P₂.Ψ.N) :
    ap.leafIn cat s l U =
      layerOp (ap.cumAt (cat l) U) ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l)
        (physicalColumnInput (cellLp A.G U (P₁.Ψ.currentZ (columnL2Restriction
            (dyadicGridCell A.G A.R.1 A.R.2) (dyadicGridCell_measurable A.G A.R.1 A.R.2) P₁.Z) U)) -
          physicalColumnInput (cellLp A.G U (P₂.Ψ.currentZ (columnL2Restriction
            (dyadicGridCell A.G A.R.1 A.R.2) (dyadicGridCell_measurable A.G A.R.1 A.R.2) P₂.Z) U)))
    := by
  have hr : ∀ P : BasicProjection A.G A.R CF, P.Ψ.D.root.1 ≤ A.R.1 := fun P =>
    dyadicGridCell_depth_le_of_subset A.G A.R P.Ψ.D.root P.root_sub
  rw [ap.leafIn_eq_sub cat s l U hz P₁ P₂ hP, ← map_sub,
    physicalColumnInput_inj (P₁.Ψ.currentZ_restrict_root P₁.grid P₁.root_sub (hr P₁) hPN₁
      (A.sub U hU) P₁.Z),
    physicalColumnInput_inj (P₂.Ψ.currentZ_restrict_root P₂.grid P₂.root_sub (hr P₂) hPN₂
      (A.sub U hU) P₂.Z)]

namespace LeafSplit
