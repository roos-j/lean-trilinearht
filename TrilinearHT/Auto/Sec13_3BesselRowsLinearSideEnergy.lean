      fun b => fp.retainedV (grp G) b S.K).filter (fun e => A.R.1 ≤ e.1 - 4 * S.K),
    ‖(Submodule.span ℂ (((Ms G).cellMode e.2.1) '' (e.2.2 : Set (Ms G).Md))).starProjection
      ((L G).op (fp.basicOut l s mb (grp G) j ls (ancAt A.G e.2.1 (e.1 - 4 * S.K)).1))‖ ^ 2
