  choose c hc using hcex
  refine ⟨c, fun G b _ J hJ => (hc G b J hJ).1, fun G b _ J hJ => (hc G b J hJ).2, ?_⟩
  -- the span projections of the events
  have inst : ∀ G (J : ℤ × ℤ) (E : Finset (Ms G).Md),
