/-- Catalog ball projections at active cells are column projections of the complete tree. -/
theorem catProj_full_ball (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (p : ℕ) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    catProj A.G ap.Mc cat I r (ap.bmask I G j p) = cellColumnProjection
      (ap.cumBase cat hR hb).D (ap.ballFam cat hR hb r j G p).A (A.cells_mem_tree hI) := by
  have h := catProj_eq_cellColumnProjection (G := A.G) (T := dyadicFiniteTree A.G A.R A.treeDepth)
    (root := A.R) (hbr := dyadicFiniteTree_below A.G A.R A.treeDepth)
    (hroot := root_mem_dyadicFiniteTree A.G A.R A.treeDepth) (s := cat) (Mc := ap.Mc)
    (hb := births_tree hb) r (fun c => ap.bmask (deepestIn A.G A.cells c) G j p)
    (fun c _ d hd hcd x hx => extMask_mono A.G A.cells hR (fun c => ap.bmask c G j p)
      (fun _ hc _ hd hcd x hx => ap.bmask_mono hc hd hcd G j p x hx)
      (dyadicFiniteTree_below A.G A.R A.treeDepth d hd) hcd x hx) (A.cells_mem_tree hI)
  simp only [deepestIn_of_mem A.G A.cells hI] at h
  exact h

/-- Catalog cumulative projections at active cells are column projections of the complete
tree. -/
theorem catProj_full_cum (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (p : Fin ap.P) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    catProj A.G ap.Mc cat I (ap.Lc - m + 1) (ap.cmask I m p) = cellColumnProjection
      (ap.cumBase cat hR hb).D (ap.cumMask cat hR hb m p) (A.cells_mem_tree hI) := by
  have h := catProj_eq_cellColumnProjection (G := A.G) (T := dyadicFiniteTree A.G A.R A.treeDepth)
    (root := A.R) (hbr := dyadicFiniteTree_below A.G A.R A.treeDepth)
    (hroot := root_mem_dyadicFiniteTree A.G A.R A.treeDepth) (s := cat) (Mc := ap.Mc)
    (hb := births_tree hb) (ap.Lc - m + 1) (fun c => ap.cmask (deepestIn A.G A.cells c) m p)
    (fun c _ d hd hcd x hx => extMask_mono A.G A.cells hR (fun c => ap.cmask c m p)
      (fun _ hc _ hd hcd x hx => ap.cmask_mono hc hd hcd m p x hx)
      (dyadicFiniteTree_below A.G A.R A.treeDepth d hd) hcd x hx) (A.cells_mem_tree hI)
  simp only [deepestIn_of_mem A.G A.cells hI] at h
  exact h

open Classical in
/-- Blueprint lines 2104-2108 with `lem:lift-composition` (lines 2062-2077): event rows of the
groups (projections onto the mode spans of the events, after the mode lift of the group), Bessel
with constant `c` within each group and with decision cells the active ancestors `u_e` of the
event cells, are jointly Bessel over all groups after inserting the averaged ball projections and
cumulative histories at their decision cells. -/
theorem attempt_event_rows (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp) (hgrp : Function.Injective grp) (k r j : ℕ)
    (Ms : ι → ModeSystem A.G ap.Mc) (ev : ∀ G, Finset (Ms G).Event) (Kd : ℤ)
    (hu : ∀ G, ∀ e ∈ ev G, ancAt A.G e.2.1 (e.1 - Kd) ∈ A.cells)
    (hJu : ∀ G, ∀ e ∈ ev G, e.1 - Kd ≤ e.2.1.1)
    [inst : ∀ G (e : (Ms G).Event), (Submodule.span ℂ
      (((Ms G).evMode e) '' (e.2.2 : Set (Ms G).Md))).HasOrthogonalProjection]
    {c : ℝ} (hc : 0 ≤ c)
    (hrows : ∀ G (F : ColumnL2 (Ms G).Md), ∑ e ∈ ev G, ‖(Submodule.span ℂ
      (((Ms G).evMode e) '' (e.2.2 : Set (Ms G).Md))).starProjection F‖ ^ 2 ≤ c * ‖F‖ ^ 2)
    (hcert : ∀ G, ∀ e ∈ ev G, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G (ancAt A.G e.2.1 (e.1 - Kd)).1
        (ancAt A.G e.2.1 (e.1 - Kd)).2 ∧
      ∃ w ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) w) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') w = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') w = grp G)
    (hPH : ap.bbase j + ap.P ≤ ap.Hmax) {ra rb : ℝ}
    (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r (ap.bmask I (grp q.1) j p)).card ≤ N)
    (ls : List (ℕ × Bool)) (z : ColumnL2 (Fin ap.Mc)) :
    ∑ G, ∑ e ∈ ev G, ‖(Submodule.span ℂ
        (((Ms G).evMode e) '' (e.2.2 : Set (Ms G).Md))).starProjection
        ((Ms G).L.op (ap.ballAt cat r j (grp G) (ancAt A.G e.2.1 (e.1 - Kd))
          (layerOp (ap.cumAt cat (ancAt A.G e.2.1 (e.1 - Kd))) ls z)))‖ ^ 2 ≤
      (1 + τ * N * 1 ^ 2) * (c * 5 * compression1 (ap.cumBase cat hR hb).D ^ 2) *
        compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * ‖z‖ ^ 2 := by
  set D := (ap.cumBase cat hR hb).D
  set u : ∀ G, {e // e ∈ ev G} → ℤ × ℤ := fun G e => ancAt A.G e.1.2.1 (e.1.1 - Kd)
  have hu' : ∀ G e, u G e ∈ A.cells := fun G e => hu G e.1 e.2
  set Q : ∀ G, {e // e ∈ ev G} → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Ms G).Md := fun G e =>
    (Submodule.span ℂ (((Ms G).evMode e.1) '' (e.1.2.2 : Set (Ms G).Md))).starProjection.comp
      (Ms G).L.op
  have hQ : ∀ G x, ∑ e ∈ (Finset.univ : Finset {e // e ∈ ev G}), ‖Q G e x‖ ^ 2 ≤
      (c * 5) * ‖x‖ ^ 2 := by
    intro G x
    have h1 := hrows G ((Ms G).L.op x)
    have h2 := (Ms G).L.norm_op_le x
    have h3 : ‖(Ms G).L.op x‖ ^ 2 ≤ 5 * ‖x‖ ^ 2 := by
      have := pow_le_pow_left₀ (norm_nonneg _) h2 2
      rwa [mul_pow, Real.sq_sqrt (by norm_num)] at this
    calc ∑ e ∈ (Finset.univ : Finset {e // e ∈ ev G}), ‖Q G e x‖ ^ 2 =
        ∑ e ∈ ev G, ‖(Submodule.span ℂ
          (((Ms G).evMode e) '' (e.2.2 : Set (Ms G).Md))).starProjection
          ((Ms G).L.op x)‖ ^ 2 :=
          Finset.sum_coe_sort (ev G) (fun e => ‖(Submodule.span ℂ (((Ms G).evMode e) ''
            (e.2.2 : Set (Ms G).Md))).starProjection ((Ms G).L.op x)‖ ^ 2)
      _ ≤ c * ‖(Ms G).L.op x‖ ^ 2 := h1
      _ ≤ c * (5 * ‖x‖ ^ 2) := mul_le_mul_of_nonneg_left h3 hc
      _ = c * 5 * ‖x‖ ^ 2 := by ring
  have hloc : ∀ G, ∀ e ∈ (Finset.univ : Finset {e // e ∈ ev G}), (Q G e).comp
      (columnL2Restriction (dyadicGridCell A.G (u G e).1 (u G e).2)
        (dyadicGridCell_measurable A.G (u G e).1 (u G e).2)) = Q G e := by
    intro G e _
    have hJu' : e.1.2.1.1 ≥ e.1.1 - Kd := hJu G e.1 e.2
    have hsub : dyadicGridCell A.G e.1.2.1.1 e.1.2.1.2 ⊆
        dyadicGridCell A.G (u G e).1 (u G e).2 := subset_ancAt A.G e.1.2.1 hJu'
    refine ContinuousLinearMap.ext fun x => ?_
    simp only [Q, ContinuousLinearMap.comp_apply]
    rw [LiftData.op_restrict]
    refine starProjection_restrict_eq _ _ _ (span_augMode_restrict hsub
      (dyadicGridCell_measurable A.G (u G e).1 (u G e).2) _ (fun m => ?_) _) _
    exact augMode_toLp_vanish (dyadicGridCell_measurable A.G e.1.2.1.1 e.1.2.1.2)
      (dyadicGridCell_volume_ne_top A.G e.1.2.1) (modeWave_measurable _ _ _ _ _ _ _)
      (modeWave_norm_le _ _ _ _ _ _ _) _ m
  have h := ap.lift_composition_catalog cat t₀ hT grp hgrp k r j D
    (fun G => ColumnL2 (Ms G).Md) (fun G => (Finset.univ : Finset {e // e ∈ ev G})) u hu'
    (fun G e => A.cells_mem_tree (hu' G e)) rfl
    (fun G p => ⟨(ap.ballFam cat hR hb r j (grp G) p).A, fun e =>
      ap.catProj_full_ball cat hR hb r j (grp G) p (hu' G e)⟩)
    (ap.cumMask cat hR hb) (fun G e m p => ap.catProj_full_cum cat hR hb m p (hu' G e))
    Q (by positivity) hQ hloc (fun G e _ => hcert G e.1 e.2) hPH hroot hτ hτ1 hHed (N := N) ?_ ls z
  · refine le_trans (le_of_eq ?_) h
    refine Finset.sum_congr rfl fun G _ => ?_
    exact (Finset.sum_coe_sort (ev G) (fun e => ‖(Submodule.span ℂ (((Ms G).evMode e) ''
      (e.2.2 : Set (Ms G).Md))).starProjection ((Ms G).L.op (ap.ballAt cat r j (grp G)
        (ancAt A.G e.2.1 (e.1 - Kd)) (layerOp (ap.cumAt cat (ancAt A.G e.2.1 (e.1 - Kd)))
          ls z)))‖ ^ 2)).symm
  · intro y
    refine le_trans (Finset.card_le_card fun q hq => ?_) (hN y)
    obtain ⟨-, e, -, p, hy, hv⟩ := Finset.mem_filter.mp hq
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, u q.1 e, hu' q.1 e, p, hy, hv⟩

end AttemptParams

