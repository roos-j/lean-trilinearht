/-- Blueprint lem:variation (`eq:variation`) for depth-indexed operator families on a basic
projection: if the restricted fixed-input jumps over disjoint depth intervals are Bessel with
constant `B`, the operators commute with the restrictions to the active cells above their depth
and are contractions, then the variation of their outputs on `E P_h Z` is at most
`2 B C_Ψ² ‖Z‖² + 2 ‖Z‖²`. -/
theorem op_variation {W : Type*} [Fintype W] {ι : Type*} [Fintype ι]
    (Op : ι → ℤ → ColumnL2 W →L[ℂ] ColumnL2 W) (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (htd : ∀ i, t i ≤ A.treeDepth)
    (Ec : ι → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells)
    {B : ℝ} (hB : 0 ≤ B)
    (hrows : ∀ x, ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
      ((Op i (A.R.1 + t i) - Op i (A.R.1 + r i)) x)‖ ^ 2 ≤ B * ‖x‖ ^ 2)
    (hcomm : ∀ i (h : ℤ) (Q : ℤ × ℤ), Q.1 ≤ h → h ≤ A.R.1 + A.treeDepth →
      (Op i h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)) =
      (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (Op i h))
    (hcontr : ∀ i h y, ‖Op i h y‖ ≤ ‖y‖)
    {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V) (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
      (Op i (A.R.1 + t i) (physEmbed V W (Ψ.proj (A.R.1 + t i) Z)) -
        Op i (A.R.1 + r i) (physEmbed V W (Ψ.proj (A.R.1 + r i) Z)))‖ ^ 2 ≤
      2 * (B * compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) + 2 * ‖Z‖ ^ 2 := by
  set rE : ι → ColumnL2 W →L[ℂ] ColumnL2 W := fun i =>
    columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2) with hrE
  have hEm : ∀ i, MeasurableSet (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2) := fun i =>
    Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2
  have hblk : ∀ i x, ‖rE i ((Op i (A.R.1 + t i) - Op i (A.R.1 + r i)) x)‖ ^ 2 =
      ∑ Q : {Q // Q ∈ (Ψ.partition (A.R.1 + r i)).cells},
        ‖rE i ((Op i (A.R.1 + t i) - Op i (A.R.1 + r i))
          (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
            (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x))‖ ^ 2 := by
    intro i x
    refine Ψ.blk_of_commute (A.R.1 + r i) ((rE i).comp (Op i (A.R.1 + t i) - Op i (A.R.1 + r i)))
      (fun y => ?_) (fun Q hQ => ?_) x
    · filter_upwards [columnL2Restriction_vanish _ (hEm i)
        ((Op i (A.R.1 + t i) - Op i (A.R.1 + r i)) y)] with z hz hzR
      refine hz fun hzE => hzR ?_
      rw [Set.mem_iUnion₂] at hzE
      obtain ⟨I, hI, hzI⟩ := hzE
      rw [hΨG]
      exact hΨR (A.sub I (hEc i I hI) hzI)
    · have hQ1 := ((Ψ.mem_partition _ Q).mp hQ).1
      have hle : Ψ.depth (A.R.1 + r i) ≤ A.R.1 + r i := by
        unfold ColumnDepthFamily.depth
        exact max_le (by omega) (min_le_left _ _)
      have hQr : Q.1 ≤ A.R.1 + r i := hQ1 ▸ hle
      have h1 := hcomm i (A.R.1 + t i) Q (by have := hrt i; omega) (by have := htd i; omega)
      have h2 := hcomm i (A.R.1 + r i) Q hQr (by have := hrt i; have := htd i; omega)
      have hc := columnL2Restriction_comm (V := W) (hEm i) (dyadicGridCell_measurable A.G Q.1 Q.2)
      rw [hΨG, ContinuousLinearMap.comp_assoc, ContinuousLinearMap.sub_comp, h1, h2,
        ← ContinuousLinearMap.comp_sub, ← ContinuousLinearMap.comp_assoc,
        ← ContinuousLinearMap.comp_assoc, hc]
  have hjoint : ∑ i, ‖rE i (Op i (A.R.1 + t i)
      (physEmbed V W ((Ψ.proj (A.R.1 + t i) - Ψ.proj (A.R.1 + r i)) Z)))‖ ^ 2 ≤ ‖Z‖ ^ 2 := by
    refine le_trans (Finset.sum_le_sum fun i _ => ?_) (Ψ.jumps_from_le hΨr r t hrt hdis Z)
    refine pow_le_pow_left₀ (norm_nonneg _) ?_ 2
    exact ((pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp
      (columnL2Restriction_norm_sq_le _ _ _)).trans ((hcontr _ _ _).trans
        (norm_physEmbed_apply_le _))
  exact basic_variation Ψ rE Op (fun i => A.R.1 + r i) (fun i => A.R.1 + t i) hB hrows hblk Z
    hjoint

