/-- Blueprint `eq:whole-ranges` (line 1867) for the global ball outputs of one depth: the outputs
of the groups, restricted to unions of certified cells of that depth, are jointly Bessel with
constant `1 + τN`. -/
theorem globOut_joint (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (ls : List (ℕ × Bool)) (ht : ℤ) (Ec : ι → Finset (ℤ × ℤ))
    (hEc : ∀ G, ∀ I ∈ Ec G, I ∈ A.cells ∧ I.1 = ht)
    (hcert : ∀ G, ∀ I ∈ Ec G, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    (w : ColumnL2 (Fin ap.Mc)) :
    ∑ G, ‖columnL2Restriction (⋃ I ∈ Ec G, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.globOutL cat hR hb r₀ j (grp G) ls ht w)‖ ^ 2 ≤ (1 + τ * N * 1 ^ 2) * ‖w‖ ^ 2 := by
  have hp := ap.hP
  have : Nonempty (Fin ap.P) := ⟨⟨0, hp⟩⟩
  set H := globHist (ap.cumBase cat hR hb) (ap.cumMask cat hR hb) ls ht w
  set rE : ι → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) := fun G =>
    columnL2Restriction (⋃ I ∈ Ec G, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hC : (0 : ℝ) ≤ 1 + τ * N * 1 ^ 2 := by positivity
  have hpad : ∀ p : Fin ap.P, ∑ G, ‖rE G ((ap.ballFam cat hR hb r₀ j (grp G) p).proj ht H)‖ ^ 2 ≤
      (1 + τ * N * 1 ^ 2) * ‖w‖ ^ 2 := by
    intro p
    have hj := joint_bessel_of_wholeRanges (Finset.univ : Finset ι) (fun G => G)
      (fun G => (rE G).comp ((ap.ballFam cat hR hb r₀ j (grp G) p).proj ht))
      (fun G h' => by
        rw [Finset.sum_eq_single_of_mem G (by simp) (fun b hb hne => by
          exact absurd (Finset.mem_filter.mp hb).2 hne)]
        have h1 : ‖((rE G).comp ((ap.ballFam cat hR hb r₀ j (grp G) p).proj ht)) h'‖ ≤ ‖h'‖ := by
          simp only [ContinuousLinearMap.comp_apply, rE]
          exact (columnL2Indicator_norm_le _ (Finset.measurableSet_biUnion _ fun I _ =>
            dyadicGridCell_measurable A.G I.1 I.2) _).trans (starProjection_norm_apply_le _
              ((ap.ballFam cat hR hb r₀ j (grp G) p).isStarProjection_proj ht) h')
        exact pow_le_pow_left₀ (norm_nonneg _) h1 2)
      hC (fun x => ap.attempt_wr2 cat t₀ hT hR hb grp hgrp k r₀ j hPH ht Ec hEc hcert hroot hτ
        hτ1 hHed hN p x) H
    refine hj.trans (mul_le_mul_of_nonneg_left ?_ hC)
    exact pow_le_pow_left₀ (norm_nonneg _) (globHist_norm_le _ hp _ ls ht w) 2
  have h := rows_uniformAvg_le rE
    (fun G (p : Fin ap.P) => (ap.ballFam cat hR hb r₀ j (grp G) p).proj ht H)
    hpad
  refine le_trans (le_of_eq ?_) h
  refine Finset.sum_congr rfl fun G _ => ?_
  simp only [globOutL, ContinuousLinearMap.comp_apply, opAvg, Fintype.card_fin, smul_apply,
    FunLike.coe_sum, Finset.sum_apply, rE, H]

