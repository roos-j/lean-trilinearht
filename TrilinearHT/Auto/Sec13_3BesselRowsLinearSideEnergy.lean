  swap
  · convert hNq using 0
  have hG0 := fp.liftConst_le_G0 l s mb ls
    (c := 6 * (⌊180 * S.dmax * Real.log (2 * S.Dm) / δs⌋₊ + 1)) (by positivity) hτ hτN cc hcc
    hkq hDmq hDb hn
