/-! ### Global filters of the transfer steps (blueprint lines 2386-2391) -/

/-- The global averaged cumulative filter of the layer `m` at depth `h`. -/
noncomputable def gCum (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  opAvg fun p : Fin ap.P => ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h

/-- The global positive chain of cumulative filters at depth `h` (outermost first). -/
noncomputable def gChain (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (ms : List ℕ) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  chainOp (fun m => ap.gCum cat hR hb m h) ms

/-- The global averaged ball filter at depth `h`. -/
noncomputable def gBall (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  opAvg fun p : Fin ap.P => (ap.ballFam cat hR hb r j G p).proj h

/-- A single cumulative pad projection at an active cell is the restriction of the global one. -/
theorem gCumPad_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (p : Fin ap.P) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj I.1) =
      (catProj A.G ap.Mc cat I (ap.Lc - m + 1) (ap.cmask I m p)).comp
        (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2)) := by
  rw [ap.cumMask_restrict cat hR hb m p hI,
    (catProj_restrict A.G ap.Mc cat I (ap.Lc - m + 1) (ap.cmask I m p)).1]

/-- A single ball pad projection at an active cell is the restriction of the global one. -/
theorem gBallPad_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (p : ℕ) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      ((ap.ballFam cat hR hb r j G p).proj I.1) =
      (catProj A.G ap.Mc cat I r (ap.bmask I G j p)).comp
        (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2)) := by
  rw [(ap.ballFam_restrict cat hR hb r j G p hI).1,
    (catProj_restrict A.G ap.Mc cat I r (ap.bmask I G j p)).1]

/-- The global cumulative filter restricts to the cell filter. -/
theorem gCum_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      (ap.gCum cat hR hb m I.1) =
      (ap.cumAt cat I m).comp (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)) :=
  opAvg_intertwine _ _ _ fun p => ap.gCumPad_restrict cat hR hb m p hI

/-- The global chain restricts to the cell chain. -/
theorem gChain_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    ∀ ms : List ℕ,
      (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)).comp (ap.gChain cat hR hb ms I.1) =
      (chainOp (ap.cumAt cat I) ms).comp (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2))
  | [] => by simp [gChain, chainOp]
  | m :: ms => by
    have ih := gChain_restrict cat hR hb hI ms
    change _ = ((ap.cumAt cat I m).comp (chainOp (ap.cumAt cat I) ms)).comp _
    change (columnL2Restriction _ _).comp ((ap.gCum cat hR hb m I.1).comp
      (ap.gChain cat hR hb ms I.1)) = _
    rw [← ContinuousLinearMap.comp_assoc, ap.gCum_restrict cat hR hb m hI,
      ContinuousLinearMap.comp_assoc, ih, ContinuousLinearMap.comp_assoc]

/-- The global ball filter restricts to the cell ball filter. -/
theorem gBall_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      (ap.gBall cat hR hb r j G I.1) =
      (ap.ballAt cat r j G I).comp (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)) :=
  opAvg_intertwine _ _ _ fun p => ap.gBallPad_restrict cat hR hb r j G p hI

/-- The chain value of a basic slot at a cell is the restriction of the global chain value. -/
theorem chain_eq_global (cat : Fin 4 → List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (l : Fin 4) (hb : ∀ d ∈ cat l, d.birth ∈ A.cells) (ms : List ℕ) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) (hz : ap.z I l = A.B l I) {CF : ℝ} (P₁ P₂ : BasicProjection A.G A.R CF)
    (hP : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → A.B l I y = P₁.val I y - P₂.val I y) :
    chainOp (ap.cumAt (cat l) I) ms (physicalColumnInput (ap.base I l)) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (ap.gChain (cat l) hR hb ms I.1 (ap.gIn P₁ P₂ I.1)) := by
  rw [ap.base_eq_gIn l hI hz P₁ P₂ hP, ← ContinuousLinearMap.comp_apply,
    ← ap.gChain_restrict (cat l) hR hb hI ms, ContinuousLinearMap.comp_apply]

/-- The ball of a chain value of a basic slot at a cell is the restriction of the global one. -/
theorem ballChain_eq_global (cat : Fin 4 → List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (l : Fin 4) (hb : ∀ d ∈ cat l, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ms : List ℕ)
    {I : ℤ × ℤ} (hI : I ∈ A.cells) (hz : ap.z I l = A.B l I) {CF : ℝ}
    (P₁ P₂ : BasicProjection A.G A.R CF)
    (hP : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → A.B l I y = P₁.val I y - P₂.val I y) :
    ap.ballAt (cat l) r j G I (chainOp (ap.cumAt (cat l) I) ms (physicalColumnInput (ap.base I l)))
      = columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (ap.gBall (cat l) hR hb r j G I.1 (ap.gChain (cat l) hR hb ms I.1 (ap.gIn P₁ P₂ I.1))) := by
  rw [ap.chain_eq_global cat hR l hb ms hI hz P₁ P₂ hP, ← ContinuousLinearMap.comp_apply
    (ap.ballAt (cat l) r j G I), ← ap.gBall_restrict (cat l) hR hb r j G hI,
    ContinuousLinearMap.comp_apply]

/-! ### Variation of the global positive chains (blueprint lines 2390-2391, lem:variation) -/

/-- The global chain is the global history of its positive layers. -/
theorem gChain_eq_globHist (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (ms : List ℕ) (h : ℤ) :
    ap.gChain cat hR hb ms h =
      globHist (ap.cumBase cat hR hb) (ap.cumMask cat hR hb) (chainHist ms 0) h := by
  unfold gChain globHist
  rw [layerOp_chainHist, List.drop_zero]
  rfl

/-- The global chain commutes with the restrictions to cells at most as deep as its depth. -/
theorem gChain_commute (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (ms : List ℕ) (h : ℤ) {Q : ℤ × ℤ}
    (hQ : Q.1 ≤ (ap.cumBase cat hR hb).depth h) :
    (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (ap.gChain cat hR hb ms h) =
    (ap.gChain cat hR hb ms h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)) := by
  set rQ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G Q.1 Q.2)
    (dyadicGridCell_measurable A.G Q.1 Q.2)
  have hcum : ∀ m, (opAvg fun p : Fin ap.P =>
      ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h).comp rQ =
      rQ.comp (opAvg fun p : Fin ap.P =>
        ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h) := fun m =>
    opAvg_commute _ _ fun p =>
      (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj_commute_restrict h
        hQ).symm
  rw [ap.gChain_eq_globHist]
  exact (layerOp_commute _ rQ hcum (chainHist ms 0)).symm

/-- Blueprint lem:variation for the shared positive chains acting on a basic projection: the
variation of the global chain values over disjoint depth intervals, restricted at the right
endpoints to unions of active cells, is at most `2 B C_Ψ² ‖Z‖² + 2 ‖Z‖²` with the chain compression
`B = |ms| Σ_m C_m²`. -/
theorem chain_variation_basic (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (ms : List ℕ) {ι : Type*} [Fintype ι] (r t : ι → ℕ)
    (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (htd : ∀ i, t i ≤ A.treeDepth) (Ec : ι → Finset (ℤ × ℤ))
    (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells) {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V)
    (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.gChain cat hR hb ms (A.R.1 + t i) (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + t i) Z)) -
          ap.gChain cat hR hb ms (A.R.1 + r i)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + r i) Z)))‖ ^ 2 ≤
      2 * ((chainHist ms 0).length * (∑ m ∈ Finset.range (chainHist ms 0).length,
          compressionC (ap.cumBase cat hR hb).D m ^ 2) * compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) +
        2 * ‖Z‖ ^ 2 := by
  set B := (chainHist ms 0).length * (∑ m ∈ Finset.range (chainHist ms 0).length,
    compressionC (ap.cumBase cat hR hb).D m ^ 2)
  have hB : 0 ≤ B := by
    have : 0 ≤ ∑ m ∈ Finset.range (chainHist ms 0).length,
        compressionC (ap.cumBase cat hR hb).D m ^ 2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
    positivity
  set E := fun i => columnL2Restriction (V := Fin ap.Mc) (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hEm : ∀ i, MeasurableSet (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2) := fun i =>
    Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2
  have hrows : ∀ x, ∑ i, ‖E i ((ap.gChain cat hR hb ms (A.R.1 + t i) -
      ap.gChain cat hR hb ms (A.R.1 + r i)) x)‖ ^ 2 ≤ B * ‖x‖ ^ 2 := by
    intro x
    refine le_trans (Finset.sum_le_sum fun i _ => columnL2Restriction_norm_sq_le _ (hEm i) _) ?_
    have h := globHist_jump (ap.cumBase cat hR hb) ap.hP (ap.cumMask cat hR hb) (chainHist ms 0)
      r t hrt hdis x
    simp only [sub_apply, ap.gChain_eq_globHist]
    exact h
  have hblk : ∀ i x, ‖E i ((ap.gChain cat hR hb ms (A.R.1 + t i) -
      ap.gChain cat hR hb ms (A.R.1 + r i)) x)‖ ^ 2 =
      ∑ Q : {Q // Q ∈ (Ψ.partition (A.R.1 + r i)).cells},
        ‖E i ((ap.gChain cat hR hb ms (A.R.1 + t i) - ap.gChain cat hR hb ms (A.R.1 + r i))
          (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
            (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x))‖ ^ 2 := by
    intro i x
    have hdepth : ∀ Q ∈ (Ψ.partition (A.R.1 + r i)).cells, ∀ h : ℤ, A.R.1 + r i ≤ h →
        h ≤ A.R.1 + t i → Q.1 ≤ (ap.cumBase cat hR hb).depth h := by
      intro Q hQ h h1 h2
      have hQ1 := ((Ψ.mem_partition _ Q).mp hQ).1
      have hle : Ψ.depth (A.R.1 + r i) ≤ A.R.1 + r i := by
        unfold ColumnDepthFamily.depth
        exact max_le (by omega) (min_le_left _ _)
      change Q.1 ≤ max A.R.1 (min h (A.R.1 + A.treeDepth))
      rw [hQ1]
      have := htd i
      exact le_trans hle (le_trans (le_min h1 (by have := hrt i; omega)) (le_max_right _ _))
    have h := Ψ.blk_of_commute (A.R.1 + r i) ((E i).comp (ap.gChain cat hR hb ms (A.R.1 + t i) -
      ap.gChain cat hR hb ms (A.R.1 + r i))) (fun y => ?_) (fun Q hQ => ?_) x
    · exact h
    · filter_upwards [columnL2Restriction_vanish _ (hEm i)
        ((ap.gChain cat hR hb ms (A.R.1 + t i) - ap.gChain cat hR hb ms (A.R.1 + r i)) y)]
        with z hz hzR
      refine hz fun hzE => hzR ?_
      rw [Set.mem_iUnion₂] at hzE
      obtain ⟨I, hI, hzI⟩ := hzE
      rw [hΨG]
      exact hΨR (A.sub I (hEc i I hI) hzI)
    · have h1 := ap.gChain_commute cat hR hb ms (A.R.1 + t i) (Q := Q)
        (hdepth Q hQ _ (by have := hrt i; omega) le_rfl)
      have h2 := ap.gChain_commute cat hR hb ms (A.R.1 + r i) (Q := Q)
        (hdepth Q hQ _ le_rfl (by have := hrt i; omega))
      have hc := columnL2Restriction_comm (V := Fin ap.Mc) (hEm i)
        (dyadicGridCell_measurable A.G Q.1 Q.2)
      rw [hΨG, ContinuousLinearMap.comp_assoc, ContinuousLinearMap.sub_comp, ← h1, ← h2,
        ← ContinuousLinearMap.comp_sub,
        ← ContinuousLinearMap.comp_assoc, ← ContinuousLinearMap.comp_assoc, hc]
  have hjoint : ∑ i, ‖E i (ap.gChain cat hR hb ms (A.R.1 + t i) (physEmbed V (Fin ap.Mc)
      ((Ψ.proj (A.R.1 + t i) - Ψ.proj (A.R.1 + r i)) Z)))‖ ^ 2 ≤ ‖Z‖ ^ 2 := by
    refine le_trans (Finset.sum_le_sum fun i _ => ?_) (Ψ.jumps_from_le hΨr r t hrt hdis Z)
    refine (columnL2Restriction_norm_sq_le _ (hEm i) _).trans ?_
    refine pow_le_pow_left₀ (norm_nonneg _) ?_ 2
    refine le_trans ?_ (norm_physEmbed_apply_le (W := Fin ap.Mc) _)
    rw [ap.gChain_eq_globHist]
    exact globHist_norm_le _ ap.hP _ _ _ _
  exact basic_variation Ψ E (fun _ h => ap.gChain cat hR hb ms h) (fun i => A.R.1 + r i)
    (fun i => A.R.1 + t i) hB hrows hblk Z hjoint

