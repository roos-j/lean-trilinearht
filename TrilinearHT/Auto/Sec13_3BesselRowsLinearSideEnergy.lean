open Classical in
/-- Blueprint line 1959 (`Z̃_{l,G,b} = R Z_{u_b}` on `J`): when the first-match cells are the
maximal cells of the label families `C n` containing the decision cell `u`, and the physical
corrections are exact there, every mode-span projection on a pre-cell `J ⊆ u` of the frozen
evaluation equals that of the lifted catalog output. -/
theorem frozen_proj_eq {Tg : Type*} (cat : List (CatCol Tg)) (hεP : ∀ Φ, Ms.L.εP Φ = 1)
    (C : Fin Mc → Finset (ℤ × ℤ))
    (hq : ∀ n y, (∃ I ∈ maxCells Gd (C n), y ∈ dyadicGridCell Gd I.1 I.2) →
      Ms.L.q n y = ∑ m ∈ Finset.univ.filter (fun m => Ms.L.own m = n),
        Ms.L.a m y * Ms.wave m y - Ms.L.s y * catAtom cat n y)
    (hcell : ∀ m, Ms.cellOf m ∈ maxCells Gd (C (Ms.L.own m)))
    {u J : ℤ × ℤ} (hJu : dyadicGridCell Gd J.1 J.2 ⊆ dyadicGridCell Gd u.1 u.2)
    (Lb : Finset (Fin Mc)) (hLb : ∀ n ∈ Lb, u ∈ C n) (β : Fin Mc → ℂ) (E : Set Ms.Md)
    [(Submodule.span ℂ ((Ms.cellMode J) '' E)).HasOrthogonalProjection] :
    (Submodule.span ℂ ((Ms.cellMode J) '' E)).starProjection
        (∑ m ∈ Ms.alive u, Ms.frozenCoef Lb β m • Ms.cellMode J m) =
      (Submodule.span ℂ ((Ms.cellMode J) '' E)).starProjection
        (Ms.L.op (∑ n ∈ Lb, β n • fitColumn (dyadicGridCell Gd u.1 u.2) (catAtom cat n) n)) := by
  have hq' : ∀ n ∈ Lb, ∀ y ∈ dyadicGridCell Gd u.1 u.2, Ms.L.q n y =
      ∑ m ∈ Finset.univ.filter (fun m => Ms.L.own m = n), Ms.L.a m y * Ms.wave m y -
        Ms.L.s y * catAtom cat n y := by
    intro n hn y hy
    obtain ⟨I, hI, huI⟩ := exists_maxCells_above Gd (hLb n hn)
    exact hq n y ⟨I, hI, huI hy⟩
  have hcov : ∀ m, Ms.L.own m ∈ Lb →
      dyadicGridCell Gd u.1 u.2 ⊆ dyadicGridCell Gd (Ms.cellOf m).1 (Ms.cellOf m).2 ∨
        Disjoint (dyadicGridCell Gd u.1 u.2)
          (dyadicGridCell Gd (Ms.cellOf m).1 (Ms.cellOf m).2) := by
    intro m hm
    have huC := hLb _ hm
    obtain ⟨-, hmax⟩ := mem_maxCells.mp (hcell m)
    rcases le_total (Ms.cellOf m).1 u.1 with h | h
    · rcases dyadicGridCell_nested_or_disjoint_of_le Gd h (Ms.cellOf m).2 u.2 with hd | hs
      · exact Or.inr hd.symm
      · exact Or.inl hs
    · rcases dyadicGridCell_nested_or_disjoint_of_le Gd h u.2 (Ms.cellOf m).2 with hd | hs
      · exact Or.inr hd
      · have := hmax u huC hs
        rw [this]
        exact Or.inl subset_rfl
  have hsyn := Ms.op_synthesis cat hεP hJu Lb β hq' hcov
  have hfe : ∑ m ∈ Ms.alive u, Ms.frozenCoef Lb β m • Ms.cellMode J m =
      ∑ m ∈ Finset.univ.filter (fun m => Ms.L.own m ∈ Lb ∧
          dyadicGridCell Gd u.1 u.2 ⊆ dyadicGridCell Gd (Ms.cellOf m).1 (Ms.cellOf m).2),
        (β (Ms.L.own m) * Ms.L.a m (dyadicGridLeft Gd (Ms.cellOf m).1 (Ms.cellOf m).2)) •
          Ms.cellMode J m := by
    simp only [frozenCoef, ite_smul, zero_smul]
    rw [← Finset.sum_filter]
    refine Finset.sum_congr ?_ fun _ _ => rfl
    ext m
    simp only [Finset.mem_filter, Ms.mem_alive, Finset.mem_univ, true_and]
    tauto
  rw [hfe, ← hsyn]
  refine starProjection_restrict_eq _ _ _ (span_augMode_restrict (V := Ms.Md) subset_rfl
    (dyadicGridCell_measurable Gd J.1 J.2) (Ms.cellMode J) (fun m => ?_) E) _
  exact augMode_toLp_vanish (dyadicGridCell_measurable Gd J.1 J.2)
    (dyadicGridCell_volume_ne_top Gd J) (Ms.wave_measurable m) (Ms.wave_norm_le m) _ m

end ModeSystem

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

/-- The side events `(b, J, E)` of the blocks `Bs` on their retained pre-cells. -/
noncomputable def events (Bs : Finset ℤ) (cells : ℤ → Finset (ℤ × ℤ)) : Finset Ms.Event := by
  classical exact Bs.biUnion fun b => (cells b).biUnion fun J =>
    (Ms.sideEvents S hA SP b J).image fun E => (b, J, E)

theorem sum_events (Bs : Finset ℤ) (cells : ℤ → Finset (ℤ × ℤ)) (f : Ms.Event → ℝ) :
    ∑ e ∈ Ms.events S hA SP Bs cells, f e =
      ∑ b ∈ Bs, ∑ J ∈ cells b, ∑ E ∈ Ms.sideEvents S hA SP b J, f (b, J, E) := by
  classical
  unfold events
  rw [Finset.sum_biUnion]
  · refine Finset.sum_congr rfl fun b _ => ?_
    rw [Finset.sum_biUnion]
    · refine Finset.sum_congr rfl fun J _ => ?_
      rw [Finset.sum_image]
      intro E _ E' _ h
      exact (Prod.ext_iff.mp (Prod.ext_iff.mp h).2).2
    · intro J _ J' _ hne
      rw [Function.onFun, Finset.disjoint_left]
      intro e he he'
      obtain ⟨E, -, rfl⟩ := Finset.mem_image.mp he
      obtain ⟨E', -, h⟩ := Finset.mem_image.mp he'
      exact hne (Prod.ext_iff.mp (Prod.ext_iff.mp h).2).1.symm
  · intro b _ b' _ hne
    rw [Function.onFun, Finset.disjoint_left]
    intro e he he'
    obtain ⟨J, -, hJ⟩ := Finset.mem_biUnion.mp he
    obtain ⟨E, -, rfl⟩ := Finset.mem_image.mp hJ
    obtain ⟨J', -, hJ'⟩ := Finset.mem_biUnion.mp he'
    obtain ⟨E', -, h⟩ := Finset.mem_image.mp hJ'
    exact hne (Prod.ext_iff.mp h).1.symm

theorem mem_events {Bs : Finset ℤ} {cells : ℤ → Finset (ℤ × ℤ)} {e : Ms.Event}
    (he : e ∈ Ms.events S hA SP Bs cells) :
    e.1 ∈ Bs ∧ e.2.1 ∈ cells e.1 ∧ e.2.2 ∈ Ms.sideEvents S hA SP e.1 e.2.1 := by
  classical
  unfold events at he
  obtain ⟨b, hb, hJ⟩ := Finset.mem_biUnion.mp he
  obtain ⟨J, hJc, hE⟩ := Finset.mem_biUnion.mp hJ
  obtain ⟨E, hEs, rfl⟩ := Finset.mem_image.mp hE
  exact ⟨hb, hJc, hEs⟩

end ModeSystem

