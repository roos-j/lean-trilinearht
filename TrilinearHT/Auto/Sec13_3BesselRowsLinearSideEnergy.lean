    exact ap.ballFam_right_decomp cat hR hb r₀ j (grp G) p (Ec G) (hEc G) (x G)
  simp only [Finset.filter_eq', Finset.mem_univ, ↓reduceIte, Finset.sum_singleton, hFG]
  refine ap.catRange_wholeRanges cat t₀ hT grp hgrp k Ec (fun _ I => I)
    (fun G I hI => (hEc G I hI).1) (fun _ _ => r₀) (fun _ _ => ap.bbase j + p + 1)
    (fun _ _ => by have := p.2; omega)
    (fun G I => catProj A.G ap.Mc cat I r₀ (ap.bmask I (grp G) j p) (x G))
    (fun _ _ _ => Submodule.starProjection_apply_mem _ _) hcert hroot hτ hτ1 hHed ?_
