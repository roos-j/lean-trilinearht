open Classical in
/-- Blueprint line 2100 ("at a fixed height, a primary is exceptional in at most `C d_max`
blocks") for block starts at least `3K` apart: if `2 log₂ T ≤ 3K`, a key is exceptional in at
most twice as many blocks as there are rational vectors of height at most `H_n`. -/
theorem exceptional_card_le (hT1 : 1 ≤ SP.Tt)
    (hTK : 2 * Real.logb 2 SP.Tt ≤ 3 * S.K) (p : Ms.Key) (T : Finset ℤ)
    (hT : ∀ b ∈ T, ∀ b' ∈ T, b < b' → b + 3 * (S.K : ℤ) ≤ b') :
    (T.filter fun b => ¬ Ms.nonexcAt S SP b p).card ≤
      2 * (Fintype.piFinset fun _ : Fin (Ms.dvOf p + Ms.zc.dim) =>
        boundedRationalEnumeration SP.Hn).card := by
  set n := Ms.dvOf p + Ms.zc.dim
  set Vs := Fintype.piFinset fun _ : Fin n => boundedRationalEnumeration SP.Hn
  set θ : Fin n → ℝ := Fin.append (Ms.θvOf p) fun l => Ms.zc.θ l / S.Q0
  -- a witness vector for every exceptional block
  have hwit : ∀ b ∈ T.filter (fun b => ¬ Ms.nonexcAt S SP b p), ∃ a ∈ Vs,
      SP.Tt⁻¹ / dyadicGridLength Gd (b - 2 * S.K) < |ratEval θ a| ∧
        |ratEval θ a| < SP.Tt / dyadicGridLength Gd (b + S.K) := by
    intro b hb
    have hne := (Finset.mem_filter.mp hb).2
    unfold nonexcAt at hne
    push Not at hne
    obtain ⟨a, ha, h1, h2⟩ := hne
    refine ⟨a, Fintype.mem_piFinset.mpr fun i =>
      mem_boundedRationalEnumeration ((le_vecHeight a i).trans ha), h1, h2⟩
  choose! w hwV hw using hwit
  rw [Finset.card_eq_sum_card_fiberwise (f := w) (t := Vs) fun b hb => hwV b hb]
  calc ∑ a ∈ Vs, ((T.filter fun b => ¬ Ms.nonexcAt S SP b p).filter fun b => w b = a).card
      ≤ ∑ _a ∈ Vs, 2 := Finset.sum_le_sum fun a _ => ?_
    _ = 2 * Vs.card := by rw [Finset.sum_const, smul_eq_mul, mul_comm]
  -- one fiber: the blocks lie in an open window of length `3K + 2 log₂ T`
  set v := |ratEval θ a|
  set B0 := Gd.baseLength
  have hB0 := Gd.baseLength_pos
  have hvpos : ∀ b ∈ ((T.filter fun b => ¬ Ms.nonexcAt S SP b p).filter fun b => w b = a),
      0 < v := by
    intro b hb
    obtain ⟨hb1, hb2⟩ := Finset.mem_filter.mp hb
    have h := (hw b hb1).1
    rw [hb2] at h
    have : 0 < SP.Tt⁻¹ / dyadicGridLength Gd (b - 2 * S.K) :=
      div_pos (inv_pos.mpr (by linarith)) (dyadicGridLength_pos _ _)
    linarith
  rcases Finset.eq_empty_or_nonempty
      ((T.filter fun b => ¬ Ms.nonexcAt S SP b p).filter fun b => w b = a) with he | hne
  · rw [he]; simp
  obtain ⟨b₀, hb₀⟩ := hne
  have hv := hvpos b₀ hb₀
  set x := Real.logb 2 (B0 * v)
  set L := Real.logb 2 SP.Tt
  refine card_separated_in_interval_le_two (K := S.K) _ (fun b hb b' hb' hbb =>
    hT b (Finset.mem_filter.mp (Finset.mem_filter.mp hb).1).1 b'
      (Finset.mem_filter.mp (Finset.mem_filter.mp hb').1).1 hbb)
    (c := x - S.K - L) (d := x + 2 * S.K + L) (by linarith) fun b hb => ?_
  obtain ⟨hb1, hb2⟩ := Finset.mem_filter.mp hb
  obtain ⟨h1, h2⟩ := hw b hb1
  rw [hb2] at h1 h2
  have hT0 : 0 < SP.Tt := by linarith
  have hlen : ∀ h : ℤ, dyadicGridLength Gd h = B0 * (2 : ℝ) ^ (-h) := fun h => rfl
  rw [hlen] at h1 h2
  -- logarithms
  have hlog : ∀ u : ℝ, 0 < u → Real.logb 2 u = Real.log u / Real.log 2 := fun u _ => rfl
  have hl2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hpow : ∀ h : ℤ, Real.logb 2 ((2 : ℝ) ^ h) = h := fun h => by
    simp only [Real.logb, Real.log_zpow]
    exact mul_div_cancel_right₀ _ hl2.ne'
  have hBv : 0 < B0 * v := mul_pos hB0 hv
  -- the lower condition bounds `b` from above
  have hup : (b : ℝ) < x + 2 * S.K + L := by
    have e : SP.Tt⁻¹ / (B0 * (2 : ℝ) ^ (-(b - 2 * (S.K : ℤ)))) =
        SP.Tt⁻¹ * (2 : ℝ) ^ (b - 2 * (S.K : ℤ)) / B0 := by
      rw [zpow_neg]; field_simp
    rw [e, div_lt_iff₀ hB0] at h1
    have h1' : SP.Tt⁻¹ * (2 : ℝ) ^ (b - 2 * (S.K : ℤ)) < B0 * v := by linarith
    have hl := Real.logb_lt_logb (b := 2) (by norm_num) (by positivity) h1'
    have hT : Real.logb 2 (SP.Tt⁻¹ * (2 : ℝ) ^ (b - 2 * (S.K : ℤ))) =
        -L + (b - 2 * S.K) := by
      rw [Real.logb_mul (by positivity) (by positivity), Real.logb_inv, hpow]; push_cast; ring
    rw [hT] at hl
    linarith
  -- the upper condition bounds `b` from below
  have hlo : x - S.K - L < b := by
    have e : SP.Tt / (B0 * (2 : ℝ) ^ (-(b + (S.K : ℤ)))) =
        SP.Tt * (2 : ℝ) ^ (b + (S.K : ℤ)) / B0 := by
      rw [zpow_neg]; field_simp
    rw [e, lt_div_iff₀ hB0] at h2
    have h2' : B0 * v < SP.Tt * (2 : ℝ) ^ (b + (S.K : ℤ)) := by linarith
    have hl := Real.logb_lt_logb (b := 2) (by norm_num) hBv h2'
    have hT : Real.logb 2 (SP.Tt * (2 : ℝ) ^ (b + (S.K : ℤ))) = L + (b + S.K) := by
      rw [Real.logb_mul (by positivity) (by positivity), hpow]; push_cast; ring
    rw [hT] at hl
    linarith
  exact ⟨hlo, hup⟩

open Classical in
/-- Blueprint line 2100 ("at one event, a nonexceptional primary is height-bad at most
`C d_max R_ht` times by stabilization", lem:stabilize line 2012): for a key nonexceptional in its
block, at most `(2 (d_v + d_z) + 1) R` heights `h ≤ J_*` are bad, when the witness bounds grow by
at least the factor `6` and the kernel bounds are monotone. -/
theorem badHeights_card_le (hEq : ∀ i, 6 * SP.Eq i ≤ SP.Eq (i + 1)) (hSk : Monotone SP.Sk)
    (b : ℤ) (p : Ms.Key) (hp : Ms.nonexcAt S SP b p) :
    ((Finset.range (SP.Jst + 1)).filter fun h => ¬ Ms.goodP S SP b h p).card ≤
      (2 * (Ms.dvOf p + Ms.zc.dim) + 1) * SP.R := by
  set Θ : Fin (Ms.dvOf p + Ms.zc.dim) → ℝ := Fin.append (Ms.θvOf p) fun l => Ms.zc.θ l / S.Q0
  set K := tinySpan Θ SP.Hn (SP.Tt⁻¹ / dyadicGridLength Gd (b - 2 * S.K))
  set V : ℕ → Submodule ℚ (Fin (Ms.dvOf p + Ms.zc.dim) → ℚ) := fun i =>
    witnessSpan K SP.D (SP.Eq i) i
  set U : ℕ → Submodule ℚ (Fin Ms.zc.dim → ℚ) := fun i =>
    smallKernelSpan K (zEmb (Ms.dvOf p) Ms.zc.dim) (SP.Sk i)
  have hV : Monotone V := witnessSpan_mono K SP.D SP.Eq hEq
  have hU : Monotone U := fun i j hij => smallKernelSpan_mono K _ (hSk hij)
  have h1 := rank_change_heights_card V hV SP.R (SP.Jst + 1)
  have h2 := rank_change_heights_card U hU SP.R (SP.Jst + 1)
  rw [Module.finrank_fin_fun] at h1 h2
  have hsub : ((Finset.range (SP.Jst + 1)).filter fun h => ¬ Ms.goodP S SP b h p) ⊆
      Finset.range SP.R ∪ ((Finset.range (SP.Jst + 1)).filter fun h => SP.R ≤ h ∧
        V (h - SP.R) ≠ V h) ∪ ((Finset.range (SP.Jst + 1)).filter fun h => SP.R ≤ h ∧
          U (h - SP.R) ≠ U h) := by
    intro h hh
    obtain ⟨hr, hbad⟩ := Finset.mem_filter.mp hh
    simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_range]
    by_cases hRh : SP.R ≤ h
    · by_cases hVh : V (h - SP.R) = V h
      · refine Or.inr ⟨Finset.mem_range.mp hr, hRh, fun hUh => hbad ⟨hp, hRh, hVh, hUh⟩⟩
      · exact Or.inl (Or.inr ⟨Finset.mem_range.mp hr, hRh, hVh⟩)
    · exact Or.inl (Or.inl (by omega))
  calc _ ≤ _ := Finset.card_le_card hsub
    _ ≤ _ := Finset.card_union_le _ _
    _ ≤ (Finset.range SP.R).card + ((Finset.range (SP.Jst + 1)).filter fun h => SP.R ≤ h ∧
          V (h - SP.R) ≠ V h).card + ((Finset.range (SP.Jst + 1)).filter fun h => SP.R ≤ h ∧
          U (h - SP.R) ≠ U h).card := by
        gcongr; exact Finset.card_union_le _ _
    _ ≤ SP.R + (Ms.dvOf p + Ms.zc.dim) * SP.R + Ms.zc.dim * SP.R := by
        rw [Finset.card_range]; omega
    _ ≤ (2 * (Ms.dvOf p + Ms.zc.dim) + 1) * SP.R := by nlinarith

