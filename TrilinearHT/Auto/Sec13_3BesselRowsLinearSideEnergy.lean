      rw [Int.floor_eq_iff]; push_cast; constructor <;> linarith [ht.1]
    have hf : Int.fract t = t - ⌊t₀⌋ + 1 := by
      rw [Int.fract, hfl]; push_cast; ring
    rw [hf, branchProfile_eq_zero_of_le (s := t - ⌊t₀⌋) hδ (by linarith), zero_add]

