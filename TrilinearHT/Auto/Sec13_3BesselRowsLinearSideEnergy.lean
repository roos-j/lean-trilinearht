section LinearSide
variable {H : Type*} [NormedAddCommGroup H]

/-- Blueprint lines 2104-2118, assembly of `eq:linear-energy`: each subtotal
`V_k = Σ_{e ∈ ev k} T_e` is a sum of exact event subtotals that are almost orthogonal
(`‖V_k‖² ≤ c Σ ‖T_e‖²`), each within `ε` of a projection row output `Y_e = P_{E,J} Z̃`, and the rows
over all events are Bessel with total `B` (mode rows per level and class, then
`lem:lift-composition`). With `#events · ε² ≤ B`, `Σ_k ‖V_k‖² ≤ 4 c B`. -/
theorem linear_side_square_energy {κ ε' : Type*} [DecidableEq ε'] (s : Finset κ)
    (ev : κ → Finset ε')
    (hdisj : Set.PairwiseDisjoint (s : Set κ) ev) (V : κ → H) (T Y : ε' → H) {c ε B : ℝ}
    (hc : 0 ≤ c) (hV : ∀ k ∈ s, ‖V k‖ ^ 2 ≤ c * ∑ e ∈ ev k, ‖T e‖ ^ 2)
    (hTY : ∀ k ∈ s, ∀ e ∈ ev k, ‖T e - Y e‖ ≤ ε)
    (hY : ∑ k ∈ s, ∑ e ∈ ev k, ‖Y e‖ ^ 2 ≤ B)
    (hcount : ((s.biUnion ev).card : ℝ) * ε ^ 2 ≤ B) :
    ∑ k ∈ s, ‖V k‖ ^ 2 ≤ 4 * c * B := by
  have hT : ∀ k ∈ s, ∀ e ∈ ev k, ‖T e‖ ^ 2 ≤ 2 * ‖Y e‖ ^ 2 + 2 * ε ^ 2 := by
    intro k hk e he
    have h1 : ‖T e‖ ≤ ‖Y e‖ + ε := by
      have := norm_le_insert' (T e) (Y e)
      linarith [hTY k hk e he, norm_sub_norm_le (T e) (Y e)]
    have h0 : 0 ≤ ‖T e‖ := norm_nonneg _
    nlinarith [sq_nonneg (‖Y e‖ - ε)]
  have hcard : ∑ k ∈ s, ((ev k).card : ℝ) = (s.biUnion ev).card := by
    rw [Finset.card_biUnion hdisj]; push_cast; rfl
  calc ∑ k ∈ s, ‖V k‖ ^ 2 ≤ ∑ k ∈ s, c * ∑ e ∈ ev k, (2 * ‖Y e‖ ^ 2 + 2 * ε ^ 2) := by
        apply Finset.sum_le_sum; intro k hk
        refine (hV k hk).trans (mul_le_mul_of_nonneg_left ?_ hc)
        exact Finset.sum_le_sum fun e he => hT k hk e he
    _ = 2 * c * (∑ k ∈ s, ∑ e ∈ ev k, ‖Y e‖ ^ 2) +
        2 * c * (∑ k ∈ s, ((ev k).card : ℝ) * ε ^ 2) := by
        rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl; intro k _
        rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul, mul_add, Finset.mul_sum,
          Finset.mul_sum]
        congr 1
        · apply Finset.sum_congr rfl; intro e _; ring
        · ring
    _ ≤ 2 * c * B + 2 * c * B := by
        rw [← Finset.sum_mul, hcard]
        gcongr
    _ = 4 * c * B := by ring

end LinearSide

