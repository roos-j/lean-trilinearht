/-- `6^h E_0 ≤ E_h` (`E_h = A₀^{h+1}`, `A₀ ≥ 6`). -/
theorem six_pow_mul_Eh_zero_le (hA : 6 ≤ S.A0) (h : ℕ) : (6 : ℝ) ^ h * S.Eh 0 ≤ S.Eh h := by
  unfold Eh
  rw [zero_add, pow_one, pow_succ]
  exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by norm_num) hA h) (by linarith)

/-- Blueprint line 2055 ("all retained shifts are allowed: `E_h ≥ B_* L_h`"): a separation at
height `h` for all shifts `|n| ≤ E_h` scaled by `L_h` gives the separation for all shifts
`|n'| ≤ E_0` at some point of a nonempty set. -/
theorem sep_height_zero (hA : 6 ≤ S.A0) {dz : ℕ} (ϑ : Fin dz → ℝ) {h : ℕ} {θ : ℝ}
    {f : ℝ → ℝ} {X : Set ℝ} (hX : X.Nonempty)
    (hsep : ∀ n : Fin dz → ℤ, (∀ i, |(n i : ℝ)| ≤ S.Eh h) →
      ∀ x ∈ X, θ < |f x + (∑ i, (n i : ℝ) * ϑ i) / Lh h|)
    (n' : Fin dz → ℤ) (hn' : ∀ i, |(n' i : ℝ)| ≤ S.Eh 0) :
    ∃ x ∈ X, θ ≤ |f x + ∑ i, (n' i : ℝ) * ϑ i| := by
  obtain ⟨x, hx⟩ := hX
  refine ⟨x, hx, ?_⟩
  have hL : Lh h = (6 : ℝ) ^ h := rfl
  have hpos : (0 : ℝ) < 6 ^ h := by positivity
  have h1 := hsep (fun i => 6 ^ h * n' i) (fun i => by
    push_cast
    rw [abs_mul, abs_of_pos hpos]
    exact (mul_le_mul_of_nonneg_left (hn' i) hpos.le).trans (S.six_pow_mul_Eh_zero_le hA h)) x hx
  have e : (∑ i, ((6 ^ h * n' i : ℤ) : ℝ) * ϑ i) / Lh h = ∑ i, (n' i : ℝ) * ϑ i := by
    rw [hL, Finset.sum_div]
    refine Finset.sum_congr rfl fun i _ => ?_
    push_cast
    field_simp
  rw [e] at h1
  exact h1.le

