theorem sum_log_shift_le {p : ℕ → ℝ} {M : ℝ} (hp1 : ∀ h, 1 ≤ p h) (hpM : ∀ h, p h ≤ M)
    (Δ n : ℕ) :
    ∑ h ∈ Finset.range n, (Real.log (p (h + Δ)) - Real.log (p h)) ≤ Δ * Real.log M := by
  have htel : ∀ n, ∑ h ∈ Finset.range n, (Real.log (p (h + Δ)) - Real.log (p h)) =
      ∑ i ∈ Finset.range Δ, (Real.log (p (n + i)) - Real.log (p i)) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      rw [Finset.sum_range_succ, ih]
      have := Finset.sum_range_sub (fun i => Real.log (p (n + i))) Δ
      simp only [add_zero] at this
      have e : ∑ i ∈ Finset.range Δ, (Real.log (p (n + 1 + i)) - Real.log (p i)) =
          ∑ i ∈ Finset.range Δ, (Real.log (p (n + i)) - Real.log (p i)) +
            ∑ i ∈ Finset.range Δ, (Real.log (p (n + (i + 1))) - Real.log (p (n + i))) := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl; intro i _
        rw [show n + 1 + i = n + (i + 1) by ring]; ring
