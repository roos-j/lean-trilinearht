/-! ### Sources of the remaining other complement of a transfer step (blueprint line 2254) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- Cumulative masks grow with the pad. -/
theorem cmask_pad_mono {I : ℤ × ℤ} {m p p' : ℕ} (hp : p ≤ p') {x : A.Vtx}
    (hx : ap.cmask I m p x) : ap.cmask I m p' x :=
  ColorSetup.cumMask_mono (K := ap.K) le_rfl (by omega) _ hx

/-- The source data of a slot value used by the far band estimate. -/
def SrcData (o : Fin 4) (I : ℤ × ℤ) (w : ColumnL2 (Fin ap.Mc)) (Co : ℝ) : Prop :=
  ∃ (ι : Type) (Fo : Finset ι) (co : ι → ℂ) (src : ι → ColumnL2 (Fin ap.Mc))
    (tago : ι → A.Vtx), w = ∑ m ∈ Fo, co m • src m ∧ ∑ m ∈ Fo, ‖co m‖ ≤ Co ∧
    (∀ m ∈ Fo, tago m ∈ A.admT.X (A.admAt I)) ∧
    ∀ m ∈ Fo, ∃ Ay : QuadraticChartData (A.vtag (tago m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc Ay ∧ IsBoundedQuadraticChart Ay ∧
      Ay.horizontal = (A.vtag (tago m)).θ ∧ Ay.matrix = (slotCoeff o : ℚ) • (A.vtag (tago m)).C ∧
      Ay.quadratic = slotCoeff o * (A.vtag (tago m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = quadraticChartAtom Ay y

/-- Blueprint line 2254 ("using its basic columns when it is unfiltered"): the basic argument of a
slot is a combination of bounded pure sources with coefficient sum at most `|L| D_c`. -/
theorem srcData_basic {I : ℤ × ℤ} (hI : I ∈ A.cells) (o : Fin 4) {Co : ℝ}
    (hCo : Fintype.card A.L * A.Dc ≤ Co) :
    ap.SrcData o I (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.B o I))) Co := by
  classical
  refine ⟨A.L, Finset.univ.filter (fun v => A.coef o I v ≠ 0), A.coef o I,
    fun v => physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.φ I v)),
    fun v => A.basicVtx hI o v,
    A.basic_expansion ap.Mc I o, ?_, fun v hv => ?_, fun v hv => ?_⟩
  · calc ∑ v ∈ Finset.univ.filter (fun v => A.coef o I v ≠ 0), ‖A.coef o I v‖
        ≤ ∑ v : A.L, ‖A.coef o I v‖ :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            fun _ _ _ => norm_nonneg _
      _ ≤ ∑ _v : A.L, A.Dc := Finset.sum_le_sum fun v _ => A.coef_le o I v
      _ = Fintype.card A.L * A.Dc := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ ≤ Co := hCo
  · exact A.basicVtx_mem hI (Finset.mem_filter.mp hv).2
  · exact ap.basic_bdd hI (Finset.mem_filter.mp hv).2

/-- Blueprint line 2254 ("expand instead the lower-rank primal source"): an averaged catalog
filter of a slot with masks of present vertices, applied to a value of size at most `S √|I|`, is a
combination of bounded pure sources with coefficient sum at most `√N S` when the slot catalog has at
most `N` labels at the cell. -/
theorem srcData_filt (cat : List (CatCol A.Vtx)) (o : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) o R γ d.birth d.rank d.tag)
    (I : ℤ × ℤ) (g : ℕ × (Fin ap.P → A.Vtx → Prop))
    (hg : ∀ k x, g.2 k x → x ∈ A.admT.X (A.admAt I)) (x : ColumnL2 (Fin ap.Mc)) {S N Co : ℝ}
    (hx : ‖x‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ S)
    (hN : ((catLabels A.G ap.Mc cat I g.1 (fun y => ∃ p, g.2 p y)).card : ℝ) ≤ N)
    (hCo : Real.sqrt N * S ≤ Co) :
    ap.SrcData o I (ap.filtAvg cat I g x) Co := by
  classical
  set F := catLabels A.G ap.Mc cat I g.1 (fun y => ∃ p, g.2 p y)
  obtain ⟨co, -, he⟩ := opAvg_catProj_l2 (G := A.G) cat I g.1 g.2 (fun y => ∃ p, g.2 p y)
    (fun p y h => ⟨p, h⟩) x
  have hmem : ∀ n ∈ F, ∃ h : (n : ℕ) < cat.length, (cat[(n : ℕ)]).tag ∈ A.admT.X (A.admAt I) := by
    intro n hn
    simp only [F, catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hn
    obtain ⟨h, -, -, p, hp⟩ := hn
    exact ⟨h, hg p _ hp⟩
  have hval : ap.filtAvg cat I g x =
      ∑ n ∈ F, co n • fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom cat n) n := by
    change filterAvg ap.P (padFam fun p => catProj A.G ap.Mc cat I g.1 (g.2 p)) x = _
    rw [filterAvg_padFam, he]
  refine ⟨{n // n ∈ F}, Finset.univ, fun n => co n.1,
    fun n => fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom cat n.1) n.1,
    fun n => (cat[(n.1 : ℕ)]'(hmem n.1 n.2).1).tag, ?_, ?_, fun n _ => (hmem n.1 n.2).2,
    fun n _ => ap.catColumn_bdd cat o hT I (hmem n.1 n.2).1 (hmem n.1 n.2).2⟩
  · rw [hval, Finset.sum_coe_sort F (fun n => co n • fitColumn (dyadicGridCell A.G I.1 I.2)
      (catAtom cat n) n)]
  · rw [Finset.sum_coe_sort F (fun n => ‖co n‖)]
    have h1 := catCoeff_l1_le (G := A.G) cat I F co
    rw [← he] at h1
    have h2 : ‖opAvg (fun p => catProj A.G ap.Mc cat I g.1 (g.2 p)) x‖ ≤ ‖x‖ :=
      norm_opAvg_apply_le _ (fun _ z => norm_catProj_le _ _ _ _ _ _ z) x
    have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
    refine h1.trans (le_trans ?_ hCo)
    have hS0 : 0 ≤ S := le_trans (by positivity) hx
    calc Real.sqrt F.card * (‖opAvg (fun p => catProj A.G ap.Mc cat I g.1 (g.2 p)) x‖ /
          Real.sqrt (dyadicGridLength A.G I.1))
        ≤ Real.sqrt N * S := by
          gcongr
          exact (div_le_div_of_nonneg_right h2 hsq.le).trans hx

