variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- Blueprint lines 2254-2256 (a far band pair with the complement band higher: "expand instead
the lower-rank primal source in position `d` ... a near source lies in both masks of the higher
`c` residual band; the main test applies, keeping the entire lower helper band as an `L²`
spectator. For a far source, expand the helper primal and use the different-tag pair
estimate"): at one cell, with the band `Q_{u,q+1} - Q_{u,q}` of a complement value `v` in slot
`u` (`p + 2 < q`), the helper band of a side value in slot `a`, a combination of pure sources in
slot `o` and a spectator in slot `b`, the form is at most the near part
`(Σ|c|) (2 β) S_a S_b` plus the far part `τ₂ S_v S_b (Σ|c|) (#helper labels) S_a`. -/
theorem far_main_le {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a)
    (huo : u ≠ o) (hub : u ≠ b) (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (catu : List (CatCol A.Vtx)) (r : ℕ) (M : Fin ap.P → A.Vtx → Prop)
    (hMm : ∀ i j : Fin ap.P, i ≤ j → ∀ x, M i x → M j x) (v : ColumnL2 (Fin ap.Mc)) {βm : ℝ}
    (hmain : ∀ k : Fin ap.P, CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag u (M k)
      (v - catProj A.G ap.Mc catu I r (M k) v) βm) (hβm : 0 ≤ βm)
    (hcatA : List (CatCol A.Vtx)) (rH : ℕ) (xa : ColumnL2 (Fin ap.Mc))
    {ι : Type*} (Fo : Finset ι) (co : ι → ℂ) (src : ι → ColumnL2 (Fin ap.Mc)) (tago : ι → A.Vtx)
    (Ys : ι → ℝ → ℂ)
    (hsrc : ∀ m ∈ Fo, ∃ A' : QuadraticChartData (A.vtag (tago m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc A' ∧ A'.horizontal = (A.vtag (tago m)).θ ∧
      A'.matrix = (slotCoeff o : ℚ) • (A.vtag (tago m)).C ∧
      A'.quadratic = slotCoeff o * (A.vtag (tago m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = quadraticChartAtom A' y)
    (hYs : ∀ m ∈ Fo, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = Ys m y)
    {p q : ℕ} (hpq : p + 2 < q) (hqP : q ≤ ap.P) (near : ι → Prop)
    (hnear : ∀ m ∈ Fo, near m → ∀ k : Fin ap.P, q - 1 ≤ k → M k (tago m))
    {τ₂ : ℝ} (hτ₂ : 0 ≤ τ₂) (hfar : ∀ m ∈ Fo, ¬ near m →
      ∀ n ∈ catLabels A.G ap.Mc hcatA I rH (M ⟨p, by omega⟩),
        PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) o a (Ys m)
          (catAtom hcatA n) τ₂)
    (X : Fin 4 → ColumnL2 (Fin ap.Mc))
    (hXa : X a = padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) (p + 1) xa -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) p xa)
    (hXu : X u = padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) (q + 1) v -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) q v)
    (hXo : X o = ∑ m ∈ Fo, co m • src m)
    {Sa Sv Sb : ℝ} (hSa : 0 < Sa) (hSv : 0 < Sv) (hSb : 0 < Sb)
    (hSa' : 2 * ‖xa‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSv' : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sv)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖ap.Λc I X‖ ≤ (∑ m ∈ Fo, ‖co m‖) * ((βm + βm) * Sa * Sb) +
      τ₂ * Sv * Sb * (∑ m ∈ Fo, ‖co m‖) *
        (Real.sqrt (catLabels A.G ap.Mc hcatA I rH (M ⟨p, by omega⟩)).card * Sa) := by
  classical
  have hpP : p < ap.P := by omega
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  rw [ap.Λc_of_mem hI]
  set Λ := cellForm (dyadicGridLength_pos A.G I.1) (A.adm I hI) (Fin ap.Mc)
  -- the spectator sizes
  have hsa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sa := by
    rw [hXa]; exact ap.padBand_size hcatA I rH M hMm hpP.le xa hSa'
  have hsv : eLpNorm (augPhys (X u)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sv := by
    rw [hXu]; exact ap.padBand_size catu I r M hMm hqP v hSv'
  -- the near/far split of the sources
  set Fn := Fo.filter near
  set Ff := Fo.filter fun m => ¬ near m
  have hsplit : X o = (∑ m ∈ Fn, co m • src m) + ∑ m ∈ Ff, co m • src m := by
    rw [hXo, Finset.sum_filter_add_sum_filter_not]
  have hΛ : Λ X = Λ (Function.update X o (∑ m ∈ Fn, co m • src m)) +
      Λ (Function.update X o (∑ m ∈ Ff, co m • src m)) := by
    rw [← Λ.map_update_add, ← hsplit, Function.update_eq_self]
  rw [hΛ]
  refine (norm_add_le _ _).trans (add_le_add ?_ ?_)
  · -- near sources: the main test of slot `u`
    set Y := Function.update X o (∑ m ∈ Fn, co m • src m)
    have hYo : Y o = ∑ m ∈ Fn, co m • src m := Function.update_self _ _ _
    have hYa : Y a = X a := Function.update_of_ne hao _ _
    have hYb : Y b = X b := Function.update_of_ne hob.symm _ _
    have hYu : Y u = X u := Function.update_of_ne huo _ _
    have hFn : ∑ m ∈ Fn, ‖co m‖ ≤ ∑ m ∈ Fo, ‖co m‖ :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
        fun _ _ _ => norm_nonneg _
    have hsrcn : ∀ m ∈ Fn, _ := fun m hm => hsrc m (Finset.mem_filter.mp hm).1
    rcases Nat.lt_or_ge q ap.P with hq | hq
    · have hYu' : Y u = (v - catProj A.G ap.Mc catu I r (M ⟨q - 1, by omega⟩) v) -
          (v - catProj A.G ap.Mc catu I r (M ⟨q, hq⟩) v) := by
        rw [hYu, hXu]; exact ap.padBand_resid_lt catu I r M (by omega) hq v
      have h := CellPass.form_band_le (A.adm I hI) (hmain ⟨q - 1, by omega⟩) (hmain ⟨q, hq⟩)
        huo.symm hao.symm hob hua hub hab Fn co src tago
        (fun m hm => ⟨hnear m (Finset.mem_filter.mp hm).1 (Finset.mem_filter.mp hm).2 _
