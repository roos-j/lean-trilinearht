      _ ≤ K * Blin := mul_le_mul_of_nonneg_left hlin (by positivity)
  calc _ ≤ ∑ G, ∑ s ∈ Sd, (‖columnL2Restriction (⋃ I ∈ Er G s, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
          (Wr G s)‖ ^ 2 + ‖Vs G (blk s)‖ ^ 2) :=
        Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun s _ => hcell G s
    _ ≤ _ := by
        simp only [Finset.sum_add_distrib]
        linarith

