variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The transfer steps of a pair of positive chains `t` (slot `c`) and `t'` (slot `d`): the merged
slot filters, larger rank first, as pad-family steps. -/
noncomputable def chainSteps (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) :
    List (TransferStep (ColumnL2 (Fin ap.Mc))) :=
  ((rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).map
    (ap.toStep (cat c) (cat d) hcat rH I)).map
      fun st => (st.1, padFam st.2.1, padFam st.2.2)

/-- The slot `c` value of the chain steps is the ball filter of the chain output. -/
theorem chainVal_chainSteps_c (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) (y : ColumnL2 (Fin ap.Mc)) :
    chainVal ap.P true (ap.chainSteps cat hcat rH s c d G I t t') y =
      ap.ballAt (cat c) (ap.leafR s c) (ap.leafJ s c) G I (chainOp (ap.cumAt (cat c) I) t y) := by
  rw [chainVal_eq_applyAll, ← ap.applyAll_slotFilt]
  unfold chainSteps
  rw [List.filter_map, List.filter_map, List.map_map, List.map_map]
  have h := rankMerge_filter_c Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')
  have e : ((rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).filter
      (((fun st : TransferStep (ColumnL2 (Fin ap.Mc)) => decide (st.1 = true)) ∘
        (fun st => (st.1, padFam st.2.1, padFam st.2.2))) ∘
          ap.toStep (cat c) (cat d) hcat rH I)) =
      (rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).filter
        (fun e => decide (e.1 = true)) := by
    congr 1
  rw [e, h, List.map_map]
  rfl

/-- The slot `d` value of the chain steps is the ball filter of the chain output. -/
theorem chainVal_chainSteps_d (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) (y : ColumnL2 (Fin ap.Mc)) :
    chainVal ap.P false (ap.chainSteps cat hcat rH s c d G I t t') y =
      ap.ballAt (cat d) (ap.leafR s d) (ap.leafJ s d) G I (chainOp (ap.cumAt (cat d) I) t' y) := by
  rw [chainVal_eq_applyAll, ← ap.applyAll_slotFilt]
  unfold chainSteps
  rw [List.filter_map, List.filter_map, List.map_map, List.map_map]
  have h := rankMerge_filter_d Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')
  have e : ((rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).filter
      (((fun st : TransferStep (ColumnL2 (Fin ap.Mc)) => decide (st.1 = false)) ∘
        (fun st => (st.1, padFam st.2.1, padFam st.2.2))) ∘
          ap.toStep (cat c) (cat d) hcat rH I)) =
      (rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).filter
        (fun e => decide (e.1 = false)) := by
    congr 1
  rw [e, h, List.map_map]
  rfl

end AttemptParams

end ActiveSetup

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- Blueprint lines 2240-2252 (transfer and its paired defects) on a leaf at one cell and group:
with sides in slots `a, b` and whole leaf outputs in slots `c, d`, the form is the signed sum over
the pairs of positive chains of the two complement histories of the transferred main term (helper
averages on the side `a`, the bases in `c, d`) plus the band defects of the rank-ordered steps. -/
theorem leaf_restored_transfer (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) {a c d : Fin 4} (hac : a ≠ c) (had : a ≠ d) (hcd : c ≠ d) (G : A.Grp)
    (I : ℤ × ℤ) (x : Fin 4 → ColumnL2 (Fin ap.Mc)) :
    ap.Λc I (Function.update (Function.update x c (ap.leafOut cat s I c G)) d
        (ap.leafOut cat s I d G)) =
      ((posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers d).reverse).map fun t' =>
        ((posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers c).reverse).map fun t =>
          ((t.1 : ℂ) * t'.1) *
            (ap.Λc I (Function.update (Function.update (Function.update x c
                (physicalColumnInput (ap.base I c))) d (physicalColumnInput (ap.base I d))) a
                  (chainSide ap.P (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a))) +
              chainDefect (ap.Λc I) ap.P a c d x (physicalColumnInput (ap.base I c))
                (physicalColumnInput (ap.base I d))
                (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a))).sum).sum := by
  unfold leafOut leafIn
  rw [form_layer_chains (ap.Λc I) hcd x]
  refine congrArg List.sum (List.map_congr_left fun t' _ => ?_)
  refine congrArg List.sum (List.map_congr_left fun t _ => ?_)
  congr 1
  rw [← ap.chainVal_chainSteps_c cat hcat rH s c d G I t.2 t'.2,
    ← ap.chainVal_chainSteps_d cat hcat rH s c d G I t.2 t'.2]
  have hxa : Function.update (Function.update x c (chainVal ap.P true
      (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (physicalColumnInput (ap.base I c)))) d
        (chainVal ap.P false (ap.chainSteps cat hcat rH s c d G I t.2 t'.2)
          (physicalColumnInput (ap.base I d))) =
      Function.update (Function.update (Function.update x c (chainVal ap.P true
        (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (physicalColumnInput (ap.base I c)))) d
          (chainVal ap.P false (ap.chainSteps cat hcat rH s c d G I t.2 t'.2)
            (physicalColumnInput (ap.base I d)))) a (x a) := by
    symm
    rw [Function.update_eq_self_iff, Function.update_of_ne had, Function.update_of_ne hac]
  rw [hxa]
  exact pad_transfer_chain (ap.Λc I) ap.hP hac had hcd x _ _
    ((rankMerge Prod.fst (ap.slotFilt s c G I t.2) (ap.slotFilt s d G I t'.2)).map
      (ap.toStep (cat c) (cat d) hcat rH I)) (x a)

end AttemptParams

end ActiveSetup

/-! ### The pair-small restored main term (blueprint lines 2261-2262, 2385-2386) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- Blueprint lines 2385-2386 ("the main term, with complements restored to their full `Y`
arguments, costs `η P^C |R|` absolutely, by pair-smallness, contractions, and Cauchy-Schwarz in
the two side sizes"), at one cell: with the full arguments `Y_c, Y_d` of a pair-small pair in two
slots and arbitrary inputs of normalized sizes `S_a, S_b` in the other two, the cell form is at most
`τ S_a S_b`. -/
theorem Λc_pair_small_le {I : ℤ × ℤ} (hI : I ∈ A.cells) {c d a b : Fin 4} (hcd : c ≠ d)
    (hca : c ≠ a) (hcb : c ≠ b) (hda : d ≠ a) (hdb : d ≠ b) (hab : a ≠ b)
    (X : Fin 4 → ColumnL2 (Fin ap.Mc)) {Yc Yd : ℝ → ℂ}
    (hYc : MemLp Yc 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)))
    {τ : ℝ} (hpair : PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I)
      c d Yc Yd τ)
    (hXc : X c = physicalColumnInput (cellLp A.G I Yc))
    (hXd : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (X d) y = Yd y)
    {Sa Sb : ℝ} (hSa : 0 < Sa) (hSb : 0 < Sb)
    (hXa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sa)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖ap.Λc I X‖ ≤ τ * Sa * Sb := by
  rw [ap.Λc_of_mem hI]
  have h := cellForm_pair_le (A.adm I hI) hcd hca hcb hda hdb hab ({()} : Finset Unit)
    (fun _ => 1) (fun _ => X d) (fun _ => Yd) (fun _ _ => hXd) Yc (fun _ _ => hpair) X
    (by rw [hXc]; exact augPhys_cellLp hYc) (by simp) hSa hSb hXa hXb
  simpa using h

/-- Blueprint lines 2261-2262 ("restoring `B_c, B_d` to `Y_c, Y_d`; each correction has an
additional basic side `U`"), at one cell: with `z = Y - V` in two slots, the form is the form of
the full pair minus the two corrections carrying `V_c` or `V_d`. -/
theorem Λc_restore {I : ℤ × ℤ} {c d : Fin 4} (hcd : c ≠ d) (X : Fin 4 → ColumnL2 (Fin ap.Mc))
    (Yc Yd Vc Vd : ColumnL2 (Fin ap.Mc)) :
    ap.Λc I (Function.update (Function.update X c (Yc - Vc)) d (Yd - Vd)) =
      ap.Λc I (Function.update (Function.update X c Yc) d Yd) -
        ap.Λc I (Function.update (Function.update X c Vc) d Yd) -
        ap.Λc I (Function.update (Function.update X c (Yc - Vc)) d Vd) := by
  rw [(ap.Λc I).map_update_sub, Function.update_comm hcd, (ap.Λc I).map_update_sub,
    Function.update_comm hcd.symm]
  rw [← Function.update_comm hcd Vc Yd X]

end AttemptParams

end ActiveSetup

/-! ### Passing residuals at the cell-form level and their averages (lines 1810-1811) -/

section CellPass

variable {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} {I : ℤ × ℤ} {κ : LocalKernelClass}
  {wI : ℝ × ℝ → ℂ}

/-- A residual `R` in slot `t` passes at level `β` at the cell-form level: against every pure
source whose tag lies in the mask, in another slot, and two spectators of normalized sizes
`S_a, S_b`, the cell form is at most `β S_a S_b` (blueprint eq:catalog-test). -/
def CellPass (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)
    wI) (c₀ : ℕ) (H : ℝ) (tagOf : Tg → ChartTag) (t : Fin 4) (M : Tg → Prop)
    (R : ColumnL2 (Fin Mc)) (β : ℝ) : Prop :=
  ∀ x, M x → ∀ {u a b : Fin 4}, u ≠ t → u ≠ a → u ≠ b → t ≠ a → t ≠ b → a ≠ b →
    ∀ A : QuadraticChartData (tagOf x).dim, QuadraticChartComplexity c₀ H A →
      A.horizontal = (tagOf x).θ → A.matrix = (slotCoeff u : ℚ) • (tagOf x).C →
      A.quadratic = slotCoeff u * (tagOf x).lam →
    ∀ X : Fin 4 → ColumnL2 (Fin Mc),
      (∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → augPhys (X u) y = quadraticChartAtom A y) →
      X t = R → ∀ {Sa Sb : ℝ}, 0 < Sa → 0 < Sb →
      eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sa →
      eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sb →
      ‖cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc) X‖ ≤ β * Sa * Sb

variable (hwI : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) wI)

/-- A passing residual passes at the cell-form level. -/
theorem ResidPass.cellPass {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {t : Fin 4}
    {M : Tg → Prop} {R : ColumnL2 (Fin Mc)} {β : ℝ}
    (h : ResidPass G I c₀ H tagOf wI t M R β) : CellPass hwI c₀ H tagOf t M R β :=
  fun _x hx _ _ _ hut hua hub hta htb hab A hA hAθ hAM hAq X hXu hXt _ _ hSa hSb hXa hXb =>
    h.form_le hwI hx hut hua hub hta htb hab A hA hAθ hAM hAq X hXu hXt hSa hSb hXa hXb

/-- The zero residual passes at level zero. -/
theorem CellPass.zero (c₀ : ℕ) (H : ℝ) (tagOf : Tg → ChartTag) (t : Fin 4) (M : Tg → Prop) :
    CellPass hwI c₀ H tagOf t M (0 : ColumnL2 (Fin Mc)) 0 := by
  intro x _ u a b _ _ _ _ _ _ A _ _ _ _ X _ hXt Sa Sb _ _ _ _
  rw [(cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc)).map_coord_zero t hXt]
  simp

/-- Blueprint lines 1810-1811 ("histories include every individual pad choice, so the tests also
hold for averages"): an average of residuals passing at level `β` passes at level `β`. -/
theorem CellPass.avg {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {t : Fin 4} {M : Tg → Prop}
    {ι : Type*} (s : Finset ι) (hs : s.Nonempty) (R : ι → ColumnL2 (Fin Mc)) {β : ℝ}
    (h : ∀ i ∈ s, CellPass hwI c₀ H tagOf t M (R i) β) :
    CellPass hwI c₀ H tagOf t M (((s.card : ℂ))⁻¹ • ∑ i ∈ s, R i) β := by
  intro x hx u a b hut hua hub hta htb hab A hA hAθ hAM hAq X hXu hXt Sa Sb hSa hSb hXa hXb
  have hXe : X = Function.update X t (((s.card : ℂ))⁻¹ • ∑ i ∈ s, R i) := by
    rw [← hXt, Function.update_eq_self]
  rw [hXe]
  refine norm_map_update_avg_le _ X t s hs R fun i hi => ?_
  refine h i hi x hx hut hua hub hta htb hab A hA hAθ hAM hAq _ ?_ (Function.update_self _ _ _)
    hSa hSb ?_ ?_
  · rw [Function.update_of_ne hut]; exact hXu
  · rw [Function.update_of_ne hta.symm]; exact hXa
  · rw [Function.update_of_ne htb.symm]; exact hXb

/-- A combination of pure sources in slot `u` (each tag in both masks) against the difference of
two passing residuals in slot `t`, with two spectators, has form at most
`(Σ |c_m|) (β₀ + β₁) S_a S_b` (the cell-form version of `ResidPass.form_band_le`). -/
theorem CellPass.form_band_le {c₀ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {t : Fin 4}
    {M₀ M₁ : Tg → Prop} {R₀ R₁ : ColumnL2 (Fin Mc)} {β₀ β₁ : ℝ}
    (h₀ : CellPass hwI c₀ H tagOf t M₀ R₀ β₀) (h₁ : CellPass hwI c₀ H tagOf t M₁ R₁ β₁)
    {u a b : Fin 4} (hut : u ≠ t) (hua : u ≠ a) (hub : u ≠ b) (hta : t ≠ a) (htb : t ≠ b)
    (hab : a ≠ b) {κs : Type*} (F : Finset κs) (c : κs → ℂ) (src : κs → ColumnL2 (Fin Mc))
    (tag : κs → Tg) (htag : ∀ m ∈ F, M₀ (tag m) ∧ M₁ (tag m))
    (hsrc : ∀ m ∈ F, ∃ A : QuadraticChartData (tagOf (tag m)).dim,
      QuadraticChartComplexity c₀ H A ∧ A.horizontal = (tagOf (tag m)).θ ∧
      A.matrix = (slotCoeff u : ℚ) • (tagOf (tag m)).C ∧
      A.quadratic = slotCoeff u * (tagOf (tag m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 → augPhys (src m) y = quadraticChartAtom A y)
    (X : Fin 4 → ColumnL2 (Fin Mc)) (hXu : X u = ∑ m ∈ F, c m • src m) (hXt : X t = R₀ - R₁)
    {Sa Sb : ℝ} (hSa : 0 < Sa) (hSb : 0 < Sb)
    (hXa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sa)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc) X‖ ≤
      (∑ m ∈ F, ‖c m‖) * ((β₀ + β₁) * Sa * Sb) := by
  set Λ := cellForm (dyadicGridLength_pos G I.1) hwI (Fin Mc)
  have hXe : X = Function.update X u (∑ m ∈ F, c m • src m) := by
    rw [← hXu, Function.update_eq_self]
  rw [hXe, Λ.map_update_sum, Finset.sum_mul]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m hm => ?_)
  rw [Λ.map_update_smul, smul_eq_mul, norm_mul]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
  obtain ⟨A, hA, hAθ, hAM, hAq, hAe⟩ := hsrc m hm
  set Y := Function.update X u (src m)
  have hYt : Y t = R₀ - R₁ := by
    simp only [Y]; rw [Function.update_of_ne hut.symm]; exact hXt
  have hsplit : Λ Y = Λ (Function.update Y t R₀) - Λ (Function.update Y t R₁) := by
    rw [← Λ.map_update_sub, ← hYt, Function.update_eq_self]
  rw [hsplit]
  have hYu : ∀ R, ∀ᵐ y ∂volume, y ∈ dyadicGridCell G I.1 I.2 →
      augPhys (Function.update Y t R u) y = quadraticChartAtom A y := fun R => by
    rw [Function.update_of_ne hut]; simp only [Y, Function.update_self]; exact hAe
  have hYa : ∀ R, Function.update Y t R a = X a := fun R => by
    rw [Function.update_of_ne hta.symm]; simp only [Y]; rw [Function.update_of_ne hua.symm]
  have hYb : ∀ R, Function.update Y t R b = X b := fun R => by
    rw [Function.update_of_ne htb.symm]; simp only [Y]; rw [Function.update_of_ne hub.symm]
  have e₀ := h₀ (tag m) (htag m hm).1 hut hua hub hta htb hab A hA hAθ hAM hAq _ (hYu R₀)
    (Function.update_self _ _ _) hSa hSb (by rw [hYa]; exact hXa) (by rw [hYb]; exact hXb)
  have e₁ := h₁ (tag m) (htag m hm).2 hut hua hub hta htb hab A hA hAθ hAM hAq _ (hYu R₁)
    (Function.update_self _ _ _) hSa hSb (by rw [hYa]; exact hXa) (by rw [hYb]; exact hXb)
  calc ‖Λ (Function.update Y t R₀) - Λ (Function.update Y t R₁)‖
      ≤ ‖Λ (Function.update Y t R₀)‖ + ‖Λ (Function.update Y t R₁)‖ := norm_sub_le _ _
    _ ≤ β₀ * Sa * Sb + β₁ * Sa * Sb := add_le_add e₀ e₁
    _ = (β₀ + β₁) * Sa * Sb := by ring

end CellPass
/-- Blueprint lines 1834-1836 ("expanding a rank-`r` outer primal costs at most `D √n_r` times
its input norm"): the coefficients of a catalog combination have absolute sum at most
`√(#labels) ‖x‖ / √|I|`. -/
theorem catCoeff_l1_le {Tg : Type*} {G : RealDyadicGrid} {Mc : ℕ} (s : List (CatCol Tg))
    (I : ℤ × ℤ) (F : Finset (Fin Mc)) (c : Fin Mc → ℂ) :
    ∑ n ∈ F, ‖c n‖ ≤ Real.sqrt F.card *
      (‖(∑ n ∈ F, c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n :
        ColumnL2 (Fin Mc))‖ / Real.sqrt (dyadicGridLength G I.1)) := by
  have hr := dyadicGridLength_pos G I.1
  have hl2 := catCombination_l2_le (G := G) s I F c
  have h1 := sum_mul_le_sqrt_mul_sqrt' F (fun _ => (1 : ℝ)) (fun n => ‖c n‖)
  simp only [one_mul, one_pow, Finset.sum_const, nsmul_eq_mul, mul_one] at h1
  refine h1.trans (mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _))
  rw [le_div_iff₀ (Real.sqrt_pos.mpr hr), ← Real.sqrt_mul (Finset.sum_nonneg fun _ _ =>
    sq_nonneg _)]
  calc Real.sqrt ((∑ n ∈ F, ‖c n‖ ^ 2) * dyadicGridLength G I.1)
      ≤ Real.sqrt (‖(∑ n ∈ F, c n • fitColumn (dyadicGridCell G I.1 I.2) (catAtom s n) n :
          ColumnL2 (Fin Mc))‖ ^ 2) := Real.sqrt_le_sqrt hl2
    _ = _ := Real.sqrt_sq (norm_nonneg _)

/-! ### Far bands: the helper band above the complement band (blueprint lines 2253-2254) -/

section FarHelper

variable {Tg : Type*}

/-- The zero residual passes at level zero against every mask. -/
theorem ResidPass.zero (G : RealDyadicGrid) {Mc : ℕ} (I : ℤ × ℤ) (c₀ : ℕ) (H : ℝ)
    (tagOf : Tg → ChartTag) (wI : ℝ × ℝ → ℂ) (t : Fin 4) (M : Tg → Prop) :
    ResidPass G I c₀ H tagOf wI t M (0 : ColumnL2 (Fin Mc)) 0 := by
  intro x _ u a b _ _ _ _ _ _ A _ _ _ _ z _ hzt _ _ _ _
  have h0 : z t =ᵐ[volume] 0 := by
    rw [hzt]
    filter_upwards [Lp.coeFn_zero (ColumnHilbert (Fin Mc)) 2 volume] with y hy
    rw [hy]; rfl
  have hz : localProgressionForm (dyadicGridLength G I.1) wI z =
      localProgressionForm (dyadicGridLength G I.1) wI (Function.update z t 0) := by
    refine localProgressionForm_congr_ae _ _ fun j => ?_
    by_cases hj : j = t
    · subst hj; rw [Function.update_self]; exact h0
    · rw [Function.update_of_ne hj]
  rw [hz, norm_le_zero_iff]
  unfold localProgressionForm
  simp [Finset.prod_eq_zero (Finset.mem_univ t)]

/-- Catalog ranges grow with the mask. -/
theorem catRange_mask_mono (G : RealDyadicGrid) (Mc : ℕ) (s : List (CatCol Tg)) (I : ℤ × ℤ)
    (r : ℕ) {M M' : Tg → Prop} (h : ∀ x, M x → M' x) :
    catRange G Mc s I r M ≤ catRange G Mc s I r M' := by
  refine Submodule.span_mono fun x hx => ?_
  obtain ⟨n, hn, h1, h2, h3, h4⟩ := hx
  exact ⟨n, hn, h1, h2, h _ h3, h4⟩

end FarHelper

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- A band of a pad family of catalog projections below the top lies in the catalog range of its
pad mask and has norm at most twice the input. -/
theorem padBand_mem (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin ap.P → A.Vtx → Prop) (hMm : ∀ i j : Fin ap.P, i ≤ j → ∀ x, M i x → M j x)
    {q : ℕ} (hq : q < ap.P) (v : ColumnL2 (Fin ap.Mc)) :
    padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (q + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) q v ∈
      catRange A.G ap.Mc cat I r (M ⟨q, hq⟩) ∧
    ‖padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (q + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) q v‖ ≤ 2 * ‖v‖ := by
  rw [padFam_succ _ hq]
  rcases q with _ | q
  · rw [padFam_zero]
    simp only [ContinuousLinearMap.coe_coe, LinearMap.zero_apply, sub_zero]
    exact ⟨Submodule.starProjection_apply_mem _ v,
      (norm_catProj_le _ _ _ _ _ _ v).trans (by linarith [norm_nonneg v])⟩
  · rw [padFam_succ _ (by omega)]
    simp only [ContinuousLinearMap.coe_coe]
    refine ⟨Submodule.sub_mem _ (Submodule.starProjection_apply_mem _ v)
      (catRange_mask_mono A.G ap.Mc cat I r (hMm ⟨q, by omega⟩ ⟨q + 1, hq⟩
        (Fin.mk_le_mk.mpr (Nat.le_succ q)))
        (Submodule.starProjection_apply_mem _ v)), ?_⟩
    refine (norm_sub_le _ _).trans ?_
    have h1 := norm_catProj_le A.G ap.Mc cat I r (M ⟨q + 1, hq⟩) v
    have h2 := norm_catProj_le A.G ap.Mc cat I r (M ⟨q, by omega⟩) v
    linarith

/-- Blueprint lines 2253-2254 (a far band pair with the helper band higher: "expand the lower `c`
band into its main pure sources; their tags lie in both masks writing the higher helper band as a
difference of residuals ... the helper test applies with arbitrary `L²` spectators"): at one cell,
the form with the helper band `Q_{a,p+1} - Q_{a,p}` of a side value in slot `a`, a lower catalog
band `Q_{u,q+1} - Q_{u,q}` (`q + 2 < p`) in slot `u` and two spectators is at most
`(#labels) (2 ‖v‖ / √|I|) (2 β) S_o S_b`, where `β` is the level of the helper tests. -/
theorem far_helper_le {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a)
    (huo : u ≠ o) (hub : u ≠ b) (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (catu : List (CatCol A.Vtx))
    (hT : ∀ d ∈ catu, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) u R γ d.birth d.rank d.tag)
    (r : ℕ) (M : Fin ap.P → A.Vtx → Prop) (hMm : ∀ i j : Fin ap.P, i ≤ j → ∀ x, M i x → M j x)
    (hav : ∀ k x, M k x → A.occAvail x.2.1 x.1) (hcatA : List (CatCol A.Vtx)) (rH : ℕ)
    (xa v : ColumnL2 (Fin ap.Mc)) {β : ℝ}
    (hpass : ∀ k : Fin ap.P, CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag a (M k)
      (xa - catProj A.G ap.Mc hcatA I rH (M k) xa) β) (hβ : 0 ≤ β)
    {p q : ℕ} (hpq : q + 2 < p) (hpP : p ≤ ap.P) (X : Fin 4 → ColumnL2 (Fin ap.Mc))
    (hXa : X a = padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) (p + 1) xa -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) p xa)
    (hXu : X u = padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) (q + 1) v -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) q v)
    {So Sb : ℝ} (hSo : 0 < So) (hSb : 0 < Sb)
    (hXo : eLpNorm (augPhys (X o)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal So)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖ap.Λc I X‖ ≤ (Real.sqrt (catLabels A.G ap.Mc catu I r (M ⟨q, by omega⟩)).card *
      (2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1))) * ((β + β) * So * Sb) := by
  classical
  have hqP : q < ap.P := by omega
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  obtain ⟨hmem, hnorm⟩ := ap.padBand_mem catu I r M hMm hqP v
  obtain ⟨c, -, -, -, hce⟩ := catRange_expansion hmem
  set F := catLabels A.G ap.Mc catu I r (M ⟨q, hqP⟩)
  -- the coefficient bound
  have hcs : ∑ n ∈ F, ‖c n‖ ≤
      Real.sqrt F.card * (2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1)) := by
    refine (catCoeff_l1_le (G := A.G) catu I F c).trans
      (mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _))
    rw [← hce]
    exact div_le_div_of_nonneg_right hnorm (Real.sqrt_nonneg _)
  have hR0 : 0 ≤ (Real.sqrt F.card * (2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1))) *
      ((β + β) * So * Sb) := by positivity
  by_cases hF : F = ∅
  · have hu0 : X u = 0 := by rw [hXu, hce, hF, Finset.sum_empty]
    rw [(ap.Λc I).map_coord_zero u hu0, norm_zero]
    exact hR0
  obtain ⟨n₀, hn₀⟩ := Finset.nonempty_iff_ne_empty.mpr hF
  have hmemF : ∀ n ∈ F, ∃ h : (n : ℕ) < catu.length, M ⟨q, hqP⟩ (catu[(n : ℕ)]).tag := by
    intro n hn
    simp only [F, catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hn
    obtain ⟨h, -, -, hM⟩ := hn
    exact ⟨h, hM⟩
  obtain ⟨hn₀l, -⟩ := hmemF n₀ hn₀
  set tag : Fin ap.Mc → A.Vtx := fun n =>
    if h : (n : ℕ) < catu.length then (catu[(n : ℕ)]).tag else (catu[(n₀ : ℕ)]).tag
  have htagF : ∀ n ∈ F, M ⟨q, hqP⟩ (tag n) := fun n hn => by
    obtain ⟨h, hM⟩ := hmemF n hn
    have htm : tag n = (catu[(n : ℕ)]).tag := dite_eq_left_of_eq_true (eq_true h)
    rw [htm]; exact hM
  have hsrc : ∀ m ∈ F, ∃ A' : QuadraticChartData (A.vtag (tag m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc A' ∧ A'.horizontal = (A.vtag (tag m)).θ ∧
      A'.matrix = (slotCoeff u : ℚ) • (A.vtag (tag m)).C ∧
      A'.quadratic = slotCoeff u * (A.vtag (tag m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom catu m) m) y =
          quadraticChartAtom A' y := by
    intro m hm
    obtain ⟨h, hM⟩ := hmemF m hm
    obtain ⟨A', hA', -, hθ, hMat, hq', he⟩ := catAtom_chart catu u hT (n := m) h
      (hav _ _ hM)
    have htm : tag m = (catu[(m : ℕ)]).tag := dite_eq_left_of_eq_true (eq_true h)
    rw [htm]
    refine ⟨A', hA', hθ, hMat, hq', ?_⟩
    rw [← he]
    exact augPhys_fitColumn_ae (catAtom_admissible catu m I) m
  have hXu' : X u =
      ∑ m ∈ F, c m • fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom catu m) m := by
    rw [hXu, ← hce]
  have hp1 : 1 ≤ p := by omega
  rw [ap.Λc_of_mem hI]
  by_cases hp : p < ap.P
  · have hXa' : X a = (xa - catProj A.G ap.Mc hcatA I rH (M ⟨p - 1, by omega⟩) xa) -
        (xa - catProj A.G ap.Mc hcatA I rH (M ⟨p, hp⟩) xa) := by
      rw [hXa, padFam_succ _ hp]
      obtain ⟨p', rfl⟩ : ∃ p', p = p' + 1 := ⟨p - 1, by omega⟩
      rw [padFam_succ _ (by omega)]
      simp only [ContinuousLinearMap.coe_coe, Nat.add_sub_cancel]
      abel
    have h := CellPass.form_band_le (A.adm I hI) (hpass ⟨p - 1, by omega⟩) (hpass ⟨p, hp⟩)
      hua huo hub hao hab hob F c
      (fun m => fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom catu m) m) tag
      (fun m hm => ⟨hMm _ _ (Fin.mk_le_mk.mpr (by omega)) _ (htagF m hm),
        hMm _ _ (Fin.mk_le_mk.mpr (by omega)) _ (htagF m hm)⟩)
      hsrc X hXu' hXa' hSo hSb hXo hXb
    exact h.trans (mul_le_mul_of_nonneg_right hcs (by positivity))
  · have e1 : padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) (p + 1) =
        LinearMap.id := by
      rw [show p + 1 = ap.P + 1 by omega]; exact padFam_top _
    have e2 : padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcatA I rH (M k)) p =
        (catProj A.G ap.Mc hcatA I rH (M ⟨p - 1, by omega⟩) :
          ColumnL2 (Fin ap.Mc) →ₗ[ℂ] ColumnL2 (Fin ap.Mc)) := by
      obtain ⟨p', rfl⟩ : ∃ p', p = p' + 1 := ⟨p - 1, by omega⟩
      exact padFam_succ _ (by omega)
    have hXa' : X a = (xa - catProj A.G ap.Mc hcatA I rH (M ⟨p - 1, by omega⟩) xa) - 0 := by
      rw [hXa, e1, e2, sub_zero]
      rfl
    have h := CellPass.form_band_le (A.adm I hI) (hpass ⟨p - 1, by omega⟩)
      (CellPass.zero (A.adm I hI) A.csrc A.Hsrc A.vtag a (M ⟨p - 1, by omega⟩))
      hua huo hub hao hab hob F c
      (fun m => fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom catu m) m) tag
      (fun m hm => ⟨hMm _ _ (Fin.mk_le_mk.mpr (by omega)) _ (htagF m hm),
        hMm _ _ (Fin.mk_le_mk.mpr (by omega)) _ (htagF m hm)⟩)
      hsrc X hXu' hXa' hSo hSb hXo hXb
    refine h.trans ?_
    calc (∑ m ∈ F, ‖c m‖) * ((β + 0) * So * Sb)
        ≤ (∑ m ∈ F, ‖c m‖) * ((β + β) * So * Sb) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right
            (by linarith) hSo.le) hSb.le) (Finset.sum_nonneg fun _ _ => norm_nonneg _)
      _ ≤ _ := mul_le_mul_of_nonneg_right hcs (by positivity)

end AttemptParams

