/-- The length of a rank merge is the sum of the lengths. -/
theorem rankMerge_length {α : Type*} (key : α → ℕ) :
    ∀ xs ys : List α, (rankMerge key xs ys).length = xs.length + ys.length
  | [], ys => by simp [rankMerge]
  | x :: xs, [] => by simp [rankMerge]
  | x :: xs, y :: ys => by
    unfold rankMerge
    split_ifs
    · rw [List.length_cons, rankMerge_length key xs (y :: ys)]; simp; omega
    · rw [List.length_cons, rankMerge_length key (x :: xs) ys]; simp; omega
termination_by xs ys => xs.length + ys.length

