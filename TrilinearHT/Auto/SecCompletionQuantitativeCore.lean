          fun I _ _ => hw G s I
  · obtain ⟨q, hq, hc⟩ := Finset.mem_biUnion.mp hc
    exact ⟨q.1, q.2, (Finset.mem_product.mp hq).2, (Finset.mem_filter.mp hc).1⟩
  · by_contra h
    exact hIF (Finset.mem_biUnion.mpr ⟨(G, s), Finset.mem_product.mpr ⟨Finset.mem_univ _, hs⟩,
      Finset.mem_filter.mpr ⟨hI, lt_of_not_ge h⟩⟩)

