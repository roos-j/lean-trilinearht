/-- A band strictly inside the pad family is a difference of two residuals. -/
theorem padBand_resid_lt (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin ap.P → A.Vtx → Prop) {q : ℕ} (hq1 : 1 ≤ q) (hq : q < ap.P)
    (v : ColumnL2 (Fin ap.Mc)) :
    padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (q + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) q v =
      (v - catProj A.G ap.Mc cat I r (M ⟨q - 1, by omega⟩) v) -
        (v - catProj A.G ap.Mc cat I r (M ⟨q, hq⟩) v) := by
  rw [padFam_succ _ hq]
  obtain ⟨q', rfl⟩ : ∃ q', q = q' + 1 := ⟨q - 1, by omega⟩
  rw [padFam_succ _ (by omega)]
  simp only [ContinuousLinearMap.coe_coe, Nat.add_sub_cancel]
  abel

/-- The top band of the pad family is a single residual. -/
theorem padBand_resid_top (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin ap.P → A.Vtx → Prop) (v : ColumnL2 (Fin ap.Mc)) :
    padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (ap.P + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) ap.P v =
      (v - catProj A.G ap.Mc cat I r (M ⟨ap.P - 1, by have := ap.hP; omega⟩) v) - 0 := by
  rw [padFam_top, sub_zero]
  have e2 : padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) ap.P =
      (catProj A.G ap.Mc cat I r (M ⟨ap.P - 1, by have := ap.hP; omega⟩) :
        ColumnL2 (Fin ap.Mc) →ₗ[ℂ] ColumnL2 (Fin ap.Mc)) := by
    have := ap.hP
    unfold padFam
    split_ifs with h1 h2
    · omega
    · rfl
    · omega
  rw [e2]
  rfl

/-- The normalized size of a band of a pad family of catalog projections. -/
theorem padBand_size (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) (r : ℕ)
    (M : Fin ap.P → A.Vtx → Prop) (hMm : ∀ i j : Fin ap.P, i ≤ j → ∀ x, M i x → M j x)
    {q : ℕ} (hq : q ≤ ap.P) (v : ColumnL2 (Fin ap.Mc)) {S : ℝ}
    (hS : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ S) :
    eLpNorm (augPhys (padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) (q + 1) v -
        padFam (fun k : Fin ap.P => catProj A.G ap.Mc cat I r (M k)) q v)) 2
      (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1)) ≤
      ENNReal.ofReal S := by
  refine (augPhys_normalized_le A.G I _).trans (ENNReal.ofReal_le_ofReal ?_)
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  refine le_trans (div_le_div_of_nonneg_right ?_ hsq.le) hS
  rcases Nat.lt_or_ge q ap.P with hq' | hq'
  · exact (ap.padBand_mem cat I r M hMm hq' v).2
  · have hqe : q = ap.P := by omega
    subst hqe
    rw [ap.padBand_resid_top cat I r M v, sub_zero]
    refine (norm_sub_le _ _).trans ?_
    have := norm_catProj_le A.G ap.Mc cat I r (M ⟨ap.P - 1, by have := ap.hP; omega⟩) v
    linarith

end AttemptParams

