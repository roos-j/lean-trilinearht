variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The positive filters of slot `l` of the leaf `s` at the cell `I` for the group `G` along the
positive chain `t` (outermost first): the ball filter, then the cumulative layers of the chain,
each as its catalog rank and its pad masks. -/
def slotFilt (s : ℕ) (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t : List ℕ) :
    List (ℕ × (Fin ap.P → A.Vtx → Prop)) :=
  (ap.leafR s l, fun p => ap.bmask I G (ap.leafJ s l) p) ::
    t.map fun m => (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p)

/-- The transfer step of a merged filter: helper pads of rank `r_H` on the helper catalog and
catalog pads of the filter rank on the catalog of its slot (`c` for `true`, `d` for `false`). -/
noncomputable def toStep (catc catd hcat : List (CatCol A.Vtx)) (rH : ℕ) (I : ℤ × ℤ)
    (e : Bool × (ℕ × (Fin ap.P → A.Vtx → Prop))) :
    Bool × (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) ×
      (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) :=
  (e.1, fun p => catProj A.G ap.Mc hcat I rH (e.2.2 p),
    fun p => catProj A.G ap.Mc (if e.1 then catc else catd) I e.2.1 (e.2.2 p))

/-- The cumulative layers of a positive chain are the averages of their pad families. -/
theorem applyAll_cum (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) :
    ∀ (t : List ℕ) (y : ColumnL2 (Fin ap.Mc)),
      applyAll ((t.map fun m => (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p)).map
        fun f : ℕ × (Fin ap.P → A.Vtx → Prop) => filterAvg ap.P
          (padFam fun p => catProj A.G ap.Mc cat I f.1 (f.2 p))) y =
        chainOp (ap.cumAt cat I) t y
  | [], y => rfl
  | m :: t, y => by
    simp only [List.map_cons, applyAll]
    rw [applyAll_cum cat I t y, filterAvg_padFam]
    rfl

/-- The filters of a slot along a positive chain compose to the ball filter of the chain output. -/
theorem applyAll_slotFilt (cat : List (CatCol A.Vtx)) (s : ℕ) (l : Fin 4) (G : A.Grp)
    (I : ℤ × ℤ) (t : List ℕ) (y : ColumnL2 (Fin ap.Mc)) :
    applyAll ((ap.slotFilt s l G I t).map fun f => filterAvg ap.P
        (padFam fun p => catProj A.G ap.Mc cat I f.1 (f.2 p))) y =
      ap.ballAt cat (ap.leafR s l) (ap.leafJ s l) G I (chainOp (ap.cumAt cat I) t y) := by
  unfold slotFilt
  rw [List.map_cons, applyAll, List.map_map]
  have h := ap.applyAll_cum cat I t y
  rw [List.map_map] at h
  rw [h, ap.ballAt_eq_filterAvg]

