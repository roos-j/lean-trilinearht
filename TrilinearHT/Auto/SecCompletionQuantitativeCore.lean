theorem near_bmask {I : ℤ × ℤ} {G : A.Grp}
    (hG : ∃ v ∈ A.admT.X (A.admAt I), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt I)) v) ∧
      ap.K.grp A.admT A.vtxBound (A.admAt I) v = G)
    {j p : ℕ} (hjp : ap.bbase j + p + 1 < ap.Hmax) {w y : A.Vtx} (hw : ap.bmask I G j p w)
    (hy : y ∈ A.admT.X (A.admAt I))
    (hd : (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) w y ≤ 1) :
    ap.bmask I G j (p + 1) y := by
  obtain ⟨v, hv, hs, rfl⟩ := hG
  have h := (A.masks ap.Hed ap.Hmax ap.ωp ap.ωh).2.1 (A.admAt I) v hv hs
    (ap.bbase j + p + 1) hjp w y hw hy hd
  exact h

/-- Blueprint lines 2255-2256 ("for a far source ... use the different-tag pair estimate"): a pure
source of a present vertex in slot `o`, with a bounded chart, is pair-separated (`PairSmall` with
`τ₂`) in the slots `o, a` from a template column of slot `a` whose present tag is more than one
edge away. -/
theorem far_pair {I : ℤ × ℤ} (hI : I ∈ A.cells) {o a : Fin 4} (hoa : o ≠ a) {y : A.Vtx}
    (Ay : QuadraticChartData (A.vtag y).dim) (hAy : QuadraticChartComplexity A.csrc A.Hsrc Ay)
    (hAb : IsBoundedQuadraticChart Ay) (hθ : Ay.horizontal = (A.vtag y).θ)
    (hM : Ay.matrix = (slotCoeff o : ℚ) • (A.vtag y).C)
    (hq : Ay.quadratic = slotCoeff o * (A.vtag y).lam)
    (cat : List (CatCol A.Vtx))
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) a R γ d.birth d.rank d.tag)
    {n : Fin ap.Mc} (hnl : (n : ℕ) < cat.length)
    (hw : (cat[(n : ℕ)]).tag ∈ A.admT.X (A.admAt I))
    (hfar : ¬ (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) (cat[(n : ℕ)]).tag y ≤ 1)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ ap.Hed) :
    PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) o a
      (quadraticChartAtom Ay) (catAtom cat n) τ₂ := by
  set x := (cat[(n : ℕ)]).tag
  have hav : A.occAvail x.2.1 x.1 := A.occAvail_of_mem hw
  obtain ⟨A', hA', hA'b, hθ', hM', hq', he⟩ := catAtom_chart cat a hT hnl hav
  rw [he]
  have hfar' : ¬ (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) y x ≤ 1 := by
    rwa [(A.tagDist ap.Hed).symm]
  have hnE := A.not_tagEdge_of_dist ap.Hed hfar'
  rw [A.depth_admAt hI] at hnE
  obtain ⟨b₁, b₂, hb, hb₁o, hb₁a, hb₂o, hb₂a, -⟩ := fin4_other_two o a hoa
  exact A.Dg_sep A.Hsrc τ₂ A.exp_two_le_Hsrc hτ₂ hτ₂1 (A.vtag y) (A.vtag x)
    hb₁o hb₁a hb hoa hb₂o.symm hb₂a.symm (A.vchart_dim y) (A.vchart_dim x) Ay A'
    (quadraticChartComplexity_mono_order hAy (by omega))
    (quadraticChartComplexity_mono_order hA' (by omega)) hAb hA'b hθ hM hq hθ' hM' hq'
    (dyadicGridLength_pos A.G I.1) (A.adm I hI) (fun hE => hnE (tagEdge_mono hE hHed))

end AttemptParams

