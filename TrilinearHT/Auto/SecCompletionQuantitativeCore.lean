chain on its averaged inner history passes at the level of the chain tests. -/
theorem chain_cum_cellPass (cat : Fin 4 → List (CatCol A.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    {τ : ℕ → ℝ} (l : Fin 4)
    (hpass : ∀ w : ap.TestIdx I l, (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc A.Hsrc
      A.vtag (A.w I) (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l))
    (s : Fin ap.leaves.length)
    (i : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).reverse).length)
    (k : Fin (ap.chainOf s l i).length) (p : Fin ap.P)
    (hmH : (chainHist (ap.chainOf s l i) (k + 1)).length ≤ ap.mH) :
    CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag l (ap.cmask I ((ap.chainOf s l i).getD k 0) p)
      (layerOp (ap.cumAt (cat l) I) (chainHist (ap.chainOf s l i) (k + 1))
          (physicalColumnInput (ap.base I l)) -
        catProj A.G ap.Mc (cat l) I (ap.Lc - (ap.chainOf s l i).getD k 0 + 1)
          (ap.cmask I ((ap.chainOf s l i).getD k 0) p)
          (layerOp (ap.cumAt (cat l) I) (chainHist (ap.chainOf s l i) (k + 1))
            (physicalColumnInput (ap.base I l))))
      (τ (ap.Lc - (ap.chainOf s l i).getD k 0 + 1) *
        ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
