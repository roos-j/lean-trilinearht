/-- The single-pad output commutes with the restrictions to cells at most as deep as its depth. -/
theorem padOutL_commute (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (p : Fin ap.P)
    (ls : List (ℕ × Bool)) (h : ℤ) {Q : ℤ × ℤ} (hQ : Q.1 ≤ (ap.cumBase cat hR hb).depth h) :
    (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (ap.padOutL cat hR hb r j G p ls h) =
    (ap.padOutL cat hR hb r j G p ls h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)) := by
  set rQ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G Q.1 Q.2)
    (dyadicGridCell_measurable A.G Q.1 Q.2)
  have hball : ((ap.ballFam cat hR hb r j G p).proj h).comp rQ =
      rQ.comp ((ap.ballFam cat hR hb r j G p).proj h) :=
    ((ap.ballFam cat hR hb r j G p).proj_commute_restrict h hQ).symm
  have hcum : ∀ m, (opAvg fun p : Fin ap.P =>
      ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h).comp rQ =
      rQ.comp (opAvg fun p : Fin ap.P =>
        ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h) := fun m =>
    opAvg_commute _ _ fun p =>
      (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj_commute_restrict h
        hQ).symm
  have hhist := layerOp_commute _ rQ hcum ls
  unfold padOutL globHist
  rw [← ContinuousLinearMap.comp_assoc, ← hball, ContinuousLinearMap.comp_assoc,
    ContinuousLinearMap.comp_assoc, hhist]

