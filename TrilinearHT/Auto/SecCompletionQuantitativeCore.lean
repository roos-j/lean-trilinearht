      η ^ (1 - p) * (81 * localFormUniformConstant κ' * (8 * (B₀ + Real.sqrt Ts))) ^ p *
        (T ^ (p / 2) * T ^ (p / 2) * T ^ (p / 2) * dyadicGridLength A.G A.R.1) := by
  have hsize : ∀ I ∈ S, ∀ G ∈ gs I, ∀ l,
      ‖π (D.core l G I (ap.leafOut cat s₀ (D.dcell I) l G))‖ ≤
        8 * (B₀ + Real.sqrt Ts) * Real.sqrt (dyadicGridLength A.G I.1) ∧
      ‖π (D.side l G I (ap.leafOut cat s₀ I l G) (ap.leafOut cat s₀ (D.dcell I) l G))‖ ≤
        8 * (B₀ + Real.sqrt Ts) * Real.sqrt (dyadicGridLength A.G I.1) := fun I hI G hG l =>
    let h := D.cell_piece_sizes l G I _ _ hB₀ hTs
