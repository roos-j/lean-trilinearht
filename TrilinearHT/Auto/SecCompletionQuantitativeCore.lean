/-! ### Global filters of the transfer steps (blueprint lines 2386-2391) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The global averaged cumulative filter of the layer `m` at depth `h`. -/
noncomputable def gCum (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  opAvg fun p : Fin ap.P => ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h

/-- The global positive chain of cumulative filters at depth `h` (outermost first). -/
noncomputable def gChain (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (ms : List ℕ) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  chainOp (fun m => ap.gCum cat hR hb m h) ms

/-- The global averaged ball filter at depth `h`. -/
noncomputable def gBall (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  opAvg fun p : Fin ap.P => (ap.ballFam cat hR hb r j G p).proj h

/-- A single cumulative pad projection at an active cell is the restriction of the global one. -/
theorem gCumPad_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) (p : Fin ap.P) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj I.1) =
      (catProj A.G ap.Mc cat I (ap.Lc - m + 1) (ap.cmask I m p)).comp
        (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2)) := by
  rw [ap.cumMask_restrict cat hR hb m p hI,
    (catProj_restrict A.G ap.Mc cat I (ap.Lc - m + 1) (ap.cmask I m p)).1]

/-- A single ball pad projection at an active cell is the restriction of the global one. -/
theorem gBallPad_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (p : ℕ) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      ((ap.ballFam cat hR hb r j G p).proj I.1) =
      (catProj A.G ap.Mc cat I r (ap.bmask I G j p)).comp
        (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2)) := by
  rw [(ap.ballFam_restrict cat hR hb r j G p hI).1,
    (catProj_restrict A.G ap.Mc cat I r (ap.bmask I G j p)).1]

/-- The global cumulative filter restricts to the cell filter. -/
theorem gCum_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (m : ℕ) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      (ap.gCum cat hR hb m I.1) =
      (ap.cumAt cat I m).comp (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)) :=
  opAvg_intertwine _ _ _ fun p => ap.gCumPad_restrict cat hR hb m p hI

/-- The global chain restricts to the cell chain. -/
theorem gChain_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    ∀ ms : List ℕ,
      (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)).comp (ap.gChain cat hR hb ms I.1) =
      (chainOp (ap.cumAt cat I) ms).comp (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2))
  | [] => by simp [gChain, chainOp]
  | m :: ms => by
    have ih := gChain_restrict cat hR hb hI ms
    change _ = ((ap.cumAt cat I m).comp (chainOp (ap.cumAt cat I) ms)).comp _
    change (columnL2Restriction _ _).comp ((ap.gCum cat hR hb m I.1).comp
      (ap.gChain cat hR hb ms I.1)) = _
    rw [← ContinuousLinearMap.comp_assoc, ap.gCum_restrict cat hR hb m hI,
      ContinuousLinearMap.comp_assoc, ih, ContinuousLinearMap.comp_assoc]

/-- The global ball filter restricts to the cell ball filter. -/
theorem gBall_restrict (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      (ap.gBall cat hR hb r j G I.1) =
      (ap.ballAt cat r j G I).comp (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)) :=
  opAvg_intertwine _ _ _ fun p => ap.gBallPad_restrict cat hR hb r j G p hI

