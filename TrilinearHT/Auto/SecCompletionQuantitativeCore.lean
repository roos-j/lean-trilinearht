/-- The kernel transform as an iterated integral of the phase-weighted kernel. -/
theorem kernelFT_eq_iter (q t : ℝ) :
    kernelFT w q t = ∫ s, ∫ x, (Real.fourierChar (-(s * t)) : ℂ) *
      ((Real.fourierChar (-(x * q)) : ℂ) * w (x, s)) := by
  unfold kernelFT
  simp_rw [Real.fourier_real_eq, Circle.smul_def, smul_eq_mul, ← integral_const_mul]

open Real in
/-- Blueprint line 2524 ("their frequencies differ by a tiny quantity, so replace the Fourier values
by the reference value"): the kernel transform is Lipschitz,
`|Ŵ(q, t) - Ŵ(q₁, t₁)| ≤ (2R)² A₀ · 2πR (|q - q₁| + |t - t₁|)`. -/
theorem kernelFT_lipschitz (hR : 0 ≤ R) (q t q₁ t₁ : ℝ) :
    ‖kernelFT w q t - kernelFT w q₁ t₁‖ ≤
      2 * R * (2 * R * (2 * π * R * (|q - q₁| + |t - t₁|) * A 0)) := by
  have hA := hw.A_nonneg 0
  have hint : ∀ q t s, Integrable (fun x => (Real.fourierChar (-(s * t)) : ℂ) *
      ((Real.fourierChar (-(x * q)) : ℂ) * w (x, s))) := by
    intro q t s
    refine Continuous.integrable_of_hasCompactSupport ?_ ?_
    · have hc := hw.smooth.continuous
      have h1 : Continuous fun x : ℝ => (Real.fourierChar (-(x * q)) : ℂ) :=
        continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
      exact continuous_const.mul (h1.mul (hc.comp (continuous_id.prodMk continuous_const)))
    · refine HasCompactSupport.intro (isCompact_Icc (a := -R) (b := R)) fun x hx => ?_
      by_contra hne
      have hw0 : w (x, s) ≠ 0 := fun h => hne (by rw [h, mul_zero, mul_zero])
      exact hx (abs_le.mp (hw.supp x s hw0).1)
  have houter : ∀ q t, Integrable (fun s => ∫ x, (Real.fourierChar (-(s * t)) : ℂ) *
      ((Real.fourierChar (-(x * q)) : ℂ) * w (x, s))) := by
    intro q t
    have h := (hw.integrable_phase q t).integral_prod_left
    simpa using h
  rw [kernelFT_eq_iter, kernelFT_eq_iter, ← integral_sub (houter q t) (houter q₁ t₁)]
  have hpt : ∀ s x, ‖(Real.fourierChar (-(s * t)) : ℂ) *
      ((Real.fourierChar (-(x * q)) : ℂ) * w (x, s)) - (Real.fourierChar (-(s * t₁)) : ℂ) *
        ((Real.fourierChar (-(x * q₁)) : ℂ) * w (x, s))‖ ≤
      2 * π * R * (|q - q₁| + |t - t₁|) * A 0 := by
    intro s x
    by_cases hw0 : w (x, s) = 0
    · simp only [hw0, mul_zero, sub_self, norm_zero]; positivity
    obtain ⟨hx, hs⟩ := hw.supp x s hw0
    have e : (Real.fourierChar (-(s * t)) : ℂ) * ((Real.fourierChar (-(x * q)) : ℂ) * w (x, s)) -
        (Real.fourierChar (-(s * t₁)) : ℂ) * ((Real.fourierChar (-(x * q₁)) : ℂ) * w (x, s)) =
        (((Real.fourierChar (-(s * t)) : ℂ) - (Real.fourierChar (-(s * t₁)) : ℂ)) *
            (Real.fourierChar (-(x * q)) : ℂ) +
          (Real.fourierChar (-(s * t₁)) : ℂ) *
            ((Real.fourierChar (-(x * q)) : ℂ) - (Real.fourierChar (-(x * q₁)) : ℂ))) *
          w (x, s) := by ring
    rw [e, norm_mul]
    have h1 := norm_fourierChar_sub_le (-(s * t)) (-(s * t₁))
    have h2 := norm_fourierChar_sub_le (-(x * q)) (-(x * q₁))
    have e1 : |-(s * t) - -(s * t₁)| = |s| * |t - t₁| := by
      rw [show -(s * t) - -(s * t₁) = -(s * (t - t₁)) by ring, abs_neg, abs_mul]
    have e2 : |-(x * q) - -(x * q₁)| = |x| * |q - q₁| := by
      rw [show -(x * q) - -(x * q₁) = -(x * (q - q₁)) by ring, abs_neg, abs_mul]
    rw [e1] at h1; rw [e2] at h2
    have hsum : ‖((Real.fourierChar (-(s * t)) : ℂ) - (Real.fourierChar (-(s * t₁)) : ℂ)) *
          (Real.fourierChar (-(x * q)) : ℂ) + (Real.fourierChar (-(s * t₁)) : ℂ) *
            ((Real.fourierChar (-(x * q)) : ℂ) - (Real.fourierChar (-(x * q₁)) : ℂ))‖ ≤
