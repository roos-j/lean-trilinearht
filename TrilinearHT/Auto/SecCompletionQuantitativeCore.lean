namespace VTest

variable {Tg : Type*} {Mc : ℕ}

/-- The helper test of a transfer step: target slot `a`, helper rank `r_H`, target mask `M_t`,
and the history of the first `k` helper averages of the steps (masks `M_st l p`) with the single
pad choice `c`, on the fixed base. -/
def ofSteps {P : ℕ} (hP : 0 < P) (a : Fin 4) (rH : ℕ) (Mt : Tg → Prop)
    (Mst : ℕ → Fin P → Tg → Prop) (k : ℕ) (c : Fin k → Fin P) (base : ColumnL2 (Fin Mc)) :
    VTest Tg Mc where
  t := a
  r := rH
  M := Mt
  m := k
  hr := fun _ => rH
  hM := fun l => Mst l (choiceExt hP c l)
  θ := fun _ => false
  base := base

/-- The history of a step helper test is the product of its single-choice helper projections. -/
theorem ofSteps_hist (G : RealDyadicGrid) (I : ℤ × ℤ) {P : ℕ} (hP : 0 < P) (a : Fin 4)
    (rH : ℕ) (Mt : Tg → Prop) (Mst : ℕ → Fin P → Tg → Prop) (k : ℕ) (c : Fin k → Fin P)
    (base : ColumnL2 (Fin Mc)) (mH : ℕ) (hk : k ≤ mH) (s : List (CatCol Tg)) :
    (ofSteps hP a rH Mt Mst k c base).hist G Mc I mH s =
      operatorComplementProduct (fun l => catProj G Mc s I rH (Mst l (choiceExt hP c l)))
        (fun _ => false) k base := by
  unfold hist
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
  change operatorComplementProduct (fun l => (ofSteps hP a rH Mt Mst k c base).Q G Mc I s l)
    (fun _ => false) (k + j) base = _
  rw [operatorComplementProduct_id_tail _ _ k (fun l hl => by
      change (if l < k then _ else _) = _
      rw [ite_eq_right_iff.mpr (fun h => absurd h (by omega))]) (fun _ _ => rfl) j]
  rw [operatorComplementProduct_congr _ k fun l hl => by
      change (if l < k then _ else _) = _
      rw [ite_eq_left_iff.mpr (fun h => absurd hl h)]]
  rfl

end VTest

/-- Blueprint lines 2253 and 1810-1811 (helper side): the residual of a single helper projection
on the side value after `k` averaged helper steps is the average over the pad choices of the
residuals of the step helper tests. -/
theorem helper_resid_avg {Tg : Type*} (G : RealDyadicGrid) (Mc : ℕ) (I : ℤ × ℤ)
    (s : List (CatCol Tg)) {P : ℕ} (hP : 0 < P) (a : Fin 4) (rH : ℕ) (Mt : Tg → Prop)
    (Mst : ℕ → Fin P → Tg → Prop) (k mH : ℕ) (hk : k ≤ mH) (base : ColumnL2 (Fin Mc)) :
    operatorComplementProduct (fun l => opAvg fun p => catProj G Mc s I rH (Mst l p))
        (fun _ => false) k base -
      catProj G Mc s I rH Mt (operatorComplementProduct
        (fun l => opAvg fun p => catProj G Mc s I rH (Mst l p)) (fun _ => false) k base) =
      (((Finset.univ : Finset (Fin k → Fin P)).card : ℂ))⁻¹ • ∑ c : Fin k → Fin P,
        (VTest.ofSteps hP a rH Mt Mst k c base).resid G Mc I mH s := by
  have hX := complementProduct_opAvg hP (fun l p => catProj G Mc s I rH (Mst l p))
    (fun _ => false) k base
  rw [hX, map_smul, map_sum, ← smul_sub, ← Finset.sum_sub_distrib]
  rw [Finset.card_univ, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin]
  push_cast
  congr 1
  refine Finset.sum_congr rfl fun c _ => ?_
  unfold VTest.resid
  rw [VTest.ofSteps_hist G I hP a rH Mt Mst k c base mH hk s]
  rfl

