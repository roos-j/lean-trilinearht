    rw [abs_mul, abs_of_nonneg (hw0 n)]
    exact mul_le_mul_of_nonneg_left (he n) (hw0 n)
  have hs2 : Summable fun n => w n * ε := hw.summable.mul_right ε
  calc |∑' n, w n * e n| ≤ ∑' n, |w n * e n| := by
        have h := norm_tsum_le_tsum_norm (f := fun n => w n * e n) hsum.norm
        simpa only [Real.norm_eq_abs] using h
