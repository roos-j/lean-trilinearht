/-- The residual of a single catalog projection on a layered history of the slot input is the
average over the pad choices of the residuals of the single-choice tests with that target. -/
theorem resid_layer_avg (cat : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) (l : Fin 4) (r : ℕ)
    (M : A.Vtx → Prop) (ls : List (ℕ × Bool)) (hmH : ls.length ≤ ap.mH) :
    layerOp (ap.cumAt (cat l) I) ls (physicalColumnInput (ap.base I l)) -
        catProj A.G ap.Mc (cat l) I r M
          (layerOp (ap.cumAt (cat l) I) ls (physicalColumnInput (ap.base I l))) =
      (((Finset.univ : Finset (Fin ap.P × (Fin ls.length → Fin ap.P))).card : ℂ))⁻¹ •
        ∑ pc : Fin ap.P × (Fin ls.length → Fin ap.P),
          ((ap.filters cat I).test l r M ls pc.2).resid A.G ap.Mc I ap.mH (cat l) := by
  have h := residual_layerOp_eq_avg A.G ap.Mc I (cat l) ap.hP (fun m => ap.Lc - m + 1)
    (ap.cmask I) l r (fun _ => M) ls ap.mH hmH (ap.base I l)
  simp only [opAvg_const ap.hP] at h
  exact h

