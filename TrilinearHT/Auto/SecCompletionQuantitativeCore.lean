/-! ### Variation of single ball pads over global histories (blueprint lines 2390-2391) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- A single ball pad projection of a group composed with the global history. -/
noncomputable def padOutL (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (p : Fin ap.P)
    (ls : List (ℕ × Bool)) (h : ℤ) : ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  ((ap.ballFam cat hR hb r j G p).proj h).comp
    (globHist (ap.cumBase cat hR hb) (ap.cumMask cat hR hb) ls h)

open Classical in
/-- The single-pad outputs of the groups on the certified cells of one depth are jointly Bessel
(the pad part of `globOut_joint`). -/
theorem pad_joint (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (ls : List (ℕ × Bool)) (ht : ℤ) (Ec : ι → Finset (ℤ × ℤ))
    (hEc : ∀ G, ∀ I ∈ Ec G, I ∈ A.cells ∧ I.1 = ht)
    (hcert : ∀ G, ∀ I ∈ Ec G, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    (p : Fin ap.P) (w : ColumnL2 (Fin ap.Mc)) :
    ∑ G, ‖columnL2Restriction (⋃ I ∈ Ec G, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.padOutL cat hR hb r₀ j (grp G) p ls ht w)‖ ^ 2 ≤ (1 + τ * N * 1 ^ 2) * ‖w‖ ^ 2 := by
  have hp := ap.hP
  set H := globHist (ap.cumBase cat hR hb) (ap.cumMask cat hR hb) ls ht w
  set rE : ι → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) := fun G =>
    columnL2Restriction (⋃ I ∈ Ec G, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hC : (0 : ℝ) ≤ 1 + τ * N * 1 ^ 2 := by positivity
  have hj := joint_bessel_of_wholeRanges (Finset.univ : Finset ι) (fun G => G)
    (fun G => (rE G).comp ((ap.ballFam cat hR hb r₀ j (grp G) p).proj ht))
    (fun G h' => by
      rw [Finset.sum_eq_single_of_mem G (by simp) (fun b hb hne => by
        exact absurd (Finset.mem_filter.mp hb).2 hne)]
      have h1 : ‖((rE G).comp ((ap.ballFam cat hR hb r₀ j (grp G) p).proj ht)) h'‖ ≤ ‖h'‖ := by
        simp only [ContinuousLinearMap.comp_apply, rE]
        exact (columnL2Indicator_norm_le _ (Finset.measurableSet_biUnion _ fun I _ =>
          dyadicGridCell_measurable A.G I.1 I.2) _).trans (starProjection_norm_apply_le _
            ((ap.ballFam cat hR hb r₀ j (grp G) p).isStarProjection_proj ht) h')
      exact pow_le_pow_left₀ (norm_nonneg _) h1 2)
    hC (fun x => ap.attempt_wr2 cat t₀ hT hR hb grp hgrp k r₀ j hPH ht Ec hEc hcert hroot hτ
      hτ1 hHed hN p x) H
  refine le_trans (le_of_eq ?_) (hj.trans (mul_le_mul_of_nonneg_left
    (pow_le_pow_left₀ (norm_nonneg _) (globHist_norm_le _ hp _ ls ht w) 2) hC))
  rfl

open Classical in
/-- Blueprint lem:variation for one ball pad (the single-pad version of `attempt_variation`): the
single-pad outputs of the groups, restricted at the right endpoints to unions of certified active
cells, have square-summable variation over disjoint depth intervals. -/
theorem attempt_variation_pad (cat : List (CatCol A.Vtx)) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (hanc : A.AncClosed)
    {ι ι' : Type*} [Fintype ι] [Fintype ι'] (grp : ι → A.Grp)
    (hgrp : Function.Injective grp) (k r₀ j : ℕ) (hPH : ap.bbase j + ap.P ≤ ap.Hmax)
    (ls : List (ℕ × Bool)) (r t : ι' → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (Ec : ι → ι' → Finset (ℤ × ℤ))
    (hEc : ∀ G i, ∀ I ∈ Ec G i, I ∈ A.cells ∧ I.1 = A.R.1 + t i)
    (hcert : ∀ G i, ∀ I ∈ Ec G i, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc cat I r₀ (ap.bmask I (grp q.1) j p)).card ≤ N)
    (p : Fin ap.P) (z : ColumnL2 (Fin ap.Mc)) :
    ∑ q : ι × ι', ‖columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + t q.2) z -
          ap.padOutL cat hR hb r₀ j (grp q.1) p ls (A.R.1 + r q.2) z)‖ ^ 2 ≤
      2 * (1 + τ * N * 1 ^ 2) *
        (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 * ‖z‖ ^ 2 +
          ls.length * (∑ m ∈ Finset.range ls.length,
            compressionC (ap.cumBase cat hR hb).D m ^ 2) * ‖z‖ ^ 2) := by
  set Ψ0 := ap.cumBase cat hR hb
  set Am := ap.cumMask cat hR hb
  set T := Finset.univ.sup t
  have ht : ∀ i, t i ≤ T := fun i => Finset.le_sup (f := t) (Finset.mem_univ i)
  have hCw : (0 : ℝ) ≤ 1 + τ * N * 1 ^ 2 := by positivity
  have key := certifiedVariation_gen T
    (fun G n => (ap.ballFam cat hR hb r₀ j (grp G) p).proj (A.R.1 + n))
    (fun G n _ => ColumnDepthFamily.isStarProjection_proj _ _)
    (fun G a _ b _ hab => ColumnDepthFamily.proj_nested _ (by omega))
    (fun G i => columnL2Restriction (⋃ I ∈ Ec G i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2))
    (fun G i y => columnL2Indicator_norm_le _ (Finset.measurableSet_biUnion _ fun I _ =>
      dyadicGridCell_measurable A.G I.1 I.2) y) r t hrt ht hdis
    (fun i => globHist Ψ0 Am ls (A.R.1 + t i) z) (fun i => globHist Ψ0 Am ls (A.R.1 + r i) z) z
    (G₀ := compressionC Ψ0.D ls.length ^ 2)
    (J := ls.length * (∑ m ∈ Finset.range ls.length, compressionC Ψ0.D m ^ 2) * ‖z‖ ^ 2) hCw
    (fun x => ap.attempt_wr1 cat t₀ hT hR hb hanc grp hgrp k r₀ j hPH r t hrt Ec hEc hcert
      hroot hτ hτ1 hHed hN p x)
    ?_
    (fun i x => ap.attempt_wr2 cat t₀ hT hR hb grp hgrp k r₀ j hPH (A.R.1 + t i)
      (fun G => Ec G i) (fun G => hEc G i) (fun G => hcert G i) hroot hτ hτ1 hHed hN p x)
    (globHist_jump Ψ0 ap.hP Am ls r t hrt hdis z)
  · refine le_trans (le_of_eq ?_) (key.trans (le_of_eq (by ring)))
    rfl
  · intro c hc hB
    have h := globHist_compression Ψ0 ap.hP Am ls (fun q : ι × ι' => A.R.1 + r q.2)
      (fun q => (columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        ((ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + t q.2) -
          (ap.ballFam cat hR hb r₀ j (grp q.1) p).proj (A.R.1 + r q.2))) hc hB
      (fun q x => ap.attempt_blk cat hR hb r₀ j (grp q.1) p (by have := hrt q.2; omega)
        (Ec q.1 q.2) (fun I hI => (hEc q.1 q.2 I hI).1) x) z
    refine h.trans (le_of_eq ?_)
    ring


