/-- Blueprint lines 1807-1811 on a positive chain (the main test of a transfer step removing a ball
filter): the residual of a single ball pad projection on the averaged chain history of the slot
input passes at the level of the chain tests. -/
theorem chain_ball_cellPass (cat : Fin 4 → List (CatCol A.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    {τ : ℕ → ℝ} (l : Fin 4)
    (hpass : ∀ w : ap.TestIdx I l, (ap.tests (fun _ => []) I l w).Pass A.G ap.Mc I A.csrc A.Hsrc
      A.vtag (A.w I) (τ (ap.tests (fun _ => []) I l w).r) ap.mH (cat l))
    (s : Fin ap.leaves.length)
    (i : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).reverse).length)
    {G : A.Grp} (hG : G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k) (k : Fin ap.P)
    (hmH : (chainHist (ap.chainOf s l i) 0).length ≤ ap.mH) :
    CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag l
      (ap.bmask I G ((leafAt ap.fuel ap.Lc ap.up₀ s).role l) k)
      (layerOp (ap.cumAt (cat l) I) (chainHist (ap.chainOf s l i) 0)
          (physicalColumnInput (ap.base I l)) -
        catProj A.G ap.Mc (cat l) I (ap.Lc + (leafAt ap.fuel ap.Lc ap.up₀ s).role l)
          (ap.bmask I G ((leafAt ap.fuel ap.Lc ap.up₀ s).role l) k)
          (layerOp (ap.cumAt (cat l) I) (chainHist (ap.chainOf s l i) 0)
            (physicalColumnInput (ap.base I l))))
      (τ (ap.Lc + (leafAt ap.fuel ap.Lc ap.up₀ s).role l) *
        ‖physicalColumnInput (V := Fin ap.Mc) (ap.base I l)‖ /
          Real.sqrt (dyadicGridLength A.G I.1)) := by
  rw [ap.resid_layer_avg cat I l _ _ _ hmH]
  refine CellPass.avg (A.adm I hI) _ ⟨(⟨0, ap.hP⟩, fun _ => ⟨0, ap.hP⟩), Finset.mem_univ _⟩ _
    fun pc _ => ?_
  have h := hpass (Sum.inr ⟨s, i, Sum.inl (⟨G, hG⟩, k, pc.2)⟩)
  rw [ap.tests_indep (fun _ => []) cat] at h
  exact ResidPass.cellPass (A.adm I hI) (CatTest.residPass h)

