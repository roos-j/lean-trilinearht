/-- Blueprint lines 2253 and 1810-1811: if the step helper tests pass at threshold `τ_H` for
every pad choice, the residual of a single helper projection on the side value after `k` averaged
helper steps passes at level `τ_H ‖base‖ / √|I|`. -/
theorem helper_cellPass {I : ℤ × ℤ} (hI : I ∈ A.cells) (hcat : List (CatCol A.Vtx)) (a : Fin 4)
    (rH : ℕ) (Mt : A.Vtx → Prop) (Mst : ℕ → Fin ap.P → A.Vtx → Prop) (k : ℕ) (hk : k ≤ ap.mH)
    (base : ColumnL2 (Fin ap.Mc)) {τH : ℝ}
    (hpass : ∀ c : Fin k → Fin ap.P, (VTest.ofSteps ap.hP a rH Mt Mst k c base).Pass A.G I
      A.csrc A.Hsrc A.vtag (A.w I) τH ap.mH hcat) :
    CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag a Mt
      (operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH (Mst l p))
          (fun _ => false) k base -
        catProj A.G ap.Mc hcat I rH Mt (operatorComplementProduct
          (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH (Mst l p)) (fun _ => false) k
            base))
      (τH * ‖base‖ / Real.sqrt (dyadicGridLength A.G I.1)) := by
  rw [helper_resid_avg A.G ap.Mc I hcat ap.hP a rH Mt Mst k ap.mH hk base]
  refine CellPass.avg (A.adm I hI) _ ⟨fun _ => ⟨0, ap.hP⟩, Finset.mem_univ _⟩ _
    fun c _ => ResidPass.cellPass (A.adm I hI) (VTest.residPass (hpass c))

