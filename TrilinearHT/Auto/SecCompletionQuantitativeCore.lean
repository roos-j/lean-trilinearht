/-- The group-indexed path sums of the used cells are the cell-indexed sums. -/
theorem usedCells_sum (Sc : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp)
    (n : ℕ) {I : ℤ × ℤ} (hI : I ∈ Sc) (hgs : gs I ⊆ gset)
    (hdep : A.R.1 ≤ I.1 ∧ I.1 ≤ A.R.1 + n) (f : Fin 4 → A.Grp → ℝ) :
    ∑ l, ∑ G : {G // G ∈ gset}, ∑ s ∈ Finset.range (n + 1),
      (if I ∈ A.usedCells Sc gs G.1 s then f l G.1 else 0) = ∑ G ∈ gs I, ∑ l, f l G := by
  conv_lhs => rw [Finset.sum_comm]
  have hs : ∀ G : {G // G ∈ gset}, ∀ l, ∑ s ∈ Finset.range (n + 1),
      (if I ∈ A.usedCells Sc gs G.1 s then f l G.1 else 0) =
      if G.1 ∈ gs I then f l G.1 else 0 := by
    intro G l
    rw [Finset.sum_eq_single (I.1 - A.R.1).toNat]
    · unfold ActiveSetup.usedCells
      simp only [Finset.mem_filter, hI, true_and]
      congr 1
      apply propext
      constructor
      · exact fun h => h.2
      · exact fun h => ⟨by omega, h⟩
    · intro s _ hs
      rw [ite_eq_right_iff]
      intro h
      unfold ActiveSetup.usedCells at h
      exact absurd (by have := (Finset.mem_filter.mp h).2.1; omega) hs
    · intro h
      exact absurd (Finset.mem_range.mpr (by omega)) h
  simp_rw [hs]
  have hite : ∀ G : A.Grp, ∑ l, (if G ∈ gs I then f l G else 0) =
      if G ∈ gs I then ∑ l, f l G else 0 := fun G => by split_ifs <;> simp
  simp_rw [hite]
  rw [Finset.sum_coe_sort gset (fun G => if G ∈ gs I then ∑ l, f l G else 0),
    Finset.sum_ite_mem, Finset.inter_eq_right.mpr hgs]

