/-- The side value after merged helper steps is a contraction of the side state. -/
theorem norm_chainSide_mergeSteps_le (catc catd hcat : List (CatCol A.Vtx)) (rH : ℕ)
    (I : ℤ × ℤ) :
    ∀ (pre : List (Bool × (ℕ × (Fin ap.P → A.Vtx → Prop)))) (x : ColumnL2 (Fin ap.Mc)),
      ‖chainSide ap.P (((pre.map (ap.toStep catc catd hcat rH I)).map
          fun st => (st.1, padFam st.2.1, padFam st.2.2))) x‖ ≤ ‖x‖
  | [], x => le_rfl
  | e :: pre, x => by
    rw [List.map_cons, List.map_cons, chainSide]
    refine (norm_chainSide_mergeSteps_le catc catd hcat rH I pre _).trans ?_
    change ‖filterAvg ap.P (padFam fun p => catProj A.G ap.Mc hcat I rH (e.2.2 p)) x‖ ≤ _
    rw [filterAvg_padFam]
    exact norm_opAvg_apply_le _ (fun _ z => norm_catProj_le _ _ _ _ _ _ z) x

