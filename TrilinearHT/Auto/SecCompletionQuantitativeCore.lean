/-! ### Near and far parts of the transfer defects (blueprint lines 2252-2258) -/

section DefectSplit

variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- The band defects of the transfer steps restricted to the band pairs `(p, q)` selected by
`sel` (the near pairs `|p - q| ≤ 2` or the far pairs). -/
noncomputable def chainDefectSel (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel] :
    List (TransferStep E) → E → ℂ
  | [], _ => 0
  | st :: rest, xa =>
      (∑ p ∈ Finset.range (P + 1), ∑ q ∈ (Finset.range (P + 1)).filter (sel p),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))) +
        chainDefectSel Λ P a c d x yc yd sel rest (filterAvg P st.2.1 xa)

/-- The band defects split into the selected and the remaining band pairs. -/
theorem chainDefect_split (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel] :
    ∀ (steps : List (TransferStep E)) (xa : E),
      chainDefect Λ P a c d x yc yd steps xa =
        chainDefectSel Λ P a c d x yc yd sel steps xa +
          chainDefectSel Λ P a c d x yc yd (fun p q => ¬ sel p q) steps xa
  | [], xa => by simp [chainDefect, chainDefectSel]
  | st :: rest, xa => by
    rw [chainDefect, chainDefectSel, chainDefectSel,
      chainDefect_split Λ P a c d x yc yd sel rest (filterAvg P st.2.1 xa)]
    have h : ∀ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd)))) =
        ∑ q ∈ (Finset.range (P + 1)).filter (sel p),
          (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
            (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
              (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
                (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                  st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd)))) +
        ∑ q ∈ (Finset.range (P + 1)).filter (fun q => ¬ sel p q),
          (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
            (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
              (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
                (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                  st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd)))) :=
      fun p _ => (Finset.sum_filter_add_sum_filter_not _ _ _).symm
    rw [Finset.sum_congr rfl h, Finset.sum_add_distrib]
    ring

end DefectSplit

section DefectBound

variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- If every selected band term of every step (with the side value of the earlier steps) is at
most `B`, the selected defects are at most `#steps (P + 1)² B` (the transfer coefficients
`(p - q) / P` have modulus at most one). -/
theorem chainDefectSel_le (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {P : ℕ} (hP : 0 < P)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel]
    {B : ℝ} (hB0 : 0 ≤ B) :
    ∀ (steps : List (TransferStep E)) (xa : E),
      (∀ pre st rest, steps = pre ++ st :: rest → ∀ p ≤ P, ∀ q ≤ P, sel p q →
        ‖Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) (chainSide P pre xa) - st.2.1 p (chainSide P pre xa)))
              (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))‖ ≤ B) →
      ‖chainDefectSel Λ P a c d x yc yd sel steps xa‖ ≤ steps.length * ((P + 1) ^ 2 * B)
  | [], xa, _ => by simp [chainDefectSel]
  | st :: rest, xa, hB => by
    rw [chainDefectSel]
    have ih := chainDefectSel_le Λ hP a c d x yc yd sel hB0 rest (filterAvg P st.2.1 xa)
      (fun pre st' rest' he p hp q hq hs => by
        have := hB (st :: pre) st' rest' (by rw [he]; rfl) p hp q hq hs
        simpa [chainSide] using this)
    have hP' : (0 : ℝ) < P := by exact_mod_cast hP
    have hhead : ‖∑ p ∈ Finset.range (P + 1), ∑ q ∈ (Finset.range (P + 1)).filter (sel p),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))‖ ≤
        (P + 1) ^ 2 * B := by
      refine (norm_sum_le _ _).trans ?_
      calc ∑ p ∈ Finset.range (P + 1), ‖∑ q ∈ (Finset.range (P + 1)).filter (sel p),
            (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
              (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
                (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
                  (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                    st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))‖
          ≤ ∑ _p ∈ Finset.range (P + 1), ∑ _q ∈ Finset.range (P + 1), B := by
            refine Finset.sum_le_sum fun p hp => (norm_sum_le _ _).trans ?_
            refine le_trans (Finset.sum_le_sum fun q hq => ?_)
              (Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
                fun _ _ _ => hB0)
            obtain ⟨hq1, hsel⟩ := Finset.mem_filter.mp hq
            have hpP := Finset.mem_range.mp hp
            have hqP := Finset.mem_range.mp hq1
            rw [norm_mul]
            have hc : ‖((p : ℂ) - q) / P‖ ≤ 1 := by
              have e : ((p : ℂ) - q) / P = (((p : ℝ) - q) / P : ℝ) := by push_cast; ring
              rw [e, Complex.norm_real, Real.norm_eq_abs, abs_div, abs_of_pos hP',
                div_le_one hP', abs_sub_le_iff]
              have h1 : (p : ℝ) ≤ P := by exact_mod_cast Nat.lt_succ_iff.mp hpP
              have h2 : (q : ℝ) ≤ P := by exact_mod_cast Nat.lt_succ_iff.mp hqP
              have h3 : (0 : ℝ) ≤ p := Nat.cast_nonneg _
              have h4 : (0 : ℝ) ≤ q := Nat.cast_nonneg _
              constructor <;> linarith
            have hΛ := hB [] st rest rfl p (Nat.lt_succ_iff.mp hpP) q (Nat.lt_succ_iff.mp hqP) hsel
            calc _ ≤ 1 * B := mul_le_mul hc hΛ (norm_nonneg _) zero_le_one
              _ = B := one_mul B
        _ = (P + 1) ^ 2 * B := by
            rw [Finset.sum_const, Finset.sum_const, Finset.card_range, nsmul_eq_mul,
              nsmul_eq_mul]
            push_cast; ring
    rw [List.length_cons]
    push_cast
    calc _ ≤ _ := norm_add_le _ _
      _ ≤ (P + 1) ^ 2 * B + rest.length * ((P + 1) ^ 2 * B) := add_le_add hhead ih
      _ = _ := by ring

end DefectBound

/-! ### Steps of a rank merge (blueprint line 2241) -/

section RankMergeSteps

variable {α : Type*}

/-- Blueprint line 2241 ("remove the larger rank among the two current outermost positive
filters ... the other complementary argument always has a strictly lower-rank outer primal
source"): every step of a rank merge takes the head of a suffix of one list, the remaining steps
are the merge of the remaining suffixes, and the head of the other remaining suffix has smaller
(for a `c` step: strictly smaller) rank. -/
theorem rankMerge_decomp (key : α → ℕ) :
    ∀ (xs ys : List α) (pre : List (Bool × α)) (e : Bool × α) (rest : List (Bool × α)),
      rankMerge key xs ys = pre ++ e :: rest →
      ∃ xs' ys' : List α, rest = rankMerge key xs' ys' ∧
        ((e.1 = true ∧ (e.2 :: xs') <:+ xs ∧ ys' <:+ ys ∧ ∀ y ∈ ys'.head?, key y < key e.2) ∨
         (e.1 = false ∧ xs' <:+ xs ∧ (e.2 :: ys') <:+ ys ∧
            ∀ x ∈ xs'.head?, key x ≤ key e.2))
  | [], ys, pre, e, rest, h => by
    simp only [rankMerge] at h
    obtain ⟨ys₁, y, ys₂, rfl, hpre, he, hrest⟩ : ∃ ys₁ y ys₂, ys = ys₁ ++ y :: ys₂ ∧
        pre = ys₁.map (fun y => (false, y)) ∧ e = (false, y) ∧
        rest = ys₂.map (fun y => (false, y)) := by
      obtain ⟨l₁, l₂, hl, hpre', hrest'⟩ := List.map_eq_append_iff.mp h
      obtain ⟨y, ys₂, rfl, he', hr'⟩ := List.map_eq_cons_iff.mp hrest'
      exact ⟨l₁, y, ys₂, hl, hpre'.symm, he'.symm, hr'.symm⟩
    refine ⟨[], ys₂, by rw [hrest]; simp [rankMerge], Or.inr ⟨by rw [he], List.nil_suffix,
      by rw [he]; exact List.suffix_append _ _, by simp⟩⟩
  | x :: xs, [], pre, e, rest, h => by
    simp only [rankMerge] at h
    obtain ⟨l₁, l₂, hl, hpre', hrest'⟩ := List.map_eq_append_iff.mp h
    obtain ⟨z, zs, rfl, he', hr'⟩ := List.map_eq_cons_iff.mp hrest'
    refine ⟨zs, [], by rw [← hr']; cases zs <;> simp [rankMerge], Or.inl ⟨by rw [← he'],
      by rw [← he']; simp only; rw [hl]; exact List.suffix_append _ _, List.nil_suffix,
      by simp⟩⟩
  | x :: xs, y :: ys, pre, e, rest, h => by
    unfold rankMerge at h
    split_ifs at h with hk
    · rcases pre with _ | ⟨e₀, pre⟩
      · simp only [List.nil_append, List.cons.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        exact ⟨xs, y :: ys, rfl, Or.inl ⟨rfl, List.suffix_refl _, List.suffix_refl _,
          by simpa using hk⟩⟩
      · simp only [List.cons_append, List.cons.injEq] at h
        obtain ⟨xs', ys', hr, h'⟩ := rankMerge_decomp key xs (y :: ys) pre e rest h.2
        refine ⟨xs', ys', hr, ?_⟩
        rcases h' with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩
        · exact Or.inl ⟨h1, h2.trans (List.suffix_cons _ _), h3, h4⟩
        · exact Or.inr ⟨h1, h2.trans (List.suffix_cons _ _), h3, h4⟩
    · rcases pre with _ | ⟨e₀, pre⟩
      · simp only [List.nil_append, List.cons.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        exact ⟨x :: xs, ys, rfl, Or.inr ⟨rfl, List.suffix_refl _, List.suffix_refl _,
          by simpa using hk⟩⟩
      · simp only [List.cons_append, List.cons.injEq] at h
        obtain ⟨xs', ys', hr, h'⟩ := rankMerge_decomp key (x :: xs) ys pre e rest h.2
        refine ⟨xs', ys', hr, ?_⟩
        rcases h' with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩
        · exact Or.inl ⟨h1, h2, h3.trans (List.suffix_cons _ _), h4⟩
        · exact Or.inr ⟨h1, h2, h3.trans (List.suffix_cons _ _), h4⟩
termination_by xs ys => xs.length + ys.length

end RankMergeSteps

/-! ### Values along the transfer steps (blueprint lines 2241-2252) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The averaged catalog filter of a slot filter entry. -/
noncomputable def filtAvg (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ)
    (f : ℕ × (Fin ap.P → A.Vtx → Prop)) :
    ColumnL2 (Fin ap.Mc) →ₗ[ℂ] ColumnL2 (Fin ap.Mc) :=
  filterAvg ap.P (padFam fun p => catProj A.G ap.Mc cat I f.1 (f.2 p))

/-- The transfer steps of any two filter lists, merged by rank. -/
noncomputable def mergeSteps (catc catd hcat : List (CatCol A.Vtx)) (rH : ℕ) (I : ℤ × ℤ)
    (xs ys : List (ℕ × (Fin ap.P → A.Vtx → Prop))) :
    List (TransferStep (ColumnL2 (Fin ap.Mc))) :=
  ((rankMerge Prod.fst xs ys).map (ap.toStep catc catd hcat rH I)).map
    fun st => (st.1, padFam st.2.1, padFam st.2.2)

theorem chainSteps_eq (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) :
    ap.chainSteps cat hcat rH s c d G I t t' =
      ap.mergeSteps (cat c) (cat d) hcat rH I (ap.slotFilt s c G I t) (ap.slotFilt s d G I t') :=
  rfl

/-- The slot `c` value of merged steps is the composition of the `c` filters. -/
theorem chainVal_mergeSteps_c (catc catd hcat : List (CatCol A.Vtx)) (rH : ℕ) (I : ℤ × ℤ)
    (xs ys : List (ℕ × (Fin ap.P → A.Vtx → Prop))) (y : ColumnL2 (Fin ap.Mc)) :
    chainVal ap.P true (ap.mergeSteps catc catd hcat rH I xs ys) y =
      applyAll (xs.map (ap.filtAvg catc I)) y := by
  rw [chainVal_eq_applyAll]
  unfold mergeSteps
  rw [List.filter_map, List.filter_map, List.map_map, List.map_map]
  have e : ((rankMerge Prod.fst xs ys).filter
      (((fun st : TransferStep (ColumnL2 (Fin ap.Mc)) => decide (st.1 = true)) ∘
        (fun st => (st.1, padFam st.2.1, padFam st.2.2))) ∘
          ap.toStep catc catd hcat rH I)) =
      (rankMerge Prod.fst xs ys).filter (fun e => decide (e.1 = true)) := by
    congr 1
  rw [e, rankMerge_filter_c, List.map_map]
  rfl

/-- The slot `d` value of merged steps is the composition of the `d` filters. -/
theorem chainVal_mergeSteps_d (catc catd hcat : List (CatCol A.Vtx)) (rH : ℕ) (I : ℤ × ℤ)
    (xs ys : List (ℕ × (Fin ap.P → A.Vtx → Prop))) (y : ColumnL2 (Fin ap.Mc)) :
    chainVal ap.P false (ap.mergeSteps catc catd hcat rH I xs ys) y =
      applyAll (ys.map (ap.filtAvg catd I)) y := by
  rw [chainVal_eq_applyAll]
  unfold mergeSteps
  rw [List.filter_map, List.filter_map, List.map_map, List.map_map]
  have e : ((rankMerge Prod.fst xs ys).filter
      (((fun st : TransferStep (ColumnL2 (Fin ap.Mc)) => decide (st.1 = false)) ∘
        (fun st => (st.1, padFam st.2.1, padFam st.2.2))) ∘
          ap.toStep catc catd hcat rH I)) =
      (rankMerge Prod.fst xs ys).filter (fun e => decide (e.1 = false)) := by
    congr 1
  rw [e, rankMerge_filter_d, List.map_map]
  rfl

/-- A positive product of `n + 1` factors is the product of the shifted factors after the first
factor. -/
theorem operatorComplementProduct_succ_shift {H : Type*} [NormedAddCommGroup H]
    [InnerProductSpace ℂ H] (B : ℕ → H →L[ℂ] H) :
    ∀ (n : ℕ) (x : H), operatorComplementProduct B (fun _ => false) (n + 1) x =
      operatorComplementProduct (fun l => B (l + 1)) (fun _ => false) n (B 0 x)
  | 0, x => rfl
  | n + 1, x => by
    change B (n + 1) (operatorComplementProduct B (fun _ => false) (n + 1) x) =
      B (n + 1) (operatorComplementProduct (fun l => B (l + 1)) (fun _ => false) n (B 0 x))
    rw [operatorComplementProduct_succ_shift B n x]

/-- The side value after merged steps is the product of the averaged helper filters of the
steps, innermost first. -/
theorem chainSide_mergeSteps (catc catd hcat : List (CatCol A.Vtx)) (rH : ℕ) (I : ℤ × ℤ) :
    ∀ (pre : List (Bool × (ℕ × (Fin ap.P → A.Vtx → Prop)))) (x : ColumnL2 (Fin ap.Mc)),
      chainSide ap.P (((pre.map (ap.toStep catc catd hcat rH I)).map
          fun st => (st.1, padFam st.2.1, padFam st.2.2))) x =
        operatorComplementProduct (fun l => opAvg fun p =>
          catProj A.G ap.Mc hcat I rH ((pre.getD l (true, 0, fun _ _ => False)).2.2 p))
          (fun _ => false) pre.length x
  | [], x => rfl
  | e :: pre, x => by
    rw [List.map_cons, List.map_cons, chainSide, chainSide_mergeSteps catc catd hcat rH I pre,
      List.length_cons, operatorComplementProduct_succ_shift]
    congr 1
    change filterAvg ap.P (padFam fun p => catProj A.G ap.Mc hcat I rH (e.2.2 p)) x = _
    rw [filterAvg_padFam]
    rfl

end AttemptParams

end ActiveSetup

/-! ### Structure of the transfer steps of a chain pair (blueprint line 2241) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- A step of merged transfer steps comes from a merge element: the earlier steps are those of the
merge prefix and the later steps are the merge of the remaining suffixes. -/
theorem mergeSteps_decomp (catc catd hcat : List (CatCol A.Vtx)) (rH : ℕ) (I : ℤ × ℤ)
    (xs ys : List (ℕ × (Fin ap.P → A.Vtx → Prop)))
    (pre : List (TransferStep (ColumnL2 (Fin ap.Mc)))) (st : TransferStep (ColumnL2 (Fin ap.Mc)))
    (rest : List (TransferStep (ColumnL2 (Fin ap.Mc))))
    (h : ap.mergeSteps catc catd hcat rH I xs ys = pre ++ st :: rest) :
    ∃ (preM : List (Bool × (ℕ × (Fin ap.P → A.Vtx → Prop)))) (e : Bool × (ℕ ×
        (Fin ap.P → A.Vtx → Prop))) (xs' ys' : List (ℕ × (Fin ap.P → A.Vtx → Prop))),
      pre = (preM.map (ap.toStep catc catd hcat rH I)).map
        (fun st => (st.1, padFam st.2.1, padFam st.2.2)) ∧
      st = ((ap.toStep catc catd hcat rH I e).1, padFam (ap.toStep catc catd hcat rH I e).2.1,
        padFam (ap.toStep catc catd hcat rH I e).2.2) ∧
      rest = ap.mergeSteps catc catd hcat rH I xs' ys' ∧
      rankMerge Prod.fst xs ys = preM ++ e :: rankMerge Prod.fst xs' ys' ∧
      ((e.1 = true ∧ (e.2 :: xs') <:+ xs ∧ ys' <:+ ys ∧ ∀ y ∈ ys'.head?, y.1 < e.2.1) ∨
       (e.1 = false ∧ xs' <:+ xs ∧ (e.2 :: ys') <:+ ys ∧ ∀ x ∈ xs'.head?, x.1 ≤ e.2.1)) := by
  unfold mergeSteps at h
  rw [List.map_map] at h
  obtain ⟨l₁, l₂, hl, hpre, hrest⟩ := List.map_eq_append_iff.mp h
  obtain ⟨e, restM, rfl, hst, hrest'⟩ := List.map_eq_cons_iff.mp hrest
  obtain ⟨xs', ys', hr, hcase⟩ := rankMerge_decomp Prod.fst xs ys l₁ e restM hl
  refine ⟨l₁, e, xs', ys', by rw [← hpre, List.map_map], hst.symm, ?_, by rw [hl, hr], hcase⟩
  rw [← hrest', hr]
  unfold mergeSteps
  rw [List.map_map]

/-- A suffix of the filters of a slot along a chain, headed by a filter, is the whole list (the
ball filter first) or a cumulative layer of the chain followed by the inner layers. -/
theorem slotFilt_suffix_cons (s : ℕ) (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t : List ℕ)
    {f : ℕ × (Fin ap.P → A.Vtx → Prop)} {xs' : List (ℕ × (Fin ap.P → A.Vtx → Prop))}
    (h : (f :: xs') <:+ ap.slotFilt s l G I t) :
    (f = (ap.leafR s l, fun p : Fin ap.P => ap.bmask I G (ap.leafJ s l) p) ∧
      xs' = t.map fun m => (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p)) ∨
    ∃ k < t.length, f = (ap.Lc - t.getD k 0 + 1, fun p : Fin ap.P => ap.cmask I (t.getD k 0) p) ∧
      xs' = (t.drop (k + 1)).map fun m => (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p) := by
  obtain ⟨pre, hpre⟩ := h
  unfold slotFilt at hpre
  rcases pre with _ | ⟨g, pre⟩
  · simp only [List.nil_append, List.cons.injEq] at hpre
    exact Or.inl ⟨hpre.1, hpre.2⟩
  · simp only [List.cons_append, List.cons.injEq] at hpre
    obtain ⟨-, hpre⟩ := hpre
    right
    refine ⟨pre.length, ?_, ?_⟩
    · have := congrArg List.length hpre
      simp only [List.length_append, List.length_cons, List.length_map] at this
      omega
    · have hd := congrArg (List.drop pre.length) hpre
      rw [List.drop_left] at hd
      rw [← List.map_drop] at hd
      have hk : pre.length < t.length := by
        have := congrArg List.length hpre
        simp only [List.length_append, List.length_cons, List.length_map] at this
        omega
      rw [List.drop_eq_getElem_cons hk, List.map_cons] at hd
      simp only [List.cons.injEq] at hd
      obtain ⟨hf, hx⟩ := hd
      exact ⟨by rw [hf, List.getD_eq_getElem _ _ hk], hx⟩

/-- A suffix of the filters of a slot along a chain is empty, the whole list, or a tail of
cumulative layers. -/
theorem slotFilt_suffix (s : ℕ) (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t : List ℕ)
    {ys' : List (ℕ × (Fin ap.P → A.Vtx → Prop))} (h : ys' <:+ ap.slotFilt s l G I t) :
    ys' = [] ∨ ys' = ap.slotFilt s l G I t ∨
      ∃ k < t.length, ys' = (t.drop k).map fun m =>
        (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p) := by
  rcases ys' with _ | ⟨f, ys'⟩
  · exact Or.inl rfl
  · rcases ap.slotFilt_suffix_cons s l G I t h with ⟨hf, hx⟩ | ⟨k, hk, hf, hx⟩
    · right; left
      rw [hf, hx]
      rfl
    · right; right
      refine ⟨k, hk, ?_⟩
      rw [hf, hx, List.drop_eq_getElem_cons hk, List.map_cons, List.getD_eq_getElem _ _ hk]

end AttemptParams

end ActiveSetup

/-! ### One far band term of a transfer step (blueprint lines 2253-2258) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- Blueprint lines 2253-2258 for one band pair of one transfer step, at one cell: the step
removes a filter (rank `r`, nested pad masks `M` of present vertices with neighbor closure) from
slot `u`, whose inner value `v` passes the main tests at level `β_m`; the side value `x_a` passes
the helper tests at level `β_H`; the other complement in slot `o` is a combination of bounded pure
sources with coefficient sum at most `C_o`. Then every far band pair (`|p - q| > 2`) has form at
most `√N_u (2 V₀ / √|I|) (2 β_H) S_o S_b + C_o (2 β_m) S_a S_b + τ₂ S_v S_b C_o √N_H S_a`. -/
theorem far_term_le {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a)
    (huo : u ≠ o) (hub : u ≠ b) (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (catu : List (CatCol A.Vtx))
    (hT : ∀ d ∈ catu, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) u R γ d.birth d.rank d.tag)
    (hcat : List (CatCol A.Vtx))
    (hTa : ∀ d ∈ hcat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) a R γ d.birth d.rank d.tag)
    (r rH : ℕ) (M : Fin ap.P → A.Vtx → Prop)
    (hMm : ∀ i j : Fin ap.P, i ≤ j → ∀ x, M i x → M j x)
    (hMp : ∀ k x, M k x → x ∈ A.admT.X (A.admAt I))
    (hMn : ∀ (k : Fin ap.P) (hk : (k : ℕ) + 1 < ap.P) (w y : A.Vtx), M k w →
      y ∈ A.admT.X (A.admAt I) →
      (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) w y ≤ 1 → M ⟨k + 1, hk⟩ y)
    (v xa : ColumnL2 (Fin ap.Mc)) {βm βH : ℝ} (hβm : 0 ≤ βm) (hβH : 0 ≤ βH)
    (hmain : ∀ k : Fin ap.P, CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag u (M k)
      (v - catProj A.G ap.Mc catu I r (M k) v) βm)
    (hhelp : ∀ k : Fin ap.P, CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag a (M k)
      (xa - catProj A.G ap.Mc hcat I rH (M k) xa) βH)
    {ι : Type*} (Fo : Finset ι) (co : ι → ℂ) (src : ι → ColumnL2 (Fin ap.Mc))
    (tago : ι → A.Vtx) (hpres : ∀ m ∈ Fo, tago m ∈ A.admT.X (A.admAt I))
    (hsrc : ∀ m ∈ Fo, ∃ Ay : QuadraticChartData (A.vtag (tago m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc Ay ∧ IsBoundedQuadraticChart Ay ∧
      Ay.horizontal = (A.vtag (tago m)).θ ∧ Ay.matrix = (slotCoeff o : ℚ) • (A.vtag (tago m)).C ∧
      Ay.quadratic = slotCoeff o * (A.vtag (tago m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = quadraticChartAtom Ay y)
    {Co : ℝ} (hCo : ∑ m ∈ Fo, ‖co m‖ ≤ Co)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ ap.Hed)
    {Nu NH : ℝ} (hNu : ∀ k, ((catLabels A.G ap.Mc catu I r (M k)).card : ℝ) ≤ Nu)
    (hNH : ∀ k, ((catLabels A.G ap.Mc hcat I rH (M k)).card : ℝ) ≤ NH)
    {p q : ℕ} (hp : p ≤ ap.P) (hq : q ≤ ap.P) (hfar : q + 2 < p ∨ p + 2 < q)
    (X : Fin 4 → ColumnL2 (Fin ap.Mc))
    (hXa : X a = padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcat I rH (M k)) (p + 1) xa -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc hcat I rH (M k)) p xa)
    (hXu : X u = padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) (q + 1) v -
      padFam (fun k : Fin ap.P => catProj A.G ap.Mc catu I r (M k)) q v)
    (hXo : X o = ∑ m ∈ Fo, co m • src m)
    {So Sa Sv Sb : ℝ} (hSo : 0 < So) (hSa : 0 < Sa) (hSv : 0 < Sv) (hSb : 0 < Sb)
    (hSa' : 2 * ‖xa‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSv' : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sv)
    (hXo' : eLpNorm (augPhys (X o)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal So)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖ap.Λc I X‖ ≤ Real.sqrt Nu * Sv * ((βH + βH) * So * Sb) +
      (Co * ((βm + βm) * Sa * Sb) + τ₂ * Sv * Sb * Co * (Real.sqrt NH * Sa)) := by
  have hNu0 : 0 ≤ Nu := le_trans (Nat.cast_nonneg _) (hNu ⟨0, ap.hP⟩)
  have hNH0 : 0 ≤ NH := le_trans (Nat.cast_nonneg _) (hNH ⟨0, ap.hP⟩)
  have hCo0 : 0 ≤ Co := le_trans (Finset.sum_nonneg fun _ _ => norm_nonneg _) hCo
  have hA : 0 ≤ Real.sqrt Nu * Sv * ((βH + βH) * So * Sb) := by positivity
  have hB : 0 ≤ Co * ((βm + βm) * Sa * Sb) + τ₂ * Sv * Sb * Co * (Real.sqrt NH * Sa) := by
    positivity
  rcases hfar with hpq | hpq
  · -- the helper band is higher
    have hav : ∀ k x, M k x → A.occAvail x.2.1 x.1 := fun k x hx => A.occAvail_of_mem (hMp k x hx)
    have h := ap.far_helper_le hI hua huo hub hao hab hob catu hT r M hMm hav hcat rH xa v hhelp
      hβH hpq hp X hXa hXu hSo hSb hXo' hXb
    refine (h.trans ?_).trans (le_add_of_nonneg_right hB)
    have hs := Real.sqrt_le_sqrt (hNu ⟨q, by omega⟩)
    have hv := hSv'
    gcongr
  · -- the complement band is higher
    have hpP : p + 1 < ap.P := by omega
    set Ys : ι → ℝ → ℂ := fun m => if h : m ∈ Fo then quadraticChartAtom (hsrc m h).choose else 0
    have hYs_eq : ∀ m (h : m ∈ Fo), Ys m = quadraticChartAtom (hsrc m h).choose := fun m h =>
      dite_eq_left_of_eq_true (eq_true h)
    have hsrc' : ∀ m ∈ Fo, ∃ A' : QuadraticChartData (A.vtag (tago m)).dim,
        QuadraticChartComplexity A.csrc A.Hsrc A' ∧ A'.horizontal = (A.vtag (tago m)).θ ∧
        A'.matrix = (slotCoeff o : ℚ) • (A.vtag (tago m)).C ∧
        A'.quadratic = slotCoeff o * (A.vtag (tago m)).lam ∧
        ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
          augPhys (src m) y = quadraticChartAtom A' y := fun m hm => by
      obtain ⟨Ay, h1, -, h3, h4, h5, h6⟩ := hsrc m hm
      exact ⟨Ay, h1, h3, h4, h5, h6⟩
    have hYs : ∀ m ∈ Fo, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (src m) y = Ys m y := fun m hm => by
      rw [hYs_eq m hm]
      exact (hsrc m hm).choose_spec.2.2.2.2.2
    set near : ι → Prop := fun m => ∃ w, M ⟨p, by omega⟩ w ∧
      (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) w (tago m) ≤ 1
    have hnear : ∀ m ∈ Fo, near m → ∀ k : Fin ap.P, q - 1 ≤ k → M k (tago m) := by
      intro m hm ⟨w, hw, hd⟩ k hk
      have h1 := hMn ⟨p, by omega⟩ hpP w (tago m) hw (hpres m hm) hd
      exact hMm _ _ (Fin.mk_le_mk.mpr (by simp only at hk ⊢; omega)) _ h1
    have hfar' : ∀ m ∈ Fo, ¬ near m →
        ∀ n ∈ catLabels A.G ap.Mc hcat I rH (M ⟨p, by omega⟩),
          PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) o a (Ys m)
            (catAtom hcat n) τ₂ := by
      intro m hm hnm n hn
      simp only [catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hn
      obtain ⟨hnl, -, -, hMw⟩ := hn
      have hwP := hMp _ _ hMw
      have hfd : ¬ (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) (hcat[(n : ℕ)]).tag
          (tago m) ≤ 1 := fun hd => hnm ⟨_, hMw, hd⟩
      obtain ⟨h1, h2, h3, h4, h5, -⟩ := (hsrc m hm).choose_spec
      rw [hYs_eq m hm]
      exact ap.far_pair hI hao.symm (hsrc m hm).choose h1 h2 h3 h4 h5 hcat hTa hnl hwP hfd hτ₂
        hτ₂1 hHed
    have h := ap.far_main_le hI hua huo hub hao hab hob catu r M hMm v hmain hβm hcat rH xa Fo
      co src tago Ys hsrc' hYs hpq hq near hnear hτ₂.le hfar' X hXa hXu hXo hSa hSv hSb hSa' hSv'
      hXb
    refine (h.trans ?_).trans (le_add_of_nonneg_left hA)
    have hs := Real.sqrt_le_sqrt (hNH ⟨p, by omega⟩)
    gcongr

end AttemptParams

