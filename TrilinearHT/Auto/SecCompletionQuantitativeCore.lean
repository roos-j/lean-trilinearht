      ((Real.fourierChar (-(x * q)) : ℂ) * w (x, s)) - (Real.fourierChar (-(s * t₁)) : ℂ) *
        ((Real.fourierChar (-(x * q₁)) : ℂ) * w (x, s)))‖ ≤
      2 * R * (2 * π * R * (|q - q₁| + |t - t₁|) * A 0) := by
    intro s
    refine (norm_integral_le_integral_norm _).trans ?_
    exact integral_norm_le_of_support hR (hpt s) fun x hx => by
      have : w (x, s) = 0 := by
        by_contra h; have := (hw.supp x s h).1; linarith
      simp [this]
