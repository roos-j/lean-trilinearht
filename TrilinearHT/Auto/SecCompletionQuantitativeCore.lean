/-- The chains of the leaves are no longer than the fuel. -/
theorem chainOf_length_le (s : Fin ap.leaves.length) (l : Fin 4)
    (i : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).reverse).length) :
    (ap.chainOf s l i).length ≤ ap.fuel := by
  unfold chainOf
  rw [List.getD_eq_getElem _ _ i.2]
  refine (posExpand_mem_length _ _ (List.getElem_mem i.2)).trans ?_
  rw [List.length_reverse]
  have := searchLeaves_layers_length ap.fuel 1 ap.Lc ap.up₀ none (fun _ => [])
    (leafAt ap.fuel ap.Lc ap.up₀ s) (leafAt_mem s.2) l
  simpa using this

/-- The merged filters of a chain pair number at most `2 fuel + 2`. -/
theorem mergeAt_length_le (s : Fin ap.leaves.length) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ)
    (ic : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers c).reverse).length)
    (id : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers d).reverse).length) :
    (ap.mergeAt s c d G I ic id).length ≤ 2 * ap.fuel + 2 := by
  unfold mergeAt
  rw [rankMerge_length]
  unfold slotFilt
  simp only [List.length_cons, List.length_map]
  have := ap.chainOf_length_le s c ic
  have := ap.chainOf_length_le s d id
  omega

/-- Blueprint lines 2253 and 1810-1811: if all helper tests of a cell pass at threshold `τ_H`,
every helper residual of every transfer step of every chain pair passes at level
`τ_H ‖base‖ / √|I|` on the side value after the earlier helper averages. -/
theorem helper_steps_pass (base : ℕ → A.Grp → Fin 4 → ℤ × ℤ → ColumnL2 (Fin ap.Mc)) (rH : ℕ)
    {I : ℤ × ℤ} (hI : I ∈ A.cells) (hcat : List (CatCol A.Vtx)) {τH : ℝ}
    (hpass : ∀ w : ap.HelperIdx I, (ap.helperTest base rH I w).Pass A.G I A.csrc A.Hsrc A.vtag
      (A.w I) τH ap.mH hcat) (hmH : 2 * ap.fuel + 2 ≤ ap.mH)
    (s : Fin ap.leaves.length) {G : A.Grp}
    (hG : G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k) (a c d : Fin 4)
    (ic : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers c).reverse).length)
    (id : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers d).reverse).length) :
    ∀ preM e restM, ap.mergeAt s c d G I ic id = preM ++ e :: restM → ∀ k : Fin ap.P,
      CellPass (A.adm I hI) A.csrc A.Hsrc A.vtag a (e.2.2 k)
        (operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH
            ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length
              (base s G a I) -
          catProj A.G ap.Mc hcat I rH (e.2.2 k)
            (operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH
              ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length
                (base s G a I)))
        (τH * ‖base s G a I‖ / Real.sqrt (dyadicGridLength A.G I.1)) := by
  intro preM e restM hm k
  have hlen := ap.mergeAt_length_le s c d G I ic id
  rw [hm] at hlen
  simp only [List.length_append, List.length_cons] at hlen
  have hn : preM.length < 2 * ap.fuel + 3 := by omega
  have hget : ∀ l < preM.length, (ap.mergeAt s c d G I ic id).getD l
      (true, 0, fun _ _ => False) = preM.getD l (true, 0, fun _ _ => False) := by
    intro l hl
    rw [hm, List.getD_append _ _ _ _ hl]
  have he : (ap.mergeAt s c d G I ic id).getD preM.length (true, 0, fun _ _ => False) = e := by
    rw [hm, List.getD_append_right _ _ _ _ le_rfl, Nat.sub_self]; rfl
  have h := ap.helper_cellPass hI hcat a rH (e.2.2 k)
    (fun l => ((ap.mergeAt s c d G I ic id).getD l (true, 0, fun _ _ => False)).2.2)
    preM.length (by omega) (base s G a I) (fun ch => by
      have := hpass ⟨s, ⟨G, hG⟩, (a, c, d), ic, id, ⟨preM.length, hn⟩, k, ch⟩
      simp only [helperTest, he] at this
      exact this)
  have hcg : operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH
      (((ap.mergeAt s c d G I ic id).getD l (true, 0, fun _ _ => False)).2.2 p))
        (fun _ => false) preM.length =
      operatorComplementProduct (fun l => opAvg fun p => catProj A.G ap.Mc hcat I rH
        ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length :=
    operatorComplementProduct_congr _ _ fun l hl => by rw [hget l hl]
  rw [hcg] at h
  exact h

/-- The number of helper tests of a cell is at most
`2^fuel D 64 4^fuel (2 fuel + 3) P^(2 fuel + 3)`, uniformly in the cell. -/
theorem card_HelperIdx_le (I : ℤ × ℤ) :
    Fintype.card (ap.HelperIdx I) ≤ 2 ^ ap.fuel * (A.vtxBound * (64 * (2 ^ ap.fuel *
      (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3)))))) := by
  classical
  have hP := ap.hP
  have hlen : ∀ (s : Fin ap.leaves.length) l,
      ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).length ≤ ap.fuel := fun s l => by
    have := searchLeaves_layers_length ap.fuel 1 ap.Lc ap.up₀ none (fun _ => [])
      (leafAt ap.fuel ap.Lc ap.up₀ s) (leafAt_mem s.2) l
    simpa using this
  have hch : ∀ (s : Fin ap.leaves.length) l,
      (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).reverse).length ≤ 2 ^ ap.fuel :=
    fun s l => (posExpand_length_le _).trans (by
      rw [List.length_reverse]; exact Nat.pow_le_pow_right two_pos (hlen s l))
  have hn : Fintype.card (Σ n : Fin (2 * ap.fuel + 3), Fin ap.P × (Fin n → Fin ap.P)) ≤
      (2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3) := by
    rw [Fintype.card_sigma]
    calc ∑ n : Fin (2 * ap.fuel + 3), Fintype.card (Fin ap.P × (Fin n → Fin ap.P))
        ≤ ∑ _n : Fin (2 * ap.fuel + 3), ap.P ^ (2 * ap.fuel + 3) := by
          refine Finset.sum_le_sum fun n _ => ?_
          rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fun, Fintype.card_fin,
            Fintype.card_fin, ← pow_succ']
          exact Nat.pow_le_pow_right hP (by omega)
      _ = _ := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
  have hσ : ∀ (s : Fin ap.leaves.length) (σ : Fin 4 × Fin 4 × Fin 4),
      Fintype.card (Σ _ic : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers
        σ.2.1).reverse).length, Σ _id : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers
          σ.2.2).reverse).length, Σ n : Fin (2 * ap.fuel + 3), Fin ap.P × (Fin n → Fin ap.P)) ≤
      2 ^ ap.fuel * (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3))) := by
    intro s σ
    rw [Fintype.card_sigma, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul,
      Fintype.card_sigma, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
    exact Nat.mul_le_mul (hch s _) (Nat.mul_le_mul (hch s _) hn)
  have hG : ∀ s : Fin ap.leaves.length,
      Fintype.card (Σ _G : {G // G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k},
        Σ σ : Fin 4 × Fin 4 × Fin 4,
          Σ _ic : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers σ.2.1).reverse).length,
            Σ _id : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers σ.2.2).reverse).length,
              Σ n : Fin (2 * ap.fuel + 3), Fin ap.P × (Fin n → Fin ap.P)) ≤
      A.vtxBound * (64 * (2 ^ ap.fuel *
        (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3))))) := by
    intro s
    rw [Fintype.card_sigma, Finset.sum_const, Finset.card_univ, Fintype.card_coe, smul_eq_mul]
    refine Nat.mul_le_mul (ap.card_groupsAt_le I _) ?_
    rw [Fintype.card_sigma]
    calc ∑ σ : Fin 4 × Fin 4 × Fin 4, _ ≤ ∑ _σ : Fin 4 × Fin 4 × Fin 4,
          2 ^ ap.fuel * (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3))) :=
          Finset.sum_le_sum fun σ _ => hσ s σ
      _ = _ := by rw [Finset.sum_const, Finset.card_univ]; simp
  rw [Fintype.card_sigma]
  calc ∑ s : Fin ap.leaves.length, _ ≤ ∑ _s : Fin ap.leaves.length, A.vtxBound * (64 *
        (2 ^ ap.fuel * (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3))))) :=
        Finset.sum_le_sum fun s _ => hG s
    _ = ap.leaves.length * (A.vtxBound * (64 * (2 ^ ap.fuel *
          (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3)))))) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
    _ ≤ _ := Nat.mul_le_mul_right _ (searchLeaves_length_le _ _ _ _ _ _)

