      ((Real.fourierChar (-(x * q)) : ℂ) * w (x, s))) - ∫ x, (Real.fourierChar (-(s * t₁)) : ℂ) *
        ((Real.fourierChar (-(x * q₁)) : ℂ) * w (x, s)) =
      ∫ x, ((Real.fourierChar (-(s * t)) : ℂ) * ((Real.fourierChar (-(x * q)) : ℂ) * w (x, s)) -
