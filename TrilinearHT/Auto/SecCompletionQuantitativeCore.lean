/-! ### Whole outputs of leaf slots: `U` slots and cells without decision cell (lines 2159-2162) -/

namespace ActiveSetup

namespace AttemptParams

namespace LeafSplit

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

/-- Cells without decision cell lie above depth `R.1 + 5K`. -/
theorem lt_of_not_hasDecision (hK1 : 1 ≤ D.S.K) {I : ℤ × ℤ} {s : ℕ} (hIs : I.1 = A.R.1 + s)
    (hd : ¬ D.hasDecision I) : s < 5 * D.S.K := by
  have h := D.blockOf_bounds hK1 I.1
  unfold hasDecision at hd
  rw [hIs] at h hd
  omega

open Classical in
/-- Blueprint lines 2159-2162 (cells without decision cell) on a basic slot of a leaf: the whole
leaf outputs on the cells without decision cell have total square at most twice the sum of the
`noDecision_budget` bounds of the two basic projections, with `M = 5K` depths. -/
theorem leaf_noDecision_mass (hK1 : 1 ≤ D.S.K) (cat : Fin 4 → List (CatCol A.Vtx)) (s₀ : ℕ)
    (l : Fin 4) (hl : ¬ D.usl l) (t₀ : Fin 4)
    (hT : ∀ d ∈ cat l, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) t₀ R γ d.birth d.rank d.tag)
    (hR : A.R ∈ A.cells) (hb : ∀ d ∈ cat l, d.birth ∈ A.cells)
    {ι : Type*} [Fintype ι] (grp : ι → A.Grp) (hgrp : Function.Injective grp) (k : ℕ)
    (hPH : ap.bbase (ap.leafJ s₀ l) + ap.P ≤ ap.Hmax) (Sd : Finset ℕ)
    (Ec : ι → ℕ → Finset (ℤ × ℤ))
    (hEc : ∀ G s, ∀ I ∈ Ec G s, I ∈ A.cells ∧ I.1 = A.R.1 + s)
    (hcert : ∀ G s, ∀ I ∈ Ec G s, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G)
    {ra rb : ℝ} (hroot : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ : ℝ} (hτ : 0 < τ) (hτ1 : τ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ⁻¹) ^ A.Dg) ≤ ap.Hed)
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × Fin ap.Mc)).filter fun q => ∃ I ∈ A.cells,
      ∃ p : Fin ap.P, y ∈ dyadicGridCell A.G I.1 I.2 ∧
        q.2 ∈ catLabels A.G ap.Mc (cat l) I (ap.leafR s₀ l)
          (ap.bmask I (grp q.1) (ap.leafJ s₀ l) p)).card ≤ N)
    (hz : ∀ I ∈ A.cells, ap.z I l = A.B l I) {CF : ℝ} (P₁ P₂ : BasicProjection A.G A.R CF)
    (hP : ∀ I ∈ A.cells, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
      A.B l I y = P₁.val I y - P₂.val I y) :
    ∑ G, ∑ s ∈ Sd, ∑ I ∈ (Ec G s).filter (fun I => D.usl l ∨ ¬ D.hasDecision I),
      ‖ap.leafOut cat s₀ I l (grp G)‖ ^ 2 ≤
      2 * ((5 * D.S.K : ℕ) * ((1 + τ * N * 1 ^ 2) *
        (1 * compression1 (ap.cumBase (cat l) hR hb).D ^ 2) *
        compressionC (ap.cumBase (cat l) hR hb).D
          ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l).length ^ 2 *
        compressionC P₁.Ψ.D 1 ^ 2 * ‖P₁.Z‖ ^ 2)) +
      2 * ((5 * D.S.K : ℕ) * ((1 + τ * N * 1 ^ 2) *
        (1 * compression1 (ap.cumBase (cat l) hR hb).D ^ 2) *
        compressionC (ap.cumBase (cat l) hR hb).D
          ((leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l).length ^ 2 *
        compressionC P₂.Ψ.D 1 ^ 2 * ‖P₂.Z‖ ^ 2)) := by
  set ls := (leafAt ap.fuel ap.Lc ap.up₀ s₀).layers l
  set Sd' := Sd.filter fun s => s < 5 * D.S.K
  set Ec' : ι → ℕ → Finset (ℤ × ℤ) := fun G s =>
    (Ec G s).filter (fun I => D.usl l ∨ ¬ D.hasDecision I)
  have hM : Sd'.card ≤ 5 * D.S.K := by
    refine (Finset.card_le_card (t := Finset.range (5 * D.S.K)) fun s hs => ?_).trans
      (Finset.card_range _).le
    exact Finset.mem_range.mpr (Finset.mem_filter.mp hs).2
  have hEc' : ∀ G s, ∀ I ∈ Ec' G s, I ∈ A.cells ∧ I.1 = A.R.1 + s := fun G s I hI =>
    hEc G s I (Finset.mem_filter.mp hI).1
  have hcert' : ∀ G s, ∀ I ∈ Ec' G s, ∃ u' ∈ A.cells,
      dyadicGridCell A.G u'.1 u'.2 ⊆ dyadicGridCell A.G I.1 I.2 ∧
      ∃ x ∈ A.admT.X (A.admAt u'), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt u')) x) ∧
        ap.K.color A.admT A.vtxBound (A.admAt u') x = k ∧
        ap.K.grp A.admT A.vtxBound (A.admAt u') x = grp G := fun G s I hI =>
    hcert G s I (Finset.mem_filter.mp hI).1
  have hr : ∀ P : BasicProjection A.G A.R CF, P.Ψ.D.root.1 ≤ A.R.1 := fun P =>
    dyadicGridCell_depth_le_of_subset A.G A.R P.Ψ.D.root P.root_sub
  have hb₁ := ap.noDecision_budget (cat l) t₀ hT hR hb grp hgrp k (ap.leafR s₀ l) (ap.leafJ s₀ l)
    Sd' hM Ec' hEc' hcert' hPH hroot hτ hτ1 hHed hN ls P₁.Ψ P₁.grid P₁.root_sub (hr P₁) P₁.Z
  have hb₂ := ap.noDecision_budget (cat l) t₀ hT hR hb grp hgrp k (ap.leafR s₀ l) (ap.leafJ s₀ l)
    Sd' hM Ec' hEc' hcert' hPH hroot hτ hτ1 hHed hN ls P₂.Ψ P₂.grid P₂.root_sub (hr P₂) P₂.Z
  set nb := fun (P : BasicProjection A.G A.R CF) (G : ι) (I : ℤ × ℤ) =>
    ‖ap.ballAt (cat l) (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G) I (layerOp (ap.cumAt (cat l) I) ls
        (physicalColumnInput (cellLp A.G I (P.Ψ.currentZ P.Z I))))‖
  -- pointwise
  have hpt : ∀ G s, ∀ I ∈ Ec' G s, ‖ap.leafOut cat s₀ I l (grp G)‖ ^ 2 ≤
      2 * nb P₁ G I ^ 2 + 2 * nb P₂ G I ^ 2 := by
    intro G s I hI
    have hIc := (hEc' G s I hI).1
    have he : ap.leafOut cat s₀ I l (grp G) =
        ap.ballAt (cat l) (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G) I (layerOp (ap.cumAt (cat l) I)
          ls (physicalColumnInput (cellLp A.G I (P₁.Ψ.currentZ P₁.Z I)))) -
        ap.ballAt (cat l) (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G) I (layerOp (ap.cumAt (cat l) I)
          ls (physicalColumnInput (cellLp A.G I (P₂.Ψ.currentZ P₂.Z I)))) := by
      unfold leafOut
      rw [ap.leafIn_eq_sub cat s₀ l I (hz I hIc) P₁ P₂ (hP I hIc), map_sub]
    rw [he]
    have := norm_sub_le (ap.ballAt (cat l) (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G) I
      (layerOp (ap.cumAt (cat l) I) ls (physicalColumnInput (cellLp A.G I (P₁.Ψ.currentZ P₁.Z I)))))
      (ap.ballAt (cat l) (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G) I
      (layerOp (ap.cumAt (cat l) I) ls (physicalColumnInput (cellLp A.G I (P₂.Ψ.currentZ P₂.Z I)))))
    have h0 := norm_nonneg (ap.ballAt (cat l) (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G) I
      (layerOp (ap.cumAt (cat l) I) ls
        (physicalColumnInput (cellLp A.G I (P₁.Ψ.currentZ P₁.Z I)))) -
      ap.ballAt (cat l) (ap.leafR s₀ l) (ap.leafJ s₀ l) (grp G) I
      (layerOp (ap.cumAt (cat l) I) ls (physicalColumnInput (cellLp A.G I (P₂.Ψ.currentZ P₂.Z I)))))
    simp only [nb]
    nlinarith [sq_nonneg (nb P₁ G I - nb P₂ G I), norm_nonneg (ap.ballAt (cat l) (ap.leafR s₀ l)
      (ap.leafJ s₀ l) (grp G) I (layerOp (ap.cumAt (cat l) I) ls
        (physicalColumnInput (cellLp A.G I (P₁.Ψ.currentZ P₁.Z I))))),
      norm_nonneg (ap.ballAt (cat l) (ap.leafR s₀ l)
      (ap.leafJ s₀ l) (grp G) I (layerOp (ap.cumAt (cat l) I) ls
        (physicalColumnInput (cellLp A.G I (P₂.Ψ.currentZ P₂.Z I)))))]
  -- restrict to the small depths
  have hsd : ∀ G, ∑ s ∈ Sd, ∑ I ∈ Ec' G s, ‖ap.leafOut cat s₀ I l (grp G)‖ ^ 2 =
      ∑ s ∈ Sd', ∑ I ∈ Ec' G s, ‖ap.leafOut cat s₀ I l (grp G)‖ ^ 2 := by
    intro G
    rw [Finset.sum_filter]
    refine Finset.sum_congr rfl fun s _ => ?_
    split_ifs with h
    · rfl
    · refine Finset.sum_eq_zero fun I hI => ?_
      exfalso
      obtain ⟨hIE, hIu⟩ := Finset.mem_filter.mp hI
      rcases hIu with hu | hd
      · exact hl hu
      · exact h (D.lt_of_not_hasDecision hK1 (hEc G s I hIE).2 hd)
  change ∑ G, ∑ s ∈ Sd, ∑ I ∈ Ec' G s, ‖ap.leafOut cat s₀ I l (grp G)‖ ^ 2 ≤ _
  simp_rw [hsd]
  rw [Finset.sum_comm]
  calc _ ≤ ∑ s ∈ Sd', ∑ G, ∑ I ∈ Ec' G s, (2 * nb P₁ G I ^ 2 + 2 * nb P₂ G I ^ 2) :=
        Finset.sum_le_sum fun s _ => Finset.sum_le_sum fun G _ =>
          Finset.sum_le_sum fun I hI => hpt G s I hI
    _ = 2 * ∑ s ∈ Sd', ∑ G, ∑ I ∈ Ec' G s, nb P₁ G I ^ 2 +
        2 * ∑ s ∈ Sd', ∑ G, ∑ I ∈ Ec' G s, nb P₂ G I ^ 2 := by
        simp only [Finset.sum_add_distrib, Finset.mul_sum]
    _ ≤ _ := by
        push_cast at hb₁ hb₂ ⊢
        linarith

end LeafSplit

