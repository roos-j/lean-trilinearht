namespace ModeComponents

variable {Mode P : Type*} [DecidableEq Mode] [DecidableEq P] (C : ModeComponents Mode P)

/-- The components at one height partition the modes: a sum over all modes is the sum over the
components of the sums over their members. -/
theorem sum_classes [Fintype Mode] {M : Type*} [AddCommMonoid M] (h : ℕ) (f : Mode → M) :
    ∑ x, f x = ∑ K ∈ Finset.univ.image (C.E h), ∑ x ∈ K, f x := by
  rw [← Finset.sum_fiberwise_of_maps_to (s := Finset.univ) (t := Finset.univ.image (C.E h))
    (g := C.E h) (fun x _ => Finset.mem_image_of_mem _ (Finset.mem_univ x))]
  refine Finset.sum_congr rfl fun K hK => ?_
  obtain ⟨m, -, rfl⟩ := Finset.mem_image.mp hK
  refine Finset.sum_congr ?_ fun _ _ => rfl
  ext x
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · intro hx; rw [← hx]; exact C.E_self h x
  · intro hx; exact C.E_comp h m x hx

end ModeComponents

namespace ModeSystem

variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

/-- The minimal CURRENT components of the block `b` on the pre-cell `J`, as sets of modes. -/
noncomputable def allComps (b : ℤ) (J : ℤ × ℤ) : Finset (Finset Ms.Md) :=
  Finset.univ.image fun x : Ms.alive (ancAt Gd J (b - 4 * S.K)) =>
    ((Ms.blockComps S hA b J).E 0 x).map ⟨Subtype.val, Subtype.val_injective⟩

/-- The core components: the minimal CURRENT components that are not side events. -/
noncomputable def coreComps (b : ℤ) (J : ℤ × ℤ) : Finset (Finset Ms.Md) :=
  Ms.allComps S hA b J \ Ms.sideEvents S hA SP b J

theorem sideEvents_subset_allComps (b : ℤ) (J : ℤ × ℤ) :
    Ms.sideEvents S hA SP b J ⊆ Ms.allComps S hA b J := by
  intro E hE
  unfold sideEvents at hE
  obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hE
  exact Finset.mem_image_of_mem _ (Finset.mem_univ x)

/-- The frozen evaluation is the sum of the subtotals of all minimal CURRENT components. -/
theorem frozenEval_eq_comps (b : ℤ) (J : ℤ × ℤ) (c : Ms.Md → ℂ) :
    Ms.frozenEval S b J c =
      ∑ K ∈ Ms.allComps S hA b J, ∑ m ∈ K, c m • Ms.cellMode J m := by
  classical
  set U := ancAt Gd J (b - 4 * S.K)
  set C := Ms.blockComps S hA b J
  set emb : Ms.alive U ↪ Ms.Md := ⟨Subtype.val, Subtype.val_injective⟩
  have h1 : Ms.frozenEval S b J c = ∑ x : Ms.alive U, c x.1 • Ms.cellMode J x.1 := by
    unfold frozenEval
    exact (Finset.sum_coe_sort (Ms.alive U) (fun m => c m • Ms.cellMode J m)).symm
  rw [h1, C.sum_classes 0 (fun x : Ms.alive U => c x.1 • Ms.cellMode J x.1)]
  unfold allComps
  have himg : (Finset.univ.image fun x : Ms.alive U => (C.E 0 x).map emb) =
      (Finset.univ.image (C.E 0)).image (Finset.map emb) := by
    rw [Finset.image_image]; rfl
  rw [himg, Finset.sum_image fun K _ K' _ hKK => Finset.map_injective emb hKK]
  refine Finset.sum_congr rfl fun K _ => ?_
  rw [Finset.sum_map]
  rfl

/-- Blueprint lines 2124 and 2460 (`A = Z̃ - V`): on a pre-cell, the frozen evaluation minus the
side subtotal is the sum of the subtotals of the core components. -/
theorem frozenEval_sub_side (b : ℤ) (J : ℤ × ℤ) (c : Ms.Md → ℂ) :
    Ms.frozenEval S b J c -
        ∑ E ∈ Ms.sideEvents S hA SP b J, ∑ m ∈ E, c m • Ms.cellMode J m =
      ∑ K ∈ Ms.coreComps S hA SP b J, ∑ m ∈ K, c m • Ms.cellMode J m := by
  classical
  rw [Ms.frozenEval_eq_comps S hA b J c, coreComps,
    ← Finset.sum_sdiff (Ms.sideEvents_subset_allComps S hA SP b J)]
  abel

end ModeSystem

namespace ModeSystem

variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

theorem cellMode_vanish (J : ℤ × ℤ) (m : Ms.Md) :
    ∀ᵐ y ∂volume, y ∉ dyadicGridCell Gd J.1 J.2 →
      (Ms.cellMode J m : ℝ → ColumnHilbert Ms.Md) y = 0 := by
  classical
  unfold cellMode
  convert augMode_toLp_vanish (dyadicGridCell_measurable Gd J.1 J.2)
    (dyadicGridCell_volume_ne_top Gd J) (Ms.wave_measurable m) (Ms.wave_norm_le m) (Ms.L.εM m) m

/-- A cell mode is fixed by the restriction to its cell. -/
theorem restrict_cellMode_self (J : ℤ × ℤ) (m : Ms.Md) :
    columnL2Restriction (dyadicGridCell Gd J.1 J.2) (dyadicGridCell_measurable Gd J.1 J.2)
      (Ms.cellMode J m) = Ms.cellMode J m :=
  columnL2Restriction_eq_self _ _ _ (Ms.cellMode_vanish J m)

/-- A cell mode vanishes after restriction to a disjoint cell. -/
theorem restrict_cellMode_disjoint {J J' : ℤ × ℤ}
    (h : Disjoint (dyadicGridCell Gd J.1 J.2) (dyadicGridCell Gd J'.1 J'.2)) (m : Ms.Md) :
    columnL2Restriction (dyadicGridCell Gd J'.1 J'.2) (dyadicGridCell_measurable Gd J'.1 J'.2)
      (Ms.cellMode J m) = 0 := by
  refine Lp.ext ?_
  change (columnL2Indicator _ (dyadicGridCell_measurable Gd J'.1 J'.2) (Ms.cellMode J m) :
    ℝ → ColumnHilbert Ms.Md) =ᵐ[volume] ((0 : ColumnL2 Ms.Md) : ℝ → ColumnHilbert Ms.Md)
  filter_upwards [columnL2Indicator_coeFn _ (dyadicGridCell_measurable Gd J'.1 J'.2)
    (Ms.cellMode J m), Ms.cellMode_vanish J m,
    Lp.coeFn_zero (E := ColumnHilbert Ms.Md) (p := 2) (μ := volume)] with y h1 h2 h3
  rw [h1, h3]
  by_cases hy : y ∈ dyadicGridCell Gd J'.1 J'.2
  · rw [Set.indicator_of_mem hy]
    exact h2 fun hyJ => Set.disjoint_left.mp h hyJ hy
  · rw [Set.indicator_of_notMem hy]; rfl

/-- Restricting the block side subtotal to one of its pre-cells keeps exactly the side events of
that pre-cell (the pre-cells of a block are disjoint). -/
theorem restrict_blockSide {b : ℤ} {cells : Finset (ℤ × ℤ)}
    (hdis : Set.PairwiseDisjoint (cells : Set (ℤ × ℤ)) fun J => dyadicGridCell Gd J.1 J.2)
    (c : ℤ × ℤ → Ms.Md → ℂ) {J : ℤ × ℤ} (hJ : J ∈ cells) :
    columnL2Restriction (dyadicGridCell Gd J.1 J.2) (dyadicGridCell_measurable Gd J.1 J.2)
        (Ms.blockSide S hA SP b cells c) =
      ∑ E ∈ Ms.sideEvents S hA SP b J, ∑ m ∈ E, c J m • Ms.cellMode J m := by
  unfold blockSide
  rw [map_sum, Finset.sum_eq_single_of_mem J hJ]
  · simp only [map_sum, map_smul, Ms.restrict_cellMode_self]
  · intro J' hJ' hne
    simp only [map_sum, map_smul, Ms.restrict_cellMode_disjoint (hdis hJ' hJ hne), smul_zero,
      Finset.sum_const_zero]

/-- Blueprint lines 2124, 2460 on a pre-cell `J` of the block: the frozen evaluation minus the
block side subtotal, restricted to `J`, is the sum of the subtotals of the core components. -/
theorem restrict_frozen_sub_blockSide {b : ℤ} {cells : Finset (ℤ × ℤ)}
    (hdis : Set.PairwiseDisjoint (cells : Set (ℤ × ℤ)) fun J => dyadicGridCell Gd J.1 J.2)
    (c : ℤ × ℤ → Ms.Md → ℂ) {J : ℤ × ℤ} (hJ : J ∈ cells) :
    columnL2Restriction (dyadicGridCell Gd J.1 J.2) (dyadicGridCell_measurable Gd J.1 J.2)
        (Ms.frozenEval S b J (c J) - Ms.blockSide S hA SP b cells c) =
      ∑ K ∈ Ms.coreComps S hA SP b J, ∑ m ∈ K, c J m • Ms.cellMode J m := by
  rw [map_sub, Ms.restrict_blockSide S hA SP hdis c hJ, ← Ms.frozenEval_sub_side S hA SP b J]
  congr 1
  unfold frozenEval
  simp only [map_sum, map_smul, Ms.restrict_cellMode_self]

