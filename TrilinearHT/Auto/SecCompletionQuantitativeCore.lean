/-! ### The rolling mass of a basic leaf slot (blueprint lines 2159-2162, eq:rolling-energy) -/

/-- Restrictions to smaller sets have smaller norm. -/
theorem columnL2Restriction_norm_sq_mono {V : Type*} [Fintype V] {s t : Set ℝ}
    (hs : MeasurableSet s) (ht : MeasurableSet t) (hst : s ⊆ t) (g : ColumnL2 V) :
    ‖columnL2Restriction s hs g‖ ^ 2 ≤ ‖columnL2Restriction t ht g‖ ^ 2 := by
  rw [columnL2Restriction_norm_sq, columnL2Restriction_norm_sq]
  exact setIntegral_mono_set ((Lp.memLp g).integrable_norm_pow two_ne_zero).integrableOn
    (Filter.Eventually.of_forall fun _ => by positivity) (Filter.Eventually.of_forall hst)

namespace ActiveSetup

namespace AttemptParams

namespace LeafSplit

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

/-- The block start lies in `(h - K, h]`. -/
theorem blockOf_bounds (hK1 : 1 ≤ D.S.K) (h : ℤ) :
    D.blockOf h ≤ h ∧ h < D.blockOf h + D.S.K := by
  unfold blockOf
  have h1 := Int.mul_ediv_add_emod (h - A.R.1) D.S.K
  have hK : (0 : ℤ) < D.S.K := by exact_mod_cast hK1
  have h2 := Int.emod_nonneg (h - A.R.1) hK.ne'
  have h3 := Int.emod_lt_of_pos (h - A.R.1) hK
  constructor <;> linarith

/-- The decision depth offset of the depth `R.1 + s` (capped at `s`). -/
noncomputable def uOf (s : ℕ) : ℕ := min s (D.blockOf (A.R.1 + s) - 4 * D.S.K - A.R.1).toNat

theorem uOf_le (s : ℕ) : D.uOf s ≤ s := min_le_left _ _

theorem sub_uOf_lt (hK1 : 1 ≤ D.S.K) (s : ℕ) : s - D.uOf s < 5 * D.S.K := by
  have h := D.blockOf_bounds hK1 (A.R.1 + s)
  unfold uOf
  omega

/-- On a cell with a decision cell, the decision cell is a cell of the root at depth
`R.1 + uOf s`, containing the cell. -/
theorem dcell_spec (hK1 : 1 ≤ D.S.K) (hanc : A.AncClosed) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    {s : ℕ} (hIs : I.1 = A.R.1 + s) (hd : D.hasDecision I) :
    D.dcell I ∈ A.cells ∧ (D.dcell I).1 = A.R.1 + D.uOf s ∧
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G (D.dcell I).1 (D.dcell I).2 := by
  have h := D.blockOf_bounds hK1 I.1
  unfold hasDecision at hd
  have hle : D.blockOf I.1 - 4 * D.S.K ≤ I.1 := by omega
  have hsub := subset_ancAt A.G I hle
  refine ⟨hanc I hI _ hsub (ancAt_subset (A.sub I hI) hd), ?_, hsub⟩
  change D.blockOf I.1 - 4 * D.S.K = A.R.1 + D.uOf s
  unfold uOf
  rw [hIs] at h hd ⊢
  omega

end LeafSplit

end AttemptParams

