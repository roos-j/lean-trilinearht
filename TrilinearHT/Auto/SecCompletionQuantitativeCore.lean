theorem leaf_three_sides_attempt (cat : Fin 4 → List (CatCol A.Vtx)) (s₀ : ℕ)
    (Sc : Finset (ℤ × ℤ)) (C : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp)
    (hSc : ∀ I ∈ Sc, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G A.R.1 A.R.2) {T : ℝ}
    (hcap : ∀ x : ℝ, ∑ I ∈ (Sc.filter (fun I => ¬ ∃ c ∈ C,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G c.1 c.2)).filter
          (fun I => x ∈ dyadicGridCell A.G I.1 I.2),
        ∑ G ∈ gs I, ∑ l, ‖π (D.side l G I (ap.leafOut cat s₀ I l G)
