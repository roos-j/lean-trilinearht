section RankMerge

variable {α : Type*}

/-- Blueprint line 2241 ("in each product remove the larger rank among the two current outermost
positive filters"): the merge of the filter lists of the two complement slots (outermost first),
taking at each step the outermost filter of larger rank (`true` for slot `c`, `false` for `d`). -/
def rankMerge (key : α → ℕ) : List α → List α → List (Bool × α)
  | [], ys => ys.map fun y => (false, y)
  | x :: xs, [] => (x :: xs).map fun x => (true, x)
  | x :: xs, y :: ys =>
      if key y < key x then (true, x) :: rankMerge key xs (y :: ys)
      else (false, y) :: rankMerge key (x :: xs) ys
termination_by xs ys => xs.length + ys.length

/-- The `true` entries of a merge are the first list. -/
theorem rankMerge_filter_true (key : α → ℕ) :
    ∀ xs ys : List α, ((rankMerge key xs ys).filter fun e => e.1).map Prod.snd = xs
  | [], ys => by simp [rankMerge]
  | x :: xs, [] => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, y :: ys => by
    unfold rankMerge
    split_ifs
    · simp only [List.filter_cons_of_pos, List.map_cons]
      rw [rankMerge_filter_true key xs (y :: ys)]
    · rw [List.filter_cons_of_neg (by simp)]
      exact rankMerge_filter_true key (x :: xs) ys
termination_by xs ys => xs.length + ys.length

/-- The `false` entries of a merge are the second list. -/
theorem rankMerge_filter_false (key : α → ℕ) :
    ∀ xs ys : List α, ((rankMerge key xs ys).filter fun e => !e.1).map Prod.snd = ys
  | [], ys => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, [] => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, y :: ys => by
    unfold rankMerge
    split_ifs
    · rw [List.filter_cons_of_neg (by simp)]
      exact rankMerge_filter_false key xs (y :: ys)
    · simp only [List.filter_cons_of_pos, List.map_cons, Bool.not_false]
      rw [rankMerge_filter_false key (x :: xs) ys]
termination_by xs ys => xs.length + ys.length

end RankMerge

section ApplyAll

variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- The composition of a list of operators, outermost first. -/
def applyAll : List (E →ₗ[ℂ] E) → E → E
  | [], y => y
  | T :: Ts, y => T (applyAll Ts y)

/-- The complement value of a slot depends only on the steps of that slot. -/
theorem chainVal_eq_applyAll (P : ℕ) (v : Bool) :
    ∀ steps : List (TransferStep E), ∀ y : E,
      chainVal P v steps y =
        applyAll ((steps.filter fun st => st.1 = v).map fun st => filterAvg P st.2.2) y
  | [], y => rfl
  | st :: rest, y => by
    by_cases h : st.1 = v
    · rw [chainVal, ite_eq_left_of_eq_true _ _ (eq_true h),
        List.filter_cons_of_pos (by simpa using h), List.map_cons, applyAll,
        chainVal_eq_applyAll P v rest y]
    · rw [chainVal, ite_eq_right_of_eq_false _ _ (eq_false h),
        List.filter_cons_of_neg (by simpa using h), chainVal_eq_applyAll P v rest y]

end ApplyAll

