theorem columnL2Restriction_adjoint (s : Set ℝ) (hs : MeasurableSet s) :
    ContinuousLinearMap.adjoint (columnL2Restriction (V := V) s hs) = columnL2Restriction s hs :=
  ((ContinuousLinearMap.eq_adjoint_iff _ _).mpr fun x y => columnL2Restriction_inner s hs x y).symm

theorem cellColumnProjection_adjoint (D : ColumnTreeData V) (A : InheritedColumnMask D)
    {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    ContinuousLinearMap.adjoint (cellColumnProjection D A hc) = cellColumnProjection D A hc :=
  (isSelfAdjoint_starProjection _).adjoint_eq

/-- Cell projections are local to their cell on both sides. -/
theorem cellColumnProjection_restrict (D : ColumnTreeData V) (A : InheritedColumnMask D)
    {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    (columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
      (dyadicGridCell_measurable D.grid c.1 c.2)).comp (cellColumnProjection D A hc) =
        cellColumnProjection D A hc ∧
    (cellColumnProjection D A hc).comp (columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
      (dyadicGridCell_measurable D.grid c.1 c.2)) = cellColumnProjection D A hc := by
  have h1 : (columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
      (dyadicGridCell_measurable D.grid c.1 c.2)).comp (cellColumnProjection D A hc) =
        cellColumnProjection D A hc :=
    ContinuousLinearMap.ext fun z => columnL2Restriction_eq_self _
      (dyadicGridCell_measurable D.grid c.1 c.2) _
      (cellColumnRange_ae_zero_off D A hc (cellColumnProjection_mem D A hc z))
  refine ⟨h1, ?_⟩
  have h2 := congrArg ContinuousLinearMap.adjoint h1
  rwa [ContinuousLinearMap.adjoint_comp, cellColumnProjection_adjoint,
    columnL2Restriction_adjoint] at h2

