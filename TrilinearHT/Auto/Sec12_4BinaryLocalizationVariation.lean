/-- The binary search over a color interval `[ℓ, h]` (blueprint lines 1841-1843): split at
`m = ⌊(ℓ+h)/2⌋` with the cumulative filter `Cum s m` of the slot `s = rule ℓ h`; the positive
branch keeps `[ℓ, m]` and the residual branch `[m+1, h]`. -/
def colorSearch {V : Type*} [AddCommGroup V] [Module ℂ V] (rule : ℕ → ℕ → Fin 4)
    (Cum : Fin 4 → ℕ → V →ₗ[ℂ] V) : ℕ → ℕ → ℕ → SplitTree V
  | 0, _, _ => SplitTree.leaf
  | fuel + 1, ℓ, h =>
      if ℓ < h then
        SplitTree.node (rule ℓ h) (Cum (rule ℓ h) ((ℓ + h) / 2))
          (colorSearch rule Cum fuel ℓ ((ℓ + h) / 2))
          (colorSearch rule Cum fuel ((ℓ + h) / 2 + 1) h)
      else SplitTree.leaf

theorem colorSearch_leafCount {V : Type*} [AddCommGroup V] [Module ℂ V] (rule : ℕ → ℕ → Fin 4)
    (Cum : Fin 4 → ℕ → V →ₗ[ℂ] V) (fuel ℓ h : ℕ) (hℓ : ℓ ≤ h) (hfuel : h - ℓ < 2 ^ fuel) :
    (colorSearch rule Cum fuel ℓ h).leafCount = h - ℓ + 1 := by
  induction fuel generalizing ℓ h with
  | zero =>
    simp only [pow_zero] at hfuel
    simp only [colorSearch, SplitTree.leafCount]; omega
  | succ fuel ih =>
    simp only [colorSearch]
    split_ifs with hlt
    · simp only [SplitTree.leafCount]
      rw [ih ℓ ((ℓ + h) / 2) (by omega) (by rw [pow_succ] at hfuel; omega),
        ih ((ℓ + h) / 2 + 1) h (by omega) (by rw [pow_succ] at hfuel; omega)]
      omega
    · simp only [SplitTree.leafCount]; omega

theorem colorSearch_height_le {V : Type*} [AddCommGroup V] [Module ℂ V] (rule : ℕ → ℕ → Fin 4)
    (Cum : Fin 4 → ℕ → V →ₗ[ℂ] V) (fuel ℓ h : ℕ) :
    (colorSearch rule Cum fuel ℓ h).height ≤ fuel := by
  induction fuel generalizing ℓ h with
  | zero => simp [colorSearch, SplitTree.height]
  | succ fuel ih =>
    simp only [colorSearch]
    split_ifs
    · simp only [SplitTree.height]
      have := ih ℓ ((ℓ + h) / 2); have := ih ((ℓ + h) / 2 + 1) h
      omega
    · simp [SplitTree.height]

section LeafLocalization
variable {V : Type*} [AddCommGroup V] [Module ℂ V]
  (Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ)

/-! ### Localization at one search leaf -/

/-- The group output `Z_{l,G} = L_{l,G} x_l` in all four slots. -/
def leafGroupOutput {γ : Type*} (L : γ → Fin 4 → V →ₗ[ℂ] V) (x : Fin 4 → V) (G : γ) :
    Fin 4 → V := fun l => L G l (x l)

/-- The three residual insertions after fixing the group source `L_{t,G} x_t` in slot `t`:
successively filter the slots `u`, `p`, `q`. -/
def leafResiduals {γ : Type*} (L : γ → Fin 4 → V →ₗ[ℂ] V) (x : Fin 4 → V) (u t p q : Fin 4)
    (G : γ) : Fin 3 → Fin 4 → V
  | 0 => Function.update (Function.update x t (L G t (x t))) u (x u - L G u (x u))
  | 1 => Function.update (Function.update (Function.update x t (L G t (x t))) u (L G u (x u)))
      p (x p - L G p (x p))
  | 2 => Function.update (Function.update (Function.update (Function.update x t (L G t (x t)))
      u (L G u (x u))) p (L G p (x p))) q (x q - L G q (x q))

omit [AddCommGroup V] [Module ℂ V] in
theorem update_comm_apply {u t : Fin 4} (h : u ≠ t) (x : Fin 4 → V) (a b : V) :
    Function.update (Function.update x u a) t b = Function.update (Function.update x t b) u a :=
  Function.update_comm h a b x

/-- The filter telescoping in the slots `u, p, q` with the group source fixed in slot `t`. -/
theorem leaf_telescope {γ : Type*} (L : γ → Fin 4 → V →ₗ[ℂ] V) (x : Fin 4 → V)
    {u t p q : Fin 4} (hut : u ≠ t) (hup : u ≠ p) (huq : u ≠ q) (htp : t ≠ p) (htq : t ≠ q)
    (hpq : p ≠ q) (G : γ) :
    Λ (Function.update x t (L G t (x t))) =
      Λ (leafGroupOutput L x G) + ∑ i : Fin 3, Λ (leafResiduals L x u t p q G i) := by
  have hcover : ∀ l : Fin 4, l = u ∨ l = t ∨ l = p ∨ l = q := by
    intro l
    fin_cases u <;> fin_cases t <;> fin_cases p <;> fin_cases q <;> fin_cases l <;>
      simp_all (config := { decide := true })
  set y0 := Function.update x t (L G t (x t))
  set y1 := Function.update y0 u (L G u (x u))
  set y2 := Function.update y1 p (L G p (x p))
  set y3 := Function.update y2 q (L G q (x q))
  have e0 : Λ y0 = Λ y1 + Λ (leafResiduals L x u t p q G 0) := by
    have := Λ.map_update_add y0 u (L G u (x u)) (x u - L G u (x u))
    simp only [add_sub_cancel] at this
    rw [show Function.update y0 u (x u) = y0 by
      simp [y0, Function.update_of_ne hut]] at this
    exact this
  have e1 : Λ y1 = Λ y2 + Λ (leafResiduals L x u t p q G 1) := by
    have := Λ.map_update_add y1 p (L G p (x p)) (x p - L G p (x p))
    simp only [add_sub_cancel] at this
    rw [show Function.update y1 p (x p) = y1 by
      simp [y1, y0, Function.update_of_ne hup.symm, Function.update_of_ne htp.symm]] at this
    exact this
  have e2 : Λ y2 = Λ y3 + Λ (leafResiduals L x u t p q G 2) := by
    have := Λ.map_update_add y2 q (L G q (x q)) (x q - L G q (x q))
    simp only [add_sub_cancel] at this
    rw [show Function.update y2 q (x q) = y2 by
      simp [y2, y1, y0, Function.update_of_ne hpq.symm, Function.update_of_ne huq.symm,
        Function.update_of_ne htq.symm]] at this
    exact this
  have e3 : y3 = leafGroupOutput L x G := by
    funext l
    rcases hcover l with rfl | rfl | rfl | rfl
    · simp [y3, y2, y1, Function.update_of_ne huq, Function.update_of_ne hup, leafGroupOutput]
    · simp [y3, y2, y1, y0, Function.update_of_ne htq, Function.update_of_ne htp,
        Function.update_of_ne hut.symm, leafGroupOutput]
    · simp [y3, y2, Function.update_of_ne hpq, leafGroupOutput]
    · simp [y3, leafGroupOutput]
  rw [e0, e1, e2, e3, Fin.sum_univ_three]
  ring

/-- Blueprint prop:localize, lines 1847-1850: the exact expansion at one leaf. The outer
primal of slot `u` is expanded into sources; the sum of the first ball projections of the
current groups is inserted in slot `t`; the remaining slots are filtered successively. -/
theorem leaf_identity {ι γ : Type*} (L : γ → Fin 4 → V →ₗ[ℂ] V) (x : Fin 4 → V)
    {u t p q : Fin 4} (hut : u ≠ t) (hup : u ≠ p) (huq : u ≠ q) (htp : t ≠ p) (htq : t ≠ q)
    (hpq : p ≠ q) (S : Finset ι) (a : ι → ℂ) (φ : ι → V) (hx : x u = ∑ v ∈ S, a v • φ v)
    (Gs : Finset γ) :
    Λ x = ∑ G ∈ Gs, Λ (leafGroupOutput L x G) +
      ∑ v ∈ S, a v * Λ (Function.update (Function.update x u (φ v)) t
        (x t - ∑ G ∈ Gs, L G t (x t))) +
      ∑ G ∈ Gs, ∑ i : Fin 3, Λ (leafResiduals L x u t p q G i) := by
  -- expand the source slot
  have hsrc : ∀ y : V, Λ (Function.update x t y) =
      ∑ v ∈ S, a v * Λ (Function.update (Function.update x u (φ v)) t y) := by
    intro y
    have hxu : Function.update x t y = Function.update (Function.update x t y) u (x u) := by
      simp [Function.update_of_ne hut]
    rw [hxu, hx, Λ.map_update_sum]
    apply Finset.sum_congr rfl; intro v _
    rw [Λ.map_update_smul, smul_eq_mul, update_comm_apply hut]
  have hx0 : Λ x = Λ (Function.update x t (x t)) := by rw [Function.update_eq_self]
  have hsplit : ∀ v, Λ (Function.update (Function.update x u (φ v)) t (x t)) =
      ∑ G ∈ Gs, Λ (Function.update (Function.update x u (φ v)) t (L G t (x t))) +
        Λ (Function.update (Function.update x u (φ v)) t (x t - ∑ G ∈ Gs, L G t (x t))) := by
    intro v
    rw [← Λ.map_update_sum, ← Λ.map_update_add, add_sub_cancel]
  rw [hx0, hsrc]
  simp_rw [hsplit, mul_add, Finset.sum_add_distrib, Finset.mul_sum]
  rw [Finset.sum_comm]
  have hG : ∀ G ∈ Gs, ∑ v ∈ S, a v * Λ (Function.update (Function.update x u (φ v)) t
      (L G t (x t))) = Λ (leafGroupOutput L x G) +
        ∑ i : Fin 3, Λ (leafResiduals L x u t p q G i) := by
    intro G _
    rw [← hsrc, leaf_telescope Λ L x hut hup huq htp htq hpq G]
  rw [Finset.sum_congr rfl hG, Finset.sum_add_distrib]
  ring

/-- Blueprint prop:localize, lines 1847-1852: the error at one leaf. Old sources are killed by
the lower guard (`εo`); a current source of group `G₀` has the matching difference controlled
by the catalog test (`εm`) and pair separation from the other groups (`εs`); the residual
insertions against the fixed group source are tested (`εr`). -/
theorem leaf_localization {ι γ : Type*} (L : γ → Fin 4 → V →ₗ[ℂ] V) (x : Fin 4 → V)
    {u t p q : Fin 4} (hut : u ≠ t) (hup : u ≠ p) (huq : u ≠ q) (htp : t ≠ p) (htq : t ≠ q)
    (hpq : p ≠ q) (S : Finset ι) (a : ι → ℂ) (φ : ι → V) (hx : x u = ∑ v ∈ S, a v • φ v)
    (Gs : Finset γ) (grp : ι → Option γ) {εo εm εs εr : ℝ}
    (hold : ∀ v ∈ S, grp v = none →
      ‖Λ (Function.update (Function.update x u (φ v)) t (x t))‖ ≤ εo ∧
      ∀ G ∈ Gs, ‖Λ (Function.update (Function.update x u (φ v)) t (L G t (x t)))‖ ≤ εo)
    (hcur : ∀ v ∈ S, ∀ G₀, grp v = some G₀ → G₀ ∈ Gs ∧
      ‖Λ (Function.update (Function.update x u (φ v)) t (x t - L G₀ t (x t)))‖ ≤ εm ∧
      ∀ G ∈ Gs, G ≠ G₀ →
        ‖Λ (Function.update (Function.update x u (φ v)) t (L G t (x t)))‖ ≤ εs)
    (hres : ∀ G ∈ Gs, ∀ i, ‖Λ (leafResiduals L x u t p q G i)‖ ≤ εr)
    (hεo : 0 ≤ εo) (hεm : 0 ≤ εm) (hεs : 0 ≤ εs) :
    ‖Λ x - ∑ G ∈ Gs, Λ (leafGroupOutput L x G)‖ ≤
      (∑ v ∈ S, ‖a v‖) * ((Gs.card + 1) * εo + εm + Gs.card * εs) + Gs.card * (3 * εr) := by
  classical
  rw [leaf_identity Λ L x hut hup huq htp htq hpq S a φ hx Gs]
  set E := (Gs.card + 1 : ℝ) * εo + εm + Gs.card * εs
  have hsrc : ∀ v ∈ S, ‖Λ (Function.update (Function.update x u (φ v)) t
      (x t - ∑ G ∈ Gs, L G t (x t)))‖ ≤ E := by
    intro v hv
    rcases hg : grp v with _ | G₀
    · obtain ⟨h1, h2⟩ := hold v hv hg
      rw [Λ.map_update_sub, Λ.map_update_sum]
      calc _ ≤ ‖Λ (Function.update (Function.update x u (φ v)) t (x t))‖ +
            ‖∑ G ∈ Gs, Λ (Function.update (Function.update x u (φ v)) t (L G t (x t)))‖ :=
            norm_sub_le _ _
        _ ≤ εo + Gs.card * εo := add_le_add h1 ((norm_sum_le _ _).trans
            ((Finset.sum_le_sum h2).trans (by rw [Finset.sum_const, nsmul_eq_mul])))
        _ ≤ E := by
            have : 0 ≤ (Gs.card : ℝ) * εs := by positivity
            simp only [E]; nlinarith
    · obtain ⟨hG₀, h1, h2⟩ := hcur v hv G₀ hg
      have hdec : x t - ∑ G ∈ Gs, L G t (x t) =
          (x t - L G₀ t (x t)) - ∑ G ∈ Gs.erase G₀, L G t (x t) := by
        rw [← Finset.add_sum_erase Gs _ hG₀]; abel
      rw [hdec, Λ.map_update_sub, Λ.map_update_sum]
      calc _ ≤ ‖Λ (Function.update (Function.update x u (φ v)) t (x t - L G₀ t (x t)))‖ +
            ‖∑ G ∈ Gs.erase G₀, Λ (Function.update (Function.update x u (φ v)) t
              (L G t (x t)))‖ := norm_sub_le _ _
        _ ≤ εm + (Gs.erase G₀).card * εs := add_le_add h1 ((norm_sum_le _ _).trans
            ((Finset.sum_le_sum fun G hG => h2 G (Finset.mem_of_mem_erase hG)
              (Finset.ne_of_mem_erase hG)).trans (by rw [Finset.sum_const, nsmul_eq_mul])))
        _ ≤ E := by
            have hc : ((Gs.erase G₀).card : ℝ) ≤ Gs.card := by
              exact_mod_cast Finset.card_erase_le
            have : ((Gs.erase G₀).card : ℝ) * εs ≤ Gs.card * εs :=
              mul_le_mul_of_nonneg_right hc hεs
            have : 0 ≤ (Gs.card + 1 : ℝ) * εo := by positivity
            simp only [E]; linarith
  have hE : 0 ≤ E := by simp only [E]; positivity
  have hfirst : ‖∑ v ∈ S, a v * Λ (Function.update (Function.update x u (φ v)) t
      (x t - ∑ G ∈ Gs, L G t (x t)))‖ ≤ (∑ v ∈ S, ‖a v‖) * E := by
    rw [Finset.sum_mul]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun v hv => ?_)
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hsrc v hv) (norm_nonneg _)
  have hsecond : ‖∑ G ∈ Gs, ∑ i : Fin 3, Λ (leafResiduals L x u t p q G i)‖ ≤
      Gs.card * (3 * εr) := by
    refine (norm_sum_le _ _).trans ?_
    calc ∑ G ∈ Gs, ‖∑ i : Fin 3, Λ (leafResiduals L x u t p q G i)‖ ≤
        ∑ _G ∈ Gs, 3 * εr := Finset.sum_le_sum fun G hG => (norm_sum_le _ _).trans (by
          calc ∑ i : Fin 3, ‖Λ (leafResiduals L x u t p q G i)‖ ≤ ∑ _i : Fin 3, εr :=
                Finset.sum_le_sum fun i _ => hres G hG i
            _ = 3 * εr := by simp)
      _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]
  calc _ = ‖∑ v ∈ S, a v * Λ (Function.update (Function.update x u (φ v)) t
        (x t - ∑ G ∈ Gs, L G t (x t))) +
        ∑ G ∈ Gs, ∑ i : Fin 3, Λ (leafResiduals L x u t p q G i)‖ := by congr 1; ring
    _ ≤ _ := (norm_add_le _ _).trans (add_le_add hfirst hsecond)

end LeafLocalization

/-! ### The current-group decomposition (prop:localize) -/

/-- `eq:min-subadd` for finite sums of nonnegative numbers. -/
theorem min_finset_subadd {σ : Type*} (s : Finset σ) {η : ℝ} (hη : 0 ≤ η) (f : σ → ℝ)
    (hf : ∀ j ∈ s, 0 ≤ f j) : min η (∑ j ∈ s, f j) ≤ ∑ j ∈ s, min η (f j) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [hη]
  | insert j s hj ih =>
    rw [Finset.sum_insert hj, Finset.sum_insert hj]
    have h1 := hf j (Finset.mem_insert_self j s)
    have h2 : ∀ i ∈ s, 0 ≤ f i := fun i hi => hf i (Finset.mem_insert_of_mem hi)
    have ih' := ih h2
    have hs : 0 ≤ ∑ i ∈ s, f i := Finset.sum_nonneg h2
    have hm : 0 ≤ ∑ i ∈ s, min η (f i) := Finset.sum_nonneg fun i hi => le_min hη (h2 i hi)
    rcases le_total η (f j) with h | h
    · rw [min_eq_left h]
      exact (min_le_left _ _).trans (le_add_of_nonneg_right hm)
    · rw [min_eq_right h]
      calc min η (f j + ∑ i ∈ s, f i) ≤ f j + min η (∑ i ∈ s, f i) := by
            rcases le_total η (∑ i ∈ s, f i) with h' | h'
            · rw [min_eq_left h']
              exact (min_le_left _ _).trans (by linarith)
            · rw [min_eq_right h']
              exact min_le_right _ _
        _ ≤ f j + ∑ i ∈ s, min η (f i) := by linarith

/-- The cell minima distribute over the leaves (blueprint line 1858, via `eq:min-subadd`). -/
theorem cell_min_leaves {ιc σ : Type*} (cells : Finset ιc) (wt : ιc → ℝ)
    (hwt : ∀ I, 0 ≤ wt I) {η : ℝ} (hη : 0 ≤ η) (Hval : ιc → ℂ) (leaves : Finset σ)
    (Hleaf : ιc → σ → ℂ) (hsplit : ∀ I ∈ cells, Hval I = ∑ s ∈ leaves, Hleaf I s)
    (Mn : ιc → σ → ℂ) (ε : ιc → σ → ℝ)
    (hleaf : ∀ I ∈ cells, ∀ s ∈ leaves, ‖Hleaf I s - Mn I s‖ ≤ ε I s) :
    ∑ I ∈ cells, wt I * min η ‖Hval I‖ ≤
      ∑ s ∈ leaves, ∑ I ∈ cells, wt I * min η ‖Mn I s‖ +
        ∑ I ∈ cells, wt I * ∑ s ∈ leaves, ε I s := by
  rw [Finset.sum_comm, ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro I hI
  rw [← Finset.mul_sum, ← mul_add]
  apply mul_le_mul_of_nonneg_left _ (hwt I)
  rw [← Finset.sum_add_distrib, hsplit I hI]
  calc min η ‖∑ s ∈ leaves, Hleaf I s‖ ≤ min η (∑ s ∈ leaves, ‖Hleaf I s‖) :=
        min_le_min le_rfl (norm_sum_le _ _)
    _ ≤ ∑ s ∈ leaves, min η ‖Hleaf I s‖ :=
        min_finset_subadd leaves hη _ fun _ _ => norm_nonneg _
    _ ≤ _ := Finset.sum_le_sum fun s hs => by
        have h := hleaf I hI s hs
        have h0 : 0 ≤ ε I s := (norm_nonneg _).trans h
        have hle : ‖Hleaf I s‖ ≤ ‖Mn I s‖ + ε I s := by
          calc ‖Hleaf I s‖ = ‖(Hleaf I s - Mn I s) +
                Mn I s‖ := by rw [sub_add_cancel]
            _ ≤ _ := (norm_add_le _ _).trans (by linarith)
        rcases le_total η ‖Mn I s‖ with h' | h'
        · rw [min_eq_left h']; exact (min_le_left _ _).trans (by linarith)
        · rw [min_eq_right h']; exact (min_le_right _ _).trans hle

namespace SplitTree
variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- The operator tuple of the `s`-th leaf. -/
def leafOp (t : SplitTree V) (s : ℕ) : Fin 4 → V →ₗ[ℂ] V :=
  (t.ops fun _ => LinearMap.id).getD s fun _ => LinearMap.id

theorem form_eq_sum_leafOp (Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ) (t : SplitTree V)
    (z : Fin 4 → V) :
    Λ z = ∑ s ∈ Finset.range t.leafCount, Λ (fun l => t.leafOp s l (z l)) := by
  have h := form_eq_sum_ops Λ t (fun _ => LinearMap.id) z
  simp only [LinearMap.id_apply] at h
  rw [h, ← ops_length t (fun _ => LinearMap.id), Finset.sum_range]
  rw [← List.sum_ofFn]
  congr 1
  apply List.ext_get
  · simp
  · intro n h1 h2
    simp [leafOp]

end SplitTree

/-- The data of the localization at one search leaf and one cell: the leaf inputs `x`, the
expanded outer primal in slot `u`, the third slot `t`, the current groups with their filters,
and the test bounds of `leaf_localization`. -/
structure LeafLocalData (V : Type*) [AddCommGroup V] [Module ℂ V]
    (Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ) (x : Fin 4 → V) where
  ι : Type
  γ : Type
  u : Fin 4
  t : Fin 4
  p : Fin 4
  q : Fin 4
  hut : u ≠ t
  hup : u ≠ p
  huq : u ≠ q
  htp : t ≠ p
  htq : t ≠ q
  hpq : p ≠ q
  S : Finset ι
  a : ι → ℂ
  φ : ι → V
  hx : x u = ∑ v ∈ S, a v • φ v
  Gs : Finset γ
  grp : ι → Option γ
  L : γ → Fin 4 → V →ₗ[ℂ] V
  εo : ℝ
  εm : ℝ
  εs : ℝ
  εr : ℝ
  hεo : 0 ≤ εo
  hεm : 0 ≤ εm
  hεs : 0 ≤ εs
  hold : ∀ v ∈ S, grp v = none →
    ‖Λ (Function.update (Function.update x u (φ v)) t (x t))‖ ≤ εo ∧
    ∀ G ∈ Gs, ‖Λ (Function.update (Function.update x u (φ v)) t (L G t (x t)))‖ ≤ εo
  hcur : ∀ v ∈ S, ∀ G₀, grp v = some G₀ → G₀ ∈ Gs ∧
    ‖Λ (Function.update (Function.update x u (φ v)) t (x t - L G₀ t (x t)))‖ ≤ εm ∧
    ∀ G ∈ Gs, G ≠ G₀ →
      ‖Λ (Function.update (Function.update x u (φ v)) t (L G t (x t)))‖ ≤ εs
  hres : ∀ G ∈ Gs, ∀ i, ‖Λ (leafResiduals L x u t p q G i)‖ ≤ εr

namespace LeafLocalData
variable {V : Type*} [AddCommGroup V] [Module ℂ V] {Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ}
  {x : Fin 4 → V} (D : LeafLocalData V Λ x)

/-- The localized main term `Σ_G H_I(Z_{0,G}, …, Z_{3,G})`. -/
noncomputable def main : ℂ := ∑ G ∈ D.Gs, Λ (leafGroupOutput D.L x G)

/-- The error budget of the leaf. -/
noncomputable def err : ℝ :=
  (∑ v ∈ D.S, ‖D.a v‖) * ((D.Gs.card + 1) * D.εo + D.εm + D.Gs.card * D.εs) +
    D.Gs.card * (3 * D.εr)

theorem bound : ‖Λ x - D.main‖ ≤ D.err :=
  leaf_localization Λ D.L x D.hut D.hup D.huq D.htp D.htq D.hpq D.S D.a D.φ D.hx D.Gs D.grp
    D.hold D.hcur D.hres D.hεo D.hεm D.hεs

end LeafLocalData

/-- Blueprint §12.4, prop:localize (line 1856, `THT.Localization.binaryGroupExpansion`).
On every cell `I` the binary search tree `T I` over the color interval (with `N` leaves,
e.g. `colorSearch`, at most `L` leaves and height `O(log L)`) expands the form exactly over
its leaves; at each leaf the outer primal is expanded and the current groups are localized
with the test bounds of `LeafLocalData`. Then the weighted cell minima are at most the sum
over the leaves of the weighted minima of the current-group sums
`Σ_G H_I(Z_{0,G,s}, …, Z_{3,G,s})`, `Z_{l,G,s} = L_{l,G,s} B_{l,s} z_l`, plus the weighted sum of
the leaf errors. -/
theorem binaryGroupExpansion {V : Type*} [AddCommGroup V] [Module ℂ V] {ιc : Type*}
    (cells : Finset ιc) (wt : ιc → ℝ) (hwt : ∀ I, 0 ≤ wt I) {η : ℝ} (hη : 0 ≤ η)
    (Λ : ιc → MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ) (z : ιc → Fin 4 → V)
    (T : ιc → SplitTree V) (N : ℕ) (hN : ∀ I ∈ cells, (T I).leafCount = N)
    (D : ∀ I s, LeafLocalData V (Λ I) (fun l => (T I).leafOp s l (z I l))) :
    ∑ I ∈ cells, wt I * min η ‖Λ I (z I)‖ ≤
      ∑ s ∈ Finset.range N, ∑ I ∈ cells, wt I * min η ‖(D I s).main‖ +
        ∑ I ∈ cells, wt I * ∑ s ∈ Finset.range N, (D I s).err := by
  have h := cell_min_leaves cells wt hwt hη (fun I => Λ I (z I)) (Finset.range N)
    (fun I s => Λ I (fun l => (T I).leafOp s l (z I l)))
    (fun I hI => by rw [← hN I hI]; exact SplitTree.form_eq_sum_leafOp (Λ I) (T I) (z I))
    (fun I s => (D I s).main) (fun I s => (D I s).err)
    (fun I _ s _ => (D I s).bound)
  exact h

section CertifiedVariation
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ### Certified variation (lem:variation) -/

/-- Synthesis bound dual to a Bessel row family. -/
theorem synthesis_le_of_bessel {κ : Type*} (s : Finset κ) (R : κ → H →L[ℂ] H) {c : ℝ}
    (hc : 0 ≤ c) (hB : ∀ h, ∑ k ∈ s, ‖R k h‖ ^ 2 ≤ c * ‖h‖ ^ 2) (x : κ → H) :
    ‖∑ k ∈ s, ContinuousLinearMap.adjoint (R k) (x k)‖ ^ 2 ≤
      c * ∑ k ∈ s, ‖x k‖ ^ 2 := by
  set S := ∑ k ∈ s, ContinuousLinearMap.adjoint (R k) (x k)
  have hS : ‖S‖ ^ 2 = RCLike.re (inner ℂ S S) := by
    rw [inner_self_eq_norm_sq_to_K, ← RCLike.ofReal_pow, RCLike.ofReal_re]
  have hinner : inner ℂ S S = ∑ k ∈ s, inner ℂ (x k) (R k S) := by
    simp only [S, sum_inner, ContinuousLinearMap.adjoint_inner_left]
  have hle : ‖S‖ ^ 2 ≤ Real.sqrt (∑ k ∈ s, ‖x k‖ ^ 2) * Real.sqrt (∑ k ∈ s, ‖R k S‖ ^ 2) := by
    rw [hS, hinner, map_sum]
    calc ∑ k ∈ s, RCLike.re (inner ℂ (x k) (R k S)) ≤ ∑ k ∈ s, ‖x k‖ * ‖R k S‖ :=
          Finset.sum_le_sum fun k _ => (RCLike.re_le_norm _).trans (norm_inner_le_norm _ _)
      _ ≤ _ := Real.sum_mul_le_sqrt_mul_sqrt s _ _
  have h2 := hB S
  have hX0 : 0 ≤ ∑ k ∈ s, ‖x k‖ ^ 2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hle2 : ‖S‖ ^ 2 ≤ Real.sqrt (∑ k ∈ s, ‖x k‖ ^ 2) * (Real.sqrt c * ‖S‖) := by
    refine hle.trans (mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _))
    rw [← Real.sqrt_sq (norm_nonneg S), ← Real.sqrt_mul hc]
    exact Real.sqrt_le_sqrt h2
  rcases eq_or_lt_of_le (norm_nonneg S) with h0 | hpos
  · rw [← h0]; simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow]; positivity
  · have h3 : ‖S‖ ≤ Real.sqrt (∑ k ∈ s, ‖x k‖ ^ 2) * Real.sqrt c := by
      have h4 : ‖S‖ * ‖S‖ ≤ (Real.sqrt (∑ k ∈ s, ‖x k‖ ^ 2) * Real.sqrt c) * ‖S‖ := by
        have := hle2; rw [sq] at this; linarith [this]
      exact le_of_mul_le_mul_right h4 hpos
    calc ‖S‖ ^ 2 ≤ (Real.sqrt (∑ k ∈ s, ‖x k‖ ^ 2) * Real.sqrt c) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) h3 2
      _ = c * ∑ k ∈ s, ‖x k‖ ^ 2 := by
          rw [mul_pow, Real.sq_sqrt hX0, Real.sq_sqrt hc]; ring

/-- Blueprint lem:variation, line 1867: rows that are Bessel within each group and whose
adjoint outputs over the groups satisfy the almost-orthogonality `eq:whole-ranges`
(`‖Σ_G Z_G‖² ≤ C Σ_G ‖Z_G‖²`) are jointly Bessel with constant `C`. -/
theorem joint_bessel_of_wholeRanges {γ κ : Type*} [Fintype γ] [DecidableEq γ] (s : Finset κ) (grp
    : κ → γ)
    (R : κ → H →L[ℂ] H) (hgrp : ∀ G h, ∑ k ∈ s.filter (grp · = G), ‖R k h‖ ^ 2 ≤ ‖h‖ ^ 2)
    {C : ℝ} (hC : 0 ≤ C)
    (hwr : ∀ x : κ → H, ‖∑ k ∈ s, ContinuousLinearMap.adjoint (R k) (x k)‖ ^ 2 ≤
      C * ∑ G, ‖∑ k ∈ s.filter (grp · = G), ContinuousLinearMap.adjoint (R k) (x k)‖ ^ 2)
    (h : H) : ∑ k ∈ s, ‖R k h‖ ^ 2 ≤ C * ‖h‖ ^ 2 := by
  classical
  set X := ∑ k ∈ s, ‖R k h‖ ^ 2
  set S := ∑ k ∈ s, ContinuousLinearMap.adjoint (R k) (R k h)
  have hX0 : 0 ≤ X := Finset.sum_nonneg fun _ _ => sq_nonneg _
  have hXS : X = RCLike.re (inner ℂ h S) := by
    simp only [S, inner_sum, ContinuousLinearMap.adjoint_inner_right, map_sum, X]
    apply Finset.sum_congr rfl; intro k _
    rw [inner_self_eq_norm_sq_to_K, ← RCLike.ofReal_pow, RCLike.ofReal_re]
  have hSG : ‖S‖ ^ 2 ≤ C * X := by
    refine (hwr fun k => R k h).trans (mul_le_mul_of_nonneg_left ?_ hC)
    calc ∑ G, ‖∑ k ∈ s.filter (grp · = G), ContinuousLinearMap.adjoint (R k) (R k h)‖ ^ 2 ≤
        ∑ G, 1 * ∑ k ∈ s.filter (grp · = G), ‖R k h‖ ^ 2 :=
          Finset.sum_le_sum fun G _ => synthesis_le_of_bessel _ R zero_le_one
            (fun h' => by rw [one_mul]; exact hgrp G h') _
      _ = X := by
          simp only [one_mul, X]
          exact Finset.sum_fiberwise s grp _
  have hXle : X ≤ ‖h‖ * Real.sqrt (C * X) := by
    refine hXS.le.trans ((RCLike.re_le_norm _).trans ((norm_inner_le_norm _ _).trans ?_))
    exact mul_le_mul_of_nonneg_left (by
      rw [← Real.sqrt_sq (norm_nonneg S)]; exact Real.sqrt_le_sqrt hSG) (norm_nonneg _)
  rcases eq_or_lt_of_le hX0 with h0 | hpos
  · rw [← h0]; positivity
  · have h1 : X ^ 2 ≤ ‖h‖ ^ 2 * (C * X) := by
      have := pow_le_pow_left₀ hX0 hXle 2
      rwa [mul_pow, Real.sq_sqrt (by positivity)] at this
    have h2 : X * X ≤ (C * ‖h‖ ^ 2) * X := by nlinarith
    exact le_of_mul_le_mul_right h2 hpos

end CertifiedVariation

section CertifiedVariation2
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-- Blueprint lem:variation, lines 1870-1871: telescoping the shared history `B'_t - B'_r`
into changed middle factors, discarding the left contractions, and inserting the right factors
at `r` by compression (cost `G₀` per layer). -/
theorem product_jumps_compression (P : ℕ → ℕ → H →L[ℂ] H) (T m : ℕ)
    (hP : ∀ l < m, ∀ n ≤ T, IsStarProjection (P l n))
    (hnest : ∀ l < m, ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P l i).comp (P l j) = P l i)
    {ι : Type*} [Fintype ι] (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i) (ht : ∀ i, t i ≤ T)
    (hdis : ∀ i j, i ≠ j → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r j) (t j)))
    (F : H) {G₀ : ℝ} (hG₀ : 0 ≤ G₀)
    (hcomp : ∀ l < m, ∀ c : ℝ, 0 ≤ c →
      (∀ h, ∑ i, ‖(P l (t i) - P l (r i)) h‖ ^ 2 ≤ c * ‖h‖ ^ 2) →
      ∑ i, ‖(P l (t i) - P l (r i)) (nestedProjectionProduct P l (r i) F)‖ ^ 2 ≤
        c * G₀ * ‖F‖ ^ 2) :
    ∑ i, ‖nestedProjectionProduct P m (t i) F - nestedProjectionProduct P m (r i) F‖ ^ 2 ≤
      (m : ℝ) ^ 2 * G₀ * ‖F‖ ^ 2 := by
  have key : finiteRowNorm (fun i => nestedProjectionProduct P m (t i) F -
      nestedProjectionProduct P m (r i) F) ≤ m * (Real.sqrt G₀ * ‖F‖) := by
    induction m with
    | zero => simp [nestedProjectionProduct, finiteRowNorm]; rfl
    | succ m ih =>
      have hi := ih (fun l hl => hP l (by omega)) (fun l hl => hnest l (by omega))
        (fun l hl => hcomp l (by omega))
      have hbes : ∀ h, ∑ i, ‖(P m (t i) - P m (r i)) h‖ ^ 2 ≤ 1 * ‖h‖ ^ 2 := fun h => by
        rw [one_mul]
        exact projection_interval_differences_bessel (P m) T (hP m (by omega))
          (hnest m (by omega)) r t hrt ht hdis h
      have hc := hcomp m (by omega) 1 zero_le_one hbes
      have hrow : finiteRowNorm (fun i => (P m (t i) - P m (r i))
          (nestedProjectionProduct P m (r i) F)) ≤ Real.sqrt G₀ * ‖F‖ := by
        apply finiteRowNorm_le_of_sq_le _ (by positivity)
        rw [mul_pow, Real.sq_sqrt hG₀]
        linarith
      have he : (fun i => nestedProjectionProduct P (m + 1) (t i) F -
          nestedProjectionProduct P (m + 1) (r i) F) =
          (fun i => P m (t i) (nestedProjectionProduct P m (t i) F -
            nestedProjectionProduct P m (r i) F)) +
          (fun i => (P m (t i) - P m (r i)) (nestedProjectionProduct P m (r i) F)) :=
        funext fun i => nestedProjectionProduct_jump_split P m (r i) (t i) F
      rw [he]
      calc _ ≤ finiteRowNorm (fun i => P m (t i) (nestedProjectionProduct P m (t i) F -
            nestedProjectionProduct P m (r i) F)) +
          finiteRowNorm (fun i => (P m (t i) - P m (r i))
            (nestedProjectionProduct P m (r i) F)) := finiteRowNorm_add_le _ _
        _ ≤ m * (Real.sqrt G₀ * ‖F‖) + Real.sqrt G₀ * ‖F‖ := by
          apply add_le_add _ hrow
          exact (finiteRowNorm_mono _ _ fun i =>
            starProjection_norm_apply_le (P m (t i)) (hP m (by omega) (t i) (ht i)) _).trans hi
        _ = ((m + 1 : ℕ) : ℝ) * (Real.sqrt G₀ * ‖F‖) := by push_cast; ring
  have h0 : 0 ≤ (m : ℝ) * (Real.sqrt G₀ * ‖F‖) := by positivity
  have hsq := pow_le_pow_left₀ (finiteRowNorm_nonneg _) key 2
  rw [finiteRowNorm_sq, mul_pow, mul_pow, Real.sq_sqrt hG₀] at hsq
  linarith

theorem sum_filter_fst {γ ι : Type*} [Fintype γ] [Fintype ι] [DecidableEq γ]
    (f : γ × ι → ℝ) (G : γ) :
    ∑ k ∈ (Finset.univ : Finset (γ × ι)).filter (fun k => k.1 = G), f k = ∑ i, f (G, i) := by
  rw [Finset.sum_filter, Fintype.sum_prod_type]
  rw [Finset.sum_eq_single G]
  · simp
  · intro b _ hb; simp [hb]
  · intro h; exact absurd (Finset.mem_univ G) h

/-- Blueprint §12.4, lem:variation (line 1879, `THT.Localization.certifiedVariation`), for the
basic coarse outputs `Z_{G,s} = L_{G,s} B'_s F` with individual nested ball projections
`L_{G,s}` and a shared product `B'_s` of `m` nested projection layers, restricted at the right
endpoints by contractions `E_{G,[r,t]}` (the certified unions). On disjoint depth intervals,
`Σ_{G,[r,t]} ‖E (Z_{G,t} - Z_{G,r})‖² ≤ 2 C_w G₀ (1 + m²) ‖F‖²`, given `eq:whole-ranges` for
the ball rows (constant `C_w`, as adjoint almost-orthogonality across groups) and the
compression estimate (cost `G₀`) for the rows used. The row Bessel bounds are proved here:
orthogonal increments of nested projections within a group, joint across groups by
`joint_bessel_of_wholeRanges`. -/
theorem certifiedVariation {γ ι : Type*} [Fintype γ] [DecidableEq γ] [Fintype ι] (T m : ℕ)
    (P : ℕ → ℕ → H →L[ℂ] H) (hP : ∀ l < m, ∀ n ≤ T, IsStarProjection (P l n))
    (hnest : ∀ l < m, ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (P l i).comp (P l j) = P l i)
    (L : γ → ℕ → H →L[ℂ] H) (hL : ∀ G, ∀ n ≤ T, IsStarProjection (L G n))
    (hLnest : ∀ G, ∀ i ≤ T, ∀ j ≤ T, i ≤ j → (L G i).comp (L G j) = L G i)
    (E : γ → ι → H →L[ℂ] H) (hE : ∀ G i y, ‖E G i y‖ ≤ ‖y‖)
    (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i) (ht : ∀ i, t i ≤ T)
    (hdis : ∀ i j, i ≠ j → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r j) (t j)))
    (F : H) {Cw G₀ : ℝ} (hCw : 0 ≤ Cw) (hG₀ : 0 ≤ G₀)
    (hwr1 : ∀ x : γ × ι → H, ‖∑ k, ContinuousLinearMap.adjoint
        ((E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2))) (x k)‖ ^ 2 ≤
      Cw * ∑ G, ‖∑ k ∈ (Finset.univ : Finset (γ × ι)).filter (fun k => k.1 = G),
        ContinuousLinearMap.adjoint ((E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2))) (x k)‖ ^ 2)
    (hcomp1 : ∀ c : ℝ, 0 ≤ c → (∀ h, ∑ k : γ × ι,
        ‖(E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2)) h‖ ^ 2 ≤ c * ‖h‖ ^ 2) →
      ∑ k : γ × ι, ‖(E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2))
        (nestedProjectionProduct P m (r k.2) F)‖ ^ 2 ≤ c * G₀ * ‖F‖ ^ 2)
    (hwr2 : ∀ i, ∀ x : γ → H, ‖∑ G, ContinuousLinearMap.adjoint
        ((E G i).comp (L G (t i))) (x G)‖ ^ 2 ≤
      Cw * ∑ G, ‖∑ G' ∈ (Finset.univ : Finset γ).filter (fun G' => G' = G),
        ContinuousLinearMap.adjoint ((E G' i).comp (L G' (t i))) (x G')‖ ^ 2)
    (hcompL : ∀ l < m, ∀ c : ℝ, 0 ≤ c →
      (∀ h, ∑ i, ‖(P l (t i) - P l (r i)) h‖ ^ 2 ≤ c * ‖h‖ ^ 2) →
      ∑ i, ‖(P l (t i) - P l (r i)) (nestedProjectionProduct P l (r i) F)‖ ^ 2 ≤
        c * G₀ * ‖F‖ ^ 2) :
    ∑ k : γ × ι, ‖E k.1 k.2 (L k.1 (t k.2) (nestedProjectionProduct P m (t k.2) F) -
        L k.1 (r k.2) (nestedProjectionProduct P m (r k.2) F))‖ ^ 2 ≤
      2 * Cw * G₀ * (1 + (m : ℝ) ^ 2) * ‖F‖ ^ 2 := by
  set B' := fun s => nestedProjectionProduct P m s F
  set R1 : γ × ι → H →L[ℂ] H := fun k => (E k.1 k.2).comp (L k.1 (t k.2) - L k.1 (r k.2))
  -- first term: joint Bessel and compression
  have hgrp1 : ∀ G h, ∑ k ∈ (Finset.univ : Finset (γ × ι)).filter (fun k => k.1 = G),
      ‖R1 k h‖ ^ 2 ≤ ‖h‖ ^ 2 := by
    intro G h
    rw [sum_filter_fst (fun k => ‖R1 k h‖ ^ 2) G]
    calc ∑ i, ‖R1 (G, i) h‖ ^ 2 ≤ ∑ i, ‖(L G (t i) - L G (r i)) h‖ ^ 2 :=
          Finset.sum_le_sum fun i _ => pow_le_pow_left₀ (norm_nonneg _)
            (by simp only [R1, ContinuousLinearMap.comp_apply]; exact hE G i _) 2
      _ ≤ ‖h‖ ^ 2 := projection_interval_differences_bessel (L G) T (hL G) (hLnest G) r t hrt
          ht hdis h
  have hjoint1 : ∀ h, ∑ k : γ × ι, ‖R1 k h‖ ^ 2 ≤ Cw * ‖h‖ ^ 2 :=
    fun h => joint_bessel_of_wholeRanges Finset.univ Prod.fst R1 hgrp1 hCw hwr1 h
  have hterm1 := hcomp1 Cw hCw hjoint1
  -- second term: whole ranges at the right endpoints and the product jumps
  have hjoint2 : ∀ i y, ∑ G, ‖(E G i).comp (L G (t i)) y‖ ^ 2 ≤ Cw * ‖y‖ ^ 2 := by
    intro i y
    apply joint_bessel_of_wholeRanges Finset.univ id (fun G => (E G i).comp (L G (t i))) _ hCw
      (hwr2 i) y
    intro G h
    rw [Finset.sum_filter, Finset.sum_eq_single G (fun b _ hb => by simp [hb])
      (fun h' => absurd (Finset.mem_univ G) h')]
    simp only [id, ite_true, ContinuousLinearMap.comp_apply]
    exact pow_le_pow_left₀ (norm_nonneg _) ((hE G i _).trans
      (starProjection_norm_apply_le _ (hL G (t i) (ht i)) _)) 2
  have hjump := product_jumps_compression P T m hP hnest r t hrt ht hdis F hG₀ hcompL
  have hterm2 : ∑ k : γ × ι, ‖E k.1 k.2 (L k.1 (t k.2) (B' (t k.2) - B' (r k.2)))‖ ^ 2 ≤
      Cw * ((m : ℝ) ^ 2 * G₀ * ‖F‖ ^ 2) := by
    rw [Fintype.sum_prod_type, Finset.sum_comm]
    calc ∑ i, ∑ G, ‖E G i (L G (t i) (B' (t i) - B' (r i)))‖ ^ 2 ≤
        ∑ i, Cw * ‖B' (t i) - B' (r i)‖ ^ 2 := Finset.sum_le_sum fun i _ => hjoint2 i _
      _ = Cw * ∑ i, ‖B' (t i) - B' (r i)‖ ^ 2 := by rw [Finset.mul_sum]
      _ ≤ _ := mul_le_mul_of_nonneg_left hjump hCw
  -- combine
  have hsplit : ∀ k : γ × ι, E k.1 k.2 (L k.1 (t k.2) (B' (t k.2)) - L k.1 (r k.2) (B' (r k.2))) =
      R1 k (B' (r k.2)) + E k.1 k.2 (L k.1 (t k.2) (B' (t k.2) - B' (r k.2))) := by
    intro k
    simp only [R1, ContinuousLinearMap.comp_apply, sub_apply, map_sub]
    abel
  calc ∑ k : γ × ι, ‖E k.1 k.2 (L k.1 (t k.2) (B' (t k.2)) - L k.1 (r k.2) (B' (r k.2)))‖ ^ 2
      ≤ ∑ k : γ × ι, (2 * ‖R1 k (B' (r k.2))‖ ^ 2 +
          2 * ‖E k.1 k.2 (L k.1 (t k.2) (B' (t k.2) - B' (r k.2)))‖ ^ 2) := by
        apply Finset.sum_le_sum; intro k _
        rw [hsplit]
        have := norm_add_le (R1 k (B' (r k.2))) (E k.1 k.2 (L k.1 (t k.2) (B' (t k.2) -
          B' (r k.2))))
        have h0 := norm_nonneg (R1 k (B' (r k.2)) + E k.1 k.2 (L k.1 (t k.2) (B' (t k.2) -
          B' (r k.2))))
        nlinarith [sq_nonneg (‖R1 k (B' (r k.2))‖ -
          ‖E k.1 k.2 (L k.1 (t k.2) (B' (t k.2) - B' (r k.2)))‖)]
    _ = 2 * ∑ k : γ × ι, ‖R1 k (B' (r k.2))‖ ^ 2 +
        2 * ∑ k : γ × ι, ‖E k.1 k.2 (L k.1 (t k.2) (B' (t k.2) - B' (r k.2)))‖ ^ 2 := by
        rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    _ ≤ 2 * (Cw * G₀ * ‖F‖ ^ 2) + 2 * (Cw * ((m : ℝ) ^ 2 * G₀ * ‖F‖ ^ 2)) :=
        add_le_add (mul_le_mul_of_nonneg_left hterm1 (by norm_num))
          (mul_le_mul_of_nonneg_left hterm2 (by norm_num))
    _ = _ := by ring

end CertifiedVariation2

end Auto

