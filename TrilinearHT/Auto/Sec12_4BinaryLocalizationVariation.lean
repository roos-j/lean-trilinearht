/-- The filters of the cell `I` for slot catalogs `cat`. -/
noncomputable def filters (cat : Fin 4 → List (CatCol A.Vtx)) (I : ℤ × ℤ) :
    LeafFilters A.Vtx A.Grp where
  G := A.G
  I := I
  Mc := ap.Mc
  cat := cat
  P := ap.P
  hP := ap.hP
  rkC := fun m => ap.Lc - m + 1
  cm := ap.cmask I
  rkB := fun j => ap.Lc + j
