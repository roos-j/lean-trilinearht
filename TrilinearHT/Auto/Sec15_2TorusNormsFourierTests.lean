        ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))) + (3 + 2) ^ J *
        (2 * 4 * (2 * Real.pi * 4 * (2 * (4 + 3 * 4) * (kernelDerivBound κ 0 +
          ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))))) *
      min 1 (((Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)).inf'
        ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩ fun j => |t - j * q|) := by
  refine (unitKernel_bounds hr hw).decay_lines (by norm_num) J _ _ (fun j hj => ?_)
    (fun j hj u => ?_) q t
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hj
    rw [abs_of_nonneg (Nat.cast_nonneg _)]
    have := i.2
    have : (i : ℝ) ≤ 3 := by exact_mod_cast Nat.lt_succ_iff.mp this
    exact this
  · obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hj
    exact unitKernel_marginal hw i u

section CosetReduction
variable {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))

/-! ### Four-core tests: coset reduction (blueprint lines 2506-2529) -/

/-- Characters are integrable on the annihilator torus (a probability space). -/
theorem integrable_torusCharacter (n : Fin d → ℤ) :
    Integrable (fun x : torusAnnihilator (rationalIntegerIntersection V) => torusCharacter n x)
      (torusAnnihilatorHaar (rationalIntegerIntersection V)) := by
  refine Integrable.of_bound (C := 1) ((continuous_torusCharacter n).comp
    continuous_subtype_val).aestronglyMeasurable (Filter.Eventually.of_forall fun x => ?_)
  unfold torusCharacter
  rw [fourier_apply, Circle.norm_coe]

open Classical in
/-- Blueprint lines 2523-2526 (the retained coset coefficient is a Haar integral): for a
trigonometric polynomial `D(u, v) = Σ_p c_p χ_{p.1}(u) χ_{p.2}(v)` on `𝓗²`, its integral against
the conjugate character of `P₀` is the sum of the coefficients in the coset `P₀ + K_B²`. -/
theorem coset_sum_eq_haar (P : Finset ((Fin d → ℤ) × (Fin d → ℤ)))
    (c : (Fin d → ℤ) × (Fin d → ℤ) → ℂ) (P₀ : (Fin d → ℤ) × (Fin d → ℤ)) :
    (∫ u : torusAnnihilator (rationalIntegerIntersection V), ∫ v : torusAnnihilator
        (rationalIntegerIntersection V), ∑ p ∈ P, c p *
          (torusCharacter (p.1 - P₀.1) u * torusCharacter (p.2 - P₀.2) v)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) =
      ∑ p ∈ P, if p.1 - P₀.1 ∈ rationalIntegerIntersection V ∧
        p.2 - P₀.2 ∈ rationalIntegerIntersection V then c p else 0 := by
  classical
  set μ := torusAnnihilatorHaar (rationalIntegerIntersection V)
  have hin : ∀ u : torusAnnihilator (rationalIntegerIntersection V),
      ∫ v, ∑ p ∈ P, c p * (torusCharacter (p.1 - P₀.1) u * torusCharacter (p.2 - P₀.2) v) ∂μ =
        ∑ p ∈ P, c p * torusCharacter (p.1 - P₀.1) u *
          (if p.2 - P₀.2 ∈ rationalIntegerIntersection V then 1 else 0) := by
    intro u
    rw [integral_finsetSum _ fun p _ => ((integrable_torusCharacter V _).const_mul _).const_mul _]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [integral_const_mul, integral_const_mul, rationalAnnihilator_character_integral]
    ring
  simp_rw [hin]
  rw [integral_finsetSum _ fun p _ => by
    simp only [mul_assoc]
    exact ((integrable_torusCharacter V _).mul_const _).const_mul _]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [integral_mul_const, integral_const_mul, rationalAnnihilator_character_integral]
  split_ifs <;> simp_all

end CosetReduction

/-- Blueprint lines 2522-2527 (replace the Fourier values of the reference coset by the reference
value; other cosets are rapidly decreasing): if the values `K_p` are within `ε` of `K_{p₀}` on the
reference coset and at most `τ` elsewhere, then
`|Σ_p c_p K_p| ≤ |K_{p₀}| |Σ_{coset} c_p| + max(ε, τ) Σ_p |c_p|`. -/
theorem coset_reference_bound {ι : Type*} (P : Finset ι) (c Kv : ι → ℂ) (rel : ι → Prop)
    [DecidablePred rel] (p₀ : ι) {ε τ : ℝ}
    (hclose : ∀ p ∈ P, rel p → ‖Kv p - Kv p₀‖ ≤ ε) (hfar : ∀ p ∈ P, ¬ rel p → ‖Kv p‖ ≤ τ) :
    ‖∑ p ∈ P, c p * Kv p‖ ≤
      ‖Kv p₀‖ * ‖∑ p ∈ P.filter rel, c p‖ + max ε τ * ∑ p ∈ P, ‖c p‖ := by
  rw [← Finset.sum_filter_add_sum_filter_not P rel]
  have h1 : ∑ p ∈ P.filter rel, c p * Kv p =
      Kv p₀ * ∑ p ∈ P.filter rel, c p + ∑ p ∈ P.filter rel, c p * (Kv p - Kv p₀) := by
    rw [Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun p _ => by ring
  rw [h1]
  have hA : ‖∑ p ∈ P.filter rel, c p * (Kv p - Kv p₀)‖ ≤
      max ε τ * ∑ p ∈ P.filter rel, ‖c p‖ := by
    rw [Finset.mul_sum]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun p hp => ?_)
    obtain ⟨hpP, hr⟩ := Finset.mem_filter.mp hp
    rw [norm_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right ((hclose p hpP hr).trans (le_max_left _ _)) (norm_nonneg _)
  have hB : ‖∑ p ∈ P.filter (fun p => ¬ rel p), c p * Kv p‖ ≤
      max ε τ * ∑ p ∈ P.filter (fun p => ¬ rel p), ‖c p‖ := by
    rw [Finset.mul_sum]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun p hp => ?_)
    obtain ⟨hpP, hr⟩ := Finset.mem_filter.mp hp
    rw [norm_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right ((hfar p hpP hr).trans (le_max_right _ _)) (norm_nonneg _)
  have hsplit := Finset.sum_filter_add_sum_filter_not P rel (fun p => ‖c p‖)
  calc ‖Kv p₀ * ∑ p ∈ P.filter rel, c p + ∑ p ∈ P.filter rel, c p * (Kv p - Kv p₀) +
        ∑ p ∈ P.filter (fun p => ¬ rel p), c p * Kv p‖
      ≤ ‖Kv p₀ * ∑ p ∈ P.filter rel, c p‖ + ‖∑ p ∈ P.filter rel, c p * (Kv p - Kv p₀)‖ +
        ‖∑ p ∈ P.filter (fun p => ¬ rel p), c p * Kv p‖ := norm_add₃_le
    _ ≤ ‖Kv p₀‖ * ‖∑ p ∈ P.filter rel, c p‖ + max ε τ * ∑ p ∈ P.filter rel, ‖c p‖ +
        max ε τ * ∑ p ∈ P.filter (fun p => ¬ rel p), ‖c p‖ := by
        rw [norm_mul]; linarith
    _ = _ := by rw [← hsplit]; ring

namespace UnitKernelBounds
variable {w : ℝ × ℝ → ℂ} {R : ℝ} {A : ℕ → ℝ} (hw : UnitKernelBounds w R A)
