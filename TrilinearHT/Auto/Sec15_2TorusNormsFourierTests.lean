/-- Blueprint lines 2484-2486 ("for every character difference needed below, `r n·ξ` is tiny if
`n ∈ K_B` and huge otherwise"), in the form used by `eq:torus-size`: from the tiny/huge
dichotomy for all integer vectors of height at most `H` (thresholds `T⁻¹/L`, `T/L`), the
frequency differences of a finite family of height-`H` differences satisfy the alternatives with
`ε` once `2π T⁻¹/L ≤ ε` and `2/ε ≤ 2π T/L`. -/
theorem tiny_huge_of_dichotomy {d : ℕ} (V : Submodule ℤ (Fin d → ℤ)) (ϑ : Fin d → ℝ) {Hn : ℕ}
    {r T L ε : ℝ} (hr : 0 ≤ r)
    (hdich : ∀ n : Fin d → ℤ, vecHeight (fun i => (n i : ℚ)) ≤ Hn →
      (n ∈ V → r * |∑ i, (n i : ℝ) * (ϑ i / L)| ≤ T⁻¹ / L) ∧
      (n ∉ V → T / L ≤ r * |∑ i, (n i : ℝ) * (ϑ i / L)|))
    {ι : Type*} (F : Finset ι) (N : ι → Fin d → ℤ)
    (hgt : ∀ k ∈ F, ∀ k' ∈ F, vecHeight (fun i => ((N k - N k') i : ℚ)) ≤ Hn)
    (hε1 : 2 * Real.pi * (T⁻¹ / L) ≤ ε) (hε2 : 2 / ε ≤ 2 * Real.pi * (T / L)) :
    (∀ k ∈ F, ∀ k' ∈ F, N k - N k' ∈ V →
      |2 * Real.pi * r * ∑ i, (N k i : ℝ) * (ϑ i / L) -
        2 * Real.pi * r * ∑ i, (N k' i : ℝ) * (ϑ i / L)| ≤ ε) ∧
    (∀ k ∈ F, ∀ k' ∈ F, N k - N k' ∉ V →
      2 / ε ≤ |2 * Real.pi * r * ∑ i, (N k i : ℝ) * (ϑ i / L) -
        2 * Real.pi * r * ∑ i, (N k' i : ℝ) * (ϑ i / L)|) := by
  have e : ∀ k k', 2 * Real.pi * r * ∑ i, (N k i : ℝ) * (ϑ i / L) -
      2 * Real.pi * r * ∑ i, (N k' i : ℝ) * (ϑ i / L) =
      2 * Real.pi * (r * ∑ i, ((N k - N k') i : ℝ) * (ϑ i / L)) := fun k k' => by
    rw [← mul_sub, ← Finset.sum_sub_distrib, mul_assoc]
    congr 2
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [Pi.sub_apply, Int.cast_sub]; ring
  have hpi : 0 < 2 * Real.pi := by positivity
  refine ⟨fun k hk k' hk' hm => ?_, fun k hk k' hk' hm => ?_⟩
  · rw [e, abs_mul, abs_of_pos hpi, abs_mul, abs_of_nonneg hr]
    exact (mul_le_mul_of_nonneg_left ((hdich _ (hgt k hk k' hk')).1 hm) hpi.le).trans hε1
  · rw [e, abs_mul, abs_of_pos hpi, abs_mul, abs_of_nonneg hr]
    exact hε2.trans (mul_le_mul_of_nonneg_left ((hdich _ (hgt k hk k' hk')).2 hm) hpi.le)

/-- Blueprint lines 2512-2534 (`eq:four-tests`, the kernel factor of the four-core test): at the
reference frequencies `(q', t')` the kernel sample satisfies `|Ŵ_s(r q', r t')| ν^J ≤ C_J μ` with
`μ = min(1, min_{0 ≤ j ≤ 3} r|t' - j q'|)` and `ν = max(1, r|q'|, r|t'|)` (the four marginals
give zeros on the lines `t = j q`). -/
theorem fourK_mu_nu {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (J : ℕ) (x₀ A B : ℝ) :
    ‖fourK a₀ r w x₀ A B‖ * max 1 (max (r * |A|) (r * |B|)) ^ J ≤
      (2 * (2 * 4 * (2 * 4 * (kernelDerivBound κ 0 +
        ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))) + (3 + 2) ^ J *
        (2 * 4 * (2 * Real.pi * 4 * (2 * (4 + 3 * 4) * (kernelDerivBound κ 0 +
          ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))))) *
      min 1 (((Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)).inf'
        ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩
          fun j => r * |B - j * A|) := by
  have h := admissible_kernel_decay hr hw J (-(r * A)) (-(r * B))
  have e1 : |-(r * A)| = r * |A| := by rw [abs_neg, abs_mul, abs_of_pos hr]
  have e2 : |-(r * B)| = r * |B| := by rw [abs_neg, abs_mul, abs_of_pos hr]
  have e3 : (fun j : ℝ => |-(r * B) - j * -(r * A)|) = fun j => r * |B - j * A| := by
    funext j
    rw [show -(r * B) - j * -(r * A) = -(r * (B - j * A)) by ring, abs_neg, abs_mul,
      abs_of_pos hr]
  rw [e1, e2, e3] at h
  unfold fourK
  rwa [norm_mul, Circle.norm_coe, one_mul]

