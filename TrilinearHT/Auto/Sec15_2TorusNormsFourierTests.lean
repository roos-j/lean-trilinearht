open Classical in
/-- Blueprint lines 2487-2493 (`eq:torus-size`, pointwise comparison along the cell line): the
torus input `g_j = (truncated cutoff) × Σ_k c_k χ_{n_k}` at `ξ (y - x*)` is at most the physical
input `|f_j(y)|` plus `(η + τ_c) Σ|c|`, when `f_j` is the cutoff times phases times the polynomial
up to `η Σ|c|` and the truncated cutoff is within `τ_c` of the true cutoff. -/
theorem coreG_line_le {d : ℕ} (QL Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) (cc : Fin 4 → (Fin d → ℤ) → ℂ) (j : Fin 4)
    (u : StandardTorus d) (f cut ph gam : ℂ) {η τ : ℝ}
    (hph : ‖ph‖ = 1) (hgam : ‖gam‖ = 1)
    (hfa : ‖f - cut * ph * (gam * ∑ k ∈ F j, c j k * torusCharacter (n j k) u)‖ ≤
      η * ∑ k ∈ F j, ‖c j k‖)
    (hline : ‖∑ v ∈ frequencyBox d Bx, cc j v * torusCharacter ((QL : ℤ) • v) u - cut‖ ≤ τ) :
    ‖coreG QL Bx F c n cc j u‖ ≤ ‖f‖ + (η + τ) * ∑ k ∈ F j, ‖c j k‖ := by
  set P := ∑ k ∈ F j, c j k * torusCharacter (n j k) u
  set Tc := ∑ v ∈ frequencyBox d Bx, cc j v * torusCharacter ((QL : ℤ) • v) u
  have hP : ‖P‖ ≤ ∑ k ∈ F j, ‖c j k‖ := by
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_)
    rw [norm_mul, norm_torusCharacter, mul_one]
  have hcP : ‖cut * ph * (gam * P)‖ = ‖cut‖ * ‖P‖ := by
    rw [norm_mul, norm_mul, norm_mul, hph, hgam]; ring
  have h1 : ‖cut‖ * ‖P‖ ≤ ‖f‖ + η * ∑ k ∈ F j, ‖c j k‖ := by
    rw [← hcP]
    calc ‖cut * ph * (gam * P)‖ ≤ ‖f‖ + ‖f - cut * ph * (gam * P)‖ := by
          have := norm_sub_le f (f - cut * ph * (gam * P))
          rwa [sub_sub_cancel] at this
      _ ≤ _ := by linarith
  have hT : ‖Tc‖ ≤ ‖cut‖ + τ := by
    have := norm_sub_le Tc cut
    calc ‖Tc‖ = ‖cut + (Tc - cut)‖ := by rw [add_sub_cancel]
      _ ≤ ‖cut‖ + ‖Tc - cut‖ := norm_add_le _ _
      _ ≤ ‖cut‖ + τ := by linarith
  have hτ : 0 ≤ τ := le_trans (norm_nonneg _) hline
  rw [coreG_factor, norm_mul]
  calc ‖Tc‖ * ‖P‖ ≤ (‖cut‖ + τ) * ‖P‖ := mul_le_mul_of_nonneg_right hT (norm_nonneg _)
    _ = ‖cut‖ * ‖P‖ + τ * ‖P‖ := by ring
    _ ≤ (‖f‖ + η * ∑ k ∈ F j, ‖c j k‖) + τ * ∑ k ∈ F j, ‖c j k‖ :=
        add_le_add h1 (mul_le_mul_of_nonneg_left hP hτ)
    _ = ‖f‖ + (η + τ) * ∑ k ∈ F j, ‖c j k‖ := by ring

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)

/-- Blueprint lines 2489-2491 (edges on a subcell): a gap edge between two modes on a subcell `I`
of `J` (threshold `θ_I`) is a gap edge on `J` with threshold `θ_I + 2|λ_m - λ_{m'}| |J|`, since
the slopes are affine with these curvatures. -/
theorem gapEdge_transfer {ϑ : Fin Ms.zc.dim → ℝ} {I J : ℤ × ℤ}
    (hIJ : dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd J.1 J.2) {θI θJ : ℝ} {h : ℕ}
    {m m' : Ms.Md}
    (he : S.gapEdge Ms.slope ϑ (dyadicGridLeft Gd I.1 I.2) (dyadicGridLength Gd I.1) θI h m m')
    (hθ : θI + 2 * |Ms.lamOf m - Ms.lamOf m'| * dyadicGridLength Gd J.1 ≤ θJ) :
    S.gapEdge Ms.slope ϑ (dyadicGridLeft Gd J.1 J.2) (dyadicGridLength Gd J.1) θJ h m m' := by
  obtain ⟨n, hn, hx⟩ := he
  refine ⟨n, hn, fun x hxJ => ?_⟩
  have hI0 : dyadicGridLeft Gd I.1 I.2 ∈ Set.Icc (dyadicGridLeft Gd I.1 I.2)
      (dyadicGridLeft Gd I.1 I.2 + dyadicGridLength Gd I.1) :=
    ⟨le_rfl, by linarith [dyadicGridLength_pos Gd I.1]⟩
  have h0 := hx _ hI0
  have hIJ' := Icc_subset_of_cell_subset hIJ hI0
  have hd : |x - dyadicGridLeft Gd I.1 I.2| ≤ dyadicGridLength Gd J.1 :=
    abs_sub_le_of_mem_cell hIJ' hxJ
  have e : Ms.slope m x - Ms.slope m' x + (∑ i, (n i : ℝ) * ϑ i) / ModeSchedule.Lh h =
      (Ms.slope m (dyadicGridLeft Gd I.1 I.2) - Ms.slope m' (dyadicGridLeft Gd I.1 I.2) +
        (∑ i, (n i : ℝ) * ϑ i) / ModeSchedule.Lh h) +
      2 * (Ms.lamOf m - Ms.lamOf m') * (x - dyadicGridLeft Gd I.1 I.2) := by
    simp only [slope]; ring
  rw [e]
  calc _ ≤ |Ms.slope m (dyadicGridLeft Gd I.1 I.2) - Ms.slope m' (dyadicGridLeft Gd I.1 I.2) +
        (∑ i, (n i : ℝ) * ϑ i) / ModeSchedule.Lh h| +
        |2 * (Ms.lamOf m - Ms.lamOf m') * (x - dyadicGridLeft Gd I.1 I.2)| := abs_add_le _ _
    _ ≤ θI + 2 * |Ms.lamOf m - Ms.lamOf m'| * dyadicGridLength Gd J.1 := by
        refine add_le_add h0 ?_
        rw [abs_mul, abs_mul, abs_two]
        exact mul_le_mul_of_nonneg_left hd (by positivity)
    _ ≤ θJ := hθ

end ModeSystem

