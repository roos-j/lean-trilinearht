variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

open Classical in
/-- Blueprint lines 2512-2514 and 2566-2569 on an attempt leaf cell (four cores, no reference):
for the torus form `(ρ', n)` of the selected modes (as exported by `four_core_test_attempt`), if
every expansion frequency has `ν ≥ U₀`, the cell form of the grouped subtotals is at most
`(2K(4η + E_g) + C₁ U₀⁻¹ |B'| |B|⁴) Π_j Σ_{m ∈ F_j} |α_m|` (`four_core_noref`). -/
theorem four_core_noref_attempt (hK1 : 1 ≤ D.S.K) {I : ℤ × ℤ} (hI : I ∈ A.cells) (G : A.Grp)
    (z : ChartTag) {δ Bc Λ : ℝ} (h : ℕ) (a : ∀ j, (D.Ms j G).alive (D.decCell I))
    (F : ∀ j, Finset ((D.Ms j G).alive (D.decCell I))) {xs : ℝ}
    (hd : 1 ≤ z.dim) {δ'' : ℝ} (hδ : 0 < δ) (hδ'' : 0 < δ'') (hQ0 : 0 < D.S.Q0)
    (hQ : ∀ a b, ∃ k : ℤ, (D.S.Q0 : ℝ) * (z.C a b : ℝ) = k) {Cm : ℝ} (hCm0 : 0 ≤ Cm)
    (hCm : ∀ a b, |(z.C a b : ℝ)| ≤ Cm) (Kt : ℕ) (ρ' : Fin 4 → Fin z.dim → ℝ)
    (hρ' : ∀ j k, ρ' j k ∈ Set.Icc (0 : ℝ) 1)
    (n : ∀ j, (D.Ms j G).alive (D.decCell I) → Fin z.dim → ℤ)
    (hη0 : 0 ≤ 2 * Real.pi * (Bc * D.S.Ξ * (2 : ℝ)⁻¹ ^ (2 * D.S.K) + Λ * (2 : ℝ)⁻¹ ^ (8 * D.S.K)))
    (hfa : ∀ j, ∀ y ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
          (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1),
        ‖∑ m ∈ F j, D.c j G (D.blockOf I.1) (D.preCell I) m.1 * (D.Ms j G).wave m.1 y -
          ((centerCut z δ (ρ' j) y : ℂ) * (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) *
            centerPhase z (ρ' j) y) : ℂ)) *
          ((Real.fourierChar ((D.Ms j G).slope (a j).1 xs * (y - xs)) : ℂ) *
            ∑ m ∈ F j, D.selC j G I xs m *
              torusCharacter (n j m) (torusMk fun i => D.xiH z h i * (y - xs)))‖ ≤
          2 * Real.pi * (Bc * D.S.Ξ * (2 : ℝ)⁻¹ ^ (2 * D.S.K) + Λ * (2 : ℝ)⁻¹ ^ (8 * D.S.K)) *
            ∑ m ∈ F j, ‖D.selC j G I xs m‖)
    {U₀ : ℝ} (hU₀ : 0 < U₀)
    (hnoref : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
        (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
      U₀ ≤ fourNu (dyadicGridLength A.G I.1)
        (D.refQ G I xs a + ∑ i, (expP1 (6 ^ h) (D.S.Q0 * 6 ^ h) n x i : ℝ) * D.xiH z h i)
        (D.refT G I xs a + ∑ i, (expP2 (6 ^ h) (D.S.Q0 * 6 ^ h) n x i : ℝ) * D.xiH z h i)) :
    ‖ap.Λc I (fun j => D.compSub j G I (D.preCell I) ((F j).image Subtype.val))‖ ≤
      (2 * localKernelSupBound κ' * (4 * (2 * Real.pi * (Bc * D.S.Ξ * (2 : ℝ)⁻¹ ^ (2 * D.S.K) +
          Λ * (2 : ℝ)⁻¹ ^ (8 * D.S.K))) + (8 * z.dim * δ'' * profR δ 1 +
          4 * (1 + cutTail z.dim δ Kt) ^ 3 * cutTail z.dim δ Kt +
          (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' D.S.Q0 Cm Kt)) +
        fourKC κ' 1 * U₀⁻¹ * (frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1))).card *
          (frequencyBox z.dim (2 ^ (Kt + 1))).card ^ 4) *
        ∏ j, ∑ m ∈ F j, ‖D.c j G (D.blockOf I.1) (D.preCell I) m.1‖ := by
  obtain ⟨hb, -⟩ := D.blockOf_bounds hK1 I.1
  have hr := dyadicGridLength_pos A.G I.1
  have hw := A.adm I hI
  have hIJ : ∀ _j : Fin 4, dyadicGridCell A.G I.1 I.2 ⊆
      dyadicGridCell A.G (D.preCell I).1 (D.preCell I).2 := fun _ =>
    subset_ancAt A.G I (show D.blockOf I.1 - 2 * D.S.K ≤ I.1 by omega)
  have himg : ∀ j y, ∑ m ∈ (F j).image Subtype.val,
      D.c j G (D.blockOf I.1) (D.preCell I) m * (D.Ms j G).wave m y =
      ∑ m ∈ F j, D.c j G (D.blockOf I.1) (D.preCell I) m.1 * (D.Ms j G).wave m.1 y := fun j y =>
    Finset.sum_image fun x _ y _ hxy => Subtype.val_injective hxy
  have hbd : ∀ j y, ‖∑ m ∈ F j, D.c j G (D.blockOf I.1) (D.preCell I) m.1 *
      (D.Ms j G).wave m.1 y‖ ≤ ∑ m ∈ F j, ‖D.selC j G I xs m‖ := fun j y => by
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => ?_)
    rw [D.norm_selC, norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) ((D.Ms j G).wave_norm_le m.1 y)
  rw [D.Λc_compSub_eq hI G (fun _ => D.preCell I) hIJ]
  simp_rw [himg]
  rw [show dyadicGridCell A.G I.1 I.2 = Set.Ico (dyadicGridLeft A.G I.1 I.2)
    (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1) from rfl,
    form_indicator_cell hr hw]
  have hfi := form_integrable_of_bounded hr hw (fun j y => ∑ m ∈ F j,
      D.c j G (D.blockOf I.1) (D.preCell I) m.1 * (D.Ms j G).wave m.1 y)
    (fun j => Finset.measurable_sum _ fun m _ =>
      measurable_const.mul ((D.Ms j G).wave_measurable m.1)) _ (fun j y _ => hbd j y)
  have key := four_core_noref (L := 6 ^ h) (Q0 := D.S.Q0) hr hw z hd hδ hδ'' ρ' hρ' hQ0 hQ
    hCm0 hCm (pow_pos (by norm_num) h) Kt (xs := xs) (fun j => (D.Ms j G).slope (a j).1 xs) F
    (fun j k => D.selC j G I xs k) n (fun j y => ∑ m ∈ F j,
      D.c j G (D.blockOf I.1) (D.preCell I) m.1 * (D.Ms j G).wave m.1 y) hfi hη0 hfa
    (fun j y _ => hbd j y) hU₀ hnoref
  have hsel : ∏ j, ∑ k ∈ F j, ‖D.selC j G I xs k‖ =
      ∏ j, ∑ m ∈ F j, ‖D.c j G (D.blockOf I.1) (D.preCell I) m.1‖ :=
    Finset.prod_congr rfl fun j _ => Finset.sum_congr rfl fun m _ => D.norm_selC j G I xs m
  rw [hsel] at key
  exact key

end LeafSplit

