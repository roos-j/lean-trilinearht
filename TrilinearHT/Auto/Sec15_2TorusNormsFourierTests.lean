    (hsmall : (3 * Hh ^ 2 : ℝ) ^ d * (d.factorial * Hh ^ (d ^ 2 + d)) * ε < Λ)
    {r : ℝ} (hr : 0 < r) {Q0 L : ℕ} (hQL : (0 : ℝ) < Q0 * L) (Bx : ℕ) (γ : Fin 4 → ℝ)
    {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j)) (n : ∀ j, ι j → Fin d → ℤ) {Nb : ℝ}
    (hNb0 : 0 ≤ Nb) (hn : ∀ j, ∀ k ∈ F j, ∀ i, |(n j k i : ℝ)| ≤ Nb)
    (p₀ : (Fin d → ℤ) × (Fin d → ℤ)) {Bp : ℝ} (hp1 : ∀ i, |(p₀.1 i : ℝ)| ≤ Bp)
    (hp2 : ∀ i, |(p₀.2 i : ℝ)| ≤ Bp)
    (hHb : L * Bx + 12 * ((Q0 * L : ℕ) * Bx + Nb) + Bp ≤ Hh) :
    ∀ x ∈ frequencyBox (d + d) Bx ×ˢ Fintype.piFinset (fun j => frequencyBox d Bx ×ˢ F j),
