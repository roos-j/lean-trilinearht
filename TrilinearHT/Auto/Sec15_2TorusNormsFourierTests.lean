/-- Blueprint lines 2487-2490 (cell averages against Haar norms): for a trigonometric sum
`g(t) = Σ_k c_k e^{i φ_k t}` on the normalized cell `[0,1]` whose frequency differences are tiny
(`|φ_k - φ_{k'}| ≤ ε`) on the related pairs and huge (`|φ_k - φ_{k'}| ≥ 2/ε`) otherwise, the cell
average of `|g|²` differs from the coset sum `Σ_{k ~ k'} c_k c̄_{k'}` (its Haar norm on the
annihilator torus) by at most `ε (Σ_k |c_k|)²`. -/
theorem cell_average_close {ι : Type*} (F : Finset ι) (c : ι → ℂ) (φ : ι → ℝ)
    (rel : ι → ι → Prop) {ε : ℝ} (hε : 0 < ε)
    (htiny : ∀ k ∈ F, ∀ k' ∈ F, rel k k' → |φ k - φ k'| ≤ ε)
    (hhuge : ∀ k ∈ F, ∀ k' ∈ F, ¬ rel k k' → 2 / ε ≤ |φ k - φ k'|) :
    ‖(∫ t in (0 : ℝ)..1, ∑ k ∈ F, ∑ k' ∈ F, c k * starRingEnd ℂ (c k') *
        Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))) -
      ∑ k ∈ F, ∑ k' ∈ F, (if rel k k' then c k * starRingEnd ℂ (c k') else 0)‖ ≤
      ε * (∑ k ∈ F, ‖c k‖) ^ 2 := by
  have hint : ∀ k k', IntervalIntegrable (fun t : ℝ => c k * starRingEnd ℂ (c k') *
      Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))) volume 0 1 := fun k k' =>
    (by fun_prop : Continuous fun t : ℝ => c k * starRingEnd ℂ (c k') *
      Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))).intervalIntegrable _ _
  have hI : (∫ t in (0 : ℝ)..1, ∑ k ∈ F, ∑ k' ∈ F, c k * starRingEnd ℂ (c k') *
      Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))) = ∑ k ∈ F, ∑ k' ∈ F,
        ∫ t in (0 : ℝ)..1, c k * starRingEnd ℂ (c k') *
          Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ)) := by
    rw [intervalIntegral.integral_finsetSum fun k _ =>
      (continuous_finsetSum _ fun k' _ => (by fun_prop : Continuous fun t : ℝ =>
        c k * starRingEnd ℂ (c k') * Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ)))
        ).intervalIntegrable _ _]
    exact Finset.sum_congr rfl fun k _ =>
      intervalIntegral.integral_finsetSum fun k' _ => hint k k'
  rw [hI]
  rw [← Finset.sum_sub_distrib]
  simp_rw [← Finset.sum_sub_distrib]
  have hterm : ∀ k ∈ F, ∀ k' ∈ F,
      ‖(∫ t in (0 : ℝ)..1, c k * starRingEnd ℂ (c k') *
        Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))) -
        (if rel k k' then c k * starRingEnd ℂ (c k') else 0)‖ ≤ ε * (‖c k‖ * ‖c k'‖) := by
    intro k hk k' hk'
    rw [intervalIntegral.integral_const_mul]
    have hcc : ‖c k * starRingEnd ℂ (c k')‖ = ‖c k‖ * ‖c k'‖ := by
      rw [norm_mul, RCLike.norm_conj]
    split_ifs with hr
    · rw [← mul_sub_one, norm_mul, hcc, mul_comm]
      refine mul_le_mul_of_nonneg_right ((character_average_tiny _).trans (htiny k hk k' hk' hr))
        (by positivity)
    · rw [sub_zero, norm_mul, hcc, mul_comm]
      refine mul_le_mul_of_nonneg_right ?_ (by positivity)
      have hh := hhuge k hk k' hk' hr
      have hne : φ k - φ k' ≠ 0 := by
        intro h0; rw [h0, abs_zero] at hh; have : 0 < 2 / ε := by positivity
        linarith
      refine (character_average_huge hne).trans ?_
      rw [div_le_iff₀ (abs_pos.mpr hne)]
      rw [div_le_iff₀ hε] at hh
      linarith
  calc ‖∑ k ∈ F, ∑ k' ∈ F, ((∫ t in (0 : ℝ)..1, c k * starRingEnd ℂ (c k') *
        Complex.exp (Complex.I * ((φ k - φ k') * t : ℝ))) -
        (if rel k k' then c k * starRingEnd ℂ (c k') else 0))‖ ≤
      ∑ k ∈ F, ∑ k' ∈ F, ε * (‖c k‖ * ‖c k'‖) :=
        (norm_sum_le _ _).trans (Finset.sum_le_sum fun k hk =>
          (norm_sum_le _ _).trans (Finset.sum_le_sum fun k' hk' => hterm k hk k' hk'))
    _ = ε * (∑ k ∈ F, ‖c k‖) ^ 2 := by
        rw [sq, Finset.sum_mul_sum, Finset.mul_sum]
        simp_rw [Finset.mul_sum]

theorem torusCharacter_sub {d : ℕ} (n m : Fin d → ℤ) (x : StandardTorus d) :
    torusCharacter (n - m) x = torusCharacter n x * starRingEnd ℂ (torusCharacter m x) := by
  have hp : torusPairing (n - m) x = torusPairing n x + -torusPairing m x := by
    rw [torusPairing_eq_sum, torusPairing_eq_sum, torusPairing_eq_sum, ← Finset.sum_neg_distrib,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Pi.sub_apply, sub_smul, sub_eq_add_neg]
  unfold torusCharacter
  rw [hp, fourier_apply, fourier_apply, fourier_apply, one_smul, one_smul, one_smul,
    AddCircle.toCircle_add, AddCircle.toCircle_neg, Circle.coe_mul, Circle.coe_inv_eq_conj]

open Classical in
/-- Blueprint lines 2487-2490 (Haar side of `eq:torus-size`): on the annihilator torus of a
rational space, `∫ |Σ_k c_k χ_k|² = Σ_{k - k' ∈ K_B} c_k c̄_{k'}`. -/
theorem haar_norm_sq_eq {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) {ι : Type*} (F : Finset ι)
    (c : ι → ℂ) (n : ι → Fin d → ℤ) :
    (∫ x : torusAnnihilator (rationalIntegerIntersection V),
        ∑ k ∈ F, ∑ k' ∈ F, c k * starRingEnd ℂ (c k') *
          (torusCharacter (n k) x * starRingEnd ℂ (torusCharacter (n k') x))
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) =
      ∑ k ∈ F, ∑ k' ∈ F,
        (if n k - n k' ∈ rationalIntegerIntersection V then c k * starRingEnd ℂ (c k') else 0) := by
  have hint : ∀ k k', Integrable (fun x : torusAnnihilator (rationalIntegerIntersection V) =>
      c k * starRingEnd ℂ (c k') * (torusCharacter (n k) x *
        starRingEnd ℂ (torusCharacter (n k') x)))
      (torusAnnihilatorHaar (rationalIntegerIntersection V)) := by
    intro k k'
    refine Integrable.const_mul ?_ _
    refine (integrable_const (1 : ℝ)).mono' ?_ (Filter.Eventually.of_forall fun x => ?_)
    · exact ((continuous_torusCharacter (n k)).comp continuous_subtype_val).mul
        ((Complex.continuous_conj.comp (continuous_torusCharacter (n k'))).comp
          continuous_subtype_val) |>.aestronglyMeasurable
    · simp only [torusCharacter, norm_mul, RCLike.norm_conj, Circle.norm_coe, mul_one,
        fourier_apply]
      exact le_refl _
  rw [integral_finsetSum _ fun k _ => integrable_finsetSum _ fun k' _ => hint k k']
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [integral_finsetSum _ fun k' _ => hint k k']
  refine Finset.sum_congr rfl fun k' _ => ?_
  rw [integral_const_mul]
  simp_rw [← torusCharacter_sub]
  rw [rationalAnnihilator_character_integral V (n k - n k')]
  split_ifs <;> simp

/-- The reference data of a tested four-core tuple at scale `R`: box shifts `n, m` with
`q' = Σ x_r + 36 n·ζ`, `t' = Σ r x_r + 36 m·ζ`, `|q'|, |t'| ≤ ν R` and
`|t' - j q'| ≥ μ R` for every line `j` (blueprint `eq:four-tests`). -/
def FourRef {d : ℕ} (ζ : Fin d → ℝ) (B μ ν R : ℝ) (x : Fin 4 → ℝ) : Prop :=
  ∃ n m : Fin d → ℤ, (∀ p, |(n p : ℝ)| ≤ B) ∧ (∀ p, |(m p : ℝ)| ≤ B) ∧
    |∑ r, x r + 36 * ∑ p, (n p : ℝ) * ζ p| ≤ ν * R ∧
    |∑ r : Fin 4, ((r : ℕ) : ℝ) * x r + 36 * ∑ p, (m p : ℝ) * ζ p| ≤ ν * R ∧
    ∀ j : Fin 4, μ * R ≤ |(∑ r : Fin 4, ((r : ℕ) : ℝ) * x r + 36 * ∑ p, (m p : ℝ) * ζ p) -
      ((j : ℕ) : ℝ) * (∑ r, x r + 36 * ∑ p, (n p : ℝ) * ζ p)|

/-- The side window of a tested tuple (blueprint line 2564, `b_Λ`): the integer frequencies `k`
with `|k - r(Q + 36 n·ζ)| ≤ 2Λ` for some box shift `|n| ≤ B`, where `Q = Σ x_r`. The window
energies `sideWinE` pair the side with `e(+k y / r)`, so the index `k` here is `-k` in the
blueprint's `|k + r(Q + n·ξ)| ≤ 2Λ`. -/
noncomputable def sideWindow {d : ℕ} (ζ : Fin d → ℝ) (r Λ B : ℝ) (x : Fin 4 → ℝ) : Finset ℤ :=
  (Fintype.piFinset fun _ : Fin d => Finset.Icc (-⌊B⌋) ⌊B⌋).biUnion fun n =>
    Finset.Icc ⌈r * (∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p) - 2 * Λ⌉
      ⌊r * (∑ i, x i + 36 * ∑ p, (n p : ℝ) * ζ p) + 2 * Λ⌋

