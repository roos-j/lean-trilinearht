          (rationalIntegerIntersection V) => ∑ p ∈ frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j,
            (cc j p.1 * c j p.2) * torusCharacter (((Q0 * L : ℕ) : ℤ) • p.1 + n j p.2) u) 2
