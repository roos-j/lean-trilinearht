  have ha : ∀ i, a i ^ 2 = 2 / r * ‖∑ m ∈ Dc i, α m • Ms.cellMode I m‖ ^ 2 := fun i => by
    simp only [a]; rw [mul_pow, Real.sq_sqrt (by positivity)]
