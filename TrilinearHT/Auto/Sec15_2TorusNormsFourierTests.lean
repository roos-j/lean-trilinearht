    (hp2 : ∀ i, |(p₀.2 i : ℝ)| ≤ Bp) {Hh : ℕ} (hH : 1 ≤ Hh)
    (hHb : L * Bx + 12 * (QL * Bx + Nb) + Bp ≤ Hh)
    (x : (Fin (d + d) → ℤ) × ∀ j, (Fin d → ℤ) × ι j)
    (hx : x ∈ frequencyBox (d + d) Bx ×ˢ Fintype.piFinset (fun j => frequencyBox d Bx ×ˢ F j)) :
    vecHeight (fun i => ((expP1 L QL n x - p₀.1) i : ℚ)) ≤ Hh ∧
      vecHeight (fun i => ((expP2 L QL n x - p₀.2) i : ℚ)) ≤ Hh := by
