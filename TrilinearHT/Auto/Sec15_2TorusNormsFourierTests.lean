      (rationalIntegerIntersection V) => coreG (Q0 * L) (2 ^ (Kt + 1)) F c n cc j u) 2
      (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      ∏ j : Fin 4, ((1 + cutTail z.dim δ Kt) * inputNorm V F c n j) :=
