/-- The anchored three-core test quantity `T_l = Σ_{j ≠ l} (j - l) γ*_j` (blueprint line 2536)
for the representatives `a` of the core roles (`γ_l = 0`). -/
noncomputable def refT3 (D : ap.LeafSplit) (G : A.Grp) (I : ℤ × ℤ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ) : ℝ :=
  ∑ j : Fin 4, ((j : ℕ) : ℝ) * D.refγ3 G I xs l a j - ((l : ℕ) : ℝ) * ∑ j, D.refγ3 G I xs l a j

