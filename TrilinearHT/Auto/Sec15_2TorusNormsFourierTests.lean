theorem norm_torusCharacter {d : ℕ} (n : Fin d → ℤ) (x : StandardTorus d) :
    ‖torusCharacter n x‖ = 1 := by
  unfold torusCharacter
  rw [fourier_apply, Circle.norm_coe]

/-- The anchored side function `e(-c_l p_ρ(y)) f_l(y)` of the three-core reduction. -/
noncomputable def sideSd (z : ChartTag) (ρ : Fin z.dim → ℝ) (l : Fin 4) (g : ℝ → ℂ) (y : ℝ) :
    ℂ :=
  (Real.fourierChar (-(((slotCoeff l : ℤ) : ℝ) * centerPhase z ρ y)) : ℂ) * g y

/-- The truncated torus input `Σ_{(v, k) ∈ B × F_j} cc_v c_k χ_{QL v + n_k}` of a role. -/
noncomputable def coreG {d : ℕ} (QL Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) (cc : Fin 4 → (Fin d → ℤ) → ℂ) (j : Fin 4)
    (u : StandardTorus d) : ℂ :=
  ∑ p ∈ frequencyBox d Bx ×ˢ F j, (cc j p.1 * c j p.2) *
    torusCharacter ((QL : ℤ) • p.1 + n j p.2) u

/-- The truncated torus multiplier `Σ_q cm_q χ_{L q'}(u) χ_{L q''}(v)`. -/
noncomputable def coreR {d : ℕ} (L Bx : ℕ) (cm : (Fin (d + d) → ℤ) → ℂ)
    (u v : StandardTorus d) : ℂ :=
  ∑ q ∈ frequencyBox (d + d) Bx, cm q *
    (torusCharacter ((L : ℤ) • fun a => q (Fin.castAdd d a)) u *
      torusCharacter ((L : ℤ) • fun a => q (Fin.natAdd d a)) v)

/-- The re-anchored multiplier `R(u - l v, v) g_l(u)` on the annihilator of `K ∩ ℤ^d`. -/
noncomputable def coreRA {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) (L QL Bx : ℕ)
    {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j)) (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ)
    (cc : Fin 4 → (Fin d → ℤ) → ℂ) (cm : (Fin (d + d) → ℤ) → ℂ) (l : Fin 4)
    (uv : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V)) : ℂ :=
  coreR L Bx cm ((uv.1 : StandardTorus d) - ((l : ℕ) : ℤ) • (uv.2 : StandardTorus d)) uv.2 *
    coreG QL Bx F c n cc l uv.1

open Classical in
/-- Blueprint lines 2537-2560 (the three-core principal estimate at a fixed side offset): after
re-anchoring the side role `l` (`offset_form_anchored`), the form with side cutoff `ζ_ρ` is
bounded by `three_core_anchored_bound` applied to the truncated cell expansion of the three core
inputs and the side gauge (`three_core_Fc_approx`, `reanchor_physical`, `reanchor_torus`). -/
theorem three_core_principal {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (z : ChartTag) (hd : 1 ≤ z.dim) {δ δ'' : ℝ}
    (hδ : 0 < δ) (hδ'' : 0 < δ'') (ρ : Fin 4 → Fin z.dim → ℝ)
    (hρ : ∀ j a, ρ j a ∈ Set.Icc (0 : ℝ) 1) {Q0 : ℕ} (hQ0 : 0 < Q0)
    (hQ : ∀ a b, ∃ k : ℤ, (Q0 : ℝ) * (z.C a b : ℝ) = k) {Cm : ℝ} (hCm0 : 0 ≤ Cm)
    (hCm : ∀ a b, |(z.C a b : ℝ)| ≤ Cm) {L : ℕ} (hL : 0 < L) (Kt : ℕ) {xs : ℝ}
    (hxs : xs ∈ Set.Icc a₀ (a₀ + r)) (l : Fin 4) (γ : Fin 4 → ℝ) (hγl : γ l = 0)
    {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j)) (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin z.dim → ℤ)
    {k₀ : ι l} (hFl : F l = {k₀}) (hcl : c l k₀ = 1) (hnl : n l k₀ = 0) (f : Fin 4 → ℝ → ℂ)
    (hfm : AEStronglyMeasurable (sideSd z (ρ l) l (f l)) volume)
    (hfl : IntegrableOn (sideSd z (ρ l) l (f l)) (Set.Icc a₀ (a₀ + r)))
    (hfi : Integrable (fun zz : ℝ × ℝ => w zz * ∏ j, Function.update f l
      (fun y => (centerCut z δ (ρ l) y : ℂ) * f l y) j (realProgressionCoordinate j zz)))
    {η : ℝ} (hη : 0 ≤ η)
    (hfa : ∀ j, j ≠ l → ∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f j y - ((centerCut z δ (ρ j) y : ℂ) *
      (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) * centerPhase z (ρ j) y) : ℂ)) *
        ((Real.fourierChar (γ j * (y - xs)) : ℂ) * ∑ k ∈ F j, c j k *
          torusCharacter (n j k) (torusMk fun i => z.θ i / (Q0 * L) * (y - xs)))‖ ≤
            η * ∑ k ∈ F j, ‖c j k‖)
    (hfb : ∀ j, j ≠ l → ∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f j y‖ ≤ ∑ k ∈ F j, ‖c j k‖)
    (V : Submodule ℚ (Fin z.dim → ℚ)) {W : ℝ} (hW : 0 ≤ W)
    (hRb : ∀ (cm : (Fin (z.dim + z.dim) → ℤ) → ℂ), (∀ v, ‖cm v‖ ≤ 1) →
      ∀ u v : StandardTorus z.dim, ‖coreR L (2 ^ (Kt + 1)) cm u v‖ ≤ W)
    (m₀ : Fin z.dim → ℤ) (N : Finset (Fin z.dim → ℤ))
    (hN : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection V)
    (αN : (Fin z.dim → ℤ) → ℝ) (β₀ : ℝ)
    (hsep : ∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → 1 ≤ |-(r * αN n) - -(r * αN n')|)
    (nref : ((Fin (z.dim + z.dim) → ℤ) × ∀ j, (Fin z.dim → ℤ) × ι j) → Fin z.dim → ℤ)
    {ε₁ H : ℝ} (hε₁ : 0 ≤ ε₁) (hH : 4 ≤ H)
    (hnear : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
        (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
      expP2 L (Q0 * L) n x - ((l : ℕ) : ℤ) • expP1 L (Q0 * L) n x - m₀ ∈
        rationalIntegerIntersection V →
      nref x ∈ N ∧ expP1 L (Q0 * L) n x - nref x ∈ rationalIntegerIntersection V ∧
        |r * (∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L))) -
          r * αN (nref x)| ≤ ε₁ ∧
        |r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
            (z.θ i / (Q0 * L))) - ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i,
              (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L)))) - r * β₀| ≤ ε₁)
