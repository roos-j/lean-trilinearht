    have hcs := sq_sum_le_card_mul_sum_sq (s := s) (f := fun i => ∑ m ∈ Dc i, ‖α m‖)
    simp only [b, mul_pow, Real.sq_sqrt (Nat.cast_nonneg _), ← Finset.mul_sum]
    rw [hsum]
