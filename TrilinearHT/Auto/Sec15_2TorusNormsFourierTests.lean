          ∑ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
            (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j), ∏ j, ‖c j (x.2 j).2‖) := by
