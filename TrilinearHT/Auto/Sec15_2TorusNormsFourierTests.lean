open Classical in
/-- Blueprint lines 2504-2509 and 2718-2723 (the tested tuple as a labelled tuple): if a tuple of
representatives `a` passes the four-core test at the path point `x*` (torus height `h'`, full box
`B_f`), its labels `x_j = ω_{a_j}(x*)` satisfy `FourRef` at the scale `R = |I|⁻¹` with the
separation vector `ζ` (`36 ζ = ξ`), the box `B_f` and the dyadic bin values `μ = 2^{⌊log₂ μ⌋}`,
`ν = 2^{⌊log₂ ν⌋ + 1}` of its test quantities (`eq:triple-test` for four cores). -/
theorem passes_fourRef {h' : ℕ} (a : ∀ j, (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ)
    (ζ : Fin Cd.z.dim → ℝ) (hζ : ∀ k, 36 * ζ k = D.xiH Cd.z h' k)
    (hP : Cd.passes h' a xs Bf) :
    FourRef ζ Bf
      ((2 : ℝ) ^ dyBin (fourMu (dyadicGridLength A.G I.1) (Cd.refQ' h' a xs Bf)
        (Cd.refT' h' a xs Bf)))
      (2 * (2 : ℝ) ^ dyBin (fourNu (dyadicGridLength A.G I.1) (Cd.refQ' h' a xs Bf)
        (Cd.refT' h' a xs Bf)))
      (A.G.baseLength⁻¹ * 2 ^ I.1) (fun j => (D.Ms j G).slope (a j).1 xs) := by
  have hr := dyadicGridLength_pos A.G I.1
  have hR : A.G.baseLength⁻¹ * 2 ^ I.1 = (dyadicGridLength A.G I.1)⁻¹ :=
    baseLength_inv_zpow A.G I.1
  have hp : Cd.refPick h' a xs Bf ∈ Cd.refSet h' a xs Bf := finPick_mem hP.1
  obtain ⟨hpbox, -, -⟩ := Finset.mem_filter.mp hp
  obtain ⟨hp1b, hp2b⟩ := Finset.mem_product.mp hpbox
  set n := (Cd.refPick h' a xs Bf).1
  set m := (Cd.refPick h' a xs Bf).2
  have hsum : ∀ v : Fin Cd.z.dim → ℤ, 36 * ∑ p, (v p : ℝ) * ζ p =
      ∑ p, (v p : ℝ) * D.xiH Cd.z h' p := fun v => by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    rw [← hζ p]; ring
  have eQ : ∑ r, (D.Ms r G).slope (a r).1 xs + 36 * ∑ p, (n p : ℝ) * ζ p =
      Cd.refQ' h' a xs Bf := by rw [hsum]; rfl
  have eT : ∑ r : Fin 4, ((r : ℕ) : ℝ) * (D.Ms r G).slope (a r).1 xs +
      36 * ∑ p, (m p : ℝ) * ζ p = Cd.refT' h' a xs Bf := by rw [hsum]; rfl
  set q := Cd.refQ' h' a xs Bf
  set t := Cd.refT' h' a xs Bf
  set μ := fourMu (dyadicGridLength A.G I.1) q t
  set ν := fourNu (dyadicGridLength A.G I.1) q t
  have hμ : 0 < μ := lt_of_lt_of_le (inv_pos.mpr Cd.hU₀) hP.2
  refine ⟨n, m, fun p => abs_le_of_mem_frequencyBox hp1b p,
    fun p => abs_le_of_mem_frequencyBox hp2b p, ?_, ?_, fun j => ?_⟩
  · rw [eQ, hR, ← div_eq_mul_inv, le_div_iff₀ hr]
    have h1 : dyadicGridLength A.G I.1 * |q| ≤ ν :=
      (le_max_left _ _).trans (le_max_right 1 _)
    have h2 := le_two_mul_dyBin ν
    nlinarith [abs_nonneg q]
  · rw [eT, hR, ← div_eq_mul_inv, le_div_iff₀ hr]
    have h1 : dyadicGridLength A.G I.1 * |t| ≤ ν :=
      (le_max_right _ _).trans (le_max_right 1 _)
    have h2 := le_two_mul_dyBin ν
    nlinarith [abs_nonneg t]
  · rw [eQ, eT, hR, ← div_eq_mul_inv, div_le_iff₀ hr]
    have h1 := dyBin_le hμ
    have h2 : μ ≤ dyadicGridLength A.G I.1 * |t - ((j : ℕ) : ℝ) * q| := by
      refine (min_le_right _ _).trans ?_
      refine Finset.inf'_le _ (Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩) |>.trans ?_
      rfl
    nlinarith

