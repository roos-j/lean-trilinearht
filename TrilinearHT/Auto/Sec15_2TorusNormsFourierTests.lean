  exact hb.trans (add_le_add le_rfl (add_le_add
    (mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hprod hW) (norm_nonneg _))
    (mul_le_mul_of_nonneg_left (expC_sum_le _ F c cc cm hcc hcm) hmax)))

