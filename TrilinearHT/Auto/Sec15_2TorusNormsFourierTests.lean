theorem coset_haar_four_le
    (Rm : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hRm : Continuous Rm) {W : ℝ}
    (hW : 0 ≤ W) (hRb : ∀ z, ‖Rm z‖ ≤ W) (l : ℤ)
    (g : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℂ)
    (hg : ∀ i, Continuous (g i))
    (χ : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ) (hχc : Continuous χ)
    (hχ : ∀ z, ‖χ z‖ ≤ 1) :
    ‖∫ u, ∫ v, Rm (u, v) * (∏ i, g i (u + ((i : ℤ) - l) • v)) * χ (u, v)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)‖ ≤
      W * ∏ i, (eLpNorm (g i) 2 (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal := by
  set μ := torusAnnihilatorHaar (rationalIntegerIntersection V)
  set F : torusAnnihilator (rationalIntegerIntersection V) ×
      torusAnnihilator (rationalIntegerIntersection V) → ℂ :=
    fun z => Rm z * (∏ i, g i (z.1 + ((i : ℤ) - l) • z.2)) * χ z
  have hFc : Continuous F := by
    refine (hRm.mul (continuous_finsetProd _ fun i _ => (hg i).comp ?_)).mul hχc
    exact continuous_fst.add ((continuous_zsmul _).comp continuous_snd)
  have hFi : Integrable F (μ.prod μ) := hFc.integrable_of_hasCompactSupport
    (HasCompactSupport.of_compactSpace F)
  have hmeas : ∀ i, AEStronglyMeasurable (g i) μ := fun i => (hg i).aestronglyMeasurable
  have hfin : ∀ i, eLpNorm (g i) 2 μ ≠ ⊤ := fun i => by
    obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn (hg i).continuousOn
    exact (MemLp.of_bound (hmeas i) C (Filter.Eventually.of_forall fun x =>
      hC x (Set.mem_univ x))).eLpNorm_ne_top
  have hlin : ∫⁻ z, ‖F z‖ₑ ∂(μ.prod μ) ≤
      ENNReal.ofReal W * ∏ i, eLpNorm (g i) 2 μ := by
    have h := haar_four V (fun _ => ENNReal.ofReal W) measurable_const (fun _ => le_refl _) l
      (fun i x => ‖g i x‖ₑ) (fun i => (hg i).enorm.measurable)
    calc ∫⁻ z, ‖F z‖ₑ ∂(μ.prod μ) ≤ ∫⁻ z, ENNReal.ofReal W *
          ∏ i, ‖g i (z.1 + ((i : ℤ) - l) • z.2)‖ₑ ∂(μ.prod μ) := by
          refine lintegral_mono fun z => ?_
          simp only [F, enorm_mul]
          calc ‖Rm z‖ₑ * ‖∏ i, g i (z.1 + ((i : ℤ) - l) • z.2)‖ₑ * ‖χ z‖ₑ
              ≤ ENNReal.ofReal W * ‖∏ i, g i (z.1 + ((i : ℤ) - l) • z.2)‖ₑ * 1 := by
                gcongr
                · rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hRb z)
                · rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hχ z)
            _ = ENNReal.ofReal W * ∏ i, ‖g i (z.1 + ((i : ℤ) - l) • z.2)‖ₑ := by
                rw [mul_one]
                congr 1
                simp only [enorm_eq_nnnorm, nnnorm_prod, ENNReal.ofNNReal_finsetProd]
      _ ≤ ENNReal.ofReal W * ∏ i, eLpNorm (fun x => ‖g i x‖ₑ) 2 μ := h
      _ = ENNReal.ofReal W * ∏ i, eLpNorm (g i) 2 μ := by
          congr 1
          exact Finset.prod_congr rfl fun i _ => eLpNorm_enorm _ (hmeas i)
  rw [← integral_prod F hFi]
  refine (norm_integral_le_integral_norm _).trans ?_
  rw [integral_norm_eq_lintegral_enorm hFi.aestronglyMeasurable]
  have hR : ENNReal.ofReal W * ∏ i, eLpNorm (g i) 2 μ ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.prod_ne_top fun i _ => hfin i)
  calc (∫⁻ z, ‖F z‖ₑ ∂(μ.prod μ)).toReal ≤ (ENNReal.ofReal W * ∏ i, eLpNorm (g i) 2 μ).toReal :=
        ENNReal.toReal_mono hR hlin
