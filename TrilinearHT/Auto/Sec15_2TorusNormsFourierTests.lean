    exact div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left g hpr.le) hQL.le
  · have g := (gap_coset ϑ hH hε hgap hsmall (n k - n k') (hh k hk k' hk')).2 hm
    rw [e, abs_div, abs_mul, abs_of_pos hpr, abs_of_pos hQL]
    exact hεΛ.trans (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left g hpr.le) hQL.le)

/-- The closed hull of a dyadic cell lies in the closed hull of any dyadic cell containing it. -/
theorem Icc_subset_of_cell_subset {G : RealDyadicGrid} {I J : ℤ × ℤ}
    (h : dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G J.1 J.2) :
    Set.Icc (dyadicGridLeft G I.1 I.2) (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1) ⊆
      Set.Icc (dyadicGridLeft G J.1 J.2) (dyadicGridLeft G J.1 J.2 + dyadicGridLength G J.1) := by
  have hI := dyadicGridLength_pos G I.1
  have hl := h (dyadicGridCell_left_mem G I.1 I.2)
  have hr : dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1 ≤
      dyadicGridLeft G J.1 J.2 + dyadicGridLength G J.1 := by
    by_contra hc
    rw [not_le] at hc
    set t := max (dyadicGridLeft G I.1 I.2) (dyadicGridLeft G J.1 J.2 + dyadicGridLength G J.1)
    have ht : t ∈ dyadicGridCell G I.1 I.2 :=
      ⟨le_max_left _ _, max_lt (by linarith) hc⟩
    have := (h ht).2
    linarith [le_max_right (dyadicGridLeft G I.1 I.2)
      (dyadicGridLeft G J.1 J.2 + dyadicGridLength G J.1)]
  intro x hx
  exact ⟨hl.1.trans hx.1, hx.2.trans hr⟩

