/-- Blueprint lines 2576-2582 (`eq:principal-core`): after fixing the final height, role types and
the dyadic amplitude and frequency bins (`μ_τ ≤ 2μ`, `ν_τ ≥ ν`, `σ_{τ,j} ≤ 2σ_j`), the principal
contributions `q_τ ≤ C μ_τ ν_τ^{-J} Λ^{-J} Π_j σ_{τ,j}` of the `N` representative tuples passing
the tests sum to at most `2⁵ C μ ν^{-J} Λ^{-J} (Π_j σ_j) N`. -/
theorem principal_core_bins {ι : Type*} (E : Finset ι) (q μτ ντ : ι → ℝ) (στ : ι → Fin 4 → ℝ)
    {C μ ν Λ : ℝ} (J : ℕ) (σ : Fin 4 → ℝ) (hC : 0 ≤ C) (hΛ : 0 < Λ) (hν : 0 < ν)
    (hq : ∀ τ ∈ E, q τ ≤ C * μτ τ * (ντ τ ^ J)⁻¹ * (Λ ^ J)⁻¹ * ∏ j, στ τ j)
    (hμ : ∀ τ ∈ E, 0 ≤ μτ τ ∧ μτ τ ≤ 2 * μ) (hντ : ∀ τ ∈ E, ν ≤ ντ τ)
    (hσ : ∀ τ ∈ E, ∀ j, 0 ≤ στ τ j ∧ στ τ j ≤ 2 * σ j) :
    ∑ τ ∈ E, q τ ≤ 2 ^ 5 * C * μ * (ν ^ J)⁻¹ * (Λ ^ J)⁻¹ * (∏ j, σ j) * E.card := by
  have hterm : ∀ τ ∈ E, q τ ≤ 2 ^ 5 * C * μ * (ν ^ J)⁻¹ * (Λ ^ J)⁻¹ * ∏ j, σ j := by
    intro τ hτ
    have hP : ∏ j, στ τ j ≤ ∏ j, (2 * σ j) :=
      Finset.prod_le_prod₀ (fun j _ => (hσ τ hτ j).1) fun j _ => (hσ τ hτ j).2
    have hP0 : 0 ≤ ∏ j, στ τ j := Finset.prod_nonneg fun j _ => (hσ τ hτ j).1
    have hνJ : (ντ τ ^ J)⁻¹ ≤ (ν ^ J)⁻¹ :=
      inv_anti₀ (pow_pos hν J) (pow_le_pow_left₀ hν.le (hντ τ hτ) J)
    have hνJ0 : 0 ≤ (ντ τ ^ J)⁻¹ := inv_nonneg.mpr (pow_nonneg (hν.le.trans (hντ τ hτ)) J)
    have hΛJ : 0 ≤ (Λ ^ J)⁻¹ := inv_nonneg.mpr (pow_nonneg hΛ.le J)
    have hμ0 : 0 ≤ μ := by linarith [(hμ τ hτ).1, (hμ τ hτ).2]
    have e : ∏ j, (2 * σ j) = 2 ^ 4 * ∏ j, σ j := by
      rw [Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    refine (hq τ hτ).trans ?_
    calc C * μτ τ * (ντ τ ^ J)⁻¹ * (Λ ^ J)⁻¹ * ∏ j, στ τ j
        ≤ C * (2 * μ) * (ν ^ J)⁻¹ * (Λ ^ J)⁻¹ * ∏ j, (2 * σ j) := by
          refine mul_le_mul (mul_le_mul_of_nonneg_right (mul_le_mul
            (mul_le_mul_of_nonneg_left (hμ τ hτ).2 hC) hνJ hνJ0 (by positivity)) hΛJ) hP hP0
            (by positivity)
      _ = 2 ^ 5 * C * μ * (ν ^ J)⁻¹ * (Λ ^ J)⁻¹ * ∏ j, σ j := by rw [e]; ring
  calc ∑ τ ∈ E, q τ ≤ ∑ _τ ∈ E, 2 ^ 5 * C * μ * (ν ^ J)⁻¹ * (Λ ^ J)⁻¹ * ∏ j, σ j :=
        Finset.sum_le_sum hterm
    _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]; ring

