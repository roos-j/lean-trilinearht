        (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (z.θ i / (Q0 * L)))| ≤ ε₁)
    (hfar : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
