/-- The finite Schur test used for `eq:side-windows` (line 2557): if the row sums of `|K|` are at
most `Rw` and the column sums at most `Cl`, then for every `λ > 0`,
`Σ_{i,j} |K_{ij}| |x_i| |y_j| ≤ (λ Rw Σ |x_i|² + λ⁻¹ Cl Σ |y_j|²)/2`. -/
theorem schur_test {ι κ : Type*} (s : Finset ι) (t : Finset κ) (K : ι → κ → ℝ) (x : ι → ℝ)
    (y : κ → ℝ) {Rw Cl lam : ℝ} (hlam : 0 < lam)
    (hrow : ∀ i ∈ s, ∑ j ∈ t, |K i j| ≤ Rw) (hcol : ∀ j ∈ t, ∑ i ∈ s, |K i j| ≤ Cl) :
    ∑ i ∈ s, ∑ j ∈ t, |K i j| * |x i| * |y j| ≤
      (lam * Rw * ∑ i ∈ s, x i ^ 2 + lam⁻¹ * Cl * ∑ j ∈ t, y j ^ 2) / 2 := by
  have hpt : ∀ i j, |K i j| * |x i| * |y j| ≤
      |K i j| * (lam * x i ^ 2 + lam⁻¹ * y j ^ 2) / 2 := by
    intro i j
    have hK := abs_nonneg (K i j)
    have hamgm : 2 * (|x i| * |y j|) ≤ lam * x i ^ 2 + lam⁻¹ * y j ^ 2 := by
      have h := sq_nonneg (lam * |x i| - |y j|)
      have hl : lam * lam⁻¹ = 1 := mul_inv_cancel₀ hlam.ne'
      have e1 : x i ^ 2 = |x i| ^ 2 := (sq_abs _).symm
      have e2 : y j ^ 2 = |y j| ^ 2 := (sq_abs _).symm
      rw [e1, e2]
      have : 0 ≤ lam⁻¹ * (lam * |x i| - |y j|) ^ 2 := mul_nonneg (inv_nonneg.mpr hlam.le) h
      nlinarith
    nlinarith [mul_le_mul_of_nonneg_left hamgm hK]
  have hsplit : ∑ i ∈ s, ∑ j ∈ t, |K i j| * (lam * x i ^ 2 + lam⁻¹ * y j ^ 2) / 2 =
      (lam * ∑ i ∈ s, x i ^ 2 * ∑ j ∈ t, |K i j| +
        lam⁻¹ * ∑ j ∈ t, y j ^ 2 * ∑ i ∈ s, |K i j|) / 2 := by
    calc _ = (∑ i ∈ s, ∑ j ∈ t, lam * x i ^ 2 * |K i j| +
          ∑ i ∈ s, ∑ j ∈ t, lam⁻¹ * y j ^ 2 * |K i j|) / 2 := by
          rw [← Finset.sum_add_distrib, Finset.sum_div]
          apply Finset.sum_congr rfl; intro i _
          rw [← Finset.sum_add_distrib, Finset.sum_div]
          apply Finset.sum_congr rfl; intro j _
          ring
      _ = _ := by
          congr 2
          · rw [Finset.mul_sum]
            apply Finset.sum_congr rfl; intro i _
            rw [Finset.mul_sum, Finset.mul_sum]
            apply Finset.sum_congr rfl; intro j _
            ring
          · rw [Finset.sum_comm, Finset.mul_sum]
            apply Finset.sum_congr rfl; intro j _
            rw [Finset.mul_sum, Finset.mul_sum]
            apply Finset.sum_congr rfl; intro i _
            ring
  calc _ ≤ ∑ i ∈ s, ∑ j ∈ t, |K i j| * (lam * x i ^ 2 + lam⁻¹ * y j ^ 2) / 2 :=
        Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hpt i j
    _ = _ := hsplit
    _ ≤ (lam * ∑ i ∈ s, x i ^ 2 * Rw + lam⁻¹ * ∑ j ∈ t, y j ^ 2 * Cl) / 2 := by
        gcongr with i hi j hj
        · exact hrow i hi
        · exact hcol j hj
    _ = _ := by rw [← Finset.sum_mul, ← Finset.sum_mul]; ring

