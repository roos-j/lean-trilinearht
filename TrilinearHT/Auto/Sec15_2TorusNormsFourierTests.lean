open Classical in
/-- Blueprint lines 2489-2491 (distinct minimal CURRENT components on an attempt leaf cell `I`
of block `b`): two modes alive at the decision cell whose minimal CURRENT components on the
pre-cell `J = anc_{b-2K}(I)` differ are not PRE-adjacent at height zero on `I` (an edge on `I`
would give a CURRENT edge on `J`, since `|I| ≥ 2 r_{t_b}` and the slope variation over `J` is
at most `4Λ/r_{u_b} ≤ Ξ/(2 r_{t_b})`). -/
theorem not_pre0Edge_of_not_mem_F (hK1 : 1 ≤ D.S.K) (I : ℤ × ℤ) (l : Fin 4) (G : A.Grp)
    (hΛ : 8 * (D.Ms l G).Λ ≤ D.S.Ξ)
    {m m' : (D.Ms l G).alive (ancAt A.G (ancAt A.G I (D.blockOf I.1 - 2 * D.S.K))
      (D.blockOf I.1 - 4 * D.S.K))}
    (hF : m' ∉ ((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1)
      (ancAt A.G I (D.blockOf I.1 - 2 * D.S.K))).F 0 m) :
    ¬ (D.Ms l G).pre0Edge D.S I m.1 m'.1 := by
  intro he
  obtain ⟨hb, hb'⟩ := D.blockOf_bounds hK1 I.1
  have hIJ := subset_ancAt A.G I (show D.blockOf I.1 - 2 * D.S.K ≤ I.1 by omega)
  have hJt : (ancAt A.G I (D.blockOf I.1 - 2 * D.S.K)).1 ≤ D.blockOf I.1 + D.S.K := by
    change D.blockOf I.1 - 2 * D.S.K ≤ D.blockOf I.1 + D.S.K; omega
  have hΞ := Ξ_nonneg D.S
  have hΛ0 : 0 ≤ (D.Ms l G).Λ := le_trans (mul_nonneg (abs_nonneg _) (sq_nonneg _))
    ((D.Ms l G).lam_le m.1)
  -- `t = b + K`, `J = b - 2K`, `U = b - 4K`
  have hrt := dyadicGridLength_pos A.G (D.blockOf I.1 + D.S.K)
  have hrU := dyadicGridLength_pos A.G (D.blockOf I.1 - 4 * D.S.K)
  have hrJ := dyadicGridLength_pos A.G (D.blockOf I.1 - 2 * D.S.K)
  have hIt : 2 * dyadicGridLength A.G (D.blockOf I.1 + D.S.K) ≤ dyadicGridLength A.G I.1 := by
    have h1 := dyadicGridLength_of_le A.G (show I.1 ≤ D.blockOf I.1 + D.S.K by omega)
    have h3 : (2 : ℝ)⁻¹ ^ (D.blockOf I.1 + D.S.K - I.1).toNat ≤ (2 : ℝ)⁻¹ := by
      have h2 : 1 ≤ (D.blockOf I.1 + D.S.K - I.1).toNat := by omega
      calc (2 : ℝ)⁻¹ ^ (D.blockOf I.1 + D.S.K - I.1).toNat ≤ (2 : ℝ)⁻¹ ^ 1 :=
            pow_le_pow_of_le_one (by norm_num) (by norm_num) h2
        _ = (2 : ℝ)⁻¹ := pow_one _
    rw [h1]
    nlinarith [dyadicGridLength_pos A.G I.1]
  have hJU : dyadicGridLength A.G (D.blockOf I.1 - 2 * D.S.K) ≤
      dyadicGridLength A.G (D.blockOf I.1 - 4 * D.S.K) :=
    (dyadicGridLength_strictAnti A.G).antitone (by omega)
  have htU : dyadicGridLength A.G (D.blockOf I.1 + D.S.K) ≤
      dyadicGridLength A.G (D.blockOf I.1 - 4 * D.S.K) :=
    (dyadicGridLength_strictAnti A.G).antitone (by omega)
  set Lc := (D.Ms l G).Λ / dyadicGridLength A.G (D.blockOf I.1 - 4 * D.S.K) ^ 2 with hLc
  have hl1 : |(D.Ms l G).lamOf m.1| ≤ Lc := (D.Ms l G).lam_le_of_alive m
  have hl2 : |(D.Ms l G).lamOf m'.1| ≤ Lc := (D.Ms l G).lam_le_of_alive m'
  have hq : |(D.Ms l G).lamOf m.1 - (D.Ms l G).lamOf m'.1| ≤ 2 * Lc := by
    have := abs_sub ((D.Ms l G).lamOf m.1) ((D.Ms l G).lamOf m'.1); linarith
  have hUq : Lc * dyadicGridLength A.G (D.blockOf I.1 - 2 * D.S.K) *
      dyadicGridLength A.G (D.blockOf I.1 + D.S.K) ≤ (D.Ms l G).Λ := by
    rw [hLc, div_mul_eq_mul_div, div_mul_eq_mul_div, div_le_iff₀ (by positivity)]
    have := mul_le_mul_of_nonneg_left (mul_le_mul hJU htU hrt.le hrU.le) hΛ0
    nlinarith
  have hdl : 2 * |(D.Ms l G).lamOf m.1 - (D.Ms l G).lamOf m'.1| *
      dyadicGridLength A.G (D.blockOf I.1 - 2 * D.S.K) ≤
      D.S.Ξ / (2 * dyadicGridLength A.G (D.blockOf I.1 + D.S.K)) := by
    rw [le_div_iff₀ (by positivity)]
    have hm2 := mul_le_mul_of_nonneg_right hq (mul_nonneg hrJ.le hrt.le)
    nlinarith
  have hθ : D.S.Ξ / dyadicGridLength A.G I.1 +
      2 * |(D.Ms l G).lamOf m.1 - (D.Ms l G).lamOf m'.1| *
        dyadicGridLength A.G (ancAt A.G I (D.blockOf I.1 - 2 * D.S.K)).1 ≤
      D.S.Ξ / dyadicGridLength A.G (D.blockOf I.1 + D.S.K) := by
    have h1 : D.S.Ξ / dyadicGridLength A.G I.1 ≤
        D.S.Ξ / (2 * dyadicGridLength A.G (D.blockOf I.1 + D.S.K)) :=
      div_le_div_of_nonneg_left hΞ (by positivity) hIt
    have h2 : D.S.Ξ / (2 * dyadicGridLength A.G (D.blockOf I.1 + D.S.K)) +
        D.S.Ξ / (2 * dyadicGridLength A.G (D.blockOf I.1 + D.S.K)) =
        D.S.Ξ / dyadicGridLength A.G (D.blockOf I.1 + D.S.K) := by field_simp; ring
    change D.S.Ξ / dyadicGridLength A.G I.1 + 2 * |(D.Ms l G).lamOf m.1 -
      (D.Ms l G).lamOf m'.1| * dyadicGridLength A.G (D.blockOf I.1 - 2 * D.S.K) ≤ _
    linarith
  have hcur := (D.Ms l G).gapEdge_transfer D.S hIJ he hθ
  have hne : m ≠ m' := by
    rintro rfl
    exact hF ((ModeComponents.E_le_F _ 0 m) (ModeComponents.E_self _ 0 m))
  apply hF
  unfold ModeSystem.blockComps ModeSystem.preComps ModeSchedule.preCurrent
  simp only [hJt, ↓reduceDIte, ModeComponents.ofEdges, Finset.mem_filter, Finset.mem_univ,
    true_and]
  refine SimpleGraph.Adj.reachable ?_
  simp only [SimpleGraph.fromRel_adj]
  exact ⟨hne, Or.inl hcur⟩

