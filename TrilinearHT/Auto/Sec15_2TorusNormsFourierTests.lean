      refine (norm_add_le _ _).trans ?_
      rw [norm_mul, norm_mul, Circle.norm_coe, Circle.norm_coe, mul_one, one_mul]
      have hπ := Real.pi_pos
      have h3 : |s| * |t - t₁| ≤ R * |t - t₁| := mul_le_mul_of_nonneg_right hs (abs_nonneg _)
      have h4 : |x| * |q - q₁| ≤ R * |q - q₁| := mul_le_mul_of_nonneg_right hx (abs_nonneg _)
      nlinarith
