open Classical in
/-- Blueprint lines 2573-2576 ("apply the probability bound separately to each minimal-component
summand"): on an attempt leaf, for a fixed assignment `a` of `n` failed trials, the core components
`K ∈ T` of role `l` failing at every trial assigned to `l` carry, summed over the words of failed
upper heights, at most `(2δ*)^{n_l} |H|^n Σ_{K ∈ T} σ_K` (each core component is bad at a
proportion at most `2δ*` of the upper heights, `coreComp_bad_card`). -/
theorem role_mask_moment (G : A.Grp) (b : ℤ) (Jp : Fin 4 → A.Grp → ℤ × ℤ) (l : Fin 4)
    (hJ : 2 ≤ D.SP.Jst) (hδ : 0 < D.SP.δs) (hδ16 : D.SP.δs ≤ 1 / 16)
    (T : Finset (Finset (D.Ms l G).Md))
    (hT : T ⊆ (D.Ms l G).coreComps D.S D.hA D.SP b (Jp l G)) (σ : Finset (D.Ms l G).Md → ℝ)
    (hσ : ∀ K ∈ T, 0 ≤ σ K) {n : ℕ} (a : Fin n → Fin 4) :
    ∑ w ∈ Fintype.piFinset (fun _ : Fin n => ModeComponents.upperHeights D.SP.Jst D.SP.δs),
        ∑ K ∈ T.filter (fun K => ∀ i, a i = l → ¬ D.slotGood G b Jp l (w i) (some K)), σ K ≤
      (2 * D.SP.δs) ^ (Finset.univ.filter fun i => a i = l).card *
        ((ModeComponents.upperHeights D.SP.Jst D.SP.δs).card : ℝ) ^ n * ∑ K ∈ T, σ K :=
  mask_second_moment _ (fun h K => D.slotGood G b Jp l h (some K)) T σ hσ
    (fun _ hK => (D.Ms l G).coreComp_bad_card D.S D.hA D.SP (hT hK) hJ hδ hδ16) a l

open Classical in
/-- Blueprint lines 2573-2580 (moments over failure assignments) on an attempt leaf: fix the final
height `h` and an assignment `a` of `n` failed trials to first failing roles. If each role size
`a'_l(w)` is bounded by `C₀ (Σ_{K selected} σ_K²)^{1/2}` over the core components `K ∈ T_l`
selected by the role mask (`eq:torus-size`), then `a'_l ≤ C σ_{F_l}`,
`E (a'_l)² ≤ C (2δ*)^{n_l} σ_{F_l}²` (dropping the extra success requirements), and Hölder with
the four roles gives `E Π_l a'_l ≤ C⁴ ((2δ*)^n)^{1/4} Π_l σ_{F_l}`, where
`σ_{F_l} = (Σ_{K ∈ T_l} σ_K²)^{1/2}` and `C = max(1, C₀, C₀²)`. -/
theorem role_moments (G : A.Grp) (b : ℤ) (Jp : Fin 4 → A.Grp → ℤ × ℤ) (hJ : 2 ≤ D.SP.Jst)
    (hδ : 0 < D.SP.δs) (hδ16 : D.SP.δs ≤ 1 / 16) (T : ∀ l, Finset (Finset (D.Ms l G).Md))
    (hT : ∀ l, T l ⊆ (D.Ms l G).coreComps D.S D.hA D.SP b (Jp l G))
    (σ : ∀ l, Finset (D.Ms l G).Md → ℝ) {n : ℕ}
    (a : Fin n → Fin 4) (h : ℕ) (Aw : Fin 4 → (Fin n → ℕ) → ℝ) (hA0 : ∀ l w, 0 ≤ Aw l w)
    {C₀ : ℝ}
    (hts : ∀ l, ∀ w ∈ Fintype.piFinset (fun _ : Fin n =>
        ModeComponents.upperHeights D.SP.Jst D.SP.δs),
      Aw l w ≤ C₀ * Real.sqrt (∑ K ∈ (T l).filter
        (fun K => roleMask (D.slotGood G b Jp l) l a w h (some K)), σ l K ^ 2)) :
    ∑ w ∈ Fintype.piFinset (fun _ : Fin n => ModeComponents.upperHeights D.SP.Jst D.SP.δs),
        (((ModeComponents.upperHeights D.SP.Jst D.SP.δs).card : ℝ) ^ n)⁻¹ * ∏ l, Aw l w ≤
      max 1 (max C₀ (C₀ ^ 2)) ^ 4 * ((2 * D.SP.δs) ^ n) ^ (1 / (4 : ℝ)) *
        ∏ l, Real.sqrt (∑ K ∈ T l, σ l K ^ 2) := by
  set H := ModeComponents.upperHeights D.SP.Jst D.SP.δs with hH
  set C := max 1 (max C₀ (C₀ ^ 2)) with hC
  have hC1 : 1 ≤ C := le_max_left _ _
  have hCC₀ : C₀ ≤ C := (le_max_left _ _).trans (le_max_right _ _)
  have hCC₀2 : C₀ ^ 2 ≤ C := (le_max_right _ _).trans (le_max_right _ _)
