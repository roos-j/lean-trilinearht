/-- The selected coefficient `α_m e(φ_m(x*))` has modulus `|α_m|` (blueprint line 2569). -/
theorem norm_selC (j : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (m : (D.Ms j G).alive (D.decCell I)) :
    ‖D.selC j G I xs m‖ = ‖D.c j G (D.blockOf I.1) (D.preCell I) m.1‖ := by
