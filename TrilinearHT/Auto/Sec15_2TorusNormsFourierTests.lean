open Classical in
/-- Blueprint `eq:torus-size` (lines 2487-2495) for one role on a cell `I`: let the selected
modes `F` (alive at `U`) have physical sum `f = Σ_m α_m wave_m`, approximated on `I` by
`cutoff × phases × Σ_m α_m e(φ_m) χ_{n_m}(ξ(y - x*))` up to `η Σ|α|`, and let the truncated cutoff
`Σ_v cc_v χ_{QL v}` be within `τ` of the cutoff on `I`. If the frequencies `QL v + n_m` of the torus
input `g = (truncated cutoff) × (Σ α e(φ) χ_n)` have tiny/huge differences (`eq:gap`), and the
selected modes split into minimal CURRENT components `Dc i` that are pairwise not PRE-adjacent on
`I`, then `‖g‖_{L²(𝓗)} ≤ √2 (Σ_i (A_i + D^{-30} s_i)²)^{1/2}` with
`A_i = (2/|I|)^{1/2} ‖A_{D_i}‖_I + |s|^{1/2} (η + τ) Σ_{D_i} |α|` and
`s_i = |box| Σ_{D_i} |α|`. -/
theorem torus_size_modes {ι : Type*} (V : Submodule ℚ (Fin Ms.zc.dim → ℚ)) {U I : ℤ × ℤ}
    (QL Bx : ℕ) (F : Finset (Ms.alive U)) (α : Ms.Md → ℂ) (φ : Ms.Md → ℝ)
    (n : Ms.alive U → Fin Ms.zc.dim → ℤ) (cc : (Fin Ms.zc.dim → ℤ) → ℂ)
    (hcc : ∀ v, ‖cc v‖ ≤ 1) (ξ : Fin Ms.zc.dim → ℝ) {xs η τ ε Dst : ℝ}
    (cut : ℝ → ℝ) (ph gam : ℝ → ℂ) (hph : ∀ y, ‖ph y‖ = 1) (hgam : ∀ y, ‖gam y‖ = 1)
    (hxs : xs ∈ Set.Icc (dyadicGridLeft Gd I.1 I.2)
      (dyadicGridLeft Gd I.1 I.2 + dyadicGridLength Gd I.1))
    (hfa : ∀ y ∈ Set.Icc (dyadicGridLeft Gd I.1 I.2)
        (dyadicGridLeft Gd I.1 I.2 + dyadicGridLength Gd I.1),
      ‖∑ m ∈ F, α m.1 * Ms.wave m.1 y - (cut y : ℂ) * ph y * (gam y *
        ∑ m ∈ F, (α m.1 * (Real.fourierChar (φ m.1) : ℂ)) *
          torusCharacter (n m) (torusMk fun i => ξ i * (y - xs)))‖ ≤
        η * ∑ m ∈ F, ‖α m.1 * (Real.fourierChar (φ m.1) : ℂ)‖)
    (hline : ∀ y ∈ Set.Icc (dyadicGridLeft Gd I.1 I.2)
        (dyadicGridLeft Gd I.1 I.2 + dyadicGridLength Gd I.1),
      ‖∑ v ∈ frequencyBox Ms.zc.dim Bx, cc v * torusCharacter ((QL : ℤ) • v)
        (torusMk fun i => ξ i * (y - xs)) - (cut y : ℂ)‖ ≤ τ)
    (hη0 : 0 ≤ η) (hτ0 : 0 ≤ τ) (hε : 0 < ε)
    (htiny : ∀ p ∈ frequencyBox Ms.zc.dim Bx ×ˢ F, ∀ p' ∈ frequencyBox Ms.zc.dim Bx ×ˢ F,
      ((QL : ℤ) • p.1 + n p.2) - ((QL : ℤ) • p'.1 + n p'.2) ∈ rationalIntegerIntersection V →
      |2 * Real.pi * dyadicGridLength Gd I.1 * ∑ i, ((((QL : ℤ) • p.1 + n p.2) i : ℤ) : ℝ) * ξ i -
        2 * Real.pi * dyadicGridLength Gd I.1 * ∑ i, ((((QL : ℤ) • p'.1 + n p'.2) i : ℤ) : ℝ) *
          ξ i| ≤ ε)
    (hhuge : ∀ p ∈ frequencyBox Ms.zc.dim Bx ×ˢ F, ∀ p' ∈ frequencyBox Ms.zc.dim Bx ×ˢ F,
      ((QL : ℤ) • p.1 + n p.2) - ((QL : ℤ) • p'.1 + n p'.2) ∉ rationalIntegerIntersection V →
      2 / ε ≤ |2 * Real.pi * dyadicGridLength Gd I.1 * ∑ i, ((((QL : ℤ) • p.1 + n p.2) i : ℤ) :
        ℝ) * ξ i - 2 * Real.pi * dyadicGridLength Gd I.1 *
          ∑ i, ((((QL : ℤ) • p'.1 + n p'.2) i : ℤ) : ℝ) * ξ i|)
    (s : Finset ι) (Dc : ι → Finset Ms.Md) (hFs : F.image Subtype.val = s.biUnion Dc)
    (hdis : Set.PairwiseDisjoint (s : Set ι) Dc)
    (hδ : 0 < Ms.δc) (hΛ : 8 * Ms.Λ ≤ S.Ξ) (hΞ : 0 < S.Ξ) (hQ0 : 0 < S.Q0)
    (Kf : ℕ) (hbox : (S.Q0 : ℝ) * 2 ^ (Kf + 1) ≤ S.Eh 0)
    (halive : ∀ i ∈ s, ∀ m ∈ Dc i,
      dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd (Ms.cellOf m).1 (Ms.cellOf m).2)
    (hna : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → ∀ m ∈ Dc i, ∀ m' ∈ Dc j, m ≠ m' ∧ ¬ Ms.pre0Edge S I m m')
    {εw Dn : ℝ} (hεw0 : 0 < εw) (hεw : ∀ m, εw ≤ Ms.L.εM m) (hDn : 0 ≤ Dn)
    (hnum : (s.card : ℝ) ≤ Dn) (hcardc : ∀ i ∈ s, ((Dc i).card : ℝ) ≤ εw * Dn ^ 2)
    (hκ : pairConst Ms.zc.dim Ms.δc S.Ξ Kf * Dn ^ 3 ≤ 1)
    (hDst : 1 ≤ Dst) (hcard : (s.card : ℝ) ≤ Dst) (hεD : 2 * ε ≤ Dst ^ (-100 : ℤ)) :
    (eLpNorm (fun u : torusAnnihilator (rationalIntegerIntersection V) =>
        ∑ p ∈ frequencyBox Ms.zc.dim Bx ×ˢ F, (cc p.1 * (α p.2.1 *
          (Real.fourierChar (φ p.2.1) : ℂ))) * torusCharacter ((QL : ℤ) • p.1 + n p.2) u) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      Real.sqrt 2 * Real.sqrt (∑ i ∈ s,
        ((Real.sqrt (2 / dyadicGridLength Gd I.1) *
            ‖∑ m ∈ Dc i, α m • Ms.cellMode I m‖ +
          Real.sqrt s.card * (η + τ) * ∑ m ∈ Dc i, ‖α m‖) +
          Dst ^ (-30 : ℤ) * ((frequencyBox Ms.zc.dim Bx).card * ∑ m ∈ Dc i, ‖α m‖)) ^ 2) := by
  set r := dyadicGridLength Gd I.1 with hr_def
  have hr : 0 < r := dyadicGridLength_pos Gd I.1
  set a₀ := dyadicGridLeft Gd I.1 I.2
  set Q : ℝ → ℂ := fun y => ∑ m ∈ F, α m.1 * Ms.wave m.1 y with hQ_def
  have hnorm : ∀ m : Ms.alive U, ‖α m.1 * (Real.fourierChar (φ m.1) : ℂ)‖ = ‖α m.1‖ := fun m => by
    rw [norm_mul, Circle.norm_coe, mul_one]
  -- the coefficient sum over the components
  have hsum : ∑ m ∈ F, ‖α m.1‖ = ∑ i ∈ s, ∑ m ∈ Dc i, ‖α m‖ := by
    rw [← Finset.sum_biUnion hdis, ← hFs, Finset.sum_image fun x _ y _ h => Subtype.val_injective h]
  set Sα := ∑ m ∈ F, ‖α m.1‖ with hSα
  have hQm : Measurable Q := Finset.measurable_sum _ fun m _ =>
    measurable_const.mul (Ms.wave_measurable m.1)
  have hQb : ∀ y, ‖Q y‖ ≤ Sα := fun y => (norm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => by
    rw [norm_mul]; exact mul_le_of_le_one_right (norm_nonneg _) (Ms.wave_norm_le m.1 y))
  -- pointwise comparison along the line
  have hpt : ∀ y ∈ Set.Icc a₀ (a₀ + r), ‖∑ p ∈ frequencyBox Ms.zc.dim Bx ×ˢ F,
      (cc p.1 * (α p.2.1 * (Real.fourierChar (φ p.2.1) : ℂ))) *
        torusCharacter ((QL : ℤ) • p.1 + n p.2) (torusMk fun i => ξ i * (y - xs))‖ ≤
      ‖Q y‖ + (η + τ) * Sα := by
    intro y hy
    have h := coreG_line_le (d := Ms.zc.dim) QL Bx (ι := fun _ => Ms.alive U) (fun _ => F)
      (fun _ m => α m.1 * (Real.fourierChar (φ m.1) : ℂ)) (fun _ => n) (fun _ => cc) 0
      (torusMk fun i => ξ i * (y - xs)) (Q y) (cut y) (ph y) (gam y) (hph y) (hgam y)
      (hfa y hy) (hline y hy)
    simp_rw [hnorm] at h
    exact h
  -- the physical energy against the component subtotals
  have hsub := Ms.cell_subtotals_upper S I s Dc α hδ hΛ hΞ hQ0 Kf hbox halive hna hεw0 hεw hDn
    hnum hcardc hκ
  have hQsum : ∀ y, Q y = ∑ m ∈ F.image Subtype.val, α m * Ms.wave m y := fun y => by
    rw [Finset.sum_image fun x _ y _ h => Subtype.val_injective h]
  have hint : ∫ y in a₀..a₀ + r, ‖Q y‖ ^ 2 ≤
      2 * ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ms.cellMode I m‖ ^ 2 := by
    rw [intervalIntegral.integral_of_le (by linarith), ← integral_Ico_eq_integral_Ioc]
    have hw := Ms.wave_sum_le_cellMode I (F.image Subtype.val) α
    have hcell : dyadicGridCell Gd I.1 I.2 = Set.Ico a₀ (a₀ + r) := rfl
    rw [hcell] at hw
    simp_rw [hQsum]
    refine hw.trans (le_trans (le_of_eq ?_) hsub)
    rw [hFs, Finset.sum_biUnion hdis]
  set a : ι → ℝ := fun i => Real.sqrt (2 / r) * ‖∑ m ∈ Dc i, α m • Ms.cellMode I m‖
