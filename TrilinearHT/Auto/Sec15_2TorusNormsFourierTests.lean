theorem abs_le_of_mem_frequencyBox {d N : ℕ} {n : Fin d → ℤ} (h : n ∈ frequencyBox d N)
    (i : Fin d) : |(n i : ℝ)| ≤ N := by
  have := Finset.mem_Icc.mp (Fintype.mem_piFinset.mp h i)
  rw [abs_le]
  constructor <;> [exact_mod_cast this.1; exact_mod_cast this.2]

