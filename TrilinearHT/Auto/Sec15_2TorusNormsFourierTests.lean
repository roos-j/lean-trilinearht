/-- Blueprint `eq:Haar-four` (lines 2497-2502): on a rational connected subtorus `𝓗`, for a
multiplier bounded by `W`,
`∫_{𝓗²} K(u,v) Π_j |h_j(u + (j - l') v)| ≤ W Π_j ‖h_j‖_{L²(𝓗)}`; this is `eq:absolute` with all
four exponents equal to two. The zero-dimensional torus is included. -/
theorem haar_four {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    (K : (torusAnnihilator (rationalIntegerIntersection V)) ×
      (torusAnnihilator (rationalIntegerIntersection V)) → ℝ≥0∞)
    (hK : Measurable K) {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) (l : ℤ)
    (h : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℝ≥0∞)
    (hh : ∀ i, Measurable (h i)) :
    (∫⁻ z, K z * ∏ i, h i (z.1 + ((i : ℤ) - l) • z.2)
      ∂(torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V))) ≤
      W * ∏ i, eLpNorm (h i) 2 (torusAnnihilatorHaar (rationalIntegerIntersection V)) := by
  refine rationalTorus_absoluteBound V K hK hW l h hh (fun _ => 2) (fun _ => by norm_num) ?_
  simp only [ENNReal.toReal_ofNat, Finset.sum_const, Finset.card_univ, Fintype.card_fin]
  norm_num

/-- Blueprint lines 2487-2488 (tiny case): averaging the character `e^{i a x}` over `[0, 1]`
gives `1` up to an error at most `|a|`. -/
theorem character_average_tiny (a : ℝ) :
    ‖(∫ x in (0 : ℝ)..1, Complex.exp (Complex.I * (a * x : ℝ))) - 1‖ ≤ |a| := by
  have hint : IntervalIntegrable (fun x : ℝ => Complex.exp (Complex.I * (a * x : ℝ)))
      volume 0 1 := (by fun_prop : Continuous fun x : ℝ =>
        Complex.exp (Complex.I * (a * x : ℝ))).intervalIntegrable _ _
  have h1 : (∫ x in (0 : ℝ)..1, Complex.exp (Complex.I * (a * x : ℝ))) - 1 =
      ∫ x in (0 : ℝ)..1, (Complex.exp (Complex.I * (a * x : ℝ)) - 1) := by
    rw [intervalIntegral.integral_sub hint intervalIntegrable_const]
    simp
  rw [h1]
  have hb : ∀ x ∈ Set.uIoc (0 : ℝ) 1, ‖Complex.exp (Complex.I * (a * x : ℝ)) - 1‖ ≤ |a| := by
    intro x hx
    rw [Set.uIoc_of_le zero_le_one] at hx
    refine (Real.norm_exp_I_mul_ofReal_sub_one_le (x := a * x)).trans ?_
    rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hx.1.le]
    exact mul_le_of_le_one_right (abs_nonneg a) hx.2
  have := intervalIntegral.norm_integral_le_of_norm_le_const hb
  simpa using this

/-- Blueprint lines 2487-2488 (huge case): averaging the character `e^{i a x}` over `[0, 1]`
gives at most `2 / |a|`. -/
theorem character_average_huge {a : ℝ} (ha : a ≠ 0) :
    ‖∫ x in (0 : ℝ)..1, Complex.exp (Complex.I * (a * x : ℝ))‖ ≤ 2 / |a| := by
  have hc : Complex.I * (a : ℂ) ≠ 0 := mul_ne_zero Complex.I_ne_zero (by exact_mod_cast ha)
  have heq : (fun x : ℝ => Complex.exp (Complex.I * (a * x : ℝ))) =
      fun x : ℝ => Complex.exp ((Complex.I * a) * x) := by
    funext x; push_cast; ring_nf
  rw [heq, integral_exp_mul_complex hc]
  rw [norm_div, norm_mul, Complex.norm_I, one_mul, Complex.norm_real, Real.norm_eq_abs]
  gcongr
  calc ‖Complex.exp (Complex.I * a * (1 : ℝ)) - Complex.exp (Complex.I * a * (0 : ℝ))‖
      ≤ ‖Complex.exp (Complex.I * a * (1 : ℝ))‖ + ‖Complex.exp (Complex.I * a * (0 : ℝ))‖ :=
        norm_sub_le _ _
    _ = 2 := by
        have e1 : Complex.I * (a : ℂ) * ((1 : ℝ) : ℂ) = ((a : ℝ) : ℂ) * Complex.I := by
          push_cast; ring
        rw [e1, Complex.norm_exp_ofReal_mul_I]
        norm_num

/-- Blueprint lines 2526-2530 (kernel decay near the zero lines): if `f` vanishes at `p₀`, and
both `f` and its derivative decay like `A (1 + ‖y‖)^{-J}`, then
`|f p| ≤ 2^J A min(1, ‖p - p₀‖) (1 + ‖p‖)^{-J}`; the mean value theorem is used toward `p₀`
when `‖p - p₀‖ < 1`, and rapid decay directly otherwise. -/
theorem vanishing_decay_bound {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {f : E → ℂ} (hf : Differentiable ℝ f) {p₀ : E} (h0 : f p₀ = 0) {A : ℝ} (J : ℕ)
    (hdec : ∀ y, ‖f y‖ ≤ A * (1 + ‖y‖)⁻¹ ^ J)
    (hder : ∀ y, ‖fderiv ℝ f y‖ ≤ A * (1 + ‖y‖)⁻¹ ^ J) (p : E) :
    ‖f p‖ ≤ 2 ^ J * A * min 1 ‖p - p₀‖ * (1 + ‖p‖)⁻¹ ^ J := by
  have hA : 0 ≤ A := by
    have := (norm_nonneg _).trans (hdec p)
    exact nonneg_of_mul_nonneg_left this (by positivity)
  have hp1 : 0 < 1 + ‖p‖ := by positivity
  by_cases hd : 1 ≤ ‖p - p₀‖
  · rw [min_eq_left hd, mul_one]
    refine (hdec p).trans ?_
    have : (1 : ℝ) ≤ 2 ^ J := one_le_pow₀ (by norm_num)
    have : 0 ≤ A * (1 + ‖p‖)⁻¹ ^ J := by positivity
    nlinarith
  · push Not at hd
    rw [min_eq_right hd.le]
    have hseg : ∀ y ∈ segment ℝ p₀ p, ‖fderiv ℝ f y‖ ≤ 2 ^ J * A * (1 + ‖p‖)⁻¹ ^ J := by
      intro y hy
      have hyp : ‖y - p‖ ≤ ‖p - p₀‖ := by
        rw [← norm_neg, neg_sub]
        obtain ⟨t, ⟨ht0, ht1⟩, rfl⟩ := (segment_eq_image_lineMap ℝ p₀ p ▸ hy)
        simp only [AffineMap.lineMap_apply_module]
        rw [show p - ((1 - t) • p₀ + t • p) = (1 - t) • (p - p₀) by
          simp only [sub_smul, one_smul, smul_sub]; abel]
        rw [norm_smul, Real.norm_of_nonneg (by linarith)]
        exact mul_le_of_le_one_left (norm_nonneg _) (by linarith)
      have hy1 : (1 + ‖p‖) / 2 ≤ 1 + ‖y‖ := by
        have h1 := norm_sub_norm_le p y
        have h2 : ‖p - y‖ = ‖y - p‖ := norm_sub_rev p y
        have h3 := norm_nonneg y
        linarith
      have hinv : (1 + ‖y‖)⁻¹ ≤ 2 * (1 + ‖p‖)⁻¹ := by
        rw [inv_le_comm₀ (by positivity) (by positivity), mul_inv, inv_inv]
        linarith
      calc ‖fderiv ℝ f y‖ ≤ A * (1 + ‖y‖)⁻¹ ^ J := hder y
        _ ≤ A * (2 * (1 + ‖p‖)⁻¹) ^ J := by gcongr
        _ = 2 ^ J * A * (1 + ‖p‖)⁻¹ ^ J := by rw [mul_pow]; ring
    have := (convex_segment p₀ p).norm_image_sub_le_of_norm_fderiv_le
      (fun y _ => hf.differentiableAt) hseg (left_mem_segment ℝ p₀ p) (right_mem_segment ℝ p₀ p)
    rw [h0, sub_zero] at this
    calc ‖f p‖ ≤ 2 ^ J * A * (1 + ‖p‖)⁻¹ ^ J * ‖p - p₀‖ := this
      _ = _ := by ring

/-- Blueprint lines 2568-2572: for a fixed assignment of the failures, Hölder with `m₀ ≥ 1`
factors and the deterministic bound give
`E Π_j a'_j ≤ C^{m₀} ((2δ)^n)^{1/m₀} Π_j σ_j` from `a'_j ≤ C σ_j` and
`E (a'_j)² ≤ C (2δ)^{n_j} σ_j²` with `Σ_j n_j = n` (here `ρ = 2δ`, `C ≥ 1`). -/
theorem core_moment_bound {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    {m₀ : ℕ} (hm : 2 ≤ m₀) (a : Fin m₀ → Ω → ℝ≥0∞)
    (ha : ∀ j, Measurable (a j)) {C ρ : ℝ≥0∞} (hC : 1 ≤ C)
    (σ : Fin m₀ → ℝ≥0∞) (n : Fin m₀ → ℕ)
    (hdet : ∀ j ω, a j ω ≤ C * σ j)
    (hsq : ∀ j, ∫⁻ ω, a j ω ^ 2 ∂P ≤ C * ρ ^ n j * σ j ^ 2) :
    ∫⁻ ω, ∏ j, a j ω ∂P ≤ C ^ m₀ * (ρ ^ (∑ j, n j)) ^ (1 / (m₀ : ℝ)) * ∏ j, σ j := by
  have hm0 : (m₀ : ℝ) ≠ 0 := by exact_mod_cast (by omega : m₀ ≠ 0)
  have hmom : ∀ j, ∫⁻ ω, a j ω ^ m₀ ∂P ≤ C ^ m₀ * ρ ^ n j * σ j ^ m₀ := by
    intro j
    have hbdd : ∀ ω, a j ω ^ m₀ ≤ (C * σ j) ^ (m₀ - 2) * a j ω ^ 2 := by
      intro ω
      rw [show a j ω ^ m₀ = a j ω ^ (m₀ - 2) * a j ω ^ 2 by
        rw [← pow_add]; congr 1; omega]
      gcongr
      exact hdet j ω
    calc ∫⁻ ω, a j ω ^ m₀ ∂P ≤ ∫⁻ ω, (C * σ j) ^ (m₀ - 2) * a j ω ^ 2 ∂P := lintegral_mono hbdd
      _ = (C * σ j) ^ (m₀ - 2) * ∫⁻ ω, a j ω ^ 2 ∂P := lintegral_const_mul _ ((ha j).pow_const 2)
      _ ≤ (C * σ j) ^ (m₀ - 2) * (C * ρ ^ n j * σ j ^ 2) := by gcongr; exact hsq j
      _ = C ^ (m₀ - 2 + 1) * ρ ^ n j * σ j ^ (m₀ - 2 + 2) := by ring
      _ ≤ C ^ m₀ * ρ ^ n j * σ j ^ m₀ := by
          rw [show m₀ - 2 + 2 = m₀ by omega]
          gcongr
          omega
  have hhold : ∫⁻ ω, ∏ j, a j ω ∂P ≤ ∏ j, (∫⁻ ω, a j ω ^ m₀ ∂P) ^ (1 / (m₀ : ℝ)) := by
    have h := ENNReal.lintegral_prod_norm_pow_le (μ := P) Finset.univ
      (f := fun j ω => a j ω ^ m₀) (fun j _ => ((ha j).pow_const _).aemeasurable)
      (p := fun _ => 1 / (m₀ : ℝ)) (by simp [Finset.card_univ]; field_simp)
      (fun _ _ => by positivity)
    refine le_trans (le_of_eq ?_) h
    refine lintegral_congr fun ω => Finset.prod_congr rfl fun j _ => ?_
    rw [one_div, ENNReal.pow_rpow_inv_natCast (by omega)]
  refine hhold.trans ?_
  calc ∏ j, (∫⁻ ω, a j ω ^ m₀ ∂P) ^ (1 / (m₀ : ℝ))
      ≤ ∏ j, (C ^ m₀ * ρ ^ n j * σ j ^ m₀) ^ (1 / (m₀ : ℝ)) := by
        gcongr with j; exact hmom j
    _ = ∏ j, (C * (ρ ^ n j) ^ (1 / (m₀ : ℝ)) * σ j) := by
        refine Finset.prod_congr rfl fun j _ => ?_
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity), one_div,
          ENNReal.pow_rpow_inv_natCast (by omega), ENNReal.pow_rpow_inv_natCast (by omega)]
    _ = C ^ m₀ * (ρ ^ (∑ j, n j)) ^ (1 / (m₀ : ℝ)) * ∏ j, σ j := by
        rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_const,
          Finset.card_univ, Fintype.card_fin, ENNReal.prod_rpow_of_nonneg (by positivity),
          Finset.prod_pow_eq_pow_sum]

section FourPaths
variable {X Y : Type*} [DecidableEq X] [DecidableEq Y]

/-! ### Many four-step paths (lem:sparse-count, blueprint lines 2608-2609) -/

/-- The codegree of two first-part vertices in a bipartite edge set. -/
def bipCodeg (Q : Finset Y) (E : Finset (X × Y)) (x x' : X) : ℕ :=
  (Q.filter fun y => (x, y) ∈ E ∧ (x', y) ∈ E).card

/-- The first-part neighborhood of a second-part vertex. -/
def bipNbhd (P : Finset X) (E : Finset (X × Y)) (y : Y) : Finset X :=
  P.filter fun x => (x, y) ∈ E

/-- Four-step paths `a - y₁ - x - y₂ - a'` in a bipartite edge set. -/
def bipFourPaths (P : Finset X) (Q : Finset Y) (E : Finset (X × Y)) (a a' : X) :
    Finset (Y × X × Y) :=
  (Q ×ˢ P ×ˢ Q).filter fun p =>
    (a, p.1) ∈ E ∧ (p.2.1, p.1) ∈ E ∧ (p.2.1, p.2.2) ∈ E ∧ (a', p.2.2) ∈ E

theorem bipCodeg_comm (Q : Finset Y) (E : Finset (X × Y)) (x x' : X) :
    bipCodeg Q E x x' = bipCodeg Q E x' x := by
  unfold bipCodeg; congr 1; ext y; simp [and_comm]

theorem card_bipFourPaths (P : Finset X) (Q : Finset Y) (E : Finset (X × Y)) (a a' : X) :
    (bipFourPaths P Q E a a').card = ∑ x ∈ P, bipCodeg Q E a x * bipCodeg Q E x a' := by
  classical
  have h : bipFourPaths P Q E a a' = (P.sigma fun x =>
      (Q.filter fun y => (a, y) ∈ E ∧ (x, y) ∈ E) ×ˢ
        (Q.filter fun y => (x, y) ∈ E ∧ (a', y) ∈ E)).map
      ⟨fun p => (p.2.1, p.1, p.2.2), fun p q h => by
        simp only [Prod.mk.injEq] at h
        exact Sigma.ext h.2.1 (heq_of_eq (Prod.ext h.1 h.2.2))⟩ := by
    ext ⟨y₁, x, y₂⟩
    simp only [bipFourPaths, Finset.mem_filter, Finset.mem_product, Finset.mem_map,
      Finset.mem_sigma, Sigma.exists]
    constructor
    · rintro ⟨⟨h1, h2, h3⟩, e1, e2, e3, e4⟩
      exact ⟨x, (y₁, y₂), ⟨h2, ⟨h1, e1, e2⟩, ⟨h3, e3, e4⟩⟩, rfl⟩
    · rintro ⟨x', ⟨z₁, z₂⟩, ⟨h2, ⟨h1, e1, e2⟩, ⟨h3, e3, e4⟩⟩, h⟩
      obtain ⟨rfl, rfl, rfl⟩ := h
      exact ⟨⟨h1, h2, h3⟩, e1, e2, e3, e4⟩
  rw [h, Finset.card_map, Finset.card_sigma]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [Finset.card_product]
  rfl

/-- Edge count through neighborhoods. -/
theorem sum_card_bipNbhd (P : Finset X) (Q : Finset Y) (E : Finset (X × Y))
    (hE : E ⊆ P ×ˢ Q) : ∑ y ∈ Q, (bipNbhd P E y).card = E.card := by
  classical
  rw [Finset.card_eq_sum_card_fiberwise (f := Prod.snd) (t := Q)
    fun e he => (Finset.mem_product.mp (hE he)).2]
  refine Finset.sum_congr rfl fun y _ => ?_
  refine Finset.card_bij (fun x _ => (x, y)) ?_ ?_ ?_
  · intro x hx
    simp only [bipNbhd, Finset.mem_filter] at hx
    simp [hx.2]
  · intro x _ x' _ h; simpa using h
  · intro e he
    simp only [Finset.mem_filter] at he
    refine ⟨e.1, ?_, ?_⟩
    · simp only [bipNbhd, Finset.mem_filter]
      refine ⟨(Finset.mem_product.mp (hE he.1)).1, ?_⟩
      rw [← he.2]; exact he.1
    · rw [← he.2]

/-- Pairs of a neighborhood with a property, summed over the second part, count codegrees. -/
theorem sum_card_pairs_bipNbhd (P : Finset X) (Q : Finset Y) (E : Finset (X × Y))
    (bad : X → X → Prop) [DecidableRel bad] :
    ∑ y ∈ Q, ((bipNbhd P E y ×ˢ bipNbhd P E y).filter fun p => bad p.1 p.2).card =
      ∑ p ∈ (P ×ˢ P).filter (fun p => bad p.1 p.2), bipCodeg Q E p.1 p.2 := by
  classical
  have h1 : ∀ y ∈ Q, ((bipNbhd P E y ×ˢ bipNbhd P E y).filter fun p => bad p.1 p.2).card =
      ∑ p ∈ (P ×ˢ P).filter (fun p => bad p.1 p.2),
        if (p.1, y) ∈ E ∧ (p.2, y) ∈ E then 1 else 0 := by
    intro y _
    rw [← Finset.card_filter]
    congr 1; ext p
    simp only [bipNbhd, Finset.mem_filter, Finset.mem_product]
    tauto
  rw [Finset.sum_congr rfl h1, Finset.sum_comm]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [← Finset.card_filter]; rfl

