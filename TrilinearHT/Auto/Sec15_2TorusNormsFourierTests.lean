open Classical in
/-- The class of a minimal component is the CURRENT component of any of its modes. -/
theorem compClass_eq_of_mem (b : ℤ) (J : ℤ × ℤ) (h : ℕ) {K : Finset Ms.Md}
    (hK : K ∈ Ms.allComps S hA b J) {z : Ms.alive (ancAt Gd J (b - 4 * S.K))} (hz : z.1 ∈ K) :
    Ms.compClass S hA b J h K =
      ((Ms.blockComps S hA b J).F h z).map ⟨Subtype.val, Subtype.val_injective⟩ := by
  obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hK
  rw [Ms.compClass_eq S hA b J h x]
  obtain ⟨z', hz', hzz⟩ := Finset.mem_map.mp hz
  have : z' = z := Subtype.val_injective hzz
  subst this
  set C := Ms.blockComps S hA b J
  have hzF : z' ∈ C.F h x := C.F_mono 0 h x (Nat.zero_le h) (C.E_le_F 0 x hz')
  rw [C.F_comp h x z' hzF]

end ModeSystem

open Classical in
/-- Blueprint lines 2576-2582 and 2775-2776 ("after fixing ... the dyadic amplitude and frequency
bins ... a uniform per-bin estimate suffices"): if every term is at most the value of its bin, the
sum is at most the sum over the occupied bins of the bin value times the number of terms in the
bin. -/
theorem sum_by_bins {ι β : Type*} [DecidableEq β] (T : Finset ι) (bin : ι → β) (val : β → ℝ)
    (w : ι → ℝ)
    (hw : ∀ p ∈ T, w p ≤ val (bin p)) :
    ∑ p ∈ T, w p ≤ ∑ c ∈ T.image bin, val c * ((T.filter fun p => bin p = c).card : ℝ) := by
  rw [← Finset.sum_fiberwise_of_maps_to (fun p hp => Finset.mem_image_of_mem bin hp)]
  refine Finset.sum_le_sum fun c _ => ?_
  calc ∑ p ∈ T.filter (fun p => bin p = c), w p ≤ ∑ _p ∈ T.filter (fun p => bin p = c), val c :=
        Finset.sum_le_sum fun p hp => by
          obtain ⟨hpT, hpc⟩ := Finset.mem_filter.mp hp
          rw [← hpc]; exact hw p hpT
    _ = val c * ((T.filter fun p => bin p = c).card : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul, mul_comm]

/-- The dyadic bin of a positive quantity: `2^k ≤ x < 2^{k+1}` with `k = ⌊log₂ x⌋`. -/
noncomputable def dyBin (x : ℝ) : ℤ := Int.log 2 x

theorem dyBin_le {x : ℝ} (hx : 0 < x) : (2 : ℝ) ^ dyBin x ≤ x := by
  have := Int.zpow_log_le_self (b := 2) (by norm_num) hx
  simpa [dyBin] using this

theorem le_two_mul_dyBin (x : ℝ) : x ≤ 2 * (2 : ℝ) ^ dyBin x := by
  have := Int.lt_zpow_succ_log_self (b := 2) (R := ℝ) (by norm_num) x
  rw [zpow_add₀ (by norm_num), zpow_one] at this
  simp only [Nat.cast_ofNat] at this
  unfold dyBin
  linarith

