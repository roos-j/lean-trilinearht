/-! ### Fourier decay of the normalized kernel (blueprint lines 2526-2534) -/

open Real in
/-- A function vanishing outside `[-R, R]` has its iterated derivatives vanishing there too. -/
theorem iteratedDeriv_eq_zero_of_support {f : ℝ → ℂ} {R : ℝ}
    (hsupp : ∀ x, f x ≠ 0 → |x| ≤ R) (k : ℕ) {x : ℝ} (hx : R < |x|) :
    iteratedDeriv k f x = 0 := by
  have hts : tsupport f ⊆ Set.Icc (-R) R := by
    refine closure_minimal (fun y hy => ?_) isClosed_Icc
    exact abs_le.mp (hsupp y hy)
  have hnot : x ∉ tsupport f := fun h => by
    have := abs_le.mpr (hts h); linarith
  rw [iteratedDeriv]
  have : iteratedFDeriv ℝ k f x = 0 := by
    by_contra hne
    exact hnot (support_iteratedFDeriv_subset k (Function.mem_support.mpr hne))
  rw [this]; rfl

/-- The integral of a function bounded by `A` and vanishing outside `[-R, R]` is at most
`2 R A`. -/
theorem integral_norm_le_of_support {g : ℝ → ℂ} {R A : ℝ} (hR : 0 ≤ R)
    (hg : ∀ x, ‖g x‖ ≤ A) (hsupp : ∀ x, R < |x| → g x = 0) :
    ∫ x, ‖g x‖ ≤ 2 * R * A := by
  have hpt : ∀ x, ‖g x‖ ≤ Set.indicator (Set.Icc (-R) R) (fun _ => A) x := by
    intro x
    by_cases hx : x ∈ Set.Icc (-R) R
    · rw [Set.indicator_of_mem hx]; exact hg x
    · rw [Set.indicator_of_notMem hx, hsupp x (by
        by_contra h; push Not at h; exact hx (abs_le.mp h)), norm_zero]
  have hint : Integrable (Set.indicator (Set.Icc (-R) R) (fun _ : ℝ => A)) :=
    (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
  calc ∫ x, ‖g x‖ ≤ ∫ x, Set.indicator (Set.Icc (-R) R) (fun _ => A) x :=
        integral_mono_of_nonneg (Filter.Eventually.of_forall fun _ => norm_nonneg _) hint
          (Filter.Eventually.of_forall hpt)
    _ = 2 * R * A := by
        rw [integral_indicator measurableSet_Icc, setIntegral_const, Real.volume_real_Icc,
          smul_eq_mul]
        rw [max_eq_left (by linarith)]
        ring

open Real in
/-- Uniform Fourier decay of a smooth function vanishing outside `[-R, R]`:
`(1 + |q|^J) ‖𝓕 f q‖ ≤ 2 R (A₀ + (2π)^{-J} A_J)` when `|f| ≤ A₀` and `|f^{(J)}| ≤ A_J`. -/
theorem fourier_decay_of_support {f : ℝ → ℂ} (hf : ContDiff ℝ (⊤ : ℕ∞) f) {R : ℝ} (hR : 0 ≤ R)
    (hsupp : ∀ x, f x ≠ 0 → |x| ≤ R) (J : ℕ) {A₀ AJ : ℝ} (hA₀ : ∀ x, ‖f x‖ ≤ A₀)
    (hAJ : ∀ x, ‖iteratedDeriv J f x‖ ≤ AJ) (q : ℝ) :
    (1 + |q| ^ J) * ‖𝓕 f q‖ ≤ 2 * R * (A₀ + ((2 * π) ^ J)⁻¹ * AJ) := by
  have hA₀0 : 0 ≤ A₀ := (norm_nonneg _).trans (hA₀ 0)
  have hAJ0 : 0 ≤ AJ := (norm_nonneg _).trans (hAJ 0)
  have hcs : HasCompactSupport f := by
    refine HasCompactSupport.intro (isCompact_Icc (a := -R) (b := R)) fun x hx => ?_
    by_contra hne
    exact hx (abs_le.mp (hsupp x hne))
  have hint : ∀ k ≤ J, Integrable (iteratedDeriv k f) := by
    intro k _
    have hc : Continuous (iteratedDeriv k f) :=
      hf.continuous_iteratedDeriv k (by exact_mod_cast le_top)
    refine hc.integrable_of_hasCompactSupport ?_
    refine HasCompactSupport.intro (isCompact_Icc (a := -R) (b := R)) fun x hx => ?_
    refine iteratedDeriv_eq_zero_of_support hsupp k ?_
    by_contra h; push Not at h; exact hx (abs_le.mp h)
  have h := Real.one_add_pow_mul_norm_fourier_le (n := J) (hf.of_le (by exact_mod_cast le_top))
    hint q
  have h1 : ∫ v, ‖f v‖ ≤ 2 * R * A₀ := integral_norm_le_of_support hR hA₀ fun x hx => by
    by_contra hne; have := hsupp x hne; linarith
  have h2 : ∫ v, ‖iteratedDeriv J f v‖ ≤ 2 * R * AJ :=
    integral_norm_le_of_support hR hAJ fun x hx => iteratedDeriv_eq_zero_of_support hsupp J hx
  have hπ : 0 ≤ ((2 * π) ^ J)⁻¹ := by positivity
  calc (1 + |q| ^ J) * ‖𝓕 f q‖ ≤ (∫ v, ‖f v‖) + ((2 * π) ^ J)⁻¹ * ∫ v, ‖iteratedDeriv J f v‖ := h
    _ ≤ 2 * R * A₀ + ((2 * π) ^ J)⁻¹ * (2 * R * AJ) := by gcongr
    _ = 2 * R * (A₀ + ((2 * π) ^ J)⁻¹ * AJ) := by ring

/-- The bounds of a normalized kernel at unit scale: smooth, vanishing outside `[-R, R]²`, with
line derivatives in each variable bounded by `A m`. -/
structure UnitKernelBounds (w : ℝ × ℝ → ℂ) (R : ℝ) (A : ℕ → ℝ) : Prop where
  smooth : ContDiff ℝ (⊤ : ℕ∞) w
  supp : ∀ x s, w (x, s) ≠ 0 → |x| ≤ R ∧ |s| ≤ R
  dx : ∀ m x s, ‖iteratedDeriv m (fun x => w (x, s)) x‖ ≤ A m
  ds : ∀ m x s, ‖iteratedDeriv m (fun s => w (x, s)) s‖ ≤ A m

/-- The Fourier transform of a kernel on `ℝ²` (first in `x`, then in `s`). -/
noncomputable def kernelFT (w : ℝ × ℝ → ℂ) (q t : ℝ) : ℂ :=
  ∫ s : ℝ, (Real.fourierChar (-(s * t)) : ℂ) * 𝓕 (fun x => w (x, s)) q

namespace UnitKernelBounds
variable {w : ℝ × ℝ → ℂ} {R : ℝ} {A : ℕ → ℝ} (hw : UnitKernelBounds w R A)
include hw

theorem R_nonneg_of_ne {x s : ℝ} (h : w (x, s) ≠ 0) : 0 ≤ R :=
  (abs_nonneg x).trans (hw.supp x s h).1

theorem A_nonneg (m : ℕ) : 0 ≤ A m := (norm_nonneg _).trans (hw.dx m 0 0)

theorem slice_x_smooth (s : ℝ) : ContDiff ℝ (⊤ : ℕ∞) (fun x => w (x, s)) :=
  hw.smooth.comp (contDiff_id.prodMk contDiff_const)

theorem slice_s_smooth (x : ℝ) : ContDiff ℝ (⊤ : ℕ∞) (fun s => w (x, s)) :=
  hw.smooth.comp (contDiff_const.prodMk contDiff_id)

open Real in
/-- Fourier decay of the `x`-slices, uniformly in `s`. -/
theorem slice_decay (hR : 0 ≤ R) (J : ℕ) (s q : ℝ) :
    (1 + |q| ^ J) * ‖𝓕 (fun x => w (x, s)) q‖ ≤ 2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J) :=
  fourier_decay_of_support (hw.slice_x_smooth s) hR (fun x hx => (hw.supp x s hx).1) J
    (fun x => by simpa using hw.dx 0 x s) (hw.dx J · s) q

/-- The `x`-slices vanish for `|s| > R`. -/
theorem slice_eq_zero {s : ℝ} (hs : R < |s|) (q : ℝ) : 𝓕 (fun x => w (x, s)) q = 0 := by
  have : (fun x => w (x, s)) = 0 := by
    funext x
    by_contra h
    have := (hw.supp x s h).2
    linarith
  rw [this]
  simp [Real.fourier_real_eq]

open Real in
/-- Blueprint lines 2530-2533 (rapid decay in the first frequency):
`(1 + |q|^J) |Ŵ(q, t)| ≤ 2R · 2R (A₀ + (2π)^{-J} A_J)`. -/
theorem decay_q (hR : 0 ≤ R) (J : ℕ) (q t : ℝ) :
    (1 + |q| ^ J) * ‖kernelFT w q t‖ ≤
      2 * R * (2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J)) := by
  have hpos : 0 < 1 + |q| ^ J := by positivity
  set M := 2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J)
  have hg : ∀ s, ‖(Real.fourierChar (-(s * t)) : ℂ) * 𝓕 (fun x => w (x, s)) q‖ ≤
      M / (1 + |q| ^ J) := by
    intro s
    rw [norm_mul, Circle.norm_coe, one_mul, le_div_iff₀ hpos, mul_comm]
    exact hw.slice_decay hR J s q
  have hint := integral_norm_le_of_support hR hg fun s hs => by
    rw [hw.slice_eq_zero hs q, mul_zero]
  unfold kernelFT
  rw [mul_comm, ← le_div_iff₀ hpos]
  refine (norm_integral_le_integral_norm _).trans (hint.trans (le_of_eq ?_))
  field_simp

/-- The phase-weighted kernel on `ℝ × ℝ` (in the order `(s, x)`) is integrable. -/
theorem integrable_phase (q t : ℝ) :
    Integrable (fun p : ℝ × ℝ => (Real.fourierChar (-(p.1 * t)) : ℂ) *
      ((Real.fourierChar (-(p.2 * q)) : ℂ) * w (p.2, p.1))) (volume.prod volume) := by
  refine Continuous.integrable_of_hasCompactSupport ?_ ?_
  · have hc := hw.smooth.continuous
    have h1 : Continuous fun p : ℝ × ℝ => (Real.fourierChar (-(p.1 * t)) : ℂ) :=
      continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
    have h2 : Continuous fun p : ℝ × ℝ => (Real.fourierChar (-(p.2 * q)) : ℂ) :=
      continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
    exact h1.mul (h2.mul (hc.comp (continuous_snd.prodMk continuous_fst)))
  · refine HasCompactSupport.intro ((isCompact_Icc (a := -R) (b := R)).prod
      (isCompact_Icc (a := -R) (b := R))) fun p hp => ?_
    by_contra hne
    have hw0 : w (p.2, p.1) ≠ 0 := fun h => hne (by rw [h, mul_zero, mul_zero])
    obtain ⟨h1, h2⟩ := hw.supp p.2 p.1 hw0
    exact hp ⟨abs_le.mp h2, abs_le.mp h1⟩

/-- Fubini: the kernel transform computed first in `s`, then in `x`. -/
theorem kernelFT_swap (q t : ℝ) :
    kernelFT w q t = ∫ x : ℝ, (Real.fourierChar (-(x * q)) : ℂ) * 𝓕 (fun s => w (x, s)) t := by
  unfold kernelFT
  simp_rw [Real.fourier_real_eq, Circle.smul_def, smul_eq_mul, ← integral_const_mul]
  rw [integral_integral_swap (hw.integrable_phase q t)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun s => ?_)
  simp only
  ring

open Real in
/-- Blueprint lines 2530-2533 (rapid decay in the second frequency). -/
theorem decay_t (hR : 0 ≤ R) (J : ℕ) (q t : ℝ) :
    (1 + |t| ^ J) * ‖kernelFT w q t‖ ≤
      2 * R * (2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J)) := by
  have hpos : 0 < 1 + |t| ^ J := by positivity
  set M := 2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J)
  have hdec : ∀ x, (1 + |t| ^ J) * ‖𝓕 (fun s => w (x, s)) t‖ ≤ M := fun x =>
    fourier_decay_of_support (hw.slice_s_smooth x) hR (fun s hs => (hw.supp x s hs).2) J
      (fun s => by simpa using hw.ds 0 x s) (hw.ds J x ·) t
  have hzero : ∀ x, R < |x| → 𝓕 (fun s => w (x, s)) t = 0 := by
    intro x hx
    have : (fun s => w (x, s)) = 0 := by
      funext s
      by_contra h
      have := (hw.supp x s h).1
      linarith
    rw [this]
    simp [Real.fourier_real_eq]
  have hg : ∀ x, ‖(Real.fourierChar (-(x * q)) : ℂ) * 𝓕 (fun s => w (x, s)) t‖ ≤
      M / (1 + |t| ^ J) := by
    intro x
    rw [norm_mul, Circle.norm_coe, one_mul, le_div_iff₀ hpos, mul_comm]
    exact hdec x
  have hint := integral_norm_le_of_support hR hg fun x hx => by rw [hzero x hx, mul_zero]
  rw [hw.kernelFT_swap, mul_comm, ← le_div_iff₀ hpos]
  refine (norm_integral_le_integral_norm _).trans (hint.trans (le_of_eq ?_))
  field_simp

/-- The sheared slices `u ↦ w(u - j s, s)` and their phase-weighted product integrability. -/
theorem integrable_shear (j q : ℝ) :
    Integrable (fun p : ℝ × ℝ => (Real.fourierChar (-(p.2 * q)) : ℂ) * w (p.2 - j * p.1, p.1))
      (volume.prod volume) := by
  refine Continuous.integrable_of_hasCompactSupport ?_ ?_
  · have hc := hw.smooth.continuous
    have h2 : Continuous fun p : ℝ × ℝ => (Real.fourierChar (-(p.2 * q)) : ℂ) :=
      continuous_subtype_val.comp (Real.continuous_fourierChar.comp (by fun_prop))
    exact h2.mul (hc.comp (by fun_prop))
  · refine HasCompactSupport.intro ((isCompact_Icc (a := -R) (b := R)).prod
      (isCompact_Icc (a := -(R + |j| * R)) (b := R + |j| * R))) fun p hp => ?_
    by_contra hne
    have hw0 : w (p.2 - j * p.1, p.1) ≠ 0 := fun h => hne (by rw [h, mul_zero])
    obtain ⟨h1, h2⟩ := hw.supp _ _ hw0
    apply hp
    refine ⟨abs_le.mp h2, abs_le.mp ?_⟩
    have : |j * p.1| ≤ |j| * R := by rw [abs_mul]; exact mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
    calc |p.2| = |(p.2 - j * p.1) + j * p.1| := by ring_nf
      _ ≤ |p.2 - j * p.1| + |j * p.1| := abs_add_le _ _
      _ ≤ R + |j| * R := add_le_add h1 this

open Real in
/-- Blueprint lines 2529-2533 (zeros on the lines `t = j q` and smoothness near them): if the
marginals `∫ w(u - j s, s) ds` vanish, then near the line,
`(1 + |q|^J) |Ŵ(q, j q + δ)| ≤ 2R · 2πR|δ| · 2(R + |j|R) (A₀ + (2π)^{-J} A_J)`. -/
theorem near_line (hR : 0 ≤ R) (J : ℕ) (j : ℝ) (hmarg : ∀ u, ∫ s, w (u - j * s, s) = 0)
    (q δ : ℝ) :
    (1 + |q| ^ J) * ‖kernelFT w q (j * q + δ)‖ ≤
      2 * R * (2 * π * R * |δ| * (2 * (R + |j| * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J))) := by
  have hpos : 0 < 1 + |q| ^ J := by positivity
  set R' := R + |j| * R
  have hR' : 0 ≤ R' := by positivity
  set F : ℝ → ℂ := fun s => 𝓕 (fun u => w (u - j * s, s)) q
  have hchar : ∀ a b : ℝ, (Real.fourierChar (a + b) : ℂ) =
      (Real.fourierChar a : ℂ) * (Real.fourierChar b : ℂ) := fun a b => by
    rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
  -- translation of the slices
  have htrans : ∀ s, 𝓕 (fun x => w (x, s)) q =
      (Real.fourierChar (j * s * q) : ℂ) * F s := by
    intro s
    simp only [F, Real.fourier_real_eq, Circle.smul_def, smul_eq_mul]
    rw [← integral_sub_right_eq_self (fun x => (Real.fourierChar (-(x * q)) : ℂ) * w (x, s))
      (j * s), ← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    simp only
    rw [show -((u - j * s) * q) = j * s * q + -(u * q) by ring, hchar]
    ring
  -- the shear form of the transform
  have hshear : kernelFT w q (j * q + δ) =
      ∫ s, (Real.fourierChar (-(s * δ)) : ℂ) * F s := by
    unfold kernelFT
    refine integral_congr_ae (Filter.Eventually.of_forall fun s => ?_)
    simp only
    rw [htrans s, ← mul_assoc, ← hchar]
    congr 3
    ring
  -- the vanishing marginal
  have hF : ∀ s, F s = ∫ u, (Real.fourierChar (-(u * q)) : ℂ) * w (u - j * s, s) := by
    intro s
    simp only [F, Real.fourier_real_eq, Circle.smul_def, smul_eq_mul]
  have hFint : Integrable F := by
    have h := (hw.integrable_shear j q).integral_prod_left
    simp only at h
    refine h.congr (Filter.Eventually.of_forall fun s => ?_)
    rw [hF s]
  have hF0 : ∫ s, F s = 0 := by
    simp_rw [hF]
    rw [integral_integral_swap (hw.integrable_shear j q)]
    refine (integral_congr_ae (g := fun _ => (0 : ℂ))
      (Filter.Eventually.of_forall fun u => ?_)).trans (by simp)
    simp only
    rw [integral_const_mul, hmarg u, mul_zero]
  -- subtract the vanishing marginal
  have hmeas : AEStronglyMeasurable (fun s : ℝ => (Real.fourierChar (-(s * δ)) : ℂ)) :=
    (continuous_subtype_val.comp
      (Real.continuous_fourierChar.comp (by fun_prop))).aestronglyMeasurable
  have hEF : Integrable (fun s => (Real.fourierChar (-(s * δ)) : ℂ) * F s) :=
    hFint.bdd_mul (c := 1) hmeas (Filter.Eventually.of_forall fun s => by rw [Circle.norm_coe])
  have hsub : kernelFT w q (j * q + δ) =
      ∫ s, ((Real.fourierChar (-(s * δ)) : ℂ) - 1) * F s := by
    rw [hshear]
    simp_rw [sub_mul, one_mul]
    rw [integral_sub hEF hFint, hF0, sub_zero]
  -- decay of the sheared slices
  set M := 2 * R' * (A 0 + ((2 * π) ^ J)⁻¹ * A J)
  have hFdec : ∀ s, (1 + |q| ^ J) * ‖F s‖ ≤ M := by
    intro s
    have hder : ∀ m u, iteratedDeriv m (fun u => w (u - j * s, s)) u =
        iteratedDeriv m (fun x => w (x, s)) (u - j * s) := by
      intro m u
      have h := iteratedDeriv_comp_affine (hw.slice_x_smooth s) m 1 (-(j * s)) u
      simp only [one_mul, one_pow, one_smul, ← sub_eq_add_neg] at h
      exact h
    refine fourier_decay_of_support (f := fun u => w (u - j * s, s))
      (hw.smooth.comp ((contDiff_id.sub contDiff_const).prodMk contDiff_const))
      hR' (fun u hu => ?_) J (fun u => by simpa using hw.dx 0 (u - j * s) s)
      (fun u => by rw [hder]; exact hw.dx J _ s) q
    obtain ⟨h1, h2⟩ := hw.supp _ _ hu
    have : |j * s| ≤ |j| * R := by rw [abs_mul]; exact mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
    calc |u| = |(u - j * s) + j * s| := by ring_nf
      _ ≤ |u - j * s| + |j * s| := abs_add_le _ _
      _ ≤ R + |j| * R := add_le_add h1 this
  have hFzero : ∀ s, R < |s| → F s = 0 := by
    intro s hs
    have : (fun u => w (u - j * s, s)) = 0 := by
      funext u
      by_contra h
      have := (hw.supp _ _ h).2
      linarith
    simp only [F, this]
    simp [Real.fourier_real_eq]
  have hg : ∀ s, ‖((Real.fourierChar (-(s * δ)) : ℂ) - 1) * F s‖ ≤
      2 * π * R * |δ| * (M / (1 + |q| ^ J)) := by
    intro s
    by_cases hs : |s| ≤ R
    · rw [norm_mul]
      have h1 : ‖(Real.fourierChar (-(s * δ)) : ℂ) - 1‖ ≤ 2 * π * R * |δ| := by
        refine (chart_fourierChar_sub_one_norm_le _).trans ?_
        rw [abs_neg, abs_mul]
        have := mul_le_mul_of_nonneg_right hs (abs_nonneg δ)
        have hπ := Real.pi_pos
        nlinarith
      have h2 : ‖F s‖ ≤ M / (1 + |q| ^ J) := by rw [le_div_iff₀ hpos, mul_comm]; exact hFdec s
      exact mul_le_mul h1 h2 (norm_nonneg _) (by positivity)
    · push Not at hs
      rw [hFzero s hs, mul_zero, norm_zero]
      have hM : 0 ≤ M := by
        have := hFdec 0
        exact le_trans (by positivity) this
      positivity
  have hint := integral_norm_le_of_support hR hg fun s hs => by rw [hFzero s hs, mul_zero]
  rw [hsub, mul_comm, ← le_div_iff₀ hpos]
  refine (norm_integral_le_integral_norm _).trans (hint.trans (le_of_eq ?_))
  field_simp

open Real in
/-- Blueprint lines 2526-2534 (`|Ŵ_s(r q', r t')| ≤ C_J μ ν^{-J}`): if the marginals along the
lines `t = j q`, `j ∈ L` (`|j| ≤ J_b`), vanish, then with `μ = min(1, min_j |t - j q|)` and
`ν = max(1, |q|, |t|)`, `|Ŵ(q, t)| ν^J ≤ C μ` for an explicit `C` depending only on `R, J_b`
and the derivative bounds. -/
theorem decay_lines (hR : 0 ≤ R) (J : ℕ) (L : Finset ℝ) (hL : L.Nonempty) {Jb : ℝ}
    (hJb : ∀ j ∈ L, |j| ≤ Jb) (hmarg : ∀ j ∈ L, ∀ u, ∫ s, w (u - j * s, s) = 0) (q t : ℝ) :
    ‖kernelFT w q t‖ * max 1 (max |q| |t|) ^ J ≤
      (2 * (2 * R * (2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J))) + (Jb + 2) ^ J *
        (2 * R * (2 * π * R * (2 * (R + Jb * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J))))) *
      min 1 (L.inf' hL fun j => |t - j * q|) := by
  set D := 2 * R * (2 * R * (A 0 + ((2 * π) ^ J)⁻¹ * A J))
  set Nb := 2 * R * (2 * π * R * (2 * (R + Jb * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J)))
  obtain ⟨j₀, hj₀L, hj₀⟩ := Finset.exists_mem_eq_inf' hL fun j => |t - j * q|
  have hJb0 : 0 ≤ Jb := (abs_nonneg _).trans (hJb j₀ hj₀L)
  have hA0 := hw.A_nonneg 0
  have hAJ := hw.A_nonneg J
  have hD0 : 0 ≤ D := by positivity
  have hN0 : 0 ≤ Nb := by positivity
  have hK := norm_nonneg (kernelFT w q t)
  set m := L.inf' hL fun j => |t - j * q|
  have hmax : max 1 (max |q| |t|) ^ J ≤ (1 + |q| ^ J) + (1 + |t| ^ J) := by
    rcases le_total 1 (max |q| |t|) with h | h
    · rw [max_eq_right h]
      rcases le_total |q| |t| with h' | h'
      · rw [max_eq_right h']; have := pow_nonneg (abs_nonneg q) J; linarith
      · rw [max_eq_left h']; have := pow_nonneg (abs_nonneg t) J; linarith
    · rw [max_eq_left h, one_pow]
      have := pow_nonneg (abs_nonneg q) J; have := pow_nonneg (abs_nonneg t) J; linarith
  by_cases hm : 1 ≤ m
  · rw [min_eq_left hm, mul_one]
    have h1 := hw.decay_q hR J q t
    have h2 := hw.decay_t hR J q t
    have : 0 ≤ (Jb + 2) ^ J * Nb := by positivity
    calc ‖kernelFT w q t‖ * max 1 (max |q| |t|) ^ J
        ≤ ‖kernelFT w q t‖ * ((1 + |q| ^ J) + (1 + |t| ^ J)) :=
          mul_le_mul_of_nonneg_left hmax hK
      _ ≤ 2 * D := by nlinarith
      _ ≤ _ := by linarith
  · push Not at hm
    rw [min_eq_right hm.le]
    have hδ : t = j₀ * q + (t - j₀ * q) := by ring
    have hnear := hw.near_line hR J j₀ (hmarg j₀ hj₀L) q (t - j₀ * q)
    rw [← hδ] at hnear
    have hmδ : |t - j₀ * q| = m := hj₀.symm
    rw [hmδ] at hnear
    -- the constant at `j₀` is at most the one at `J_b`
    have hR' : 2 * π * R * m * (2 * (R + |j₀| * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J)) ≤
        2 * π * R * m * (2 * (R + Jb * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J)) := by
      have hm0 : 0 ≤ m := hmδ ▸ abs_nonneg _
      gcongr
      exact hJb j₀ hj₀L
    have hN : (1 + |q| ^ J) * ‖kernelFT w q t‖ ≤ Nb * m := by
      calc (1 + |q| ^ J) * ‖kernelFT w q t‖ ≤ 2 * R * (2 * π * R * m *
            (2 * (R + |j₀| * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J))) := hnear
        _ ≤ 2 * R * (2 * π * R * m * (2 * (R + Jb * R) * (A 0 + ((2 * π) ^ J)⁻¹ * A J))) :=
            mul_le_mul_of_nonneg_left hR' (by positivity)
        _ = Nb * m := by ring
    -- `ν ≤ (J_b + 2) max(1, |q|)`
    have hν : max 1 (max |q| |t|) ^ J ≤ (Jb + 2) ^ J * (1 + |q| ^ J) := by
      have ht : |t| ≤ Jb * |q| + 1 := by
        have h1 : |t| ≤ |j₀ * q| + |t - j₀ * q| := by
          calc |t| = |j₀ * q + (t - j₀ * q)| := by ring_nf
            _ ≤ _ := abs_add_le _ _
        rw [abs_mul, hmδ] at h1
        have := mul_le_mul_of_nonneg_right (hJb j₀ hj₀L) (abs_nonneg q)
        linarith
      have hle : max 1 (max |q| |t|) ≤ (Jb + 2) * max 1 |q| := by
        have hq1 : 1 ≤ max 1 |q| := le_max_left _ _
        have hqq : |q| ≤ max 1 |q| := le_max_right _ _
        refine max_le (by nlinarith) (max_le (by nlinarith) (by nlinarith))
      have hp : (max 1 |q|) ^ J ≤ 1 + |q| ^ J := by
        rcases le_total 1 |q| with h | h
        · rw [max_eq_right h]; linarith
        · rw [max_eq_left h, one_pow]; have := pow_nonneg (abs_nonneg q) J; linarith
      calc max 1 (max |q| |t|) ^ J ≤ ((Jb + 2) * max 1 |q|) ^ J :=
            pow_le_pow_left₀ (le_trans zero_le_one (le_max_left _ _)) hle J
        _ = (Jb + 2) ^ J * (max 1 |q|) ^ J := mul_pow _ _ _
        _ ≤ (Jb + 2) ^ J * (1 + |q| ^ J) := mul_le_mul_of_nonneg_left hp (by positivity)
    have hm0 : 0 ≤ m := hmδ ▸ abs_nonneg _
    calc ‖kernelFT w q t‖ * max 1 (max |q| |t|) ^ J
        ≤ ‖kernelFT w q t‖ * ((Jb + 2) ^ J * (1 + |q| ^ J)) := mul_le_mul_of_nonneg_left hν hK
      _ = (Jb + 2) ^ J * ((1 + |q| ^ J) * ‖kernelFT w q t‖) := by ring
      _ ≤ (Jb + 2) ^ J * (Nb * m) := mul_le_mul_of_nonneg_left hN (by positivity)
      _ ≤ (2 * D + (Jb + 2) ^ J * Nb) * m := by nlinarith

end UnitKernelBounds

end KernelDecay

/-- Blueprint lines 2522-2534: the unit-scale admissible kernel `W_s` has the bounds of a
normalized kernel, uniformly over the kernel class. -/
theorem unitKernel_bounds {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) :
    UnitKernelBounds (unitKernel a₀ r w) 4 (kernelDerivBound κ) := by
  have hrm : ∀ m : ℕ, r ^ m * r⁻¹ ^ m = 1 := fun m => by
    rw [← mul_pow, mul_inv_cancel₀ hr.ne', one_pow]
  refine ⟨hw.smooth.comp (by fun_prop), fun x s h => ?_, fun m x s => ?_, fun m x s => ?_⟩
  · have hsupp := kernelUnitRescale_support (u := ![x, s]) hr hw (by
      simpa [kernelUnitRescale, unitKernel] using h)
    exact ⟨by simpa using hsupp 0, by simpa using hsupp 1⟩
  · have he : (fun x => unitKernel a₀ r w (x, s)) =
        fun x => (fun y => w (y, r * s)) (r * x + (a₀ + r / 2)) := by
      funext x; simp [unitKernel, add_comm]
    rw [he, iteratedDeriv_comp_affine (φ := fun y => w (y, r * s))
      (hw.smooth.comp (contDiff_id.prodMk contDiff_const)), norm_smul,
      Real.norm_eq_abs, abs_pow, abs_of_pos hr]
    have hb := hw.derivativeBound m 0 (r * x + (a₀ + r / 2), r * s)
    simp only [localKernelPartial, iteratedDeriv_zero, add_zero] at hb
    calc r ^ m * ‖iteratedDeriv m (fun y => w (y, r * s)) (r * x + (a₀ + r / 2))‖ ≤
        r ^ m * (r⁻¹ ^ m * kernelDerivBound κ m) :=
          mul_le_mul_of_nonneg_left (by simpa [kernelDerivBound] using hb) (by positivity)
      _ = kernelDerivBound κ m := by rw [← mul_assoc, hrm, one_mul]
  · have he : (fun s => unitKernel a₀ r w (x, s)) =
        fun s => (fun y => w (a₀ + r / 2 + r * x, y)) (r * s + 0) := by
      funext s; simp [unitKernel]
    rw [he, iteratedDeriv_comp_affine (φ := fun y => w (a₀ + r / 2 + r * x, y))
      (hw.smooth.comp (contDiff_const.prodMk contDiff_id)), norm_smul,
      Real.norm_eq_abs, abs_pow, abs_of_pos hr]
    have hb := hw.derivativeBound 0 m (a₀ + r / 2 + r * x, r * s + 0)
    simp only [localKernelPartial, iteratedDeriv_zero, zero_add] at hb
    calc r ^ m * ‖iteratedDeriv m (fun y => w (a₀ + r / 2 + r * x, y)) (r * s + 0)‖ ≤
        r ^ m * (r⁻¹ ^ m * kernelDerivBound κ m) :=
          mul_le_mul_of_nonneg_left (by simpa [kernelDerivBound] using hb) (by positivity)
      _ = kernelDerivBound κ m := by rw [← mul_assoc, hrm, one_mul]

/-- Blueprint line 2529 ("the four marginals give zeros of `Ŵ_s(q,t)` on the four lines
`t = j q`"): the unit-scale kernel has vanishing marginals along the four lines. -/
theorem unitKernel_marginal {κ : LocalKernelClass} {a₀ r : ℝ} {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (j : Fin 4) (u : ℝ) :
    ∫ s, unitKernel a₀ r w (u - (j : ℝ) * s, s) = 0 := by
  have h := hw.marginal (a₀ + r / 2 + r * u) j
  have hc := Measure.integral_comp_mul_left (fun t => w (a₀ + r / 2 + r * u - (j : ℝ) * t, t)) r
  simp only [unitKernel]
  have he : (fun s => w (a₀ + r / 2 + r * (u - (j : ℝ) * s), r * s)) =
      fun s => (fun t => w (a₀ + r / 2 + r * u - (j : ℝ) * t, t)) (r * s) := by
    funext s; congr 2; ring
  rw [he, hc, h, smul_zero]

/-- Blueprint lines 2526-2534 for the admissible kernels: `|Ŵ_s(q, t)| ν^J ≤ C_J μ` with
`μ = min(1, min_{0 ≤ j ≤ 3} |t - j q|)`, `ν = max(1, |q|, |t|)`, uniformly over the class. -/
theorem admissible_kernel_decay {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a₀ r w) (J : ℕ) (q t : ℝ) :
