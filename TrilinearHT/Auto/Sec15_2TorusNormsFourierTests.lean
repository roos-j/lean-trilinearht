      H ≤ r * |(∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
          (z.θ i / (Q0 * L))) -
        (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (z.θ i / (Q0 * L)))|)
