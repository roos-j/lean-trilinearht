        (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (z.θ i / (Q0 * L)))|)
    (hA₀ : r * |∑ j, γ j + ∑ i, (p₀.1 i : ℝ) * (z.θ i / (Q0 * L))| ≤ U)
    (hB₀ : r * |∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (z.θ i / (Q0 * L))| ≤ U)
    (hHU : 1 ≤ H - U) {W : ℝ} (hW : 0 ≤ W)
    (hRb : ∀ (cm : (Fin (z.dim + z.dim) → ℤ) → ℂ), (∀ v, ‖cm v‖ ≤ 1) →
      ∀ u v : StandardTorus z.dim,
      ‖∑ q ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)), cm q *
