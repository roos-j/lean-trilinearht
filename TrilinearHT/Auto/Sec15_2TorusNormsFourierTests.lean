/-- A fixed choice of an element of a finite set (the default if empty). -/
noncomputable def finPick {X : Type*} [Inhabited X] (S : Finset X) : X :=
  if h : S.Nonempty then h.choose else default

theorem finPick_mem {X : Type*} [Inhabited X] {S : Finset X} (h : S.Nonempty) : finPick S ∈ S := by
  simp only [finPick, h, ↓reduceDIte]
  exact h.choose_spec

open Classical in
/-- The reference of the coset of `v` modulo `K` among the frequencies `P`: a fixed member of `P`
in the same coset (blueprint line 2547, "choose one reference `n` from the box per coset"). -/
noncomputable def cosetRep {d : ℕ} (K : Submodule ℤ (Fin d → ℤ)) (P : Finset (Fin d → ℤ))
    (v : Fin d → ℤ) : Fin d → ℤ :=
  finPick (P.filter fun u => v - u ∈ K)

theorem cosetRep_spec {d : ℕ} (K : Submodule ℤ (Fin d → ℤ)) (P : Finset (Fin d → ℤ))
    {v : Fin d → ℤ} (hv : v ∈ P) : cosetRep K P v ∈ P ∧ v - cosetRep K P v ∈ K := by
  classical
  have hne : (P.filter fun u => v - u ∈ K).Nonempty := ⟨v, Finset.mem_filter.mpr ⟨hv, by simp⟩⟩
  exact Finset.mem_filter.mp (finPick_mem hne)

theorem cosetRep_eq {d : ℕ} (K : Submodule ℤ (Fin d → ℤ)) (P : Finset (Fin d → ℤ))
    {v v' : Fin d → ℤ} (h : v - v' ∈ K) : cosetRep K P v = cosetRep K P v' := by
  classical
  unfold cosetRep
  congr 1
  ext u
  simp only [Finset.mem_filter]
  refine and_congr_right fun _ => ⟨fun hu => ?_, fun hu => ?_⟩
  · have : v' - u = (v - u) - (v - v') := by abel
    rw [this]; exact K.sub_mem hu h
  · have : v - u = (v' - u) + (v - v') := by abel
    rw [this]; exact K.add_mem hu h

theorem cosetRep_sub_not_mem {d : ℕ} (K : Submodule ℤ (Fin d → ℤ)) (P : Finset (Fin d → ℤ))
    {v v' : Fin d → ℤ} (hv : v ∈ P) (hv' : v' ∈ P) (hne : cosetRep K P v ≠ cosetRep K P v') :
    cosetRep K P v - cosetRep K P v' ∉ K := by
  intro hmem
  apply hne
  refine cosetRep_eq K P ?_
  have h1 := (cosetRep_spec K P hv).2
  have h2 := (cosetRep_spec K P hv').2
  have : v - v' = (v - cosetRep K P v) + (cosetRep K P v - cosetRep K P v') -
      (v' - cosetRep K P v') := by abel
  rw [this]
  exact K.sub_mem (K.add_mem h1 hmem) h2

open Classical in
/-- Blueprint lines 2543-2550 (the three-core cosets from the gap of the nonexceptional primary):
with the references `nref` of the horizontal cosets modulo `K_B` (one box frequency per coset),
distinct references are separated (`r|(n - n')·ξ| ≥ rΛ/(Q₀L) ≥ 1`), the terms on the reference
vertical coset `m₀` are within `rε/(Q₀L)` of their references, and the other vertical cosets have
`r|T_l| ≥ rΛ/(Q₀L) - U` (`|r β₀| ≤ U`): the `hN`, `hsep`, `hnear`, `hfar` inputs of
`three_core_principal` with `α_n = Σ γ + n·ξ` and `β₀ = Σ (j - l) γ_j + m₀·ξ`. -/
theorem three_coset_of_gap {d : ℕ} (ϑ : Fin d → ℝ) {Hh : ℕ} (hH : 1 ≤ Hh) {ε Λ : ℝ}
    (hε : 0 ≤ ε)
    (hgap : ∀ a : Fin d → ℚ, vecHeight a ≤ Hh → |ratEval ϑ a| ≤ ε ∨ Λ ≤ |ratEval ϑ a|)
    (hsmall : (3 * Hh ^ 2 : ℝ) ^ d * (d.factorial * Hh ^ (d ^ 2 + d)) * ε < Λ)
    {r : ℝ} (hr : 0 < r) {Q0 L : ℕ} (hQL : (0 : ℝ) < Q0 * L) (Bx : ℕ) (γ : Fin 4 → ℝ)
    {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j)) (n : ∀ j, ι j → Fin d → ℤ) {Nb : ℝ}
    (hNb0 : 0 ≤ Nb) (hn : ∀ j, ∀ k ∈ F j, ∀ i, |(n j k i : ℝ)| ≤ Nb) (l : Fin 4)
    (m₀ : Fin d → ℤ) {Bp : ℝ} (hm₀ : ∀ i, |(m₀ i : ℝ)| ≤ Bp)
    (hHb : 4 * (L * Bx + 4 * (3 * ((Q0 * L : ℕ) * Bx + Nb))) + Bp ≤ Hh) {U : ℝ}
    (hU : r * |∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j - ((l : ℕ) : ℝ) * ∑ j, γ j +
      ∑ i, (m₀ i : ℝ) * (ϑ i / (Q0 * L))| ≤ U)
    (h1 : 1 ≤ r * Λ / (Q0 * L)) :
    ∃ N : Finset (Fin d → ℤ), ∃ nref : ((Fin (d + d) → ℤ) × ∀ j, (Fin d → ℤ) × ι j) → Fin d → ℤ,
      (∀ n ∈ N, ∀ i, |(n i : ℝ)| ≤ L * Bx + 4 * (3 * ((Q0 * L : ℕ) * Bx + Nb))) ∧
      (∀ n ∈ N, ∀ n' ∈ N, n ≠ n' → n - n' ∉ rationalIntegerIntersection (tinySpan ϑ Hh ε)) ∧
      (∀ n ∈ N, ∀ n' ∈ N, n ≠ n' →
        1 ≤ |-(r * (∑ j, γ j + ∑ i, (n i : ℝ) * (ϑ i / (Q0 * L)))) -
          -(r * (∑ j, γ j + ∑ i, (n' i : ℝ) * (ϑ i / (Q0 * L))))|) ∧
      (∀ x ∈ frequencyBox (d + d) Bx ×ˢ Fintype.piFinset
          (fun j => frequencyBox d Bx ×ˢ F j),
        expP2 L (Q0 * L) n x - ((l : ℕ) : ℤ) • expP1 L (Q0 * L) n x - m₀ ∈
          rationalIntegerIntersection (tinySpan ϑ Hh ε) →
        nref x ∈ N ∧ expP1 L (Q0 * L) n x - nref x ∈
            rationalIntegerIntersection (tinySpan ϑ Hh ε) ∧
          |r * (∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L))) -
            r * (∑ j, γ j + ∑ i, (nref x i : ℝ) * (ϑ i / (Q0 * L)))| ≤ r * ε / (Q0 * L) ∧
          |r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
              (ϑ i / (Q0 * L))) - ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i,
                (expP1 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L)))) -
            r * (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j - ((l : ℕ) : ℝ) * ∑ j, γ j +
              ∑ i, (m₀ i : ℝ) * (ϑ i / (Q0 * L)))| ≤ r * ε / (Q0 * L)) ∧
      (∀ x ∈ frequencyBox (d + d) Bx ×ˢ Fintype.piFinset
          (fun j => frequencyBox d Bx ×ˢ F j),
        expP2 L (Q0 * L) n x - ((l : ℕ) : ℤ) • expP1 L (Q0 * L) n x - m₀ ∉
          rationalIntegerIntersection (tinySpan ϑ Hh ε) →
        r * Λ / (Q0 * L) - U ≤ |r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j +
            ∑ i, (expP2 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L))) - ((l : ℕ) : ℝ) *
              (∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L))))|) := by
  set K := rationalIntegerIntersection (tinySpan ϑ Hh ε) with hK
  set Bxs := frequencyBox (d + d) Bx ×ˢ Fintype.piFinset (fun j => frequencyBox d Bx ×ˢ F j)
  set P := Bxs.image (expP1 L (Q0 * L) n) with hP
  set E : ℝ := L * Bx + 4 * (3 * ((Q0 * L : ℕ) * Bx + Nb)) with hE
  have hE0 : 0 ≤ (Q0 * L : ℕ) * (Bx : ℝ) + Nb := by positivity
  have hent : ∀ x ∈ Bxs, ∀ i, |(expP1 L (Q0 * L) n x i : ℝ)| ≤ E ∧
      |(expP2 L (Q0 * L) n x i : ℝ)| ≤ E := fun x hx i => by
    have := expP_entries_le L (Q0 * L) Bx F n hn x hx i
    constructor <;> [linarith [this.1]; linarith [this.2]]
  have hPent : ∀ v ∈ P, ∀ i, |(v i : ℝ)| ≤ E := fun v hv i => by
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hv
    exact (hent x hx i).1
  -- heights of the differences
  have hht2 : ∀ v ∈ P, ∀ v' ∈ P, vecHeight (fun i => ((v - v') i : ℚ)) ≤ Hh := fun v hv v' hv' =>
    vecHeight_int_le _ hH fun i => by
      simp only [Pi.sub_apply, Int.cast_sub]
      refine (abs_sub _ _).trans ?_
      have := hPent v hv i; have := hPent v' hv' i
      have : 0 ≤ E := (abs_nonneg _).trans (hPent v hv i)
      have : 0 ≤ Bp := (abs_nonneg _).trans (hm₀ i)
      linarith
  have hl3 : ((l : ℕ) : ℝ) ≤ 3 := by have := l.isLt; exact_mod_cast (by omega : (l : ℕ) ≤ 3)
  have hl0 : (0 : ℝ) ≤ (l : ℕ) := Nat.cast_nonneg _
  have hhtΔ : ∀ x ∈ Bxs, vecHeight (fun i =>
      ((expP2 L (Q0 * L) n x - ((l : ℕ) : ℤ) • expP1 L (Q0 * L) n x - m₀) i : ℚ)) ≤ Hh :=
    fun x hx => vecHeight_int_le _ hH fun i => by
      simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Int.cast_sub, Int.cast_mul,
        Int.cast_natCast]
      have h2 := (hent x hx i).2; have h1' := (hent x hx i).1; have hm := hm₀ i
      have hE0' : 0 ≤ E := (abs_nonneg _).trans h1'
      calc |(expP2 L (Q0 * L) n x i : ℝ) - ((l : ℕ) : ℝ) * (expP1 L (Q0 * L) n x i : ℝ) -
            (m₀ i : ℝ)| ≤ |(expP2 L (Q0 * L) n x i : ℝ)| +
            ((l : ℕ) : ℝ) * |(expP1 L (Q0 * L) n x i : ℝ)| + |(m₀ i : ℝ)| := by
            have := abs_sub (((expP2 L (Q0 * L) n x i : ℝ)) - ((l : ℕ) : ℝ) *
              (expP1 L (Q0 * L) n x i : ℝ)) (m₀ i : ℝ)
            have := abs_sub ((expP2 L (Q0 * L) n x i : ℝ))
              (((l : ℕ) : ℝ) * (expP1 L (Q0 * L) n x i : ℝ))
            rw [abs_mul, abs_of_nonneg hl0] at this
            linarith
        _ ≤ E + 3 * E + Bp := by nlinarith
        _ ≤ Hh := by linarith
  have hfd : ∀ (c : ℝ) (v v' : Fin d → ℤ), (c + ∑ i, (v i : ℝ) * (ϑ i / (Q0 * L))) -
      (c + ∑ i, (v' i : ℝ) * (ϑ i / (Q0 * L))) = (∑ i, ((v - v') i : ℝ) * ϑ i) / (Q0 * L) :=
    fun c v v' => freq_diff_eq ϑ c v v'
  have key : ∀ e1 e2 : Fin d → ℤ, (∑ i, (e2 i : ℝ) * (ϑ i / (Q0 * L))) - ((l : ℕ) : ℝ) *
      (∑ i, (e1 i : ℝ) * (ϑ i / (Q0 * L))) - ∑ i, (m₀ i : ℝ) * (ϑ i / (Q0 * L)) =
      (∑ i, ((e2 - ((l : ℕ) : ℤ) • e1 - m₀) i : ℝ) * ϑ i) / (Q0 * L) := by
    intro e1 e2
    rw [Finset.mul_sum, ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib, Finset.sum_div]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Int.cast_sub, Int.cast_mul,
      Int.cast_natCast]
    ring
  have hscale : ∀ X : ℝ, |r * (X / (Q0 * L))| = r * (|X| / (Q0 * L)) := fun X => by
    rw [abs_mul, abs_of_pos hr, abs_div, abs_of_pos hQL]
  have htiny : ∀ X : ℝ, |X| ≤ ε → r * (|X| / (Q0 * L)) ≤ r * ε / (Q0 * L) := fun X hX => by
    rw [mul_div_assoc]
    exact mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right hX hQL.le) hr.le
  have hhuge : ∀ X : ℝ, Λ ≤ |X| → r * Λ / (Q0 * L) ≤ r * (|X| / (Q0 * L)) := fun X hX => by
    rw [mul_div_assoc]
    exact mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right hX hQL.le) hr.le
  refine ⟨P.image (cosetRep K P), fun x => cosetRep K P (expP1 L (Q0 * L) n x), ?_, ?_, ?_, ?_,
    ?_⟩
  · intro u hu i
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hu
    exact hPent _ (cosetRep_spec K P hv).1 i
  · intro u hu u' hu' hne
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨v', hv', rfl⟩ := Finset.mem_image.mp hu'
    exact cosetRep_sub_not_mem K P hv hv' hne
  · intro u hu u' hu' hne
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨v', hv', rfl⟩ := Finset.mem_image.mp hu'
    have hm := cosetRep_sub_not_mem K P hv hv' hne
    have g := (gap_coset ϑ hH hε hgap hsmall _
      (hht2 _ (cosetRep_spec K P hv).1 _ (cosetRep_spec K P hv').1)).2 hm
    have e := hfd (∑ j, γ j) (cosetRep K P v) (cosetRep K P v')
    rw [show -(r * (∑ j, γ j + ∑ i, ((cosetRep K P v) i : ℝ) * (ϑ i / (Q0 * L)))) -
        -(r * (∑ j, γ j + ∑ i, ((cosetRep K P v') i : ℝ) * (ϑ i / (Q0 * L)))) =
        -(r * ((∑ j, γ j + ∑ i, ((cosetRep K P v) i : ℝ) * (ϑ i / (Q0 * L))) -
          (∑ j, γ j + ∑ i, ((cosetRep K P v') i : ℝ) * (ϑ i / (Q0 * L))))) by ring,
      e, abs_neg, hscale]
    exact h1.trans (hhuge _ g)
  · intro x hx hΔ
    have hv : expP1 L (Q0 * L) n x ∈ P := Finset.mem_image_of_mem _ hx
    obtain ⟨hrep, hmem⟩ := cosetRep_spec K P hv
    refine ⟨Finset.mem_image_of_mem _ hv, hmem, ?_, ?_⟩
    · have g := (gap_coset ϑ hH hε hgap hsmall _ (hht2 _ hv _ hrep)).1 hmem
      rw [← mul_sub, hfd, hscale]
      exact htiny _ g
    · have g := (gap_coset ϑ hH hε hgap hsmall _ (hhtΔ x hx)).1 hΔ
      have k := key (expP1 L (Q0 * L) n x) (expP2 L (Q0 * L) n x)
      rw [show r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
          (ϑ i / (Q0 * L))) - ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i,
            (expP1 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L)))) -
          r * (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j - ((l : ℕ) : ℝ) * ∑ j, γ j +
            ∑ i, (m₀ i : ℝ) * (ϑ i / (Q0 * L))) =
          r * ((∑ i, (expP2 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L))) - ((l : ℕ) : ℝ) *
            (∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L))) -
              ∑ i, (m₀ i : ℝ) * (ϑ i / (Q0 * L))) by ring, k, hscale]
      exact htiny _ g
  · intro x hx hΔ
    have g := (gap_coset ϑ hH hε hgap hsmall _ (hhtΔ x hx)).2 hΔ
    have k := key (expP1 L (Q0 * L) n x) (expP2 L (Q0 * L) n x)
    set β := ∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j - ((l : ℕ) : ℝ) * ∑ j, γ j +
      ∑ i, (m₀ i : ℝ) * (ϑ i / (Q0 * L)) with hβ
    set X := ∑ i, ((expP2 L (Q0 * L) n x - ((l : ℕ) : ℤ) • expP1 L (Q0 * L) n x - m₀) i : ℝ) *
      ϑ i with hX
    have eT : r * ((∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
          (ϑ i / (Q0 * L))) - ((l : ℕ) : ℝ) * (∑ j, γ j + ∑ i,
            (expP1 L (Q0 * L) n x i : ℝ) * (ϑ i / (Q0 * L)))) =
        r * β + r * (X / (Q0 * L)) := by rw [← k, hβ]; ring
    rw [eT]
    have h2 := abs_sub_abs_le_abs_sub (r * (X / (Q0 * L))) (-(r * β))
    rw [sub_neg_eq_add, add_comm, abs_neg, hscale] at h2
    have h3 : |r * β| ≤ U := by rw [abs_mul, abs_of_pos hr]; exact hU
    linarith [hhuge _ g]

open Classical in
/-- Blueprint lines 2512-2514 and 2566-2569 (a four-core tuple without reference, discarded): if
every expansion frequency has `ν = max(1, r|q'|, r|t'|) ≥ U₀` (no reference in the full box with
`max(|q'|, |t'|) ≤ U₀ R_s`), every kernel sample is at most `C₁ U₀⁻¹` (`fourK_discard`) and the
local form is at most the numerical errors plus `C₁ U₀⁻¹ |B'| |B|⁴ Π_j Σ_k |c_{j,k}|`. -/
theorem four_core_noref {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) (z : ChartTag) (hd : 1 ≤ z.dim) {δ δ'' : ℝ}
    (hδ : 0 < δ) (hδ'' : 0 < δ'') (ρ : Fin 4 → Fin z.dim → ℝ)
    (hρ : ∀ j a, ρ j a ∈ Set.Icc (0 : ℝ) 1) {Q0 : ℕ} (hQ0 : 0 < Q0)
    (hQ : ∀ a b, ∃ k : ℤ, (Q0 : ℝ) * (z.C a b : ℝ) = k) {Cm : ℝ} (hCm0 : 0 ≤ Cm)
    (hCm : ∀ a b, |(z.C a b : ℝ)| ≤ Cm) {L : ℕ} (hL : 0 < L) (Kt : ℕ) {xs : ℝ}
    (γ : Fin 4 → ℝ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j)) (c : ∀ j, ι j → ℂ)
    (n : ∀ j, ι j → Fin z.dim → ℤ) (f : Fin 4 → ℝ → ℂ)
    (hfi : Integrable (fun zz : ℝ × ℝ => w zz * ∏ j, f j (realProgressionCoordinate j zz)))
    {η : ℝ} (hη : 0 ≤ η)
    (hfa : ∀ j, ∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f j y - ((centerCut z δ (ρ j) y : ℂ) *
      (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) * centerPhase z (ρ j) y) : ℂ)) *
        ((Real.fourierChar (γ j * (y - xs)) : ℂ) * ∑ k ∈ F j, c j k *
          torusCharacter (n j k) (torusMk fun i => z.θ i / (Q0 * L) * (y - xs)))‖ ≤
            η * ∑ k ∈ F j, ‖c j k‖)
    (hfb : ∀ j, ∀ y ∈ Set.Icc a₀ (a₀ + r), ‖f j y‖ ≤ ∑ k ∈ F j, ‖c j k‖) {U₀ : ℝ}
    (hU₀ : 0 < U₀)
    (hnoref : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
        (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
      U₀ ≤ fourNu r (∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L)))
        (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
          (z.θ i / (Q0 * L)))) :
    ‖localProgressionForm r w f‖ ≤
      (2 * localKernelSupBound κ * (4 * η + (8 * z.dim * δ'' * profR δ 1 +
          4 * (1 + cutTail z.dim δ Kt) ^ 3 * cutTail z.dim δ Kt +
          (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt)) +
        fourKC κ 1 * U₀⁻¹ * (frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1))).card *
          (frequencyBox z.dim (2 ^ (Kt + 1))).card ^ 4) * ∏ j, ∑ k ∈ F j, ‖c j k‖ := by
  obtain ⟨cc, cm, hcc, hcm, -, -, hprod⟩ :=
    four_core_product z hd hδ hδ'' ρ hρ hQ0 hQ hCm0 hCm hL
    Kt xs γ F c n f a₀ (a₀ + r) hη hfa hfb
  have hm := mul_nonneg κ.margin_pos.le hr.le
  have hS0 : 0 ≤ ∏ j, ∑ k ∈ F j, ‖c j k‖ :=
    Finset.prod_nonneg fun j _ => Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hEg0 : 0 ≤ 8 * z.dim * δ'' * profR δ 1 + 4 * (1 + cutTail z.dim δ Kt) ^ 3 *
      cutTail z.dim δ Kt + (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt := by
    have := profR_nonneg hδ 1
    have := cutTail_nonneg z.dim hδ Kt
    have : 0 ≤ multTail z.dim δ'' Q0 Cm Kt := by
      unfold multTail; have := profR_nonneg hδ'' (z.dim + z.dim + 1); positivity
    positivity
  have hτ : ∀ x ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)) ×ˢ Fintype.piFinset
      (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j),
      ‖fourK a₀ r w xs (∑ j, γ j + ∑ i, (expP1 L (Q0 * L) n x i : ℝ) * (z.θ i / (Q0 * L)))
        (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
          (z.θ i / (Q0 * L)))‖ ≤ fourKC κ 1 * U₀⁻¹ := fun x hx =>
    fourK_discard hr hw le_rfl xs _ _ hU₀ (Or.inr (hnoref x hx))
  have hb := four_core_cell_bound hr hw f hfi ⊥ (fun i => z.θ i / (Q0 * L)) xs γ
    (frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1))) cm
    (fun q => ((L : ℤ) • fun a => q (Fin.castAdd z.dim a),
      (L : ℤ) • fun a => q (Fin.natAdd z.dim a)))
    (fun j => frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j) (fun j p => cc j p.1 * c j p.2)
    (fun j p => (((Q0 * L : ℕ) : ℤ) • p.1 + n j p.2)) (mul_nonneg (by linarith) hS0)
    (fun zz hzz => hprod zz.1 zz.2 fun j => by
      have := hw.support zz hzz j
      simp only [realProgressionCoordinate] at this
      exact ⟨by linarith [this.1], by linarith [this.2]⟩)
    0 0 (ε := fourKC κ 1 * U₀⁻¹) (τ := fourKC κ 1 * U₀⁻¹)
    (fun x hx _ => by rw [sub_zero]; exact hτ x hx) (fun x hx _ => hτ x hx)
    (Nat.cast_nonneg (frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1))).card)
    (fun u v => truncMult_le_card _ L cm hcm u v)
  rw [norm_zero, zero_mul, zero_add, max_self] at hb
  have hC := expC_sum_le (2 ^ (Kt + 1)) F c cc cm hcc hcm
  rw [sum_box_prod_norm, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin] at hC
  have hτ0 : 0 ≤ fourKC κ 1 * U₀⁻¹ := by
    have := kernelDerivBound_nonneg κ 0
    have := kernelDerivBound_nonneg κ 1
    have : 0 ≤ U₀⁻¹ := inv_nonneg.mpr hU₀.le
    unfold fourKC
    positivity
  refine hb.trans ?_
  calc _ ≤ 2 * localKernelSupBound κ * ((4 * η + (8 * z.dim * δ'' * profR δ 1 +
          4 * (1 + cutTail z.dim δ Kt) ^ 3 * cutTail z.dim δ Kt +
          (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt)) * ∏ j, ∑ k ∈ F j, ‖c j k‖) +
        fourKC κ 1 * U₀⁻¹ * ((frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1))).card *
          ((frequencyBox z.dim (2 ^ (Kt + 1))).card ^ 4 * ∏ j, ∑ k ∈ F j, ‖c j k‖)) :=
        add_le_add le_rfl (mul_le_mul_of_nonneg_left hC hτ0)
    _ = _ := by ring

