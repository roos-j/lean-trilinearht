theorem role_tiny_huge_of_gap {d : ℕ} (ϑ : Fin d → ℝ) {Hh : ℕ} (hH : 1 ≤ Hh) {ε Λ : ℝ}
    (hε : 0 ≤ ε)
    (hgap : ∀ a : Fin d → ℚ, vecHeight a ≤ Hh → |ratEval ϑ a| ≤ ε ∨ Λ ≤ |ratEval ϑ a|)
    (hsmall : (3 * Hh ^ 2 : ℝ) ^ d * (d.factorial * Hh ^ (d ^ 2 + d)) * ε < Λ)
    {r QL : ℝ} (hr : 0 < r) (hQL : 0 < QL) {ι : Type*} (F : Finset ι) (n : ι → Fin d → ℤ)
    (hh : ∀ k ∈ F, ∀ k' ∈ F, vecHeight (fun i => ((n k - n k') i : ℚ)) ≤ Hh)
    (hεΛ : 2 / (2 * Real.pi * r * ε / QL) ≤ 2 * Real.pi * r * Λ / QL) :
    (∀ k ∈ F, ∀ k' ∈ F, n k - n k' ∈ rationalIntegerIntersection (tinySpan ϑ Hh ε) →
      |2 * Real.pi * r * ∑ i, (n k i : ℝ) * (ϑ i / QL) -
        2 * Real.pi * r * ∑ i, (n k' i : ℝ) * (ϑ i / QL)| ≤ 2 * Real.pi * r * ε / QL) ∧
    (∀ k ∈ F, ∀ k' ∈ F, n k - n k' ∉ rationalIntegerIntersection (tinySpan ϑ Hh ε) →
      2 / (2 * Real.pi * r * ε / QL) ≤ |2 * Real.pi * r * ∑ i, (n k i : ℝ) * (ϑ i / QL) -
        2 * Real.pi * r * ∑ i, (n k' i : ℝ) * (ϑ i / QL)|) := by
  have e : ∀ k k', 2 * Real.pi * r * ∑ i, (n k i : ℝ) * (ϑ i / QL) -
      2 * Real.pi * r * ∑ i, (n k' i : ℝ) * (ϑ i / QL) =
      2 * Real.pi * r * (∑ i, ((n k - n k') i : ℝ) * ϑ i) / QL := fun k k' => by
    rw [← mul_sub, ← Finset.sum_sub_distrib, mul_div_assoc, Finset.sum_div]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [Pi.sub_apply, Int.cast_sub]
