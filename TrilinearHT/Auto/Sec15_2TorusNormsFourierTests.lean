    (hsmall : (3 * D.SP.Hn ^ 2 : ℝ) ^ (D.Ms l G).zc.dim * ((D.Ms l G).zc.dim.factorial *
      D.SP.Hn ^ ((D.Ms l G).zc.dim ^ 2 + (D.Ms l G).zc.dim)) *
