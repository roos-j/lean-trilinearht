theorem core_torus_role (hK1 : 1 ≤ D.S.K) {I : ℤ × ℤ} (j : Fin 4) (G : A.Grp) (z : ChartTag)
    (hz : (D.Ms j G).zc = z) {δ : ℝ} (hδc : (D.Ms j G).δc = δ)
    (hcl : (D.Ms j G).cl = slotCoeff j) (hρ : ∀ k, (D.Ms j G).ρ k ∈ Set.Icc (0 : ℝ) 1)
    {Bc Λ : ℝ}
    (hcount : ∀ y, ((Finset.univ.filter fun m => y ∈ dyadicGridCell A.G
      ((D.Ms j G).cellOf m).1 ((D.Ms j G).cellOf m).2).card : ℝ) ≤ Bc)
    (hΛ : (D.Ms j G).Λ ≤ Λ) (hΛ0 : 0 ≤ Λ) (h : ℕ) (a : (D.Ms j G).alive (D.decCell I))
    (F : Finset ((D.Ms j G).alive (D.decCell I)))
    (hF : F ⊆ ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).E h a)
    {xs : ℝ} (hxs : xs ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1)) :
    ∃ ρ' : Fin z.dim → ℝ, (∀ k, ρ' k ∈ Set.Icc (0 : ℝ) 1) ∧
    ∃ n : (D.Ms j G).alive (D.decCell I) → Fin z.dim → ℤ,
      (∀ m ∈ F, ∀ i, |(n m i : ℝ)| ≤
        Fintype.card ((D.Ms j G).alive (D.decCell I)) * D.S.Eh h) ∧
      (∀ y ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
          (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1),
        ‖∑ m ∈ F, D.c j G (D.blockOf I.1) (D.preCell I) m.1 * (D.Ms j G).wave m.1 y -
          ((centerCut z δ ρ' y : ℂ) * (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) *
            centerPhase z ρ' y) : ℂ)) *
          ((Real.fourierChar ((D.Ms j G).slope a.1 xs * (y - xs)) : ℂ) *
            ∑ m ∈ F, D.selC j G I xs m *
              torusCharacter (n m) (torusMk fun i => D.xiH z h i * (y - xs)))‖ ≤
          2 * Real.pi * (Bc * D.S.Ξ * (2 : ℝ)⁻¹ ^ (2 * D.S.K) + Λ * (2 : ℝ)⁻¹ ^ (8 * D.S.K)) *
            ∑ m ∈ F, ‖D.selC j G I xs m‖) ∧
      (∀ y, ‖∑ m ∈ F, D.c j G (D.blockOf I.1) (D.preCell I) m.1 * (D.Ms j G).wave m.1 y‖ ≤
        ∑ m ∈ F, ‖D.selC j G I xs m‖) := by
