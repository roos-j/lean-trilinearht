open Classical in
/-- The candidate references of a three-core tuple (blueprint line 2537): the `m` in the full box
with `r |T_l + m·ξ| ≤ U₀`. -/
noncomputable def refSet3 (h' : ℕ) (l : Fin 4) (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I))
    (xs : ℝ) (Bf : ℕ) : Finset (Fin Cd.z.dim → ℤ) :=
  (frequencyBox Cd.z.dim Bf).filter fun m =>
    dyadicGridLength A.G I.1 * |D.refT3 G I l a xs + ∑ i, (m i : ℝ) * D.xiH Cd.z h' i| ≤ Cd.U₀

/-- The reference of a three-core tuple chosen by a fixed rule. -/
noncomputable def refPick3 (h' : ℕ) (l : Fin 4) (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I))
    (xs : ℝ) (Bf : ℕ) : Fin Cd.z.dim → ℤ :=
  finPick (Cd.refSet3 h' l a xs Bf)

/-- The anchored reference frequency `β = T_l + m·ξ` (blueprint line 2537, `β = r(T_l + m·ξ)`
before scaling). -/
noncomputable def beta3 (h' : ℕ) (l : Fin 4) (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I))
    (xs : ℝ) (Bf : ℕ) : ℝ :=
  D.refT3 G I l a xs + ∑ i, ((Cd.refPick3 h' l a xs Bf) i : ℝ) * D.xiH Cd.z h' i

open Classical in
/-- The three-core test (blueprint line 2537): a reference exists and `r|β| ≥ U₀⁻¹`. -/
def passes3 (h' : ℕ) (l : Fin 4) (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) (xs : ℝ)
    (Bf : ℕ) : Prop :=
  (Cd.refSet3 h' l a xs Bf).Nonempty ∧
    Cd.U₀⁻¹ ≤ dyadicGridLength A.G I.1 * |Cd.beta3 h' l a xs Bf|

/-- The data of the three-core estimate on the cell (blueprint lines 2536-2565): the offset average
conditions, the derivative order `J ≥ 2`, the shell parameters `A_w`, `I_w` of the side windows, and
the reserves of the three-core cosets (`three_coset_of_gap`: box `B_p`, separation `rΛ/(Q₀L) ≥ 1`,
far threshold `rΛ/(Q₀L) - U₀ ≥ 4`, `U₀ ≥ 4`). -/
structure ThreeData where
  hdδ : 8 * Cd.z.dim * Cd.δ ≤ 1
  hδ8 : Cd.δ ≤ 1 / 8
  J3 : ℕ
  hJ3 : 2 ≤ J3
  Aw : ℕ
  Iw : ℕ
  hHb3 : ∀ h' ≤ D.SP.Jst, 4 * (((6 ^ h' : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) +
    4 * (3 * (((D.S.Q0 * 6 ^ h' : ℕ) : ℝ) * ((2 ^ (Cd.Kt + 1) : ℕ) : ℝ) + Cd.Nb))) + Cd.Bp ≤ Cd.Hh
  hsep1 : ∀ h' ≤ D.SP.Jst, 1 ≤ dyadicGridLength A.G I.1 * Cd.Λg / (D.S.Q0 * ((6 ^ h' : ℕ) : ℝ))
  hH4 : ∀ h' ≤ D.SP.Jst,
    4 ≤ dyadicGridLength A.G I.1 * Cd.Λg / (D.S.Q0 * ((6 ^ h' : ℕ) : ℝ)) - Cd.U₀
  hU4 : 4 ≤ Cd.U₀

open Classical in
/-- Blueprint lines 2489-2491: the parts of a family of core components in different minimal
CURRENT components are distinct and not PRE-adjacent at height zero on the cell. -/
theorem unitPart_nonadj (hK1 : 1 ≤ D.S.K) (j : Fin 4) (hΛΞ : 8 * (D.Ms j G).Λ ≤ D.S.Ξ)
    {M : Finset (Finset (D.Ms j G).Md)}
    (hMj : M ⊆ (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) :
    ∀ i ∈ M.image ((D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) 0),
      ∀ i' ∈ M.image ((D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) 0), i ≠ i' →
      ∀ m ∈ unitPart (I := I) j M i, ∀ m' ∈ unitPart (I := I) j M i',
        m ≠ m' ∧ ¬ (D.Ms j G).pre0Edge D.S I m m' := by
  have hdis := unitPart_disjoint (I := I) j hMj
  intro i hi i' hi' hii' m hm m' hm'
  refine ⟨fun hmm => ?_, ?_⟩
  · subst hmm
    exact Finset.disjoint_left.mp (hdis hi hi' hii') hm hm'
  obtain ⟨K, hK, hmK⟩ := Finset.mem_biUnion.mp hm
  obtain ⟨K', hK', hmK'⟩ := Finset.mem_biUnion.mp hm'
  obtain ⟨hKM, hKi⟩ := Finset.mem_filter.mp hK
  obtain ⟨hK'M, hK'i⟩ := Finset.mem_filter.mp hK'
  have hKall := (Finset.mem_sdiff.mp (hMj hKM)).1
  have hK'all := (Finset.mem_sdiff.mp (hMj hK'M)).1
  obtain ⟨x, -, hxK⟩ := Finset.mem_image.mp hKall
  obtain ⟨x', -, hxK'⟩ := Finset.mem_image.mp hK'all
  have hmK2 := hmK
  have hmK'2 := hmK'
  rw [← hxK] at hmK2
  rw [← hxK'] at hmK'2
  obtain ⟨z, -, rfl⟩ := Finset.mem_map.mp hmK2
  obtain ⟨z', -, rfl⟩ := Finset.mem_map.mp hmK'2
  refine D.not_pre0Edge_of_not_mem_F hK1 I j G hΛΞ (m := z) (m' := z') fun hzz => ?_
  apply hii'
  have e1 := (D.Ms j G).compClass_eq_of_mem D.S D.hA _ _ 0 hKall (z := z) hmK
  have e2 := (D.Ms j G).compClass_eq_of_mem D.S D.hA _ _ 0 hK'all (z := z') hmK'
  have hF : ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).F 0 z' =
      ((D.Ms j G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).F 0 z :=
    ((D.Ms j G).blockComps D.S D.hA _ _).F_comp 0 z z' hzz
  rw [← hKi, ← hK'i]
  change (D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) 0 K =
    (D.Ms j G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) 0 K'
  rw [e1, e2, hF]

