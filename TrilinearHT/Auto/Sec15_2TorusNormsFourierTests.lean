omit hw in
/-- The kernel transform as an iterated integral of the phase-weighted kernel. -/
theorem kernelFT_eq_iter (q t : ℝ) :
    kernelFT w q t = ∫ s, ∫ x, (Real.fourierChar (-(s * t)) : ℂ) *
