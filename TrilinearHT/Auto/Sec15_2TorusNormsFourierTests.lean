open Classical in
/-- The part of a family of components inside a minimal CURRENT component `i`. -/
noncomputable def unitPart (l : Fin 4) (M : Finset (Finset (D.Ms l G).Md))
    (i : Finset (D.Ms l G).Md) : Finset (D.Ms l G).Md :=
  (M.filter fun K =>
    (D.Ms l G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) 0 K = i).biUnion id

open Classical in
/-- The parts of a family of core components in distinct minimal CURRENT components are
disjoint. -/
theorem unitPart_disjoint (l : Fin 4) {M : Finset (Finset (D.Ms l G).Md)}
    (hM : M ⊆ (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I)) :
    Set.PairwiseDisjoint ((M.image ((D.Ms l G).compClass D.S D.hA (D.blockOf I.1)
      (D.preCell I) 0) : Finset (Finset (D.Ms l G).Md)) : Set (Finset (D.Ms l G).Md))
      (unitPart (I := I) l M) := by
  intro i _ i' _ hii'
  unfold unitPart
  rw [Function.onFun, Finset.disjoint_biUnion_left]
  intro K hK
  rw [Finset.disjoint_biUnion_right]
  intro K' hK'
  obtain ⟨hKM, hKi⟩ := Finset.mem_filter.mp hK
  obtain ⟨hK'M, hK'i⟩ := Finset.mem_filter.mp hK'
  have hne : K ≠ K' := fun h => hii' (by rw [← hKi, ← hK'i, h])
  exact (D.Ms l G).coreComps_pairwiseDisjoint D.S D.hA D.SP _ _ (hM hKM) (hM hK'M) hne

