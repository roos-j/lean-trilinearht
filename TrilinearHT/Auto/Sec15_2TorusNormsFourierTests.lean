            (∑ j, γ j + ∑ i, (p₀.1 i : ℝ) * (ϑ i / (Q0 * L)))| ≤ r * ε / (Q0 * L) ∧
          r * |(∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (expP2 L (Q0 * L) n x i : ℝ) *
              (ϑ i / (Q0 * L))) -
            (∑ j : Fin 4, ((j : ℕ) : ℝ) * γ j + ∑ i, (p₀.2 i : ℝ) * (ϑ i / (Q0 * L)))| ≤
            r * ε / (Q0 * L)) ∧
