/-- The four-core test quantity `μ = min(1, min_{0 ≤ j ≤ 3} r |t' - j q'|)` of `eq:four-tests`. -/
noncomputable def fourMu (r A B : ℝ) : ℝ :=
  min 1 (((Finset.univ : Finset (Fin 4)).image fun j : Fin 4 => (j : ℝ)).inf'
    ⟨0, Finset.mem_image.mpr ⟨0, Finset.mem_univ _, by simp⟩⟩ fun j => r * |B - j * A|)

/-- The four-core test quantity `ν = max(1, r |q'|, r |t'|)` of `eq:four-tests`. -/
noncomputable def fourNu (r A B : ℝ) : ℝ := max 1 (max (r * |A|) (r * |B|))

/-- The constant `C_J` of `fourK_mu_nu`. -/
noncomputable def fourKC (κ : LocalKernelClass) (J : ℕ) : ℝ :=
  2 * (2 * 4 * (2 * 4 * (kernelDerivBound κ 0 +
    ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))) + (3 + 2) ^ J *
    (2 * 4 * (2 * Real.pi * 4 * (2 * (4 + 3 * 4) * (kernelDerivBound κ 0 +
      ((2 * Real.pi) ^ J)⁻¹ * kernelDerivBound κ J))))

theorem fourMu_le_one (r A B : ℝ) : fourMu r A B ≤ 1 := min_le_left _ _

theorem one_le_fourNu (r A B : ℝ) : 1 ≤ fourNu r A B := le_max_left _ _

/-- Blueprint lines 2566-2569 (discarded four-core tuples): if the inner minimum is below `U₀⁻¹`
(`μ ≤ U₀⁻¹`) or no reference lies in `max(|q'|, |t'|) ≤ U₀ R_s` (`ν ≥ U₀`), the kernel sample at
the reference is at most `C_J U₀⁻¹` (`fourK_mu_nu` with `J ≥ 1`). -/
theorem fourK_discard {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) {J : ℕ} (hJ : 1 ≤ J) (x₀ A B : ℝ) {U₀ : ℝ}
    (hU : 0 < U₀) (hd : fourMu r A B ≤ U₀⁻¹ ∨ U₀ ≤ fourNu r A B) :
    ‖fourK a₀ r w x₀ A B‖ ≤ fourKC κ J * U₀⁻¹ := by
  have h := fourK_mu_nu hr hw J x₀ A B
  change ‖fourK a₀ r w x₀ A B‖ * fourNu r A B ^ J ≤ fourKC κ J * fourMu r A B at h
  have hν := one_le_fourNu r A B
  have hC : 0 ≤ fourKC κ J := by
    have := kernelDerivBound_nonneg κ 0
    have := kernelDerivBound_nonneg κ J
    unfold fourKC
    positivity
  have hνJ : fourNu r A B ≤ fourNu r A B ^ J := le_self_pow₀ hν (by omega)
  have hK0 := norm_nonneg (fourK a₀ r w x₀ A B)
  rcases hd with hd | hd
  · calc ‖fourK a₀ r w x₀ A B‖ ≤ ‖fourK a₀ r w x₀ A B‖ * fourNu r A B ^ J :=
          le_mul_of_one_le_right hK0 (one_le_pow₀ hν)
      _ ≤ fourKC κ J * fourMu r A B := h
      _ ≤ fourKC κ J * U₀⁻¹ := mul_le_mul_of_nonneg_left hd hC
  · have hpos : 0 < fourNu r A B := lt_of_lt_of_le one_pos hν
    have h1 : ‖fourK a₀ r w x₀ A B‖ * fourNu r A B ≤ fourKC κ J :=
      (mul_le_mul_of_nonneg_left hνJ hK0).trans (h.trans
        (mul_le_of_le_one_right hC (fourMu_le_one r A B)))
    calc ‖fourK a₀ r w x₀ A B‖ ≤ fourKC κ J / fourNu r A B := by
          rw [le_div_iff₀ hpos]; exact h1
      _ ≤ fourKC κ J * U₀⁻¹ := by
          rw [div_eq_mul_inv]
          exact mul_le_mul_of_nonneg_left (inv_anti₀ hU hd) hC

/-- The truncated core torus function `g_j` is bounded by `M Σ_k |c_k|` when the truncated cutoff is
bounded by `M` on the torus. -/
theorem coreG_norm_le {d : ℕ} (QL Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) (cc : Fin 4 → (Fin d → ℤ) → ℂ) (j : Fin 4)
    {M : ℝ} (hM : 0 ≤ M)
    (hsup : ∀ u, ‖∑ v ∈ frequencyBox d Bx, cc j v * torusCharacter ((QL : ℤ) • v) u‖ ≤ M)
    (u : StandardTorus d) :
    ‖coreG QL Bx F c n cc j u‖ ≤ M * ∑ k ∈ F j, ‖c j k‖ := by
  rw [coreG_factor, norm_mul]
  refine mul_le_mul (hsup u) ((norm_sum_le _ _).trans (Finset.sum_le_sum fun k _ => ?_))
    (norm_nonneg _) hM
  rw [norm_mul, norm_torusCharacter, mul_one]

/-- The `L²(𝓗)` norm of `g_j` is at most its supremum bound `M Σ_k |c_k|` (Haar probability). -/
theorem coreG_L2_le {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) (QL Bx : ℕ) {ι : Fin 4 → Type*}
    (F : ∀ j, Finset (ι j)) (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ)
    (cc : Fin 4 → (Fin d → ℤ) → ℂ) (j : Fin 4) {M : ℝ} (hM : 0 ≤ M)
    (hsup : ∀ u, ‖∑ v ∈ frequencyBox d Bx, cc j v * torusCharacter ((QL : ℤ) • v) u‖ ≤ M) :
    (eLpNorm (fun u : torusAnnihilator (rationalIntegerIntersection V) =>
        coreG QL Bx F c n cc j u) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      M * ∑ k ∈ F j, ‖c j k‖ := by
  have hS : 0 ≤ M * ∑ k ∈ F j, ‖c j k‖ :=
    mul_nonneg hM (Finset.sum_nonneg fun _ _ => norm_nonneg _)
  refine ENNReal.toReal_le_of_le_ofReal hS ?_
  refine (eLpNorm_le_of_ae_bound (f := fun u : torusAnnihilator (rationalIntegerIntersection V) =>
      coreG QL Bx F c n cc j u) (Continuous.aestronglyMeasurable (by
      unfold coreG
      exact continuous_finsetSum _ fun p _ => continuous_const.mul
        ((continuous_torusCharacter _).comp continuous_subtype_val)))
    (Filter.Eventually.of_forall fun u =>
    coreG_norm_le QL Bx F c n cc j hM hsup u)).trans (le_of_eq ?_)
  simp

/-- The absolute coefficient sum over the full box: `Σ_x Π_j |c_j(x_j)| = |B'| Π_j (|B| Σ_k |c_k|)`.
-/
theorem sum_box_prod_norm {d : ℕ} (Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) :
    ∑ x ∈ frequencyBox (d + d) Bx ×ˢ Fintype.piFinset (fun j => frequencyBox d Bx ×ˢ F j),
        ∏ j, ‖c j (x.2 j).2‖ =
      (frequencyBox (d + d) Bx).card *
        ∏ j, ((frequencyBox d Bx).card * ∑ k ∈ F j, ‖c j k‖) := by
  rw [Finset.sum_product]
  simp only
  rw [Finset.sum_const, nsmul_eq_mul,
    ← Finset.prod_univ_sum (t := fun j => frequencyBox d Bx ×ˢ F j) (f := fun j q => ‖c j q.2‖)]
  congr 1
  refine Finset.prod_congr rfl fun j _ => ?_
  rw [Finset.sum_product, Finset.mul_sum]
  simp [Finset.sum_const, Finset.mul_sum]

/-- Blueprint lines 2566-2569 (`eq:core-numerical`, four cores): the numerical, coset-replacement
and tail errors of `four_core_principal` are at most `(2 K (4η + E_g) + M |B'| |B|⁴) Π_j Σ_m |α_m|`
(the precision factor times the absolute coefficient products). -/
theorem four_core_errors_le {d : ℕ} (Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) (cc : Fin 4 → (Fin d → ℤ) → ℂ) (cm : (Fin (d + d) → ℤ) → ℂ)
    (hcc : ∀ j v, ‖cc j v‖ ≤ 1) (hcm : ∀ v, ‖cm v‖ ≤ 1) {K E M : ℝ} (hM : 0 ≤ M) :
    2 * K * (E * ∏ j, ∑ k ∈ F j, ‖c j k‖) +
      M * ∑ x ∈ frequencyBox (d + d) Bx ×ˢ Fintype.piFinset
        (fun j => frequencyBox d Bx ×ˢ F j), ‖cm x.1 * ∏ j, (cc j (x.2 j).1 * c j (x.2 j).2)‖ ≤
      (2 * K * E + M * (frequencyBox (d + d) Bx).card * (frequencyBox d Bx).card ^ 4) *
        ∏ j, ∑ k ∈ F j, ‖c j k‖ := by
  have h := mul_le_mul_of_nonneg_left (expC_sum_le Bx F c cc cm hcc hcm) hM
  rw [sum_box_prod_norm, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ,
    Fintype.card_fin] at h
  nlinarith [h]

/-- Blueprint lines 2566-2569 (discarded four-core tuples): when `μ ≤ U₀⁻¹` or `ν ≥ U₀`, the
retained coset term `|Ŵ_s(r q', r t')| W Π_j ‖g_j‖₂` is at most
`C_J U₀⁻¹ W Π_j (1 + τ_c) Σ_m |α_m|`. -/
theorem four_core_discard {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) {J : ℕ} (hJ : 1 ≤ J) (x₀ A B : ℝ) {U₀ : ℝ}
    (hU : 0 < U₀) (hd : fourMu r A B ≤ U₀⁻¹ ∨ U₀ ≤ fourNu r A B) {d : ℕ}
    (V : Submodule ℚ (Fin d → ℚ)) (QL Bx : ℕ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin d → ℤ) (cc : Fin 4 → (Fin d → ℤ) → ℂ) {τ : ℝ}
    (hτ : 0 ≤ τ)
    (hsup : ∀ j u, ‖∑ v ∈ frequencyBox d Bx, cc j v * torusCharacter ((QL : ℤ) • v) u‖ ≤ 1 + τ)
    {W : ℝ} (hW : 0 ≤ W) :
    ‖fourK a₀ r w x₀ A B‖ * (W * ∏ j : Fin 4, (eLpNorm (fun u : torusAnnihilator
        (rationalIntegerIntersection V) => coreG QL Bx F c n cc j u) 2
        (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal) ≤
      fourKC κ J * U₀⁻¹ * (W * ∏ j, ((1 + τ) * ∑ k ∈ F j, ‖c j k‖)) := by
  have hP : ∏ j : Fin 4, (eLpNorm (fun u : torusAnnihilator
      (rationalIntegerIntersection V) => coreG QL Bx F c n cc j u) 2
      (torusAnnihilatorHaar (rationalIntegerIntersection V))).toReal ≤
      ∏ j, ((1 + τ) * ∑ k ∈ F j, ‖c j k‖) :=
    Finset.prod_le_prod₀ (fun _ _ => ENNReal.toReal_nonneg) fun j _ =>
      coreG_L2_le V QL Bx F c n cc j (by linarith) (hsup j)
  exact mul_le_mul (fourK_discard hr hw hJ x₀ A B hU hd) (mul_le_mul_of_nonneg_left hP hW)
    (mul_nonneg hW (Finset.prod_nonneg fun _ _ => ENNReal.toReal_nonneg))
    (le_trans (norm_nonneg _) (fourK_discard hr hw hJ x₀ A B hU hd))

/-- Blueprint lines 2566-2569 (discarded three-core tuples): when `|β| ≤ U₀⁻¹` or `|β| ≥ U₀`, the
anchor entry constant `C_{J,A} μ ν^{-J}` of `three_core_principal` is at most
`C_{J,A} U₀⁻¹` (`J ≥ 1`). -/
theorem entryC_discard {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) {J : ℕ} (hJ : 1 ≤ J) (A : ℕ) {b U₀ : ℝ}
    (hU : 0 < U₀) (hd : |b| ≤ U₀⁻¹ ∨ U₀ ≤ |b|) :
    entryC κ J A b ≤ kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * 2 ^ (A + 2) * U₀⁻¹ := by
  have hk := kerC_nonneg hr hw (J + (A + 2))
  have hC : 0 ≤ kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) := by positivity
  have hν : 1 ≤ max 1 |b| := le_max_left _ _
  have hpos : 0 < max 1 |b| := lt_of_lt_of_le one_pos hν
  have key : min 1 |b| / max 1 |b| ^ J ≤ U₀⁻¹ := by
    rcases hd with hd | hd
    · exact (div_le_self (le_min zero_le_one (abs_nonneg _)) (one_le_pow₀ hν)).trans
        ((min_le_right _ _).trans hd)
    · rw [div_le_iff₀ (pow_pos hpos J)]
      have h1 : max 1 |b| ≤ max 1 |b| ^ J := le_self_pow₀ hν (by omega)
      have h2 : U₀ ≤ max 1 |b| := hd.trans (le_max_right _ _)
      calc min 1 |b| ≤ 1 := min_le_left _ _
        _ = U₀⁻¹ * U₀ := (inv_mul_cancel₀ hU.ne').symm
        _ ≤ U₀⁻¹ * max 1 |b| ^ J :=
            mul_le_mul_of_nonneg_left (h2.trans h1) (inv_nonneg.mpr hU.le)
  unfold entryC
  calc kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * min 1 |b| / max 1 |b| ^ J * 2 ^ (A + 2)
      = kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * (min 1 |b| / max 1 |b| ^ J) *
          2 ^ (A + 2) := by ring
    _ ≤ kerC κ (J + (A + 2)) * (3 + 2) ^ (J + (A + 2)) * U₀⁻¹ * 2 ^ (A + 2) := by
        gcongr
    _ = _ := by ring

