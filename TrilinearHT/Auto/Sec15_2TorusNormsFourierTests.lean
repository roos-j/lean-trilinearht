  have hIJ := subset_ancAt A.G I (show D.blockOf I.1 - 2 * D.S.K ≤ I.1 by omega)
  have hU0 := dyadicGridLength_pos A.G (D.decCell I).1
  obtain ⟨ρ', hρ', hgauge, n, hn, happ, hbd⟩ := (D.Ms j G).role_input_approx D.S D.hA z hz
    (b := D.blockOf I.1) (J := D.preCell I)
    (by change D.blockOf I.1 - 2 * D.S.K ≤ D.blockOf I.1 + D.S.K; omega) a F hF
    (fun m => D.c j G (D.blockOf I.1) (D.preCell I) m.1)
    (Λ := Λ / dyadicGridLength A.G (D.decCell I).1 ^ 2)
    (fun m _ => ((D.Ms j G).lam_le_of_alive m).trans
      (div_le_div_of_nonneg_right hΛ (by positivity)))
    (Icc_subset_of_cell_subset hIJ hxs)
    (fun y hy => D.core_torus_eta hK1 I j G hcount hΛ0 hxs hy)
  refine ⟨ρ', fun k => ?_, n, hn, fun y hy => ?_, hbd⟩
  · obtain ⟨k', hk'⟩ := hρ' k
    rw [hk']; exact hρ k'
  · have e := happ y hy
    rw [hδc, hcl] at e
    have h6 : ((6 ^ h : ℕ) : ℝ) = 6 ^ h := by push_cast; rfl
    unfold xiH selC
    rw [h6]
    exact e

/-- The selected coefficients of a three-core tuple on the attempt (`1` on the side term). -/
noncomputable def c3 (G : A.Grp) (I : ℤ × ℤ) (xs : ℝ) :
    ∀ j, Option ((D.Ms j G).alive (D.decCell I)) → ℂ :=
  sideOptC fun j => D.selC j G I xs

/-- The reference slopes `γ_j = ω_{a_j}(x*)` of the cores, `0` on the side role `l`. -/
noncomputable def refγ3 (G : A.Grp) (I : ℤ × ℤ) (xs : ℝ) (l : Fin 4)
    (a : ∀ j, j ≠ l → (D.Ms j G).alive (D.decCell I)) : Fin 4 → ℝ :=
  fun j => if hj : j = l then 0 else (D.Ms j G).slope (a j hj).1 xs

/-- The selected wave sum of a core role on the pre-cell. -/
noncomputable def coreSum (j : Fin 4) (G : A.Grp) (I : ℤ × ℤ)
    (F : Finset ((D.Ms j G).alive (D.decCell I))) : ℝ → ℂ :=
  fun y => ∑ m ∈ F, D.c j G (D.blockOf I.1) (D.preCell I) m.1 * (D.Ms j G).wave m.1 y

