  {D : ap.LeafSplit}

namespace CellCoreData
variable {I : ℤ × ℤ} {G : A.Grp} (Cd : D.CellCoreData I G)

open Classical in
/-- The candidate references of a four-core tuple (blueprint lines 2504-2508): the pairs `(n, m)`
in the full box `|n|_∞, |m|_∞ ≤ B'` with `r|Q + n·ξ|, r|T + m·ξ| ≤ U₀`, at the torus height `h'`,
for the representatives `a` and the path point `x*`. -/
noncomputable def refSet (h' : ℕ) (a : ∀ j, (D.Ms j G).alive (D.decCell I)) (xs : ℝ)
    (Bf : ℕ) : Finset ((Fin Cd.z.dim → ℤ) × (Fin Cd.z.dim → ℤ)) :=
  (frequencyBox Cd.z.dim Bf ×ˢ frequencyBox Cd.z.dim Bf).filter fun q =>
    dyadicGridLength A.G I.1 * |D.refQ G I xs a + ∑ i, (q.1 i : ℝ) * D.xiH Cd.z h' i| ≤ Cd.U₀ ∧
    dyadicGridLength A.G I.1 * |D.refT G I xs a + ∑ i, (q.2 i : ℝ) * D.xiH Cd.z h' i| ≤ Cd.U₀

/-- The reference of a four-core tuple chosen by a fixed rule (blueprint line 2508). -/
noncomputable def refPick (h' : ℕ) (a : ∀ j, (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ) :
    (Fin Cd.z.dim → ℤ) × (Fin Cd.z.dim → ℤ) :=
  finPick (Cd.refSet h' a xs Bf)

/-- The test frequencies `q' = Q + n·ξ`, `t' = T + m·ξ` at the chosen reference. -/
noncomputable def refQ' (h' : ℕ) (a : ∀ j, (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ) :
    ℝ :=
  D.refQ G I xs a + ∑ i, ((Cd.refPick h' a xs Bf).1 i : ℝ) * D.xiH Cd.z h' i

noncomputable def refT' (h' : ℕ) (a : ∀ j, (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ) :
    ℝ :=
  D.refT G I xs a + ∑ i, ((Cd.refPick h' a xs Bf).2 i : ℝ) * D.xiH Cd.z h' i

open Classical in
/-- The four-core test (blueprint lines 2508-2509): a reference exists and the inner minimum is at
least `U₀⁻¹`. -/
def passes (h' : ℕ) (a : ∀ j, (D.Ms j G).alive (D.decCell I)) (xs : ℝ) (Bf : ℕ) : Prop :=
  (Cd.refSet h' a xs Bf).Nonempty ∧
    Cd.U₀⁻¹ ≤ fourMu (dyadicGridLength A.G I.1) (Cd.refQ' h' a xs Bf) (Cd.refT' h' a xs Bf)

end CellCoreData

