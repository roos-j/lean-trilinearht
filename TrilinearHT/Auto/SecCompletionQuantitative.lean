/-- The physical part of the error of the leaf split has energy at most that of the physical
lift error of the decision-cell output on the cell. -/
theorem err_phys_norm_sq_le (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc)) :
    ‖physEmbed (Fin ap.Mc) (Fin ap.Mc) (D.err l G I ZU)‖ ^ 2 ≤
      ∫ y in dyadicGridCell A.G I.1 I.2, ‖(ZU : ℝ → ColumnHilbert (Fin ap.Mc)) y none -
        ((D.Ms l G).L.op ZU : ℝ → ColumnHilbert (D.Ms l G).Md) y none‖ ^ 2 := by
