/-- The squared physical coordinate of an `L²` column function is measurable. -/
theorem measurable_physCoord_sq {V : Type*} [Fintype V] (x : ColumnL2 V) :
    Measurable fun y => ‖(x : ℝ → ColumnHilbert V) y none‖ ^ 2 := by
  have h : Measurable (x : ℝ → ColumnHilbert V) := (Lp.stronglyMeasurable x).measurable
  exact ((continuous_apply none).measurable.comp
    ((PiLp.continuous_ofLp 2 _).measurable.comp h)).norm.pow_const 2

