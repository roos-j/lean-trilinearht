section PieceBand

/-- Blueprint lines 2421-2445 (`eq:near-band` on one short-block piece): with the first side stack
indexed by positions and bands, the second side stack by positions and the complementary band
stack by bands, the cell sum of the matched band forms (positions selected at each use, arbitrary
signs) is bounded by the short-block constant times the stack sizes. -/
theorem piece_band_bound (κ : LocalKernelClass) {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) :
    ∃ Cq : ℝ, 0 ≤ Cq ∧ ∀ (G : RealDyadicGrid) (K Nd : ℕ), K ≤ Nd →
      ∀ (T : ShortBlockTree G K) {ι κ' ν : Type} [DecidableEq ι] [DecidableEq κ']
        [DecidableEq ν] (s : Finset ι) (t : Finset κ') (u : Finset ν) {a b c : Fin 4},
      a ≠ b → a ≠ c → b ≠ c →
      ∀ (f : Fin 4 → ℝ → ℂ) (x : ι → ν → ℝ → ℂ) (w : κ' → ℝ → ℂ) (y : ν → ℝ → ℂ),
      (∀ j, Measurable (f j)) → (∀ i p, Measurable (x i p)) → (∀ k, Measurable (w k)) →
      (∀ p, Measurable (y p)) →
      ∀ (kernel : ℤ × ℤ → ℝ × ℝ → ℂ), (∀ I ∈ T.internal, IsAdmissibleLocalKernel κ
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (kernel I)) →
      ∀ cells ⊆ T.internal,
      (∀ I ∈ cells, ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ I ∈ cells, ∀ i p, eLpNorm (x i p) 2 (normalizedIntervalMeasure
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ I ∈ cells, ∀ k, eLpNorm (w k) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ I ∈ cells, ∀ p, eLpNorm (y p) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≠ ⊤) →
      ∀ sv : Fin 4 → ℝ, (∀ j, 0 ≤ sv j) →
      (∀ L ∈ T.leaves, ∫⁻ z in dyadicGridCell G L.1 L.2,
        ENNReal.ofReal (∑ i ∈ s, ∑ p ∈ u, ‖x i p z‖ ^ 2) ≤
          ENNReal.ofReal (sv a ^ 2 * dyadicGridLength G L.1)) →
      (∀ L ∈ T.leaves, ∫⁻ z in dyadicGridCell G L.1 L.2, ENNReal.ofReal (∑ k ∈ t, ‖w k z‖ ^ 2) ≤
        ENNReal.ofReal (sv b ^ 2 * dyadicGridLength G L.1)) →
      (∀ L ∈ T.leaves, ∫⁻ z in dyadicGridCell G L.1 L.2, ENNReal.ofReal (∑ p ∈ u, ‖y p z‖ ^ 2) ≤
        ENNReal.ofReal (sv c ^ 2 * dyadicGridLength G L.1)) →
      (∀ j, j ≠ a → j ≠ b → j ≠ c → ∀ L ∈ T.leaves, ∫⁻ z in dyadicGridCell G L.1 L.2,
        ‖f j z‖ₑ ^ 2 ≤ ENNReal.ofReal (sv j ^ 2 * dyadicGridLength G L.1)) →
      ∀ (sa : ℤ × ℤ → ι) (sb : ℤ × ℤ → κ'), (∀ I ∈ cells, sa I ∈ s) → (∀ I ∈ cells, sb I ∈ t) →
      ∀ sg : ℤ × ℤ → ℂ, (∀ I, ‖sg I‖ ≤ 1) →
      ‖∑ I ∈ cells, (dyadicGridLength G I.1 : ℂ) * (sg I * ∑ p ∈ u, localProgressionForm
          (dyadicGridLength G I.1) (kernel I) (Function.update (Function.update
            (Function.update f a (x (sa I) p)) b (w (sb I))) c (y p)))‖ ≤
        Cq * (1 + finiteDepthConstant κ q Nd) * (1 + Real.log ((K : ℝ) + 2)) *
          ((K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) * dyadicGridLength G T.root.1 * ∏ j, sv j := by
  obtain ⟨Cq, hCq, hrb⟩ := piece_random_bound κ hq2 hq3 (C4 := 16) (by norm_num)
  refine ⟨Cq, hCq, ?_⟩
  intro G K Nd hKN T ι κ' ν _ _ _ s t u a b c hab hac hbc f x w y hf hx hw hy kernel hker cells
    hcells hff hxf hwf hyf sv hsv hla hlb hlc hlo sa sb hsa hsb sg hsg
  classical
  set Ω := SignPattern s × SignPattern t × SignPattern u
  set z : Fin 4 → ℝ → ℝ := fun j r => if j = a then Real.sqrt (∑ i ∈ s, ∑ p ∈ u, ‖x i p r‖ ^ 2)
    else if j = b then Real.sqrt (∑ k ∈ t, ‖w k r‖ ^ 2)
    else if j = c then Real.sqrt (∑ p ∈ u, ‖y p r‖ ^ 2) else ‖f j r‖
  set zσ : Fin 4 → Ω → ℝ → ℂ := fun j ω =>
    randTuple3 a b c f s t u x w y ω.1.1 ω.2.1.1 ω.2.2.1 j
  set ε : ℤ × ℤ → Ω → ℂ := fun I ω => sg I * (patternSign ω.1.1 (sa I) : ℂ) *
    patternSign ω.2.1.1 (sb I)
  -- the slot values of the randomized tuple
  have hza : ∀ ω r, zσ a ω r = ∑ i ∈ s, ∑ p ∈ u, (patternSign ω.1.1 i : ℂ) *
      patternSign ω.2.2.1 p * x i p r := fun ω r => by
    simp [zσ, randTuple3, Function.update_of_ne hab, Function.update_of_ne hac]
  have hzb : ∀ ω r, zσ b ω r = ∑ k ∈ t, (patternSign ω.2.1.1 k : ℂ) * w k r := fun ω r => by
    simp [zσ, randTuple3, Function.update_of_ne hbc]
  have hzc : ∀ ω r, zσ c ω r = ∑ p ∈ u, (patternSign ω.2.2.1 p : ℂ) * y p r := fun ω r => by
    simp [zσ, randTuple3]
  have hzo : ∀ j, j ≠ a → j ≠ b → j ≠ c → ∀ ω r, zσ j ω r = f j r := fun j h1 h2 h3 ω r => by
    simp [zσ, randTuple3, Function.update_of_ne h1, Function.update_of_ne h2,
      Function.update_of_ne h3]
  have hzm : ∀ j, Measurable (z j) := by
    intro j
    simp only [z]
    split_ifs
    · exact Real.continuous_sqrt.measurable.comp (Finset.measurable_sum _ fun i _ =>
        Finset.measurable_sum _ fun p _ => ((hx i p).norm.pow_const 2))
    · exact Real.continuous_sqrt.measurable.comp (Finset.measurable_sum _ fun k _ =>
        ((hw k).norm.pow_const 2))
    · exact Real.continuous_sqrt.measurable.comp (Finset.measurable_sum _ fun p _ =>
        ((hy p).norm.pow_const 2))
    · exact (hf j).norm
  have hsq : ∀ (S : ℝ), 0 ≤ S → ‖Real.sqrt S‖ₑ ^ 2 = ENNReal.ofReal S := fun S hS => by
    rw [Real.enorm_eq_ofReal (Real.sqrt_nonneg _), ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
      Real.sq_sqrt hS]
  have hleaf : ∀ j, ∀ L ∈ T.leaves, ∫⁻ r in dyadicGridCell G L.1 L.2, ‖z j r‖ₑ ^ 2 ≤
      ENNReal.ofReal (sv j ^ 2 * dyadicGridLength G L.1) := by
    intro j L hL
    by_cases hja : j = a
    · subst hja
      refine le_trans (le_of_eq ?_) (hla L hL)
      refine setLIntegral_congr_fun (dyadicGridCell_measurable _ _ _) fun r _ => ?_
      simp only [z, ↓reduceIte]
      exact hsq _ (Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _)
    by_cases hjb : j = b
    · subst hjb
      refine le_trans (le_of_eq ?_) (hlb L hL)
      refine setLIntegral_congr_fun (dyadicGridCell_measurable _ _ _) fun r _ => ?_
      simp only [z, hja, ↓reduceIte]
      exact hsq _ (Finset.sum_nonneg fun _ _ => sq_nonneg _)
    by_cases hjc : j = c
    · subst hjc
      refine le_trans (le_of_eq ?_) (hlc L hL)
      refine setLIntegral_congr_fun (dyadicGridCell_measurable _ _ _) fun r _ => ?_
      simp only [z, hja, hjb, ↓reduceIte]
      exact hsq _ (Finset.sum_nonneg fun _ _ => sq_nonneg _)
    · refine le_trans (le_of_eq ?_) (hlo j hja hjb hjc L hL)
      refine setLIntegral_congr_fun (dyadicGridCell_measurable _ _ _) fun r _ => ?_
      simp only [z, hja, hjb, hjc, ↓reduceIte, enorm_norm]
  have hzσm : ∀ j ω, Measurable (zσ j ω) := by
    intro j ω
    change Measurable (randTuple3 a b c f s t u x w y ω.1.1 ω.2.1.1 ω.2.2.1 j)
    unfold randTuple3
    refine update_measurable_fin (update_measurable_fin (update_measurable_fin hf a ?_) b ?_)
      c ?_ j
    · exact Finset.measurable_sum _ fun i _ => Finset.measurable_sum _ fun p _ =>
        measurable_const.mul (hx i p)
    · exact Finset.measurable_sum _ fun k _ => measurable_const.mul (hw k)
    · exact Finset.measurable_sum _ fun p _ => measurable_const.mul (hy p)
  have hmom : ∀ j r, ((Fintype.card Ω : ℝ≥0∞)⁻¹ * ∑ ω, ‖zσ j ω r‖ₑ ^ (4 : ℝ)) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal 16 * ‖z j r‖ₑ := by
    intro j r
    by_cases hja : j = a
    · subst hja
      simp_rw [hza]
      have hzz : ‖z j r‖ₑ = ENNReal.ofReal (Real.sqrt (∑ i ∈ s, ∑ p ∈ u, ‖x i p r‖ ^ 2)) := by
        simp only [z, ↓reduceIte]; exact Real.enorm_eq_ofReal (Real.sqrt_nonneg _)
      rw [hzz]
      exact moment_three_a s t u (fun i p => x i p r)
    by_cases hjb : j = b
    · subst hjb
      simp_rw [hzb]
      have hzz : ‖z j r‖ₑ = ENNReal.ofReal (Real.sqrt (∑ k ∈ t, ‖w k r‖ ^ 2)) := by
        simp only [z, hja, ↓reduceIte]; exact Real.enorm_eq_ofReal (Real.sqrt_nonneg _)
      rw [hzz]
      exact moment_three_b s t u (fun k => w k r)
    by_cases hjc : j = c
    · subst hjc
      simp_rw [hzc]
      have hzz : ‖z j r‖ₑ = ENNReal.ofReal (Real.sqrt (∑ p ∈ u, ‖y p r‖ ^ 2)) := by
        simp only [z, hja, hjb, ↓reduceIte]; exact Real.enorm_eq_ofReal (Real.sqrt_nonneg _)
      rw [hzz]
      exact moment_three_c s t u (fun p => y p r)
    · simp_rw [hzo j hja hjb hjc]
      rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, ← mul_assoc,
        ENNReal.inv_mul_cancel (by simp) (by simp), one_mul, ← ENNReal.rpow_mul,
        show (4 : ℝ) * (1 / 4) = 1 by norm_num, ENNReal.rpow_one]
      have hzz : ‖z j r‖ₑ = ‖f j r‖ₑ := by
        simp only [z, hja, hjb, hjc, ↓reduceIte, enorm_norm]
      rw [hzz]
      exact le_mul_of_one_le_left (by simp) (by rw [ENNReal.one_le_ofReal]; norm_num)
  have hε1 : ∀ I ω, ‖ε I ω‖ ≤ 1 := by
    intro I ω
    have h1 : ‖(patternSign ω.1.1 (sa I) : ℂ)‖ = 1 := by
      unfold patternSign; split_ifs <;> simp
    have h2 : ‖(patternSign ω.2.1.1 (sb I) : ℂ)‖ = 1 := by
      unfold patternSign; split_ifs <;> simp
    simp only [ε, norm_mul, h1, h2, mul_one]
    exact hsg I
  have hTc : ∀ I ∈ cells, (Fintype.card Ω : ℂ)⁻¹ * ∑ ω, ε I ω *
      localProgressionForm (dyadicGridLength G I.1) (kernel I) (fun j => zσ j ω) =
      sg I * ∑ p ∈ u, localProgressionForm (dyadicGridLength G I.1) (kernel I)
        (Function.update (Function.update (Function.update f a (x (sa I) p)) b (w (sb I))) c
          (y p)) := by
    intro I hI
    have h := form_sign_avg3 (dyadicGridLength_pos G I.1) (hker I (hcells hI)) hab hac hbc f hf
      (hff I hI) s t u x w y hx (hxf I hI) hw (hwf I hI) hy (hyf I hI) (hsa I hI) (hsb I hI)
    rw [← h]
    have e := avg_three_families s t u (fun v₁ v₂ v₃ => sg I * ((patternSign v₁ (sa I) : ℂ) *
      patternSign v₂ (sb I) * localProgressionForm (dyadicGridLength G I.1) (kernel I)
        (randTuple3 a b c f s t u x w y v₁ v₂ v₃)))
    simp only [smul_eq_mul] at e
    have e' : ∀ ω : Ω, ε I ω * localProgressionForm (dyadicGridLength G I.1) (kernel I)
        (fun j => zσ j ω) = sg I * ((patternSign ω.1.1 (sa I) : ℂ) * patternSign ω.2.1.1 (sb I) *
          localProgressionForm (dyadicGridLength G I.1) (kernel I)
            (randTuple3 a b c f s t u x w y ω.1.1 ω.2.1.1 ω.2.2.1)) := fun ω => by
      simp only [ε, zσ]; ring
    simp_rw [e']
    rw [e]
    simp only [Finset.mul_sum]
    refine Finset.sum_congr rfl fun v₁ _ => Finset.sum_congr rfl fun v₂ _ =>
      Finset.sum_congr rfl fun v₃ _ => ?_
    ring
  exact hrb G K Nd hKN T z hzm sv hsv hleaf zσ hzσm hmom kernel hker cells hcells ε hε1 _ hTc

