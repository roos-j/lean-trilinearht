theorem Λc_phys (I : ℤ × ℤ) (x : Fin 4 → ColumnL2 (Fin ap.Mc)) :
    ap.Λc I x = ap.Λc I (fun l => physEmbed (Fin ap.Mc) (Fin ap.Mc) (x l)) := by
