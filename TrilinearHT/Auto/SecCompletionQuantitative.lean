variable {V V' W : Type*} [Fintype V] [Fintype V'] [Fintype W]

open scoped Classical in
/-- The physical value of the physical embedding. -/
theorem physEmbed_coeFn_none (x : ColumnL2 V) :
    ∀ᵐ y ∂volume, (physEmbed V W x : ℝ → ColumnHilbert W) y none =
      (x : ℝ → ColumnHilbert V) y none := by
  filter_upwards [physEmbed_coeFn (W := W) x] with y hy
  rw [hy]
  simp

open scoped Classical in
/-- The norm of the physical embedding at a point is the modulus of the physical value. -/
theorem physEmbed_coeFn_norm (x : ColumnL2 V) :
    ∀ᵐ y ∂volume, ‖(physEmbed V W x : ℝ → ColumnHilbert W) y‖ =
      ‖(x : ℝ → ColumnHilbert V) y none‖ := by
  filter_upwards [physEmbed_coeFn (W := W) x] with y hy
  rw [hy, norm_smul]
  simp

/-- Physical embeddings compose. -/
theorem physEmbed_physEmbed {X : Type*} [Fintype X] (x : ColumnL2 V) :
    physEmbed W X (physEmbed V W x) = physEmbed V X x := by
  classical
  apply Lp.ext
  filter_upwards [physEmbed_coeFn (W := X) (physEmbed V W x), physEmbed_coeFn (W := X) x,
    physEmbed_coeFn_none (W := W) x] with y h1 h2 h3
  rw [h1, h2, h3]

/-- The restricted energy of a difference of physical embeddings is the integral of the
squared difference of the physical values. -/
theorem norm_sq_restrict_physEmbed_sub (s : Set ℝ) (hs : MeasurableSet s) (x : ColumnL2 V)
    (x' : ColumnL2 V') :
    ‖columnL2Restriction s hs (physEmbed V W x - physEmbed V' W x')‖ ^ 2 =
      ∫ y in s, ‖(x : ℝ → ColumnHilbert V) y none - (x' : ℝ → ColumnHilbert V') y none‖ ^ 2 := by
  classical
  rw [columnL2Restriction_norm_sq]
  refine integral_congr_ae (ae_restrict_of_ae ?_)
  filter_upwards [Lp.coeFn_sub (physEmbed V W x) (physEmbed V' W x'),
    physEmbed_coeFn (W := W) x, physEmbed_coeFn (W := W) x'] with y h1 h2 h3
  rw [h1, Pi.sub_apply, h2, h3, ← sub_smul, norm_smul]
  simp

end PhysicalPart

