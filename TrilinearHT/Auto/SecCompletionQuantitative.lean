open Classical in
/-- Blueprint `eq:side-cap` (lines 2159-2166) for arbitrary rolling side vectors: if the rolling
parts `W_{G,s}`, restricted to the certified cells of depth `s`, have total square at most
`B_var`, and the linear sides `V_{G,b}` have total square at most `B_lin`, one first-crossing cut
of total length at most `ρ|R|` makes every retained path sum of the side weights at most
`(2 B_var + 2 K B_lin) / (ρ |R|)`. -/
theorem side_caps_of_rolling (Gd : RealDyadicGrid) (root : ℤ × ℤ) {ι : Type*} [Fintype ι]
    (Sd : Finset ℕ) (Sc : Finset (ℤ × ℤ)) (Ec : ι → ℕ → Finset (ℤ × ℤ))
    (hsub : ∀ G s, Ec G s ⊆ Sc) (d : ℕ → ℤ) (hEc : ∀ G s, ∀ I ∈ Ec G s, I.1 = d s)
    {W : Type*} [Fintype W] (Wr : ι → ℕ → ColumnL2 W) {Bvar : ℝ}
    (hvar : ∑ G, ∑ s ∈ Sd, ‖columnL2Restriction (⋃ I ∈ Ec G s, dyadicGridCell Gd I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable Gd I.1 I.2)
        (Wr G s)‖ ^ 2 ≤ Bvar)
    {Vt : ι → Type*} [∀ G, Fintype (Vt G)]
    (Vs : ∀ G, ℤ → ColumnL2 (Vt G)) (blk : ℕ → ℤ) {K : ℕ}
    (hK : ∀ b, (Sd.filter fun s => blk s = b).card ≤ K) (Bs : Finset ℤ)
    (hBs : ∀ s ∈ Sd, blk s ∈ Bs) {Blin : ℝ} (hlin : ∑ G, ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 ≤ Blin)
    (hSc : ∀ I ∈ Sc, dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd root.1 root.2)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    let a : Bool → ℤ × ℤ → ℝ := fun v I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
      (if v then 2 * ‖columnL2Restriction (dyadicGridCell Gd I.1 I.2)
        (dyadicGridCell_measurable Gd I.1 I.2) (Wr G s)‖ ^ 2
      else 2 * ‖columnL2Restriction (dyadicGridCell Gd I.1 I.2)
        (dyadicGridCell_measurable Gd I.1 I.2) (Vs G (blk s))‖ ^ 2) /
          dyadicGridLength Gd I.1 else 0
    let T := (2 * Bvar / dyadicGridLength Gd root.1 + 2 * (K * Blin) /
      dyadicGridLength Gd root.1) / ρ
    dyadicRootLength Gd (dyadicFirstCrossings Gd Sc (fun I => ∑ v, a v I) T) ≤
        ρ * dyadicGridLength Gd root.1 ∧
      ∀ x : ℝ, dyadicRealPathSum Gd (dyadicRetainedCells Gd Sc (fun I => ∑ v, a v I) T)
        (fun I => ∑ v, a v I) x ≤ T := by
  intro a T
  have hL := dyadicGridLength_pos Gd root.1
  have hdis : ∀ G s, Set.PairwiseDisjoint (Ec G s : Set (ℤ × ℤ))
      fun I => dyadicGridCell Gd I.1 I.2 := fun G s =>
    cells_pairwiseDisjoint_of_depth Gd (Ec G s) fun I hI => hEc G s I hI
  -- the rolling budget
  have hroll : dyadicWeightedMass Gd Sc (a true) ≤ 2 * Bvar := by
    have hm := cell_weights_mass Gd Sc (V := fun _ => W) Sd Ec hsub hdis Wr
    have e : dyadicWeightedMass Gd Sc (a true) = 2 * dyadicWeightedMass Gd Sc
        (fun I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
          ‖columnL2Restriction (dyadicGridCell Gd I.1 I.2)
            (dyadicGridCell_measurable Gd I.1 I.2) (Wr G s)‖ ^ 2 /
            dyadicGridLength Gd I.1 else 0) := by
      unfold dyadicWeightedMass
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [a, ↓reduceIte, Finset.mul_sum]
      refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun s _ => ?_
      split_ifs <;> ring
    rw [e, hm]
    exact mul_le_mul_of_nonneg_left hvar (by norm_num)
  -- the fixed budget
  have hfix : dyadicWeightedMass Gd Sc (a false) ≤ 2 * (K * Blin) := by
    have hm := cell_weights_mass Gd Sc (V := Vt) Sd Ec hsub hdis (fun G s => Vs G (blk s))
    have e : dyadicWeightedMass Gd Sc (a false) = 2 * dyadicWeightedMass Gd Sc
        (fun I => ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
          ‖columnL2Restriction (dyadicGridCell Gd I.1 I.2)
            (dyadicGridCell_measurable Gd I.1 I.2) (Vs G (blk s))‖ ^ 2 /
            dyadicGridLength Gd I.1 else 0) := by
      unfold dyadicWeightedMass
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun I _ => ?_
      simp only [a, Bool.false_eq_true, ↓reduceIte, Finset.mul_sum]
      refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun s _ => ?_
      split_ifs <;> ring
    rw [e, hm]
    refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
    calc ∑ G, ∑ s ∈ Sd, ‖columnL2Restriction (⋃ I ∈ Ec G s, dyadicGridCell Gd I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable Gd I.1 I.2)
            (Vs G (blk s))‖ ^ 2 ≤ ∑ G, ∑ s ∈ Sd, ‖Vs G (blk s)‖ ^ 2 :=
          Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun s _ =>
            pow_le_pow_left₀ (norm_nonneg _) (columnL2Indicator_norm_le _
              (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable Gd I.1 I.2)
              (Vs G (blk s))) 2
      _ ≤ ∑ G, K * ∑ b ∈ Sd.image blk, ‖Vs G b‖ ^ 2 :=
          Finset.sum_le_sum fun G _ => sum_comp_le_mul Sd blk (fun b => ‖Vs G b‖ ^ 2)
            (fun _ => sq_nonneg _) (fun b => by convert hK b)
      _ ≤ ∑ G, K * ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 := by
          refine Finset.sum_le_sum fun G _ => mul_le_mul_of_nonneg_left
            (Finset.sum_le_sum_of_subset_of_nonneg (fun b hb' => ?_) fun _ _ _ => sq_nonneg _)
            (by positivity)
          obtain ⟨s, hs, rfl⟩ := Finset.mem_image.mp hb'
          exact hBs s hs
      _ = K * ∑ G, ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 := by rw [Finset.mul_sum]
      _ ≤ K * Blin := mul_le_mul_of_nonneg_left hlin (by positivity)
  have hcaps := side_caps_of_budgets Gd Sc a (fun v I _ => ?_) root hSc
    (fun v => if v then 2 * Bvar / dyadicGridLength Gd root.1
      else 2 * (K * Blin) / dyadicGridLength Gd root.1) (fun v => ?_) hρ hρ1
  · have hsum : (∑ v : Bool, if v then 2 * Bvar / dyadicGridLength Gd root.1
        else 2 * (K * Blin) / dyadicGridLength Gd root.1) =
        2 * Bvar / dyadicGridLength Gd root.1 + 2 * (K * Blin) / dyadicGridLength Gd root.1 := by
      rw [Fintype.sum_bool]; simp only [↓reduceIte, Bool.false_eq_true]
    rw [hsum] at hcaps
    exact hcaps
  · refine Finset.sum_nonneg fun G _ => Finset.sum_nonneg fun s _ => ?_
    have := dyadicGridLength_pos Gd I.1
    split_ifs <;> positivity
  · cases v
    · simp only [Bool.false_eq_true, ↓reduceIte]
      rw [div_mul_cancel₀ _ hL.ne']; exact hfix
    · simp only [↓reduceIte]
      rw [div_mul_cancel₀ _ hL.ne']; exact hroll


