          ap.globOut cat hR hb r₀ j (grp q.1) ls (A.R.1 + r q.2)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + r q.2) Z)))‖ ^ 2 ≤
      2 * (2 * (1 + τ * N * 1 ^ 2) *
          (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
            ls.length * (∑ m ∈ Finset.range ls.length,
              compressionC (ap.cumBase cat hR hb).D m ^ 2)) *
          compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) +
        2 * ((1 + τ * N * 1 ^ 2) * ‖Z‖ ^ 2) := by
  have hC : (0 : ℝ) ≤ 1 + τ * N * 1 ^ 2 := by positivity
  have hBv : 0 ≤ 2 * (1 + τ * N * 1 ^ 2) *
      (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
        ls.length * (∑ m ∈ Finset.range ls.length,
          compressionC (ap.cumBase cat hR hb).D m ^ 2)) := by
    have : 0 ≤ ∑ m ∈ Finset.range ls.length, compressionC (ap.cumBase cat hR hb).D m ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    positivity
  have hrows : ∀ x, ∑ q : ι × ι', ‖((columnL2Restriction (⋃ I ∈ Ec q.1 q.2,
      dyadicGridCell A.G I.1 I.2) (Finset.measurableSet_biUnion _ fun I _ =>
        dyadicGridCell_measurable A.G I.1 I.2)).comp
      (ap.globOutL cat hR hb r₀ j (grp q.1) ls (A.R.1 + t q.2) -
        ap.globOutL cat hR hb r₀ j (grp q.1) ls (A.R.1 + r q.2))) x‖ ^ 2 ≤
      (2 * (1 + τ * N * 1 ^ 2) *
        (compressionC (ap.cumBase cat hR hb).D ls.length ^ 2 +
          ls.length * (∑ m ∈ Finset.range ls.length,
            compressionC (ap.cumBase cat hR hb).D m ^ 2))) * ‖x‖ ^ 2 := by
    intro x
    have h := ap.attempt_variation cat t₀ hT hR hb hanc grp hgrp k r₀ j hPH ls r t hrt hdis Ec
      hEc hcert hroot hτ hτ1 hHed hN x
    exact le_trans (le_of_eq rfl) (h.trans (le_of_eq (by ring)))
  have hjoint : ∑ q : ι × ι', ‖((columnL2Restriction (⋃ I ∈ Ec q.1 q.2,
      dyadicGridCell A.G I.1 I.2) (Finset.measurableSet_biUnion _ fun I _ =>
        dyadicGridCell_measurable A.G I.1 I.2)))
      (ap.globOutL cat hR hb r₀ j (grp q.1) ls (A.R.1 + t q.2) (physEmbed V (Fin ap.Mc)
        ((Ψ.proj (A.R.1 + t q.2) - Ψ.proj (A.R.1 + r q.2)) Z)))‖ ^ 2 ≤
      (1 + τ * N * 1 ^ 2) * ‖Z‖ ^ 2 := by
    rw [Fintype.sum_prod_type, Finset.sum_comm]
    calc _ ≤ ∑ i : ι', (1 + τ * N * 1 ^ 2) *
            ‖physEmbed V (Fin ap.Mc) ((Ψ.proj (A.R.1 + t i) - Ψ.proj (A.R.1 + r i)) Z)‖ ^ 2 :=
          Finset.sum_le_sum fun i _ => ap.globOut_joint cat t₀ hT hR hb grp hgrp k r₀ j hPH ls
            (A.R.1 + t i) (fun G => Ec G i) (fun G => hEc G i) (fun G => hcert G i) hroot hτ
            hτ1 hHed hN _
      _ ≤ ∑ i : ι', (1 + τ * N * 1 ^ 2) *
            ‖(Ψ.proj (A.R.1 + t i) - Ψ.proj (A.R.1 + r i)) Z‖ ^ 2 :=
          Finset.sum_le_sum fun i _ => mul_le_mul_of_nonneg_left
            (pow_le_pow_left₀ (norm_nonneg _) (norm_physEmbed_apply_le _) 2) hC
      _ ≤ _ := by
          rw [← Finset.mul_sum]
          exact mul_le_mul_of_nonneg_left (Ψ.jumps_from_le hΨr r t hrt hdis Z) hC
  have h := basic_variation Ψ
    (fun q : ι × ι' => columnL2Restriction (⋃ I ∈ Ec q.1 q.2, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2))
    (fun q h => ap.globOutL cat hR hb r₀ j (grp q.1) ls h)
    (fun q => A.R.1 + r q.2) (fun q => A.R.1 + t q.2) hBv (fun x => hrows x)
    (fun q x => ap.globOut_rows_blk cat hR hb r₀ j (grp q.1) ls (by have := hrt q.2; omega)
      (by have := htd q.2; omega) (Ec q.1 q.2) (fun I hI => (hEc q.1 q.2 I hI).1) Ψ hΨG hΨR
      hΨr (by omega) x) Z hjoint
  exact h

