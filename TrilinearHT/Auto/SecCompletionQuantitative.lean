/-- The cell-local leaf output depends only on the input on the cell. -/
theorem ballAt_layer_restrict (cat : List (CatCol A.Vtx)) (r j : ℕ) (G : A.Grp) (I : ℤ × ℤ)
    (ls : List (ℕ × Bool)) (z : ColumnL2 (Fin ap.Mc)) :
    ap.ballAt cat r j G I (layerOp (ap.cumAt cat I) ls z) =
      ap.ballAt cat r j G I (layerOp (ap.cumAt cat I) ls (columnL2Restriction
        (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) z)) := by
  set rI := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
  have hcomm : (layerOp (ap.cumAt cat I) ls).comp rI = rI.comp (layerOp (ap.cumAt cat I) ls) :=
    layerOp_commute _ rI (fun m => by
      unfold cumAt
      refine opAvg_commute _ _ fun p => ?_
      have h := catProj_restrict A.G ap.Mc cat I (ap.Lc - m + 1) (ap.cmask I m p)
      rw [h.1, h.2]) ls
  have hballr : (ap.ballAt cat r j G I).comp rI = ap.ballAt cat r j G I := by
    unfold ballAt
    refine ContinuousLinearMap.ext fun x => ?_
    simp only [ContinuousLinearMap.comp_apply, opAvg, smul_apply, FunLike.coe_sum,
      Finset.sum_apply]
    congr 1
    refine Finset.sum_congr rfl fun p _ => ?_
    exact DFunLike.congr_fun (catProj_restrict A.G ap.Mc cat I r (ap.bmask I G j p)).1 x
  have e := DFunLike.congr_fun hcomm z
  simp only [ContinuousLinearMap.comp_apply] at e
  rw [e]
  exact (DFunLike.congr_fun hballr _).symm

/-- Blueprint lines 1805 and 1859 ("acting on `F_l`"): the actual leaf ball output of a cell
whose input is the current basic projection of a column family is the restriction to the cell of
the global ball output acting on the rank-zero projection at the cell's depth. -/
theorem leaf_ball_eq_globOut (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool))
    {I : ℤ × ℤ} (hI : I ∈ A.cells) {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V)
    (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ap.ballAt cat r j G I (layerOp (ap.cumAt cat I) ls
        (physicalColumnInput (cellLp A.G I (Ψ.currentZ Z I)))) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (ap.globOut cat hR hb r j G ls I.1 (physEmbed V (Fin ap.Mc) (Ψ.proj I.1 Z))) := by
  rw [ap.globOut_restrict cat hR hb r j G ls hI,
    ap.ballAt_layer_restrict cat r j G I ls (physEmbed V (Fin ap.Mc) (Ψ.proj I.1 Z))]
  have hIR := A.sub I hI
  have hroot : Ψ.D.root.1 ≤ I.1 :=
    le_trans hΨr (dyadicGridCell_depth_le_of_subset A.G I A.R hIR)
  have h := Ψ.restrict_physEmbed_proj (W := Fin ap.Mc) (I := I)
    (by rw [hΨG]; exact hIR.trans hΨR) hroot Z
  rw [hΨG] at h
  rw [h]

end AttemptParams

