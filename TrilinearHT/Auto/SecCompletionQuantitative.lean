section DepthLocality

variable {V : Type*} [Fintype V]

/-- A cell projection commutes with the restriction to a cell containing it or disjoint from it. -/
theorem cellColumnProjection_commute_restrict (D : ColumnTreeData V) (A : InheritedColumnMask D)
    {c : ℤ × ℤ} (hc : c ∈ D.cells) {s : Set ℝ} (hs : MeasurableSet s)
    (h : dyadicGridCell D.grid c.1 c.2 ⊆ s ∨ Disjoint (dyadicGridCell D.grid c.1 c.2) s) :
    (columnL2Restriction s hs).comp (cellColumnProjection D A hc) =
      (cellColumnProjection D A hc).comp (columnL2Restriction s hs) := by
  obtain ⟨h1, h2⟩ := cellColumnProjection_restrict D A hc
  have hm := dyadicGridCell_measurable D.grid c.1 c.2
  rcases h with hsub | hdis
  · rw [← h1, ← ContinuousLinearMap.comp_assoc, columnL2Restriction_comp_of_subset' hm hs hsub,
      h1, ← h2, ContinuousLinearMap.comp_assoc, columnL2Restriction_comp_of_subset hm hs hsub]
  · refine ContinuousLinearMap.ext fun z => ?_
    have e1 : columnL2Restriction s hs (cellColumnProjection D A hc z) = 0 := by
      rw [← DFunLike.congr_fun h1 z, ContinuousLinearMap.comp_apply,
        ← ContinuousLinearMap.comp_apply (columnL2Restriction s hs),
        columnL2Restriction_comp_disjoint hs hm hdis.symm]
      rfl
    have e2 : cellColumnProjection D A hc (columnL2Restriction s hs z) = 0 := by
      rw [← DFunLike.congr_fun h2, ContinuousLinearMap.comp_apply,
        ← ContinuousLinearMap.comp_apply (columnL2Restriction _ hm),
        columnL2Restriction_comp_disjoint hm hs hdis, zero_apply, map_zero]
    simp only [ContinuousLinearMap.comp_apply, e1, e2]

/-- The depth projections of a column family commute with the restriction to any dyadic cell of
depth at most the partition depth (blueprint lines 1879-1890: histories are local). -/
theorem ColumnDepthFamily.proj_commute_restrict (Φ : ColumnDepthFamily V) (h : ℤ) {Q : ℤ × ℤ}
    (hQ : Q.1 ≤ Φ.depth h) :
    (columnL2Restriction (dyadicGridCell Φ.D.grid Q.1 Q.2)
      (dyadicGridCell_measurable Φ.D.grid Q.1 Q.2)).comp (Φ.proj h) =
    (Φ.proj h).comp (columnL2Restriction (dyadicGridCell Φ.D.grid Q.1 Q.2)
      (dyadicGridCell_measurable Φ.D.grid Q.1 Q.2)) := by
  refine ContinuousLinearMap.ext fun z => ?_
  simp only [ContinuousLinearMap.comp_apply]
  unfold ColumnDepthFamily.proj
  rw [partitionColumnProjection_eq_sum, partitionColumnProjection_eq_sum, map_sum]
  refine Finset.sum_congr rfl fun c _ => ?_
  have hc1 := ((Φ.mem_partition h c.1).mp c.2).1
  have hcQ : dyadicGridCell Φ.D.grid c.1.1 c.1.2 ⊆ dyadicGridCell Φ.D.grid Q.1 Q.2 ∨
      Disjoint (dyadicGridCell Φ.D.grid c.1.1 c.1.2) (dyadicGridCell Φ.D.grid Q.1 Q.2) := by
    rcases dyadicGridCell_nested_or_disjoint_of_le Φ.D.grid (show Q.1 ≤ c.1.1 by omega) Q.2
      c.1.2 with hd | hs
    · exact Or.inr hd.symm
    · exact Or.inl hs
  exact DFunLike.congr_fun (cellColumnProjection_commute_restrict Φ.D Φ.A
    ((Φ.partition h).subset c.2) (dyadicGridCell_measurable _ _ _) hcQ) z

end DepthLocality

section DepthLocality2

variable {V W : Type*} [Fintype V] [Fintype W]

/-- A column function (of any label type) vanishing off the root of a depth family splits
orthogonally over its depth partition. -/
theorem ColumnDepthFamily.norm_sq_partition' (Ψ : ColumnDepthFamily V) (h : ℤ) (v : ColumnL2 W)
    (hv : ∀ᵐ y ∂volume, y ∉ dyadicGridCell Ψ.D.grid Ψ.D.root.1 Ψ.D.root.2 →
      (v : ℝ → ColumnHilbert W) y = 0) :
    ‖v‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition h).cells},
      ‖columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) v‖ ^ 2 := by
  classical
  set π := Ψ.partition h
  set w : (ℤ × ℤ) → ColumnL2 W := fun Q => columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1 Q.2)
    (dyadicGridCell_measurable Ψ.D.grid Q.1 Q.2) v
  have hw : ∀ Q, ∀ᵐ y ∂volume, y ∉ dyadicGridCell Ψ.D.grid Q.1 Q.2 →
      (w Q : ℝ → ColumnHilbert W) y = 0 := by
    intro Q
    filter_upwards [columnL2Indicator_coeFn _ (dyadicGridCell_measurable Ψ.D.grid Q.1 Q.2) v]
      with y hy hyQ
    change (columnL2Indicator _ (dyadicGridCell_measurable Ψ.D.grid Q.1 Q.2) v :
      ℝ → ColumnHilbert W) y = 0
    rw [hy, Set.indicator_of_notMem hyQ]
  have hsum : v = ∑ Q ∈ π.cells, w Q := by
    refine Lp.ext ?_
    have hall : ∀ᵐ y ∂volume, ∀ Q ∈ π.cells, (w Q : ℝ → ColumnHilbert W) y =
        (dyadicGridCell Ψ.D.grid Q.1 Q.2).indicator (v : ℝ → ColumnHilbert W) y := by
      rw [Filter.eventually_all_finset]
      intro Q _
      exact columnL2Indicator_coeFn _ (dyadicGridCell_measurable Ψ.D.grid Q.1 Q.2) v
    filter_upwards [hall, hv, Lp.coeFn_fun_finsetSum π.cells w] with y h1 h2 h3
    rw [h3, Finset.sum_congr rfl h1, ← Finset.indicator_biUnion_apply _ _ π.disjoint, π.cover]
    by_cases hy : y ∈ dyadicGridCell Ψ.D.grid Ψ.D.root.1 Ψ.D.root.2
    · rw [Set.indicator_of_mem hy]
    · rw [Set.indicator_of_notMem hy, h2 hy]
  conv_lhs => rw [hsum]
  rw [columnL2_norm_sq_sum_disjoint π.cells w (fun Q => dyadicGridCell Ψ.D.grid Q.1 Q.2)
    π.disjoint hw]
  exact (Finset.sum_coe_sort π.cells (fun Q => ‖w Q‖ ^ 2)).symm

/-- Rows whose outputs vanish off the root of a depth family and which commute with the
restrictions to its depth-`h` cells split orthogonally over that partition (the hypothesis of
`basic_insert`). -/
theorem ColumnDepthFamily.blk_of_commute (Ψ : ColumnDepthFamily V) (h : ℤ)
    (R : ColumnL2 W →L[ℂ] ColumnL2 W)
    (hvan : ∀ x, ∀ᵐ y ∂volume, y ∉ dyadicGridCell Ψ.D.grid Ψ.D.root.1 Ψ.D.root.2 →
      (R x : ℝ → ColumnHilbert W) y = 0)
    (hc : ∀ Q ∈ (Ψ.partition h).cells,
      R.comp (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1 Q.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1 Q.2)) =
      (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1 Q.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1 Q.2)).comp R) (x : ColumnL2 W) :
    ‖R x‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition h).cells},
      ‖R (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x)‖ ^ 2 := by
  rw [Ψ.norm_sq_partition' h (R x) (hvan x)]
  refine Finset.sum_congr rfl fun Q _ => ?_
  rw [← ContinuousLinearMap.comp_apply R, hc Q.1 Q.2]
  rfl

end DepthLocality2

section BasicVariation

variable {V W : Type*} [Fintype V] [Fintype W]

/-- Blueprint lem:variation (`eq:variation`, lines 1861-1890) for histories acting on a rank-zero
basic projection: if the history rows `S_i (T_i(t_i) - T_i(r_i))` are Bessel for all inputs and
local at the left depths, then the variation of the actual outputs `T_i(h) (E P_h Z)` is bounded
by the compressed row constant plus the joint size `J` of the outputs on the jumps of the basic
projections. -/
theorem basic_variation {ι : Type*} [Fintype ι] (Ψ : ColumnDepthFamily V)
    (S : ι → ColumnL2 W →L[ℂ] ColumnL2 W) (T : ι → ℤ → ColumnL2 W →L[ℂ] ColumnL2 W)
    (r t : ι → ℤ) {B : ℝ} (hB : 0 ≤ B)
    (hrows : ∀ x, ∑ i, ‖S i ((T i (t i) - T i (r i)) x)‖ ^ 2 ≤ B * ‖x‖ ^ 2)
    (hblk : ∀ i x, ‖S i ((T i (t i) - T i (r i)) x)‖ ^ 2 =
      ∑ Q : {Q // Q ∈ (Ψ.partition (r i)).cells},
        ‖S i ((T i (t i) - T i (r i)) (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
          (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x))‖ ^ 2)
    (Z : ColumnL2 V) {J : ℝ}
    (hjoint : ∑ i, ‖S i (T i (t i) (physEmbed V W ((Ψ.proj (t i) - Ψ.proj (r i)) Z)))‖ ^ 2 ≤
      J) :
    ∑ i, ‖S i (T i (t i) (physEmbed V W (Ψ.proj (t i) Z)) -
        T i (r i) (physEmbed V W (Ψ.proj (r i) Z)))‖ ^ 2 ≤
      2 * (B * compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) + 2 * J := by
  have hins := basic_insert (W := W) Ψ r (fun i => (S i).comp (T i (t i) - T i (r i))) hB
    (fun x => hrows x) (fun i x => hblk i x) Z
  have hsplit : ∀ i, S i (T i (t i) (physEmbed V W (Ψ.proj (t i) Z)) -
      T i (r i) (physEmbed V W (Ψ.proj (r i) Z))) =
      S i ((T i (t i) - T i (r i)) (physEmbed V W (Ψ.proj (r i) Z))) +
        S i (T i (t i) (physEmbed V W ((Ψ.proj (t i) - Ψ.proj (r i)) Z))) := by
    intro i
    simp only [sub_apply, map_sub]
    abel
  calc ∑ i, ‖S i (T i (t i) (physEmbed V W (Ψ.proj (t i) Z)) -
        T i (r i) (physEmbed V W (Ψ.proj (r i) Z)))‖ ^ 2
      ≤ ∑ i, (2 * ‖S i ((T i (t i) - T i (r i)) (physEmbed V W (Ψ.proj (r i) Z)))‖ ^ 2 +
          2 * ‖S i (T i (t i) (physEmbed V W ((Ψ.proj (t i) - Ψ.proj (r i)) Z)))‖ ^ 2) := by
        refine Finset.sum_le_sum fun i _ => ?_
        rw [hsplit i]
        set a := S i ((T i (t i) - T i (r i)) (physEmbed V W (Ψ.proj (r i) Z)))
        set b := S i (T i (t i) (physEmbed V W ((Ψ.proj (t i) - Ψ.proj (r i)) Z)))
        calc ‖a + b‖ ^ 2 ≤ (‖a‖ + ‖b‖) ^ 2 :=
              pow_le_pow_left₀ (norm_nonneg _) (norm_add_le a b) 2
          _ ≤ 2 * ‖a‖ ^ 2 + 2 * ‖b‖ ^ 2 := by nlinarith [sq_nonneg (‖a‖ - ‖b‖)]
    _ = 2 * ∑ i, ‖S i ((T i (t i) - T i (r i)) (physEmbed V W (Ψ.proj (r i) Z)))‖ ^ 2 +
          2 * ∑ i, ‖S i (T i (t i) (physEmbed V W ((Ψ.proj (t i) - Ψ.proj (r i)) Z)))‖ ^ 2 := by
        rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]
    _ ≤ _ := by
        have := hins
        simp only [ContinuousLinearMap.comp_apply] at this
        gcongr

end BasicVariation

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The global ball output of an attempt as an operator. -/
noncomputable def globOutL (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool)) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  (opAvg (fun p : Fin ap.P => (ap.ballFam cat hR hb r j G p).proj h)).comp
    (globHist (ap.cumBase cat hR hb) (ap.cumMask cat hR hb) ls h)

theorem globOutL_apply (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool)) (h : ℤ)
    (z : ColumnL2 (Fin ap.Mc)) :
    ap.globOutL cat hR hb r j G ls h z = ap.globOut cat hR hb r j G ls h z := rfl

theorem norm_globOutL_apply_le (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool)) (h : ℤ)
    (z : ColumnL2 (Fin ap.Mc)) : ‖ap.globOutL cat hR hb r j G ls h z‖ ≤ ‖z‖ := by
  refine (norm_opAvg_apply_le _ (fun p y => starProjection_norm_apply_le _
    ((ap.ballFam cat hR hb r j G p).isStarProjection_proj h) y) _).trans ?_
  exact globHist_norm_le _ ap.hP _ ls h z

/-- The global ball outputs of an attempt at depth `h` commute with the restriction to every
dyadic cell of depth at most `h` (and at most the depth of the tree). -/
theorem globOutL_commute (cat : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ cat, d.birth ∈ A.cells) (r j : ℕ) (G : A.Grp) (ls : List (ℕ × Bool)) (h : ℤ)
    {Q : ℤ × ℤ} (hQ : Q.1 ≤ (ap.cumBase cat hR hb).depth h) :
    (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (ap.globOutL cat hR hb r j G ls h) =
    (ap.globOutL cat hR hb r j G ls h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)) := by
  set rQ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G Q.1 Q.2)
    (dyadicGridCell_measurable A.G Q.1 Q.2)
  have hball : ∀ p : Fin ap.P, ((ap.ballFam cat hR hb r j G p).proj h).comp rQ =
      rQ.comp ((ap.ballFam cat hR hb r j G p).proj h) := fun p =>
    ((ap.ballFam cat hR hb r j G p).proj_commute_restrict h hQ).symm
  have hcum : ∀ m, (opAvg fun p : Fin ap.P =>
      ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h).comp rQ =
      rQ.comp (opAvg fun p : Fin ap.P =>
        ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h) := fun m =>
    opAvg_commute _ _ fun p =>
      (((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj_commute_restrict h
        hQ).symm
  have hhist := layerOp_commute _ rQ hcum ls
  have hb2 := opAvg_commute _ _ hball
  unfold globOutL globHist
  refine ContinuousLinearMap.ext fun x => ?_
  simp only [ContinuousLinearMap.comp_apply]
  have e1 := DFunLike.congr_fun hhist x
  simp only [ContinuousLinearMap.comp_apply] at e1
  rw [e1]
  have e2 := DFunLike.congr_fun hb2 (layerOp (fun m => opAvg fun p : Fin ap.P =>
    ((ap.cumBase cat hR hb).withMask (ap.cumMask cat hR hb m p)).proj h) ls x)
  simp only [ContinuousLinearMap.comp_apply] at e2
  rw [e2]

