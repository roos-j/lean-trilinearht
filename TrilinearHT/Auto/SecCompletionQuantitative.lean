open Classical in
/-- Blueprint line 2100 ("at one event, a nonexceptional primary is height-bad at most
`C d_max R_ht` times by stabilization", lem:stabilize line 2012): for a key nonexceptional in its
block, at most `(2 (d_v + d_z) + 1) R` heights `h ≤ J_*` are bad, when the witness bounds grow by
at least the factor `6` and the kernel bounds are monotone. -/
theorem badHeights_card_le (hEq : ∀ i, 6 * SP.Eq i ≤ SP.Eq (i + 1)) (hSk : Monotone SP.Sk)
    (b : ℤ) (p : Ms.Key) (hp : Ms.nonexcAt S SP b p) :
    ((Finset.range (SP.Jst + 1)).filter fun h => ¬ Ms.goodP S SP b h p).card ≤
      (2 * (Ms.dvOf p + Ms.zc.dim) + 1) * SP.R := by
  set Θ : Fin (Ms.dvOf p + Ms.zc.dim) → ℝ := Fin.append (Ms.θvOf p) fun l => Ms.zc.θ l / S.Q0
  set K := tinySpan Θ SP.Hn (SP.Tt⁻¹ / dyadicGridLength Gd (b - 2 * S.K))
  set V : ℕ → Submodule ℚ (Fin (Ms.dvOf p + Ms.zc.dim) → ℚ) := fun i =>
    witnessSpan K SP.D (SP.Eq i) i
  set U : ℕ → Submodule ℚ (Fin Ms.zc.dim → ℚ) := fun i =>
    smallKernelSpan K (zEmb (Ms.dvOf p) Ms.zc.dim) (SP.Sk i)
  have hV : Monotone V := witnessSpan_mono K SP.D SP.Eq hEq
  have hU : Monotone U := fun i j hij => smallKernelSpan_mono K _ (hSk hij)
  have h1 := rank_change_heights_card V hV SP.R (SP.Jst + 1)
  have h2 := rank_change_heights_card U hU SP.R (SP.Jst + 1)
  rw [Module.finrank_fin_fun] at h1 h2
  have hsub : ((Finset.range (SP.Jst + 1)).filter fun h => ¬ Ms.goodP S SP b h p) ⊆
      Finset.range SP.R ∪ ((Finset.range (SP.Jst + 1)).filter fun h => SP.R ≤ h ∧
        V (h - SP.R) ≠ V h) ∪ ((Finset.range (SP.Jst + 1)).filter fun h => SP.R ≤ h ∧
          U (h - SP.R) ≠ U h) := by
    intro h hh
    obtain ⟨hr, hbad⟩ := Finset.mem_filter.mp hh
    simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_range]
    by_cases hRh : SP.R ≤ h
    · by_cases hVh : V (h - SP.R) = V h
      · refine Or.inr ⟨Finset.mem_range.mp hr, hRh, fun hUh => hbad ⟨hp, hRh, hVh, hUh⟩⟩
      · exact Or.inl (Or.inr ⟨Finset.mem_range.mp hr, hRh, hVh⟩)
    · exact Or.inl (Or.inl (by omega))
  calc _ ≤ _ := Finset.card_le_card hsub
    _ ≤ _ := Finset.card_union_le _ _
    _ ≤ (Finset.range SP.R).card + ((Finset.range (SP.Jst + 1)).filter fun h => SP.R ≤ h ∧
          V (h - SP.R) ≠ V h).card + ((Finset.range (SP.Jst + 1)).filter fun h => SP.R ≤ h ∧
          U (h - SP.R) ≠ U h).card := by
        gcongr; exact Finset.card_union_le _ _
    _ ≤ SP.R + (Ms.dvOf p + Ms.zc.dim) * SP.R + Ms.zc.dim * SP.R := by
        rw [Finset.card_range]; omega
    _ ≤ (2 * (Ms.dvOf p + Ms.zc.dim) + 1) * SP.R := by nlinarith

end ModeSystem

section PatternEstimates

variable {W : Type*} [NormedAddCommGroup W] [NormedSpace ℂ W]

open Classical in
/-- A pattern containing an error slot: its form is at most the size cap cubed times the
normalized error size of that slot. -/
theorem pattern_error_le (Λ : MultilinearMap ℂ (fun _ : Fin 4 => W) ℂ) {C r Bs : ℝ}
    (hC : 0 ≤ C) (hr : 0 < r)
    (hΛ : ∀ x : Fin 4 → W, ‖Λ x‖ ≤ C * ∏ l, (‖x l‖ / Real.sqrt r))
    (a s e : Fin 4 → W) (hsize : ∀ l, ‖a l‖ ≤ Bs * Real.sqrt r ∧ ‖s l‖ ≤ Bs * Real.sqrt r ∧
      ‖e l‖ ≤ Bs * Real.sqrt r) (σ : Fin 4 → Fin 3) {l₀ : Fin 4} (hl₀ : σ l₀ = 2) :
    ‖Λ (patternPiece a s e σ)‖ ≤ C * Bs ^ 3 * (‖e l₀‖ / Real.sqrt r) := by
  have hsr := Real.sqrt_pos.mpr hr
  have hpiece : ∀ l, ‖patternPiece a s e σ l‖ / Real.sqrt r ≤ Bs := by
    intro l
    rw [div_le_iff₀ hsr]
    unfold patternPiece
    have h := hsize l
    match σ l with
    | 0 => exact h.1
    | 1 => exact h.2.1
    | 2 => exact h.2.2
  have hl₀' : patternPiece a s e σ l₀ = e l₀ := by unfold patternPiece; rw [hl₀]; rfl
  refine (hΛ _).trans ?_
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ l₀), hl₀']
  have hrest : ∏ l ∈ Finset.univ.erase l₀, (‖patternPiece a s e σ l‖ / Real.sqrt r) ≤
      Bs ^ 3 := by
    calc ∏ l ∈ Finset.univ.erase l₀, (‖patternPiece a s e σ l‖ / Real.sqrt r)
        ≤ ∏ _l ∈ Finset.univ.erase l₀, Bs :=
          Finset.prod_le_prod₀ (fun l _ => by positivity) fun l _ => hpiece l
      _ = Bs ^ 3 := by
          rw [Finset.prod_const, Finset.card_erase_of_mem (Finset.mem_univ _)]; simp
  have he0 : 0 ≤ ‖e l₀‖ / Real.sqrt r := by positivity
  calc C * (‖e l₀‖ / Real.sqrt r * ∏ l ∈ Finset.univ.erase l₀,
        (‖patternPiece a s e σ l‖ / Real.sqrt r))
      ≤ C * (‖e l₀‖ / Real.sqrt r * Bs ^ 3) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hrest he0) hC
    _ = C * Bs ^ 3 * (‖e l₀‖ / Real.sqrt r) := by ring

open Classical in
/-- Blueprint line 2461 and line 2166 ("every term containing a physical error is
`O(e^{-k}|R|)`"): the error patterns of all cells and groups are bounded, after Cauchy-Schwarz
over the cells and groups, by `324 C B³ (Σ_I |I| #G_I)^{1/2} (Σ_{I,G,l} ‖E‖²)^{1/2}`. -/
theorem error_patterns_le {ι γ : Type*} (S : Finset ι) (len : ι → ℝ) (hlen : ∀ I ∈ S, 0 < len I)
    (Gs : ι → Finset γ) (Λ : ι → MultilinearMap ℂ (fun _ : Fin 4 => W) ℂ) {C Bs : ℝ}
    (hC : 0 ≤ C) (hBs : 0 ≤ Bs)
    (hΛ : ∀ I ∈ S, ∀ x : Fin 4 → W, ‖Λ I x‖ ≤ C * ∏ l, (‖x l‖ / Real.sqrt (len I)))
    (a s e : ι → γ → Fin 4 → W)
    (hsize : ∀ I ∈ S, ∀ G ∈ Gs I, ∀ l, ‖a I G l‖ ≤ Bs * Real.sqrt (len I) ∧
      ‖s I G l‖ ≤ Bs * Real.sqrt (len I) ∧ ‖e I G l‖ ≤ Bs * Real.sqrt (len I))
    {M Ee : ℝ} (hM : ∑ I ∈ S, len I * (Gs I).card ≤ M)
    (hE : ∑ I ∈ S, ∑ G ∈ Gs I, ∑ l, ‖e I G l‖ ^ 2 ≤ Ee) :
    ∑ I ∈ S, len I * ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
        ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
      81 * (C * Bs ^ 3) * (Real.sqrt (4 * M) * Real.sqrt Ee) := by
  -- one pattern at one cell and group
  have hone : ∀ I ∈ S, ∀ G ∈ Gs I, ∀ σ ∈ Finset.univ.filter
      (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
      ‖Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
        C * Bs ^ 3 * ∑ l, (‖e I G l‖ / Real.sqrt (len I)) := by
    intro I hI G hG σ hσ
    obtain ⟨l₀, hl₀⟩ := (Finset.mem_filter.mp hσ).2
    refine (pattern_error_le (Λ I) hC (hlen I hI) (hΛ I hI) _ _ _ (hsize I hI G hG) σ
      hl₀).trans ?_
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact Finset.single_le_sum (f := fun l => ‖e I G l‖ / Real.sqrt (len I))
      (fun l _ => by positivity) (Finset.mem_univ l₀)
  have hcard : (Finset.univ.filter (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2)).card ≤ 81 := by
    refine (Finset.card_filter_le _ _).trans ?_
    simp
  have hcell : ∀ I ∈ S, len I * ∑ σ ∈ Finset.univ.filter
      (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
        ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
      81 * (C * Bs ^ 3) * ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) := by
    intro I hI
    have hr := hlen I hI
    have hsr := Real.sqrt_pos.mpr hr
    have hX : 0 ≤ C * Bs ^ 3 * ∑ G ∈ Gs I, ∑ l, (‖e I G l‖ / Real.sqrt (len I)) := by
      have : 0 ≤ ∑ G ∈ Gs I, ∑ l, (‖e I G l‖ / Real.sqrt (len I)) := by positivity
      positivity
    calc len I * ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
          ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖
        ≤ len I * ∑ _σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => ∃ l, σ l = 2),
            C * Bs ^ 3 * ∑ G ∈ Gs I, ∑ l, (‖e I G l‖ / Real.sqrt (len I)) := by
          refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun σ hσ => ?_) hr.le
          refine (norm_sum_le _ _).trans ?_
          rw [Finset.mul_sum]
          exact Finset.sum_le_sum fun G hG => hone I hI G hG σ hσ
      _ ≤ len I * (81 * (C * Bs ^ 3 * ∑ G ∈ Gs I, ∑ l, (‖e I G l‖ / Real.sqrt (len I)))) := by
          rw [Finset.sum_const, nsmul_eq_mul]
          refine mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) hX) hr.le
      _ = 81 * (C * Bs ^ 3) * ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) := by
          simp only [Finset.mul_sum]
          refine Finset.sum_congr rfl fun G _ => Finset.sum_congr rfl fun l _ => ?_
          calc len I * (81 * (C * Bs ^ 3 * (‖e I G l‖ / Real.sqrt (len I))))
              = 81 * (C * Bs ^ 3) * (len I / Real.sqrt (len I) * ‖e I G l‖) := by ring
            _ = _ := by rw [Real.div_sqrt]
  -- Cauchy-Schwarz over cells, groups and slots
  set T := S.sigma Gs
  have hCS : ∑ I ∈ S, ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) ≤
      Real.sqrt (4 * M) * Real.sqrt Ee := by
    have h1 : ∑ I ∈ S, ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) =
        ∑ x ∈ T ×ˢ (Finset.univ : Finset (Fin 4)), Real.sqrt (len x.1.1) * ‖e x.1.1 x.1.2 x.2‖ := by
      rw [Finset.sum_product, Finset.sum_sigma]
    rw [h1]
    refine (Real.sum_mul_le_sqrt_mul_sqrt _ _ _).trans ?_
    have h2 : ∑ x ∈ T ×ˢ (Finset.univ : Finset (Fin 4)), Real.sqrt (len x.1.1) ^ 2 ≤ 4 * M := by
      rw [Finset.sum_product, Finset.sum_sigma]
      calc ∑ I ∈ S, ∑ G ∈ Gs I, ∑ _l : Fin 4, Real.sqrt (len I) ^ 2
          = ∑ I ∈ S, 4 * (len I * (Gs I).card) := by
            refine Finset.sum_congr rfl fun I hI => ?_
            rw [Real.sq_sqrt (hlen I hI).le]
            simp [Finset.sum_const]; ring
        _ ≤ 4 * M := by rw [← Finset.mul_sum]; linarith
    have h3 : ∑ x ∈ T ×ˢ (Finset.univ : Finset (Fin 4)), ‖e x.1.1 x.1.2 x.2‖ ^ 2 ≤ Ee := by
      rw [Finset.sum_product, Finset.sum_sigma]; exact hE
    exact mul_le_mul (Real.sqrt_le_sqrt h2) (Real.sqrt_le_sqrt h3) (Real.sqrt_nonneg _)
      (Real.sqrt_nonneg _)
  calc _ ≤ ∑ I ∈ S, 81 * (C * Bs ^ 3) * ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) :=
        Finset.sum_le_sum hcell
    _ = 81 * (C * Bs ^ 3) * ∑ I ∈ S, ∑ G ∈ Gs I, ∑ l, (Real.sqrt (len I) * ‖e I G l‖) := by
        rw [Finset.mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left hCS (by positivity)

end PatternEstimates

section PatternEstimates2

variable {W : Type*} [NormedAddCommGroup W] [NormedSpace ℂ W]

open Classical in
/-- Four factors bounded by `B`, of which at least three are bounded by `√w`, have product at most
`B w √w`. -/
theorem prod_four_le_of_three (f : Fin 4 → ℝ) (hf0 : ∀ l, 0 ≤ f l) {B w : ℝ} (hB : ∀ l, f l ≤ B)
    (Sd : Finset (Fin 4)) (hS : 3 ≤ Sd.card) (hw : ∀ l ∈ Sd, f l ≤ Real.sqrt w) :
    ∏ l, f l ≤ B * (w * Real.sqrt w) := by
  obtain ⟨T, hTS, hT3⟩ := Finset.exists_subset_card_eq hS
  have hsq := Real.sqrt_nonneg w
  rw [← Finset.prod_mul_prod_compl T]
  have h1 : ∏ l ∈ T, f l ≤ Real.sqrt w ^ 3 := by
    calc ∏ l ∈ T, f l ≤ ∏ _l ∈ T, Real.sqrt w :=
          Finset.prod_le_prod₀ (fun l _ => hf0 l) fun l hl => hw l (hTS hl)
      _ = Real.sqrt w ^ 3 := by rw [Finset.prod_const, hT3]
  have hc : Tᶜ.card = 1 := by rw [Finset.card_compl, hT3]; rfl
  have h2 : ∏ l ∈ Tᶜ, f l ≤ B := by
    obtain ⟨m, hm⟩ := Finset.card_eq_one.mp hc
    rw [hm, Finset.prod_singleton]; exact hB m
  have hB0 : 0 ≤ B := (hf0 0).trans (hB 0)
  have hw3 : Real.sqrt w ^ 3 = w * Real.sqrt w := by
    rcases le_or_gt 0 w with h | h
    · rw [pow_succ, Real.sq_sqrt h]
    · rw [Real.sqrt_eq_zero_of_nonpos h.le]; ring
  calc (∏ l ∈ T, f l) * ∏ l ∈ Tᶜ, f l ≤ Real.sqrt w ^ 3 * B :=
        mul_le_mul h1 h2 (Finset.prod_nonneg fun l _ => hf0 l) (by positivity)
    _ = B * (w * Real.sqrt w) := by rw [hw3]; ring

/-- `Σ w_i √w_i ≤ (Σ w_i) √(Σ w_i)` for nonnegative `w`. -/
theorem sum_mul_sqrt_le {γ : Type*} (s : Finset γ) (w : γ → ℝ) (hw : ∀ i ∈ s, 0 ≤ w i) :
    ∑ i ∈ s, w i * Real.sqrt (w i) ≤ (∑ i ∈ s, w i) * Real.sqrt (∑ i ∈ s, w i) := by
  rw [Finset.sum_mul]
  exact Finset.sum_le_sum fun i hi => mul_le_mul_of_nonneg_left
    (Real.sqrt_le_sqrt (Finset.single_le_sum hw hi)) (hw i hi)

open Classical in
/-- Blueprint `eq:three-sides` with `eq:min-power` (lines 2372-2390, 2447-2456): patterns
without errors and with at least three sides, with every piece of normalized size at most `B` and
the side weights `u_I = Σ_{G,l} ‖S_{G,l}‖² / |I|` having path sums at most `T`, contribute in the
active-cell minimum at most `η^{1-p} (81 C B)^p T^{3p/2} |R|` for `2/3 < p ≤ 1`. -/
theorem three_side_patterns_le (Gd : RealDyadicGrid) {γ : Type*} (S : Finset (ℤ × ℤ))
    (root : ℤ × ℤ) (hroot : ∀ I ∈ S, dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd root.1 root.2)
    (Gs : ℤ × ℤ → Finset γ) (Λ : ℤ × ℤ → MultilinearMap ℂ (fun _ : Fin 4 => W) ℂ) {C Bs : ℝ}
    (hC : 0 ≤ C) (hBs : 0 ≤ Bs)
    (hΛ : ∀ I ∈ S, ∀ x : Fin 4 → W, ‖Λ I x‖ ≤
      C * ∏ l, (‖x l‖ / Real.sqrt (dyadicGridLength Gd I.1)))
    (a s e : ℤ × ℤ → γ → Fin 4 → W)
    (hsize : ∀ I ∈ S, ∀ G ∈ Gs I, ∀ l, ‖a I G l‖ ≤ Bs * Real.sqrt (dyadicGridLength Gd I.1) ∧
      ‖s I G l‖ ≤ Bs * Real.sqrt (dyadicGridLength Gd I.1))
    {T : ℝ} (hT : ∀ x : ℝ, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell Gd I.1 I.2),
      ∑ G ∈ Gs I, ∑ l, ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1 ≤ T)
    {η p : ℝ} (hη : 0 ≤ η) (hp : 2 / 3 < p) (hp1 : p ≤ 1) :
    ∑ I ∈ S, dyadicGridLength Gd I.1 * min η ‖∑ σ ∈ Finset.univ.filter
        (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
          ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
      η ^ (1 - p) * (81 * C * Bs) ^ p *
        (T ^ (p / 2) * T ^ (p / 2) * T ^ (p / 2) * dyadicGridLength Gd root.1) := by
  set u : ℤ × ℤ → ℝ := fun I => ∑ G ∈ Gs I, ∑ l, ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1
  have hu0 : ∀ I, 0 ≤ u I := fun I => Finset.sum_nonneg fun G _ =>
    Finset.sum_nonneg fun l _ => div_nonneg (sq_nonneg _) (dyadicGridLength_pos Gd I.1).le
  have hp0 : 0 < p := by linarith
  -- one pattern at one cell
  have hpat : ∀ I ∈ S, ∀ σ ∈ Finset.univ.filter
      (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
      ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
        C * Bs * (u I * Real.sqrt (u I)) := by
    intro I hI σ hσ
    obtain ⟨hnoerr, hcnt⟩ := (Finset.mem_filter.mp hσ).2
    have hr := dyadicGridLength_pos Gd I.1
    have hsr := Real.sqrt_pos.mpr hr
    set wG : γ → ℝ := fun G => ∑ l, ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1
    have hwG0 : ∀ G, 0 ≤ wG G := fun G => Finset.sum_nonneg fun l _ =>
      div_nonneg (sq_nonneg _) hr.le
    have hG : ∀ G ∈ Gs I, ‖Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
        C * (Bs * (wG G * Real.sqrt (wG G))) := by
      intro G hG
      refine (hΛ I hI _).trans (mul_le_mul_of_nonneg_left ?_ hC)
      refine prod_four_le_of_three _ (fun l => by positivity) (fun l => ?_)
        (Finset.univ.filter fun l => σ l = 1) hcnt (fun l hl => ?_)
      · rw [div_le_iff₀ hsr]
        unfold patternPiece
        have h := hsize I hI G hG l
        have hσl := hnoerr l
        match hm : σ l with
        | 0 => simpa [hm] using h.1
        | 1 => simpa [hm] using h.2
        | 2 => exact absurd hm hσl
      · have hσl := (Finset.mem_filter.mp hl).2
        unfold patternPiece
        rw [hσl]
        change ‖s I G l‖ / Real.sqrt (dyadicGridLength Gd I.1) ≤ Real.sqrt (wG G)
        rw [div_le_iff₀ hsr, ← Real.sqrt_mul (hwG0 G)]
        have h1 : ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1 ≤ wG G :=
          Finset.single_le_sum (f := fun l => ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1)
            (fun l _ => div_nonneg (sq_nonneg _) hr.le) (Finset.mem_univ l)
        rw [← Real.sqrt_sq (norm_nonneg (s I G l))]
        refine Real.sqrt_le_sqrt ?_
        rw [div_le_iff₀ hr] at h1
        exact h1
    calc ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖
        ≤ ∑ G ∈ Gs I, C * (Bs * (wG G * Real.sqrt (wG G))) :=
          (norm_sum_le _ _).trans (Finset.sum_le_sum hG)
      _ = C * Bs * ∑ G ∈ Gs I, wG G * Real.sqrt (wG G) := by
          rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun G _ => by ring
      _ ≤ C * Bs * (u I * Real.sqrt (u I)) :=
          mul_le_mul_of_nonneg_left (sum_mul_sqrt_le _ wG fun G _ => hwG0 G) (by positivity)
  have hcard : (Finset.univ.filter (fun σ : Fin 4 → Fin 3 =>
      (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1)).card ≤ 81 := by
    refine (Finset.card_filter_le _ _).trans ?_
    simp
  -- the active minimum at one cell
  have hcell : ∀ I ∈ S, dyadicGridLength Gd I.1 * min η ‖∑ σ ∈ Finset.univ.filter
      (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
        ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
      η ^ (1 - p) * (81 * C * Bs) ^ p * (dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p) := by
    intro I hI
    have hr := dyadicGridLength_pos Gd I.1
    have hX : ‖∑ σ ∈ Finset.univ.filter
        (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
          ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
        81 * C * Bs * (u I * Real.sqrt (u I)) := by
      refine (norm_sum_le _ _).trans ?_
      calc _ ≤ ∑ _σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 =>
            (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1), C * Bs * (u I * Real.sqrt (u I)) :=
            Finset.sum_le_sum fun σ hσ => hpat I hI σ hσ
        _ ≤ 81 * (C * Bs * (u I * Real.sqrt (u I))) := by
            rw [Finset.sum_const, nsmul_eq_mul]
            exact mul_le_mul_of_nonneg_right (by exact_mod_cast hcard)
              (by have := hu0 I; positivity)
        _ = _ := by ring
    have hm := min_le_rpow_mul (η := η) hη (norm_nonneg _) hp0.le hp1
      (x := ‖∑ σ ∈ Finset.univ.filter
        (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
          ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖)
    have hpow : ‖∑ σ ∈ Finset.univ.filter
        (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
          ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ^ p ≤
        (81 * C * Bs) ^ p * (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p := by
      rw [← Real.mul_rpow (by positivity) (by positivity)]
      refine Real.rpow_le_rpow (norm_nonneg _) (hX.trans (le_of_eq ?_)) hp0.le
      rw [Real.mul_self_sqrt (hu0 I)]
    calc dyadicGridLength Gd I.1 * min η _
        ≤ dyadicGridLength Gd I.1 * (η ^ (1 - p) * ((81 * C * Bs) ^ p *
            (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p)) :=
          mul_le_mul_of_nonneg_left (hm.trans (mul_le_mul_of_nonneg_left hpow
            (Real.rpow_nonneg hη _))) hr.le
      _ = _ := by ring
  have hpc := power_cost_bound Gd S (fun I => Real.sqrt (u I)) (fun I => Real.sqrt (u I))
    (fun I => Real.sqrt (u I)) (fun I _ => Real.sqrt_nonneg _) (fun I _ => Real.sqrt_nonneg _)
    (fun I _ => Real.sqrt_nonneg _) root hroot (Ca := T) (Cb := T) (Cc := T)
    (fun x => by simp_rw [Real.sq_sqrt (hu0 _)]; exact hT x)
    (fun x => by simp_rw [Real.sq_sqrt (hu0 _)]; exact hT x)
    (fun x => by simp_rw [Real.sq_sqrt (hu0 _)]; exact hT x) hp
  calc _ ≤ ∑ I ∈ S, η ^ (1 - p) * (81 * C * Bs) ^ p * (dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p) := Finset.sum_le_sum hcell
    _ = η ^ (1 - p) * (81 * C * Bs) ^ p * ∑ I ∈ S, dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p := by rw [Finset.mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left hpc (by positivity)

end PatternEstimates2

section PatternEstimates3

variable {W : Type*} [NormedAddCommGroup W] [NormedSpace ℂ W]

open Classical in
/-- Blueprint `eq:min-power` with `eq:three-sides` integrated over paths: cell quantities bounded by
`K u_I √u_I`, where the weights `u_I` have path sums at most `T`, contribute to the active
minimum at most `η^{1-p} K^p T^{3p/2} |R|`. -/
theorem power_min_sum_le (Gd : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (root : ℤ × ℤ)
    (hroot : ∀ I ∈ S, dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd root.1 root.2)
    (x u : ℤ × ℤ → ℝ) (hx : ∀ I ∈ S, 0 ≤ x I) (hu : ∀ I, 0 ≤ u I) {K T : ℝ} (hK : 0 ≤ K)
    (hxu : ∀ I ∈ S, x I ≤ K * (u I * Real.sqrt (u I)))
    (hT : ∀ y : ℝ, ∑ I ∈ S.filter (fun I => y ∈ dyadicGridCell Gd I.1 I.2), u I ≤ T)
    {η p : ℝ} (hη : 0 ≤ η) (hp : 2 / 3 < p) (hp1 : p ≤ 1) :
    ∑ I ∈ S, dyadicGridLength Gd I.1 * min η (x I) ≤
      η ^ (1 - p) * K ^ p * (T ^ (p / 2) * T ^ (p / 2) * T ^ (p / 2) *
        dyadicGridLength Gd root.1) := by
  have hp0 : 0 < p := by linarith
  have hcell : ∀ I ∈ S, dyadicGridLength Gd I.1 * min η (x I) ≤
      η ^ (1 - p) * K ^ p * (dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p) := by
    intro I hI
    have hr := dyadicGridLength_pos Gd I.1
    have hm := min_le_rpow_mul hη (hx I hI) hp0.le hp1
    have hpow : x I ^ p ≤ K ^ p * (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p := by
      rw [← Real.mul_rpow hK (by positivity)]
      refine Real.rpow_le_rpow (hx I hI) ((hxu I hI).trans (le_of_eq ?_)) hp0.le
      rw [Real.mul_self_sqrt (hu I)]
    calc dyadicGridLength Gd I.1 * min η (x I)
        ≤ dyadicGridLength Gd I.1 * (η ^ (1 - p) * (K ^ p *
            (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p)) :=
          mul_le_mul_of_nonneg_left (hm.trans (mul_le_mul_of_nonneg_left hpow
            (Real.rpow_nonneg hη _))) hr.le
      _ = _ := by ring
  have hpc := power_cost_bound Gd S (fun I => Real.sqrt (u I)) (fun I => Real.sqrt (u I))
    (fun I => Real.sqrt (u I)) (fun I _ => Real.sqrt_nonneg _) (fun I _ => Real.sqrt_nonneg _)
    (fun I _ => Real.sqrt_nonneg _) root hroot (Ca := T) (Cb := T) (Cc := T)
    (fun y => by simp_rw [Real.sq_sqrt (hu _)]; exact hT y)
    (fun y => by simp_rw [Real.sq_sqrt (hu _)]; exact hT y)
    (fun y => by simp_rw [Real.sq_sqrt (hu _)]; exact hT y) hp
  calc _ ≤ ∑ I ∈ S, η ^ (1 - p) * K ^ p * (dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p) := Finset.sum_le_sum hcell
    _ = η ^ (1 - p) * K ^ p * ∑ I ∈ S, dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p := by rw [Finset.mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left hpc (by positivity)

open Classical in
/-- Blueprint line 2461 ("for terms with exactly two sides, replace the two core complements by
their whole current `Z` arguments; corrections have at least three sides"): at one cell the
two-core two-side patterns differ from the restored ones by at most `81` times the error and the
three-side pattern sums. -/
theorem two_two_cell_le {γ : Type*} (Gs : Finset γ) (Λ : MultilinearMap ℂ (fun _ : Fin 4 => W) ℂ)
    (a s e : γ → Fin 4 → W) :
    ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        patternCount σ 0 = 2 ∧ patternCount σ 1 = 2),
        ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) σ)‖ ≤
      ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
          patternCount σ 0 = 2 ∧ patternCount σ 1 = 2),
          ∑ G ∈ Gs, Λ (fun l => if σ l = 0 then a G l + s G l + e G l else s G l)‖ +
        81 * ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2),
          ‖∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖ +
        81 * ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
          3 ≤ patternCount τ 1), ‖∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖ := by
  set P22 := Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
    patternCount σ 0 = 2 ∧ patternCount σ 1 = 2)
  set Perr := Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2)
  set P3 := Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧ 3 ≤ patternCount τ 1)
  set f : (Fin 4 → Fin 3) → ℝ := fun τ => ‖∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖
  have hrest : ∀ σ ∈ P22, ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) σ) =
      ∑ G ∈ Gs, Λ (fun l => if σ l = 0 then a G l + s G l + e G l else s G l) -
        ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
          ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ) := by
    intro σ hσ
    rw [Finset.sum_comm, ← Finset.sum_sub_distrib]
    exact Finset.sum_congr rfl fun G _ =>
      form_restore_cores Λ (a G) (s G) (e G) σ (Finset.mem_filter.mp hσ).2.1
  have hcorr : ∀ σ ∈ P22, ‖∑ τ ∈ Finset.univ.filter
      (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
        ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖ ≤
      ∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ := by
    intro σ hσ
    obtain ⟨hσe, -, hσ1⟩ := (Finset.mem_filter.mp hσ).2
    refine (norm_sum_le _ _).trans ?_
    have hsub : Finset.univ.filter (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1) ⊆
        Perr ∪ P3 := by
      intro τ hτ
      obtain ⟨hne, hτσ⟩ := (Finset.mem_filter.mp hτ).2
      rcases restore_correction_sides σ τ hσe hne hτσ with h | h
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, h⟩)
      · by_cases he : ∃ l, τ l = 2
        · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, he⟩)
        · push Not at he
          exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, he,
            by omega⟩)
    calc ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
          f τ ≤ ∑ τ ∈ Perr ∪ P3, f τ :=
          Finset.sum_le_sum_of_subset_of_nonneg hsub fun _ _ _ => norm_nonneg _
      _ ≤ ∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ := by
          have h1 := Finset.sum_union_inter (s₁ := Perr) (s₂ := P3) (f := f)
          have h0 : 0 ≤ ∑ τ ∈ Perr ∩ P3, f τ := Finset.sum_nonneg fun _ _ => norm_nonneg _
          linarith
  have hcard : P22.card ≤ 81 := (Finset.card_filter_le _ _).trans (by simp)
  have hX0 : 0 ≤ ∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ := by positivity
  rw [Finset.sum_congr rfl hrest, Finset.sum_sub_distrib]
  refine (norm_sub_le _ _).trans ?_
  have h2 : ‖∑ σ ∈ P22, ∑ τ ∈ Finset.univ.filter
      (fun τ : Fin 4 → Fin 3 => τ ≠ σ ∧ ∀ l, σ l = 1 → τ l = 1),
        ∑ G ∈ Gs, Λ (patternPiece (a G) (s G) (e G) τ)‖ ≤
      81 * (∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ) := by
    refine (norm_sum_le _ _).trans ?_
    calc _ ≤ ∑ _σ ∈ P22, (∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ) := Finset.sum_le_sum hcorr
      _ ≤ 81 * (∑ τ ∈ Perr, f τ + ∑ τ ∈ P3, f τ) := by
          rw [Finset.sum_const, nsmul_eq_mul]
          exact mul_le_mul_of_nonneg_right (by exact_mod_cast hcard) hX0
  linarith

end PatternEstimates3

section TransferStep

variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- A four-linear form as a bilinear form in two distinct slots, the other slots fixed. -/
def bilinTwo (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {a c : Fin 4}
    (hac : a ≠ c) (x : Fin 4 → E) : E →ₗ[ℂ] E →ₗ[ℂ] ℂ :=
  LinearMap.mk₂ ℂ (fun u v => Λ (Function.update (Function.update x a u) c v))
    (fun u u' v => by
      have h := Λ.map_update_add (Function.update x c v) a u u'
      simp [Function.update_comm hac])
    (fun t u v => by
      have h := Λ.map_update_smul (Function.update x c v) a t u
      simp [Function.update_comm hac])
    (fun u v v' => Λ.map_update_add (Function.update x a u) c v v')
    (fun t u v => Λ.map_update_smul (Function.update x a u) c t v)

theorem bilinTwo_apply (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {a c : Fin 4}
    (hac : a ≠ c) (x : Fin 4 → E) (u v : E) :
    bilinTwo Λ hac x u v = Λ (Function.update (Function.update x a u) c v) := rfl

/-- Blueprint `eq:transfer` (line 2252) for a four-linear form: transferring the averaged filter
of the complement slot `c` to the helper average on the side slot `a` changes the form by the band
sum `Σ_{p,q} ((p - q)/P) H(A_p^a x_a, A_q^c x_c)`. -/
theorem transfer_step (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {a c : Fin 4} (hac : a ≠ c)
    (x : Fin 4 → E) (Qa Qc : ℕ → E →ₗ[ℂ] E) {P : ℕ} (hP : 0 < P)
    (ha0 : Qa 0 = 0) (hc0 : Qc 0 = 0) (haP : Qa (P + 1) = LinearMap.id)
    (hcP : Qc (P + 1) = LinearMap.id) :
    Λ (Function.update x c ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qc (p + 1) (x c))) -
        Λ (Function.update x a ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qa (p + 1) (x a))) =
      ∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update x a
          (Qa (p + 1) (x a) - Qa p (x a))) c (Qc (q + 1) (x c) - Qc q (x c))) := by
  have h := transfer_identity (bilinTwo Λ hac x) Qa Qc hP ha0 hc0 haP hcP (x a) (x c)
  simp only [bilinTwo_apply] at h
  rw [← h]
  congr 1
  · congr 1
    funext l
    by_cases hl : l = c
    · subst hl; simp
    · rw [Function.update_of_ne hl, Function.update_of_ne hl]
      by_cases hla : l = a
      · subst hla; simp
      · rw [Function.update_of_ne hla]
  · congr 1
    funext l
    by_cases hl : l = c
    · subst hl; simp only [Function.update_self]; exact Function.update_of_ne (Ne.symm hac) _ _
    · rw [Function.update_of_ne hl]

end TransferStep

section TransferChain

variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- The average `P⁻¹ Σ_{p=1}^P Q_p` of a filter family. -/
noncomputable def filterAvg (P : ℕ) (Q : ℕ → E →ₗ[ℂ] E) : E →ₗ[ℂ] E :=
  (P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Q (p + 1)

theorem filterAvg_apply (P : ℕ) (Q : ℕ → E →ₗ[ℂ] E) (x : E) :
    filterAvg P Q x = (P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Q (p + 1) x := by
  simp [filterAvg, LinearMap.sum_apply]

/-- One transfer step: the slot it acts on (`true` for `c`, `false` for `d`), the helper filters
on the side slot and the filters of the complement slot. -/
abbrev TransferStep (E : Type*) [AddCommGroup E] [Module ℂ E] :=
  Bool × (ℕ → E →ₗ[ℂ] E) × (ℕ → E →ₗ[ℂ] E)

/-- The complement value of slot `c` (`v = true`) or `d` (`v = false`): the averaged filters of
its steps, outermost first, applied to the base. -/
noncomputable def chainVal (P : ℕ) (v : Bool) : List (TransferStep E) → E → E
  | [], y => y
  | st :: rest, y => if st.1 = v then filterAvg P st.2.2 (chainVal P v rest y)
      else chainVal P v rest y

/-- The side value after all transfers: the helper averages applied in step order. -/
noncomputable def chainSide (P : ℕ) : List (TransferStep E) → E → E
  | [], x => x
  | st :: rest, x => chainSide P rest (filterAvg P st.2.1 x)

/-- The band defects of all transfer steps. -/
noncomputable def chainDefect (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) : List (TransferStep E) → E → ℂ
  | [], _ => 0
  | st :: rest, xa =>
      (∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
        (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))) +
        chainDefect Λ P a c d x yc yd rest (filterAvg P st.2.1 xa)

/-- Blueprint lines 2241-2268 ("after all transfers the main term is `H(D_{a,s} S_a, S_b, B_c,
B_d)`"): transferring the averaged filters of the two complement slots one at a time, each to a
helper average on the side slot, the form of the side and the two complement chains is the form of
the transferred side and the two bases plus the band defects of the steps. -/
theorem transfer_chain (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {P : ℕ} (hP : 0 < P)
    {a c d : Fin 4} (hac : a ≠ c) (had : a ≠ d) (hcd : c ≠ d) (x : Fin 4 → E) (yc yd : E) :
    ∀ (steps : List (TransferStep E)), (∀ st ∈ steps, st.2.1 0 = 0 ∧ st.2.2 0 = 0 ∧
        st.2.1 (P + 1) = LinearMap.id ∧ st.2.2 (P + 1) = LinearMap.id) → ∀ xa : E,
      Λ (Function.update (Function.update (Function.update x c (chainVal P true steps yc)) d
          (chainVal P false steps yd)) a xa) =
        Λ (Function.update (Function.update (Function.update x c yc) d yd) a
            (chainSide P steps xa)) + chainDefect Λ P a c d x yc yd steps xa
  | [], _, xa => by simp [chainVal, chainSide, chainDefect]
  | st :: rest, hst, xa => by
    obtain ⟨h1, h2, h3, h4⟩ := hst st (List.mem_cons_self ..)
    have ih := transfer_chain Λ hP hac had hcd x yc yd rest
      (fun s hs => hst s (List.mem_cons_of_mem _ hs)) (filterAvg P st.2.1 xa)
    -- the state before the step
    set zc := chainVal P true rest yc
    set zd := chainVal P false rest yd
    set X := Function.update (Function.update (Function.update x c zc) d zd) a xa
    obtain ⟨v, Qa, Qs⟩ := st
    cases v with
    | true =>
      have hstep := sub_eq_iff_eq_add.mp (transfer_step Λ hac X Qa Qs hP h1 h2 h3 h4)
      have eXc : X c = zc := by
        simp only [X, Function.update_apply]; simp [hac.symm, hcd]
      have eXa : X a = xa := by simp [X]
      rw [eXc, eXa] at hstep
      have hL : Function.update (Function.update (Function.update x c
            (chainVal P true ((true, Qa, Qs) :: rest) yc)) d
              (chainVal P false ((true, Qa, Qs) :: rest) yd)) a xa =
          Function.update X c ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qs (p + 1) zc) := by
        funext l
        simp only [chainVal, X, zc, zd, filterAvg_apply, Function.update_apply]
        split_ifs <;> simp_all
      have hR : Function.update X a ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qa (p + 1) xa) =
          Function.update (Function.update (Function.update x c zc) d zd) a
            (filterAvg P Qa xa) := by
        simp only [X, Function.update_idem, filterAvg_apply]
      rw [hL, hstep, hR, ih]
      simp only [chainSide, chainDefect, X, zc, zd, ite_true, Function.update_idem]
      ring
    | false =>
      have hstep := sub_eq_iff_eq_add.mp (transfer_step Λ had X Qa Qs hP h1 h2 h3 h4)
      have eXd : X d = zd := by
        simp only [X, Function.update_apply]; simp [had.symm]
      have eXa : X a = xa := by simp [X]
      rw [eXd, eXa] at hstep
      have hL : Function.update (Function.update (Function.update x c
            (chainVal P true ((false, Qa, Qs) :: rest) yc)) d
              (chainVal P false ((false, Qa, Qs) :: rest) yd)) a xa =
          Function.update X d ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qs (p + 1) zd) := by
        funext l
        simp only [chainVal, X, zc, zd, filterAvg_apply, Function.update_apply]
        split_ifs <;> simp_all
      have hR : Function.update X a ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qa (p + 1) xa) =
          Function.update (Function.update (Function.update x c zc) d zd) a
            (filterAvg P Qa xa) := by
        simp only [X, Function.update_idem, filterAvg_apply]
      rw [hL, hstep, hR, ih]
      simp only [chainSide, chainDefect, X, zc, zd, Function.update_idem, Bool.false_eq_true,
        ite_false]
      ring

end TransferChain

section ComplementExpansion

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- The signed positive chains of a layer list given outermost first: each complement layer
`1 - C` contributes either nothing or `-C`. -/
def posExpand : List (ℕ × Bool) → List (ℤ × List ℕ)
  | [] => [(1, [])]
  | (m, false) :: rest => (posExpand rest).map fun t => (t.1, m :: t.2)
  | (m, true) :: rest => posExpand rest ++ (posExpand rest).map fun t => (-t.1, m :: t.2)

/-- The composition of a chain of layers, outermost first. -/
def chainOp (Cum : ℕ → E →L[ℂ] E) : List ℕ → E →L[ℂ] E
  | [] => ContinuousLinearMap.id ℂ E
  | m :: ch => (Cum m).comp (chainOp Cum ch)

theorem comp_list_sum (A : E →L[ℂ] E) (L : List (E →L[ℂ] E)) :
    A.comp L.sum = (L.map fun T => A.comp T).sum := by
  induction L with
  | nil => simp
  | cons T L ih => simp [ContinuousLinearMap.comp_add, ih]

theorem neg_list_sum (L : List (E →L[ℂ] E)) : -L.sum = (L.map fun T => -T).sum := by
  induction L with
  | nil => simp
  | cons T L ih => simp [ih]; abel

theorem posExpand_length (L : List (ℕ × Bool)) :
    (posExpand L).length = 2 ^ (L.filter fun x => x.2).length := by
  induction L with
  | nil => simp [posExpand]
  | cons x rest ih =>
    obtain ⟨m, b⟩ := x
    cases b with
    | false => simp [posExpand, ih]
    | true => simp [posExpand, ih, pow_succ]; ring

/-- Blueprint line 2241 ("expand complements in the latter two histories as identity minus a
positive average; there are only `2^{O(log L)}` products"): a layered history is the signed sum
of its positive chains. -/
theorem layerOp_eq_posExpand (Cum : ℕ → E →L[ℂ] E) :
    ∀ ls : List (ℕ × Bool), layerOp Cum ls =
      ((posExpand ls.reverse).map fun t => (t.1 : ℂ) • chainOp Cum t.2).sum := by
  intro ls
  induction ls using List.reverseRecOn with
  | nil => simp [layerOp_nil, posExpand, chainOp]
  | append_singleton l x ih =>
    rw [layerOp_append, ih, List.reverse_append, List.reverse_singleton, List.singleton_append]
    obtain ⟨m, b⟩ := x
    cases b with
    | false =>
      simp only [Bool.false_eq_true, ↓reduceIte, posExpand, List.map_map]
      rw [comp_list_sum, List.map_map]
      congr 1
      refine List.map_congr_left fun t _ => ?_
      simp [chainOp]
    | true =>
      simp only [↓reduceIte, posExpand, List.map_append, List.sum_append, List.map_map]
      rw [ContinuousLinearMap.sub_comp, ContinuousLinearMap.id_comp, comp_list_sum,
        List.map_map, sub_eq_add_neg, neg_list_sum, List.map_map]
      congr 1
      congr 1
      refine List.map_congr_left fun t _ => ?_
      simp [chainOp]

end ComplementExpansion

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The data of the core-side-error split of the leaf outputs of an attempt (blueprint
`eq:sides`, `eq:core-side-error`, lines 2120-2135): the block length `K`, the schedule and side
parameters, the mode systems of the slots and groups, the pre-cells of the blocks and the frozen
coefficients, and the slots carrying a basic `U` (whole sides). -/
structure LeafSplit where
  S : ModeSchedule
  hA : 6 ≤ S.A0
  SP : SideParams
  Ms : Fin 4 → A.Grp → ModeSystem A.G ap.Mc
  cells : Fin 4 → A.Grp → ℤ → Finset (ℤ × ℤ)
  c : ∀ l G, ℤ → ℤ × ℤ → (Ms l G).Md → ℂ
  usl : Fin 4 → Prop

namespace LeafSplit

variable {ap} (D : ap.LeafSplit)

/-- The block start of a depth: the largest `R.1 + K β ≤ h`. -/
noncomputable def blockOf (h : ℤ) : ℤ :=
  A.R.1 + D.S.K * ((h - A.R.1) / D.S.K)

/-- The decision cell `u_b` of a cell (its ancestor at depth `b - 4K`). -/
noncomputable def dcell (I : ℤ × ℤ) : ℤ × ℤ := ancAt A.G I (D.blockOf I.1 - 4 * D.S.K)

/-- Whether a cell has a decision cell below the root. -/
def hasDecision (I : ℤ × ℤ) : Prop := A.R.1 ≤ D.blockOf I.1 - 4 * D.S.K

open Classical in
/-- The rolling part `Z_{s} - Z_{u_b}` and the lifted parts of the leaf output `Zout` of slot
`l` and group `G` at a cell `I`, given the output `ZU` at its decision cell. -/
noncomputable def lifted (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc)) :
    ColumnL2 (Fin ap.Mc) :=
  columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
    (physEmbed (D.Ms l G).Md (Fin ap.Mc) ((D.Ms l G).L.op ZU))

/-- The linear side `V_{l,G,b}` on a cell. -/
noncomputable def linSide (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) : ColumnL2 (Fin ap.Mc) :=
  columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
    (physEmbed (D.Ms l G).Md (Fin ap.Mc) ((D.Ms l G).blockSide D.S D.hA D.SP (D.blockOf I.1)
      (D.cells l G (D.blockOf I.1)) (D.c l G (D.blockOf I.1))))

open Classical in
/-- The side part `S_{l,G,s} = Z_s - Z_{u_b} + V_{l,G,b}` (or the whole output for a `U` slot or a
cell without decision cell). -/
noncomputable def side (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (Zout ZU : ColumnL2 (Fin ap.Mc)) :
    ColumnL2 (Fin ap.Mc) :=
  if D.usl l ∨ ¬ D.hasDecision I then Zout else
    Zout - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) ZU + D.linSide l G I

open Classical in
/-- The core part `A_{l,G,b} = Z̃ - V`. -/
noncomputable def core (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc)) :
    ColumnL2 (Fin ap.Mc) :=
  if D.usl l ∨ ¬ D.hasDecision I then 0 else D.lifted l G I ZU - D.linSide l G I

open Classical in
/-- The physical error `E_{l,G,b} = Z_{u_b} - Z̃`. -/
noncomputable def err (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc)) :
    ColumnL2 (Fin ap.Mc) :=
  if D.usl l ∨ ¬ D.hasDecision I then 0 else
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) ZU -
      D.lifted l G I ZU

/-- Blueprint `eq:core-side-error`: the leaf output is the sum of its core, side and error
parts. -/
theorem core_add_side_add_err (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ)
    (Zout ZU : ColumnL2 (Fin ap.Mc)) :
    D.core l G I ZU + D.side l G I Zout ZU + D.err l G I ZU = Zout := by
  unfold core side err
  split_ifs
  · simp
  · abel

end LeafSplit

end AttemptParams

end ActiveSetup

section PieceSelection

/-- The lower integral over two independent sign families is the double average. -/
theorem lintegral_signMeasure_prod {ι κ : Type*} (s : Finset ι) (t : Finset κ)
    (f : SignPattern s × SignPattern t → ℝ≥0∞) :
    ∫⁻ σ, f σ ∂((signMeasure s).prod (signMeasure t)) =
      (2 ^ s.card : ℝ≥0∞)⁻¹ * ∑ σ₁, ((2 ^ t.card : ℝ≥0∞)⁻¹ * ∑ σ₂, f (σ₁, σ₂)) := by
  rw [lintegral_prod _ (Measurable.of_discrete).aemeasurable, lintegral_signMeasure]
  congr 1
  refine Finset.sum_congr rfl fun σ₁ _ => ?_
  rw [lintegral_signMeasure]

/-- The double sign selection: averaging `ε_a η_b ε_i η_j` over two independent sign families
gives `δ_{ai} δ_{bj}`. -/
theorem sign_select_two {ι κ : Type*} [DecidableEq ι] [DecidableEq κ] (s : Finset ι)
    (t : Finset κ) {a i : ι} {b j : κ} (ha : a ∈ s) (hi : i ∈ s) (hb : b ∈ t) (hj : j ∈ t) :
    ((2 : ℝ) ^ s.card)⁻¹ * ∑ u ∈ s.powerset, (((2 : ℝ) ^ t.card)⁻¹ *
      ∑ v ∈ t.powerset, patternSign u a * patternSign v b * (patternSign u i * patternSign v j)) =
      if a = i ∧ b = j then 1 else 0 := by
  have e : ∀ u, ∑ v ∈ t.powerset, patternSign u a * patternSign v b *
      (patternSign u i * patternSign v j) =
        (patternSign u a * patternSign u i) * ∑ v ∈ t.powerset, patternSign v b * patternSign v j :=
    fun u => by rw [Finset.mul_sum]; exact Finset.sum_congr rfl fun v _ => by ring
  simp_rw [e, sum_patternSign_mul t hb hj]
  have e2 : ∀ u, ((2 : ℝ) ^ t.card)⁻¹ * (patternSign u a * patternSign u i *
      (if b = j then (2 : ℝ) ^ t.card else 0)) =
      (((2 : ℝ) ^ t.card)⁻¹ * (if b = j then (2 : ℝ) ^ t.card else 0)) *
        (patternSign u a * patternSign u i) := fun u => by ring
  simp_rw [e2, ← Finset.mul_sum, sum_patternSign_mul s ha hi]
  have h2s : (2 : ℝ) ^ s.card ≠ 0 := by positivity
  have h2t : (2 : ℝ) ^ t.card ≠ 0 := by positivity
  by_cases h1 : a = i <;> by_cases h2 : b = j <;> simp [h1, h2, h2s, h2t]

end PieceSelection

section PieceSelection2


/-- The randomized tuple: slot `a` carries `Σ_i ε_i x_i`, slot `b` carries `Σ_k η_k w_k`, the other
slots are fixed. -/
noncomputable def randTuple {ι κ : Type*} [DecidableEq ι] [DecidableEq κ] (a b : Fin 4)
    (f : Fin 4 → ℝ → ℂ) (s : Finset ι) (t : Finset κ) (x : ι → ℝ → ℂ) (w : κ → ℝ → ℂ)
    (u : Finset ι) (v : Finset κ) : Fin 4 → ℝ → ℂ :=
  Function.update (Function.update f a (fun y => ∑ i ∈ s, (patternSign u i : ℂ) * x i y)) b
    (fun y => ∑ k ∈ t, (patternSign v k : ℂ) * w k y)

/-- Blueprint lines 2421-2423 (expectation selects the positions): averaging `ε_{i₀} η_{k₀}`
times the form of the randomized tuple over both sign families gives the form of the selected
positions. -/
theorem form_sign_avg {κ' : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w₀ : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ' a₀ r w₀) {ι κ : Type*} [DecidableEq ι] [DecidableEq κ]
    {a b : Fin 4} (hab : a ≠ b) (f : Fin 4 → ℝ → ℂ) (hf : ∀ j, Measurable (f j))
    (hfin : ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (s : Finset ι) (t : Finset κ) (x : ι → ℝ → ℂ) (w : κ → ℝ → ℂ)
    (hx : ∀ i, Measurable (x i)) (hxf : ∀ i, eLpNorm (x i) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hwm : ∀ k, Measurable (w k)) (hwf : ∀ k, eLpNorm (w k) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    {i₀ : ι} {k₀ : κ} (hi₀ : i₀ ∈ s) (hk₀ : k₀ ∈ t) :
    ((2 : ℂ) ^ s.card)⁻¹ * ∑ u ∈ s.powerset, (((2 : ℂ) ^ t.card)⁻¹ *
      ∑ v ∈ t.powerset, (patternSign u i₀ : ℂ) * patternSign v k₀ *
        localProgressionForm r w₀ (randTuple a b f s t x w u v)) =
      localProgressionForm r w₀ (Function.update (Function.update f a (x i₀)) b (w k₀)) := by
  classical
  -- expand both randomized slots
  have hexp : ∀ u v, localProgressionForm r w₀ (randTuple a b f s t x w u v) =
      ∑ i ∈ s, ∑ k ∈ t, ((patternSign u i : ℂ) * patternSign v k) *
        localProgressionForm r w₀ (Function.update (Function.update f a (x i)) b (w k)) := by
    intro u v
    have hfa : ∀ j, Measurable (Function.update f a (fun y => ∑ i ∈ s,
        (patternSign u i : ℂ) * x i y) j) := by
      intro j
      by_cases hj : j = a
      · subst hj; simp only [Function.update_self]
        exact Finset.measurable_sum _ fun i _ => measurable_const.mul (hx i)
      · rw [Function.update_of_ne hj]; exact hf j
    have hfaf : ∀ j, eLpNorm (Function.update f a (fun y => ∑ i ∈ s,
        (patternSign u i : ℂ) * x i y) j) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
      intro j
      by_cases hj : j = a
      · subst hj; simp only [Function.update_self]
        have hm : MemLp (fun y => ∑ i ∈ s, (patternSign u i : ℂ) * x i y) 2
            (normalizedIntervalMeasure a₀ r) :=
          memLp_finsetSum s fun i _ => MemLp.const_mul (Ne.lt_top (hxf i)) _
        exact hm.eLpNorm_ne_top
      · rw [Function.update_of_ne hj]; exact hfin j
    unfold randTuple
    rw [localProgressionForm_update_sum hr hw hfa hfaf b t (fun k => (patternSign v k : ℂ)) w
      hwm hwf]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => ?_
    have hfb : ∀ j, Measurable (Function.update f b (w k) j) := by
      intro j
      by_cases hj : j = b
      · subst hj; simp only [Function.update_self]; exact hwm k
      · rw [Function.update_of_ne hj]; exact hf j
    have hfbf : ∀ j, eLpNorm (Function.update f b (w k) j) 2
        (normalizedIntervalMeasure a₀ r) ≠ ⊤ := by
      intro j
      by_cases hj : j = b
      · subst hj; simp only [Function.update_self]; exact hwf k
      · rw [Function.update_of_ne hj]; exact hfin j
    rw [Function.update_comm hab, localProgressionForm_update_sum hr hw hfb hfbf a s
      (fun i => (patternSign u i : ℂ)) x hx hxf, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Function.update_comm hab]
    ring
  simp_rw [hexp]
  -- collapse with the sign selection
  set F : ι → κ → ℂ := fun i k =>
    localProgressionForm r w₀ (Function.update (Function.update f a (x i)) b (w k))
  have hsel : ∀ i ∈ s, ∀ k ∈ t, ((2 : ℂ) ^ s.card)⁻¹ * ∑ u ∈ s.powerset, (((2 : ℂ) ^ t.card)⁻¹ *
      ∑ v ∈ t.powerset, (patternSign u i₀ : ℂ) * patternSign v k₀ *
        ((patternSign u i : ℂ) * patternSign v k)) = if i₀ = i ∧ k₀ = k then 1 else 0 := by
    intro i hi k hk
    have h := sign_select_two s t hi₀ hi hk₀ hk
    have h' := congrArg (fun z : ℝ => (z : ℂ)) h
    simp only [Complex.ofReal_mul, Complex.ofReal_sum, Complex.ofReal_inv, Complex.ofReal_pow,
      Complex.ofReal_ofNat] at h'
    rw [h']
    split_ifs <;> simp
  calc ((2 : ℂ) ^ s.card)⁻¹ * ∑ u ∈ s.powerset, (((2 : ℂ) ^ t.card)⁻¹ *
        ∑ v ∈ t.powerset, (patternSign u i₀ : ℂ) * patternSign v k₀ *
          ∑ i ∈ s, ∑ k ∈ t, ((patternSign u i : ℂ) * patternSign v k) * F i k)
      = ∑ i ∈ s, ∑ k ∈ t, (((2 : ℂ) ^ s.card)⁻¹ * ∑ u ∈ s.powerset, (((2 : ℂ) ^ t.card)⁻¹ *
          ∑ v ∈ t.powerset, (patternSign u i₀ : ℂ) * patternSign v k₀ *
            ((patternSign u i : ℂ) * patternSign v k))) * F i k := by
        have hswap : ∀ g : Finset ι → Finset κ → ι → κ → ℂ,
            ∑ u ∈ s.powerset, ∑ v ∈ t.powerset, ∑ i ∈ s, ∑ k ∈ t, g u v i k =
              ∑ i ∈ s, ∑ k ∈ t, ∑ u ∈ s.powerset, ∑ v ∈ t.powerset, g u v i k := by
          intro g
          calc _ = ∑ u ∈ s.powerset, ∑ i ∈ s, ∑ v ∈ t.powerset, ∑ k ∈ t, g u v i k :=
                Finset.sum_congr rfl fun u _ => Finset.sum_comm
            _ = ∑ u ∈ s.powerset, ∑ i ∈ s, ∑ k ∈ t, ∑ v ∈ t.powerset, g u v i k :=
                Finset.sum_congr rfl fun u _ => Finset.sum_congr rfl fun i _ => Finset.sum_comm
            _ = ∑ i ∈ s, ∑ u ∈ s.powerset, ∑ k ∈ t, ∑ v ∈ t.powerset, g u v i k :=
                Finset.sum_comm
            _ = _ := Finset.sum_congr rfl fun i _ => Finset.sum_comm
        simp only [Finset.mul_sum, Finset.sum_mul]
        rw [hswap]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun k _ =>
          Finset.sum_congr rfl fun u _ => Finset.sum_congr rfl fun v _ => ?_
        ring
    _ = F i₀ k₀ := by
        rw [Finset.sum_eq_single i₀ (fun i hi hne => Finset.sum_eq_zero fun k hk => by
            rw [hsel i hi k hk, ite_eq_right_iff.mpr (fun h => absurd h.1.symm hne), zero_mul])
          (fun h => absurd hi₀ h),
          Finset.sum_eq_single k₀ (fun k hk hne => by
            rw [hsel i₀ hi₀ k hk, ite_eq_right_iff.mpr (fun h => absurd h.2.symm hne), zero_mul])
          (fun h => absurd hk₀ h), hsel i₀ hi₀ k₀ hk₀,
          ite_eq_left_iff.mpr (fun h => absurd ⟨rfl, rfl⟩ h), one_mul]

end PieceSelection2

section PieceSelection3

theorem rademacherSum_complex {ι : Type*} [DecidableEq ι] (s u : Finset ι) (v : ι → ℂ) :
    rademacherSum s u v = ∑ i ∈ s, (patternSign u i : ℂ) * v i := by
  rw [rademacherSum_eq_sign]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Complex.real_smul]

/-- The fourth moment of the randomized slot under two independent sign families. -/
theorem randSlot_moment {ι κ : Type*} [DecidableEq ι] (s : Finset ι)
    (t : Finset κ) (x : ι → ℝ → ℂ) (y : ℝ) :
    (∫⁻ σ, ‖∑ i ∈ s, (patternSign σ.1.1 i : ℂ) * x i y‖ₑ ^ (4 : ℝ)
        ∂((signMeasure s).prod (signMeasure t))) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal 4 * ENNReal.ofReal (Real.sqrt (∑ i ∈ s, ‖x i y‖ ^ 2)) := by
  have e : ∫⁻ σ, ‖∑ i ∈ s, (patternSign σ.1.1 i : ℂ) * x i y‖ₑ ^ (4 : ℝ)
      ∂((signMeasure s).prod (signMeasure t)) =
      ∫⁻ σ, ‖rademacherSum s σ.1 (fun i => x i y)‖ₑ ^ (4 : ℝ) ∂(signMeasure s) := by
    rw [lintegral_signMeasure_prod, lintegral_signMeasure]
    congr 1
    refine Finset.sum_congr rfl fun σ₁ _ => ?_
    dsimp only
    rw [Finset.sum_const, Finset.card_univ, card_signPattern, nsmul_eq_mul, ← mul_assoc]
    have h2 : (2 ^ t.card : ℝ≥0∞)⁻¹ * ((2 ^ t.card : ℕ) : ℝ≥0∞) = 1 := by
      push_cast
      exact ENNReal.inv_mul_cancel (by positivity) (by simp)
    rw [h2, one_mul, rademacherSum_complex]
  rw [e]
  exact rademacher_moment_hyp s x y

/-- Blueprint lines 2421-2445 (fixed stacks randomized for `lem:shortblock`): on a short-block
piece, the cell sum of the forms with two slots selected from position stacks at each use (and
arbitrary signs) is bounded by the short-block constant times the stack and slot sizes. -/
theorem piece_select_bound (κ : LocalKernelClass) {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) :
    ∃ Cq : ℝ, 0 ≤ Cq ∧ ∀ (G : RealDyadicGrid) (K Nd : ℕ), K ≤ Nd →
      ∀ (T : ShortBlockTree G K) {ι κ' : Type} [DecidableEq ι] [DecidableEq κ']
        (s : Finset ι) (t : Finset κ') {a b : Fin 4}, a ≠ b →
      ∀ (f : Fin 4 → ℝ → ℂ) (x : ι → ℝ → ℂ) (w : κ' → ℝ → ℂ), (∀ j, Measurable (f j)) →
      (∀ i, Measurable (x i)) → (∀ k, Measurable (w k)) →
      ∀ (kernel : ℤ × ℤ → ℝ × ℝ → ℂ), (∀ I ∈ T.internal, IsAdmissibleLocalKernel κ
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (kernel I)) →
      ∀ cells ⊆ T.internal,
      (∀ I ∈ cells, ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ I ∈ cells, ∀ i, eLpNorm (x i) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ I ∈ cells, ∀ k, eLpNorm (w k) 2 (normalizedIntervalMeasure (dyadicGridLeft G I.1 I.2)
        (dyadicGridLength G I.1)) ≠ ⊤) →
      ∀ sv : Fin 4 → ℝ, (∀ j, 0 ≤ sv j) →
      (∀ L ∈ T.leaves, ∫⁻ y in dyadicGridCell G L.1 L.2, ENNReal.ofReal (∑ i ∈ s, ‖x i y‖ ^ 2) ≤
        ENNReal.ofReal (sv a ^ 2 * dyadicGridLength G L.1)) →
      (∀ L ∈ T.leaves, ∫⁻ y in dyadicGridCell G L.1 L.2, ENNReal.ofReal (∑ k ∈ t, ‖w k y‖ ^ 2) ≤
        ENNReal.ofReal (sv b ^ 2 * dyadicGridLength G L.1)) →
      (∀ j, j ≠ a → j ≠ b → ∀ L ∈ T.leaves, ∫⁻ y in dyadicGridCell G L.1 L.2, ‖f j y‖ₑ ^ 2 ≤
        ENNReal.ofReal (sv j ^ 2 * dyadicGridLength G L.1)) →
      ∀ (sa : ℤ × ℤ → ι) (sb : ℤ × ℤ → κ'), (∀ I ∈ cells, sa I ∈ s) → (∀ I ∈ cells, sb I ∈ t) →
      ∀ sg : ℤ × ℤ → ℂ, (∀ I, ‖sg I‖ ≤ 1) →
      ‖∑ I ∈ cells, (dyadicGridLength G I.1 : ℂ) * sg I * localProgressionForm
          (dyadicGridLength G I.1) (kernel I)
            (Function.update (Function.update f a (x (sa I))) b (w (sb I)))‖ ≤
        Cq * (1 + finiteDepthConstant κ q Nd) * (1 + Real.log ((K : ℝ) + 2)) *
          ((K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) * dyadicGridLength G T.root.1 * ∏ j, sv j := by
  obtain ⟨Cq, hCq, hsbc⟩ := short_block_comparison κ hq2 hq3 (C4 := 4) (by norm_num)
  refine ⟨Cq, hCq, ?_⟩
  intro G K Nd hKN T ι κ' _ _ s t a b hab f x w hf hx hw kernel hker cells hcells hff hxf hwf sv
    hsv hla hlb hlo sa sb hsa hsb sg hsg
  classical
  -- the deterministic sizes and the randomized slots
  set z : Fin 4 → ℝ → ℝ := fun j y => if j = a then Real.sqrt (∑ i ∈ s, ‖x i y‖ ^ 2)
    else if j = b then Real.sqrt (∑ k ∈ t, ‖w k y‖ ^ 2) else ‖f j y‖
  set Ω := SignPattern s × SignPattern t
  set P : Measure Ω := (signMeasure s).prod (signMeasure t)
  set zσ : Fin 4 → Ω → ℝ → ℂ := fun j σ => randTuple a b f s t x w σ.1.1 σ.2.1 j
  set ε : ℤ × ℤ → Ω → ℂ := fun I σ => sg I * (patternSign σ.1.1 (sa I) : ℂ) *
    patternSign σ.2.1 (sb I)
  have hz0 : ∀ j y, 0 ≤ z j y := fun j y => by
    simp only [z]; split_ifs <;> positivity
  have hzm : ∀ j, Measurable fun y => ‖z j y‖ := by
    intro j
    simp only [z]
    split_ifs
    · exact (Real.continuous_sqrt.measurable.comp (Finset.measurable_sum _ fun i _ =>
        ((hx i).norm.pow_const 2))).norm
    · exact (Real.continuous_sqrt.measurable.comp (Finset.measurable_sum _ fun k _ =>
        ((hw k).norm.pow_const 2))).norm
    · exact (hf j).norm.norm
  have hleaf : ∀ j, ∀ L ∈ T.leaves, ∫⁻ y in dyadicGridCell G L.1 L.2, ‖z j y‖ₑ ^ 2 ≤
      ENNReal.ofReal (sv j ^ 2 * dyadicGridLength G L.1) := by
    intro j L hL
    by_cases hja : j = a
    · subst hja
      refine le_trans (le_of_eq ?_) (hla L hL)
      refine setLIntegral_congr_fun (dyadicGridCell_measurable _ _ _) fun y _ => ?_
      simp only [z, ↓reduceIte]
      rw [Real.enorm_eq_ofReal (Real.sqrt_nonneg _), ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
        Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
    · by_cases hjb : j = b
      · subst hjb
        refine le_trans (le_of_eq ?_) (hlb L hL)
        refine setLIntegral_congr_fun (dyadicGridCell_measurable _ _ _) fun y _ => ?_
        simp only [z, hja, ↓reduceIte]
        rw [Real.enorm_eq_ofReal (Real.sqrt_nonneg _), ← ENNReal.ofReal_pow (Real.sqrt_nonneg _),
          Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
      · refine le_trans (le_of_eq ?_) (hlo j hja hjb L hL)
        refine setLIntegral_congr_fun (dyadicGridCell_measurable _ _ _) fun y _ => ?_
        simp only [z, hja, hjb, ↓reduceIte, enorm_norm]
  have hzσm : ∀ j, Measurable (Function.uncurry (zσ j)) := by
    intro j
    refine measurable_from_prod_countable_right fun σ => ?_
    change Measurable (randTuple a b f s t x w σ.1.1 σ.2.1 j)
    unfold randTuple
    by_cases hjb : j = b
    · subst hjb; simp only [Function.update_self]
      exact Finset.measurable_sum _ fun k _ => measurable_const.mul (hw k)
    · rw [Function.update_of_ne hjb]
      by_cases hja : j = a
      · subst hja; simp only [Function.update_self]
        exact Finset.measurable_sum _ fun i _ => measurable_const.mul (hx i)
      · rw [Function.update_of_ne hja]; exact hf j
  have hmom : ∀ j y, (∫⁻ σ, ‖zσ j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal 4 * ‖z j y‖ₑ := by
    intro j y
    by_cases hjb : j = b
    · subst hjb
      have e : ∀ σ : Ω, zσ j σ y = ∑ k ∈ t, (patternSign σ.2.1 k : ℂ) * w k y := fun σ => by
        simp [zσ, randTuple]
      simp_rw [e]
      have hzb : ‖z j y‖ₑ = ENNReal.ofReal (Real.sqrt (∑ k ∈ t, ‖w k y‖ ^ 2)) := by
        have : z j y = Real.sqrt (∑ k ∈ t, ‖w k y‖ ^ 2) := by
          simp [z, Ne.symm hab]
        rw [this]
        exact Real.enorm_eq_ofReal (Real.sqrt_nonneg _)
      rw [hzb]
      -- the moment over the second family
      have e2 : ∫⁻ σ, ‖∑ k ∈ t, (patternSign σ.2.1 k : ℂ) * w k y‖ₑ ^ (4 : ℝ) ∂P =
          ∫⁻ σ, ‖rademacherSum t σ.1 (fun k => w k y)‖ₑ ^ (4 : ℝ) ∂(signMeasure t) := by
        rw [lintegral_signMeasure_prod, lintegral_signMeasure]
        dsimp only
        simp_rw [rademacherSum_complex]
        rw [Finset.sum_const, Finset.card_univ, card_signPattern, nsmul_eq_mul, ← mul_assoc]
        have h2 : (2 ^ s.card : ℝ≥0∞)⁻¹ * ((2 ^ s.card : ℕ) : ℝ≥0∞) = 1 := by
          push_cast
          exact ENNReal.inv_mul_cancel (by positivity) (by simp)
        rw [h2, one_mul]
      rw [e2]
      exact rademacher_moment_hyp t w y
    · by_cases hja : j = a
      · subst hja
        have e : ∀ σ : Ω, zσ j σ y = ∑ i ∈ s, (patternSign σ.1.1 i : ℂ) * x i y := fun σ => by
          simp [zσ, randTuple, Function.update_of_ne hab]
        simp_rw [e]
        have hza : ‖z j y‖ₑ = ENNReal.ofReal (Real.sqrt (∑ i ∈ s, ‖x i y‖ ^ 2)) := by
          have : z j y = Real.sqrt (∑ i ∈ s, ‖x i y‖ ^ 2) := by simp [z]
          rw [this]
          exact Real.enorm_eq_ofReal (Real.sqrt_nonneg _)
        rw [hza]
        exact randSlot_moment s t x y
      · have e : ∀ σ : Ω, zσ j σ y = f j y := fun σ => by
          simp [zσ, randTuple, Function.update_of_ne hjb, Function.update_of_ne hja]
        simp_rw [e]
        rw [lintegral_const, measure_univ, mul_one, ← ENNReal.rpow_mul]
        have hzo : ‖z j y‖ₑ = ‖f j y‖ₑ := by
          simp only [z, hja, hjb, ↓reduceIte, enorm_norm]
        rw [hzo, show (4 : ℝ) * (1 / 4) = 1 by norm_num, ENNReal.rpow_one]
        exact le_mul_of_one_le_left (by simp) (by rw [ENNReal.one_le_ofReal]; norm_num)
  have hεm : ∀ I, Measurable (ε I) := fun I => Measurable.of_discrete
  have hε1 : ∀ I σ, ‖ε I σ‖ ≤ 1 := by
    intro I σ
    have h1 : ‖(patternSign σ.1.1 (sa I) : ℂ)‖ = 1 := by
      unfold patternSign; split_ifs <;> simp
    have h2 : ‖(patternSign σ.2.1 (sb I) : ℂ)‖ = 1 := by
      unfold patternSign; split_ifs <;> simp
    simp only [ε, norm_mul, h1, h2, mul_one]
    exact hsg I
  have hmain := hsbc G K Nd hKN T z hzm sv hsv hleaf P zσ hzσm hmom kernel hker cells hcells ε
    hεm hε1
  -- the average over the signs selects the positions
  have hsel : ∀ I ∈ cells, ((2 : ℂ) ^ s.card)⁻¹ * ∑ σ₁ : SignPattern s, (((2 : ℂ) ^ t.card)⁻¹ *
      ∑ σ₂ : SignPattern t, (patternSign σ₁.1 (sa I) : ℂ) * patternSign σ₂.1 (sb I) *
        localProgressionForm (dyadicGridLength G I.1) (kernel I)
          (randTuple a b f s t x w σ₁.1 σ₂.1)) =
      localProgressionForm (dyadicGridLength G I.1) (kernel I)
        (Function.update (Function.update f a (x (sa I))) b (w (sb I))) := by
    intro I hI
    have h := form_sign_avg (dyadicGridLength_pos G I.1) (hker I (hcells hI)) hab f hf
      (hff I hI) s t x w hx (hxf I hI) hw (hwf I hI) (hsa I hI) (hsb I hI)
    rw [← h]
    congr 1
    rw [← Finset.sum_coe_sort s.powerset]
    refine Finset.sum_congr rfl fun σ₁ _ => ?_
    congr 1
    exact Finset.sum_coe_sort t.powerset (fun v => (patternSign σ₁.1 (sa I) : ℂ) *
      patternSign v (sb I) * localProgressionForm (dyadicGridLength G I.1) (kernel I)
        (randTuple a b f s t x w σ₁.1 v))
  set X : Ω → ℂ := fun σ => ∑ I ∈ cells, (dyadicGridLength G I.1 : ℂ) * ε I σ *
    localProgressionForm (dyadicGridLength G I.1) (kernel I) (fun j => zσ j σ)
  have hswap3 : ∀ g : SignPattern s → SignPattern t → ℤ × ℤ → ℂ,
      ∑ σ₁, ∑ σ₂, ∑ I ∈ cells, g σ₁ σ₂ I = ∑ I ∈ cells, ∑ σ₁, ∑ σ₂, g σ₁ σ₂ I := by
    intro g
    calc _ = ∑ σ₁, ∑ I ∈ cells, ∑ σ₂, g σ₁ σ₂ I :=
          Finset.sum_congr rfl fun σ₁ _ => Finset.sum_comm
      _ = _ := Finset.sum_comm
  have havg : ((2 : ℂ) ^ s.card)⁻¹ * ∑ σ₁ : SignPattern s, (((2 : ℂ) ^ t.card)⁻¹ *
      ∑ σ₂ : SignPattern t, X (σ₁, σ₂)) =
      ∑ I ∈ cells, (dyadicGridLength G I.1 : ℂ) * sg I * localProgressionForm
        (dyadicGridLength G I.1) (kernel I)
          (Function.update (Function.update f a (x (sa I))) b (w (sb I))) := by
    have e1 : ((2 : ℂ) ^ s.card)⁻¹ * ∑ σ₁ : SignPattern s, (((2 : ℂ) ^ t.card)⁻¹ *
        ∑ σ₂ : SignPattern t, X (σ₁, σ₂)) =
        ∑ σ₁, ∑ σ₂, ∑ I ∈ cells, ((2 : ℂ) ^ s.card)⁻¹ * (((2 : ℂ) ^ t.card)⁻¹ *
          ((dyadicGridLength G I.1 : ℂ) * ε I (σ₁, σ₂) *
            localProgressionForm (dyadicGridLength G I.1) (kernel I)
              (fun j => zσ j (σ₁, σ₂)))) := by
      simp only [X, Finset.mul_sum]
    rw [e1, hswap3]
    refine Finset.sum_congr rfl fun I hI => ?_
    rw [← hsel I hI, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun σ₁ _ => ?_
    rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun σ₂ _ => ?_
    simp only [ε, zσ]
    ring
  -- the triangle inequality for the average
  have hX : ‖((2 : ℂ) ^ s.card)⁻¹ * ∑ σ₁ : SignPattern s, (((2 : ℂ) ^ t.card)⁻¹ *
      ∑ σ₂ : SignPattern t, X (σ₁, σ₂))‖ ≤ (∫⁻ σ, ‖X σ‖ₑ ∂P).toReal := by
    rw [lintegral_signMeasure_prod]
    have hfin : ∀ σ₁ : SignPattern s, ∑ σ₂ : SignPattern t, ‖X (σ₁, σ₂)‖ₑ ≠ ⊤ := fun σ₁ =>
      ENNReal.sum_ne_top.mpr fun _ _ => enorm_ne_top
    rw [ENNReal.toReal_mul, ENNReal.toReal_sum (fun σ₁ _ => ENNReal.mul_ne_top (by simp)
      (hfin σ₁))]
    simp_rw [ENNReal.toReal_mul, ENNReal.toReal_sum (fun _ _ => enorm_ne_top), toReal_enorm]
    rw [norm_mul]
    refine mul_le_mul (le_of_eq (by simp)) ((norm_sum_le _ _).trans (Finset.sum_le_sum
      fun σ₁ _ => ?_)) (norm_nonneg _) (by positivity)
    rw [norm_mul]
    exact mul_le_mul (le_of_eq (by simp)) (norm_sum_le _ _) (norm_nonneg _) (by positivity)
  rw [← havg]
  refine hX.trans (ENNReal.toReal_le_of_le_ofReal ?_ hmain)
  have hK0 : 0 ≤ (1 : ℝ) + Real.log ((K : ℝ) + 2) := by
    have := Real.log_nonneg (show (1 : ℝ) ≤ K + 2 by linarith [(Nat.cast_nonneg K : (0 : ℝ) ≤ K)])
    linarith
  have hCN := (finiteDepthConstant_bounds κ hq2.le Nd).1
  have := dyadicGridLength_pos G T.root.1
  have : 0 ≤ ∏ j, sv j := Finset.prod_nonneg fun j _ => hsv j
  positivity

end PieceSelection3

/-- The total length of a pairwise disjoint finite family of dyadic cells is the measure of their
union. -/
theorem dyadicRootLength_eq_volume (G : RealDyadicGrid) (S : Finset (ℤ × ℤ))
    (hS : Set.PairwiseDisjoint (S : Set (ℤ × ℤ)) (fun c => dyadicGridCell G c.1 c.2)) :
    dyadicRootLength G S = (volume (⋃ c ∈ S, dyadicGridCell G c.1 c.2)).toReal := by
  rw [measure_biUnion_finset hS (fun c _ => dyadicGridCell_measurable G c.1 c.2),
    ENNReal.toReal_sum (fun c _ => by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)]
  unfold dyadicRootLength
  refine Finset.sum_congr rfl fun c _ => ?_
  rw [dyadicGridCell_volume, ENNReal.toReal_ofReal (dyadicGridLength_pos G c.1).le]

section SparseRoots

variable (G : RealDyadicGrid) (H : Finset (ℤ × ℤ)) (ga gb : ℝ → ℝ≥0∞)

open Classical in
/-- The stopping cells below a root `Q` (blueprint lines 2430-2431): the maximal cells of the hull
strictly below `Q` where either squared stack average exceeds sixteen times its value at `Q`. -/
noncomputable def sparseStops (Q : ℤ × ℤ) : Finset (ℤ × ℤ) :=
  maximalDyadicCells G (H.filter fun c =>
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2 ∧ c ≠ Q ∧
      (16 * dyadicEnergyAverage G ga Q < dyadicEnergyAverage G ga c ∨
        16 * dyadicEnergyAverage G gb Q < dyadicEnergyAverage G gb c))

theorem sparseStops_sub (Q : ℤ × ℤ) {c : ℤ × ℤ} (hc : c ∈ sparseStops G H ga gb Q) :
    c ∈ H ∧ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2 ∧ c ≠ Q ∧
      (16 * dyadicEnergyAverage G ga Q < dyadicEnergyAverage G ga c ∨
        16 * dyadicEnergyAverage G gb Q < dyadicEnergyAverage G gb c) := by
  classical
  have h := maximalDyadicCells_subset G _ hc
  exact ⟨(Finset.mem_filter.mp h).1, (Finset.mem_filter.mp h).2⟩

theorem sparseStops_depth (Q : ℤ × ℤ) {c : ℤ × ℤ} (hc : c ∈ sparseStops G H ga gb Q) :
    Q.1 < c.1 := by
  obtain ⟨-, hsub, hne, -⟩ := sparseStops_sub G H ga gb Q hc
  exact dyadicGridCell_depth_lt_of_subset_ne G c Q hsub hne

theorem sparseStops_disjoint (Q : ℤ × ℤ) :
    Set.PairwiseDisjoint (sparseStops G H ga gb Q : Set (ℤ × ℤ))
      (fun c => dyadicGridCell G c.1 c.2) :=
  maximalDyadicCells_pairwiseDisjoint G _

open Classical in
/-- Blueprint line 2431: the stopping cells of a root have total length at most `|Q|/8`. -/
theorem sparseStops_length_le (Q : ℤ × ℤ) :
    dyadicRootLength G (sparseStops G H ga gb Q) ≤ dyadicGridLength G Q.1 / 8 := by
  classical
  set S := H.filter fun c => dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2 ∧ c ≠ Q ∧
    (16 * dyadicEnergyAverage G ga Q < dyadicEnergyAverage G ga c ∨
      16 * dyadicEnergyAverage G gb Q < dyadicEnergyAverage G gb c)
  have hvol := sparse_two_stacks_volume_le G (S.filter fun c =>
      dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2) Q
    (fun c hc => (Finset.mem_filter.mp hc).2) ga gb
  have hset : (⋃ c ∈ maximalDyadicCells G S, dyadicGridCell G c.1 c.2) ⊆
      ⋃ c ∈ (S.filter fun c => dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2).filter
        (fun c => 16 * dyadicEnergyAverage G ga Q < dyadicEnergyAverage G ga c ∨
          16 * dyadicEnergyAverage G gb Q < dyadicEnergyAverage G gb c),
        dyadicGridCell G c.1 c.2 := by
    rw [maximalDyadicCells_union]
    intro x hx
    simp only [Set.mem_iUnion] at hx ⊢
    obtain ⟨c, hc, hxc⟩ := hx
    obtain ⟨hcH, hsub, hne, hbig⟩ := Finset.mem_filter.mp hc
    exact ⟨c, Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨hc, hsub⟩, hbig⟩, hxc⟩
  have hlen := dyadicRootLength_eq_volume G (maximalDyadicCells G S)
    (maximalDyadicCells_pairwiseDisjoint G S)
  rw [show sparseStops G H ga gb Q = maximalDyadicCells G S from rfl, hlen]
  have hQ := dyadicGridLength_pos G Q.1
  have h1 := (measure_mono hset).trans hvol
  rw [dyadicGridCell_volume] at h1
  calc (volume (⋃ c ∈ maximalDyadicCells G S, dyadicGridCell G c.1 c.2)).toReal
      ≤ (ENNReal.ofReal (dyadicGridLength G Q.1) / 8).toReal :=
        ENNReal.toReal_mono (by simp [ENNReal.div_eq_top]) h1
    _ = dyadicGridLength G Q.1 / 8 := by
        rw [ENNReal.toReal_div, ENNReal.toReal_ofReal hQ.le]; norm_num

end SparseRoots

section SparseRoots2

variable (G : RealDyadicGrid) (H : Finset (ℤ × ℤ)) (ga gb : ℝ → ℝ≥0∞)

open Classical in
/-- The generations of the sparse decomposition of a root `Q₀`. -/
noncomputable def sparseGen (Q₀ : ℤ × ℤ) : ℕ → Finset (ℤ × ℤ)
  | 0 => {Q₀}
  | k + 1 => (sparseGen Q₀ k).biUnion (sparseStops G H ga gb)

theorem sparseGen_sub (Q₀ : ℤ × ℤ) :
    ∀ k, ∀ Q ∈ sparseGen G H ga gb Q₀ k,
      dyadicGridCell G Q.1 Q.2 ⊆ dyadicGridCell G Q₀.1 Q₀.2 ∧ Q₀.1 + k ≤ Q.1 := by
  intro k
  induction k with
  | zero =>
    intro Q hQ
    rw [sparseGen, Finset.mem_singleton] at hQ
    subst hQ; simp
  | succ k ih =>
    intro Q hQ
    simp only [sparseGen, Finset.mem_biUnion] at hQ
    obtain ⟨Q', hQ', hQQ'⟩ := hQ
    obtain ⟨-, hsub, -, -⟩ := sparseStops_sub G H ga gb Q' hQQ'
    have hd := sparseStops_depth G H ga gb Q' hQQ'
    obtain ⟨h1, h2⟩ := ih Q' hQ'
    exact ⟨hsub.trans h1, by push_cast; omega⟩

/-- The cells of one generation are pairwise disjoint. -/
theorem sparseGen_disjoint (Q₀ : ℤ × ℤ) :
    ∀ k, Set.PairwiseDisjoint (sparseGen G H ga gb Q₀ k : Set (ℤ × ℤ))
      (fun c => dyadicGridCell G c.1 c.2) := by
  intro k
  induction k with
  | zero =>
    intro a ha b hb hab
    rw [sparseGen, Finset.coe_singleton, Set.mem_singleton_iff] at ha hb
    exact absurd (ha.trans hb.symm) hab
  | succ k ih =>
    intro c hc d hd hcd
    simp only [sparseGen, Finset.coe_biUnion, Set.mem_iUnion, Finset.mem_coe] at hc hd
    obtain ⟨Q, hQ, hcQ⟩ := hc
    obtain ⟨Q', hQ', hdQ'⟩ := hd
    by_cases hQQ : Q = Q'
    · subst hQQ
      exact sparseStops_disjoint G H ga gb Q hcQ hdQ' hcd
    · have hdis := ih hQ hQ' hQQ
      exact Set.disjoint_of_subset (sparseStops_sub G H ga gb Q hcQ).2.1
        (sparseStops_sub G H ga gb Q' hdQ').2.1 hdis

/-- A root of a later generation lies in a stopping cell of the unique root of an earlier
generation containing it, and is disjoint from the other roots of that generation. -/
theorem sparseGen_later (Q₀ : ℤ × ℤ) :
    ∀ j k, j < k → ∀ Q ∈ sparseGen G H ga gb Q₀ k, ∀ Q' ∈ sparseGen G H ga gb Q₀ j,
      (∃ c ∈ sparseStops G H ga gb Q', dyadicGridCell G Q.1 Q.2 ⊆ dyadicGridCell G c.1 c.2) ∨
        Disjoint (dyadicGridCell G Q.1 Q.2) (dyadicGridCell G Q'.1 Q'.2) := by
  intro j k hjk
  induction k with
  | zero => omega
  | succ k ih =>
    intro Q hQ Q' hQ'
    simp only [sparseGen, Finset.mem_biUnion] at hQ
    obtain ⟨P, hP, hQP⟩ := hQ
    have hQPsub := (sparseStops_sub G H ga gb P hQP).2.1
    rcases Nat.lt_succ_iff_lt_or_eq.mp hjk with hlt | heq
    · rcases ih hlt P hP Q' hQ' with ⟨c, hc, hPc⟩ | hdis
      · exact Or.inl ⟨c, hc, hQPsub.trans hPc⟩
      · exact Or.inr (Set.disjoint_of_subset_left hQPsub hdis)
    · subst heq
      by_cases hPQ : P = Q'
      · subst hPQ; exact Or.inl ⟨Q, hQP, subset_rfl⟩
      · exact Or.inr (Set.disjoint_of_subset_left hQPsub (sparseGen_disjoint G H ga gb Q₀ j hP
          hQ' hPQ))

end SparseRoots2

section SparseRoots3

variable (G : RealDyadicGrid) (H : Finset (ℤ × ℤ)) (ga gb : ℝ → ℝ≥0∞)

open Classical in
/-- The roots of the sparse decomposition of `Q₀` up to `D` generations. -/
noncomputable def sparseRoots (Q₀ : ℤ × ℤ) (D : ℕ) : Finset (ℤ × ℤ) :=
  (Finset.range (D + 1)).biUnion (sparseGen G H ga gb Q₀)

/-- The remainder of a root: the root minus its stopping cells. -/
noncomputable def sparseRem (Q : ℤ × ℤ) : Set ℝ :=
  dyadicGridCell G Q.1 Q.2 \ ⋃ c ∈ sparseStops G H ga gb Q, dyadicGridCell G c.1 c.2

theorem sparseRem_measurable (Q : ℤ × ℤ) : MeasurableSet (sparseRem G H ga gb Q) :=
  (dyadicGridCell_measurable _ _ _).diff
    (Finset.measurableSet_biUnion _ fun _ _ => dyadicGridCell_measurable _ _ _)

theorem sparseRem_sub (Q : ℤ × ℤ) : sparseRem G H ga gb Q ⊆ dyadicGridCell G Q.1 Q.2 :=
  Set.sdiff_subset

/-- Blueprint line 2431: the remainder has measure at least `7|Q|/8`. -/
theorem sparseRem_volume (Q : ℤ × ℤ) :
    7 * ENNReal.ofReal (dyadicGridLength G Q.1) ≤ 8 * volume (sparseRem G H ga gb Q) := by
  classical
  have hQ := dyadicGridLength_pos G Q.1
  have hlen := sparseStops_length_le G H ga gb Q
  rw [dyadicRootLength_eq_volume G _ (sparseStops_disjoint G H ga gb Q)] at hlen
  have hUsub : (⋃ c ∈ sparseStops G H ga gb Q, dyadicGridCell G c.1 c.2) ⊆
      dyadicGridCell G Q.1 Q.2 :=
    Set.iUnion₂_subset fun c hc => (sparseStops_sub G H ga gb Q hc).2.1
  have hUfin : volume (⋃ c ∈ sparseStops G H ga gb Q, dyadicGridCell G c.1 c.2) ≠ ⊤ :=
    ne_top_of_le_ne_top (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)
      (measure_mono hUsub)
  have hU : volume (⋃ c ∈ sparseStops G H ga gb Q, dyadicGridCell G c.1 c.2) ≤
      ENNReal.ofReal (dyadicGridLength G Q.1 / 8) :=
    (ENNReal.le_ofReal_iff_toReal_le hUfin (by positivity)).mpr hlen
  have hcov : dyadicGridCell G Q.1 Q.2 ⊆ sparseRem G H ga gb Q ∪
      ⋃ c ∈ sparseStops G H ga gb Q, dyadicGridCell G c.1 c.2 := by
    intro x hx
    by_cases hxU : x ∈ ⋃ c ∈ sparseStops G H ga gb Q, dyadicGridCell G c.1 c.2
    · exact Or.inr hxU
    · exact Or.inl ⟨hx, hxU⟩
  have hle := (measure_mono (μ := volume) hcov).trans (measure_union_le _ _)
  rw [dyadicGridCell_volume] at hle
  have h8 : ENNReal.ofReal (dyadicGridLength G Q.1 / 8) =
      ENNReal.ofReal (dyadicGridLength G Q.1) / 8 := by
    rw [ENNReal.ofReal_div_of_pos (by norm_num)]; norm_num
  rw [h8] at hU
  set L := ENNReal.ofReal (dyadicGridLength G Q.1)
  have hLt : L ≠ ⊤ := ENNReal.ofReal_ne_top
  have h1 : L ≤ volume (sparseRem G H ga gb Q) + L / 8 := hle.trans (add_le_add le_rfl hU)
  calc 7 * L = 8 * L - L := by
        rw [show (8 : ℝ≥0∞) * L = 7 * L + L by ring, ENNReal.add_sub_cancel_right hLt]
    _ ≤ 8 * (volume (sparseRem G H ga gb Q) + L / 8) - L := by gcongr
    _ = 8 * volume (sparseRem G H ga gb Q) := by
        rw [mul_add, ENNReal.mul_div_cancel (by norm_num) (by norm_num),
          ENNReal.add_sub_cancel_right hLt]

/-- Distinct roots have disjoint remainders. -/
theorem sparseRem_disjoint (Q₀ : ℤ × ℤ) (D : ℕ) :
    Set.PairwiseDisjoint (sparseRoots G H ga gb Q₀ D : Set (ℤ × ℤ)) (sparseRem G H ga gb) := by
  classical
  intro Q hQ Q' hQ' hne
  simp only [sparseRoots, Finset.coe_biUnion, Finset.coe_range, Set.mem_iUnion, Set.mem_Iio,
    Finset.mem_coe] at hQ hQ'
  obtain ⟨j, -, hQj⟩ := hQ
  obtain ⟨k, -, hQk⟩ := hQ'
  have key : ∀ {P P' : ℤ × ℤ} {a b : ℕ}, a < b → P ∈ sparseGen G H ga gb Q₀ a →
      P' ∈ sparseGen G H ga gb Q₀ b →
        Disjoint (sparseRem G H ga gb P) (sparseRem G H ga gb P') := by
    intro P P' a b hab hP hP'
    rcases sparseGen_later G H ga gb Q₀ a b hab P' hP' P hP with ⟨c, hc, hP'c⟩ | hdis
    · refine Set.disjoint_left.mpr fun x hx hx' => ?_
      exact hx.2 (Set.mem_biUnion hc (hP'c (sparseRem_sub G H ga gb P' hx')))
    · exact Set.disjoint_of_subset (sparseRem_sub G H ga gb P) (sparseRem_sub G H ga gb P')
        hdis.symm
  rcases lt_trichotomy j k with hjk | rfl | hjk
  · exact key hjk hQj hQk
  · exact Set.disjoint_of_subset (sparseRem_sub G H ga gb Q) (sparseRem_sub G H ga gb Q')
      (sparseGen_disjoint G H ga gb Q₀ j hQj hQk hne)
  · exact (key hjk hQk hQj).symm

open Classical in
/-- Blueprint line 2432 ("a child's squared average is at most twice its parent's; hence side leaf
norms are bounded multiples of the root sizes"): every hull cell below `Q₀` within `D` depths is
owned by a root containing it but no stopping cell of it, where both stack averages are at most
sixteen times those of the root. -/
theorem sparse_owner (Q₀ : ℤ × ℤ) (D : ℕ) {c : ℤ × ℤ} (hcH : c ∈ H)
    (hcQ : dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q₀.1 Q₀.2) (hcD : c.1 ≤ Q₀.1 + D) :
    ∃ Q ∈ sparseRoots G H ga gb Q₀ D, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2 ∧
      (∀ s ∈ sparseStops G H ga gb Q, ¬ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G s.1 s.2) ∧
      dyadicEnergyAverage G ga c ≤ 16 * dyadicEnergyAverage G ga Q ∧
      dyadicEnergyAverage G gb c ≤ 16 * dyadicEnergyAverage G gb Q := by
  set Rc := (sparseRoots G H ga gb Q₀ D).filter fun Q =>
    dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2
  have hne : Rc.Nonempty := ⟨Q₀, Finset.mem_filter.mpr ⟨Finset.mem_biUnion.mpr
    ⟨0, Finset.mem_range.mpr (by omega), by simp [sparseGen]⟩, hcQ⟩⟩
  obtain ⟨Q, hQR, hmax⟩ := Rc.exists_max_image (fun Q => Q.1) hne
  obtain ⟨hQr, hcQ'⟩ := Finset.mem_filter.mp hQR
  have hnot : ∀ s ∈ sparseStops G H ga gb Q,
      ¬ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G s.1 s.2 := by
    intro s hs hcs
    obtain ⟨j, hj, hQj⟩ := Finset.mem_biUnion.mp hQr
    have hsj : s ∈ sparseGen G H ga gb Q₀ (j + 1) :=
      Finset.mem_biUnion.mpr ⟨Q, hQj, hs⟩
    have hsd := (sparseGen_sub G H ga gb Q₀ (j + 1) s hsj).2
    have hcs' := dyadicGridCell_depth_le_of_subset G c s hcs
    have hsR : s ∈ sparseRoots G H ga gb Q₀ D := Finset.mem_biUnion.mpr
      ⟨j + 1, Finset.mem_range.mpr (by push_cast at hsd; omega), hsj⟩
    have := hmax s (Finset.mem_filter.mpr ⟨hsR, hcs⟩)
    have := sparseStops_depth G H ga gb Q hs
    omega
  refine ⟨Q, hQr, hcQ', hnot, ?_, ?_⟩
  all_goals
    by_cases hcq : c = Q
    · subst hcq
      exact le_mul_of_one_le_left (by positivity) (by norm_num)
    · by_contra hbig
      rw [not_le] at hbig
      obtain ⟨s, hs, hcs⟩ := maximalDyadicCells_covers G (H.filter fun c =>
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2 ∧ c ≠ Q ∧
          (16 * dyadicEnergyAverage G ga Q < dyadicEnergyAverage G ga c ∨
            16 * dyadicEnergyAverage G gb Q < dyadicEnergyAverage G gb c))
        (Finset.mem_filter.mpr
          ⟨hcH, hcQ', hcq, by first | exact Or.inl hbig | exact Or.inr hbig⟩)
      exact hnot s hs hcs

end SparseRoots3

section SparsePieces

variable (G : RealDyadicGrid) (H : Finset (ℤ × ℤ)) (ga gb : ℝ → ℝ≥0∞)

open Classical in
/-- Blueprint lines 2432-2435: on the internal cells of the piece of a sparse root (the owned
cells and their ancestors below the root, all in the hull), both stack averages are at most
sixteen times those of the root. -/
theorem piece_internal_avg_le (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ))
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2)
    (hown : ∀ c ∈ C, ∀ s ∈ sparseStops G H ga gb Q,
      ¬ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G s.1 s.2)
    (hhull : ∀ c ∈ C, ∀ d : ℤ × ℤ, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G Q.1 Q.2 → d ∈ H)
    {d : ℤ × ℤ} (hd : d ∈ pieceInternal G Q C) :
    dyadicEnergyAverage G ga d ≤ 16 * dyadicEnergyAverage G ga Q ∧
      dyadicEnergyAverage G gb d ≤ 16 * dyadicEnergyAverage G gb Q := by
  rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, hc, hcd, hdQ⟩
  · exact ⟨le_mul_of_one_le_left (by positivity) (by norm_num),
      le_mul_of_one_le_left (by positivity) (by norm_num)⟩
  · have hdH := hhull c hc d hcd hdQ
    by_cases hdq : d = Q
    · subst hdq
      exact ⟨le_mul_of_one_le_left (by positivity) (by norm_num),
        le_mul_of_one_le_left (by positivity) (by norm_num)⟩
    have key : ¬ (16 * dyadicEnergyAverage G ga Q < dyadicEnergyAverage G ga d ∨
        16 * dyadicEnergyAverage G gb Q < dyadicEnergyAverage G gb d) := by
      intro hbig
      obtain ⟨s, hs, hds⟩ := maximalDyadicCells_covers G (H.filter fun c =>
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2 ∧ c ≠ Q ∧
          (16 * dyadicEnergyAverage G ga Q < dyadicEnergyAverage G ga c ∨
            16 * dyadicEnergyAverage G gb Q < dyadicEnergyAverage G gb c))
        (Finset.mem_filter.mpr ⟨hdH, hdQ, hdq, hbig⟩)
      exact hown c hc s hs (hcd.trans hds)
    push Not at key
    exact key

open Classical in
/-- Blueprint line 2436: the leaves of the piece of a sparse root carry stack energy at most
`32 |L|` times the root average. -/
theorem piece_leaf_energy (Q : ℤ × ℤ) (C : Finset (ℤ × ℤ))
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2)
    (hown : ∀ c ∈ C, ∀ s ∈ sparseStops G H ga gb Q,
      ¬ dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G s.1 s.2)
    (hhull : ∀ c ∈ C, ∀ d : ℤ × ℤ, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G Q.1 Q.2 → d ∈ H)
    {L : ℤ × ℤ} (hL : L ∈ pieceLeaves G Q C) :
    ∫⁻ x in dyadicGridCell G L.1 L.2, ga x ≤
        32 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G ga Q ∧
      ∫⁻ x in dyadicGridCell G L.1 L.2, gb x ≤
        32 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G gb Q := by
  obtain ⟨-, p, hp, hLp⟩ := mem_pieceLeaves.mp hL
  obtain ⟨ha, hb⟩ := piece_internal_avg_le G H ga gb Q C hC hown hhull hp
  constructor
  · refine (child_lintegral_le G hLp ga).trans ?_
    calc 2 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G ga p
        ≤ 2 * ENNReal.ofReal (dyadicGridLength G L.1) * (16 * dyadicEnergyAverage G ga Q) := by
          gcongr
      _ = 32 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G ga Q := by ring
  · refine (child_lintegral_le G hLp gb).trans ?_
    calc 2 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G gb p
        ≤ 2 * ENNReal.ofReal (dyadicGridLength G L.1) * (16 * dyadicEnergyAverage G gb Q) := by
          gcongr
      _ = 32 * ENNReal.ofReal (dyadicGridLength G L.1) * dyadicEnergyAverage G gb Q := by ring

end SparsePieces

section DoubleKhintchine

/-- Khintchine at the fourth moment: `E|Σ ε_i a_i|⁴ ≤ 256 (Σ |a_i|²)²`. -/
theorem khintchine_four {ι : Type*} [DecidableEq ι] (s : Finset ι) (a : ι → ℂ) :
    rademacherMean s (fun u => ‖rademacherSum s u a‖ ^ (4 : ℝ)) ≤
      256 * (∑ i ∈ s, ‖a i‖ ^ 2) ^ 2 := by
  have h := signs_moment_bound s a (p := 4) (by norm_num)
  have hm0 : 0 ≤ rademacherMean s (fun u => ‖rademacherSum s u a‖ ^ (4 : ℝ)) := by
    unfold rademacherMean; positivity
  have hS0 : 0 ≤ ∑ i ∈ s, ‖a i‖ ^ 2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
  have h4 : Real.sqrt 4 = 2 := by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
  rw [h4] at h
  have h' := Real.rpow_le_rpow (by positivity) h (show (0 : ℝ) ≤ 4 by norm_num)
  rw [← Real.rpow_mul hm0, show (1 / 4 : ℝ) * 4 = 1 by norm_num, Real.rpow_one] at h'
  refine h'.trans (le_of_eq ?_)
  rw [Real.mul_rpow (by positivity) (Real.sqrt_nonneg _),
    show (4 : ℝ) = (2 : ℕ) * 2 by norm_num, Real.rpow_mul (Real.sqrt_nonneg _),
    Real.rpow_natCast, Real.sq_sqrt hS0, Real.rpow_mul (by norm_num), Real.rpow_natCast]
  norm_num

/-- Minkowski for nonnegative finite sums in `L²` of a finite average:
`E (Σ_i g_i)² ≤ (Σ_i (E g_i²)^{1/2})²`. -/
theorem rademacherMean_sum_sq_le {κ ι : Type*} (u : Finset κ) (s : Finset ι)
    (g : ι → Finset κ → ℝ) :
    rademacherMean u (fun w => (∑ i ∈ s, g i w) ^ 2) ≤
      (∑ i ∈ s, Real.sqrt (rademacherMean u (fun w => g i w ^ 2))) ^ 2 := by
  have hexp : ∀ w, (∑ i ∈ s, g i w) ^ 2 = ∑ i ∈ s, ∑ i' ∈ s, g i w * g i' w := by
    intro w; rw [sq, Finset.sum_mul_sum]
  unfold rademacherMean
  simp_rw [hexp]
  rw [Finset.sum_comm, Finset.mul_sum, sq, Finset.sum_mul_sum]
  refine Finset.sum_le_sum fun i _ => ?_
  rw [Finset.sum_comm, Finset.mul_sum]
  refine Finset.sum_le_sum fun i' _ => ?_
  -- Cauchy-Schwarz for the average
  have hc : 0 ≤ ((2 : ℝ) ^ u.card)⁻¹ := by positivity
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt u.powerset (fun w => g i w) (fun w => g i' w)
  calc ((2 : ℝ) ^ u.card)⁻¹ * ∑ w ∈ u.powerset, g i w * g i' w
      ≤ ((2 : ℝ) ^ u.card)⁻¹ * (Real.sqrt (∑ w ∈ u.powerset, g i w ^ 2) *
          Real.sqrt (∑ w ∈ u.powerset, g i' w ^ 2)) := mul_le_mul_of_nonneg_left hcs hc
    _ = Real.sqrt (((2 : ℝ) ^ u.card)⁻¹ * ∑ w ∈ u.powerset, g i w ^ 2) *
        Real.sqrt (((2 : ℝ) ^ u.card)⁻¹ * ∑ w ∈ u.powerset, g i' w ^ 2) := by
        rw [Real.sqrt_mul hc, Real.sqrt_mul hc]
        rw [show Real.sqrt ((2 : ℝ) ^ u.card)⁻¹ * Real.sqrt (∑ w ∈ u.powerset, g i w ^ 2) *
            (Real.sqrt ((2 : ℝ) ^ u.card)⁻¹ * Real.sqrt (∑ w ∈ u.powerset, g i' w ^ 2)) =
            (Real.sqrt ((2 : ℝ) ^ u.card)⁻¹ * Real.sqrt ((2 : ℝ) ^ u.card)⁻¹) *
              (Real.sqrt (∑ w ∈ u.powerset, g i w ^ 2) *
                Real.sqrt (∑ w ∈ u.powerset, g i' w ^ 2)) by ring,
          Real.mul_self_sqrt hc]

/-- Blueprint lines 2421-2423 ("two applications of Khintchine give the pointwise moment
hypothesis"): the product chaos `Σ_{i,p} ε_i ζ_p x_{ip}` has fourth moment at most
`16⁴ (Σ |x_{ip}|²)²`. -/
theorem double_khintchine {ι κ : Type*} [DecidableEq ι] [DecidableEq κ] (s : Finset ι)
    (u : Finset κ) (x : ι → κ → ℂ) :
    rademacherMean u (fun w => rademacherMean s (fun v =>
      ‖∑ i ∈ s, ∑ p ∈ u, (patternSign v i : ℂ) * patternSign w p * x i p‖ ^ (4 : ℝ))) ≤
      16 ^ 4 * (∑ i ∈ s, ∑ p ∈ u, ‖x i p‖ ^ 2) ^ 2 := by
  set X : ι → Finset κ → ℂ := fun i w => ∑ p ∈ u, (patternSign w p : ℂ) * x i p
  -- inner Khintchine for fixed `ζ`
  have hin : ∀ w, rademacherMean s (fun v =>
      ‖∑ i ∈ s, ∑ p ∈ u, (patternSign v i : ℂ) * patternSign w p * x i p‖ ^ (4 : ℝ)) ≤
      256 * (∑ i ∈ s, ‖X i w‖ ^ 2) ^ 2 := by
    intro w
    have h := khintchine_four s (fun i => X i w)
    refine le_trans (le_of_eq ?_) h
    unfold rademacherMean
    congr 1
    refine Finset.sum_congr rfl fun v _ => ?_
    dsimp only
    rw [rademacherSum_complex]
    congr 2
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [X, Finset.mul_sum]
    exact Finset.sum_congr rfl fun p _ => by ring
  -- the outer average and Minkowski
  have hX4 : ∀ i, rademacherMean u (fun w => (‖X i w‖ ^ 2) ^ 2) ≤
      256 * (∑ p ∈ u, ‖x i p‖ ^ 2) ^ 2 := by
    intro i
    have h := khintchine_four u (fun p => x i p)
    refine le_trans (le_of_eq ?_) h
    unfold rademacherMean
    congr 1
    refine Finset.sum_congr rfl fun w _ => ?_
    dsimp only
    rw [rademacherSum_complex, ← pow_mul]
    simp only [X]
    norm_cast
  have hmink := rademacherMean_sum_sq_le u s (fun i w => ‖X i w‖ ^ 2)
  have hsq : ∀ i, Real.sqrt (rademacherMean u (fun w => (‖X i w‖ ^ 2) ^ 2)) ≤
      16 * ∑ p ∈ u, ‖x i p‖ ^ 2 := by
    intro i
    have h0 : 0 ≤ ∑ p ∈ u, ‖x i p‖ ^ 2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
    calc Real.sqrt (rademacherMean u (fun w => (‖X i w‖ ^ 2) ^ 2))
        ≤ Real.sqrt (256 * (∑ p ∈ u, ‖x i p‖ ^ 2) ^ 2) := Real.sqrt_le_sqrt (hX4 i)
      _ = 16 * ∑ p ∈ u, ‖x i p‖ ^ 2 := by
          rw [Real.sqrt_mul (by norm_num), Real.sqrt_sq h0,
            show (256 : ℝ) = 16 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
  calc rademacherMean u (fun w => rademacherMean s (fun v =>
        ‖∑ i ∈ s, ∑ p ∈ u, (patternSign v i : ℂ) * patternSign w p * x i p‖ ^ (4 : ℝ)))
      ≤ rademacherMean u (fun w => 256 * (∑ i ∈ s, ‖X i w‖ ^ 2) ^ 2) :=
        rademacherMean_mono u fun w _ => hin w
    _ = 256 * rademacherMean u (fun w => (∑ i ∈ s, ‖X i w‖ ^ 2) ^ 2) := by
        unfold rademacherMean; rw [← Finset.mul_sum]; ring
    _ ≤ 256 * (∑ i ∈ s, 16 * ∑ p ∈ u, ‖x i p‖ ^ 2) ^ 2 := by
        refine mul_le_mul_of_nonneg_left (hmink.trans ?_) (by norm_num)
        exact pow_le_pow_left₀ (Finset.sum_nonneg fun _ _ => Real.sqrt_nonneg _)
          (Finset.sum_le_sum fun i _ => hsq i) 2
    _ = 16 ^ 4 * (∑ i ∈ s, ∑ p ∈ u, ‖x i p‖ ^ 2) ^ 2 := by
        rw [← Finset.mul_sum]; ring

end DoubleKhintchine

section PieceRandom

/-- The uniform probability on a finite type with the discrete σ-algebra. -/
noncomputable def unifMeasure (Ω : Type*) [Fintype Ω] [MeasurableSpace Ω] : Measure Ω :=
  (Fintype.card Ω : ℝ≥0∞)⁻¹ • Measure.count

theorem lintegral_unifMeasure {Ω : Type*} [Fintype Ω] [MeasurableSpace Ω]
    [MeasurableSingletonClass Ω] (f : Ω → ℝ≥0∞) :
    ∫⁻ ω, f ω ∂(unifMeasure Ω) = (Fintype.card Ω : ℝ≥0∞)⁻¹ * ∑ ω, f ω := by
  unfold unifMeasure
  rw [lintegral_smul_measure, lintegral_count, tsum_fintype, smul_eq_mul]

instance {Ω : Type*} [Fintype Ω] [Nonempty Ω] [MeasurableSpace Ω] [MeasurableSingletonClass Ω] :
    IsProbabilityMeasure (unifMeasure Ω) := by
  constructor
  have h := lintegral_unifMeasure (Ω := Ω) (fun _ => 1)
  rw [lintegral_one, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one] at h
  rw [h]
  exact ENNReal.inv_mul_cancel (by simp) (by simp)

/-- Blueprint lines 2421-2445: on a short-block piece, any randomization on a finite uniform
probability space with fourth moments bounded by `C₄` times deterministic sizes, and signed
expectations equal to given cell quantities `T_I`, bounds `Σ_I |I| T_I` by the short-block
constant. -/
theorem piece_random_bound (κ : LocalKernelClass) {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3)
    {C4 : ℝ} (hC4 : 0 ≤ C4) :
    ∃ Cq : ℝ, 0 ≤ Cq ∧ ∀ (G : RealDyadicGrid) (K Nd : ℕ), K ≤ Nd →
      ∀ (T : ShortBlockTree G K) (z : Fin 4 → ℝ → ℝ), (∀ j, Measurable (z j)) →
      ∀ sv : Fin 4 → ℝ, (∀ j, 0 ≤ sv j) →
      (∀ j, ∀ L ∈ T.leaves, ∫⁻ y in dyadicGridCell G L.1 L.2, ‖z j y‖ₑ ^ 2 ≤
        ENNReal.ofReal (sv j ^ 2 * dyadicGridLength G L.1)) →
      ∀ {Ω : Type} [Fintype Ω] [Nonempty Ω] [MeasurableSpace Ω] [MeasurableSingletonClass Ω]
        (zσ : Fin 4 → Ω → ℝ → ℂ), (∀ j ω, Measurable (zσ j ω)) →
      (∀ j y, ((Fintype.card Ω : ℝ≥0∞)⁻¹ * ∑ ω, ‖zσ j ω y‖ₑ ^ (4 : ℝ)) ^ (1 / 4 : ℝ) ≤
        ENNReal.ofReal C4 * ‖z j y‖ₑ) →
      ∀ (kernel : ℤ × ℤ → ℝ × ℝ → ℂ), (∀ I ∈ T.internal, IsAdmissibleLocalKernel κ
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (kernel I)) →
      ∀ cells ⊆ T.internal, ∀ ε : ℤ × ℤ → Ω → ℂ, (∀ I ω, ‖ε I ω‖ ≤ 1) →
      ∀ Tc : ℤ × ℤ → ℂ, (∀ I ∈ cells, (Fintype.card Ω : ℂ)⁻¹ * ∑ ω, ε I ω *
        localProgressionForm (dyadicGridLength G I.1) (kernel I) (fun j => zσ j ω) = Tc I) →
      ‖∑ I ∈ cells, (dyadicGridLength G I.1 : ℂ) * Tc I‖ ≤
        Cq * (1 + finiteDepthConstant κ q Nd) * (1 + Real.log ((K : ℝ) + 2)) *
          ((K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) * dyadicGridLength G T.root.1 * ∏ j, sv j := by
  obtain ⟨Cq, hCq, hsbc⟩ := short_block_comparison κ hq2 hq3 hC4
  refine ⟨Cq, hCq, ?_⟩
  intro G K Nd hKN T z hz sv hsv hleaf Ω _ _ _ _ zσ hzσ hmom kernel hker cells hcells ε hε1 Tc hTc
  have hzm : ∀ j, Measurable fun y => ‖z j y‖ := fun j => (hz j).norm
  have hzσm : ∀ j, Measurable (Function.uncurry (zσ j)) := fun j =>
    measurable_from_prod_countable_right fun ω => hzσ j ω
  have hmom' : ∀ j y, (∫⁻ ω, ‖zσ j ω y‖ₑ ^ (4 : ℝ) ∂(unifMeasure Ω)) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ‖z j y‖ₑ := fun j y => by
    rw [lintegral_unifMeasure]; exact hmom j y
  have hmain := hsbc G K Nd hKN T z hzm sv hsv hleaf (unifMeasure Ω) zσ hzσm hmom' kernel
    hker cells hcells ε (fun I => Measurable.of_discrete) hε1
  set X : Ω → ℂ := fun ω => ∑ I ∈ cells, (dyadicGridLength G I.1 : ℂ) * ε I ω *
    localProgressionForm (dyadicGridLength G I.1) (kernel I) (fun j => zσ j ω)
  have havg : (Fintype.card Ω : ℂ)⁻¹ * ∑ ω, X ω =
      ∑ I ∈ cells, (dyadicGridLength G I.1 : ℂ) * Tc I := by
    simp only [X]
    rw [Finset.sum_comm, Finset.mul_sum]
    refine Finset.sum_congr rfl fun I hI => ?_
    rw [← hTc I hI, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun ω _ => ?_
    ring
  have hX : ‖(Fintype.card Ω : ℂ)⁻¹ * ∑ ω, X ω‖ ≤ (∫⁻ ω, ‖X ω‖ₑ ∂(unifMeasure Ω)).toReal := by
    rw [lintegral_unifMeasure, ENNReal.toReal_mul, ENNReal.toReal_sum (fun _ _ => enorm_ne_top)]
    simp_rw [toReal_enorm]
    rw [norm_mul]
    refine mul_le_mul (le_of_eq (by simp)) (norm_sum_le _ _) (norm_nonneg _) (by positivity)
  rw [← havg]
  refine hX.trans (ENNReal.toReal_le_of_le_ofReal ?_ hmain)
  have hK0 : 0 ≤ (1 : ℝ) + Real.log ((K : ℝ) + 2) := by
    have := Real.log_nonneg (show (1 : ℝ) ≤ K + 2 by
      linarith [(Nat.cast_nonneg K : (0 : ℝ) ≤ K)])
    linarith
  have hCN := (finiteDepthConstant_bounds κ hq2.le Nd).1
  have := dyadicGridLength_pos G T.root.1
  have : 0 ≤ ∏ j, sv j := Finset.prod_nonneg fun j _ => hsv j
  positivity

end PieceRandom

section ThreeFamilies

variable {ι κ ν : Type*} [DecidableEq ι] [DecidableEq κ] [DecidableEq ν]

omit [DecidableEq ι] [DecidableEq κ] [DecidableEq ν] in
/-- The uniform average over three sign families as a nested average. -/
theorem avg_three_families {M : Type*} [AddCommGroup M] [Module ℂ M] (s : Finset ι)
    (t : Finset κ) (u : Finset ν) (g : Finset ι → Finset κ → Finset ν → M) :
    ((Fintype.card (SignPattern s × SignPattern t × SignPattern u) : ℂ))⁻¹ •
      ∑ ω : SignPattern s × SignPattern t × SignPattern u, g ω.1.1 ω.2.1.1 ω.2.2.1 =
    ((2 : ℂ) ^ s.card)⁻¹ • ∑ v₁ ∈ s.powerset, (((2 : ℂ) ^ t.card)⁻¹ •
      ∑ v₂ ∈ t.powerset, (((2 : ℂ) ^ u.card)⁻¹ • ∑ v₃ ∈ u.powerset, g v₁ v₂ v₃)) := by
  rw [Fintype.card_prod, Fintype.card_prod, card_signPattern, card_signPattern, card_signPattern,
    Fintype.sum_prod_type, ← Finset.sum_coe_sort s.powerset]
  simp_rw [Fintype.sum_prod_type]
  simp only [Finset.smul_sum, smul_smul]
  refine Finset.sum_congr rfl fun v₁ _ => ?_
  rw [← Finset.sum_coe_sort t.powerset]
  refine Finset.sum_congr rfl fun v₂ _ => ?_
  rw [← Finset.sum_coe_sort u.powerset]
  refine Finset.sum_congr rfl fun v₃ _ => ?_
  congr 1
  push_cast
  ring

/-- The triple sign selection: averaging `ε_{i₀} η_{j₀} ε_i η_j ζ_p ζ_{p'}` over three independent
families gives `δ_{i₀ i} δ_{j₀ j} δ_{p p'}`. -/
theorem sign_select_three (s : Finset ι) (t : Finset κ) (u : Finset ν) {i₀ i : ι} {j₀ j : κ}
    {p p' : ν} (hi₀ : i₀ ∈ s) (hi : i ∈ s) (hj₀ : j₀ ∈ t) (hj : j ∈ t) (hp : p ∈ u)
    (hp' : p' ∈ u) :
    ((2 : ℝ) ^ s.card)⁻¹ * ∑ v₁ ∈ s.powerset, (((2 : ℝ) ^ t.card)⁻¹ * ∑ v₂ ∈ t.powerset,
      (((2 : ℝ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset, patternSign v₁ i₀ * patternSign v₂ j₀ *
        (patternSign v₁ i * patternSign v₂ j * (patternSign v₃ p * patternSign v₃ p')))) =
      if i₀ = i ∧ j₀ = j ∧ p = p' then 1 else 0 := by
  have h3 : ((2 : ℝ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset, patternSign v₃ p * patternSign v₃ p' =
      if p = p' then 1 else 0 := by
    rw [sum_patternSign_mul u hp hp']
    split_ifs <;> simp
  have e : ∀ v₁ v₂, ((2 : ℝ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset, patternSign v₁ i₀ *
      patternSign v₂ j₀ * (patternSign v₁ i * patternSign v₂ j *
        (patternSign v₃ p * patternSign v₃ p')) =
      patternSign v₁ i₀ * patternSign v₂ j₀ * (patternSign v₁ i * patternSign v₂ j) *
        (if p = p' then 1 else 0) := by
    intro v₁ v₂
    rw [← h3, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum]
    exact Finset.sum_congr rfl fun v₃ _ => by ring
  simp_rw [e]
  have h2 := sign_select_two s t hi₀ hi hj₀ hj
  rw [show (if i₀ = i ∧ j₀ = j ∧ p = p' then (1 : ℝ) else 0) =
    (if i₀ = i ∧ j₀ = j then 1 else 0) * (if p = p' then 1 else 0) by
      by_cases h1 : i₀ = i <;> by_cases h2 : j₀ = j <;> by_cases h3 : p = p' <;> simp [*]]
  rw [← h2]
  simp only [Finset.mul_sum, Finset.sum_mul]
  refine Finset.sum_congr rfl fun v₁ _ => Finset.sum_congr rfl fun v₂ _ => ?_
  ring

end ThreeFamilies

section ThreeFamilies2

variable {ι κ ν : Type*} [DecidableEq ι] [DecidableEq κ] [DecidableEq ν]

omit [DecidableEq ι] [DecidableEq κ] [DecidableEq ν] in
/-- The uniform average over three sign families as a nested average (real values). -/
theorem avg_three_families_real (s : Finset ι) (t : Finset κ) (u : Finset ν)
    (g : Finset ι → Finset κ → Finset ν → ℝ) :
    ((Fintype.card (SignPattern s × SignPattern t × SignPattern u) : ℝ))⁻¹ *
      ∑ ω : SignPattern s × SignPattern t × SignPattern u, g ω.1.1 ω.2.1.1 ω.2.2.1 =
    ((2 : ℝ) ^ s.card)⁻¹ * ∑ v₁ ∈ s.powerset, (((2 : ℝ) ^ t.card)⁻¹ *
      ∑ v₂ ∈ t.powerset, (((2 : ℝ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset, g v₁ v₂ v₃)) := by
  rw [Fintype.card_prod, Fintype.card_prod, card_signPattern, card_signPattern, card_signPattern,
    Fintype.sum_prod_type, ← Finset.sum_coe_sort s.powerset]
  simp_rw [Fintype.sum_prod_type]
  simp only [Finset.mul_sum]
  refine Finset.sum_congr rfl fun v₁ _ => ?_
  rw [← Finset.sum_coe_sort t.powerset]
  refine Finset.sum_congr rfl fun v₂ _ => ?_
  rw [← Finset.sum_coe_sort u.powerset]
  refine Finset.sum_congr rfl fun v₃ _ => ?_
  push_cast
  ring

/-- The fourth moment of an average of norms in `ℝ≥0∞` is that of the real average. -/
theorem enorm_avg_rpow {Ω : Type*} [Fintype Ω] [Nonempty Ω] (g : Ω → ℂ) :
    ((Fintype.card Ω : ℝ≥0∞)⁻¹ * ∑ ω, ‖g ω‖ₑ ^ (4 : ℝ)) ^ (1 / 4 : ℝ) =
      ENNReal.ofReal (((Fintype.card Ω : ℝ)⁻¹ * ∑ ω, ‖g ω‖ ^ (4 : ℝ)) ^ (1 / 4 : ℝ)) := by
  rw [← ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
  congr 1
  rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_inv_of_pos (by
    exact_mod_cast Fintype.card_pos), ENNReal.ofReal_natCast,
    ENNReal.ofReal_sum_of_nonneg fun _ _ => by positivity]
  congr 1
  refine Finset.sum_congr rfl fun ω _ => ?_
  rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num)]

end ThreeFamilies2

section ThreeFamilies3

variable {ι κ ν : Type*} [DecidableEq ι] [DecidableEq κ] [DecidableEq ν]

omit [DecidableEq ι] [DecidableEq κ] [DecidableEq ν] in
theorem root4_le {A c S : ℝ} (hA : 0 ≤ A) (hc : 0 ≤ c) (hS : 0 ≤ S) (h : A ≤ c ^ 4 * S ^ 2) :
    A ^ (1 / 4 : ℝ) ≤ c * Real.sqrt S := by
  refine (Real.rpow_le_rpow hA h (by norm_num)).trans (le_of_eq ?_)
  rw [Real.mul_rpow (by positivity) (by positivity), show c ^ 4 = c ^ ((4 : ℕ) : ℝ) by
    norm_cast, ← Real.rpow_mul hc, show S ^ 2 = S ^ ((2 : ℕ) : ℝ) by norm_cast,
    ← Real.rpow_mul hS, Real.sqrt_eq_rpow]
  norm_num

instance signPattern_nonempty {α : Type*} (s : Finset α) : Nonempty (SignPattern s) :=
  ⟨⟨∅, Finset.empty_mem_powerset s⟩⟩

omit [DecidableEq κ] in
/-- The moment of the side slot `Σ_{i,p} ε_i ζ_p x_{ip}` on three families. -/
theorem moment_three_a (s : Finset ι) (t : Finset κ) (u : Finset ν) (x : ι → ν → ℂ) :
    ((Fintype.card (SignPattern s × SignPattern t × SignPattern u) : ℝ≥0∞)⁻¹ *
      ∑ ω : SignPattern s × SignPattern t × SignPattern u,
        ‖∑ i ∈ s, ∑ p ∈ u, (patternSign ω.1.1 i : ℂ) * patternSign ω.2.2.1 p * x i p‖ₑ ^
          (4 : ℝ)) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal 16 * ENNReal.ofReal (Real.sqrt (∑ i ∈ s, ∑ p ∈ u, ‖x i p‖ ^ 2)) := by
  rw [enorm_avg_rpow, ← ENNReal.ofReal_mul (by norm_num)]
  refine ENNReal.ofReal_le_ofReal (root4_le (by positivity) (by norm_num)
    (Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _) ?_)
  set F : Finset ι → Finset ν → ℝ := fun v w =>
    ‖∑ i ∈ s, ∑ p ∈ u, (patternSign v i : ℂ) * patternSign w p * x i p‖ ^ (4 : ℝ)
  have e := avg_three_families_real s t u (fun v₁ _ v₃ => F v₁ v₃)
  simp only [F] at e ⊢
  rw [e]
  have e2 : ((2 : ℝ) ^ s.card)⁻¹ * ∑ v₁ ∈ s.powerset, (((2 : ℝ) ^ t.card)⁻¹ *
      ∑ v₂ ∈ t.powerset, (((2 : ℝ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset, F v₁ v₃)) =
      rademacherMean u (fun w => rademacherMean s (fun v => F v w)) := by
    have hc : ∀ v₁, ((2 : ℝ) ^ t.card)⁻¹ * ∑ v₂ ∈ t.powerset,
        (((2 : ℝ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset, F v₁ v₃) =
        rademacherMean u (fun w => F v₁ w) := fun v₁ =>
      rademacherMean_const t _
    simp_rw [hc]
    unfold rademacherMean
    simp only [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun w _ => Finset.sum_congr rfl fun v _ => ?_
    ring
  simp only [F] at e2
  rw [e2]
  exact double_khintchine s u x

end ThreeFamilies3

section ThreeFamilies4

variable {ι κ ν : Type*} [DecidableEq ι] [DecidableEq κ] [DecidableEq ν]

/-- The randomized tuple of a band defect: slot `a` carries `Σ_{i,p} ε_i ζ_p x_{ip}`, slot `b`
carries `Σ_j η_j w_j`, slot `c` carries `Σ_p ζ_p y_p`. -/
noncomputable def randTuple3 (a b c : Fin 4) (f : Fin 4 → ℝ → ℂ) (s : Finset ι) (t : Finset κ)
    (u : Finset ν) (x : ι → ν → ℝ → ℂ) (w : κ → ℝ → ℂ) (y : ν → ℝ → ℂ) (v₁ : Finset ι)
    (v₂ : Finset κ) (v₃ : Finset ν) : Fin 4 → ℝ → ℂ :=
  Function.update (Function.update (Function.update f a
    (fun z => ∑ i ∈ s, ∑ p ∈ u, (patternSign v₁ i : ℂ) * patternSign v₃ p * x i p z)) b
      (fun z => ∑ j ∈ t, (patternSign v₂ j : ℂ) * w j z)) c
        (fun z => ∑ p ∈ u, (patternSign v₃ p : ℂ) * y p z)

theorem update_measurable_fin {f : Fin 4 → ℝ → ℂ} (hf : ∀ j, Measurable (f j)) (k : Fin 4)
    {g : ℝ → ℂ} (hg : Measurable g) : ∀ j, Measurable (Function.update f k g j) := by
  intro j
  by_cases hj : j = k
  · subst hj; simp only [Function.update_self]; exact hg
  · rw [Function.update_of_ne hj]; exact hf j

theorem update_fin_fin {μ : Measure ℝ} {f : Fin 4 → ℝ → ℂ} (hf : ∀ j, eLpNorm (f j) 2 μ ≠ ⊤)
    (k : Fin 4) {g : ℝ → ℂ} (hg : eLpNorm g 2 μ ≠ ⊤) :
    ∀ j, eLpNorm (Function.update f k g j) 2 μ ≠ ⊤ := by
  intro j
  by_cases hj : j = k
  · subst hj; simp only [Function.update_self]; exact hg
  · rw [Function.update_of_ne hj]; exact hf j

theorem sum_eLpNorm_ne_top {μ : Measure ℝ} {α : Type*} (s : Finset α) (c : α → ℂ)
    (g : α → ℝ → ℂ) (hg : ∀ i, eLpNorm (g i) 2 μ ≠ ⊤) :
    eLpNorm (fun z => ∑ i ∈ s, c i * g i z) 2 μ ≠ ⊤ :=
  (memLp_finsetSum s fun i _ => MemLp.const_mul (Ne.lt_top (hg i)) _).eLpNorm_ne_top

omit [DecidableEq ι] [DecidableEq κ] [DecidableEq ν] in
/-- Interchanging three outer sums with four inner sums. -/
theorem sum_swap_three_four {A B C : Type*} (VA : Finset A) (VB : Finset B) (VC : Finset C)
    (s : Finset ι) (u : Finset ν) (t : Finset κ) (g : A → B → C → ι → ν → κ → ν → ℂ) :
    ∑ a ∈ VA, ∑ b ∈ VB, ∑ c ∈ VC, ∑ i ∈ s, ∑ p ∈ u, ∑ j ∈ t, ∑ p' ∈ u, g a b c i p j p' =
      ∑ i ∈ s, ∑ p ∈ u, ∑ j ∈ t, ∑ p' ∈ u, ∑ a ∈ VA, ∑ b ∈ VB, ∑ c ∈ VC, g a b c i p j p' := by
  have h1 : ∀ (G : A → B → C → ℂ), ∑ a ∈ VA, ∑ b ∈ VB, ∑ c ∈ VC, G a b c =
      ∑ w ∈ VA ×ˢ (VB ×ˢ VC), G w.1 w.2.1 w.2.2 := by
    intro G; rw [Finset.sum_product]; simp_rw [Finset.sum_product]
  have h2 : ∀ (G : ι → ν → κ → ν → ℂ), ∑ i ∈ s, ∑ p ∈ u, ∑ j ∈ t, ∑ p' ∈ u, G i p j p' =
      ∑ q ∈ s ×ˢ (u ×ˢ (t ×ˢ u)), G q.1 q.2.1 q.2.2.1 q.2.2.2 := by
    intro G; rw [Finset.sum_product]; simp_rw [Finset.sum_product]
  rw [h1 (fun a b c => ∑ i ∈ s, ∑ p ∈ u, ∑ j ∈ t, ∑ p' ∈ u, g a b c i p j p')]
  simp_rw [h2]
  rw [Finset.sum_comm]
  exact Finset.sum_congr rfl fun q _ =>
    (h1 (fun a b c => g a b c q.1 q.2.1 q.2.2.1 q.2.2.2)).symm

set_option maxHeartbeats 1000000 in
-- The expansion of three randomized slots and the seven nested sums are large terms.
/-- Blueprint lines 2421-2423 with the band family: averaging `ε_{i₀} η_{j₀}` times the form of
the randomized band tuple over three independent sign families gives the matched band sum
`Σ_p H(x_{i₀ p}, w_{j₀}, y_p)`. -/
theorem form_sign_avg3 {κ' : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w₀ : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ' a₀ r w₀) {a b c : Fin 4} (hab : a ≠ b) (hac : a ≠ c)
    (hbc : b ≠ c) (f : Fin 4 → ℝ → ℂ) (hf : ∀ j, Measurable (f j))
    (hfin : ∀ j, eLpNorm (f j) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (s : Finset ι) (t : Finset κ) (u : Finset ν) (x : ι → ν → ℝ → ℂ) (w : κ → ℝ → ℂ)
    (y : ν → ℝ → ℂ) (hx : ∀ i p, Measurable (x i p))
    (hxf : ∀ i p, eLpNorm (x i p) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hwm : ∀ j, Measurable (w j)) (hwf : ∀ j, eLpNorm (w j) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    (hym : ∀ p, Measurable (y p)) (hyf : ∀ p, eLpNorm (y p) 2 (normalizedIntervalMeasure a₀ r) ≠ ⊤)
    {i₀ : ι} {j₀ : κ} (hi₀ : i₀ ∈ s) (hj₀ : j₀ ∈ t) :
    ((2 : ℂ) ^ s.card)⁻¹ * ∑ v₁ ∈ s.powerset, (((2 : ℂ) ^ t.card)⁻¹ * ∑ v₂ ∈ t.powerset,
      (((2 : ℂ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset, (patternSign v₁ i₀ : ℂ) * patternSign v₂ j₀ *
        localProgressionForm r w₀ (randTuple3 a b c f s t u x w y v₁ v₂ v₃))) =
      ∑ p ∈ u, localProgressionForm r w₀
        (Function.update (Function.update (Function.update f a (x i₀ p)) b (w j₀)) c (y p)) := by
  classical
  set μ := normalizedIntervalMeasure a₀ r
  set F : ι → ν → κ → ν → ℂ := fun i p j p' => localProgressionForm r w₀
    (Function.update (Function.update (Function.update f a (x i p)) b (w j)) c (y p'))
  -- expand the three randomized slots
  have hexp : ∀ v₁ v₂ v₃, localProgressionForm r w₀ (randTuple3 a b c f s t u x w y v₁ v₂ v₃) =
      ∑ i ∈ s, ∑ p ∈ u, ∑ j ∈ t, ∑ p' ∈ u, ((patternSign v₁ i : ℂ) * patternSign v₃ p *
        (patternSign v₂ j * patternSign v₃ p')) * F i p j p' := by
    intro v₁ v₂ v₃
    set Xa : ℝ → ℂ := fun z => ∑ i ∈ s, ∑ p ∈ u, (patternSign v₁ i : ℂ) * patternSign v₃ p *
      x i p z
    set Xb : ℝ → ℂ := fun z => ∑ j ∈ t, (patternSign v₂ j : ℂ) * w j z
    have hXam : Measurable Xa := Finset.measurable_sum _ fun i _ => Finset.measurable_sum _
      fun p _ => measurable_const.mul (hx i p)
    have hXbm : Measurable Xb := Finset.measurable_sum _ fun j _ => measurable_const.mul (hwm j)
    have hXaf : eLpNorm Xa 2 μ ≠ ⊤ := by
      have : MemLp Xa 2 μ := memLp_finsetSum s fun i _ => memLp_finsetSum u fun p _ =>
        MemLp.const_mul (Ne.lt_top (hxf i p)) _
      exact this.eLpNorm_ne_top
    have hXbf : eLpNorm Xb 2 μ ≠ ⊤ := sum_eLpNorm_ne_top t _ w hwf
    -- slot `c`
    unfold randTuple3
    rw [localProgressionForm_update_sum hr hw
      (update_measurable_fin (update_measurable_fin hf a hXam) b hXbm)
      (update_fin_fin (update_fin_fin hfin a hXaf) b hXbf) c u
      (fun p => (patternSign v₃ p : ℂ)) y hym hyf]
    -- slot `b`
    have hb : ∀ p', localProgressionForm r w₀ (Function.update (Function.update
        (Function.update f a Xa) b Xb) c (y p')) = ∑ j ∈ t, (patternSign v₂ j : ℂ) *
          localProgressionForm r w₀ (Function.update (Function.update (Function.update f a Xa)
            c (y p')) b (w j)) := by
      intro p'
      rw [Function.update_comm hbc]
      exact localProgressionForm_update_sum hr hw
        (update_measurable_fin (update_measurable_fin hf a hXam) c (hym p'))
        (update_fin_fin (update_fin_fin hfin a hXaf) c (hyf p')) b t
        (fun j => (patternSign v₂ j : ℂ)) w hwm hwf
    -- slot `a`
    have ha : ∀ p' j, localProgressionForm r w₀ (Function.update (Function.update
        (Function.update f a Xa) c (y p')) b (w j)) = ∑ i ∈ s, ∑ p ∈ u,
          ((patternSign v₁ i : ℂ) * patternSign v₃ p) * F i p j p' := by
      intro p' j
      rw [Function.update_comm hac, Function.update_comm hab]
      have hfa := update_measurable_fin (update_measurable_fin hf c (hym p')) b (hwm j)
      have hfaf := update_fin_fin (update_fin_fin hfin c (hyf p')) b (hwf j)
      have e1 : Xa = fun z => ∑ q ∈ s ×ˢ u, ((patternSign v₁ q.1 : ℂ) * patternSign v₃ q.2) *
          x q.1 q.2 z := by
        funext z; simp only [Xa]; rw [Finset.sum_product (s := s) (t := u)]
      rw [e1, localProgressionForm_update_sum hr hw hfa hfaf a (s ×ˢ u)
        (fun q => (patternSign v₁ q.1 : ℂ) * patternSign v₃ q.2) (fun q => x q.1 q.2)
        (fun q => hx q.1 q.2) (fun q => hxf q.1 q.2), Finset.sum_product (s := s) (t := u)]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun p _ => ?_
      congr 1
      simp only [F]
      congr 1
      rw [Function.update_comm hab.symm, Function.update_comm hac.symm,
        Function.update_comm hbc.symm]
    simp_rw [hb, ha]
    simp only [Finset.mul_sum]
    -- reorder the sums
    have hperm : ∀ g : ν → κ → ι → ν → ℂ,
        ∑ p' ∈ u, ∑ j ∈ t, ∑ i ∈ s, ∑ p ∈ u, g p' j i p =
          ∑ i ∈ s, ∑ p ∈ u, ∑ j ∈ t, ∑ p' ∈ u, g p' j i p := by
      intro g
      calc _ = ∑ p' ∈ u, ∑ i ∈ s, ∑ j ∈ t, ∑ p ∈ u, g p' j i p :=
            Finset.sum_congr rfl fun p' _ => Finset.sum_comm
        _ = ∑ i ∈ s, ∑ p' ∈ u, ∑ j ∈ t, ∑ p ∈ u, g p' j i p := Finset.sum_comm
        _ = ∑ i ∈ s, ∑ p' ∈ u, ∑ p ∈ u, ∑ j ∈ t, g p' j i p :=
            Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun p' _ => Finset.sum_comm
        _ = ∑ i ∈ s, ∑ p ∈ u, ∑ p' ∈ u, ∑ j ∈ t, g p' j i p :=
            Finset.sum_congr rfl fun i _ => Finset.sum_comm
        _ = _ := Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun p _ =>
            Finset.sum_comm
    rw [hperm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun p _ =>
      Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun p' _ => ?_
    ring
  simp_rw [hexp]
  -- the coefficients
  have hcoef : ∀ i ∈ s, ∀ p ∈ u, ∀ j ∈ t, ∀ p' ∈ u,
      ((2 : ℂ) ^ s.card)⁻¹ * ∑ v₁ ∈ s.powerset, (((2 : ℂ) ^ t.card)⁻¹ * ∑ v₂ ∈ t.powerset,
        (((2 : ℂ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset, (patternSign v₁ i₀ : ℂ) *
          patternSign v₂ j₀ * ((patternSign v₁ i : ℂ) * patternSign v₃ p *
            (patternSign v₂ j * patternSign v₃ p')))) =
        if i₀ = i ∧ j₀ = j ∧ p = p' then 1 else 0 := by
    intro i hi p hp j hj p' hp'
    have h := sign_select_three s t u hi₀ hi hj₀ hj hp hp'
    have h' := congrArg (fun z : ℝ => (z : ℂ)) h
    simp only [Complex.ofReal_mul, Complex.ofReal_sum, Complex.ofReal_inv, Complex.ofReal_pow,
      Complex.ofReal_ofNat] at h'
    rw [show (if i₀ = i ∧ j₀ = j ∧ p = p' then (1 : ℂ) else 0) =
      ((if i₀ = i ∧ j₀ = j ∧ p = p' then (1 : ℝ) else 0 : ℝ) : ℂ) by split_ifs <;> simp, ← h']
    congr 1; refine Finset.sum_congr rfl fun v₁ _ => ?_
    congr 1; refine Finset.sum_congr rfl fun v₂ _ => ?_
    congr 1; refine Finset.sum_congr rfl fun v₃ _ => ?_
    ring
  have hL : ((2 : ℂ) ^ s.card)⁻¹ * ∑ v₁ ∈ s.powerset, (((2 : ℂ) ^ t.card)⁻¹ *
      ∑ v₂ ∈ t.powerset, (((2 : ℂ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset,
        (patternSign v₁ i₀ : ℂ) * patternSign v₂ j₀ * ∑ i ∈ s, ∑ p ∈ u, ∑ j ∈ t, ∑ p' ∈ u,
          ((patternSign v₁ i : ℂ) * patternSign v₃ p * (patternSign v₂ j * patternSign v₃ p')) *
            F i p j p')) =
      ∑ i ∈ s, ∑ p ∈ u, ∑ j ∈ t, ∑ p' ∈ u, (((2 : ℂ) ^ s.card)⁻¹ * ∑ v₁ ∈ s.powerset,
        (((2 : ℂ) ^ t.card)⁻¹ * ∑ v₂ ∈ t.powerset, (((2 : ℂ) ^ u.card)⁻¹ *
          ∑ v₃ ∈ u.powerset, (patternSign v₁ i₀ : ℂ) * patternSign v₂ j₀ *
            ((patternSign v₁ i : ℂ) * patternSign v₃ p *
              (patternSign v₂ j * patternSign v₃ p'))))) * F i p j p' := by
    simp only [Finset.mul_sum, Finset.sum_mul]
    rw [sum_swap_three_four]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun p _ =>
      Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun p' _ =>
        Finset.sum_congr rfl fun v₁ _ => Finset.sum_congr rfl fun v₂ _ =>
          Finset.sum_congr rfl fun v₃ _ => ?_
    ring
  rw [hL]
  rw [Finset.sum_eq_single i₀ (fun i hi hne => Finset.sum_eq_zero fun p hp =>
      Finset.sum_eq_zero fun j hj => Finset.sum_eq_zero fun p' hp' => by
        rw [hcoef i hi p hp j hj p' hp', ite_eq_right_iff.mpr (fun h => absurd h.1.symm hne),
          zero_mul]) (fun h => absurd hi₀ h)]
  refine Finset.sum_congr rfl fun p hp => ?_
  rw [Finset.sum_eq_single j₀ (fun j hj hne => Finset.sum_eq_zero fun p' hp' => by
      rw [hcoef i₀ hi₀ p hp j hj p' hp', ite_eq_right_iff.mpr (fun h => absurd h.2.1.symm hne),
        zero_mul]) (fun h => absurd hj₀ h)]
  rw [Finset.sum_eq_single p (fun p' hp' hne => by
      rw [hcoef i₀ hi₀ p hp j₀ hj₀ p' hp', ite_eq_right_iff.mpr (fun h => absurd h.2.2.symm hne),
        zero_mul]) (fun h => absurd hp h)]
  rw [hcoef i₀ hi₀ p hp j₀ hj₀ p hp, ite_eq_left_iff.mpr (fun h => absurd ⟨rfl, rfl, rfl⟩ h),
    one_mul]

