/-- The lift is bounded on each cell: `‖lifted‖ ≤ √5 ‖1_I Z_U‖`. -/
theorem norm_lifted_le (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc)) :
    ‖D.lifted l G I ZU‖ ≤ Real.sqrt 5 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) ZU‖ := by
  unfold lifted
  rw [← physEmbed_restrict, ← (D.Ms l G).L.op_restrict]
  exact (norm_physEmbed_apply_le _).trans ((D.Ms l G).L.norm_op_le _)

/-- Blueprint lines 2163-2166 ("the lift is pointwise bounded ... so the full core and error
sizes on retained cells are also at most `P^C`"): the physical parts of the core, side and
error pieces are at most `4 (‖Z_s‖ + ‖1_I Z_U‖ + ‖V‖)`. -/
theorem piece_sizes_le (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (Zout ZU : ColumnL2 (Fin ap.Mc)) :
    let B := 4 * (‖Zout‖ + ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) ZU‖ + ‖D.linSide l G I‖)
    ‖π (D.core l G I ZU)‖ ≤ B ∧ ‖π (D.side l G I Zout ZU)‖ ≤ B ∧ ‖π (D.err l G I ZU)‖ ≤ B := by
  classical
  intro B
  set a := ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2) ZU‖
  set v := ‖D.linSide l G I‖
  have hz := norm_nonneg Zout
  have ha : 0 ≤ a := norm_nonneg _
  have hv : 0 ≤ v := norm_nonneg _
  have hlift := D.norm_lifted_le l G I ZU
  have h5 : Real.sqrt 5 ≤ 3 := by
    rw [Real.sqrt_le_left (by norm_num)]; norm_num
  have hπ : ∀ x : ColumnL2 (Fin ap.Mc), ‖π x‖ ≤ ‖x‖ := fun x => norm_physEmbed_apply_le x
  refine ⟨(hπ _).trans ?_, (hπ _).trans ?_, (hπ _).trans ?_⟩
  · unfold core
    split_ifs
    · rw [norm_zero]; positivity
    · refine (norm_sub_le _ _).trans ?_
      nlinarith
  · unfold side
    split_ifs
    · linarith
    · refine (norm_add_le _ _).trans ?_
      have := norm_sub_le Zout (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) ZU)
      linarith
  · unfold err
    split_ifs
    · rw [norm_zero]; positivity
    · refine (norm_sub_le _ _).trans ?_
      nlinarith

