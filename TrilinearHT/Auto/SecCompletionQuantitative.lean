  unfold err
  split_ifs with h
  · rw [map_zero, norm_zero]
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow]
    exact setIntegral_nonneg (dyadicGridCell_measurable _ _ _) fun _ _ => sq_nonneg _
  · unfold lifted
    simp only [map_sub, physEmbed_restrict, physEmbed_physEmbed]
    rw [← map_sub, norm_sq_restrict_physEmbed_sub]

