open scoped Classical in
/-- The physical embedding between augmented column spaces: keep the physical coordinate and
drop all private coordinates. -/
noncomputable def physEmbed (V W : Type*) [Fintype V] [Fintype W] :
    ColumnL2 V →L[ℂ] ColumnL2 W :=
  ContinuousLinearMap.compLpL 2 volume
    ((ContinuousLinearMap.toSpanSingleton ℂ (EuclideanSpace.single (none : Option W) (1 : ℂ))).comp
      (EuclideanSpace.proj (none : Option V)))

open scoped Classical in
theorem physEmbed_coeFn (x : ColumnL2 V) :
    (physEmbed V W x : ℝ → ColumnHilbert W) =ᵐ[volume]
      fun y => (x : ℝ → ColumnHilbert V) y none •
        EuclideanSpace.single (none : Option W) (1 : ℂ) := by
  change (ContinuousLinearMap.compLp _ x : ℝ → ColumnHilbert W) =ᵐ[volume] _
  filter_upwards [ContinuousLinearMap.coeFn_compLp
    ((ContinuousLinearMap.toSpanSingleton ℂ (EuclideanSpace.single (none : Option W) (1 : ℂ))).comp
      (EuclideanSpace.proj (none : Option V))) x] with y hy
  rw [hy]
  rfl

open scoped Classical in
theorem norm_physEmbed_apply_le (x : ColumnL2 V) : ‖physEmbed V W x‖ ≤ ‖x‖ := by
  refine (ContinuousLinearMap.le_opNorm _ _).trans ?_
  refine mul_le_of_le_one_left (norm_nonneg _) ?_
  refine (ContinuousLinearMap.norm_compLpL_le _).trans ?_
  refine (ContinuousLinearMap.opNorm_comp_le _ _).trans ?_
  have h1 : ‖ContinuousLinearMap.toSpanSingleton ℂ
      (EuclideanSpace.single (none : Option W) (1 : ℂ))‖ ≤ 1 := by
    rw [ContinuousLinearMap.norm_toSpanSingleton]; simp
  have h2 : ‖(EuclideanSpace.proj (none : Option V) : ColumnHilbert V →L[ℂ] ℂ)‖ ≤ 1 :=
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun x => by
      rw [one_mul]; exact PiLp.norm_apply_le x none
  calc _ ≤ 1 * 1 := mul_le_mul h1 h2 (norm_nonneg _) zero_le_one
    _ = 1 := one_mul 1

theorem physEmbed_restrict (s : Set ℝ) (hs : MeasurableSet s) (x : ColumnL2 V) :
    physEmbed V W (columnL2Restriction s hs x) = columnL2Restriction s hs (physEmbed V W x) := by
  classical
  apply Lp.ext
  change (physEmbed V W (columnL2Indicator s hs x) : ℝ → ColumnHilbert W) =ᵐ[volume]
    (columnL2Indicator s hs (physEmbed V W x) : ℝ → ColumnHilbert W)
  filter_upwards [physEmbed_coeFn (W := W) (columnL2Indicator s hs x),
    columnL2Indicator_coeFn s hs x, columnL2Indicator_coeFn s hs (physEmbed V W x),
    physEmbed_coeFn (W := W) x] with y h1 h2 h3 h4
  rw [h1, h3, h2]
  by_cases hy : y ∈ s
  · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy, h4]
  · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]; simp

/-- Blueprint lines 1805 and 1879-1890 for a rank-zero innermost factor: rows that are Bessel for
all inputs and split orthogonally over the cells of the depth partition of a basic column family
remain Bessel after inserting the physical part of its depth projection, at the cost of one
compression constant. -/
theorem basic_insert {ι F : Type*} [Fintype ι] [NormedAddCommGroup F] [NormedSpace ℂ F]
    (Ψ : ColumnDepthFamily V) (d : ι → ℤ) (R : ι → ColumnL2 W →L[ℂ] F) {B : ℝ} (hB : 0 ≤ B)
    (hR : ∀ x, ∑ i, ‖R i x‖ ^ 2 ≤ B * ‖x‖ ^ 2)
    (hblk : ∀ i x, ‖R i x‖ ^ 2 = ∑ Q : {Q // Q ∈ (Ψ.partition (d i)).cells},
      ‖R i (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
        (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x)‖ ^ 2) (Z : ColumnL2 V) :
    ∑ i, ‖R i (physEmbed V W (Ψ.proj (d i) Z))‖ ^ 2 ≤
      B * compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2 := by
  have h := globHist_compression Ψ (P := 1) Nat.one_pos (fun _ _ => Ψ.A) [(0, false)] d
    (fun i => (R i).comp (physEmbed V W)) hB
    (fun x => by
      refine le_trans ?_ (mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (norm_nonneg _) (norm_physEmbed_apply_le (W := W) x) 2) hB)
      exact hR _)
    (fun i x => by
      simp only [ContinuousLinearMap.comp_apply]
      rw [hblk i]
      simp_rw [physEmbed_restrict])
    Z
  refine le_trans (le_of_eq ?_) h
  refine Finset.sum_congr rfl fun i _ => ?_
  have e : globHist Ψ (P := 1) (fun _ _ => Ψ.A) [(0, false)] (d i) = Ψ.proj (d i) := by
    unfold globHist
    rw [show ([(0, false)] : List (ℕ × Bool)) = [] ++ [(0, false)] from rfl, layerOp_append,
      layerOp_nil]
    ext1 x
    simp [opAvg]
    rfl
  rw [e]
  rfl

