/-- A set of integers pairwise at least `3K` apart has at most two points in an open interval of
length at most `6K`. -/
theorem card_separated_in_interval_le_two {K : ℕ} (T : Finset ℤ)
    (hT : ∀ b ∈ T, ∀ b' ∈ T, b < b' → b + 3 * (K : ℤ) ≤ b') {c d : ℝ}
    (hcd : d ≤ c + 6 * K) (hin : ∀ b ∈ T, c < b ∧ (b : ℝ) < d) : T.card ≤ 2 := by
  by_contra hlt
  rw [not_le] at hlt
  obtain ⟨x, hx, y, hy, z, hz, hxy, hxz, hyz⟩ := Finset.two_lt_card.mp hlt
  have key : ∀ u ∈ T, ∀ v ∈ T, ∀ w ∈ T, u < v → v < w → False := by
    intro u hu v hv w hw huv hvw
    have h1 := hT u hu v hv huv
    have h2 := hT v hv w hw hvw
    have hu' := (hin u hu).1
    have hw' := (hin w hw).2
    have : (w : ℝ) - u ≥ 6 * K := by
      have : w - u ≥ 6 * (K : ℤ) := by omega
      exact_mod_cast this
    linarith
  rcases lt_or_gt_of_ne hxy with h1 | h1 <;> rcases lt_or_gt_of_ne hxz with h2 | h2 <;>
    rcases lt_or_gt_of_ne hyz with h3 | h3
  all_goals first
    | exact key x hx y hy z hz h1 h3
    | exact key x hx z hz y hy h2 (by omega)
    | exact key y hy x hx z hz (by omega) h2
    | exact key y hy z hz x hx h3 (by omega)
    | exact key z hz x hx y hy (by omega) h1
    | exact key z hz y hy x hx (by omega) (by omega)

