open Classical in
/-- Ball masks increase with the pad. -/
theorem bmask_pad_mono {I : ℤ × ℤ} {G : A.Grp} {j p p' : ℕ} (hp : p ≤ p') {x : A.Vtx}
    (hx : ap.bmask I G j p x) : ap.bmask I G j p' x :=
  ap.K.mask_pad_mono A.admT A.vtxBound (by omega) hx

