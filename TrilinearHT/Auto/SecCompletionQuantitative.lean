/-- The pattern forms see only the physical parts of the pieces. -/
theorem patF_phys (gs : Finset A.Grp) (I : ℤ × ℤ) (Zout ZU : Fin 4 → A.Grp → ColumnL2 (Fin ap.Mc))
    (σ : Fin 4 → Fin 3) :
    D.patF gs I Zout ZU σ = ∑ G ∈ gs, ap.Λc I (patternPiece (fun l => π (D.core l G I (ZU l G)))
      (fun l => π (D.side l G I (Zout l G) (ZU l G))) (fun l => π (D.err l G I (ZU l G))) σ) := by
  unfold patF
  refine Finset.sum_congr rfl fun G _ => ?_
  rw [ap.Λc_phys]
  congr 1
  exact map_patternPiece (π (ap := ap) : ColumnL2 (Fin ap.Mc) →ₗ[ℂ] ColumnL2 (Fin ap.Mc)) _ _ _ σ

