/-- Blueprint `eq:sides`: a side is a rolling part plus the linear side, so
`‖S‖² ≤ 2 ‖Z_s - 1_I Z_U‖² + 2 ‖V‖²` (for a basic `U` slot, `‖S‖ = ‖Z_s‖`). -/
theorem side_norm_sq_le (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (Zout ZU : ColumnL2 (Fin ap.Mc))
    (hB : ¬ (D.usl l ∨ ¬ D.hasDecision I)) :
    ‖D.side l G I Zout ZU‖ ^ 2 ≤ 2 * ‖Zout - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) ZU‖ ^ 2 + 2 * ‖D.linSide l G I‖ ^ 2 := by
  classical
  unfold side
  rw [ite_eq_right_iff.mpr fun h => absurd h hB]
  have h := norm_add_le (Zout - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2) ZU) (D.linSide l G I)
  have h0 := norm_nonneg (Zout - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2) ZU + D.linSide l G I)
  nlinarith [sq_nonneg (‖Zout - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2) ZU‖ - ‖D.linSide l G I‖)]

open Classical in
/-- Blueprint `eq:side-cap` (lines 2159-2166) for the sides of one slot of a search leaf: if the
rolling parts are restrictions of global rolling vectors `W_{G,s}` with total square `B_var`
on the certified cells, and the linear sides are restrictions of `V_{G,b}` with total square
`B_lin`, then one cut of total length at most `ρ|R|` makes every retained path sum of
`‖S_{l,G,s}‖² / |I|` at most `(2 B_var + 2 K B_lin) / (ρ |R|)`. -/
theorem leaf_side_caps (l : Fin 4) (hl : ¬ D.usl l) {ι : Type*} [Fintype ι] (grp : ι → A.Grp)
    (Sd : Finset ℕ) (Sc : Finset (ℤ × ℤ)) (Ec : ι → ℕ → Finset (ℤ × ℤ))
    (hsub : ∀ G s, Ec G s ⊆ Sc) (d : ℕ → ℤ) (hEc : ∀ G s, ∀ I ∈ Ec G s, I.1 = d s)
    (hdec : ∀ G s, ∀ I ∈ Ec G s, D.hasDecision I)
    (Zout ZU : ι → ℕ → ℤ × ℤ → ColumnL2 (Fin ap.Mc))
    (Wr : ι → ℕ → ColumnL2 (Fin ap.Mc))
    (hW : ∀ G s, ∀ I ∈ Ec G s, Zout G s I - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (ZU G s I) =
        columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          (Wr G s))
    {Bvar : ℝ}
    (hvar : ∑ G, ∑ s ∈ Sd, ‖columnL2Restriction (⋃ I ∈ Ec G s, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (Wr G s)‖ ^ 2 ≤ Bvar)
    (Vs : ι → ℤ → ColumnL2 (Fin ap.Mc)) (blk : ℕ → ℤ)
    (hV : ∀ G s, ∀ I ∈ Ec G s, D.linSide l (grp G) I =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (Vs G (blk s)))
    {K : ℕ} (hK : ∀ b, (Sd.filter fun s => blk s = b).card ≤ K) (Bs : Finset ℤ)
    (hBs : ∀ s ∈ Sd, blk s ∈ Bs) {Blin : ℝ} (hlin : ∑ G, ∑ b ∈ Bs, ‖Vs G b‖ ^ 2 ≤ Blin)
    (hSc : ∀ I ∈ Sc, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G A.R.1 A.R.2)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ Sc ∧
      dyadicRootLength A.G C ≤ ρ * dyadicGridLength A.G A.R.1 ∧
      ∀ x : ℝ, ∑ I ∈ Sc.filter (fun I => (¬ ∃ c ∈ C,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G c.1 c.2) ∧
          x ∈ dyadicGridCell A.G I.1 I.2),
        ∑ G, ∑ s ∈ Sd, (if I ∈ Ec G s then
          ‖D.side l (grp G) I (Zout G s I) (ZU G s I)‖ ^ 2 / dyadicGridLength A.G I.1 else 0) ≤
        (2 * Bvar / dyadicGridLength A.G A.R.1 + 2 * (K * Blin) / dyadicGridLength A.G A.R.1) /
          ρ := by
  have h := side_caps_of_rolling A.G A.R Sd Sc Ec hsub d hEc Wr hvar Vs blk hK Bs hBs hlin hSc hρ
    hρ1
  simp only at h
  obtain ⟨hlen, hcap⟩ := h
  set a : ℤ × ℤ → ℝ := fun I => ∑ v : Bool, ∑ G, ∑ s ∈ Sd, if I ∈ Ec G s then
    (if v then 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (Wr G s)‖ ^ 2
    else 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (Vs G (blk s))‖ ^ 2) /
        dyadicGridLength A.G I.1 else 0
  set T := (2 * Bvar / dyadicGridLength A.G A.R.1 + 2 * (K * Blin) /
    dyadicGridLength A.G A.R.1) / ρ
  set C := dyadicFirstCrossings A.G Sc a T
  have ha0 : ∀ I, 0 ≤ a I := by
    intro I
    have hL := dyadicGridLength_pos A.G I.1
    simp only [a]
    refine Finset.sum_nonneg fun v _ => Finset.sum_nonneg fun G _ =>
      Finset.sum_nonneg fun s _ => ?_
    split_ifs <;> positivity
  refine ⟨C, fun c hc => (Finset.mem_filter.mp (maximalDyadicCells_subset A.G _ hc)).1, hlen,
    fun x => ?_⟩
  refine le_trans ?_ (hcap x)
  unfold dyadicRealPathSum
  calc _ ≤ ∑ I ∈ Sc.filter (fun I => (¬ ∃ c ∈ C,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G c.1 c.2) ∧
          x ∈ dyadicGridCell A.G I.1 I.2), a I := by
        refine Finset.sum_le_sum fun I hI => ?_
        simp only [a, Fintype.sum_bool, ↓reduceIte, Bool.false_eq_true]
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_le_sum fun G _ => ?_
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_le_sum fun s _ => ?_
        split_ifs with hIE
        · have hL := dyadicGridLength_pos A.G I.1
          rw [← add_div]
          refine div_le_div_of_nonneg_right ?_ hL.le
          have hB : ¬ (D.usl l ∨ ¬ D.hasDecision I) := by
            rintro (h | h)
            · exact hl h
            · exact h (hdec G s I hIE)
          have := D.side_norm_sq_le l (grp G) I (Zout G s I) (ZU G s I) hB
          rw [hW G s I hIE, hV G s I hIE] at this
          linarith
        · simp
    _ ≤ _ := by
        refine Finset.sum_le_sum_of_subset_of_nonneg (fun I hI => ?_) fun I _ _ => ha0 I
        have hI' := Finset.mem_filter.mp hI
        have hIS := hI'.1
        have hno := hI'.2.1
        have hx := hI'.2.2
        refine Finset.mem_filter.mpr ⟨?_, hx⟩
        unfold dyadicRetainedCells
        refine Finset.mem_filter.mpr ⟨hIS, ?_⟩
        by_contra hbad
        rw [not_le] at hbad
        obtain ⟨c, hc, hIc⟩ := maximalDyadicCells_covers A.G (dyadicBadCells A.G Sc a T)
          (Finset.mem_filter.mpr ⟨hIS, hbad⟩)
        exact hno ⟨c, hc, hIc⟩

