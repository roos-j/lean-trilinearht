/-! ### The physical-error patterns of a leaf (blueprint lines 2149-2166) -/

/-- The layered leaf inputs of a bounded slot function have size at most `B₀ √|U|`. -/
theorem leafIn_size (cat : Fin 4 → List (CatCol A.Vtx)) (s : ℕ) (l : Fin 4) (U : ℤ × ℤ)
    {B₀ : ℝ} (hB₀ : 0 ≤ B₀) (hm : MemLp (ap.z U l) 2 (A.μ U))
    (hb : (eLpNorm (ap.z U l) 2 (A.μ U)).toReal ≤ B₀) :
    ‖ap.leafIn cat s l U‖ ≤ B₀ * Real.sqrt (dyadicGridLength A.G U.1) := by
  have hs := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G U.1)
  have h := norm_cellLp_div_le (Mc := ap.Mc) hm hB₀ hb
  rw [div_le_iff₀ hs] at h
  exact ((ap.filters cat U).norm_input_le (leafAt ap.fuel ap.Lc ap.up₀ s).layers l).trans h

namespace LeafSplit
variable {ap} (D : ap.LeafSplit)

/-- Every cell lies in its decision cell. -/
theorem sub_dcell (hK1 : 1 ≤ D.S.K) (I : ℤ × ℤ) :
    dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G (D.dcell I).1 (D.dcell I).2 := by
  have h := D.blockOf_bounds hK1 I.1
  exact subset_ancAt A.G I (by omega)

/-- The cells sharing a decision cell occupy at most `K` depths. -/
theorem card_depths_dcell_le (hK1 : 1 ≤ D.S.K) (S : Finset (ℤ × ℤ)) (U : ℤ × ℤ) :
    ((S.filter fun I => D.dcell I = U).image Prod.fst).card ≤ D.S.K := by
  refine (Finset.card_le_card (t := Finset.Icc (U.1 + 4 * D.S.K)
    (U.1 + 4 * D.S.K + D.S.K - 1)) fun h hh => ?_).trans (by simp)
  obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hh
  obtain ⟨-, hIU⟩ := Finset.mem_filter.mp hI
  have h := D.blockOf_bounds hK1 I.1
  have hU1 : U.1 = D.blockOf I.1 - 4 * D.S.K := by rw [← hIU]; rfl
  rw [Finset.mem_Icc]
  omega

open Classical in
/-- Blueprint lines 2149-2166 ("every term containing a physical error is `O(e^{-k}|R|)`") on one
search leaf: on retained cells `S` where, for every slot and successful group, the rolling part
and the linear side have total square at most `T |I|`, with slot functions bounded by `B₀`, the
error patterns of the leaf are at most the bound of `leaf_error_bound` with
`B_s = 8 (B₀ + √T)` and `K_x = M_c B₀²`. -/
theorem leaf_error_attempt (hK1 : 1 ≤ D.S.K) (cat : Fin 4 → List (CatCol A.Vtx)) (s₀ : ℕ)
    (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp)
    (hgs : ∀ I ∈ S, gs I ⊆ gset) (hMc : 0 < ap.Mc) {B₀ T : ℝ} (hB₀ : 0 ≤ B₀) (hT : 0 ≤ T)
    (hzm : ∀ U l, MemLp (ap.z U l) 2 (A.μ U))
    (hzb : ∀ U l, (eLpNorm (ap.z U l) 2 (A.μ U)).toReal ≤ B₀)
    (hreg : ∀ I ∈ S, ∀ G ∈ gs I, ∀ l, ¬ (D.usl l ∨ ¬ D.hasDecision I) →
      ‖ap.leafOut cat s₀ I l G - columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (ap.leafOut cat s₀ (D.dcell I) l G)‖ ^ 2 +
        ‖D.linSide l G I‖ ^ 2 ≤ T * dyadicGridLength A.G I.1)
    (dim : A.Grp → ℕ) {dB : ℕ} (hdim : ∀ G ∈ gset, dim G ≤ dB) {δ δc : ℝ} (hδ : 0 < δ)
    (herr : ∀ l, ∑ G ∈ gset, ∑ U ∈ (S.filter fun I => G ∈ gs I).image D.dcell,
      ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
        (‖(ap.leafOut cat s₀ U l G : ℝ → ColumnHilbert (Fin ap.Mc)) y none -
          ((D.Ms l G).L.op (ap.leafOut cat s₀ U l G) :
            ℝ → ColumnHilbert (D.Ms l G).Md) y none‖ ^ 2) ≤
      ∑ G ∈ gset, ∑ U ∈ (S.filter fun I => G ∈ gs I).image D.dcell,
        ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
          (8 * dim G * δ *
            ‖(ap.leafOut cat s₀ U l G : ℝ → ColumnHilbert (Fin ap.Mc)) y none‖ ^ 2 +
            2 * δ ^ 2 * (δc ^ 2 * (ap.Mc * B₀ ^ 2) / δ ^ 2))) :
    ∑ I ∈ S, dyadicGridLength A.G I.1 * ∑ σ ∈ Finset.univ.filter (fun σ => ∃ l, σ l = 2),
        ‖D.patF (gs I) I (fun l G => ap.leafOut cat s₀ I l G)
          (fun l G => ap.leafOut cat s₀ (D.dcell I) l G) σ‖ ≤
      81 * (localFormUniformConstant κ' * (8 * (B₀ + Real.sqrt T)) ^ 3) *
        (Real.sqrt (4 * ∑ I ∈ S, dyadicGridLength A.G I.1 * (gs I).card) *
        Real.sqrt (D.S.K * (4 * ((8 * dB * δ / ap.Mc + 2 * δc ^ 2) * (ap.Mc * B₀ ^ 2) *
          ∑ G ∈ gset, ∑ U ∈ (S.filter fun I => G ∈ gs I).image D.dcell,
            dyadicGridLength A.G U.1)))) := by
  have hKx : ∀ l, ∀ G ∈ gset, ∀ U ∈ (S.filter fun I => G ∈ gs I).image D.dcell,
      ap.Mc * ‖ap.leafIn cat s₀ l U‖ ^ 2 / dyadicGridLength A.G U.1 ≤ ap.Mc * B₀ ^ 2 := by
    intro l G _ U _
    have hU := dyadicGridLength_pos A.G U.1
    have h := ap.leafIn_size cat s₀ l U hB₀ (hzm U l) (hzb U l)
