physical coordinates (zero in the basic `U` slot, which is a side; blueprint line 2461). -/
noncomputable def coreAt (l : Fin 4) (G : bf.Grp) (I : ℤ × ℤ) : ColumnL2 (bf.Lab ⊕ Fin fp.Mc) :=
  if D.u = some l then 0 else
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (fp.physMain (D.Ms l G).Md ((D.Ms l G).blockCore D.S D.hA D.SP (A.blkStart D.S.K I.1)
        (fp.retainedV G (A.blkStart D.S.K I.1) D.S.K) (D.c l G (A.blkStart D.S.K I.1))))

open Classical in
/-- The physical error `E_{l,G,b}` of the block of the cell `I` for the lifts `L`, restricted to
`I` (zero in the basic `U` slot). -/
noncomputable def errAt (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) (l : Fin 4)
    (G : bf.Grp) (I : ℤ × ℤ) : ColumnL2 (bf.Lab ⊕ Fin fp.Mc) :=
  if D.u = some l then 0 else
    columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (fp.physError (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
        D.S.K (A.blkStart D.S.K I.1))

open Classical in
/-- The frozen coefficients represent the lifted frozen outputs on the retained `v_b`-cells of
the block of `I` (the first export of `linear_energy`). -/
def RepAt (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) (l : Fin 4) (G : bf.Grp)
    (I : ℤ × ℤ) : Prop :=
  ∀ J ∈ fp.retainedV G (A.blkStart D.S.K I.1) D.S.K,
    (D.Ms l G).frozenEval D.S (A.blkStart D.S.K I.1) J (D.c l G (A.blkStart D.S.K I.1) J) =
      columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
        ((L l G).op (fp.frozenZ l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
          (A.blkStart D.S.K I.1 - 4 * D.S.K)))

open Classical in
/-- Blueprint `eq:core-side-error` on a cell (line 2129): the physical part of the whole leaf
output is the core plus the side plus the error (in the basic `U` slot the whole output is the
side). -/
theorem phys_out_eq (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) (l : Fin 4) (G : bf.Grp) (hrep : D.u ≠ some l → D.RepAt L l G I) :
    fp.physMain (bf.Lab ⊕ Fin fp.Mc) (D.toLeaf.out l G I) =
      D.coreAt l G I + fp.physMain (bf.Lab ⊕ Fin fp.Mc) (D.toLeaf.sv l G I) +
        D.errAt L l G I := by
  by_cases hl : D.u = some l
  · have hs : D.toLeaf.out l G I = D.toLeaf.sv l G I := (D.toLeaf.sv_u l hl G I).symm
    rw [hs]
    simp only [coreAt, errAt, hl, ↓reduceIte, zero_add, add_zero]
  · have ho : D.toLeaf.out l G I = columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.basicOut l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) I.1) := by
      rw [fp.basicOut_restrict l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) hI]
      unfold SideLeafM.out
      rw [D.toLeaf.xin_basic l hl I]
      rfl
    have hsv : D.toLeaf.sv l G I = columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (D.gs' l G I.1) := D.toLeaf_sv_basic hl G I
    have hcse := fp.core_side_error (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l)
      (D.Lf.layers l) D.S D.hA D.SP (A.blkStart D.S.K I.1) (D.c l G (A.blkStart D.S.K I.1))
      (hrep hl) I.1
    have hgs : D.gs' l G I.1 = fp.sideState (D.Ms l G) l (D.cat l) (D.mbs l) G (D.Lf.role l)
        (D.Lf.layers l) D.S D.hA D.SP (D.c l G (A.blkStart D.S.K I.1)) (A.blkStart D.S.K I.1)
        I.1 := rfl
    have hss : fp.physMain (bf.Lab ⊕ Fin fp.Mc) (fp.sideState (D.Ms l G) l (D.cat l) (D.mbs l) G
        (D.Lf.role l) (D.Lf.layers l) D.S D.hA D.SP (D.c l G (A.blkStart D.S.K I.1))
        (A.blkStart D.S.K I.1) I.1) = fp.sideState (D.Ms l G) l (D.cat l) (D.mbs l) G
        (D.Lf.role l) (D.Lf.layers l) D.S D.hA D.SP (D.c l G (A.blkStart D.S.K I.1))
        (A.blkStart D.S.K I.1) I.1 := by
      unfold sideState
      rw [map_add, map_sub, fp.physMain_physMain, fp.physMain_physMain, fp.physMain_physMain]
    simp only [coreAt, errAt, hl, ↓reduceIte]
    have e1 : fp.physMain (bf.Lab ⊕ Fin fp.Mc) (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.basicOut l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) I.1)) =
        columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          (fp.physMain (bf.Lab ⊕ Fin fp.Mc)
            (fp.basicOut l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) I.1)) :=
      physEmbed_restrict _ _ _
    have e2 : fp.physMain (bf.Lab ⊕ Fin fp.Mc) (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (D.gs' l G I.1)) =
        columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          (fp.physMain (bf.Lab ⊕ Fin fp.Mc) (D.gs' l G I.1)) :=
      physEmbed_restrict _ _ _
    rw [ho, hsv, e1, e2, hcse, hgs, hss, map_add, map_add]

end SideInput

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

open Classical in
theorem physMain_coreAt (l : Fin 4) (G : bf.Grp) (I : ℤ × ℤ) :
    fp.physMain (bf.Lab ⊕ Fin fp.Mc) (D.coreAt l G I) = D.coreAt l G I := by
  unfold coreAt
  split_ifs
  · exact map_zero _
  · rw [← physEmbed_restrict, fp.physMain_physMain]

open Classical in
theorem physMain_errAt (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) (l : Fin 4)
    (G : bf.Grp) (I : ℤ × ℤ) :
    fp.physMain (bf.Lab ⊕ Fin fp.Mc) (D.errAt L l G I) = D.errAt L l G I := by
  unfold errAt
  split_ifs
  · exact map_zero _
  · rw [physEmbed_restrict]
    congr 1
    unfold physError
    rw [map_sub, fp.physMain_physMain, fp.physMain_physMain]

open Classical in
/-- Blueprint `eq:core-side-error` in the cell form (line 2461): the form of the whole leaf outputs
is the sum over the core/side/error patterns of the forms of their pieces. -/
theorem form_expand (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) (G : bf.Grp) (hrep : ∀ l, D.u ≠ some l → D.RepAt L l G I) :
    fp.Λc I (fun l => D.toLeaf.out l G I) = ∑ σ : Fin 4 → Fin 3,
      fp.Λc I (patternPiece (fun l => D.coreAt l G I) (fun l => D.toLeaf.sv l G I)
        (fun l => D.errAt L l G I) σ) := by
  rw [fp.Λc_phys]
  simp_rw [D.phys_out_eq L hI _ G (hrep _)]
  rw [form_pattern_expand]
  refine Finset.sum_congr rfl fun σ _ => ?_
  rw [fp.Λc_phys I (patternPiece _ (fun l => D.toLeaf.sv l G I) _ σ)]
  congr 1
  funext l
  unfold patternPiece
  generalize σ l = j
  fin_cases j
  · exact (D.physMain_coreAt l G I).symm
  · rfl
  · exact (D.physMain_errAt L l G I).symm

open Classical in
/-- The restored two-side patterns of the pieces are the two-side patterns of the whole outputs
and the sides (the form sees only physical parts). -/
theorem restored_eq (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) (G : bf.Grp) (hrep : ∀ l, D.u ≠ some l → D.RepAt L l G I)
    (σ : Fin 4 → Fin 3) :
    fp.Λc I (fun l => if σ l = 0 then D.coreAt l G I + D.toLeaf.sv l G I + D.errAt L l G I
      else D.toLeaf.sv l G I) =
    fp.Λc I (fun l => if σ l = 0 then D.toLeaf.out l G I else D.toLeaf.sv l G I) := by
  rw [fp.Λc_phys, fp.Λc_phys I (fun l => if σ l = 0 then D.toLeaf.out l G I
    else D.toLeaf.sv l G I)]
  congr 1
  funext l
  split_ifs
  · rw [D.phys_out_eq L hI l G (hrep l), map_add, map_add, D.physMain_coreAt,
      D.physMain_errAt]
  · rfl

open Classical in
/-- Blueprint line 2461 on one cell: the form of the whole leaf outputs summed over the groups is
at most the restored two-side patterns of the whole outputs and sides, `82` times the error
patterns and the patterns with at least three sides, and the patterns with at least three cores
(a basic `U` role remains a side: its core and error vanish). -/
theorem cell_reduction (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) (gsI : Finset bf.Grp)
    (hrep : ∀ G ∈ gsI, ∀ l, D.u ≠ some l → D.RepAt L l G I) :
    ‖∑ G ∈ gsI, fp.Λc I (fun l => D.toLeaf.out l G I)‖ ≤
      ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
            (Finset.univ.filter fun l => σ l = 0).card = 2 ∧
            (Finset.univ.filter fun l => σ l = 1).card = 2),
          ∑ G ∈ gsI, fp.Λc I
            (fun l => if σ l = 0 then D.toLeaf.out l G I else D.toLeaf.sv l G I)‖ +
        82 * ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2),
          ‖∑ G ∈ gsI, fp.Λc I (patternPiece (fun l => D.coreAt l G I)
            (fun l => D.toLeaf.sv l G I) (fun l => D.errAt L l G I) τ)‖ +
        82 * ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
          3 ≤ patternCount τ 1),
          ‖∑ G ∈ gsI, fp.Λc I (patternPiece (fun l => D.coreAt l G I)
            (fun l => D.toLeaf.sv l G I) (fun l => D.errAt L l G I) τ)‖ +
        ‖∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
          3 ≤ patternCount τ 0),
          ∑ G ∈ gsI, fp.Λc I (patternPiece (fun l => D.coreAt l G I)
            (fun l => D.toLeaf.sv l G I) (fun l => D.errAt L l G I) τ)‖ := by
  set a : bf.Grp → Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc) := fun G l => D.coreAt l G I
  set s : bf.Grp → Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc) := fun G l => D.toLeaf.sv l G I
  set e : bf.Grp → Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc) := fun G l => D.errAt L l G I
  set F : (Fin 4 → Fin 3) → ℂ := fun σ => ∑ G ∈ gsI, fp.Λc I (patternPiece (a G) (s G) (e G) σ)
  have hsum : ∑ G ∈ gsI, fp.Λc I (fun l => D.toLeaf.out l G I) = ∑ σ, F σ := by
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl fun G hG => D.form_expand L hI G (hrep G hG)
  have h22 := two_two_cell_le gsI (fp.Λc I) a s e
  have hrest : ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        patternCount σ 0 = 2 ∧ patternCount σ 1 = 2),
        ∑ G ∈ gsI, fp.Λc I (fun l => if σ l = 0 then a G l + s G l + e G l else s G l) =
      ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
          (Finset.univ.filter fun l => σ l = 0).card = 2 ∧
          (Finset.univ.filter fun l => σ l = 1).card = 2),
        ∑ G ∈ gsI, fp.Λc I
          (fun l => if σ l = 0 then D.toLeaf.out l G I else D.toLeaf.sv l G I) :=
    Finset.sum_congr rfl fun σ _ => Finset.sum_congr rfl fun G hG =>
      D.restored_eq L hI G (hrep G hG) σ
  rw [hrest] at h22
  rw [hsum, form_pattern_split F]
  set E := ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2), ‖F τ‖
  set T := ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
    3 ≤ patternCount τ 1), ‖F τ‖
  have hE : ‖∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2), F τ‖ ≤ E :=
    norm_sum_le _ _
  have hT : ‖∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
      3 ≤ patternCount τ 1), F τ‖ ≤ T := norm_sum_le _ _
  have hE0 : 0 ≤ E := Finset.sum_nonneg fun _ _ => norm_nonneg _
  have hT0 : 0 ≤ T := Finset.sum_nonneg fun _ _ => norm_nonneg _
  have h4 : ‖∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2), F τ +
      ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
        3 ≤ patternCount τ 0), F τ +
      ∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
        3 ≤ patternCount τ 1), F τ +
      ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        patternCount σ 0 = 2 ∧ patternCount σ 1 = 2), F σ‖ ≤
      ‖∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => ∃ l, τ l = 2), F τ‖ +
      ‖∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
        3 ≤ patternCount τ 0), F τ‖ +
      ‖∑ τ ∈ Finset.univ.filter (fun τ : Fin 4 → Fin 3 => (∀ l, τ l ≠ 2) ∧
        3 ≤ patternCount τ 1), F τ‖ +
      ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        patternCount σ 0 = 2 ∧ patternCount σ 1 = 2), F σ‖ := norm_add₄_le
  have h22' : ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
      patternCount σ 0 = 2 ∧ patternCount σ 1 = 2), F σ‖ ≤
      ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
          (Finset.univ.filter fun l => σ l = 0).card = 2 ∧
          (Finset.univ.filter fun l => σ l = 1).card = 2),
        ∑ G ∈ gsI, fp.Λc I
          (fun l => if σ l = 0 then D.toLeaf.out l G I else D.toLeaf.sv l G I)‖ +
        81 * E + 81 * T := h22
  linarith

end SideInput

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

open Classical in
/-- Blueprint line 2164 with the physical side subtotal: on a cell `I` inside a retained
`v_b`-cell, `‖1_I A‖ ≤ √5 (‖1_I Z_h‖ + ‖1_I (Z_h - Z_{u_b})‖) + ‖1_I V_phys‖`. -/
theorem core_size_phys {n : ℕ} (Ms : ModeSystem A.G n)
    (L : LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md) (l : Fin 4) (s : List (CatCol bf.Vtx))
    (mb : bf.MainBudget s) (G : bf.Grp) (j : ℕ) (ls : List (ℕ × Bool)) (S : ModeSchedule)
    (hA : 6 ≤ S.A0) (SP : SideParams) (b : ℤ) (c : ℤ × ℤ → Ms.Md → ℂ)
    (hrep : ∀ J ∈ fp.retainedV G b S.K,
      Ms.frozenEval S b J (c J) = columnL2Restriction (dyadicGridCell A.G J.1 J.2)
        (dyadicGridCell_measurable A.G J.1 J.2) (L.op (fp.frozenZ l s mb G j ls (b - 4 * S.K))))
    {J I : ℤ × ℤ} (hJ : J ∈ fp.retainedV G b S.K)
    (hIJ : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2) (h : ℤ) :
    ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.physMain Ms.Md (Ms.blockCore S hA SP b (fp.retainedV G b S.K) c))‖ ≤
      Real.sqrt 5 * (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (fp.basicOut l s mb G j ls h)‖ +
        ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          (fp.basicOut l s mb G j ls h - fp.frozenZ l s mb G j ls (b - 4 * S.K))‖) +
        ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          (fp.physMain Ms.Md (Ms.blockSide S hA SP b (fp.retainedV G b S.K) c))‖ := by
  set rI := columnL2Restriction (V := bf.Lab ⊕ Fin fp.Mc) (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
  set rIm := columnL2Restriction (V := Ms.Md) (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
  set Zh := fp.basicOut l s mb G j ls h
  set Zu := fp.frozenZ l s mb G j ls (b - 4 * S.K)
  have hZu : ‖rI Zu‖ ≤ ‖rI Zh‖ + ‖rI (Zh - Zu)‖ := by
    have : rI Zu = rI Zh - rI (Zh - Zu) := by rw [map_sub, sub_sub_cancel]
    rw [this]; exact norm_sub_le _ _
  have hlift : rIm (fp.frozenLift L l s mb G j ls b S.K) = L.op (rI Zu) := by
    unfold frozenLift
    rw [← ContinuousLinearMap.comp_apply rIm, columnL2Restriction_comp_of_subset, L.op_restrict]
    exact fun y hy => Set.mem_iUnion₂.mpr ⟨J, hJ, hIJ hy⟩
  have hliftN : ‖rIm (fp.frozenLift L l s mb G j ls b S.K)‖ ≤ Real.sqrt 5 * ‖rI Zu‖ := by
    rw [hlift]; exact L.norm_op_le _
  have h1 : ‖rI (fp.physMain Ms.Md (fp.frozenLift L l s mb G j ls b S.K))‖ ≤
      ‖rIm (fp.frozenLift L l s mb G j ls b S.K)‖ := by
    rw [← physEmbed_restrict]; exact norm_physEmbed_apply_le _
  have hcore : Ms.blockCore S hA SP b (fp.retainedV G b S.K) c =
      fp.frozenLift L l s mb G j ls b S.K - Ms.blockSide S hA SP b (fp.retainedV G b S.K) c := by
    rw [fp.frozenLift_eq_core_add_side Ms L l s mb G j ls S hA SP b c hrep, add_sub_cancel_right]
  rw [hcore, map_sub, map_sub]
  refine (norm_sub_le _ _).trans ?_
  have h5 : 0 ≤ Real.sqrt 5 := Real.sqrt_nonneg _
  nlinarith [norm_nonneg (rI Zh), norm_nonneg (rI (Zh - Zu))]

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- The rolling increment `Z_{l,G,h} - Z_{l,G,u_b}` of the slot `l` at the depth `h`. -/
noncomputable def roll (l : Fin 4) (G : bf.Grp) (h : ℤ) : ColumnL2 (bf.Lab ⊕ Fin fp.Mc) :=
  fp.basicOut l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) h -
    fp.frozenZ l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
      (A.blkStart D.S.K h - 4 * D.S.K)

/-- The physical linear side `V_{l,G,b}` of the block of the depth `h`. -/
noncomputable def pV (l : Fin 4) (G : bf.Grp) (h : ℤ) : ColumnL2 (bf.Lab ⊕ Fin fp.Mc) :=
  fp.physMain (D.Ms l G).Md ((D.Ms l G).blockSide D.S D.hA D.SP (A.blkStart D.S.K h)
    (fp.retainedV G (A.blkStart D.S.K h) D.S.K) (D.c l G (A.blkStart D.S.K h)))

open Classical in
/-- Blueprint line 2159 (rolling sides): the rolling increments of a basic slot on the cells of
all groups have total square at most `K (20 G₀ + 32) |R|` (`rolling_budget`). -/
theorem roll_cell_energy (hanc : A.AncClosed) (hne : A.cells.Nonempty) (l : Fin 4)
    (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells) (gs : ℤ × ℤ → Finset bf.Grp)
    (gset : Finset bf.Grp) (hgs : ∀ I ∈ S, gs I ⊆ gset) (k : ℕ)
    (hcertS : ∀ I ∈ S, ∀ G ∈ gs I, fp.Cert k G I)
    (B : D.toLeaf.BallData gset) {ra rb : ℝ}
    (hroot' : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ' : ℝ} (hτ' : 0 < τ') (hτ1 : τ' ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ'⁻¹) ^ A.Dg) ≤ fp.Hed)
    (hτN : τ' * B.N * A.colBudget ^ 2 ≤ 1) (cc : ℕ) (hc : 1 ≤ cc) {kk : ℝ} (hk : 1 ≤ kk)
    (hDm : ∀ l, Real.log (2 * (D.mbs l).B) ≤ kk ^ cc)
    (hDb : Real.log (2 * A.colBudget) ≤ kk ^ cc)
    (hLs : ∀ l, ((D.Lf.layers l).length : ℝ) ≤ cc * (Real.log kk + 1)) :
    ∑ I ∈ S, ∑ G ∈ gs I, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (D.roll l G I.1)‖ ^ 2 ≤
      D.S.K * (20 * Real.exp ((4096 * (cc + 1) * (1024 * (cc + 1) + cc + 7) + cc ^ 2 + 3) *
        (1 + Real.log (2 * kk)) ^ 2) + 32) * dyadicGridLength A.G A.R.1 := by
  have hdep : ∀ I ∈ S, A.R.1 ≤ I.1 := fun I hI =>
    dyadicGridCell_depth_le_of_subset A.G I A.R (A.sub I (hS hI))
  set Sd : Finset ℕ := S.image (fun I => (I.1 - A.R.1).toNat) with hSd_def
  set Ec : {G // G ∈ gset} → ℕ → Finset (ℤ × ℤ) := fun G t =>
    S.filter fun I => I.1 = A.R.1 + t ∧ G.1 ∈ gs I with hEc_def
  have hbud := fp.rolling_budget l (D.cat l) (B.hT l) (B.htag l) (B.dv l) (D.mbs l) hanc hne
    (ι := {G // G ∈ gset}) Subtype.val Subtype.val_injective k (D.Lf.role l) (B.hPH l)
    (D.Lf.layers l) D.hK Sd
    (fun t ht => by
      obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp ht
      exact Finset.le_sup (f := fun I => (I.1 - A.R.1).toNat) (hS hI))
    Ec (fun G t I hI => by
      obtain ⟨hIS, hIt, -⟩ := Finset.mem_filter.mp hI
      exact ⟨hS hIS, hIt⟩)
    (fun G t I hI => by
      obtain ⟨hIS, -, hG⟩ := Finset.mem_filter.mp hI
      exact hcertS I hIS G.1 hG) hroot' hτ' hτ1 hHed (B.hN l) hτN cc hc hk (hDm l) hDb (hLs l)
  have heq := cell_budget_eq A.G S (fun (G : {G // G ∈ gset}) h => D.roll l G.1 h)
    (fun G I => G.1 ∈ gs I) Sd A.R.1 Ec (fun G t => rfl) (fun I hI => ⟨(I.1 - A.R.1).toNat,
      Finset.mem_image_of_mem _ hI, by have := hdep I hI; omega⟩)
  calc ∑ I ∈ S, ∑ G ∈ gs I, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (D.roll l G I.1)‖ ^ 2
      = ∑ I ∈ S, ∑ G : {G // G ∈ gset}, (if G.1 ∈ gs I then
          ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
            (D.roll l G.1 I.1)‖ ^ 2 else 0) := by
        refine Finset.sum_congr rfl fun I hI => ?_
        rw [sum_sub_eq_ite (hgs I hI)]
    _ = ∑ t ∈ Sd, ∑ G : {G // G ∈ gset}, ‖columnL2Restriction
          (⋃ I ∈ Ec G t, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
          (D.roll l G.1 (A.R.1 + t))‖ ^ 2 := by
        refine Eq.trans ?_ heq
        refine Finset.sum_congr rfl fun I _ => Finset.sum_congr rfl fun G _ => ?_
        split_ifs <;> rfl
    _ ≤ _ := by
        refine le_of_eq_of_le (Finset.sum_congr rfl fun t _ => Finset.sum_congr rfl fun G _ => ?_)
          hbud
        unfold roll
        rw [blkStart_nat]

open Classical in
/-- Blueprint line 2159 ("a fixed `V_{l,G,b}` is counted at most `K` times"): the physical linear
sides of a basic slot on the cells of all groups have total square at most `K V_l |R|` under the
linear-side bound. -/
theorem V_cell_energy (l : Fin 4) (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells)
    (gs : ℤ × ℤ → Finset bf.Grp) (gset : Finset bf.Grp) (hgs : ∀ I ∈ S, gs I ⊆ gset) (Bn : ℕ)
    (hBn : ∀ I ∈ S, D.toLeaf.bk I < Bn) {Vl : ℝ}
    (hlin : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖(D.Ms l G).blockSide D.S D.hA D.SP
        (A.R.1 + ((D.S.K * β : ℕ) : ℤ)) (fp.retainedV G (A.R.1 + ((D.S.K * β : ℕ) : ℤ)) D.S.K)
        (D.c l G (A.R.1 + ((D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤ Vl * dyadicGridLength A.G A.R.1) :
    ∑ I ∈ S, ∑ G ∈ gs I, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (D.pV l G I.1)‖ ^ 2 ≤
      D.S.K * (Vl * dyadicGridLength A.G A.R.1) := by
  have hK := D.hK
  have hdep : ∀ I ∈ S, A.R.1 ≤ I.1 := fun I hI =>
    dyadicGridCell_depth_le_of_subset A.G I A.R (A.sub I (hS hI))
  set Sd : Finset ℕ := S.image (fun I => (I.1 - A.R.1).toNat) with hSd_def
  set Ec : {G // G ∈ gset} → ℕ → Finset (ℤ × ℤ) := fun G t =>
    S.filter fun I => I.1 = A.R.1 + t ∧ G.1 ∈ gs I with hEc_def
  have heq := cell_budget_eq A.G S (fun (G : {G // G ∈ gset}) h => D.pV l G.1 h)
    (fun G I => G.1 ∈ gs I) Sd A.R.1 Ec (fun G t => rfl) (fun I hI => ⟨(I.1 - A.R.1).toNat,
      Finset.mem_image_of_mem _ hI, by have := hdep I hI; omega⟩)
  set f : ℕ → ℝ := fun b => ∑ G : {G // G ∈ gset}, ‖(D.Ms l G.1).blockSide D.S D.hA D.SP
    (A.R.1 + (b : ℤ)) (fp.retainedV G.1 (A.R.1 + (b : ℤ)) D.S.K)
    (D.c l G.1 (A.R.1 + (b : ℤ)))‖ ^ 2 with hf
  have hf0 : ∀ b, 0 ≤ f b := fun b => Finset.sum_nonneg fun _ _ => sq_nonneg _
  calc ∑ I ∈ S, ∑ G ∈ gs I, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (D.pV l G I.1)‖ ^ 2
      = ∑ I ∈ S, ∑ G : {G // G ∈ gset}, (if G.1 ∈ gs I then
          ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
            (D.pV l G.1 I.1)‖ ^ 2 else 0) := by
        refine Finset.sum_congr rfl fun I hI => ?_
        rw [sum_sub_eq_ite (hgs I hI)]
    _ = ∑ t ∈ Sd, ∑ G : {G // G ∈ gset}, ‖columnL2Restriction
          (⋃ I ∈ Ec G t, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
          (D.pV l G.1 (A.R.1 + t))‖ ^ 2 := by
        refine Eq.trans ?_ heq
        refine Finset.sum_congr rfl fun I _ => Finset.sum_congr rfl fun G _ => ?_
        split_ifs <;> rfl
    _ ≤ ∑ t ∈ Sd, f (D.S.K * (t / D.S.K)) := by
        refine Finset.sum_le_sum fun t _ => Finset.sum_le_sum fun G _ => ?_
        refine (columnL2Restriction_norm_sq_le _ _ _).trans ?_
        unfold pV
        rw [blkStart_nat]
        exact pow_le_pow_left₀ (norm_nonneg _) (norm_physEmbed_apply_le _) 2
    _ ≤ D.S.K * ∑ b ∈ Sd.image (fun t => D.S.K * (t / D.S.K)), f b :=
        sum_block_le Sd (by omega) f hf0
    _ ≤ D.S.K * (Vl * dyadicGridLength A.G A.R.1) := by
        refine mul_le_mul_of_nonneg_left ((D.V_sum_le l gset Bn _ fun t' ht' => ?_).trans hlin)
          (Nat.cast_nonneg _)
        obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp ht'
        obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp ht
        refine ⟨(I.1 - A.R.1).toNat / D.S.K, ?_, rfl⟩
        have h1 := hBn I hI
        change ((I.1 - A.R.1) / D.S.K).toNat < Bn at h1
        rwa [toNat_ediv_eq (by have := hdep I hI; omega)] at h1

end SideInput

end ActiveSetup.BasicFamilies.FamParams

/-- Four cell terms under one minimum. -/
theorem min_four_le {η a e t c : ℝ} (hη : 0 ≤ η) (ha : 0 ≤ a) (he : 0 ≤ e) (ht : 0 ≤ t)
    (hc : 0 ≤ c) :
    min η (a + 82 * e + 82 * t + c) ≤ min η a + 82 * e + 82 * min η t + min η c := by
  simp only [min_def]
  split_ifs <;> linarith

/-- The core size bound `√5 (B₀ + √T) + √T` on retained cells (blueprint line 2164). -/
noncomputable def coreBd (B₀ T : ℝ) : ℝ := Real.sqrt 5 * (B₀ + Real.sqrt T) + Real.sqrt T

/-- The error size bound `(1 + √5)(B₀ + √T)` on retained cells (blueprint line 2164). -/
noncomputable def errBd (B₀ T : ℝ) : ℝ := (1 + Real.sqrt 5) * (B₀ + Real.sqrt T)

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

open Classical in
/-- Before the attempt there are no retained `v_b`-cells. -/
theorem retainedV_eq_empty (G : bf.Grp) {b : ℤ} {K : ℕ} (hb : b - 2 * K < A.R.1) :
    fp.retainedV G b K = ∅ := by
  refine Finset.eq_empty_of_forall_notMem fun J hJ => ?_
  obtain ⟨hJt, hJ1, -⟩ := (fp.mem_retainedV).mp hJ
  have h := ((dyadicFiniteTree_mem_iff A.G A.R J _).mp hJt).1
  have := dyadicGridCell_depth_le_of_subset A.G J A.R h
  omega

open Classical in
/-- Before the attempt the physical error vanishes (the frozen output is zero). -/
theorem physError_eq_zero {n : ℕ} (Ms : ModeSystem A.G n)
    (L : LiftData (bf.Lab ⊕ Fin fp.Mc) Ms.Md) (l : Fin 4) (s : List (CatCol bf.Vtx))
    (mb : bf.MainBudget s) (G : bf.Grp) (j : ℕ) (ls : List (ℕ × Bool)) {K : ℕ} {b : ℤ}
    (hb : b - 4 * K < A.R.1) : fp.physError Ms L l s mb G j ls K b = 0 := by
  have hz : fp.frozenZ l s mb G j ls (b - 4 * K) = 0 := by simp [frozenZ, hb]
  unfold physError frozenLift
  rw [hz, map_zero, map_zero, map_zero, map_zero, sub_zero]

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- The whole output of a basic slot on an active cell is the restriction of its coarse output. -/
theorem out_eq_restrict {l : Fin 4} (hl : D.u ≠ some l) (G : bf.Grp) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) :
    D.toLeaf.out l G I = columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2)
      (fp.basicOut l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) I.1) := by
  rw [fp.basicOut_restrict l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) hI]
  unfold SideLeafM.out
  rw [D.toLeaf.xin_basic l hl I]
  rfl

open Classical in
/-- Blueprint line 2164 on one cell of an actual use: with the whole output, the rolling increment
and the physical linear side of normalized sizes at most `B₀`, `√T`, `√T`, the core and the
physical error have normalized sizes at most `coreBd B₀ T` and `errBd B₀ T`. -/
theorem sizes_at (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) {I : ℤ × ℤ}
    (hI : I ∈ A.cells) (G : bf.Grp) (huse : fp.ActualUse G I) (l : Fin 4) (hrep : D.RepAt L l G I)
    {B₀ T : ℝ} (hB₀ : 0 ≤ B₀)
    (hout : ‖D.toLeaf.out l G I‖ ≤ B₀ * Real.sqrt (dyadicGridLength A.G I.1))
    (hroll : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (D.roll l G I.1)‖ ≤
        Real.sqrt T * Real.sqrt (dyadicGridLength A.G I.1))
    (hpV : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (D.pV l G I.1)‖ ≤
        Real.sqrt T * Real.sqrt (dyadicGridLength A.G I.1)) :
    ‖D.coreAt l G I‖ ≤ coreBd B₀ T * Real.sqrt (dyadicGridLength A.G I.1) ∧
      ‖D.errAt L l G I‖ ≤ errBd B₀ T * Real.sqrt (dyadicGridLength A.G I.1) := by
  have hsq := Real.sqrt_nonneg (dyadicGridLength A.G I.1)
  have h5 := Real.sqrt_nonneg 5
  have hT := Real.sqrt_nonneg T
  have hcB : 0 ≤ coreBd B₀ T := by unfold coreBd; positivity
  have heB : 0 ≤ errBd B₀ T := by unfold errBd; positivity
  by_cases hl : D.u = some l
  · simp only [coreAt, errAt, hl, ↓reduceIte, norm_zero]
    exact ⟨by positivity, by positivity⟩
  have hb := blkStart_bounds D.hK I.1 (A := A)
  set b := A.blkStart D.S.K I.1 with hbdef
  have hK0 : (0 : ℤ) ≤ D.S.K := Nat.cast_nonneg _
  by_cases hR : A.R.1 ≤ b - 2 * D.S.K
  · have hJ := fp.ancAt_mem_retainedV huse hb.1 hb.2 hR
    have hIJ := subset_ancAt A.G I (show b - 2 * (D.S.K : ℤ) ≤ I.1 by omega)
    have hZ : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.basicOut l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l) I.1)‖ ≤
        B₀ * Real.sqrt (dyadicGridLength A.G I.1) := by
      rw [← D.out_eq_restrict hl G hI]; exact hout
    have hc := fp.core_size_phys (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l)
      (D.Lf.layers l) D.S D.hA D.SP b (D.c l G b) hrep hJ hIJ I.1
    have he := (fp.core_error_sizes (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l)
      (D.Lf.layers l) D.S D.hA D.SP b (D.c l G b) hrep hJ hIJ I.1).1
    have hroll' := hroll
    have hpV' := hpV
    unfold roll at hroll'
    unfold pV at hpV'
    simp only [coreAt, errAt, hl, ↓reduceIte]
    constructor
    · refine hc.trans ?_
      unfold coreBd
      nlinarith
    · refine he.trans ?_
      unfold errBd
      nlinarith
  · have hempty := fp.retainedV_eq_empty G (b := b) (K := D.S.K) (by omega)
    have herr := fp.physError_eq_zero (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l)
      (D.Lf.layers l) (K := D.S.K) (b := b) (by omega)
    simp only [coreAt, errAt, hl, ↓reduceIte]
    rw [← hbdef, herr, hempty]
    unfold ModeSystem.blockCore
    simp only [Finset.sum_empty, map_zero, norm_zero]
    exact ⟨by positivity, by positivity⟩

end SideInput

end ActiveSetup.BasicFamilies.FamParams

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

/-- The cap of the rolling increments and the physical linear sides on the retained paths of the
second cut: `Σ_l (K (20 G₀ + 32) + K V_l) / ρ₂` over the basic slots. -/
noncomputable def T2 (cc : ℕ) (kk : ℝ) (Vl : Fin 4 → ℝ) (ρ₂ : ℝ) : ℝ :=
  (∑ l, if D.u = some l then 0 else
    (D.S.K * (20 * Real.exp ((4096 * (cc + 1) * (1024 * (cc + 1) + cc + 7) + cc ^ 2 + 3) *
      (1 + Real.log (2 * kk)) ^ 2) + 32) + D.S.K * Vl l)) / ρ₂

open Classical in
/-- Blueprint line 2461, the reduction of the core terms on the side states. Take the cut family
`C` of the side estimate (two-side bound `B₂`, side cap `T_c`, three-side power bound `B₃(B_c)` on
retained cells with cores of normalized size `B_c`) and a second cut `C₂` of root fraction at most
`ρ₂` for the integrated budgets of the rolling sides (`eq:variation`) and the linear sides
(`eq:linear-energy`). On the cells retained by both, the cores, errors and sides have the `P^C`
retained sizes `coreBd`, `errBd` and `√T_c` (the lift is pointwise bounded), and the weighted
active minimum of the whole leaf outputs is at most `B₂`, `82` times the error patterns (bounded by
`eq:physical-error`, the active multiplicity `M` and Cauchy-Schwarz), `82 B₃` and the weighted
active minimum of the patterns with at least three cores. A basic `U` role remains a side. -/
theorem core_reduction (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md)
    (hanc : A.AncClosed) (hne : A.cells.Nonempty) (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells)
    (gs : ℤ × ℤ → Finset bf.Grp) (gset : Finset bf.Grp) (hgs : ∀ I ∈ S, gs I ⊆ gset) (k Bn : ℕ)
    (hcertS : ∀ I ∈ S, ∀ G ∈ gs I, fp.Cert k G I)
    (huse : ∀ I ∈ S, ∀ G ∈ gs I, fp.ActualUse G I) (hBn : ∀ I ∈ S, D.toLeaf.bk I < Bn)
    (B : D.toLeaf.BallData gset) {ra rb : ℝ}
    (hroot' : ∀ I ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ Set.Icc ra rb)
    {τ' : ℝ} (hτ' : 0 < τ') (hτ1 : τ' ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ'⁻¹) ^ A.Dg) ≤ fp.Hed)
    (hτN : τ' * B.N * A.colBudget ^ 2 ≤ 1) (cc : ℕ) (hc : 1 ≤ cc) {kk : ℝ} (hk : 1 ≤ kk)
    (hDm : ∀ l, Real.log (2 * (D.mbs l).B) ≤ kk ^ cc)
    (hDb : Real.log (2 * A.colBudget) ≤ kk ^ cc)
    (hLs : ∀ l, ((D.Lf.layers l).length : ℝ) ≤ cc * (Real.log kk + 1)) {Vl : Fin 4 → ℝ}
    (hlin : ∀ l, D.u ≠ some l → ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖(D.Ms l G).blockSide D.S
        D.hA D.SP (A.R.1 + ((D.S.K * β : ℕ) : ℤ))
          (fp.retainedV G (A.R.1 + ((D.S.K * β : ℕ) : ℤ)) D.S.K)
          (D.c l G (A.R.1 + ((D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤
        Vl l * dyadicGridLength A.G A.R.1)
    (hrep : ∀ I ∈ S, ∀ G ∈ gs I, ∀ l, D.u ≠ some l → D.RepAt L l G I)
    {B₀ : ℝ} (hB₀ : 0 ≤ B₀)
    (hout : ∀ I ∈ S, ∀ G ∈ gs I, ∀ l,
      ‖D.toLeaf.out l G I‖ ≤ B₀ * Real.sqrt (dyadicGridLength A.G I.1))
    -- the outputs of the side estimate on its cut family `C`
    (C : Finset (ℤ × ℤ)) {η : ℝ} (hη : 0 ≤ η) {B₂ Tc : ℝ}
    (htwo : ∑ I ∈ S.filter (fun I => ¬ ∃ e ∈ C,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e.1 e.2),
        dyadicGridLength A.G I.1 * min η ‖∑ σ ∈ Finset.univ.filter
          (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
            (Finset.univ.filter fun l => σ l = 0).card = 2 ∧
            (Finset.univ.filter fun l => σ l = 1).card = 2),
          ∑ G ∈ gs I, fp.Λc I
            (fun l => if σ l = 0 then D.toLeaf.out l G I else D.toLeaf.sv l G I)‖ ≤ B₂)
    (hcap : ∀ x, ∑ I ∈ (S.filter (fun I => ¬ ∃ e ∈ C,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e.1 e.2)).filter
          (fun I => x ∈ dyadicGridCell A.G I.1 I.2), ∑ G ∈ gs I, D.toLeaf.s2 G I ≤ Tc)
    {B₃ : ℝ → ℝ}
    (hthree : ∀ (core err : ℤ × ℤ → bf.Grp → Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
        (S' : Finset (ℤ × ℤ)), S' ⊆ S.filter (fun I => ¬ ∃ e ∈ C,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e.1 e.2) → ∀ {Bc : ℝ}, 0 ≤ Bc →
        (∀ I ∈ S', ∀ G ∈ gs I, ∀ l,
          ‖core I G l‖ ≤ Bc * Real.sqrt (dyadicGridLength A.G I.1)) →
        ∑ I ∈ S', dyadicGridLength A.G I.1 * min η (∑ σ ∈ Finset.univ.filter
          (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
            ‖∑ G ∈ gs I, fp.Λc I
              (patternPiece (core I G) (fun l => D.toLeaf.sv l G I) (err I G) σ)‖) ≤ B₃ Bc)
    -- the physical errors (`eq:physical-error`) and the active multiplicity
    {Ee M : ℝ} (hEe : ∑ I ∈ S, ∑ G ∈ gs I, ∑ l, ‖D.errAt L l G I‖ ^ 2 ≤ Ee)
    (hM : ∑ I ∈ S, dyadicGridLength A.G I.1 * (gs I).card ≤ M)
