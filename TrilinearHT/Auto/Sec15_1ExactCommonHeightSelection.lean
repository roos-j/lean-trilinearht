namespace LeafSplit
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

open Classical in
/-- The goodness at a height of the entry of a component tuple in a slot: the goodness of the
component in a core slot, always good otherwise. -/
def slotGood (G : A.Grp) (b : ℤ) (Jp : Fin 4 → A.Grp → ℤ × ℤ) (l : Fin 4) (h : ℕ)
    (o : Option (Finset (D.Ms l G).Md)) : Prop :=
  match o with
  | some K => (D.Ms l G).compGood D.S D.hA D.SP b (Jp l G) h K
  | none => True

open Classical in
/-- The upper heights are nonempty for `δ ≤ 1/16`. -/
theorem upperHeights_nonempty {J : ℕ} {δ : ℝ} (hδ16 : δ ≤ 1 / 16) :
    (ModeComponents.upperHeights J δ).Nonempty := by
  refine ⟨J, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (Nat.lt_succ_self J), ?_⟩⟩
  refine Nat.ceil_le.mpr ?_
  have : (0 : ℝ) ≤ J := Nat.cast_nonneg J
  nlinarith

open Classical in
/-- Blueprint lines 2463-2466 on a leaf cell and group: every tuple of core components of a
pattern has an upper height at which all its slots are good (bad proportions at most `2δ` per
core slot, `8δ < 1`). -/
theorem tuple_success (G : A.Grp) (b : ℤ) (Jp : Fin 4 → A.Grp → ℤ × ℤ) (σ : Fin 4 → Fin 3)
    (hJ : 2 ≤ D.SP.Jst) (hδ : 0 < D.SP.δs) (hδ16 : D.SP.δs ≤ 1 / 16) :
    ∀ r ∈ Fintype.piFinset (compIdx σ (fun l => (D.Ms l G).coreComps D.S D.hA D.SP b (Jp l G))),
      ((ModeComponents.upperHeights D.SP.Jst D.SP.δs).filter
        fun h => ∀ l, D.slotGood G b Jp l h (r l)).Nonempty := by
  intro r hr
  set H := ModeComponents.upperHeights D.SP.Jst D.SP.δs
  have hHn := upperHeights_nonempty (J := D.SP.Jst) hδ16
  set bad : Fin 4 → Finset ℕ := fun l => H.filter fun h => ¬ D.slotGood G b Jp l h (r l)
  have hbad : ∀ l, ((bad l ∩ H).card : ℝ) ≤ 2 * D.SP.δs * H.card := by
    intro l
    have hsub : bad l ∩ H ⊆ bad l := Finset.inter_subset_left
    refine (Nat.cast_le.mpr (Finset.card_le_card hsub)).trans ?_
    have hrl := (Fintype.mem_piFinset.mp hr) l
    unfold compIdx at hrl
    split_ifs at hrl with hl
    · obtain ⟨K, hK, hrK⟩ := Finset.mem_map.mp hrl
      have e : bad l = H.filter fun h => ¬ (D.Ms l G).compGood D.S D.hA D.SP b (Jp l G) h K := by
        simp only [bad, ← hrK, slotGood, Function.Embedding.some_apply]
      rw [e]
      exact (D.Ms l G).coreComp_bad_card D.S D.hA D.SP hK hJ hδ hδ16
    · have hrn : r l = none := Finset.mem_singleton.mp hrl
      have e : bad l = ∅ := by
        simp only [bad, hrn, slotGood, not_true_eq_false]
        exact Finset.filter_false_of_mem fun _ _ => id
      rw [e, Finset.card_empty, Nat.cast_zero]
      have : (0 : ℝ) ≤ H.card := Nat.cast_nonneg _
      positivity
  have hpos := success_proportion_pos H hHn bad hbad (by norm_num; linarith)
  have hne : (H.filter fun h => ∀ l, h ∉ bad l).Nonempty := by
    by_contra hc
    rw [Finset.not_nonempty_iff_eq_empty] at hc
    rw [hc, Finset.card_empty, Nat.cast_zero, zero_div] at hpos
    exact lt_irrefl _ hpos
  obtain ⟨h, hh⟩ := hne
  obtain ⟨hH, hall⟩ := Finset.mem_filter.mp hh
  refine ⟨h, Finset.mem_filter.mpr ⟨hH, fun l => ?_⟩⟩
  by_contra hng
  exact hall l (Finset.mem_filter.mpr ⟨hH, hng⟩)

open Classical in
/-- Blueprint lines 2463-2469 on a leaf cell and group: the component expansion of a pattern form
is the convergent sum over the trial counts `n`, the assignments `a` of the failed trials to first
failing slots, the words `w` of failed heights and the final upper heights `h`, with weight
`|H|^{-(n+1)}`, of the sums over the tuples of components in the product masks. -/
theorem group_first_success (I : ℤ × ℤ) (G : A.Grp) (Zout ZU : Fin 4 → A.Grp → ColumnL2 (Fin ap.Mc))
    (σ : Fin 4 → Fin 3) (Jp : Fin 4 → A.Grp → ℤ × ℤ) (hJ : 2 ≤ D.SP.Jst) (hδ : 0 < D.SP.δs)
    (hδ16 : D.SP.δs ≤ 1 / 16) :
    HasSum (fun n : ℕ => ∑ a : Fin n → Fin 4,
      ∑ w ∈ Fintype.piFinset (fun _ : Fin n => ModeComponents.upperHeights D.SP.Jst D.SP.δs),
      ∑ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs,
        (((ModeComponents.upperHeights D.SP.Jst D.SP.δs).card : ℝ) ^ (n + 1))⁻¹ •
        ∑ r ∈ (Fintype.piFinset (compIdx σ
            (fun l => (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (Jp l G)))).filter
          (fun r => ∀ l, roleMask (D.slotGood G (D.blockOf I.1) Jp l) l a w h (r l)),
          ap.Λc I (compSlot σ (fun l K => D.compSub l G I (Jp l G) K)
            (fun l => π (D.side l G I (Zout l G) (ZU l G)))
            (fun l => π (D.err l G I (ZU l G))) r))
      (∑ r ∈ Fintype.piFinset (compIdx σ
          (fun l => (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (Jp l G))),
        ap.Λc I (compSlot σ (fun l K => D.compSub l G I (Jp l G) K)
          (fun l => π (D.side l G I (Zout l G) (ZU l G)))
          (fun l => π (D.err l G I (ZU l G))) r)) :=
  first_success_masked _ _ (fun l h o => D.slotGood G (D.blockOf I.1) Jp l h o) _
    (D.tuple_success G (D.blockOf I.1) Jp σ hJ hδ hδ16)

end LeafSplit

