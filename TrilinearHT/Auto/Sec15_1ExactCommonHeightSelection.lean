theorem physMain_physMain {V : Type*} [Fintype V] (x : ColumnL2 V) :
    fp.physMain (bf.Lab ⊕ Fin fp.Mc) (fp.physMain V x) = fp.physMain V x :=
  physEmbed_physEmbed x

