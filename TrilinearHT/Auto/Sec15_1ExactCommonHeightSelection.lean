    · subst hj
      rw [hFl, Finset.sum_singleton, Finset.sum_singleton, hcl, hzero, hγl, hfl y]
      simpa using hη
    · exact hfa j hj y hy
  · by_cases hj : j = l
    · subst hj
      rw [hFl, Finset.sum_singleton, hcl, norm_one, hfl y, norm_mul, Circle.norm_coe, mul_one,
        Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (centerCut_mem _ _ _ _).1]
      exact (centerCut_mem _ _ _ _).2
    · exact hfb j hj y hy

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc)

open Classical in
/-- The alive modes at a cell `U` all contain its left endpoint, so their number is at most any
bound on the modes whose first-match cell contains a point (blueprint line 2468, "a PRE path to
the representative has at most `D_*` edges"). -/
theorem card_alive_le (U : ℤ × ℤ) {Bc : ℝ}
    (hcount : ∀ y, ((Finset.univ.filter fun m =>
      y ∈ dyadicGridCell Gd (Ms.cellOf m).1 (Ms.cellOf m).2).card : ℝ) ≤ Bc) :
    (Fintype.card (Ms.alive U) : ℝ) ≤ Bc := by
  refine le_trans ?_ (hcount (dyadicGridLeft Gd U.1 U.2))
  rw [Fintype.card_coe]
  refine Nat.cast_le.mpr (Finset.card_le_card fun m hm => ?_)
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
    (Ms.mem_alive.mp hm) (dyadicGridCell_left_mem Gd U.1 U.2)⟩

/-- Blueprint line 2469 ("each selected mode was admitted by `u_b` and had curvature at most `D_*`
at its admission scale"): an alive mode at `U` has `|λ_m| ≤ Λ / |U|²`. -/
theorem lam_le_of_alive {U : ℤ × ℤ} (m : Ms.alive U) :
    |Ms.lamOf m.1| ≤ Ms.Λ / dyadicGridLength Gd U.1 ^ 2 := by
  have hsub := Ms.mem_alive.mp m.2
  have hlen := dyadicGridLength_le_of_subset Gd hsub
  have hU := dyadicGridLength_pos Gd U.1
  rw [le_div_iff₀ (by positivity)]
  calc |Ms.lamOf m.1| * dyadicGridLength Gd U.1 ^ 2 ≤
      |Ms.lamOf m.1| * dyadicGridLength Gd (Ms.cellOf m.1).1 ^ 2 :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hU.le hlen 2) (abs_nonneg _)
    _ ≤ Ms.Λ := Ms.lam_le m.1

end ModeSystem

/-- Two points of a dyadic cell are at distance at most its length. -/
theorem abs_sub_le_of_mem_cell {G : RealDyadicGrid} {I : ℤ × ℤ} {x y : ℝ}
    (hx : x ∈ Set.Icc (dyadicGridLeft G I.1 I.2)
      (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1))
    (hy : y ∈ Set.Icc (dyadicGridLeft G I.1 I.2)
      (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1)) :
    |y - x| ≤ dyadicGridLength G I.1 := by
  rw [abs_le]; constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

/-- Lengths along a chain of depths: `|I| = |d| 2^{-(I.1 - d)}` for `d ≤ I.1`. -/
theorem dyadicGridLength_of_le (G : RealDyadicGrid) {d s : ℤ} (h : d ≤ s) :
    dyadicGridLength G s = dyadicGridLength G d * (2 : ℝ)⁻¹ ^ (s - d).toNat := by
  rw [← dyadicGridLength_add_nat]
  congr 1
  omega

