theorem Λc_compSub_eq {I : ℤ × ℤ} (hI : I ∈ A.cells) (G : A.Grp) (J : Fin 4 → ℤ × ℤ)
    (hIJ : ∀ j, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G (J j).1 (J j).2)
