section FirstSuccess
variable {α : Type*} [DecidableEq α]

/-! ### First-success heights on the attempt cores (blueprint lines 2463-2467) -/

/-- Blueprint line 2467 (finite words): the words of length `n + 1` over the heights `H` whose
first success (membership in `G`) is the last letter number `|H \ G|^n |G|`. -/
theorem first_success_words_card (H Gd : Finset α) (n : ℕ) :
    (Fintype.piFinset fun i : Fin (n + 1) =>
      if (i : ℕ) = n then Gd else H \ Gd).card = (H \ Gd).card ^ n * Gd.card := by
  rw [Fintype.card_piFinset, Fin.prod_univ_castSucc]
  simp only [Fin.val_castSucc, Fin.val_last, ↓reduceIte]
  congr 1
  rw [Finset.prod_congr rfl (g := fun _ => (H \ Gd).card) fun i _ => by
    simp [Nat.ne_of_lt i.2], Finset.prod_const, Finset.card_univ, Fintype.card_fin]

/-- Blueprint line 2467 (exact identity in expectation): with one-trial success proportion
`p ∈ (0, 1]`, the first-success weights reproduce any value exactly:
`Σ_n (1 - p)^n p v = v`. -/
theorem first_success_hasSum {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {p : ℝ}
    (hp0 : 0 < p) (hp1 : p ≤ 1) (v : E) :
    HasSum (fun n : ℕ => ((1 - p) ^ n * p) • v) v := by
  simpa using (first_success_weights_sum hp0 hp1).smul_const v

/-- Blueprint lines 2468-2469 (product masks): the heights whose first failing role is `j`:
failure at role `j` and success at every earlier role. -/
def failMask {m₀ : ℕ} (H : Finset α) (bad : Fin m₀ → Finset α) (j : Fin m₀) : Finset α :=
  H.filter fun h => h ∈ bad j ∧ ∀ j' < j, h ∉ bad j'

/-- The failure masks of distinct roles are disjoint. -/
theorem failMask_disjoint {m₀ : ℕ} (H : Finset α) (bad : Fin m₀ → Finset α) {j j' : Fin m₀}
    (hne : j ≠ j') : Disjoint (failMask H bad j) (failMask H bad j') := by
  rw [Finset.disjoint_left]
  intro h h1 h2
  obtain ⟨-, hb1, hl1⟩ := Finset.mem_filter.mp h1
  obtain ⟨-, hb2, hl2⟩ := Finset.mem_filter.mp h2
  rcases lt_or_gt_of_ne hne with hlt | hlt
  · exact hl2 j hlt hb1
  · exact hl1 j' hlt hb2

/-- Every failed height lies in the failure mask of exactly one role (its first failing role). -/
theorem failed_mem_failMask {m₀ : ℕ} (H : Finset α) (bad : Fin m₀ → Finset α) {h : α}
    (hH : h ∈ H) (hf : ∃ j, h ∈ bad j) : ∃ j, h ∈ failMask H bad j := by
  classical
  have hs : (Finset.univ.filter fun j => h ∈ bad j).Nonempty := by
    obtain ⟨j, hj⟩ := hf
    exact ⟨j, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩⟩
  set j := (Finset.univ.filter fun j => h ∈ bad j).min' hs
  have hj : h ∈ bad j := (Finset.mem_filter.mp (Finset.min'_mem _ hs)).2
  refine ⟨j, Finset.mem_filter.mpr ⟨hH, hj, fun j' hj' hb => ?_⟩⟩
  exact absurd (Finset.min'_le _ j' (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hb⟩))
    (not_le.mpr hj')

/-- Blueprint lines 2468-2469 ("there are at most `m₀^n` assignments; for a fixed assignment the
conditions form a product mask"): the words of `n` failed trials are the disjoint union, over the
assignments `a : Fin n → Fin m₀` of trials to first failing roles, of the product masks. -/
theorem failed_words_eq_biUnion {m₀ n : ℕ} (H : Finset α) (bad : Fin m₀ → Finset α) :
    (Fintype.piFinset fun _ : Fin n => H.filter fun h => ∃ j, h ∈ bad j) =
      (Finset.univ : Finset (Fin n → Fin m₀)).biUnion fun a =>
        Fintype.piFinset fun i => failMask H bad (a i) := by
  classical
  ext w
  simp only [Fintype.mem_piFinset, Finset.mem_filter, Finset.mem_biUnion, Finset.mem_univ,
    true_and]
  constructor
  · intro hw
    choose a ha using fun i => failed_mem_failMask H bad (hw i).1 (hw i).2
    exact ⟨a, ha⟩
  · rintro ⟨a, ha⟩ i
    obtain ⟨hH, hb, -⟩ := Finset.mem_filter.mp (ha i)
    exact ⟨hH, a i, hb⟩

/-- The number of failure assignments of `n` trials is `m₀^n`. -/
theorem card_assignments (m₀ n : ℕ) :
    (Finset.univ : Finset (Fin n → Fin m₀)).card = m₀ ^ n := by
  simp

end FirstSuccess

/-! ### Frequency box and the offset side (blueprint lines 2476-2479) -/

/-- Blueprint `eq:frequency-box` (line 2477): the integer shifts of a selected component,
bounded by `|alive| E_h` (`component_torus_form`), lie in the box `B'_h = D_*^5 E_h` once the
alive modes number at most `D_* ≥ 1`. -/
theorem frequency_box {d : ℕ} (n : Fin d → ℤ) {N E D : ℝ} (hE : 0 ≤ E) (hD : 1 ≤ D)
    (hND : N ≤ D) (hn : ∀ i, |(n i : ℝ)| ≤ N * E) : ∀ i, |(n i : ℝ)| ≤ D ^ 5 * E := by
  intro i
  refine (hn i).trans (mul_le_mul_of_nonneg_right ?_ hE)
  calc N ≤ D := hND
    _ = D ^ 1 := (pow_one D).symm
    _ ≤ D ^ 5 := pow_le_pow_right₀ hD (by norm_num)

/-- Blueprint line 2478 (the offset side `S' = ζ^{ρ_l} e(-c_l p_{ρ_l}) S_phys`): multiplying a
side by a cutoff of modulus at most one and a unimodular phase does not increase its normalized
`L²` norm. -/
theorem offset_side_eLpNorm_le {μ : Measure ℝ} (ζ φ S : ℝ → ℂ) (hζ : ∀ y, ‖ζ y‖ ≤ 1)
    (hφ : ∀ y, ‖φ y‖ = 1) (hm : AEStronglyMeasurable (fun y => ζ y * φ y * S y) μ) :
    eLpNorm (fun y => ζ y * φ y * S y) 2 μ ≤ eLpNorm S 2 μ := by
  refine eLpNorm_mono hm fun y => ?_
  rw [norm_mul, norm_mul, hφ y, mul_one]
  exact mul_le_of_le_one_left (norm_nonneg _) (hζ y)

