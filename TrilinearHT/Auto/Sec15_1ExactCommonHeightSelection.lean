    (M : ∀ l, Finset (Finset (D.Ms l G).Md)) {ι : Fin 4 → Type*}
    (cls : ∀ l, Finset (D.Ms l G).Md → ι l)
    (hdis : ∀ l, Set.PairwiseDisjoint (M l : Set (Finset (D.Ms l G).Md)) id) :
