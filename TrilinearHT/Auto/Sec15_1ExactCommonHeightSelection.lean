variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

open Classical in
/-- Blueprint lines 2172-2191 and 2034-2035 on one pre-cell (representatives of the final
classes): if every good mode `x` at height `h` has a good class mode `m_C` with the same CURRENT
component `C = F_h(x)`, and `a_C ∈ E_{h-Δ}(m_C)`, then every mode of a good component `K` lies in
the PRE predecessor of the representative `a_C` of its final class (the `haRep` hypothesis of the
cell bounds). -/
theorem haRep_of_classMode {b : ℤ} {J : ℤ × ℤ} {h : ℕ}
    (hstab : ∀ h x x', Ms.goodP S SP b h ((Ms.blockComps S hA b J).π x) →
      (Ms.blockComps S hA b J).π x' = (Ms.blockComps S hA b J).π x →
      x' ∈ (Ms.blockComps S hA b J).F h x → x' ∈ (Ms.blockComps S hA b J).E (h - SP.Δ) x)
    (mC aC : Finset Ms.Md → Ms.alive (ancAt Gd J (b - 4 * S.K)))
    (hmC : ∀ x, (Ms.blockComps S hA b J).Good SP.Δ (Ms.goodP S SP b) h x →
      (Ms.blockComps S hA b J).Good SP.Δ (Ms.goodP S SP b) h
          (mC (((Ms.blockComps S hA b J).F h x).map ⟨Subtype.val, Subtype.val_injective⟩)) ∧
        (Ms.blockComps S hA b J).F h
          (mC (((Ms.blockComps S hA b J).F h x).map ⟨Subtype.val, Subtype.val_injective⟩)) =
          (Ms.blockComps S hA b J).F h x)
    (haC : ∀ C, aC C ∈ (Ms.blockComps S hA b J).E (h - SP.Δ) (mC C)) :
    ∀ K, Ms.compGood S hA SP b J h K → ∀ x : Ms.alive (ancAt Gd J (b - 4 * S.K)), x.1 ∈ K →
      x ∈ (Ms.blockComps S hA b J).E (h - SP.Δ) (aC (Ms.compClass S hA b J h K)) := by
  intro K hK x hxK
  obtain ⟨x₀, rfl, hx₀⟩ := hK
  rw [Ms.compClass_eq S hA b J h x₀]
  obtain ⟨hgood, hF⟩ := hmC x₀ hx₀
  have hx : x ∈ (Ms.blockComps S hA b J).E 0 x₀ := by
    obtain ⟨y, hy, hyx⟩ := Finset.mem_map.mp hxK
    rw [← Subtype.val_injective hyx]; exact hy
  exact (Ms.blockComps S hA b J).mem_pred_of_good_class SP.Δ (Ms.goodP S SP b) hstab hgood hx₀
    hF.symm hx (haC _)

end ModeSystem

