theorem leaf_error_bound (cat : Fin 4 → List (CatCol A.Vtx)) (r j : Fin 4 → ℕ)
    (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp)
    (hgs : ∀ I ∈ S, gs I ⊆ gset)
    (hdc : ∀ I ∈ S, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G (D.dcell I).1 (D.dcell I).2)
    {K : ℕ} (hK : ∀ U, ((S.filter fun I => D.dcell I = U).image Prod.fst).card ≤ K)
    (xs : Fin 4 → A.Grp → ℤ × ℤ → ColumnL2 (Fin ap.Mc)) (Zout : ℤ × ℤ → Fin 4 → A.Grp →
      ColumnL2 (Fin ap.Mc)) (hMc : 0 < ap.Mc) {Kx : ℝ}
    (hKx : ∀ l, ∀ G ∈ gset, ∀ U ∈ (S.filter fun I => G ∈ gs I).image D.dcell,
      ap.Mc * ‖xs l G U‖ ^ 2 / dyadicGridLength A.G U.1 ≤ Kx)
    (dim : A.Grp → ℕ) {dB : ℕ} (hdim : ∀ G ∈ gset, dim G ≤ dB) {δ δc : ℝ} (hδ : 0 < δ)
    (herr : ∀ l, ∑ G ∈ gset, ∑ U ∈ (S.filter fun I => G ∈ gs I).image D.dcell,
      ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
        (‖(ap.ballAt (cat l) (r l) (j l) G U (xs l G U) : ℝ → ColumnHilbert (Fin ap.Mc)) y
            none -
          ((D.Ms l G).L.op (ap.ballAt (cat l) (r l) (j l) G U (xs l G U)) :
            ℝ → ColumnHilbert (D.Ms l G).Md) y none‖ ^ 2) ≤
      ∑ G ∈ gset, ∑ U ∈ (S.filter fun I => G ∈ gs I).image D.dcell,
        ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
          (8 * dim G * δ *
            ‖(ap.ballAt (cat l) (r l) (j l) G U (xs l G U) : ℝ → ColumnHilbert (Fin ap.Mc)) y
              none‖ ^ 2 + 2 * δ ^ 2 * (δc ^ 2 * Kx / δ ^ 2)))
    {Bs M : ℝ} (hBs : 0 ≤ Bs)
    (hsize : ∀ I ∈ S, ∀ G ∈ gs I, ∀ l,
      ‖π (D.core l G I (ap.ballAt (cat l) (r l) (j l) G (D.dcell I) (xs l G (D.dcell I))))‖ ≤
        Bs * Real.sqrt (dyadicGridLength A.G I.1) ∧
      ‖π (D.side l G I (Zout I l G)
        (ap.ballAt (cat l) (r l) (j l) G (D.dcell I) (xs l G (D.dcell I))))‖ ≤
        Bs * Real.sqrt (dyadicGridLength A.G I.1) ∧
      ‖π (D.err l G I (ap.ballAt (cat l) (r l) (j l) G (D.dcell I) (xs l G (D.dcell I))))‖ ≤
