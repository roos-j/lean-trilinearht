namespace ModeComponents
variable {Mode P : Type*} [DecidableEq Mode] [DecidableEq P] (C : ModeComponents Mode P)

/-- Blueprint lines 2468-2470 ("the selected modes ... lie in the unique good predecessor of
each `F_j`"): a minimal PRE component good at `h` inside the CURRENT component of a mode `m` good
at `h` lies in the predecessor `E_{h-Δ}(m)`. -/
theorem minimalPre_subset_pred (Δ : ℕ) (goodP : ℕ → P → Prop) [∀ h, DecidablePred (goodP h)]
    (hstab : ∀ h x x', goodP h (C.π x) → C.π x' = C.π x → x' ∈ C.F h x → x' ∈ C.E (h - Δ) x)
    {h : ℕ} {m x : Mode} (hm : C.Good Δ goodP h m) (hx : C.Good Δ goodP h x)
    (hxm : x ∈ C.F h m) : C.E 0 x ⊆ C.E (h - Δ) m := by
  intro y hy
  have hgy : C.Good Δ goodP h y := (C.good_iff_of_minimal_pre Δ goodP hy h).mp hx
  have hyF : y ∈ C.F h m := by
    have h1 : y ∈ C.F h x := C.F_mono 0 h x (Nat.zero_le _) (C.E_le_F 0 x hy)
    rwa [C.F_comp h m x hxm] at h1
  rw [C.good_same_predecessor Δ goodP hstab hm hgy hyF]
  exact C.E_self _ y

end ModeComponents

