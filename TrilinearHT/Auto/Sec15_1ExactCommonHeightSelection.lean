/-! ### Exact common-height selection (common-height, blueprint lines 2464-2476) -/

/-- Blueprint lines 2466-2467 ("the first-success rule has total weight exactly one for every
tuple, hence gives an exact identity in expectation for the finite multilinear expansion"): for a
finite family of tuples `τ` with one-trial success proportions `p_τ ∈ (0, 1]`, the expansion
`Σ_τ F_τ` is the sum over trial counts `n` of `Σ_τ (1 - p_τ)^n p_τ F_τ`. -/
theorem first_success_identity {ι E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] (T : Finset ι) (pr : ι → ℝ) (hp0 : ∀ τ ∈ T, 0 < pr τ)
    (hp1 : ∀ τ ∈ T, pr τ ≤ 1) (F : ι → E) :
    HasSum (fun n : ℕ => ∑ τ ∈ T, ((1 - pr τ) ^ n * pr τ) • F τ) (∑ τ ∈ T, F τ) := by
  have h : ∀ τ ∈ T, HasSum (fun n : ℕ => ((1 - pr τ) ^ n * pr τ) • F τ) (F τ) := by
    intro τ hτ
    have := (first_success_weights_sum (hp0 τ hτ) (hp1 τ hτ)).smul_const (F τ)
    simpa only [one_smul] using this
  exact hasSum_sum h

/-- Blueprint line 2466 ("success probability is at least `1 - 2 m₀ δ_*`"): if each of `m₀` roles
has bad proportion at most `2δ` among the sampled heights, the one-trial success proportion of a
tuple is at least `1 - 2 m₀ δ`, positive when `2 m₀ δ < 1`. -/
theorem success_proportion_pos {α : Type*} [DecidableEq α] (H : Finset α) (hH : H.Nonempty)
    {m₀ : ℕ} (bad : Fin m₀ → Finset α) {δ : ℝ}
    (hbad : ∀ j, ((bad j ∩ H).card : ℝ) ≤ 2 * δ * H.card) (hδ : 2 * m₀ * δ < 1) :
    0 < ((H.filter fun h => ∀ j, h ∉ bad j).card : ℝ) / H.card := by
  have hc : (0 : ℝ) < H.card := by exact_mod_cast hH.card_pos
  have h := all_good_proportion H bad hbad
  apply div_pos _ hc
  have : 0 < (1 - m₀ * (2 * δ)) * H.card := mul_pos (by linarith) hc
  linarith

/-! ### Selected modes in torus form (`eq:core-torus-form`, blueprint lines 2468-2476) -/

/-- The quadratic phase identity `φ(y) - φ(x) = ω(x)(y - x) + λ(y - x)²` for
`φ(y) = λ(y-a)² + γ(y-a)`, `ω(y) = 2λ(y-a) + γ`. -/
theorem quad_phase_sub (lam a γ x y : ℝ) :
    (lam * (y - a) ^ 2 + γ * (y - a)) - (lam * (x - a) ^ 2 + γ * (x - a)) =
      (2 * lam * (x - a) + γ) * (y - x) + lam * (y - x) ^ 2 := by ring

/-- Blueprint lines 2470-2471 ("a PRE path to the representative supplies an integer shift with
slope error at most `D_* Ξ / r_{v_b}` ... the quadratic Taylor error is likewise small"): if the
slope of a mode `m` at `x*` equals that of the representative `a` minus the shift `s` up to `θ`,
the phase of `m` on the cell is `φ_m(x*) + (ω_a(x*) - s)(y - x*)` up to
`θ |y - x*| + |λ_m| (y - x*)²`. -/
theorem mode_phase_reduction {lam a γ ωa s θ x y : ℝ}
    (hsl : |(2 * lam * (x - a) + γ) - ωa + s| ≤ θ) :
    |(lam * (y - a) ^ 2 + γ * (y - a)) - (lam * (x - a) ^ 2 + γ * (x - a)) - (ωa - s) * (y - x)|
      ≤ θ * |y - x| + |lam| * (y - x) ^ 2 := by
  rw [quad_phase_sub]
  have e : (2 * lam * (x - a) + γ) * (y - x) + lam * (y - x) ^ 2 - (ωa - s) * (y - x) =
      ((2 * lam * (x - a) + γ) - ωa + s) * (y - x) + lam * (y - x) ^ 2 := by ring
  rw [e]
  refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
  · rw [abs_mul]; exact mul_le_mul_of_nonneg_right hsl (abs_nonneg _)
  · rw [abs_mul, abs_of_nonneg (sq_nonneg (y - x))]

/-- The exponential form of `mode_phase_reduction`: with `e(t) = exp(2πit)`,
`|e(φ_m(y)) - e(φ_m(x*)) e((ω_a(x*) - s)(y - x*))| ≤ 2π (θ |y - x*| + |λ_m| (y - x*)²)`. -/
theorem mode_char_reduction {lam a γ ωa s θ x y : ℝ}
    (hsl : |(2 * lam * (x - a) + γ) - ωa + s| ≤ θ) :
    ‖(Real.fourierChar (lam * (y - a) ^ 2 + γ * (y - a)) : ℂ) -
        (Real.fourierChar (lam * (x - a) ^ 2 + γ * (x - a)) : ℂ) *
          (Real.fourierChar ((ωa - s) * (y - x)) : ℂ)‖ ≤
      2 * Real.pi * (θ * |y - x| + |lam| * (y - x) ^ 2) := by
  have hmul : (Real.fourierChar (lam * (x - a) ^ 2 + γ * (x - a)) : ℂ) *
      (Real.fourierChar ((ωa - s) * (y - x)) : ℂ) =
      (Real.fourierChar ((lam * (x - a) ^ 2 + γ * (x - a)) + (ωa - s) * (y - x)) : ℂ) := by
    rw [Real.fourierChar.map_add_eq_mul (lam * (x - a) ^ 2 + γ * (x - a)) ((ωa - s) * (y - x)),
      Circle.coe_mul]
  rw [hmul]
  set u := lam * (y - a) ^ 2 + γ * (y - a)
  set v := (lam * (x - a) ^ 2 + γ * (x - a)) + (ωa - s) * (y - x)
  have hfc : ∀ t : ℝ, (Real.fourierChar t : ℂ) = Complex.exp (((2 * Real.pi * t : ℝ) : ℂ) *
      Complex.I) := by
    intro t; rw [Real.fourierChar_apply]
  rw [hfc u, hfc v]
  have h1 := Real.norm_exp_I_mul_ofReal_sub_one_le (x := 2 * Real.pi * (u - v))
  have hfac : Complex.exp (((2 * Real.pi * u : ℝ) : ℂ) * Complex.I) -
      Complex.exp (((2 * Real.pi * v : ℝ) : ℂ) * Complex.I) =
      Complex.exp (((2 * Real.pi * v : ℝ) : ℂ) * Complex.I) *
        (Complex.exp (Complex.I * ((2 * Real.pi * (u - v) : ℝ) : ℂ)) - 1) := by
    rw [mul_sub, mul_one, ← Complex.exp_add]
    congr 1
    push_cast; ring_nf
  rw [hfac, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]
  refine h1.trans ?_
  rw [Real.norm_eq_abs, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * Real.pi)]
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  have := mode_phase_reduction (y := y) hsl
  simpa only [u, v, sub_sub] using this

/-- Blueprint `eq:core-torus-form` (lines 2471-2476) for one role: the selected modes, each with
slope at `x*` equal to the representative's `ω_a(x*)` minus its shift `s_m` up to `θ`, and with
curvatures at most `Λ`, synthesize on the cell
`Σ_m α_m e(φ_m(y)) = e(ω_a(x*)(y - x*)) Σ_m α_m e(φ_m(x*)) e(-s_m (y - x*))` up to the uniform
error `2π (θ |y - x*| + Λ (y - x*)²) Σ_m |α_m|`. -/
theorem selected_torus_form {ι : Type*} (F : Finset ι) (α : ι → ℂ) (lam a γ s : ι → ℝ)
    {ωa θ Λ x y : ℝ} (hsl : ∀ m ∈ F, |(2 * lam m * (x - a m) + γ m) - ωa + s m| ≤ θ)
    (hlam : ∀ m ∈ F, |lam m| ≤ Λ) :
    ‖∑ m ∈ F, α m * (Real.fourierChar (lam m * (y - a m) ^ 2 + γ m * (y - a m)) : ℂ) -
        (Real.fourierChar (ωa * (y - x)) : ℂ) * ∑ m ∈ F, α m *
          ((Real.fourierChar (lam m * (x - a m) ^ 2 + γ m * (x - a m)) : ℂ) *
            (Real.fourierChar (-(s m * (y - x))) : ℂ))‖ ≤
      2 * Real.pi * (θ * |y - x| + Λ * (y - x) ^ 2) * ∑ m ∈ F, ‖α m‖ := by
  rw [Finset.mul_sum, ← Finset.sum_sub_distrib, Finset.mul_sum]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m hm => ?_)
  have hsplit : (Real.fourierChar (ωa * (y - x)) : ℂ) *
      (α m * ((Real.fourierChar (lam m * (x - a m) ^ 2 + γ m * (x - a m)) : ℂ) *
        (Real.fourierChar (-(s m * (y - x))) : ℂ))) =
      α m * ((Real.fourierChar (lam m * (x - a m) ^ 2 + γ m * (x - a m)) : ℂ) *
        (Real.fourierChar ((ωa - s m) * (y - x)) : ℂ)) := by
    have : (Real.fourierChar ((ωa - s m) * (y - x)) : ℂ) =
        (Real.fourierChar (ωa * (y - x)) : ℂ) * (Real.fourierChar (-(s m * (y - x))) : ℂ) := by
      rw [← Circle.coe_mul, ← Real.fourierChar.map_add_eq_mul]
      congr 2; ring
    rw [this]; ring
  rw [hsplit, ← mul_sub, norm_mul]
  have h := mode_char_reduction (y := y) (hsl m hm)
  have hl : 2 * Real.pi * (θ * |y - x| + |lam m| * (y - x) ^ 2) ≤
      2 * Real.pi * (θ * |y - x| + Λ * (y - x) ^ 2) := by
    gcongr; exact hlam m hm
  calc ‖α m‖ * _ ≤ ‖α m‖ * (2 * Real.pi * (θ * |y - x| + Λ * (y - x) ^ 2)) :=
        mul_le_mul_of_nonneg_left (h.trans hl) (norm_nonneg _)
    _ = _ := by ring

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

/-- Blueprint line 2470 ("a PRE path to the representative has at most `D_*` edges; it supplies
an integer shift of size at most `D_* E_{h-Δ}`, with slope error at most `D_* Ξ / r_{v_b}`"):
two modes in one PRE component at height `h` of the pre-cell `J` of block `b` differ in slope,
after a shift `n·ϑ/L_h` with `|n| ≤ |alive| E_h`, by at most `|alive| Ξ / r_J` on the pre-cell. -/
theorem pre_component_shift {b : ℤ} {J : ℤ × ℤ} (hJ : J.1 ≤ b + S.K) {h : ℕ}
    {x a : Ms.alive (ancAt Gd J (b - 4 * S.K))} (hx : x ∈ (Ms.blockComps S hA b J).E h a) :
    ∃ n : Fin Ms.zc.dim → ℤ,
      (∀ i, |(n i : ℝ)| ≤ Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) * S.Eh h) ∧
      ∀ y ∈ Set.Icc (dyadicGridLeft Gd J.1 J.2)
          (dyadicGridLeft Gd J.1 J.2 + dyadicGridLength Gd J.1),
        |Ms.slope a.1 y - Ms.slope x.1 y + (∑ i, (n i : ℝ) * (Ms.zc.θ i / S.Q0)) /
            ModeSchedule.Lh h| ≤
          Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) *
            (S.Ξ / dyadicGridLength Gd J.1) := by
  classical
  rw [Ms.blockComps_eq S hA hJ] at hx
  unfold preComps ModeSchedule.preCurrent ModeComponents.ofEdges at hx
  have hreach := by simpa using hx
  have hE : 0 ≤ S.Eh h := by unfold ModeSchedule.Eh; have := hA; positivity
  exact S.gapEdge_reachable_sum (fun (x : Ms.alive (ancAt Gd J (b - 4 * S.K))) (y : ℝ) =>
    Ms.slope x.1 y) (fun l => Ms.zc.θ l / S.Q0) _ _ _
    (div_nonneg (Ξ_nonneg S) (dyadicGridLength_pos Gd J.1).le) hE hreach

/-- The quadratic phase `φ_m(y) = λ_m (y - a_m)² + γ_m (y - a_m)` of a mode. -/
noncomputable def phase (m : Ms.Md) (y : ℝ) : ℝ :=
  Ms.lamOf m * (y - dyadicGridLeft Gd (Ms.cellOf m).1 (Ms.cellOf m).2) ^ 2 +
    Ms.γOf m * (y - dyadicGridLeft Gd (Ms.cellOf m).1 (Ms.cellOf m).2)

open Classical in
/-- Blueprint `eq:core-torus-form` (lines 2468-2476) for one selected component: the selected
modes `F` of the PRE predecessor of the representative `a` at height `h` on the pre-cell `J`
synthesize, at points `x*, y` of the pre-cell, the representative phase times a trigonometric
polynomial in the integer shifts `n_m` (`|n_m| ≤ |alive| E_h`):
`Σ_m α_m e(φ_m(y)) = e(ω_a(x*)(y - x*)) Σ_m α_m e(φ_m(x*)) e(-(n_m·ϑ/L_h)(y - x*))`, up to
`2π (|alive| Ξ/r_J |y - x*| + Λ (y - x*)²) Σ |α_m|` when all curvatures are at most `Λ`. -/
theorem component_torus_form {b : ℤ} {J : ℤ × ℤ} (hJ : J.1 ≤ b + S.K) {h : ℕ}
    (a : Ms.alive (ancAt Gd J (b - 4 * S.K)))
    (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K))))
    (hF : F ⊆ (Ms.blockComps S hA b J).E h a) (α : Ms.alive (ancAt Gd J (b - 4 * S.K)) → ℂ)
    {Λ : ℝ} (hΛ : ∀ m ∈ F, |Ms.lamOf m.1| ≤ Λ) :
    ∃ n : Ms.alive (ancAt Gd J (b - 4 * S.K)) → Fin Ms.zc.dim → ℤ,
      (∀ m ∈ F, ∀ i, |(n m i : ℝ)| ≤
        Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) * S.Eh h) ∧
      ∀ x ∈ Set.Icc (dyadicGridLeft Gd J.1 J.2)
          (dyadicGridLeft Gd J.1 J.2 + dyadicGridLength Gd J.1), ∀ y : ℝ,
        ‖∑ m ∈ F, α m * (Real.fourierChar (Ms.phase m.1 y) : ℂ) -
          (Real.fourierChar (Ms.slope a.1 x * (y - x)) : ℂ) * ∑ m ∈ F, α m *
            ((Real.fourierChar (Ms.phase m.1 x) : ℂ) *
              (Real.fourierChar (-((-(∑ i, (n m i : ℝ) * (Ms.zc.θ i / S.Q0)) /
                ModeSchedule.Lh h) * (y - x))) : ℂ))‖ ≤
          2 * Real.pi * (Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) *
            (S.Ξ / dyadicGridLength Gd J.1) * |y - x| + Λ * (y - x) ^ 2) * ∑ m ∈ F, ‖α m‖ := by
  have hex : ∀ m : Ms.alive (ancAt Gd J (b - 4 * S.K)), ∃ n : Fin Ms.zc.dim → ℤ,
      m ∈ F → (∀ i, |(n i : ℝ)| ≤ Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) *
        S.Eh h) ∧ ∀ y ∈ Set.Icc (dyadicGridLeft Gd J.1 J.2)
          (dyadicGridLeft Gd J.1 J.2 + dyadicGridLength Gd J.1),
        |Ms.slope a.1 y - Ms.slope m.1 y + (∑ i, (n i : ℝ) * (Ms.zc.θ i / S.Q0)) /
            ModeSchedule.Lh h| ≤ Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) *
              (S.Ξ / dyadicGridLength Gd J.1) := by
    intro m
    by_cases hm : m ∈ F
    · obtain ⟨n, hn, hsl⟩ := Ms.pre_component_shift S hA hJ (hF hm)
      exact ⟨n, fun _ => ⟨hn, hsl⟩⟩
    · exact ⟨0, fun h' => absurd h' hm⟩
  choose n hn using hex
  refine ⟨n, fun m hm => (hn m hm).1, fun x hx y => ?_⟩
  have h := selected_torus_form F α (fun m => Ms.lamOf m.1)
    (fun m => dyadicGridLeft Gd (Ms.cellOf m.1).1 (Ms.cellOf m.1).2) (fun m => Ms.γOf m.1)
    (fun m => -(∑ i, (n m i : ℝ) * (Ms.zc.θ i / S.Q0)) / ModeSchedule.Lh h)
    (ωa := Ms.slope a.1 x) (x := x) (y := y)
    (θ := Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) * (S.Ξ / dyadicGridLength Gd J.1))
    (fun m hm => ?_) hΛ
  · exact h
  · have := (hn m hm).2 x hx
    rw [← abs_neg]
    convert this using 2
    simp only [slope]
    ring

end ModeSystem

end Auto

