theorem Λc_phys (I : ℤ × ℤ) (x : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    fp.Λc I x = fp.Λc I (fun l => fp.physMain (bf.Lab ⊕ Fin fp.Mc) (x l)) := by
  by_cases hI : I ∈ A.cells
  · rw [fp.Λc_apply hI, fp.Λc_apply hI]
    refine localProgressionForm_congr_ae _ _ fun l => ?_
    filter_upwards [physEmbed_coeFn_none (W := bf.Lab ⊕ Fin fp.Mc) (x l)] with y hy
    exact hy.symm
  · unfold Λc
    simp [hI]

