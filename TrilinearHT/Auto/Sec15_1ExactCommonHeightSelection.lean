/-- Transport of the gauge and the slope shifts of a mode system to a chart tag `z = Ms.zc`
(the four roles of a group share their chart tag but have dependent frequency dimensions). -/
theorem chart_transport (Ms : ModeSystem Gd Mc) (z : ChartTag) (hz : Ms.zc = z) :
    ∃ ρ' : Fin z.dim → ℝ, ∃ e : Fin Ms.zc.dim ≃ Fin z.dim,
      (∀ i, ρ' (e i) = Ms.ρ i) ∧ (∀ i, z.θ (e i) = Ms.zc.θ i) ∧
      ∀ y, Ms.gauge y = (centerCut z Ms.δc ρ' y : ℂ) *
        (Real.fourierChar ((Ms.cl : ℝ) * centerPhase z ρ' y) : ℂ) := by
  rcases Ms with ⟨Md, L, zc, δc, ρ, cl⟩
  simp only at hz ⊢
  subst hz
  exact ⟨ρ, Equiv.refl _, fun _ => rfl, fun _ => rfl, fun _ => rfl⟩

end ModeSystem

