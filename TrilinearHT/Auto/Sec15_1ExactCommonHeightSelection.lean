variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {bf : A.BasicFamilies}
  {fp : bf.FamParams}

namespace SideInput
variable (D : fp.SideInput)

open Classical in
/-- The energy of the cell error of a basic slot is the cell integral of the squared physical
error (the form of `eq:physical-error` produced by the offset selection,
`physical_error_used`). -/
theorem errAt_norm_sq (L : ∀ l G, LiftData (bf.Lab ⊕ Fin fp.Mc) (D.Ms l G).Md) {l : Fin 4}
    (hl : D.u ≠ some l) (G : bf.Grp) (I : ℤ × ℤ) :
    ‖D.errAt L l G I‖ ^ 2 = ∫ y in dyadicGridCell A.G I.1 I.2,
      ‖(fp.physError (D.Ms l G) (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l) (D.Lf.layers l)
        D.S.K (A.blkStart D.S.K I.1) : ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc)) y none‖ ^ 2 := by
  simp only [errAt, hl, ↓reduceIte]
  unfold physError
  rw [norm_sq_restrict_physEmbed_sub]
  refine integral_congr_ae (ae_restrict_of_ae ?_)
  filter_upwards [Lp.coeFn_sub
      (fp.physMain (bf.Lab ⊕ Fin fp.Mc) (fp.frozenZ l (D.cat l) (D.mbs l) G (D.Lf.role l)
        (D.Lf.layers l) (A.blkStart D.S.K I.1 - 4 * D.S.K)))
      (fp.physMain (D.Ms l G).Md (fp.frozenLift (L l G) l (D.cat l) (D.mbs l) G (D.Lf.role l)
        (D.Lf.layers l) (A.blkStart D.S.K I.1) D.S.K)),
    physEmbed_coeFn_none (W := bf.Lab ⊕ Fin fp.Mc) (fp.frozenZ l (D.cat l) (D.mbs l) G
      (D.Lf.role l) (D.Lf.layers l) (A.blkStart D.S.K I.1 - 4 * D.S.K)),
    physEmbed_coeFn_none (W := bf.Lab ⊕ Fin fp.Mc) (fp.frozenLift (L l G) l (D.cat l) (D.mbs l)
      G (D.Lf.role l) (D.Lf.layers l) (A.blkStart D.S.K I.1) D.S.K)] with y h1 h2 h3
  rw [h1, Pi.sub_apply, PiLp.sub_apply, h2, h3]

end SideInput

