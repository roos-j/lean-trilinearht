open Classical in
/-- Blueprint lines 2463-2470 (four core roles): the cell form of four component subtotals on
their pre-cells is the local form of the wave combinations `1_I Σ_{m ∈ K_j} c_m wave_m`. -/
theorem Λc_compSub_eq {I : ℤ × ℤ} (hI : I ∈ A.cells) (G : A.Grp) (J : Fin 4 → ℤ × ℤ)
    (hIJ : ∀ j, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G (J j).1 (J j).2)
    (K : ∀ j, Finset (D.Ms j G).Md) :
    ap.Λc I (fun j => D.compSub j G I (J j) (K j)) =
      localProgressionForm (dyadicGridLength A.G I.1) (A.w I) (fun j =>
        (dyadicGridCell A.G I.1 I.2).indicator (fun y => ∑ m ∈ K j,
          D.c j G (D.blockOf I.1) (J j) m * (D.Ms j G).wave m y)) := by
  rw [ap.Λc_eq_form hI]
  exact localProgressionForm_congr_ae _ _ fun j => D.augPhys_compSub j G (hIJ j) (K j)

