/-- The final-height class of a component index of a core slot (blueprint line 2467). -/
noncomputable def coreCls (G : A.Grp) (I : ℤ × ℤ) (h : ℕ) (l : Fin 4)
    (o : Option (Finset (D.Ms l G).Md)) : Finset (D.Ms l G).Md :=
  match o with
  | some K => (D.Ms l G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h K
  | none => ∅

open Classical in
/-- Blueprint lines 2466-2467 (masks select entire minimal CURRENT components): two core
components of a slot in one minimal CURRENT component have the same role mask for every failure
history with heights in the upper heights, and the same final class at every height. -/
theorem roleMask_iff_of_same_unit (G : A.Grp) (I : ℤ × ℤ) (l : Fin 4)
    (hstab : ∀ h x x', (D.Ms l G).goodP D.S D.SP (D.blockOf I.1) h
      (((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).π x) →
      ((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).π x' =
        ((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).π x →
      x' ∈ ((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).F h x →
      x' ∈ ((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).E (h - D.SP.Δ) x)
    (hJ : 2 ≤ D.SP.Jst) (hδ : 0 < D.SP.δs) (hδJ : ⌈4 * D.SP.δs * D.SP.Jst⌉₊ ≤ D.SP.Jst)
    {K K' : Finset (D.Ms l G).Md}
    (hK : K ∈ (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I))
    (hK' : K' ∈ (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I))
    (hcls : (D.Ms l G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) 0 K =
      (D.Ms l G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) 0 K')
    {n : ℕ} (a : Fin n → Fin 4) {w : Fin n → ℕ}
    (hw : ∀ i, w i ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs) {h : ℕ}
    (hh : h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs) :
    (roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h (some K) ↔
      roleMask (D.slotGood G (D.blockOf I.1) (fun _ _ => D.preCell I) l) l a w h (some K')) ∧
    (D.Ms l G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h K =
      (D.Ms l G).compClass D.S D.hA (D.blockOf I.1) (D.preCell I) h K' := by
  have hg := fun t (ht : t ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs) =>
    (D.Ms l G).compGood_iff_of_same_class D.S D.hA D.SP hstab hJ hδ hδJ hK hK' hcls t ht
  refine ⟨?_, ?_⟩
  · unfold roleMask slotGood
    simp only
    rw [hg h hh]
    constructor
    · rintro ⟨h1, h2, h3⟩
      exact ⟨h1, fun i hi => (hg (w i) (hw i)).not.mp (h2 i hi),
        fun i hi => (hg (w i) (hw i)).mp (h3 i hi)⟩
    · rintro ⟨h1, h2, h3⟩
      exact ⟨h1, fun i hi => (hg (w i) (hw i)).not.mpr (h2 i hi),
        fun i hi => (hg (w i) (hw i)).mpr (h3 i hi)⟩
  · obtain ⟨x, hKx, -⟩ := (D.Ms l G).coreComps_rep D.S D.hA D.SP hK
    obtain ⟨x', hKx', -⟩ := (D.Ms l G).coreComps_rep D.S D.hA D.SP hK'
    rw [hKx, hKx', (D.Ms l G).compClass_eq D.S D.hA _ _ 0 x,
      (D.Ms l G).compClass_eq D.S D.hA _ _ 0 x'] at hcls
    have hF0 : ((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).F 0 x =
        ((D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)).F 0 x' :=
      Finset.map_injective _ hcls
    set C := (D.Ms l G).blockComps D.S D.hA (D.blockOf I.1) (D.preCell I)
    have hx' : x' ∈ C.F h x :=
      C.F_mono 0 h x (Nat.zero_le h) (hF0 ▸ C.E_le_F 0 x' (C.E_self 0 x'))
    rw [hKx, hKx', (D.Ms l G).compClass_eq D.S D.hA _ _ h x,
      (D.Ms l G).compClass_eq D.S D.hA _ _ h x', C.F_comp h x x' hx']

end LeafSplit

