/-- Blueprint lines 2468-2470 ("group the selected modes at the final successful components"):
the subtotals of pairwise disjoint components add up to the subtotal of their union. -/
theorem sum_compSub (l : Fin 4) (G : A.Grp) (I J : ℤ × ℤ) {ι : Type*} (s : Finset ι)
    (K : ι → Finset (D.Ms l G).Md)
    (hdis : Set.PairwiseDisjoint (s : Set ι) K) :
    ∑ i ∈ s, D.compSub l G I J (K i) = D.compSub l G I J (s.biUnion K) := by
  unfold compSub
  rw [Finset.sum_biUnion hdis]
  simp only [map_sum]

open Classical in
/-- Blueprint lines 2468-2470 for four core roles: the forms of the masked component tuples sum to
the forms of the grouped subtotals, grouped by a class map `cls` (the final successful CURRENT
components), each grouped input being the subtotal of the union of the masked components of the
class. -/
theorem grouped_cell_form (I : ℤ × ℤ) (G : A.Grp) (J : Fin 4 → ℤ × ℤ)
    (M : ∀ l, Finset (Finset (D.Ms l G).Md)) {ι : Fin 4 → Type*}
    (cls : ∀ l, Finset (D.Ms l G).Md → ι l)
    (hdis : ∀ l, Set.PairwiseDisjoint (M l : Set (Finset (D.Ms l G).Md)) id) :
    ∑ r ∈ Fintype.piFinset M, ap.Λc I (fun l => D.compSub l G I (J l) (r l)) =
      ∑ p ∈ Fintype.piFinset (fun l => (M l).image (cls l)),
        ap.Λc I (fun l => D.compSub l G I (J l)
          (((M l).filter fun K => cls l K = p l).biUnion id)) := by
  rw [multilinear_regroup (ap.Λc I) M cls (fun l K => D.compSub l G I (J l) K)]
  refine Finset.sum_congr rfl fun p _ => ?_
  congr 1
  funext l
  exact D.sum_compSub l G I (J l) _ id ((hdis l).subset (Finset.coe_subset.mpr
    (Finset.filter_subset _ _)))

