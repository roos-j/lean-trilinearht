open Classical in
/-- Blueprint lines 2470-2476 for one role on a cell `[lo, hi]` of its pre-cell: the selected wave
sum `Σ_{m ∈ F} α_m wave_m` satisfies the hypotheses of `four_core_product` with `γ = ω_a(x*)`,
coefficients `c_m = α_m e(φ_m(x*))`, `ξ = θ_z/(Q₀ 6^h)` and relative error `η` bounding the
torus-form error on the cell. -/
theorem role_input_approx (z : ChartTag) (hz : Ms.zc = z) {b : ℤ} {J : ℤ × ℤ}
    (hJ : J.1 ≤ b + S.K) {h : ℕ} (a : Ms.alive (ancAt Gd J (b - 4 * S.K)))
    (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K))))
    (hF : F ⊆ (Ms.blockComps S hA b J).E h a) (α : Ms.alive (ancAt Gd J (b - 4 * S.K)) → ℂ)
    {Λ : ℝ} (hΛ : ∀ m ∈ F, |Ms.lamOf m.1| ≤ Λ) {xs : ℝ}
    (hxs : xs ∈ Set.Icc (dyadicGridLeft Gd J.1 J.2)
      (dyadicGridLeft Gd J.1 J.2 + dyadicGridLength Gd J.1)) {lo hi η : ℝ}
    (hη : ∀ y ∈ Set.Icc lo hi, 2 * Real.pi * (Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) *
      (S.Ξ / dyadicGridLength Gd J.1) * |y - xs| + Λ * (y - xs) ^ 2) ≤ η) :
    ∃ ρ' : Fin z.dim → ℝ, (∀ i, ∃ k, ρ' i = Ms.ρ k) ∧
      (∀ y, Ms.gauge y = (centerCut z Ms.δc ρ' y : ℂ) *
        (Real.fourierChar ((Ms.cl : ℝ) * centerPhase z ρ' y) : ℂ)) ∧
      ∃ n : Ms.alive (ancAt Gd J (b - 4 * S.K)) → Fin z.dim → ℤ,
      (∀ m ∈ F, ∀ i, |(n m i : ℝ)| ≤
        Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) * S.Eh h) ∧
      (∀ y ∈ Set.Icc lo hi, ‖∑ m ∈ F, α m * Ms.wave m.1 y -
          ((centerCut z Ms.δc ρ' y : ℂ) * (Real.fourierChar ((Ms.cl : ℝ) *
            centerPhase z ρ' y) : ℂ)) * ((Real.fourierChar (Ms.slope a.1 xs * (y - xs)) : ℂ) *
            ∑ m ∈ F, (α m * (Real.fourierChar (Ms.phase m.1 xs) : ℂ)) *
              torusCharacter (n m) (torusMk fun i => z.θ i / (S.Q0 * 6 ^ h) * (y - xs)))‖ ≤
          η * ∑ m ∈ F, ‖α m * (Real.fourierChar (Ms.phase m.1 xs) : ℂ)‖) ∧
      (∀ y, ‖∑ m ∈ F, α m * Ms.wave m.1 y‖ ≤
        ∑ m ∈ F, ‖α m * (Real.fourierChar (Ms.phase m.1 xs) : ℂ)‖) := by
  obtain ⟨ρ', hρ', hgauge, n, hn, hform⟩ := Ms.group_torus_char' S hA z hz hJ a F hF α hΛ
  have hnorm : ∀ m, ‖α m * (Real.fourierChar (Ms.phase m.1 xs) : ℂ)‖ = ‖α m‖ := fun m => by
    rw [norm_mul, Circle.norm_coe, mul_one]
  refine ⟨ρ', hρ', hgauge, n, hn, fun y hy => ?_, fun y => ?_⟩
  · refine (hform xs hxs y).trans ?_
    simp_rw [hnorm]
    exact mul_le_mul_of_nonneg_right (hη y hy) (Finset.sum_nonneg fun _ _ => norm_nonneg _)
  · simp_rw [hnorm]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => ?_)
    rw [norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) (Ms.wave_norm_le m.1 y)

end ModeSystem

