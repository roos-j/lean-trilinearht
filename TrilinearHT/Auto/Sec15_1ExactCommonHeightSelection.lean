open Classical in
/-- Blueprint lines 2470-2480 (`eq:core-torus-form` for four selected core roles with the gauge
multiplier): if each role input is, on the cell `[lo, hi]`, within `η Σ_k |c_{j,k}|` of
`gauge_j(y) e(γ_j (y - x*)) Σ_k c_{j,k} χ_{n_{j,k}}(ξ (y - x*))` with gauges of a common chart tag
(`ξ = θ/(Q₀ L)`, offsets in `[0, 1]`), then there are truncated cutoff and multiplier coefficients
of modulus at most one such that on the cell the product of the inputs is within
`(4η + E_g) Π_j Σ_k |c_{j,k}|` of `e(Σ_j γ_j (y_j - x*)) R(u, v) Π_j g_j(u + j v)`. -/
theorem four_core_product (z : ChartTag) (hd : 1 ≤ z.dim) {δ δ'' : ℝ} (hδ : 0 < δ)
    (hδ'' : 0 < δ'') (ρ : Fin 4 → Fin z.dim → ℝ) (hρ : ∀ j a, ρ j a ∈ Set.Icc (0 : ℝ) 1)
    {Q0 : ℕ} (hQ0 : 0 < Q0) (hQ : ∀ a b, ∃ k : ℤ, (Q0 : ℝ) * (z.C a b : ℝ) = k) {Cm : ℝ}
    (hCm0 : 0 ≤ Cm) (hCm : ∀ a b, |(z.C a b : ℝ)| ≤ Cm) {L : ℕ} (hL : 0 < L) (Kt : ℕ)
    (xs : ℝ) (γ : Fin 4 → ℝ) {ι : Fin 4 → Type*} (F : ∀ j, Finset (ι j))
    (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin z.dim → ℤ) (f : Fin 4 → ℝ → ℂ) (lo hi : ℝ)
    {η : ℝ} (hη : 0 ≤ η)
    (hfa : ∀ j, ∀ y ∈ Set.Icc lo hi, ‖f j y - ((centerCut z δ (ρ j) y : ℂ) *
      (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) * centerPhase z (ρ j) y) : ℂ)) *
        ((Real.fourierChar (γ j * (y - xs)) : ℂ) * ∑ k ∈ F j, c j k *
          torusCharacter (n j k) (torusMk fun i => z.θ i / (Q0 * L) * (y - xs)))‖ ≤
            η * ∑ k ∈ F j, ‖c j k‖)
    (hfb : ∀ j, ∀ y ∈ Set.Icc lo hi, ‖f j y‖ ≤ ∑ k ∈ F j, ‖c j k‖) :
    ∃ cc : Fin 4 → (Fin z.dim → ℤ) → ℂ, ∃ cm : (Fin (z.dim + z.dim) → ℤ) → ℂ,
      (∀ j v, ‖cc j v‖ ≤ 1) ∧ (∀ v, ‖cm v‖ ≤ 1) ∧
      (∀ j u, ‖∑ v ∈ frequencyBox z.dim (2 ^ (Kt + 1)), cc j v *
        torusCharacter (((Q0 * L : ℕ) : ℤ) • v) u‖ ≤ 1 + cutTail z.dim δ Kt) ∧
      (∀ j y, ‖∑ v ∈ frequencyBox z.dim (2 ^ (Kt + 1)), cc j v *
        torusCharacter (((Q0 * L : ℕ) : ℤ) • v)
          (torusMk fun i => z.θ i / (Q0 * L) * (y - xs)) -
        (centerCut z δ (ρ j) y : ℂ)‖ ≤ cutTail z.dim δ Kt) ∧
      ∀ x t : ℝ, (∀ j : Fin 4, x + ((j : ℕ) : ℝ) * t ∈ Set.Icc lo hi) →
      ‖∏ j, f j (x + ((j : ℕ) : ℝ) * t) -
        (Real.fourierChar (∑ j, γ j * (x + ((j : ℕ) : ℝ) * t - xs)) : ℂ) *
          ((∑ v ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)), cm v *
            (torusCharacter ((L : ℤ) • fun a => v (Fin.castAdd z.dim a))
              (torusMk fun i => z.θ i / (Q0 * L) * (x - xs)) *
             torusCharacter ((L : ℤ) • fun a => v (Fin.natAdd z.dim a))
              (torusMk fun i => z.θ i / (Q0 * L) * t))) *
          ∏ j : Fin 4, (∑ p ∈ frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j, (cc j p.1 * c j p.2) *
            torusCharacter (((Q0 * L : ℕ) : ℤ) • p.1 + n j p.2)
              ((torusMk fun i => z.θ i / (Q0 * L) * (x - xs)) +
                (((j : ℕ) : ℤ) - 0) • (torusMk fun i => z.θ i / (Q0 * L) * t))))‖ ≤
        (4 * η + (8 * z.dim * δ'' * profR δ 1 + 4 * (1 + cutTail z.dim δ Kt) ^ 3 *
          cutTail z.dim δ Kt + (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt)) *
          ∏ j, ∑ k ∈ F j, ‖c j k‖ := by
  obtain ⟨cc, cm, hcc, hcm, hsup, hline, hg⟩ :=
    gauge_torus_approx z hd hδ hδ'' ρ hρ hQ0 hQ hCm0 hCm hL Kt xs
  refine ⟨cc, cm, hcc, hcm, hsup, hline, fun x t hxt => ?_⟩
  exact four_inputs_approx z δ ρ (fun i => z.θ i / (Q0 * L)) xs γ F c n f lo hi hη hfa hfb cc cm
    hg x t hxt

/-- The local form only sees the inputs on the cell `[a₀, a₀ + r]` (its kernel support). -/
theorem form_congr_support {κ : LocalKernelClass} {a₀ r : ℝ} (hr : 0 < r) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a₀ r w) {f g : Fin 4 → ℝ → ℂ}
    (hfg : ∀ j, ∀ y ∈ Set.Icc a₀ (a₀ + r), f j y = g j y) :
    localProgressionForm r w f = localProgressionForm r w g := by
  have hm := mul_nonneg κ.margin_pos.le hr.le
  unfold localProgressionForm
  congr 1
  refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
  by_cases hz : w z = 0
  · simp [hz]
  · simp only
    congr 1
    refine Finset.prod_congr rfl fun j _ => hfg j _ ?_
    have := hw.support z hz j
    exact ⟨by linarith [this.1], by linarith [this.2]⟩

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

open Classical in
/-- Blueprint lines 2470-2476 for one role on a cell `[lo, hi]` of its pre-cell: the selected wave
sum `Σ_{m ∈ F} α_m wave_m` satisfies the hypotheses of `four_core_product` with `γ = ω_a(x*)`,
coefficients `c_m = α_m e(φ_m(x*))`, `ξ = θ_z/(Q₀ 6^h)` and relative error `η` bounding the
torus-form error on the cell. -/
theorem role_input_approx (z : ChartTag) (hz : Ms.zc = z) {b : ℤ} {J : ℤ × ℤ}
    (hJ : J.1 ≤ b + S.K) {h : ℕ} (a : Ms.alive (ancAt Gd J (b - 4 * S.K)))
    (F : Finset (Ms.alive (ancAt Gd J (b - 4 * S.K))))
    (hF : F ⊆ (Ms.blockComps S hA b J).E h a) (α : Ms.alive (ancAt Gd J (b - 4 * S.K)) → ℂ)
    {Λ : ℝ} (hΛ : ∀ m ∈ F, |Ms.lamOf m.1| ≤ Λ) {xs : ℝ}
    (hxs : xs ∈ Set.Icc (dyadicGridLeft Gd J.1 J.2)
      (dyadicGridLeft Gd J.1 J.2 + dyadicGridLength Gd J.1)) {lo hi η : ℝ}
    (hη : ∀ y ∈ Set.Icc lo hi, 2 * Real.pi * (Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) *
      (S.Ξ / dyadicGridLength Gd J.1) * |y - xs| + Λ * (y - xs) ^ 2) ≤ η) :
    ∃ ρ' : Fin z.dim → ℝ, (∀ i, ∃ k, ρ' i = Ms.ρ k) ∧
      (∀ y, Ms.gauge y = (centerCut z Ms.δc ρ' y : ℂ) *
        (Real.fourierChar ((Ms.cl : ℝ) * centerPhase z ρ' y) : ℂ)) ∧
      ∃ n : Ms.alive (ancAt Gd J (b - 4 * S.K)) → Fin z.dim → ℤ,
      (∀ m ∈ F, ∀ i, |(n m i : ℝ)| ≤
        Fintype.card (Ms.alive (ancAt Gd J (b - 4 * S.K))) * S.Eh h) ∧
      (∀ y ∈ Set.Icc lo hi, ‖∑ m ∈ F, α m * Ms.wave m.1 y -
          ((centerCut z Ms.δc ρ' y : ℂ) * (Real.fourierChar ((Ms.cl : ℝ) *
            centerPhase z ρ' y) : ℂ)) * ((Real.fourierChar (Ms.slope a.1 xs * (y - xs)) : ℂ) *
            ∑ m ∈ F, (α m * (Real.fourierChar (Ms.phase m.1 xs) : ℂ)) *
              torusCharacter (n m) (torusMk fun i => z.θ i / (S.Q0 * 6 ^ h) * (y - xs)))‖ ≤
          η * ∑ m ∈ F, ‖α m * (Real.fourierChar (Ms.phase m.1 xs) : ℂ)‖) ∧
      (∀ y, ‖∑ m ∈ F, α m * Ms.wave m.1 y‖ ≤
        ∑ m ∈ F, ‖α m * (Real.fourierChar (Ms.phase m.1 xs) : ℂ)‖) := by
  obtain ⟨ρ', hρ', hgauge, n, hn, hform⟩ := Ms.group_torus_char' S hA z hz hJ a F hF α hΛ
  have hnorm : ∀ m, ‖α m * (Real.fourierChar (Ms.phase m.1 xs) : ℂ)‖ = ‖α m‖ := fun m => by
    rw [norm_mul, Circle.norm_coe, mul_one]
  refine ⟨ρ', hρ', hgauge, n, hn, fun y hy => ?_, fun y => ?_⟩
  · refine (hform xs hxs y).trans ?_
    simp_rw [hnorm]
    exact mul_le_mul_of_nonneg_right (hη y hy) (Finset.sum_nonneg fun _ _ => norm_nonneg _)
  · simp_rw [hnorm]
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun m _ => ?_)
    rw [norm_mul]
    exact mul_le_of_le_one_right (norm_nonneg _) (Ms.wave_norm_le m.1 y)

end ModeSystem

