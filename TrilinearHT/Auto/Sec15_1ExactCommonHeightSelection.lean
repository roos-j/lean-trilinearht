open Classical in
/-- The truncated multiplier is bounded by the number of its frequencies (blueprint line 2476:
absolute Fourier costs are fixed powers of `D_*`). -/
theorem truncMult_le_card {d : ℕ} (B L : ℕ) (cm : (Fin (d + d) → ℤ) → ℂ) (hcm : ∀ v, ‖cm v‖ ≤ 1)
    (u v : StandardTorus d) :
    ‖∑ q ∈ frequencyBox (d + d) B, cm q *
      (torusCharacter ((L : ℤ) • fun a => q (Fin.castAdd d a)) u *
        torusCharacter ((L : ℤ) • fun a => q (Fin.natAdd d a)) v)‖ ≤
      (frequencyBox (d + d) B).card := by
  refine (norm_sum_le _ _).trans ?_
  have h1 : ∀ q, ‖cm q * (torusCharacter ((L : ℤ) • fun a => q (Fin.castAdd d a)) u *
      torusCharacter ((L : ℤ) • fun a => q (Fin.natAdd d a)) v)‖ ≤ 1 := by
    intro q
    rw [norm_mul, norm_mul]
    simp only [torusCharacter, fourier_apply, Circle.norm_coe, mul_one]
    exact hcm q
  calc ∑ q ∈ frequencyBox (d + d) B, _ ≤ ∑ _q ∈ frequencyBox (d + d) B, (1 : ℝ) :=
        Finset.sum_le_sum fun q _ => h1 q
    _ = _ := by rw [Finset.sum_const, nsmul_eq_mul, mul_one]

open Classical in
/-- Blueprint lines 2478-2480 and 2537-2542 (three cores, side role `l`): on the cell, the product
of the three core inputs and the side gauge `G_l(y_l)` is within `(4η + E_g) Π_{j ≠ l} Σ|c_j|` of
the re-anchored phase sum `Σ_x C_x e(A_x (y_l - x*) + (B_x - l A_x) t)` of
`R(u, v) Π_j g_j(u + j v)` (`four_core_product` with the side slot's input equal to its gauge,
a single coefficient one at frequency zero). -/
theorem three_core_Fc_approx (z : ChartTag) (hd : 1 ≤ z.dim) {δ δ'' : ℝ} (hδ : 0 < δ)
    (hδ'' : 0 < δ'') (ρ : Fin 4 → Fin z.dim → ℝ) (hρ : ∀ j a, ρ j a ∈ Set.Icc (0 : ℝ) 1)
    {Q0 : ℕ} (hQ0 : 0 < Q0) (hQ : ∀ a b, ∃ k : ℤ, (Q0 : ℝ) * (z.C a b : ℝ) = k) {Cm : ℝ}
    (hCm0 : 0 ≤ Cm) (hCm : ∀ a b, |(z.C a b : ℝ)| ≤ Cm) {L : ℕ} (hL : 0 < L) (Kt : ℕ)
    (xs : ℝ) (l : Fin 4) (γ : Fin 4 → ℝ) (hγl : γ l = 0) {ι : Fin 4 → Type*}
    (F : ∀ j, Finset (ι j)) (c : ∀ j, ι j → ℂ) (n : ∀ j, ι j → Fin z.dim → ℤ) {k₀ : ι l}
    (hFl : F l = {k₀}) (hcl : c l k₀ = 1) (hnl : n l k₀ = 0) (f : Fin 4 → ℝ → ℂ)
    (hfl : ∀ y, f l y = (centerCut z δ (ρ l) y : ℂ) *
      (Real.fourierChar (((slotCoeff l : ℤ) : ℝ) * centerPhase z (ρ l) y) : ℂ))
    (lo hi : ℝ) {η : ℝ} (hη : 0 ≤ η)
    (hfa : ∀ j, j ≠ l → ∀ y ∈ Set.Icc lo hi, ‖f j y - ((centerCut z δ (ρ j) y : ℂ) *
      (Real.fourierChar (((slotCoeff j : ℤ) : ℝ) * centerPhase z (ρ j) y) : ℂ)) *
        ((Real.fourierChar (γ j * (y - xs)) : ℂ) * ∑ k ∈ F j, c j k *
          torusCharacter (n j k) (torusMk fun i => z.θ i / (Q0 * L) * (y - xs)))‖ ≤
            η * ∑ k ∈ F j, ‖c j k‖)
    (hfb : ∀ j, j ≠ l → ∀ y ∈ Set.Icc lo hi, ‖f j y‖ ≤ ∑ k ∈ F j, ‖c j k‖) :
    ∃ cc : Fin 4 → (Fin z.dim → ℤ) → ℂ, ∃ cm : (Fin (z.dim + z.dim) → ℤ) → ℂ,
      (∀ j v, ‖cc j v‖ ≤ 1) ∧ (∀ v, ‖cm v‖ ≤ 1) ∧
      (∀ j u, ‖∑ v ∈ frequencyBox z.dim (2 ^ (Kt + 1)), cc j v *
        torusCharacter (((Q0 * L : ℕ) : ℤ) • v) u‖ ≤ 1 + cutTail z.dim δ Kt) ∧
      (∀ j y, ‖∑ v ∈ frequencyBox z.dim (2 ^ (Kt + 1)), cc j v *
        torusCharacter (((Q0 * L : ℕ) : ℤ) • v)
          (torusMk fun i => z.θ i / (Q0 * L) * (y - xs)) -
        (centerCut z δ (ρ j) y : ℂ)‖ ≤ cutTail z.dim δ Kt) ∧
      ∀ x t : ℝ, (∀ j : Fin 4, x + ((j : ℕ) : ℝ) * t ∈ Set.Icc lo hi) →
      ‖∏ j, f j (x + ((j : ℕ) : ℝ) * t) -
        (Real.fourierChar (∑ j, γ j * (x + ((j : ℕ) : ℝ) * t - xs)) : ℂ) *
          ((∑ v ∈ frequencyBox (z.dim + z.dim) (2 ^ (Kt + 1)), cm v *
            (torusCharacter ((L : ℤ) • fun a => v (Fin.castAdd z.dim a))
              (torusMk fun i => z.θ i / (Q0 * L) * (x - xs)) *
             torusCharacter ((L : ℤ) • fun a => v (Fin.natAdd z.dim a))
              (torusMk fun i => z.θ i / (Q0 * L) * t))) *
          ∏ j : Fin 4, (∑ p ∈ frequencyBox z.dim (2 ^ (Kt + 1)) ×ˢ F j, (cc j p.1 * c j p.2) *
            torusCharacter (((Q0 * L : ℕ) : ℤ) • p.1 + n j p.2)
              ((torusMk fun i => z.θ i / (Q0 * L) * (x - xs)) +
                (((j : ℕ) : ℤ) - 0) • (torusMk fun i => z.θ i / (Q0 * L) * t))))‖ ≤
        (4 * η + (8 * z.dim * δ'' * profR δ 1 + 4 * (1 + cutTail z.dim δ Kt) ^ 3 *
          cutTail z.dim δ Kt + (1 + cutTail z.dim δ Kt) ^ 4 * multTail z.dim δ'' Q0 Cm Kt)) *
          ∏ j, ∑ k ∈ F j, ‖c j k‖ := by
  have hzero : ∀ y, torusCharacter (n l k₀) (torusMk fun i => z.θ i / (Q0 * L) * (y - xs)) =
      1 := fun y => by rw [hnl, torusCharacter_zero]
  refine four_core_product z hd hδ hδ'' ρ hρ hQ0 hQ hCm0 hCm hL Kt xs γ F c n f lo hi hη
    (fun j y hy => ?_) (fun j y hy => ?_)
  · by_cases hj : j = l
    · subst hj
      rw [hFl, Finset.sum_singleton, Finset.sum_singleton, hcl, hzero, hγl, hfl y]
      simpa using hη
    · exact hfa j hj y hy
  · by_cases hj : j = l
    · subst hj
      rw [hFl, Finset.sum_singleton, hcl, norm_one, hfl y, norm_mul, Circle.norm_coe, mul_one,
        Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (centerCut_mem _ _ _ _).1]
      exact (centerCut_mem _ _ _ _).2
    · exact hfb j hj y hy

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc)

open Classical in
/-- The alive modes at a cell `U` all contain its left endpoint, so their number is at most any
bound on the modes whose first-match cell contains a point (blueprint line 2468, "a PRE path to
the representative has at most `D_*` edges"). -/
theorem card_alive_le (U : ℤ × ℤ) {Bc : ℝ}
    (hcount : ∀ y, ((Finset.univ.filter fun m =>
      y ∈ dyadicGridCell Gd (Ms.cellOf m).1 (Ms.cellOf m).2).card : ℝ) ≤ Bc) :
    (Fintype.card (Ms.alive U) : ℝ) ≤ Bc := by
  refine le_trans ?_ (hcount (dyadicGridLeft Gd U.1 U.2))
  rw [Fintype.card_coe]
  refine Nat.cast_le.mpr (Finset.card_le_card fun m hm => ?_)
  exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
    (Ms.mem_alive.mp hm) (dyadicGridCell_left_mem Gd U.1 U.2)⟩

/-- Blueprint line 2469 ("each selected mode was admitted by `u_b` and had curvature at most `D_*`
at its admission scale"): an alive mode at `U` has `|λ_m| ≤ Λ / |U|²`. -/
theorem lam_le_of_alive {U : ℤ × ℤ} (m : Ms.alive U) :
    |Ms.lamOf m.1| ≤ Ms.Λ / dyadicGridLength Gd U.1 ^ 2 := by
  have hsub := Ms.mem_alive.mp m.2
  have hlen := dyadicGridLength_le_of_subset Gd hsub
  have hU := dyadicGridLength_pos Gd U.1
  rw [le_div_iff₀ (by positivity)]
  calc |Ms.lamOf m.1| * dyadicGridLength Gd U.1 ^ 2 ≤
      |Ms.lamOf m.1| * dyadicGridLength Gd (Ms.cellOf m.1).1 ^ 2 :=
        mul_le_mul_of_nonneg_left (pow_le_pow_left₀ hU.le hlen 2) (abs_nonneg _)
    _ ≤ Ms.Λ := Ms.lam_le m.1

end ModeSystem

/-- Two points of a dyadic cell are at distance at most its length. -/
theorem abs_sub_le_of_mem_cell {G : RealDyadicGrid} {I : ℤ × ℤ} {x y : ℝ}
    (hx : x ∈ Set.Icc (dyadicGridLeft G I.1 I.2)
      (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1))
    (hy : y ∈ Set.Icc (dyadicGridLeft G I.1 I.2)
      (dyadicGridLeft G I.1 I.2 + dyadicGridLength G I.1)) :
    |y - x| ≤ dyadicGridLength G I.1 := by
  rw [abs_le]; constructor <;> linarith [hx.1, hx.2, hy.1, hy.2]

/-- Lengths along a chain of depths: `|I| = |d| 2^{-(I.1 - d)}` for `d ≤ I.1`. -/
theorem dyadicGridLength_of_le (G : RealDyadicGrid) {d s : ℤ} (h : d ≤ s) :
    dyadicGridLength G s = dyadicGridLength G d * (2 : ℝ)⁻¹ ^ (s - d).toNat := by
  rw [← dyadicGridLength_add_nat]
  congr 1
  omega

