variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

namespace LeafSplit
variable {ap} (D : ap.LeafSplit)

/-- The physical part of the error of the leaf split has energy at most that of the physical
lift error of the decision-cell output on the cell. -/
theorem err_phys_norm_sq_le (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ZU : ColumnL2 (Fin ap.Mc)) :
    ‖physEmbed (Fin ap.Mc) (Fin ap.Mc) (D.err l G I ZU)‖ ^ 2 ≤
      ∫ y in dyadicGridCell A.G I.1 I.2, ‖(ZU : ℝ → ColumnHilbert (Fin ap.Mc)) y none -
        ((D.Ms l G).L.op ZU : ℝ → ColumnHilbert (D.Ms l G).Md) y none‖ ^ 2 := by
  classical
  unfold err
  split_ifs with h
  · rw [map_zero, norm_zero]
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow]
    exact setIntegral_nonneg (dyadicGridCell_measurable _ _ _) fun _ _ => sq_nonneg _
  · unfold lifted
    simp only [map_sub, physEmbed_restrict, physEmbed_physEmbed]
    rw [← map_sub, norm_sq_restrict_physEmbed_sub]

end LeafSplit

