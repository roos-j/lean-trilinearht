namespace LeafSplit
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

/-- The physical subtotal on a cell `I` of a core component `K` of slot `l` and group `G` on the
pre-cell `J`. -/
noncomputable def compSub (l : Fin 4) (G : A.Grp) (I J : ℤ × ℤ) (K : Finset (D.Ms l G).Md) :
    ColumnL2 (Fin ap.Mc) :=
  π (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
    (physEmbed (D.Ms l G).Md (Fin ap.Mc)
      (∑ m ∈ K, D.c l G (D.blockOf I.1) J m • (D.Ms l G).cellMode J m)))

open Classical in
/-- Blueprint lines 2463-2467 on a cell with a decision cell: given, for each group and each core
slot of a pattern, a pre-cell of the block containing the cell with the exact frozen synthesis of
the decision-cell output, the pattern form of the leaf is the sum over the groups and the tuples of
core components of the forms of their component subtotals, with the sides and errors in the other
slots. -/
theorem patF_comp_expand (gs : Finset A.Grp) (I : ℤ × ℤ)
    (Zout ZU : Fin 4 → A.Grp → ColumnL2 (Fin ap.Mc)) (σ : Fin 4 → Fin 3)
    (Jp : Fin 4 → A.Grp → ℤ × ℤ)
    (hreg : ∀ l, σ l = 0 → ¬ (D.usl l ∨ ¬ D.hasDecision I))
    (hJ : ∀ l, σ l = 0 → ∀ G ∈ gs, Jp l G ∈ D.cells l G (D.blockOf I.1))
    (hdis : ∀ l, σ l = 0 → ∀ G ∈ gs,
      Set.PairwiseDisjoint (D.cells l G (D.blockOf I.1) : Set (ℤ × ℤ))
        fun J => dyadicGridCell A.G J.1 J.2)
    (hIJ : ∀ l, σ l = 0 → ∀ G ∈ gs,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G (Jp l G).1 (Jp l G).2)
    (hfz : ∀ l, σ l = 0 → ∀ G ∈ gs, columnL2Restriction (dyadicGridCell A.G (Jp l G).1 (Jp l G).2)
      (dyadicGridCell_measurable A.G (Jp l G).1 (Jp l G).2) ((D.Ms l G).L.op (ZU l G)) =
        (D.Ms l G).frozenEval D.S (D.blockOf I.1) (Jp l G) (D.c l G (D.blockOf I.1) (Jp l G))) :
    D.patF gs I Zout ZU σ = ∑ G ∈ gs, ∑ r ∈ Fintype.piFinset (compIdx σ
        (fun l => (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (Jp l G))),
      ap.Λc I (compSlot σ (fun l K => D.compSub l G I (Jp l G) K)
        (fun l => π (D.side l G I (Zout l G) (ZU l G))) (fun l => π (D.err l G I (ZU l G))) r) := by
  rw [D.patF_phys]
  refine Finset.sum_congr rfl fun G hG => ?_
  refine pattern_comp_expand (ap.Λc I) σ _ _ _ _ _ fun l hl => ?_
  rw [D.core_eq_comps l G I (ZU l G) (hreg l hl) (hJ l hl G hG) (hdis l hl G hG)
    (hIJ l hl G hG) (hfz l hl G hG)]
  unfold compSub
  simp only [map_sum]

end LeafSplit

