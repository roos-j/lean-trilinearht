namespace LeafSplit
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

open Classical in
/-- Blueprint lines 2461-2467 and 2845-2848 at a regular leaf cell: the form of the patterns with
at least three cores and no error is at most the sum over the groups of the bounds of the four-core
component expansion and of the three-core expansions with side slot `l` (`core_leaf_le`,
`core_pattern_cases`). -/
theorem core_leaf_split (hK1 : 1 ≤ D.S.K) (gs : Finset A.Grp) (I : ℤ × ℤ)
    (Zout ZU : Fin 4 → A.Grp → ColumnL2 (Fin ap.Mc))
    (hreg : ∀ l, ¬ (D.usl l ∨ ¬ D.hasDecision I))
    (hJ : ∀ l, ∀ G ∈ gs, D.preCell I ∈ D.cells l G (D.blockOf I.1))
    (hdis : ∀ l, ∀ G ∈ gs, Set.PairwiseDisjoint (D.cells l G (D.blockOf I.1) : Set (ℤ × ℤ))
      fun J => dyadicGridCell A.G J.1 J.2)
    (hfz : ∀ l, ∀ G ∈ gs, columnL2Restriction (dyadicGridCell A.G (D.preCell I).1
      (D.preCell I).2) (dyadicGridCell_measurable A.G (D.preCell I).1 (D.preCell I).2)
        ((D.Ms l G).L.op (ZU l G)) =
        (D.Ms l G).frozenEval D.S (D.blockOf I.1) (D.preCell I)
          (D.c l G (D.blockOf I.1) (D.preCell I)))
    (F4 : A.Grp → ℝ) (F3 : Fin 4 → A.Grp → ℝ)
    (h4 : ∀ G ∈ gs, ‖∑ r ∈ Fintype.piFinset (compIdx (fun _ => 0)
          (fun l => (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I))),
        ap.Λc I (compSlot (fun _ => 0) (fun l K => D.compSub l G I (D.preCell I) K)
          (fun l => π (D.side l G I (Zout l G) (ZU l G))) (fun l => π (D.err l G I (ZU l G)))
            r)‖ ≤ F4 G)
    (h3 : ∀ l, ∀ G ∈ gs, ‖∑ r ∈ Fintype.piFinset (compIdx (fun k => if k = l then 1 else 0)
          (fun j => (D.Ms j G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I))),
        ap.Λc I (compSlot (fun k => if k = l then 1 else 0)
          (fun j K => D.compSub j G I (D.preCell I) K)
          (fun j => π (D.side j G I (Zout j G) (ZU j G))) (fun j => π (D.err j G I (ZU j G)))
            r)‖ ≤ F3 l G) :
    ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        3 ≤ patternCount σ 0), D.patF gs I Zout ZU σ‖ ≤
      ∑ G ∈ gs, F4 G + ∑ l, ∑ G ∈ gs, F3 l G := by
  have hF4 : ∀ G ∈ gs, 0 ≤ F4 G := fun G hG => (norm_nonneg _).trans (h4 G hG)
  have hF3 : ∀ l, ∀ G ∈ gs, 0 ≤ F3 l G := fun l G hG => (norm_nonneg _).trans (h3 l G hG)
  set σ3 : Fin 4 → Fin 4 → Fin 3 := fun l k => if k = l then 1 else 0 with hσ3
  have hσ3inj : ∀ l l', σ3 l = σ3 l' → l = l' := by
    simp only [hσ3]; decide
  have hσ3ne : ∀ l, σ3 l ≠ fun _ => 0 := by
    simp only [hσ3]; decide
  set F : (Fin 4 → Fin 3) → A.Grp → ℝ := fun σ G =>
    (if σ = (fun _ => 0) then F4 G else 0) + ∑ l, (if σ = σ3 l then F3 l G else 0) with hF
  refine (D.core_leaf_le hK1 gs I Zout ZU hreg hJ hdis hfz F fun σ h2 h3' G hG => ?_).trans ?_
  · rcases core_pattern_cases σ h2 h3' with rfl | ⟨l, rfl⟩
    · have e : F (fun _ => 0) G = F4 G := by
        simp only [hF, ↓reduceIte, add_eq_left]
        exact Finset.sum_eq_zero fun l _ => ite_eq_right_iff.mpr fun h => absurd h.symm (hσ3ne l)
      rw [e]; exact h4 G hG
    · have e : F (σ3 l) G = F3 l G := by
        simp only [hF, ite_eq_right_iff.mpr fun h => absurd h (hσ3ne l), zero_add]
        rw [Finset.sum_eq_single l (fun l' _ hl' => ite_eq_right_iff.mpr fun h =>
          absurd (hσ3inj l l' h).symm hl') (by simp), ite_eq_left_of_eq_true _ _ (eq_true rfl)]
      rw [e]; exact h3 l G hG
  · have hFG : ∀ G ∈ gs, ∀ σ, 0 ≤ F σ G := fun G hG σ => by
      simp only [hF]
      refine add_nonneg ?_ (Finset.sum_nonneg fun l _ => ?_)
      · split_ifs; exacts [hF4 G hG, le_rfl]
      · split_ifs; exacts [hF3 l G hG, le_rfl]
    have hσsum : ∀ G, ∑ σ, F σ G = F4 G + ∑ l, F3 l G := fun G => by
      simp only [hF, Finset.sum_add_distrib, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
      rw [Finset.sum_comm]
      simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    calc ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
          3 ≤ patternCount σ 0), ∑ G ∈ gs, F σ G
        ≤ ∑ σ, ∑ G ∈ gs, F σ G := Finset.sum_le_sum_of_subset_of_nonneg
          (Finset.subset_univ _) fun σ _ _ => Finset.sum_nonneg fun G hG => hFG G hG σ
      _ = ∑ G ∈ gs, (F4 G + ∑ l, F3 l G) := by
          rw [Finset.sum_comm]
          exact Finset.sum_congr rfl fun G _ => hσsum G
      _ = ∑ G ∈ gs, F4 G + ∑ l, ∑ G ∈ gs, F3 l G := by
          rw [Finset.sum_add_distrib, Finset.sum_comm]

end LeafSplit

