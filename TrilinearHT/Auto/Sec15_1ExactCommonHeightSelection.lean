variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

open Classical in
/-- Blueprint lines 2463-2467 and 2845-2848 for the core patterns of a leaf at a regular cell `I`
(decision cell, no basic `U` slot): if the pre-cell of `I` is one of the disjoint pre-cells of its
block with the exact frozen synthesis of the decision-cell outputs, then the form of the patterns
with at least three cores and no error is at most the sum over these patterns and the groups of
any bounds `F σ G` of their component expansions on the pre-cell (`patF_comp_expand`). -/
theorem core_leaf_le (hK1 : 1 ≤ D.S.K) (gs : Finset A.Grp) (I : ℤ × ℤ)
    (Zout ZU : Fin 4 → A.Grp → ColumnL2 (Fin ap.Mc))
    (hreg : ∀ l, ¬ (D.usl l ∨ ¬ D.hasDecision I))
    (hJ : ∀ l, ∀ G ∈ gs, D.preCell I ∈ D.cells l G (D.blockOf I.1))
    (hdis : ∀ l, ∀ G ∈ gs, Set.PairwiseDisjoint (D.cells l G (D.blockOf I.1) : Set (ℤ × ℤ))
      fun J => dyadicGridCell A.G J.1 J.2)
    (hfz : ∀ l, ∀ G ∈ gs, columnL2Restriction (dyadicGridCell A.G (D.preCell I).1
      (D.preCell I).2) (dyadicGridCell_measurable A.G (D.preCell I).1 (D.preCell I).2)
        ((D.Ms l G).L.op (ZU l G)) =
        (D.Ms l G).frozenEval D.S (D.blockOf I.1) (D.preCell I)
          (D.c l G (D.blockOf I.1) (D.preCell I)))
    (F : (Fin 4 → Fin 3) → A.Grp → ℝ)
    (hF : ∀ σ : Fin 4 → Fin 3, (∀ l, σ l ≠ 2) → 3 ≤ patternCount σ 0 → ∀ G ∈ gs,
      ‖∑ r ∈ Fintype.piFinset (compIdx σ
          (fun l => (D.Ms l G).coreComps D.S D.hA D.SP (D.blockOf I.1) (D.preCell I))),
        ap.Λc I (compSlot σ (fun l K => D.compSub l G I (D.preCell I) K)
          (fun l => π (D.side l G I (Zout l G) (ZU l G))) (fun l => π (D.err l G I (ZU l G)))
            r)‖ ≤ F σ G) :
    ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        3 ≤ patternCount σ 0), D.patF gs I Zout ZU σ‖ ≤
      ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        3 ≤ patternCount σ 0), ∑ G ∈ gs, F σ G := by
  obtain ⟨hb, -⟩ := D.blockOf_bounds hK1 I.1
  have hIJ : dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G (D.preCell I).1 (D.preCell I).2 :=
    subset_ancAt A.G I (show D.blockOf I.1 - 2 * D.S.K ≤ I.1 by omega)
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun σ hσ => ?_)
  obtain ⟨h2, h3⟩ := (Finset.mem_filter.mp hσ).2
  rw [D.patF_comp_expand gs I Zout ZU σ (fun _ _ => D.preCell I) (fun l _ => hreg l)
    (fun l _ G hG => hJ l G hG) (fun l _ G hG => hdis l G hG) (fun _ _ _ _ => hIJ)
    (fun l _ G hG => hfz l G hG)]
  exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun G hG => hF σ h2 h3 G hG)

end LeafSplit

