/-- Blueprint lines 2461-2462: a pattern without physical errors and with at least three cores is
the four-core pattern or has exactly one side slot `l`. -/
theorem core_pattern_cases :
    ∀ σ : Fin 4 → Fin 3, (∀ l, σ l ≠ 2) → 3 ≤ patternCount σ 0 →
      σ = (fun _ => 0) ∨ ∃ l, σ = fun k => if k = l then 1 else 0 := by
  unfold patternCount
  decide

