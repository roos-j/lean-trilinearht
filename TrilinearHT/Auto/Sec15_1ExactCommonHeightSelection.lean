theorem sum_compSub (l : Fin 4) (G : A.Grp) (I J : ℤ × ℤ) {ι : Type*} (s : Finset ι)
    (K : ι → Finset (D.Ms l G).Md)
    (hdis : Set.PairwiseDisjoint (s : Set ι) K) :
    ∑ i ∈ s, D.compSub l G I J (K i) = D.compSub l G I J (s.biUnion K) := by
