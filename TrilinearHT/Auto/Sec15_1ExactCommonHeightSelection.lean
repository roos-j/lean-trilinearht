    (hstab : D.Stab) (I : ℤ × ℤ) (G : bf.Grp) (σ : Fin 4 → Fin 3) (hJ : 2 ≤ D.SP.Jst)
    (hδ : 0 < D.SP.δs) (hδ16 : D.SP.δs ≤ 1 / 16) (hδJ : ⌈4 * D.SP.δs * D.SP.Jst⌉₊ ≤ D.SP.Jst)
    (hQ : 1 ≤ D.S.Q0) (hD : 2 ≤ D.S.Dstar)
    (hcard : ∀ l, (((D.Ms l G).alive (ancAt A.G (D.preAt I)
      (A.blkStart D.S.K I.1 - 4 * D.S.K))).card : ℝ) ≤ D.S.Dstar)
    (hΛ : ∀ l, (D.Ms l G).Λ ≤ D.S.Dstar) (hK : D.S.Dstar ^ 600 ≤ (2 : ℝ) ^ D.S.K) :
    (fp.Λc I (patternPiece (fun l => D.coreAt l G I) (fun l => D.toLeaf.sv l G I)
        (fun l => D.errAt L l G I) σ) =
      ∑ r ∈ Fintype.piFinset (compIdx σ (fun l => D.compsAt l G I)),
        fp.Λc I (compSlot σ (fun l K => D.compSub l G I K) (fun l => D.toLeaf.sv l G I)
          (fun l => D.errAt L l G I) r) ∧
    HasSum (fun n : ℕ => ∑ a : Fin n → Fin 4,
      ∑ w ∈ Fintype.piFinset (fun _ : Fin n => ModeComponents.upperHeights D.SP.Jst D.SP.δs),
      ∑ h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs,
        (((ModeComponents.upperHeights D.SP.Jst D.SP.δs).card : ℝ) ^ (n + 1))⁻¹ •
        ∑ r ∈ (Fintype.piFinset (compIdx σ (fun l => D.compsAt l G I))).filter
          (fun r => ∀ l, roleMask (D.slotGood G I l) l a w h (r l)),
          fp.Λc I (compSlot σ (fun l K => D.compSub l G I K) (fun l => D.toLeaf.sv l G I)
            (fun l => D.errAt L l G I) r))
      (fp.Λc I (patternPiece (fun l => D.coreAt l G I) (fun l => D.toLeaf.sv l G I)
        (fun l => D.errAt L l G I) σ))) ∧
    (∀ r ∈ Fintype.piFinset (compIdx σ (fun l => D.compsAt l G I)),
      ((ModeComponents.upperHeights D.SP.Jst D.SP.δs).filter
        fun h => ∀ l, D.slotGood G I l h (r l)).Nonempty) ∧
    (∀ l {K K' : Finset (D.Ms l G).Md},
      K ∈ (D.Ms l G).coreComps D.S D.hA D.SP (A.blkStart D.S.K I.1) (D.preAt I) →
      K' ∈ (D.Ms l G).coreComps D.S D.hA D.SP (A.blkStart D.S.K I.1) (D.preAt I) →
      (D.Ms l G).compClass D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I) 0 K =
        (D.Ms l G).compClass D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I) 0 K' →
      ∀ {n : ℕ} (a : Fin n → Fin 4) {w : Fin n → ℕ},
      (∀ i, w i ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs) → ∀ {h : ℕ},
      h ∈ ModeComponents.upperHeights D.SP.Jst D.SP.δs →
      (roleMask (D.slotGood G I l) l a w h (some K) ↔
        roleMask (D.slotGood G I l) l a w h (some K')) ∧
      D.coreCls G I h l (some K) = D.coreCls G I h l (some K')) ∧
    (∀ l {h : ℕ}, h ≤ D.SP.Jst → ∀ (Ks : Finset (Finset (D.Ms l G).Md)),
      (∀ K ∈ Ks, (D.Ms l G).compGood D.S D.hA D.SP (A.blkStart D.S.K I.1) (D.preAt I) h K) →
      ∀ {m a : (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K))},
      ((D.Ms l G).blockComps D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I)).Good D.SP.Δ
        ((D.Ms l G).goodP D.S D.SP (A.blkStart D.S.K I.1)) h m →
      (∀ K ∈ Ks, (((D.Ms l G).blockComps D.S D.hA (A.blkStart D.S.K I.1)
        (D.preAt I)).F h m).map ⟨Subtype.val, Subtype.val_injective⟩ =
          (D.Ms l G).compClass D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I) h K) →
      a ∈ ((D.Ms l G).blockComps D.S D.hA (A.blkStart D.S.K I.1) (D.preAt I)).E
        (h - D.SP.Δ) m →
      ∀ (Fsel : Finset ((D.Ms l G).alive (ancAt A.G (D.preAt I)
        (A.blkStart D.S.K I.1 - 4 * D.S.K)))), (∀ x ∈ Fsel, ∃ K ∈ Ks, x.1 ∈ K) →
      ∀ {xs : ℝ}, xs ∈ dyadicGridCell A.G I.1 I.2 →
      ∃ n : (D.Ms l G).alive (ancAt A.G (D.preAt I) (A.blkStart D.S.K I.1 - 4 * D.S.K)) →
          Fin (D.Ms l G).zc.dim → ℤ,
        (∀ x ∈ Fsel, ∀ i, |(n x i : ℝ)| ≤ D.S.Dstar ^ 5 * D.S.Eh (h - D.SP.Δ)) ∧
        ∀ y ∈ dyadicGridCell A.G I.1 I.2,
          ‖∑ x ∈ Fsel, D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1 * (D.Ms l G).wave x.1 y -
            (Real.fourierChar (((D.Ms l G).cl : ℝ) *
              centerPhase (D.Ms l G).zc (D.Ms l G).ρ y) : ℂ) *
              (Real.fourierChar ((D.Ms l G).slope a.1 xs * (y - xs)) : ℂ) *
              (D.Ms l G).torusG D.S (h - D.SP.Δ) xs Fsel
                (fun x => D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1) n
                (fun i => (D.Ms l G).torusξ D.S (h - D.SP.Δ) i * (y - xs))‖ ≤
            (D.S.Dstar ^ 150)⁻¹ *
              ∑ x ∈ Fsel, ‖D.c l G (A.blkStart D.S.K I.1) (D.preAt I) x.1‖) := by
  obtain ⟨h1, h2⟩ := D.pattern_first_success L I G σ hJ hδ hδ16
  refine ⟨⟨h1, h2⟩, D.tuple_success G I σ hJ hδ hδ16,
    fun l K K' hK hK' hcls n a w hw h hh =>
      D.roleMask_iff_of_same_unit hstab G I l hJ hδ hδJ hK hK' hcls a hw hh,
    fun l h hh Ks hKs m a hm hcls ha Fsel hFsel xs hxs => ?_⟩
  obtain ⟨n, hn, hform⟩ := D.core_torus_form hstab G I l hh hQ hD (hcard l) (hΛ l) hK Ks hKs hm
    hcls ha Fsel hFsel hxs
  have hE : 0 ≤ D.S.Eh (h - D.SP.Δ) := by
    unfold ModeSchedule.Eh
    exact pow_nonneg (le_trans (by norm_num) D.hA) _
