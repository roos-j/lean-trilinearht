section CompExpand
variable {V : Type*} [AddCommGroup V] [Module ℂ V]

open Classical in
/-- The slot values of a component tuple: the selected component subtotal in a core slot, the
pattern piece otherwise. -/
noncomputable def compSlot (σ : Fin 4 → Fin 3) {κ : Fin 4 → Type*} (sub : ∀ l, κ l → V)
    (s e : Fin 4 → V) (r : ∀ l, Option (κ l)) (l : Fin 4) : V :=
  if σ l = 0 then (match r l with | some K => sub l K | none => 0) else ![0, s l, e l] (σ l)

open Classical in
/-- The index sets of the component tuples: the components of a core slot, a single dummy
otherwise. -/
noncomputable def compIdx (σ : Fin 4 → Fin 3) {κ : Fin 4 → Type*} (Ks : ∀ l, Finset (κ l))
    (l : Fin 4) : Finset (Option (κ l)) :=
  if σ l = 0 then (Ks l).map Function.Embedding.some else {none}

open Classical in
/-- Blueprint lines 2463-2467 (the finite multilinear expansion of the core slots): if each core
slot of a pattern is the sum of its component subtotals, the pattern form is the sum over the
component tuples of the forms of the tuple values. -/
theorem pattern_comp_expand (Λ : MultilinearMap ℂ (fun _ : Fin 4 => V) ℂ) (σ : Fin 4 → Fin 3)
    {κ : Fin 4 → Type*} (Ks : ∀ l, Finset (κ l)) (sub : ∀ l, κ l → V) (a s e : Fin 4 → V)
    (ha : ∀ l, σ l = 0 → a l = ∑ K ∈ Ks l, sub l K) :
    Λ (patternPiece a s e σ) =
      ∑ r ∈ Fintype.piFinset (compIdx σ Ks), Λ (compSlot σ sub s e r) := by
  have h : patternPiece a s e σ = fun l => ∑ j ∈ compIdx σ Ks l,
      (if σ l = 0 then (match j with | some K => sub l K | none => 0) else
        ![0, s l, e l] (σ l)) := by
    funext l
    unfold patternPiece compIdx
    by_cases hl : σ l = 0
    · simp only [hl, ↓reduceIte, Finset.sum_map, Function.Embedding.some_apply]
      rw [ha l hl]
      simp
    · simp only [hl, ↓reduceIte, Finset.sum_singleton]
      have : σ l = 1 ∨ σ l = 2 := by omega
      rcases this with h1 | h2 <;> simp [*]
  rw [h, MultilinearMap.map_sum_finset]
  rfl

end CompExpand

