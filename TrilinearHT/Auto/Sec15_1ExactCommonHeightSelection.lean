namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

open Classical in
/-- The final CURRENT class at height `h` of a component `K` of the block `b` on the pre-cell `J`
(blueprint line 2467, "group the selected modes at the final successful components"): the union of
the CURRENT components `F_h(x)` of the modes `x` whose minimal component is `K`. -/
noncomputable def compClass (b : ℤ) (J : ℤ × ℤ) (h : ℕ) (K : Finset Ms.Md) : Finset Ms.Md :=
  (Finset.univ.filter fun x : Ms.alive (ancAt Gd J (b - 4 * S.K)) =>
    ((Ms.blockComps S hA b J).E 0 x).map ⟨Subtype.val, Subtype.val_injective⟩ = K).biUnion
    fun x => ((Ms.blockComps S hA b J).F h x).map ⟨Subtype.val, Subtype.val_injective⟩

open Classical in
/-- The final class of the minimal component of `x` is the CURRENT component of `x`. -/
theorem compClass_eq (b : ℤ) (J : ℤ × ℤ) (h : ℕ) (x : Ms.alive (ancAt Gd J (b - 4 * S.K))) :
    Ms.compClass S hA b J h (((Ms.blockComps S hA b J).E 0 x).map
      ⟨Subtype.val, Subtype.val_injective⟩) =
      ((Ms.blockComps S hA b J).F h x).map ⟨Subtype.val, Subtype.val_injective⟩ := by
  set C := Ms.blockComps S hA b J
  ext m
  simp only [compClass, Finset.mem_biUnion, Finset.mem_filter, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨x', hx', hm⟩
    have hE : C.E 0 x' = C.E 0 x := Finset.map_injective _ hx'
    have hx'x : x' ∈ C.F h x :=
      C.F_mono 0 h x (Nat.zero_le h) (C.E_le_F 0 x (hE ▸ C.E_self 0 x'))
    rwa [← C.F_comp h x x' hx'x]
  · intro hm
    exact ⟨x, rfl, hm⟩

/-- Blueprint lines 2467-2468 ("they lie in the unique good predecessor of each `F_j`"): a minimal
component `E_0(x)` of a mode good at `h` whose CURRENT component at `h` is that of a good mode
`x₀` lies in the PRE predecessor `E_{h-Δ}(x₀)` (`good_same_predecessor`). -/
theorem minimal_subset_pred {U : ℤ × ℤ} {P : Type*} [DecidableEq P]
    (C : ModeComponents (Ms.alive U) P) (Δ : ℕ) (goodP : ℕ → P → Prop)
    [∀ h, DecidablePred (goodP h)]
    (hstab : ∀ h x x', goodP h (C.π x) → C.π x' = C.π x → x' ∈ C.F h x → x' ∈ C.E (h - Δ) x)
    {h : ℕ} {x₀ x : Ms.alive U} (hg₀ : C.Good Δ goodP h x₀) (hg : C.Good Δ goodP h x)
    (hcls : C.F h x = C.F h x₀) : C.E 0 x ⊆ C.E (h - Δ) x₀ := by
  have hx : x ∈ C.F h x₀ := hcls ▸ C.E_le_F h x (C.E_self h x)
  rw [C.good_same_predecessor Δ goodP hstab hg₀ hg hx]
  exact C.E_mono 0 (h - Δ) x (Nat.zero_le _)

end ModeSystem

