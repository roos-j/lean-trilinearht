variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

open Classical in
/-- Blueprint lines 2466-2469 (`eq:core-torus-form`, the error of the torus form on an attempt
leaf cell `I` of block `b`): with the pre-cell `J` of `I` at depth `v_b = b - 2K` and the decision
cell `U` at `u_b = b - 4K`, the slope term of a PRE path (at most `B_c` alive modes, threshold
`Ξ/r_{v_b}`) and the curvature term (`|λ| ≤ Λ'/r_{u_b}²`) are at most `B_c Ξ 2^{-2K}` and
`Λ' 2^{-8K}` on `I`. -/
theorem core_torus_eta (hK1 : 1 ≤ D.S.K) (I : ℤ × ℤ) (l : Fin 4) (G : A.Grp) {Bc : ℝ}
    (hcount : ∀ y, ((Finset.univ.filter fun m => y ∈ dyadicGridCell A.G
      ((D.Ms l G).cellOf m).1 ((D.Ms l G).cellOf m).2).card : ℝ) ≤ Bc)
    {Λ' : ℝ} (hΛ0 : 0 ≤ Λ') {xs y : ℝ}
    (hxs : xs ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1))
    (hy : y ∈ Set.Icc (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLeft A.G I.1 I.2 + dyadicGridLength A.G I.1)) :
    2 * Real.pi * (Fintype.card ((D.Ms l G).alive (ancAt A.G (ancAt A.G I
        (D.blockOf I.1 - 2 * D.S.K)) (D.blockOf I.1 - 4 * D.S.K))) *
      (D.S.Ξ / dyadicGridLength A.G (ancAt A.G I (D.blockOf I.1 - 2 * D.S.K)).1) * |y - xs| +
      Λ' / dyadicGridLength A.G (ancAt A.G (ancAt A.G I
        (D.blockOf I.1 - 2 * D.S.K)) (D.blockOf I.1 - 4 * D.S.K)).1 ^ 2 * (y - xs) ^ 2) ≤
    2 * Real.pi * (Bc * D.S.Ξ * (2 : ℝ)⁻¹ ^ (2 * D.S.K) +
      Λ' * (2 : ℝ)⁻¹ ^ (8 * D.S.K)) := by
  obtain ⟨hb, -⟩ := D.blockOf_bounds hK1 I.1
  set b := D.blockOf I.1
  have hJ1 : (ancAt A.G I (b - 2 * D.S.K)).1 = b - 2 * D.S.K := rfl
  have hU1 : (ancAt A.G (ancAt A.G I (b - 2 * D.S.K)) (b - 4 * D.S.K)).1 = b - 4 * D.S.K := rfl
  rw [hJ1, hU1]
  have hd := abs_sub_le_of_mem_cell hxs hy
  have hc := (D.Ms l G).card_alive_le (ancAt A.G (ancAt A.G I (b - 2 * D.S.K))
    (b - 4 * D.S.K)) hcount
  have hBc : 0 ≤ Bc := le_trans (Nat.cast_nonneg _) (hcount 0)
  have hΞ := Ξ_nonneg D.S
  have hJpos := dyadicGridLength_pos A.G (b - 2 * D.S.K)
  have hUpos := dyadicGridLength_pos A.G (b - 4 * D.S.K)
  -- `|I| ≤ |J| 2^{-2K}` and `|I| ≤ |U| 2^{-4K}`
  have hIJ : dyadicGridLength A.G I.1 ≤
      dyadicGridLength A.G (b - 2 * D.S.K) * (2 : ℝ)⁻¹ ^ (2 * D.S.K) := by
    rw [dyadicGridLength_of_le A.G (show b - 2 * D.S.K ≤ I.1 by omega)]
    refine mul_le_mul_of_nonneg_left (pow_le_pow_of_le_one (by norm_num) (by norm_num)
      (by omega)) hJpos.le
  have hIU : dyadicGridLength A.G I.1 ≤
      dyadicGridLength A.G (b - 4 * D.S.K) * (2 : ℝ)⁻¹ ^ (4 * D.S.K) := by
    rw [dyadicGridLength_of_le A.G (show b - 4 * D.S.K ≤ I.1 by omega)]
    refine mul_le_mul_of_nonneg_left (pow_le_pow_of_le_one (by norm_num) (by norm_num)
      (by omega)) hUpos.le
  refine mul_le_mul_of_nonneg_left (add_le_add ?_ ?_) (by positivity)
  · calc (Fintype.card _ : ℝ) * (D.S.Ξ / dyadicGridLength A.G (b - 2 * D.S.K)) * |y - xs| ≤
        Bc * (D.S.Ξ / dyadicGridLength A.G (b - 2 * D.S.K)) *
          (dyadicGridLength A.G (b - 2 * D.S.K) * (2 : ℝ)⁻¹ ^ (2 * D.S.K)) := by
          have hq : 0 ≤ D.S.Ξ / dyadicGridLength A.G (b - 2 * D.S.K) := div_nonneg hΞ hJpos.le
          exact mul_le_mul (mul_le_mul_of_nonneg_right hc hq) (hd.trans hIJ)
            (abs_nonneg _) (mul_nonneg hBc hq)
      _ = Bc * D.S.Ξ * (2 : ℝ)⁻¹ ^ (2 * D.S.K) := by field_simp
  · have hsq : (y - xs) ^ 2 ≤ (dyadicGridLength A.G (b - 4 * D.S.K) *
        (2 : ℝ)⁻¹ ^ (4 * D.S.K)) ^ 2 := by
      rw [← sq_abs]
      exact pow_le_pow_left₀ (abs_nonneg _) (hd.trans hIU) 2
    calc Λ' / dyadicGridLength A.G (b - 4 * D.S.K) ^ 2 * (y - xs) ^ 2 ≤
        Λ' / dyadicGridLength A.G (b - 4 * D.S.K) ^ 2 *
          (dyadicGridLength A.G (b - 4 * D.S.K) * (2 : ℝ)⁻¹ ^ (4 * D.S.K)) ^ 2 :=
          mul_le_mul_of_nonneg_left hsq (by positivity)
      _ = Λ' * (2 : ℝ)⁻¹ ^ (8 * D.S.K) := by
          rw [mul_pow, ← pow_mul]; field_simp; ring_nf

/-- The torus frequency `ξ = θ_z/(Q₀ L_h)`, `L_h = 6^h` (blueprint line 2468). -/
noncomputable def xiH (z : ChartTag) (h : ℕ) : Fin z.dim → ℝ :=
  fun i => z.θ i / (D.S.Q0 * ((6 ^ h : ℕ) : ℝ))

/-- The decision cell `U = anc_{b-4K}(J)` of the pre-cell of `I`. -/
noncomputable def decCell (I : ℤ × ℤ) : ℤ × ℤ :=
  ancAt A.G (D.preCell I) (D.blockOf I.1 - 4 * D.S.K)

/-- The selected coefficient `α_m e(φ_m(x*))` of a mode of role `j` (blueprint line 2468). -/
noncomputable def selC (j : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (xs : ℝ)
    (m : (D.Ms j G).alive (D.decCell I)) : ℂ :=
  D.c j G (D.blockOf I.1) (D.preCell I) m.1 * (Real.fourierChar ((D.Ms j G).phase m.1 xs) : ℂ)

end LeafSplit

