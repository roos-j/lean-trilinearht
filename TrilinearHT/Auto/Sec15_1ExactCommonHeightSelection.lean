      ‖π (D.side l G I (ap.leafOut cat s₀ I l G) (ap.leafOut cat s₀ (D.dcell I) l G))‖ ≤
        8 * (B₀ + Real.sqrt T) * Real.sqrt (dyadicGridLength A.G I.1) ∧
      ‖π (D.err l G I (ap.leafOut cat s₀ (D.dcell I) l G))‖ ≤
        8 * (B₀ + Real.sqrt T) * Real.sqrt (dyadicGridLength A.G I.1) := fun I hI G hG l =>
    D.cell_piece_sizes l G I _ _ hB₀ hT
      (ap.leafOut_size cat s₀ I l G hB₀ (hzm I l) (hzb I l)) (hreg I hI G hG l)
  exact D.leaf_error_bound cat (fun l => ap.leafR s₀ l) (fun l => ap.leafJ s₀ l) S gs gset hgs
    (fun I _ => D.sub_dcell hK1 I) (D.card_depths_dcell_le hK1 S)
    (fun l _ U => ap.leafIn cat s₀ l U) (fun I l G => ap.leafOut cat s₀ I l G) hMc hKx dim hdim
