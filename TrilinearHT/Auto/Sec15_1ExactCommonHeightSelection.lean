    (hM : ∑ I ∈ S, dyadicGridLength A.G I.1 * (gs I).card ≤ M) :
    ∑ I ∈ S, dyadicGridLength A.G I.1 * ∑ σ ∈ Finset.univ.filter (fun σ => ∃ l, σ l = 2),
        ‖D.patF (gs I) I (Zout I) (fun l G =>
          ap.ballAt (cat l) (r l) (j l) G (D.dcell I) (xs l G (D.dcell I))) σ‖ ≤
      81 * (localFormUniformConstant κ' * Bs ^ 3) * (Real.sqrt (4 * M) *
        Real.sqrt (K * (4 * ((8 * dB * δ / ap.Mc + 2 * δc ^ 2) * Kx *
          ∑ G ∈ gset, ∑ U ∈ (S.filter fun I => G ∈ gs I).image D.dcell,
            dyadicGridLength A.G U.1)))) := by
  set F : Fin 4 → A.Grp → ℤ × ℤ → ColumnL2 (Fin ap.Mc) := fun l G U =>
    ap.ballAt (cat l) (r l) (j l) G U (xs l G U)
  set Us : A.Grp → Finset (ℤ × ℤ) := fun G => (S.filter fun I => G ∈ gs I).image D.dcell
  set c : ℝ := 8 * dB * δ / ap.Mc + 2 * δc ^ 2
  have hc : 0 ≤ c := by positivity
  have hKx0 : 0 ≤ Kx ∨ ∀ G ∈ gset, Us G = ∅ := by
    by_cases h : ∃ G ∈ gset, (Us G).Nonempty
    · obtain ⟨G, hG, U, hU⟩ := h
      left
      have h1 := hKx 0 G hG U hU
      exact le_trans (by have := dyadicGridLength_pos A.G U.1; positivity) h1
    · right
      intro G hG
      by_contra hne
      exact h ⟨G, hG, Finset.nonempty_iff_ne_empty.mpr hne⟩
  -- the majorant on all decision cells of one slot
  have hslot : ∀ l, ∑ G ∈ gset, ∑ U ∈ Us G, ∫⁻ y in dyadicGridCell A.G U.1 U.2, ENNReal.ofReal
      (‖(F l G U : ℝ → ColumnHilbert (Fin ap.Mc)) y none -
        ((D.Ms l G).L.op (F l G U) : ℝ → ColumnHilbert (D.Ms l G).Md) y none‖ ^ 2) ≤
      ENNReal.ofReal (c * Kx * ∑ G ∈ gset, ∑ U ∈ Us G, dyadicGridLength A.G U.1) := by
    intro l
    refine (herr l).trans ?_
    rcases hKx0 with hKx0 | hempty
    · rw [Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg fun G _ => by
        rw [Finset.mul_sum]
        exact Finset.sum_nonneg fun U _ => by
          have := dyadicGridLength_pos A.G U.1; positivity]
      refine Finset.sum_le_sum fun G hG => ?_
      rw [Finset.mul_sum, ENNReal.ofReal_sum_of_nonneg fun U _ => by
        have := dyadicGridLength_pos A.G U.1; positivity]
      refine Finset.sum_le_sum fun U hU => ?_
      have hnb : ‖F l G U‖ ≤ ‖xs l G U‖ :=
        norm_opAvg_apply_le _ (fun _ y => norm_catProj_le _ _ _ _ _ _ y) _
      have hKF : ap.Mc * ‖F l G U‖ ^ 2 / dyadicGridLength A.G U.1 ≤ Kx := by
        refine le_trans ?_ (hKx l G hG U hU)
        have := dyadicGridLength_pos A.G U.1
        gcongr
      exact ball_err_majorant_le A.G U (F l G U) hMc hKF (hdim G hG) (δc := δc) hδ
    · refine le_trans (le_of_eq ?_) zero_le
      refine Finset.sum_eq_zero fun G hG => ?_
      have h0 := hempty G hG
      simp only [Us] at h0
      rw [h0, Finset.sum_empty]
  -- the error energy on the used cells
  have hE := leaf_err_energy_le A.G D.Ms S gs gset hgs D.dcell hdc hK F
  have hE' : ∑ I ∈ S, ∑ G ∈ gs I, ∑ l, ∫ y in dyadicGridCell A.G I.1 I.2,
      ‖(F l G (D.dcell I) : ℝ → ColumnHilbert (Fin ap.Mc)) y none -
        ((D.Ms l G).L.op (F l G (D.dcell I)) : ℝ → ColumnHilbert (D.Ms l G).Md) y none‖ ^ 2 ≤
      K * (4 * (c * Kx * ∑ G ∈ gset, ∑ U ∈ Us G, dyadicGridLength A.G U.1)) := by
    have hsum : ∑ l : Fin 4, ∑ G ∈ gset, ∑ U ∈ Us G, ∫⁻ y in dyadicGridCell A.G U.1 U.2,
        ENNReal.ofReal (‖(F l G U : ℝ → ColumnHilbert (Fin ap.Mc)) y none -
          ((D.Ms l G).L.op (F l G U) : ℝ → ColumnHilbert (D.Ms l G).Md) y none‖ ^ 2) ≤
        ∑ _l : Fin 4, ENNReal.ofReal (c * Kx * ∑ G ∈ gset, ∑ U ∈ Us G,
          dyadicGridLength A.G U.1) := Finset.sum_le_sum fun l _ => hslot l
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, Nat.cast_ofNat] at hsum
    have hR : 0 ≤ c * Kx * ∑ G ∈ gset, ∑ U ∈ Us G, dyadicGridLength A.G U.1 ∨
        ∑ G ∈ gset, ∑ U ∈ Us G, dyadicGridLength A.G U.1 = 0 := by
      rcases hKx0 with h | h
      · left
        have : 0 ≤ ∑ G ∈ gset, ∑ U ∈ Us G, dyadicGridLength A.G U.1 :=
          Finset.sum_nonneg fun G _ => Finset.sum_nonneg fun U _ =>
            (dyadicGridLength_pos A.G U.1).le
        positivity
      · right
        refine Finset.sum_eq_zero fun G hG => ?_
        rw [h G hG, Finset.sum_empty]
    have hlhs : 0 ≤ ∑ I ∈ S, ∑ G ∈ gs I, ∑ l, ∫ y in dyadicGridCell A.G I.1 I.2,
        ‖(F l G (D.dcell I) : ℝ → ColumnHilbert (Fin ap.Mc)) y none -
          ((D.Ms l G).L.op (F l G (D.dcell I)) : ℝ → ColumnHilbert (D.Ms l G).Md) y none‖ ^ 2 :=
      Finset.sum_nonneg fun I _ => Finset.sum_nonneg fun G _ => Finset.sum_nonneg fun l _ =>
        setIntegral_nonneg (dyadicGridCell_measurable _ _ _) fun _ _ => sq_nonneg _
    have hY : 0 ≤ c * Kx * ∑ G ∈ gset, ∑ U ∈ Us G, dyadicGridLength A.G U.1 := by
      rcases hR with hR | hR
      · exact hR
      · rw [hR, mul_zero]
    have e : (K : ℝ≥0∞) * (4 * ENNReal.ofReal (c * Kx * ∑ G ∈ gset, ∑ U ∈ Us G,
        dyadicGridLength A.G U.1)) = ENNReal.ofReal (K * (4 * (c * Kx * ∑ G ∈ gset,
          ∑ U ∈ Us G, dyadicGridLength A.G U.1))) := by
      rw [ENNReal.ofReal_mul (Nat.cast_nonneg K), ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4),
        ENNReal.ofReal_natCast, ENNReal.ofReal_ofNat]
    refine (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp (hE.trans ?_)
    rw [← e]
    gcongr
    convert hsum
  exact D.leaf_error_patterns S gs Zout (fun I l G => F l G (D.dcell I)) hBs hsize hM hE'

