variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (T : ap.TTData)

open Classical in
/-- The freeze differences on the cells of one offset and block are the restricted differences on
their union between the depth of the offset and the block start. -/
theorem frz_cells (hK1 : 1 ≤ T.D.S.K) (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j o n β : ℕ) :
    ∑ J ∈ T.offCells n β, T.frzD c d G t t' j o J =
      ∑ p ∈ ap.uo o, ‖columnL2Restriction (⋃ J ∈ T.offCells n β, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (T.Y c d G t t' j o (A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ)) p -
          T.Y c d G t t' j o (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) p)‖ ^ 2 +
      ‖columnL2Restriction (⋃ J ∈ T.offCells n β, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (T.F c d G t t' j (A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ)) -
          T.F c d G t t' j (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))‖ ^ 2 := by
  unfold frzD
  rw [Finset.sum_add_distrib, Finset.sum_comm]
  congr 1
  · refine Finset.sum_congr rfl fun p _ => ?_
    rw [← T.offCells_sum hK1 n β]
    refine Finset.sum_congr rfl fun J hJ => ?_
    obtain ⟨e1, e2, -⟩ := T.offCells_depth hK1 hJ
    have ev : T.Y c d G t t' j o J.1 p - T.Y c d G t t' j o (T.D.blockOf J.1) p =
        T.Y c d G t t' j o (A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ)) p -
          T.Y c d G t t' j o (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) p := by
      rw [e2, e1]
    rw [ev]
  · rw [← T.offCells_sum hK1 n β]
    refine Finset.sum_congr rfl fun J hJ => ?_
    obtain ⟨e1, e2, -⟩ := T.offCells_depth hK1 hJ
    have ev : T.F c d G t t' j J.1 - T.F c d G t t' j (T.D.blockOf J.1) =
        T.F c d G t t' j (A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ)) -
          T.F c d G t t' j (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) := by
      rw [e2, e1]
    rw [ev]

open Classical in
/-- The band variation over disjoint depth intervals (`slot_variation` for the band operators). -/
theorem band_var (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j o p : ℕ) {ι : Type} [Fintype ι]
    (r s : ι → ℕ) (hrs : ∀ i, r i ≤ s i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (s i)) (Finset.Ioc (r i') (s i')))
    (htd : ∀ i, s i ≤ A.treeDepth) (Ec : ι → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells) :
    ∑ i, ‖columnL2Restriction (⋃ J ∈ Ec i, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (T.Y c d G t t' j o (A.R.1 + s i) p - T.Y c d G t t' j o (A.R.1 + r i) p)‖ ^ 2 ≤
      T.slotVar (cslot c d ((T.desc c d t t').getD j (true, 0, none)).1)
        (4 * T.jmpC c d ((T.desc c d t t').getD j (true, 0, none)).1
          (restIdx ((T.desc c d t t').getD j (true, 0, none)).1
            ((T.desc c d t t').drop (j + 1)) (j + 1)).length) := by
  have hgb : ∀ h, (if ((T.desc c d t t').getD j (true, 0, none)).1 then
      ap.gIn (T.P₁ c) (T.P₂ c) h else ap.gIn (T.P₁ d) (T.P₂ d) h) =
      ap.gIn (T.P₁ (cslot c d ((T.desc c d t t').getD j (true, 0, none)).1))
        (T.P₂ (cslot c d ((T.desc c d t t').getD j (true, 0, none)).1)) h := fun h => by
    cases ((T.desc c d t t').getD j (true, 0, none)).1 <;> rfl
  simp only [T.Y_eq, hgb]
  have hjb := T.jmpC_nonneg c d ((T.desc c d t t').getD j (true, 0, none)).1
    (restIdx ((T.desc c d t t').getD j (true, 0, none)).1 ((T.desc c d t t').drop (j + 1))
      (j + 1)).length
  exact T.slot_variation (cslot c d ((T.desc c d t t').getD j (true, 0, none)).1)
    (fun h => T.bandDiff c d G (T.desc c d t t') j (p + o - 2) h) r s hrs hdis htd Ec hEc
    (by positivity)
    (fun x => T.bandDiff_rows c d G (T.desc c d t t') j (p + o - 2) r s hrs hdis Ec hEc x)
    (fun h Q hQ hN => T.bandDiff_comm c d G (T.desc c d t t') j (p + o - 2) h Q hQ hN)
    (fun h y => T.bandDiff_contr c d G (T.desc c d t t') j (p + o - 2) h y)

open Classical in
/-- The other complement variation over disjoint depth intervals. -/
theorem other_var (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j : ℕ) {ι : Type} [Fintype ι]
    (r s : ι → ℕ) (hrs : ∀ i, r i ≤ s i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (s i)) (Finset.Ioc (r i') (s i')))
    (htd : ∀ i, s i ≤ A.treeDepth) (Ec : ι → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells) :
    ∑ i, ‖columnL2Restriction (⋃ J ∈ Ec i, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        (T.F c d G t t' j (A.R.1 + s i) - T.F c d G t t' j (A.R.1 + r i))‖ ^ 2 ≤
      T.slotVar (cslot c d (!((T.desc c d t t').getD j (true, 0, none)).1))
        (T.jmpC c d (!((T.desc c d t t').getD j (true, 0, none)).1)
          (restIdx (!((T.desc c d t t').getD j (true, 0, none)).1)
            ((T.desc c d t t').drop (j + 1)) (j + 1)).length) := by
  have hgf : ∀ h, (if ((T.desc c d t t').getD j (true, 0, none)).1 then
      ap.gIn (T.P₁ d) (T.P₂ d) h else ap.gIn (T.P₁ c) (T.P₂ c) h) =
      ap.gIn (T.P₁ (cslot c d (!((T.desc c d t t').getD j (true, 0, none)).1)))
        (T.P₂ (cslot c d (!((T.desc c d t t').getD j (true, 0, none)).1))) h := fun h => by
    cases ((T.desc c d t t').getD j (true, 0, none)).1 <;> rfl
  simp only [T.F_eq, hgf]
  exact T.slot_variation (cslot c d (!((T.desc c d t t').getD j (true, 0, none)).1))
    (fun h => T.histOp c d G (T.desc c d t t') j
      (!((T.desc c d t t').getD j (true, 0, none)).1) h) r s hrs hdis htd Ec hEc
    (T.jmpC_nonneg _ _ _ _)
    (fun x => T.histOp_rows c d G (T.desc c d t t') j _ r s hrs hdis Ec x)
    (fun h Q hQ hN => T.histOp_comm c d G (T.desc c d t t') j _ h Q hQ hN)
    (fun h y => T.histOp_contr c d G (T.desc c d t t') j _ h y)

