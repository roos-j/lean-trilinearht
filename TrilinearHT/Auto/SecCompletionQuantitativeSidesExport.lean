variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (T : ap.TTData)

open Classical in
/-- Blueprint lines 2412-2416 (the base terms of the rolling stacks, "its base term uses Lemma
variation on `[u_b, b]`, whose overlap over blocks is bounded", and the linear sides): the global
sides of a basic slot at the block starts, restricted to the ancestors of the uses at the block
starts, have total square at most `8 B_var + 2 E_lin + 4 |groups| E_out`. -/
theorem block_start_energy (hanc : A.AncClosed) (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells)
    (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp) (Bn : ℕ) (a : Fin 4)
    {okA : A.Grp → ℤ × ℤ → Prop} {BA : ℝ}
    (hcapA : A.VarCap gset (fun G h => LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G
      (T.P₁ a) (T.P₂ a) h) okA BA)
    (hok : ∀ I ∈ S, ∀ G ∈ gs I, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okA G J)
    (hK1 : 1 ≤ T.D.S.K) {EL EO : ℝ}
    (hlin : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn,
      ‖T.D.gV a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))‖ ^ 2 ≤ EL)
    (hout : ∀ G ∈ gset, ∀ h, ‖LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G
      (T.P₁ a) (T.P₂ a) h‖ ^ 2 ≤ EO) :
    ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖columnL2Restriction
      (⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
        (fun I => ancAt A.G I (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (T.gside a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤
      2 * (4 * BA) + 2 * EL + 4 * gset.card * EO := by
  have hRle : ∀ I ∈ A.cells, A.R.1 ≤ I.1 ∧ I.1 ≤ A.R.1 + A.treeDepth := fun I hI =>
    ⟨dyadicGridCell_depth_le_of_subset A.G I A.R
      ((dyadicFiniteTree_mem_iff A.G A.R I A.treeDepth).mp (A.cells_mem_tree hI)).1,
    ((dyadicFiniteTree_mem_iff A.G A.R I A.treeDepth).mp (A.cells_mem_tree hI)).2⟩
  set E : A.Grp → ℕ → Set ℝ := fun G β => ⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
    (fun I => ancAt A.G I (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2 with hE
  have hEm : ∀ G β, MeasurableSet (E G β) := fun G β =>
    Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2
  set roll : A.Grp → ℕ → ColumnL2 (Fin ap.Mc) := fun G β =>
    LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G (T.P₁ a) (T.P₂ a)
      (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) -
    LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G (T.P₁ a) (T.P₂ a)
      (A.R.1 + ((T.D.S.K * (β - 4) : ℕ) : ℤ)) with hroll
  have hpt : ∀ G ∈ gset, ∀ β, ‖columnL2Restriction (E G β) (hEm G β)
      (T.gside a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤
      (if 4 ≤ β ∧ T.D.S.K * β ≤ A.treeDepth then
        2 * ‖columnL2Restriction (E G β) (hEm G β) (roll G β)‖ ^ 2 else 0) +
      2 * ‖T.D.gV a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))‖ ^ 2 + (if β < 4 then EO else 0) := by
    intro G hG β
    have hEO : 0 ≤ EO := (sq_nonneg _).trans (hout G hG 0)
    by_cases h4 : 4 ≤ β
    · have hdec : A.R.1 ≤ A.R.1 + ((T.D.S.K * β : ℕ) : ℤ) - 4 * T.D.S.K := by
        have : 4 * T.D.S.K ≤ T.D.S.K * β := by nlinarith
        push_cast; omega
      have hb4 : A.R.1 + ((T.D.S.K * β : ℕ) : ℤ) - 4 * T.D.S.K =
          A.R.1 + ((T.D.S.K * (β - 4) : ℕ) : ℤ) := by
        rw [Nat.mul_sub, Nat.cast_sub (by nlinarith)]; push_cast; ring
      have e : T.gside a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) =
          roll G β + T.D.gV a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) := by
        unfold gside LeafSplit.gSide
        rw [ite_eq_left_of_eq_true _ _ (eq_true hdec), hb4]
      rw [e]
      have h4' : ¬ β < 4 := by omega
      simp only [h4', ite_false, add_zero]
      by_cases htd : T.D.S.K * β ≤ A.treeDepth
      · simp only [h4, htd, and_self, ite_true]
        rw [map_add]
        refine (norm_add_sq_le_two_mul _ _).trans (add_le_add le_rfl ?_)
        exact mul_le_mul_of_nonneg_left (columnL2Restriction_norm_sq_le _ _ _) (by norm_num)
      · have hempty : E G β = ∅ := by
          simp only [hE]
          refine Set.eq_empty_of_forall_notMem fun y hy => ?_
          obtain ⟨J, hJ, -⟩ := Set.mem_iUnion₂.mp hy
          obtain ⟨I, hI, -⟩ := Finset.mem_image.mp hJ
          obtain ⟨hIS, -, hbk⟩ := Finset.mem_filter.mp hI
          have e := T.bk_offI hK1 (hRle I (hS hIS)).1
          rw [hbk] at e
          have := (hRle I (hS hIS)).2
          have h1 := e.1
          push_cast at h1
          omega
        have hz : ∀ x : ColumnL2 (Fin ap.Mc), ‖columnL2Restriction (E G β) (hEm G β) x‖ ^ 2 = 0 :=
          fun x => by
            rw [columnL2Restriction_norm_sq, hempty, Measure.restrict_empty, integral_zero_measure]
        rw [hz]
        simp only [htd, and_false, ite_false, zero_add]
        exact mul_nonneg (by norm_num) (sq_nonneg _)
    · have hdec : ¬ A.R.1 ≤ A.R.1 + ((T.D.S.K * β : ℕ) : ℤ) - 4 * T.D.S.K := by
        have : T.D.S.K * β < 4 * T.D.S.K := by nlinarith
        push_cast; omega
      have e : T.gside a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) =
          LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G (T.P₁ a) (T.P₂ a)
            (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) := by
        unfold gside LeafSplit.gSide
        rw [ite_eq_right_of_eq_false _ _ (eq_false hdec)]
      rw [e]
      have h4' : β < 4 := by omega
      simp only [h4, false_and, ite_false, h4', ite_true, zero_add]
      have h1 := (columnL2Restriction_norm_sq_le (E G β) (hEm G β) (LeafSplit.gOut (ap := ap)
        T.cat T.hR T.hbc T.s a G (T.P₁ a) (T.P₂ a) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))).trans
        (hout G hG _)
      have := sq_nonneg ‖T.D.gV a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))‖
      linarith
  refine le_trans (Finset.sum_le_sum fun G hG => Finset.sum_le_sum fun β _ => hpt G hG β) ?_
  simp only [Finset.sum_add_distrib]
  have hroll : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn,
      (if 4 ≤ β ∧ T.D.S.K * β ≤ A.treeDepth then
        2 * ‖columnL2Restriction (E G β) (hEm G β) (roll G β)‖ ^ 2 else 0) ≤ 2 * (4 * BA) := by
    have hc : ∀ G, ∑ β ∈ Finset.range Bn, (if 4 ≤ β ∧ T.D.S.K * β ≤ A.treeDepth then
        2 * ‖columnL2Restriction (E G β) (hEm G β) (roll G β)‖ ^ 2 else 0) =
        2 * ∑ ρ ∈ Finset.range 4, ∑ β ∈ (Finset.range Bn).filter (fun β => 4 ≤ β ∧ β % 4 = ρ ∧
          T.D.S.K * β ≤ A.treeDepth),
          ‖columnL2Restriction (E G β) (hEm G β) (roll G β)‖ ^ 2 := by
      intro G
      rw [← Finset.sum_filter, ← Finset.mul_sum, ← Finset.sum_fiberwise_of_maps_to
        (g := fun β => β % 4) (t := Finset.range 4) (fun β _ => Finset.mem_range.mpr
          (Nat.mod_lt _ (by norm_num)))]
      congr 1
      refine Finset.sum_congr rfl fun ρ _ => Finset.sum_congr ?_ fun _ _ => rfl
      ext β
      simp only [Finset.mem_filter, Finset.mem_range]
      tauto
    simp only [hc, ← Finset.mul_sum]
    rw [Finset.sum_comm]
    calc 2 * ∑ ρ ∈ Finset.range 4, ∑ G ∈ gset, ∑ β ∈ (Finset.range Bn).filter (fun β => 4 ≤ β ∧
          β % 4 = ρ ∧ T.D.S.K * β ≤ A.treeDepth),
          ‖columnL2Restriction (E G β) (hEm G β) (roll G β)‖ ^ 2
        ≤ 2 * ∑ _ρ ∈ Finset.range 4, BA := by
          gcongr with ρ _
          exact T.rolling_class hanc S hS gs gset Bn a hcapA hok hK1 ρ
      _ = 2 * (4 * BA) := by rw [Finset.sum_const, Finset.card_range]; ring
  have hlin2 : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn,
      2 * ‖T.D.gV a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))‖ ^ 2 ≤ 2 * EL := by
    simp only [← Finset.mul_sum]; linarith
  have hout4 : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, (if β < 4 then EO else 0) ≤
      4 * gset.card * EO := by
    calc _ ≤ ∑ _G ∈ gset, 4 * EO := by
          refine Finset.sum_le_sum fun G hG => ?_
          have hEO : 0 ≤ EO := (sq_nonneg _).trans (hout G hG 0)
          rw [← Finset.sum_filter, Finset.sum_const, nsmul_eq_mul]
          refine mul_le_mul_of_nonneg_right ?_ hEO
          have : ((Finset.range Bn).filter (fun β => β < 4)).card ≤ 4 := by
            refine (Finset.card_le_card (t := Finset.range 4) fun β hβ => ?_).trans (by simp)
            exact Finset.mem_range.mpr (Finset.mem_filter.mp hβ).2
          exact_mod_cast this
      _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]; ring
  linarith

