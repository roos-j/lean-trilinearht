open Classical in
/-- The active cells of a given block offset and block. -/
noncomputable def offCells (n β : ℕ) : Finset (ℤ × ℤ) :=
  A.cells.filter fun J => T.offI J = n ∧ T.bk J = β

open Classical in
/-- On the cells of one offset and block, a sum of restricted squares of one vector is the
restricted square on their union. -/
theorem offCells_sum (hK1 : 1 ≤ T.D.S.K) (n β : ℕ) (v : ColumnL2 (Fin ap.Mc)) :
    ∑ J ∈ T.offCells n β, ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2)
      (dyadicGridCell_measurable A.G J.1 J.2) v‖ ^ 2 =
    ‖columnL2Restriction (⋃ J ∈ T.offCells n β, dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2) v‖ ^ 2 := by
  refine sum_norm_sq_restrict_le A.G _ (fun I hI I' hI' hne => ?_) v
  have h1 := Finset.mem_filter.mp hI
  have h2 := Finset.mem_filter.mp hI'
  have hRle : ∀ J ∈ A.cells, A.R.1 ≤ J.1 := fun J hJ => dyadicGridCell_depth_le_of_subset A.G J A.R
    ((dyadicFiniteTree_mem_iff A.G A.R J A.treeDepth).mp (A.cells_mem_tree hJ)).1
  have e1 := (T.bk_offI hK1 (hRle I h1.1)).1
  have e2 := (T.bk_offI hK1 (hRle I' h2.1)).1
  have hd : I.1 = I'.1 := by rw [e1, e2, h1.2.1, h1.2.2, h2.2.1, h2.2.2]
  have hne2 : I.2 ≠ I'.2 := fun h => hne (Prod.ext hd h)
  simp only [Function.onFun]
  rw [hd]
  exact dyadicGridCell_pairwiseDisjoint A.G I'.1 hne2

open Classical in
/-- The depth and block start of the cells of one offset and block. -/
theorem offCells_depth (hK1 : 1 ≤ T.D.S.K) {n β : ℕ} {J : ℤ × ℤ} (hJ : J ∈ T.offCells n β) :
    J.1 = A.R.1 + ((T.D.S.K * β + n : ℕ) : ℤ) ∧
      T.D.blockOf J.1 = A.R.1 + ((T.D.S.K * β : ℕ) : ℤ) ∧ n < T.D.S.K := by
  have h1 := Finset.mem_filter.mp hJ
  have hRle : A.R.1 ≤ J.1 := dyadicGridCell_depth_le_of_subset A.G J A.R
    ((dyadicFiniteTree_mem_iff A.G A.R J A.treeDepth).mp (A.cells_mem_tree h1.1)).1
  have e := T.bk_offI hK1 hRle
  rw [h1.2.1, h1.2.2] at e
  exact ⟨e.1, e.2.2, e.2.1⟩

