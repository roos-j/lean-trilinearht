variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (T : ap.TTData)

/-- The global histories and band operators at the depth `h` commute with the restrictions to the
active cells at most that deep. -/
theorem histOp_comm (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) (v : Bool)
    (h : ℤ) (Q : ℤ × ℤ) (hQ : Q.1 ≤ h) (hN : h ≤ A.R.1 + A.treeDepth) :
    (T.histOp c d G D j v h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)) =
      (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (T.histOp c d G D j v h) := by
  have hd : ∀ M : InheritedColumnMask (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D,
      Q.1 ≤ ((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).depth h := fun M => by
    change Q.1 ≤ max (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D.root.1
      (min h (A.R.1 + A.treeDepth))
    exact le_max_of_le_right (le_min hQ (by omega))
  set rQ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G Q.1 Q.2)
    (dyadicGridCell_measurable A.G Q.1 Q.2)
  have hpad : ∀ M : InheritedColumnMask (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D,
      (((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).proj h).comp rQ =
        rQ.comp (((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).proj h) :=
    fun M => (((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).proj_commute_restrict
      h (hd M)).symm
  unfold histOp globHist
  exact layerOp_commute _ rQ (fun m => opAvg_commute _ _ fun p => hpad _) _

theorem bandOp_comm (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    (h : ℤ) (Q : ℤ × ℤ) (hQ : Q.1 ≤ h) (hN : h ≤ A.R.1 + A.treeDepth) :
    (T.bandOp c d G D j m h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)) =
      (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (T.bandOp c d G D j m h) := by
  set v := (D.getD j (true, 0, none)).1
  have hd : ∀ M : InheritedColumnMask (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D,
      Q.1 ≤ ((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask M).depth h := fun M => by
    change Q.1 ≤ max (ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).D.root.1
      (min h (A.R.1 + A.treeDepth))
    exact le_max_of_le_right (le_min hQ (by omega))
  unfold bandOp
  rw [ContinuousLinearMap.comp_assoc, T.histOp_comm c d G D j v h Q hQ hN,
    ← ContinuousLinearMap.comp_assoc, ← ContinuousLinearMap.comp_assoc]
  congr 1
  unfold padFamC
  split_ifs
  · simp
  · exact (((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask _).proj_commute_restrict h
      (hd _)).symm
  · simp

theorem bandDiff_comm (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    (h : ℤ) (Q : ℤ × ℤ) (hQ : Q.1 ≤ h) (hN : h ≤ A.R.1 + A.treeDepth) :
    (T.bandDiff c d G D j m h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)) =
      (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
        (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (T.bandDiff c d G D j m h) := by
  unfold bandDiff
  rw [ContinuousLinearMap.sub_comp, ContinuousLinearMap.comp_sub,
    T.bandOp_comm c d G D j (m + 1) h Q hQ hN, T.bandOp_comm c d G D j m h Q hQ hN]

theorem histOp_contr (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j : ℕ)
    (v : Bool) (h : ℤ) (y : ColumnL2 (Fin ap.Mc)) : ‖T.histOp c d G D j v h y‖ ≤ ‖y‖ :=
  globHist_norm_le _ ap.hP _ _ _ _

theorem bandDiff_contr (c d : Fin 4) (G : A.Grp) (D : List (Bool × ℕ × Option ℕ)) (j m : ℕ)
    (h : ℤ) (y : ColumnL2 (Fin ap.Mc)) : ‖T.bandDiff c d G D j m h y‖ ≤ ‖y‖ := by
  set v := (D.getD j (true, 0, none)).1
  set Q : Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) := fun p =>
    ((ap.cumBase (T.cat (cslot c d v)) T.hR (T.hbc _)).withMask
      (T.cmpMask c d G v D j p)).proj h with hQ
  set z := T.histOp c d G D j v h y
  have hb := padFamC_bessel Q (fun p => ColumnDepthFamily.isStarProjection_proj _ _)
    (fun p p' hpp => ap.gPad_nested _ T.hR (T.hbc _) _ G _ _ hpp h) z
  have e : T.bandDiff c d G D j m h y = (padFamC Q (m + 1) - padFamC Q m) z := by
    unfold bandDiff bandOp
    simp only [sub_apply, ContinuousLinearMap.comp_apply]
    rfl
  rw [e]
  refine le_trans ?_ (T.histOp_contr c d G D j v h y)
  by_cases hm : m < ap.P + 1
  · have h1 := Finset.single_le_sum (f := fun n => ‖(padFamC Q (n + 1) - padFamC Q n) z‖ ^ 2)
      (fun _ _ => sq_nonneg _) (Finset.mem_range.mpr hm)
    exact (pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _) two_ne_zero).mp (h1.trans hb)
  · have h1 : padFamC Q (m + 1) = padFamC Q m := by
      unfold padFamC
      have : ¬ m - 1 < ap.P := by omega
      have : ¬ m + 1 - 1 < ap.P := by omega
      simp only [show m + 1 ≠ 0 by omega, show m ≠ 0 by omega, ite_false, *, ↓reduceDIte]
    rw [h1, sub_self, zero_apply, norm_zero]
    exact norm_nonneg _

