open Classical in
/-- The physical embedding of scalar inputs is additive. -/
theorem physicalColumnInput_add {V : Type*} [Fintype V] (f g : Lp ℂ 2 (volume : Measure ℝ)) :
    physicalColumnInput (V := V) (f + g) =
      physicalColumnInput (V := V) f + physicalColumnInput (V := V) g :=
  map_add ((ContinuousLinearMap.toSpanSingleton ℂ
    (EuclideanSpace.single (none : Option V) (1 : ℂ))).compLpL 2 volume) f g

open Classical in
/-- The physical embedding of scalar inputs vanishes at zero. -/
theorem physicalColumnInput_zero {V : Type*} [Fintype V] :
    physicalColumnInput (V := V) (0 : Lp ℂ 2 (volume : Measure ℝ)) = 0 :=
  map_zero ((ContinuousLinearMap.toSpanSingleton ℂ
    (EuclideanSpace.single (none : Option V) (1 : ℂ))).compLpL 2 volume)

