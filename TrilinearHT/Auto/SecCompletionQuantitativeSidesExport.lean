/-- The complement value after cell transfer steps is a contraction. -/
theorem norm_chainVal_cell_le (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (v : Bool) :
    ∀ (D : List (Bool × ℕ × Option ℕ)) (y : ColumnL2 (Fin ap.Mc)),
      ‖chainVal ap.P v ((D.map fun e => ap.cellStep cat hcat rH s c d G I e).map padStep) y‖ ≤
        ‖y‖
  | [], y => le_rfl
  | e :: D, y => by
    rw [List.map_cons, List.map_cons, chainVal]
    split_ifs
    · refine le_trans ?_ (norm_chainVal_cell_le cat hcat rH s c d G I v D y)
      change ‖filterAvg ap.P (padFam (ap.cellStep cat hcat rH s c d G I e).2.2) _‖ ≤ _
      rw [filterAvg_padFam]
      exact norm_opAvg_apply_le _ (fun _ z => norm_catProj_le _ _ _ _ _ _ z) _
    · exact norm_chainVal_cell_le cat hcat rH s c d G I v D y

/-- The bands of the global complement pads of a step at the depth `h`, restricted to an active
cell at most that deep, are Bessel. -/
theorem compBand_bessel (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (r : ℕ) (G : A.Grp) (j : ℕ) (e : Option ℕ) (h : ℤ)
    (J : ℤ × ℤ) (hJ : J.1 ≤ h) (hJN : J.1 ≤ A.R.1 + A.treeDepth) (y : ColumnL2 (Fin ap.Mc)) :
    ∑ n ∈ Finset.range (ap.P + 1), ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2)
      (dyadicGridCell_measurable A.G J.1 J.2)
      ((padFamC (fun p : Fin ap.P => ((ap.cumBase catl hR hb).withMask (ap.gMask catl hR hb r
        (ap.stepMask G j e p) (ap.stepMask_mono G j e p))).proj h) (n + 1) -
       padFamC (fun p : Fin ap.P => ((ap.cumBase catl hR hb).withMask (ap.gMask catl hR hb r
        (ap.stepMask G j e p) (ap.stepMask_mono G j e p))).proj h) n) y)‖ ^ 2 ≤
      ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
        y‖ ^ 2 := by
  set rJ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G J.1 J.2)
    (dyadicGridCell_measurable A.G J.1 J.2)
  set Qg : Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) := fun p =>
    ((ap.cumBase catl hR hb).withMask (ap.gMask catl hR hb r
      (ap.stepMask G j e p) (ap.stepMask_mono G j e p))).proj h with hQg
  have hd : ∀ M : InheritedColumnMask (ap.cumBase catl hR hb).D,
      J.1 ≤ ((ap.cumBase catl hR hb).withMask M).depth h := fun M => by
    change J.1 ≤ max (ap.cumBase catl hR hb).D.root.1 (min h (A.R.1 + A.treeDepth))
    exact le_max_of_le_right (le_min hJ hJN)
  have hpad : ∀ p, (Qg p).comp rJ = rJ.comp (Qg p) := fun p =>
    (((ap.cumBase catl hR hb).withMask _).proj_commute_restrict h (hd _)).symm
  have hQ : ∀ n, rJ.comp (padFamC Qg n) = (padFamC Qg n).comp rJ := by
    intro n
    unfold padFamC
    split_ifs
    · simp
    · exact (hpad _).symm
    · simp
  have he : ∀ n, rJ ((padFamC Qg (n + 1) - padFamC Qg n) y) =
      (padFamC Qg (n + 1) - padFamC Qg n) (rJ y) := fun n => by
    rw [sub_apply, sub_apply, map_sub, ← ContinuousLinearMap.comp_apply, hQ,
      ← ContinuousLinearMap.comp_apply rJ, hQ]
    rfl
  simp_rw [he]
  exact padFamC_bessel Qg (fun p => ColumnDepthFamily.isStarProjection_proj _ _)
    (fun p p' hpp => ap.gPad_nested catl hR hb r G j e hpp h) (rJ y)

