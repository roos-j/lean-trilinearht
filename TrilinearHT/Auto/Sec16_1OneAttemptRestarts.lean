      (∀ m ∈ Ms, ∀ j, j ≠ a → j ≠ b → j ≠ c → ∀ c' ∈ U m, ∀ d ∈ A.cells,
        dyadicGridCell A.G c'.1 c'.2 ⊆ dyadicGridCell A.G d.1 d.2 → bs m ≤ d.1 →
