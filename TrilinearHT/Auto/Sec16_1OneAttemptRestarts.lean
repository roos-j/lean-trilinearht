theorem near_band_stacks (κ : LocalKernelClass) {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) :
    ∃ Cq : ℝ, 0 ≤ Cq ∧ ∀ {c₀ : ℕ} (A : ActiveSetup κ c₀) (ap : A.AttemptParams) (K Nd : ℕ),
