    (fun I => dyadicGridLength A.G I.1) (fun I => (dyadicGridLength_pos A.G I.1).le)
    (fun m I => ∑ p ∈ ap.uo m.1.2.2.2.2.2, ap.Λc I (Function.update (Function.update
      (Function.update (Fm m) a (Xs m p I.1)) b (Ws m I)) e (Ym m p))) hX0
    (by have := div_nonneg hEA0 hR0.le; positivity) (by have := div_nonneg hEB0 hR0.le; positivity)
    hR0.le hsum
