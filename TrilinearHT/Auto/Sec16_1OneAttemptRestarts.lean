    linarith
  · have hd : 0 < 1 / (32 * (C₅ + 1)) := by positivity
    have hq1 : (2 + 1 / (32 * (C₅ + 1)) - 1) ≥ 1 := by linarith
    have hfrac : (2 + 1 / (32 * (C₅ + 1)) - 2) / (2 + 1 / (32 * (C₅ + 1)) - 1) ≤
        1 / (32 * (C₅ + 1)) := by
      rw [div_le_iff₀ (by linarith)]
      nlinarith
    calc 2 * C₅ * ((2 + 1 / (32 * (C₅ + 1)) - 2) / (2 + 1 / (32 * (C₅ + 1)) - 1)) ≤
        2 * C₅ * (1 / (32 * (C₅ + 1))) := by gcongr
      _ = C₅ / (16 * (C₅ + 1)) := by field_simp; ring
      _ < 1 / 8 := by
          rw [div_lt_iff₀ (by positivity)]; nlinarith

section StoppingGenerations
variable {α : Type*} [DecidableEq α] (C : Finset α) (cell : α → Set ℝ)
  (bad : α → α → Prop) [∀ J K, Decidable (bad J K)]

/-! Abstract stopping generations for blueprint `thm:uniform-local`, lines 2910-2925: a finite
laminar family of nonempty cells, roots, and a stopping relation `bad J K` ("`K` violates the
averages of `J`"). -/

/-- The first stops of `J`: maximal cells of `C` strictly inside `J` violating `J`. -/
noncomputable def firstStops (J : α) : Finset α := by
  classical exact (C.filter fun K => cell K ⊂ cell J ∧ bad J K).filter fun K =>
    ¬∃ L ∈ C, cell K ⊂ cell L ∧ cell L ⊂ cell J ∧ bad J L

/-- The stopping generations, starting from the roots. -/
noncomputable def stopGen (roots : Finset α) : ℕ → Finset α
  | 0 => roots
  | k + 1 => (stopGen roots k).biUnion (firstStops C cell bad)

variable {C cell bad}

omit [DecidableEq α] in
theorem mem_firstStops {J K : α} :
    K ∈ firstStops C cell bad J ↔ (K ∈ C ∧ cell K ⊂ cell J ∧ bad J K) ∧
      ¬∃ L ∈ C, cell K ⊂ cell L ∧ cell L ⊂ cell J ∧ bad J L := by
  classical
  simp only [firstStops, Finset.mem_filter, and_assoc]

omit [DecidableEq α] in
theorem firstStops_subset (J : α) : firstStops C cell bad J ⊆ C := fun _ hK =>
  (mem_firstStops.mp hK).1.1

theorem stopGen_subset {roots : Finset α} (hr : roots ⊆ C) :
    ∀ k, stopGen C cell bad roots k ⊆ C
  | 0 => hr
  | k + 1 => by
    intro K hK
    obtain ⟨P, -, hP⟩ := Finset.mem_biUnion.mp hK
    exact firstStops_subset P hP

end StoppingGenerations

/-! ### Normalized absorption from the active-final estimate (prop:normalized, lines 2827-2904) -/

/-- For `θ > 0`, eventually in `k`, `k^{C} e^{-2 k^θ} ≤ e^{-k^θ}`. -/
theorem eventually_pow_mul_exp_le (C : ℕ) {θ : ℝ} (hθ : 0 < θ) :
    ∃ K : ℕ, ∀ k : ℕ, K ≤ k → (k : ℝ) ^ C * Real.exp (-2 * (k : ℝ) ^ θ) ≤
      Real.exp (-(k : ℝ) ^ θ) := by
  have ho := _root_.isLittleO_log_rpow_atTop hθ
  have hev := ho.bound (show (0 : ℝ) < 1 / ((C : ℝ) + 1) by positivity)
  have hev' := (tendsto_natCast_atTop_atTop (R := ℝ)).eventually
    (hev.and (Filter.eventually_ge_atTop 1))
  obtain ⟨K, hK⟩ := Filter.eventually_atTop.mp hev'
  refine ⟨K, fun k hk => ?_⟩
  obtain ⟨hb, hk1⟩ := hK k hk
  have hkpos : (0 : ℝ) < k := by linarith
  have hlog0 : 0 ≤ Real.log k := Real.log_nonneg hk1
  have hθpos : 0 ≤ (k : ℝ) ^ θ := Real.rpow_nonneg hkpos.le θ
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hlog0, abs_of_nonneg hθpos] at hb
  have hC : (C : ℝ) * Real.log k ≤ (k : ℝ) ^ θ := by
    have h1 : ((C : ℝ) + 1) * Real.log k ≤ (k : ℝ) ^ θ := by
      have := mul_le_mul_of_nonneg_left hb (show (0 : ℝ) ≤ (C : ℝ) + 1 by positivity)
      rwa [← mul_assoc, mul_one_div_cancel (by positivity), one_mul] at this
    nlinarith
  have hpow : (k : ℝ) ^ C = Real.exp ((C : ℝ) * Real.log k) := by
    rw [← Real.exp_log (pow_pos hkpos C), Real.log_pow]
  rw [hpow, ← Real.exp_add, Real.exp_le_exp]
  linarith

namespace ActiveSetup
