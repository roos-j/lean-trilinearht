/-- Collapsing the block and group indices of the uses of a cell. -/
theorem sum_Ms_collapse (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp)
    (Lp Jm Bn : ℕ) (C₀ : ℝ) (a b : Fin 4) {I : ℤ × ℤ} (hI : I ∈ S) (hgs : gs I ⊆ gset)
    (hBn : T.bk I < Bn) (g : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ → ℝ) :
    ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn), (if I ∈ S ∧ m.2.1 ∈ gs I ∧
        T.bk I = m.2.2 ∧ T.Val a b m.1.1 m.1.2.1 ∧
        ¬ T.Ucase I m.1.1 m.1.2.1 ∧ m.1.2.2.1 < (T.pe m.1.1).length ∧
        m.1.2.2.2.1 < (T.pe m.1.2.1).length ∧
        m.1.2.2.2.2.1 < (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
          (T.tOf m.1.2.1 m.1.2.2.2.1)).length ∧
        T.unfl C₀ I m.2.1 m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1)
          m.1.2.2.2.2.1 m.1.2.2.2.2.2 then g m else 0) =
      ∑ G ∈ gs I, ∑ ω ∈ nOs Lp Jm, (if T.Val a b ω.1 ω.2.1 ∧
        ¬ T.Ucase I ω.1 ω.2.1 ∧ ω.2.2.1 < (T.pe ω.1).length ∧
        ω.2.2.2.1 < (T.pe ω.2.1).length ∧
        ω.2.2.2.2.1 < (T.desc ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)).length ∧
        T.unfl C₀ I G ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)
          ω.2.2.2.2.1 ω.2.2.2.2.2 then g (ω, G, T.bk I) else 0) := by
  rw [Finset.sum_comm (s := gs I), Finset.sum_product]
  refine Finset.sum_congr rfl fun ω _ => ?_
  rw [Finset.sum_product]
  refine ((Finset.sum_subset hgs ?_).symm).trans (Finset.sum_congr rfl fun G hG => ?_)
  · intro G _ hG
    refine Finset.sum_eq_zero fun β _ => ?_
    split_ifs with h
    · exact absurd h.2.1 hG
    · rfl
  · rw [Finset.sum_eq_single (T.bk I)]
    · simp only [hI, hG, true_and]
    · intro β _ hβ
      split_ifs with h
      · exact absurd h.2.2.1.symm hβ
      · rfl
    · intro h; exact absurd (Finset.mem_range.mpr hBn) h

open Classical in
/-- Expanding the outer indices of the uses of a cell and group into the slot, chain, step and
offset sums. -/
theorem sum_nOs_expand (Lp Jm : ℕ) (C₀ : ℝ) (a b : Fin 4) (I : ℤ × ℤ) (G : A.Grp)
    (hLp : ∀ l, (T.pe l).length ≤ Lp)
    (hJm : ∀ c d i i', (T.desc c d (T.tOf c i) (T.tOf d i')).length ≤ Jm)
    (g : Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ → ℝ) :
    ∑ ω ∈ nOs Lp Jm, (if T.Val a b ω.1 ω.2.1 ∧
        ¬ T.Ucase I ω.1 ω.2.1 ∧ ω.2.2.1 < (T.pe ω.1).length ∧
        ω.2.2.2.1 < (T.pe ω.2.1).length ∧
        ω.2.2.2.2.1 < (T.desc ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)).length ∧
        T.unfl C₀ I G ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)
          ω.2.2.2.2.1 ω.2.2.2.2.2 then g ω else 0) =
      ∑ c : Fin 4, ∑ d : Fin 4, (if T.Val a b c d ∧ ¬ T.Ucase I c d then
        ∑ i' ∈ Finset.range (T.pe d).length, ∑ i ∈ Finset.range (T.pe c).length,
          ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
            ∑ o ∈ Finset.range 5, (if T.unfl C₀ I G c d (T.tOf c i) (T.tOf d i') j o then
              g (c, d, i, i', j, o) else 0) else 0) := by
  simp only [nOs, Finset.sum_product]
  refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
  by_cases hV : T.Val a b c d ∧ ¬ T.Ucase I c d
  · rw [ite_eq_left_of_eq_true _ _ (eq_true hV), Finset.sum_comm, ← sum_range_ite_lt (hLp d)]
    refine Finset.sum_congr rfl fun i' _ => ?_
    by_cases hi' : i' < (T.pe d).length
    · rw [ite_eq_left_of_eq_true _ _ (eq_true hi'), ← sum_range_ite_lt (hLp c)]
      refine Finset.sum_congr rfl fun i _ => ?_
      by_cases hi : i < (T.pe c).length
      · rw [ite_eq_left_of_eq_true _ _ (eq_true hi), ← sum_range_ite_lt (hJm c d i i')]
        refine Finset.sum_congr rfl fun j _ => ?_
        by_cases hj : j < (T.desc c d (T.tOf c i) (T.tOf d i')).length
        · simp only [hV.1, hV.2, hi, hi', hj, true_and, not_false_eq_true, ↓reduceIte]
        · simp only [hj, false_and, and_false, ite_false, Finset.sum_const_zero]
      · simp only [hi, false_and, and_false, ite_false, Finset.sum_const_zero]
    · simp only [hi', false_and, and_false, ite_false, Finset.sum_const_zero]
  · rw [ite_eq_right_of_eq_false _ _ (eq_false hV)]
    refine Finset.sum_eq_zero fun i _ => Finset.sum_eq_zero fun i' _ =>
      Finset.sum_eq_zero fun j _ => Finset.sum_eq_zero fun o _ => ?_
    rw [ite_eq_right_of_eq_false _ _ (eq_false fun h => hV ⟨h.1, h.2.1⟩)]

/-- The frozen complement bands at the block start of a cell. -/
noncomputable def Ybk (I : ℤ × ℤ) (G : A.Grp) (c d : Fin 4) (t t' : List ℕ) (j o p : ℕ) :
    ColumnL2 (Fin ap.Mc) :=
  T.Y c d G t t' j o (T.D.blockOf I.1) p

/-- The frozen other complement at the block start of a cell. -/
noncomputable def Fbk (I : ℤ × ℤ) (G : A.Grp) (c d : Fin 4) (t t' : List ℕ) (j : ℕ) :
    ColumnL2 (Fin ap.Mc) :=
  T.F c d G t t' j (T.D.blockOf I.1)

open Classical in
/-- The frozen near band parts of a cell, summed over its groups and slot tuples, are `2/P` times
    the
use indicator sums of the near band applications over the slot triples `(a, b, e)`. -/
theorem near_cell_eq (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp)
    (Lp Jm Bn : ℕ) (C₀ : ℝ) {I : ℤ × ℤ} (hI : I ∈ S) (hgs : gs I ⊆ gset) (hBn : T.bk I < Bn)
    (hLp : ∀ l, (T.pe l).length ≤ Lp)
    (hJm : ∀ c d i i', (T.desc c d (T.tOf c i) (T.tOf d i')).length ≤ Jm) :
    ∑ G ∈ gs I, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4, ∑ d : Fin 4,
      T.nearPart I G a b c d T.Ybk T.Fbk (T.unfl C₀) =
    2 / (ap.P : ℝ) * ∑ a : Fin 4, ∑ b : Fin 4, ∑ e : Fin 4,
      ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn),
        (if I ∈ T.nU S gs C₀ a b e m then ‖T.nf a b m.1.1 m.1.2.1 m.2.1 I (T.tOf m.1.1 m.1.2.2.1)
          (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1 m.1.2.2.2.2.2‖ else 0) := by
  have hR : ∀ a b : Fin 4, ∑ e : Fin 4, ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn),
      (if I ∈ T.nU S gs C₀ a b e m then ‖T.nf a b m.1.1 m.1.2.1 m.2.1 I (T.tOf m.1.1 m.1.2.2.1)
        (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1 m.1.2.2.2.2.2‖ else 0) =
      ∑ G ∈ gs I, ∑ c : Fin 4, ∑ d : Fin 4, (if T.Val a b c d ∧ ¬ T.Ucase I c d then
        ∑ i' ∈ Finset.range (T.pe d).length, ∑ i ∈ Finset.range (T.pe c).length,
          ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
            ∑ o ∈ Finset.range 5, (if T.unfl C₀ I G c d (T.tOf c i) (T.tOf d i') j o then
              ‖T.nf a b c d G I (T.tOf c i) (T.tOf d i') j o‖ else 0) else 0) := by
    intro a b
    rw [T.sum_e_nU, T.sum_Ms_collapse S gs gset Lp Jm Bn C₀ a b hI hgs hBn]
    exact Finset.sum_congr rfl fun G _ => T.sum_nOs_expand Lp Jm C₀ a b I G hLp hJm _
  have hL : ∀ G a b c d, T.nearPart I G a b c d T.Ybk T.Fbk (T.unfl C₀) =
      2 / (ap.P : ℝ) * (if T.Val a b c d ∧ ¬ T.Ucase I c d then
        ∑ i' ∈ Finset.range (T.pe d).length, ∑ i ∈ Finset.range (T.pe c).length,
          ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
            ∑ o ∈ Finset.range 5, (if T.unfl C₀ I G c d (T.tOf c i) (T.tOf d i') j o then
              ‖T.nf a b c d G I (T.tOf c i) (T.tOf d i') j o‖ else 0) else 0) := by
    intro G a b c d
    unfold nearPart
    split_ifs with h
    · unfold nearAbs
      rw [list_map_sum_range _ (0, []), Finset.mul_sum]
      refine Finset.sum_congr rfl fun i' _ => ?_
      rw [list_map_sum_range _ (0, []), Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.mul_sum]
      rfl
    · rw [mul_zero]
  simp_rw [hL, hR, ← Finset.mul_sum]
  congr 1
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.sum_comm]

/-- The critical absolute bound of one near band application (`near_triple_U`). -/
noncomputable def nearBnd {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) (N Lp Jm Bn : ℕ)
    (gset : Finset A.Grp) (C₀ ρ BA EWa EU : ℝ) : ℝ :=
  8 / 7 * (nbCU κ' hq2 hq3 * (1 + finiteDepthConstant κ' q T.D.S.K) *
      (1 + Real.log ((T.D.S.K : ℝ) + 2)) *
      ((T.D.S.K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) * (64 * (2 * C₀) * (2 * C₀))) *
    Real.sqrt ((hullCutConstant (ρ / 2) * ((1 : ℕ) *
        (T.nearEA Lp Jm N BA EWa / dyadicGridLength A.G A.R.1)) *
        (1 + Real.log (2 + ((nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn)).card *
          (N + 1) * 1 : ℕ)))) *
      (hullCutConstant (ρ / 2) * ((N + 1 : ℕ) *
        ((nOs Lp Jm).card * EU / dyadicGridLength A.G A.R.1)) *
        (1 + Real.log (2 + ((nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn)).card *
          (N + 1) * 1 : ℕ))))) *
    dyadicGridLength A.G A.R.1

