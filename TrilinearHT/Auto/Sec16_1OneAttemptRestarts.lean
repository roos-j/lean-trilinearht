  refine ⟨2 + 1 / (32 * (C₅ + 1)), ?_, ?_, ?_⟩
  · have : 0 < 1 / (32 * (C₅ + 1)) := by positivity
    linarith
  · have : 1 / (32 * (C₅ + 1)) ≤ 1 / 32 := by
