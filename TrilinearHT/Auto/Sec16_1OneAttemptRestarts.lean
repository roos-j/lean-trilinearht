  obtain ⟨Cq, hCq, hnc⟩ := near_band_cut κ hq2 hq3
  refine ⟨Cq, hCq, ?_⟩
  intro c₀ A ap K Nd hKN hK hanc M Ms U bs hUc hUb Ka Kb _ _ ι κ' β u a b c hab hac hbc F Y va vb
    actA selA valA actB selB valB hrepA hrepB Ea Eb ρ hEa hEb hρ hρ1 hXe hWe Bc Bd hBc hBd hYb hFb
