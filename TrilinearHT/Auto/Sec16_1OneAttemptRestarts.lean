/-- The constant of `near_band_positions`. -/
noncomputable def nbC (κ : LocalKernelClass) {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) : ℝ :=
  Classical.choose (near_band_positions κ hq2 hq3)

namespace ActiveSetup

namespace AttemptParams

namespace TTData
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (T : ap.TTData)

/-- The banded stack energy budget of the near applications (`bandStack_outer`). -/
noncomputable def nearEA (Lp Jm N : ℕ) (B EW : ℝ) : ℝ :=
  ∑ ω ∈ nOs Lp Jm, (N * (2 * B + 16 * (ap.P + 2) * (ap.bandJumpC T.hcat T.hR T.hbh ω.2.2.2.2.1 * EW)
      +
    16 * (ap.P + 2) * (N * (ap.bandJumpC T.hcat T.hR T.hbh ω.2.2.2.2.1 * (N * B)))) + EW)

/-- The untouched stack energy budget of the near applications (`posStack_outer`). -/
noncomputable def nearEB (Lp Jm N : ℕ) (B EW : ℝ) : ℝ := ∑ _ω ∈ nOs Lp Jm, (N * B + EW)

open Classical in
/-- Blueprint lines 2400-2456 (`eq:near-band`) for the slots `a, b` and the banded complement slot
`e`, with `b` basic: off a cut family of root fraction `ρ`, the weighted frozen near band forms of
the unflagged uses are at most the critical absolute bound of `near_band_positions` with the
stack energies of `bandStack_outer` and `posStack_outer` and the complement bounds `2 C₀`. -/
theorem near_triple {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) {a b e : Fin 4} (hab : a ≠ b)
    (hae : a ≠ e) (hbe : b ≠ e) (hanc : A.AncClosed) (hK1 : 1 ≤ T.D.S.K) {N : ℕ}
    (hKN : T.D.S.K ≤ 2 ^ N) (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells)
    (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp) (Lp Jm Bn : ℕ)
    (hbas : ∀ l, ¬ T.D.usl l → ∀ I ∈ A.cells, ap.z I l = A.B l I ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        A.B l I y = (T.P₁ l).val I y - (T.P₂ l).val I y)
    (hdc : ∀ I ∈ S, T.D.hasDecision I → T.D.dcell I ∈ A.cells) (hbu : ¬ T.D.usl b)
    {okA okB : A.Grp → ℤ × ℤ → Prop} {BA BB : ℝ}
    (hcapA : A.VarCap gset (fun G h => LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G
      (T.P₁ a) (T.P₂ a) h) okA BA)
    (hcapB : A.VarCap gset (fun G h => LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s b G
      (T.P₁ b) (T.P₂ b) h) okB BB)
    (hok : ∀ I ∈ S, ∀ G ∈ gs I, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okA G J ∧ okB G J)
    {EWa EWb : ℝ}
    (hEWa : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖columnL2Restriction
      (⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
        (fun I => ancAt A.G I (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (T.gside a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤
        EWa)
    (hEWb : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖columnL2Restriction
      (⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
        (fun I => ancAt A.G I (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (T.gside b G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤
        EWb)
    {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ A.cells ∧
      dyadicRootLength A.G (maximalDyadicCells A.G C) ≤ ρ * dyadicGridLength A.G A.R.1 ∧
      ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn), ∑ I ∈ (T.nU S gs C₀ a b e m).filter
          (fun I => ¬ ∃ e' ∈ C, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
        dyadicGridLength A.G I.1 * ‖T.nf a b m.1.1 m.1.2.1 m.2.1 I (T.tOf m.1.1 m.1.2.2.1)
          (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1 m.1.2.2.2.2.2‖ ≤
      8 / 7 * (nbC κ' hq2 hq3 * (1 + finiteDepthConstant κ' q T.D.S.K) *
          (1 + Real.log ((T.D.S.K : ℝ) + 2)) *
          ((T.D.S.K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) * (64 * (2 * C₀) * (2 * C₀))) *
        Real.sqrt ((hullCutConstant (ρ / 2) * ((N + 1 : ℕ) *
            (T.nearEA Lp Jm N BA EWa / dyadicGridLength A.G A.R.1)) *
            (1 + Real.log (2 + ((nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn)).card *
              (N + 1) * (N + 1) : ℕ)))) *
          (hullCutConstant (ρ / 2) * ((N + 1 : ℕ) *
            (nearEB Lp Jm N BB EWb / dyadicGridLength A.G A.R.1)) *
            (1 + Real.log (2 + ((nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn)).card *
              (N + 1) * (N + 1) : ℕ))))) *
        dyadicGridLength A.G A.R.1 := by
  classical
  have hR0 := dyadicGridLength_pos A.G A.R.1
  have hRle : ∀ I ∈ A.cells, A.R.1 ≤ I.1 := fun I hI => dyadicGridCell_depth_le_of_subset A.G I A.R
    ((dyadicFiniteTree_mem_iff A.G A.R I A.treeDepth).mp (A.cells_mem_tree hI)).1
  set K := T.D.S.K with hKdef
  set Ms := nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn) with hMs
  set U : A.Grp → ℕ → Finset (ℤ × ℤ) := fun g β => S.filter fun I => g ∈ gs I ∧ T.bk I = β
    with hUdef
  set Ah : Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ → A.Grp → ℕ → ℤ →
      (ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) := fun ω g n h =>
    T.hAh ω.1 ω.2.1 g (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1) ω.2.2.2.2.1 n h with hAhdef
  have hU : ∀ g β, ∀ I ∈ U g β, I ∈ A.cells ∧ I.1 = A.R.1 + ((K * β + T.offI I : ℕ) : ℤ) ∧
      T.offI I < K := by
    intro g β I hI
    obtain ⟨hIS, -, hβ⟩ := Finset.mem_filter.mp hI
    have h := T.bk_offI hK1 (hRle I (hS hIS))
    rw [← hβ]
    exact ⟨hS hIS, h.1, h.2.1⟩
  have hoff : ∀ (J : ℤ × ℤ) (β m : ℕ), m < K → J.1 = A.R.1 + ((K * β + m : ℕ) : ℤ) →
      T.offI J = m := fun J β m hm hJ => T.offI_eq hK1 J β m hm hJ
  have hokA : ∀ g ∈ gset, ∀ β, ∀ I ∈ U g β, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okA g J :=
    fun g _ β I hI J hJ hsub => (hok I (Finset.mem_filter.mp hI).1 g
      (Finset.mem_filter.mp hI).2.1 J hJ hsub).1
  have hokB : ∀ g ∈ gset, ∀ β, ∀ I ∈ U g β, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okB g J :=
    fun g _ β I hI J hJ hsub => (hok I (Finset.mem_filter.mp hI).1 g
      (Finset.mem_filter.mp hI).2.1 J hJ hsub).2
  have hbes : ∀ ω g h y, ∑ p ∈ Finset.range (ap.P + 1),
      ‖(Ah ω g (p + 1) h - Ah ω g p h) y‖ ^ 2 ≤ ‖y‖ ^ 2 := fun ω g h y =>
    ap.bandPads_bessel T.hcat T.hR T.hbh _ _
      (ap.hMask_nested T.hcat T.hR T.hbh T.rH T.s _ _ g _ _) h y
  have hcomm : ∀ ω g n h (J : ℤ × ℤ), J.1 ≤ h → J.1 ≤ A.R.1 + A.treeDepth →
      (columnL2Restriction (dyadicGridCell A.G J.1 J.2)
        (dyadicGridCell_measurable A.G J.1 J.2)).comp (Ah ω g n h) =
        (Ah ω g n h).comp (columnL2Restriction (dyadicGridCell A.G J.1 J.2)
          (dyadicGridCell_measurable A.G J.1 J.2)) := fun ω g n h J hJ hJN =>
    ap.bandPads_comm T.hcat T.hR T.hbh _ _ n h J hJ hJN
  have hJ : ∀ ω, ∀ g ∈ gset, ∀ n, ∀ {ι : Type} [Fintype ι] (r t : ι → ℕ), (∀ i, r i ≤ t i) →
      (∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i'))) →
      ∀ Ec : ι → Finset (ℤ × ℤ), (∀ i, ∀ J ∈ Ec i, J ∈ A.cells) → ∀ x,
      ∑ i, ‖columnL2Restriction (⋃ J ∈ Ec i, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        ((Ah ω g n (A.R.1 + t i) - Ah ω g n (A.R.1 + r i)) x)‖ ^ 2 ≤
          ap.bandJumpC T.hcat T.hR T.hbh ω.2.2.2.2.1 * ‖x‖ ^ 2 :=
    fun ω g _ n ι _ r t hrt hdis Ec hEc x =>
      ap.bandPads_jump T.hcat T.hR T.hbh _ _ n r t hrt hdis Ec hEc x
  have hXe := A.bandStack_outer hanc (nOs Lp Jm) gset _ okA hcapA hKN (Finset.range Bn) U T.offI
    hoff hU hokA Ah hbes hcomm (fun ω => ap.bandJumpC T.hcat T.hR T.hbh ω.2.2.2.2.1)
    (fun ω => ap.bandJumpC_nonneg T.hcat T.hR T.hbh _) hJ
    (fun g β => T.gside a g (A.R.1 + ((K * β : ℕ) : ℤ)) (A.R.1 + ((K * β : ℕ) : ℤ))) hEWa
    (fun g β h => T.gside a g (A.R.1 + ((K * β : ℕ) : ℤ)) h)
    (fun g β h => T.D.gSide_eq T.cat T.hR T.hbc T.s a g _ _ _ h) Ms subset_rfl
    (T.nU S gs C₀ a b e) (fun m _ I hI => Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hI).1,
      (Finset.mem_filter.mp hI).2.1, (Finset.mem_filter.mp hI).2.2.1⟩)
    (fun m => ap.uo m.1.2.2.2.2.2) (fun m _ => ap.uo_sub _)
  have hWe := A.posStack_outer hanc (nOs Lp Jm) gset _ okB hcapB hKN (Finset.range Bn) U T.offI
    hU hokB (fun g β h => T.gside b g (A.R.1 + ((K * β : ℕ) : ℤ)) h)
    (fun g β h h' => by
      unfold gside
      rw [T.D.gSide_eq T.cat T.hR T.hbc T.s b g _ _ _ h,
        T.D.gSide_eq T.cat T.hR T.hbc T.s b g _ _ _ h']
      abel) hEWb Ms subset_rfl
    (T.nU S gs C₀ a b e) (fun m _ I hI => Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hI).1,
      (Finset.mem_filter.mp hI).2.1, (Finset.mem_filter.mp hI).2.2.1⟩)
  have hEA0 : 0 ≤ T.nearEA Lp Jm N BA EWa := le_trans (Finset.sum_nonneg fun _ _ =>
    Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ =>
      sq_nonneg _) hXe
  have hEB0 : 0 ≤ nearEB Lp Jm N BB EWb := le_trans (Finset.sum_nonneg fun _ _ =>
    Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _) hWe
  -- the block starts of the uses
  have hbs : ∀ m ∈ Ms, ∀ I ∈ T.nU S gs C₀ a b e m,
      T.D.blockOf I.1 = A.R.1 + ((K * m.2.2 : ℕ) : ℤ) ∧
      I.1 = A.R.1 + ((K * m.2.2 : ℕ) : ℤ) + (T.offI I : ℤ) ∧ T.offI I < K := by
    intro m _ I hI
    have hm := Finset.mem_filter.mp hI
    have h := T.bk_offI hK1 (hRle I (hS hm.1))
    rw [hm.2.2.1] at h
    refine ⟨h.2.2, ?_, h.2.1⟩
    rw [h.1]
    push_cast
    ring
  set Fm : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ → Fin 4 → ColumnL2 (Fin ap.Mc) :=
    fun m => Function.update 0 (fSlot m.1.1 m.1.2.1 (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
      (T.tOf m.1.2.1 m.1.2.2.2.1)) m.1.2.2.2.2.1)
      (T.F m.1.1 m.1.2.1 m.2.1 (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1
        (A.R.1 + ((K * m.2.2 : ℕ) : ℤ))) with hFm
  set Ym : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ → ℕ → ColumnL2 (Fin ap.Mc) :=
    fun m p => T.Y m.1.1 m.1.2.1 m.2.1 (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1)
      m.1.2.2.2.2.1 m.1.2.2.2.2.2 (A.R.1 + ((K * m.2.2 : ℕ) : ℤ)) p with hYm
  set Xs : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ → ℕ → ℤ → ColumnL2 (Fin ap.Mc) :=
    fun m p h => (Ah m.1 m.2.1 (p + 1) h - Ah m.1 m.2.1 p h)
      (T.gside a m.2.1 (A.R.1 + ((K * m.2.2 : ℕ) : ℤ)) h) with hXs
  set Ws : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ → ℤ → ColumnL2 (Fin ap.Mc) :=
    fun m h => T.gside b m.2.1 (A.R.1 + ((K * m.2.2 : ℕ) : ℤ)) h with hWs
  have hspec := (Classical.choose_spec (near_band_positions κ' hq2 hq3)).2 A ap K K N le_rfl hK1
    hKN hanc Ms (T.nU S gs C₀ a b e) (fun m => A.R.1 + ((K * m.2.2 : ℕ) : ℤ)) T.offI
