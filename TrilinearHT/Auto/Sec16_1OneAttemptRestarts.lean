/-! ### The quantitative inequality (prop:normalized, blueprint lines 2843-2858) -/

theorem min_add_le {η a b : ℝ} (hη : 0 ≤ η) (ha : 0 ≤ a) (hb : 0 ≤ b) :
    min η (a + b) ≤ min η a + min η b := by
  rcases le_total η a with h | h
  · rw [min_eq_left h]
    exact le_add_of_le_of_nonneg (min_le_left _ _) (le_min hη hb)
  · rw [min_eq_right h]
    rcases le_total η b with h' | h'
    · rw [min_eq_left h']; exact (min_le_left _ _).trans (by linarith)
    · rw [min_eq_right h']; exact min_le_right _ _

/-! ### Choice of `q, α, P` (prop:normalized, blueprint lines 2866-2888) -/

/-- Blueprint lines 2871-2879: with `α = ε/(4(C₄+1))` and `P = ⌈η^{-α}⌉` (`0 < η ≤ 1`),
`η^ε P^{C₄} ≤ 2^{C₄} η^{ε/2}`. -/
theorem eta_power_P_le {ε C₄ η : ℝ} (hε : 0 < ε) (hC₄ : 0 ≤ C₄) (hη0 : 0 < η) (hη1 : η ≤ 1) :
    η ^ ε * (⌈η ^ (-(ε / (4 * (C₄ + 1))))⌉₊ : ℝ) ^ C₄ ≤ 2 ^ C₄ * η ^ (ε / 2) := by
  set α := ε / (4 * (C₄ + 1)) with hα
  have hα0 : 0 < α := by positivity
  have hX1 : 1 ≤ η ^ (-α) := Real.one_le_rpow_of_pos_of_le_one_of_nonpos hη0 hη1 (by linarith)
  have hP : (⌈η ^ (-α)⌉₊ : ℝ) ≤ 2 * η ^ (-α) := by
    have := Nat.ceil_lt_add_one (show 0 ≤ η ^ (-α) by positivity)
    linarith
  have hP0 : 0 ≤ (⌈η ^ (-α)⌉₊ : ℝ) := Nat.cast_nonneg _
  calc η ^ ε * (⌈η ^ (-α)⌉₊ : ℝ) ^ C₄ ≤ η ^ ε * (2 * η ^ (-α)) ^ C₄ := by gcongr
    _ = 2 ^ C₄ * (η ^ ε * η ^ (-α * C₄)) := by
        rw [Real.mul_rpow (by norm_num) (by positivity), ← Real.rpow_mul hη0.le]; ring
    _ = 2 ^ C₄ * η ^ (ε - α * C₄) := by
        rw [← Real.rpow_add hη0]; ring_nf
    _ ≤ 2 ^ C₄ * η ^ (ε / 2) := by
        refine mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hη0 hη1 ?_)
          (by positivity)
        rw [hα]
        have : ε / (4 * (C₄ + 1)) * C₄ ≤ ε / 4 := by
          rw [div_mul_eq_mul_div, div_le_div_iff₀ (by positivity) (by norm_num)]
          nlinarith
        linarith

