  set Ws : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ → ℤ × ℤ → ColumnL2 (Fin ap.Mc) :=
    fun m I => T.side b m.2.1 I with hWs
  have hspec := (Classical.choose_spec (near_band_positions_U κ' hq2 hq3)).2 A ap K K N le_rfl hK1
    hKN hanc Ms (T.nU S gs C₀ a b e) (fun m => A.R.1 + ((K * m.2.2 : ℕ) : ℤ)) T.offI
    (fun m _ I hI => hS (Finset.mem_filter.mp hI).1)
    (fun m hm I hI => ⟨(hbs m hm I hI).2.1, (hbs m hm I hI).2.2⟩)
    (fun m => ap.uo m.1.2.2.2.2.2) hab hae hbe Fm Ym Xs Ws
    (div_nonneg hEA0 hR0.le) (div_nonneg hEB0 hR0.le) hρ hρ1
    (hXe.trans (le_of_eq (div_mul_cancel₀ _ hR0.ne').symm))
    (hWe.trans (le_of_eq (div_mul_cancel₀ _ hR0.ne').symm))
    (by positivity : (0 : ℝ) ≤ 2 * C₀) (by positivity : (0 : ℝ) ≤ 2 * C₀) ?_ ?_
  rotate_left
  · intro m hm I hI J hJ hsub hbJ
    have hu := (Finset.mem_filter.mp hI).2.2.2.2.2.2.2.2.2
    have hblk := (hbs m hm I hI).1
    have h := (hu J hJ hsub (by rw [hblk]; exact hbJ)).1
    rw [hblk] at h
    refine (energyAverage_band_le A.G _ _ J).trans (ENNReal.ofReal_le_ofReal ?_)
    rw [div_le_iff₀ (dyadicGridLength_pos A.G J.1)]
    exact h
  · intro m hm j' hja hjb hje I hI J hJ hsub hbJ
    have hu := (Finset.mem_filter.mp hI).2.2.2.2.2.2.2.2.2
    have hblk := (hbs m hm I hI).1
    have h := (hu J hJ hsub (by rw [hblk]; exact hbJ)).2
    rw [hblk] at h
    refine (energyAverage_single_le A.G _ J).trans (ENNReal.ofReal_le_ofReal ?_)
    rw [div_le_iff₀ (dyadicGridLength_pos A.G J.1)]
    by_cases hjf : j' = fSlot m.1.1 m.1.2.1 (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
      (T.tOf m.1.2.1 m.1.2.2.2.1)) m.1.2.2.2.2.1
    · rw [hjf]
