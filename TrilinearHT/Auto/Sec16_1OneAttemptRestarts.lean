  obtain ⟨C, hCc, hlen, hsum⟩ := hspec
  refine ⟨C, hCc, hlen, ?_⟩
  have hX0 : 0 ≤ nbCU κ' hq2 hq3 * (1 + finiteDepthConstant κ' q K) *
