variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (T : ap.TTData)

/-- The offset of a cell at depth `R.1 + K β + m` with `m < K` is `m`. -/
theorem offI_eq (hK1 : 1 ≤ T.D.S.K) (J : ℤ × ℤ) (β m : ℕ) (hm : m < T.D.S.K)
    (hJ : J.1 = A.R.1 + ((T.D.S.K * β + m : ℕ) : ℤ)) : T.offI J = m := by
  unfold offI
  rw [hJ]
  have hK : (0 : ℤ) < T.D.S.K := by exact_mod_cast hK1
  have : A.R.1 + ((T.D.S.K * β + m : ℕ) : ℤ) - A.R.1 = (m : ℤ) + T.D.S.K * β := by
    push_cast; ring
  rw [this, Int.add_mul_emod_self_left, Int.emod_eq_of_lt (by omega) (by exact_mod_cast hm)]
  simp

/-- The frozen near band form of a use with complements `c, d`, positive chain indices `i, i'`,
step `j` and offset `o`: helper bands of the global side of `a`, the side of `b`, the frozen
complement bands and the frozen other complement. -/
noncomputable def nf (a b c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) (j o : ℕ) : ℂ :=
  ap.nearForm I a b (eSlot c d (T.desc c d t t') j) (fSlot c d (T.desc c d t t') j) 0 (ap.uo o)
    (T.X c d G t t' j I.1 (T.gside a G (T.D.blockOf I.1) I.1))
    (fun p => T.Y c d G t t' j o (T.D.blockOf I.1) p) (T.side b G I)
    (T.F c d G t t' j (T.D.blockOf I.1))

/-- The outer indices `(c, d, i, i', j, o)` of the near band applications. -/
def nOs (Lp Jm : ℕ) : Finset (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) :=
  Finset.univ ×ˢ (Finset.univ ×ˢ (Finset.range Lp ×ˢ (Finset.range Lp ×ˢ
    (Finset.range Jm ×ˢ Finset.range 5))))

open Classical in
/-- The uses of an index `((c, d, i, i', j, o), G, β)` for the slots `a, b` and the banded
complement slot `e`: the cells of `S` of block `β` carrying the group, with an admissible tuple
of basic complements, step `j` banding `e`, and unflagged. -/
noncomputable def nU (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (C₀ : ℝ) (a b e : Fin 4)
    (m : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ) : Finset (ℤ × ℤ) :=
  S.filter fun I => m.2.1 ∈ gs I ∧ T.bk I = m.2.2 ∧ T.Val a b m.1.1 m.1.2.1 ∧
    ¬ T.Ucase I m.1.1 m.1.2.1 ∧ m.1.2.2.1 < (T.pe m.1.1).length ∧
    m.1.2.2.2.1 < (T.pe m.1.2.1).length ∧
    m.1.2.2.2.2.1 < (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
      (T.tOf m.1.2.1 m.1.2.2.2.1)).length ∧
    eSlot m.1.1 m.1.2.1 (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
      (T.tOf m.1.2.1 m.1.2.2.2.1)) m.1.2.2.2.2.1 = e ∧
    T.unfl C₀ I m.2.1 m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1)
      m.1.2.2.2.2.1 m.1.2.2.2.2.2

/-- The helper band operators of the step `j` of the chains `t, t'` of the complements `c, d`. -/
noncomputable def hAh (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j n : ℕ) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  ap.bandPads T.hcat T.hR T.hbh (ap.hMask T.hcat T.hR T.hbh T.rH T.s c d G (T.desc c d t t')) j n h

/-- The frozen near band form of a use with a step `j` banding `e` in terms of the helper band
operators of the global side of `a` and the given value `W` of the slot `b`, if `W` and the side of
`b` agree on the cell. -/
theorem nf_eq {a b c d e : Fin 4} (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) {j : ℕ} (o : ℕ)
    (hj : j < (T.desc c d t t').length) (he : eSlot c d (T.desc c d t t') j = e)
    (W : ColumnL2 (Fin ap.Mc))
    (hW : columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (T.side b G I) = columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) W) :
    T.nf a b c d G I t t' j o = ∑ p ∈ ap.uo o, ap.Λc I (Function.update (Function.update
      (Function.update (Function.update 0 (fSlot c d (T.desc c d t t') j)
        (T.F c d G t t' j (T.D.blockOf I.1))) a
        ((T.hAh c d G t t' j (p + 1) I.1 - T.hAh c d G t t' j p I.1)
          (T.gside a G (T.D.blockOf I.1) I.1))) b W) e
      (T.Y c d G t t' j o (T.D.blockOf I.1) p)) := by
  unfold nf nearForm
  rw [he]
  refine Finset.sum_congr rfl fun p _ => ?_
  have hX : T.X c d G t t' j I.1 (T.gside a G (T.D.blockOf I.1) I.1) p =
      (T.hAh c d G t t' j (p + 1) I.1 - T.hAh c d G t t' j p I.1)
        (T.gside a G (T.D.blockOf I.1) I.1) := by
    unfold X Xband hAh
    rw [ap.gSt_help_band T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G _ hj,
      ap.gSt_help_band T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G _ hj, sub_apply]
  rw [hX]
  refine ap.Λc_congr_restrict I fun l => ?_
  by_cases hle : l = e
  · subst hle; simp only [Function.update_self]
  by_cases hlb : l = b
  · subst hlb; simp only [Function.update_of_ne hle, Function.update_self]; exact hW
  simp only [Function.update_of_ne hle, Function.update_of_ne hlb]

