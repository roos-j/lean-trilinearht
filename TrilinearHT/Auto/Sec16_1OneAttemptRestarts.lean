open Classical in
/-- Collapsing the block and group indices of the uses of a cell. -/
theorem sum_Ms_collapse (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp)
    (Lp Jm Bn : ℕ) (C₀ : ℝ) (a b : Fin 4) {I : ℤ × ℤ} (hI : I ∈ S) (hgs : gs I ⊆ gset)
    (hBn : T.bk I < Bn) (g : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ → ℝ) :
    ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn), (if I ∈ S ∧ m.2.1 ∈ gs I ∧
        T.bk I = m.2.2 ∧ T.Val a b m.1.1 m.1.2.1 ∧
        ¬ T.Ucase I m.1.1 m.1.2.1 ∧ m.1.2.2.1 < (T.pe m.1.1).length ∧
        m.1.2.2.2.1 < (T.pe m.1.2.1).length ∧
        m.1.2.2.2.2.1 < (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
          (T.tOf m.1.2.1 m.1.2.2.2.1)).length ∧
        T.unfl C₀ I m.2.1 m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1)
          m.1.2.2.2.2.1 m.1.2.2.2.2.2 then g m else 0) =
      ∑ G ∈ gs I, ∑ ω ∈ nOs Lp Jm, (if T.Val a b ω.1 ω.2.1 ∧
        ¬ T.Ucase I ω.1 ω.2.1 ∧ ω.2.2.1 < (T.pe ω.1).length ∧
        ω.2.2.2.1 < (T.pe ω.2.1).length ∧
        ω.2.2.2.2.1 < (T.desc ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)).length ∧
        T.unfl C₀ I G ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)
          ω.2.2.2.2.1 ω.2.2.2.2.2 then g (ω, G, T.bk I) else 0) := by
  rw [Finset.sum_comm (s := gs I), Finset.sum_product]
  refine Finset.sum_congr rfl fun ω _ => ?_
  rw [Finset.sum_product]
  refine ((Finset.sum_subset hgs ?_).symm).trans (Finset.sum_congr rfl fun G hG => ?_)
  · intro G _ hG
    refine Finset.sum_eq_zero fun β _ => ?_
    split_ifs with h
    · exact absurd h.2.1 hG
    · rfl
  · rw [Finset.sum_eq_single (T.bk I)]
    · simp only [hI, hG, true_and]
    · intro β _ hβ
      split_ifs with h
      · exact absurd h.2.2.1.symm hβ
      · rfl
    · intro h; exact absurd (Finset.mem_range.mpr hBn) h

open Classical in
/-- Expanding the outer indices of the uses of a cell and group into the slot, chain, step and
offset sums. -/
theorem sum_nOs_expand (Lp Jm : ℕ) (C₀ : ℝ) (a b : Fin 4) (I : ℤ × ℤ) (G : A.Grp)
    (hLp : ∀ l, (T.pe l).length ≤ Lp)
    (hJm : ∀ c d i i', (T.desc c d (T.tOf c i) (T.tOf d i')).length ≤ Jm)
    (g : Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ → ℝ) :
    ∑ ω ∈ nOs Lp Jm, (if T.Val a b ω.1 ω.2.1 ∧
        ¬ T.Ucase I ω.1 ω.2.1 ∧ ω.2.2.1 < (T.pe ω.1).length ∧
        ω.2.2.2.1 < (T.pe ω.2.1).length ∧
        ω.2.2.2.2.1 < (T.desc ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)).length ∧
        T.unfl C₀ I G ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)
          ω.2.2.2.2.1 ω.2.2.2.2.2 then g ω else 0) =
      ∑ c : Fin 4, ∑ d : Fin 4, (if T.Val a b c d ∧ ¬ T.Ucase I c d then
        ∑ i' ∈ Finset.range (T.pe d).length, ∑ i ∈ Finset.range (T.pe c).length,
          ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
            ∑ o ∈ Finset.range 5, (if T.unfl C₀ I G c d (T.tOf c i) (T.tOf d i') j o then
              g (c, d, i, i', j, o) else 0) else 0) := by
  simp only [nOs, Finset.sum_product]
  refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun d _ => ?_
  by_cases hV : T.Val a b c d ∧ ¬ T.Ucase I c d
  · rw [ite_eq_left_of_eq_true _ _ (eq_true hV), Finset.sum_comm, ← sum_range_ite_lt (hLp d)]
    refine Finset.sum_congr rfl fun i' _ => ?_
    by_cases hi' : i' < (T.pe d).length
    · rw [ite_eq_left_of_eq_true _ _ (eq_true hi'), ← sum_range_ite_lt (hLp c)]
      refine Finset.sum_congr rfl fun i _ => ?_
      by_cases hi : i < (T.pe c).length
      · rw [ite_eq_left_of_eq_true _ _ (eq_true hi), ← sum_range_ite_lt (hJm c d i i')]
        refine Finset.sum_congr rfl fun j _ => ?_
        by_cases hj : j < (T.desc c d (T.tOf c i) (T.tOf d i')).length
        · simp only [hV.1, hV.2, hi, hi', hj, true_and, not_false_eq_true, ↓reduceIte]
        · simp only [hj, false_and, and_false, ite_false, Finset.sum_const_zero]
      · simp only [hi, false_and, and_false, ite_false, Finset.sum_const_zero]
    · simp only [hi', false_and, and_false, ite_false, Finset.sum_const_zero]
  · rw [ite_eq_right_of_eq_false _ _ (eq_false hV)]
    refine Finset.sum_eq_zero fun i _ => Finset.sum_eq_zero fun i' _ =>
      Finset.sum_eq_zero fun j _ => Finset.sum_eq_zero fun o _ => ?_
    rw [ite_eq_right_of_eq_false _ _ (eq_false fun h => hV ⟨h.1, h.2.1⟩)]

/-- The frozen complement bands at the block start of a cell. -/
noncomputable def Ybk (I : ℤ × ℤ) (G : A.Grp) (c d : Fin 4) (t t' : List ℕ) (j o p : ℕ) :
    ColumnL2 (Fin ap.Mc) :=
  T.Y c d G t t' j o (T.D.blockOf I.1) p

/-- The frozen other complement at the block start of a cell. -/
noncomputable def Fbk (I : ℤ × ℤ) (G : A.Grp) (c d : Fin 4) (t t' : List ℕ) (j : ℕ) :
    ColumnL2 (Fin ap.Mc) :=
  T.F c d G t t' j (T.D.blockOf I.1)

open Classical in
/-- The frozen near band parts of a cell, summed over its groups and slot tuples, are `2/P` times
    the
use indicator sums of the near band applications over the slot triples `(a, b, e)`. -/
theorem near_cell_eq (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp)
    (Lp Jm Bn : ℕ) (C₀ : ℝ) {I : ℤ × ℤ} (hI : I ∈ S) (hgs : gs I ⊆ gset) (hBn : T.bk I < Bn)
    (hLp : ∀ l, (T.pe l).length ≤ Lp)
    (hJm : ∀ c d i i', (T.desc c d (T.tOf c i) (T.tOf d i')).length ≤ Jm) :
    ∑ G ∈ gs I, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4, ∑ d : Fin 4,
      T.nearPart I G a b c d T.Ybk T.Fbk (T.unfl C₀) =
    2 / (ap.P : ℝ) * ∑ a : Fin 4, ∑ b : Fin 4, ∑ e : Fin 4,
      ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn),
        (if I ∈ T.nU S gs C₀ a b e m then ‖T.nf a b m.1.1 m.1.2.1 m.2.1 I (T.tOf m.1.1 m.1.2.2.1)
          (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1 m.1.2.2.2.2.2‖ else 0) := by
  have hR : ∀ a b : Fin 4, ∑ e : Fin 4, ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn),
      (if I ∈ T.nU S gs C₀ a b e m then ‖T.nf a b m.1.1 m.1.2.1 m.2.1 I (T.tOf m.1.1 m.1.2.2.1)
        (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1 m.1.2.2.2.2.2‖ else 0) =
      ∑ G ∈ gs I, ∑ c : Fin 4, ∑ d : Fin 4, (if T.Val a b c d ∧ ¬ T.Ucase I c d then
        ∑ i' ∈ Finset.range (T.pe d).length, ∑ i ∈ Finset.range (T.pe c).length,
          ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
            ∑ o ∈ Finset.range 5, (if T.unfl C₀ I G c d (T.tOf c i) (T.tOf d i') j o then
              ‖T.nf a b c d G I (T.tOf c i) (T.tOf d i') j o‖ else 0) else 0) := by
    intro a b
    rw [T.sum_e_nU, T.sum_Ms_collapse S gs gset Lp Jm Bn C₀ a b hI hgs hBn]
    exact Finset.sum_congr rfl fun G _ => T.sum_nOs_expand Lp Jm C₀ a b I G hLp hJm _
  have hL : ∀ G a b c d, T.nearPart I G a b c d T.Ybk T.Fbk (T.unfl C₀) =
      2 / (ap.P : ℝ) * (if T.Val a b c d ∧ ¬ T.Ucase I c d then
        ∑ i' ∈ Finset.range (T.pe d).length, ∑ i ∈ Finset.range (T.pe c).length,
          ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
            ∑ o ∈ Finset.range 5, (if T.unfl C₀ I G c d (T.tOf c i) (T.tOf d i') j o then
              ‖T.nf a b c d G I (T.tOf c i) (T.tOf d i') j o‖ else 0) else 0) := by
    intro G a b c d
    unfold nearPart
    split_ifs with h
    · unfold nearAbs
      rw [list_map_sum_range _ (0, []), Finset.mul_sum]
      refine Finset.sum_congr rfl fun i' _ => ?_
      rw [list_map_sum_range _ (0, []), Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [Finset.mul_sum]
      rfl
    · rw [mul_zero]
  simp_rw [hL, hR, ← Finset.mul_sum]
  congr 1
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun a _ => ?_
  rw [Finset.sum_comm]

/-- The critical absolute bound of one near band application (`near_triple_U`). -/
noncomputable def nearBnd {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) (N Lp Jm Bn : ℕ)
    (gset : Finset A.Grp) (C₀ ρ BA EWa EU : ℝ) : ℝ :=
  8 / 7 * (nbCU κ' hq2 hq3 * (1 + finiteDepthConstant κ' q T.D.S.K) *
      (1 + Real.log ((T.D.S.K : ℝ) + 2)) *
      ((T.D.S.K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) * (64 * (2 * C₀) * (2 * C₀))) *
    Real.sqrt ((hullCutConstant (ρ / 2) * ((1 : ℕ) *
        (T.nearEA Lp Jm N BA EWa / dyadicGridLength A.G A.R.1)) *
        (1 + Real.log (2 + ((nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn)).card *
          (N + 1) * 1 : ℕ)))) *
      (hullCutConstant (ρ / 2) * ((N + 1 : ℕ) *
        ((nOs Lp Jm).card * EU / dyadicGridLength A.G A.R.1)) *
        (1 + Real.log (2 + ((nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn)).card *
          (N + 1) * 1 : ℕ))))) *
    dyadicGridLength A.G A.R.1

open Classical in
/-- The uses of a near band application have distinct slots `a, b, e` and `a ≠ u`. -/
theorem nU_slots {S : Finset (ℤ × ℤ)} {gs : ℤ × ℤ → Finset A.Grp} {C₀ : ℝ} {a b e : Fin 4}
    {m : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ} {I : ℤ × ℤ}
    (hI : I ∈ T.nU S gs C₀ a b e m) : a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ a ≠ T.u := by
  have h := (Finset.mem_filter.mp hI).2
  obtain ⟨hab, hac, had, hbc, hbd, -, hau⟩ := h.2.2.1
  have he := h.2.2.2.2.2.2.2.1
  unfold eSlot at he
  refine ⟨hab, ?_, ?_, hau⟩ <;> split_ifs at he <;> subst he <;> assumption

open Classical in
/-- Blueprint `eq:near-band` (lines 2430-2456) on one leaf: one cut family of root fraction `ρ` (the
union of the cuts of the near band applications of all slot triples) such that the weighted
frozen near band parts of the retained cells are at most `12/P` times the sum of the critical
absolute bounds `nearBnd` of the triples `(a, b, e)` with distinct slots and `a ≠ u`. -/
theorem near_sum {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) (hanc : A.AncClosed) (hK1 : 1 ≤ T.D.S.K)
    {N : ℕ} (hKN : T.D.S.K ≤ 2 ^ N) (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells)
    (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp) (hgs : ∀ I ∈ S, gs I ⊆ gset)
    (Lp Jm Bn : ℕ) (hBn : ∀ I ∈ S, T.bk I < Bn) (hLp : ∀ l, (T.pe l).length ≤ Lp)
    (hJm : ∀ c d i i', (T.desc c d (T.tOf c i) (T.tOf d i')).length ≤ Jm)
    {okA : Fin 4 → A.Grp → ℤ × ℤ → Prop} {BA EWa EU : Fin 4 → ℝ}
    (hcapA : ∀ a, a ≠ T.u → A.VarCap gset (fun G h => LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc
      T.s a G (T.P₁ a) (T.P₂ a) h) (okA a) (BA a))
    (hok : ∀ a, a ≠ T.u → ∀ I ∈ S, ∀ G ∈ gs I, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okA a G J)
    (hEWa : ∀ a, a ≠ T.u → ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖columnL2Restriction
      (⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
        (fun I => ancAt A.G I (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (T.gside a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤
        EWa a)
    (hEU : ∀ b, ∑ I ∈ S, ∑ G ∈ gs I, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.side b G I)‖ ^ 2 ≤ EU b)
    {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∃ Cn : Finset (ℤ × ℤ), Cn ⊆ A.cells ∧
      dyadicRootLength A.G Cn ≤ ρ * dyadicGridLength A.G A.R.1 ∧
      ∑ I ∈ S.filter (fun I => ¬ ∃ e' ∈ Cn,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
        dyadicGridLength A.G I.1 * (6 * ∑ G ∈ gs I, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4,
          ∑ d : Fin 4, T.nearPart I G a b c d T.Ybk T.Fbk (T.unfl C₀)) ≤
      12 / (ap.P : ℝ) * ∑ a : Fin 4, ∑ b : Fin 4, ∑ e : Fin 4,
        (if a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ a ≠ T.u then
          T.nearBnd hq2 hq3 N Lp Jm Bn gset C₀ (ρ / 64) (BA a) (EWa a) (EU b) else 0) := by
  set Ms := nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn) with hMs
  have hP : ∀ a b e : Fin 4, ∃ C : Finset (ℤ × ℤ), C ⊆ A.cells ∧
      dyadicRootLength A.G (maximalDyadicCells A.G C) ≤ ρ / 64 * dyadicGridLength A.G A.R.1 ∧
      ((a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ a ≠ T.u) →
        ∑ m ∈ Ms, ∑ I ∈ (T.nU S gs C₀ a b e m).filter (fun I => ¬ ∃ e' ∈ C,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
          dyadicGridLength A.G I.1 * ‖T.nf a b m.1.1 m.1.2.1 m.2.1 I (T.tOf m.1.1 m.1.2.2.1)
            (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1 m.1.2.2.2.2.2‖ ≤
        T.nearBnd hq2 hq3 N Lp Jm Bn gset C₀ (ρ / 64) (BA a) (EWa a) (EU b)) := by
    intro a b e
    by_cases h : a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ a ≠ T.u
    · obtain ⟨C, h1, h2, h3⟩ := T.near_triple_U hq2 hq3 h.1 h.2.1 h.2.2.1 hanc hK1 hKN S hS gs
        gset Lp Jm Bn hgs (hcapA a h.2.2.2) (hok a h.2.2.2) (hEWa a h.2.2.2) (hEU b) hC₀
        (ρ := ρ / 64) (by positivity) (by linarith)
      exact ⟨C, h1, h2, fun _ => h3⟩
    · refine ⟨∅, Finset.empty_subset _, ?_, fun h' => absurd h' h⟩
      have : maximalDyadicCells A.G ∅ = ∅ :=
        Finset.subset_empty.mp (maximalDyadicCells_subset A.G ∅)
      rw [this, dyadicRootLength, Finset.sum_empty]
      have := dyadicGridLength_pos A.G A.R.1
      positivity
  choose Cf hCf1 hCf2 hCf3 using hP
  set Cn := (Finset.univ : Finset (Fin 4 × Fin 4 × Fin 4)).biUnion
    fun x => maximalDyadicCells A.G (Cf x.1 x.2.1 x.2.2) with hCn
  have hcov : ∀ a b e (I : ℤ × ℤ), (¬ ∃ e' ∈ Cn,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2) →
      ¬ ∃ e' ∈ Cf a b e, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2 := by
    intro a b e I hI ⟨e', he', hsub⟩
    obtain ⟨d, hd, hsub'⟩ := maximalDyadicCells_covers A.G (Cf a b e) he'
    exact hI ⟨d, Finset.mem_biUnion.mpr ⟨(a, b, e), Finset.mem_univ _, hd⟩, hsub.trans hsub'⟩
  refine ⟨Cn, ?_, ?_, ?_⟩
  · intro c hc
    obtain ⟨x, -, hx⟩ := Finset.mem_biUnion.mp hc
    exact hCf1 _ _ _ (maximalDyadicCells_subset A.G _ hx)
  · unfold dyadicRootLength
    refine (sum_biUnion_le_of_nonneg _ _ _ fun c : ℤ × ℤ => (dyadicGridLength_pos A.G c.1).le).trans
        ?_
    calc ∑ x ∈ (Finset.univ : Finset (Fin 4 × Fin 4 × Fin 4)),
          ∑ c ∈ maximalDyadicCells A.G (Cf x.1 x.2.1 x.2.2), dyadicGridLength A.G c.1
        ≤ ∑ _x ∈ (Finset.univ : Finset (Fin 4 × Fin 4 × Fin 4)),
          ρ / 64 * dyadicGridLength A.G A.R.1 :=
          Finset.sum_le_sum fun x _ => hCf2 x.1 x.2.1 x.2.2
      _ = ρ * dyadicGridLength A.G A.R.1 := by
          rw [Finset.sum_const, Finset.card_univ]
          simp only [Fintype.card_prod, Fintype.card_fin, nsmul_eq_mul]
          ring
  · have hcell : ∀ I ∈ S.filter (fun I => ¬ ∃ e' ∈ Cn,
        dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
        dyadicGridLength A.G I.1 * (6 * ∑ G ∈ gs I, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4,
          ∑ d : Fin 4, T.nearPart I G a b c d T.Ybk T.Fbk (T.unfl C₀)) =
        12 / (ap.P : ℝ) * ∑ a : Fin 4, ∑ b : Fin 4, ∑ e : Fin 4, ∑ m ∈ Ms,
          dyadicGridLength A.G I.1 * (if I ∈ T.nU S gs C₀ a b e m then ‖T.nf a b m.1.1 m.1.2.1
            m.2.1 I (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1
              m.1.2.2.2.2.2‖ else 0) := by
      intro I hI
      have hIS := (Finset.mem_filter.mp hI).1
      rw [T.near_cell_eq S gs gset Lp Jm Bn C₀ hIS (hgs I hIS) (hBn I hIS) hLp hJm]
      simp only [Finset.mul_sum]
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ =>
        Finset.sum_congr rfl fun e _ => Finset.sum_congr rfl fun m _ => ?_
      ring
    have hP0 : (0 : ℝ) ≤ 12 / (ap.P : ℝ) := by positivity
    rw [Finset.sum_congr rfl hcell, ← Finset.mul_sum]
    refine mul_le_mul_of_nonneg_left ?_ hP0
    rw [Finset.sum_comm]
    refine Finset.sum_le_sum fun a _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_le_sum fun b _ => ?_
    rw [Finset.sum_comm]
    refine Finset.sum_le_sum fun e _ => ?_
    rw [Finset.sum_comm]
    have hm : ∀ m ∈ Ms, ∑ I ∈ S.filter (fun I => ¬ ∃ e' ∈ Cn,
        dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
        dyadicGridLength A.G I.1 * (if I ∈ T.nU S gs C₀ a b e m then ‖T.nf a b m.1.1 m.1.2.1
          m.2.1 I (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1
            m.1.2.2.2.2.2‖ else 0) ≤
        ∑ I ∈ (T.nU S gs C₀ a b e m).filter (fun I => ¬ ∃ e' ∈ Cf a b e,
          dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
          dyadicGridLength A.G I.1 * ‖T.nf a b m.1.1 m.1.2.1 m.2.1 I (T.tOf m.1.1 m.1.2.2.1)
            (T.tOf m.1.2.1 m.1.2.2.2.1) m.1.2.2.2.2.1 m.1.2.2.2.2.2‖ := by
      intro m _
      simp only [mul_ite, mul_zero]
      rw [← Finset.sum_filter]
      refine Finset.sum_le_sum_of_subset_of_nonneg (fun I hI => ?_)
        fun I _ _ => mul_nonneg (dyadicGridLength_pos A.G I.1).le (norm_nonneg _)
      obtain ⟨hI1, hI2⟩ := Finset.mem_filter.mp hI
      exact Finset.mem_filter.mpr ⟨hI2, hcov a b e I (Finset.mem_filter.mp hI1).2⟩
    by_cases h : a ≠ b ∧ a ≠ e ∧ b ≠ e ∧ a ≠ T.u
    · rw [ite_eq_left_of_eq_true _ _ (eq_true h)]
      exact (Finset.sum_le_sum hm).trans (hCf3 a b e h)
    · rw [ite_eq_right_of_eq_false _ _ (eq_false h)]
      refine le_of_eq (Finset.sum_eq_zero fun m _ => Finset.sum_eq_zero fun I _ => ?_)
      rw [ite_eq_right_of_eq_false _ _ (eq_false fun hI => h (T.nU_slots hI)), mul_zero]

