      ∀ {Ea Eb ρ : ℝ}, 0 ≤ Ea → 0 ≤ Eb → 0 < ρ → ρ < 1 →
      ∑ m ∈ Ms, ∑ k, ∑ i ∈ ((U m).filter (actA k)).image (selA k), ∑ p ∈ u m,
