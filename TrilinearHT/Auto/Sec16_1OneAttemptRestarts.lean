/-! ### The union of the cuts (blueprint lines 2839-2841) -/

/-- Blueprint lines 2839-2841 ("choose their thresholds so the union of exceptional roots has
length at most `|R|/4`"): finitely many cut families `F_i` inside the root, of lengths at most
`ρ_i |R|` with `Σ ρ_i ≤ 1/4`, have maximal union cells `X` that are inside the root, pairwise
disjoint, of total length at most `|R|/4`, and cover every cut cell. -/
theorem exceptional_union (G : RealDyadicGrid) {ι : Type*} (T : Finset ι)
    (F : ι → Finset (ℤ × ℤ)) (ρs : ι → ℝ) (root : ℤ × ℤ)
    (hFR : ∀ i ∈ T, ∀ c ∈ F i, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2)
    (hF : ∀ i ∈ T, dyadicRootLength G (F i) ≤ ρs i * dyadicGridLength G root.1)
    (hρ : ∑ i ∈ T, ρs i ≤ 1 / 4) :
    ∃ X : Finset (ℤ × ℤ),
      (∀ c ∈ X, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G root.1 root.2) ∧
      (∀ c ∈ X, ∀ c' ∈ X, c ≠ c' →
        Disjoint (dyadicGridCell G c.1 c.2) (dyadicGridCell G c'.1 c'.2)) ∧
      ∑ c ∈ X, dyadicGridLength G c.1 ≤ 1 / 4 * dyadicGridLength G root.1 ∧
      ∀ i ∈ T, ∀ c ∈ F i, ∃ d ∈ X, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 := by
  classical
  refine ⟨maximalDyadicCells G (T.biUnion F), fun c hc => ?_, fun c hc c' hc' hne => ?_,
    exceptional_roots_le G T F ρs root hF hρ, fun i hi c hc => ?_⟩
  · obtain ⟨i, hi, hci⟩ := Finset.mem_biUnion.mp (maximalDyadicCells_subset G _ hc)
    exact hFR i hi c hci
  · exact maximalDyadicCells_pairwiseDisjoint G _ hc hc' hne
  · exact maximalDyadicCells_covers G _ (Finset.mem_biUnion.mpr ⟨i, hi, hc⟩)

