/-- The constant of `near_band_positions`. -/
noncomputable def nbC (κ : LocalKernelClass) {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) : ℝ :=
  Classical.choose (near_band_positions κ hq2 hq3)

