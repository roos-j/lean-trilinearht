/-- The global side of a block is the leaf output jump from the block start plus the block-start
value. -/
theorem gSide_eq (cat : Fin 4 → List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ l, ∀ d ∈ cat l, d.birth ∈ A.cells) (s : ℕ) (l : Fin 4) (G : A.Grp) {CF : ℝ}
    (P₁ P₂ : BasicProjection A.G A.R CF) (b h : ℤ) :
    D.gSide cat hR hb s l G P₁ P₂ b h = gOut cat hR hb s l G P₁ P₂ h -
      gOut cat hR hb s l G P₁ P₂ b + D.gSide cat hR hb s l G P₁ P₂ b b := by
  unfold gSide
  split_ifs <;> abel

