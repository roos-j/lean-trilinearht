variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (T : ap.TTData)

/-- The banded stack energy budget of the near applications (`bandStack_outer`). -/
noncomputable def nearEA (Lp Jm N : ℕ) (B EW : ℝ) : ℝ :=
  ∑ ω ∈ nOs Lp Jm, (N * (2 * B + 16 * (ap.P + 2) * (ap.bandJumpC T.hcat T.hR T.hbh ω.2.2.2.2.1 * EW)
      +
    16 * (ap.P + 2) * (N * (ap.bandJumpC T.hcat T.hR T.hbh ω.2.2.2.2.1 * (N * B)))) + EW)

/-- The untouched stack energy budget of the near applications (`posStack_outer`). -/
noncomputable def nearEB (Lp Jm N : ℕ) (B EW : ℝ) : ℝ := ∑ _ω ∈ nOs Lp Jm, (N * B + EW)

open Classical in
/-- Blueprint lines 2400-2456 (`eq:near-band`) for the slots `a, b` and the banded complement slot
`e`, with `b` basic: off a cut family of root fraction `ρ`, the weighted frozen near band forms of
the unflagged uses are at most the critical absolute bound of `near_band_positions` with the
stack energies of `bandStack_outer` and `posStack_outer` and the complement bounds `2 C₀`. -/
theorem near_triple {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) {a b e : Fin 4} (hab : a ≠ b)
    (hae : a ≠ e) (hbe : b ≠ e) (hanc : A.AncClosed) (hK1 : 1 ≤ T.D.S.K) {N : ℕ}
    (hKN : T.D.S.K ≤ 2 ^ N) (S : Finset (ℤ × ℤ)) (hS : S ⊆ A.cells)
    (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp) (Lp Jm Bn : ℕ)
    (hbas : ∀ l, ¬ T.D.usl l → ∀ I ∈ A.cells, ap.z I l = A.B l I ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        A.B l I y = (T.P₁ l).val I y - (T.P₂ l).val I y)
    (hdc : ∀ I ∈ S, T.D.hasDecision I → T.D.dcell I ∈ A.cells) (hbu : ¬ T.D.usl b)
    {okA okB : A.Grp → ℤ × ℤ → Prop} {BA BB : ℝ}
    (hcapA : A.VarCap gset (fun G h => LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s a G
      (T.P₁ a) (T.P₂ a) h) okA BA)
    (hcapB : A.VarCap gset (fun G h => LeafSplit.gOut (ap := ap) T.cat T.hR T.hbc T.s b G
      (T.P₁ b) (T.P₂ b) h) okB BB)
    (hok : ∀ I ∈ S, ∀ G ∈ gs I, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → okA G J ∧ okB G J)
    {EWa EWb : ℝ}
    (hEWa : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖columnL2Restriction
      (⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
        (fun I => ancAt A.G I (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (T.gside a G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤
        EWa)
    (hEWb : ∑ G ∈ gset, ∑ β ∈ Finset.range Bn, ‖columnL2Restriction
      (⋃ J ∈ (S.filter fun I => G ∈ gs I ∧ T.bk I = β).image
        (fun I => ancAt A.G I (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ))), dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (T.gside b G (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)) (A.R.1 + ((T.D.S.K * β : ℕ) : ℤ)))‖ ^ 2 ≤
        EWb)
    {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ A.cells ∧
      dyadicRootLength A.G (maximalDyadicCells A.G C) ≤ ρ * dyadicGridLength A.G A.R.1 ∧
      ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn), ∑ I ∈ (T.nU S gs C₀ a b e m).filter
          (fun I => ¬ ∃ e' ∈ C, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G e'.1 e'.2),
        dyadicGridLength A.G I.1 * ‖T.nf a b m.1.1 m.1.2.1 m.2.1 I (T.tOf m.1.1 m.1.2.2.1)
