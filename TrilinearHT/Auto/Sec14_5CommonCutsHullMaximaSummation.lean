/-- On a cell of a basic slot (also basic at its decision cell), the side of the leaf split is the
restriction of the global side of its block at its depth. -/
theorem side_eq_gSide (cat : Fin 4 → List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ l, ∀ d ∈ cat l, d.birth ∈ A.cells) (s : ℕ) (l : Fin 4) (hl : ¬ D.usl l) (G : A.Grp)
    (hK1 : 1 ≤ D.S.K) {I : ℤ × ℤ} (hI : I ∈ A.cells) {CF : ℝ} (P₁ P₂ : BasicProjection A.G A.R CF)
    (hzI : ap.z I l = A.B l I)
    (hPI : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → A.B l I y = P₁.val I y - P₂.val I y)
    (hdec : D.hasDecision I → D.dcell I ∈ A.cells ∧ ap.z (D.dcell I) l = A.B l (D.dcell I) ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G (D.dcell I).1 (D.dcell I).2 →
        A.B l (D.dcell I) y = P₁.val (D.dcell I) y - P₂.val (D.dcell I) y) :
    D.side l G I (ap.leafOut cat s I l G) (ap.leafOut cat s (D.dcell I) l G) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (D.gSide cat hR hb s l G P₁ P₂ (D.blockOf I.1) I.1) := by
