    norm_nonneg _) hu0 (by positivity) (fun I hI => ?_) hT hη hp hp1
  calc ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 =>
        (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
