open Classical in
/-- Blueprint lines 2372-2384 and 2447-2449 (`eq:three-sides`, `eq:min-power`): if the cell
values `h_I` are bounded by sums over terms `o` and groups `G ∈ gs I` of products of three
    nonnegative
strong factors, whose group-summed squares have path caps `C_a o, C_b o, C_c o`, then
`Σ_I |I| min(η, ‖h_I‖) ≤ η^{1-p} Σ_o (C_a C_b C_c)^{p/2} |R|` for `2/3 < p ≤ 1`. -/
theorem min_three_strong (Gd : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (root : ℤ × ℤ)
    (hroot : ∀ I ∈ S, dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd root.1 root.2)
    {ω γ : Type*} (Os : Finset ω) (gs : ℤ × ℤ → Finset γ) (fa fb fc : ω → ℤ × ℤ → γ → ℝ)
    (ha : ∀ o I G, 0 ≤ fa o I G) (hb : ∀ o I G, 0 ≤ fb o I G)
    (Ca Cb Cc : ω → ℝ)
    (hCa : ∀ o ∈ Os, ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell Gd I.1 I.2),
      ∑ G ∈ gs I, fa o I G ^ 2 ≤ Ca o)
    (hCb : ∀ o ∈ Os, ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell Gd I.1 I.2),
      ∑ G ∈ gs I, fb o I G ^ 2 ≤ Cb o)
    (hCc : ∀ o ∈ Os, ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell Gd I.1 I.2),
      ∑ G ∈ gs I, fc o I G ^ 2 ≤ Cc o)
    (hval : ℤ × ℤ → ℝ)
    (hh : ∀ I ∈ S, hval I ≤ ∑ o ∈ Os, ∑ G ∈ gs I, fa o I G * fb o I G * fc o I G)
    {η p : ℝ} (hη : 0 ≤ η) (hp : 2 / 3 < p) (hp1 : p ≤ 1) :
    ∑ I ∈ S, dyadicGridLength Gd I.1 * min η (hval I) ≤
      η ^ (1 - p) * ∑ o ∈ Os, Ca o ^ (p / 2) * Cb o ^ (p / 2) * Cc o ^ (p / 2) *
        dyadicGridLength Gd root.1 := by
  have hp0 : 0 < p := by linarith
  set A : ω → ℤ × ℤ → ℝ := fun o I => Real.sqrt (∑ G ∈ gs I, fa o I G ^ 2)
  set B : ω → ℤ × ℤ → ℝ := fun o I => Real.sqrt (∑ G ∈ gs I, fb o I G ^ 2)
  set C : ω → ℤ × ℤ → ℝ := fun o I => Real.sqrt (∑ G ∈ gs I, fc o I G ^ 2)
  -- per cell: the group sum is at most the product of the three group norms
  have hcell : ∀ o I, ∑ G ∈ gs I, fa o I G * fb o I G * fc o I G ≤
      A o I * B o I * C o I := by
    intro o I
    have hcmax : ∀ G ∈ gs I, fc o I G ≤ C o I := fun G hG =>
      Real.le_sqrt_of_sq_le (Finset.single_le_sum (f := fun G => fc o I G ^ 2)
        (fun _ _ => sq_nonneg _) hG)
    calc ∑ G ∈ gs I, fa o I G * fb o I G * fc o I G
        ≤ ∑ G ∈ gs I, fa o I G * fb o I G * C o I :=
          Finset.sum_le_sum fun G hG => mul_le_mul_of_nonneg_left (hcmax G hG)
            (mul_nonneg (ha o I G) (hb o I G))
      _ = (∑ G ∈ gs I, fa o I G * fb o I G) * C o I := by rw [Finset.sum_mul]
      _ ≤ A o I * B o I * C o I := by
          refine mul_le_mul_of_nonneg_right ?_ (Real.sqrt_nonneg _)
          exact sum_mul_le_sqrt_mul_sqrt _ _ _
  have hAB : ∀ o I, 0 ≤ A o I * B o I * C o I := fun o I => by positivity
  calc ∑ I ∈ S, dyadicGridLength Gd I.1 * min η (hval I)
      ≤ ∑ I ∈ S, dyadicGridLength Gd I.1 * (η ^ (1 - p) *
          ∑ o ∈ Os, (A o I * B o I * C o I) ^ p) := by
        refine Finset.sum_le_sum fun I hI => mul_le_mul_of_nonneg_left ?_
          (dyadicGridLength_pos Gd I.1).le
        have h1 : hval I ≤ ∑ o ∈ Os, A o I * B o I * C o I :=
          (hh I hI).trans (Finset.sum_le_sum fun o _ => hcell o I)
        refine (min_le_min_left η h1).trans ((min_le_rpow_mul hη
          (Finset.sum_nonneg fun o _ => hAB o I) hp0.le hp1).trans ?_)
        exact mul_le_mul_of_nonneg_left (rpow_finsetSum_le _ _ (fun o _ => hAB o I) hp0 hp1)
          (by positivity)
    _ = η ^ (1 - p) * ∑ o ∈ Os, ∑ I ∈ S, dyadicGridLength Gd I.1 *
          (A o I * B o I * C o I) ^ p := by
        simp only [Finset.mul_sum]
        rw [Finset.sum_comm]
        exact Finset.sum_congr rfl fun o _ => Finset.sum_congr rfl fun I _ => by ring
    _ ≤ η ^ (1 - p) * ∑ o ∈ Os, Ca o ^ (p / 2) * Cb o ^ (p / 2) * Cc o ^ (p / 2) *
          dyadicGridLength Gd root.1 := by
        refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun o ho => ?_) (by positivity)
        refine power_cost_bound Gd S (A o) (B o) (C o) (fun I _ => Real.sqrt_nonneg _)
          (fun I _ => Real.sqrt_nonneg _) (fun I _ => Real.sqrt_nonneg _) root hroot
          (fun x => ?_) (fun x => ?_) (fun x => ?_) hp
        · refine le_trans (le_of_eq (Finset.sum_congr rfl fun I _ => ?_)) (hCa o ho x)
          exact Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)
        · refine le_trans (le_of_eq (Finset.sum_congr rfl fun I _ => ?_)) (hCb o ho x)
          exact Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)
        · refine le_trans (le_of_eq (Finset.sum_congr rfl fun I _ => ?_)) (hCc o ho x)
          exact Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)

open Classical in
/-- Blueprint lines 2446-2456 (combination in the active minimum): if every cell value is at most
an absolute part plus a sum of products of three strong factors with group-summed path caps, the
weighted active minimum is at most the weighted absolute parts plus the power cost of the strong
products. -/
theorem min_abs_three_strong (Gd : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (root : ℤ × ℤ)
    (hroot : ∀ I ∈ S, dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd root.1 root.2)
    {ω γ : Type*} (Os : Finset ω) (gs : ℤ × ℤ → Finset γ) (fa fb fc : ω → ℤ × ℤ → γ → ℝ)
    (ha : ∀ o I G, 0 ≤ fa o I G) (hb : ∀ o I G, 0 ≤ fb o I G) (hc : ∀ o I G, 0 ≤ fc o I G)
    (Ca Cb Cc : ω → ℝ)
    (hCa : ∀ o ∈ Os, ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell Gd I.1 I.2),
      ∑ G ∈ gs I, fa o I G ^ 2 ≤ Ca o)
    (hCb : ∀ o ∈ Os, ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell Gd I.1 I.2),
      ∑ G ∈ gs I, fb o I G ^ 2 ≤ Cb o)
    (hCc : ∀ o ∈ Os, ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell Gd I.1 I.2),
      ∑ G ∈ gs I, fc o I G ^ 2 ≤ Cc o)
    (val absv : ℤ × ℤ → ℝ) (habs : ∀ I ∈ S, 0 ≤ absv I)
    (hval : ∀ I ∈ S, val I ≤ absv I + ∑ o ∈ Os, ∑ G ∈ gs I, fa o I G * fb o I G * fc o I G)
    {η p : ℝ} (hη : 0 ≤ η) (hp : 2 / 3 < p) (hp1 : p ≤ 1) :
    ∑ I ∈ S, dyadicGridLength Gd I.1 * min η (val I) ≤
      ∑ I ∈ S, dyadicGridLength Gd I.1 * absv I +
        η ^ (1 - p) * ∑ o ∈ Os, Ca o ^ (p / 2) * Cb o ^ (p / 2) * Cc o ^ (p / 2) *
          dyadicGridLength Gd root.1 := by
  set ts : ℤ × ℤ → ℝ := fun I => ∑ o ∈ Os, ∑ G ∈ gs I, fa o I G * fb o I G * fc o I G
  have hts : ∀ I, 0 ≤ ts I := fun I => Finset.sum_nonneg fun o _ => Finset.sum_nonneg fun G _ =>
    mul_nonneg (mul_nonneg (ha o I G) (hb o I G)) (hc o I G)
  have h1 : ∀ I ∈ S, dyadicGridLength Gd I.1 * min η (val I) ≤
      dyadicGridLength Gd I.1 * absv I + dyadicGridLength Gd I.1 * min η (ts I) := by
    intro I hI
    rw [← mul_add]
    refine mul_le_mul_of_nonneg_left ?_ (dyadicGridLength_pos Gd I.1).le
    rcases le_total η (ts I) with h | h
    · rw [min_eq_left h]
      exact (min_le_left _ _).trans (le_add_of_nonneg_left (habs I hI))
    · rw [min_eq_right h]
      exact (min_le_right _ _).trans (hval I hI)
  refine (Finset.sum_le_sum h1).trans ?_
  rw [Finset.sum_add_distrib]
  refine add_le_add le_rfl ?_
  exact min_three_strong Gd S root hroot Os gs fa fb fc ha hb Ca Cb Cc hCa hCb hCc ts
    (fun I _ => le_rfl) hη hp hp1

/-- The `2+2` patterns: two cores and two sides, no error. -/
theorem two_two_tuple : ∀ σ : Fin 4 → Fin 3, ((∀ l, σ l ≠ 2) ∧
    (Finset.univ.filter fun l => σ l = 0).card = 2 ∧
    (Finset.univ.filter fun l => σ l = 1).card = 2) → ∀ u : Fin 4,
    ∃ a b c d : Fin 4, a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d ∧ σ c = 0 ∧ σ d = 0 ∧
      σ a = 1 ∧ σ b = 1 ∧ a ≠ u := by
  decide

theorem card_two_two : (Finset.univ.filter fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
    (Finset.univ.filter fun l => σ l = 0).card = 2 ∧
    (Finset.univ.filter fun l => σ l = 1).card = 2).card = 6 := by
  decide

