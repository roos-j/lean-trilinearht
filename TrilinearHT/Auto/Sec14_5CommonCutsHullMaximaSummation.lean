      ap.leafOut cat s J l G = columnL2Restriction (dyadicGridCell A.G J.1 J.2)
        (dyadicGridCell_measurable A.G J.1 J.2) (gOut cat hR hb s l G P₁ P₂ J.1) := by
    intro J hJ hz hP
    rw [ap.leafOut_eq_projOut cat s l hR (hb l) G hJ hz P₁ P₂ hP]
    rfl
  unfold side gSide
  by_cases hd : D.hasDecision I
  · obtain ⟨hdc, hzd, hPd⟩ := hdec hd
    have hd' : A.R.1 ≤ D.blockOf I.1 - 4 * D.S.K := hd
    simp only [hl, false_or, hd, not_true_eq_false, ite_false, hd', ite_true]
    have hsub : dyadicGridCell A.G I.1 I.2 ⊆
        dyadicGridCell A.G (D.dcell I).1 (D.dcell I).2 := by
      unfold dcell
      refine subset_ancAt A.G I ?_
      have := (D.blockOf_bounds hK1 I.1).1
      omega
    rw [hout hI hzI hPI, hout hdc hzd hPd, ← ContinuousLinearMap.comp_apply
      (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)),
      columnL2Restriction_comp_of_subset _ _ hsub, map_add, map_sub]
    rfl
  · have hd' : ¬ A.R.1 ≤ D.blockOf I.1 - 4 * D.S.K := hd
    simp only [hl, false_or, hd, not_false_eq_true, ite_true, hd', ite_false]
    exact hout hI hzI hPI

