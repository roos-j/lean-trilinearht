/-- The moment of the slot `Σ_j η_j w_j` on three families. -/
theorem moment_three_b (s : Finset ι) (t : Finset κ) (u : Finset ν) (w : κ → ℂ) :
    ((Fintype.card (SignPattern s × SignPattern t × SignPattern u) : ℝ≥0∞)⁻¹ *
      ∑ ω : SignPattern s × SignPattern t × SignPattern u,
        ‖∑ j ∈ t, (patternSign ω.2.1.1 j : ℂ) * w j‖ₑ ^ (4 : ℝ)) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal 16 * ENNReal.ofReal (Real.sqrt (∑ j ∈ t, ‖w j‖ ^ 2)) := by
  rw [enorm_avg_rpow, ← ENNReal.ofReal_mul (by norm_num)]
  refine ENNReal.ofReal_le_ofReal (root4_le (by positivity) (by norm_num)
    (Finset.sum_nonneg fun _ _ => sq_nonneg _) ?_)
  have e := avg_three_families_real s t u
    (fun _ v₂ _ => ‖∑ j ∈ t, (patternSign v₂ j : ℂ) * w j‖ ^ (4 : ℝ))
  rw [e]
  have hk := khintchine_four t w
  simp_rw [rademacherSum_complex] at hk
  have e2 : ((2 : ℝ) ^ s.card)⁻¹ * ∑ v₁ ∈ s.powerset, (((2 : ℝ) ^ t.card)⁻¹ *
      ∑ v₂ ∈ t.powerset, (((2 : ℝ) ^ u.card)⁻¹ * ∑ _v₃ ∈ u.powerset,
        ‖∑ j ∈ t, (patternSign v₂ j : ℂ) * w j‖ ^ (4 : ℝ))) =
      rademacherMean t (fun v => ‖∑ j ∈ t, (patternSign v j : ℂ) * w j‖ ^ (4 : ℝ)) := by
    have h3 : ∀ v₂ : Finset κ, ((2 : ℝ) ^ u.card)⁻¹ * ∑ _v₃ ∈ u.powerset,
        ‖∑ j ∈ t, (patternSign v₂ j : ℂ) * w j‖ ^ (4 : ℝ) =
        ‖∑ j ∈ t, (patternSign v₂ j : ℂ) * w j‖ ^ (4 : ℝ) := fun v₂ =>
      rademacherMean_const u _
    simp_rw [h3]
    exact rademacherMean_const s _
  rw [e2]
  refine hk.trans ?_
  have : (0 : ℝ) ≤ (∑ j ∈ t, ‖w j‖ ^ 2) ^ 2 := sq_nonneg _
  nlinarith

omit [DecidableEq ι] [DecidableEq κ] in
/-- The moment of the band slot `Σ_p ζ_p y_p` on three families. -/
theorem moment_three_c (s : Finset ι) (t : Finset κ) (u : Finset ν) (y : ν → ℂ) :
    ((Fintype.card (SignPattern s × SignPattern t × SignPattern u) : ℝ≥0∞)⁻¹ *
      ∑ ω : SignPattern s × SignPattern t × SignPattern u,
        ‖∑ p ∈ u, (patternSign ω.2.2.1 p : ℂ) * y p‖ₑ ^ (4 : ℝ)) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal 16 * ENNReal.ofReal (Real.sqrt (∑ p ∈ u, ‖y p‖ ^ 2)) := by
  rw [enorm_avg_rpow, ← ENNReal.ofReal_mul (by norm_num)]
  refine ENNReal.ofReal_le_ofReal (root4_le (by positivity) (by norm_num)
    (Finset.sum_nonneg fun _ _ => sq_nonneg _) ?_)
  have e := avg_three_families_real s t u
    (fun _ _ v₃ => ‖∑ p ∈ u, (patternSign v₃ p : ℂ) * y p‖ ^ (4 : ℝ))
  rw [e]
  have hk := khintchine_four u y
  simp_rw [rademacherSum_complex] at hk
  have e2 : ((2 : ℝ) ^ s.card)⁻¹ * ∑ _v₁ ∈ s.powerset, (((2 : ℝ) ^ t.card)⁻¹ *
      ∑ _v₂ ∈ t.powerset, (((2 : ℝ) ^ u.card)⁻¹ * ∑ v₃ ∈ u.powerset,
        ‖∑ p ∈ u, (patternSign v₃ p : ℂ) * y p‖ ^ (4 : ℝ))) =
      rademacherMean u (fun v => ‖∑ p ∈ u, (patternSign v p : ℂ) * y p‖ ^ (4 : ℝ)) := by
    have h2 : ((2 : ℝ) ^ t.card)⁻¹ * ∑ _v₂ ∈ t.powerset, (((2 : ℝ) ^ u.card)⁻¹ *
        ∑ v₃ ∈ u.powerset, ‖∑ p ∈ u, (patternSign v₃ p : ℂ) * y p‖ ^ (4 : ℝ)) =
        rademacherMean u (fun v => ‖∑ p ∈ u, (patternSign v p : ℂ) * y p‖ ^ (4 : ℝ)) :=
      rademacherMean_const t _
    rw [h2]
    exact rademacherMean_const s _
  rw [e2]
  refine hk.trans ?_
  have : (0 : ℝ) ≤ (∑ p ∈ u, ‖y p‖ ^ 2) ^ 2 := sq_nonneg _
  nlinarith

