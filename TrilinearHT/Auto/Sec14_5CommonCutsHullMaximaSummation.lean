/-- The packet width of lem:height at height `y` for coefficient vectors of dimension at most
`2 d_max + 1`, in base-two units: `16 (2 d_max + 1)^3 log(2 max(2, y))` (from the natural-log
width `8 (d+1)^3 log(2B)` of `rational_logarithmic_cover_nat`). -/
noncomputable def packetW (dmax : ℕ) (y : ℝ) : ℝ :=
  16 * (2 * dmax + 1 : ℝ) ^ 3 * Real.log (2 * max 2 y)

theorem packetW_nonneg (dmax : ℕ) (y : ℝ) : 0 ≤ packetW dmax y := by
  unfold packetW
  have : 0 ≤ Real.log (2 * max 2 y) := Real.log_nonneg (by
    have := le_max_left 2 y; linarith)
  positivity

/-- Blueprint `mode-schedule` (lines 1944-1966) with `K` chosen last at the packet width of the
chosen height: there is a schedule with `eq:mode-parameters`, side parameters read off it, and
`log H ≤ M Λ^{12}`, `log T ≤ M Λ^{16}`, `K ≤ M Λ^{16}`. -/
theorem exists_attempt_schedule (Cj CA CT CK : ℕ) {δs : ℝ} (hδs : 0 < δs) (hδs1 : δs ≤ 1) :
    ∃ M : ℝ, 0 < M ∧ ∀ (dmax : ℕ) (Dstar Bstar Dm : ℝ) (Q0 : ℕ), 2 ≤ dmax → 2 ≤ Dstar →
      2 ≤ Bstar → 2 ≤ Dm → 1 ≤ Q0 →
      let Λ := (dmax : ℝ) + Real.log Dstar + Real.log Bstar + Real.log Dm + Real.log Q0 + 1
      ∃ S : ModeSchedule, S.dmax = dmax ∧ S.Dstar = Dstar ∧ S.Bstar = Bstar ∧ S.Dm = Dm ∧
        S.Q0 = Q0 ∧ S.Valid Cj CA CT CK δs (packetW dmax S.H) ∧
        Real.log S.H ≤ M * Λ ^ 12 ∧ Real.log S.T ≤ M * Λ ^ 16 ∧ (S.K : ℝ) ≤ M * Λ ^ 16 := by
  obtain ⟨M, hM, hch⟩ := chooseSchedule Cj CA CT CK hδs hδs1
  refine ⟨M + 32 * 27 * (2 + M), by positivity, ?_⟩
  intro dmax Dstar Bstar Dm Q0 hd hD hB hDm hQ Λ
  have hΛ1 : 1 ≤ Λ := by
    have := Real.log_nonneg (by linarith only [hD] : (1 : ℝ) ≤ Dstar)
    have := Real.log_nonneg (by linarith only [hB] : (1 : ℝ) ≤ Bstar)
    have := Real.log_nonneg (by linarith only [hDm] : (1 : ℝ) ≤ Dm)
    have := Real.log_nonneg (by exact_mod_cast hQ : (1 : ℝ) ≤ Q0)
    have : (0 : ℝ) ≤ dmax := Nat.cast_nonneg _
    simp only [Λ]; linarith
  have hdΛ : (dmax : ℝ) ≤ Λ := by
    have := Real.log_nonneg (by linarith only [hD] : (1 : ℝ) ≤ Dstar)
    have := Real.log_nonneg (by linarith only [hB] : (1 : ℝ) ≤ Bstar)
    have := Real.log_nonneg (by linarith only [hDm] : (1 : ℝ) ≤ Dm)
    have := Real.log_nonneg (by exact_mod_cast hQ : (1 : ℝ) ≤ Q0)
    simp only [Λ]; linarith
  have hS := hch dmax Dstar Bstar Dm (packetW dmax) Q0 hd hD hB hDm hQ (packetW_nonneg dmax)
  dsimp only at hS
  obtain ⟨S, h1, h2, h3, h4, h5, hV, hH, hT, hK⟩ := hS
  have hΛe : (dmax : ℝ) + Real.log Dstar + Real.log Bstar + Real.log Dm + Real.log Q0 + 1 = Λ :=
    rfl
  rw [hΛe] at hH hT hK
  clear_value Λ
  have hc0 : 0 ≤ 32 * 27 * (2 + M) := by positivity
  refine ⟨S, h1, h2, h3, h4, h5, hV, hH.trans ?_, hT.trans ?_, hK.trans ?_⟩
  · exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_right hc0)
      (pow_nonneg (by linarith only [hΛ1]) 12)
  · exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_right hc0)
      (pow_nonneg (by linarith only [hΛ1]) 16)
  clear hV hT hK
  -- the packet width at the chosen height
  have hlog : Real.log (2 * max 2 S.H) ≤ 2 + M * Λ ^ 12 := by
    have hMΛ : 0 ≤ M * Λ ^ 12 := mul_nonneg hM.le (pow_nonneg (by linarith only [hΛ1]) 12)
    rcases le_total S.H 2 with h | h
    · rw [max_eq_left h]
      have h4 : Real.log (2 * 2) ≤ 2 := by
        rw [Real.log_mul (by norm_num) (by norm_num)]
        linarith only [Real.log_two_lt_d9]
      linarith only [h4, hMΛ]
    · rw [max_eq_right h, Real.log_mul (by norm_num) (by linarith only [h])]
      linarith only [Real.log_two_lt_d9, hH, hMΛ]
  have hW : packetW dmax S.H ≤ 16 * 27 * Λ ^ 3 * (2 + M * Λ ^ 12) := by
    unfold packetW
    have h3 : (2 * dmax + 1 : ℝ) ^ 3 ≤ 27 * Λ ^ 3 := by
      have : (2 * dmax + 1 : ℝ) ≤ 3 * Λ := by linarith only [hdΛ, hΛ1]
      calc (2 * dmax + 1 : ℝ) ^ 3 ≤ (3 * Λ) ^ 3 := pow_le_pow_left₀ (by positivity) this 3
        _ = 27 * Λ ^ 3 := by ring
    have h0 : 0 ≤ Real.log (2 * max 2 S.H) := Real.log_nonneg (by
      have := le_max_left 2 S.H; linarith only [this])
    calc 16 * (2 * dmax + 1 : ℝ) ^ 3 * Real.log (2 * max 2 S.H)
        ≤ 16 * (27 * Λ ^ 3) * (2 + M * Λ ^ 12) := by gcongr
      _ = 16 * 27 * Λ ^ 3 * (2 + M * Λ ^ 12) := by ring
  have hp3 : Λ ^ 3 ≤ Λ ^ 16 := pow_le_pow_right₀ hΛ1 (by norm_num)
