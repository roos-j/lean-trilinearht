section PatternEstimates2
variable {W : Type*} [NormedAddCommGroup W] [NormedSpace ℂ W]

open Classical in
/-- Four factors bounded by `B`, of which at least three are bounded by `√w`, have product at most
`B w √w`. -/
theorem prod_four_le_of_three (f : Fin 4 → ℝ) (hf0 : ∀ l, 0 ≤ f l) {B w : ℝ} (hB : ∀ l, f l ≤ B)
    (Sd : Finset (Fin 4)) (hS : 3 ≤ Sd.card) (hw : ∀ l ∈ Sd, f l ≤ Real.sqrt w) :
    ∏ l, f l ≤ B * (w * Real.sqrt w) := by
  obtain ⟨T, hTS, hT3⟩ := Finset.exists_subset_card_eq hS
  have hsq := Real.sqrt_nonneg w
  rw [← Finset.prod_mul_prod_compl T]
  have h1 : ∏ l ∈ T, f l ≤ Real.sqrt w ^ 3 := by
    calc ∏ l ∈ T, f l ≤ ∏ _l ∈ T, Real.sqrt w :=
          Finset.prod_le_prod₀ (fun l _ => hf0 l) fun l hl => hw l (hTS hl)
      _ = Real.sqrt w ^ 3 := by rw [Finset.prod_const, hT3]
  have hc : Tᶜ.card = 1 := by rw [Finset.card_compl, hT3]; rfl
  have h2 : ∏ l ∈ Tᶜ, f l ≤ B := by
    obtain ⟨m, hm⟩ := Finset.card_eq_one.mp hc
    rw [hm, Finset.prod_singleton]; exact hB m
  have hB0 : 0 ≤ B := (hf0 0).trans (hB 0)
  have hw3 : Real.sqrt w ^ 3 = w * Real.sqrt w := by
    rcases le_or_gt 0 w with h | h
    · rw [pow_succ, Real.sq_sqrt h]
    · rw [Real.sqrt_eq_zero_of_nonpos h.le]; ring
  calc (∏ l ∈ T, f l) * ∏ l ∈ Tᶜ, f l ≤ Real.sqrt w ^ 3 * B :=
        mul_le_mul h1 h2 (Finset.prod_nonneg fun l _ => hf0 l) (by positivity)
    _ = B * (w * Real.sqrt w) := by rw [hw3]; ring

/-- `Σ w_i √w_i ≤ (Σ w_i) √(Σ w_i)` for nonnegative `w`. -/
theorem sum_mul_sqrt_le {γ : Type*} (s : Finset γ) (w : γ → ℝ) (hw : ∀ i ∈ s, 0 ≤ w i) :
    ∑ i ∈ s, w i * Real.sqrt (w i) ≤ (∑ i ∈ s, w i) * Real.sqrt (∑ i ∈ s, w i) := by
  rw [Finset.sum_mul]
  exact Finset.sum_le_sum fun i hi => mul_le_mul_of_nonneg_left
    (Real.sqrt_le_sqrt (Finset.single_le_sum hw hi)) (hw i hi)

open Classical in
/-- Blueprint `eq:three-sides` with `eq:min-power` (lines 2372-2390, 2447-2456): patterns
without errors and with at least three sides, with every piece of normalized size at most `B` and
the side weights `u_I = Σ_{G,l} ‖S_{G,l}‖² / |I|` having path sums at most `T`, contribute in the
active-cell minimum at most `η^{1-p} (81 C B)^p T^{3p/2} |R|` for `2/3 < p ≤ 1`. -/
theorem three_side_patterns_le (Gd : RealDyadicGrid) {γ : Type*} (S : Finset (ℤ × ℤ))
    (root : ℤ × ℤ) (hroot : ∀ I ∈ S, dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd root.1 root.2)
    (Gs : ℤ × ℤ → Finset γ) (Λ : ℤ × ℤ → MultilinearMap ℂ (fun _ : Fin 4 => W) ℂ) {C Bs : ℝ}
    (hC : 0 ≤ C) (hBs : 0 ≤ Bs)
    (hΛ : ∀ I ∈ S, ∀ x : Fin 4 → W, ‖Λ I x‖ ≤
      C * ∏ l, (‖x l‖ / Real.sqrt (dyadicGridLength Gd I.1)))
    (a s e : ℤ × ℤ → γ → Fin 4 → W)
    (hsize : ∀ I ∈ S, ∀ G ∈ Gs I, ∀ l, ‖a I G l‖ ≤ Bs * Real.sqrt (dyadicGridLength Gd I.1) ∧
      ‖s I G l‖ ≤ Bs * Real.sqrt (dyadicGridLength Gd I.1))
    {T : ℝ} (hT : ∀ x : ℝ, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell Gd I.1 I.2),
      ∑ G ∈ Gs I, ∑ l, ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1 ≤ T)
    {η p : ℝ} (hη : 0 ≤ η) (hp : 2 / 3 < p) (hp1 : p ≤ 1) :
    ∑ I ∈ S, dyadicGridLength Gd I.1 * min η ‖∑ σ ∈ Finset.univ.filter
        (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
          ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
      η ^ (1 - p) * (81 * C * Bs) ^ p *
        (T ^ (p / 2) * T ^ (p / 2) * T ^ (p / 2) * dyadicGridLength Gd root.1) := by
  set u : ℤ × ℤ → ℝ := fun I => ∑ G ∈ Gs I, ∑ l, ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1
  have hu0 : ∀ I, 0 ≤ u I := fun I => Finset.sum_nonneg fun G _ =>
    Finset.sum_nonneg fun l _ => div_nonneg (sq_nonneg _) (dyadicGridLength_pos Gd I.1).le
  have hp0 : 0 < p := by linarith
  -- one pattern at one cell
  have hpat : ∀ I ∈ S, ∀ σ ∈ Finset.univ.filter
      (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
      ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
        C * Bs * (u I * Real.sqrt (u I)) := by
    intro I hI σ hσ
    obtain ⟨hnoerr, hcnt⟩ := (Finset.mem_filter.mp hσ).2
    have hr := dyadicGridLength_pos Gd I.1
    have hsr := Real.sqrt_pos.mpr hr
    set wG : γ → ℝ := fun G => ∑ l, ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1
    have hwG0 : ∀ G, 0 ≤ wG G := fun G => Finset.sum_nonneg fun l _ =>
      div_nonneg (sq_nonneg _) hr.le
    have hG : ∀ G ∈ Gs I, ‖Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
        C * (Bs * (wG G * Real.sqrt (wG G))) := by
      intro G hG
      refine (hΛ I hI _).trans (mul_le_mul_of_nonneg_left ?_ hC)
      refine prod_four_le_of_three _ (fun l => by positivity) (fun l => ?_)
        (Finset.univ.filter fun l => σ l = 1) hcnt (fun l hl => ?_)
      · rw [div_le_iff₀ hsr]
        unfold patternPiece
        have h := hsize I hI G hG l
        have hσl := hnoerr l
        match hm : σ l with
        | 0 => simpa [hm] using h.1
        | 1 => simpa [hm] using h.2
        | 2 => exact absurd hm hσl
      · have hσl := (Finset.mem_filter.mp hl).2
        unfold patternPiece
        rw [hσl]
        change ‖s I G l‖ / Real.sqrt (dyadicGridLength Gd I.1) ≤ Real.sqrt (wG G)
        rw [div_le_iff₀ hsr, ← Real.sqrt_mul (hwG0 G)]
        have h1 : ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1 ≤ wG G :=
          Finset.single_le_sum (f := fun l => ‖s I G l‖ ^ 2 / dyadicGridLength Gd I.1)
            (fun l _ => div_nonneg (sq_nonneg _) hr.le) (Finset.mem_univ l)
        rw [← Real.sqrt_sq (norm_nonneg (s I G l))]
        refine Real.sqrt_le_sqrt ?_
        rw [div_le_iff₀ hr] at h1
        exact h1
    calc ‖∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖
        ≤ ∑ G ∈ Gs I, C * (Bs * (wG G * Real.sqrt (wG G))) :=
          (norm_sum_le _ _).trans (Finset.sum_le_sum hG)
      _ = C * Bs * ∑ G ∈ Gs I, wG G * Real.sqrt (wG G) := by
          rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun G _ => by ring
      _ ≤ C * Bs * (u I * Real.sqrt (u I)) :=
          mul_le_mul_of_nonneg_left (sum_mul_sqrt_le _ wG fun G _ => hwG0 G) (by positivity)
  have hcard : (Finset.univ.filter (fun σ : Fin 4 → Fin 3 =>
      (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1)).card ≤ 81 := by
    refine (Finset.card_filter_le _ _).trans ?_
    simp
  -- the active minimum at one cell
  have hcell : ∀ I ∈ S, dyadicGridLength Gd I.1 * min η ‖∑ σ ∈ Finset.univ.filter
      (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
        ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
      η ^ (1 - p) * (81 * C * Bs) ^ p * (dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p) := by
    intro I hI
    have hr := dyadicGridLength_pos Gd I.1
    have hX : ‖∑ σ ∈ Finset.univ.filter
        (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
          ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ≤
        81 * C * Bs * (u I * Real.sqrt (u I)) := by
      refine (norm_sum_le _ _).trans ?_
      calc _ ≤ ∑ _σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 =>
            (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1), C * Bs * (u I * Real.sqrt (u I)) :=
            Finset.sum_le_sum fun σ hσ => hpat I hI σ hσ
        _ ≤ 81 * (C * Bs * (u I * Real.sqrt (u I))) := by
            rw [Finset.sum_const, nsmul_eq_mul]
            exact mul_le_mul_of_nonneg_right (by exact_mod_cast hcard)
              (by have := hu0 I; positivity)
        _ = _ := by ring
    have hm := min_le_rpow_mul (η := η) hη (norm_nonneg _) hp0.le hp1
      (x := ‖∑ σ ∈ Finset.univ.filter
        (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
          ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖)
    have hpow : ‖∑ σ ∈ Finset.univ.filter
        (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧ 3 ≤ patternCount σ 1),
          ∑ G ∈ Gs I, Λ I (patternPiece (a I G) (s I G) (e I G) σ)‖ ^ p ≤
        (81 * C * Bs) ^ p * (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p := by
      rw [← Real.mul_rpow (by positivity) (by positivity)]
      refine Real.rpow_le_rpow (norm_nonneg _) (hX.trans (le_of_eq ?_)) hp0.le
      rw [Real.mul_self_sqrt (hu0 I)]
    calc dyadicGridLength Gd I.1 * min η _
        ≤ dyadicGridLength Gd I.1 * (η ^ (1 - p) * ((81 * C * Bs) ^ p *
            (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p)) :=
          mul_le_mul_of_nonneg_left (hm.trans (mul_le_mul_of_nonneg_left hpow
            (Real.rpow_nonneg hη _))) hr.le
      _ = _ := by ring
  have hpc := power_cost_bound Gd S (fun I => Real.sqrt (u I)) (fun I => Real.sqrt (u I))
    (fun I => Real.sqrt (u I)) (fun I _ => Real.sqrt_nonneg _) (fun I _ => Real.sqrt_nonneg _)
    (fun I _ => Real.sqrt_nonneg _) root hroot (Ca := T) (Cb := T) (Cc := T)
    (fun x => by simp_rw [Real.sq_sqrt (hu0 _)]; exact hT x)
    (fun x => by simp_rw [Real.sq_sqrt (hu0 _)]; exact hT x)
    (fun x => by simp_rw [Real.sq_sqrt (hu0 _)]; exact hT x) hp
  calc _ ≤ ∑ I ∈ S, η ^ (1 - p) * (81 * C * Bs) ^ p * (dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p) := Finset.sum_le_sum hcell
    _ = η ^ (1 - p) * (81 * C * Bs) ^ p * ∑ I ∈ S, dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p := by rw [Finset.mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left hpc (by positivity)

end PatternEstimates2

section PatternEstimates3
variable {W : Type*} [NormedAddCommGroup W] [NormedSpace ℂ W]

open Classical in
/-- Blueprint `eq:min-power` with `eq:three-sides` integrated over paths: cell quantities bounded by
`K u_I √u_I`, where the weights `u_I` have path sums at most `T`, contribute to the active
minimum at most `η^{1-p} K^p T^{3p/2} |R|`. -/
theorem power_min_sum_le (Gd : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (root : ℤ × ℤ)
    (hroot : ∀ I ∈ S, dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd root.1 root.2)
    (x u : ℤ × ℤ → ℝ) (hx : ∀ I ∈ S, 0 ≤ x I) (hu : ∀ I, 0 ≤ u I) {K T : ℝ} (hK : 0 ≤ K)
    (hxu : ∀ I ∈ S, x I ≤ K * (u I * Real.sqrt (u I)))
    (hT : ∀ y : ℝ, ∑ I ∈ S.filter (fun I => y ∈ dyadicGridCell Gd I.1 I.2), u I ≤ T)
    {η p : ℝ} (hη : 0 ≤ η) (hp : 2 / 3 < p) (hp1 : p ≤ 1) :
    ∑ I ∈ S, dyadicGridLength Gd I.1 * min η (x I) ≤
      η ^ (1 - p) * K ^ p * (T ^ (p / 2) * T ^ (p / 2) * T ^ (p / 2) *
        dyadicGridLength Gd root.1) := by
  have hp0 : 0 < p := by linarith
  have hcell : ∀ I ∈ S, dyadicGridLength Gd I.1 * min η (x I) ≤
      η ^ (1 - p) * K ^ p * (dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p) := by
    intro I hI
    have hr := dyadicGridLength_pos Gd I.1
    have hm := min_le_rpow_mul hη (hx I hI) hp0.le hp1
    have hpow : x I ^ p ≤ K ^ p * (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p := by
      rw [← Real.mul_rpow hK (by positivity)]
      refine Real.rpow_le_rpow (hx I hI) ((hxu I hI).trans (le_of_eq ?_)) hp0.le
      rw [Real.mul_self_sqrt (hu I)]
    calc dyadicGridLength Gd I.1 * min η (x I)
        ≤ dyadicGridLength Gd I.1 * (η ^ (1 - p) * (K ^ p *
            (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p)) :=
          mul_le_mul_of_nonneg_left (hm.trans (mul_le_mul_of_nonneg_left hpow
            (Real.rpow_nonneg hη _))) hr.le
      _ = _ := by ring
  have hpc := power_cost_bound Gd S (fun I => Real.sqrt (u I)) (fun I => Real.sqrt (u I))
    (fun I => Real.sqrt (u I)) (fun I _ => Real.sqrt_nonneg _) (fun I _ => Real.sqrt_nonneg _)
    (fun I _ => Real.sqrt_nonneg _) root hroot (Ca := T) (Cb := T) (Cc := T)
    (fun y => by simp_rw [Real.sq_sqrt (hu _)]; exact hT y)
    (fun y => by simp_rw [Real.sq_sqrt (hu _)]; exact hT y)
    (fun y => by simp_rw [Real.sq_sqrt (hu _)]; exact hT y) hp
  calc _ ≤ ∑ I ∈ S, η ^ (1 - p) * K ^ p * (dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p) := Finset.sum_le_sum hcell
    _ = η ^ (1 - p) * K ^ p * ∑ I ∈ S, dyadicGridLength Gd I.1 *
        (Real.sqrt (u I) * Real.sqrt (u I) * Real.sqrt (u I)) ^ p := by rw [Finset.mul_sum]
    _ ≤ _ := mul_le_mul_of_nonneg_left hpc (by positivity)

end PatternEstimates3

