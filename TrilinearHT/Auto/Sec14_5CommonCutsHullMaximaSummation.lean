/-- A linear map commutes with the selection of a pattern piece. -/
theorem map_patternPiece {V W : Type*} [AddCommGroup V] [Module ℂ V] [AddCommGroup W] [Module ℂ W]
    (f : V →ₗ[ℂ] W) (a s e : Fin 4 → V) (σ : Fin 4 → Fin 3) :
    (fun l => f (patternPiece a s e σ l)) =
      patternPiece (fun l => f (a l)) (fun l => f (s l)) (fun l => f (e l)) σ := by
  funext l
  unfold patternPiece
  generalize σ l = j
  fin_cases j <;> rfl

