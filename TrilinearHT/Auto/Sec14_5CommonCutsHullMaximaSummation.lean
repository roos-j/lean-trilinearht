theorem pieceInternal_sub_hull {G : RealDyadicGrid} {H : Finset (ℤ × ℤ)} {Q : ℤ × ℤ}
    {C : Finset (ℤ × ℤ)} (hQ : Q ∈ H)
    (hC : ∀ c ∈ C, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G Q.1 Q.2)
    (hhull : ∀ c ∈ C, ∀ d : ℤ × ℤ, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
      dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G Q.1 Q.2 → d ∈ H) :
    pieceInternal G Q C ⊆ H := by
  intro d hd
  rcases (mem_pieceInternal hC).mp hd with rfl | ⟨c, hc, hcd, hdQ⟩
  · exact hQ
  · exact hhull c hc d hcd hdQ

open Classical in
/-- Blueprint lines 2421-2445 (`eq:near-band` before the transfer coefficient): for indices `n`
with retained hulls `H_n`, disjoint hull roots `Rt_n ⊆ H_n` in `R`, use cells `U_n` within `K`
depths of their roots, randomized side stacks `x_n` (positions and bands), `w_n` (positions) and
the frozen complementary band stack `y_n` of averages at most `B_c²` on the hulls, the selected
matched band sums with arbitrary signs satisfy
`7 Σ_n |Σ_{I ∈ U_n} |I| ε_I Σ_p Λ_I(…)| ≤ 8 C (1+C_N) log K K^{2(q-2)/(q-1)} B_c B_d √(AB) |R|`
under the joint hull caps `Σ_n m_{a,n} ≤ A`, `Σ_n m_{b,n} ≤ B` on `R`. -/
theorem near_band_bound (κ : LocalKernelClass) {q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) :
    ∃ Cq : ℝ, 0 ≤ Cq ∧ ∀ (G : RealDyadicGrid) (K Nd : ℕ), K ≤ Nd → 1 ≤ K →
      ∀ {N : Type*} (Ns : Finset N) (H Rt U : N → Finset (ℤ × ℤ)) {R : Set ℝ},
      MeasurableSet R → (∀ n ∈ Ns, Rt n ⊆ H n) →
      (∀ n ∈ Ns, (Rt n : Set (ℤ × ℤ)).PairwiseDisjoint fun c => dyadicGridCell G c.1 c.2) →
      (∀ n ∈ Ns, ∀ r ∈ Rt n, dyadicGridCell G r.1 r.2 ⊆ R) → (∀ n ∈ Ns, U n ⊆ H n) →
      (∀ n ∈ Ns, ∀ c ∈ U n, ∃ r ∈ Rt n, dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G r.1 r.2) →
      (∀ n ∈ Ns, ∀ c ∈ U n, ∀ r ∈ Rt n,
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G r.1 r.2 → c.1 < r.1 + K) →
      (∀ n ∈ Ns, ∀ c ∈ U n, ∀ r ∈ Rt n, ∀ d : ℤ × ℤ,
        dyadicGridCell G c.1 c.2 ⊆ dyadicGridCell G d.1 d.2 →
        dyadicGridCell G d.1 d.2 ⊆ dyadicGridCell G r.1 r.2 → d ∈ H n) →
      ∀ {ι κ' β : Type} [DecidableEq ι] [DecidableEq κ'] [DecidableEq β]
      (s : N → Finset ι) (t : N → Finset κ') (u : N → Finset β) {a b c : Fin 4},
      a ≠ b → a ≠ c → b ≠ c →
      ∀ (f : N → Fin 4 → ℝ → ℂ) (x : N → ι → β → ℝ → ℂ) (w : N → κ' → ℝ → ℂ)
        (y : N → β → ℝ → ℂ),
      (∀ n j, Measurable (f n j)) → (∀ n i p, Measurable (x n i p)) →
      (∀ n k, Measurable (w n k)) → (∀ n p, Measurable (y n p)) →
      ∀ {A B : ℝ≥0∞},
      (∀ z ∈ R, ∑ n ∈ Ns, dyadicHullMax G (H n)
        (fun r => ENNReal.ofReal (∑ i ∈ s n, ∑ p ∈ u n, ‖x n i p r‖ ^ 2)) z ≤ A) →
      (∀ z ∈ R, ∑ n ∈ Ns, dyadicHullMax G (H n)
        (fun r => ENNReal.ofReal (∑ k ∈ t n, ‖w n k r‖ ^ 2)) z ≤ B) →
      (∀ n ∈ Ns, ∀ d ∈ H n, dyadicEnergyAverage G
        (fun r => ENNReal.ofReal (∑ i ∈ s n, ∑ p ∈ u n, ‖x n i p r‖ ^ 2)) d ≠ ⊤) →
      (∀ n ∈ Ns, ∀ d ∈ H n, dyadicEnergyAverage G
        (fun r => ENNReal.ofReal (∑ k ∈ t n, ‖w n k r‖ ^ 2)) d ≠ ⊤) →
      ∀ (kernel : N → ℤ × ℤ → ℝ × ℝ → ℂ), (∀ n ∈ Ns, ∀ I ∈ H n, IsAdmissibleLocalKernel κ
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1) (kernel n I)) →
      (∀ n ∈ Ns, ∀ I ∈ U n, ∀ j, eLpNorm (f n j) 2 (normalizedIntervalMeasure
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ n ∈ Ns, ∀ I ∈ U n, ∀ i p, eLpNorm (x n i p) 2 (normalizedIntervalMeasure
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ n ∈ Ns, ∀ I ∈ U n, ∀ k, eLpNorm (w n k) 2 (normalizedIntervalMeasure
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≠ ⊤) →
      (∀ n ∈ Ns, ∀ I ∈ U n, ∀ p, eLpNorm (y n p) 2 (normalizedIntervalMeasure
        (dyadicGridLeft G I.1 I.2) (dyadicGridLength G I.1)) ≠ ⊤) →
      ∀ {Bc Bd : ℝ}, 0 ≤ Bc → 0 ≤ Bd →
      (∀ n ∈ Ns, ∀ d ∈ H n, dyadicEnergyAverage G
        (fun r => ENNReal.ofReal (∑ p ∈ u n, ‖y n p r‖ ^ 2)) d ≤ ENNReal.ofReal (Bc ^ 2)) →
      (∀ n ∈ Ns, ∀ j, j ≠ a → j ≠ b → j ≠ c → ∀ d ∈ H n,
        dyadicEnergyAverage G (fun r => ‖f n j r‖ₑ ^ 2) d ≤ ENNReal.ofReal (Bd ^ 2)) →
      ∀ (sa : N → ℤ × ℤ → ι) (sb : N → ℤ × ℤ → κ'), (∀ n ∈ Ns, ∀ I ∈ U n, sa n I ∈ s n) →
      (∀ n ∈ Ns, ∀ I ∈ U n, sb n I ∈ t n) →
      ∀ sg : N → ℤ × ℤ → ℂ, (∀ n I, ‖sg n I‖ ≤ 1) →
      7 * ∑ n ∈ Ns, ‖∑ I ∈ U n, (dyadicGridLength G I.1 : ℂ) * (sg n I * ∑ p ∈ u n,
          localProgressionForm (dyadicGridLength G I.1) (kernel n I) (Function.update
            (Function.update (Function.update (f n) a (x n (sa n I) p)) b (w n (sb n I))) c
              (y n p)))‖ₑ ≤
        8 * ENNReal.ofReal (Cq * (1 + finiteDepthConstant κ q Nd) *
          (1 + Real.log ((K : ℝ) + 2)) * ((K : ℝ) + 2) ^ (2 * (q - 2) / (q - 1)) *
            (64 * Bc * Bd)) * ((A * B) ^ (1 / 2 : ℝ) * volume R) := by
  obtain ⟨Cq, hCq, hsp⟩ := sparse_piece_bound κ hq2 hq3
  refine ⟨Cq, hCq, ?_⟩
  intro G K Nd hKN hK N Ns H Rt U R hRm hRtH hRtdis hRtR hUH hUr hdep hclos ι κ' β _ _ _ s t u
    a b c hab hac hbc f x w y hf hx hw hy A B hA hB hAf hBf kernel hker hff hxf hwf hyf Bc Bd
    hBc hBd hcB hdB sa sb hsa hsb sg hsg
  refine sparse_root_sum G Ns K H Rt U
    (fun n r => ENNReal.ofReal (∑ i ∈ s n, ∑ p ∈ u n, ‖x n i p r‖ ^ 2))
    (fun n r => ENNReal.ofReal (∑ k ∈ t n, ‖w n k r‖ ^ 2)) hRm hRtH hRtdis hRtR hUH hUr hdep
    hclos hA hB _ _ ?_
  intro n hn Q C hQ hCU hC hdepth hown hhull
  have hint := pieceInternal_sub_hull hQ hC hhull
  exact hsp G K Nd hKN hK (H n) Q C hC hdepth (s n) (t n) (u n) hab hac hbc (f n) (x n) (w n)
    (y n) (hf n) (hx n) (hw n) (hy n) hown hhull (hAf n hn Q hQ) (hBf n hn Q hQ) (kernel n)
    (fun I hI => hker n hn I (hint hI)) (fun I hI => hff n hn I (hCU hI))
    (fun I hI => hxf n hn I (hCU hI)) (fun I hI => hwf n hn I (hCU hI))
    (fun I hI => hyf n hn I (hCU hI)) hBc hBd (fun d hd => hcB n hn d (hint hd))
    (fun j h1 h2 h3 d hd => hdB n hn j h1 h2 h3 d (hint hd)) (sa n) (sb n)
    (fun I hI => hsa n hn I (hCU hI)) (fun I hI => hsb n hn I (hCU hI)) (sg n) (hsg n)

end NearBandBound

