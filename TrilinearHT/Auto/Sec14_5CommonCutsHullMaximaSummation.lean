/-- The product of two distinct entries of a nonnegative family is at most its sum of squares. -/
theorem mul_le_sum_sq_fin4 (v : Fin 4 → ℝ) {a b : Fin 4} (hab : a ≠ b) :
    v a * v b ≤ ∑ l, v l ^ 2 := by
  have h2 : v a ^ 2 + v b ^ 2 ≤ ∑ l, v l ^ 2 := by
    rw [← Finset.sum_pair (f := fun l => v l ^ 2) hab]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
      fun _ _ _ => sq_nonneg _
  nlinarith [sq_nonneg (v a - v b)]

