variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (T : ap.TTData)

theorem ns_nonneg (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) : 0 ≤ T.ns l G I := by
  unfold ns; positivity

theorem ns_mul_le {a b : Fin 4} (hab : a ≠ b) (G : A.Grp) (I : ℤ × ℤ) :
    T.ns a G I * T.ns b G I ≤ T.s2 G I :=
  mul_le_sum_sq_fin4 (fun l => T.ns l G I) hab

/-- The restricted normalized size is at most the normalized side size. -/
theorem restr_ns_le (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) :
    ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (T.side l G I)‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ T.ns l G I :=
  div_le_div_of_nonneg_right ((pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _)
    two_ne_zero).mp (columnL2Restriction_norm_sq_le _ _ _)) (Real.sqrt_nonneg _)

/-- The restricted normalized size of any column is at most its normalized size. -/
theorem restr_div_le (I : ℤ × ℤ) (v : ColumnL2 (Fin ap.Mc)) :
    ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2) v‖ /
      Real.sqrt (dyadicGridLength A.G I.1) ≤ ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) :=
  div_le_div_of_nonneg_right ((pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _)
    two_ne_zero).mp (columnL2Restriction_norm_sq_le _ _ _)) (Real.sqrt_nonneg _)

/-- Blueprint lines 2446-2456 for a core slot carrying a basic `U` side, or a cell without
decision cell: the core vanishes, the restored output is a side, and the restored form is at most
the side square sum times `C_κ B₀` times the third side size. -/
theorem ucore_le {a b c d : Fin 4} (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c)
    (hbd : b ≠ d) (hcd : c ≠ d) (G : A.Grp) (I : ℤ × ℤ) {B₀ : ℝ} (hB₀ : 0 ≤ B₀)
    (hout : ∀ l, ‖T.out l G I‖ ≤ B₀ * Real.sqrt (dyadicGridLength A.G I.1))
    (hu : (T.D.usl c ∨ ¬ T.D.hasDecision I) ∨ (T.D.usl d ∨ ¬ T.D.hasDecision I)) :
    ‖ap.Λc I (Function.update (Function.update (fun l => T.side l G I) c (T.out c G I)) d
        (T.out d G I))‖ ≤
      T.s2 G I * (localFormUniformConstant κ' * B₀ * (T.ns c G I + T.ns d G I)) := by
  have hs : 0 < Real.sqrt (dyadicGridLength A.G I.1) :=
    Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  have hCκ : 0 ≤ localFormUniformConstant κ' := localFormUniformConstant_nonneg κ'
  have hob : ∀ l, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.out l G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1) ≤ B₀ := fun l =>
    (restr_div_le I _).trans ((div_le_iff₀ hs).mpr (hout l))
  have hns : ∀ l, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.side l G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1) ≤ T.ns l G I := fun l => T.restr_ns_le l G I
  have hr0 : ∀ v : ColumnL2 (Fin ap.Mc), 0 ≤ ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) v‖ / Real.sqrt (dyadicGridLength A.G I.1) :=
    fun v => by positivity
  have hsab := T.ns_mul_le hab G I
  have hsa := T.ns_nonneg a G I
  have hsb := T.ns_nonneg b G I
  have hsc := T.ns_nonneg c G I
  have hsd := T.ns_nonneg d G I
  refine (ap.Λc_four_le I hab hac had hbc hbd hcd (fun l => T.side l G I) _ _).trans ?_
  have hab' : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.side a G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1) *
      (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.side b G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1)) ≤ T.s2 G I :=
    (mul_le_mul (hns a) (hns b) (hr0 _) hsa).trans hsab
  have hcd' : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.out c G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1) *
      (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.out d G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1)) ≤ B₀ * (T.ns c G I + T.ns d G I) := by
    rcases hu with hc | hd
    · have e : T.out c G I = T.side c G I := (T.D.side_eq_out c G I _ _ hc).symm
      rw [e]
      calc _ ≤ T.ns c G I * B₀ := mul_le_mul (hns c) (hob d) (hr0 _) hsc
        _ ≤ _ := by nlinarith
    · have e : T.out d G I = T.side d G I := (T.D.side_eq_out d G I _ _ hd).symm
      rw [e]
      calc _ ≤ B₀ * T.ns d G I := mul_le_mul (hob c) (hns d) (hr0 _) hB₀
        _ ≤ _ := by nlinarith
  calc localFormUniformConstant κ' * (_ * _ * _ * _)
      = localFormUniformConstant κ' * ((‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.side a G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1) *
      (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.side b G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1))) * (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.out c G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1) *
      (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.out d G I)‖ /
        Real.sqrt (dyadicGridLength A.G I.1)))) := by ring
    _ ≤ localFormUniformConstant κ' * (T.s2 G I * (B₀ * (T.ns c G I + T.ns d G I))) :=
        mul_le_mul_of_nonneg_left (mul_le_mul hab' hcd' (mul_nonneg (hr0 _) (hr0 _))
          (T.s2_nonneg G I)) hCκ
    _ = _ := by ring

