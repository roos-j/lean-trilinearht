variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

open Classical in
/-- The near band defect of one step, by offsets: the sum over the five offsets `o` of
`(2 - o)/P` times the band sums with the paired bands `p` and `p + o - 2`. -/
theorem defTerm_near (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ) (a c d : Fin 4)
    (x : Fin 4 → E) (yc yd : E) (st : TransferStep E) (rest : List (TransferStep E)) (xa : E) :
    defTerm Λ P a c d x yc yd (fun p q => ¬ (q + 2 < p ∨ p + 2 < q)) st rest xa =
      ∑ o ∈ Finset.range 5, (((2 : ℂ) - o) / P) * ∑ p ∈ (Finset.range (P + 1)).filter
        (fun p => 2 ≤ p + o ∧ p + o - 2 ≤ P),
        Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (p + o - 2 + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 (p + o - 2) (chainVal P st.1 rest (if st.1 then yc else yd)))) := by
  unfold defTerm
  have h := near_pairs_offsets (M := ℂ) P (fun p q => Λ (Function.update (Function.update
    (Function.update (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd))
      a (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
        (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
          st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd)))))
  simp only [smul_eq_mul] at h
  exact h

end NearTerm

theorem posExpand_coef : ∀ (ls : List (ℕ × Bool)), ∀ t ∈ posExpand ls, ‖(t.1 : ℂ)‖ ≤ 1
  | [], t, ht => by simp only [posExpand, List.mem_singleton] at ht; subst ht; simp
  | (m, false) :: rest, t, ht => by
    simp only [posExpand, List.mem_map] at ht
    obtain ⟨t', ht', rfl⟩ := ht
    exact posExpand_coef rest t' ht'
  | (m, true) :: rest, t, ht => by
    simp only [posExpand, List.mem_append, List.mem_map] at ht
    rcases ht with ht | ⟨t', ht', rfl⟩
    · exact posExpand_coef rest t ht
    · simp only [Int.cast_neg, norm_neg]
      exact posExpand_coef rest t' ht'

theorem norm_list_map_sum_le {α E : Type*} [SeminormedAddCommGroup E] (L : List α) (f : α → E) :
    ‖(L.map f).sum‖ ≤ (L.map fun x => ‖f x‖).sum := by
  induction L with
  | nil => simp
  | cons x L ih =>
    simp only [List.map_cons, List.sum_cons]
    exact (norm_add_le _ _).trans (add_le_add le_rfl ih)

theorem list_map_sum_le {α : Type*} (L : List α) {f g : α → ℝ} (h : ∀ x ∈ L, f x ≤ g x) :
    (L.map f).sum ≤ (L.map g).sum := by
  induction L with
  | nil => simp
  | cons x L ih =>
    simp only [List.map_cons, List.sum_cons]
    exact add_le_add (h x (List.mem_cons_self ..)) (ih fun y hy => h y (List.mem_cons_of_mem _ hy))

