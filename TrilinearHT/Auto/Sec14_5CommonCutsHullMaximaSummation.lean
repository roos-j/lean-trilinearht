  exact D.leaf_three_sides S gs (fun I hI => hSc I (Finset.mem_filter.mp (hS hI)).1)
    (fun I l G => ap.leafOut cat s₀ I l G) (fun I l G => ap.leafOut cat s₀ (D.dcell I) l G)
    (by positivity) hsize hT hη hp hp1

