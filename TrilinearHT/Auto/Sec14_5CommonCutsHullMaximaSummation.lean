/-- The cell form with two slots updated is at most `C_κ` times the four normalized restricted
sizes. -/
theorem Λc_four_le (I : ℤ × ℤ) {a b c d : Fin 4} (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (x : Fin 4 → ColumnL2 (Fin ap.Mc))
    (vc vd : ColumnL2 (Fin ap.Mc)) :
    ‖ap.Λc I (Function.update (Function.update x c vc) d vd)‖ ≤
      localFormUniformConstant κ' *
        ((‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          (x a)‖ / Real.sqrt (dyadicGridLength A.G I.1)) *
        (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          (x b)‖ / Real.sqrt (dyadicGridLength A.G I.1)) *
        (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          vc‖ / Real.sqrt (dyadicGridLength A.G I.1)) *
        (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          vd‖ / Real.sqrt (dyadicGridLength A.G I.1))) := by
  refine (ap.norm_Λc_le_restrict I _).trans (le_of_eq ?_)
  rw [prod_fin4_distinct hab hac had hbc hbd hcd]
  simp only [Function.update_self, Function.update_of_ne hcd, Function.update_of_ne hac,
    Function.update_of_ne had, Function.update_of_ne hbc, Function.update_of_ne hbd]

