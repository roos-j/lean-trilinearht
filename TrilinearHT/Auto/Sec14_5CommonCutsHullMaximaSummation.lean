theorem core_add_side_add_err (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ)
    (Zout ZU : ColumnL2 (Fin ap.Mc)) :
    D.core l G I ZU + D.side l G I Zout ZU + D.err l G I ZU = Zout := by
