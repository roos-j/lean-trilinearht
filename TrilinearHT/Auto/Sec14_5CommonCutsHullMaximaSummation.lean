/-- Blueprint `eq:min-power` (line 2445): `min(η, x) ≤ η^{1-p} x^p` for `x ≥ 0`, `0 ≤ p ≤ 1`. -/
theorem min_le_rpow_mul {η x p : ℝ} (hη : 0 ≤ η) (hx : 0 ≤ x) (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    min η x ≤ η ^ (1 - p) * x ^ p := by
  rcases le_total η x with h | h
  · rw [min_eq_left h]
    calc η = η ^ (1 - p) * η ^ p := by
          rcases hη.eq_or_lt with h0 | h0
          · rw [← h0]
            rcases hp0.eq_or_lt with hp | hp
            · rw [← hp]; simp
            · rw [Real.zero_rpow hp.ne', mul_zero]
          · rw [← Real.rpow_add h0]; simp
      _ ≤ η ^ (1 - p) * x ^ p :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hη h hp0) (Real.rpow_nonneg hη _)
  · rw [min_eq_right h]
    calc x = x ^ (1 - p) * x ^ p := by
          rcases hx.eq_or_lt with h0 | h0
          · rw [← h0]
            rcases hp0.eq_or_lt with hp | hp
            · rw [← hp]; simp
            · rw [Real.zero_rpow hp.ne', mul_zero]
          · rw [← Real.rpow_add h0]; simp
      _ ≤ η ^ (1 - p) * x ^ p :=
          mul_le_mul_of_nonneg_right (Real.rpow_le_rpow hx h (by linarith))
            (Real.rpow_nonneg hx _)

/-- The chain of consecutive intervals `[b, b + l₀], [b + l₀, b + l₀ + l₁], …`. -/
def intervalChain : ℕ → List ℕ → List (ℕ × ℕ)
  | _, [] => []
  | b, l :: ls => (b, b + l) :: intervalChain (b + l) ls

theorem intervalChain_lengths (b : ℕ) (ls : List ℕ) :
    (intervalChain b ls).map (fun I => I.2 - I.1) = ls := by
  induction ls generalizing b with
  | nil => rfl
  | cons l ls ih => simp [intervalChain, ih]

theorem intervalChain_mem (b : ℕ) (ls : List ℕ) :
    ∀ I ∈ intervalChain b ls, b ≤ I.1 ∧ I.1 ≤ I.2 ∧ I.2 ≤ b + ls.sum := by
  induction ls generalizing b with
  | nil => simp [intervalChain]
  | cons l ls ih =>
    intro I hI
    simp only [intervalChain, List.mem_cons] at hI
    rcases hI with rfl | hI
    · simp only [List.sum_cons]; omega
    · have := ih (b + l) I hI
      simp only [List.sum_cons]; omega

theorem intervalChain_telescope {M : Type*} [AddCommGroup M] (W : ℕ → M) (b : ℕ)
    (ls : List ℕ) :
    W (b + ls.sum) = W b + ((intervalChain b ls).map fun I => W I.2 - W I.1).sum := by
  induction ls generalizing b with
  | nil => simp [intervalChain]
  | cons l ls ih =>
    simp only [intervalChain, List.map_cons, List.sum_cons]
    rw [← add_assoc, ih (b + l)]
    abel

/-- Blueprint lines 2409-2412 (fixed stacks): `W_s = W_b + Σ_{[r,t] ∈ 𝒫(b,s)} (W_t - W_r)` over the
binary partition of the prefix `[b, s]`, with at most one interval of each dyadic length. -/
theorem binary_prefix_expansion {M : Type*} [AddCommGroup M] (W : ℕ → M) (b n : ℕ) :
    ∃ L : List (ℕ × ℕ), (L.map fun I => I.2 - I.1).Nodup ∧
      (∀ I ∈ L, b ≤ I.1 ∧ I.1 ≤ I.2 ∧ I.2 ≤ b + n ∧ ∃ k, I.2 - I.1 = 2 ^ k) ∧
      W (b + n) = W b + (L.map fun I => W I.2 - W I.1).sum := by
  set ls := n.bitIndices.map (2 ^ ·)
  have hsum : ls.sum = n := Nat.sum_map_two_pow_bitIndices n
  refine ⟨intervalChain b ls, ?_, ?_, ?_⟩
  · rw [intervalChain_lengths]
    exact Nat.bitIndices_nodup.map (Nat.pow_right_injective le_rfl)
  · intro I hI
    obtain ⟨h1, h2, h3⟩ := intervalChain_mem b ls I hI
    refine ⟨h1, h2, hsum ▸ h3, ?_⟩
    have hlen : I.2 - I.1 ∈ ls := by
      rw [← intervalChain_lengths b ls]; exact List.mem_map_of_mem hI
    obtain ⟨k, -, hk⟩ := List.mem_map.mp hlen
    exact ⟨k, hk.symm⟩
  · have := intervalChain_telescope W b ls
    rwa [hsum] at this

/-- Blueprint lines 2433-2436: on each remainder the stopping cell gives
`a_Q b_Q ≤ √(m_a m_b)`, and pointwise Cauchy–Schwarz over the indices `ν` gives
`Σ_ν √(m_{a,ν} m_{b,ν}) ≤ √(Σ_ν m_{a,ν}) √(Σ_ν m_{b,ν})`. -/
theorem hull_maxima_cauchy_schwarz {ι : Type*} (s : Finset ι) (ma mb : ι → ℝ)
    (ha : ∀ i ∈ s, 0 ≤ ma i) (hb : ∀ i ∈ s, 0 ≤ mb i) :
    ∑ i ∈ s, Real.sqrt (ma i * mb i) ≤
      Real.sqrt (∑ i ∈ s, ma i) * Real.sqrt (∑ i ∈ s, mb i) := by
  have := Real.sum_mul_le_sqrt_mul_sqrt s (fun i => Real.sqrt (ma i)) (fun i => Real.sqrt (mb i))
  calc ∑ i ∈ s, Real.sqrt (ma i * mb i) = ∑ i ∈ s, Real.sqrt (ma i) * Real.sqrt (mb i) :=
        Finset.sum_congr rfl fun i hi => Real.sqrt_mul (ha i hi) _
    _ ≤ _ := this
    _ = _ := by
        congr 2
        · exact Finset.sum_congr rfl fun i hi => Real.sq_sqrt (ha i hi)
        · exact Finset.sum_congr rfl fun i hi => Real.sq_sqrt (hb i hi)

