theorem derivative_graph_small_difference {q : ℕ} [NeZero q]
    (f : ZMod q → ℂ) (hf : ∀ x, ‖f x‖ ≤ 1) {δ : ℝ} (hδ : 0 < δ)
    (hU : δ ≤ gowersNorm (finiteHaar (ZMod q)) 3 f) :
