/-- The integrable envelope used for the Gram matrix in the Fourier row estimate. -/
noncomputable def quadraticTimeEnvelope (Lambda t s : ℝ) : ℝ :=
  (1 + (Lambda * (t - s)) ^ 2)⁻¹

theorem integral_quadraticTimeEnvelope_univ_eq_pi_div
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    (∫ s : Real, quadraticTimeEnvelope Lambda t s) = Real.pi / Lambda := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hfcont : Continuous f := by
    dsimp [f]
    apply Continuous.inv₀
    · fun_prop
    · intro u
      positivity
  have hrewrite : (fun s : Real => quadraticTimeEnvelope Lambda t s) =
      fun s => f (Lambda * (s - t)) := by
    funext s
    unfold quadraticTimeEnvelope
    dsimp [f]
    congr 2
    ring
  rw [hrewrite]
  have htranslation :
      (∫ s : Real, f (Lambda * (s - t))) =
        ∫ x : Real, f (Lambda * x) := by
    let g : Real → Real := fun x => f (Lambda * x)
    have hgcont : Continuous g :=
      hfcont.comp (continuous_const.mul continuous_id)
    have hmap : Measure.map (fun x : Real => x + (-t)) volume = volume :=
      map_add_right_eq_self volume (-t)
    have hphi : AEMeasurable (fun x : Real => x + (-t)) volume :=
      (continuous_id.add continuous_const).aemeasurable
    calc
      (∫ s : Real, f (Lambda * (s - t))) =
          ∫ s : Real, g (s + (-t)) := by
            apply integral_congr_ae
            filter_upwards with s
            simp only [g, sub_eq_add_neg]
      _ = ∫ x : Real, g x := by
        calc
          (∫ s : Real, g (s + (-t))) =
              ∫ x : Real, g x ∂Measure.map (fun x : Real => x + (-t)) volume :=
            (integral_map hphi hgcont.aestronglyMeasurable).symm
          _ = ∫ x : Real, g x := by rw [hmap]
      _ = ∫ x : Real, f (Lambda * x) := rfl
  rw [htranslation, Measure.integral_comp_mul_left]
  have hbase : (∫ x : Real, f x) = Real.pi := by
    simpa only [f] using integral_univ_inv_one_add_sq
  rw [hbase, smul_eq_mul, abs_of_pos (inv_pos.mpr hLambda)]
  rw [div_eq_mul_inv]
  ring

/-- The same whole-line quadratic envelope is integrable.  This deliberately
keeps the translation and dilation steps separate so subsequent Schur bounds
can use it as an ordinary Bochner-integrable majorant. -/
theorem integrable_quadraticTimeEnvelope_univ
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    Integrable (fun s : Real => quadraticTimeEnvelope Lambda t s) volume := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hf : Integrable f volume := by
    simpa only [f] using integrable_inv_one_add_sq
  have hscale : Integrable (fun x : Real => f (Lambda * x)) volume :=
    hf.comp_mul_left' hLambda.ne'
  have htranslate : Integrable (fun s : Real => f (Lambda * (s - t))) volume := by
    simpa only [sub_eq_add_neg] using hscale.comp_sub_right t
  refine htranslate.congr ?_
  filter_upwards with s
  unfold quadraticTimeEnvelope
  dsimp only [f]
  congr 2
  ring

/-- The fixed nonnegative majorant of the unit interval in the row estimate. -/
noncomputable def fourierRowBump (x : ℝ) : ℂ :=
  gevreyIntervalCutoff (-1) 0 1 2 x

theorem fourierRowBump_contDiff (n : ℕ) : ContDiff ℝ n fourierRowBump :=
  Complex.ofRealCLM.contDiff.comp (gevreyIntervalCutoff_contDiff n (-1) 0 1 2)

theorem fourierRowBump_hasCompactSupport : HasCompactSupport fourierRowBump :=
  (gevreyIntervalCutoff_hasCompactSupport (by norm_num : (-1 : ℝ) < 0)
    (by norm_num : (1 : ℝ) < 2)).comp_left (by simp : ((0 : ℝ) : ℂ) = 0)

theorem hasCompactSupport_iteratedDeriv {f : ℝ → ℂ} (hf : HasCompactSupport f) (n : ℕ) :
    HasCompactSupport (iteratedDeriv n f) := by
  induction n with
  | zero => simpa using hf
  | succ n ih => simpa only [iteratedDeriv_succ] using ih.deriv

theorem integrable_iteratedDeriv_fourierRowBump (n : ℕ) :
    Integrable (iteratedDeriv n fourierRowBump) :=
  ((fourierRowBump_contDiff n).continuous_iteratedDeriv n le_rfl).integrable_of_hasCompactSupport
    (hasCompactSupport_iteratedDeriv fourierRowBump_hasCompactSupport n)

theorem fourierRowBump_eq_one {x : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    fourierRowBump x = 1 := by
  simp [fourierRowBump, gevreyIntervalCutoff_eq_one (by norm_num : (-1 : ℝ) < 0)
    (by norm_num : (1 : ℝ) < 2) hx]

/-- The constant obtained by twice integrating the fixed bump by parts. -/
noncomputable def fourierRowConstant : ℝ :=
  (∫ x, ‖fourierRowBump x‖) + (4 * Real.pi ^ 2)⁻¹ *
    ∫ x, ‖iteratedDeriv 2 fourierRowBump x‖

theorem fourierRowConstant_nonneg : 0 ≤ fourierRowConstant := by
  unfold fourierRowConstant
  positivity

