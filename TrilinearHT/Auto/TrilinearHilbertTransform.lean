    k ^ p = Real.exp (Real.log k * p) := Real.rpow_def_of_pos hk0 _
    _ ≤ Real.exp (p * logarithmicSize (2 * k) ^ 1) := by
      apply Real.exp_le_exp.mpr
      simpa [mul_comm] using mul_le_mul_of_nonneg_left hlog hp
    _ ≤ _ := hk

