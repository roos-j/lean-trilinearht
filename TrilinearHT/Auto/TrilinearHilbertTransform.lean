/-- The integrable envelope used for the Gram matrix in the Fourier row estimate. -/
noncomputable def quadraticTimeEnvelope (Lambda t s : ℝ) : ℝ :=
  (1 + (Lambda * (t - s)) ^ 2)⁻¹

theorem integral_quadraticTimeEnvelope_univ_eq_pi_div
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    (∫ s : Real, quadraticTimeEnvelope Lambda t s) = Real.pi / Lambda := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hfcont : Continuous f := by
    dsimp [f]
    apply Continuous.inv₀
    · fun_prop
    · intro u
      positivity
  have hrewrite : (fun s : Real => quadraticTimeEnvelope Lambda t s) =
      fun s => f (Lambda * (s - t)) := by
    funext s
    unfold quadraticTimeEnvelope
    dsimp [f]
    congr 2
    ring
  rw [hrewrite]
  have htranslation :
      (∫ s : Real, f (Lambda * (s - t))) =
        ∫ x : Real, f (Lambda * x) := by
    let g : Real → Real := fun x => f (Lambda * x)
    have hgcont : Continuous g :=
      hfcont.comp (continuous_const.mul continuous_id)
    have hmap : Measure.map (fun x : Real => x + (-t)) volume = volume :=
      map_add_right_eq_self volume (-t)
    have hphi : AEMeasurable (fun x : Real => x + (-t)) volume :=
      (continuous_id.add continuous_const).aemeasurable
    calc
      (∫ s : Real, f (Lambda * (s - t))) =
          ∫ s : Real, g (s + (-t)) := by
            apply integral_congr_ae
            filter_upwards with s
            simp only [g, sub_eq_add_neg]
      _ = ∫ x : Real, g x := by
        calc
          (∫ s : Real, g (s + (-t))) =
              ∫ x : Real, g x ∂Measure.map (fun x : Real => x + (-t)) volume :=
            (integral_map hphi hgcont.aestronglyMeasurable).symm
          _ = ∫ x : Real, g x := by rw [hmap]
      _ = ∫ x : Real, f (Lambda * x) := rfl
  rw [htranslation, Measure.integral_comp_mul_left]
  have hbase : (∫ x : Real, f x) = Real.pi := by
    simpa only [f] using integral_univ_inv_one_add_sq
  rw [hbase, smul_eq_mul, abs_of_pos (inv_pos.mpr hLambda)]
  rw [div_eq_mul_inv]
  ring

/-- The same whole-line quadratic envelope is integrable.  This deliberately
keeps the translation and dilation steps separate so subsequent Schur bounds
can use it as an ordinary Bochner-integrable majorant. -/
theorem integrable_quadraticTimeEnvelope_univ
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    Integrable (fun s : Real => quadraticTimeEnvelope Lambda t s) volume := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hf : Integrable f volume := by
    simpa only [f] using integrable_inv_one_add_sq
  have hscale : Integrable (fun x : Real => f (Lambda * x)) volume :=
    hf.comp_mul_left' hLambda.ne'
  have htranslate : Integrable (fun s : Real => f (Lambda * (s - t))) volume := by
    simpa only [sub_eq_add_neg] using hscale.comp_sub_right t
  refine htranslate.congr ?_
  filter_upwards with s
  unfold quadraticTimeEnvelope
  dsimp only [f]
  congr 2
  ring

/-- The fixed nonnegative majorant of the unit interval in the row estimate. -/
noncomputable def fourierRowBump (x : ℝ) : ℂ :=
  gevreyIntervalCutoff (-1) 0 1 2 x

theorem fourierRowBump_contDiff (n : ℕ) : ContDiff ℝ n fourierRowBump :=
  Complex.ofRealCLM.contDiff.comp (gevreyIntervalCutoff_contDiff n (-1) 0 1 2)

theorem fourierRowBump_hasCompactSupport : HasCompactSupport fourierRowBump :=
  (gevreyIntervalCutoff_hasCompactSupport (by norm_num : (-1 : ℝ) < 0)
    (by norm_num : (1 : ℝ) < 2)).comp_left (by simp : ((0 : ℝ) : ℂ) = 0)

theorem hasCompactSupport_iteratedDeriv {f : ℝ → ℂ} (hf : HasCompactSupport f) (n : ℕ) :
    HasCompactSupport (iteratedDeriv n f) := by
  induction n with
  | zero => simpa using hf
  | succ n ih => simpa only [iteratedDeriv_succ] using ih.deriv

theorem integrable_iteratedDeriv_fourierRowBump (n : ℕ) :
    Integrable (iteratedDeriv n fourierRowBump) :=
  ((fourierRowBump_contDiff n).continuous_iteratedDeriv n le_rfl).integrable_of_hasCompactSupport
    (hasCompactSupport_iteratedDeriv fourierRowBump_hasCompactSupport n)

theorem fourierRowBump_eq_one {x : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    fourierRowBump x = 1 := by
  simp [fourierRowBump, gevreyIntervalCutoff_eq_one (by norm_num : (-1 : ℝ) < 0)
    (by norm_num : (1 : ℝ) < 2) hx]

/-- The constant obtained by twice integrating the fixed bump by parts. -/
noncomputable def fourierRowConstant : ℝ :=
  (∫ x, ‖fourierRowBump x‖) + (4 * Real.pi ^ 2)⁻¹ *
    ∫ x, ‖iteratedDeriv 2 fourierRowBump x‖

theorem fourierRowConstant_nonneg : 0 ≤ fourierRowConstant := by
  unfold fourierRowConstant
  positivity

open scoped FourierTransform in
/-- Blueprint Lemma `lem:fourier-foundation`, line 148: the Gram envelope
from two integrations by parts, including the zero-frequency bound. -/
theorem fourierRowBump_fourier_bound (u : ℝ) :
    ‖𝓕 fourierRowBump u‖ ≤ fourierRowConstant * (1 + u ^ 2)⁻¹ := by
  have h := Real.one_add_sq_mul_norm_fourier_le (fourierRowBump_contDiff 2)
    (fun k _ => integrable_iteratedDeriv_fourierRowBump k) u
  rw [← div_eq_mul_inv, le_div_iff₀ (by positivity)]
  simpa only [fourierRowConstant, mul_comm] using h

/-- The left endpoint of a half-spacing interval extending toward a fixed center. -/
noncomputable def frequencyPackingLeft (x δ ξ : ℝ) : ℝ :=
  if ξ ≤ x then ξ else ξ - δ / 2

/-- Disjoint half-spacing intervals used to sum a decreasing Gram envelope. -/
def frequencyPackingInterval (x δ ξ : ℝ) : Set ℝ :=
  Set.Ioc (frequencyPackingLeft x δ ξ) (frequencyPackingLeft x δ ξ + δ / 2)

theorem frequencyPackingInterval_subset {x δ ξ : ℝ} (hδ : 0 ≤ δ) :
    frequencyPackingInterval x δ ξ ⊆ Set.Ioc (ξ - δ / 2) (ξ + δ / 2) := by
  intro t ht
  dsimp [frequencyPackingInterval, frequencyPackingLeft] at ht
  split_ifs at ht <;> constructor <;> linarith [ht.1, ht.2]

theorem frequencyPackingInterval_disjoint {x δ ξ η : ℝ} (hδ : 0 ≤ δ)
    (hsep : δ ≤ |ξ - η|) :
    Disjoint (frequencyPackingInterval x δ ξ) (frequencyPackingInterval x δ η) := by
  apply Set.disjoint_left.mpr
  intro t ht ht'
  have hξ := frequencyPackingInterval_subset hδ ht
  have hη := frequencyPackingInterval_subset hδ ht'
  have hlt : |ξ - η| < δ := abs_lt.mpr ⟨by linarith [hξ.2, hη.1],
    by linarith [hξ.1, hη.2]⟩
  linarith

theorem frequencyPackingInterval_distance_le {x δ ξ t : ℝ} (hδ : 0 ≤ δ)
    (hsep : δ ≤ |ξ - x|) (ht : t ∈ frequencyPackingInterval x δ ξ) :
    |x - t| ≤ |x - ξ| := by
  dsimp [frequencyPackingInterval, frequencyPackingLeft] at ht
  split_ifs at ht with hξ
  · rw [abs_of_nonpos (sub_nonpos.mpr hξ)] at hsep
    have htx : t ≤ x := by linarith [ht.2]
    rw [abs_of_nonneg (sub_nonneg.mpr htx), abs_of_nonneg (sub_nonneg.mpr hξ)]
    linarith [ht.1]
  · have hxξ : x ≤ ξ := le_of_lt (lt_of_not_ge hξ)
    rw [abs_of_nonneg (sub_nonneg.mpr hxξ)] at hsep
    have hxt : x ≤ t := by linarith [ht.1]
    rw [abs_of_nonpos (sub_nonpos.mpr hxt), abs_of_nonpos (sub_nonpos.mpr hxξ)]
    linarith [ht.2]

theorem quadraticTimeEnvelope_nonneg (r x t : ℝ) : 0 ≤ quadraticTimeEnvelope r x t := by
  unfold quadraticTimeEnvelope
  positivity

theorem quadraticTimeEnvelope_le_on_packingInterval {r x δ ξ t : ℝ}
    (hδ : 0 ≤ δ) (hsep : δ ≤ |ξ - x|) (ht : t ∈ frequencyPackingInterval x δ ξ) :
    quadraticTimeEnvelope r x ξ ≤ quadraticTimeEnvelope r x t := by
  have hd := frequencyPackingInterval_distance_le hδ hsep ht
  have hsq : (r * (x - t)) ^ 2 ≤ (r * (x - ξ)) ^ 2 := by
    rw [mul_pow, mul_pow]
    apply mul_le_mul_of_nonneg_left _ (sq_nonneg r)
    exact (sq_le_sq).mpr hd
  simpa only [quadraticTimeEnvelope, one_div] using
    one_div_le_one_div_of_le (show 0 < 1 + (r * (x - t)) ^ 2 by positivity)
      (by linarith)

theorem quadraticTimeEnvelope_mul_half_spacing_le_integral {r x δ ξ : ℝ}
    (hr : 0 < r) (hδ : 0 < δ) (hsep : δ ≤ |ξ - x|) :
    quadraticTimeEnvelope r x ξ * (δ / 2) ≤
      ∫ t in frequencyPackingInterval x δ ξ, quadraticTimeEnvelope r x t := by
  have hm : MeasurableSet (frequencyPackingInterval x δ ξ) := measurableSet_Ioc
  have hi := setIntegral_mono_on (f := fun _ : ℝ => quadraticTimeEnvelope r x ξ)
    (g := fun t => quadraticTimeEnvelope r x t) (s := frequencyPackingInterval x δ ξ)
    (integrableOn_const (by simp [frequencyPackingInterval, Real.volume_Ioc]))
    (integrable_quadraticTimeEnvelope_univ hr).integrableOn hm
    (fun t ht => quadraticTimeEnvelope_le_on_packingInterval hδ.le hsep ht)
  simpa [integral_const, Measure.real, frequencyPackingInterval, Real.volume_Ioc,
    ENNReal.toReal_ofReal (show 0 ≤ δ / 2 by positivity), mul_comm] using hi

/-- A separated family away from a fixed center has bounded total Gram envelope. -/
theorem sum_quadraticTimeEnvelope_off_center {ι : Type*} (s : Finset ι) (ξ : ι → ℝ)
    {r δ x : ℝ} (hr : 0 < r) (hδ : 0 < δ)
    (hsep : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → δ ≤ |ξ i - ξ j|)
    (haway : ∀ i ∈ s, δ ≤ |ξ i - x|) :
    ∑ i ∈ s, quadraticTimeEnvelope r x (ξ i) ≤ 2 * Real.pi / (r * δ) := by
  classical
  have hint := integrable_quadraticTimeEnvelope_univ (t := x) hr
  have hdisj : (↑s : Set ι).Pairwise
      (fun i j => Disjoint (frequencyPackingInterval x δ (ξ i))
        (frequencyPackingInterval x δ (ξ j))) := by
    intro i hi j hj hij
    exact frequencyPackingInterval_disjoint hδ.le (hsep i hi j hj hij)
  have htotal : (∑ i ∈ s, quadraticTimeEnvelope r x (ξ i)) * (δ / 2) ≤ Real.pi / r := by
    calc
      _ = ∑ i ∈ s, quadraticTimeEnvelope r x (ξ i) * (δ / 2) := Finset.sum_mul ..
      _ ≤ ∑ i ∈ s, ∫ t in frequencyPackingInterval x δ (ξ i),
          quadraticTimeEnvelope r x t := Finset.sum_le_sum
            (fun i hi => quadraticTimeEnvelope_mul_half_spacing_le_integral hr hδ (haway i hi))
      _ = ∫ t in ⋃ i ∈ s, frequencyPackingInterval x δ (ξ i),
          quadraticTimeEnvelope r x t :=
        (integral_biUnion_finset s (fun _ _ => measurableSet_Ioc) hdisj
          (fun _ _ => hint.integrableOn)).symm
      _ ≤ ∫ t, quadraticTimeEnvelope r x t :=
        setIntegral_le_integral hint (Filter.Eventually.of_forall
          (fun t => quadraticTimeEnvelope_nonneg r x t))
      _ = _ := integral_quadraticTimeEnvelope_univ_eq_pi_div hr
  have h := (le_div_iff₀ (show 0 < δ / 2 by positivity)).mpr htotal
  convert h using 1
  field_simp

/-- Blueprint Lemma `lem:fourier-foundation`, lines 149–152: a uniform
absolute row bound for separated frequencies. -/
theorem sum_quadraticTimeEnvelope_separated {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) {r δ : ℝ} (hr : 0 < r) (hδ : 0 < δ)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) (i : ι) :
    ∑ j, quadraticTimeEnvelope r (ξ i) (ξ j) ≤ 1 + 2 * Real.pi / (r * δ) := by
  classical
  rw [← Finset.add_sum_erase Finset.univ (fun j => quadraticTimeEnvelope r (ξ i) (ξ j))
    (Finset.mem_univ i)]
  have h := sum_quadraticTimeEnvelope_off_center (Finset.univ.erase i) ξ hr hδ
    (fun j _ k _ hjk => hsep j k hjk)
    (fun j hj => hsep j i (Finset.mem_erase.mp hj).1)
  simpa [quadraticTimeEnvelope, add_comm] using add_le_add_left h 1

/-- Blueprint Lemma `lem:fourier-foundation`, lines 153–157: finite Schur
bound for vector-valued entries, controlled by nonnegative scalar row and column sums. -/
theorem finite_schur_bound {ι κ : Type*} [Fintype ι] [Fintype κ]
    {E : ι → Type*} [∀ i, SeminormedAddCommGroup (E i)]
    (v : ∀ i, κ → E i) (a : ι → κ → ℝ) (z : κ → ℝ) {B : ℝ}
    (hB : 0 ≤ B) (ha : ∀ i j, 0 ≤ a i j) (_hz : ∀ j, 0 ≤ z j)
    (hv : ∀ i j, ‖v i j‖ ≤ a i j * z j)
    (hrow : ∀ i, ∑ j, a i j ≤ B) (hcol : ∀ j, ∑ i, a i j ≤ B) :
    ∑ i, ‖∑ j, v i j‖ ^ 2 ≤ B ^ 2 * ∑ j, z j ^ 2 := by
  have hi : ∀ i, ‖∑ j, v i j‖ ^ 2 ≤ B * ∑ j, a i j * z j ^ 2 := by
    intro i
    have hn : ‖∑ j, v i j‖ ≤ ∑ j, a i j * z j :=
      (norm_sum_le _ _).trans (Finset.sum_le_sum (fun j _ => hv i j))
    calc
      _ ≤ (∑ j, a i j * z j) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hn 2
      _ ≤ (∑ j, a i j) * ∑ j, a i j * z j ^ 2 :=
        Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul Finset.univ
          (fun j _ => ha i j) (fun j _ => mul_nonneg (ha i j) (sq_nonneg _))
          (fun j _ => by ring_nf; exact le_rfl)
      _ ≤ _ := mul_le_mul_of_nonneg_right (hrow i)
        (Finset.sum_nonneg (fun j _ => mul_nonneg (ha i j) (sq_nonneg _)))
  calc
    _ ≤ ∑ i, B * ∑ j, a i j * z j ^ 2 := Finset.sum_le_sum (fun i _ => hi i)
    _ = B * ∑ j, (∑ i, a i j) * z j ^ 2 := by
      rw [← Finset.mul_sum, Finset.sum_comm]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      rw [Finset.sum_mul]
    _ ≤ B * ∑ j, B * z j ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ hB
      exact Finset.sum_le_sum (fun j _ =>
        mul_le_mul_of_nonneg_right (hcol j) (sq_nonneg _))
    _ = _ := by rw [← Finset.mul_sum]; ring

/-- The scalar matrix form of the Schur estimate displayed in the blueprint. -/
theorem complex_matrix_schur_bound {ι κ : Type*} [Fintype ι] [Fintype κ]
    (a : ι → κ → ℂ) (z : κ → ℂ) {B : ℝ} (hB : 0 ≤ B)
    (hrow : ∀ i, ∑ j, ‖a i j‖ ≤ B) (hcol : ∀ j, ∑ i, ‖a i j‖ ≤ B) :
    ∑ i, ‖∑ j, a i j * z j‖ ^ 2 ≤ B ^ 2 * ∑ j, ‖z j‖ ^ 2 :=
  finite_schur_bound (fun i j => a i j * z j) (fun i j => ‖a i j‖) (fun j => ‖z j‖)
    hB (fun _ _ => norm_nonneg _) (fun _ => norm_nonneg _)
    (fun _ _ => le_of_eq (norm_mul _ _)) hrow hcol

/-- The quadratic-form version of the finite Schur test. -/
theorem finite_schur_quadratic {ι : Type*} [Fintype ι]
    (a : ι → ι → ℝ) (z : ι → ℝ) {B : ℝ} (ha : ∀ i j, 0 ≤ a i j)
    (hrow : ∀ i, ∑ j, a i j ≤ B) (hcol : ∀ j, ∑ i, a i j ≤ B) :
    ∑ i, ∑ j, a i j * z i * z j ≤ B * ∑ i, z i ^ 2 := by
  have hrow' : (∑ i, ∑ j, a i j * z i ^ 2) ≤ B * ∑ i, z i ^ 2 := by
    calc
      _ = ∑ i, (∑ j, a i j) * z i ^ 2 := by simp_rw [Finset.sum_mul]
      _ ≤ ∑ i, B * z i ^ 2 := Finset.sum_le_sum (fun i _ =>
        mul_le_mul_of_nonneg_right (hrow i) (sq_nonneg _))
      _ = _ := (Finset.mul_sum ..).symm
  have hcol' : (∑ i, ∑ j, a i j * z j ^ 2) ≤ B * ∑ j, z j ^ 2 := by
    rw [Finset.sum_comm]
    calc
      _ = ∑ j, (∑ i, a i j) * z j ^ 2 := by simp_rw [Finset.sum_mul]
      _ ≤ ∑ j, B * z j ^ 2 := Finset.sum_le_sum (fun j _ =>
        mul_le_mul_of_nonneg_right (hcol j) (sq_nonneg _))
      _ = _ := (Finset.mul_sum ..).symm
  have hterm : ∀ i j, 2 * (a i j * z i * z j) ≤ a i j * z i ^ 2 + a i j * z j ^ 2 := by
    intro i j
    nlinarith [mul_nonneg (ha i j) (sq_nonneg (z i - z j))]
  have hsum := Finset.sum_le_sum (s := Finset.univ) (fun i _ =>
    Finset.sum_le_sum (s := Finset.univ) (fun j _ => hterm i j))
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum] at hsum
  linarith

open scoped ComplexConjugate FourierTransform

/-- The convention `e(ξ x) = exp(2π i ξ x)` used in the blueprint. -/
noncomputable def fourierWave (ξ x : ℝ) : ℂ := Real.fourierChar (ξ * x)

theorem fourierWave_continuous (ξ : ℝ) : Continuous (fourierWave ξ) :=
  continuous_subtype_val.comp
    (Real.continuous_fourierChar.comp (continuous_const.mul continuous_id))

theorem norm_fourierWave (ξ x : ℝ) : ‖fourierWave ξ x‖ = 1 := Circle.norm_coe _

theorem fourierWave_mul_conj (ξ η x : ℝ) :
    fourierWave ξ x * conj (fourierWave η x) = fourierWave (ξ - η) x := by
  unfold fourierWave
  rw [← Circle.coe_inv_eq_conj, ← Circle.coe_mul, ← AddChar.map_neg_eq_inv,
    ← AddChar.map_add_eq_mul]
  congr 2
  ring

/-- The Gram entry for the fixed smooth majorant of `[0,1]`. -/
noncomputable def fourierRowGram (ξ η : ℝ) : ℂ :=
  ∫ x, fourierRowBump x * fourierWave ξ x * conj (fourierWave η x)

theorem integrable_fourierRowGram_integrand (ξ η : ℝ) :
    Integrable (fun x => fourierRowBump x * fourierWave ξ x * conj (fourierWave η x)) :=
  (((fourierRowBump_contDiff 0).continuous.mul (fourierWave_continuous ξ)).mul
    (fourierWave_continuous η).star).integrable_of_hasCompactSupport
      fourierRowBump_hasCompactSupport.mul_right.mul_right

theorem fourierRowGram_eq_fourier (ξ η : ℝ) :
    fourierRowGram ξ η = 𝓕 fourierRowBump (η - ξ) := by
  rw [fourierRowGram, Real.fourier_eq]
  apply integral_congr_ae
  filter_upwards [] with x
  rw [mul_assoc, fourierWave_mul_conj]
  simp only [fourierWave, RCLike.inner_apply, conj_trivial, Circle.smul_def, smul_eq_mul]
  have h : (ξ - η) * x = -(x * (η - ξ)) := by ring
  rw [h]
  simp [mul_comm]

theorem norm_fourierRowGram_le (ξ η : ℝ) :
    ‖fourierRowGram ξ η‖ ≤ fourierRowConstant * quadraticTimeEnvelope 1 ξ η := by
  rw [fourierRowGram_eq_fourier]
  have h := fourierRowBump_fourier_bound (η - ξ)
  simpa [quadraticTimeEnvelope, sub_sq_comm] using h

theorem fourierRowGram_row_bound {ι : Type*} [Fintype ι] (ξ : ι → ℝ) {δ : ℝ}
    (hδ : 0 < δ) (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) (i : ι) :
    ∑ j, ‖fourierRowGram (ξ i) (ξ j)‖ ≤ fourierRowConstant * (1 + 2 * Real.pi / δ) := by
  calc
    _ ≤ ∑ j, fourierRowConstant * quadraticTimeEnvelope 1 (ξ i) (ξ j) :=
      Finset.sum_le_sum (fun j _ => norm_fourierRowGram_le _ _)
    _ = fourierRowConstant * ∑ j, quadraticTimeEnvelope 1 (ξ i) (ξ j) :=
      (Finset.mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (by simpa using (sum_quadraticTimeEnvelope_separated ξ
        (by norm_num : (0 : ℝ) < 1) hδ hsep i)) fourierRowConstant_nonneg

/-- The real-valued fixed majorant underlying `fourierRowBump`. -/
noncomputable def fourierRowWeight (x : ℝ) : ℝ := gevreyIntervalCutoff (-1) 0 1 2 x

theorem fourierRowWeight_nonneg (x : ℝ) : 0 ≤ fourierRowWeight x :=
  (gevreyIntervalCutoff_mem_Icc (-1) 0 1 2 x).1

theorem fourierRowWeight_continuous : Continuous fourierRowWeight :=
  (gevreyIntervalCutoff_contDiff 0 (-1) 0 1 2).continuous

theorem fourierRowWeight_hasCompactSupport : HasCompactSupport fourierRowWeight :=
  gevreyIntervalCutoff_hasCompactSupport (by norm_num : (-1 : ℝ) < 0)
    (by norm_num : (1 : ℝ) < 2)

/-- A finite exponential sum with arbitrary real frequencies. -/
noncomputable def fourierPolynomial {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) (x : ℝ) : ℂ := ∑ i, c i * fourierWave (ξ i) x

theorem fourierPolynomial_continuous {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) : Continuous (fourierPolynomial ξ c) :=
  continuous_finsetSum _ (fun i _ => continuous_const.mul (fourierWave_continuous (ξ i)))

theorem integrable_fourierRowWeightedEnergy {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) :
    Integrable (fun x => fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2) := by
  have h := fourierRowWeight_continuous.mul ((fourierPolynomial_continuous ξ c).norm.pow 2)
  exact h.integrable_of_hasCompactSupport fourierRowWeight_hasCompactSupport.mul_right

/-- Exact finite Gram expansion for the weighted exponential sum. -/
theorem fourierRowWeightedEnergy_eq_gram {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) :
    ((∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 : ℝ) : ℂ) =
      ∑ i, ∑ j, (c i * conj (c j)) * fourierRowGram (ξ i) (ξ j) := by
  have hpoint : ∀ x, ((fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 : ℝ) : ℂ) =
      ∑ i, ∑ j, (c i * conj (c j)) *
        (fourierRowBump x * fourierWave (ξ i) x * conj (fourierWave (ξ j) x)) := by
    intro x
    rw [Complex.ofReal_mul, ← Complex.normSq_eq_norm_sq, ← Complex.mul_conj]
    change fourierRowBump x * (fourierPolynomial ξ c x * conj (fourierPolynomial ξ c x)) = _
    simp only [fourierPolynomial, map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  have hInt : ∀ i j, Integrable (fun x => (c i * conj (c j)) *
      (fourierRowBump x * fourierWave (ξ i) x * conj (fourierWave (ξ j) x))) :=
    fun i j => (integrable_fourierRowGram_integrand (ξ i) (ξ j)).const_mul _
  rw [← integral_complex_ofReal]
  simp_rw [hpoint]
  rw [integral_finsetSum _ (fun i _ => integrable_finsetSum _ (fun j _ => hInt i j))]
  apply Finset.sum_congr rfl
  intro i _
  rw [integral_finsetSum _ (fun j _ => hInt i j)]
  apply Finset.sum_congr rfl
  intro j _
  rw [integral_const_mul]
  rfl

theorem fourierRowGram_swap (ξ η : ℝ) : fourierRowGram η ξ = conj (fourierRowGram ξ η) := by
  unfold fourierRowGram
  rw [← integral_conj]
  apply integral_congr_ae
  filter_upwards [] with x
  simp only [map_mul, fourierRowBump, Complex.conj_ofReal, starRingEnd_self_apply]
  ring

/-- The smooth majorant's weighted energy is bounded by the separated Gram rows. -/
theorem fourierRowWeightedEnergy_le {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) {δ : ℝ} (hδ : 0 < δ)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) :
    (∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2) ≤
      (fourierRowConstant * (1 + 2 * Real.pi / δ)) * ∑ i, ‖c i‖ ^ 2 := by
  have hnonneg : 0 ≤ ∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 :=
    integral_nonneg (fun x => mul_nonneg (fourierRowWeight_nonneg x) (sq_nonneg _))
  have hcol : ∀ j, ∑ i, ‖fourierRowGram (ξ i) (ξ j)‖ ≤
      fourierRowConstant * (1 + 2 * Real.pi / δ) := by
    intro j
    have h := fourierRowGram_row_bound ξ hδ hsep j
    simpa only [fourierRowGram_swap (ξ j), Complex.norm_conj] using h
  calc
    _ = ‖((∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 : ℝ) : ℂ)‖ :=
      (Complex.norm_of_nonneg hnonneg).symm
    _ = ‖∑ i, ∑ j, (c i * conj (c j)) * fourierRowGram (ξ i) (ξ j)‖ :=
      congrArg norm (fourierRowWeightedEnergy_eq_gram ξ c)
    _ ≤ ∑ i, ∑ j, ‖(c i * conj (c j)) * fourierRowGram (ξ i) (ξ j)‖ :=
      (norm_sum_le _ _).trans (Finset.sum_le_sum (fun i _ => norm_sum_le _ _))
    _ = ∑ i, ∑ j, ‖fourierRowGram (ξ i) (ξ j)‖ * ‖c i‖ * ‖c j‖ := by
      simp only [norm_mul, Complex.norm_conj]
      congr 1
      funext i
      congr 1
      funext j
      ring
    _ ≤ _ := finite_schur_quadratic (fun i j => ‖fourierRowGram (ξ i) (ξ j)‖)
      (fun i => ‖c i‖) (fun _ _ => norm_nonneg _)
      (fourierRowGram_row_bound ξ hδ hsep) hcol

/-- The unit-interval separated exponential-sum estimate in the blueprint. -/
theorem integral_fourierPolynomial_unit_le {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) {δ : ℝ} (hδ : 0 < δ)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) :
    (∫ x in Set.Icc (0 : ℝ) 1, ‖fourierPolynomial ξ c x‖ ^ 2) ≤
      (fourierRowConstant * (1 + 2 * Real.pi / δ)) * ∑ i, ‖c i‖ ^ 2 := by
  calc
    _ = ∫ x in Set.Icc (0 : ℝ) 1,
        fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro x hx
      have hw : fourierRowWeight x = 1 :=
        gevreyIntervalCutoff_eq_one (by norm_num : (-1 : ℝ) < 0)
          (by norm_num : (1 : ℝ) < 2) hx
      simp only [hw, one_mul]
    _ ≤ ∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 :=
      setIntegral_le_integral (integrable_fourierRowWeightedEnergy ξ c)
        (Filter.Eventually.of_forall (fun x =>
          mul_nonneg (fourierRowWeight_nonneg x) (sq_nonneg _)))
    _ ≤ _ := fourierRowWeightedEnergy_le ξ c hδ hsep

theorem fourierWave_affine (ξ r a x : ℝ) :
    fourierWave ξ (r * x + a) = fourierWave ξ a * fourierWave (r * ξ) x := by
  unfold fourierWave
  rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
  congr 2
  ring

theorem fourierPolynomial_affine {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) (r a x : ℝ) :
    fourierPolynomial ξ c (r * x + a) =
      fourierPolynomial (fun i => r * ξ i) (fun i => c i * fourierWave (ξ i) a) x := by
  unfold fourierPolynomial
  apply Finset.sum_congr rfl
  intro i _
  rw [fourierWave_affine]
  ring

/-- Affine normalization of an ordinary interval integral. -/
theorem integral_Icc_eq_length_mul_unit (f : ℝ → ℝ) {a b : ℝ} (hab : a ≤ b) :
    (∫ x in Set.Icc a b, f x) =
      (b - a) * ∫ x in Set.Icc (0 : ℝ) 1, f ((b - a) * x + a) := by
  rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab,
    integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  simp

/-- Blueprint Lemma `lem:fourier-foundation`, lines 137–141: the separated
exponential-sum estimate on any real interval, with an explicit absolute constant. -/
theorem integral_fourierPolynomial_interval_le {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) {δ a b : ℝ} (hδ : 0 < δ) (hab : a ≤ b)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) :
    (∫ x in Set.Icc a b, ‖fourierPolynomial ξ c x‖ ^ 2) ≤
      fourierRowConstant * ((b - a) + 2 * Real.pi / δ) * ∑ i, ‖c i‖ ^ 2 := by
  rcases hab.eq_or_lt with rfl | hab
  · simp only [Set.Icc_self, integral_singleton, sub_self, zero_add]
    simp only [measureReal_def, measure_singleton, ENNReal.toReal_zero, zero_smul]
    exact mul_nonneg (mul_nonneg fourierRowConstant_nonneg
      (show 0 ≤ 2 * Real.pi / δ by positivity))
      (Finset.sum_nonneg (fun _ _ => sq_nonneg _))
  let r := b - a
  have hr : 0 < r := sub_pos.mpr hab
  have hsep' : ∀ i j, i ≠ j → r * δ ≤ |r * ξ i - r * ξ j| := by
    intro i j hij
    rw [← mul_sub, abs_mul, abs_of_pos hr]
    exact mul_le_mul_of_nonneg_left (hsep i j hij) hr.le
  have hunit := integral_fourierPolynomial_unit_le (fun i => r * ξ i)
    (fun i => c i * fourierWave (ξ i) a) (mul_pos hr hδ) hsep'
  simp only [norm_mul, norm_fourierWave, mul_one] at hunit
  rw [integral_Icc_eq_length_mul_unit _ hab.le]
  change r * (∫ x in Set.Icc (0 : ℝ) 1, ‖fourierPolynomial ξ c (r * x + a)‖ ^ 2) ≤ _
  simp_rw [fourierPolynomial_affine]
  refine (mul_le_mul_of_nonneg_left hunit hr.le).trans_eq ?_
  change r * (fourierRowConstant * (1 + 2 * Real.pi / (r * δ)) * ∑ i, ‖c i‖ ^ 2) =
    fourierRowConstant * (r + 2 * Real.pi / δ) * ∑ i, ‖c i‖ ^ 2
  field_simp

/-- Finite Hilbert-space duality: a synthesis bound gives the same squared
constant in the analysis-row bound, as used in blueprint Lemma `lem:fourier-foundation`. -/
theorem analysis_bound_of_synthesis_bound {ι H : Type*} [Fintype ι]
    [SeminormedAddCommGroup H] [InnerProductSpace ℂ H]
    (v : ι → H) {B : ℝ} (hB : 0 ≤ B)
    (hsyn : ∀ c : ι → ℂ, ‖∑ i, c i • v i‖ ^ 2 ≤ B * ∑ i, ‖c i‖ ^ 2) (x : H) :
    ∑ i, ‖inner ℂ (v i) x‖ ^ 2 ≤ B * ‖x‖ ^ 2 := by
  let c : ι → ℂ := fun i => inner ℂ (v i) x
  let y := ∑ i, c i • v i
  let E : ℝ := ∑ i, ‖c i‖ ^ 2
  have hE : 0 ≤ E := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have hinner : inner ℂ y x = (E : ℂ) := by
    dsimp [y, E]
    rw [sum_inner, Complex.ofReal_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [inner_smul_left]
    change conj (c i) * c i = _
    rw [mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have hcs : E ^ 2 ≤ ‖y‖ ^ 2 * ‖x‖ ^ 2 := by
    have h := norm_inner_le_norm (𝕜 := ℂ) y x
    rw [hinner, Complex.norm_of_nonneg hE] at h
    simpa [mul_pow] using pow_le_pow_left₀ hE h 2
  have hy : ‖y‖ ^ 2 ≤ B * E := hsyn c
  change E ≤ B * ‖x‖ ^ 2
  rcases hE.eq_or_lt with hE | hE
  · rw [← hE]
    exact mul_nonneg hB (sq_nonneg _)
  · apply (mul_le_mul_iff_right₀ hE).mp
    have h := hcs.trans (mul_le_mul_of_nonneg_right hy (sq_nonneg ‖x‖))
    nlinarith

/-- A common bounded measurable multiplier costs the square of its bound in
the squared row estimate, as asserted in blueprint Lemma `lem:fourier-foundation`. -/
theorem integral_multiplier_fourierPolynomial_le {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) {δ a b M : ℝ} (hδ : 0 < δ) (hab : a ≤ b)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|)
    (g : ℝ → ℂ) (hg : AEStronglyMeasurable g (volume.restrict (Set.Icc a b)))
    (hgbound : ∀ᵐ x ∂volume.restrict (Set.Icc a b), ‖g x‖ ≤ M) :
    (∫ x in Set.Icc a b, ‖g x * fourierPolynomial ξ c x‖ ^ 2) ≤
      M ^ 2 * (fourierRowConstant * ((b - a) + 2 * Real.pi / δ) * ∑ i, ‖c i‖ ^ 2) := by
  have hp := fourierPolynomial_continuous ξ c
  have hi : Integrable (fun x => M ^ 2 * ‖fourierPolynomial ξ c x‖ ^ 2)
      (volume.restrict (Set.Icc a b)) := (hp.norm.pow 2).integrableOn_Icc.const_mul _
  have hmeas : AEStronglyMeasurable (fun x => ‖g x * fourierPolynomial ξ c x‖ ^ 2)
      (volume.restrict (Set.Icc a b)) := (hg.mul hp.aestronglyMeasurable).norm.pow 2
  have hdom : ∀ᵐ x ∂volume.restrict (Set.Icc a b),
      ‖g x * fourierPolynomial ξ c x‖ ^ 2 ≤ M ^ 2 * ‖fourierPolynomial ξ c x‖ ^ 2 := by
    filter_upwards [hgbound] with x hx
    rw [norm_mul, mul_pow]
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) hx 2) (sq_nonneg _)
  have hgi := hi.mono' hmeas (hdom.mono (fun x hx => by
    simpa only [Real.norm_of_nonneg (sq_nonneg _)] using hx))
  calc
    _ ≤ ∫ x in Set.Icc a b, M ^ 2 * ‖fourierPolynomial ξ c x‖ ^ 2 :=
      integral_mono_ae hgi hi hdom
    _ = M ^ 2 * ∫ x in Set.Icc a b, ‖fourierPolynomial ξ c x‖ ^ 2 := integral_const_mul ..
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (integral_fourierPolynomial_interval_le ξ c hδ hab hsep) (sq_nonneg _)

/-- The absolute constant form of the separated-frequency estimate, with
the same constant for all finite families, intervals, and positive spacings. -/
theorem exists_separated_fourier_interval_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ (N : ℕ) (ξ : Fin N → ℝ) (c : Fin N → ℂ)
      (δ a b : ℝ), 0 < δ → a ≤ b →
      (∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) →
      (∫ x in Set.Icc a b, ‖fourierPolynomial ξ c x‖ ^ 2) ≤
        C * ((b - a) + δ⁻¹) * ∑ i, ‖c i‖ ^ 2 := by
  let C := 1 + fourierRowConstant * (1 + 2 * Real.pi)
  have hM0 := fourierRowConstant_nonneg
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨C, hC, ?_⟩
  intro N ξ c δ a b hδ hab hsep
  have hM : fourierRowConstant ≤ C := by
    dsimp [C]
    nlinarith [fourierRowConstant_nonneg, Real.pi_pos]
  have hMπ : fourierRowConstant * (2 * Real.pi) ≤ C := by
    dsimp [C]
    linarith [fourierRowConstant_nonneg]
  refine (integral_fourierPolynomial_interval_le ξ c hδ hab hsep).trans ?_
  apply mul_le_mul_of_nonneg_right _ (Finset.sum_nonneg (fun _ _ => sq_nonneg _))
  calc
    _ = fourierRowConstant * (b - a) + (fourierRowConstant * (2 * Real.pi)) * δ⁻¹ := by
      rw [div_eq_mul_inv]; ring
    _ ≤ C * (b - a) + C * δ⁻¹ := add_le_add
      (mul_le_mul_of_nonneg_right hM (sub_nonneg.mpr hab))
      (mul_le_mul_of_nonneg_right hMπ (inv_nonneg.mpr hδ.le))
    _ = _ := by ring

/-- A derivative with one sign has variation bounded by its endpoint sizes. -/
theorem integral_abs_derivative_le_endpoints {a b : ℝ} {u u' : ℝ → ℝ}
    (hu : ∀ x ∈ Set.uIcc a b, HasDerivAt u (u' x) x)
    (hu' : IntervalIntegrable u' volume a b)
    (hsign : (∀ x ∈ Set.uIcc a b, 0 ≤ u' x) ∨ (∀ x ∈ Set.uIcc a b, u' x ≤ 0)) :
    (∫ x in a..b, |u' x|) ≤ |u a| + |u b| := by
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt hu hu'
  rcases hsign with hpos | hneg
  · have heq : (∫ x in a..b, |u' x|) = ∫ x in a..b, u' x :=
      intervalIntegral.integral_congr (fun x hx => abs_of_nonneg (hpos x hx))
    rw [heq, hFTC]
    linarith [le_abs_self (u b), neg_le_abs (u a)]
  · have heq : (∫ x in a..b, |u' x|) = ∫ x in a..b, -u' x :=
      intervalIntegral.integral_congr (fun x hx => abs_of_nonpos (hneg x hx))
    rw [heq, intervalIntegral.integral_neg, hFTC]
    linarith [le_abs_self (u a), neg_le_abs (u b)]

/-- Differentiating the blueprint's oscillatory wave along a real phase. -/
theorem hasDerivAt_fourierWave_comp {p : ℝ → ℝ} {q x : ℝ} (hp : HasDerivAt p q x) :
    HasDerivAt (fun t => fourierWave 1 (p t))
      (fourierWave 1 (p x) * (((2 * Real.pi * q : ℝ) : ℂ) * Complex.I)) x := by
  have hreal := hp.const_mul (2 * Real.pi)
  have harg : HasDerivAt (fun t => ((2 * Real.pi * p t : ℝ) : ℂ) * Complex.I)
      (((2 * Real.pi * q : ℝ) : ℂ) * Complex.I) x := by
    simpa only [Complex.real_smul] using hreal.smul_const Complex.I
  simpa only [fourierWave, one_mul, Real.fourierChar_apply] using harg.cexp

/-- One nonstationary integration by parts, with a real reciprocal amplitude.
The sign condition controls its total variation by the endpoint values. -/
theorem norm_integral_fourierWave_of_reciprocal {a b : ℝ} (hab : a ≤ b)
    (p q u u' : ℝ → ℝ) (hpcont : Continuous p)
    (hp : ∀ x ∈ Set.uIcc a b, HasDerivAt p (q x) x)
    (hu : ∀ x ∈ Set.uIcc a b, HasDerivAt u (u' x) x)
    (hu'cont : ContinuousOn u' (Set.uIcc a b))
    (hcancel : ∀ x ∈ Set.uIcc a b, u x * q x = 1)
    (hsign : (∀ x ∈ Set.uIcc a b, 0 ≤ u' x) ∨ (∀ x ∈ Set.uIcc a b, u' x ≤ 0)) :
    ‖∫ x in a..b, fourierWave 1 (p x)‖ ≤ 2 * (|u a| + |u b|) := by
  let E : ℝ → ℂ := fun x => fourierWave 1 (p x)
  let z : ℂ := ((2 * Real.pi : ℝ) : ℂ) * Complex.I
  have hEcont : Continuous E := (fourierWave_continuous 1).comp hpcont
  have hducont : ContinuousOn (fun x => (u' x : ℂ)) (Set.uIcc a b) :=
    Complex.continuous_ofReal.comp_continuousOn hu'cont
  have hduE : IntervalIntegrable (fun x => (u' x : ℂ) * E x) volume a b :=
    (hducont.mul hEcont.continuousOn).intervalIntegrable
  have hzE : IntervalIntegrable (fun x => z * E x) volume a b :=
    (continuous_const.mul hEcont).intervalIntegrable a b
  have hderiv : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (fun t => (u t : ℂ) * E t) ((u' x : ℂ) * E x + z * E x) x := by
    intro x hx
    have huc : HasDerivAt (fun t => (u t : ℂ)) (u' x : ℂ) x := by
      simpa using (hu x hx).smul_const (1 : ℂ)
    have h := huc.mul (hasDerivAt_fourierWave_comp (hp x hx))
    convert h using 1
    have hc : (u x : ℂ) * (q x : ℂ) = 1 := by exact_mod_cast hcancel x hx
    dsimp [E, z]
    push_cast
    linear_combination -((2 * Real.pi : ℂ) * Complex.I * fourierWave 1 (p x)) * hc
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hduE.add hzE)
  rw [intervalIntegral.integral_add hduE hzE, intervalIntegral.integral_const_mul] at hFTC
  have heq : z * (∫ x in a..b, E x) =
      (u b : ℂ) * E b - (u a : ℂ) * E a - ∫ x in a..b, (u' x : ℂ) * E x := by
    linear_combination hFTC
  have hEnorm : ∀ x, ‖E x‖ = 1 := fun x => norm_fourierWave _ _
  have hz : ‖z‖ = 2 * Real.pi := by
    dsimp [z]
    rw [norm_mul, Complex.norm_of_nonneg (by positivity), Complex.norm_I, mul_one]
  have hrem : ‖∫ x in a..b, (u' x : ℂ) * E x‖ ≤ |u a| + |u b| := by
    calc
      _ ≤ ∫ x in a..b, ‖(u' x : ℂ) * E x‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ = ∫ x in a..b, |u' x| := by
        simp only [norm_mul, hEnorm, mul_one, Complex.norm_real, Real.norm_eq_abs]
      _ ≤ _ := integral_abs_derivative_le_endpoints hu hu'cont.intervalIntegrable hsign
  have hmain : (2 * Real.pi) * ‖∫ x in a..b, E x‖ ≤
      |u b| + |u a| + (|u a| + |u b|) := by
    calc
      _ = ‖z * (∫ x in a..b, E x)‖ := by rw [norm_mul, hz]
      _ = _ := congrArg norm heq
      _ ≤ ‖(u b : ℂ) * E b - (u a : ℂ) * E a‖ +
          ‖∫ x in a..b, (u' x : ℂ) * E x‖ := norm_sub_le _ _
      _ ≤ (‖(u b : ℂ) * E b‖ + ‖(u a : ℂ) * E a‖) + (|u a| + |u b|) :=
        add_le_add (norm_sub_le _ _) hrem
      _ = _ := by simp only [norm_mul, hEnorm, mul_one, Complex.norm_real, Real.norm_eq_abs]
  have hpi : 1 ≤ 2 * Real.pi := by linarith [Real.two_le_pi]
  have hlow := mul_le_mul_of_nonneg_right hpi (norm_nonneg (∫ x in a..b, E x))
  change ‖∫ x in a..b, E x‖ ≤ _
  nlinarith

/-- Blueprint Lemma `lem:fourier-foundation`, lines 143 and 158: a real
quadratic phase whose derivative has modulus at least `A` has oscillatory integral
at most `4/A`. This includes linear phases and degenerate intervals. -/
theorem quadratic_oscillatory_integral_bound (α β γ : ℝ) {a b A : ℝ}
    (hab : a ≤ b) (hA : 0 < A)
    (hlower : ∀ x ∈ Set.Icc a b, A ≤ |2 * α * x + β|) :
    ‖∫ x in Set.Icc a b, fourierWave 1 (α * x ^ 2 + β * x + γ)‖ ≤ 4 / A := by
  let p : ℝ → ℝ := fun x => α * x ^ 2 + β * x + γ
  let q : ℝ → ℝ := fun x => 2 * α * x + β
  let u : ℝ → ℝ := fun x => (q x)⁻¹
  let u' : ℝ → ℝ := fun x => -(2 * α) / (q x) ^ 2
  have hn : ∀ x ∈ Set.uIcc a b, q x ≠ 0 := by
    intro x hx hzero
    rw [Set.uIcc_of_le hab] at hx
    have h := hlower x hx
    change A ≤ |q x| at h
    rw [hzero, abs_zero] at h
    linarith
  have hp : ∀ x ∈ Set.uIcc a b, HasDerivAt p (q x) x := by
    intro x _
    convert ((((hasDerivAt_id x).pow 2).const_mul α).add
      ((hasDerivAt_id x).const_mul β)).add_const γ using 1 <;> dsimp [p, q]
    all_goals ring
  have hq : ∀ x, HasDerivAt q (2 * α) x := by
    intro x
    simpa [q] using ((hasDerivAt_id x).const_mul (2 * α)).add_const β
  have hu : ∀ x ∈ Set.uIcc a b, HasDerivAt u (u' x) x :=
    fun x hx => (hq x).inv (hn x hx)
  have hu'cont : ContinuousOn u' (Set.uIcc a b) :=
    continuousOn_const.div ((by fun_prop : Continuous q).continuousOn.pow 2)
      (fun x hx => pow_ne_zero 2 (hn x hx))
  have hcancel : ∀ x ∈ Set.uIcc a b, u x * q x = 1 :=
    fun x hx => inv_mul_cancel₀ (hn x hx)
  have hsign : (∀ x ∈ Set.uIcc a b, 0 ≤ u' x) ∨
      (∀ x ∈ Set.uIcc a b, u' x ≤ 0) := by
    rcases le_total α 0 with hα | hα
    · left
      intro x _
      exact div_nonneg (by linarith) (sq_nonneg _)
    · right
      intro x _
      exact div_nonpos_of_nonpos_of_nonneg (by linarith) (sq_nonneg _)
  have hendpoint : ∀ x ∈ Set.Icc a b, |u x| ≤ A⁻¹ := by
    intro x hx
    dsimp [u]
    rw [abs_inv]
    simpa only [one_div] using one_div_le_one_div_of_le hA (hlower x hx)
  have h := norm_integral_fourierWave_of_reciprocal hab p q u u' (by fun_prop)
    hp hu hu'cont hcancel hsign
  have ha := hendpoint a ⟨le_rfl, hab⟩
  have hb := hendpoint b ⟨hab, le_rfl⟩
  rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab]
  change ‖∫ x in a..b, fourierWave 1 (p x)‖ ≤ _
  refine h.trans ?_
  rw [div_eq_mul_inv]
  linarith

open scoped ENNReal

/-- Normalized counting measure, the Haar probability measure on a finite group. -/
noncomputable def finiteHaar (G : Type*) [Fintype G] [MeasurableSpace G] : Measure G :=
  ((Fintype.card G : ℝ≥0∞)⁻¹) • Measure.count

instance finiteHaar_isProbabilityMeasure (G : Type*) [Fintype G] [Nonempty G]
    [MeasurableSpace G] : IsProbabilityMeasure (finiteHaar G) := by
  constructor
  suffices (Fintype.card G : ℝ≥0∞)⁻¹ * Fintype.card G = 1 by
    simpa [finiteHaar] using this
  exact ENNReal.inv_mul_cancel (by positivity) (by simp)

instance finiteHaar_isAddLeftInvariant (G : Type*) [AddGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd G] :
    (finiteHaar G).IsAddLeftInvariant := by
  unfold finiteHaar
  infer_instance

theorem integral_finiteHaar {G : Type*} [Fintype G] [MeasurableSpace G]
    [MeasurableSingletonClass G] (f : G → ℂ) :
    (∫ x, f x ∂finiteHaar G) = finiteAverage f := by
  rw [finiteHaar, integral_smul_measure, integral_count]
  simp [finiteAverage, ENNReal.toReal_inv, Complex.real_smul]

/-! Probability-normalized Fourier analysis on finite cyclic groups. -/

noncomputable def finiteFourier {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (ξ : ZMod q) : ℂ :=
  (q : ℂ)⁻¹ * ZMod.dft f ξ

theorem finiteFourier_eq_average {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (ξ : ZMod q) :
    finiteFourier f ξ = finiteAverage (fun x => f x * ZMod.stdAddChar (-(ξ * x))) := by
  simp only [finiteFourier, ZMod.dft_apply, smul_eq_mul, finiteAverage, ZMod.card]
  congr 1
  apply Finset.sum_congr rfl
  intro x _
  rw [mul_comm x ξ, mul_comm]

theorem finiteFourier_inversion {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (x : ZMod q) :
    f x = ∑ ξ, finiteFourier f ξ * ZMod.stdAddChar (ξ * x) := by
  have h := congrFun (ZMod.dft.symm_apply_apply f) x
  rw [ZMod.invDFT_def] at h
  rw [← h]
  simp only [smul_eq_mul, finiteFourier, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro ξ _
  ring

theorem finite_character_orthogonality {q : ℕ} [NeZero q] (ξ : ZMod q) :
    finiteAverage (fun x => ZMod.stdAddChar (ξ * x)) = if ξ = 0 then 1 else 0 := by
  unfold finiteAverage
  by_cases hξ : ξ = 0
  · simp [hξ, ZMod.card, NeZero.ne (q : ℂ)]
  · have hs : ∑ x, ZMod.stdAddChar (ξ * x) = 0 := by
      simpa only [AddChar.mulShift_apply] using
        AddChar.sum_eq_zero_of_ne_one (ZMod.isPrimitive_stdAddChar q hξ)
    simp [hs, hξ]

theorem stdAddChar_conj {q : ℕ} [NeZero q] (x : ZMod q) :
    conj (ZMod.stdAddChar x) = ZMod.stdAddChar (-x) := by
  simp only [ZMod.stdAddChar_apply, AddChar.map_neg_eq_inv, ← Circle.coe_inv_eq_conj,
    Circle.coe_inv]

theorem finiteAverage_sum {G I : Type*} [Fintype G] (s : Finset I) (f : I → G → ℂ) :
    finiteAverage (fun x => ∑ i ∈ s, f i x) = ∑ i ∈ s, finiteAverage (f i) := by
  simp only [← uniformMean_complex_eq, uniformMean_sum]

theorem finiteAverage_mul_const {G : Type*} [Fintype G] (f : G → ℂ) (c : ℂ) :
    finiteAverage (fun x => f x * c) = finiteAverage f * c := by
  simp only [finiteAverage, ← Finset.sum_mul, mul_assoc]

theorem finiteAverage_const_mul {G : Type*} [Fintype G] (c : ℂ) (f : G → ℂ) :
    finiteAverage (fun x => c * f x) = c * finiteAverage f := by
  simp only [finiteAverage, ← Finset.mul_sum]
  ring

theorem finiteAverage_re {G : Type*} [Fintype G] (f : G → ℂ) :
    (finiteAverage f).re = uniformMean (fun x => (f x).re) := by
  rw [← uniformMean_complex_eq]
  simp [uniformMean, Complex.re_sum]

theorem finiteFourier_pairing {q : ℕ} [NeZero q] (f g : ZMod q → ℂ) :
    finiteAverage (fun x => f x * conj (g x)) =
      ∑ ξ, finiteFourier f ξ * conj (finiteFourier g ξ) := by
  have hg (x : ZMod q) : f x * conj (g x) =
      ∑ ξ, (f x * ZMod.stdAddChar (-(ξ * x))) * conj (finiteFourier g ξ) := by
    conv_lhs => rw [finiteFourier_inversion g x]
    simp only [map_sum, map_mul, stdAddChar_conj, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro ξ _
    ring
  simp only [hg, finiteAverage_sum, finiteAverage_mul_const, ← finiteFourier_eq_average]

theorem finiteFourier_parseval {q : ℕ} [NeZero q] (f : ZMod q → ℂ) :
    uniformMean (fun x => ‖f x‖ ^ 2) = ∑ ξ, ‖finiteFourier f ξ‖ ^ 2 := by
  have h := congrArg Complex.re (finiteFourier_pairing f f)
  simpa only [finiteAverage_re, Complex.mul_conj, Complex.normSq_eq_norm_sq,
    Complex.ofReal_re, Complex.re_sum] using h

theorem finiteAverage_comm {A B : Type*} [Fintype A] [Fintype B] (f : A → B → ℂ) :
    finiteAverage (fun a => finiteAverage (f a)) =
      finiteAverage (fun b => finiteAverage (fun a => f a b)) := by
  simp only [← uniformMean_complex_eq]
  exact uniformMean_comm f

theorem finiteAverage_equiv {A B : Type*} [Fintype A] [Fintype B]
    (e : A ≃ B) (f : B → ℂ) : finiteAverage (fun a => f (e a)) = finiteAverage f := by
  simpa only [← uniformMean_complex_eq] using uniformMean_equiv e f

theorem finiteFourier_translate {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (a ξ : ZMod q) :
    finiteFourier (fun x => f (x - a)) ξ =
      ZMod.stdAddChar (-(ξ * a)) * finiteFourier f ξ := by
  rw [finiteFourier_eq_average]
  rw [← finiteAverage_equiv (Equiv.addRight a)
    (fun x => f (x - a) * ZMod.stdAddChar (-(ξ * x)))]
  simp only [Equiv.coe_addRight, add_sub_cancel_right, mul_add, neg_add,
    AddChar.map_add_eq_mul]
  simp_rw [← mul_assoc]
  rw [finiteAverage_mul_const, ← finiteFourier_eq_average, mul_comm]

theorem finiteFourier_convolution {q : ℕ} [NeZero q] (f g : ZMod q → ℂ) (ξ : ZMod q) :
    finiteFourier (finiteConvolution f g) ξ = finiteFourier f ξ * finiteFourier g ξ := by
  rw [finiteFourier_eq_average]
  simp only [finiteConvolution, ← finiteAverage_mul_const]
  rw [finiteAverage_comm]
  have hi (y : ZMod q) :
      finiteAverage (fun x => f y * g (x - y) * ZMod.stdAddChar (-(ξ * x))) =
        (f y * ZMod.stdAddChar (-(ξ * y))) * finiteFourier g ξ := by
    simp_rw [mul_assoc]
    rw [finiteAverage_const_mul, ← finiteFourier_eq_average, finiteFourier_translate]
  simp only [hi, finiteAverage_mul_const, ← finiteFourier_eq_average]

theorem finiteHaar_pi {I G : Type*} [Fintype I] [DecidableEq I] [Fintype G] [Nonempty G]
    [MeasurableSpace G] [MeasurableSingletonClass G] :
    Measure.pi (fun _ : I => finiteHaar G) = finiteHaar (I → G) := by
  apply Measure.ext_of_singleton
  intro f
  rw [Measure.pi_singleton]
  simp [finiteHaar, ← ENNReal.inv_pow]

theorem integral_finiteHaar_uniform {G E : Type*} [Fintype G] [MeasurableSpace G]
    [MeasurableSingletonClass G] [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] (f : G → E) :
    (∫ x, f x ∂finiteHaar G) = uniformMean f := by
  rw [finiteHaar, integral_smul_measure, integral_count]
  simp [uniformMean, ENNReal.toReal_inv]

theorem finite_cubeAverage_eq {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] (j : ℕ)
    (f : (Fin j → Bool) → G → ℂ) :
    cubeAverage (finiteHaar G) j f =
      uniformMean (fun h : Fin j → G => uniformMean (cubeIntegrand f h)) := by
  simp only [cubeAverage, finiteHaar_pi, integral_finiteHaar_uniform]

theorem finite_gowersNorm_pow {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd₂ G]
    {j : ℕ} (hj : 1 ≤ j) (f : G → ℂ) :
    gowersNorm (finiteHaar G) j f ^ (2 ^ j) =
      (cubeAverage (finiteHaar G) j (fun _ => f)).re := by
  apply gowersNorm_pow (finiteHaar G) hj f (measurable_of_countable f)
    (M := ∑ x, ‖f x‖)
  intro x
  exact Finset.single_le_sum (fun _ _ => norm_nonneg _) (Finset.mem_univ x)

theorem finiteAverage_conj {G : Type*} [Fintype G] (f : G → ℂ) :
    finiteAverage (fun x => conj (f x)) = conj (finiteAverage f) := by
  simp [finiteAverage, map_sum, map_mul]

theorem finiteFourier_reflect_conj {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (ξ : ZMod q) :
    finiteFourier (fun x => conj (f (-x))) ξ = conj (finiteFourier f ξ) := by
  rw [finiteFourier_eq_average,
    ← finiteAverage_equiv (Equiv.neg _) (fun x => conj (f (-x)) *
      ZMod.stdAddChar (-(ξ * x)))]
  simp only [Equiv.neg_apply, neg_neg, mul_neg]
  rw [finiteFourier_eq_average, ← finiteAverage_conj]
  congr 1
  funext x
  simp only [map_mul, stdAddChar_conj, neg_neg]

theorem finite_cubeAverage_sq {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd₂ G]
    (j : ℕ) (f : G → ℂ) : cubeAverage (finiteHaar G) (j + 1) (fun _ => f) =
      (uniformMean (fun h : Fin j → G =>
        ‖uniformMean (diagonalCubeIntegrand j f h)‖ ^ 2) : ℝ) := by
  rw [cubeAverage_diagonal_eq_integral_sq (finiteHaar G) j f (measurable_of_countable f)
    (M := ∑ x, ‖f x‖) (fun x =>
      Finset.single_le_sum (fun _ _ => norm_nonneg _) (Finset.mem_univ x))]
  simp only [finiteHaar_pi, integral_finiteHaar_uniform]

theorem diagonalCubeIntegrand_one {G : Type*} [AddCommGroup G]
    (f : G → ℂ) (h : Fin 1 → G) (x : G) :
    diagonalCubeIntegrand 1 f h x = f x * conj (f (x + h 0)) := by
  rw [diagonalCubeIntegrand_succ 0]
  simp only [diagonalCubeIntegrand_zero]

theorem finiteFourier_gowers_two {q : ℕ} [NeZero q] (f : ZMod q → ℂ) :
    gowersNorm (finiteHaar (ZMod q)) 2 f ^ 4 = ∑ ξ, ‖finiteFourier f ξ‖ ^ 4 := by
  rw [show 4 = 2 ^ 2 from rfl, finite_gowersNorm_pow (by norm_num),
    show 2 = 1 + 1 from rfl, finite_cubeAverage_sq, Complex.ofReal_re]
  have hf1 (h : Fin 1 → ZMod q) : diagonalCubeIntegrand 1 f h =
      fun x => f x * conj (f (x + h 0)) := funext (diagonalCubeIntegrand_one f h)
  simp only [hf1]
  rw [uniformMean_eval (0 : Fin 1)
    (fun h => ‖uniformMean (fun x => f x * conj (f (x + h)))‖ ^ 2)]
  let D := finiteConvolution f (fun x => conj (f (-x)))
  have hd (h : ZMod q) : uniformMean (fun x => f x * conj (f (x + h))) = D (-h) := by
    rw [uniformMean_complex_eq]
    simp only [D, finiteConvolution, neg_sub, sub_neg_eq_add, add_comm]
  simp only [hd]
  have hn : uniformMean (fun h => ‖D (-h)‖ ^ 2) = uniformMean (fun h => ‖D h‖ ^ 2) := by
    simpa only [Equiv.neg_apply] using
      uniformMean_equiv (Equiv.neg _) (fun h => ‖D h‖ ^ 2)
  rw [hn, finiteFourier_parseval]
  apply Finset.sum_congr rfl
  intro ξ _
  simp only [D, finiteFourier_convolution, finiteFourier_reflect_conj,
    norm_mul, Complex.norm_conj]
  ring

theorem uniformMean_fin_cons {G E : Type*} [Fintype G] [AddCommMonoid E] [Module ℝ E]
    (j : ℕ) (f : (Fin (j + 1) → G) → E) :
    uniformMean f = uniformMean (fun t => uniformMean (fun h : Fin j → G => f (Fin.cons t h))) := by
  let e : G × (Fin j → G) ≃ (Fin (j + 1) → G) :=
    { toFun := fun p => Fin.cons p.1 p.2
      invFun := fun h => (h 0, fun i => h i.succ)
      left_inv := fun p => by ext <;> simp
      right_inv := fun h => by ext i; induction i using Fin.cases <;> simp }
  rw [← uniformMean_equiv e]
  rw [uniformMean_prod]
  rfl

theorem finite_cubeAverage_recursion {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] (j : ℕ) (f : G → ℂ) :
    cubeAverage (finiteHaar G) (j + 1) (fun _ => f) =
      uniformMean (fun t => cubeAverage (finiteHaar G) j
        (fun _ x => f x * conj (f (x + t)))) := by
  simp only [finite_cubeAverage_eq]
  rw [uniformMean_fin_cons]
  congr 1
  funext t
  congr 1
  funext h
  congr 1
  funext x
  change diagonalCubeIntegrand (j + 1) f (Fin.cons t h) x =
    diagonalCubeIntegrand j (fun x => f x * conj (f (x + t))) h x
  simp only [diagonalCubeIntegrand_succ, Fin.cons_zero, Fin.cons_succ,
    diagonalCubeIntegrand_mul, diagonalCubeIntegrand_conj, diagonalCubeIntegrand_translate]

theorem uniformMean_conj {G : Type*} [Fintype G] (f : G → ℂ) :
    uniformMean (fun x => conj (f x)) = conj (uniformMean f) := by
  simpa only [uniformMean_complex_eq] using finiteAverage_conj f

theorem uniformMean_re {G : Type*} [Fintype G] (f : G → ℂ) :
    (uniformMean f).re = uniformMean (fun x => (f x).re) := by
  rw [uniformMean_complex_eq, finiteAverage_re]

theorem finite_cubeAverage_conj {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] (j : ℕ) (f : G → ℂ) :
    cubeAverage (finiteHaar G) j (fun _ x => conj (f x)) =
      conj (cubeAverage (finiteHaar G) j (fun _ => f)) := by
  simp only [finite_cubeAverage_eq]
  have heq (h : Fin j → G) : cubeIntegrand (fun _ x => conj (f x)) h =
      fun x => conj (cubeIntegrand (fun _ => f) h x) := by
    funext x
    exact diagonalCubeIntegrand_conj j f h x
  simp only [heq, uniformMean_conj]

theorem finite_gowersNorm_conj {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] (j : ℕ) (f : G → ℂ) :
    gowersNorm (finiteHaar G) j (fun x => conj (f x)) = gowersNorm (finiteHaar G) j f := by
  simp only [gowersNorm, finite_cubeAverage_conj, Complex.conj_re]

/-- The source's `U³` recursion, with its stated multiplicative-difference convention. -/
theorem finite_gowers_three_recursion {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd₂ G] (f : G → ℂ) :
    gowersNorm (finiteHaar G) 3 f ^ 8 = uniformMean (fun t =>
      gowersNorm (finiteHaar G) 2 (fun x => f (x + t) * conj (f x)) ^ 4) := by
  rw [show 8 = 2 ^ 3 from rfl, finite_gowersNorm_pow (by norm_num),
    show 3 = 2 + 1 from rfl, finite_cubeAverage_recursion, uniformMean_re]
  congr 1
  funext t
  rw [show 4 = 2 ^ 2 from rfl, finite_gowersNorm_pow (by norm_num)]
  have heq : (fun x => f (x + t) * conj (f x)) =
      (fun x => conj (f x * conj (f (x + t)))) := by
    funext x
    simp [mul_comm]
  rw [heq, finite_cubeAverage_conj, Complex.conj_re]

open ClassicalMaximal

/-- The measure-preserving isometry identifying the one-coordinate Euclidean space
with the blueprint's real variable. -/
noncomputable def realLineEquiv : EuclideanSpace ℝ (Fin 1) ≃ₗᵢ[ℝ] ℝ where
  toLinearEquiv := (PiLp.equivOfUnique 2 ℝ (fun _ : Fin 1 => ℝ)).toLinearEquiv
  norm_map' := by
    intro x
    change ‖x 0‖ = ‖x‖
    simp [EuclideanSpace.norm_eq, Real.sqrt_sq_eq_abs]

theorem hlMaximal_realLine_comp {E : Type*} [NormedAddCommGroup E] (f : ℝ → E)
    (x : EuclideanSpace ℝ (Fin 1)) :
    hlMaximal volume (fun y => f (realLineEquiv y)) x =
      hlMaximal volume f (realLineEquiv x) := by
  have he := realLineEquiv.toHomeomorph.measurableEmbedding
  have hmp := realLineEquiv.measurePreserving
  unfold hlMaximal
  congr 1
  funext r
  have hpre : realLineEquiv ⁻¹' Metric.closedBall (realLineEquiv x) r =
      Metric.closedBall x r := by
    ext y
    simp only [Set.mem_preimage, Metric.mem_closedBall, realLineEquiv.isometry.dist_eq]
  simp only [hlBallAverage]
  rw [← hpre, hmp.measure_preimage_emb he,
    hmp.setLIntegral_comp_preimage_emb he (fun y => ‖f y‖ₑ)]

theorem mixedENorm_realLine_comp {Ω : Type*} [MeasurableSpace Ω]
    (ν : Measure Ω) (p s : ℝ) (u : ℝ × Ω → ℝ≥0∞) :
    mixedENorm volume ν p s (fun z => u (realLineEquiv z.1, z.2)) =
      mixedENorm volume ν p s u := by
  unfold mixedENorm
  congr 1
  have hmp : MeasurePreserving realLineEquiv
      (volume : Measure (EuclideanSpace ℝ (Fin 1))) volume := realLineEquiv.measurePreserving
  exact hmp.lintegral_comp_emb realLineEquiv.toHomeomorph.measurableEmbedding
    (fun x : ℝ => (∫⁻ ω, u (x, ω) ^ s ∂ν) ^ (p / s))

noncomputable def realMixedMaximal {Ω E : Type*} [NormedAddCommGroup E]
    (f : ℝ × Ω → E) (z : ℝ × Ω) : ℝ≥0∞ :=
  hlMaximal volume (fun y => f (y, z.2)) z.1

theorem feffermanStein_real {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (ν : Measure Ω) [IsFiniteMeasure ν] {p s : ℝ} (hp : 1 < p) (hs : 1 < s)
    {f : ℝ × Ω → E} (hf : Measurable f) :
    mixedENorm volume ν p s (realMixedMaximal f) ≤
      fsMixedConst 1 p s * mixedENorm volume ν p s (fun z => ‖f z‖ₑ) := by
  let g : EuclideanSpace ℝ (Fin 1) × Ω → E := fun z => f (realLineEquiv z.1, z.2)
  have hg : Measurable g := hf.comp
    ((realLineEquiv.continuous.measurable.comp measurable_fst).prodMk measurable_snd)
  have h := feffermanStein_mixed ν hp hs hg
  have hM : mixedMaximal g = fun z => realMixedMaximal f (realLineEquiv z.1, z.2) := by
    funext z
    exact hlMaximal_realLine_comp (fun y => f (y, z.2)) z.1
  rw [hM, mixedENorm_realLine_comp] at h
  simpa only [g, mixedENorm_realLine_comp ν p s (fun z => ‖f z‖ₑ)] using h

/-- The centered powered maximal function, used to prove the uncentered source estimate. -/
noncomputable def centeredMaximalQ {Ω : Type*} (q : ℝ) (f : ℝ × Ω → ℂ) (z : ℝ × Ω) : ℝ≥0∞ :=
  realMixedMaximal (fun z => ‖f z‖ ^ q) z ^ (1 / q)

theorem centeredMaximalQ_mixedNorm {Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω)
    [IsFiniteMeasure ν] {p q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) (hpq : q < p)
    (f : ℝ × Ω → ℂ) (hf : Measurable f) :
    mixedENorm volume ν p 4 (centeredMaximalQ q f) ≤
      fsMixedConst 1 (p / q) (4 / q) ^ (1 / q) *
        mixedENorm volume ν p 4 (fun z => ‖f z‖ₑ) := by
  have hq0 : 0 < q := by linarith
  have hp0 : 0 < p := by linarith
  have hpr : 1 < p / q := (lt_div_iff₀ hq0).mpr (by simpa)
  have hsr : 1 < 4 / q := (lt_div_iff₀ hq0).mpr (by linarith)
  let g : ℝ × Ω → ℝ := fun z => ‖f z‖ ^ q
  have hg : Measurable g := hf.norm.pow_const q
  have h := feffermanStein_real ν hpr hsr hg
  have hgn (z) : ‖g z‖ₑ = ‖f z‖ₑ ^ q := by
    rw [Real.enorm_eq_ofReal (Real.rpow_nonneg (norm_nonneg _) _),
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq0.le, ofReal_norm]
  have hMq : (fun z => centeredMaximalQ q f z ^ q) = realMixedMaximal g := by
    funext z
    simp only [centeredMaximalQ, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one]
    rfl
  have hscale := mixedENorm_rpow_scale volume ν hp0 (by norm_num : (0 : ℝ) < 4)
    hq0 (centeredMaximalQ q f)
  rw [hMq] at hscale
  simp only [hgn] at h
  rw [hscale, mixedENorm_rpow_scale volume ν hp0 (by norm_num : (0 : ℝ) < 4)
    hq0 (fun z => ‖f z‖ₑ)] at h
  have hfinal := ENNReal.rpow_le_rpow h (one_div_pos.mpr hq0).le
  rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one,
    ENNReal.mul_rpow_of_nonneg _ _ (one_div_pos.mpr hq0).le,
    ← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one] at hfinal
  exact hfinal

/-- Centered prerequisite for blueprint `lem:vector-maximal`: for `2 < q < 3` and `p > q`,
`M_q` is bounded on `L^p(ℝ; L^4(Ω))`, uniformly over finite inner measure spaces. -/
theorem centeredOneMixedNorm (p q : ℝ) (hq2 : 2 < q) (hq3 : q < 3) (hpq : q < p) :
    ∃ C : NNReal, ∀ {Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω) [IsFiniteMeasure ν]
      (f : ℝ × Ω → ℂ), Measurable f →
        mixedENorm volume ν p 4 (centeredMaximalQ q f) ≤
          C * mixedENorm volume ν p 4 (fun z => ‖f z‖ₑ) := by
  have hq0 : 0 < q := by linarith
  have hpr : 1 < p / q := (lt_div_iff₀ hq0).mpr (by simpa)
  have hsr : 1 < 4 / q := (lt_div_iff₀ hq0).mpr (by linarith)
  let C := fsMixedConst 1 (p / q) (4 / q) ^ (1 / q)
  have hC : C ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by positivity)
    (fsMixedConst_ne_top 1 hpr hsr)
  refine ⟨C.toNNReal, ?_⟩
  intro Ω _ ν _ f hf
  rw [ENNReal.coe_toNNReal hC]
  exact centeredMaximalQ_mixedNorm ν hq2 hq3 hpq f hf

/-- The reduced-basis estimates imply a uniform bound on each coefficient
weighted by its basis-vector length; used in blueprint `lem:lattice-box`. -/
theorem reducedBasis_weighted_coordinate_bound {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) (i : Fin n) (x : E) :
    ‖b i‖ * |b.repr x i| ≤ (8 : ℝ) ^ n * ‖x‖ := by
  calc
    _ ≤ ((2 : ℝ) ^ n * ‖InnerProductSpace.gramSchmidt ℝ b i‖) * |b.repr x i| :=
      mul_le_mul_of_nonneg_right (reducedBasis_primal_prefix_bound b hb hr le_rfl)
        (abs_nonneg _)
    _ = (2 : ℝ) ^ n * (‖InnerProductSpace.gramSchmidt ℝ b i‖ * |b.repr x i|) := by ring
    _ ≤ (2 : ℝ) ^ n * ((4 : ℝ) ^ n * ‖x‖) :=
      mul_le_mul_of_nonneg_left (reducedBasis_coordinate_bound b hb hr i x) (by positivity)
    _ = (8 : ℝ) ^ n * ‖x‖ := by rw [← mul_assoc, ← mul_pow]; norm_num

/-- The printed floored side length; zero lengths will be discarded. -/
noncomputable def latticeBoxSideLength {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (i : Fin n) : ℤ :=
  ⌊(4 * (n : ℝ) * ‖b i‖)⁻¹⌋

/-- The part of the lattice basis retained in the coefficient box. -/
noncomputable def latticeBoxIndices {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) : Finset (Fin n) :=
  Finset.univ.filter (fun i => 0 < latticeBoxSideLength b i)

/-- An integer coefficient box on the selected part of a basis. -/
def integerCoefficientBox {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (I : Finset (Fin n)) (L : Fin n → ℤ) : Set E :=
  {x | ∃ z : Fin n → ℤ, (∀ i ∉ I, z i = 0) ∧
    (∀ i ∈ I, |z i| ≤ L i) ∧ ∑ i, z i • b i = x}

theorem latticeBoxSideLength_nonneg {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (i : Fin n) :
    0 ≤ latticeBoxSideLength b i := Int.floor_nonneg.mpr (by positivity)

theorem latticeBoxSideLength_pos {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) {i : Fin n}
    (hi : i ∈ latticeBoxIndices b) : 1 ≤ latticeBoxSideLength b i := by
  have h : 0 < latticeBoxSideLength b i := (Finset.mem_filter.mp hi).2
  omega

theorem latticeBoxSideLength_zero {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) {i : Fin n}
    (hi : i ∉ latticeBoxIndices b) : latticeBoxSideLength b i = 0 := by
  have h : ¬0 < latticeBoxSideLength b i := by simpa [latticeBoxIndices] using hi
  exact le_antisymm (le_of_not_gt h) (latticeBoxSideLength_nonneg b i)

theorem latticeBoxSideLength_weight_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (hn : 0 < n) (b : Module.Basis (Fin n) ℝ E) (i : Fin n) :
    (latticeBoxSideLength b i : ℝ) * ‖b i‖ ≤ (4 * (n : ℝ))⁻¹ := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hb : ‖b i‖ ≠ 0 := norm_ne_zero_iff.mpr (b.ne_zero i)
  calc
    _ ≤ (4 * (n : ℝ) * ‖b i‖)⁻¹ * ‖b i‖ :=
      mul_le_mul_of_nonneg_right (Int.floor_le _) (norm_nonneg _)
    _ = _ := by field_simp

/-- Blueprint `lem:lattice-box`, line 336: the total length budget is `1/4`. -/
theorem latticeBoxSideLength_sum_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (hn : 0 < n) (b : Module.Basis (Fin n) ℝ E) :
    ∑ i, (latticeBoxSideLength b i : ℝ) * ‖b i‖ ≤ (1 / 4 : ℝ) := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  calc
    _ ≤ ∑ _i : Fin n, (4 * (n : ℝ))⁻¹ :=
      Finset.sum_le_sum fun i _ => latticeBoxSideLength_weight_le hn b i
    _ = (1 / 4 : ℝ) := by simp; field_simp

/-- The explicit radius `(100d)^(-10d)` from blueprint `lem:lattice-box`. -/
noncomputable def latticeBoxRadius (n : ℕ) : ℝ := ((100 * (n : ℝ)) ^ (10 * n))⁻¹

theorem latticeBoxRadius_pos {n : ℕ} (hn : 0 < n) : 0 < latticeBoxRadius n := by
  unfold latticeBoxRadius
  have : (0 : ℝ) < n := by exact_mod_cast hn
  positivity

theorem latticeBoxRadius_scaled_le {n : ℕ} (hn : 0 < n) :
    (4 * (n : ℝ) * (8 : ℝ) ^ n) * latticeBoxRadius n ≤ 1 := by
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hbase : (1 : ℝ) ≤ 100 * n := by linarith
  have hbound : (4 * (n : ℝ)) * (8 : ℝ) ^ n ≤ (100 * (n : ℝ)) ^ (10 * n) := by
    calc
      _ ≤ (100 * (n : ℝ)) * (100 * (n : ℝ)) ^ n :=
        mul_le_mul (by linarith) (pow_le_pow_left₀ (by norm_num) (by linarith) n)
          (by positivity) (by positivity)
      _ = (100 * (n : ℝ)) ^ (n + 1) := by rw [pow_succ]; ring
      _ ≤ _ := pow_le_pow_right₀ hbase (by omega)
  rw [latticeBoxRadius, ← div_eq_mul_inv]
  exact (div_le_one (by positivity)).mpr hbound

/-- Integer coordinates in a real basis of its integer span. -/
theorem exists_integer_basis_coordinates {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) {v : E}
    (hv : v ∈ Submodule.span ℤ (Set.range b)) :
    ∃ z : Fin n → ℤ, (∀ i, (z i : ℝ) = b.repr v i) ∧ ∑ i, z i • b i = v := by
  have hcoord : ∀ i, ∃ z : ℤ, (z : ℝ) = b.repr v i :=
    (b.mem_span_iff_repr_mem ℤ v).mp hv
  choose z hz using hcoord
  refine ⟨z, hz, ?_⟩
  calc
    _ = ∑ i, b.repr v i • b i := by
      apply Finset.sum_congr rfl
      intro i _
      rw [← hz i, Int.cast_smul_eq_zsmul ℝ]
    _ = v := b.sum_repr v

/-- Blueprint `lem:lattice-box`, lines 337–342: every lattice vector with
norm at most the explicit radius belongs to the selected coefficient box. -/
theorem small_lattice_vector_mem_coefficientBox {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ} (hn : 0 < n)
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) {v : E} (hv : v ∈ Submodule.span ℤ (Set.range b))
    (hnorm : ‖v‖ ≤ latticeBoxRadius n) :
    v ∈ integerCoefficientBox b (latticeBoxIndices b) (latticeBoxSideLength b) := by
  obtain ⟨z, hz, hsum⟩ := exists_integer_basis_coordinates b hv
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  have hcoeff (i : Fin n) : |z i| ≤ latticeBoxSideLength b i := by
    apply Int.le_floor.mpr
    rw [Int.cast_abs]
    rw [← one_div]
    have hbi : 0 < ‖b i‖ := norm_pos_iff.mpr (b.ne_zero i)
    apply (le_div_iff₀ (by positivity)).mpr
    calc
      _ = (4 * (n : ℝ)) * (‖b i‖ * |b.repr v i|) := by rw [hz i]; ring
      _ ≤ (4 * (n : ℝ)) * ((8 : ℝ) ^ n * ‖v‖) :=
        mul_le_mul_of_nonneg_left (reducedBasis_weighted_coordinate_bound b hb hr i v)
          (by positivity)
      _ ≤ (4 * (n : ℝ)) * ((8 : ℝ) ^ n * latticeBoxRadius n) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hnorm (by positivity)) (by positivity)
      _ = (4 * (n : ℝ) * (8 : ℝ) ^ n) * latticeBoxRadius n := by ring
      _ ≤ 1 := latticeBoxRadius_scaled_le hn
  refine ⟨z, ?_, fun i _ => hcoeff i, hsum⟩
  intro i hi
  exact abs_nonpos_iff.mp (by simpa only [latticeBoxSideLength_zero b hi] using hcoeff i)

/-- Every partial coordinate sum in the selected coefficient box has norm
at most `1/4`, as required in blueprint `lem:lattice-box`. -/
theorem coefficientBox_partial_sum_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (hn : 0 < n) (b : Module.Basis (Fin n) ℝ E)
    (z : Fin n → ℤ) (hz : ∀ i ∉ latticeBoxIndices b, z i = 0)
    (hbound : ∀ i ∈ latticeBoxIndices b, |z i| ≤ latticeBoxSideLength b i)
    (s : Finset (Fin n)) : ‖∑ i ∈ s, z i • b i‖ ≤ (1 / 4 : ℝ) := by
  have hcoeff (i : Fin n) : |z i| ≤ latticeBoxSideLength b i := by
    by_cases hi : i ∈ latticeBoxIndices b
    · exact hbound i hi
    · rw [hz i hi, abs_zero]
      exact latticeBoxSideLength_nonneg b i
  calc
    _ ≤ ∑ i ∈ s, |(z i : ℝ)| * ‖b i‖ := by
      simpa only [norm_zsmul ℝ, Real.norm_eq_abs] using norm_sum_le s (fun i => z i • b i)
    _ ≤ ∑ i ∈ s, (latticeBoxSideLength b i : ℝ) * ‖b i‖ := by
      apply Finset.sum_le_sum
      intro i _
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      exact_mod_cast hcoeff i
    _ ≤ ∑ i, (latticeBoxSideLength b i : ℝ) * ‖b i‖ :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ s) (fun i _ _ =>
        mul_nonneg (by exact_mod_cast latticeBoxSideLength_nonneg b i) (norm_nonneg _))
    _ ≤ (1 / 4 : ℝ) := latticeBoxSideLength_sum_le hn b

theorem coefficientBox_subset_quarter_ball {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (hn : 0 < n) (b : Module.Basis (Fin n) ℝ E) :
    integerCoefficientBox b (latticeBoxIndices b) (latticeBoxSideLength b) ⊆
      Metric.closedBall (0 : E) (1 / 4) := by
  rintro x ⟨z, hz, hbound, rfl⟩
  rw [Metric.mem_closedBall, dist_zero_right]
  exact coefficientBox_partial_sum_le hn b z hz hbound Finset.univ

theorem integerCoefficientBox_empty {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (L : Fin n → ℤ) :
    integerCoefficientBox b ∅ L = {0} := by
  ext x
  constructor
  · rintro ⟨z, hz, _, hsum⟩
    have hzero : z = 0 := funext fun i => hz i (Finset.notMem_empty i)
    simpa only [hzero, Pi.zero_apply, zero_smul, Finset.sum_const_zero,
      Set.mem_singleton_iff] using hsum.symm
  · intro hx
    have hx0 : x = 0 := Set.mem_singleton_iff.mp hx
    subst x
    exact ⟨0, by simp, by simp, by simp⟩

/-- Blueprint `lem:lattice-box`, complete statement: a part of a lattice
basis with positive integer side lengths contains the closed radius
`(100d)^(-10d)` lattice ball and lies in the closed radius `1/4` ball;
every partial coordinate sum satisfies the same outer bound. -/
theorem smallBallCoefficientBox {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ} (hn : 0 < n)
    (b : Module.Basis (Fin n) ℝ E) :
    ∃ (c : Module.Basis (Fin n) ℝ E) (I : Finset (Fin n)) (L : Fin n → ℤ),
      Submodule.span ℤ (Set.range c) = Submodule.span ℤ (Set.range b) ∧
      (∀ i ∈ I, 1 ≤ L i) ∧
      (Metric.closedBall (0 : E) (latticeBoxRadius n) ∩
        (Submodule.span ℤ (Set.range b) : Set E) ⊆ integerCoefficientBox c I L) ∧
      (integerCoefficientBox c I L ⊆ Metric.closedBall 0 (1 / 4)) ∧
      ∀ z : Fin n → ℤ, (∀ i ∉ I, z i = 0) → (∀ i ∈ I, |z i| ≤ L i) →
        ∀ s : Finset (Fin n), ‖∑ i ∈ s, z i • c i‖ ≤ (1 / 4 : ℝ) := by
  obtain ⟨c, hc, hshort, hred⟩ := exists_reducedShortestProjectionBasis b
  refine ⟨c, latticeBoxIndices c, latticeBoxSideLength c, hc,
    fun _ hi => latticeBoxSideLength_pos c hi, ?_,
    coefficientBox_subset_quarter_ball hn c, coefficientBox_partial_sum_le hn c⟩
  intro v hv
  apply small_lattice_vector_mem_coefficientBox hn c hshort hred
  · rw [hc]
    exact hv.2
  · simpa only [Metric.mem_closedBall, dist_zero_right] using hv.1

/-- The coefficient-box theorem for an arbitrary full lattice in positive dimension. -/
theorem smallBallCoefficientBox_fullLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (L : Submodule ℤ E)
    [DiscreteTopology L] [IsZLattice ℝ L] (hd : 0 < Module.finrank ℝ E) :
    ∃ (b : Module.Basis (Fin (Module.finrank ℝ E)) ℝ E)
      (I : Finset (Fin (Module.finrank ℝ E))) (a : Fin (Module.finrank ℝ E) → ℤ),
      Submodule.span ℤ (Set.range b) = L ∧ (∀ i ∈ I, 1 ≤ a i) ∧
      (Metric.closedBall (0 : E) (latticeBoxRadius (Module.finrank ℝ E)) ∩
        (L : Set E) ⊆ integerCoefficientBox b I a) ∧
      (integerCoefficientBox b I a ⊆ Metric.closedBall 0 (1 / 4)) ∧
      ∀ z : Fin (Module.finrank ℝ E) → ℤ, (∀ i ∉ I, z i = 0) → (∀ i ∈ I, |z i| ≤ a i) →
        ∀ s : Finset (Fin (Module.finrank ℝ E)), ‖∑ i ∈ s, z i • b i‖ ≤ (1 / 4 : ℝ) := by
  let := ZLattice.module_finite ℝ L
  let := ZLattice.module_free ℝ L
  let b := ((Module.finBasis ℤ L).ofZLatticeBasis ℝ L).reindex (finCongr (ZLattice.rank ℝ L))
  have hb : Submodule.span ℤ (Set.range b) = L := by
    rw [Module.Basis.range_reindex, Module.Basis.ofZLatticeBasis_span]
  simpa only [hb] using smallBallCoefficientBox hd b

/-- The standard real torus used in blueprint `lem:torus-annihilator`. -/
abbrev StandardTorus (d : ℕ) := Fin d → AddCircle (1 : ℝ)

/-- Evaluation of an integer frequency at a torus point, before exponentiation. -/
noncomputable def torusEvaluation {d : ℕ} (x : StandardTorus d) :
    (Fin d → ℤ) →ₗ[ℤ] AddCircle (1 : ℝ) := (Pi.basisFun ℤ (Fin d)).constr ℤ x

noncomputable def torusPairing {d : ℕ} (n : Fin d → ℤ) (x : StandardTorus d) :
    AddCircle (1 : ℝ) := torusEvaluation x n

theorem torusPairing_eq_sum {d : ℕ} (n : Fin d → ℤ) (x : StandardTorus d) :
    torusPairing n x = ∑ i, n i • x i := by
  simp [torusPairing, torusEvaluation, Module.Basis.constr_apply_fintype]

noncomputable def torusPairingMap {d : ℕ} (n : Fin d → ℤ) :
    StandardTorus d →ₗ[ℤ] AddCircle (1 : ℝ) where
  toFun := torusPairing n
  map_add' x y := by simp [torusPairing, torusEvaluation]
  map_smul' r x := by simp [torusPairing, torusEvaluation]

theorem continuous_torusPairing {d : ℕ} (n : Fin d → ℤ) : Continuous (torusPairing n) := by
  have h : torusPairing n = fun x => ∑ i, n i • x i := funext (torusPairing_eq_sum n)
  rw [h]
  exact continuous_finsetSum _ (fun i _ => (continuous_apply i).zsmul (n i))

/-- The subgroup annihilating all frequencies in an integer submodule. -/
noncomputable def torusAnnihilator {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    Submodule ℤ (StandardTorus d) := ⨅ n : L, (torusPairingMap (n : Fin d → ℤ)).ker

theorem mem_torusAnnihilator {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) (x : StandardTorus d) :
    x ∈ torusAnnihilator L ↔ ∀ n ∈ L, torusPairing n x = 0 := by
  simp only [torusAnnihilator, Submodule.mem_iInf, LinearMap.mem_ker]
  change (∀ n : L, torusPairing n x = 0) ↔ _
  exact ⟨fun h n hn => h ⟨n, hn⟩, fun h n => h n n.property⟩

/-- An integer basis acts on the torus by evaluating its basis frequencies. -/
noncomputable def torusBasisEquiv {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ)) :
    StandardTorus d ≃ₗ[ℤ] StandardTorus d :=
  ((Pi.basisFun ℤ (Fin d)).constr ℤ).trans (b.constr ℤ).symm

theorem torusBasisEquiv_apply {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (x : StandardTorus d) (i : Fin d) : torusBasisEquiv b x i = torusPairing (b i) x := rfl

theorem torusBasisEquiv_symm_apply {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (x : StandardTorus d) (i : Fin d) :
    (torusBasisEquiv b).symm x i = ∑ j, b.repr (Pi.basisFun ℤ (Fin d) i) j • x j := by
  change (b.constr ℤ x) (Pi.basisFun ℤ (Fin d) i) = _
  exact b.constr_apply_fintype ℤ x _

theorem continuous_torusBasisEquiv {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ)) :
    Continuous (torusBasisEquiv b) := by
  apply continuous_pi
  intro i
  simpa only [torusBasisEquiv_apply] using continuous_torusPairing (b i)

theorem continuous_torusBasisEquiv_symm {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ)) :
    Continuous (torusBasisEquiv b).symm := by
  apply continuous_pi
  intro i
  simp only [torusBasisEquiv_symm_apply]
  exact continuous_finsetSum _ (fun j _ => (continuous_apply j).zsmul _)

noncomputable def torusBasisHomeomorph {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ)) :
    StandardTorus d ≃ₜ StandardTorus d where
  toEquiv := (torusBasisEquiv b).toEquiv
  continuous_toFun := continuous_torusBasisEquiv b
  continuous_invFun := continuous_torusBasisEquiv_symm b

/-- Blueprint `lem:torus-annihilator`, line 358: an adapted integer basis
turns annihilation by its first basis vectors into zero coordinate conditions. -/
theorem torusAnnihilator_basis_coordinates {d r : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (hb : Submodule.span ℤ (b '' {i | i.val < r}) = L) (x : StandardTorus d) :
    x ∈ torusAnnihilator L ↔ ∀ i : Fin d, i.val < r → torusBasisEquiv b x i = 0 := by
  rw [mem_torusAnnihilator]
  constructor
  · intro h i hi
    rw [torusBasisEquiv_apply]
    apply h
    rw [← hb]
    exact Submodule.subset_span ⟨i, hi, rfl⟩
  · intro h n hn
    have hker : L ≤ (torusEvaluation x).ker := by
      rw [← hb]
      apply Submodule.span_le.mpr
      rintro _ ⟨i, hi, rfl⟩
      exact h i hi
    exact hker hn

theorem rationalAnnihilator_coordinates {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) :
    ∃ r ≤ d, ∃ b : Module.Basis (Fin d) ℤ (Fin d → ℤ), ∀ x : StandardTorus d,
      x ∈ torusAnnihilator (rationalIntegerIntersection V) ↔
        ∀ i : Fin d, i.val < r → torusBasisEquiv b x i = 0 := by
  obtain ⟨r, hr, b, hb⟩ := saturatedAdaptedBasis (rationalIntegerIntersection V)
    (rationalIntegerIntersection_saturated V)
  exact ⟨r, hr, b, torusAnnihilator_basis_coordinates _ b hb⟩

/-- The coordinate torus with its first `r` coordinates equal to zero. -/
def coordinateTorus (d r : ℕ) : Submodule ℤ (StandardTorus d) where
  carrier := {x | ∀ i : Fin d, i.val < r → x i = 0}
  zero_mem' := by simp
  add_mem' hx hy i hi := by simp [hx i hi, hy i hi]
  smul_mem' a x hx i hi := by simp [hx i hi]

noncomputable def coordinateTorusTailEquiv (d r : ℕ) :
    coordinateTorus d r ≃ₗ[ℤ] ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ)) where
  toFun x i := x.val i.val
  invFun y := ⟨fun i => if h : r ≤ i.val then y ⟨i, h⟩ else 0, by
    intro i hi
    exact dite_eq_right (by omega)⟩
  left_inv x := by
    apply Subtype.ext
    funext i
    change (if h : r ≤ i.val then x.val (⟨i, h⟩ : {i : Fin d // r ≤ i.val}).val else 0) = x.val i
    by_cases hi : r ≤ i.val
    · simp only [dite_eq_left hi]
    · rw [dite_eq_right hi]
      exact (x.property i (by omega)).symm
  right_inv y := by
    funext i
    exact dite_eq_left i.property
  map_add' x y := rfl
  map_smul' a x := rfl

theorem continuous_coordinateTorusTailEquiv (d r : ℕ) :
    Continuous (coordinateTorusTailEquiv d r) := by
  exact continuous_pi fun i => (continuous_apply i.val).comp continuous_subtype_val

theorem continuous_coordinateTorusTailEquiv_symm (d r : ℕ) :
    Continuous (coordinateTorusTailEquiv d r).symm := by
  apply Continuous.subtype_mk
  apply continuous_pi
  intro i
  change Continuous (fun y : {i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ) =>
    if h : r ≤ i.val then y ⟨i, h⟩ else 0)
  by_cases hi : r ≤ i.val
  · simpa only [dite_eq_left hi] using continuous_apply (⟨i, hi⟩ : {i : Fin d // r ≤ i.val})
  · simpa only [dite_eq_right hi] using
      (continuous_const : Continuous (fun _ : {i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ) =>
        (0 : AddCircle (1 : ℝ))))

noncomputable def coordinateTorusTailHomeomorph (d r : ℕ) :
    coordinateTorus d r ≃ₜ ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ)) where
  toEquiv := (coordinateTorusTailEquiv d r).toEquiv
  continuous_toFun := continuous_coordinateTorusTailEquiv d r
  continuous_invFun := continuous_coordinateTorusTailEquiv_symm d r

noncomputable def torusAnnihilatorCoordinateEquiv {d r : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (hb : Submodule.span ℤ (b '' {i | i.val < r}) = L) :
    torusAnnihilator L ≃ₗ[ℤ] coordinateTorus d r where
  toFun x := ⟨torusBasisEquiv b x, (torusAnnihilator_basis_coordinates L b hb x).mp x.property⟩
  invFun y := ⟨(torusBasisEquiv b).symm y,
    (torusAnnihilator_basis_coordinates L b hb _).mpr (by
      have hy : ∀ i : Fin d, i.val < r → (y : StandardTorus d) i = 0 := y.property
      simpa only [LinearEquiv.apply_symm_apply] using hy)⟩
  left_inv x := Subtype.ext ((torusBasisEquiv b).symm_apply_apply x)
  right_inv y := Subtype.ext ((torusBasisEquiv b).apply_symm_apply y)
  map_add' x y := Subtype.ext ((torusBasisEquiv b).map_add x y)
  map_smul' a x := Subtype.ext ((torusBasisEquiv b).map_smul a x)

noncomputable def torusAnnihilatorCoordinateHomeomorph {d r : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (hb : Submodule.span ℤ (b '' {i | i.val < r}) = L) :
    torusAnnihilator L ≃ₜ coordinateTorus d r where
  toEquiv := (torusAnnihilatorCoordinateEquiv L b hb).toEquiv
  continuous_toFun := ((continuous_torusBasisEquiv b).comp continuous_subtype_val).subtype_mk _
  continuous_invFun :=
    ((continuous_torusBasisEquiv_symm b).comp continuous_subtype_val).subtype_mk _

/-- Blueprint `lem:torus-annihilator`: every saturated annihilator is
isomorphic and homeomorphic to a finite product of circles. -/
theorem saturatedAnnihilator_is_torus {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) : ∃ r ≤ d,
      Nonempty (torusAnnihilator L ≃ₗ[ℤ] ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ))) ∧
      Nonempty (torusAnnihilator L ≃ₜ ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ))) := by
  obtain ⟨r, hr, b, hb⟩ := saturatedAdaptedBasis L hL
  exact ⟨r, hr,
    ⟨(torusAnnihilatorCoordinateEquiv L b hb).trans (coordinateTorusTailEquiv d r)⟩,
    ⟨(torusAnnihilatorCoordinateHomeomorph L b hb).trans (coordinateTorusTailHomeomorph d r)⟩⟩

theorem saturatedAnnihilator_connected {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) : ConnectedSpace (torusAnnihilator L) := by
  obtain ⟨r, _, _, ⟨e⟩⟩ := saturatedAnnihilator_is_torus L hL
  exact e.symm.surjective.connectedSpace e.symm.continuous

theorem rationalAnnihilator_connected {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) :
    ConnectedSpace (torusAnnihilator (rationalIntegerIntersection V)) :=
  saturatedAnnihilator_connected _ (rationalIntegerIntersection_saturated V)

theorem torusAnnihilator_isClosed {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    IsClosed (torusAnnihilator L : Set (StandardTorus d)) := by
  have heq : (torusAnnihilator L : Set (StandardTorus d)) =
      ⋂ n : L, {x | torusPairing (n : Fin d → ℤ) x = 0} := by
    ext x
    simp only [SetLike.mem_coe, mem_torusAnnihilator, Set.mem_iInter,
      Set.mem_ofPred_eq, Subtype.forall]
  rw [heq]
  apply isClosed_iInter
  intro n
  exact isClosed_eq (continuous_torusPairing (n : Fin d → ℤ))
    (continuous_const : Continuous (fun _ : StandardTorus d => (0 : AddCircle (1 : ℝ))))

instance torusAnnihilator_compactSpace {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    CompactSpace (torusAnnihilator L) :=
  isCompact_iff_compactSpace.mp (torusAnnihilator_isClosed L).isCompact

/-- Haar probability on the compact annihilator subgroup. -/
noncomputable def torusAnnihilatorHaar {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    MeasureTheory.Measure (torusAnnihilator L) :=
  MeasureTheory.Measure.addHaarMeasure
    (⟨⟨Set.univ, isCompact_univ⟩, by simp⟩ : TopologicalSpace.PositiveCompacts (torusAnnihilator L))

instance torusAnnihilatorHaar_isAddHaar {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    (torusAnnihilatorHaar L).IsAddHaarMeasure := by
  unfold torusAnnihilatorHaar
  infer_instance

instance torusAnnihilatorHaar_probability {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    MeasureTheory.IsProbabilityMeasure (torusAnnihilatorHaar L) := by
  constructor
  exact MeasureTheory.Measure.addHaarMeasure_self

/-- The character `exp(2πi n·x)` on the standard torus. -/
noncomputable def torusCharacter {d : ℕ} (n : Fin d → ℤ) (x : StandardTorus d) : ℂ :=
  fourier 1 (torusPairing n x)

theorem continuous_torusCharacter {d : ℕ} (n : Fin d → ℤ) : Continuous (torusCharacter n) :=
  (fourier 1).continuous.comp (continuous_torusPairing n)

theorem torusPairing_basis_inverse {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (n : Fin d → ℤ) (y : StandardTorus d) :
    torusPairing n ((torusBasisEquiv b).symm y) = ∑ i, b.repr n i • y i := by
  change ((Pi.basisFun ℤ (Fin d)).constr ℤ)
    (((Pi.basisFun ℤ (Fin d)).constr ℤ).symm ((b.constr ℤ) y)) n = _
  rw [LinearEquiv.apply_symm_apply]
  exact b.constr_apply_fintype ℤ y n

/-- A frequency outside a saturated integer submodule has a half-period
on its annihilator, giving the cancellation needed for its Haar integral. -/
theorem saturatedAnnihilator_half_period {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) {n : Fin d → ℤ} (hn : n ∉ L) :
    ∃ x : torusAnnihilator L, torusPairing n x = ((1 / 2 : ℝ) : AddCircle (1 : ℝ)) := by
  classical
  obtain ⟨r, _, b, hb⟩ := saturatedAdaptedBasis L hL
  have hex : ∃ i : Fin d, r ≤ i.val ∧ b.repr n i ≠ 0 := by
    by_contra h
    push Not at h
    apply hn
    rw [← hb, b.mem_span_image]
    intro i hi
    have hi' : b.repr n i ≠ 0 := Finsupp.mem_support_iff.mp hi
    exact lt_of_not_ge (fun hri => hi' (h i hri))
  obtain ⟨i, hi, hni⟩ := hex
  let y : StandardTorus d := Pi.single i (((1 / 2 : ℝ) / (b.repr n i : ℝ)) : AddCircle (1 : ℝ))
  have hx : (torusBasisEquiv b).symm y ∈ torusAnnihilator L := by
    apply (torusAnnihilator_basis_coordinates L b hb _).mpr
    intro j hj
    rw [LinearEquiv.apply_symm_apply]
    have hji : j ≠ i := by intro heq; subst j; omega
    simp [y, Pi.single_eq_of_ne hji]
  refine ⟨⟨(torusBasisEquiv b).symm y, hx⟩, ?_⟩
  rw [torusPairing_basis_inverse]
  simp only [y, Pi.single_apply, smul_ite, smul_zero, Finset.sum_ite_eq', Finset.mem_univ,
    ite_true]
  rw [← AddCircle.coe_zsmul]
  congr 1
  rw [zsmul_eq_mul]
  have hk : (b.repr n i : ℝ) ≠ 0 := by exact_mod_cast hni
  field_simp

theorem torusCharacter_add_half_period {d : ℕ} (n : Fin d → ℤ) {a : StandardTorus d}
    (ha : torusPairing n a = ((1 / 2 : ℝ) : AddCircle (1 : ℝ))) (x : StandardTorus d) :
    torusCharacter n (x + a) = -torusCharacter n x := by
  have hpair := (torusPairingMap n).map_add x a
  change torusPairing n (x + a) = torusPairing n x + torusPairing n a at hpair
  rw [torusCharacter, hpair, ha]
  simpa only [Int.cast_one, div_one, torusCharacter] using
    fourier_add_half_inv_index (T := (1 : ℝ)) (n := (1 : ℤ))
      one_ne_zero zero_lt_one (torusPairing n x)

open scoped Classical in
/-- Blueprint `lem:torus-annihilator`: the Haar integral of a torus character
over the annihilator of a saturated lattice is exactly its membership indicator. -/
theorem saturatedAnnihilator_character_integral {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) (n : Fin d → ℤ) :
    (∫ x : torusAnnihilator L, torusCharacter n x ∂torusAnnihilatorHaar L) =
      if n ∈ L then (1 : ℂ) else 0 := by
  classical
  by_cases hn : n ∈ L
  · rw [ite_eq_left hn]
    have hone : ∀ x : torusAnnihilator L, torusCharacter n x = 1 := by
      intro x
      have h := (mem_torusAnnihilator L x).mp x.property n hn
      simp [torusCharacter, h]
    simp only [hone, MeasureTheory.integral_const, MeasureTheory.probReal_univ, one_smul]
  · rw [ite_eq_right hn]
    obtain ⟨a, ha⟩ := saturatedAnnihilator_half_period L hL hn
    exact MeasureTheory.integral_eq_zero_of_add_right_eq_neg
      (g := a) (fun x => torusCharacter_add_half_period n ha x)

open scoped Classical in
theorem rationalAnnihilator_character_integral {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    (n : Fin d → ℤ) :
    (∫ x : torusAnnihilator (rationalIntegerIntersection V), torusCharacter n x
      ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) =
      if n ∈ rationalIntegerIntersection V then (1 : ℂ) else 0 :=
  saturatedAnnihilator_character_integral _ (rationalIntegerIntersection_saturated V) n

/-- Nonzero integer multiplication is onto every saturated annihilator torus. -/
theorem saturatedAnnihilator_zsmul_surjective {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) {k : ℤ} (hk : k ≠ 0) :
    Function.Surjective (fun x : torusAnnihilator L => k • x) := by
  obtain ⟨r, _, ⟨e⟩, _⟩ := saturatedAnnihilator_is_torus L hL
  intro y
  obtain ⟨x, hx⟩ := DivisibleBy.surjective_smul
    ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ)) ℤ hk (e y)
  refine ⟨e.symm x, ?_⟩
  apply e.injective
  rw [map_smul, e.apply_symm_apply]
  exact hx

/-- The two-coordinate progression map from blueprint `lem:torus-annihilator`. -/
def progressionPairHom (G : Type*) [AddCommGroup G] (i j l : ℤ) : (G × G) →+ (G × G) where
  toFun x := (x.1 + (i - l) • x.2, x.1 + (j - l) • x.2)
  map_zero' := by simp
  map_add' x y := by
    ext <;> simp only [Prod.fst_add, Prod.snd_add, smul_add] <;> abel

theorem progressionPairHom_surjective {G : Type*} [AddCommGroup G]
    (hdiv : ∀ k : ℤ, k ≠ 0 → Function.Surjective (fun x : G => k • x))
    {i j : ℤ} (hij : i ≠ j) (l : ℤ) : Function.Surjective (progressionPairHom G i j l) := by
  rintro ⟨a, b⟩
  obtain ⟨v, hv⟩ := hdiv (j - i) (sub_ne_zero.mpr hij.symm) (b - a)
  change (j - i) • v = b - a at hv
  refine ⟨(a - (i - l) • v, v), ?_⟩
  apply Prod.ext
  · change a - (i - l) • v + (i - l) • v = a
    abel
  · change a - (i - l) • v + (j - l) • v = b
    calc
      _ = a + (j - i) • v := by simp only [sub_smul]; abel
      _ = b := by rw [hv]; abel

theorem saturatedAnnihilator_progression_surjective {d : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (hL : IntegerSaturated L) {i j : ℤ}
    (hij : i ≠ j) (l : ℤ) :
    Function.Surjective (progressionPairHom (torusAnnihilator L) i j l) :=
  progressionPairHom_surjective (fun _ hk => saturatedAnnihilator_zsmul_surjective L hL hk) hij l

theorem rationalAnnihilator_progression_surjective {d : ℕ}
    (V : Submodule ℚ (Fin d → ℚ)) {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    Function.Surjective
      (progressionPairHom (torusAnnihilator (rationalIntegerIntersection V)) i j l) :=
  saturatedAnnihilator_progression_surjective _ (rationalIntegerIntersection_saturated V) hij l

theorem continuous_progressionPairHom {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] (i j l : ℤ) : Continuous (progressionPairHom G i j l) :=
  (continuous_fst.add (continuous_snd.zsmul (i - l))).prodMk
    (continuous_fst.add (continuous_snd.zsmul (j - l)))

/-- Blueprint `lem:torus-annihilator`: the progression pair map preserves
the product of the annihilator's Haar probabilities. -/
theorem saturatedAnnihilator_progression_measurePreserving {d : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (hL : IntegerSaturated L) {i j : ℤ}
    (hij : i ≠ j) (l : ℤ) :
    MeasureTheory.MeasurePreserving (progressionPairHom (torusAnnihilator L) i j l)
      ((torusAnnihilatorHaar L).prod (torusAnnihilatorHaar L))
      ((torusAnnihilatorHaar L).prod (torusAnnihilatorHaar L)) := by
  let : SecondCountableTopology (torusAnnihilator L) := inferInstance
  let : BorelSpace (torusAnnihilator L) := inferInstance
  exact AddMonoidHom.measurePreserving (continuous_progressionPairHom i j l)
    (saturatedAnnihilator_progression_surjective L hL hij l) rfl

theorem rationalAnnihilator_progression_measurePreserving {d : ℕ}
    (V : Submodule ℚ (Fin d → ℚ)) {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    MeasureTheory.MeasurePreserving
      (progressionPairHom (torusAnnihilator (rationalIntegerIntersection V)) i j l)
      ((torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V)))
      ((torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V))) :=
  saturatedAnnihilator_progression_measurePreserving _
    (rationalIntegerIntersection_saturated V) hij l

open scoped Classical in
/-- Blueprint `lem:torus-annihilator`, complete statement: a rational
annihilator is a compact connected torus; its character integrals are the
indicator of the integer lattice; and every two-distinct-slot progression
map is surjective and preserves Haar probability, including dimension zero. -/
theorem rationalAnnihilator {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) :
    ConnectedSpace (torusAnnihilator (rationalIntegerIntersection V)) ∧
    (∃ r ≤ d, Nonempty (torusAnnihilator (rationalIntegerIntersection V) ≃ₜ
      ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ)))) ∧
    (∀ n : Fin d → ℤ,
      (∫ x : torusAnnihilator (rationalIntegerIntersection V), torusCharacter n x
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) =
        if n ∈ rationalIntegerIntersection V then (1 : ℂ) else 0) ∧
    ∀ i j : ℤ, i ≠ j → ∀ l : ℤ,
      Function.Surjective
        (progressionPairHom (torusAnnihilator (rationalIntegerIntersection V)) i j l) ∧
      MeasureTheory.MeasurePreserving
        (progressionPairHom (torusAnnihilator (rationalIntegerIntersection V)) i j l)
        ((torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
          (torusAnnihilatorHaar (rationalIntegerIntersection V)))
        ((torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
          (torusAnnihilatorHaar (rationalIntegerIntersection V))) := by
  refine ⟨rationalAnnihilator_connected V, ?_, rationalAnnihilator_character_integral V, ?_⟩
  · obtain ⟨r, hr, _, he⟩ :=
      saturatedAnnihilator_is_torus _ (rationalIntegerIntersection_saturated V)
    exact ⟨r, hr, he⟩
  · intro i j hij l
    exact ⟨rationalAnnihilator_progression_surjective V hij l,
      rationalAnnihilator_progression_measurePreserving V hij l⟩

/-- The reciprocal exponent polytope in blueprint `lem:absolute`, line 390. -/
def reciprocalExponentPolytope (d k : ℕ) : Set (Fin d → ℝ) :=
  {a | (∀ i, 0 ≤ a i ∧ a i ≤ 1) ∧ ∑ i, a i ≤ k}

theorem reciprocalExponentPolytope_convex (d k : ℕ) :
    Convex ℝ (reciprocalExponentPolytope d k) := by
  intro a ha b hb s t hs ht hst
  constructor
  · intro i
    change 0 ≤ s * a i + t * b i ∧ s * a i + t * b i ≤ 1
    constructor
    · exact add_nonneg (mul_nonneg hs (ha.1 i).1) (mul_nonneg ht (hb.1 i).1)
    · calc
        s * a i + t * b i ≤ s * 1 + t * 1 :=
          add_le_add (mul_le_mul_of_nonneg_left (ha.1 i).2 hs)
            (mul_le_mul_of_nonneg_left (hb.1 i).2 ht)
        _ = 1 := by nlinarith
  · change ∑ i, (s * a i + t * b i) ≤ (k : ℝ)
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    calc
      _ ≤ s * k + t * k := add_le_add (mul_le_mul_of_nonneg_left ha.2 hs)
        (mul_le_mul_of_nonneg_left hb.2 ht)
      _ = k := by nlinarith

theorem reciprocalExponentPolytope_compact (d k : ℕ) :
    IsCompact (reciprocalExponentPolytope d k) := by
  have he : reciprocalExponentPolytope d k =
      Set.Icc (0 : Fin d → ℝ) 1 ∩ {a | ∑ i, a i ≤ (k : ℝ)} := by
    ext a
    simp only [reciprocalExponentPolytope, Set.mem_ofPred_eq, Set.mem_inter_iff,
      Set.mem_Icc, Pi.le_def, Pi.zero_apply, Pi.one_apply, forall_and]
  rw [he]
  exact isCompact_Icc.inter_right
    (isClosed_le (continuous_finsetSum _ (fun i _ => continuous_apply i)) continuous_const)

/-- A nonzero symmetric perturbation rules out an extreme point. -/
theorem extremePoint_perturbation_eq_zero {d : ℕ} {s : Set (Fin d → ℝ)}
    {a v : Fin d → ℝ} (ha : a ∈ s.extremePoints ℝ)
    (hplus : a + v ∈ s) (hminus : a - v ∈ s) : v = 0 := by
  have h := ha.2 hplus hminus (mem_openSegment_add_sub (𝕜 := ℝ) a v)
  have : a + v = a + 0 := by simpa using h
  exact add_left_cancel this

theorem reciprocalExponentPolytope_perturb {d k : ℕ} {a v : Fin d → ℝ}
    (hv : ∀ i, |v i| ≤ min (a i) (1 - a i))
    (hs : |∑ i, v i| ≤ (k : ℝ) - ∑ i, a i) :
    a + v ∈ reciprocalExponentPolytope d k ∧
      a - v ∈ reciprocalExponentPolytope d k := by
  have hc (i) := abs_le.mp (hv i)
  have hb (i) := le_min_iff.mp (hv i)
  have hsum := abs_le.mp hs
  constructor
  · constructor
    · intro i
      change 0 ≤ a i + v i ∧ a i + v i ≤ 1
      constructor <;>
        linarith [hc i, hb i, min_le_left (a i) (1 - a i), min_le_right (a i) (1 - a i)]
    · change ∑ i, (a i + v i) ≤ (k : ℝ)
      rw [Finset.sum_add_distrib]
      linarith
  · constructor
    · intro i
      change 0 ≤ a i - v i ∧ a i - v i ≤ 1
      constructor <;>
        linarith [hc i, hb i, min_le_left (a i) (1 - a i), min_le_right (a i) (1 - a i)]
    · change ∑ i, (a i - v i) ≤ (k : ℝ)
      rw [Finset.sum_sub_distrib]
      linarith

/-- Two fractional coordinates admit opposite perturbations, as in
blueprint `lem:absolute`, line 390. -/
theorem reciprocalExponentPolytope_extreme_fractional_unique {d k : ℕ}
    {a : Fin d → ℝ} (ha : a ∈ (reciprocalExponentPolytope d k).extremePoints ℝ)
    {i j : Fin d} (hi : 0 < a i ∧ a i < 1) (hj : 0 < a j ∧ a j < 1) : i = j := by
  classical
  by_contra hij
  let e := min (min (a i) (1 - a i)) (min (a j) (1 - a j))
  have he : 0 < e := lt_min (lt_min hi.1 (sub_pos.mpr hi.2))
    (lt_min hj.1 (sub_pos.mpr hj.2))
  let v : Fin d → ℝ := Pi.single i e - Pi.single j e
  have hv (t) : |v t| ≤ min (a t) (1 - a t) := by
    by_cases hti : t = i
    · subst t
      simp [v, hij, abs_of_pos he, e]
    · by_cases htj : t = j
      · subst t
        simp [v, Ne.symm hij, abs_of_pos he, e]
      · simp only [v, Pi.sub_apply, Pi.single_apply, hti, htj, ite_false,
          sub_zero, abs_zero]
        exact le_min (ha.1.1 t).1 (sub_nonneg.mpr (ha.1.1 t).2)
  have hsum : ∑ t, v t = 0 := by simp [v, Finset.sum_sub_distrib]
  have hp := reciprocalExponentPolytope_perturb hv
    (show |∑ t, v t| ≤ (k : ℝ) - ∑ t, a t by rw [hsum, abs_zero]; exact sub_nonneg.mpr ha.1.2)
  have hz := congrFun (extremePoint_perturbation_eq_zero ha hp.1 hp.2) i
  have : e = 0 := by simpa [v, hij, Ne.symm hij] using hz
  exact he.ne' this

theorem reciprocalExponentPolytope_extreme_fractional_sum {d k : ℕ}
    {a : Fin d → ℝ} (ha : a ∈ (reciprocalExponentPolytope d k).extremePoints ℝ)
    {i : Fin d} (hi : 0 < a i ∧ a i < 1) : ∑ t, a t = k := by
  classical
  by_contra hne
  have hlt : ∑ t, a t < (k : ℝ) := lt_of_le_of_ne ha.1.2 hne
  let e := min (min (a i) (1 - a i)) ((k : ℝ) - ∑ t, a t)
  have he : 0 < e := lt_min (lt_min hi.1 (sub_pos.mpr hi.2)) (sub_pos.mpr hlt)
  let v : Fin d → ℝ := Pi.single i e
  have hv (t) : |v t| ≤ min (a t) (1 - a t) := by
    by_cases hti : t = i
    · subst t
      simp [v, abs_of_pos he, e]
    · simp only [v, Pi.single_apply, hti, ite_false, abs_zero]
      exact le_min (ha.1.1 t).1 (sub_nonneg.mpr (ha.1.1 t).2)
  have hs : |∑ t, v t| ≤ (k : ℝ) - ∑ t, a t := by
    simp [v, abs_of_pos he, e]
  have hp := reciprocalExponentPolytope_perturb hv hs
  have hz := congrFun (extremePoint_perturbation_eq_zero ha hp.1 hp.2) i
  have : e = 0 := by simpa [v] using hz
  exact he.ne' this

/-- Every extreme point of the reciprocal exponent polytope is Boolean. -/
theorem reciprocalExponentPolytope_extreme_boolean {d k : ℕ}
    {a : Fin d → ℝ} (ha : a ∈ (reciprocalExponentPolytope d k).extremePoints ℝ)
    (i : Fin d) : a i = 0 ∨ a i = 1 := by
  classical
  by_contra h
  push Not at h
  have hi : 0 < a i ∧ a i < 1 :=
    ⟨lt_of_le_of_ne (ha.1.1 i).1 h.1.symm, lt_of_le_of_ne (ha.1.1 i).2 h.2⟩
  have hj (j : Fin d) (hji : j ≠ i) : a j = 0 ∨ a j = 1 := by
    by_contra hn
    push Not at hn
    exact hji (reciprocalExponentPolytope_extreme_fractional_unique ha
      ⟨lt_of_le_of_ne (ha.1.1 j).1 hn.1.symm,
        lt_of_le_of_ne (ha.1.1 j).2 hn.2⟩ hi)
  let s := (Finset.univ.erase i).filter (fun j => a j = 1)
  have hs : ∑ j ∈ Finset.univ.erase i, a j = (s.card : ℝ) := by
    calc
      _ = ∑ j ∈ Finset.univ.erase i, if a j = 1 then (1 : ℝ) else 0 := by
        apply Finset.sum_congr rfl
        intro j hjmem
        rcases hj j (Finset.mem_erase.mp hjmem).1 with hjzero | hjone
        · simp [hjzero]
        · simp [hjone]
      _ = s.card := by simp [s]
  have hsum := Finset.sum_erase_add Finset.univ a (Finset.mem_univ i)
  rw [hs, reciprocalExponentPolytope_extreme_fractional_sum ha hi] at hsum
  have hlow : (s.card : ℝ) < k := by linarith
  have hupp : (k : ℝ) < (s.card : ℝ) + 1 := by linarith
  have hlow' : s.card < k := by exact_mod_cast hlow
  have hupp' : k < s.card + 1 := by exact_mod_cast hupp
  omega

/-- Boolean endpoint configurations with at most `k` occupied slots. -/
def reciprocalExponentEndpoints (d k : ℕ) : Set (Fin d → ℝ) :=
  {a | (∀ i, a i = 0 ∨ a i = 1) ∧ ∑ i, a i ≤ k}

theorem reciprocalExponentEndpoints_finite (d k : ℕ) :
    (reciprocalExponentEndpoints d k).Finite := by
  classical
  apply (Set.finite_range (fun b : Fin d → Bool => fun i => if b i then (1 : ℝ) else 0)).subset
  intro a ha
  refine ⟨fun i => decide (a i = 1), ?_⟩
  funext i
  rcases ha.1 i with hi | hi <;> simp [hi]

/-- Blueprint `lem:absolute`, line 390: the admissible reciprocal exponents
are precisely the convex hull of Boolean configurations with at most `k` ones.
In particular `d = 4`, `k = 2` gives the source interpolation polytope. -/
theorem reciprocalExponentPolytope_eq_convexHull (d k : ℕ) :
    reciprocalExponentPolytope d k = convexHull ℝ (reciprocalExponentEndpoints d k) := by
  have hsub : reciprocalExponentEndpoints d k ⊆ reciprocalExponentPolytope d k := by
    intro a ha
    refine ⟨fun i => ?_, ha.2⟩
    rcases ha.1 i with hi | hi <;> simp [hi]
  apply Set.Subset.antisymm
  · rw [← closure_convexHull_extremePoints (reciprocalExponentPolytope_compact d k)
      (reciprocalExponentPolytope_convex d k)]
    apply closure_minimal
    · apply convexHull_mono
      intro a ha
      exact ⟨reciprocalExponentPolytope_extreme_boolean ha, ha.1.2⟩
    · exact (reciprocalExponentEndpoints_finite d k).isClosed_convexHull ℝ
  · exact convexHull_min hsub (reciprocalExponentPolytope_convex d k)

/-- Product identity used by positive Hölder interpolation, valid also for
zero and infinite bases because every exponent is nonnegative. -/
theorem ennreal_product_convex_exponents {d : ℕ} (f : Fin d → ℝ≥0∞)
    {a b : Fin d → ℝ} (ha : ∀ i, 0 ≤ a i) (hb : ∀ i, 0 ≤ b i)
    {s t : ℝ} (hs : 0 ≤ s) (ht : 0 ≤ t) :
    (∏ i, f i ^ (s * a i + t * b i)) =
      (∏ i, f i ^ a i) ^ s * (∏ i, f i ^ b i) ^ t := by
  simp_rw [ENNReal.rpow_add_of_nonneg _ _ (mul_nonneg hs (ha _))
    (mul_nonneg ht (hb _)), mul_comm s, mul_comm t, ENNReal.rpow_mul]
  rw [Finset.prod_mul_distrib, ENNReal.prod_rpow_of_nonneg hs,
    ENNReal.prod_rpow_of_nonneg ht]

/-- Positive product-integral bounds form a convex set of nonnegative
exponents. This is the Hölder interpolation step of `lem:absolute`, line 392. -/
theorem positiveExponentBound_convex {X : Type*} [MeasurableSpace X]
    (μ : Measure X) {d : ℕ} (f : Fin d → X → ℝ≥0∞)
    (hf : ∀ i, AEMeasurable (f i) μ) (B : Fin d → ℝ≥0∞) (C : ℝ≥0∞) :
    Convex ℝ {a : Fin d → ℝ | (∀ i, 0 ≤ a i) ∧
      (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ≤ C * ∏ i, B i ^ a i} := by
  intro a ha b hb s t hs ht hst
  refine ⟨fun i => add_nonneg (mul_nonneg hs (ha.1 i)) (mul_nonneg ht (hb.1 i)), ?_⟩
  change (∫⁻ x, ∏ i, f i x ^ (s * a i + t * b i) ∂μ) ≤
    C * ∏ i, B i ^ (s * a i + t * b i)
  simp_rw [ennreal_product_convex_exponents _ ha.1 hb.1 hs ht]
  calc
    _ ≤ (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ^ s *
        (∫⁻ x, ∏ i, f i x ^ b i ∂μ) ^ t :=
      ENNReal.lintegral_mul_norm_pow_le
        (Finset.aemeasurable_fun_prod _ (fun i _ => (hf i).pow_const _))
        (Finset.aemeasurable_fun_prod _ (fun i _ => (hf i).pow_const _)) hs ht hst
    _ ≤ (C * ∏ i, B i ^ a i) ^ s * (C * ∏ i, B i ^ b i) ^ t :=
      mul_le_mul' (ENNReal.rpow_le_rpow ha.2 hs) (ENNReal.rpow_le_rpow hb.2 ht)
    _ = C * ((∏ i, B i ^ a i) ^ s * (∏ i, B i ^ b i) ^ t) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hs, ENNReal.mul_rpow_of_nonneg _ _ ht]
      calc
        _ = (C ^ s * C ^ t) *
            ((∏ i, B i ^ a i) ^ s * (∏ i, B i ^ b i) ^ t) := by ac_rfl
        _ = _ := by rw [← ENNReal.rpow_add_of_nonneg s t hs ht, hst, ENNReal.rpow_one]

/-- Blueprint `lem:absolute`, line 392: positive Boolean endpoint estimates
interpolate throughout the complete reciprocal-exponent polytope. The extended
nonnegative formulation includes zero and infinite integrals without division. -/
theorem positiveEndpointInterpolation {X : Type*} [MeasurableSpace X]
    (μ : Measure X) {d k : ℕ} (f : Fin d → X → ℝ≥0∞)
    (hf : ∀ i, AEMeasurable (f i) μ) (B : Fin d → ℝ≥0∞) (C : ℝ≥0∞)
    (hend : ∀ a ∈ reciprocalExponentEndpoints d k,
      (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ≤ C * ∏ i, B i ^ a i)
    {a : Fin d → ℝ} (ha : a ∈ reciprocalExponentPolytope d k) :
    (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ≤ C * ∏ i, B i ^ a i := by
  have hs : reciprocalExponentEndpoints d k ⊆
      {a : Fin d → ℝ | (∀ i, 0 ≤ a i) ∧
        (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ≤ C * ∏ i, B i ^ a i} := by
    intro a ha
    refine ⟨fun i => ?_, hend a ha⟩
    rcases ha.1 i with hi | hi <;> simp [hi]
  have hconv := convexHull_min hs (positiveExponentBound_convex μ f hf B C)
  rw [← reciprocalExponentPolytope_eq_convexHull] at hconv
  exact (hconv ha).2

/-- Scalar affine change of variables for the real endpoint estimates in
blueprint `lem:absolute`, line 388. -/
theorem real_lintegral_affine (g : ℝ → ℝ≥0∞) (hg : Measurable g)
    {a : ℝ} (ha : a ≠ 0) (b : ℝ) :
    (∫⁻ t : ℝ, g (b + a * t)) = ENNReal.ofReal |a⁻¹| * ∫⁻ u : ℝ, g u := by
  calc
    _ = ∫⁻ u : ℝ, g (b + u) ∂Measure.map (fun t : ℝ => a * t) volume :=
      (lintegral_map (hg.comp (measurable_const.add measurable_id))
        (measurable_const.mul measurable_id)).symm
    _ = _ := by
      rw [Real.map_volume_mul_left ha, lintegral_smul_measure,
        lintegral_add_left_eq_self]
      rfl

/-- The two occupied real progression slots have Jacobian `j - i`,
as used by blueprint `lem:absolute`, line 388. -/
theorem real_progression_pair_lintegral (f g : ℝ → ℝ≥0∞)
    (hf : Measurable f) (hg : Measurable g) {i j : ℝ} (hij : i ≠ j) :
    (∫⁻ z : ℝ × ℝ, f (z.1 + i * z.2) * g (z.1 + j * z.2)) =
      ENNReal.ofReal |(j - i)⁻¹| * (∫⁻ u : ℝ, f u) * ∫⁻ v : ℝ, g v := by
  have hm : Measurable (fun z : ℝ × ℝ => f (z.1 + i * z.2) * g (z.1 + j * z.2)) :=
    (hf.comp (measurable_fst.add (measurable_const.mul measurable_snd))).mul
      (hg.comp (measurable_fst.add (measurable_const.mul measurable_snd)))
  change (∫⁻ z : ℝ × ℝ, f (z.1 + i * z.2) * g (z.1 + j * z.2)
      ∂volume.prod volume) = _
  rw [lintegral_prod _ hm.aemeasurable]
  rw [lintegral_lintegral_swap hm.aemeasurable]
  have hshift (t : ℝ) :
      (∫⁻ x : ℝ, f (x + i * t) * g (x + j * t)) =
        ∫⁻ u : ℝ, f u * g (u + (j - i) * t) := by
    convert lintegral_add_right_eq_self (μ := (volume : Measure ℝ))
      (fun u : ℝ => f u * g (u + (j - i) * t)) (i * t) using 1
    congr 1
    funext x
    congr 2
    ring
  simp_rw [hshift]
  have hinner (u : ℝ) :
      (∫⁻ t : ℝ, f u * g (u + (j - i) * t)) =
        f u * (ENNReal.ofReal |(j - i)⁻¹| * ∫⁻ v : ℝ, g v) := by
    have hgu : Measurable (fun t : ℝ => g (u + (j - i) * t)) :=
      hg.comp (measurable_const.add (measurable_const.mul measurable_id))
    rw [lintegral_const_mul _ hgu,
      real_lintegral_affine g hg (sub_ne_zero.mpr hij.symm)]
  rw [lintegral_lintegral_swap]
  · simp_rw [hinner]
    rw [lintegral_mul_const _ hf]
    ac_rfl
  · exact ((hf.comp measurable_snd).mul (hg.comp
      (measurable_snd.add (measurable_const.mul measurable_fst)))).aemeasurable

/-- The four real progression coordinates in blueprint `eq:local`. -/
def realProgressionCoordinate (j : Fin 4) (z : ℝ × ℝ) : ℝ := z.1 + (j : ℝ) * z.2

theorem continuous_realProgressionCoordinate (j : Fin 4) :
    Continuous (realProgressionCoordinate j) :=
  continuous_fst.add (continuous_const.mul continuous_snd)

/-- Blueprint `eq:local`: the scale-normalized local complex form. -/
noncomputable def localProgressionForm (r : ℝ) (w : ℝ × ℝ → ℂ)
    (f : Fin 4 → ℝ → ℂ) : ℂ :=
  (r : ℂ)⁻¹ ^ 2 * ∫ z : ℝ × ℝ, w z * ∏ j, f j (realProgressionCoordinate j z)

/-- Interval support required of the kernel in blueprint `eq:local`.
The stronger interior-support and smoothness conditions imply this condition. -/
def HasLocalProgressionSupport {E : Type*} [Zero E]
    (a r : ℝ) (w : ℝ × ℝ → E) : Prop :=
  ∀ z, w z ≠ 0 → ∀ j : Fin 4, realProgressionCoordinate j z ∈ Set.Icc a (a + r)

/-- The support of a local progression kernel has a scale-sized time fiber. -/
theorem localProgressionSupport_time {E : Type*} [Zero E] {a r : ℝ}
    (hr : 0 ≤ r) {w : ℝ × ℝ → E} (hw : HasLocalProgressionSupport a r w)
    {z : ℝ × ℝ} (hz : w z ≠ 0) : z.2 ∈ Set.Icc (-r) r := by
  have hzero := hw z hz 0
  have hthree := hw z hz 3
  norm_num [realProgressionCoordinate, Set.mem_Icc] at hzero hthree
  constructor <;> linarith

/-- Normalized Lebesgue measure on a source interval, for the local `Lp` norms. -/
noncomputable def normalizedIntervalMeasure (a r : ℝ) : Measure ℝ :=
  ENNReal.ofReal r⁻¹ • volume.restrict (Set.Icc a (a + r))

theorem normalizedIntervalMeasure_probability (a : ℝ) {r : ℝ} (hr : 0 < r) :
    IsProbabilityMeasure (normalizedIntervalMeasure a r) := by
  constructor
  simp only [normalizedIntervalMeasure, Measure.smul_apply, Measure.restrict_apply_univ,
    Real.volume_Icc, add_sub_cancel_left, smul_eq_mul]
  rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hr.le), inv_mul_cancel₀ hr.ne', ENNReal.ofReal_one]

theorem realProgression_pair_jacobian_le_one {i j : Fin 4} (hij : i ≠ j) :
    ENNReal.ofReal |((j : ℝ) - (i : ℝ))⁻¹| ≤ 1 := by
  fin_cases i <;> fin_cases j <;> norm_num at *

/-- The two-`L1` endpoint in blueprint `lem:absolute`, line 388. -/
theorem localProgression_pair_endpoint {a r : ℝ} {K : ℝ × ℝ → ℝ≥0∞}
    (hK : HasLocalProgressionSupport a r K) {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f g : ℝ → ℝ≥0∞) (hf : Measurable f) (hg : Measurable g)
    {i j : Fin 4} (hij : i ≠ j) :
    (∫⁻ z : ℝ × ℝ, K z *
      (f (realProgressionCoordinate i z) * g (realProgressionCoordinate j z))) ≤
      W * (∫⁻ u in Set.Icc a (a + r), f u) * ∫⁻ v in Set.Icc a (a + r), g v := by
  let F := (Set.Icc a (a + r)).indicator f
  let G := (Set.Icc a (a + r)).indicator g
  have hF : Measurable F := hf.indicator measurableSet_Icc
  have hG : Measurable G := hg.indicator measurableSet_Icc
  have hm : Measurable (fun z : ℝ × ℝ =>
      F (realProgressionCoordinate i z) * G (realProgressionCoordinate j z)) :=
    (hF.comp (continuous_realProgressionCoordinate i).measurable).mul
      (hG.comp (continuous_realProgressionCoordinate j).measurable)
  calc
    _ ≤ ∫⁻ z : ℝ × ℝ, W *
        (F (realProgressionCoordinate i z) * G (realProgressionCoordinate j z)) := by
      apply lintegral_mono
      intro z
      by_cases hz : K z = 0
      · simp [hz]
      · simp only [F, G, Set.indicator_of_mem (hK z hz i),
          Set.indicator_of_mem (hK z hz j)]
        exact mul_le_mul_left (hW z) _
    _ = W * (ENNReal.ofReal |((j : ℝ) - (i : ℝ))⁻¹| *
        (∫⁻ u : ℝ, F u) * ∫⁻ v : ℝ, G v) := by
      rw [lintegral_const_mul _ hm]
      exact congrArg (W * ·) (real_progression_pair_lintegral F G hF hG
        (by exact_mod_cast (show i.val ≠ j.val from fun h => hij (Fin.ext h))))
    _ ≤ W * ((∫⁻ u : ℝ, F u) * ∫⁻ v : ℝ, G v) := by
      simpa only [one_mul] using mul_le_mul_right
        (mul_le_mul_left (mul_le_mul_left
          (realProgression_pair_jacobian_le_one hij) (∫⁻ u : ℝ, F u)) (∫⁻ v : ℝ, G v)) W
    _ = _ := by
      rw [show (∫⁻ u : ℝ, F u) = ∫⁻ u in Set.Icc a (a + r), f u from
        lintegral_indicator measurableSet_Icc f,
        show (∫⁻ v : ℝ, G v) = ∫⁻ v in Set.Icc a (a + r), g v from
        lintegral_indicator measurableSet_Icc g]
      exact (mul_assoc _ _ _).symm

theorem real_progression_time_cutoff_lintegral (F : ℝ → ℝ≥0∞)
    (hF : Measurable F) (r i : ℝ) :
    (∫⁻ z : ℝ × ℝ, (Set.Icc (-r) r).indicator (fun _ => (1 : ℝ≥0∞)) z.2 *
      F (z.1 + i * z.2)) = ENNReal.ofReal (2 * r) * ∫⁻ u : ℝ, F u := by
  let χ : ℝ → ℝ≥0∞ := (Set.Icc (-r) r).indicator (fun _ => 1)
  have hχ : Measurable χ := measurable_const.indicator measurableSet_Icc
  have hm : Measurable (fun z : ℝ × ℝ => χ z.2 * F (z.1 + i * z.2)) :=
    (hχ.comp measurable_snd).mul
      (hF.comp (measurable_fst.add (measurable_const.mul measurable_snd)))
  change (∫⁻ z : ℝ × ℝ, χ z.2 * F (z.1 + i * z.2) ∂volume.prod volume) = _
  rw [lintegral_prod _ hm.aemeasurable, lintegral_lintegral_swap hm.aemeasurable]
  have hinner (t : ℝ) : (∫⁻ x : ℝ, χ t * F (x + i * t)) = χ t * ∫⁻ u : ℝ, F u := by
    have hFt : Measurable (fun x : ℝ => F (x + i * t)) :=
      hF.comp (measurable_id.add measurable_const)
    rw [lintegral_const_mul _ hFt, lintegral_add_right_eq_self]
  simp_rw [hinner]
  rw [lintegral_mul_const _ hχ]
  congr 1
  simp [χ, lintegral_indicator measurableSet_Icc, Real.volume_Icc, two_mul]

/-- The one-`L1` endpoint in blueprint `lem:absolute`, line 388. -/
theorem localProgression_single_endpoint {a r : ℝ} (hr : 0 ≤ r)
    {K : ℝ × ℝ → ℝ≥0∞} (hK : HasLocalProgressionSupport a r K)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : ℝ → ℝ≥0∞) (hf : Measurable f) (i : Fin 4) :
    (∫⁻ z : ℝ × ℝ, K z * f (realProgressionCoordinate i z)) ≤
      W * ENNReal.ofReal (2 * r) * ∫⁻ u in Set.Icc a (a + r), f u := by
  let F := (Set.Icc a (a + r)).indicator f
  let χ : ℝ → ℝ≥0∞ := (Set.Icc (-r) r).indicator (fun _ => 1)
  have hF : Measurable F := hf.indicator measurableSet_Icc
  have hχ : Measurable χ := measurable_const.indicator measurableSet_Icc
  have hm : Measurable (fun z : ℝ × ℝ => χ z.2 * F (realProgressionCoordinate i z)) :=
    (hχ.comp measurable_snd).mul
      (hF.comp (continuous_realProgressionCoordinate i).measurable)
  calc
    _ ≤ ∫⁻ z : ℝ × ℝ, W * (χ z.2 * F (realProgressionCoordinate i z)) := by
      apply lintegral_mono
      intro z
      by_cases hz : K z = 0
      · simp [hz]
      · simp only [χ, F, Set.indicator_of_mem (localProgressionSupport_time hr hK hz),
          Set.indicator_of_mem (hK z hz i), one_mul]
        exact mul_le_mul_left (hW z) _
    _ = W * (ENNReal.ofReal (2 * r) * ∫⁻ u : ℝ, F u) := by
      rw [lintegral_const_mul _ hm]
      exact congrArg (W * ·) (real_progression_time_cutoff_lintegral F hF r (i : ℝ))
    _ = _ := by
      rw [show (∫⁻ u : ℝ, F u) = ∫⁻ u in Set.Icc a (a + r), f u from
        lintegral_indicator measurableSet_Icc f]
      exact (mul_assoc _ _ _).symm

/-- The all-infinity endpoint in blueprint `lem:absolute`, line 388. -/
theorem localProgression_empty_endpoint {a r : ℝ} (hr : 0 ≤ r)
    {K : ℝ × ℝ → ℝ≥0∞} (hK : HasLocalProgressionSupport a r K)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) :
    (∫⁻ z : ℝ × ℝ, K z) ≤ W * ENNReal.ofReal (2 * r) * ENNReal.ofReal r := by
  simpa using localProgression_single_endpoint hr hK hW (fun _ => 1) measurable_const 0

/-- A two-coordinate measure-preserving map supplies a positive endpoint
bound, as in the torus argument of blueprint `lem:absolute`, line 394. -/
theorem measurePreserving_pair_endpoint {X Y Z : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z]
    {μ : Measure X} {ν : Measure Y} {ρ : Measure Z} [SFinite ρ]
    {P : X → Y × Z} (hP : MeasurePreserving P μ (ν.prod ρ))
    {K : X → ℝ≥0∞} {W : ℝ≥0∞} (hW : ∀ x, K x ≤ W)
    (f : Y → ℝ≥0∞) (g : Z → ℝ≥0∞) (hf : Measurable f) (hg : Measurable g) :
    (∫⁻ x, K x * (f (P x).1 * g (P x).2) ∂μ) ≤
      W * (∫⁻ y, f y ∂ν) * ∫⁻ z, g z ∂ρ := by
  have hm : Measurable (fun z : Y × Z => f z.1 * g z.2) :=
    (hf.comp measurable_fst).mul (hg.comp measurable_snd)
  calc
    _ ≤ ∫⁻ x, W * (f (P x).1 * g (P x).2) ∂μ :=
      lintegral_mono (fun x => mul_le_mul_left (hW x) _)
    _ = W * (∫⁻ z, f z.1 * g z.2 ∂ν.prod ρ) := by
      have hmP : Measurable (fun x => f (P x).1 * g (P x).2) := hm.comp hP.measurable
      rw [lintegral_const_mul _ hmP, hP.lintegral_comp hm]
    _ = _ := by
      rw [lintegral_prod_mul hf.aemeasurable hg.aemeasurable, mul_assoc]

/-- Blueprint `lem:absolute`, torus two-slot endpoint with constant one
for a multiplier bounded by one. -/
theorem rationalTorus_pair_endpoint {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    {K : (torusAnnihilator (rationalIntegerIntersection V)) ×
      (torusAnnihilator (rationalIntegerIntersection V)) → ℝ≥0∞}
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f g : torusAnnihilator (rationalIntegerIntersection V) → ℝ≥0∞)
    (hf : Measurable f) (hg : Measurable g) {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    (∫⁻ z, K z * (f (z.1 + (i - l) • z.2) * g (z.1 + (j - l) • z.2))
      ∂(torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V))) ≤
      W * (∫⁻ u, f u ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) *
        ∫⁻ v, g v ∂torusAnnihilatorHaar (rationalIntegerIntersection V) :=
  measurePreserving_pair_endpoint
    (rationalAnnihilator_progression_measurePreserving V hij l) hW f g hf hg

theorem rationalTorus_single_endpoint {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    {K : (torusAnnihilator (rationalIntegerIntersection V)) ×
      (torusAnnihilator (rationalIntegerIntersection V)) → ℝ≥0∞}
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : torusAnnihilator (rationalIntegerIntersection V) → ℝ≥0∞)
    (hf : Measurable f) (i l : ℤ) :
    (∫⁻ z, K z * f (z.1 + (i - l) • z.2)
      ∂(torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V))) ≤
      W * ∫⁻ u, f u ∂torusAnnihilatorHaar (rationalIntegerIntersection V) := by
  simpa using rationalTorus_pair_endpoint V hW f (fun _ => 1) hf measurable_const
    (i := i) (j := i + 1) (by omega) l

theorem rationalTorus_empty_endpoint {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    {K : (torusAnnihilator (rationalIntegerIntersection V)) ×
      (torusAnnihilator (rationalIntegerIntersection V)) → ℝ≥0∞}
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) :
    (∫⁻ z, K z ∂(torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
      (torusAnnihilatorHaar (rationalIntegerIntersection V))) ≤ W := by
  simpa using rationalTorus_single_endpoint V hW (fun _ => 1) measurable_const 0 0

/-- The progression pair map is injective on torsion-free groups, the
integer-lattice endpoint argument of blueprint `lem:absolute`, line 394. -/
theorem progressionPairHom_injective {G : Type*} [AddCommGroup G] [HasUniqueDiv G]
    {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    Function.Injective (progressionPairHom G i j l) := by
  intro a b hab
  have h1 : a.1 + (i - l) • a.2 = b.1 + (i - l) • b.2 := congrArg Prod.fst hab
  have h2 : a.1 + (j - l) • a.2 = b.1 + (j - l) • b.2 := congrArg Prod.snd hab
  have hv : (j - i) • a.2 = (j - i) • b.2 := by
    calc
      _ = (a.1 + (j - l) • a.2) - (a.1 + (i - l) • a.2) := by
        simp only [sub_smul]; abel
      _ = (b.1 + (j - l) • b.2) - (b.1 + (i - l) • b.2) := by rw [h1, h2]
      _ = _ := by simp only [sub_smul]; abel
  have hv' := zsmul_right_injective (sub_ne_zero.mpr hij.symm) hv
  rw [hv'] at h1
  exact Prod.ext (add_right_cancel h1) hv'

/-- Blueprint `lem:absolute`, line 394: counting over the progression image
is bounded by the full product sum, in every integer-lattice dimension. -/
theorem integerProgression_pair_endpoint {d : ℕ}
    {K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞}
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) (f g : (Fin d → ℤ) → ℝ≥0∞)
    {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    (∑' z : (Fin d → ℤ) × (Fin d → ℤ),
      K z * (f (z.1 + (i - l) • z.2) * g (z.1 + (j - l) • z.2))) ≤
      W * (∑' u, f u) * ∑' v, g v := by
  calc
    _ ≤ ∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        W * (f (z.1 + (i - l) • z.2) * g (z.1 + (j - l) • z.2)) :=
      ENNReal.tsum_le_tsum (fun z => mul_le_mul_left (hW z) _)
    _ = W * ∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        f (z.1 + (i - l) • z.2) * g (z.1 + (j - l) • z.2) := ENNReal.tsum_mul_left
    _ ≤ W * ∑' z : (Fin d → ℤ) × (Fin d → ℤ), f z.1 * g z.2 :=
      mul_le_mul_right (ENNReal.tsum_comp_le_tsum_of_injective
        (progressionPairHom_injective hij l) (fun z => f z.1 * g z.2)) W
    _ = _ := by
      rw [ENNReal.tsum_prod' (f := fun z : (Fin d → ℤ) × (Fin d → ℤ) => f z.1 * g z.2)]
      simp_rw [ENNReal.tsum_mul_left, ENNReal.tsum_mul_right]
      exact (mul_assoc _ _ _).symm

theorem integerProgression_time_cutoff_sum {d : ℕ} (T : Finset (Fin d → ℤ))
    (f : (Fin d → ℤ) → ℝ≥0∞) (i : ℤ) :
    (∑' z : (Fin d → ℤ) × (Fin d → ℤ),
      (if z.2 ∈ T then (1 : ℝ≥0∞) else 0) * f (z.1 + i • z.2)) =
      (T.card : ℝ≥0∞) * ∑' u, f u := by
  classical
  rw [ENNReal.tsum_prod' (f := fun z : (Fin d → ℤ) × (Fin d → ℤ) =>
    (if z.2 ∈ T then (1 : ℝ≥0∞) else 0) * f (z.1 + i • z.2)), ENNReal.tsum_comm]
  have hinner (v : Fin d → ℤ) :
      (∑' u, (if v ∈ T then (1 : ℝ≥0∞) else 0) * f (u + i • v)) =
        (if v ∈ T then (1 : ℝ≥0∞) else 0) * ∑' u, f u := by
    rw [ENNReal.tsum_mul_left]
    congr 1
    exact (Equiv.addRight (i • v)).tsum_eq f
  simp_rw [hinner]
  rw [ENNReal.tsum_mul_right]
  congr 1
  rw [tsum_eq_sum (s := T) (fun v hv => ite_eq_right hv)]
  simp

/-- One occupied slot for a local lattice kernel: the time support supplies
the remaining scale factor in blueprint `lem:absolute`, line 394. -/
theorem integerProgression_single_endpoint {d : ℕ} (T : Finset (Fin d → ℤ))
    {K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞}
    (hT : ∀ z, K z ≠ 0 → z.2 ∈ T) {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : (Fin d → ℤ) → ℝ≥0∞) (i l : ℤ) :
    (∑' z : (Fin d → ℤ) × (Fin d → ℤ), K z * f (z.1 + (i - l) • z.2)) ≤
      W * T.card * ∑' u, f u := by
  classical
  calc
    _ ≤ ∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        W * ((if z.2 ∈ T then (1 : ℝ≥0∞) else 0) * f (z.1 + (i - l) • z.2)) := by
      apply ENNReal.tsum_le_tsum
      intro z
      by_cases hz : K z = 0
      · simp [hz]
      · simp only [ite_eq_left (hT z hz), one_mul]
        exact mul_le_mul_left (hW z) _
    _ = _ := by
      rw [ENNReal.tsum_mul_left, integerProgression_time_cutoff_sum, mul_assoc]

/-- The empty lattice endpoint, with explicit cardinalities of the local
space and time boxes rather than an implicit scale constant. -/
theorem integerProgression_empty_endpoint {d : ℕ} (A T : Finset (Fin d → ℤ))
    {K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞}
    (hT : ∀ z, K z ≠ 0 → z.2 ∈ T) (i l : ℤ)
    (hA : ∀ z, K z ≠ 0 → z.1 + (i - l) • z.2 ∈ A)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) :
    (∑' z : (Fin d → ℤ) × (Fin d → ℤ), K z) ≤ W * T.card * A.card := by
  classical
  have hid (z : (Fin d → ℤ) × (Fin d → ℤ)) :
      K z * (if z.1 + (i - l) • z.2 ∈ A then (1 : ℝ≥0∞) else 0) = K z := by
    by_cases hz : K z = 0
    · simp [hz]
    · simp only [ite_eq_left (hA z hz), mul_one]
  have hsum : (∑' u, if u ∈ A then (1 : ℝ≥0∞) else 0) = A.card := by
    rw [tsum_eq_sum (s := A) (fun u hu => ite_eq_right hu)]
    simp
  simpa only [hid, hsum] using integerProgression_single_endpoint T hT hW
    (fun u => if u ∈ A then 1 else 0) i l

theorem reciprocalExponentEndpoints_support {d k : ℕ} {a : Fin d → ℝ}
    (ha : a ∈ reciprocalExponentEndpoints d k) :
    ∃ S : Finset (Fin d), S.card ≤ k ∧ ∀ i, a i = if i ∈ S then 1 else 0 := by
  classical
  let S := Finset.univ.filter (fun i => a i = 1)
  have he (i) : a i = if i ∈ S then 1 else 0 := by
    rcases ha.1 i with hi | hi <;> simp [S, hi]
  refine ⟨S, ?_, he⟩
  have hsum : ∑ i, a i = (S.card : ℝ) := by simp_rw [he]; simp
  have hbound := ha.2
  rw [hsum] at hbound
  exact_mod_cast hbound

/-- Abstract positive rank-two estimate obtained from the empty, singleton
and pair endpoints. This assembles the interpolation argument in `lem:absolute`. -/
theorem positivePairwise_power_bound {X Y : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] (μ : Measure X) (ν : Measure Y)
    {d : ℕ} (P : Fin d → X → Y) (hP : ∀ i, Measurable (P i))
    (C : ℝ≥0∞) (hempty : μ Set.univ ≤ C)
    (hsingle : ∀ i (f : Y → ℝ≥0∞), Measurable f →
      (∫⁻ x, f (P i x) ∂μ) ≤ C * ∫⁻ y, f y ∂ν)
    (hpair : ∀ i j, i ≠ j → ∀ (f g : Y → ℝ≥0∞), Measurable f → Measurable g →
      (∫⁻ x, f (P i x) * g (P j x) ∂μ) ≤ C * (∫⁻ y, f y ∂ν) * ∫⁻ y, g y ∂ν)
    (f : Fin d → Y → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    {a : Fin d → ℝ} (ha : a ∈ reciprocalExponentPolytope d 2) :
    (∫⁻ x, ∏ i, f i (P i x) ^ a i ∂μ) ≤ C * ∏ i, (∫⁻ y, f i y ∂ν) ^ a i := by
  apply positiveEndpointInterpolation μ (fun i x => f i (P i x))
    (fun i => ((hf i).comp (hP i)).aemeasurable) (fun i => ∫⁻ y, f i y ∂ν) C ?_ ha
  intro b hb
  obtain ⟨S, hS, he⟩ := reciprocalExponentEndpoints_support hb
  have hprod (v : Fin d → ℝ≥0∞) : (∏ i, v i ^ b i) = ∏ i ∈ S, v i := by
    simp_rw [he]
    simp only [apply_ite, ENNReal.rpow_one, ENNReal.rpow_zero, Finset.prod_ite_mem_eq]
  simp_rw [hprod]
  by_cases hzero : S.card = 0
  · have : S = ∅ := Finset.card_eq_zero.mp hzero
    simpa [this] using hempty
  by_cases hone : S.card = 1
  · obtain ⟨i, hi⟩ := Finset.card_eq_one.mp hone
    simpa [hi] using hsingle i (f i) (hf i)
  · obtain ⟨i, j, hij, hs⟩ := Finset.card_eq_two.mp (show S.card = 2 by omega)
    simpa [hs, hij, mul_assoc] using hpair i j hij (f i) (f j) (hf i) (hf j)

theorem quasiMeasurePreserving_of_positive_bound {X Y : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] {μ : Measure X} {ν : Measure Y}
    {P : X → Y} (hP : Measurable P) (C : ℝ≥0∞)
    (hbound : ∀ f : Y → ℝ≥0∞, Measurable f →
      (∫⁻ x, f (P x) ∂μ) ≤ C * ∫⁻ y, f y ∂ν) :
    QuasiMeasurePreserving P μ ν := by
  refine ⟨hP, Measure.absolutelyContinuous_of_le_smul (c := C) ?_⟩
  apply Measure.le_iff.mpr
  intro s hs
  have hm : Measurable (s.indicator (fun _ : Y => (1 : ℝ≥0∞))) :=
    measurable_const.indicator hs
  have h := hbound _ hm
  rw [← lintegral_map hm hP] at h
  simpa only [lintegral_indicator hs, lintegral_one, Measure.restrict_apply_univ,
    Measure.smul_apply, smul_eq_mul] using h

/-- The finite moment used for positive interpolation; an infinity slot
contributes the constant one and is bounded by its essential supremum. -/
noncomputable def interpolationMoment (p : ℝ≥0∞) (f : Y → ℝ≥0∞) : Y → ℝ≥0∞ :=
  fun y => if p = ∞ then 1 else f y ^ p.toReal

noncomputable def interpolationInfinityFactor [MeasurableSpace Y]
    (ν : Measure Y) (p : ℝ≥0∞) (f : Y → ℝ≥0∞) : ℝ≥0∞ :=
  if p = ∞ then eLpNorm f ∞ ν else 1

theorem measurable_interpolationMoment [MeasurableSpace Y] {f : Y → ℝ≥0∞}
    (hf : Measurable f) (p : ℝ≥0∞) : Measurable (interpolationMoment p f) := by
  classical
  change Measurable (fun y => if p = ∞ then (1 : ℝ≥0∞) else f y ^ p.toReal)
  by_cases hp : p = ∞
  · simp only [hp, ite_true]
    exact measurable_const
  · simpa only [ite_eq_right hp] using hf.pow_const p.toReal

theorem interpolationMoment_ae_bound [MeasurableSpace Y] (ν : Measure Y)
    (f : Y → ℝ≥0∞) {p : ℝ≥0∞} (hp : 1 ≤ p) :
    ∀ᵐ y ∂ν, f y ≤ interpolationInfinityFactor ν p f *
      interpolationMoment p f y ^ p.toReal⁻¹ := by
  classical
  by_cases htop : p = ∞
  · subst p
    simpa [interpolationMoment, interpolationInfinityFactor] using
      (enorm_ae_le_eLpNormEssSup f ν).mono (fun y hy =>
        hy.trans (eLpNormEssSup_le_eLpNorm_top))
  · have hpzero : p ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
    have hreal : p.toReal ≠ 0 := (ENNReal.toReal_pos hpzero htop).ne'
    exact Filter.Eventually.of_forall (fun y => by
      simp [interpolationMoment, interpolationInfinityFactor, htop,
        ← ENNReal.rpow_mul, mul_inv_cancel₀ hreal])

theorem interpolationMoment_norm_identity [MeasurableSpace Y] (ν : Measure Y)
    {f : Y → ℝ≥0∞} (hf : Measurable f) {p : ℝ≥0∞} (hp : 1 ≤ p) :
    interpolationInfinityFactor ν p f *
      (∫⁻ y, interpolationMoment p f y ∂ν) ^ p.toReal⁻¹ = eLpNorm f p ν := by
  classical
  by_cases htop : p = ∞
  · simp [interpolationMoment, interpolationInfinityFactor, htop]
  · have hpzero : p ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hpzero htop hf.aestronglyMeasurable]
    simp [interpolationMoment, interpolationInfinityFactor, htop, one_div]

/-- The full `Lp` version of positive rank-two interpolation, including
infinity exponents and zero or infinite norms, used in blueprint `eq:absolute`. -/
theorem positivePairwise_eLpNorm_bound {X Y : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] (μ : Measure X) (ν : Measure Y)
    {d : ℕ} (P : Fin d → X → Y) (hP : ∀ i, Measurable (P i))
    (C : ℝ≥0∞) (hempty : μ Set.univ ≤ C)
    (hsingle : ∀ i (f : Y → ℝ≥0∞), Measurable f →
      (∫⁻ x, f (P i x) ∂μ) ≤ C * ∫⁻ y, f y ∂ν)
    (hpair : ∀ i j, i ≠ j → ∀ (f g : Y → ℝ≥0∞), Measurable f → Measurable g →
      (∫⁻ x, f (P i x) * g (P j x) ∂μ) ≤ C * (∫⁻ y, f y ∂ν) * ∫⁻ y, g y ∂ν)
    (f : Fin d → Y → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    (p : Fin d → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    (∫⁻ x, ∏ i, f i (P i x) ∂μ) ≤ C * ∏ i, eLpNorm (f i) (p i) ν := by
  classical
  let g := fun i => interpolationMoment (p i) (f i)
  let B := fun i => interpolationInfinityFactor ν (p i) (f i)
  have hg (i) : Measurable (g i) := measurable_interpolationMoment (hf i) (p i)
  have ha : (fun i => (p i).toReal⁻¹) ∈ reciprocalExponentPolytope d 2 := by
    refine ⟨fun i => ⟨inv_nonneg.mpr ENNReal.toReal_nonneg, ?_⟩, ?_⟩
    · by_cases htop : p i = ∞
      · simp [htop]
      · have hreal : 1 ≤ (p i).toReal := by
          simpa using ENNReal.toReal_mono htop (hp i)
        exact (inv_le_one₀ (lt_of_lt_of_le zero_lt_one hreal)).mpr hreal
    · exact_mod_cast hsum
  have hpoint : ∀ᵐ x ∂μ, ∀ i, f i (P i x) ≤ B i * g i (P i x) ^ (p i).toReal⁻¹ := by
    rw [ae_all_iff]
    intro i
    exact (quasiMeasurePreserving_of_positive_bound (hP i) C (hsingle i)).ae
      (interpolationMoment_ae_bound ν (f i) (hp i))
  have hgm : Measurable (fun x => ∏ i, g i (P i x) ^ (p i).toReal⁻¹) :=
    Finset.measurable_fun_prod _ (fun i _ => ((hg i).comp (hP i)).pow_const _)
  calc
    _ ≤ ∫⁻ x, ∏ i, B i * g i (P i x) ^ (p i).toReal⁻¹ ∂μ :=
      lintegral_mono_ae (hpoint.mono (fun x hx => Finset.prod_le_prod (fun i _ => hx i)))
    _ = (∏ i, B i) * ∫⁻ x, ∏ i, g i (P i x) ^ (p i).toReal⁻¹ ∂μ := by
      simp_rw [Finset.prod_mul_distrib]
      exact lintegral_const_mul _ hgm
    _ ≤ (∏ i, B i) * (C * ∏ i, (∫⁻ y, g i y ∂ν) ^ (p i).toReal⁻¹) :=
      mul_le_mul_right (positivePairwise_power_bound μ ν P hP C hempty hsingle hpair g hg ha) _
    _ = C * ∏ i, B i * (∫⁻ y, g i y ∂ν) ^ (p i).toReal⁻¹ := by
      rw [Finset.prod_mul_distrib]
      ac_rfl
    _ = _ := by
      congr 1
      apply Finset.prod_congr rfl
      intro i _
      exact interpolationMoment_norm_identity ν (hf i) (hp i)

/-- Weighted version of the positive rank-two estimate. The three hypotheses
are precisely the endpoint integrals proved in the three source settings. -/
theorem positiveWeightedPairwise_eLpNorm_bound {X Y : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] (μ : Measure X) (ν : Measure Y)
    {d : ℕ} (P : Fin d → X → Y) (hP : ∀ i, Measurable (P i))
    (K : X → ℝ≥0∞) (hK : Measurable K) (C : ℝ≥0∞)
    (hempty : (∫⁻ x, K x ∂μ) ≤ C)
    (hsingle : ∀ i (f : Y → ℝ≥0∞), Measurable f →
      (∫⁻ x, K x * f (P i x) ∂μ) ≤ C * ∫⁻ y, f y ∂ν)
    (hpair : ∀ i j, i ≠ j → ∀ (f g : Y → ℝ≥0∞), Measurable f → Measurable g →
      (∫⁻ x, K x * (f (P i x) * g (P j x)) ∂μ) ≤
        C * (∫⁻ y, f y ∂ν) * ∫⁻ y, g y ∂ν)
    (f : Fin d → Y → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    (p : Fin d → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    (∫⁻ x, K x * ∏ i, f i (P i x) ∂μ) ≤ C * ∏ i, eLpNorm (f i) (p i) ν := by
  have hwd (g : X → ℝ≥0∞) (hg : Measurable g) :
      (∫⁻ x, g x ∂μ.withDensity K) = ∫⁻ x, K x * g x ∂μ :=
    lintegral_withDensity_eq_lintegral_mul μ hK hg
  rw [← hwd (fun x => ∏ i, f i (P i x))
    (Finset.measurable_fun_prod _ (fun i _ => (hf i).comp (hP i)))]
  apply positivePairwise_eLpNorm_bound (μ.withDensity K) ν P hP C ?_ ?_ ?_ f hf p hp hsum
  · simpa only [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
      using hempty
  · intro i g hg
    rw [hwd (fun x => g (P i x)) (hg.comp (hP i))]
    exact hsingle i g hg
  · intro i j hij g h hg hh
    rw [hwd (fun x => g (P i x) * h (P j x)) ((hg.comp (hP i)).mul (hh.comp (hP j)))]
    exact hpair i j hij g h hg hh

/-- Blueprint `eq:absolute` on every rational connected subtorus, with the
exact multiplier constant and all exponents in `[1, ∞]`. -/
theorem rationalTorus_absoluteBound {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    (K : (torusAnnihilator (rationalIntegerIntersection V)) ×
      (torusAnnihilator (rationalIntegerIntersection V)) → ℝ≥0∞)
    (hK : Measurable K) {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) (l : ℤ)
    (f : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℝ≥0∞)
    (hf : ∀ i, Measurable (f i)) (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    (∫⁻ z, K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2)
      ∂(torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V))) ≤
      W * ∏ i, eLpNorm (f i) (p i) (torusAnnihilatorHaar (rationalIntegerIntersection V)) := by
  apply positiveWeightedPairwise_eLpNorm_bound _ _
    (fun i z => z.1 + ((i : ℤ) - l) • z.2) ?_ K hK W
    (rationalTorus_empty_endpoint V hW) ?_ ?_ f hf p hp hsum
  · intro i
    exact (continuous_fst.add (continuous_snd.zsmul ((i : ℤ) - l))).measurable
  · intro i g hg
    exact rationalTorus_single_endpoint V hW g hg (i : ℤ) l
  · intro i j hij g h hg hh
    exact rationalTorus_pair_endpoint V hW g h hg hh
      (by exact_mod_cast (show i.val ≠ j.val from fun h => hij (Fin.ext h))) l

/-- Blueprint `eq:absolute` on the real line: the normalized positive local
form is bounded for every exponent in `[1, ∞]` with reciprocal sum at most two.
Only boundedness and interval support of the kernel are needed. -/
theorem localProgression_absoluteBound {a r : ℝ} (hr : 0 < r)
    (K : ℝ × ℝ → ℝ≥0∞) (hK : Measurable K)
    (hsupport : HasLocalProgressionSupport a r K)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : Fin 4 → ℝ → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ENNReal.ofReal r⁻¹ ^ 2 *
      (∫⁻ z : ℝ × ℝ, K z * ∏ i, f i (realProgressionCoordinate i z)) ≤
      (2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) := by
  let R := ENNReal.ofReal r⁻¹
  have hcancel : R * ENNReal.ofReal r = 1 := by
    rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hr.le), inv_mul_cancel₀ hr.ne',
      ENNReal.ofReal_one]
  have htwo : ENNReal.ofReal (2 * r) = 2 * ENNReal.ofReal r := by
    rw [ENNReal.ofReal_mul (by norm_num)]
    norm_num
  have hnorm (g : ℝ → ℝ≥0∞) :
      (∫⁻ u, g u ∂normalizedIntervalMeasure a r) = R * ∫⁻ u in Set.Icc a (a + r), g u := by
    rw [normalizedIntervalMeasure, lintegral_smul_measure]
    rfl
  have hWtwo : W ≤ 2 * W := by
    simpa only [one_mul] using mul_le_mul_left (show (1 : ℝ≥0∞) ≤ 2 by norm_num) W
  suffices (∫⁻ z, K z * ∏ i, f i (realProgressionCoordinate i z)
      ∂(R ^ 2 • (volume : Measure (ℝ × ℝ)))) ≤
      (2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) by
    simpa only [lintegral_smul_measure, smul_eq_mul] using this
  apply positiveWeightedPairwise_eLpNorm_bound _ _ realProgressionCoordinate
    (fun i => (continuous_realProgressionCoordinate i).measurable) K hK (2 * W)
    ?_ ?_ ?_ f hf p hp hsum
  · rw [lintegral_smul_measure]
    change R ^ 2 * (∫⁻ z : ℝ × ℝ, K z) ≤ 2 * W
    calc
      _ ≤ R ^ 2 * (W * ENNReal.ofReal (2 * r) * ENNReal.ofReal r) :=
        mul_le_mul_right (localProgression_empty_endpoint hr.le hsupport hW) _
      _ = (2 * W) * (R * ENNReal.ofReal r) ^ 2 := by rw [htwo]; ring
      _ = 2 * W := by rw [hcancel]; simp
  · intro i g hg
    rw [lintegral_smul_measure, hnorm]
    change R ^ 2 * (∫⁻ z : ℝ × ℝ, K z * g (realProgressionCoordinate i z)) ≤ _
    calc
      _ ≤ R ^ 2 * (W * ENNReal.ofReal (2 * r) * ∫⁻ u in Set.Icc a (a + r), g u) :=
        mul_le_mul_right (localProgression_single_endpoint hr.le hsupport hW g hg i) _
      _ = (2 * W) * (R * ∫⁻ u in Set.Icc a (a + r), g u) *
          (R * ENNReal.ofReal r) := by rw [htwo]; ring
      _ = _ := by rw [hcancel, mul_one]
  · intro i j hij g h hg hh
    rw [lintegral_smul_measure, hnorm, hnorm]
    change R ^ 2 * (∫⁻ z : ℝ × ℝ, K z *
      (g (realProgressionCoordinate i z) * h (realProgressionCoordinate j z))) ≤ _
    calc
      _ ≤ R ^ 2 * (W * (∫⁻ u in Set.Icc a (a + r), g u) *
          ∫⁻ u in Set.Icc a (a + r), h u) :=
        mul_le_mul_right (localProgression_pair_endpoint hsupport hW g h hg hh hij) _
      _ = W * (R * ∫⁻ u in Set.Icc a (a + r), g u) *
          (R * ∫⁻ u in Set.Icc a (a + r), h u) := by ring
      _ ≤ _ := mul_le_mul_left (mul_le_mul_left hWtwo _) _

/-- Normalized counting measure at a positive lattice scale. -/
noncomputable def normalizedLatticeMeasure (d : ℕ) (N : ℝ) : Measure (Fin d → ℤ) :=
  ENNReal.ofReal N⁻¹ • Measure.count

/-- The scale-normalized lattice progression estimate, with explicit bounds
on the cardinalities of its space and time support boxes. -/
theorem integerProgression_absoluteBound_global {d : ℕ} {N : ℝ} (hN : 0 < N)
    (A T : Finset (Fin d → ℤ)) {B : ℝ≥0∞} (hB : 1 ≤ B)
    (hAcard : (A.card : ℝ≥0∞) ≤ B * ENNReal.ofReal N)
    (hTcard : (T.card : ℝ≥0∞) ≤ B * ENNReal.ofReal N)
    (K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞)
    (hT : ∀ z, K z ≠ 0 → z.2 ∈ T) (l : ℤ)
    (hA : ∀ z, K z ≠ 0 → z.1 + (0 - l) • z.2 ∈ A)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : Fin 4 → (Fin d → ℤ) → ℝ≥0∞) (p : Fin 4 → ℝ≥0∞)
    (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ENNReal.ofReal N⁻¹ ^ 2 *
      (∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2)) ≤
      (B ^ 2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedLatticeMeasure d N) := by
  let R := ENNReal.ofReal N⁻¹
  let Q := ENNReal.ofReal N
  have hcancel : R * Q = 1 := by
    rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hN.le), inv_mul_cancel₀ hN.ne',
      ENNReal.ofReal_one]
  have hAc : (A.card : ℝ≥0∞) ≤ B * Q := hAcard
  have hTc : (T.card : ℝ≥0∞) ≤ B * Q := hTcard
  have hBsquare : B ≤ B ^ 2 := by
    simpa only [one_mul, pow_two] using mul_le_mul_left hB B
  have hWb : W ≤ B ^ 2 * W := by
    simpa only [one_mul] using mul_le_mul_left (hB.trans hBsquare) W
  have hnorm (g : (Fin d → ℤ) → ℝ≥0∞) :
      (∫⁻ u, g u ∂normalizedLatticeMeasure d N) = R * ∑' u, g u := by
    rw [normalizedLatticeMeasure, lintegral_smul_measure, lintegral_count]
    rfl
  suffices (∫⁻ z, K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2)
      ∂(R ^ 2 • (Measure.count : Measure ((Fin d → ℤ) × (Fin d → ℤ))))) ≤
      (B ^ 2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedLatticeMeasure d N) by
    simpa only [lintegral_smul_measure, smul_eq_mul, lintegral_count] using this
  apply positiveWeightedPairwise_eLpNorm_bound _ _
    (fun i z => z.1 + ((i : ℤ) - l) • z.2) (fun _ => measurable_of_countable _)
    K (measurable_of_countable _) (B ^ 2 * W) ?_ ?_ ?_ f
    (fun _ => measurable_of_countable _) p hp hsum
  · rw [lintegral_smul_measure, lintegral_count]
    change R ^ 2 * (∑' z, K z) ≤ B ^ 2 * W
    calc
      _ ≤ R ^ 2 * (W * T.card * A.card) :=
        mul_le_mul_right (integerProgression_empty_endpoint A T hT 0 l hA hW) _
      _ ≤ R ^ 2 * (W * (B * Q) * (B * Q)) := by gcongr
      _ = (B ^ 2 * W) * (R * Q) ^ 2 := by ring
      _ = B ^ 2 * W := by rw [hcancel]; simp
  · intro i g hg
    rw [lintegral_smul_measure, lintegral_count, hnorm]
    change R ^ 2 * (∑' z, K z * g (z.1 + ((i : ℤ) - l) • z.2)) ≤
      (B ^ 2 * W) * (R * ∑' u, g u)
    calc
      _ ≤ R ^ 2 * (W * T.card * ∑' u, g u) :=
        mul_le_mul_right (integerProgression_single_endpoint T hT hW g (i : ℤ) l) _
      _ ≤ R ^ 2 * (W * (B * Q) * ∑' u, g u) := by gcongr
      _ = (B * W) * (R * ∑' u, g u) * (R * Q) := by ring
      _ = (B * W) * (R * ∑' u, g u) := by rw [hcancel, mul_one]
      _ ≤ _ := mul_le_mul_left (mul_le_mul_left hBsquare W) _
  · intro i j hij g h hg hh
    rw [lintegral_smul_measure, lintegral_count, hnorm, hnorm]
    change R ^ 2 * (∑' z, K z *
      (g (z.1 + ((i : ℤ) - l) • z.2) * h (z.1 + ((j : ℤ) - l) • z.2))) ≤ _
    calc
      _ ≤ R ^ 2 * (W * (∑' u, g u) * ∑' v, h v) :=
        mul_le_mul_right (integerProgression_pair_endpoint hW g h
          (by exact_mod_cast (show i.val ≠ j.val from fun h => hij (Fin.ext h))) l) _
      _ = W * (R * ∑' u, g u) * (R * ∑' v, h v) := by ring
      _ ≤ _ := mul_le_mul_left (mul_le_mul_left hWb _) _

/-- Blueprint `eq:absolute` for the actual complex local kernel and inputs.
The nonnegative integral gives the intended interpretation even for infinite norms. -/
theorem localProgression_absoluteNormBound {a r : ℝ} (hr : 0 < r)
    (w : ℝ × ℝ → ℂ) (hw : Measurable w) (hsupport : HasLocalProgressionSupport a r w)
    {W : ℝ≥0∞} (hW : ∀ z, ‖w z‖ₑ ≤ W)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ENNReal.ofReal r⁻¹ ^ 2 *
      (∫⁻ z : ℝ × ℝ, ‖w z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ) ≤
      (2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) := by
  have hs : HasLocalProgressionSupport a r (fun z => ‖w z‖ₑ) := by
    intro z hz
    exact hsupport z (fun h => hz (by simp [h]))
  have h := localProgression_absoluteBound hr (fun z => ‖w z‖ₑ) hw.enorm hs hW
    (fun i x => ‖f i x‖ₑ) (fun i => (hf i).enorm) p hp hsum
  have hn (i) : eLpNorm (fun x => ‖f i x‖ₑ) (p i) (normalizedIntervalMeasure a r) =
      eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) :=
    eLpNorm_enorm (f i) (hf i).aestronglyMeasurable
  simpa only [hn] using h

/-- Blueprint `eq:absolute` for local integer-lattice progressions, with
normalized local `Lp` norms and the explicit fixed-box constant `B² W`. -/
theorem integerProgression_absoluteBound {d : ℕ} {N : ℝ} (hN : 0 < N)
    (A T : Finset (Fin d → ℤ)) {B : ℝ≥0∞} (hB : 1 ≤ B)
    (hAcard : (A.card : ℝ≥0∞) ≤ B * ENNReal.ofReal N)
    (hTcard : (T.card : ℝ≥0∞) ≤ B * ENNReal.ofReal N)
    (K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞)
    (hT : ∀ z, K z ≠ 0 → z.2 ∈ T) (l : ℤ)
    (hA : ∀ z, K z ≠ 0 → ∀ i : Fin 4, z.1 + ((i : ℤ) - l) • z.2 ∈ A)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : Fin 4 → (Fin d → ℤ) → ℝ≥0∞) (p : Fin 4 → ℝ≥0∞)
    (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ENNReal.ofReal N⁻¹ ^ 2 *
      (∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2)) ≤
      (B ^ 2 * W) * ∏ i, eLpNorm (f i) (p i)
        ((normalizedLatticeMeasure d N).restrict (A : Set (Fin d → ℤ))) := by
  classical
  let F := fun i => (A : Set (Fin d → ℤ)).indicator (f i)
  have hid (z : (Fin d → ℤ) × (Fin d → ℤ)) :
      K z * ∏ i, F i (z.1 + ((i : ℤ) - l) • z.2) =
        K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2) := by
    by_cases hz : K z = 0
    · simp [hz]
    · congr 1
      apply Finset.prod_congr rfl
      intro i _
      exact Set.indicator_of_mem (hA z hz i) (f i)
  have hn (i) : eLpNorm (F i) (p i) (normalizedLatticeMeasure d N) =
      eLpNorm (f i) (p i)
        ((normalizedLatticeMeasure d N).restrict (A : Set (Fin d → ℤ))) :=
    eLpNorm_indicator_eq_eLpNorm_restrict A.measurableSet.nullMeasurableSet
  have h := integerProgression_absoluteBound_global hN A T hB hAcard hTcard K hT l
    (fun z hz => by simpa only [Fin.val_zero, Nat.cast_zero] using hA z hz 0) hW F p hp hsum
  simpa only [hid, hn] using h

/-- The complex local form is controlled by the positive local estimate.
This is the form of `lem:absolute` used in `lem:finite-CN`. -/
theorem localProgressionForm_enorm_le {a r : ℝ} (hr : 0 < r)
    (w : ℝ × ℝ → ℂ) (hw : Measurable w) (hsupport : HasLocalProgressionSupport a r w)
    {W : ℝ≥0∞} (hW : ∀ z, ‖w z‖ₑ ≤ W)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ‖localProgressionForm r w f‖ₑ ≤
      (2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) := by
  have hc : ‖(r : ℂ)⁻¹ ^ 2‖ₑ = ENNReal.ofReal r⁻¹ ^ 2 := by
    simp only [← ofReal_norm, norm_pow, norm_inv, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hr]
    exact ENNReal.ofReal_pow (inv_nonneg.mpr hr.le) 2
  have hn (z : ℝ × ℝ) : ‖w z * ∏ i, f i (realProgressionCoordinate i z)‖ₑ =
      ‖w z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ := by
    simp only [← ofReal_norm, norm_mul, norm_prod,
      ENNReal.ofReal_mul (norm_nonneg _),
      ENNReal.ofReal_prod_of_nonneg (fun _ _ => norm_nonneg _)]
  rw [localProgressionForm, enorm_mul, hc]
  calc
    _ ≤ ENNReal.ofReal r⁻¹ ^ 2 *
        ∫⁻ z : ℝ × ℝ, ‖w z * ∏ i, f i (realProgressionCoordinate i z)‖ₑ :=
      mul_le_mul_right (enorm_integral_le_lintegral_enorm _) _
    _ = ENNReal.ofReal r⁻¹ ^ 2 *
        ∫⁻ z : ℝ × ℝ, ‖w z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ := by
      simp_rw [hn]
    _ ≤ _ := localProgression_absoluteNormBound hr w hw hsupport hW f hf p hp hsum

/-- The uncentered Hardy–Littlewood maximal operator specified at blueprint
line 67, using nondegenerate intervals containing the evaluation point. -/
noncomputable def uncenteredRealMaximal {E : Type*} [NormedAddCommGroup E]
    (f : ℝ → E) (x : ℝ) : ℝ≥0∞ :=
  ⨆ (a : ℝ) (b : ℝ) (_ : a < b) (_ : x ∈ Set.Icc a b),
    (ENNReal.ofReal (b - a))⁻¹ * ∫⁻ y in Set.Icc a b, ‖f y‖ₑ

theorem real_intervalAverage_le_two_centered {E : Type*} [NormedAddCommGroup E]
    (f : ℝ → E) {a b x : ℝ} (hab : a < b) (hx : x ∈ Set.Icc a b) :
    (ENNReal.ofReal (b - a))⁻¹ * (∫⁻ y in Set.Icc a b, ‖f y‖ₑ) ≤
      2 * hlMaximal volume f x := by
  have hr : 0 < b - a := sub_pos.mpr hab
  have hsub : Set.Icc a b ⊆ Metric.closedBall x (b - a) := by
    intro y hy
    rw [Metric.mem_closedBall, Real.dist_eq]
    exact abs_le.mpr ⟨by linarith [hy.1, hx.2], by linarith [hy.2, hx.1]⟩
  have hcoeff : (ENNReal.ofReal (b - a))⁻¹ =
      2 * (ENNReal.ofReal (2 * (b - a)))⁻¹ := by
    calc
      _ = ENNReal.ofReal (b - a)⁻¹ := (ENNReal.ofReal_inv_of_pos hr).symm
      _ = ENNReal.ofReal (2 * (2 * (b - a))⁻¹) := by
        congr 1
        field_simp
      _ = _ := by
        rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_inv_of_pos (by positivity)]
        norm_num
  calc
    _ ≤ (ENNReal.ofReal (b - a))⁻¹ *
        ∫⁻ y in Metric.closedBall x (b - a), ‖f y‖ₑ :=
      mul_le_mul_right (lintegral_mono_set hsub) _
    _ = 2 * hlBallAverage volume f x (b - a) := by
      rw [hcoeff, hlBallAverage, Real.volume_closedBall, mul_assoc]
    _ ≤ _ := mul_le_mul_right (hlBallAverage_le_hlMaximal volume f x (b - a)) 2

/-- The uncentered maximal operator is at most twice the centered one. -/
theorem uncenteredRealMaximal_le_two_centered {E : Type*} [NormedAddCommGroup E]
    (f : ℝ → E) (x : ℝ) : uncenteredRealMaximal f x ≤ 2 * hlMaximal volume f x := by
  refine iSup_le (fun a => iSup_le (fun b => iSup_le (fun hab => iSup_le (fun hx => ?_))))
  exact real_intervalAverage_le_two_centered f hab hx

theorem mixedENorm_const_mul {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (μ : Measure X) (ν : Measure Ω) {p s : ℝ} (hp : 0 < p) (hs : 0 < s)
    (c : ℝ≥0∞) (hc : c ≠ ∞) (f : X × Ω → ℝ≥0∞) :
    mixedENorm μ ν p s (fun z => c * f z) = c * mixedENorm μ ν p s f := by
  have hcs : c ^ s ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg hs.le hc
  have hcsp : c ^ (s * (p / s)) ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (mul_nonneg hs.le (div_nonneg hp.le hs.le)) hc
  simp_rw [mixedENorm, ENNReal.mul_rpow_of_nonneg _ _ hs.le,
    lintegral_const_mul' _ _ hcs,
    ENNReal.mul_rpow_of_nonneg _ _ (div_nonneg hp.le hs.le), ← ENNReal.rpow_mul,
    lintegral_const_mul' _ _ hcsp,
    ENNReal.mul_rpow_of_nonneg _ _ (one_div_nonneg.mpr hp.le), ← ENNReal.rpow_mul]
  rw [show s * (p / s) * (1 / p) = 1 by field_simp, ENNReal.rpow_one]

/-- The blueprint's powered uncentered maximal function, with the convention
specified at source line 67 and used in `lem:vector-maximal` and `eq:CN`. -/
noncomputable def maximalQ {Ω : Type*} (q : ℝ) (f : ℝ × Ω → ℂ)
    (z : ℝ × Ω) : ℝ≥0∞ :=
  uncenteredRealMaximal (fun y => ‖f (y, z.2)‖ ^ q) z.1 ^ (1 / q)

theorem maximalQ_le_centered {Ω : Type*} {q : ℝ} (hq : 0 < q)
    (f : ℝ × Ω → ℂ) (z : ℝ × Ω) :
    maximalQ q f z ≤ (2 : ℝ≥0∞) ^ (1 / q) * centeredMaximalQ q f z := by
  change uncenteredRealMaximal (fun y => ‖f (y, z.2)‖ ^ q) z.1 ^ (1 / q) ≤
    (2 : ℝ≥0∞) ^ (1 / q) *
      hlMaximal volume (fun y => ‖f (y, z.2)‖ ^ q) z.1 ^ (1 / q)
  exact (ENNReal.rpow_le_rpow (uncenteredRealMaximal_le_two_centered _ _)
    (one_div_nonneg.mpr hq.le)).trans_eq
      (ENNReal.mul_rpow_of_nonneg _ _ (one_div_nonneg.mpr hq.le))

/-- Blueprint `lem:vector-maximal`, lines 240–251: the source's uncentered
`M_q` is bounded on `L^p(ℝ; L^4(Ω))`, uniformly over all finite inner measure spaces. -/
theorem oneMixedNorm (p q : ℝ) (hq2 : 2 < q) (hq3 : q < 3) (hpq : q < p) :
    ∃ C : NNReal, ∀ {Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω) [IsFiniteMeasure ν]
      (f : ℝ × Ω → ℂ), Measurable f →
        mixedENorm volume ν p 4 (maximalQ q f) ≤
          C * mixedENorm volume ν p 4 (fun z => ‖f z‖ₑ) := by
  have hq : 0 < q := by linarith
  have hp : 0 < p := hq.trans hpq
  obtain ⟨C, hC⟩ := centeredOneMixedNorm p q hq2 hq3 hpq
  let D : ℝ≥0∞ := 2 ^ (1 / q)
  have hD : D ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by positivity) (by norm_num)
  refine ⟨D.toNNReal * C, ?_⟩
  intro Ω _ ν _ f hf
  rw [ENNReal.coe_mul, ENNReal.coe_toNNReal hD]
  calc
    _ ≤ mixedENorm volume ν p 4 (fun z => D * centeredMaximalQ q f z) :=
      mixedENorm_mono volume ν hp (by norm_num) (fun z => maximalQ_le_centered hq f z)
    _ = D * mixedENorm volume ν p 4 (centeredMaximalQ q f) :=
      mixedENorm_const_mul volume ν hp (by norm_num) D hD _
    _ ≤ D * (C * mixedENorm volume ν p 4 (fun z => ‖f z‖ₑ)) :=
      mul_le_mul_right (hC ν f hf) D
    _ = _ := (mul_assoc _ _ _).symm

/-- Fixed constants defining the admissible kernel class, blueprint line 371. -/
structure LocalKernelClass where
  margin : ℝ
  margin_pos : 0 < margin
  derivativeConstant : ℝ
  one_le_derivativeConstant : 1 ≤ derivativeConstant

/-- Coordinate partial derivative of a local kernel. This keeps the source's
total-order derivative convention rather than replacing it by an operator norm. -/
noncomputable def localKernelPartial (m n : ℕ) (w : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  iteratedDeriv m (fun x => iteratedDeriv n (fun t => w (x, t)) z.2) z.1

/-- Smoothness, interior support, four zero marginals, and the quantitative
derivative bounds in blueprint `eq:local` and `eq:marginals`, lines 371–376. -/
structure IsAdmissibleLocalKernel (κ : LocalKernelClass) (a r : ℝ)
    (w : ℝ × ℝ → ℂ) : Prop where
  smooth : ContDiff ℝ (⊤ : ℕ∞) w
  support : ∀ z, w z ≠ 0 → ∀ j : Fin 4,
    a + κ.margin * r ≤ realProgressionCoordinate j z ∧
      realProgressionCoordinate j z ≤ a + r - κ.margin * r
  marginal : ∀ (u : ℝ) (j : Fin 4), ∫ t : ℝ, w (u - (j : ℝ) * t, t) = 0
  derivativeBound : ∀ (m n : ℕ) (z : ℝ × ℝ),
    ‖localKernelPartial m n w z‖ ≤ r⁻¹ ^ (m + n) *
      (κ.derivativeConstant * ((m + n : ℕ) + 2)) ^
        (κ.derivativeConstant * ((m + n : ℕ) + 2))

noncomputable def localKernelSupBound (κ : LocalKernelClass) : ℝ :=
  (κ.derivativeConstant * 2) ^ (κ.derivativeConstant * 2)

theorem localKernelSupBound_nonneg (κ : LocalKernelClass) : 0 ≤ localKernelSupBound κ :=
  Real.rpow_nonneg (by nlinarith [κ.one_le_derivativeConstant]) _

theorem admissibleLocalKernel_norm_le {κ : LocalKernelClass} {a r : ℝ}
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w) (z : ℝ × ℝ) :
    ‖w z‖ ≤ localKernelSupBound κ := by
  simpa [localKernelPartial, localKernelSupBound] using hw.derivativeBound 0 0 z

theorem admissibleLocalKernel_support {κ : LocalKernelClass} {a r : ℝ} (hr : 0 ≤ r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w) :
    HasLocalProgressionSupport a r w := by
  intro z hz j
  have h := hw.support z hz j
  have hc := mul_nonneg κ.margin_pos.le hr
  constructor <;> linarith

/-- The scalar specialization of the source's uncentered powered maximal function. -/
noncomputable def scalarMaximalQ (q : ℝ) (f : ℝ → ℂ) (x : ℝ) : ℝ≥0∞ :=
  maximalQ q (fun z : ℝ × Unit => f z.1) (x, ())

/-- The complete finite data quantified over by blueprint `eq:CN`: one
dyadic grid, a finite collection in at most `N` consecutive depths, an admissible
kernel at every selected cell, and compactly supported measurable `Lq` inputs. -/
structure FiniteDepthLocalData (κ : LocalKernelClass) (q : ℝ) (N : ℕ) where
  grid : RealDyadicGrid
  cells : Finset (ℤ × ℤ)
  firstDepth : ℤ
  depths : ∀ c ∈ cells, firstDepth ≤ c.1 ∧ c.1 < firstDepth + N
  kernel : (ℤ × ℤ) → ℝ × ℝ → ℂ
  admissible : ∀ c ∈ cells, IsAdmissibleLocalKernel κ
    (dyadicGridLeft grid c.1 c.2) (dyadicGridLength grid c.1) (kernel c)
  input : Fin 4 → ℝ → ℂ
  measurable_input : ∀ i, Measurable (input i)
  memLp_input : ∀ i, MemLp (input i) (ENNReal.ofReal q) volume
  compact_input : ∀ i, HasCompactSupport (input i)

/-- The finite numerator in blueprint `eq:CN`. -/
noncomputable def finiteDepthNumerator {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) : ℝ :=
  ∑ c ∈ D.cells, dyadicGridLength D.grid c.1 *
    ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖

/-- The nonnegative maximal-product denominator in blueprint `eq:CN`. -/
noncomputable def finiteDepthDenominator {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) : ℝ≥0∞ :=
  ∫⁻ x : ℝ, ∏ i, scalarMaximalQ q (D.input i) x

/-- Only strictly positive finite denominators enter the real ratios in
blueprint `eq:CN`, lines 398–403. -/
def finiteDepthRatios (κ : LocalKernelClass) (q : ℝ) (N : ℕ) : Set ℝ :=
  {c | ∃ D : FiniteDepthLocalData κ q N, 0 < finiteDepthDenominator D ∧
    finiteDepthDenominator D ≠ ∞ ∧ c = finiteDepthNumerator D / (finiteDepthDenominator D).toReal}

/-- The least constant at least one from blueprint `eq:CN`. Inserting one
before the supremum includes the empty-ratio case without a division convention. -/
noncomputable def finiteDepthConstant (κ : LocalKernelClass) (q : ℝ) (N : ℕ) : ℝ :=
  sSup (insert 1 (finiteDepthRatios κ q N))

theorem finiteDepthNumerator_nonneg {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) : 0 ≤ finiteDepthNumerator D := by
  apply Finset.sum_nonneg
  intro c _
  exact mul_nonneg (dyadicGridLength_pos D.grid c.1).le (norm_nonneg _)

/-- Every normalized local `Lq` norm is bounded by the source's uncentered
`M_q` at every point of the interval, as used in `lem:finite-CN`, line 409. -/
theorem localLpNorm_le_scalarMaximalQ {a r x q : ℝ} (hr : 0 < r) (hq : 0 < q)
    (hx : x ∈ Set.Icc a (a + r)) (f : ℝ → ℂ) (hf : Measurable f) :
    eLpNorm f (ENNReal.ofReal q) (normalizedIntervalMeasure a r) ≤ scalarMaximalQ q f x := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ne_of_gt (ENNReal.ofReal_pos.mpr hq)) ENNReal.ofReal_ne_top hf.aestronglyMeasurable]
  simp only [ENNReal.toReal_ofReal hq.le, normalizedIntervalMeasure, lintegral_smul_measure,
    smul_eq_mul, scalarMaximalQ, maximalQ]
  apply ENNReal.rpow_le_rpow _ (one_div_nonneg.mpr hq.le)
  have hgn (y : ℝ) : ‖‖f y‖ ^ q‖ₑ = ‖f y‖ₑ ^ q := by
    rw [Real.enorm_eq_ofReal (Real.rpow_nonneg (norm_nonneg _) _),
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le, ofReal_norm]
  change ENNReal.ofReal r⁻¹ * (∫⁻ y in Set.Icc a (a + r), ‖f y‖ₑ ^ q) ≤
    uncenteredRealMaximal (fun y => ‖f y‖ ^ q) x
  calc
    _ = (ENNReal.ofReal ((a + r) - a))⁻¹ *
        ∫⁻ y in Set.Icc a (a + r), ‖‖f y‖ ^ q‖ₑ := by
      simp_rw [hgn]
      rw [add_sub_cancel_left, ENNReal.ofReal_inv_of_pos hr]
    _ ≤ _ := by
      unfold uncenteredRealMaximal
      refine le_iSup_of_le a ?_
      refine le_iSup_of_le (a + r) ?_
      refine le_iSup_of_le (show a < a + r by linarith) ?_
      refine le_iSup_of_le hx ?_
      exact le_rfl

/-- The uniform real constant furnished by the fixed admissible kernel class. -/
noncomputable def localFormUniformConstant (κ : LocalKernelClass) : ℝ :=
  2 * localKernelSupBound κ

theorem localFormUniformConstant_nonneg (κ : LocalKernelClass) :
    0 ≤ localFormUniformConstant κ := mul_nonneg (by norm_num) (localKernelSupBound_nonneg κ)

/-- The local `L2` estimate followed by normalized exponent monotonicity,
the first step of blueprint `lem:finite-CN`, line 409. -/
theorem admissibleLocalForm_le_localLp {κ : LocalKernelClass} {a r q : ℝ}
    (hr : 0 < r) (hq : 2 ≤ q) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ i, Measurable (f i)) :
    ‖localProgressionForm r w f‖ₑ ≤ ENNReal.ofReal (localFormUniformConstant κ) *
      ∏ i, eLpNorm (f i) (ENNReal.ofReal q) (normalizedIntervalMeasure a r) := by
  let : IsProbabilityMeasure (normalizedIntervalMeasure a r) :=
    normalizedIntervalMeasure_probability a hr
  have hW (z) : ‖w z‖ₑ ≤ ENNReal.ofReal (localKernelSupBound κ) := by
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (admissibleLocalKernel_norm_le hw z)
  have h := localProgressionForm_enorm_le hr w hw.smooth.continuous.measurable
    (admissibleLocalKernel_support hr.le hw) hW f hf (fun _ => 2)
    (by norm_num) (by norm_num [Fin.sum_univ_succ])
  have htwo : (2 : ℝ≥0∞) ≤ ENNReal.ofReal q := by
    exact_mod_cast ENNReal.ofReal_le_ofReal hq
  have hc : (2 : ℝ≥0∞) * ENNReal.ofReal (localKernelSupBound κ) =
      ENNReal.ofReal (localFormUniformConstant κ) := by
    rw [localFormUniformConstant, ENNReal.ofReal_mul (by norm_num)]
    norm_num
  rw [hc] at h
  exact h.trans (mul_le_mul_right
    (Finset.prod_le_prod (fun i _ => eLpNorm_le_eLpNorm_of_exponent_le htwo)) _)

/-- The source local form is bounded pointwise on its interval by the product
of the four uncentered maximal functions. -/
theorem admissibleLocalForm_le_maximalProduct {κ : LocalKernelClass} {a r q x : ℝ}
    (hr : 0 < r) (hq : 2 ≤ q) (hx : x ∈ Set.Icc a (a + r))
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ i, Measurable (f i)) :
    ‖localProgressionForm r w f‖ₑ ≤ ENNReal.ofReal (localFormUniformConstant κ) *
      ∏ i, scalarMaximalQ q (f i) x :=
  (admissibleLocalForm_le_localLp hr hq hw f hf).trans
    (mul_le_mul_right (Finset.prod_le_prod (fun i _ =>
      localLpNorm_le_scalarMaximalQ hr (by linarith) hx (f i) (hf i))) _)

theorem finiteDepth_cell_bound {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (hq : 2 ≤ q) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    ENNReal.ofReal (dyadicGridLength D.grid c.1) *
      ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ ≤
      ENNReal.ofReal (localFormUniformConstant κ) *
        ∫⁻ x in dyadicGridCell D.grid c.1 c.2, ∏ i, scalarMaximalQ q (D.input i) x := by
  let H := ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ
  calc
    _ = ∫⁻ _x in dyadicGridCell D.grid c.1 c.2, H := by
      rw [setLIntegral_const, dyadicGridCell_volume]
      exact mul_comm _ _
    _ ≤ ∫⁻ x in dyadicGridCell D.grid c.1 c.2,
        ENNReal.ofReal (localFormUniformConstant κ) * ∏ i, scalarMaximalQ q (D.input i) x := by
      apply setLIntegral_mono' (dyadicGridCell_measurable D.grid c.1 c.2)
      intro x hx
      exact admissibleLocalForm_le_maximalProduct (dyadicGridLength_pos D.grid c.1) hq
        ⟨hx.1, hx.2.le⟩ (D.admissible c hc) D.input D.measurable_input
    _ = _ := lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

theorem finiteDepth_one_level_bound {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (hq : 2 ≤ q) (s : ℤ) :
    (∑ c ∈ D.cells.filter (fun c => c.1 = s),
      ENNReal.ofReal (dyadicGridLength D.grid c.1) *
        ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ) ≤
      ENNReal.ofReal (localFormUniformConstant κ) * finiteDepthDenominator D := by
  classical
  let S := D.cells.filter (fun c => c.1 = s)
  have hd : Set.PairwiseDisjoint (S : Set (ℤ × ℤ))
      (fun c => dyadicGridCell D.grid c.1 c.2) := by
    intro c hc c' hc' hne
    have hcS := (Finset.mem_filter.mp hc).2
    have hcS' := (Finset.mem_filter.mp hc').2
    change Disjoint (dyadicGridCell D.grid c.1 c.2) (dyadicGridCell D.grid c'.1 c'.2)
    rw [hcS, hcS']
    apply dyadicGridCell_pairwiseDisjoint D.grid s
    intro he
    exact hne (Prod.ext (hcS.trans hcS'.symm) he)
  calc
    _ ≤ ∑ c ∈ S, ENNReal.ofReal (localFormUniformConstant κ) *
        ∫⁻ x in dyadicGridCell D.grid c.1 c.2, ∏ i, scalarMaximalQ q (D.input i) x :=
      Finset.sum_le_sum (fun c hc => finiteDepth_cell_bound D hq (Finset.mem_filter.mp hc).1)
    _ = ENNReal.ofReal (localFormUniformConstant κ) *
        ∫⁻ x in ⋃ c ∈ S, dyadicGridCell D.grid c.1 c.2,
          ∏ i, scalarMaximalQ q (D.input i) x := by
      rw [lintegral_biUnion_finset hd
        (fun c _ => dyadicGridCell_measurable D.grid c.1 c.2), Finset.mul_sum]
    _ ≤ _ := mul_le_mul_right (lintegral_mono' Measure.restrict_le_self le_rfl) _

theorem finiteDepthNumerator_ofReal {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) :
    ENNReal.ofReal (finiteDepthNumerator D) = ∑ c ∈ D.cells,
      ENNReal.ofReal (dyadicGridLength D.grid c.1) *
        ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ := by
  unfold finiteDepthNumerator
  rw [ENNReal.ofReal_sum_of_nonneg (fun c _ =>
    mul_nonneg (dyadicGridLength_pos D.grid c.1).le (norm_nonneg _))]
  apply Finset.sum_congr rfl
  intro c _
  rw [ENNReal.ofReal_mul (dyadicGridLength_pos D.grid c.1).le, ofReal_norm]

/-- Blueprint `lem:finite-CN`, line 409: disjoint depth summation gives the
uniform linear-in-depth bound before the absorption argument begins. -/
theorem finiteDepthNumerator_le {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (hq : 2 ≤ q) :
    ENNReal.ofReal (finiteDepthNumerator D) ≤
      ENNReal.ofReal (localFormUniformConstant κ * N) * finiteDepthDenominator D := by
  classical
  let T : Finset ℤ := Finset.Ico D.firstDepth (D.firstDepth + N)
  let w := fun c : ℤ × ℤ => ENNReal.ofReal (dyadicGridLength D.grid c.1) *
    ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ
  have hmem (c) (hc : c ∈ D.cells) : c.1 ∈ T := Finset.mem_Ico.mpr (D.depths c hc)
  have hcard : T.card = N := by simp [T, Int.card_Ico]
  have hpartition : (∑ s ∈ T, ∑ c ∈ D.cells.filter (fun c => c.1 = s), w c) =
      ∑ c ∈ D.cells, w c := by
    simp_rw [Finset.sum_filter]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro c hc
    simp [hmem c hc]
  rw [finiteDepthNumerator_ofReal]
  change (∑ c ∈ D.cells, w c) ≤ _
  rw [← hpartition]
  calc
    _ ≤ ∑ _s ∈ T, ENNReal.ofReal (localFormUniformConstant κ) * finiteDepthDenominator D :=
      Finset.sum_le_sum (fun s _ => finiteDepth_one_level_bound D hq s)
    _ = (N : ℝ≥0∞) * (ENNReal.ofReal (localFormUniformConstant κ) * finiteDepthDenominator D) := by
      rw [Finset.sum_const, nsmul_eq_mul, hcard]
    _ = _ := by
      rw [ENNReal.ofReal_mul (localFormUniformConstant_nonneg κ)]
      simp only [ENNReal.ofReal_natCast]
      ac_rfl

theorem finiteDepth_ratio_le {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (hq : 2 ≤ q)
    (hpos : 0 < finiteDepthDenominator D) (hfin : finiteDepthDenominator D ≠ ∞) :
    finiteDepthNumerator D / (finiteDepthDenominator D).toReal ≤
      localFormUniformConstant κ * N := by
  have hp : 0 < (finiteDepthDenominator D).toReal :=
    ENNReal.toReal_pos hpos.ne' hfin
  apply (div_le_iff₀ hp).mpr
  have h := ENNReal.toReal_mono
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hfin) (finiteDepthNumerator_le D hq)
  simpa only [ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (finiteDepthNumerator_nonneg D),
    ENNReal.toReal_ofReal (mul_nonneg (localFormUniformConstant_nonneg κ)
      (Nat.cast_nonneg N))] using h

theorem finiteDepthRatios_bddAbove (κ : LocalKernelClass) {q : ℝ} (hq : 2 ≤ q)
    (N : ℕ) : BddAbove (insert 1 (finiteDepthRatios κ q N)) := by
  refine ⟨1 + localFormUniformConstant κ * N, ?_⟩
  intro c hc
  rcases Set.mem_insert_iff.mp hc with rfl | ⟨D, hp, hf, rfl⟩
  · exact le_add_of_nonneg_right (mul_nonneg (localFormUniformConstant_nonneg κ)
      (Nat.cast_nonneg N))
  · exact (finiteDepth_ratio_le D hq hp hf).trans (by linarith)

/-- Blueprint `eq:CN` and `lem:finite-CN`: the real supremum is bounded,
and the inserted value one enforces the required normalization. -/
theorem finiteDepthConstant_bounds (κ : LocalKernelClass) {q : ℝ} (hq : 2 ≤ q)
    (N : ℕ) : 1 ≤ finiteDepthConstant κ q N ∧
      finiteDepthConstant κ q N ≤ 1 + localFormUniformConstant κ * N := by
  constructor
  · exact le_csSup (finiteDepthRatios_bddAbove κ hq N) (Set.mem_insert 1 _)
  · apply csSup_le (Set.insert_nonempty 1 _)
    intro c hc
    rcases Set.mem_insert_iff.mp hc with rfl | ⟨D, hp, hf, rfl⟩
    · exact le_add_of_nonneg_right (mul_nonneg (localFormUniformConstant_nonneg κ)
        (Nat.cast_nonneg N))
    · exact (finiteDepth_ratio_le D hq hp hf).trans (by linarith)

/-- Blueprint `eq:CN`: the defining inequality holds at the real supremum,
including zero and infinite denominator cases. -/
theorem finiteDepthConstant_spec {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (hq : 2 ≤ q) (D : FiniteDepthLocalData κ q N) :
    ENNReal.ofReal (finiteDepthNumerator D) ≤
      ENNReal.ofReal (finiteDepthConstant κ q N) * finiteDepthDenominator D := by
  have hC : 0 < finiteDepthConstant κ q N :=
    lt_of_lt_of_le zero_lt_one (finiteDepthConstant_bounds κ hq N).1
  by_cases hz : finiteDepthDenominator D = 0
  · simpa only [hz, mul_zero] using finiteDepthNumerator_le D hq
  by_cases ht : finiteDepthDenominator D = ∞
  · rw [ht, ENNReal.mul_top (ENNReal.ofReal_pos.mpr hC).ne']
    exact le_top
  have hp : 0 < (finiteDepthDenominator D).toReal := ENNReal.toReal_pos hz ht
  have hr : finiteDepthNumerator D / (finiteDepthDenominator D).toReal ≤
      finiteDepthConstant κ q N :=
    le_csSup (finiteDepthRatios_bddAbove κ hq N)
      (Set.mem_insert_of_mem 1 ⟨D, bot_lt_iff_ne_bot.mpr hz, ht, rfl⟩)
  have h := ENNReal.ofReal_le_ofReal ((div_le_iff₀ hp).mp hr)
  rwa [ENNReal.ofReal_mul hC.le, ENNReal.ofReal_toReal ht] at h

/-- Blueprint `eq:CN`: every admissible real constant at least one majorizes
the constructed constant. -/
theorem finiteDepthConstant_least {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    {c : ℝ} (hc : 1 ≤ c)
    (hbound : ∀ D : FiniteDepthLocalData κ q N,
      ENNReal.ofReal (finiteDepthNumerator D) ≤
        ENNReal.ofReal c * finiteDepthDenominator D) :
    finiteDepthConstant κ q N ≤ c := by
  apply csSup_le (Set.insert_nonempty 1 _)
  intro b hb
  rcases Set.mem_insert_iff.mp hb with rfl | ⟨D, hp, ht, rfl⟩
  · exact hc
  · apply (div_le_iff₀ (ENNReal.toReal_pos hp.ne' ht)).mpr
    have h := ENNReal.toReal_mono
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ht) (hbound D)
    simpa only [ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (finiteDepthNumerator_nonneg D),
      ENNReal.toReal_ofReal (le_trans zero_le_one hc)] using h

/-- Blueprint `lem:finite-CN`, lines 405–411: for every source exponent and
positive depth, the normalized least constant is finite, at most `1 + C N`,
and satisfies its defining inequality for all admissible data. -/
theorem finiteDepthConstant_finite (κ : LocalKernelClass) {q : ℝ}
    (hq : 2 < q ∧ q < 3) (N : ℕ) (_hN : 0 < N) :
    (1 ≤ finiteDepthConstant κ q N ∧
      finiteDepthConstant κ q N ≤ 1 + localFormUniformConstant κ * N) ∧
    (∀ D : FiniteDepthLocalData κ q N,
      ENNReal.ofReal (finiteDepthNumerator D) ≤
        ENNReal.ofReal (finiteDepthConstant κ q N) * finiteDepthDenominator D) ∧
    (∀ c : ℝ, 1 ≤ c →
      (∀ D : FiniteDepthLocalData κ q N, ENNReal.ofReal (finiteDepthNumerator D) ≤
        ENNReal.ofReal c * finiteDepthDenominator D) → finiteDepthConstant κ q N ≤ c) :=
  ⟨finiteDepthConstant_bounds κ hq.1.le N,
    finiteDepthConstant_spec hq.1.le, fun _ => finiteDepthConstant_least⟩

/-- The source Hilbert space has one physical coordinate and one distinct
private coordinate for each label (`column-data`, lines 470–474). -/
abbrev ColumnHilbert (V : Type*) := EuclideanSpace ℂ (Option V)

/-- Global L2 space in which cell-supported column projections act. -/
noncomputable abbrev ColumnL2 (V : Type*) [Fintype V] :=
  Lp (ColumnHilbert V) 2 (volume : Measure ℝ)

open scoped Classical in
/-- The augmented column `(φᵥ(y), sqrt(εᵥ) eᵥ)` from blueprint line 473. -/
noncomputable def privateColumnValue {V : Type*} [Fintype V]
    (φ : V → ℝ → ℂ) (ε : V → ℝ) (v : V) (y : ℝ) : ColumnHilbert V :=
  φ v y • EuclideanSpace.single none (1 : ℂ) +
    (Real.sqrt (ε v) : ℂ) • EuclideanSpace.single (some v) (1 : ℂ)

theorem privateColumnValue_physical {V : Type*} [Fintype V]
    (φ : V → ℝ → ℂ) (ε : V → ℝ) (v : V) (y : ℝ) :
    privateColumnValue φ ε v y none = φ v y := by
  classical
  simp [privateColumnValue]

open scoped Classical in
theorem privateColumnValue_private {V : Type*} [Fintype V]
    (φ : V → ℝ → ℂ) (ε : V → ℝ) (v w : V) (y : ℝ) :
    privateColumnValue φ ε v y (some w) = if w = v then (Real.sqrt (ε v) : ℂ) else 0 := by
  classical
  by_cases hw : w = v <;> simp [privateColumnValue, hw]

theorem privateColumnValue_measurable {V : Type*} [Fintype V]
    (φ : V → ℝ → ℂ) (ε : V → ℝ) (v : V) (hφ : Measurable (φ v)) :
    Measurable (privateColumnValue φ ε v) := by
  exact (hφ.smul measurable_const).add measurable_const

open scoped Classical in
/-- Finite column data from `eq:columnbudget` and `column-data`, lines
470–483. The budget counts available labels at each point, without bounding
the total number of labels on disjoint branches. -/
structure ColumnTreeData (V : Type*) [Fintype V] where
  grid : RealDyadicGrid
  cells : Finset (ℤ × ℤ)
  root : ℤ × ℤ
  below_root : ∀ c ∈ cells, dyadicGridCell grid c.1 c.2 ⊆ dyadicGridCell grid root.1 root.2
  birth : V → ℤ × ℤ
  birth_mem : ∀ v, birth v ∈ cells
  scalar : V → ℝ → ℂ
  scalar_measurable : ∀ v, Measurable (scalar v)
  privateWeight : V → ℝ
  privateWeight_pos : ∀ v, 0 < privateWeight v
  budget : ℝ
  two_le_budget : 2 ≤ budget
  private_lower : ∀ v, budget⁻¹ ≤ Real.sqrt (privateWeight v)
  column_bound : ∀ v, ∀ᵐ y ∂volume.restrict (dyadicGridCell grid (birth v).1 (birth v).2),
    ‖privateColumnValue scalar privateWeight v y‖ ≤ budget
  path_count : ∀ y : ℝ,
    ((Finset.univ.filter
      (fun v => y ∈ dyadicGridCell grid (birth v).1 (birth v).2)).card : ℝ) ≤ budget

/-- A fixed inherited mask: available birth cells contain the decision
cell, and every old label remains available on each descendant in the tree. -/
structure InheritedColumnMask {V : Type*} [Fintype V] (D : ColumnTreeData V) where
  labels : (ℤ × ℤ) → Finset V
  available : ∀ c ∈ D.cells, ∀ v ∈ labels c,
    dyadicGridCell D.grid c.1 c.2 ⊆ dyadicGridCell D.grid (D.birth v).1 (D.birth v).2
  inherited : ∀ c ∈ D.cells, ∀ d ∈ D.cells,
    dyadicGridCell D.grid c.1 c.2 ⊆ dyadicGridCell D.grid d.1 d.2 → labels d ⊆ labels c

/-- Each decision-cell mask has at most the path budget many columns,
although labels on other branches need not be bounded in number. -/
theorem InheritedColumnMask_card_le {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    ((A.labels c).card : ℝ) ≤ D.budget := by
  classical
  let y := dyadicGridLeft D.grid c.1 c.2
  have hy : y ∈ dyadicGridCell D.grid c.1 c.2 := dyadicGridCell_left_mem D.grid c.1 c.2
  have hsub : A.labels c ⊆ Finset.univ.filter
      (fun v => y ∈ dyadicGridCell D.grid (D.birth v).1 (D.birth v).2) := by
    intro v hv
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, A.available c hc v hv hy⟩
  exact (Nat.cast_le.mpr (Finset.card_le_card hsub)).trans (D.path_count y)

/-- The birth-cell essential bound passes to every decision cell on
which the fixed mask makes the label available. -/
theorem InheritedColumnMask_ae_column_bound {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) {v : V} (hv : v ∈ A.labels c) :
    ∀ᵐ y ∂volume.restrict (dyadicGridCell D.grid c.1 c.2),
      ‖privateColumnValue D.scalar D.privateWeight v y‖ ≤ D.budget :=
  ae_restrict_of_ae_restrict_of_subset (A.available c hc v hv) (D.column_bound v)

/-- Available columns, restricted to a decision cell and extended by zero,
belong to L2 by the source essential bound and the finite cell measure. -/
theorem cellColumn_memLp {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) {v : V} (hv : v ∈ A.labels c) :
    MemLp ((dyadicGridCell D.grid c.1 c.2).indicator
      (privateColumnValue D.scalar D.privateWeight v)) 2 volume := by
  apply (memLp_indicator_iff_restrict
    (dyadicGridCell_measurable D.grid c.1 c.2).nullMeasurableSet).mpr
  let : IsFiniteMeasure (volume.restrict (dyadicGridCell D.grid c.1 c.2)) :=
    isFiniteMeasure_restrict.mpr (by rw [dyadicGridCell_volume]; exact ENNReal.ofReal_ne_top)
  have hm := privateColumnValue_measurable D.scalar D.privateWeight v (D.scalar_measurable v)
  exact MemLp.of_bound hm.aestronglyMeasurable D.budget
    (InheritedColumnMask_ae_column_bound D A hc hv)

/-- The cell-supported L2 column, with its exact original representative. -/
noncomputable def cellColumnLp {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    (v : {v // v ∈ A.labels c}) : ColumnL2 V :=
  MemLp.toLp _ (cellColumn_memLp D A hc v.property)

theorem cellColumnLp_coeFn {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) (v : {v // v ∈ A.labels c}) :
    (cellColumnLp D A hc v : ℝ → ColumnHilbert V) =ᵐ[volume]
      (dyadicGridCell D.grid c.1 c.2).indicator (privateColumnValue D.scalar D.privateWeight v) :=
  MemLp.coeFn_toLp (cellColumn_memLp D A hc v.property)

/-- The source projection range is the span of constant-coefficient
combinations of the restricted available columns (`column-data`, line 483). -/
noncomputable def cellColumnRange {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    Submodule ℂ (ColumnL2 V) :=
  Submodule.span ℂ (Set.range (cellColumnLp D A hc))

instance cellColumnRange_finiteDimensional {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    FiniteDimensional ℂ (cellColumnRange D A hc) := by
  classical
  unfold cellColumnRange
  exact FiniteDimensional.span_of_finite ℂ (Set.finite_range _)

/-- Orthogonal projection onto the finite-dimensional column range. No
basis-selection algorithm is part of this definition. -/
noncomputable def cellColumnProjection {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    ColumnL2 V →L[ℂ] ColumnL2 V :=
  (cellColumnRange D A hc).starProjection

theorem cellColumnProjection_mem {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) (z : ColumnL2 V) :
    cellColumnProjection D A hc z ∈ cellColumnRange D A hc :=
  Submodule.starProjection_apply_mem _ _

theorem cellColumnProjection_norm_le {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    ‖cellColumnProjection D A hc‖ ≤ 1 := Submodule.starProjection_norm_le _

theorem cellColumnProjection_fixes_column {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) (v : {v // v ∈ A.labels c}) :
    cellColumnProjection D A hc (cellColumnLp D A hc v) = cellColumnLp D A hc v := by
  apply Submodule.starProjection_eq_self_iff.mpr
  exact Submodule.subset_span (Set.mem_range_self v)

open scoped Classical in
/-- Membership in the projection range is exactly a constant-coefficient
combination of the available restricted columns. -/
theorem cellColumnRange_mem_iff {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) (z : ColumnL2 V) :
    z ∈ cellColumnRange D A hc ↔
      ∃ a : {v // v ∈ A.labels c} → ℂ, ∑ v, a v • cellColumnLp D A hc v = z := by
  exact Submodule.mem_span_range_iff_exists_fun ℂ

open scoped Classical in
/-- The orthogonal projection is represented by coefficients constant on
the decision cell, exactly as required by `column-data`, line 480. -/
theorem cellColumnProjection_representation {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) (z : ColumnL2 V) :
    ∃ a : {v // v ∈ A.labels c} → ℂ,
      ∑ v, a v • cellColumnLp D A hc v = cellColumnProjection D A hc z :=
  (cellColumnRange_mem_iff D A hc _).mp (cellColumnProjection_mem D A hc z)

/-- Multiplication of an L2 column-space vector by a measurable decision
set, retaining its original values on the set and zero elsewhere. -/
noncomputable def columnL2Indicator {V : Type*} [Fintype V] (s : Set ℝ)
    (hs : MeasurableSet s) (z : ColumnL2 V) : ColumnL2 V :=
  MemLp.toLp (s.indicator z) (MemLp.indicator hs.nullMeasurableSet (Lp.memLp z))

theorem columnL2Indicator_coeFn {V : Type*} [Fintype V] (s : Set ℝ)
    (hs : MeasurableSet s) (z : ColumnL2 V) :
    (columnL2Indicator s hs z : ℝ → ColumnHilbert V) =ᵐ[volume] s.indicator z :=
  MemLp.coeFn_toLp _

theorem columnL2Indicator_add {V : Type*} [Fintype V] (s : Set ℝ)
    (hs : MeasurableSet s) (z w : ColumnL2 V) :
    columnL2Indicator s hs (z + w) = columnL2Indicator s hs z + columnL2Indicator s hs w := by
  classical
  apply Lp.ext
  filter_upwards [columnL2Indicator_coeFn s hs (z + w), columnL2Indicator_coeFn s hs z,
    columnL2Indicator_coeFn s hs w, Lp.coeFn_add z w,
    Lp.coeFn_add (columnL2Indicator s hs z) (columnL2Indicator s hs w)] with y h1 h2 h3 h4 h5
  rw [h1, h5]
  by_cases hy : y ∈ s
  · simpa only [Set.indicator_of_mem hy, Pi.add_apply, h2, h3] using h4
  · simp only [Set.indicator_of_notMem hy, Pi.add_apply, h2, h3, add_zero]

theorem columnL2Indicator_smul {V : Type*} [Fintype V] (s : Set ℝ)
    (hs : MeasurableSet s) (a : ℂ) (z : ColumnL2 V) :
    columnL2Indicator s hs (a • z) = a • columnL2Indicator s hs z := by
  classical
  apply Lp.ext
  filter_upwards [columnL2Indicator_coeFn s hs (a • z), columnL2Indicator_coeFn s hs z,
    Lp.coeFn_smul a z, Lp.coeFn_smul a (columnL2Indicator s hs z)] with y h1 h2 h3 h4
  rw [h1, h4]
  by_cases hy : y ∈ s
  · simpa only [Set.indicator_of_mem hy, Pi.smul_apply, h2] using h3
  · simp only [Set.indicator_of_notMem hy, Pi.smul_apply, h2, smul_zero]

theorem columnL2Indicator_norm_le {V : Type*} [Fintype V] (s : Set ℝ)
    (hs : MeasurableSet s) (z : ColumnL2 V) : ‖columnL2Indicator s hs z‖ ≤ ‖z‖ := by
  unfold columnL2Indicator
  rw [Lp.norm_toLp, Lp.norm_def]
  exact ENNReal.toReal_mono (Lp.eLpNorm_ne_top z) (eLpNorm_indicator_le z hs.nullMeasurableSet)

/-- The bounded linear decision-set restriction operator. -/
noncomputable def columnL2Restriction {V : Type*} [Fintype V] (s : Set ℝ)
    (hs : MeasurableSet s) : ColumnL2 V →L[ℂ] ColumnL2 V := by
  let L : ColumnL2 V →ₗ[ℂ] ColumnL2 V :=
    { toFun := columnL2Indicator s hs
      map_add' := columnL2Indicator_add s hs
      map_smul' := columnL2Indicator_smul s hs }
  exact L.mkContinuous 1 (fun z => by
    change ‖columnL2Indicator s hs z‖ ≤ 1 * ‖z‖
    simpa only [one_mul] using columnL2Indicator_norm_le s hs z)

/-- Restricting an old column to a descendant gives exactly the same
label's descendant column, using the inherited-mask inclusion. -/
theorem cellColumn_restrict_descendant {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c d : ℤ × ℤ} (hc : c ∈ D.cells) (hd : d ∈ D.cells)
    (hcd : dyadicGridCell D.grid c.1 c.2 ⊆ dyadicGridCell D.grid d.1 d.2)
    (v : {v // v ∈ A.labels d}) :
    columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
      (dyadicGridCell_measurable D.grid c.1 c.2) (cellColumnLp D A hd v) =
      cellColumnLp D A hc ⟨v, A.inherited c hc d hd hcd v.property⟩ := by
  classical
  apply Lp.ext
  filter_upwards [columnL2Indicator_coeFn (dyadicGridCell D.grid c.1 c.2)
    (dyadicGridCell_measurable D.grid c.1 c.2) (cellColumnLp D A hd v),
    cellColumnLp_coeFn D A hd v,
    cellColumnLp_coeFn D A hc ⟨v, A.inherited c hc d hd hcd v.property⟩] with y h1 h2 h3
  change (columnL2Indicator (dyadicGridCell D.grid c.1 c.2)
    (dyadicGridCell_measurable D.grid c.1 c.2)
    (cellColumnLp D A hd v) : ℝ → ColumnHilbert V) y = _
  rw [h1, h3]
  by_cases hy : y ∈ dyadicGridCell D.grid c.1 c.2
  · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy, h2, Set.indicator_of_mem (hcd hy)]
  · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]

/-- Blueprint `column-data`, lines 480–483: restriction to a descendant
preserves the range of old constant-coefficient column combinations. -/
theorem cellColumnRange_restrict_descendant {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c d : ℤ × ℤ} (hc : c ∈ D.cells) (hd : d ∈ D.cells)
    (hcd : dyadicGridCell D.grid c.1 c.2 ⊆ dyadicGridCell D.grid d.1 d.2)
    {z : ColumnL2 V} (hz : z ∈ cellColumnRange D A hd) :
    columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
      (dyadicGridCell_measurable D.grid c.1 c.2) z ∈ cellColumnRange D A hc := by
  let R := columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
    (dyadicGridCell_measurable D.grid c.1 c.2) (V := V)
  have hsub : cellColumnRange D A hd ≤ (cellColumnRange D A hc).comap R.toLinearMap := by
    apply Submodule.span_le.mpr
    rintro _ ⟨v, rfl⟩
    change R (cellColumnLp D A hd v) ∈ cellColumnRange D A hc
    rw [show R (cellColumnLp D A hd v) = _ from cellColumn_restrict_descendant D A hc hd hcd v]
    exact Submodule.subset_span (Set.mem_range_self _)
  exact hsub hz

/-- Every vector in a cell's column range is fixed by restriction to that
cell, making the zero extension in the source projection explicit. -/
theorem cellColumnRange_fixed_restriction {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    {z : ColumnL2 V} (hz : z ∈ cellColumnRange D A hc) :
    columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
      (dyadicGridCell_measurable D.grid c.1 c.2) z = z := by
  let R := columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
    (dyadicGridCell_measurable D.grid c.1 c.2) (V := V)
  change R z = z
  change z ∈ Submodule.span ℂ (Set.range (cellColumnLp D A hc)) at hz
  induction hz using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨v, rfl⟩ := hz
    exact cellColumn_restrict_descendant D A hc hc (Set.Subset.refl _) v
  | zero => exact map_zero R
  | add z w _ _ hz hw => simp only [map_add, hz, hw]
  | smul a z _ hz => simp only [map_smul, hz]

/-- Column-range vectors vanish almost everywhere off their decision cell. -/
theorem cellColumnRange_ae_zero_off {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    {z : ColumnL2 V} (hz : z ∈ cellColumnRange D A hc) :
    ∀ᵐ y ∂volume, y ∉ dyadicGridCell D.grid c.1 c.2 → z y = 0 := by
  have heq := cellColumnRange_fixed_restriction D A hc hz
  have hae := columnL2Indicator_coeFn (dyadicGridCell D.grid c.1 c.2)
    (dyadicGridCell_measurable D.grid c.1 c.2) z
  change (columnL2Indicator (dyadicGridCell D.grid c.1 c.2)
    (dyadicGridCell_measurable D.grid c.1 c.2) z) = z at heq
  rw [heq] at hae
  filter_upwards [hae] with y hy
  intro hout
  simpa only [Set.indicator_of_notMem hout] using hy

/-- The ranges of columns on disjoint decision cells are orthogonal,
justifying the source's direct sums on stopping partitions. -/
theorem cellColumnRange_inner_eq_zero_of_disjoint {V : Type*} [Fintype V]
    (D : ColumnTreeData V) (A : InheritedColumnMask D) {c d : ℤ × ℤ}
    (hc : c ∈ D.cells) (hd : d ∈ D.cells)
    (hdis : Disjoint (dyadicGridCell D.grid c.1 c.2) (dyadicGridCell D.grid d.1 d.2))
    {z w : ColumnL2 V} (hz : z ∈ cellColumnRange D A hc) (hw : w ∈ cellColumnRange D A hd) :
    inner ℂ z w = 0 := by
  rw [MeasureTheory.L2.inner_def]
  have heq : (fun y => inner ℂ (z y) (w y)) =ᵐ[volume] 0 := by
    filter_upwards [cellColumnRange_ae_zero_off D A hc hz,
      cellColumnRange_ae_zero_off D A hd hw] with y hz0 hw0
    by_cases hy : y ∈ dyadicGridCell D.grid c.1 c.2
    · have hyd : y ∉ dyadicGridCell D.grid d.1 d.2 := fun hyd => Set.disjoint_left.mp hdis hy hyd
      simp only [hw0 hyd, inner_zero_right, Pi.zero_apply]
    · simp only [hz0 hy, inner_zero_left, Pi.zero_apply]
  rw [integral_congr_ae heq]
  simp only [Pi.zero_apply, integral_zero]

/-- A finite stopping partition of the source root, using cells of the
fixed column tree. Half-open cells make the disjoint cover exact. -/
structure ColumnStoppingPartition {V : Type*} [Fintype V] (D : ColumnTreeData V) where
  cells : Finset (ℤ × ℤ)
  subset : cells ⊆ D.cells
  disjoint : Set.PairwiseDisjoint (cells : Set (ℤ × ℤ))
    (fun c => dyadicGridCell D.grid c.1 c.2)
  cover : (⋃ c ∈ cells, dyadicGridCell D.grid c.1 c.2) =
    dyadicGridCell D.grid D.root.1 D.root.2

/-- Orthogonal direct sum of the cell column ranges on a stopping partition. -/
noncomputable def partitionColumnRange {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (π : ColumnStoppingPartition D) : Submodule ℂ (ColumnL2 V) :=
  ⨆ c : {c // c ∈ π.cells}, cellColumnRange D A (π.subset c.property)

instance partitionColumnRange_finiteDimensional {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (π : ColumnStoppingPartition D) :
    FiniteDimensional ℂ (partitionColumnRange D A π) := by
  classical
  unfold partitionColumnRange
  infer_instance

/-- The source stopping-partition projection, defined from its range. -/
noncomputable def partitionColumnProjection {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (π : ColumnStoppingPartition D) :
    ColumnL2 V →L[ℂ] ColumnL2 V := (partitionColumnRange D A π).starProjection

theorem partitionColumnRange_orthogonalFamily {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (π : ColumnStoppingPartition D) :
    OrthogonalFamily ℂ (fun c : {c // c ∈ π.cells} => cellColumnRange D A (π.subset c.property))
      (fun c => (cellColumnRange D A (π.subset c.property)).subtypeₗᵢ) := by
  intro c d hcd z w
  apply cellColumnRange_inner_eq_zero_of_disjoint D A (π.subset c.property) (π.subset d.property)
    (π.disjoint c.property d.property (fun h => hcd (Subtype.ext h))) z.property w.property

open scoped Classical in
/-- Blueprint `column-data`, line 480: the partition projection equals the
finite direct sum of its cell projections. -/
theorem partitionColumnProjection_eq_sum {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (π : ColumnStoppingPartition D) (z : ColumnL2 V) :
    partitionColumnProjection D A π z =
      ∑ c : {c // c ∈ π.cells}, cellColumnProjection D A (π.subset c.property) z := by
  let W := fun c : {c // c ∈ π.cells} => cellColumnRange D A (π.subset c.property)
  have horth := partitionColumnRange_orthogonalFamily D A π
  have hm : partitionColumnProjection D A π z ∈ ⨆ c, W c :=
    Submodule.starProjection_apply_mem _ _
  have hh := horth.sum_projection_of_mem_iSup (partitionColumnProjection D A π z) hm
  calc
    _ = ∑ c, (W c).starProjection (partitionColumnProjection D A π z) := hh.symm
    _ = _ := by
      apply Finset.sum_congr rfl
      intro c _
      have hle : W c ≤ partitionColumnRange D A π := le_iSup W c
      have hcomp := Submodule.starProjection_comp_starProjection_of_le hle
      exact congrArg (fun L : ColumnL2 V →L[ℂ] ColumnL2 V => L z) hcomp

theorem partitionColumnProjection_norm_le {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (π : ColumnStoppingPartition D) :
    ‖partitionColumnProjection D A π‖ ≤ 1 := Submodule.starProjection_norm_le _

theorem cellColumnRange_restrict_superset {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    {s : Set ℝ} (hs : MeasurableSet s) (hcs : dyadicGridCell D.grid c.1 c.2 ⊆ s)
    {z : ColumnL2 V} (hz : z ∈ cellColumnRange D A hc) : columnL2Restriction s hs z = z := by
  classical
  apply Lp.ext
  filter_upwards [columnL2Indicator_coeFn s hs z, cellColumnRange_ae_zero_off D A hc hz]
    with y hy hz0
  change (columnL2Indicator s hs z : ℝ → ColumnHilbert V) y = z y
  rw [hy]
  by_cases hys : y ∈ s
  · exact Set.indicator_of_mem hys _
  · rw [Set.indicator_of_notMem hys, hz0 (fun hyc => hys (hcs hyc))]

theorem cellColumnRange_restrict_disjoint {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    {s : Set ℝ} (hs : MeasurableSet s) (hdis : Disjoint s (dyadicGridCell D.grid c.1 c.2))
    {z : ColumnL2 V} (hz : z ∈ cellColumnRange D A hc) : columnL2Restriction s hs z = 0 := by
  classical
  apply Lp.ext
  filter_upwards [columnL2Indicator_coeFn s hs z, cellColumnRange_ae_zero_off D A hc hz,
    Lp.coeFn_zero (E := ColumnHilbert V) (p := (2 : ℝ≥0∞)) (μ := (volume : Measure ℝ))]
    with y hy hz0 hzero
  change (columnL2Indicator s hs z : ℝ → ColumnHilbert V) y = _
  rw [hy, hzero]
  by_cases hys : y ∈ s
  · rw [Set.indicator_of_mem hys, hz0 (fun hyc => Set.disjoint_left.mp hdis hys hyc)]
    rfl
  · rw [Set.indicator_of_notMem hys]
    rfl

open scoped Classical in
/-- The decision-cell restriction operators on a stopping partition sum
to restriction to the root, an exact L2 identity. -/
theorem columnPartition_restriction_sum {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (π : ColumnStoppingPartition D) (z : ColumnL2 V) :
    (∑ c : {c // c ∈ π.cells}, columnL2Restriction (dyadicGridCell D.grid c.val.1 c.val.2)
      (dyadicGridCell_measurable D.grid c.val.1 c.val.2) z) =
      columnL2Restriction (dyadicGridCell D.grid D.root.1 D.root.2)
        (dyadicGridCell_measurable D.grid D.root.1 D.root.2) z := by
  classical
  let R := fun c : {c // c ∈ π.cells} => columnL2Restriction
    (dyadicGridCell D.grid c.val.1 c.val.2) (dyadicGridCell_measurable D.grid c.val.1 c.val.2) z
  have hall : ∀ᵐ y ∂volume, ∀ c : {c // c ∈ π.cells},
      (R c : ℝ → ColumnHilbert V) y = (dyadicGridCell D.grid c.val.1 c.val.2).indicator z y :=
    ae_all_iff.mpr (fun c => columnL2Indicator_coeFn
      (dyadicGridCell D.grid c.val.1 c.val.2)
      (dyadicGridCell_measurable D.grid c.val.1 c.val.2) z)
  apply Lp.ext
  filter_upwards [Lp.coeFn_fun_finsetSum Finset.univ R, hall,
    columnL2Indicator_coeFn (dyadicGridCell D.grid D.root.1 D.root.2)
      (dyadicGridCell_measurable D.grid D.root.1 D.root.2) z] with y hsum hall hroot
  change (∑ c, R c : ColumnL2 V) y =
    (columnL2Indicator _ (dyadicGridCell_measurable D.grid D.root.1 D.root.2) z :
      ℝ → ColumnHilbert V) y
  rw [hsum, hroot]
  simp only [hall]
  by_cases hyr : y ∈ dyadicGridCell D.grid D.root.1 D.root.2
  · rw [← π.cover] at hyr
    obtain ⟨c, hc, hyc⟩ := Set.mem_iUnion₂.mp hyr
    rw [Finset.sum_eq_single (⟨c, hc⟩ : {c // c ∈ π.cells})]
    · rw [Set.indicator_of_mem hyc, Set.indicator_of_mem (D.below_root c (π.subset hc) hyc)]
    · intro d _ hdc
      have hyd : y ∉ dyadicGridCell D.grid d.val.1 d.val.2 := by
        intro hyd
        exact Set.disjoint_left.mp
          (π.disjoint d.property hc (fun h => hdc (Subtype.ext h))) hyd hyc
      exact Set.indicator_of_notMem hyd _
    · simp
  · rw [Set.indicator_of_notMem hyr]
    apply Finset.sum_eq_zero
    intro c _
    exact Set.indicator_of_notMem (fun hyc => hyr (D.below_root c.val (π.subset c.property) hyc)) _

/-- Every fine stopping cell is contained in one old stopping cell. -/
def ColumnPartitionRefines {V : Type*} [Fintype V] {D : ColumnTreeData V}
    (σ π : ColumnStoppingPartition D) : Prop :=
  ∀ c ∈ σ.cells, ∃ d ∈ π.cells,
    dyadicGridCell D.grid c.1 c.2 ⊆ dyadicGridCell D.grid d.1 d.2

/-- Blueprint `column-data`, lines 480–483: inherited masks make the old
partition range a subspace of every refining stopping-partition range. -/
theorem partitionColumnRange_mono {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {σ π : ColumnStoppingPartition D}
    (href : ColumnPartitionRefines σ π) :
    partitionColumnRange D A π ≤ partitionColumnRange D A σ := by
  classical
  apply iSup_le
  intro d z hz
  have hsum : (∑ c : {c // c ∈ σ.cells}, columnL2Restriction
      (dyadicGridCell D.grid c.val.1 c.val.2)
      (dyadicGridCell_measurable D.grid c.val.1 c.val.2) z) = z :=
    (columnPartition_restriction_sum D σ z).trans
      (cellColumnRange_restrict_superset D A (π.subset d.property)
        (dyadicGridCell_measurable D.grid D.root.1 D.root.2)
        (D.below_root d.val (π.subset d.property)) hz)
  rw [← hsum]
  apply Submodule.sum_mem
  intro c _
  obtain ⟨d', hd', hcd'⟩ := href c.val c.property
  by_cases heq : d' = d.val
  · have hcd : dyadicGridCell D.grid c.val.1 c.val.2 ⊆
        dyadicGridCell D.grid d.val.1 d.val.2 := by simpa only [heq] using hcd'
    exact (le_iSup (fun c : {c // c ∈ σ.cells} => cellColumnRange D A (σ.subset c.property)) c)
      (cellColumnRange_restrict_descendant D A (σ.subset c.property) (π.subset d.property) hcd hz)
  · have hdis : Disjoint (dyadicGridCell D.grid c.val.1 c.val.2)
        (dyadicGridCell D.grid d.val.1 d.val.2) :=
      (π.disjoint hd' d.property heq).mono_left hcd'
    rw [cellColumnRange_restrict_disjoint D A (π.subset d.property)
      (dyadicGridCell_measurable D.grid c.val.1 c.val.2) hdis hz]
    exact Submodule.zero_mem _

/-- The orthogonal projections on refining stopping partitions are nested;
this is derived from the inherited masks, not assumed in the interface. -/
theorem partitionColumnProjection_nested {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {σ π : ColumnStoppingPartition D}
    (href : ColumnPartitionRefines σ π) :
    (partitionColumnProjection D A π).comp (partitionColumnProjection D A σ) =
      partitionColumnProjection D A π :=
  Submodule.starProjection_comp_starProjection_of_le (partitionColumnRange_mono D A href)

/-- Restriction to a measurable decision set is self-adjoint on the
column L2 space. -/
theorem columnL2Restriction_inner {V : Type*} [Fintype V] (s : Set ℝ)
    (hs : MeasurableSet s) (z w : ColumnL2 V) :
    inner ℂ (columnL2Restriction s hs z) w = inner ℂ z (columnL2Restriction s hs w) := by
  classical
  rw [MeasureTheory.L2.inner_def, MeasureTheory.L2.inner_def]
  apply integral_congr_ae
  filter_upwards [columnL2Indicator_coeFn s hs z, columnL2Indicator_coeFn s hs w] with y hz hw
  change inner ℂ ((columnL2Indicator s hs z : ℝ → ColumnHilbert V) y) (w y) =
    inner ℂ (z y) ((columnL2Indicator s hs w : ℝ → ColumnHilbert V) y)
  rw [hz, hw]
  by_cases hy : y ∈ s
  · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy]
  · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy,
      inner_zero_left, inner_zero_right]

/-- Exact output locality of the cell projection. -/
theorem cellColumnProjection_output_locality {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    (columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
      (dyadicGridCell_measurable D.grid c.1 c.2)).comp (cellColumnProjection D A hc) =
        cellColumnProjection D A hc := by
  apply ContinuousLinearMap.ext
  intro z
  exact cellColumnRange_fixed_restriction D A hc (cellColumnProjection_mem D A hc z)

/-- Blueprint `column-data`, line 483: the cell projection is unchanged by
right multiplication by its decision-cell indicator. -/
theorem cellColumnProjection_input_locality {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    (cellColumnProjection D A hc).comp (columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
      (dyadicGridCell_measurable D.grid c.1 c.2)) = cellColumnProjection D A hc := by
  apply ContinuousLinearMap.ext
  intro z
  apply ext_inner_right ℂ
  intro w
  change inner ℂ ((cellColumnRange D A hc).starProjection
      (columnL2Restriction (dyadicGridCell D.grid c.1 c.2)
        (dyadicGridCell_measurable D.grid c.1 c.2) z)) w =
    inner ℂ ((cellColumnRange D A hc).starProjection z) w
  rw [Submodule.inner_starProjection_left_eq_right, Submodule.inner_starProjection_left_eq_right,
    columnL2Restriction_inner, cellColumnRange_fixed_restriction D A hc
      (Submodule.starProjection_apply_mem _ w)]

/-- Fixed row-family interface in blueprint `column-data`, line 483.
The square-sum bound and exact input-cell equation remain explicit data
when later constructions assemble and compose row families. -/
structure ColumnRowFamily {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (ι F : Type*) [Fintype ι] [NormedAddCommGroup F] [NormedSpace ℂ F] where
  decision : ι → ℤ × ℤ
  decision_mem : ∀ i, decision i ∈ D.cells
  row : ι → ColumnL2 V →L[ℂ] F
  bound : ℝ
  bound_nonneg : 0 ≤ bound
  square_sum : ∀ z, ∑ i, ‖row i z‖ ^ 2 ≤ bound ^ 2 * ‖z‖ ^ 2
  input_locality : ∀ i, (row i).comp (columnL2Restriction
    (dyadicGridCell D.grid (decision i).1 (decision i).2)
    (dyadicGridCell_measurable D.grid (decision i).1 (decision i).2)) = row i

/-- Left composition preserves the exact decision-cell locality equation. -/
theorem columnRowFamily_postcompose_locality {V ι F K : Type*} [Fintype V] [Fintype ι]
    [NormedAddCommGroup F] [NormedSpace ℂ F] [NormedAddCommGroup K] [NormedSpace ℂ K]
    (D : ColumnTreeData V) (B : ColumnRowFamily D ι F) (L : ι → F →L[ℂ] K) (i : ι) :
    ((L i).comp (B.row i)).comp (columnL2Restriction
      (dyadicGridCell D.grid (B.decision i).1 (B.decision i).2)
      (dyadicGridCell_measurable D.grid (B.decision i).1 (B.decision i).2)) =
      (L i).comp (B.row i) := by
  rw [ContinuousLinearMap.comp_assoc, B.input_locality]

/-- Euclidean coefficient space for the labels available on a decision cell. -/
abbrev CellCoefficients {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (c : ℤ × ℤ) := EuclideanSpace ℂ {v // v ∈ A.labels c}

open scoped Classical in
/-- Evaluation of a constant-coefficient combination of available columns. -/
noncomputable def columnCombination {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (c : ℤ × ℤ) (a : CellCoefficients D A c) (y : ℝ) :
    ColumnHilbert V :=
  ∑ v : {v // v ∈ A.labels c}, a v • privateColumnValue D.scalar D.privateWeight v y

open scoped Classical in
theorem columnCombination_physical {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (c : ℤ × ℤ) (a : CellCoefficients D A c) (y : ℝ) :
    columnCombination D A c a y none = ∑ v : {v // v ∈ A.labels c}, a v * D.scalar v y := by
  simp [columnCombination, privateColumnValue_physical, smul_eq_mul]

open scoped Classical in
theorem columnCombination_private {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (c : ℤ × ℤ) (a : CellCoefficients D A c) (y : ℝ)
    (w : {v // v ∈ A.labels c}) :
    columnCombination D A c a y (some w.val) = a w * (Real.sqrt (D.privateWeight w) : ℂ) := by
  classical
  simp only [columnCombination, WithLp.ofLp_sum, Finset.sum_apply, WithLp.ofLp_smul,
    Pi.smul_apply, privateColumnValue_private, smul_eq_mul]
  rw [Finset.sum_eq_single w]
  · simp
  · intro v _ hv
    have hne : w.val ≠ v.val := fun h => hv (Subtype.ext h.symm)
    simp only [ite_eq_right hne, mul_zero]
  · simp

open scoped Classical in
/-- The private coordinates alone control the coefficient norm, the lower
bound in blueprint `lem:coeff`, lines 487–491. -/
theorem columnCombination_lower {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) (c : ℤ × ℤ) (a : CellCoefficients D A c) (y : ℝ) :
    D.budget⁻¹ * ‖a‖ ≤ ‖columnCombination D A c a y‖ := by
  classical
  have hD : 0 < D.budget := lt_of_lt_of_le (by norm_num) D.two_le_budget
  have hi : 0 ≤ D.budget⁻¹ := inv_nonneg.mpr hD.le
  let e : {v // v ∈ A.labels c} → Option V := fun v => some v.val
  have he : Function.Injective e := fun v w h => Subtype.ext (Option.some.inj h)
  have hsq : (D.budget⁻¹ * ‖a‖) ^ 2 ≤ ‖columnCombination D A c a y‖ ^ 2 := by
    calc
      _ = ∑ v : {v // v ∈ A.labels c}, (D.budget⁻¹ * ‖a v‖) ^ 2 := by
        rw [mul_pow, EuclideanSpace.norm_sq_eq, Finset.mul_sum]
        exact Finset.sum_congr rfl (fun v _ => (mul_pow _ _ 2).symm)
      _ ≤ ∑ v : {v // v ∈ A.labels c},
          ‖columnCombination D A c a y (some v.val)‖ ^ 2 := by
        apply Finset.sum_le_sum
        intro v _
        rw [columnCombination_private, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (Real.sqrt_nonneg _)]
        have h := mul_le_mul_of_nonneg_right (D.private_lower v) (norm_nonneg (a v))
        have h0 := mul_nonneg hi (norm_nonneg (a v))
        have h1 := mul_nonneg (Real.sqrt_nonneg (D.privateWeight v)) (norm_nonneg (a v))
        nlinarith
      _ = ∑ o ∈ Finset.univ.image e, ‖columnCombination D A c a y o‖ ^ 2 := by
        rw [Finset.sum_image (fun v _ w _ h => he h)]
      _ ≤ ∑ o : Option V, ‖columnCombination D A c a y o‖ ^ 2 :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          (fun _ _ _ => sq_nonneg _)
      _ = _ := (EuclideanSpace.norm_sq_eq _).symm
  exact (sq_le_sq₀ (mul_nonneg hi (norm_nonneg a)) (norm_nonneg _)).mp hsq

open scoped Classical in
theorem columnCombination_upper_of_bound {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    (a : CellCoefficients D A c) (y : ℝ)
    (hcol : ∀ v : {v // v ∈ A.labels c},
      ‖privateColumnValue D.scalar D.privateWeight v y‖ ≤ D.budget) :
    ‖columnCombination D A c a y‖ ≤ (D.budget * Real.sqrt D.budget) * ‖a‖ := by
  classical
  have hD : 0 ≤ D.budget := le_trans (by norm_num) D.two_le_budget
  have hcard : (Fintype.card {v // v ∈ A.labels c} : ℝ) ≤ D.budget := by
    simpa only [Fintype.card_coe] using InheritedColumnMask_card_le D A hc
  have hcs := Real.sum_mul_le_sqrt_mul_sqrt Finset.univ
    (fun v : {v // v ∈ A.labels c} => ‖a v‖) (fun _ => (1 : ℝ))
  simp only [mul_one, one_pow, Finset.sum_const, Finset.card_univ, nsmul_eq_mul] at hcs
  have hsum : ∑ v : {v // v ∈ A.labels c}, ‖a v‖ ≤ Real.sqrt D.budget * ‖a‖ := by
    calc
      _ ≤ Real.sqrt (∑ v, ‖a v‖ ^ 2) * Real.sqrt (Fintype.card {v // v ∈ A.labels c}) := by
        simpa only [mul_one] using hcs
      _ = ‖a‖ * Real.sqrt (Fintype.card {v // v ∈ A.labels c}) := by rw [← EuclideanSpace.norm_eq]
      _ ≤ ‖a‖ * Real.sqrt D.budget :=
        mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hcard) (norm_nonneg a)
      _ = _ := mul_comm _ _
  calc
    _ ≤ ∑ v : {v // v ∈ A.labels c}, ‖a v • privateColumnValue D.scalar D.privateWeight v y‖ :=
      norm_sum_le _ _
    _ = ∑ v : {v // v ∈ A.labels c}, ‖a v‖ *
        ‖privateColumnValue D.scalar D.privateWeight v y‖ :=
      Finset.sum_congr rfl (fun v _ => norm_smul _ _)
    _ ≤ ∑ v : {v // v ∈ A.labels c}, ‖a v‖ * D.budget :=
      Finset.sum_le_sum (fun v _ => mul_le_mul_of_nonneg_left (hcol v) (norm_nonneg _))
    _ = D.budget * ∑ v : {v // v ∈ A.labels c}, ‖a v‖ := by rw [← Finset.sum_mul, mul_comm]
    _ ≤ D.budget * (Real.sqrt D.budget * ‖a‖) := mul_le_mul_of_nonneg_left hsum hD
    _ = _ := (mul_assoc _ _ _).symm

theorem columnBudget_rpow_three_halves {V : Type*} [Fintype V] (D : ColumnTreeData V) :
    D.budget ^ (3 / 2 : ℝ) = D.budget * Real.sqrt D.budget := by
  have hD : 0 < D.budget := lt_of_lt_of_le (by norm_num) D.two_le_budget
  rw [show (3 / 2 : ℝ) = 1 + 1 / 2 by norm_num, Real.rpow_add hD,
    Real.rpow_one, Real.sqrt_eq_rpow]

open scoped Classical in
/-- Blueprint `lem:coeff`, lines 487–491: the two-sided coefficient norm
bound holds uniformly in all coefficients on a common full-measure subset
of the decision cell, using the source essential-supremum convention. -/
theorem columnCombination_bounds {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    ∀ᵐ y ∂volume.restrict (dyadicGridCell D.grid c.1 c.2),
      ∀ a : CellCoefficients D A c,
        D.budget⁻¹ * ‖a‖ ≤ ‖columnCombination D A c a y‖ ∧
        ‖columnCombination D A c a y‖ ≤ D.budget ^ (3 / 2 : ℝ) * ‖a‖ := by
  have hall : ∀ᵐ y ∂volume.restrict (dyadicGridCell D.grid c.1 c.2),
      ∀ v : {v // v ∈ A.labels c},
        ‖privateColumnValue D.scalar D.privateWeight v y‖ ≤ D.budget :=
    ae_all_iff.mpr (fun v => InheritedColumnMask_ae_column_bound D A hc v.property)
  filter_upwards [hall] with y hy
  intro a
  refine ⟨columnCombination_lower D A c a y, ?_⟩
  rw [columnBudget_rpow_three_halves]
  exact columnCombination_upper_of_bound D A hc a y hy

open scoped Classical in
/-- The cell synthesis map used to form the averaged Gram operator in
blueprint `lem:coeff`, line 503. -/
noncomputable def cellColumnSynthesis {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    CellCoefficients D A c →L[ℂ] ColumnL2 V :=
  LinearMap.toContinuousLinearMap
    { toFun := fun a => ∑ v : {v // v ∈ A.labels c}, a v • cellColumnLp D A hc v
      map_add' := by intros; simp [add_smul, Finset.sum_add_distrib]
      map_smul' := by intros; simp [mul_smul, Finset.smul_sum] }

open scoped Classical in
theorem cellColumnSynthesis_coeFn {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    (a : CellCoefficients D A c) :
    (cellColumnSynthesis D A hc a : ℝ → ColumnHilbert V) =ᵐ[volume]
      (dyadicGridCell D.grid c.1 c.2).indicator (columnCombination D A c a) := by
  classical
  have hs := Lp.coeFn_fun_finsetSum Finset.univ
    (fun v : {v // v ∈ A.labels c} => a v • cellColumnLp D A hc v)
  have hm := ae_all_iff.mpr (fun v : {v // v ∈ A.labels c} =>
    Lp.coeFn_smul (a v) (cellColumnLp D A hc v))
  have hv := ae_all_iff.mpr (fun v : {v // v ∈ A.labels c} =>
    cellColumnLp_coeFn D A hc v)
  filter_upwards [hs, hm, hv] with y hys hym hyv
  change (∑ v : {v // v ∈ A.labels c}, a v • cellColumnLp D A hc v) y = _
  rw [hys]
  simp only [hym, Pi.smul_apply, hyv]
  by_cases hy : y ∈ dyadicGridCell D.grid c.1 c.2
  · simp [hy, columnCombination]
  · simp [hy]

/-- The normalized Gram operator is the adjoint-square of cell synthesis,
divided by the cell length. This is the averaged Gram operator of `lem:coeff`. -/
noncomputable def cellColumnGram {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    CellCoefficients D A c →L[ℂ] CellCoefficients D A c :=
  (((dyadicGridLength D.grid c.1)⁻¹ : ℝ) : ℂ) •
    (cellColumnSynthesis D A hc).adjoint.comp (cellColumnSynthesis D A hc)

set_option backward.isDefEq.respectTransparency false in
theorem cellColumnGram_inner {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    (a b : CellCoefficients D A c) :
    inner ℂ a (cellColumnGram D A hc b) =
      (dyadicGridLength D.grid c.1)⁻¹ •
        inner ℂ (cellColumnSynthesis D A hc a) (cellColumnSynthesis D A hc b) := by
  change inner ℂ a
    ((((dyadicGridLength D.grid c.1)⁻¹ : ℝ) : ℂ) •
      (cellColumnSynthesis D A hc).adjoint (cellColumnSynthesis D A hc b)) = _
  rw [inner_smul_right, ContinuousLinearMap.adjoint_inner_right]
  rfl

theorem cellColumnSynthesis_inner_integral {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    (a b : CellCoefficients D A c) :
    inner ℂ (cellColumnSynthesis D A hc a) (cellColumnSynthesis D A hc b) =
      ∫ y in dyadicGridCell D.grid c.1 c.2,
        inner ℂ (columnCombination D A c a y) (columnCombination D A c b y) := by
  rw [MeasureTheory.L2.inner_def, ← integral_indicator (dyadicGridCell_measurable D.grid c.1 c.2)]
  apply integral_congr_ae
  filter_upwards [cellColumnSynthesis_coeFn D A hc a,
    cellColumnSynthesis_coeFn D A hc b] with y ha hb
  rw [ha, hb]
  by_cases hy : y ∈ dyadicGridCell D.grid c.1 c.2 <;> simp [hy]

set_option backward.isDefEq.respectTransparency false in
theorem cellColumnSynthesis_norm_sq_integral {V : Type*} [Fintype V] (D : ColumnTreeData V)
    (A : InheritedColumnMask D) {c : ℤ × ℤ} (hc : c ∈ D.cells)
    (a : CellCoefficients D A c) :
    ‖cellColumnSynthesis D A hc a‖ ^ 2 =
