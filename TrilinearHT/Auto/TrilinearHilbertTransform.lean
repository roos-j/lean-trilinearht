open Polynomial

/-- The derivative-polynomial recurrence in blueprint Lemma `lem:gevrey`. -/
noncomputable def gevreyDerivativePolynomial : ℕ → Polynomial ℝ
  | 0 => 1
  | n + 1 => X ^ 2 * (gevreyDerivativePolynomial n - (gevreyDerivativePolynomial n).derivative)

/-- Blueprint Lemma `lem:gevrey`: the recurrence describes all derivatives,
including at the gluing point and on the negative half-line. -/
theorem iteratedDeriv_expNegInvGlue (n : ℕ) :
    iteratedDeriv n expNegInvGlue =
      fun x => (gevreyDerivativePolynomial n).eval x⁻¹ * expNegInvGlue x := by
  induction n with
  | zero => simp [gevreyDerivativePolynomial, iteratedDeriv_zero]
  | succ n ih =>
    rw [iteratedDeriv_succ, ih]
    funext x
    exact (expNegInvGlue.hasDerivAt_polynomial_eval_inv_mul _ x).deriv

/-- Blueprint Lemma `lem:gevrey`: derivative polynomials have degree at most `2n`. -/
theorem gevreyDerivativePolynomial_natDegree (n : ℕ) :
    (gevreyDerivativePolynomial n).natDegree ≤ 2 * n := by
  induction n with
  | zero => simp [gevreyDerivativePolynomial]
  | succ n ih =>
    have hd := Polynomial.natDegree_derivative_le (gevreyDerivativePolynomial n)
    have hs := Polynomial.natDegree_sub_le
      (gevreyDerivativePolynomial n) (gevreyDerivativePolynomial n).derivative
    have hm := Polynomial.natDegree_mul_le (p := (X ^ 2 : Polynomial ℝ))
      (q := gevreyDerivativePolynomial n - (gevreyDerivativePolynomial n).derivative)
    simp only [Polynomial.natDegree_X_pow] at hm
    change (X ^ 2 * (gevreyDerivativePolynomial n -
      (gevreyDerivativePolynomial n).derivative)).natDegree ≤ 2 * (n + 1)
    omega

/-- Coefficient bound for one step of the source's derivative recurrence. -/
theorem polynomial_derivative_step_coeff_le {p : Polynomial ℝ} {d : ℕ} {M : ℝ}
    (hd : p.natDegree ≤ d) (hM : 0 ≤ M) (hp : ∀ i, |p.coeff i| ≤ M) (i : ℕ) :
    |(X ^ 2 * (p - p.derivative)).coeff i| ≤ (d + 1 : ℝ) * M := by
  rw [Polynomial.coeff_X_pow_mul']
  split_ifs with hi
  · rw [Polynomial.coeff_sub, Polynomial.coeff_derivative]
    have hder : |(i - 2 + 1 : ℕ) * p.coeff (i - 2 + 1)| ≤ (d : ℝ) * M := by
      by_cases hk : i - 2 + 1 ≤ d
      · rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
        exact mul_le_mul (by exact_mod_cast hk) (hp _) (abs_nonneg _) (Nat.cast_nonneg _)
      · have hz : p.coeff (i - 2 + 1) = 0 := Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)
        simp only [hz, mul_zero, abs_zero]
        positivity
    have hsub := abs_sub (p.coeff (i - 2)) ((i - 2 + 1 : ℕ) * p.coeff (i - 2 + 1))
    have := hp (i - 2)
    push_cast at hder hsub
    rw [mul_comm (p.coeff (i - 2 + 1))]
    nlinarith
  · simp only [abs_zero]
    positivity

/-- Blueprint Lemma `lem:gevrey`: a factorial coefficient majorant.
This slightly coarser bound still gives one fixed Gevrey order. -/
theorem gevreyDerivativePolynomial_coeff_le (n i : ℕ) :
    |(gevreyDerivativePolynomial n).coeff i| ≤ ((2 * n).factorial : ℝ) := by
  induction n generalizing i with
  | zero => simp [gevreyDerivativePolynomial, Polynomial.coeff_one]; split_ifs <;> norm_num
  | succ n ih =>
    have h := polynomial_derivative_step_coeff_le (gevreyDerivativePolynomial_natDegree n)
      (show (0 : ℝ) ≤ (2 * n).factorial by positivity) ih i
    change |(X ^ 2 * (gevreyDerivativePolynomial n -
      (gevreyDerivativePolynomial n).derivative)).coeff i| ≤ ((2 * (n + 1)).factorial : ℝ)
    refine h.trans ?_
    have heq : 2 * (n + 1) = (2 * n + 1) + 1 := by omega
    rw [heq, Nat.factorial_succ, Nat.factorial_succ]
    push_cast
    exact le_mul_of_one_le_left (by positivity) (by have := Nat.cast_nonneg (α := ℝ) n; linarith)

/-- The exponential series controls every monomial in a derivative polynomial. -/
theorem monomial_mul_exp_neg_le_factorial {z : ℝ} (hz : 0 ≤ z) (i : ℕ) :
    z ^ i * Real.exp (-z) ≤ (i.factorial : ℝ) := by
  have hi : (0 : ℝ) < i.factorial := by positivity
  have h := (div_le_iff₀ hi).mp (Real.pow_div_factorial_le_exp z hz i)
  calc
    z ^ i * Real.exp (-z) ≤ (Real.exp z * (i.factorial : ℝ)) * Real.exp (-z) := by gcongr
    _ = i.factorial := by rw [mul_right_comm, ← Real.exp_add]; simp

/-- A quantitative derivative bound for the source's smooth gluing function. -/
theorem iteratedDeriv_expNegInvGlue_factorial_bound (n : ℕ) (x : ℝ) :
    |iteratedDeriv n expNegInvGlue x| ≤ (2 * n + 1 : ℝ) * ((2 * n).factorial : ℝ) ^ 2 := by
  rw [iteratedDeriv_expNegInvGlue]
  dsimp only
  by_cases hx : x ≤ 0
  · rw [expNegInvGlue.zero_of_nonpos hx, mul_zero, abs_zero]
    positivity
  have hxpos : 0 < x := lt_of_not_ge hx
  have hz : 0 ≤ x⁻¹ := inv_nonneg.mpr hxpos.le
  have hglue : expNegInvGlue x = Real.exp (-x⁻¹) := by
    simp [expNegInvGlue, hx]
  rw [hglue, abs_mul, abs_of_pos (Real.exp_pos _),
    Polynomial.eval_eq_sum_range' (Nat.lt_succ_of_le (gevreyDerivativePolynomial_natDegree n))]
  calc
    |∑ i ∈ Finset.range (2 * n + 1), (gevreyDerivativePolynomial n).coeff i * (x⁻¹) ^ i| *
        Real.exp (-x⁻¹) ≤
        (∑ i ∈ Finset.range (2 * n + 1),
          |(gevreyDerivativePolynomial n).coeff i * (x⁻¹) ^ i|) * Real.exp (-x⁻¹) := by
      gcongr
      exact Finset.abs_sum_le_sum_abs _ _
    _ = ∑ i ∈ Finset.range (2 * n + 1),
        |(gevreyDerivativePolynomial n).coeff i| * ((x⁻¹) ^ i * Real.exp (-x⁻¹)) := by
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro i hi
      rw [abs_mul, abs_of_nonneg (pow_nonneg hz i)]
      ring
    _ ≤ ∑ _i ∈ Finset.range (2 * n + 1), ((2 * n).factorial : ℝ) ^ 2 := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ 2 * n := by simp only [Finset.mem_range] at hi; omega
      have hf : (i.factorial : ℝ) ≤ (2 * n).factorial := by exact_mod_cast Nat.factorial_le hi'
      calc
        _ ≤ ((2 * n).factorial : ℝ) * (i.factorial : ℝ) :=
          mul_le_mul (gevreyDerivativePolynomial_coeff_le n i)
            (monomial_mul_exp_neg_le_factorial hz i) (by positivity) (by positivity)
        _ ≤ _ := by rw [pow_two]; gcongr
    _ = _ := by simp

/-- Blueprint Lemma `lem:gevrey`: the gluing function has a fixed Gevrey order.
The explicit order four is sufficient for the source's existential fixed-order requirement. -/
theorem iteratedDeriv_expNegInvGlue_gevrey_bound (n : ℕ) (x : ℝ) :
    |iteratedDeriv n expNegInvGlue x| ≤ (4 * ((n : ℝ) + 1)) ^ (4 * (n + 1)) := by
  have hn : 0 ≤ (n : ℝ) := Nat.cast_nonneg _
  have hb : 1 ≤ 4 * ((n : ℝ) + 1) := by linarith
  have hf : ((2 * n).factorial : ℝ) ≤ (4 * ((n : ℝ) + 1)) ^ (2 * n) := by
    calc
      _ ≤ ((2 * n : ℕ) : ℝ) ^ (2 * n) := by exact_mod_cast Nat.factorial_le_pow (2 * n)
      _ ≤ _ := by push_cast; gcongr <;> linarith
  calc
    _ ≤ (2 * n + 1 : ℝ) * ((2 * n).factorial : ℝ) ^ 2 :=
      iteratedDeriv_expNegInvGlue_factorial_bound n x
    _ ≤ (4 * ((n : ℝ) + 1)) * ((4 * ((n : ℝ) + 1)) ^ (2 * n)) ^ 2 := by
      gcongr
      linarith
    _ = (4 * ((n : ℝ) + 1)) ^ (4 * n + 1) := by
      rw [← pow_mul, show 2 * n * 2 = 4 * n by omega, pow_succ]
      ring
    _ ≤ _ := pow_le_pow_right₀ hb (by omega)

/-- The compact bump `g(x)g(1-x)` in blueprint Lemma `lem:gevrey`. -/
noncomputable def gevreyBump (x : ℝ) : ℝ := expNegInvGlue x * expNegInvGlue (1 - x)

theorem gevreyBump_nonneg (x : ℝ) : 0 ≤ gevreyBump x :=
  mul_nonneg (expNegInvGlue.nonneg x) (expNegInvGlue.nonneg (1 - x))

theorem gevreyBump_pos {x : ℝ} (hx : x ∈ Set.Ioo (0 : ℝ) 1) : 0 < gevreyBump x :=
  mul_pos (expNegInvGlue.pos_of_pos hx.1) (expNegInvGlue.pos_of_pos (sub_pos.mpr hx.2))

theorem gevreyBump_zero {x : ℝ} (hx : x ∉ Set.Ioo (0 : ℝ) 1) : gevreyBump x = 0 := by
  by_cases h : x ≤ 0
  · simp [gevreyBump, expNegInvGlue.zero_of_nonpos h]
  · have h' : 1 ≤ x := by
      simp only [Set.mem_Ioo, not_and_or, not_lt] at hx
      rcases hx with hx | hx <;> linarith
    simp [gevreyBump, expNegInvGlue.zero_of_nonpos (show 1 - x ≤ 0 by linarith)]

theorem gevreyBump_contDiff {n : ℕ∞} : ContDiff ℝ n gevreyBump := by
  exact expNegInvGlue.contDiff.mul
    (expNegInvGlue.contDiff.comp (contDiff_const.sub contDiff_id))

theorem gevreyBump_hasCompactSupport : HasCompactSupport gevreyBump := by
  apply HasCompactSupport.intro (K := Set.Icc (0 : ℝ) 1) isCompact_Icc
  intro x hx
  exact gevreyBump_zero (fun h => hx ⟨h.1.le, h.2.le⟩)

/-- Blueprint Lemma `lem:gevrey`: a compact positive bump with a fixed all-orders bound. -/
theorem iteratedDeriv_gevreyBump_bound (n : ℕ) (x : ℝ) :
    |iteratedDeriv n gevreyBump x| ≤ (8 * ((n : ℝ) + 1)) ^ (8 * (n + 1)) := by
  let B : ℝ := 8 * ((n : ℝ) + 1)
  have hB : 1 ≤ B := by dsimp [B]; have := Nat.cast_nonneg (α := ℝ) n; linarith
  have hder (i : ℕ) (hi : i ≤ n) (y : ℝ) :
      |iteratedDeriv i expNegInvGlue y| ≤ B ^ (4 * (i + 1)) := by
    refine (iteratedDeriv_expNegInvGlue_gevrey_bound i y).trans ?_
    apply pow_le_pow_left₀ (by positivity)
    dsimp [B]
    have hi' : (i : ℝ) ≤ n := by exact_mod_cast hi
    have := Nat.cast_nonneg (α := ℝ) n
    linarith
  have hrefl (i : ℕ) :
      |iteratedDeriv i (fun y : ℝ => expNegInvGlue (1 - y)) x| =
        |iteratedDeriv i expNegInvGlue (1 - x)| := by
    simp [iteratedDeriv_comp_const_sub, abs_mul, abs_pow]
  have hleft : ContDiffAt ℝ n expNegInvGlue x := expNegInvGlue.contDiff.contDiffAt
  have hright : ContDiffAt ℝ n (fun y : ℝ => expNegInvGlue (1 - y)) x := by
    fun_prop
  change |iteratedDeriv n (fun y => expNegInvGlue y * expNegInvGlue (1 - y)) x| ≤ _
  rw [iteratedDeriv_fun_mul hleft hright]
  calc
    _ ≤ ∑ i ∈ Finset.range (n + 1),
        |(n.choose i : ℝ) * iteratedDeriv i expNegInvGlue x *
          iteratedDeriv (n - i) (fun y : ℝ => expNegInvGlue (1 - y)) x| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * B ^ (4 * (n + 2)) := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ n := by simp only [Finset.mem_range] at hi; omega
      rw [abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _), hrefl]
      calc
        _ ≤ (n.choose i : ℝ) * B ^ (4 * (i + 1)) * B ^ (4 * (n - i + 1)) := by
          gcongr
          · exact hder i hi' x
          · exact hder (n - i) (Nat.sub_le _ _) (1 - x)
        _ = _ := by
          rw [mul_assoc, ← pow_add]
          congr 2
          omega
    _ = (2 : ℝ) ^ n * B ^ (4 * (n + 2)) := by
      rw [← Finset.sum_mul]
      congr 1
      exact_mod_cast Nat.sum_range_choose n
    _ ≤ B ^ n * B ^ (4 * (n + 2)) := by
      gcongr
      dsimp [B]
      have := Nat.cast_nonneg (α := ℝ) n
      linarith
    _ ≤ B ^ (8 * (n + 1)) := by
      rw [← pow_add]
      apply pow_le_pow_right₀ hB
      omega

open MeasureTheory

/-- The positive normalization constant for the bump in blueprint Lemma `lem:gevrey`. -/
noncomputable def gevreyBumpIntegral : ℝ := ∫ x : ℝ, gevreyBump x

theorem gevreyBump_integrable : Integrable gevreyBump :=
  (gevreyBump_contDiff (n := 0)).continuous.integrable_of_hasCompactSupport
    gevreyBump_hasCompactSupport

theorem gevreyBumpIntegral_pos : 0 < gevreyBumpIntegral := by
  exact integral_pos_of_integrable_nonneg_nonzero
    (gevreyBump_contDiff (n := 0)).continuous gevreyBump_integrable
    gevreyBump_nonneg (ne_of_gt (gevreyBump_pos (x := 1 / 2) (by constructor <;> norm_num)))

/-- The normalized positive bump in blueprint Lemma `lem:gevrey`. -/
noncomputable def gevreyDensity (x : ℝ) : ℝ := gevreyBump x / gevreyBumpIntegral

theorem gevreyDensity_nonneg (x : ℝ) : 0 ≤ gevreyDensity x :=
  div_nonneg (gevreyBump_nonneg x) gevreyBumpIntegral_pos.le

theorem gevreyDensity_contDiff {n : ℕ∞} : ContDiff ℝ n gevreyDensity :=
  gevreyBump_contDiff.div_const _

theorem gevreyDensity_integrable : Integrable gevreyDensity :=
  gevreyBump_integrable.div_const _

theorem gevreyDensity_integral : ∫ x : ℝ, gevreyDensity x = 1 := by
  simp only [gevreyDensity, integral_div]
  exact div_self gevreyBumpIntegral_pos.ne'

theorem gevreyDensity_zero {x : ℝ} (hx : x ∉ Set.Ioo (0 : ℝ) 1) : gevreyDensity x = 0 := by
  simp [gevreyDensity, gevreyBump_zero hx]

/-- Blueprint Lemma `lem:gevrey`: normalization costs one fixed positive factor. -/
theorem iteratedDeriv_gevreyDensity_bound (n : ℕ) (x : ℝ) :
    |iteratedDeriv n gevreyDensity x| ≤
      gevreyBumpIntegral⁻¹ * (8 * ((n : ℝ) + 1)) ^ (8 * (n + 1)) := by
  have heq : gevreyDensity = fun y => gevreyBump y * gevreyBumpIntegral⁻¹ := by
    funext y
    exact div_eq_mul_inv _ _
  rw [heq, iteratedDeriv_mul_const_field, abs_mul, abs_of_pos (inv_pos.mpr gevreyBumpIntegral_pos)]
  simpa [mul_comm] using mul_le_mul_of_nonneg_right
    (iteratedDeriv_gevreyBump_bound n x) (inv_nonneg.mpr gevreyBumpIntegral_pos.le)

/-- The smooth increasing step obtained by integrating the probability bump. -/
noncomputable def gevreyStep (x : ℝ) : ℝ := ∫ t in (0 : ℝ)..x, gevreyDensity t

theorem gevreyStep_hasDerivAt (x : ℝ) : HasDerivAt gevreyStep (gevreyDensity x) x := by
  exact ((gevreyDensity_contDiff (n := 0)).continuous.integral_hasStrictDerivAt 0 x).hasDerivAt

theorem gevreyStep_deriv : deriv gevreyStep = gevreyDensity := by
  funext x
  exact (gevreyStep_hasDerivAt x).deriv

theorem gevreyStep_contDiff (n : ℕ) : ContDiff ℝ n gevreyStep := by
  have hd : Differentiable ℝ gevreyStep := fun x => (gevreyStep_hasDerivAt x).differentiableAt
  cases n with
  | zero => exact contDiff_zero.mpr hd.continuous
  | succ n =>
    rw [show ((n + 1 : ℕ) : WithTop ℕ∞) = n + 1 from rfl]
    apply contDiff_succ_iff_deriv.mpr
    refine ⟨hd, by simp, ?_⟩
    rw [gevreyStep_deriv]
    exact gevreyDensity_contDiff

theorem iteratedDeriv_gevreyStep_succ (n : ℕ) :
    iteratedDeriv (n + 1) gevreyStep = iteratedDeriv n gevreyDensity := by
  rw [iteratedDeriv_succ', gevreyStep_deriv]

theorem gevreyStep_zero {x : ℝ} (hx : x ≤ 0) : gevreyStep x = 0 := by
  unfold gevreyStep
  calc
    _ = ∫ _t in (0 : ℝ)..x, (0 : ℝ) := by
      apply intervalIntegral.integral_congr
      intro t ht
      rw [Set.uIcc_of_ge hx] at ht
      have ht0 : t ≤ 0 := ht.2
      exact gevreyDensity_zero (fun h => (not_lt_of_ge ht0) h.1)
    _ = 0 := by simp

theorem gevreyStep_one {x : ℝ} (hx : 1 ≤ x) : gevreyStep x = 1 := by
  unfold gevreyStep
  rw [intervalIntegral.integral_eq_integral_of_support_subset, gevreyDensity_integral]
  intro t ht
  have ht' : t ∈ Set.Ioo (0 : ℝ) 1 := by
    by_contra h
    exact ht (gevreyDensity_zero h)
  exact ⟨ht'.1, ht'.2.le.trans hx⟩

theorem gevreyStep_monotone : Monotone gevreyStep :=
  monotone_of_hasDerivAt_nonneg gevreyStep_hasDerivAt gevreyDensity_nonneg

theorem gevreyStep_mem_Icc (x : ℝ) : gevreyStep x ∈ Set.Icc (0 : ℝ) 1 := by
  constructor
  · by_cases hx : x ≤ 0
    · rw [gevreyStep_zero hx]
    · have := gevreyStep_monotone (le_of_not_ge hx)
      simpa [gevreyStep_zero (le_refl (0 : ℝ))] using this
  · by_cases hx : 1 ≤ x
    · rw [gevreyStep_one hx]
    · have := gevreyStep_monotone (le_of_not_ge hx)
      simpa [gevreyStep_one (le_refl (1 : ℝ))] using this

/-- The compact partition function from blueprint Lemma `lem:gevrey`, expressed
as a difference of antiderivatives, equivalently as convolution with an interval. -/
noncomputable def gevreyPartition (x : ℝ) : ℝ :=
  gevreyStep (2 * x + 3 / 2) - gevreyStep (2 * x - 1 / 2)

theorem gevreyPartition_nonneg (x : ℝ) : 0 ≤ gevreyPartition x := by
  exact sub_nonneg.mpr (gevreyStep_monotone (by linarith))

theorem gevreyPartition_le_one (x : ℝ) : gevreyPartition x ≤ 1 := by
  have h₁ := (gevreyStep_mem_Icc (2 * x + 3 / 2)).2
  have h₂ := (gevreyStep_mem_Icc (2 * x - 1 / 2)).1
  dsimp [gevreyPartition]
  linarith

theorem gevreyPartition_zero_left {x : ℝ} (hx : x ≤ -(3 / 4)) : gevreyPartition x = 0 := by
  rw [gevreyPartition, gevreyStep_zero (show 2 * x + 3 / 2 ≤ 0 by linarith),
    gevreyStep_zero (show 2 * x - 1 / 2 ≤ 0 by linarith), sub_self]

theorem gevreyPartition_zero_right {x : ℝ} (hx : 3 / 4 ≤ x) : gevreyPartition x = 0 := by
  rw [gevreyPartition, gevreyStep_one (show 1 ≤ 2 * x + 3 / 2 by linarith),
    gevreyStep_one (show 1 ≤ 2 * x - 1 / 2 by linarith), sub_self]

theorem gevreyPartition_contDiff (n : ℕ) : ContDiff ℝ n gevreyPartition := by
  exact ((gevreyStep_contDiff n).comp ((contDiff_const.mul contDiff_id).add contDiff_const)).sub
    ((gevreyStep_contDiff n).comp ((contDiff_const.mul contDiff_id).sub contDiff_const))

theorem gevreyPartition_tsupport_subset :
    tsupport gevreyPartition ⊆ Set.Icc (-(3 / 4) : ℝ) (3 / 4) := by
  apply closure_minimal _ isClosed_Icc
  intro x hx
  constructor
  · by_contra h
    exact hx (gevreyPartition_zero_left (le_of_not_ge h))
  · by_contra h
    exact hx (gevreyPartition_zero_right (le_of_not_ge h))

theorem gevreyPartition_hasCompactSupport : HasCompactSupport gevreyPartition :=
  isCompact_Icc.of_isClosed_subset (isClosed_tsupport _) gevreyPartition_tsupport_subset

theorem gevreyPartition_tsupport_subset_open :
    tsupport gevreyPartition ⊆ Set.Ioo (-1 : ℝ) 1 := by
  intro x hx
  have := gevreyPartition_tsupport_subset hx
  constructor <;> linarith [this.1, this.2]

/-- The two nonzero possible translates telescope on a fundamental interval. -/
theorem gevreyPartition_add_shift {x : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    gevreyPartition x + gevreyPartition (x - 1) = 1 := by
  unfold gevreyPartition
  rw [show 2 * (x - 1) + 3 / 2 = 2 * x - 1 / 2 by ring]
  rw [gevreyStep_one (show 1 ≤ 2 * x + 3 / 2 by linarith [hx.1]),
    gevreyStep_zero (show 2 * (x - 1) - 1 / 2 ≤ 0 by linarith [hx.2])]
  ring

/-- Blueprint Lemma `lem:gevrey`: the integer translates sum exactly to one. -/
theorem gevreyPartition_tsum (x : ℝ) : ∑' k : ℤ, gevreyPartition (x - k) = 1 := by
  let k : ℤ := ⌊x⌋
  have hk : (k : ℝ) ≤ x := Int.floor_le x
  have hk' : x < (k : ℝ) + 1 := Int.lt_floor_add_one x
  have hsum : (∑' j : ℤ, gevreyPartition (x - j)) =
      ∑ j ∈ ({k, k + 1} : Finset ℤ), gevreyPartition (x - j) := by
    apply tsum_eq_sum
    intro j hj
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hj
    rcases lt_or_ge j k with h | h
    · apply gevreyPartition_zero_right
      have h' : (j : ℝ) + 1 ≤ k := by exact_mod_cast h
      linarith
    · apply gevreyPartition_zero_left
      have h' : k + 2 ≤ j := by omega
      have h'' : (k : ℝ) + 2 ≤ j := by exact_mod_cast h'
      linarith
  rw [hsum]
  have hne : k ≠ k + 1 := by omega
  rw [Finset.sum_pair hne]
  simp only [Int.cast_add, Int.cast_one]
  rw [show x - ((k : ℝ) + 1) = (x - k) - 1 by ring]
  exact gevreyPartition_add_shift ⟨by linarith, by linarith⟩

/-- Affine rescaling multiplies the `n`th derivative by the `n`th power of the slope. -/
theorem iteratedDeriv_affine (n : ℕ) {f : ℝ → ℝ} (hf : ContDiff ℝ n f) (c a : ℝ) :
    iteratedDeriv n (fun x => f (c * x + a)) =
      fun x => c ^ n * iteratedDeriv n f (c * x + a) := by
  have ht : ContDiff ℝ n (fun x => f (x + a)) := hf.comp (contDiff_id.add contDiff_const)
  have h := iteratedDeriv_comp_const_mul ht c
  simpa only [iteratedDeriv_comp_add_const] using h

/-- The source's normalized step inherits quantitative derivative bounds. -/
theorem iteratedDeriv_gevreyStep_bound (n : ℕ) (x : ℝ) :
    |iteratedDeriv n gevreyStep x| ≤ max 1 gevreyBumpIntegral⁻¹ *
      (8 * ((n : ℝ) + 1)) ^ (8 * (n + 1)) := by
  have hK : 1 ≤ max 1 gevreyBumpIntegral⁻¹ := le_max_left _ _
  cases n with
  | zero =>
    simp only [iteratedDeriv_zero, Nat.cast_zero, zero_add]
    have hx := gevreyStep_mem_Icc x
    rw [abs_of_nonneg hx.1]
    norm_num
    nlinarith [hx.2]
  | succ n =>
    rw [iteratedDeriv_gevreyStep_succ]
    refine (iteratedDeriv_gevreyDensity_bound n x).trans ?_
    have hpow : (8 * ((n : ℝ) + 1)) ^ (8 * (n + 1)) ≤
        (8 * (((n + 1 : ℕ) : ℝ) + 1)) ^ (8 * (n + 1 + 1)) := by
      calc
        _ ≤ (8 * (((n + 1 : ℕ) : ℝ) + 1)) ^ (8 * (n + 1)) := by
          gcongr
          norm_num
        _ ≤ _ := by
          apply pow_le_pow_right₀
          · push_cast; have := Nat.cast_nonneg (α := ℝ) n; linarith
          · omega
    exact mul_le_mul (le_max_right _ _) hpow (by positivity) (by linarith)

/-- Blueprint Lemma `lem:gevrey`: the partition has one fixed Gevrey order. -/
theorem iteratedDeriv_gevreyPartition_bound (n : ℕ) (x : ℝ) :
    |iteratedDeriv n gevreyPartition x| ≤ (2 * max 1 gevreyBumpIntegral⁻¹) *
      (8 * ((n : ℝ) + 1)) ^ (9 * (n + 1)) := by
  let B : ℝ := 8 * ((n : ℝ) + 1)
  let K : ℝ := max 1 gevreyBumpIntegral⁻¹
  have hB : 2 ≤ B := by dsimp [B]; have := Nat.cast_nonneg (α := ℝ) n; linarith
  have hK : 0 ≤ K := by dsimp [K]; have := le_max_left (1 : ℝ) gevreyBumpIntegral⁻¹; linarith
  have h₁ : ContDiffAt ℝ n (fun y => gevreyStep (2 * y + 3 / 2)) x := by
    exact ((gevreyStep_contDiff n).comp
      ((contDiff_const.mul contDiff_id).add contDiff_const)).contDiffAt
  have h₂ : ContDiffAt ℝ n (fun y => gevreyStep (2 * y + -(1 / 2))) x := by
    exact ((gevreyStep_contDiff n).comp
      ((contDiff_const.mul contDiff_id).add contDiff_const)).contDiffAt
  have heq : gevreyPartition = fun y =>
      gevreyStep (2 * y + 3 / 2) - gevreyStep (2 * y + -(1 / 2)) := by
    funext y
    simp only [gevreyPartition, sub_eq_add_neg]
  rw [heq, iteratedDeriv_fun_sub h₁ h₂,
    iteratedDeriv_affine n (gevreyStep_contDiff n),
    iteratedDeriv_affine n (gevreyStep_contDiff n)]
  dsimp only
  calc
    _ ≤ |(2 : ℝ) ^ n * iteratedDeriv n gevreyStep (2 * x + 3 / 2)| +
        |(2 : ℝ) ^ n * iteratedDeriv n gevreyStep (2 * x + -(1 / 2))| := abs_sub _ _
    _ ≤ (2 : ℝ) ^ n * (K * B ^ (8 * (n + 1))) +
        (2 : ℝ) ^ n * (K * B ^ (8 * (n + 1))) := by
      simp only [abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ 2 ^ n)]
      gcongr <;> exact iteratedDeriv_gevreyStep_bound n _
    _ ≤ (2 * K) * B ^ (9 * (n + 1)) := by
      calc
        _ = (2 * K) * ((2 : ℝ) ^ n * B ^ (8 * (n + 1))) := by ring
        _ ≤ (2 * K) * (B ^ n * B ^ (8 * (n + 1))) := by gcongr
        _ ≤ _ := by
          rw [← pow_add]
          gcongr
          · linarith
          · omega

/-- Cutoff for `[b,c]` with support strictly inside `(a,d)`, from the source's step construction. -/
noncomputable def gevreyIntervalCutoff (a b c d x : ℝ) : ℝ :=
  gevreyStep ((2 * x - a - b) / (b - a)) * gevreyStep ((c + d - 2 * x) / (d - c))

theorem gevreyIntervalCutoff_mem_Icc (a b c d x : ℝ) :
    gevreyIntervalCutoff a b c d x ∈ Set.Icc (0 : ℝ) 1 := by
  have h₁ := gevreyStep_mem_Icc ((2 * x - a - b) / (b - a))
  have h₂ := gevreyStep_mem_Icc ((c + d - 2 * x) / (d - c))
  refine ⟨mul_nonneg h₁.1 h₂.1, ?_⟩
  calc
    _ ≤ 1 * gevreyStep ((c + d - 2 * x) / (d - c)) :=
      mul_le_mul_of_nonneg_right h₁.2 h₂.1
    _ ≤ 1 := by simpa using h₂.2

theorem gevreyIntervalCutoff_eq_one {a b c d x : ℝ} (hab : a < b) (hcd : c < d)
    (hx : x ∈ Set.Icc b c) : gevreyIntervalCutoff a b c d x = 1 := by
  have h₁ : 1 ≤ (2 * x - a - b) / (b - a) := by
    apply (le_div_iff₀ (sub_pos.mpr hab)).mpr
    linarith [hx.1]
  have h₂ : 1 ≤ (c + d - 2 * x) / (d - c) := by
    apply (le_div_iff₀ (sub_pos.mpr hcd)).mpr
    linarith [hx.2]
  rw [gevreyIntervalCutoff, gevreyStep_one h₁, gevreyStep_one h₂, mul_one]

theorem gevreyIntervalCutoff_contDiff (n : ℕ) (a b c d : ℝ) :
    ContDiff ℝ n (gevreyIntervalCutoff a b c d) := by
  apply ContDiff.mul
  · exact (gevreyStep_contDiff n).comp
      ((((contDiff_const.mul contDiff_id).sub contDiff_const).sub contDiff_const).div_const _)
  · exact (gevreyStep_contDiff n).comp
      ((contDiff_const.sub (contDiff_const.mul contDiff_id)).div_const _)

theorem gevreyIntervalCutoff_zero_left {a b c d x : ℝ} (hab : a < b)
    (hx : x ≤ (a + b) / 2) : gevreyIntervalCutoff a b c d x = 0 := by
  have h₁ : (2 * x - a - b) / (b - a) ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg (by linarith) (sub_pos.mpr hab).le
  rw [gevreyIntervalCutoff, gevreyStep_zero h₁, zero_mul]

theorem gevreyIntervalCutoff_zero_right {a b c d x : ℝ} (hcd : c < d)
    (hx : (c + d) / 2 ≤ x) : gevreyIntervalCutoff a b c d x = 0 := by
  have h₂ : (c + d - 2 * x) / (d - c) ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg (by linarith) (sub_pos.mpr hcd).le
  rw [gevreyIntervalCutoff, gevreyStep_zero h₂, mul_zero]

theorem gevreyIntervalCutoff_tsupport_subset {a b c d : ℝ} (hab : a < b) (hcd : c < d) :
    tsupport (gevreyIntervalCutoff a b c d) ⊆ Set.Icc ((a + b) / 2) ((c + d) / 2) := by
  apply closure_minimal _ isClosed_Icc
  intro x hx
  constructor
  · by_contra h
    exact hx (gevreyIntervalCutoff_zero_left hab (le_of_not_ge h))
  · by_contra h
    exact hx (gevreyIntervalCutoff_zero_right hcd (le_of_not_ge h))

theorem gevreyIntervalCutoff_hasCompactSupport {a b c d : ℝ} (hab : a < b) (hcd : c < d) :
    HasCompactSupport (gevreyIntervalCutoff a b c d) :=
  isCompact_Icc.of_isClosed_subset (isClosed_tsupport _)
    (gevreyIntervalCutoff_tsupport_subset hab hcd)

theorem gevreyIntervalCutoff_tsupport_subset_open {a b c d : ℝ} (hab : a < b) (hcd : c < d) :
    tsupport (gevreyIntervalCutoff a b c d) ⊆ Set.Ioo a d := by
  intro x hx
  have := gevreyIntervalCutoff_tsupport_subset hab hcd hx
  constructor <;> linarith [this.1, this.2]

/-- Quantitative Leibniz rule for derivative bounds of geometric form. -/
theorem iteratedDeriv_mul_geometric_bound {n : ℕ} {f g : ℝ → ℝ} {x A B R : ℝ}
    (hf : ContDiffAt ℝ n f x) (hg : ContDiffAt ℝ n g x)
    (hA : 0 ≤ A) (_hB : 0 ≤ B) (hR : 0 ≤ R)
    (hfi : ∀ i ≤ n, |iteratedDeriv i f x| ≤ A * R ^ i)
    (hgi : ∀ i ≤ n, |iteratedDeriv i g x| ≤ B * R ^ i) :
    |iteratedDeriv n (fun y => f y * g y) x| ≤ A * B * (2 * R) ^ n := by
  rw [iteratedDeriv_fun_mul hf hg]
  calc
    _ ≤ ∑ i ∈ Finset.range (n + 1),
        |(n.choose i : ℝ) * iteratedDeriv i f x * iteratedDeriv (n - i) g x| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (A * B * R ^ n) := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ n := by simp only [Finset.mem_range] at hi; omega
      rw [abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
      calc
        _ ≤ (n.choose i : ℝ) * (A * R ^ i) * (B * R ^ (n - i)) := by
          gcongr
          · exact hfi i hi'
          · exact hgi (n - i) (Nat.sub_le _ _)
        _ = _ := by
          have hp : R ^ i * R ^ (n - i) = R ^ n := by
            rw [← pow_add, Nat.add_sub_of_le hi']
          calc
            _ = (n.choose i : ℝ) * (A * B * (R ^ i * R ^ (n - i))) := by ring
            _ = _ := by rw [hp]
    _ = (2 : ℝ) ^ n * (A * B * R ^ n) := by
      rw [← Finset.sum_mul]
      congr 1
      exact_mod_cast Nat.sum_range_choose n
    _ = _ := by rw [mul_pow]; ring

/-- Derivatives of an affine step, uniformly over orders up to a fixed `n`. -/
theorem iteratedDeriv_affine_step_bound {n i : ℕ} (hi : i ≤ n)
    (c a x S : ℝ) (hS : 0 ≤ S) (hc : |c| ≤ S) :
    |iteratedDeriv i (fun y => gevreyStep (c * y + a)) x| ≤
      (max 1 gevreyBumpIntegral⁻¹ * (8 * ((n : ℝ) + 1)) ^ (8 * (n + 1))) * S ^ i := by
  rw [iteratedDeriv_affine i (gevreyStep_contDiff i), abs_mul, abs_pow]
  have hi' : (i : ℝ) ≤ n := by exact_mod_cast hi
  have hpow : (8 * ((i : ℝ) + 1)) ^ (8 * (i + 1)) ≤
      (8 * ((n : ℝ) + 1)) ^ (8 * (n + 1)) := by
    calc
      _ ≤ (8 * ((n : ℝ) + 1)) ^ (8 * (i + 1)) := by gcongr
      _ ≤ _ := by
        apply pow_le_pow_right₀
        · have := Nat.cast_nonneg (α := ℝ) n; linarith
        · omega
  calc
    _ ≤ S ^ i * (max 1 gevreyBumpIntegral⁻¹ *
        (8 * ((i : ℝ) + 1)) ^ (8 * (i + 1))) := by
      gcongr
      exact iteratedDeriv_gevreyStep_bound i _
    _ ≤ _ := by
      rw [mul_comm (S ^ i)]
      gcongr

/-- Blueprint Lemma `lem:gevrey`: explicit derivative bound for interval cutoffs.
The interval dependence is isolated in the maximum of the two transition slopes. -/
theorem iteratedDeriv_gevreyIntervalCutoff_bound (n : ℕ) (a b c d x : ℝ) :
    |iteratedDeriv n (gevreyIntervalCutoff a b c d) x| ≤
      (max 1 gevreyBumpIntegral⁻¹) ^ 2 *
      (8 * ((n : ℝ) + 1)) ^ (16 * (n + 1)) *
      (2 * max |2 / (b - a)| |(-2) / (d - c)|) ^ n := by
  let S := max |2 / (b - a)| |(-2) / (d - c)|
  let A := max 1 gevreyBumpIntegral⁻¹ * (8 * ((n : ℝ) + 1)) ^ (8 * (n + 1))
  have hS : 0 ≤ S := (abs_nonneg _).trans (le_max_left _ _)
  have hA : 0 ≤ A := by dsimp [A]; positivity
  have heq : gevreyIntervalCutoff a b c d = fun y =>
      gevreyStep ((2 / (b - a)) * y + (-a - b) / (b - a)) *
      gevreyStep (((-2) / (d - c)) * y + (c + d) / (d - c)) := by
    funext y
    unfold gevreyIntervalCutoff
    congr 1 <;> congr 1 <;> ring
  rw [heq]
  have hf : ContDiffAt ℝ n (fun y => gevreyStep ((2 / (b - a)) * y + (-a - b) / (b - a))) x :=
    ((gevreyStep_contDiff n).comp ((contDiff_const.mul contDiff_id).add contDiff_const)).contDiffAt
  have hg : ContDiffAt ℝ n (fun y => gevreyStep (((-2) / (d - c)) * y + (c + d) / (d - c))) x :=
    ((gevreyStep_contDiff n).comp ((contDiff_const.mul contDiff_id).add contDiff_const)).contDiffAt
  have h := iteratedDeriv_mul_geometric_bound hf hg hA hA hS
    (fun i hi => iteratedDeriv_affine_step_bound hi _ _ x S hS (le_max_left _ _))
    (fun i hi => iteratedDeriv_affine_step_bound hi _ _ x S hS (le_max_right _ _))
  convert h using 1
  dsimp [A, S]
  rw [← pow_two, mul_pow (max 1 gevreyBumpIntegral⁻¹)
    ((8 * ((n : ℝ) + 1)) ^ (8 * (n + 1))) 2, ← pow_mul]
  rw [show 8 * (n + 1) * 2 = 16 * (n + 1) by omega]

/-- Fixed scalar and rescaling factors can be absorbed in one Gevrey constant. -/
theorem absorb_gevrey_constants {A R : ℝ} (_hA : 0 ≤ A) (hR : 0 ≤ R) (s : ℕ) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ n : ℕ,
      A * R ^ n * (8 * ((n : ℝ) + 1)) ^ (s * (n + 1)) ≤
        ((C : ℝ) * ((n : ℝ) + 1)) ^ (C * (n + 1)) := by
  let C : ℕ := s + 9 + ⌈A⌉₊ + ⌈R⌉₊
  have hC : 1 ≤ C := by dsimp [C]; omega
  have hC8 : (8 : ℝ) ≤ C := by exact_mod_cast (show 8 ≤ C by dsimp [C]; omega)
  have hAC : A ≤ C := (Nat.le_ceil A).trans (by exact_mod_cast (show ⌈A⌉₊ ≤ C by dsimp [C]; omega))
  have hRC : R ≤ C := (Nat.le_ceil R).trans (by exact_mod_cast (show ⌈R⌉₊ ≤ C by dsimp [C]; omega))
  refine ⟨C, hC, ?_⟩
  intro n
  let B : ℝ := (C : ℝ) * ((n : ℝ) + 1)
  have hn : 0 ≤ (n : ℝ) := Nat.cast_nonneg _
  have hCB : (C : ℝ) ≤ B := by dsimp [B]; nlinarith
  have hB : 1 ≤ B := by linarith
  calc
    _ ≤ B * B ^ n * B ^ (s * (n + 1)) := by
      gcongr
      · exact hAC.trans hCB
      · exact hRC.trans hCB
      · dsimp [B]; gcongr
    _ = B ^ (n + 1 + s * (n + 1)) := by rw [pow_add, pow_succ]; ring
    _ ≤ _ := by
      apply pow_le_pow_right₀ hB
      have hs : s + 1 ≤ C := by dsimp [C]; omega
      nlinarith

/-- The precise fixed-order Gevrey assertion for the partition in the blueprint. -/
theorem gevreyPartition_exists_derivative_bound :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ (n : ℕ) (x : ℝ),
      |iteratedDeriv n gevreyPartition x| ≤
        ((C : ℝ) * ((n : ℝ) + 1)) ^ (C * (n + 1)) := by
  have hK : 0 ≤ 2 * max 1 gevreyBumpIntegral⁻¹ := by positivity
  obtain ⟨C, hC, h⟩ := absorb_gevrey_constants hK (show (0 : ℝ) ≤ 1 by norm_num) 9
  refine ⟨C, hC, fun n x => (iteratedDeriv_gevreyPartition_bound n x).trans ?_⟩
  simpa using h n

/-- The precise fixed-order Gevrey assertion for arbitrary interval cutoffs. -/
theorem gevreyIntervalCutoff_exists_derivative_bound (a b c d : ℝ) :
    ∃ C : ℕ, 1 ≤ C ∧ ∀ (n : ℕ) (x : ℝ),
      |iteratedDeriv n (gevreyIntervalCutoff a b c d) x| ≤
        ((C : ℝ) * ((n : ℝ) + 1)) ^ (C * (n + 1)) := by
  have hA : 0 ≤ (max 1 gevreyBumpIntegral⁻¹) ^ 2 := sq_nonneg _
  have hR : 0 ≤ 2 * max |2 / (b - a)| |(-2) / (d - c)| := by positivity
  obtain ⟨C, hC, h⟩ := absorb_gevrey_constants hA hR 16
  refine ⟨C, hC, fun n x => (iteratedDeriv_gevreyIntervalCutoff_bound n a b c d x).trans ?_⟩
  simpa [mul_assoc, mul_left_comm, mul_comm] using h n

/-- Coordinate differentiation, for the mixed partial bounds in blueprint Lemma `lem:gevrey`. -/
noncomputable def coordinateDeriv {ι : Type*} [DecidableEq ι]
    (i : ι) (f : (ι → ℝ) → ℝ) (x : ι → ℝ) : ℝ :=
  deriv (fun t => f (Function.update x i t)) (x i)

/-- A mixed partial, with derivative directions specified by a finite list. -/
noncomputable def mixedPartial {ι : Type*} [DecidableEq ι]
    : List ι → ((ι → ℝ) → ℝ) → (ι → ℝ) → ℝ
  | [], f => f
  | i :: l, f => coordinateDeriv i (mixedPartial l f)

theorem coordinateDeriv_pi_product {ι : Type*} [Fintype ι] [DecidableEq ι]
    (i : ι) (f : ι → ℝ → ℝ) (x : ι → ℝ) :
    coordinateDeriv i (fun y => ∏ j, f j (y j)) x =
      deriv (f i) (x i) * ∏ j ∈ Finset.univ.erase i, f j (x j) := by
  unfold coordinateDeriv
  have heq : (fun t => ∏ j, f j (Function.update x i t j)) =
      fun t => f i t * ∏ j ∈ Finset.univ.erase i, f j (x j) := by
    funext t
    rw [← Finset.mul_prod_erase Finset.univ (fun j => f j (Function.update x i t j))
      (Finset.mem_univ i)]
    simp only [Function.update_self]
    congr 1
    apply Finset.prod_congr rfl
    intro j hj
    have hji : j ≠ i := (Finset.mem_erase.mp hj).1
    simp [Function.update_of_ne hji]
  rw [heq, deriv_mul_const_field]

/-- Blueprint Lemma `lem:gevrey`: mixed partials of a product cutoff factor
into the corresponding one-variable derivatives. -/
theorem mixedPartial_pi_product {ι : Type*} [Fintype ι] [DecidableEq ι]
    (l : List ι) (f : ι → ℝ → ℝ) (x : ι → ℝ) :
    mixedPartial l (fun y => ∏ j, f j (y j)) x =
      ∏ j, iteratedDeriv (l.count j) (f j) (x j) := by
  induction l generalizing x with
  | nil => simp [mixedPartial, iteratedDeriv_zero]
  | cons i l ih =>
    have heq : mixedPartial l (fun y => ∏ j, f j (y j)) =
        fun y => ∏ j, iteratedDeriv (l.count j) (f j) (y j) := funext ih
    rw [mixedPartial, heq, coordinateDeriv_pi_product,
      ← Finset.mul_prod_erase Finset.univ
        (fun j => iteratedDeriv ((i :: l).count j) (f j) (x j)) (Finset.mem_univ i)]
    congr 1
    · simp only [List.count_cons_self, iteratedDeriv_succ]
    · apply Finset.prod_congr rfl
      intro j hj
      have hji : j ≠ i := (Finset.mem_erase.mp hj).1
      simp [Ne.symm hji]

/-- The product derivative bounds promised in blueprint Lemma `lem:gevrey`. -/
theorem mixedPartial_pi_product_bound {ι : Type*} [Fintype ι] [DecidableEq ι]
    (l : List ι) (f : ι → ℝ → ℝ) (B : ι → ℕ → ℝ) (x : ι → ℝ)
    (h : ∀ j, |iteratedDeriv (l.count j) (f j) (x j)| ≤ B j (l.count j)) :
    |mixedPartial l (fun y => ∏ j, f j (y j)) x| ≤ ∏ j, B j (l.count j) := by
  rw [mixedPartial_pi_product, Finset.abs_prod]
  exact Finset.prod_le_prod₀ (fun j _ => abs_nonneg _) (fun j _ => h j)

/-- Blueprint Lemma `lem:gevrey`, partition-of-unity assertion: there is a
nonnegative smooth compactly supported function in `(-1,1)` whose integer translates
sum to one and whose derivatives satisfy a single fixed Gevrey bound. -/
theorem existsGevreyPartition :
    ∃ ρ : ℝ → ℝ, (∀ n : ℕ, ContDiff ℝ n ρ) ∧ (∀ x, 0 ≤ ρ x) ∧
      HasCompactSupport ρ ∧ tsupport ρ ⊆ Set.Ioo (-1 : ℝ) 1 ∧
      (∀ x : ℝ, ∑' k : ℤ, ρ (x - k) = 1) ∧
      ∃ C : ℕ, 1 ≤ C ∧ ∀ (n : ℕ) (x : ℝ),
        |iteratedDeriv n ρ x| ≤ ((C : ℝ) * ((n : ℝ) + 1)) ^ (C * (n + 1)) :=
  ⟨gevreyPartition, gevreyPartition_contDiff, gevreyPartition_nonneg,
    gevreyPartition_hasCompactSupport, gevreyPartition_tsupport_subset_open,
    gevreyPartition_tsum, gevreyPartition_exists_derivative_bound⟩

/-- Blueprint Lemma `lem:gevrey`, interval-cutoff assertion: for a compact
interval inside an open interval, a smooth nonnegative cutoff equals one on the
compact interval and has compact support in the open interval, with Gevrey bounds. -/
theorem existsGevreyIntervalCutoff {a b c d : ℝ} (hab : a < b) (_hbc : b ≤ c) (hcd : c < d) :
    ∃ χ : ℝ → ℝ, (∀ n : ℕ, ContDiff ℝ n χ) ∧ (∀ x, χ x ∈ Set.Icc (0 : ℝ) 1) ∧
      HasCompactSupport χ ∧ tsupport χ ⊆ Set.Ioo a d ∧
      (∀ x ∈ Set.Icc b c, χ x = 1) ∧
      ∃ C : ℕ, 1 ≤ C ∧ ∀ (n : ℕ) (x : ℝ),
        |iteratedDeriv n χ x| ≤ ((C : ℝ) * ((n : ℝ) + 1)) ^ (C * (n + 1)) :=
  ⟨gevreyIntervalCutoff a b c d, fun n => gevreyIntervalCutoff_contDiff n a b c d,
    gevreyIntervalCutoff_mem_Icc a b c d, gevreyIntervalCutoff_hasCompactSupport hab hcd,
    gevreyIntervalCutoff_tsupport_subset_open hab hcd,
    fun _ hx => gevreyIntervalCutoff_eq_one hab hcd hx,
    gevreyIntervalCutoff_exists_derivative_bound a b c d⟩

/-- The integer translates in the constructed partition are locally finite. -/
theorem gevreyPartition_locallyFinite :
    LocallyFinite (fun k : ℤ => Function.support (fun x : ℝ => gevreyPartition (x - k))) := by
  intro x
  refine ⟨Set.Ioo (x - 1) (x + 1), Ioo_mem_nhds (by linarith) (by linarith), ?_⟩
  apply (Set.finite_Icc (⌊x⌋ - 2) (⌊x⌋ + 3)).subset
  rintro k ⟨y, hy, hyx⟩
  have hlo : -(3 / 4 : ℝ) < y - k := by
    by_contra h
    exact hy (gevreyPartition_zero_left (le_of_not_gt h))
  have hhi : y - k < (3 / 4 : ℝ) := by
    by_contra h
    exact hy (gevreyPartition_zero_right (le_of_not_gt h))
  have hf := Int.floor_le x
  have hf' := Int.lt_floor_add_one x
  constructor
  · have : (⌊x⌋ : ℝ) - 2 ≤ (k : ℝ) := by linarith [hyx.1]
    exact_mod_cast this
  · have : (k : ℝ) ≤ (⌊x⌋ : ℝ) + 3 := by linarith [hyx.2]
    exact_mod_cast this

/-! ### Fourier coefficient estimates

The following one-dimensional integration-by-parts proofs are adapted from
`../lean-dfr/DFR/Auto/Twisted/ConeDecompositionMultiplierTheorem/`,
`ConeDecompositionMultiplierTheorem.lean`, copyright 2026 Joris Roos,
Apache 2.0. They implement the coordinate estimate in blueprint
Lemma `lem:fourier-foundation`, lines 130–146.
-/

open AddCircle

theorem fourierCoeffOn_of_hasDerivAt_zeroBoundary
    {a b : ℝ} (hab : a < b) {f f' : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
    (hf : ∀ x ∈ Set.uIcc a b, HasDerivAt f (f' x) x)
    (hf' : IntervalIntegrable f' volume a b)
    (hboundary : f b = f a) :
    fourierCoeffOn hab f n =
      -(1 / (-2 * Real.pi * Complex.I * n)) *
        ((b - a) * fourierCoeffOn hab f' n) := by
  rw [fourierCoeffOn_of_hasDerivAt hab hn hf hf', hboundary, sub_self, mul_zero, zero_sub]
  ring_nf

theorem norm_fourierCoeffOn_of_hasDerivAt_zeroBoundary
    {a b : ℝ} (hab : a < b) {f f' : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
    (hf : ∀ x ∈ Set.uIcc a b, HasDerivAt f (f' x) x)
    (hf' : IntervalIntegrable f' volume a b)
    (hboundary : f b = f a) :
    ‖fourierCoeffOn hab f n‖ =
      ‖1 / (-2 * Real.pi * Complex.I * n)‖ * |b - a| * ‖fourierCoeffOn hab f' n‖ := by
  rw [fourierCoeffOn_of_hasDerivAt_zeroBoundary hab hn hf hf' hboundary]
  simp only [norm_neg, norm_mul]
  have hcast : (↑b : ℂ) - ↑a = ↑(b - a) := by push_cast; ring
  rw [hcast, Complex.norm_real, Real.norm_eq_abs]
  ring

theorem norm_fourierCoeffOn_le_of_norm_le
    {a b C : ℝ} (hab : a < b) {f : ℝ → ℂ} (n : ℤ)
    (hf : ∀ x ∈ Set.uIoc a b, ‖f x‖ ≤ C) :
    ‖fourierCoeffOn hab f n‖ ≤ C := by
  have hperiod : Fact (0 < b - a) := ⟨by linarith⟩
  let : Fact (0 < b - a) := hperiod
  rw [fourierCoeffOn_eq_integral]
  have hint : ‖∫ x in a..b,
      fourier (-n) (x : AddCircle (b - a)) • f x‖ ≤ C * |b - a| := by
    apply intervalIntegral.norm_integral_le_of_norm_le_const
    intro x hx
    have hfourier : ‖fourier (-n) (x : AddCircle (b - a))‖ = 1 := Circle.norm_coe _
    rw [norm_smul, hfourier, one_mul]
    exact hf x hx
  rw [norm_smul, Real.norm_eq_abs]
  calc
    |1 / (b - a)| * ‖∫ x in a..b,
        fourier (-n) (x : AddCircle (b - a)) • f x‖ ≤
        |1 / (b - a)| * (C * |b - a|) :=
      mul_le_mul_of_nonneg_left hint (abs_nonneg _)
    _ = C := by
      rw [abs_of_pos (by positivity : 0 < b - a)]
      rw [abs_of_pos (by positivity : 0 < 1 / (b - a))]
      calc
        1 / (b - a) * (C * (b - a)) =
            C * ((b - a)⁻¹ * (b - a)) := by rw [one_div]; ring
        _ = C := by rw [inv_mul_cancel₀ (ne_of_gt (sub_pos.mpr hab)), mul_one]

theorem norm_fourier_antideriv_factor (n : ℤ) :
    ‖1 / (-2 * Real.pi * Complex.I * n)‖ =
      (2 * Real.pi * |(n : ℝ)|)⁻¹ := by
  rw [one_div, norm_inv, norm_mul, norm_mul, norm_mul]
  have htwoC : ‖(2 : ℂ)‖ = (2 : ℝ) := by norm_num
  rw [norm_neg, htwoC, Complex.norm_real, Complex.norm_I, Complex.norm_intCast]
  simp only [Real.norm_eq_abs]
  rw [abs_of_pos Real.pi_pos]
  simp

theorem norm_fourierCoeffOn_le_of_deriv_bound
    {a b C : ℝ} (hab : a < b) {f f' : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
    (hf : ∀ x ∈ Set.uIcc a b, HasDerivAt f (f' x) x)
    (hf' : IntervalIntegrable f' volume a b)
    (hboundary : f b = f a)
    (hbound : ∀ x ∈ Set.uIoc a b, ‖f' x‖ ≤ C) :
    ‖fourierCoeffOn hab f n‖ ≤
      (2 * Real.pi * |(n : ℝ)|)⁻¹ * |b - a| * C := by
  rw [norm_fourierCoeffOn_of_hasDerivAt_zeroBoundary
    hab hn hf hf' hboundary, norm_fourier_antideriv_factor]
  exact mul_le_mul_of_nonneg_left
    (norm_fourierCoeffOn_le_of_norm_le hab n hbound)
    (mul_nonneg (inv_nonneg.mpr (by positivity)) (abs_nonneg _))

theorem norm_fourierCoeffOn_le_of_iteratedDeriv_bound
    {a b C : ℝ} (hab : a < b) {f : ℝ → ℂ} {n : ℤ} (hn : n ≠ 0)
    (N : ℕ) (hf : ContDiff ℝ N f)
    (hboundary : ∀ r : ℕ, r < N →
      iteratedDeriv r f b = iteratedDeriv r f a)
    (hbound : ∀ x ∈ Set.uIoc a b, ‖iteratedDeriv N f x‖ ≤ C) :
    ‖fourierCoeffOn hab f n‖ ≤
      ((2 * Real.pi * |(n : ℝ)|)⁻¹ * |b - a|) ^ N * C := by
  induction N generalizing f with
  | zero =>
      simpa using norm_fourierCoeffOn_le_of_norm_le hab n hbound
  | succ N ih =>
      let g : ℝ → ℂ := deriv f
      have hg : ContDiff ℝ N g := by
        dsimp [g]
        exact hf.deriv'
      have hgboundary : ∀ r : ℕ, r < N →
          iteratedDeriv r g b = iteratedDeriv r g a := by
        intro r hr
        change iteratedDeriv r (deriv f) b = iteratedDeriv r (deriv f) a
        rw [← iteratedDeriv_succ']
        exact hboundary (r + 1) (Nat.succ_lt_succ hr)
      have hgbound : ∀ x ∈ Set.uIoc a b, ‖iteratedDeriv N g x‖ ≤ C := by
        intro x hx
        rw [← iteratedDeriv_succ']
        exact hbound x hx
      have hrec := ih hg hgboundary hgbound
      let d : ℝ := (2 * Real.pi * |(n : ℝ)|)⁻¹ * |b - a|
      have hd : 0 ≤ d := mul_nonneg (inv_nonneg.mpr (by positivity)) (abs_nonneg _)
      have hderiv : ∀ x ∈ Set.uIcc a b, HasDerivAt f (g x) x := by
        intro x _
        dsimp [g]
        exact (hf.differentiable_iteratedDeriv 0
          (by exact_mod_cast Nat.zero_lt_succ N)).differentiableAt.hasDerivAt
      have hgint : IntervalIntegrable g volume a b := by
        exact (hf.continuous_deriv
          (by exact_mod_cast Nat.succ_le_succ (Nat.zero_le N))).intervalIntegrable a b
      have hzero : f b = f a := by
        simpa using hboundary 0 (by omega)
      have hstep : ‖fourierCoeffOn hab f n‖ = d * ‖fourierCoeffOn hab g n‖ := by
        dsimp [d]
        rw [show (2 * Real.pi * |(n : ℝ)|)⁻¹ * |b - a| =
            ‖1 / (-2 * Real.pi * Complex.I * n)‖ * |b - a| by
              rw [norm_fourier_antideriv_factor]]
        exact norm_fourierCoeffOn_of_hasDerivAt_zeroBoundary
          hab hn hderiv hgint hzero
      rw [hstep]
      calc
        d * ‖fourierCoeffOn hab g n‖ ≤ d * (d ^ N * C) :=
          mul_le_mul_of_nonneg_left hrec hd
        _ = d ^ (N + 1) * C := by ring

/-- Derivatives preserve the period, including the endpoint identities needed
for repeated integration by parts. -/
theorem periodic_iteratedDeriv {f : ℝ → ℂ} {T : ℝ}
    (hf : Function.Periodic f T) (m : ℕ) : Function.Periodic (iteratedDeriv m f) T := by
  have heq : (fun x => f (x + T)) = f := funext hf
  intro x
  have h := congrFun (iteratedDeriv_comp_add_const m f T) x
  rw [heq] at h
  exact h.symm

/-- Blueprint Lemma `lem:fourier-foundation`, lines 130–146, in one
coordinate of the unit torus. The coefficient is Mathlib's Haar coefficient. -/
theorem norm_fourierCoeff_le_of_periodic_derivative_bound
    (F : UnitAddCircle → ℂ) {n : ℤ} (hn : n ≠ 0) (m : ℕ) {A : ℝ}
    (hf : ContDiff ℝ m (fun x : ℝ => F x))
    (hbound : ∀ x : ℝ, ‖iteratedDeriv m (fun t : ℝ => F t) x‖ ≤ A) :
    ‖fourierCoeff F n‖ ≤ (2 * Real.pi * |(n : ℝ)|)⁻¹ ^ m * A := by
  have hp : Function.Periodic (fun t : ℝ => F t) 1 := by
    intro t
    change F ((t + 1 : ℝ) : UnitAddCircle) = F (t : UnitAddCircle)
    rw [coe_add_period]
  have hb : ∀ r : ℕ, r < m →
      iteratedDeriv r (fun t : ℝ => F t) 1 = iteratedDeriv r (fun t : ℝ => F t) 0 := by
    intro r _
    simpa using periodic_iteratedDeriv hp r 0
  have h := norm_fourierCoeffOn_le_of_iteratedDeriv_bound
    (by norm_num : (0 : ℝ) < 1) hn m hf hb (fun x _ => hbound x)
  have heq : fourierCoeffOn (by norm_num : (0 : ℝ) < 1) (fun x : ℝ => F x) n =
      fourierCoeff F n := by
    rw [fourierCoeffOn_eq_integral, fourierCoeff_eq_intervalIntegral F n 0]
    simp
  simpa [heq] using h

noncomputable section TorusFourier

local instance : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩

local instance : IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (IsProbabilityMeasure AddCircle.haarAddCircle)

/-- Splitting off an arbitrary torus coordinate in the Fourier integral. -/
theorem mFourierCoeff_eq_coordinate_integral {d : ℕ}
    (F : UnitAddTorus (Fin (d + 1)) → ℂ) (hF : Continuous F)
    (n : Fin (d + 1) → ℤ) (i : Fin (d + 1)) :
    UnitAddTorus.mFourierCoeff F n =
      ∫ y : UnitAddTorus (Fin d),
        (∏ j, fourier (-(n (i.succAbove j))) (y j)) *
          fourierCoeff (fun t => F (i.insertNth t y)) (n i) := by
  let G : UnitAddTorus (Fin (d + 1)) → ℂ :=
    fun x => UnitAddTorus.mFourier (-n) x * F x
  have hG : Continuous G := (UnitAddTorus.mFourier (-n)).continuous.mul hF
  have hIns : Continuous (fun p : UnitAddCircle × UnitAddTorus (Fin d) =>
      i.insertNth (α := fun _ => UnitAddCircle) p.1 p.2) := by
    apply continuous_pi
    intro j
    refine i.succAboveCases ?_ (fun k => ?_) j
    · simpa using continuous_fst
    · simp only [Fin.insertNth_apply_succAbove]
      exact (continuous_apply k).comp continuous_snd
  have hGI : Integrable (fun p : UnitAddCircle × UnitAddTorus (Fin d) =>
      G (i.insertNth p.1 p.2)) := (hG.comp hIns).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
  change (∫ x, G x) = _
  rw [← (volume_preserving_piFinSuccAbove
    (fun _ : Fin (d + 1) => UnitAddCircle) i).symm.integral_comp']
  change (∫ p : UnitAddCircle × UnitAddTorus (Fin d), G (i.insertNth p.1 p.2)) = _
  rw [Measure.volume_eq_prod, integral_prod_symm _ hGI]
  apply integral_congr_ae
  filter_upwards [] with y
  simp only [G, UnitAddTorus.mFourier, ContinuousMap.coe_mk, Pi.neg_apply]
  simp only [fourierCoeff]
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards [] with t
  rw [i.prod_univ_succAbove]
  simp only [Fin.insertNth_apply_same, Fin.insertNth_apply_succAbove]
  change _ = _ * (fourier (-(n i)) t * F (i.insertNth t y))
  ring

/-- The multivariate coefficient inherits the one-dimensional derivative
bound in each nonzero frequency coordinate. -/
theorem norm_mFourierCoeff_le_coordinate {d : ℕ}
    (F : UnitAddTorus (Fin (d + 1)) → ℂ) (hF : Continuous F)
    (n : Fin (d + 1) → ℤ) (i : Fin (d + 1)) (hi : n i ≠ 0)
    (m : ℕ) {A : ℝ}
    (hsmooth : ∀ y : UnitAddTorus (Fin d),
      ContDiff ℝ m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)))
    (hbound : ∀ (y : UnitAddTorus (Fin d)) (x : ℝ),
      ‖iteratedDeriv m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)) x‖ ≤ A) :
    ‖UnitAddTorus.mFourierCoeff F n‖ ≤ (2 * Real.pi * |(n i : ℝ)|)⁻¹ ^ m * A := by
  rw [mFourierCoeff_eq_coordinate_integral F hF n i]
  have h : ∀ y : UnitAddTorus (Fin d),
      ‖(∏ j, fourier (-(n (i.succAbove j))) (y j)) *
        fourierCoeff (fun t => F (i.insertNth t y)) (n i)‖ ≤
          (2 * Real.pi * |(n i : ℝ)|)⁻¹ ^ m * A := by
    intro y
    rw [norm_mul, norm_prod]
    have hnorm : ∏ j : Fin d, ‖fourier (-(n (i.succAbove j))) (y j)‖ = 1 := by
      simp only [fourier_apply, Circle.norm_coe, Finset.prod_const_one]
    rw [hnorm, one_mul]
    exact norm_fourierCoeff_le_of_periodic_derivative_bound
      (fun t => F (i.insertNth t y)) hi m (hsmooth y) (hbound y)
  simpa using norm_integral_le_of_norm_le_const
    (μ := (volume : Measure (UnitAddTorus (Fin d)))) (Filter.Eventually.of_forall h)

/-- Euclidean length of an integer frequency, as in the blueprint's torus estimates. -/
def frequencyLength {d : ℕ} (n : Fin d → ℤ) : ℝ :=
  Real.sqrt (∑ j, (n j : ℝ) ^ 2)

theorem frequencyLength_nonneg {d : ℕ} (n : Fin d → ℤ) : 0 ≤ frequencyLength n :=
  Real.sqrt_nonneg _

theorem frequencyLength_pos {d : ℕ} {n : Fin d → ℤ} (hn : n ≠ 0) :
    0 < frequencyLength n := by
  have hne : ∃ i, n i ≠ 0 := by
    by_contra h
    push Not at h
    exact hn (funext h)
  obtain ⟨i, hi⟩ := hne
  apply Real.sqrt_pos.mpr
  apply lt_of_lt_of_le (sq_pos_of_ne_zero (by exact_mod_cast hi : (n i : ℝ) ≠ 0))
  exact Finset.single_le_sum (fun j _ => sq_nonneg (n j : ℝ)) (Finset.mem_univ i)

/-- A largest coordinate controls the Euclidean frequency length. -/
theorem exists_dominant_frequency {d : ℕ} (n : Fin (d + 1) → ℤ) :
    ∃ i, frequencyLength n ≤ Real.sqrt (d + 1 : ℝ) * |(n i : ℝ)| := by
  obtain ⟨i, _, hi⟩ := Finset.exists_max_image Finset.univ
    (fun j => |(n j : ℝ)|) Finset.univ_nonempty
  refine ⟨i, ?_⟩
  have hsum : (∑ j, (n j : ℝ) ^ 2) ≤ (d + 1 : ℝ) * |(n i : ℝ)| ^ 2 := by
    calc
      _ = ∑ j, |(n j : ℝ)| ^ 2 := by simp
      _ ≤ ∑ _j : Fin (d + 1), |(n i : ℝ)| ^ 2 := by
        apply Finset.sum_le_sum
        intro j hj
        exact pow_le_pow_left₀ (abs_nonneg _) (hi j hj) 2
      _ = _ := by simp [mul_comm]
  calc
    frequencyLength n ≤ Real.sqrt ((d + 1 : ℝ) * |(n i : ℝ)| ^ 2) :=
      Real.sqrt_le_sqrt hsum
    _ = _ := by rw [Real.sqrt_mul (by positivity), Real.sqrt_sq (abs_nonneg _)]

/-- Blueprint Lemma `lem:fourier-foundation`, lines 130–133: the exact
Euclidean-frequency decay estimate. Coordinate derivatives are taken on real lifts
of torus slices, so their periodic boundary conditions follow automatically. -/
theorem norm_mFourierCoeff_le_derivative_bound {d : ℕ}
    (F : UnitAddTorus (Fin (d + 1)) → ℂ) (hF : Continuous F)
    (n : Fin (d + 1) → ℤ) (hn : n ≠ 0) (m : ℕ) {A : ℝ}
    (hsmooth : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)),
      ContDiff ℝ m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)))
    (hbound : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)) (x : ℝ),
      ‖iteratedDeriv m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)) x‖ ≤ A) :
    ‖UnitAddTorus.mFourierCoeff F n‖ ≤
      A * (Real.sqrt (d + 1 : ℝ) / (2 * Real.pi * frequencyLength n)) ^ m := by
  obtain ⟨i, hi⟩ := exists_dominant_frequency n
  have hlen := frequencyLength_pos hn
  have hni : n i ≠ 0 := by
    intro h
    simp [h] at hi
    linarith
  have hA : 0 ≤ A := (norm_nonneg _).trans (hbound i (fun _ => 0) 0)
  have hbase : (2 * Real.pi * |(n i : ℝ)|)⁻¹ ≤
      Real.sqrt (d + 1 : ℝ) / (2 * Real.pi * frequencyLength n) := by
    have habs : 0 < |(n i : ℝ)| := abs_pos.mpr (by exact_mod_cast hni)
    rw [inv_eq_one_div, div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith [mul_le_mul_of_nonneg_left hi (show 0 ≤ 2 * Real.pi by positivity)]
  calc
    _ ≤ (2 * Real.pi * |(n i : ℝ)|)⁻¹ ^ m * A :=
      norm_mFourierCoeff_le_coordinate F hF n i hni m (hsmooth i) (hbound i)
    _ ≤ _ := by
      rw [mul_comm A]
      exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by positivity) hbase m) hA

theorem abs_frequency_coordinate_le {d : ℕ} (n : Fin d → ℤ) (i : Fin d) :
    |(n i : ℝ)| ≤ frequencyLength n := by
  rw [← Real.sqrt_sq_eq_abs (n i : ℝ)]
  apply Real.sqrt_le_sqrt
  exact Finset.single_le_sum (fun j _ => sq_nonneg (n j : ℝ)) (Finset.mem_univ i)

theorem one_le_frequencyLength {d : ℕ} {n : Fin d → ℤ} (hn : n ≠ 0) :
    1 ≤ frequencyLength n := by
  have hne : ∃ i, n i ≠ 0 := by
    by_contra h
    push Not at h
    exact hn (funext h)
  obtain ⟨i, hi⟩ := hne
  have h : (1 : ℝ) ≤ |(n i : ℝ)| := by exact_mod_cast Int.one_le_abs hi
  exact h.trans (abs_frequency_coordinate_le n i)

/-- A finite box containing all frequencies in a bounded Euclidean ball. -/
def frequencyBox (d N : ℕ) : Finset (Fin d → ℤ) :=
  Fintype.piFinset (fun _ => Finset.Icc (-(N : ℤ)) N)

theorem card_frequencyBox (d N : ℕ) : (frequencyBox d N).card = (2 * N + 1) ^ d := by
  have h : (Finset.Icc (-(N : ℤ)) N).card = 2 * N + 1 := by
    rw [Int.card_Icc]
    omega
  simp [frequencyBox, h]

theorem mem_frequencyBox_of_length_le {d N : ℕ} {n : Fin d → ℤ}
    (h : frequencyLength n ≤ N) : n ∈ frequencyBox d N := by
  apply Fintype.mem_piFinset.mpr
  intro i
  have hi := abs_frequency_coordinate_le n i |>.trans h
  have hi' : |n i| ≤ (N : ℤ) := by exact_mod_cast hi
  exact Finset.mem_Icc.mpr (abs_le.mp hi')

/-- The nonzero portion of a dyadic shell. The zero mode is deliberately
separate: see `automation/ErrorReport.md` for the printed first-shell omission. -/
def frequencyShell (d : ℕ) (T : ℝ) : Finset (Fin d → ℤ) :=
  (frequencyBox d ⌈2 * T⌉₊).filter
    (fun n => n ≠ 0 ∧ T ≤ 1 + frequencyLength n ∧ 1 + frequencyLength n < 2 * T)

theorem mem_frequencyShell {d : ℕ} {T : ℝ} {n : Fin d → ℤ} :
    n ∈ frequencyShell d T ↔
      n ≠ 0 ∧ T ≤ 1 + frequencyLength n ∧ 1 + frequencyLength n < 2 * T := by
  rw [frequencyShell, Finset.mem_filter]
  constructor
  · exact fun h => h.2
  · intro h
    refine ⟨mem_frequencyBox_of_length_le ?_, h⟩
    exact (by linarith [h.2.2] : frequencyLength n ≤ 2 * T).trans (Nat.le_ceil _)

theorem card_frequencyShell_le {d : ℕ} {T : ℝ} (hT : 1 ≤ T) :
    ((frequencyShell d T).card : ℝ) ≤ (7 * T) ^ d := by
  have hcard : (frequencyShell d T).card ≤ (2 * ⌈2 * T⌉₊ + 1) ^ d := by
    rw [← card_frequencyBox]
    exact Finset.card_le_card (Finset.filter_subset _ _)
  have hceil := Nat.ceil_lt_add_one (show 0 ≤ 2 * T by linarith)
  have hbase : (2 * ⌈2 * T⌉₊ + 1 : ℝ) ≤ 7 * T := by linarith
  calc
    _ ≤ ((2 * ⌈2 * T⌉₊ + 1 : ℕ) : ℝ) ^ d := by exact_mod_cast hcard
    _ = (2 * (⌈2 * T⌉₊ : ℝ) + 1) ^ d := by push_cast; rfl
    _ ≤ _ := pow_le_pow_left₀ (by positivity) hbase d

/-- Absolute shell mass from the blueprint's coefficient estimate. The explicit
constant `7 ^ d` is independent of the derivative order `m`. The expression
`(sqrt d) ^ m` is the factor `d ^ (m/2)` in the source. -/
theorem sum_frequencyShell_le {d m : ℕ} {A T : ℝ} (hA : 0 ≤ A) (hT : 1 ≤ T)
    (c : (Fin d → ℤ) → ℂ)
    (hc : ∀ n, n ≠ 0 → ‖c n‖ ≤
      A * (Real.sqrt (d : ℝ) / (2 * Real.pi * frequencyLength n)) ^ m) :
    ∑ n ∈ frequencyShell d T, ‖c n‖ ≤
      (7 : ℝ) ^ d * A * (Real.sqrt (d : ℝ)) ^ m * T ^ ((d : ℝ) - m) := by
  have hTpos : 0 < T := by linarith
  have hpoint : ∀ n ∈ frequencyShell d T,
      ‖c n‖ ≤ A * (Real.sqrt (d : ℝ) / T) ^ m := by
    intro n hn
    obtain ⟨hn0, hnlo, _⟩ := mem_frequencyShell.mp hn
    have hlen := one_le_frequencyLength hn0
    have hden : T ≤ 2 * Real.pi * frequencyLength n := by
      nlinarith [mul_le_mul_of_nonneg_right Real.two_le_pi (frequencyLength_nonneg n)]
    refine (hc n hn0).trans (mul_le_mul_of_nonneg_left ?_ hA)
    apply pow_le_pow_left₀ (by positivity)
    exact div_le_div_of_nonneg_left (Real.sqrt_nonneg _) hTpos hden
  calc
    _ ≤ ∑ _n ∈ frequencyShell d T, A * (Real.sqrt (d : ℝ) / T) ^ m :=
      Finset.sum_le_sum hpoint
    _ = ((frequencyShell d T).card : ℝ) * (A * (Real.sqrt (d : ℝ) / T) ^ m) := by
      simp
    _ ≤ (7 * T) ^ d * (A * (Real.sqrt (d : ℝ) / T) ^ m) :=
      mul_le_mul_of_nonneg_right (card_frequencyShell_le hT) (by positivity)
    _ = _ := by
      rw [Real.rpow_sub hTpos, Real.rpow_natCast, Real.rpow_natCast, mul_pow, div_pow]
      ring

/-- Blueprint Lemma `lem:fourier-foundation`, the nonzero Fourier shell
estimate obtained from smooth coordinate derivatives. -/
theorem sum_mFourierCoeff_frequencyShell_le {d m : ℕ} {A T : ℝ} (hT : 1 ≤ T)
    (F : UnitAddTorus (Fin (d + 1)) → ℂ) (hF : Continuous F)
    (hsmooth : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)),
      ContDiff ℝ m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)))
    (hbound : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)) (x : ℝ),
      ‖iteratedDeriv m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)) x‖ ≤ A) :
    ∑ n ∈ frequencyShell (d + 1) T, ‖UnitAddTorus.mFourierCoeff F n‖ ≤
      (7 : ℝ) ^ (d + 1) * A * (Real.sqrt (d + 1 : ℝ)) ^ m *
        T ^ ((d + 1 : ℝ) - m) := by
  have hA : 0 ≤ A := (norm_nonneg _).trans (hbound 0 (fun _ => 0) 0)
  simpa only [Nat.cast_add, Nat.cast_one] using sum_frequencyShell_le hA hT
    (UnitAddTorus.mFourierCoeff F)
    (fun n hn => by
      simpa only [Nat.cast_add, Nat.cast_one] using
        norm_mFourierCoeff_le_derivative_bound F hF n hn m hsmooth hbound)

/-- Nonzero integer frequencies are covered by the dyadic shells. -/
theorem exists_mem_dyadic_frequencyShell {d : ℕ} {n : Fin d → ℤ} (hn : n ≠ 0) :
    ∃ k : ℕ, n ∈ frequencyShell d ((2 : ℝ) ^ k) := by
  obtain ⟨k, hk, hk'⟩ := exists_nat_pow_near
    (show 1 ≤ 1 + frequencyLength n by linarith [frequencyLength_nonneg n])
    (show (1 : ℝ) < 2 by norm_num)
  refine ⟨k, mem_frequencyShell.mpr ⟨hn, hk, ?_⟩⟩
  simpa [pow_succ, mul_comm] using hk'

/-- The shell estimates form a convergent geometric series once the derivative
order exceeds the dimension. -/
theorem summable_dyadic_frequencyShell {d m : ℕ} {A : ℝ} (hA : 0 ≤ A) (hm : d < m)
    (c : (Fin d → ℤ) → ℂ)
    (hc : ∀ n, n ≠ 0 → ‖c n‖ ≤
      A * (Real.sqrt (d : ℝ) / (2 * Real.pi * frequencyLength n)) ^ m) :
    Summable (fun k : ℕ => ∑ n ∈ frequencyShell d ((2 : ℝ) ^ k), ‖c n‖) := by
  let r : ℝ := (2 : ℝ) ^ ((d : ℝ) - m)
  have hr0 : 0 ≤ r := by positivity
  have hr1 : r < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num)
    (by have h : (d : ℝ) < m := by exact_mod_cast hm
        linarith)
  have hgeom := (summable_geometric_of_lt_one hr0 hr1).mul_left
    ((7 : ℝ) ^ d * A * (Real.sqrt (d : ℝ)) ^ m)
  apply hgeom.of_nonneg_of_le
  · intro k; exact Finset.sum_nonneg (fun _ _ => norm_nonneg _)
  · intro k
    have h := sum_frequencyShell_le hA (show 1 ≤ (2 : ℝ) ^ k by
      exact one_le_pow₀ (by norm_num)) c hc
    convert h using 1
    dsimp [r]
    rw [Real.rpow_pow_comm (by norm_num)]

/-- A countable collection of finite shells with summable masses controls
the entire series, with one separately handled exceptional index. -/
theorem summable_norm_of_finite_shells {β : Type*}
    (c : β → ℂ) (z : β) (s : ℕ → Finset β)
    (hcover : ∀ b, b ≠ z → ∃ k, b ∈ s k)
    (hmass : Summable (fun k => ∑ b ∈ s k, ‖c b‖)) : Summable (fun b => ‖c b‖) := by
  classical
  let B : ℕ × β → ℝ := fun p => if p.2 ∈ s p.1 then ‖c p.2‖ else 0
  have hB0 : ∀ p, 0 ≤ B p := by intro p; dsimp [B]; split_ifs <;> positivity
  have hBs : ∀ k, Summable (fun b => B (k, b)) := by
    intro k
    exact summable_of_ne_finset_zero (s := s k) (fun b hb => by simp [B, hb])
  have hBt : ∀ k, (∑' b, B (k, b)) = ∑ b ∈ s k, ‖c b‖ := by
    intro k
    rw [tsum_eq_sum (s := s k) (fun b hb => by simp [B, hb])]
    exact Finset.sum_congr rfl (fun b hb => by simp [B, hb])
  have hprod : Summable B := (summable_prod_of_nonneg hB0).mpr ⟨hBs, by simpa [hBt]⟩
  have hsingle : Summable (fun b => if b = z then ‖c z‖ else 0) :=
    summable_of_ne_finset_zero (s := {z}) (by
      intro b hb
      simp only [Finset.mem_singleton] at hb
      simp [hb])
  apply (hsingle.add hprod.prod_symm.prod).of_nonneg_of_le (fun b => norm_nonneg _)
  intro b
  by_cases hb : b = z
  · subst b
    simp only [ite_true]
    exact le_add_of_nonneg_right (tsum_nonneg (fun k => hB0 (k, z)))
  · obtain ⟨k, hk⟩ := hcover b hb
    simp only [ite_eq_right hb, zero_add]
    have h := hprod.prod_symm.prod_factor b |>.le_tsum k (fun j _ => hB0 (j, b))
    simpa [B, hk] using h

/-- Absolute convergence of a coefficient sequence with decay order above dimension. -/
theorem summable_norm_of_frequency_decay {d m : ℕ} {A : ℝ} (hA : 0 ≤ A) (hm : d < m)
    (c : (Fin d → ℤ) → ℂ)
    (hc : ∀ n, n ≠ 0 → ‖c n‖ ≤
      A * (Real.sqrt (d : ℝ) / (2 * Real.pi * frequencyLength n)) ^ m) :
    Summable (fun n => ‖c n‖) :=
  summable_norm_of_finite_shells c 0 (fun k => frequencyShell d ((2 : ℝ) ^ k))
    (fun _ hn => exists_mem_dyadic_frequencyShell hn)
    (summable_dyadic_frequencyShell hA hm c hc)

/-- Blueprint Lemma `lem:fourier-foundation`: choosing a derivative order
above the dimension gives absolute convergence of the torus Fourier coefficients. -/
theorem summable_norm_mFourierCoeff {d m : ℕ} {A : ℝ} (hm : d + 1 < m)
    (F : UnitAddTorus (Fin (d + 1)) → ℂ) (hF : Continuous F)
    (hsmooth : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)),
      ContDiff ℝ m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)))
    (hbound : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)) (x : ℝ),
      ‖iteratedDeriv m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)) x‖ ≤ A) :
    Summable (fun n => ‖UnitAddTorus.mFourierCoeff F n‖) := by
  have hA : 0 ≤ A := (norm_nonneg _).trans (hbound 0 (fun _ => 0) 0)
  exact summable_norm_of_frequency_decay hA hm (UnitAddTorus.mFourierCoeff F)
    (fun n hn => by
      simpa only [Nat.cast_add, Nat.cast_one] using
        norm_mFourierCoeff_le_derivative_bound F hF n hn m hsmooth hbound)

/-- Blueprint Lemma `lem:fourier-foundation`: the Fourier series converges
in the uniform norm of continuous functions on the torus. -/
theorem hasSum_mFourier_of_derivative_bound {d m : ℕ} {A : ℝ} (hm : d + 1 < m)
    (F : C(UnitAddTorus (Fin (d + 1)), ℂ))
    (hsmooth : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)),
      ContDiff ℝ m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)))
    (hbound : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)) (x : ℝ),
      ‖iteratedDeriv m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)) x‖ ≤ A) :
    HasSum (fun n => UnitAddTorus.mFourierCoeff F n • UnitAddTorus.mFourier n) F :=
  UnitAddTorus.hasSum_mFourier_series_of_summable
    (summable_norm_mFourierCoeff hm F F.continuous hsmooth hbound).of_norm

/-- Summable shell masses bound the total absolute mass whenever the shells
cover the support. Overlap of shells is harmless for this upper bound. -/
theorem tsum_norm_le_shell_masses {β : Type*}
    (c : β → ℂ) (s : ℕ → Finset β)
    (hcover : ∀ b, c b ≠ 0 → ∃ k, b ∈ s k)
    (hmass : Summable (fun k => ∑ b ∈ s k, ‖c b‖)) :
    Summable (fun b => ‖c b‖) ∧
      (∑' b, ‖c b‖) ≤ ∑' k, ∑ b ∈ s k, ‖c b‖ := by
  classical
  let B : ℕ × β → ℝ := fun p => if p.2 ∈ s p.1 then ‖c p.2‖ else 0
  have hB0 : ∀ p, 0 ≤ B p := by intro p; dsimp [B]; split_ifs <;> positivity
  have hBs : ∀ k, Summable (fun b => B (k, b)) := by
    intro k
    exact summable_of_ne_finset_zero (s := s k) (fun b hb => by simp [B, hb])
  have hBt : ∀ k, (∑' b, B (k, b)) = ∑ b ∈ s k, ‖c b‖ := by
    intro k
    rw [tsum_eq_sum (s := s k) (fun b hb => by simp [B, hb])]
    exact Finset.sum_congr rfl (fun b hb => by simp [B, hb])
  have hprod : Summable B := (summable_prod_of_nonneg hB0).mpr ⟨hBs, by simpa [hBt]⟩
  have hpoint : ∀ b, ‖c b‖ ≤ ∑' k, B (k, b) := by
    intro b
    by_cases hb : c b = 0
    · simpa [hb] using tsum_nonneg (fun k => hB0 (k, b))
    · obtain ⟨k, hk⟩ := hcover b hb
      have h := hprod.prod_symm.prod_factor b |>.le_tsum k (fun j _ => hB0 (j, b))
      simpa [B, hk] using h
  have hs := hprod.prod_symm.prod.of_nonneg_of_le (fun b => norm_nonneg _) hpoint
  refine ⟨hs, (hs.tsum_le_tsum hpoint hprod.prod_symm.prod).trans_eq ?_⟩
  have ht : Summable (Function.uncurry (fun k b => B (k, b))) := hprod
  exact ht.tsum_comm.trans (tsum_congr hBt)

/-- Frequencies past a dyadic cutoff are covered by the later shells. -/
theorem exists_mem_late_frequencyShell {d : ℕ} {n : Fin d → ℤ} (hn : n ≠ 0)
    (K : ℕ) (hK : (2 : ℝ) ^ K ≤ 1 + frequencyLength n) :
    ∃ k : ℕ, n ∈ frequencyShell d ((2 : ℝ) ^ (K + k)) := by
  obtain ⟨j, hj⟩ := exists_mem_dyadic_frequencyShell hn
  have hj' := mem_frequencyShell.mp hj
  have hKj : K ≤ j := by
    by_contra h
    have hle : j + 1 ≤ K := by omega
    have hpow := pow_le_pow_right₀ (show (1 : ℝ) ≤ 2 by norm_num) hle
    have hlt : 1 + frequencyLength n < (2 : ℝ) ^ (j + 1) := by
      simpa [pow_succ, mul_comm] using hj'.2.2
    linarith
  refine ⟨j - K, ?_⟩
  simpa [Nat.add_sub_of_le hKj] using hj

/-- Quantitative absolute Fourier tail. Taking `m` greater than the dimension
plus a requested tail power gives that power of decay, with explicit constants. -/
theorem frequency_tail_bound {d m : ℕ} {A : ℝ} (hA : 0 ≤ A) (hm : d < m)
    (c : (Fin d → ℤ) → ℂ)
    (hc : ∀ n, n ≠ 0 → ‖c n‖ ≤
      A * (Real.sqrt (d : ℝ) / (2 * Real.pi * frequencyLength n)) ^ m) (K : ℕ) :
    (∑' n, if n ≠ 0 ∧ (2 : ℝ) ^ K ≤ 1 + frequencyLength n then ‖c n‖ else 0) ≤
      (7 : ℝ) ^ d * A * (Real.sqrt (d : ℝ)) ^ m *
        ((2 : ℝ) ^ K) ^ ((d : ℝ) - m) / (1 - (2 : ℝ) ^ ((d : ℝ) - m)) := by
  classical
  let ctail : (Fin d → ℤ) → ℂ := fun n =>
    if n ≠ 0 ∧ (2 : ℝ) ^ K ≤ 1 + frequencyLength n then c n else 0
  let s : ℕ → Finset (Fin d → ℤ) := fun k => frequencyShell d ((2 : ℝ) ^ (K + k))
  let C : ℝ := (7 : ℝ) ^ d * A * (Real.sqrt (d : ℝ)) ^ m
  let r : ℝ := (2 : ℝ) ^ ((d : ℝ) - m)
  have hr0 : 0 ≤ r := by positivity
  have hr1 : r < 1 := Real.rpow_lt_one_of_one_lt_of_neg (by norm_num)
    (by have h : (d : ℝ) < m := by exact_mod_cast hm
        linarith)
  have hgeom : Summable (fun k : ℕ => (C * r ^ K) * r ^ k) :=
    (summable_geometric_of_lt_one hr0 hr1).mul_left _
  have hct : ∀ n, ‖ctail n‖ ≤ ‖c n‖ := by
    intro n
    dsimp [ctail]
    split_ifs <;> simp
  have hmassle : ∀ k, (∑ n ∈ s k, ‖ctail n‖) ≤ (C * r ^ K) * r ^ k := by
    intro k
    calc
      _ ≤ ∑ n ∈ s k, ‖c n‖ := Finset.sum_le_sum (fun n _ => hct n)
      _ ≤ C * ((2 : ℝ) ^ (K + k)) ^ ((d : ℝ) - m) :=
        sum_frequencyShell_le hA (one_le_pow₀ (by norm_num)) c hc
      _ = _ := by
        dsimp [r]
        rw [← Real.rpow_pow_comm (by norm_num), pow_add]
        ring
  have hmass : Summable (fun k => ∑ n ∈ s k, ‖ctail n‖) :=
    hgeom.of_nonneg_of_le (fun k => Finset.sum_nonneg (fun _ _ => norm_nonneg _)) hmassle
  have hcover : ∀ n, ctail n ≠ 0 → ∃ k, n ∈ s k := by
    intro n hn
    have ht : n ≠ 0 ∧ (2 : ℝ) ^ K ≤ 1 + frequencyLength n := by
      by_contra h
      exact hn (by simp [ctail, h])
    exact exists_mem_late_frequencyShell ht.1 K ht.2
  have hsum := (tsum_norm_le_shell_masses ctail s hcover hmass).2
  have heq : (∑' n, ‖ctail n‖) =
      ∑' n, if n ≠ 0 ∧ (2 : ℝ) ^ K ≤ 1 + frequencyLength n then ‖c n‖ else 0 := by
    apply tsum_congr
    intro n
    dsimp [ctail]
    split_ifs <;> simp
  rw [← heq]
  calc
    _ ≤ ∑' k, ∑ n ∈ s k, ‖ctail n‖ := hsum
    _ ≤ ∑' k, (C * r ^ K) * r ^ k := hmass.tsum_le_tsum hmassle hgeom
    _ = C * r ^ K * (1 - r)⁻¹ := by rw [tsum_mul_left, tsum_geometric_of_lt_one hr0 hr1]
    _ = _ := by
      dsimp [C, r]
      rw [Real.rpow_pow_comm (by norm_num)]
      rfl

/-- Frequencies retained by a dyadic Fourier truncation, including the constant mode. -/
def frequencyTruncationSet (d K : ℕ) : Finset (Fin d → ℤ) :=
  (frequencyBox d ⌈(2 : ℝ) ^ K⌉₊).filter
    (fun n => n = 0 ∨ 1 + frequencyLength n < (2 : ℝ) ^ K)

theorem mem_frequencyTruncationSet {d K : ℕ} {n : Fin d → ℤ} :
    n ∈ frequencyTruncationSet d K ↔
      n = 0 ∨ 1 + frequencyLength n < (2 : ℝ) ^ K := by
  rw [frequencyTruncationSet, Finset.mem_filter]
  constructor
  · exact fun h => h.2
  · intro h
    refine ⟨mem_frequencyBox_of_length_le ?_, h⟩
    apply le_trans (b := (2 : ℝ) ^ K) _ (Nat.le_ceil _)
    rcases h with rfl | h
    · simp [frequencyLength]
    · linarith

/-- Blueprint Lemma `lem:fourier-foundation`: quantitative truncation in the
uniform norm, with the constant Fourier mode retained separately. -/
theorem norm_mFourier_truncation_error {d m : ℕ} {A : ℝ} (hm : d + 1 < m)
    (F : C(UnitAddTorus (Fin (d + 1)), ℂ))
    (hsmooth : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)),
      ContDiff ℝ m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)))
    (hbound : ∀ (i : Fin (d + 1)) (y : UnitAddTorus (Fin d)) (x : ℝ),
      ‖iteratedDeriv m (fun t : ℝ => F (i.insertNth (t : UnitAddCircle) y)) x‖ ≤ A)
    (K : ℕ) :
    ‖F - ∑ n ∈ frequencyTruncationSet (d + 1) K,
      UnitAddTorus.mFourierCoeff F n • UnitAddTorus.mFourier n‖ ≤
      (7 : ℝ) ^ (d + 1) * A * (Real.sqrt (d + 1 : ℝ)) ^ m *
        ((2 : ℝ) ^ K) ^ ((d + 1 : ℝ) - m) /
          (1 - (2 : ℝ) ^ ((d + 1 : ℝ) - m)) := by
  classical
  let s := frequencyTruncationSet (d + 1) K
  let t : (Fin (d + 1) → ℤ) → C(UnitAddTorus (Fin (d + 1)), ℂ) :=
    fun n => UnitAddTorus.mFourierCoeff F n • UnitAddTorus.mFourier n
  have hnorm : ∀ n, ‖t n‖ = ‖UnitAddTorus.mFourierCoeff F n‖ := by
    intro n
    simp [t, norm_smul, UnitAddTorus.mFourier_norm]
  have htn : Summable (fun n => ‖t n‖) := by
    simpa only [hnorm] using summable_norm_mFourierCoeff hm F F.continuous hsmooth hbound
  have hsum : HasSum t F := hasSum_mFourier_of_derivative_bound hm F hsmooth hbound
  have heq : F - ∑ n ∈ s, t n =
      ∑' n : ↥((↑s : Set (Fin (d + 1) → ℤ))ᶜ), t n := by
    have h := htn.of_norm.sum_add_tsum_compl (s := s)
    rw [hsum.tsum_eq] at h
    symm
    apply eq_sub_iff_add_eq.mpr
    simpa [add_comm] using h
  change ‖F - ∑ n ∈ s, t n‖ ≤ _
  rw [heq]
  have hA : 0 ≤ A := (norm_nonneg _).trans (hbound 0 (fun _ => 0) 0)
  calc
    _ ≤ ∑' n : ↥((↑s : Set (Fin (d + 1) → ℤ))ᶜ), ‖t n‖ :=
      norm_tsum_le_tsum_norm (htn.subtype _)
    _ = ∑' n, if n ≠ 0 ∧ (2 : ℝ) ^ K ≤ 1 + frequencyLength n then
        ‖UnitAddTorus.mFourierCoeff F n‖ else 0 := by
      rw [tsum_subtype ((↑s : Set (Fin (d + 1) → ℤ))ᶜ) (fun n => ‖t n‖)]
      apply tsum_congr
      intro n
      simp [Set.indicator, s, mem_frequencyTruncationSet, hnorm, not_or]
    _ ≤ _ := by
      simpa only [Nat.cast_add, Nat.cast_one] using frequency_tail_bound hA hm
        (UnitAddTorus.mFourierCoeff F)
        (fun n hn => by
          simpa only [Nat.cast_add, Nat.cast_one] using
            norm_mFourierCoeff_le_derivative_bound F F.continuous n hn m hsmooth hbound) K

end TorusFourier

/-! ### Separated-frequency rows

The quadratic-envelope integral calculations are adapted from
`../lean-spherical/LeanSpherical/Auto/Spherical/MSS/Kakeya/TTStarSchur.lean`,
copyright 2026 Joris Roos, Apache 2.0.
-/

/-- The integrable envelope used for the Gram matrix in the Fourier row estimate. -/
noncomputable def quadraticTimeEnvelope (Lambda t s : ℝ) : ℝ :=
  (1 + (Lambda * (t - s)) ^ 2)⁻¹

theorem integral_quadraticTimeEnvelope_univ_eq_pi_div
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    (∫ s : Real, quadraticTimeEnvelope Lambda t s) = Real.pi / Lambda := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hfcont : Continuous f := by
    dsimp [f]
    apply Continuous.inv₀
    · fun_prop
    · intro u
      positivity
  have hrewrite : (fun s : Real => quadraticTimeEnvelope Lambda t s) =
      fun s => f (Lambda * (s - t)) := by
    funext s
    unfold quadraticTimeEnvelope
    dsimp [f]
    congr 2
    ring
  rw [hrewrite]
  have htranslation :
      (∫ s : Real, f (Lambda * (s - t))) =
        ∫ x : Real, f (Lambda * x) := by
    let g : Real → Real := fun x => f (Lambda * x)
    have hgcont : Continuous g :=
      hfcont.comp (continuous_const.mul continuous_id)
    have hmap : Measure.map (fun x : Real => x + (-t)) volume = volume :=
      map_add_right_eq_self volume (-t)
    have hphi : AEMeasurable (fun x : Real => x + (-t)) volume :=
      (continuous_id.add continuous_const).aemeasurable
    calc
      (∫ s : Real, f (Lambda * (s - t))) =
          ∫ s : Real, g (s + (-t)) := by
            apply integral_congr_ae
            filter_upwards with s
            simp only [g, sub_eq_add_neg]
      _ = ∫ x : Real, g x := by
        calc
          (∫ s : Real, g (s + (-t))) =
              ∫ x : Real, g x ∂Measure.map (fun x : Real => x + (-t)) volume :=
            (integral_map hphi hgcont.aestronglyMeasurable).symm
          _ = ∫ x : Real, g x := by rw [hmap]
      _ = ∫ x : Real, f (Lambda * x) := rfl
  rw [htranslation, Measure.integral_comp_mul_left]
  have hbase : (∫ x : Real, f x) = Real.pi := by
    simpa only [f] using integral_univ_inv_one_add_sq
  rw [hbase, smul_eq_mul, abs_of_pos (inv_pos.mpr hLambda)]
  rw [div_eq_mul_inv]
  ring

/-- The same whole-line quadratic envelope is integrable.  This deliberately
keeps the translation and dilation steps separate so subsequent Schur bounds
can use it as an ordinary Bochner-integrable majorant. -/
theorem integrable_quadraticTimeEnvelope_univ
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    Integrable (fun s : Real => quadraticTimeEnvelope Lambda t s) volume := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hf : Integrable f volume := by
    simpa only [f] using integrable_inv_one_add_sq
  have hscale : Integrable (fun x : Real => f (Lambda * x)) volume :=
    hf.comp_mul_left' hLambda.ne'
  have htranslate : Integrable (fun s : Real => f (Lambda * (s - t))) volume := by
    simpa only [sub_eq_add_neg] using hscale.comp_sub_right t
  refine htranslate.congr ?_
  filter_upwards with s
  unfold quadraticTimeEnvelope
  dsimp only [f]
  congr 2
  ring

/-- The fixed nonnegative majorant of the unit interval in the row estimate. -/
noncomputable def fourierRowBump (x : ℝ) : ℂ :=
  gevreyIntervalCutoff (-1) 0 1 2 x

theorem fourierRowBump_contDiff (n : ℕ) : ContDiff ℝ n fourierRowBump :=
  Complex.ofRealCLM.contDiff.comp (gevreyIntervalCutoff_contDiff n (-1) 0 1 2)

theorem fourierRowBump_hasCompactSupport : HasCompactSupport fourierRowBump :=
  (gevreyIntervalCutoff_hasCompactSupport (by norm_num : (-1 : ℝ) < 0)
    (by norm_num : (1 : ℝ) < 2)).comp_left (by simp : ((0 : ℝ) : ℂ) = 0)

theorem hasCompactSupport_iteratedDeriv {f : ℝ → ℂ} (hf : HasCompactSupport f) (n : ℕ) :
    HasCompactSupport (iteratedDeriv n f) := by
  induction n with
  | zero => simpa using hf
  | succ n ih => simpa only [iteratedDeriv_succ] using ih.deriv

theorem integrable_iteratedDeriv_fourierRowBump (n : ℕ) :
    Integrable (iteratedDeriv n fourierRowBump) :=
  ((fourierRowBump_contDiff n).continuous_iteratedDeriv n le_rfl).integrable_of_hasCompactSupport
    (hasCompactSupport_iteratedDeriv fourierRowBump_hasCompactSupport n)

theorem fourierRowBump_eq_one {x : ℝ} (hx : x ∈ Set.Icc (0 : ℝ) 1) :
    fourierRowBump x = 1 := by
  simp [fourierRowBump, gevreyIntervalCutoff_eq_one (by norm_num : (-1 : ℝ) < 0)
    (by norm_num : (1 : ℝ) < 2) hx]

/-- The constant obtained by twice integrating the fixed bump by parts. -/
noncomputable def fourierRowConstant : ℝ :=
  (∫ x, ‖fourierRowBump x‖) + (4 * Real.pi ^ 2)⁻¹ *
    ∫ x, ‖iteratedDeriv 2 fourierRowBump x‖

theorem fourierRowConstant_nonneg : 0 ≤ fourierRowConstant := by
  unfold fourierRowConstant
  positivity

open scoped FourierTransform in
/-- Blueprint Lemma `lem:fourier-foundation`, line 148: the Gram envelope
from two integrations by parts, including the zero-frequency bound. -/
theorem fourierRowBump_fourier_bound (u : ℝ) :
    ‖𝓕 fourierRowBump u‖ ≤ fourierRowConstant * (1 + u ^ 2)⁻¹ := by
  have h := Real.one_add_sq_mul_norm_fourier_le (fourierRowBump_contDiff 2)
    (fun k _ => integrable_iteratedDeriv_fourierRowBump k) u
  rw [← div_eq_mul_inv, le_div_iff₀ (by positivity)]
  simpa only [fourierRowConstant, mul_comm] using h

/-- The left endpoint of a half-spacing interval extending toward a fixed center. -/
noncomputable def frequencyPackingLeft (x δ ξ : ℝ) : ℝ :=
  if ξ ≤ x then ξ else ξ - δ / 2

/-- Disjoint half-spacing intervals used to sum a decreasing Gram envelope. -/
def frequencyPackingInterval (x δ ξ : ℝ) : Set ℝ :=
  Set.Ioc (frequencyPackingLeft x δ ξ) (frequencyPackingLeft x δ ξ + δ / 2)

theorem frequencyPackingInterval_subset {x δ ξ : ℝ} (hδ : 0 ≤ δ) :
    frequencyPackingInterval x δ ξ ⊆ Set.Ioc (ξ - δ / 2) (ξ + δ / 2) := by
  intro t ht
  dsimp [frequencyPackingInterval, frequencyPackingLeft] at ht
  split_ifs at ht <;> constructor <;> linarith [ht.1, ht.2]

theorem frequencyPackingInterval_disjoint {x δ ξ η : ℝ} (hδ : 0 ≤ δ)
    (hsep : δ ≤ |ξ - η|) :
    Disjoint (frequencyPackingInterval x δ ξ) (frequencyPackingInterval x δ η) := by
  apply Set.disjoint_left.mpr
  intro t ht ht'
  have hξ := frequencyPackingInterval_subset hδ ht
  have hη := frequencyPackingInterval_subset hδ ht'
  have hlt : |ξ - η| < δ := abs_lt.mpr ⟨by linarith [hξ.2, hη.1],
    by linarith [hξ.1, hη.2]⟩
  linarith

theorem frequencyPackingInterval_distance_le {x δ ξ t : ℝ} (hδ : 0 ≤ δ)
    (hsep : δ ≤ |ξ - x|) (ht : t ∈ frequencyPackingInterval x δ ξ) :
    |x - t| ≤ |x - ξ| := by
  dsimp [frequencyPackingInterval, frequencyPackingLeft] at ht
  split_ifs at ht with hξ
  · rw [abs_of_nonpos (sub_nonpos.mpr hξ)] at hsep
    have htx : t ≤ x := by linarith [ht.2]
    rw [abs_of_nonneg (sub_nonneg.mpr htx), abs_of_nonneg (sub_nonneg.mpr hξ)]
    linarith [ht.1]
  · have hxξ : x ≤ ξ := le_of_lt (lt_of_not_ge hξ)
    rw [abs_of_nonneg (sub_nonneg.mpr hxξ)] at hsep
    have hxt : x ≤ t := by linarith [ht.1]
    rw [abs_of_nonpos (sub_nonpos.mpr hxt), abs_of_nonpos (sub_nonpos.mpr hxξ)]
    linarith [ht.2]

theorem quadraticTimeEnvelope_nonneg (r x t : ℝ) : 0 ≤ quadraticTimeEnvelope r x t := by
  unfold quadraticTimeEnvelope
  positivity

theorem quadraticTimeEnvelope_le_on_packingInterval {r x δ ξ t : ℝ}
    (hδ : 0 ≤ δ) (hsep : δ ≤ |ξ - x|) (ht : t ∈ frequencyPackingInterval x δ ξ) :
    quadraticTimeEnvelope r x ξ ≤ quadraticTimeEnvelope r x t := by
  have hd := frequencyPackingInterval_distance_le hδ hsep ht
  have hsq : (r * (x - t)) ^ 2 ≤ (r * (x - ξ)) ^ 2 := by
    rw [mul_pow, mul_pow]
    apply mul_le_mul_of_nonneg_left _ (sq_nonneg r)
    exact (sq_le_sq).mpr hd
  simpa only [quadraticTimeEnvelope, one_div] using
    one_div_le_one_div_of_le (show 0 < 1 + (r * (x - t)) ^ 2 by positivity)
      (by linarith)

theorem quadraticTimeEnvelope_mul_half_spacing_le_integral {r x δ ξ : ℝ}
    (hr : 0 < r) (hδ : 0 < δ) (hsep : δ ≤ |ξ - x|) :
    quadraticTimeEnvelope r x ξ * (δ / 2) ≤
      ∫ t in frequencyPackingInterval x δ ξ, quadraticTimeEnvelope r x t := by
  have hm : MeasurableSet (frequencyPackingInterval x δ ξ) := measurableSet_Ioc
  have hi := setIntegral_mono_on (f := fun _ : ℝ => quadraticTimeEnvelope r x ξ)
    (g := fun t => quadraticTimeEnvelope r x t) (s := frequencyPackingInterval x δ ξ)
    (integrableOn_const (by simp [frequencyPackingInterval, Real.volume_Ioc]))
    (integrable_quadraticTimeEnvelope_univ hr).integrableOn hm
    (fun t ht => quadraticTimeEnvelope_le_on_packingInterval hδ.le hsep ht)
  simpa [integral_const, Measure.real, frequencyPackingInterval, Real.volume_Ioc,
    ENNReal.toReal_ofReal (show 0 ≤ δ / 2 by positivity), mul_comm] using hi

/-- A separated family away from a fixed center has bounded total Gram envelope. -/
theorem sum_quadraticTimeEnvelope_off_center {ι : Type*} (s : Finset ι) (ξ : ι → ℝ)
    {r δ x : ℝ} (hr : 0 < r) (hδ : 0 < δ)
    (hsep : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → δ ≤ |ξ i - ξ j|)
    (haway : ∀ i ∈ s, δ ≤ |ξ i - x|) :
    ∑ i ∈ s, quadraticTimeEnvelope r x (ξ i) ≤ 2 * Real.pi / (r * δ) := by
  classical
  have hint := integrable_quadraticTimeEnvelope_univ (t := x) hr
  have hdisj : (↑s : Set ι).Pairwise
      (fun i j => Disjoint (frequencyPackingInterval x δ (ξ i))
        (frequencyPackingInterval x δ (ξ j))) := by
    intro i hi j hj hij
    exact frequencyPackingInterval_disjoint hδ.le (hsep i hi j hj hij)
  have htotal : (∑ i ∈ s, quadraticTimeEnvelope r x (ξ i)) * (δ / 2) ≤ Real.pi / r := by
    calc
      _ = ∑ i ∈ s, quadraticTimeEnvelope r x (ξ i) * (δ / 2) := Finset.sum_mul ..
      _ ≤ ∑ i ∈ s, ∫ t in frequencyPackingInterval x δ (ξ i),
          quadraticTimeEnvelope r x t := Finset.sum_le_sum
            (fun i hi => quadraticTimeEnvelope_mul_half_spacing_le_integral hr hδ (haway i hi))
      _ = ∫ t in ⋃ i ∈ s, frequencyPackingInterval x δ (ξ i),
          quadraticTimeEnvelope r x t :=
        (integral_biUnion_finset s (fun _ _ => measurableSet_Ioc) hdisj
          (fun _ _ => hint.integrableOn)).symm
      _ ≤ ∫ t, quadraticTimeEnvelope r x t :=
        setIntegral_le_integral hint (Filter.Eventually.of_forall
          (fun t => quadraticTimeEnvelope_nonneg r x t))
      _ = _ := integral_quadraticTimeEnvelope_univ_eq_pi_div hr
  have h := (le_div_iff₀ (show 0 < δ / 2 by positivity)).mpr htotal
  convert h using 1
  field_simp

/-- Blueprint Lemma `lem:fourier-foundation`, lines 149–152: a uniform
absolute row bound for separated frequencies. -/
theorem sum_quadraticTimeEnvelope_separated {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) {r δ : ℝ} (hr : 0 < r) (hδ : 0 < δ)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) (i : ι) :
    ∑ j, quadraticTimeEnvelope r (ξ i) (ξ j) ≤ 1 + 2 * Real.pi / (r * δ) := by
  classical
  rw [← Finset.add_sum_erase Finset.univ (fun j => quadraticTimeEnvelope r (ξ i) (ξ j))
    (Finset.mem_univ i)]
  have h := sum_quadraticTimeEnvelope_off_center (Finset.univ.erase i) ξ hr hδ
    (fun j _ k _ hjk => hsep j k hjk)
    (fun j hj => hsep j i (Finset.mem_erase.mp hj).1)
  simpa [quadraticTimeEnvelope, add_comm] using add_le_add_left h 1

/-- Blueprint Lemma `lem:fourier-foundation`, lines 153–157: finite Schur
bound for vector-valued entries, controlled by nonnegative scalar row and column sums. -/
theorem finite_schur_bound {ι κ : Type*} [Fintype ι] [Fintype κ]
    {E : ι → Type*} [∀ i, SeminormedAddCommGroup (E i)]
    (v : ∀ i, κ → E i) (a : ι → κ → ℝ) (z : κ → ℝ) {B : ℝ}
    (hB : 0 ≤ B) (ha : ∀ i j, 0 ≤ a i j) (_hz : ∀ j, 0 ≤ z j)
    (hv : ∀ i j, ‖v i j‖ ≤ a i j * z j)
    (hrow : ∀ i, ∑ j, a i j ≤ B) (hcol : ∀ j, ∑ i, a i j ≤ B) :
    ∑ i, ‖∑ j, v i j‖ ^ 2 ≤ B ^ 2 * ∑ j, z j ^ 2 := by
  have hi : ∀ i, ‖∑ j, v i j‖ ^ 2 ≤ B * ∑ j, a i j * z j ^ 2 := by
    intro i
    have hn : ‖∑ j, v i j‖ ≤ ∑ j, a i j * z j :=
      (norm_sum_le _ _).trans (Finset.sum_le_sum (fun j _ => hv i j))
    calc
      _ ≤ (∑ j, a i j * z j) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) hn 2
      _ ≤ (∑ j, a i j) * ∑ j, a i j * z j ^ 2 :=
        Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul Finset.univ
          (fun j _ => ha i j) (fun j _ => mul_nonneg (ha i j) (sq_nonneg _))
          (fun j _ => by ring_nf; exact le_rfl)
      _ ≤ _ := mul_le_mul_of_nonneg_right (hrow i)
        (Finset.sum_nonneg (fun j _ => mul_nonneg (ha i j) (sq_nonneg _)))
  calc
    _ ≤ ∑ i, B * ∑ j, a i j * z j ^ 2 := Finset.sum_le_sum (fun i _ => hi i)
    _ = B * ∑ j, (∑ i, a i j) * z j ^ 2 := by
      rw [← Finset.mul_sum, Finset.sum_comm]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      rw [Finset.sum_mul]
    _ ≤ B * ∑ j, B * z j ^ 2 := by
      apply mul_le_mul_of_nonneg_left _ hB
      exact Finset.sum_le_sum (fun j _ =>
        mul_le_mul_of_nonneg_right (hcol j) (sq_nonneg _))
    _ = _ := by rw [← Finset.mul_sum]; ring

/-- The scalar matrix form of the Schur estimate displayed in the blueprint. -/
theorem complex_matrix_schur_bound {ι κ : Type*} [Fintype ι] [Fintype κ]
    (a : ι → κ → ℂ) (z : κ → ℂ) {B : ℝ} (hB : 0 ≤ B)
    (hrow : ∀ i, ∑ j, ‖a i j‖ ≤ B) (hcol : ∀ j, ∑ i, ‖a i j‖ ≤ B) :
    ∑ i, ‖∑ j, a i j * z j‖ ^ 2 ≤ B ^ 2 * ∑ j, ‖z j‖ ^ 2 :=
  finite_schur_bound (fun i j => a i j * z j) (fun i j => ‖a i j‖) (fun j => ‖z j‖)
    hB (fun _ _ => norm_nonneg _) (fun _ => norm_nonneg _)
    (fun _ _ => le_of_eq (norm_mul _ _)) hrow hcol

/-- The quadratic-form version of the finite Schur test. -/
theorem finite_schur_quadratic {ι : Type*} [Fintype ι]
    (a : ι → ι → ℝ) (z : ι → ℝ) {B : ℝ} (ha : ∀ i j, 0 ≤ a i j)
    (hrow : ∀ i, ∑ j, a i j ≤ B) (hcol : ∀ j, ∑ i, a i j ≤ B) :
    ∑ i, ∑ j, a i j * z i * z j ≤ B * ∑ i, z i ^ 2 := by
  have hrow' : (∑ i, ∑ j, a i j * z i ^ 2) ≤ B * ∑ i, z i ^ 2 := by
    calc
      _ = ∑ i, (∑ j, a i j) * z i ^ 2 := by simp_rw [Finset.sum_mul]
      _ ≤ ∑ i, B * z i ^ 2 := Finset.sum_le_sum (fun i _ =>
        mul_le_mul_of_nonneg_right (hrow i) (sq_nonneg _))
      _ = _ := (Finset.mul_sum ..).symm
  have hcol' : (∑ i, ∑ j, a i j * z j ^ 2) ≤ B * ∑ j, z j ^ 2 := by
    rw [Finset.sum_comm]
    calc
      _ = ∑ j, (∑ i, a i j) * z j ^ 2 := by simp_rw [Finset.sum_mul]
      _ ≤ ∑ j, B * z j ^ 2 := Finset.sum_le_sum (fun j _ =>
        mul_le_mul_of_nonneg_right (hcol j) (sq_nonneg _))
      _ = _ := (Finset.mul_sum ..).symm
  have hterm : ∀ i j, 2 * (a i j * z i * z j) ≤ a i j * z i ^ 2 + a i j * z j ^ 2 := by
    intro i j
    nlinarith [mul_nonneg (ha i j) (sq_nonneg (z i - z j))]
  have hsum := Finset.sum_le_sum (s := Finset.univ) (fun i _ =>
    Finset.sum_le_sum (s := Finset.univ) (fun j _ => hterm i j))
  simp only [Finset.sum_add_distrib, ← Finset.mul_sum] at hsum
  linarith

open scoped ComplexConjugate FourierTransform

/-- The convention `e(ξ x) = exp(2π i ξ x)` used in the blueprint. -/
noncomputable def fourierWave (ξ x : ℝ) : ℂ := Real.fourierChar (ξ * x)

theorem fourierWave_continuous (ξ : ℝ) : Continuous (fourierWave ξ) :=
  continuous_subtype_val.comp
    (Real.continuous_fourierChar.comp (continuous_const.mul continuous_id))

theorem norm_fourierWave (ξ x : ℝ) : ‖fourierWave ξ x‖ = 1 := Circle.norm_coe _

theorem fourierWave_mul_conj (ξ η x : ℝ) :
    fourierWave ξ x * conj (fourierWave η x) = fourierWave (ξ - η) x := by
  unfold fourierWave
  rw [← Circle.coe_inv_eq_conj, ← Circle.coe_mul, ← AddChar.map_neg_eq_inv,
    ← AddChar.map_add_eq_mul]
  congr 2
  ring

/-- The Gram entry for the fixed smooth majorant of `[0,1]`. -/
noncomputable def fourierRowGram (ξ η : ℝ) : ℂ :=
  ∫ x, fourierRowBump x * fourierWave ξ x * conj (fourierWave η x)

theorem integrable_fourierRowGram_integrand (ξ η : ℝ) :
    Integrable (fun x => fourierRowBump x * fourierWave ξ x * conj (fourierWave η x)) :=
  (((fourierRowBump_contDiff 0).continuous.mul (fourierWave_continuous ξ)).mul
    (fourierWave_continuous η).star).integrable_of_hasCompactSupport
      fourierRowBump_hasCompactSupport.mul_right.mul_right

theorem fourierRowGram_eq_fourier (ξ η : ℝ) :
    fourierRowGram ξ η = 𝓕 fourierRowBump (η - ξ) := by
  rw [fourierRowGram, Real.fourier_eq]
  apply integral_congr_ae
  filter_upwards [] with x
  rw [mul_assoc, fourierWave_mul_conj]
  simp only [fourierWave, RCLike.inner_apply, conj_trivial, Circle.smul_def, smul_eq_mul]
  have h : (ξ - η) * x = -(x * (η - ξ)) := by ring
  rw [h]
  simp [mul_comm]

theorem norm_fourierRowGram_le (ξ η : ℝ) :
    ‖fourierRowGram ξ η‖ ≤ fourierRowConstant * quadraticTimeEnvelope 1 ξ η := by
  rw [fourierRowGram_eq_fourier]
  have h := fourierRowBump_fourier_bound (η - ξ)
  simpa [quadraticTimeEnvelope, sub_sq_comm] using h

theorem fourierRowGram_row_bound {ι : Type*} [Fintype ι] (ξ : ι → ℝ) {δ : ℝ}
    (hδ : 0 < δ) (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) (i : ι) :
    ∑ j, ‖fourierRowGram (ξ i) (ξ j)‖ ≤ fourierRowConstant * (1 + 2 * Real.pi / δ) := by
  calc
    _ ≤ ∑ j, fourierRowConstant * quadraticTimeEnvelope 1 (ξ i) (ξ j) :=
      Finset.sum_le_sum (fun j _ => norm_fourierRowGram_le _ _)
    _ = fourierRowConstant * ∑ j, quadraticTimeEnvelope 1 (ξ i) (ξ j) :=
      (Finset.mul_sum ..).symm
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (by simpa using (sum_quadraticTimeEnvelope_separated ξ
        (by norm_num : (0 : ℝ) < 1) hδ hsep i)) fourierRowConstant_nonneg

/-- The real-valued fixed majorant underlying `fourierRowBump`. -/
noncomputable def fourierRowWeight (x : ℝ) : ℝ := gevreyIntervalCutoff (-1) 0 1 2 x

theorem fourierRowWeight_nonneg (x : ℝ) : 0 ≤ fourierRowWeight x :=
  (gevreyIntervalCutoff_mem_Icc (-1) 0 1 2 x).1

theorem fourierRowWeight_continuous : Continuous fourierRowWeight :=
  (gevreyIntervalCutoff_contDiff 0 (-1) 0 1 2).continuous

theorem fourierRowWeight_hasCompactSupport : HasCompactSupport fourierRowWeight :=
  gevreyIntervalCutoff_hasCompactSupport (by norm_num : (-1 : ℝ) < 0)
    (by norm_num : (1 : ℝ) < 2)

/-- A finite exponential sum with arbitrary real frequencies. -/
noncomputable def fourierPolynomial {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) (x : ℝ) : ℂ := ∑ i, c i * fourierWave (ξ i) x

theorem fourierPolynomial_continuous {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) : Continuous (fourierPolynomial ξ c) :=
  continuous_finsetSum _ (fun i _ => continuous_const.mul (fourierWave_continuous (ξ i)))

theorem integrable_fourierRowWeightedEnergy {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) :
    Integrable (fun x => fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2) := by
  have h := fourierRowWeight_continuous.mul ((fourierPolynomial_continuous ξ c).norm.pow 2)
  exact h.integrable_of_hasCompactSupport fourierRowWeight_hasCompactSupport.mul_right

/-- Exact finite Gram expansion for the weighted exponential sum. -/
theorem fourierRowWeightedEnergy_eq_gram {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) :
    ((∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 : ℝ) : ℂ) =
      ∑ i, ∑ j, (c i * conj (c j)) * fourierRowGram (ξ i) (ξ j) := by
  have hpoint : ∀ x, ((fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 : ℝ) : ℂ) =
      ∑ i, ∑ j, (c i * conj (c j)) *
        (fourierRowBump x * fourierWave (ξ i) x * conj (fourierWave (ξ j) x)) := by
    intro x
    rw [Complex.ofReal_mul, ← Complex.normSq_eq_norm_sq, ← Complex.mul_conj]
    change fourierRowBump x * (fourierPolynomial ξ c x * conj (fourierPolynomial ξ c x)) = _
    simp only [fourierPolynomial, map_sum, map_mul, Finset.sum_mul, Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    ring
  have hInt : ∀ i j, Integrable (fun x => (c i * conj (c j)) *
      (fourierRowBump x * fourierWave (ξ i) x * conj (fourierWave (ξ j) x))) :=
    fun i j => (integrable_fourierRowGram_integrand (ξ i) (ξ j)).const_mul _
  rw [← integral_complex_ofReal]
  simp_rw [hpoint]
  rw [integral_finsetSum _ (fun i _ => integrable_finsetSum _ (fun j _ => hInt i j))]
  apply Finset.sum_congr rfl
  intro i _
  rw [integral_finsetSum _ (fun j _ => hInt i j)]
  apply Finset.sum_congr rfl
  intro j _
  rw [integral_const_mul]
  rfl

theorem fourierRowGram_swap (ξ η : ℝ) : fourierRowGram η ξ = conj (fourierRowGram ξ η) := by
  unfold fourierRowGram
  rw [← integral_conj]
  apply integral_congr_ae
  filter_upwards [] with x
  simp only [map_mul, fourierRowBump, Complex.conj_ofReal, starRingEnd_self_apply]
  ring

/-- The smooth majorant's weighted energy is bounded by the separated Gram rows. -/
theorem fourierRowWeightedEnergy_le {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) {δ : ℝ} (hδ : 0 < δ)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) :
    (∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2) ≤
      (fourierRowConstant * (1 + 2 * Real.pi / δ)) * ∑ i, ‖c i‖ ^ 2 := by
  have hnonneg : 0 ≤ ∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 :=
    integral_nonneg (fun x => mul_nonneg (fourierRowWeight_nonneg x) (sq_nonneg _))
  have hcol : ∀ j, ∑ i, ‖fourierRowGram (ξ i) (ξ j)‖ ≤
      fourierRowConstant * (1 + 2 * Real.pi / δ) := by
    intro j
    have h := fourierRowGram_row_bound ξ hδ hsep j
    simpa only [fourierRowGram_swap (ξ j), Complex.norm_conj] using h
  calc
    _ = ‖((∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 : ℝ) : ℂ)‖ :=
      (Complex.norm_of_nonneg hnonneg).symm
    _ = ‖∑ i, ∑ j, (c i * conj (c j)) * fourierRowGram (ξ i) (ξ j)‖ :=
      congrArg norm (fourierRowWeightedEnergy_eq_gram ξ c)
    _ ≤ ∑ i, ∑ j, ‖(c i * conj (c j)) * fourierRowGram (ξ i) (ξ j)‖ :=
      (norm_sum_le _ _).trans (Finset.sum_le_sum (fun i _ => norm_sum_le _ _))
    _ = ∑ i, ∑ j, ‖fourierRowGram (ξ i) (ξ j)‖ * ‖c i‖ * ‖c j‖ := by
      simp only [norm_mul, Complex.norm_conj]
      congr 1
      funext i
      congr 1
      funext j
      ring
    _ ≤ _ := finite_schur_quadratic (fun i j => ‖fourierRowGram (ξ i) (ξ j)‖)
      (fun i => ‖c i‖) (fun _ _ => norm_nonneg _)
      (fourierRowGram_row_bound ξ hδ hsep) hcol

/-- The unit-interval separated exponential-sum estimate in the blueprint. -/
theorem integral_fourierPolynomial_unit_le {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) {δ : ℝ} (hδ : 0 < δ)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) :
    (∫ x in Set.Icc (0 : ℝ) 1, ‖fourierPolynomial ξ c x‖ ^ 2) ≤
      (fourierRowConstant * (1 + 2 * Real.pi / δ)) * ∑ i, ‖c i‖ ^ 2 := by
  calc
    _ = ∫ x in Set.Icc (0 : ℝ) 1,
        fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 := by
      apply setIntegral_congr_fun measurableSet_Icc
      intro x hx
      have hw : fourierRowWeight x = 1 :=
        gevreyIntervalCutoff_eq_one (by norm_num : (-1 : ℝ) < 0)
          (by norm_num : (1 : ℝ) < 2) hx
      simp only [hw, one_mul]
    _ ≤ ∫ x, fourierRowWeight x * ‖fourierPolynomial ξ c x‖ ^ 2 :=
      setIntegral_le_integral (integrable_fourierRowWeightedEnergy ξ c)
        (Filter.Eventually.of_forall (fun x =>
          mul_nonneg (fourierRowWeight_nonneg x) (sq_nonneg _)))
    _ ≤ _ := fourierRowWeightedEnergy_le ξ c hδ hsep

theorem fourierWave_affine (ξ r a x : ℝ) :
    fourierWave ξ (r * x + a) = fourierWave ξ a * fourierWave (r * ξ) x := by
  unfold fourierWave
  rw [← Circle.coe_mul, ← AddChar.map_add_eq_mul]
  congr 2
  ring

theorem fourierPolynomial_affine {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) (r a x : ℝ) :
    fourierPolynomial ξ c (r * x + a) =
      fourierPolynomial (fun i => r * ξ i) (fun i => c i * fourierWave (ξ i) a) x := by
  unfold fourierPolynomial
  apply Finset.sum_congr rfl
  intro i _
  rw [fourierWave_affine]
  ring

/-- Affine normalization of an ordinary interval integral. -/
theorem integral_Icc_eq_length_mul_unit (f : ℝ → ℝ) {a b : ℝ} (hab : a ≤ b) :
    (∫ x in Set.Icc a b, f x) =
      (b - a) * ∫ x in Set.Icc (0 : ℝ) 1, f ((b - a) * x + a) := by
  rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab,
    integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1)]
  simp

/-- Blueprint Lemma `lem:fourier-foundation`, lines 137–141: the separated
exponential-sum estimate on any real interval, with an explicit absolute constant. -/
theorem integral_fourierPolynomial_interval_le {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) {δ a b : ℝ} (hδ : 0 < δ) (hab : a ≤ b)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) :
    (∫ x in Set.Icc a b, ‖fourierPolynomial ξ c x‖ ^ 2) ≤
      fourierRowConstant * ((b - a) + 2 * Real.pi / δ) * ∑ i, ‖c i‖ ^ 2 := by
  rcases hab.eq_or_lt with rfl | hab
  · simp only [Set.Icc_self, integral_singleton, sub_self, zero_add]
    simp only [measureReal_def, measure_singleton, ENNReal.toReal_zero, zero_smul]
    exact mul_nonneg (mul_nonneg fourierRowConstant_nonneg
      (show 0 ≤ 2 * Real.pi / δ by positivity))
      (Finset.sum_nonneg (fun _ _ => sq_nonneg _))
  let r := b - a
  have hr : 0 < r := sub_pos.mpr hab
  have hsep' : ∀ i j, i ≠ j → r * δ ≤ |r * ξ i - r * ξ j| := by
    intro i j hij
    rw [← mul_sub, abs_mul, abs_of_pos hr]
    exact mul_le_mul_of_nonneg_left (hsep i j hij) hr.le
  have hunit := integral_fourierPolynomial_unit_le (fun i => r * ξ i)
    (fun i => c i * fourierWave (ξ i) a) (mul_pos hr hδ) hsep'
  simp only [norm_mul, norm_fourierWave, mul_one] at hunit
  rw [integral_Icc_eq_length_mul_unit _ hab.le]
  change r * (∫ x in Set.Icc (0 : ℝ) 1, ‖fourierPolynomial ξ c (r * x + a)‖ ^ 2) ≤ _
  simp_rw [fourierPolynomial_affine]
  refine (mul_le_mul_of_nonneg_left hunit hr.le).trans_eq ?_
  change r * (fourierRowConstant * (1 + 2 * Real.pi / (r * δ)) * ∑ i, ‖c i‖ ^ 2) =
    fourierRowConstant * (r + 2 * Real.pi / δ) * ∑ i, ‖c i‖ ^ 2
  field_simp

/-- Finite Hilbert-space duality: a synthesis bound gives the same squared
constant in the analysis-row bound, as used in blueprint Lemma `lem:fourier-foundation`. -/
theorem analysis_bound_of_synthesis_bound {ι H : Type*} [Fintype ι]
    [SeminormedAddCommGroup H] [InnerProductSpace ℂ H]
    (v : ι → H) {B : ℝ} (hB : 0 ≤ B)
    (hsyn : ∀ c : ι → ℂ, ‖∑ i, c i • v i‖ ^ 2 ≤ B * ∑ i, ‖c i‖ ^ 2) (x : H) :
    ∑ i, ‖inner ℂ (v i) x‖ ^ 2 ≤ B * ‖x‖ ^ 2 := by
  let c : ι → ℂ := fun i => inner ℂ (v i) x
  let y := ∑ i, c i • v i
  let E : ℝ := ∑ i, ‖c i‖ ^ 2
  have hE : 0 ≤ E := Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  have hinner : inner ℂ y x = (E : ℂ) := by
    dsimp [y, E]
    rw [sum_inner, Complex.ofReal_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [inner_smul_left]
    change conj (c i) * c i = _
    rw [mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have hcs : E ^ 2 ≤ ‖y‖ ^ 2 * ‖x‖ ^ 2 := by
    have h := norm_inner_le_norm (𝕜 := ℂ) y x
    rw [hinner, Complex.norm_of_nonneg hE] at h
    simpa [mul_pow] using pow_le_pow_left₀ hE h 2
  have hy : ‖y‖ ^ 2 ≤ B * E := hsyn c
  change E ≤ B * ‖x‖ ^ 2
  rcases hE.eq_or_lt with hE | hE
  · rw [← hE]
    exact mul_nonneg hB (sq_nonneg _)
  · apply (mul_le_mul_iff_right₀ hE).mp
    have h := hcs.trans (mul_le_mul_of_nonneg_right hy (sq_nonneg ‖x‖))
    nlinarith

/-- A common bounded measurable multiplier costs the square of its bound in
the squared row estimate, as asserted in blueprint Lemma `lem:fourier-foundation`. -/
theorem integral_multiplier_fourierPolynomial_le {ι : Type*} [Fintype ι]
    (ξ : ι → ℝ) (c : ι → ℂ) {δ a b M : ℝ} (hδ : 0 < δ) (hab : a ≤ b)
    (hsep : ∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|)
    (g : ℝ → ℂ) (hg : AEStronglyMeasurable g (volume.restrict (Set.Icc a b)))
    (hgbound : ∀ᵐ x ∂volume.restrict (Set.Icc a b), ‖g x‖ ≤ M) :
    (∫ x in Set.Icc a b, ‖g x * fourierPolynomial ξ c x‖ ^ 2) ≤
      M ^ 2 * (fourierRowConstant * ((b - a) + 2 * Real.pi / δ) * ∑ i, ‖c i‖ ^ 2) := by
  have hp := fourierPolynomial_continuous ξ c
  have hi : Integrable (fun x => M ^ 2 * ‖fourierPolynomial ξ c x‖ ^ 2)
      (volume.restrict (Set.Icc a b)) := (hp.norm.pow 2).integrableOn_Icc.const_mul _
  have hmeas : AEStronglyMeasurable (fun x => ‖g x * fourierPolynomial ξ c x‖ ^ 2)
      (volume.restrict (Set.Icc a b)) := (hg.mul hp.aestronglyMeasurable).norm.pow 2
  have hdom : ∀ᵐ x ∂volume.restrict (Set.Icc a b),
      ‖g x * fourierPolynomial ξ c x‖ ^ 2 ≤ M ^ 2 * ‖fourierPolynomial ξ c x‖ ^ 2 := by
    filter_upwards [hgbound] with x hx
    rw [norm_mul, mul_pow]
    exact mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) hx 2) (sq_nonneg _)
  have hgi := hi.mono' hmeas (hdom.mono (fun x hx => by
    simpa only [Real.norm_of_nonneg (sq_nonneg _)] using hx))
  calc
    _ ≤ ∫ x in Set.Icc a b, M ^ 2 * ‖fourierPolynomial ξ c x‖ ^ 2 :=
      integral_mono_ae hgi hi hdom
    _ = M ^ 2 * ∫ x in Set.Icc a b, ‖fourierPolynomial ξ c x‖ ^ 2 := integral_const_mul ..
    _ ≤ _ := mul_le_mul_of_nonneg_left
      (integral_fourierPolynomial_interval_le ξ c hδ hab hsep) (sq_nonneg _)

/-- The absolute constant form of the separated-frequency estimate, with
the same constant for all finite families, intervals, and positive spacings. -/
theorem exists_separated_fourier_interval_bound :
    ∃ C : ℝ, 0 < C ∧ ∀ (N : ℕ) (ξ : Fin N → ℝ) (c : Fin N → ℂ)
      (δ a b : ℝ), 0 < δ → a ≤ b →
      (∀ i j, i ≠ j → δ ≤ |ξ i - ξ j|) →
      (∫ x in Set.Icc a b, ‖fourierPolynomial ξ c x‖ ^ 2) ≤
        C * ((b - a) + δ⁻¹) * ∑ i, ‖c i‖ ^ 2 := by
  let C := 1 + fourierRowConstant * (1 + 2 * Real.pi)
  have hM0 := fourierRowConstant_nonneg
  have hC : 0 < C := by dsimp [C]; positivity
  refine ⟨C, hC, ?_⟩
  intro N ξ c δ a b hδ hab hsep
  have hM : fourierRowConstant ≤ C := by
    dsimp [C]
    nlinarith [fourierRowConstant_nonneg, Real.pi_pos]
  have hMπ : fourierRowConstant * (2 * Real.pi) ≤ C := by
    dsimp [C]
    linarith [fourierRowConstant_nonneg]
  refine (integral_fourierPolynomial_interval_le ξ c hδ hab hsep).trans ?_
  apply mul_le_mul_of_nonneg_right _ (Finset.sum_nonneg (fun _ _ => sq_nonneg _))
  calc
    _ = fourierRowConstant * (b - a) + (fourierRowConstant * (2 * Real.pi)) * δ⁻¹ := by
      rw [div_eq_mul_inv]; ring
    _ ≤ C * (b - a) + C * δ⁻¹ := add_le_add
      (mul_le_mul_of_nonneg_right hM (sub_nonneg.mpr hab))
      (mul_le_mul_of_nonneg_right hMπ (inv_nonneg.mpr hδ.le))
    _ = _ := by ring

/-- A derivative with one sign has variation bounded by its endpoint sizes. -/
theorem integral_abs_derivative_le_endpoints {a b : ℝ} {u u' : ℝ → ℝ}
    (hu : ∀ x ∈ Set.uIcc a b, HasDerivAt u (u' x) x)
    (hu' : IntervalIntegrable u' volume a b)
    (hsign : (∀ x ∈ Set.uIcc a b, 0 ≤ u' x) ∨ (∀ x ∈ Set.uIcc a b, u' x ≤ 0)) :
    (∫ x in a..b, |u' x|) ≤ |u a| + |u b| := by
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt hu hu'
  rcases hsign with hpos | hneg
  · have heq : (∫ x in a..b, |u' x|) = ∫ x in a..b, u' x :=
      intervalIntegral.integral_congr (fun x hx => abs_of_nonneg (hpos x hx))
    rw [heq, hFTC]
    linarith [le_abs_self (u b), neg_le_abs (u a)]
  · have heq : (∫ x in a..b, |u' x|) = ∫ x in a..b, -u' x :=
      intervalIntegral.integral_congr (fun x hx => abs_of_nonpos (hneg x hx))
    rw [heq, intervalIntegral.integral_neg, hFTC]
    linarith [le_abs_self (u a), neg_le_abs (u b)]

/-- Differentiating the blueprint's oscillatory wave along a real phase. -/
theorem hasDerivAt_fourierWave_comp {p : ℝ → ℝ} {q x : ℝ} (hp : HasDerivAt p q x) :
    HasDerivAt (fun t => fourierWave 1 (p t))
      (fourierWave 1 (p x) * (((2 * Real.pi * q : ℝ) : ℂ) * Complex.I)) x := by
  have hreal := hp.const_mul (2 * Real.pi)
  have harg : HasDerivAt (fun t => ((2 * Real.pi * p t : ℝ) : ℂ) * Complex.I)
      (((2 * Real.pi * q : ℝ) : ℂ) * Complex.I) x := by
    simpa only [Complex.real_smul] using hreal.smul_const Complex.I
  simpa only [fourierWave, one_mul, Real.fourierChar_apply] using harg.cexp

/-- One nonstationary integration by parts, with a real reciprocal amplitude.
The sign condition controls its total variation by the endpoint values. -/
theorem norm_integral_fourierWave_of_reciprocal {a b : ℝ} (hab : a ≤ b)
    (p q u u' : ℝ → ℝ) (hpcont : Continuous p)
    (hp : ∀ x ∈ Set.uIcc a b, HasDerivAt p (q x) x)
    (hu : ∀ x ∈ Set.uIcc a b, HasDerivAt u (u' x) x)
    (hu'cont : ContinuousOn u' (Set.uIcc a b))
    (hcancel : ∀ x ∈ Set.uIcc a b, u x * q x = 1)
    (hsign : (∀ x ∈ Set.uIcc a b, 0 ≤ u' x) ∨ (∀ x ∈ Set.uIcc a b, u' x ≤ 0)) :
    ‖∫ x in a..b, fourierWave 1 (p x)‖ ≤ 2 * (|u a| + |u b|) := by
  let E : ℝ → ℂ := fun x => fourierWave 1 (p x)
  let z : ℂ := ((2 * Real.pi : ℝ) : ℂ) * Complex.I
  have hEcont : Continuous E := (fourierWave_continuous 1).comp hpcont
  have hducont : ContinuousOn (fun x => (u' x : ℂ)) (Set.uIcc a b) :=
    Complex.continuous_ofReal.comp_continuousOn hu'cont
  have hduE : IntervalIntegrable (fun x => (u' x : ℂ) * E x) volume a b :=
    (hducont.mul hEcont.continuousOn).intervalIntegrable
  have hzE : IntervalIntegrable (fun x => z * E x) volume a b :=
    (continuous_const.mul hEcont).intervalIntegrable a b
  have hderiv : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (fun t => (u t : ℂ) * E t) ((u' x : ℂ) * E x + z * E x) x := by
    intro x hx
    have huc : HasDerivAt (fun t => (u t : ℂ)) (u' x : ℂ) x := by
      simpa using (hu x hx).smul_const (1 : ℂ)
    have h := huc.mul (hasDerivAt_fourierWave_comp (hp x hx))
    convert h using 1
    have hc : (u x : ℂ) * (q x : ℂ) = 1 := by exact_mod_cast hcancel x hx
    dsimp [E, z]
    push_cast
    linear_combination -((2 * Real.pi : ℂ) * Complex.I * fourierWave 1 (p x)) * hc
  have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv (hduE.add hzE)
  rw [intervalIntegral.integral_add hduE hzE, intervalIntegral.integral_const_mul] at hFTC
  have heq : z * (∫ x in a..b, E x) =
      (u b : ℂ) * E b - (u a : ℂ) * E a - ∫ x in a..b, (u' x : ℂ) * E x := by
    linear_combination hFTC
  have hEnorm : ∀ x, ‖E x‖ = 1 := fun x => norm_fourierWave _ _
  have hz : ‖z‖ = 2 * Real.pi := by
    dsimp [z]
    rw [norm_mul, Complex.norm_of_nonneg (by positivity), Complex.norm_I, mul_one]
  have hrem : ‖∫ x in a..b, (u' x : ℂ) * E x‖ ≤ |u a| + |u b| := by
    calc
      _ ≤ ∫ x in a..b, ‖(u' x : ℂ) * E x‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ = ∫ x in a..b, |u' x| := by
        simp only [norm_mul, hEnorm, mul_one, Complex.norm_real, Real.norm_eq_abs]
      _ ≤ _ := integral_abs_derivative_le_endpoints hu hu'cont.intervalIntegrable hsign
  have hmain : (2 * Real.pi) * ‖∫ x in a..b, E x‖ ≤
      |u b| + |u a| + (|u a| + |u b|) := by
    calc
      _ = ‖z * (∫ x in a..b, E x)‖ := by rw [norm_mul, hz]
      _ = _ := congrArg norm heq
      _ ≤ ‖(u b : ℂ) * E b - (u a : ℂ) * E a‖ +
          ‖∫ x in a..b, (u' x : ℂ) * E x‖ := norm_sub_le _ _
      _ ≤ (‖(u b : ℂ) * E b‖ + ‖(u a : ℂ) * E a‖) + (|u a| + |u b|) :=
        add_le_add (norm_sub_le _ _) hrem
      _ = _ := by simp only [norm_mul, hEnorm, mul_one, Complex.norm_real, Real.norm_eq_abs]
  have hpi : 1 ≤ 2 * Real.pi := by linarith [Real.two_le_pi]
  have hlow := mul_le_mul_of_nonneg_right hpi (norm_nonneg (∫ x in a..b, E x))
  change ‖∫ x in a..b, E x‖ ≤ _
  nlinarith

/-- Blueprint Lemma `lem:fourier-foundation`, lines 143 and 158: a real
quadratic phase whose derivative has modulus at least `A` has oscillatory integral
at most `4/A`. This includes linear phases and degenerate intervals. -/
theorem quadratic_oscillatory_integral_bound (α β γ : ℝ) {a b A : ℝ}
    (hab : a ≤ b) (hA : 0 < A)
    (hlower : ∀ x ∈ Set.Icc a b, A ≤ |2 * α * x + β|) :
    ‖∫ x in Set.Icc a b, fourierWave 1 (α * x ^ 2 + β * x + γ)‖ ≤ 4 / A := by
  let p : ℝ → ℝ := fun x => α * x ^ 2 + β * x + γ
  let q : ℝ → ℝ := fun x => 2 * α * x + β
  let u : ℝ → ℝ := fun x => (q x)⁻¹
  let u' : ℝ → ℝ := fun x => -(2 * α) / (q x) ^ 2
  have hn : ∀ x ∈ Set.uIcc a b, q x ≠ 0 := by
    intro x hx hzero
    rw [Set.uIcc_of_le hab] at hx
    have h := hlower x hx
    change A ≤ |q x| at h
    rw [hzero, abs_zero] at h
    linarith
  have hp : ∀ x ∈ Set.uIcc a b, HasDerivAt p (q x) x := by
    intro x _
    convert ((((hasDerivAt_id x).pow 2).const_mul α).add
      ((hasDerivAt_id x).const_mul β)).add_const γ using 1 <;> dsimp [p, q]
    all_goals ring
  have hq : ∀ x, HasDerivAt q (2 * α) x := by
    intro x
    simpa [q] using ((hasDerivAt_id x).const_mul (2 * α)).add_const β
  have hu : ∀ x ∈ Set.uIcc a b, HasDerivAt u (u' x) x :=
    fun x hx => (hq x).inv (hn x hx)
  have hu'cont : ContinuousOn u' (Set.uIcc a b) :=
    continuousOn_const.div ((by fun_prop : Continuous q).continuousOn.pow 2)
      (fun x hx => pow_ne_zero 2 (hn x hx))
  have hcancel : ∀ x ∈ Set.uIcc a b, u x * q x = 1 :=
    fun x hx => inv_mul_cancel₀ (hn x hx)
  have hsign : (∀ x ∈ Set.uIcc a b, 0 ≤ u' x) ∨
      (∀ x ∈ Set.uIcc a b, u' x ≤ 0) := by
    rcases le_total α 0 with hα | hα
    · left
      intro x _
      exact div_nonneg (by linarith) (sq_nonneg _)
    · right
      intro x _
      exact div_nonpos_of_nonpos_of_nonneg (by linarith) (sq_nonneg _)
  have hendpoint : ∀ x ∈ Set.Icc a b, |u x| ≤ A⁻¹ := by
    intro x hx
    dsimp [u]
    rw [abs_inv]
    simpa only [one_div] using one_div_le_one_div_of_le hA (hlower x hx)
  have h := norm_integral_fourierWave_of_reciprocal hab p q u u' (by fun_prop)
    hp hu hu'cont hcancel hsign
  have ha := hendpoint a ⟨le_rfl, hab⟩
  have hb := hendpoint b ⟨hab, le_rfl⟩
  rw [integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hab]
  change ‖∫ x in a..b, fourierWave 1 (p x)‖ ≤ _
  refine h.trans ?_
  rw [div_eq_mul_inv]
  linarith

/-! ### Haar cube averages

The Boolean parity and vertex splitting algebra below is adapted from
`../lean-dfr/DFR/Auto/SmoothingIneq3D/Smoothing3D.lean`, copyright 2026 Joris Roos,
Apache 2.0. Here parity counts true coordinates, exactly as in the supplied blueprint.
-/

/-- Conjugation to the power of a natural number, reduced modulo two. -/
noncomputable def cubeConj (n : ℕ) (z : ℂ) : ℂ := if Even n then z else conj z

theorem cubeConj_zero (z : ℂ) : cubeConj 0 z = z := by simp [cubeConj]

theorem cubeConj_succ (n : ℕ) (z : ℂ) : cubeConj (n + 1) z = conj (cubeConj n z) := by
  by_cases h : Even n <;> simp [cubeConj, h, Nat.even_add_one]

theorem norm_cubeConj (n : ℕ) (z : ℂ) : ‖cubeConj n z‖ = ‖z‖ := by
  by_cases h : Even n <;> simp [cubeConj, h]

/-- Hamming weight of a Boolean cube vertex. -/
def cubeWeight {j : ℕ} (ω : Fin j → Bool) : ℕ := ∑ i, if ω i then 1 else 0

/-- The group-valued shift `ω · h` at a cube vertex. -/
def cubeShift {G : Type*} [AddCommMonoid G] {j : ℕ}
    (h : Fin j → G) (ω : Fin j → Bool) : G := ∑ i, if ω i then h i else 0

theorem cubeWeight_cons {j : ℕ} (b : Bool) (ω : Fin j → Bool) :
    cubeWeight (Fin.cons b ω) = (if b then 1 else 0) + cubeWeight ω := by
  rw [cubeWeight, cubeWeight, Fin.sum_univ_succ]
  simp

theorem cubeShift_cons {G : Type*} [AddCommMonoid G] {j : ℕ}
    (h : Fin (j + 1) → G) (b : Bool) (ω : Fin j → Bool) :
    cubeShift h (Fin.cons b ω) = (if b then h 0 else 0) +
      cubeShift (fun i => h i.succ) ω := by
  simp [cubeShift, Fin.sum_univ_succ]

/-- Splitting a Boolean vertex into its first coordinate and its remaining face. -/
def cubeConsEquiv (j : ℕ) : Bool × (Fin j → Bool) ≃ (Fin (j + 1) → Bool) where
  toFun p := Fin.cons p.1 p.2
  invFun ω := (ω 0, fun i => ω i.succ)
  left_inv p := by ext <;> simp
  right_inv ω := by funext i; induction i using Fin.cases <;> simp

/-- The literal mixed cube integrand in blueprint `cube-definition`. -/
noncomputable def cubeIntegrand {G : Type*} [AddCommMonoid G] {j : ℕ}
    (f : (Fin j → Bool) → G → ℂ) (h : Fin j → G) (x : G) : ℂ :=
  ∏ ω : Fin j → Bool, cubeConj (cubeWeight ω) (f ω (x + cubeShift h ω))

/-- The mixed Gowers cube average with probability measure on every variable. -/
noncomputable def cubeAverage {G : Type*} [AddCommMonoid G] [MeasurableSpace G]
    (μ : Measure G) (j : ℕ) (f : (Fin j → Bool) → G → ℂ) : ℂ :=
  ∫ h : Fin j → G, ∫ x, cubeIntegrand f h x ∂μ ∂Measure.pi (fun _ => μ)

/-- The diagonal cube integrand, before taking a nonnegative root. -/
noncomputable def diagonalCubeIntegrand {G : Type*} [AddCommMonoid G]
    (j : ℕ) (f : G → ℂ) (h : Fin j → G) (x : G) : ℂ :=
  cubeIntegrand (fun _ => f) h x

theorem diagonalCubeIntegrand_zero {G : Type*} [AddCommMonoid G]
    (f : G → ℂ) (h : Fin 0 → G) (x : G) : diagonalCubeIntegrand 0 f h x = f x := by
  rw [diagonalCubeIntegrand, cubeIntegrand, Fintype.prod_unique]
  simp [cubeWeight, cubeShift, cubeConj]

/-- Separating one increment gives the product of a face and its conjugate translate. -/
theorem diagonalCubeIntegrand_succ {G : Type*} [AddCommMonoid G]
    (j : ℕ) (f : G → ℂ) (h : Fin (j + 1) → G) (x : G) :
    diagonalCubeIntegrand (j + 1) f h x =
      diagonalCubeIntegrand j f (fun i => h i.succ) x *
        conj (diagonalCubeIntegrand j f (fun i => h i.succ) (x + h 0)) := by
  unfold diagonalCubeIntegrand cubeIntegrand
  rw [← (cubeConsEquiv j).prod_comp
    (fun ω => cubeConj (cubeWeight ω) (f (x + cubeShift h ω))),
    Fintype.prod_prod_type, Fintype.prod_bool, map_prod, ← Finset.prod_mul_distrib,
    ← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro ω _
  simp [cubeConsEquiv, cubeWeight_cons, cubeShift_cons, Nat.add_comm 1,
    cubeConj_succ, add_assoc, mul_comm]

theorem measurable_cubeConj (n : ℕ) : Measurable (cubeConj n) := by
  change Measurable (fun z : ℂ => cubeConj n z)
  by_cases h : Even n
  · simp only [cubeConj, ite_eq_left h]
    exact measurable_id
  · simp only [cubeConj, ite_eq_right h]
    exact Complex.continuous_conj.measurable

theorem measurable_cubeShift {G : Type*} [AddCommMonoid G] [MeasurableSpace G]
    [MeasurableAdd₂ G] {j : ℕ} (ω : Fin j → Bool) :
    Measurable (fun h : Fin j → G => cubeShift h ω) := by
  unfold cubeShift
  fun_prop

theorem measurable_cubeIntegrand {G : Type*} [AddCommMonoid G] [MeasurableSpace G]
    [MeasurableAdd₂ G] {j : ℕ} (f : (Fin j → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) :
    Measurable (fun p : (Fin j → G) × G => cubeIntegrand f p.1 p.2) := by
  unfold cubeIntegrand
  apply Finset.measurable_prod
  intro ω _
  exact (measurable_cubeConj _).comp ((hf ω).comp
    (measurable_snd.add ((measurable_cubeShift ω).comp measurable_fst)))

theorem norm_cubeIntegrand_le {G : Type*} [AddCommMonoid G] {j : ℕ}
    (f : (Fin j → Bool) → G → ℂ) {M : ℝ}
    (hf : ∀ ω x, ‖f ω x‖ ≤ M) (h : Fin j → G) (x : G) :
    ‖cubeIntegrand f h x‖ ≤ M ^ (2 ^ j) := by
  unfold cubeIntegrand
  rw [norm_prod]
  have hp : (∏ ω : Fin j → Bool, ‖cubeConj (cubeWeight ω) (f ω (x + cubeShift h ω))‖) ≤
      ∏ _ω : Fin j → Bool, M :=
    Finset.prod_le_prod₀ (fun _ _ => norm_nonneg _) (fun ω _ => by
      simpa only [norm_cubeConj] using hf ω (x + cubeShift h ω))
  simpa using hp

/-- A bounded measurable complex function on a finite measure space is integrable. -/
theorem integrable_of_measurable_bounded {X : Type*} [MeasurableSpace X]
    {μ : Measure X} [IsFiniteMeasure μ] {f : X → ℂ} (hf : Measurable f)
    {M : ℝ} (hbound : ∀ x, ‖f x‖ ≤ M) : Integrable f μ :=
  (integrable_const M).mono' hf.aestronglyMeasurable (Filter.Eventually.of_forall hbound)

/-- Haar independence of a point and its independent translate. -/
theorem integral_haar_correlation {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (f : G → ℂ) (hf : Measurable f) {M : ℝ} (hbound : ∀ x, ‖f x‖ ≤ M) :
    (∫ h, ∫ x, f x * conj (f (x + h)) ∂μ ∂μ) = ((‖∫ x, f x ∂μ‖ ^ 2 : ℝ) : ℂ) := by
  have hM : 0 ≤ M := (norm_nonneg (f 0)).trans (hbound 0)
  have hmeas : Measurable (fun p : G × G => f p.2 * conj (f (p.2 + p.1))) :=
    (hf.comp measurable_snd).mul (Complex.continuous_conj.measurable.comp
      (hf.comp (measurable_snd.add measurable_fst)))
  have hint : Integrable (fun p : G × G => f p.2 * conj (f (p.2 + p.1))) (μ.prod μ) :=
    integrable_of_measurable_bounded hmeas (fun p => by
      rw [norm_mul, Complex.norm_conj]
      exact mul_le_mul (hbound _) (hbound _) (norm_nonneg _) hM)
  rw [integral_integral_swap hint]
  simp_rw [integral_const_mul]
  have htranslation (x : G) : (∫ h, conj (f (x + h)) ∂μ) = ∫ h, conj (f h) ∂μ :=
    integral_add_left_eq_self (fun h => conj (f h)) x
  simp_rw [htranslation]
  rw [integral_conj, integral_mul_const, Complex.mul_conj, Complex.normSq_eq_norm_sq]

/-- Fubini splitting of the first coordinate of a finite probability product. -/
theorem integral_pi_cons {G : Type*} [MeasurableSpace G]
    (μ : Measure G) [IsProbabilityMeasure μ] {j : ℕ}
    (F : (Fin (j + 1) → G) → ℂ) (hF : Measurable F) {M : ℝ}
    (hbound : ∀ h, ‖F h‖ ≤ M) :
    (∫ h, F h ∂Measure.pi (fun _ : Fin (j + 1) => μ)) =
      ∫ h, ∫ t, F (Fin.cons t h) ∂μ ∂Measure.pi (fun _ : Fin j => μ) := by
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (j + 1) => G) 0
  have hmp := (measurePreserving_piFinSuccAbove (fun _ : Fin (j + 1) => μ) 0).symm
  have hInt : Integrable (fun p : G × (Fin j → G) => F (e.symm p))
      (μ.prod (Measure.pi (fun _ : Fin j => μ))) :=
    integrable_of_measurable_bounded (hF.comp e.symm.measurable) (fun p => hbound _)
  rw [← hmp.integral_comp']
  change (∫ p : G × (Fin j → G), F (e.symm p) ∂μ.prod (Measure.pi (fun _ => μ))) = _
  rw [integral_prod_symm _ hInt]
  apply integral_congr_ae
  filter_upwards [] with h
  apply integral_congr_ae
  filter_upwards [] with t
  congr 1
  simp [e, MeasurableEquiv.piFinSuccAbove_symm_apply, Fin.insertNthEquiv]

/-- Blueprint `cube-definition`, lines 168–172: the diagonal cube average
is the average of squared absolute face averages. This proves both reality and positivity. -/
theorem cubeAverage_diagonal_eq_integral_sq {G : Type*} [AddCommGroup G]
    [MeasurableSpace G] [MeasurableAdd₂ G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (j : ℕ) (f : G → ℂ) (hf : Measurable f) {M : ℝ} (hbound : ∀ x, ‖f x‖ ≤ M) :
    cubeAverage μ (j + 1) (fun _ => f) =
      ((∫ h : Fin j → G, ‖∫ x, diagonalCubeIntegrand j f h x ∂μ‖ ^ 2
        ∂Measure.pi (fun _ => μ) : ℝ) : ℂ) := by
  have hmeas := measurable_cubeIntegrand (j := j + 1) (fun _ => f) (fun _ => hf)
  have hinnerMeas : Measurable (fun h : Fin (j + 1) → G =>
      ∫ x, cubeIntegrand (fun _ => f) h x ∂μ) :=
    hmeas.stronglyMeasurable.integral_prod_right.measurable
  have hinnerBound : ∀ h : Fin (j + 1) → G,
      ‖∫ x, cubeIntegrand (fun _ => f) h x ∂μ‖ ≤ M ^ (2 ^ (j + 1)) := by
    intro h
    simpa using norm_integral_le_of_norm_le_const (μ := μ)
      (Filter.Eventually.of_forall (fun x => norm_cubeIntegrand_le
        (fun _ => f) (fun _ => hbound) h x))
  rw [cubeAverage, integral_pi_cons μ _ hinnerMeas hinnerBound, ← integral_complex_ofReal]
  apply integral_congr_ae
  filter_upwards [] with h
  have hfaceMeas : Measurable (diagonalCubeIntegrand j f h) :=
    (measurable_cubeIntegrand (fun _ => f) (fun _ => hf)).comp
      (measurable_const.prodMk measurable_id)
  have hfaceBound : ∀ x, ‖diagonalCubeIntegrand j f h x‖ ≤ M ^ (2 ^ j) :=
    fun x => norm_cubeIntegrand_le (fun _ => f) (fun _ => hbound) h x
  have heq : ∀ t x, cubeIntegrand (fun _ => f) (Fin.cons t h) x =
      diagonalCubeIntegrand j f h x * conj (diagonalCubeIntegrand j f h (x + t)) := by
    intro t x
    change diagonalCubeIntegrand (j + 1) f (Fin.cons t h) x = _
    simpa only [Fin.cons_zero, Fin.cons_succ] using diagonalCubeIntegrand_succ j f (Fin.cons t h) x
  simp_rw [heq]
  exact integral_haar_correlation μ _ hfaceMeas hfaceBound

/-- Reality of every positive-order diagonal Haar cube average. -/
theorem cubeAverage_diagonal_im_eq_zero {G : Type*} [AddCommGroup G]
    [MeasurableSpace G] [MeasurableAdd₂ G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {j : ℕ} (hj : 1 ≤ j) (f : G → ℂ) (hf : Measurable f)
    {M : ℝ} (hbound : ∀ x, ‖f x‖ ≤ M) : (cubeAverage μ j (fun _ => f)).im = 0 := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
  rw [cubeAverage_diagonal_eq_integral_sq μ j f hf hbound]
  exact Complex.ofReal_im _

/-- Nonnegativity of every positive-order diagonal Haar cube average. -/
theorem cubeAverage_diagonal_re_nonneg {G : Type*} [AddCommGroup G]
    [MeasurableSpace G] [MeasurableAdd₂ G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {j : ℕ} (hj : 1 ≤ j) (f : G → ℂ) (hf : Measurable f)
    {M : ℝ} (hbound : ∀ x, ‖f x‖ ≤ M) : 0 ≤ (cubeAverage μ j (fun _ => f)).re := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
  rw [cubeAverage_diagonal_eq_integral_sq μ j f hf hbound, Complex.ofReal_re]
  exact integral_nonneg (fun _ => sq_nonneg _)

/-- Blueprint `cube-definition`, line 174: the nonnegative `2^j`-th root
of the diagonal cube average. Its positivity and root identity hold for `j ≥ 1`. -/
noncomputable def gowersNorm {G : Type*} [AddCommMonoid G] [MeasurableSpace G]
    (μ : Measure G) (j : ℕ) (f : G → ℂ) : ℝ :=
  (cubeAverage μ j (fun _ => f)).re ^ (((2 ^ j : ℕ) : ℝ)⁻¹)

theorem gowersNorm_nonneg {G : Type*} [AddCommGroup G]
    [MeasurableSpace G] [MeasurableAdd₂ G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {j : ℕ} (hj : 1 ≤ j) (f : G → ℂ) (hf : Measurable f)
    {M : ℝ} (hbound : ∀ x, ‖f x‖ ≤ M) : 0 ≤ gowersNorm μ j f :=
  Real.rpow_nonneg (cubeAverage_diagonal_re_nonneg μ hj f hf hbound) _

theorem gowersNorm_pow {G : Type*} [AddCommGroup G]
    [MeasurableSpace G] [MeasurableAdd₂ G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {j : ℕ} (hj : 1 ≤ j) (f : G → ℂ) (hf : Measurable f)
    {M : ℝ} (hbound : ∀ x, ‖f x‖ ≤ M) :
    gowersNorm μ j f ^ (2 ^ j) = (cubeAverage μ j (fun _ => f)).re :=
  Real.rpow_inv_natCast_pow (cubeAverage_diagonal_re_nonneg μ hj f hf hbound) (by positivity)

open scoped ENNReal

/-- Normalized counting measure, the Haar probability measure on a finite group. -/
noncomputable def finiteHaar (G : Type*) [Fintype G] [MeasurableSpace G] : Measure G :=
  ((Fintype.card G : ℝ≥0∞)⁻¹) • Measure.count

instance finiteHaar_isProbabilityMeasure (G : Type*) [Fintype G] [Nonempty G]
    [MeasurableSpace G] : IsProbabilityMeasure (finiteHaar G) := by
  constructor
  suffices (Fintype.card G : ℝ≥0∞)⁻¹ * Fintype.card G = 1 by
    simpa [finiteHaar] using this
  exact ENNReal.inv_mul_cancel (by positivity) (by simp)

instance finiteHaar_isAddLeftInvariant (G : Type*) [AddGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd G] :
    (finiteHaar G).IsAddLeftInvariant := by
  unfold finiteHaar
  infer_instance

/-- Probability-counting expectation written as a finite sum. -/
noncomputable def finiteAverage {G : Type*} [Fintype G] (f : G → ℂ) : ℂ :=
  (Fintype.card G : ℂ)⁻¹ * ∑ x, f x

theorem integral_finiteHaar {G : Type*} [Fintype G] [MeasurableSpace G]
    [MeasurableSingletonClass G] (f : G → ℂ) :
    (∫ x, f x ∂finiteHaar G) = finiteAverage f := by
  rw [finiteHaar, integral_smul_measure, integral_count]
  simp [finiteAverage, ENNReal.toReal_inv, Complex.real_smul]

/-- Probability-normalized convolution, with the source's subtraction convention. -/
noncomputable def finiteConvolution {G : Type*} [Fintype G] [AddGroup G]
    (f g : G → ℂ) (x : G) : ℂ := finiteAverage (fun y => f y * g (x - y))

/-! The following sign-moment helpers are adapted from
`../lean-variationalsw/VariationalSW/Auto/KhintchineInequality.lean`
(Copyright 2026 Joris Roos, Apache 2.0; original author Claude).
Only the upper-moment argument is needed here. -/
section Signs

variable {ι : Type*} [DecidableEq ι]

/-- The Rademacher signed sum `∑_{i ∈ s} ε_i v_i` attached to the sign pattern `u ⊆ s`:
`ε_i = 1` if `i ∈ u` and `ε_i = -1` otherwise. -/
def rademacherSum {G : Type*} [AddCommGroup G] (s u : Finset ι) (v : ι → G) : G :=
  ∑ i ∈ s, if i ∈ u then v i else -v i

/-- The uniform average `2^{-|s|} ∑_{u ⊆ s} F u` over all sign patterns on `s`. -/
noncomputable def rademacherMean (s : Finset ι) (F : Finset ι → ℝ) : ℝ :=
  (2 ^ s.card : ℝ)⁻¹ * ∑ u ∈ s.powerset, F u

/-- Additive maps commute with Rademacher signed sums. -/
theorem map_rademacherSum {G G' : Type*} [AddCommGroup G] [AddCommGroup G']
    (φ : G →+ G') (s u : Finset ι) (v : ι → G) :
    φ (rademacherSum s u v) = rademacherSum s u (fun i => φ (v i)) := by
  unfold rademacherSum
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  split_ifs <;> simp

/-- Adding a new index `a` with sign `-1`. -/
theorem rademacherSum_insert_of_subset {G : Type*} [AddCommGroup G] {s u : Finset ι} {a : ι}
    (ha : a ∉ s) (hu : u ⊆ s) (v : ι → G) :
    rademacherSum (insert a s) u v = -v a + rademacherSum s u v := by
  have hau : a ∉ u := fun h => ha (hu h)
  unfold rademacherSum
  rw [Finset.sum_insert ha]
  simp [hau]

/-- Adding a new index `a` with sign `+1`. -/
theorem rademacherSum_insert_insert {G : Type*} [AddCommGroup G] {s u : Finset ι} {a : ι}
    (ha : a ∉ s) (v : ι → G) :
    rademacherSum (insert a s) (insert a u) v = v a + rademacherSum s u v := by
  unfold rademacherSum
  rw [Finset.sum_insert ha]
  simp only [Finset.mem_insert_self, ↓reduceIte]
  congr 1
  refine Finset.sum_congr rfl fun i hi => ?_
  have hia : i ≠ a := fun h => ha (h ▸ hi)
  simp [Finset.mem_insert, hia]

end Signs

/-- Real two-point inequality driving the upper moment bound:
if `w² ≤ 4PA` and `4m ≤ c + 3`, `1 ≤ c`, then
`(P+A+w)^m + (P+A-w)^m ≤ 2 (P + cA)^m`. -/
theorem two_point_pow_aux {P A w c : ℝ} (hP : 0 ≤ P) (hA : 0 ≤ A) (hw : w ^ 2 ≤ 4 * P * A)
    (hc : 1 ≤ c) (hQ : 0 < P + c * A) :
    ∀ m : ℕ, 4 * (m : ℝ) ≤ c + 3 →
      (P + A + w) ^ m + (P + A - w) ^ m ≤ 2 * (P + c * A) ^ m ∧
        (P + c * A) * (w * ((P + A + w) ^ m - (P + A - w) ^ m)) ≤
          2 * m * w ^ 2 * (P + c * A) ^ m := by
  set Q := P + c * A with hQdef
  set u := P + A with hudef
  have huQ : u ≤ Q := by nlinarith
  have hu : 0 ≤ u := by positivity
  intro m
  induction m with
  | zero => intro _; norm_num
  | succ m ih =>
    intro hm
    have hm' : 4 * (m : ℝ) ≤ c + 3 := by push_cast at hm; linarith
    obtain ⟨hF, hG⟩ := ih hm'
    have hQm : 0 ≤ Q ^ m := pow_nonneg hQ.le m
    have hstep1 : (u + w) ^ (m + 1) + (u - w) ^ (m + 1) =
        u * ((u + w) ^ m + (u - w) ^ m) + w * ((u + w) ^ m - (u - w) ^ m) := by ring
    have hstep2 : (u + w) ^ (m + 1) - (u - w) ^ (m + 1) =
        u * ((u + w) ^ m - (u - w) ^ m) + w * ((u + w) ^ m + (u - w) ^ m) := by ring
    have hmc : 4 * (m : ℝ) + 1 ≤ c := by push_cast at hm; linarith
    have hm0 : (0 : ℝ) ≤ m := Nat.cast_nonneg m
    constructor
    · -- Q * F_{m+1} ≤ 2 Q^{m+2}
      have key : Q * ((u + w) ^ (m + 1) + (u - w) ^ (m + 1)) ≤ Q * (2 * Q ^ (m + 1)) := by
        rw [hstep1]
        have h1 : Q * (u * ((u + w) ^ m + (u - w) ^ m)) ≤ Q * (u * (2 * Q ^ m)) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hF hu) hQ.le
        have h2 : u * Q + m * w ^ 2 ≤ Q ^ 2 := by
          have : m * w ^ 2 ≤ m * (4 * P * A) := mul_le_mul_of_nonneg_left hw hm0
          have hPA : 0 ≤ P * A := mul_nonneg hP hA
          have hcc : c ≤ c * c := by nlinarith
          have hid : Q ^ 2 - u * Q - m * (4 * P * A) =
              (c - 4 * m - 1) * (P * A) + (c * c - c) * A ^ 2 := by
            rw [hQdef, hudef]; ring
          nlinarith [mul_le_mul_of_nonneg_left hmc hPA, mul_le_mul_of_nonneg_left hcc (sq_nonneg A)]
        have : Q * (u * ((u + w) ^ m + (u - w) ^ m)) + Q * (w * ((u + w) ^ m - (u - w) ^ m))
            ≤ Q * (u * (2 * Q ^ m)) + 2 * m * w ^ 2 * Q ^ m := by
          linarith
        calc Q * (u * ((u + w) ^ m + (u - w) ^ m) + w * ((u + w) ^ m - (u - w) ^ m))
            = Q * (u * ((u + w) ^ m + (u - w) ^ m)) + Q * (w * ((u + w) ^ m - (u - w) ^ m)) := by
              ring
          _ ≤ Q * (u * (2 * Q ^ m)) + 2 * m * w ^ 2 * Q ^ m := this
          _ = 2 * Q ^ m * (u * Q + m * w ^ 2) := by ring
          _ ≤ 2 * Q ^ m * (Q ^ 2) := by
              exact mul_le_mul_of_nonneg_left h2 (by positivity)
          _ = Q * (2 * Q ^ (m + 1)) := by ring
      exact le_of_mul_le_mul_left key hQ
    · rw [hstep2]
      have hw2 : 0 ≤ w ^ 2 := sq_nonneg w
      have h1 : u * (Q * (w * ((u + w) ^ m - (u - w) ^ m))) ≤ u * (2 * m * w ^ 2 * Q ^ m) :=
        mul_le_mul_of_nonneg_left hG hu
      have h2 : Q * w ^ 2 * ((u + w) ^ m + (u - w) ^ m) ≤ Q * w ^ 2 * (2 * Q ^ m) :=
        mul_le_mul_of_nonneg_left hF (mul_nonneg hQ.le hw2)
      have h3 : u * (2 * m * w ^ 2 * Q ^ m) ≤ Q * (2 * m * w ^ 2 * Q ^ m) :=
        mul_le_mul_of_nonneg_right huQ (by positivity)
      calc Q * (w * (u * ((u + w) ^ m - (u - w) ^ m) + w * ((u + w) ^ m + (u - w) ^ m)))
          = u * (Q * (w * ((u + w) ^ m - (u - w) ^ m))) +
              Q * w ^ 2 * ((u + w) ^ m + (u - w) ^ m) := by ring
        _ ≤ Q * (2 * m * w ^ 2 * Q ^ m) + Q * w ^ 2 * (2 * Q ^ m) := by linarith
        _ = 2 * ((m + 1 : ℕ) : ℝ) * w ^ 2 * Q ^ (m + 1) := by push_cast; ring

section Vectors

variable {ι : Type*} [DecidableEq ι]
variable (𝕜 : Type*) {H : Type*} [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]
include 𝕜

/-- Two-point inequality in an inner product space:
`(‖x+a‖²+μ)^n + (‖x-a‖²+μ)^n ≤ 2 (‖x‖²+μ+c‖a‖²)^n` whenever `1 ≤ c` and `4n ≤ c+3`. -/
theorem two_point_norm_pow (x a : H) {μ c : ℝ} (hμ : 0 ≤ μ) (hc : 1 ≤ c) (n : ℕ)
    (hn : 4 * (n : ℝ) ≤ c + 3) :
    (‖x + a‖ ^ 2 + μ) ^ n + (‖x - a‖ ^ 2 + μ) ^ n ≤ 2 * (‖x‖ ^ 2 + μ + c * ‖a‖ ^ 2) ^ n := by
  have hadd := norm_add_sq (𝕜 := 𝕜) x a
  have hsub := norm_sub_sq (𝕜 := 𝕜) x a
  set t := RCLike.re (inner 𝕜 x a) with ht
  have htle : t ^ 2 ≤ (‖x‖ * ‖a‖) ^ 2 := by
    have h1 : |t| ≤ ‖x‖ * ‖a‖ :=
      (RCLike.abs_re_le_norm _).trans (norm_inner_le_norm (𝕜 := 𝕜) x a)
    rw [← sq_abs]
    exact pow_le_pow_left₀ (abs_nonneg _) h1 2
  have hP : 0 ≤ ‖x‖ ^ 2 + μ := by positivity
  have hA : 0 ≤ ‖a‖ ^ 2 := by positivity
  have hw : (2 * t) ^ 2 ≤ 4 * (‖x‖ ^ 2 + μ) * ‖a‖ ^ 2 := by
    have : 0 ≤ μ * ‖a‖ ^ 2 := mul_nonneg hμ hA
    nlinarith
  rcases (show 0 ≤ ‖x‖ ^ 2 + μ + c * ‖a‖ ^ 2 by positivity).lt_or_eq with hQ | hQ
  · have := (two_point_pow_aux hP hA hw hc hQ n hn).1
    have e1 : ‖x + a‖ ^ 2 + μ = ‖x‖ ^ 2 + μ + ‖a‖ ^ 2 + 2 * t := by rw [hadd]; ring
    have e2 : ‖x - a‖ ^ 2 + μ = ‖x‖ ^ 2 + μ + ‖a‖ ^ 2 - 2 * t := by rw [hsub]; ring
    rw [e1, e2]
    exact this
  · have hx : ‖x‖ ^ 2 = 0 := by nlinarith [sq_nonneg ‖x‖, sq_nonneg ‖a‖]
    have ha : ‖a‖ ^ 2 = 0 := by nlinarith [sq_nonneg ‖x‖, sq_nonneg ‖a‖]
    have hμ0 : μ = 0 := by nlinarith [sq_nonneg ‖x‖, sq_nonneg ‖a‖]
    have hx0 : x = 0 := by simpa using hx
    have ha0 : a = 0 := by simpa using ha
    subst hx0 ha0 hμ0
    rcases n with _ | n <;> norm_num

/-- Even-moment bound with a free base point: for `1 ≤ c`, `4n ≤ c+3`, `μ ≥ 0`,
`∑_{u ⊆ s} (‖x + ∑ ε_i v_i‖² + μ)^n ≤ 2^{|s|} (‖x‖² + μ + c ∑ ‖v_i‖²)^n`. -/
theorem sum_powerset_norm_sq_add_pow_le (s : Finset ι) (v : ι → H) {c : ℝ} (hc : 1 ≤ c)
    (n : ℕ) (hn : 4 * (n : ℝ) ≤ c + 3) :
    ∀ (x : H) (μ : ℝ), 0 ≤ μ →
      ∑ u ∈ s.powerset, (‖x + rademacherSum s u v‖ ^ 2 + μ) ^ n ≤
        2 ^ s.card * (‖x‖ ^ 2 + μ + c * ∑ i ∈ s, ‖v i‖ ^ 2) ^ n := by
  induction s using Finset.induction_on with
  | empty => intro x μ _; simp [rademacherSum]
  | @insert a s ha ih =>
    intro x μ hμ
    rw [Finset.sum_powerset_insert ha]
    have e1 : ∀ u ∈ s.powerset, (‖x + rademacherSum (insert a s) u v‖ ^ 2 + μ) ^ n =
        (‖(x - v a) + rademacherSum s u v‖ ^ 2 + μ) ^ n := by
      intro u hu
      rw [rademacherSum_insert_of_subset ha (Finset.mem_powerset.mp hu)]
      rw [sub_eq_add_neg, add_assoc]
    have e2 : ∀ u ∈ s.powerset, (‖x + rademacherSum (insert a s) (insert a u) v‖ ^ 2 + μ) ^ n =
        (‖(x + v a) + rademacherSum s u v‖ ^ 2 + μ) ^ n := by
      intro u _
      rw [rademacherSum_insert_insert ha]
      rw [add_assoc]
    rw [Finset.sum_congr rfl e1, Finset.sum_congr rfl e2]
    set S := ∑ i ∈ s, ‖v i‖ ^ 2
    have hS : 0 ≤ S := Finset.sum_nonneg fun i _ => sq_nonneg _
    have hμ' : 0 ≤ μ + c * S := by nlinarith
    have htp := two_point_norm_pow 𝕜 x (v a) hμ' hc n hn
    calc _ ≤ 2 ^ s.card * (‖x - v a‖ ^ 2 + μ + c * S) ^ n +
          2 ^ s.card * (‖x + v a‖ ^ 2 + μ + c * S) ^ n := add_le_add (ih _ _ hμ) (ih _ _ hμ)
      _ = 2 ^ s.card * ((‖x + v a‖ ^ 2 + (μ + c * S)) ^ n +
          (‖x - v a‖ ^ 2 + (μ + c * S)) ^ n) := by ring
      _ ≤ 2 ^ s.card * (2 * (‖x‖ ^ 2 + (μ + c * S) + c * ‖v a‖ ^ 2) ^ n) :=
          mul_le_mul_of_nonneg_left htp (by positivity)
      _ = _ := by
          rw [Finset.card_insert_of_notMem ha, Finset.sum_insert ha, pow_succ]
          ring

/-- Exact second moment with a free base point:
`∑_{u ⊆ s} ‖x + ∑ ε_i v_i‖² = 2^{|s|} (‖x‖² + ∑ ‖v_i‖²)`. -/
theorem sum_powerset_norm_add_sq (s : Finset ι) (v : ι → H) :
    ∀ x : H, ∑ u ∈ s.powerset, ‖x + rademacherSum s u v‖ ^ 2 =
      2 ^ s.card * (‖x‖ ^ 2 + ∑ i ∈ s, ‖v i‖ ^ 2) := by
  induction s using Finset.induction_on with
  | empty => intro x; simp [rademacherSum]
  | @insert a s ha ih =>
    intro x
    rw [Finset.sum_powerset_insert ha]
    have e1 : ∀ u ∈ s.powerset, ‖x + rademacherSum (insert a s) u v‖ ^ 2 =
        ‖(x - v a) + rademacherSum s u v‖ ^ 2 := by
      intro u hu
      rw [rademacherSum_insert_of_subset ha (Finset.mem_powerset.mp hu)]
      rw [sub_eq_add_neg, add_assoc]
    have e2 : ∀ u ∈ s.powerset, ‖x + rademacherSum (insert a s) (insert a u) v‖ ^ 2 =
        ‖(x + v a) + rademacherSum s u v‖ ^ 2 := by
      intro u _
      rw [rademacherSum_insert_insert ha]
      rw [add_assoc]
    rw [Finset.sum_congr rfl e1, Finset.sum_congr rfl e2, ih, ih,
      Finset.card_insert_of_notMem ha, Finset.sum_insert ha, pow_succ]
    have hadd := norm_add_sq (𝕜 := 𝕜) x (v a)
    have hsub := norm_sub_sq (𝕜 := 𝕜) x (v a)
    linear_combination (2 : ℝ) ^ s.card * (hsub + hadd)

/-- Exact second moment: `∑_{u ⊆ s} ‖∑ ε_i v_i‖² = 2^{|s|} ∑ ‖v_i‖²`. -/
theorem sum_powerset_norm_rademacherSum_sq (s : Finset ι) (v : ι → H) :
    ∑ u ∈ s.powerset, ‖rademacherSum s u v‖ ^ 2 = 2 ^ s.card * ∑ i ∈ s, ‖v i‖ ^ 2 := by
  simpa using sum_powerset_norm_add_sq 𝕜 s v 0

/-- Even moments: `∑_{u ⊆ s} ‖∑ ε_i v_i‖^{2n} ≤ 2^{|s|} (c ∑ ‖v_i‖²)^n` for `1 ≤ c`, `4n ≤ c+3`. -/
theorem sum_powerset_norm_rademacherSum_pow_le (s : Finset ι) (v : ι → H) {c : ℝ}
    (hc : 1 ≤ c) (n : ℕ) (hn : 4 * (n : ℝ) ≤ c + 3) :
    ∑ u ∈ s.powerset, ‖rademacherSum s u v‖ ^ (2 * n) ≤
      2 ^ s.card * (c * ∑ i ∈ s, ‖v i‖ ^ 2) ^ n := by
  have := sum_powerset_norm_sq_add_pow_le 𝕜 s v hc n hn 0 0 le_rfl
  simpa [pow_mul] using this

/-- The explicit upper Khintchine constant `C_p = √(4 ⌈p/2⌉)`. -/
noncomputable def khintchineUpperConst (p : ℝ) : ℝ := Real.sqrt (4 * (⌈p / 2⌉₊ : ℝ))

omit 𝕜 in
/-- Positivity of the upper Khintchine constant. -/
theorem khintchineUpperConst_pos {p : ℝ} (hp : 0 < p) : 0 < khintchineUpperConst p := by
  unfold khintchineUpperConst
  have : (0 : ℝ) < ⌈p / 2⌉₊ := by exact_mod_cast Nat.ceil_pos.mpr (half_pos hp)
  positivity


/-- Upper Khintchine inequality, `p`-th power form:
`2^{-|s|} ∑_{u ⊆ s} ‖∑ ε_i v_i‖^p ≤ (C_p (∑ ‖v_i‖²)^{1/2})^p` for `0 < p`. -/
theorem khintchine_upper_rpow (s : Finset ι) (v : ι → H) {p : ℝ} (hp : 0 < p) :
    rademacherMean s (fun u => ‖rademacherSum s u v‖ ^ p) ≤
      (khintchineUpperConst p * Real.sqrt (∑ i ∈ s, ‖v i‖ ^ 2)) ^ p := by
  set n := ⌈p / 2⌉₊ with hndef
  have hn1 : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr (Nat.ceil_pos.mpr (half_pos hp)).ne'
  have hn1' : (1 : ℝ) ≤ n := by exact_mod_cast hn1
  set c : ℝ := 4 * (n : ℝ) with hcdef
  have hc : 1 ≤ c := by linarith
  have hnc : 4 * (n : ℝ) ≤ c + 3 := by linarith
  set S := ∑ i ∈ s, ‖v i‖ ^ 2 with hSdef
  have hS : 0 ≤ S := Finset.sum_nonneg fun i _ => sq_nonneg _
  set N : ℝ := 2 ^ s.card with hNdef
  have hN : 0 < N := by positivity
  have heven := sum_powerset_norm_rademacherSum_pow_le 𝕜 s v hc n hnc
  set q : ℝ := 2 * n / p with hqdef
  have hpn : p ≤ 2 * n := by
    have := Nat.le_ceil (p / 2)
    rw [← hndef] at this
    linarith
  have hq : 1 ≤ q := by rw [hqdef, le_div_iff₀ hp]; linarith
  have hq0 : 0 < q := by linarith
  have hw : ∑ _u ∈ s.powerset, N⁻¹ = 1 := by
    rw [Finset.sum_const, Finset.card_powerset, nsmul_eq_mul]
    push_cast
    exact mul_inv_cancel₀ hN.ne'
  have hpm := Real.rpow_arith_mean_le_arith_mean_rpow s.powerset (fun _ => N⁻¹)
    (fun u => ‖rademacherSum s u v‖ ^ p) (fun _ _ => (inv_pos.mpr hN).le) hw
    (fun _ _ => Real.rpow_nonneg (norm_nonneg _) _) hq
  have hzq : ∀ u : Finset ι,
      (‖rademacherSum s u v‖ ^ p) ^ q = ‖rademacherSum s u v‖ ^ (2 * n) := by
    intro u
    rw [← Real.rpow_mul (norm_nonneg _), hqdef, mul_div_cancel₀ _ hp.ne', ← Real.rpow_natCast]
    push_cast; ring_nf
  simp only [hzq] at hpm
  rw [← Finset.mul_sum, ← Finset.mul_sum] at hpm
  have hM : 0 ≤ rademacherMean s (fun u => ‖rademacherSum s u v‖ ^ p) := by
    unfold rademacherMean
    exact mul_nonneg (inv_nonneg.mpr (by positivity))
      (Finset.sum_nonneg fun _ _ => Real.rpow_nonneg (norm_nonneg _) _)
  have hMq : (rademacherMean s (fun u => ‖rademacherSum s u v‖ ^ p)) ^ q ≤ (c * S) ^ n := by
    unfold rademacherMean
    refine hpm.trans ?_
    rw [inv_mul_le_iff₀ hN]
    exact heven
  have hcS : 0 ≤ c * S := by positivity
  calc rademacherMean s (fun u => ‖rademacherSum s u v‖ ^ p)
      = ((rademacherMean s (fun u => ‖rademacherSum s u v‖ ^ p)) ^ q) ^ q⁻¹ :=
        (Real.rpow_rpow_inv hM hq0.ne').symm
    _ ≤ ((c * S) ^ n) ^ q⁻¹ :=
        Real.rpow_le_rpow (Real.rpow_nonneg hM _) hMq (inv_nonneg.mpr hq0.le)
    _ = (khintchineUpperConst p * Real.sqrt S) ^ p := by
        unfold khintchineUpperConst
        rw [← hndef, ← hcdef, ← Real.sqrt_mul (by positivity), Real.sqrt_eq_rpow,
          ← Real.rpow_mul hcS, ← Real.rpow_natCast, ← Real.rpow_mul hcS, hqdef]
        congr 1
        field_simp

/-- Upper Khintchine inequality (Blueprint Lemma 2.6 (`lem:khintchine`), upper bound):
for vectors `v_i` in a real or complex inner product space and `0 < p < ∞`,
`(𝔼_ε ‖∑_{i ∈ s} ε_i v_i‖^p)^{1/p} ≤ C_p (∑_{i ∈ s} ‖v_i‖²)^{1/2}`, where the expectation is the
uniform average over the `2^{|s|}` sign patterns and `C_p = khintchineUpperConst p` depends
only on `p`. -/
theorem khintchine_upper (s : Finset ι) (v : ι → H) {p : ℝ} (hp : 0 < p) :
    (rademacherMean s (fun u => ‖rademacherSum s u v‖ ^ p)) ^ (1 / p) ≤
      khintchineUpperConst p * Real.sqrt (∑ i ∈ s, ‖v i‖ ^ 2) := by
  have hC := (khintchineUpperConst_pos hp).le
  have hM : 0 ≤ rademacherMean s (fun u => ‖rademacherSum s u v‖ ^ p) := by
    unfold rademacherMean
    exact mul_nonneg (inv_nonneg.mpr (by positivity))
      (Finset.sum_nonneg fun _ _ => Real.rpow_nonneg (norm_nonneg _) _)
  calc _ ≤ ((khintchineUpperConst p * Real.sqrt (∑ i ∈ s, ‖v i‖ ^ 2)) ^ p) ^ (1 / p) :=
        Real.rpow_le_rpow hM (khintchine_upper_rpow 𝕜 s v hp) (by positivity)
    _ = _ := by rw [one_div, Real.rpow_rpow_inv (by positivity) hp.ne']

end Vectors

theorem khintchineUpperConst_le {p : ℝ} (hp : 2 ≤ p) :
    khintchineUpperConst p ≤ 2 * Real.sqrt p := by
  have hp0 : 0 ≤ p := by linarith
  have hc := Nat.ceil_lt_add_one (show 0 ≤ p / 2 by positivity)
  calc khintchineUpperConst p ≤ Real.sqrt (4 * p) := by
        apply Real.sqrt_le_sqrt
        linarith
    _ = 2 * Real.sqrt p := by rw [Real.sqrt_mul (by norm_num)]; norm_num

/-- The source's dimension-free sign estimate, with the absolute constant `2`. -/
theorem signs_moment_bound {ι : Type*} [DecidableEq ι] (s : Finset ι)
    (a : ι → ℂ) {p : ℝ} (hp : 2 ≤ p) :
    (rademacherMean s (fun u => ‖rademacherSum s u a‖ ^ p)) ^ (1 / p) ≤
      2 * Real.sqrt p * Real.sqrt (∑ i ∈ s, ‖a i‖ ^ 2) :=
  (khintchine_upper ℂ s a (by linarith)).trans
    (mul_le_mul_of_nonneg_right (khintchineUpperConst_le hp) (Real.sqrt_nonneg _))

theorem rademacherMean_mono {ι : Type*} (s : Finset ι)
    {f g : Finset ι → ℝ} (h : ∀ u ∈ s.powerset, f u ≤ g u) :
    rademacherMean s f ≤ rademacherMean s g :=
  mul_le_mul_of_nonneg_left (Finset.sum_le_sum h) (by positivity)

theorem rademacherMean_const_mul {ι : Type*} (s : Finset ι)
    (c : ℝ) (f : Finset ι → ℝ) :
    rademacherMean s (fun u => c * f u) = c * rademacherMean s f := by
  simp only [rademacherMean, ← Finset.mul_sum]
  ring

/-- Two independent sign families, with a constant depending only on the moment. -/
theorem double_signs_moment_bound {ι κ : Type*} [DecidableEq ι] [DecidableEq κ]
    [Fintype κ] (s : Finset ι) (a : ι → κ → ℂ) {p : ℝ} (hp : 0 < p) :
    rademacherMean s (fun u => rademacherMean Finset.univ (fun v =>
      ‖rademacherSum Finset.univ v (fun j => rademacherSum s u (fun i => a i j))‖ ^ p)) ≤
      (khintchineUpperConst p ^ 2 * Real.sqrt (∑ i ∈ s, ∑ j, ‖a i j‖ ^ 2)) ^ p := by
  let b : ι → EuclideanSpace ℂ κ := fun i => WithLp.toLp 2 (a i)
  have hb (u : Finset ι) (j : κ) :
      (rademacherSum s u b) j = rademacherSum s u (fun i => a i j) := by
    simp only [rademacherSum, WithLp.ofLp_sum, Finset.sum_apply]
    apply Finset.sum_congr rfl
    intro i _
    split_ifs <;> rfl
  have hnorm (u : Finset ι) :
      Real.sqrt (∑ j, ‖rademacherSum s u (fun i => a i j)‖ ^ 2) =
        ‖rademacherSum s u b‖ := by rw [EuclideanSpace.norm_eq]; simp only [hb]
  have hC : 0 ≤ khintchineUpperConst p := (khintchineUpperConst_pos hp).le
  calc _ ≤ rademacherMean s (fun u =>
          (khintchineUpperConst p * ‖rademacherSum s u b‖) ^ p) := by
        apply rademacherMean_mono
        intro u _
        simpa only [hnorm] using
          khintchine_upper_rpow ℂ Finset.univ (fun j => rademacherSum s u (fun i => a i j)) hp
    _ = khintchineUpperConst p ^ p *
          rademacherMean s (fun u => ‖rademacherSum s u b‖ ^ p) := by
        simp_rw [Real.mul_rpow hC (norm_nonneg _)]
        exact rademacherMean_const_mul _ _ _
    _ ≤ khintchineUpperConst p ^ p *
          (khintchineUpperConst p * Real.sqrt (∑ i ∈ s, ‖b i‖ ^ 2)) ^ p :=
        mul_le_mul_of_nonneg_left (khintchine_upper_rpow ℂ s b hp) (by positivity)
    _ = _ := by
        rw [← Real.mul_rpow hC (by positivity)]
        congr 1
        simp only [EuclideanSpace.norm_sq_eq, b]
        ring

/-! Finite uniform expectations used in sampling symmetrization. -/

noncomputable def uniformMean {A E : Type*} [Fintype A] [AddCommMonoid E]
    [Module ℝ E] (f : A → E) : E := (Fintype.card A : ℝ)⁻¹ • ∑ a, f a

theorem uniformMean_const {A E : Type*} [Fintype A] [Nonempty A]
    [AddCommMonoid E] [Module ℝ E] (c : E) : uniformMean (fun _ : A => c) = c := by
  simp only [uniformMean, Finset.sum_const, Finset.card_univ]
  rw [← Nat.cast_smul_eq_nsmul ℝ, smul_smul, inv_mul_cancel₀ (by positivity), one_smul]

theorem uniformMean_add {A E : Type*} [Fintype A] [AddCommMonoid E]
    [Module ℝ E] (f g : A → E) :
    uniformMean (fun a => f a + g a) = uniformMean f + uniformMean g := by
  simp [uniformMean, Finset.sum_add_distrib, smul_add]

theorem uniformMean_sub {A E : Type*} [Fintype A] [AddCommGroup E]
    [Module ℝ E] (f g : A → E) :
    uniformMean (fun a => f a - g a) = uniformMean f - uniformMean g := by
  simp [uniformMean, Finset.sum_sub_distrib, smul_sub]

theorem uniformMean_sum {A I E : Type*} [Fintype A] [AddCommMonoid E]
    [Module ℝ E] (s : Finset I) (f : I → A → E) :
    uniformMean (fun a => ∑ i ∈ s, f i a) = ∑ i ∈ s, uniformMean (f i) := by
  simp only [uniformMean, Finset.smul_sum]
  exact Finset.sum_comm

theorem uniformMean_smul {A E : Type*} [Fintype A] [AddCommMonoid E]
    [Module ℝ E] (c : ℝ) (f : A → E) :
    uniformMean (fun a => c • f a) = c • uniformMean f := by
  simp only [uniformMean, ← Finset.smul_sum]
  exact smul_comm _ _ _

theorem uniformMean_mono {A : Type*} [Fintype A] {f g : A → ℝ}
    (h : ∀ a, f a ≤ g a) : uniformMean f ≤ uniformMean g :=
  mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun a _ => h a)) (by positivity)

theorem uniformMean_nonneg {A : Type*} [Fintype A] {f : A → ℝ}
    (h : ∀ a, 0 ≤ f a) : 0 ≤ uniformMean f := by
  exact mul_nonneg (by positivity) (Finset.sum_nonneg (fun a _ => h a))

theorem uniformMean_equiv {A B E : Type*} [Fintype A] [Fintype B]
    [AddCommMonoid E] [Module ℝ E] (e : A ≃ B) (f : B → E) :
    uniformMean (fun a => f (e a)) = uniformMean f := by
  unfold uniformMean
  rw [Fintype.card_congr e, Equiv.sum_comp e]

theorem uniformMean_prod {A B E : Type*} [Fintype A] [Fintype B]
    [AddCommMonoid E] [Module ℝ E] (f : A × B → E) :
    uniformMean f = uniformMean (fun a => uniformMean (fun b => f (a, b))) := by
  simp only [uniformMean, Fintype.card_prod, Nat.cast_mul, mul_inv_rev,
    Fintype.sum_prod_type, ← Finset.smul_sum, smul_smul]
  rw [mul_comm]

theorem uniformMean_norm_rpow_le {A : Type*} [Fintype A] [Nonempty A]
    (f : A → ℂ) {p : ℝ} (hp : 1 ≤ p) :
    ‖uniformMean f‖ ^ p ≤ uniformMean (fun a => ‖f a‖ ^ p) := by
  have hcard : 0 < (Fintype.card A : ℝ) := by positivity
  have hn : ‖uniformMean f‖ ≤ uniformMean (fun a => ‖f a‖) := by
    unfold uniformMean
    rw [norm_smul, Real.norm_of_nonneg (by positivity)]
    exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) (by positivity)
  refine (Real.rpow_le_rpow (norm_nonneg _) hn (by linarith)).trans ?_
  have hw : ∑ _ : A, (Fintype.card A : ℝ)⁻¹ = 1 := by
    simp [← Nat.cast_smul_eq_nsmul ℝ, hcard.ne']
  simpa only [uniformMean, smul_eq_mul, Finset.mul_sum] using
    Real.rpow_arith_mean_le_arith_mean_rpow Finset.univ
      (fun _ : A => (Fintype.card A : ℝ)⁻¹) (fun a => ‖f a‖)
      (fun _ _ => by positivity) hw (fun _ _ => norm_nonneg _) hp

theorem uniformMean_eval {I A E : Type*} [Fintype I] [DecidableEq I]
    [Fintype A] [Nonempty A] [AddCommMonoid E] [Module ℝ E]
    (i : I) (f : A → E) : uniformMean (fun a : I → A => f (a i)) = uniformMean f := by
  rw [← uniformMean_equiv (Equiv.funSplitAt i A).symm]
  simp only [Equiv.funSplitAt_symm_apply, dite_true]
  rw [uniformMean_prod]
  simp only [uniformMean_const]

/-- Jensen's introduction of an independent copy of the entire sample. -/
theorem sampling_ghost_bound {I A : Type*} [Fintype I] [DecidableEq I]
    [Fintype A] [Nonempty A] (f : A → ℂ) {p : ℝ} (hp : 1 ≤ p) :
    uniformMean (fun a : I → A =>
      ‖∑ i, (f (a i) - uniformMean f)‖ ^ p) ≤
    uniformMean (fun a : I → A => uniformMean (fun b : I → A =>
      ‖∑ i, (f (a i) - f (b i))‖ ^ p)) := by
  apply uniformMean_mono
  intro a
  have heq : uniformMean (fun b : I → A => ∑ i, (f (a i) - f (b i))) =
      ∑ i, (f (a i) - uniformMean f) := by
    rw [uniformMean_sum]
    simp only [uniformMean_sub, uniformMean_const, uniformMean_eval]
  rw [← heq]
  exact uniformMean_norm_rpow_le _ hp

/-- Swapping sample pairs at selected coordinates preserves the uniform distribution. -/
def samplePairSwap {I A : Type*} [DecidableEq I] (u : Finset I) :
    ((I → A) × (I → A)) ≃ ((I → A) × (I → A)) where
  toFun ab := (fun i => if i ∈ u then ab.1 i else ab.2 i,
    fun i => if i ∈ u then ab.2 i else ab.1 i)
  invFun ab := (fun i => if i ∈ u then ab.1 i else ab.2 i,
    fun i => if i ∈ u then ab.2 i else ab.1 i)
  left_inv ab := by ext i <;> dsimp <;> split_ifs <;> rfl
  right_inv ab := by ext i <;> dsimp <;> split_ifs <;> rfl

theorem samplePairSwap_difference {I A : Type*} [Fintype I] [DecidableEq I]
    (u : Finset I) (f : A → ℂ) (ab : (I → A) × (I → A)) :
    (∑ i, (f ((samplePairSwap u ab).1 i) - f ((samplePairSwap u ab).2 i))) =
      rademacherSum Finset.univ u (fun i => f (ab.1 i) - f (ab.2 i)) := by
  apply Finset.sum_congr rfl
  intro i _
  dsimp [samplePairSwap]
  split_ifs <;> simp

theorem uniformMean_rademacherMean_comm {A I : Type*} [Fintype A]
    (s : Finset I) (f : A → Finset I → ℝ) :
    uniformMean (fun a => rademacherMean s (f a)) =
      rademacherMean s (fun u => uniformMean (fun a => f a u)) := by
  simp only [uniformMean, rademacherMean, smul_eq_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro u _
  apply Finset.sum_congr rfl
  intro a _
  ring

theorem rademacherMean_const {I : Type*} (s : Finset I) (c : ℝ) :
    rademacherMean s (fun _ => c) = c := by
  simp [rademacherMean, Finset.card_powerset]

theorem sampling_sign_symmetrization {I A : Type*} [Fintype I] [DecidableEq I]
    [Fintype A] (f : A → ℂ) (p : ℝ) :
    uniformMean (fun a : I → A => uniformMean (fun b : I → A =>
      ‖∑ i, (f (a i) - f (b i))‖ ^ p)) =
    uniformMean (fun ab : (I → A) × (I → A) =>
      rademacherMean Finset.univ (fun u =>
        ‖rademacherSum Finset.univ u (fun i => f (ab.1 i) - f (ab.2 i))‖ ^ p)) := by
  rw [← uniformMean_prod (fun ab : (I → A) × (I → A) =>
    ‖∑ i, (f (ab.1 i) - f (ab.2 i))‖ ^ p), uniformMean_rademacherMean_comm]
  have heq (u : Finset I) :
      uniformMean (fun ab : (I → A) × (I → A) =>
        ‖rademacherSum Finset.univ u (fun i => f (ab.1 i) - f (ab.2 i))‖ ^ p) =
      uniformMean (fun ab : (I → A) × (I → A) =>
        ‖∑ i, (f (ab.1 i) - f (ab.2 i))‖ ^ p) := by
    simpa only [samplePairSwap_difference] using uniformMean_equiv (samplePairSwap u)
      (fun ab : (I → A) × (I → A) => ‖∑ i, (f (ab.1 i) - f (ab.2 i))‖ ^ p)
  simp only [heq, rademacherMean_const]

theorem signs_moment_le_sum_rpow {I : Type*} [Fintype I] [DecidableEq I]
    (a : I → ℂ) {p : ℝ} (hp : 2 ≤ p) :
    rademacherMean Finset.univ (fun u => ‖rademacherSum Finset.univ u a‖ ^ p) ≤
      khintchineUpperConst p ^ p * (Fintype.card I : ℝ) ^ (p / 2 - 1) *
        ∑ i, ‖a i‖ ^ p := by
  have hC := (khintchineUpperConst_pos (show 0 < p by linarith)).le
  refine (khintchine_upper_rpow ℂ Finset.univ a (by linarith)).trans ?_
  rw [Real.mul_rpow hC (Real.sqrt_nonneg _), Real.sqrt_eq_rpow,
    ← Real.rpow_mul (Finset.sum_nonneg (fun i _ => sq_nonneg ‖a i‖))]
  have heq : (1 / 2 : ℝ) * p = p / 2 := by ring
  rw [heq, mul_assoc]
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  have h := Real.rpow_sum_le_const_mul_sum_rpow_of_nonneg Finset.univ
    (f := fun i => ‖a i‖ ^ 2) (show 1 ≤ p / 2 by linarith) (fun i _ => sq_nonneg _)
  convert h using 1
  simp only [Finset.card_univ]
  congr 1
  apply Finset.sum_congr rfl
  intro i _
  rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _)]
  congr 1
  push_cast
  ring

theorem norm_sub_rpow_le (a b : ℂ) {p : ℝ} (hp : 1 ≤ p) :
    ‖a - b‖ ^ p ≤ (2 : ℝ) ^ (p - 1) * (‖a‖ ^ p + ‖b‖ ^ p) := by
  refine (Real.rpow_le_rpow (norm_nonneg _) (norm_sub_le a b) (by linarith)).trans ?_
  have h := Real.rpow_sum_le_const_mul_sum_rpow_of_nonneg Finset.univ
    (f := fun i : Fin 2 => if i = 0 then ‖a‖ else ‖b‖) hp
    (fun i _ => by split_ifs <;> positivity)
  simpa [Fin.sum_univ_two] using h

theorem uniformMean_comm {A B E : Type*} [Fintype A] [Fintype B]
    [AddCommMonoid E] [Module ℝ E] (f : A → B → E) :
    uniformMean (fun a => uniformMean (f a)) =
      uniformMean (fun b => uniformMean (fun a => f a b)) := by
  simp only [uniformMean, ← Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm, mul_comm]

theorem sample_difference_moment {I A : Type*} [Fintype I] [DecidableEq I]
    [Fintype A] [Nonempty A] (f : A → ℂ) (i : I) {p : ℝ} (hp : 1 ≤ p) :
    uniformMean (fun ab : (I → A) × (I → A) =>
      ‖f (ab.1 i) - f (ab.2 i)‖ ^ p) ≤
        (2 : ℝ) ^ p * uniformMean (fun a => ‖f a‖ ^ p) := by
  refine (uniformMean_mono (fun ab : (I → A) × (I → A) =>
    norm_sub_rpow_le (f (ab.1 i)) (f (ab.2 i)) hp)).trans_eq ?_
  change uniformMean (fun ab : (I → A) × (I → A) =>
    (2 : ℝ) ^ (p - 1) • (‖f (ab.1 i)‖ ^ p + ‖f (ab.2 i)‖ ^ p)) = _
  rw [uniformMean_smul, uniformMean_add]
  rw [uniformMean_prod (fun ab : (I → A) × (I → A) => ‖f (ab.1 i)‖ ^ p),
    uniformMean_prod (fun ab : (I → A) × (I → A) => ‖f (ab.2 i)‖ ^ p)]
  simp only [uniformMean_const, smul_eq_mul]
  rw [uniformMean_eval i (fun a => ‖f a‖ ^ p)]
  rw [Real.rpow_sub (by norm_num), Real.rpow_one]
  ring

/-- Centered sums of independent uniform samples have square-root sample-size growth. -/
theorem sampling_sum_moment_bound {I A : Type*} [Fintype I] [DecidableEq I]
    [Nonempty I] [Fintype A] [Nonempty A] (f : A → ℂ) {p : ℝ} (hp : 2 ≤ p) :
    uniformMean (fun a : I → A => ‖∑ i, (f (a i) - uniformMean f)‖ ^ p) ≤
      (2 * khintchineUpperConst p * Real.sqrt (Fintype.card I)) ^ p *
        uniformMean (fun a => ‖f a‖ ^ p) := by
  let D := khintchineUpperConst p ^ p * (Fintype.card I : ℝ) ^ (p / 2 - 1)
  have hD : 0 ≤ D := by dsimp [D, khintchineUpperConst]; positivity
  have hN : 0 < (Fintype.card I : ℝ) := by positivity
  have hC := (khintchineUpperConst_pos (show 0 < p by linarith)).le
  calc _ ≤ uniformMean (fun a : I → A => uniformMean (fun b : I → A =>
          ‖∑ i, (f (a i) - f (b i))‖ ^ p)) := sampling_ghost_bound f (by linarith)
    _ = _ := sampling_sign_symmetrization f p
    _ ≤ uniformMean (fun ab : (I → A) × (I → A) =>
          D * ∑ i, ‖f (ab.1 i) - f (ab.2 i)‖ ^ p) :=
        uniformMean_mono (fun ab => signs_moment_le_sum_rpow _ hp)
    _ = D * ∑ i, uniformMean (fun ab : (I → A) × (I → A) =>
          ‖f (ab.1 i) - f (ab.2 i)‖ ^ p) := by
        change uniformMean (fun ab : (I → A) × (I → A) =>
          D • ∑ i, ‖f (ab.1 i) - f (ab.2 i)‖ ^ p) = _
        rw [uniformMean_smul, uniformMean_sum, smul_eq_mul]
    _ ≤ D * ∑ _ : I, ((2 : ℝ) ^ p * uniformMean (fun a => ‖f a‖ ^ p)) :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun i _ =>
          sample_difference_moment f i (by linarith))) hD
    _ = _ := by
        simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul, D]
        rw [Real.mul_rpow (mul_nonneg (by norm_num) hC) (Real.sqrt_nonneg _),
          Real.mul_rpow (by norm_num) hC, Real.sqrt_eq_rpow,
          ← Real.rpow_mul hN.le, Real.rpow_sub hN, Real.rpow_one]
        have he : (1 / 2 : ℝ) * p = p / 2 := by ring
        rw [he]
        field_simp

theorem sampling_mean_moment_bound {I A : Type*} [Fintype I] [DecidableEq I]
    [Nonempty I] [Fintype A] [Nonempty A] (f : A → ℂ) {p : ℝ} (hp : 2 ≤ p) :
    uniformMean (fun a : I → A => ‖uniformMean (fun i => f (a i)) - uniformMean f‖ ^ p) ≤
      (4 * Real.sqrt (p / Fintype.card I)) ^ p * uniformMean (fun a => ‖f a‖ ^ p) := by
  have hN : 0 < (Fintype.card I : ℝ) := by positivity
  have hC := (khintchineUpperConst_pos (show 0 < p by linarith)).le
  have heq (a : I → A) : uniformMean (fun i => f (a i)) - uniformMean f =
      (Fintype.card I : ℝ)⁻¹ • ∑ i, (f (a i) - uniformMean f) := by
    calc _ = uniformMean (fun i => f (a i) - uniformMean f) := by
          rw [uniformMean_sub, uniformMean_const]
      _ = _ := rfl
  simp_rw [heq, norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hN.le),
    Real.mul_rpow (inv_nonneg.mpr hN.le) (norm_nonneg _)]
  change uniformMean (fun a : I → A => (Fintype.card I : ℝ)⁻¹ ^ p •
    ‖∑ i, (f (a i) - uniformMean f)‖ ^ p) ≤ _
  rw [uniformMean_smul, smul_eq_mul]
  refine (mul_le_mul_of_nonneg_left (sampling_sum_moment_bound f hp)
    (by positivity)).trans ?_
  rw [← mul_assoc, ← Real.mul_rpow (inv_nonneg.mpr hN.le) (by positivity)]
  apply mul_le_mul_of_nonneg_right _ (uniformMean_nonneg (fun a => by positivity))
  apply Real.rpow_le_rpow (by positivity) _ (by linarith)
  have hs := Real.sq_sqrt hN.le
  have hs0 : 0 < Real.sqrt (Fintype.card I) := Real.sqrt_pos.mpr hN
  calc (Fintype.card I : ℝ)⁻¹ * (2 * khintchineUpperConst p * Real.sqrt (Fintype.card I))
      = 2 * khintchineUpperConst p / Real.sqrt (Fintype.card I) := by
        field_simp
        nlinarith
    _ ≤ 4 * Real.sqrt p / Real.sqrt (Fintype.card I) := by
        apply div_le_div_of_nonneg_right _ hs0.le
        nlinarith [khintchineUpperConst_le hp]
    _ = 4 * Real.sqrt (p / Fintype.card I) := by rw [Real.sqrt_div (by linarith)]; ring

/-- Finite `Lᵖ` norm with probability counting measure. -/
noncomputable def finiteLpNorm {G : Type*} [Fintype G] (p : ℝ) (f : G → ℂ) : ℝ :=
  uniformMean (fun x => ‖f x‖ ^ p) ^ (1 / p)

theorem finiteLpNorm_rpow {G : Type*} [Fintype G] (f : G → ℂ) {p : ℝ} (hp : 0 < p) :
    finiteLpNorm p f ^ p = uniformMean (fun x => ‖f x‖ ^ p) := by
  unfold finiteLpNorm
  rw [one_div]
  exact Real.rpow_inv_rpow (uniformMean_nonneg (fun x : G =>
    Real.rpow_nonneg (norm_nonneg (f x)) p)) hp.ne'

theorem uniformMean_translate {G E : Type*} [AddGroup G] [Fintype G]
    [AddCommMonoid E] [Module ℝ E] (f : G → E) (a : G) :
    uniformMean (fun x => f (x - a)) = uniformMean f :=
  uniformMean_equiv (Equiv.subRight a) f

/-- Sampling estimate for translates; samples may be drawn uniformly from any finite type. -/
theorem sampling_translate_moment_bound {G A I : Type*} [AddCommGroup G] [Fintype G]
    [Fintype A] [Nonempty A] [Fintype I] [DecidableEq I] [Nonempty I]
    (z : A → G) (f : G → ℂ) {p : ℝ} (hp : 2 ≤ p) :
    uniformMean (fun a : I → A => finiteLpNorm p (fun x =>
      uniformMean (fun i => f (x - z (a i))) - uniformMean (fun b => f (x - z b))) ^ p) ≤
      (4 * Real.sqrt (p / Fintype.card I) * finiteLpNorm p f) ^ p := by
  simp only [finiteLpNorm_rpow _ (show 0 < p by linarith)]
  rw [uniformMean_comm]
  refine (uniformMean_mono (fun x =>
    sampling_mean_moment_bound (fun b => f (x - z b)) hp)).trans_eq ?_
  change uniformMean (fun x => (4 * Real.sqrt (p / Fintype.card I)) ^ p •
    uniformMean (fun b => ‖f (x - z b)‖ ^ p)) = _
  rw [uniformMean_smul, uniformMean_comm]
  have ht (b : A) : uniformMean (fun x => ‖f (x - z b)‖ ^ p) =
      uniformMean (fun x => ‖f x‖ ^ p) :=
    uniformMean_translate (fun x => ‖f x‖ ^ p) (z b)
  simp only [ht, uniformMean_const, smul_eq_mul]
  rw [Real.mul_rpow (x := 4 * Real.sqrt (p / Fintype.card I))
      (y := finiteLpNorm p f) (by positivity) (Real.rpow_nonneg
        (uniformMean_nonneg (fun x => Real.rpow_nonneg (norm_nonneg (f x)) p)) _),
    finiteLpNorm_rpow _ (by linarith)]

theorem uniformMean_complex_eq {G : Type*} [Fintype G] (f : G → ℂ) :
    uniformMean f = finiteAverage f := by
  simp [uniformMean, finiteAverage, Complex.real_smul]

/-- The probability-density normalization `1_A / (|A| / |G|)`. -/
noncomputable def finiteSetDensity {G : Type*} [Fintype G] [DecidableEq G]
    (A : Finset G) (x : G) : ℂ :=
  if x ∈ A then (Fintype.card G : ℂ) / A.card else 0

theorem finiteConvolution_comm {G : Type*} [AddCommGroup G] [Fintype G]
    (f g : G → ℂ) (x : G) : finiteConvolution f g x = finiteConvolution g f x := by
  unfold finiteConvolution finiteAverage
  congr 1
  simpa only [Equiv.subLeft_apply, sub_sub_cancel, mul_comm] using
    (Equiv.sum_comp (Equiv.subLeft x) (fun y => g y * f (x - y)))

theorem finiteConvolution_setDensity {G : Type*} [AddCommGroup G] [Fintype G]
    [DecidableEq G] (A : Finset G) (f : G → ℂ) (x : G) :
    finiteConvolution f (finiteSetDensity A) x = uniformMean (fun a : A => f (x - a)) := by
  rw [finiteConvolution_comm]
  simp only [finiteConvolution, finiteAverage, finiteSetDensity, ite_mul, zero_mul]
  rw [Finset.sum_ite_mem, ← Finset.mul_sum]
  rw [uniformMean_complex_eq]
  simp only [finiteAverage, Fintype.card_coe]
  have hG : (Fintype.card G : ℂ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  field_simp
  simp only [Finset.univ_inter]
  congr 1
  exact (A.sum_coe_sort (fun a => f (x - a))).symm

/-- Blueprint `lem:finite-fourier`: the sampling inequality with probability counting
norms and convolution, with the absolute constant `4`. -/
theorem sampling_convolution_bound {G : Type*} [AddCommGroup G] [Fintype G]
    [DecidableEq G] (A : Finset G) (hA : A.Nonempty) (n : ℕ) (hn : 0 < n)
    (f : G → ℂ) {p : ℝ} (hp : 2 ≤ p) :
    uniformMean (fun a : Fin n → A => finiteLpNorm p (fun x =>
      uniformMean (fun i => f (x - a i)) - finiteConvolution f (finiteSetDensity A) x) ^ p) ≤
      (4 * Real.sqrt (p / n) * finiteLpNorm p f) ^ p := by
  let : NeZero n := ⟨Nat.ne_of_gt hn⟩
  let : Nonempty A := by obtain ⟨a, ha⟩ := hA; exact ⟨⟨a, ha⟩⟩
  simp only [finiteConvolution_setDensity]
  simpa only [Fintype.card_fin] using
    sampling_translate_moment_bound (I := Fin n) (fun a : A => (a : G)) f hp

/-! Probability-normalized Fourier analysis on finite cyclic groups. -/

noncomputable def finiteFourier {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (ξ : ZMod q) : ℂ :=
  (q : ℂ)⁻¹ * ZMod.dft f ξ

theorem finiteFourier_eq_average {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (ξ : ZMod q) :
    finiteFourier f ξ = finiteAverage (fun x => f x * ZMod.stdAddChar (-(ξ * x))) := by
  simp only [finiteFourier, ZMod.dft_apply, smul_eq_mul, finiteAverage, ZMod.card]
  congr 1
  apply Finset.sum_congr rfl
  intro x _
  rw [mul_comm x ξ, mul_comm]

theorem finiteFourier_inversion {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (x : ZMod q) :
    f x = ∑ ξ, finiteFourier f ξ * ZMod.stdAddChar (ξ * x) := by
  have h := congrFun (ZMod.dft.symm_apply_apply f) x
  rw [ZMod.invDFT_def] at h
  rw [← h]
  simp only [smul_eq_mul, finiteFourier, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro ξ _
  ring

theorem finite_character_orthogonality {q : ℕ} [NeZero q] (ξ : ZMod q) :
    finiteAverage (fun x => ZMod.stdAddChar (ξ * x)) = if ξ = 0 then 1 else 0 := by
  unfold finiteAverage
  by_cases hξ : ξ = 0
  · simp [hξ, ZMod.card, NeZero.ne (q : ℂ)]
  · have hs : ∑ x, ZMod.stdAddChar (ξ * x) = 0 := by
      simpa only [AddChar.mulShift_apply] using
        AddChar.sum_eq_zero_of_ne_one (ZMod.isPrimitive_stdAddChar q hξ)
    simp [hs, hξ]

theorem stdAddChar_conj {q : ℕ} [NeZero q] (x : ZMod q) :
    conj (ZMod.stdAddChar x) = ZMod.stdAddChar (-x) := by
  simp only [ZMod.stdAddChar_apply, AddChar.map_neg_eq_inv, ← Circle.coe_inv_eq_conj,
    Circle.coe_inv]

theorem finiteAverage_sum {G I : Type*} [Fintype G] (s : Finset I) (f : I → G → ℂ) :
    finiteAverage (fun x => ∑ i ∈ s, f i x) = ∑ i ∈ s, finiteAverage (f i) := by
  simp only [← uniformMean_complex_eq, uniformMean_sum]

theorem finiteAverage_mul_const {G : Type*} [Fintype G] (f : G → ℂ) (c : ℂ) :
    finiteAverage (fun x => f x * c) = finiteAverage f * c := by
  simp only [finiteAverage, ← Finset.sum_mul, mul_assoc]

theorem finiteAverage_const_mul {G : Type*} [Fintype G] (c : ℂ) (f : G → ℂ) :
    finiteAverage (fun x => c * f x) = c * finiteAverage f := by
  simp only [finiteAverage, ← Finset.mul_sum]
  ring

theorem finiteAverage_re {G : Type*} [Fintype G] (f : G → ℂ) :
    (finiteAverage f).re = uniformMean (fun x => (f x).re) := by
  rw [← uniformMean_complex_eq]
  simp [uniformMean, Complex.re_sum]

theorem finiteFourier_pairing {q : ℕ} [NeZero q] (f g : ZMod q → ℂ) :
    finiteAverage (fun x => f x * conj (g x)) =
      ∑ ξ, finiteFourier f ξ * conj (finiteFourier g ξ) := by
  have hg (x : ZMod q) : f x * conj (g x) =
      ∑ ξ, (f x * ZMod.stdAddChar (-(ξ * x))) * conj (finiteFourier g ξ) := by
    conv_lhs => rw [finiteFourier_inversion g x]
    simp only [map_sum, map_mul, stdAddChar_conj, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro ξ _
    ring
  simp only [hg, finiteAverage_sum, finiteAverage_mul_const, ← finiteFourier_eq_average]

theorem finiteFourier_parseval {q : ℕ} [NeZero q] (f : ZMod q → ℂ) :
    uniformMean (fun x => ‖f x‖ ^ 2) = ∑ ξ, ‖finiteFourier f ξ‖ ^ 2 := by
  have h := congrArg Complex.re (finiteFourier_pairing f f)
  simpa only [finiteAverage_re, Complex.mul_conj, Complex.normSq_eq_norm_sq,
    Complex.ofReal_re, Complex.re_sum] using h

theorem finiteAverage_comm {A B : Type*} [Fintype A] [Fintype B] (f : A → B → ℂ) :
    finiteAverage (fun a => finiteAverage (f a)) =
      finiteAverage (fun b => finiteAverage (fun a => f a b)) := by
  simp only [← uniformMean_complex_eq]
  exact uniformMean_comm f

theorem finiteAverage_equiv {A B : Type*} [Fintype A] [Fintype B]
    (e : A ≃ B) (f : B → ℂ) : finiteAverage (fun a => f (e a)) = finiteAverage f := by
  simpa only [← uniformMean_complex_eq] using uniformMean_equiv e f

theorem finiteFourier_translate {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (a ξ : ZMod q) :
    finiteFourier (fun x => f (x - a)) ξ =
      ZMod.stdAddChar (-(ξ * a)) * finiteFourier f ξ := by
  rw [finiteFourier_eq_average]
  rw [← finiteAverage_equiv (Equiv.addRight a)
    (fun x => f (x - a) * ZMod.stdAddChar (-(ξ * x)))]
  simp only [Equiv.coe_addRight, add_sub_cancel_right, mul_add, neg_add,
    AddChar.map_add_eq_mul]
  simp_rw [← mul_assoc]
  rw [finiteAverage_mul_const, ← finiteFourier_eq_average, mul_comm]

theorem finiteFourier_convolution {q : ℕ} [NeZero q] (f g : ZMod q → ℂ) (ξ : ZMod q) :
    finiteFourier (finiteConvolution f g) ξ = finiteFourier f ξ * finiteFourier g ξ := by
  rw [finiteFourier_eq_average]
  simp only [finiteConvolution, ← finiteAverage_mul_const]
  rw [finiteAverage_comm]
  have hi (y : ZMod q) :
      finiteAverage (fun x => f y * g (x - y) * ZMod.stdAddChar (-(ξ * x))) =
        (f y * ZMod.stdAddChar (-(ξ * y))) * finiteFourier g ξ := by
    simp_rw [mul_assoc]
    rw [finiteAverage_const_mul, ← finiteFourier_eq_average, finiteFourier_translate]
  simp only [hi, finiteAverage_mul_const, ← finiteFourier_eq_average]

theorem finiteHaar_pi {I G : Type*} [Fintype I] [DecidableEq I] [Fintype G] [Nonempty G]
    [MeasurableSpace G] [MeasurableSingletonClass G] :
    Measure.pi (fun _ : I => finiteHaar G) = finiteHaar (I → G) := by
  apply Measure.ext_of_singleton
  intro f
  rw [Measure.pi_singleton]
  simp [finiteHaar, ← ENNReal.inv_pow]

theorem integral_finiteHaar_uniform {G E : Type*} [Fintype G] [MeasurableSpace G]
    [MeasurableSingletonClass G] [NormedAddCommGroup E] [NormedSpace ℝ E]
    [CompleteSpace E] (f : G → E) :
    (∫ x, f x ∂finiteHaar G) = uniformMean f := by
  rw [finiteHaar, integral_smul_measure, integral_count]
  simp [uniformMean, ENNReal.toReal_inv]

theorem finite_cubeAverage_eq {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] (j : ℕ)
    (f : (Fin j → Bool) → G → ℂ) :
    cubeAverage (finiteHaar G) j f =
      uniformMean (fun h : Fin j → G => uniformMean (cubeIntegrand f h)) := by
  simp only [cubeAverage, finiteHaar_pi, integral_finiteHaar_uniform]

theorem finite_gowersNorm_pow {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd₂ G]
    {j : ℕ} (hj : 1 ≤ j) (f : G → ℂ) :
    gowersNorm (finiteHaar G) j f ^ (2 ^ j) =
      (cubeAverage (finiteHaar G) j (fun _ => f)).re := by
  apply gowersNorm_pow (finiteHaar G) hj f (measurable_of_countable f)
    (M := ∑ x, ‖f x‖)
  intro x
  exact Finset.single_le_sum (fun _ _ => norm_nonneg _) (Finset.mem_univ x)

theorem finiteAverage_conj {G : Type*} [Fintype G] (f : G → ℂ) :
    finiteAverage (fun x => conj (f x)) = conj (finiteAverage f) := by
  simp [finiteAverage, map_sum, map_mul]

theorem finiteFourier_reflect_conj {q : ℕ} [NeZero q] (f : ZMod q → ℂ) (ξ : ZMod q) :
    finiteFourier (fun x => conj (f (-x))) ξ = conj (finiteFourier f ξ) := by
  rw [finiteFourier_eq_average,
    ← finiteAverage_equiv (Equiv.neg _) (fun x => conj (f (-x)) *
      ZMod.stdAddChar (-(ξ * x)))]
  simp only [Equiv.neg_apply, neg_neg, mul_neg]
  rw [finiteFourier_eq_average, ← finiteAverage_conj]
  congr 1
  funext x
  simp only [map_mul, stdAddChar_conj, neg_neg]

theorem finite_cubeAverage_sq {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd₂ G]
    (j : ℕ) (f : G → ℂ) : cubeAverage (finiteHaar G) (j + 1) (fun _ => f) =
      (uniformMean (fun h : Fin j → G =>
        ‖uniformMean (diagonalCubeIntegrand j f h)‖ ^ 2) : ℝ) := by
  rw [cubeAverage_diagonal_eq_integral_sq (finiteHaar G) j f (measurable_of_countable f)
    (M := ∑ x, ‖f x‖) (fun x =>
      Finset.single_le_sum (fun _ _ => norm_nonneg _) (Finset.mem_univ x))]
  simp only [finiteHaar_pi, integral_finiteHaar_uniform]

theorem diagonalCubeIntegrand_one {G : Type*} [AddCommGroup G]
    (f : G → ℂ) (h : Fin 1 → G) (x : G) :
    diagonalCubeIntegrand 1 f h x = f x * conj (f (x + h 0)) := by
  rw [diagonalCubeIntegrand_succ 0]
  simp only [diagonalCubeIntegrand_zero]

theorem finiteFourier_gowers_two {q : ℕ} [NeZero q] (f : ZMod q → ℂ) :
    gowersNorm (finiteHaar (ZMod q)) 2 f ^ 4 = ∑ ξ, ‖finiteFourier f ξ‖ ^ 4 := by
  rw [show 4 = 2 ^ 2 from rfl, finite_gowersNorm_pow (by norm_num),
    show 2 = 1 + 1 from rfl, finite_cubeAverage_sq, Complex.ofReal_re]
  have hf1 (h : Fin 1 → ZMod q) : diagonalCubeIntegrand 1 f h =
      fun x => f x * conj (f (x + h 0)) := funext (diagonalCubeIntegrand_one f h)
  simp only [hf1]
  rw [uniformMean_eval (0 : Fin 1)
    (fun h => ‖uniformMean (fun x => f x * conj (f (x + h)))‖ ^ 2)]
  let D := finiteConvolution f (fun x => conj (f (-x)))
  have hd (h : ZMod q) : uniformMean (fun x => f x * conj (f (x + h))) = D (-h) := by
    rw [uniformMean_complex_eq]
    simp only [D, finiteConvolution, neg_sub, sub_neg_eq_add, add_comm]
  simp only [hd]
  have hn : uniformMean (fun h => ‖D (-h)‖ ^ 2) = uniformMean (fun h => ‖D h‖ ^ 2) := by
    simpa only [Equiv.neg_apply] using
      uniformMean_equiv (Equiv.neg _) (fun h => ‖D h‖ ^ 2)
  rw [hn, finiteFourier_parseval]
  apply Finset.sum_congr rfl
  intro ξ _
  simp only [D, finiteFourier_convolution, finiteFourier_reflect_conj,
    norm_mul, Complex.norm_conj]
  ring

theorem cubeConj_mul (n : ℕ) (a b : ℂ) : cubeConj n (a * b) = cubeConj n a * cubeConj n b := by
  by_cases h : Even n <;> simp [cubeConj, h]

theorem cubeConj_conj (n : ℕ) (a : ℂ) : cubeConj n (conj a) = conj (cubeConj n a) := by
  by_cases h : Even n <;> simp [cubeConj, h]

theorem diagonalCubeIntegrand_mul {G : Type*} [AddCommGroup G] (j : ℕ)
    (f g : G → ℂ) (h : Fin j → G) (x : G) :
    diagonalCubeIntegrand j (fun x => f x * g x) h x =
      diagonalCubeIntegrand j f h x * diagonalCubeIntegrand j g h x := by
  simp [diagonalCubeIntegrand, cubeIntegrand, cubeConj_mul, Finset.prod_mul_distrib]

theorem diagonalCubeIntegrand_conj {G : Type*} [AddCommGroup G] (j : ℕ)
    (f : G → ℂ) (h : Fin j → G) (x : G) :
    diagonalCubeIntegrand j (fun x => conj (f x)) h x =
      conj (diagonalCubeIntegrand j f h x) := by
  simp [diagonalCubeIntegrand, cubeIntegrand, cubeConj_conj, map_prod]

theorem diagonalCubeIntegrand_translate {G : Type*} [AddCommGroup G] (j : ℕ)
    (f : G → ℂ) (h : Fin j → G) (x t : G) :
    diagonalCubeIntegrand j (fun y => f (y + t)) h x =
      diagonalCubeIntegrand j f h (x + t) := by
  simp [diagonalCubeIntegrand, cubeIntegrand, add_right_comm]

theorem uniformMean_fin_cons {G E : Type*} [Fintype G] [AddCommMonoid E] [Module ℝ E]
    (j : ℕ) (f : (Fin (j + 1) → G) → E) :
    uniformMean f = uniformMean (fun t => uniformMean (fun h : Fin j → G => f (Fin.cons t h))) := by
  let e : G × (Fin j → G) ≃ (Fin (j + 1) → G) :=
    { toFun := fun p => Fin.cons p.1 p.2
      invFun := fun h => (h 0, fun i => h i.succ)
      left_inv := fun p => by ext <;> simp
      right_inv := fun h => by ext i; induction i using Fin.cases <;> simp }
  rw [← uniformMean_equiv e]
  rw [uniformMean_prod]
  rfl

theorem finite_cubeAverage_recursion {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] (j : ℕ) (f : G → ℂ) :
    cubeAverage (finiteHaar G) (j + 1) (fun _ => f) =
      uniformMean (fun t => cubeAverage (finiteHaar G) j
        (fun _ x => f x * conj (f (x + t)))) := by
  simp only [finite_cubeAverage_eq]
  rw [uniformMean_fin_cons]
  congr 1
  funext t
  congr 1
  funext h
  congr 1
  funext x
  change diagonalCubeIntegrand (j + 1) f (Fin.cons t h) x =
    diagonalCubeIntegrand j (fun x => f x * conj (f (x + t))) h x
  simp only [diagonalCubeIntegrand_succ, Fin.cons_zero, Fin.cons_succ,
    diagonalCubeIntegrand_mul, diagonalCubeIntegrand_conj, diagonalCubeIntegrand_translate]

theorem uniformMean_conj {G : Type*} [Fintype G] (f : G → ℂ) :
    uniformMean (fun x => conj (f x)) = conj (uniformMean f) := by
  simpa only [uniformMean_complex_eq] using finiteAverage_conj f

theorem uniformMean_re {G : Type*} [Fintype G] (f : G → ℂ) :
    (uniformMean f).re = uniformMean (fun x => (f x).re) := by
  rw [uniformMean_complex_eq, finiteAverage_re]

theorem finite_cubeAverage_conj {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] (j : ℕ) (f : G → ℂ) :
    cubeAverage (finiteHaar G) j (fun _ x => conj (f x)) =
      conj (cubeAverage (finiteHaar G) j (fun _ => f)) := by
  simp only [finite_cubeAverage_eq]
  have heq (h : Fin j → G) : cubeIntegrand (fun _ x => conj (f x)) h =
      fun x => conj (cubeIntegrand (fun _ => f) h x) := by
    funext x
    exact diagonalCubeIntegrand_conj j f h x
  simp only [heq, uniformMean_conj]

theorem finite_gowersNorm_conj {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] (j : ℕ) (f : G → ℂ) :
    gowersNorm (finiteHaar G) j (fun x => conj (f x)) = gowersNorm (finiteHaar G) j f := by
  simp only [gowersNorm, finite_cubeAverage_conj, Complex.conj_re]

/-- The source's `U³` recursion, with its stated multiplicative-difference convention. -/
theorem finite_gowers_three_recursion {G : Type*} [AddCommGroup G] [Fintype G]
    [MeasurableSpace G] [MeasurableSingletonClass G] [MeasurableAdd₂ G] (f : G → ℂ) :
    gowersNorm (finiteHaar G) 3 f ^ 8 = uniformMean (fun t =>
      gowersNorm (finiteHaar G) 2 (fun x => f (x + t) * conj (f x)) ^ 4) := by
  rw [show 8 = 2 ^ 3 from rfl, finite_gowersNorm_pow (by norm_num),
    show 3 = 2 + 1 from rfl, finite_cubeAverage_recursion, uniformMean_re]
  congr 1
  funext t
  rw [show 4 = 2 ^ 2 from rfl, finite_gowersNorm_pow (by norm_num)]
  have heq : (fun x => f (x + t) * conj (f x)) =
      (fun x => conj (f x * conj (f (x + t)))) := by
    funext x
    simp [mul_comm]
  rw [heq, finite_cubeAverage_conj, Complex.conj_re]

/-! Coordinate reflection for the Haar cube Cauchy–Schwarz inequality. -/

def cubeFace {j : ℕ} {E : Type*} (i : Fin (j + 1)) (b : Bool)
    (f : (Fin (j + 1) → Bool) → E) : (Fin j → Bool) → E :=
  fun ω => f (Fin.insertNth i b ω)

def cubeCopy {j : ℕ} {E : Type*} (i : Fin j) (b : Bool)
    (f : (Fin j → Bool) → E) : (Fin j → Bool) → E :=
  fun ω => f (Function.update ω i b)

theorem cubeWeight_insertNth {j : ℕ} (i : Fin (j + 1)) (b : Bool) (ω : Fin j → Bool) :
    cubeWeight (Fin.insertNth i b ω) = (if b then 1 else 0) + cubeWeight ω := by
  unfold cubeWeight
  rw [Fin.sum_univ_succAbove _ i]
  simp

theorem cubeShift_insertNth {G : Type*} [AddCommMonoid G] {j : ℕ}
    (i : Fin (j + 1)) (h : Fin (j + 1) → G) (b : Bool) (ω : Fin j → Bool) :
    cubeShift h (Fin.insertNth i b ω) = (if b then h i else 0) +
      cubeShift (fun k => h (i.succAbove k)) ω := by
  unfold cubeShift
  rw [Fin.sum_univ_succAbove _ i]
  simp

theorem cubeIntegrand_split {G : Type*} [AddCommMonoid G] {j : ℕ}
    (i : Fin (j + 1)) (f : (Fin (j + 1) → Bool) → G → ℂ)
    (h : Fin j → G) (t x : G) :
    cubeIntegrand f (Fin.insertNth i t h) x =
      cubeIntegrand (cubeFace i false f) h x *
        conj (cubeIntegrand (cubeFace i true f) h (x + t)) := by
  unfold cubeIntegrand
  rw [← (Fin.insertNthEquiv (fun _ : Fin (j + 1) => Bool) i).prod_comp
    (fun ω => cubeConj (cubeWeight ω) (f ω (x + cubeShift (Fin.insertNth i t h) ω))),
    Fintype.prod_prod_type, Fintype.prod_bool, map_prod, ← Finset.prod_mul_distrib,
    ← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro ω _
  simp [Fin.insertNthEquiv, cubeWeight_insertNth, cubeShift_insertNth,
    cubeFace, Nat.add_comm 1, cubeConj_succ, add_assoc, mul_comm]

theorem integral_pi_insertNth {G : Type*} [MeasurableSpace G]
    (μ : Measure G) [IsProbabilityMeasure μ] {j : ℕ} (i : Fin (j + 1))
    (F : (Fin (j + 1) → G) → ℂ) (hF : Measurable F) {M : ℝ}
    (hbound : ∀ h, ‖F h‖ ≤ M) :
    (∫ h, F h ∂Measure.pi (fun _ : Fin (j + 1) => μ)) =
      ∫ h, ∫ t, F (Fin.insertNth i t h) ∂μ ∂Measure.pi (fun _ : Fin j => μ) := by
  let e := MeasurableEquiv.piFinSuccAbove (fun _ : Fin (j + 1) => G) i
  have hmp := (measurePreserving_piFinSuccAbove (fun _ : Fin (j + 1) => μ) i).symm
  have hInt : Integrable (fun p : G × (Fin j → G) => F (e.symm p))
      (μ.prod (Measure.pi (fun _ : Fin j => μ))) :=
    integrable_of_measurable_bounded (hF.comp e.symm.measurable) (fun p => hbound _)
  rw [← hmp.integral_comp']
  change (∫ p : G × (Fin j → G), F (e.symm p) ∂μ.prod (Measure.pi (fun _ => μ))) = _
  rw [integral_prod_symm _ hInt]
  apply integral_congr_ae
  filter_upwards [] with h
  apply integral_congr_ae
  filter_upwards [] with t
  rfl

theorem integral_haar_cross_correlation {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (f g : G → ℂ) (hf : Measurable f) (hg : Measurable g) {M N : ℝ}
    (hboundf : ∀ x, ‖f x‖ ≤ M) (hboundg : ∀ x, ‖g x‖ ≤ N) :
    (∫ h, ∫ x, f x * conj (g (x + h)) ∂μ ∂μ) =
      (∫ x, f x ∂μ) * conj (∫ x, g x ∂μ) := by
  have hM : 0 ≤ M := (norm_nonneg (f 0)).trans (hboundf 0)
  have hmeas : Measurable (fun p : G × G => f p.2 * conj (g (p.2 + p.1))) :=
    (hf.comp measurable_snd).mul (Complex.continuous_conj.measurable.comp
      (hg.comp (measurable_snd.add measurable_fst)))
  have hint : Integrable (fun p : G × G => f p.2 * conj (g (p.2 + p.1))) (μ.prod μ) :=
    integrable_of_measurable_bounded hmeas (fun p => by
      rw [norm_mul, Complex.norm_conj]
      exact mul_le_mul (hboundf _) (hboundg _) (norm_nonneg _) hM)
  rw [integral_integral_swap hint]
  simp_rw [integral_const_mul]
  have ht (x : G) : (∫ h, conj (g (x + h)) ∂μ) = ∫ h, conj (g h) ∂μ :=
    integral_add_left_eq_self (fun h => conj (g h)) x
  simp_rw [ht]
  rw [integral_conj, integral_mul_const]

/-- Every coordinate splitting expresses a mixed cube as an inner product of face averages. -/
theorem cubeAverage_split {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {j : ℕ} (i : Fin (j + 1)) (f : (Fin (j + 1) → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) {M : ℝ} (hbound : ∀ ω x, ‖f ω x‖ ≤ M) :
    cubeAverage μ (j + 1) f = ∫ h : Fin j → G,
      (∫ x, cubeIntegrand (cubeFace i false f) h x ∂μ) *
        conj (∫ x, cubeIntegrand (cubeFace i true f) h x ∂μ)
          ∂Measure.pi (fun _ => μ) := by
  have hmeas := measurable_cubeIntegrand f hf
  have hm : Measurable (fun h : Fin (j + 1) → G => ∫ x, cubeIntegrand f h x ∂μ) :=
    hmeas.stronglyMeasurable.integral_prod_right.measurable
  have hb : ∀ h : Fin (j + 1) → G, ‖∫ x, cubeIntegrand f h x ∂μ‖ ≤ M ^ (2 ^ (j + 1)) := by
    intro h
    simpa using norm_integral_le_of_norm_le_const (μ := μ)
      (Filter.Eventually.of_forall (norm_cubeIntegrand_le f hbound h))
  rw [cubeAverage, integral_pi_insertNth μ i _ hm hb]
  apply integral_congr_ae
  filter_upwards [] with h
  simp only [cubeIntegrand_split]
  apply integral_haar_cross_correlation μ
  · exact (measurable_cubeIntegrand _ (fun ω => hf _)).comp
      (measurable_const.prodMk measurable_id)
  · exact (measurable_cubeIntegrand _ (fun ω => hf _)).comp
      (measurable_const.prodMk measurable_id)
  · exact norm_cubeIntegrand_le _ (fun ω => hbound _) h
  · exact norm_cubeIntegrand_le _ (fun ω => hbound _) h

theorem norm_integral_mul_conj_sq_le {X : Type*} [MeasurableSpace X]
    (μ : Measure X) [IsFiniteMeasure μ] (f g : X → ℂ)
    (hf : Measurable f) (hg : Measurable g) {M N : ℝ}
    (hbf : ∀ x, ‖f x‖ ≤ M) (hbg : ∀ x, ‖g x‖ ≤ N) :
    ‖∫ x, f x * conj (g x) ∂μ‖ ^ 2 ≤
      (∫ x, ‖f x‖ ^ 2 ∂μ) * (∫ x, ‖g x‖ ^ 2 ∂μ) := by
  have hfl : MemLp f (ENNReal.ofReal 2) μ :=
    MemLp.of_bound hf.aestronglyMeasurable M (Filter.Eventually.of_forall hbf)
  have hgl : MemLp g (ENNReal.ofReal 2) μ :=
    MemLp.of_bound hg.aestronglyMeasurable N (Filter.Eventually.of_forall hbg)
  have hholder := integral_mul_norm_le_Lp_mul_Lq
    (show Real.HolderConjugate 2 2 by norm_num [Real.holderConjugate_iff]) hfl hgl
  have hnorm := norm_integral_le_integral_norm (fun x => f x * conj (g x)) (μ := μ)
  simp only [norm_mul, Complex.norm_conj] at hnorm
  have h : ‖∫ x, f x * conj (g x) ∂μ‖ ≤
      Real.sqrt (∫ x, ‖f x‖ ^ 2 ∂μ) * Real.sqrt (∫ x, ‖g x‖ ^ 2 ∂μ) := by
    simpa only [Real.rpow_two, ← Real.sqrt_eq_rpow] using hnorm.trans hholder
  have hsq := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg _)
    (Real.sqrt_nonneg _))).mpr h
  simpa only [mul_pow, Real.sq_sqrt (integral_nonneg (fun x => sq_nonneg ‖f x‖)),
    Real.sq_sqrt (integral_nonneg (fun x => sq_nonneg ‖g x‖))] using hsq

theorem cubeFace_copy {j : ℕ} {E : Type*} (i : Fin (j + 1)) (b c : Bool)
    (f : (Fin (j + 1) → Bool) → E) : cubeFace i c (cubeCopy i b f) = cubeFace i b f := by
  funext ω
  unfold cubeFace cubeCopy
  rw [Fin.update_insertNth]

/-- The two reflected cubes are squares of face averages, hence real and nonnegative. -/
theorem cubeAverage_copy_eq_sq {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {j : ℕ} (i : Fin (j + 1)) (b : Bool) (f : (Fin (j + 1) → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) {M : ℝ} (hbound : ∀ ω x, ‖f ω x‖ ≤ M) :
    cubeAverage μ (j + 1) (cubeCopy i b f) =
      (∫ h : Fin j → G, ‖∫ x, cubeIntegrand (cubeFace i b f) h x ∂μ‖ ^ 2
        ∂Measure.pi (fun _ => μ) : ℝ) := by
  rw [cubeAverage_split μ i (cubeCopy i b f) (fun ω => hf _) (fun ω => hbound _)]
  simp only [cubeFace_copy, Complex.mul_conj, Complex.normSq_eq_norm_sq,
    integral_complex_ofReal]

theorem cubeAverage_copy_re_nonneg {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {j : ℕ} (i : Fin (j + 1)) (b : Bool) (f : (Fin (j + 1) → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) {M : ℝ} (hbound : ∀ ω x, ‖f ω x‖ ≤ M) :
    0 ≤ (cubeAverage μ (j + 1) (cubeCopy i b f)).re := by
  rw [cubeAverage_copy_eq_sq μ i b f hf hbound, Complex.ofReal_re]
  exact integral_nonneg (fun h => sq_nonneg _)

/-- One coordinate-reflection Cauchy–Schwarz step from `lem:cube-foundation`. -/
theorem cubeAverage_coordinate_cs {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {j : ℕ} (i : Fin (j + 1)) (f : (Fin (j + 1) → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) {M : ℝ} (hbound : ∀ ω x, ‖f ω x‖ ≤ M) :
    ‖cubeAverage μ (j + 1) f‖ ^ 2 ≤
      (cubeAverage μ (j + 1) (cubeCopy i false f)).re *
        (cubeAverage μ (j + 1) (cubeCopy i true f)).re := by
  rw [cubeAverage_split μ i f hf hbound,
    cubeAverage_copy_eq_sq μ i false f hf hbound,
    cubeAverage_copy_eq_sq μ i true f hf hbound, Complex.ofReal_re, Complex.ofReal_re]
  apply norm_integral_mul_conj_sq_le
  · exact (measurable_cubeIntegrand _ (fun ω => hf _)).stronglyMeasurable
      |>.integral_prod_right.measurable
  · exact (measurable_cubeIntegrand _ (fun ω => hf _)).stronglyMeasurable
      |>.integral_prod_right.measurable
  · intro h
    simpa using norm_integral_le_of_norm_le_const (μ := μ)
      (Filter.Eventually.of_forall (norm_cubeIntegrand_le (cubeFace i false f)
        (fun ω => hbound _) h))
  · intro h
    simpa using norm_integral_le_of_norm_le_const (μ := μ)
      (Filter.Eventually.of_forall (norm_cubeIntegrand_le (cubeFace i true f)
        (fun ω => hbound _) h))

/-- Apply the specified coordinate reflections in order. -/
def cubeReflections {d : ℕ} {E : Type*} : (n : ℕ) → (Fin n → Fin d) →
    (Fin n → Bool) → ((Fin d → Bool) → E) → ((Fin d → Bool) → E)
  | 0, _, _, f => f
  | n + 1, c, ω, f => cubeReflections n (fun i => c i.succ) (fun i => ω i.succ)
      (cubeCopy (c 0) (ω 0) f)

/-- The finite Cauchy–Schwarz iteration, restricted to any class closed under reflections. -/
theorem cube_reflection_iteration {d : ℕ} {E : Type*}
    (P : ((Fin d → Bool) → E) → Prop) (Q : ((Fin d → Bool) → E) → ℝ)
    (hQ : ∀ f, P f → 0 ≤ Q f)
    (hcopy : ∀ i b f, P f → P (cubeCopy i b f))
    (hcs : ∀ i f, P f → Q f ^ 2 ≤ Q (cubeCopy i false f) * Q (cubeCopy i true f))
    (n : ℕ) (c : Fin n → Fin d) (f : (Fin d → Bool) → E) (hf : P f) :
    Q f ^ (2 ^ n) ≤ ∏ ω : Fin n → Bool, Q (cubeReflections n c ω f) := by
  induction n generalizing f with
  | zero => simp [cubeReflections]
  | succ n ih =>
    have hbranch (b : Bool) :
        Q (cubeCopy (c 0) b f) ^ (2 ^ n) ≤
          ∏ ω : Fin n → Bool, Q (cubeReflections n (fun i => c i.succ) ω
            (cubeCopy (c 0) b f)) := ih _ _ (hcopy _ _ _ hf)
    calc Q f ^ (2 ^ (n + 1)) = (Q f ^ 2) ^ (2 ^ n) := by
          rw [← pow_mul, pow_succ]; congr 1; omega
      _ ≤ (Q (cubeCopy (c 0) false f) * Q (cubeCopy (c 0) true f)) ^ (2 ^ n) :=
          pow_le_pow_left₀ (sq_nonneg _) (hcs _ f hf) _
      _ = ∏ b : Bool, Q (cubeCopy (c 0) b f) ^ (2 ^ n) := by
          rw [mul_pow, Fintype.prod_bool]; ring
      _ ≤ ∏ b : Bool, ∏ ω : Fin n → Bool,
          Q (cubeReflections n (fun i => c i.succ) ω (cubeCopy (c 0) b f)) :=
          Finset.prod_le_prod₀ (fun b _ => pow_nonneg (hQ _ (hcopy _ _ _ hf)) _)
            (fun b _ => hbranch b)
      _ = ∏ ω : Fin (n + 1) → Bool, Q (cubeReflections (n + 1) c ω f) := by
          rw [← (cubeConsEquiv n).prod_comp
            (fun ω => Q (cubeReflections (n + 1) c ω f)), Fintype.prod_prod_type]
          simp only [cubeConsEquiv, Equiv.coe_fn_mk, cubeReflections, Fin.cons_zero, Fin.cons_succ]

theorem cubeReflections_three {E : Type*} (ω : Fin 3 → Bool) (f : (Fin 3 → Bool) → E) :
    cubeReflections 3 id ω f = fun _ => f ω := by
  funext ν
  simp only [cubeReflections, id_eq, cubeCopy]
  congr 1
  ext i
  fin_cases i <;> simp

theorem cubeAverage_diagonal_norm_eq_re {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    {j : ℕ} (hj : 1 ≤ j) (f : G → ℂ) (hf : Measurable f) {M : ℝ}
    (hbound : ∀ x, ‖f x‖ ≤ M) :
    ‖cubeAverage μ j (fun _ => f)‖ = (cubeAverage μ j (fun _ => f)).re := by
  rw [← Complex.abs_re_eq_norm.mpr (cubeAverage_diagonal_im_eq_zero μ hj f hf hbound),
    abs_of_nonneg (cubeAverage_diagonal_re_nonneg μ hj f hf hbound)]

/-- The eightfold reflection estimate before taking nonnegative eighth roots. -/
theorem cubeAverage_three_cs_pow {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (f : (Fin 3 → Bool) → G → ℂ) (hf : ∀ ω, Measurable (f ω))
    {M : ℝ} (hbound : ∀ ω x, ‖f ω x‖ ≤ M) :
    ‖cubeAverage μ 3 f‖ ^ 8 ≤ ∏ ω, (cubeAverage μ 3 (fun _ => f ω)).re := by
  let P : ((Fin 3 → Bool) → G → ℂ) → Prop :=
    fun g => (∀ ω, Measurable (g ω)) ∧ ∀ ω x, ‖g ω x‖ ≤ M
  have hcopy (i : Fin 3) (b : Bool) (g : (Fin 3 → Bool) → G → ℂ) (hg : P g) :
      P (cubeCopy i b g) := ⟨fun ω => hg.1 _, fun ω => hg.2 _⟩
  have hcs (i : Fin 3) (g : (Fin 3 → Bool) → G → ℂ) (hg : P g) :
      ‖cubeAverage μ 3 g‖ ^ 2 ≤
        ‖cubeAverage μ 3 (cubeCopy i false g)‖ * ‖cubeAverage μ 3 (cubeCopy i true g)‖ := by
    refine (cubeAverage_coordinate_cs μ i g hg.1 hg.2).trans ?_
    exact mul_le_mul (Complex.re_le_norm _) (Complex.re_le_norm _)
      (cubeAverage_copy_re_nonneg μ i true g hg.1 hg.2) (norm_nonneg _)
  have h := cube_reflection_iteration P (fun g => ‖cubeAverage μ 3 g‖)
    (fun _ _ => norm_nonneg _) hcopy hcs 3 id f ⟨hf, hbound⟩
  norm_num only at h
  simpa only [cubeReflections_three, cubeAverage_diagonal_norm_eq_re μ
    (by norm_num : 1 ≤ 3) _ (hf _) (hbound _)] using h

/-- Blueprint `lem:cube-foundation`: mixed Gowers–Cauchy–Schwarz on Haar probability groups. -/
theorem cubeAverage_three_cs {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (f : (Fin 3 → Bool) → G → ℂ) (hf : ∀ ω, Measurable (f ω))
    {M : ℝ} (hbound : ∀ ω x, ‖f ω x‖ ≤ M) :
    ‖cubeAverage μ 3 f‖ ≤ ∏ ω, gowersNorm μ 3 (f ω) := by
  have hn (ω : Fin 3 → Bool) : 0 ≤ gowersNorm μ 3 (f ω) :=
    gowersNorm_nonneg μ (by norm_num) _ (hf ω) (hbound ω)
  have hp (ω : Fin 3 → Bool) : gowersNorm μ 3 (f ω) ^ 8 =
      (cubeAverage μ 3 (fun _ => f ω)).re :=
    gowersNorm_pow μ (by norm_num) _ (hf ω) (hbound ω)
  have h := cubeAverage_three_cs_pow μ f hf hbound
  simp only [← hp, Finset.prod_pow] at h
  exact (pow_le_pow_iff_left₀ (norm_nonneg _) (Finset.prod_nonneg (fun ω _ => hn ω))
    (by norm_num : (8 : ℕ) ≠ 0)).mp h

theorem cubeConj_add (n : ℕ) (a b : ℂ) : cubeConj n (a + b) = cubeConj n a + cubeConj n b := by
  by_cases h : Even n <;> simp [cubeConj, h]

def cubeChoice {G : Type*} {j : ℕ} (f g : G → ℂ)
    (σ : (Fin j → Bool) → Bool) : (Fin j → Bool) → G → ℂ :=
  fun ω => if σ ω then f else g

theorem cubeIntegrand_add_expansion {G : Type*} [AddCommGroup G] (j : ℕ)
    (f g : G → ℂ) (h : Fin j → G) (x : G) :
    cubeIntegrand (fun _ x => f x + g x) h x =
      ∑ σ : (Fin j → Bool) → Bool, cubeIntegrand (cubeChoice f g σ) h x := by
  unfold cubeIntegrand
  have heq (ω : Fin j → Bool) : cubeConj (cubeWeight ω) (f (x + cubeShift h ω) +
      g (x + cubeShift h ω)) = ∑ b : Bool,
        cubeConj (cubeWeight ω) ((if b then f else g) (x + cubeShift h ω)) := by
    simp [cubeConj_add]
  simp only [heq, Fintype.prod_sum, cubeChoice]

theorem measurable_cubeChoice {G : Type*} [MeasurableSpace G] {j : ℕ}
    (f g : G → ℂ) (hf : Measurable f) (hg : Measurable g)
    (σ : (Fin j → Bool) → Bool) (ω : Fin j → Bool) :
    Measurable (cubeChoice f g σ ω) := by
  unfold cubeChoice
  split_ifs <;> assumption

theorem norm_cubeChoice_le {G : Type*} {j : ℕ} (f g : G → ℂ)
    {M : ℝ} (hf : ∀ x, ‖f x‖ ≤ M) (hg : ∀ x, ‖g x‖ ≤ M)
    (σ : (Fin j → Bool) → Bool) (ω : Fin j → Bool) (x : G) :
    ‖cubeChoice f g σ ω x‖ ≤ M := by
  unfold cubeChoice
  split_ifs <;> first | exact hf x | exact hg x

set_option maxHeartbeats 800000 in
-- The finite expansion has a function space of cube vertices as its summation index.
theorem cubeAverage_add_expansion {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] (j : ℕ)
    (f g : G → ℂ) (hf : Measurable f) (hg : Measurable g) {M : ℝ}
    (hbf : ∀ x, ‖f x‖ ≤ M) (hbg : ∀ x, ‖g x‖ ≤ M) :
    cubeAverage μ j (fun _ x => f x + g x) =
      ∑ σ : (Fin j → Bool) → Bool, cubeAverage μ j (cubeChoice f g σ) := by
  have hm (σ : (Fin j → Bool) → Bool) :=
    measurable_cubeIntegrand (cubeChoice f g σ) (measurable_cubeChoice f g hf hg σ)
  have hb (σ : (Fin j → Bool) → Bool) :=
    norm_cubeIntegrand_le (cubeChoice f g σ) (norm_cubeChoice_le f g hbf hbg σ)
  have hi (σ : (Fin j → Bool) → Bool) (h : Fin j → G) :
      Integrable (cubeIntegrand (cubeChoice f g σ) h) μ :=
    integrable_of_measurable_bounded ((hm σ).comp (measurable_const.prodMk measurable_id)) (hb σ h)
  have ho (σ : (Fin j → Bool) → Bool) : Integrable (fun h : Fin j → G =>
      ∫ x, cubeIntegrand (cubeChoice f g σ) h x ∂μ) (Measure.pi (fun _ => μ)) := by
    apply integrable_of_measurable_bounded
      ((hm σ).stronglyMeasurable.integral_prod_right.measurable) (M := M ^ (2 ^ j))
    intro h
    simpa using norm_integral_le_of_norm_le_const (μ := μ)
      (Filter.Eventually.of_forall (hb σ h))
  unfold cubeAverage
  simp_rw [cubeIntegrand_add_expansion, integral_finsetSum _ (fun σ _ => hi σ _)]
  exact integral_finsetSum _ (fun σ _ => ho σ)

theorem sum_cubeChoice_products {j : ℕ} (a b : ℝ) :
    (∑ σ : (Fin j → Bool) → Bool, ∏ ω : Fin j → Bool, if σ ω then a else b) =
      (a + b) ^ (2 ^ j) := by
  rw [← Fintype.prod_sum (fun _ : Fin j → Bool => fun c : Bool => if c then a else b)]
  simp

/-- The triangle inequality for the order-three Haar Gowers seminorm
on bounded measurable inputs. -/
theorem gowersNorm_three_add_le {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (f g : G → ℂ) (hf : Measurable f) (hg : Measurable g) {M : ℝ}
    (hbf : ∀ x, ‖f x‖ ≤ M) (hbg : ∀ x, ‖g x‖ ≤ M) :
    gowersNorm μ 3 (fun x => f x + g x) ≤ gowersNorm μ 3 f + gowersNorm μ 3 g := by
  have hsum : ∀ x, ‖f x + g x‖ ≤ M + M :=
    fun x => (norm_add_le _ _).trans (add_le_add (hbf x) (hbg x))
  have hnorm (σ : (Fin 3 → Bool) → Bool) :
      ‖cubeAverage μ 3 (cubeChoice f g σ)‖ ≤
        ∏ ω : Fin 3 → Bool, if σ ω then gowersNorm μ 3 f else gowersNorm μ 3 g := by
    convert cubeAverage_three_cs μ (cubeChoice f g σ)
      (measurable_cubeChoice f g hf hg σ) (norm_cubeChoice_le f g hbf hbg σ) using 1
    congr 1
    funext ω
    unfold cubeChoice
    split_ifs <;> rfl
  have hp : gowersNorm μ 3 (fun x => f x + g x) ^ 8 ≤
      (gowersNorm μ 3 f + gowersNorm μ 3 g) ^ 8 := by
    calc _ = (cubeAverage μ 3 (fun _ x => f x + g x)).re :=
          gowersNorm_pow μ (by norm_num) _ (hf.add hg) hsum
      _ ≤ ‖cubeAverage μ 3 (fun _ x => f x + g x)‖ := Complex.re_le_norm _
      _ = ‖∑ σ : (Fin 3 → Bool) → Bool, cubeAverage μ 3 (cubeChoice f g σ)‖ := by
          rw [cubeAverage_add_expansion μ 3 f g hf hg hbf hbg]
      _ ≤ ∑ σ : (Fin 3 → Bool) → Bool, ‖cubeAverage μ 3 (cubeChoice f g σ)‖ := norm_sum_le _ _
      _ ≤ ∑ σ : (Fin 3 → Bool) → Bool, ∏ ω : Fin 3 → Bool,
          if σ ω then gowersNorm μ 3 f else gowersNorm μ 3 g :=
          Finset.sum_le_sum (fun σ _ => hnorm σ)
      _ = _ := sum_cubeChoice_products _ _
  exact (pow_le_pow_iff_left₀ (gowersNorm_nonneg μ (by norm_num) _ (hf.add hg) hsum)
    (add_nonneg (gowersNorm_nonneg μ (by norm_num) f hf hbf)
      (gowersNorm_nonneg μ (by norm_num) g hg hbg)) (by norm_num : (8 : ℕ) ≠ 0)).mp hp

theorem diagonalCubeIntegrand_const_three {G : Type*} [AddCommGroup G]
    (c : ℂ) (h : Fin 3 → G) (x : G) :
    diagonalCubeIntegrand 3 (fun _ => c) h x = (‖c‖ : ℂ) ^ 8 := by
  calc _ = (c * conj c) ^ 4 := by
        simp only [diagonalCubeIntegrand_succ, diagonalCubeIntegrand_zero,
          map_mul, starRingEnd_self_apply]
        ring
    _ = _ := by rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]; push_cast; ring

theorem cubeAverage_three_const_mul {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    (μ : Measure G) (c : ℂ) (f : G → ℂ) :
    cubeAverage μ 3 (fun _ x => c * f x) = (‖c‖ : ℂ) ^ 8 * cubeAverage μ 3 (fun _ => f) := by
  unfold cubeAverage
  have heq (h : Fin 3 → G) (x : G) : cubeIntegrand (fun _ x => c * f x) h x =
      (‖c‖ : ℂ) ^ 8 * cubeIntegrand (fun _ => f) h x := by
    exact (diagonalCubeIntegrand_mul 3 (fun _ => c) f h x).trans
      (congrArg (fun z => z * diagonalCubeIntegrand 3 f h x)
        (diagonalCubeIntegrand_const_three c h x))
  simp only [heq, integral_const_mul]

/-- Absolute homogeneity of the order-three Haar Gowers seminorm. -/
theorem gowersNorm_three_const_mul {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (c : ℂ) (f : G → ℂ) (hf : Measurable f) {M : ℝ} (hbf : ∀ x, ‖f x‖ ≤ M) :
    gowersNorm μ 3 (fun x => c * f x) = ‖c‖ * gowersNorm μ 3 f := by
  have hm : Measurable (fun x => c * f x) := measurable_const.mul hf
  have hb : ∀ x, ‖c * f x‖ ≤ ‖c‖ * M := fun x => by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hbf x) (norm_nonneg _)
  have hp : gowersNorm μ 3 (fun x => c * f x) ^ 8 = (‖c‖ * gowersNorm μ 3 f) ^ 8 := by
    rw [show 8 = 2 ^ 3 from rfl, gowersNorm_pow μ (by norm_num) _ hm hb,
      mul_pow, gowersNorm_pow μ (by norm_num) _ hf hbf, cubeAverage_three_const_mul]
    simp [← Complex.ofReal_pow, Complex.mul_re]
  exact (pow_left_inj₀ (gowersNorm_nonneg μ (by norm_num) _ hm hb)
    (mul_nonneg (norm_nonneg _) (gowersNorm_nonneg μ (by norm_num) f hf hbf))
    (by norm_num : (8 : ℕ) ≠ 0)).mp hp

theorem gowersNorm_three_zero {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant] :
    gowersNorm μ 3 (fun _ : G => 0) = 0 := by
  simpa only [zero_mul, norm_zero] using
    gowersNorm_three_const_mul μ 0 (fun _ : G => 0) measurable_const (M := 0) (by simp)

/-- The complex vector space of pointwise bounded measurable functions. -/
def boundedMeasurableSubmodule (G : Type*) [MeasurableSpace G] : Submodule ℂ (G → ℂ) where
  carrier := {f | Measurable f ∧ ∃ M : ℝ, ∀ x, ‖f x‖ ≤ M}
  zero_mem' := ⟨measurable_const, 0, by simp⟩
  add_mem' := by
    rintro f g ⟨hf, M, hM⟩ ⟨hg, N, hN⟩
    exact ⟨hf.add hg, M + N, fun x =>
      (norm_add_le _ _).trans (add_le_add (hM x) (hN x))⟩
  smul_mem' := by
    rintro c f ⟨hf, M, hM⟩
    refine ⟨measurable_const.mul hf, ‖c‖ * M, fun x => ?_⟩
    change ‖c * f x‖ ≤ _
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hM x) (norm_nonneg _)

/-- The order-three Gowers seminorm, bundled on bounded measurable functions. -/
noncomputable def gowersThreeSeminorm {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant] :
    Seminorm ℂ (boundedMeasurableSubmodule G) :=
  Seminorm.of (fun f => gowersNorm μ 3 f.1)
    (by
      intro f g
      obtain ⟨M, hM⟩ := f.2.2
      obtain ⟨N, hN⟩ := g.2.2
      exact gowersNorm_three_add_le μ f.1 g.1 f.2.1 g.2.1
        (fun x => (hM x).trans (le_max_left M N))
        (fun x => (hN x).trans (le_max_right M N)))
    (by
      intro c f
      obtain ⟨M, hM⟩ := f.2.2
      exact gowersNorm_three_const_mul μ c f.1 f.2.1 hM)

/-! Independent tetrahedral vertex coordinates for the cube `L²` estimate. -/

def tetrahedronShear {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (j : ℕ) :
    (G × (Fin j → G)) ≃ᵐ (G × (Fin j → G)) where
  toFun p := (p.1, fun i => p.1 + p.2 i)
  invFun p := (p.1, fun i => p.2 i - p.1)
  left_inv p := by ext <;> simp
  right_inv p := by ext <;> simp
  measurable_toFun := measurable_fst.prodMk (Measurable.of_eval (fun i =>
    measurable_fst.add ((measurable_pi_apply i).comp measurable_snd)))
  measurable_invFun := measurable_fst.prodMk (Measurable.of_eval (fun i =>
    ((measurable_pi_apply i).comp measurable_snd).sub measurable_fst))

theorem measurePreserving_tetrahedronShear {G : Type*} [AddCommGroup G]
    [MeasurableSpace G] [MeasurableAdd₂ G] [MeasurableNeg G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant] (j : ℕ) :
    MeasurePreserving (tetrahedronShear (G := G) j)
      (μ.prod (Measure.pi (fun _ : Fin j => μ))) (μ.prod (Measure.pi (fun _ : Fin j => μ))) := by
  change MeasurePreserving (fun p : G × (Fin j → G) => (p.1, fun i => p.1 + p.2 i)) _ _
  apply (MeasurePreserving.id μ).skew_product
    (g := fun (x : G) (h : Fin j → G) (i : Fin j) => x + h i)
  · exact Measurable.of_eval (fun i =>
      measurable_fst.add ((measurable_pi_apply i).comp measurable_snd))
  · filter_upwards [] with x
    exact (measurePreserving_pi (fun _ : Fin j => μ) (fun _ : Fin j => μ)
      (fun _ => measurePreserving_add_left μ x)).map_eq

/-- The base vertex and its three edge neighbors have independent Haar distributions. -/
theorem integral_tetrahedron_product {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] (j : ℕ) (f : G → ℝ) (g : Fin j → G → ℝ) :
    (∫ p : G × (Fin j → G), f p.1 * ∏ i, g i (p.1 + p.2 i)
      ∂μ.prod (Measure.pi (fun _ => μ))) =
        (∫ x, f x ∂μ) * ∏ i, ∫ x, g i x ∂μ := by
  have hs := (measurePreserving_tetrahedronShear μ j).integral_comp'
    (fun p : G × (Fin j → G) => f p.1 * ∏ i, g i (p.2 i))
  change (∫ p : G × (Fin j → G), f p.1 * ∏ i, g i (p.1 + p.2 i)
    ∂μ.prod (Measure.pi (fun _ => μ))) = _ at hs
  rw [hs, integral_prod_mul f (fun h : Fin j → G => ∏ i, g i (h i)),
    integral_fintype_prod_eq_prod]

def cubeOpposite {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (j : ℕ) :
    (G × (Fin j → G)) ≃ᵐ (G × (Fin j → G)) where
  toFun p := (p.1 + ∑ i, p.2 i, fun i => -p.2 i)
  invFun p := (p.1 + ∑ i, p.2 i, fun i => -p.2 i)
  left_inv p := by ext <;> simp
  right_inv p := by ext <;> simp
  measurable_toFun := (measurable_fst.add (Finset.measurable_sum _ (fun i _ =>
    (measurable_pi_apply i).comp measurable_snd))).prodMk
      (Measurable.of_eval (fun i => ((measurable_pi_apply i).comp measurable_snd).neg))
  measurable_invFun := (measurable_fst.add (Finset.measurable_sum _ (fun i _ =>
    (measurable_pi_apply i).comp measurable_snd))).prodMk
      (Measurable.of_eval (fun i => ((measurable_pi_apply i).comp measurable_snd).neg))

theorem measurePreserving_cubeOpposite {G : Type*} [AddCommGroup G]
    [MeasurableSpace G] [MeasurableAdd₂ G] [MeasurableNeg G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant] [μ.IsNegInvariant] (j : ℕ) :
    MeasurePreserving (cubeOpposite (G := G) j)
      (μ.prod (Measure.pi (fun _ : Fin j => μ))) (μ.prod (Measure.pi (fun _ : Fin j => μ))) := by
  let ν := Measure.pi (fun _ : Fin j => μ)
  have hs : MeasurePreserving (fun p : (Fin j → G) × G =>
      (p.1, (∑ i, p.1 i) + p.2)) (ν.prod μ) (ν.prod μ) := by
    apply (MeasurePreserving.id ν).skew_product
      (g := fun (h : Fin j → G) (x : G) => (∑ i, h i) + x)
    · exact (Finset.measurable_sum _ (fun i _ =>
        (measurable_pi_apply i).comp measurable_fst)).add measurable_snd
    · filter_upwards [] with h
      exact (measurePreserving_add_left μ (∑ i, h i)).map_eq
  have hb := (Measure.measurePreserving_swap (μ := ν) (ν := μ)).comp
    (hs.comp (Measure.measurePreserving_swap (μ := μ) (ν := ν)))
  have hn := (MeasurePreserving.id μ).prod
    (measurePreserving_pi (fun _ : Fin j => μ) (fun _ : Fin j => μ)
      (fun _ => Measure.measurePreserving_neg μ))
  convert hn.comp hb using 1
  ext p <;> simp [cubeOpposite, Function.comp_def, add_comm]

/-- The opposite vertex and its three edge neighbors also have independent Haar distributions. -/
theorem integral_opposite_tetrahedron_product {G : Type*} [AddCommGroup G]
    [MeasurableSpace G] [MeasurableAdd₂ G] [MeasurableNeg G]
    (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant] [μ.IsNegInvariant]
    (j : ℕ) (f : G → ℝ) (g : Fin j → G → ℝ) :
    (∫ p : G × (Fin j → G), f (p.1 + ∑ i, p.2 i) *
      ∏ i, g i (p.1 + (∑ k, p.2 k) - p.2 i)
        ∂μ.prod (Measure.pi (fun _ => μ))) =
          (∫ x, f x ∂μ) * ∏ i, ∫ x, g i x ∂μ := by
  have hs := (measurePreserving_cubeOpposite μ j).integral_comp'
    (fun p : G × (Fin j → G) => f p.1 * ∏ i, g i (p.1 + p.2 i))
  change (∫ p : G × (Fin j → G), f (p.1 + ∑ i, p.2 i) *
    ∏ i, g i (p.1 + (∑ k, p.2 k) + -p.2 i) ∂μ.prod (Measure.pi (fun _ => μ))) = _ at hs
  simpa only [← sub_eq_add_neg, integral_tetrahedron_product] using hs

def cubeUnitVertex (i : Fin 3) : Fin 3 → Bool :=
  ![![true, false, false], ![false, true, false], ![false, false, true]] i

def cubeCoUnitVertex (i : Fin 3) : Fin 3 → Bool :=
  ![![false, true, true], ![true, false, true], ![true, true, false]] i

theorem prod_boolCube_succ {R : Type*} [CommMonoid R] (j : ℕ)
    (F : (Fin (j + 1) → Bool) → R) :
    (∏ ω, F ω) = (∏ ω : Fin j → Bool, F (Fin.cons false ω)) *
      ∏ ω : Fin j → Bool, F (Fin.cons true ω) := by
  rw [← (cubeConsEquiv j).prod_comp F, Fintype.prod_prod_type, Fintype.prod_bool]
  simp [cubeConsEquiv, mul_comm]

theorem cube_vertex_product_three {G R : Type*} [AddCommGroup G] [CommRing R]
    (F : (Fin 3 → Bool) → G → R) (h : Fin 3 → G) (x : G) :
    (∏ ω : Fin 3 → Bool, F ω (x + cubeShift h ω)) =
      (F ![false, false, false] x * ∏ i : Fin 3, F (cubeUnitVertex i) (x + h i)) *
        (F ![true, true, true] (x + ∑ i, h i) *
          ∏ i : Fin 3, F (cubeCoUnitVertex i) (x + (∑ k, h k) - h i)) := by
  have hF : F = fun ω y => F ![ω 0, ω 1, ω 2] y := by
    funext ω y
    congr 1
    ext i
    fin_cases i <;> rfl
  conv_lhs => rw [hF]
  simp only [prod_boolCube_succ, Fintype.prod_unique]
  simp [cubeShift, Fin.sum_univ_succ, Fin.prod_univ_succ, cubeUnitVertex, cubeCoUnitVertex,
    add_assoc, add_left_comm, add_comm, sub_eq_add_neg]
  simp only [show (2 : Fin 3) = (1 : Fin 2).succ by decide, Fin.cons_succ,
    show (1 : Fin 2) = (0 : Fin 1).succ by decide, Fin.cons_zero]
  ring

/-- Products of independent `L²` factors remain in `L²` on the product probability space. -/
theorem memLp_tetrahedron_product {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] (j : ℕ) (f : G → ℝ) (g : Fin j → G → ℝ)
    (hf : Measurable f) (hg : ∀ i, Measurable (g i))
    (hfl : MemLp f 2 μ) (hgl : ∀ i, MemLp (g i) 2 μ) :
    MemLp (fun p : G × (Fin j → G) => f p.1 * ∏ i, g i (p.1 + p.2 i)) 2
      (μ.prod (Measure.pi (fun _ => μ))) := by
  have hm : Measurable (fun p : G × (Fin j → G) => f p.1 * ∏ i, g i (p.2 i)) :=
    (hf.comp measurable_fst).mul (Finset.measurable_prod _ (fun i _ =>
      (hg i).comp ((measurable_pi_apply i).comp measurable_snd)))
  have hi := hfl.integrable_sq.mul_prod (Integrable.fintype_prod (fun i => (hgl i).integrable_sq))
  have hl : MemLp (fun p : G × (Fin j → G) => f p.1 * ∏ i, g i (p.2 i)) 2
      (μ.prod (Measure.pi (fun _ => μ))) := by
    apply (memLp_two_iff_integrable_sq hm.aestronglyMeasurable).mpr
    simpa only [mul_pow, ← Finset.prod_pow] using hi
  exact hl.comp_measurePreserving (measurePreserving_tetrahedronShear μ j)

theorem prod_cube_vertices_three {R : Type*} [CommRing R] (F : (Fin 3 → Bool) → R) :
    (∏ ω, F ω) = (F ![false, false, false] * ∏ i : Fin 3, F (cubeUnitVertex i)) *
      (F ![true, true, true] * ∏ i : Fin 3, F (cubeCoUnitVertex i)) := by
  simpa using cube_vertex_product_three (G := ℤ) (fun ω _ => F ω) (fun _ => 0) 0

/-- The full cube integrand is integrable for eight measurable `L²` inputs. -/
theorem cubeIntegrand_three_integrable {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] [μ.IsNegInvariant] (f : (Fin 3 → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) (hfl : ∀ ω, MemLp (f ω) 2 μ) :
    Integrable (fun p : G × (Fin 3 → G) => cubeIntegrand f p.2 p.1)
      (μ.prod (Measure.pi (fun _ => μ))) := by
  let A := fun p : G × (Fin 3 → G) => ‖f ![false, false, false] p.1‖ *
    ∏ i : Fin 3, ‖f (cubeUnitVertex i) (p.1 + p.2 i)‖
  let B := fun p : G × (Fin 3 → G) => ‖f ![true, true, true] (p.1 + ∑ i, p.2 i)‖ *
    ∏ i : Fin 3, ‖f (cubeCoUnitVertex i) (p.1 + (∑ k, p.2 k) - p.2 i)‖
  have hA : MemLp A 2 (μ.prod (Measure.pi (fun _ => μ))) :=
    memLp_tetrahedron_product μ 3 (fun x => ‖f ![false, false, false] x‖)
      (fun i x => ‖f (cubeUnitVertex i) x‖) (hf _).norm (fun i => (hf _).norm)
      (hfl _).norm (fun i => (hfl _).norm)
  have hB : MemLp B 2 (μ.prod (Measure.pi (fun _ => μ))) := by
    have h := (memLp_tetrahedron_product μ 3
      (fun x => ‖f ![true, true, true] x‖) (fun i x => ‖f (cubeCoUnitVertex i) x‖)
      (hf _).norm (fun i => (hf _).norm) (hfl _).norm (fun i => (hfl _).norm))
        |>.comp_measurePreserving
        (measurePreserving_cubeOpposite μ 3)
    simpa only [Function.comp_def, cubeOpposite, MeasurableEquiv.coe_mk, Equiv.coe_fn_mk,
      ← sub_eq_add_neg] using h
  have hp : Integrable (fun p => A p * B p) (μ.prod (Measure.pi (fun _ => μ))) :=
    memLp_one_iff_integrable.mp (hA.fun_mul hB)
  apply hp.mono' ((measurable_cubeIntegrand f hf).comp measurable_swap).aestronglyMeasurable
  filter_upwards [] with p
  change ‖cubeIntegrand f p.2 p.1‖ ≤ A p * B p
  simp only [cubeIntegrand, norm_prod, norm_cubeConj]
  exact le_of_eq (cube_vertex_product_three (fun ω x => ‖f ω x‖) p.2 p.1)

noncomputable def haarL2Norm {G : Type*} [MeasurableSpace G] (μ : Measure G) (f : G → ℂ) : ℝ :=
  Real.sqrt (∫ x, ‖f x‖ ^ 2 ∂μ)

theorem haarL2Norm_sq {G : Type*} [MeasurableSpace G] (μ : Measure G) (f : G → ℂ) :
    haarL2Norm μ f ^ 2 = ∫ x, ‖f x‖ ^ 2 ∂μ :=
  Real.sq_sqrt (integral_nonneg (fun _x => sq_nonneg _))

/-- Blueprint `eq:cube-L2`, in the stronger form valid on any abelian Haar probability
group with measurable inversion: all eight measurable inputs may already lie in `L²`. -/
theorem cubeAverage_three_le_L2 {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] [μ.IsNegInvariant] (f : (Fin 3 → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) (hfl : ∀ ω, MemLp (f ω) 2 μ) :
    ‖cubeAverage μ 3 f‖ ≤ ∏ ω, haarL2Norm μ (f ω) := by
  let ν := μ.prod (Measure.pi (fun _ : Fin 3 => μ))
  let A := fun p : G × (Fin 3 → G) => ‖f ![false, false, false] p.1‖ *
    ∏ i : Fin 3, ‖f (cubeUnitVertex i) (p.1 + p.2 i)‖
  let B := fun p : G × (Fin 3 → G) => ‖f ![true, true, true] (p.1 + ∑ i, p.2 i)‖ *
    ∏ i : Fin 3, ‖f (cubeCoUnitVertex i) (p.1 + (∑ k, p.2 k) - p.2 i)‖
  have hA : MemLp A 2 ν :=
    memLp_tetrahedron_product μ 3 (fun x => ‖f ![false, false, false] x‖)
      (fun i x => ‖f (cubeUnitVertex i) x‖) (hf _).norm (fun i => (hf _).norm)
      (hfl _).norm (fun i => (hfl _).norm)
  have hB : MemLp B 2 ν := by
    have h := (memLp_tetrahedron_product μ 3
      (fun x => ‖f ![true, true, true] x‖) (fun i x => ‖f (cubeCoUnitVertex i) x‖)
      (hf _).norm (fun i => (hf _).norm) (hfl _).norm (fun i => (hfl _).norm))
        |>.comp_measurePreserving
        (measurePreserving_cubeOpposite μ 3)
    simpa only [Function.comp_def, cubeOpposite, MeasurableEquiv.coe_mk, Equiv.coe_fn_mk,
      ← sub_eq_add_neg] using h
  have hAn (p) : 0 ≤ A p := by dsimp [A]; positivity
  have hBn (p) : 0 ≤ B p := by dsimp [B]; positivity
  have hnorm (p : G × (Fin 3 → G)) : ‖cubeIntegrand f p.2 p.1‖ = A p * B p := by
    simp only [cubeIntegrand, norm_prod, norm_cubeConj]
    exact cube_vertex_product_three (fun ω x => ‖f ω x‖) p.2 p.1
  have hcube : cubeAverage μ 3 f = ∫ p, cubeIntegrand f p.2 p.1 ∂ν :=
    (integral_prod_symm _ (cubeIntegrand_three_integrable μ f hf hfl)).symm
  have hholder : (∫ p, A p * B p ∂ν) ≤
      Real.sqrt (∫ p, A p ^ 2 ∂ν) * Real.sqrt (∫ p, B p ^ 2 ∂ν) := by
    have h := integral_mul_norm_le_Lp_mul_Lq
      (show Real.HolderConjugate 2 2 by norm_num [Real.holderConjugate_iff])
      (show MemLp A (ENNReal.ofReal 2) ν by simpa using hA)
      (show MemLp B (ENNReal.ofReal 2) ν by simpa using hB)
    simpa only [Real.norm_of_nonneg (hAn _), Real.norm_of_nonneg (hBn _),
      Real.rpow_two, ← Real.sqrt_eq_rpow] using h
  have hle : ‖cubeAverage μ 3 f‖ ≤
      Real.sqrt (∫ p, A p ^ 2 ∂ν) * Real.sqrt (∫ p, B p ^ 2 ∂ν) := by
    rw [hcube]
    refine (norm_integral_le_integral_norm _).trans ?_
    simpa only [hnorm] using hholder
  have hsq := (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg _)
    (Real.sqrt_nonneg _))).mpr hle
  rw [mul_pow, Real.sq_sqrt (integral_nonneg (fun p => sq_nonneg (A p))),
    Real.sq_sqrt (integral_nonneg (fun p => sq_nonneg (B p)))] at hsq
  have hAi : (∫ p, A p ^ 2 ∂ν) = (∫ x, ‖f ![false, false, false] x‖ ^ 2 ∂μ) *
      ∏ i : Fin 3, ∫ x, ‖f (cubeUnitVertex i) x‖ ^ 2 ∂μ := by
    simp only [A, ν, mul_pow, ← Finset.prod_pow]
    exact integral_tetrahedron_product μ 3 (fun x => ‖f ![false, false, false] x‖ ^ 2)
      (fun i x => ‖f (cubeUnitVertex i) x‖ ^ 2)
  have hBi : (∫ p, B p ^ 2 ∂ν) = (∫ x, ‖f ![true, true, true] x‖ ^ 2 ∂μ) *
      ∏ i : Fin 3, ∫ x, ‖f (cubeCoUnitVertex i) x‖ ^ 2 ∂μ := by
    simp only [B, ν, mul_pow, ← Finset.prod_pow]
    exact integral_opposite_tetrahedron_product μ 3 (fun x => ‖f ![true, true, true] x‖ ^ 2)
      (fun i x => ‖f (cubeCoUnitVertex i) x‖ ^ 2)
  have heq : (∏ ω, haarL2Norm μ (f ω)) ^ 2 =
      (∫ p, A p ^ 2 ∂ν) * (∫ p, B p ^ 2 ∂ν) := by
    rw [← Finset.prod_pow]
    simp only [haarL2Norm_sq]
    rw [prod_cube_vertices_three, hAi, hBi]
  rw [← heq] at hsq
  exact (sq_le_sq₀ (norm_nonneg _) (Finset.prod_nonneg (fun ω _ => Real.sqrt_nonneg _))).mp hsq

theorem measurePreserving_cubeVertex {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) [IsProbabilityMeasure μ] [μ.IsAddLeftInvariant]
    (j : ℕ) (ω : Fin j → Bool) :
    MeasurePreserving (fun p : G × (Fin j → G) => p.1 + cubeShift p.2 ω)
      (μ.prod (Measure.pi (fun _ => μ))) μ := by
  let ν := Measure.pi (fun _ : Fin j => μ)
  have hs := (MeasurePreserving.id ν).skew_product
    (g := fun (h : Fin j → G) (x : G) => cubeShift h ω + x)
    ((measurable_cubeShift ω).comp measurable_fst |>.add measurable_snd)
    (Filter.Eventually.of_forall (fun h =>
      (measurePreserving_add_left μ (cubeShift h ω)).map_eq))
  have hp := (measurePreserving_snd (μ := ν) (ν := μ)).comp
    (hs.comp (Measure.measurePreserving_swap (μ := μ) (ν := ν)))
  simpa only [Function.comp_def, Prod.swap, ν, add_comm] using hp

theorem cubeAverage_three_congr_ae {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] [μ.IsNegInvariant] (f g : (Fin 3 → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) (hg : ∀ ω, Measurable (g ω))
    (hfl : ∀ ω, MemLp (f ω) 2 μ) (hgl : ∀ ω, MemLp (g ω) 2 μ)
    (heq : ∀ ω, f ω =ᵐ[μ] g ω) : cubeAverage μ 3 f = cubeAverage μ 3 g := by
  rw [cubeAverage, cubeAverage, ← integral_prod_symm _
    (cubeIntegrand_three_integrable μ f hf hfl), ← integral_prod_symm _
    (cubeIntegrand_three_integrable μ g hg hgl)]
  apply integral_congr_ae
  have h := fun ω => (measurePreserving_cubeVertex μ 3 ω).quasiMeasurePreserving.ae
    (heq ω)
  filter_upwards [ae_all_iff.mpr h] with p hp
  simp only [cubeIntegrand, hp]

/-- A measurable representative is used only to evaluate integrals; the cube form below
is independent of this choice by `cubeAverage_three_congr_ae`. -/
noncomputable def l2Representative {G : Type*} [MeasurableSpace G] (μ : Measure G)
    (f : Lp ℂ 2 μ) : G → ℂ := (Lp.aestronglyMeasurable f).mk f

theorem l2Representative_measurable {G : Type*} [MeasurableSpace G] (μ : Measure G)
    (f : Lp ℂ 2 μ) : Measurable (l2Representative μ f) :=
  (Lp.aestronglyMeasurable f).stronglyMeasurable_mk.measurable

theorem l2Representative_ae {G : Type*} [MeasurableSpace G] (μ : Measure G)
    (f : Lp ℂ 2 μ) : l2Representative μ f =ᵐ[μ] f :=
  (Lp.aestronglyMeasurable f).ae_eq_mk.symm

theorem l2Representative_memLp {G : Type*} [MeasurableSpace G] (μ : Measure G)
    (f : Lp ℂ 2 μ) : MemLp (l2Representative μ f) 2 μ :=
  (memLp_congr_ae (l2Representative_ae μ f)).mpr (Lp.memLp f)

theorem haarL2Norm_l2Representative {G : Type*} [MeasurableSpace G] (μ : Measure G)
    (f : Lp ℂ 2 μ) : haarL2Norm μ (l2Representative μ f) = ‖f‖ := by
  have hi : (∫ x, ‖f x‖ ^ 2 ∂μ) = ‖f‖ ^ 2 := by
    simpa only [L2.inner_def, real_inner_self_eq_norm_sq] using
      (real_inner_self_eq_norm_sq f)
  have heq : (∫ x, ‖l2Representative μ f x‖ ^ 2 ∂μ) = ∫ x, ‖f x‖ ^ 2 ∂μ := by
    apply integral_congr_ae
    filter_upwards [l2Representative_ae μ f] with x hx
    rw [hx]
  rw [haarL2Norm, heq, hi, Real.sqrt_sq (norm_nonneg _)]

theorem cubeIntegrand_update {G : Type*} [AddCommGroup G] {j : ℕ}
    (f : (Fin j → Bool) → G → ℂ) (ω : Fin j → Bool) (g : G → ℂ)
    (h : Fin j → G) (x : G) :
    cubeIntegrand (Function.update f ω g) h x =
      cubeConj (cubeWeight ω) (g (x + cubeShift h ω)) *
        ∏ v ∈ Finset.univ.erase ω, cubeConj (cubeWeight v) (f v (x + cubeShift h v)) := by
  classical
  rw [cubeIntegrand, ← Finset.mul_prod_erase _ _ (Finset.mem_univ ω)]
  simp only [Function.update_self]
  congr 1
  apply Finset.prod_congr rfl
  intro v hv
  rw [Function.update_of_ne (Finset.mem_erase.mp hv).1]

theorem cubeConj_real_smul (n : ℕ) (r : ℝ) (z : ℂ) :
    cubeConj n (r • z) = r • cubeConj n z := by
  by_cases hn : Even n <;> simp [cubeConj, hn]

theorem cubeIntegrand_update_add {G : Type*} [AddCommGroup G] {j : ℕ}
    (f : (Fin j → Bool) → G → ℂ) (ω : Fin j → Bool) (g k : G → ℂ)
    (h : Fin j → G) (x : G) :
    cubeIntegrand (Function.update f ω (g + k)) h x =
      cubeIntegrand (Function.update f ω g) h x +
      cubeIntegrand (Function.update f ω k) h x := by
  simp only [cubeIntegrand_update, Pi.add_apply, cubeConj_add, add_mul]

theorem cubeIntegrand_update_smul {G : Type*} [AddCommGroup G] {j : ℕ}
    (f : (Fin j → Bool) → G → ℂ) (ω : Fin j → Bool) (r : ℝ) (g : G → ℂ)
    (h : Fin j → G) (x : G) :
    cubeIntegrand (Function.update f ω (r • g)) h x =
      r • cubeIntegrand (Function.update f ω g) h x := by
  simp only [cubeIntegrand_update, Pi.smul_apply, cubeConj_real_smul, smul_mul_assoc]

theorem cubeAverage_three_update_add {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] [μ.IsNegInvariant] (f : (Fin 3 → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) (hfl : ∀ ω, MemLp (f ω) 2 μ)
    (ω : Fin 3 → Bool) (g k : G → ℂ) (hg : Measurable g) (hk : Measurable k)
    (hgl : MemLp g 2 μ) (hkl : MemLp k 2 μ) :
    cubeAverage μ 3 (Function.update f ω (g + k)) =
      cubeAverage μ 3 (Function.update f ω g) + cubeAverage μ 3 (Function.update f ω k) := by
  classical
  have hm (u : G → ℂ) (hu : Measurable u) : ∀ v, Measurable (Function.update f ω u v) := by
    intro v
    by_cases h : v = ω <;> simp [Function.update, h, hu, hf]
  have hl (u : G → ℂ) (hu : MemLp u 2 μ) : ∀ v, MemLp (Function.update f ω u v) 2 μ := by
    intro v
    by_cases h : v = ω <;> simp [Function.update, h, hu, hfl]
  have hi (u : G → ℂ) (hu : Measurable u) (hul : MemLp u 2 μ) :=
    cubeIntegrand_three_integrable μ (Function.update f ω u) (hm u hu) (hl u hul)
  simp only [cubeAverage]
  rw [← integral_prod_symm _ (hi (g + k) (hg.add hk) (hgl.add hkl)),
    ← integral_prod_symm _ (hi g hg hgl), ← integral_prod_symm _ (hi k hk hkl)]
  simp only [cubeIntegrand_update_add]
  exact integral_add (hi g hg hgl) (hi k hk hkl)

theorem cubeAverage_three_update_smul {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] (μ : Measure G) (f : (Fin 3 → Bool) → G → ℂ)
    (ω : Fin 3 → Bool) (r : ℝ) (g : G → ℂ) :
    cubeAverage μ 3 (Function.update f ω (r • g)) =
      r • cubeAverage μ 3 (Function.update f ω g) := by
  simp only [cubeAverage, cubeIntegrand_update_smul, integral_smul]

noncomputable def l2CubeAverage {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    (μ : Measure G) (f : (Fin 3 → Bool) → Lp ℂ 2 μ) : ℂ :=
  cubeAverage μ 3 (fun ω => l2Representative μ (f ω))

theorem l2CubeAverage_update_eq {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] [μ.IsNegInvariant] (f : (Fin 3 → Bool) → Lp ℂ 2 μ)
    (ω : Fin 3 → Bool) (u : Lp ℂ 2 μ) (g : G → ℂ)
    (hg : Measurable g) (hgl : MemLp g 2 μ) (hgu : g =ᵐ[μ] u) :
    l2CubeAverage μ (Function.update f ω u) =
      cubeAverage μ 3 (Function.update (fun v => l2Representative μ (f v)) ω g) := by
  classical
  refine cubeAverage_three_congr_ae μ _ _
    (fun v => l2Representative_measurable μ _) ?_
    (fun v => l2Representative_memLp μ _) ?_ ?_
  · intro v
    by_cases h : v = ω <;> simp [Function.update, h, hg, l2Representative_measurable]
  · intro v
    by_cases h : v = ω <;> simp [Function.update, h, hgl, l2Representative_memLp]
  · intro v
    by_cases h : v = ω
    · subst v
      simpa only [Function.update_self] using (l2Representative_ae μ u).trans hgu.symm
    · simp only [Function.update_of_ne h]
      exact Filter.EventuallyEq.rfl

/-- The cube form is real multilinear: odd vertices conjugate their complex input. -/
noncomputable def l2CubeMultilinear {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] [μ.IsNegInvariant] :
    MultilinearMap ℝ (fun _ : Fin 3 → Bool => Lp ℂ 2 μ) ℂ :=
  MultilinearMap.mk' (l2CubeAverage μ) (by
    intro f ω u v
    rw [l2CubeAverage_update_eq μ f ω (u + v)
      (l2Representative μ u + l2Representative μ v)
      ((l2Representative_measurable μ u).add (l2Representative_measurable μ v))
      ((l2Representative_memLp μ u).add (l2Representative_memLp μ v))
      (((l2Representative_ae μ u).add (l2Representative_ae μ v)).trans
        (Lp.coeFn_add u v).symm)]
    rw [l2CubeAverage_update_eq μ f ω u _ (l2Representative_measurable μ u)
      (l2Representative_memLp μ u) (l2Representative_ae μ u),
      l2CubeAverage_update_eq μ f ω v _ (l2Representative_measurable μ v)
      (l2Representative_memLp μ v) (l2Representative_ae μ v)]
    exact cubeAverage_three_update_add μ _ (fun i => l2Representative_measurable μ _)
      (fun i => l2Representative_memLp μ _) ω _ _
      (l2Representative_measurable μ u) (l2Representative_measurable μ v)
      (l2Representative_memLp μ u) (l2Representative_memLp μ v)) (by
    intro f ω r u
    rw [l2CubeAverage_update_eq μ f ω (r • u) (r • l2Representative μ u)
      ((l2Representative_measurable μ u).const_smul r)
      ((l2Representative_memLp μ u).const_smul r)
      (((l2Representative_ae μ u).const_smul r).trans (Lp.coeFn_smul r u).symm)]
    rw [l2CubeAverage_update_eq μ f ω u _ (l2Representative_measurable μ u)
      (l2Representative_memLp μ u) (l2Representative_ae μ u)]
    exact cubeAverage_three_update_smul μ _ ω r _)

/-- Blueprint `lem:cube-foundation`: the continuous extension to eight `L²` inputs. -/
noncomputable def l2CubeContinuous {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] [μ.IsNegInvariant] :
    ContinuousMultilinearMap ℝ (fun _ : Fin 3 → Bool => Lp ℂ 2 μ) ℂ :=
  (l2CubeMultilinear μ).mkContinuous 1 (fun f => by
    change ‖cubeAverage μ 3 (fun ω => l2Representative μ (f ω))‖ ≤ 1 * ∏ ω, ‖f ω‖
    simpa only [one_mul, haarL2Norm_l2Representative] using
      cubeAverage_three_le_L2 μ (fun ω => l2Representative μ (f ω))
        (fun ω => l2Representative_measurable μ _) (fun ω => l2Representative_memLp μ _))

theorem l2CubeContinuous_toLp {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] [μ.IsNegInvariant] (f : (Fin 3 → Bool) → G → ℂ)
    (hf : ∀ ω, Measurable (f ω)) (hfl : ∀ ω, MemLp (f ω) 2 μ) :
    l2CubeContinuous μ (fun ω => (hfl ω).toLp (f ω)) = cubeAverage μ 3 f := by
  apply cubeAverage_three_congr_ae μ _ f (fun ω => l2Representative_measurable μ _)
    hf (fun ω => l2Representative_memLp μ _) hfl
  intro ω
  exact (l2Representative_ae μ _).trans (MemLp.coeFn_toLp (hfl ω))

theorem l2CubeContinuous_norm_le_one {G : Type*} [AddCommGroup G] [MeasurableSpace G]
    [MeasurableAdd₂ G] [MeasurableNeg G] (μ : Measure G) [IsProbabilityMeasure μ]
    [μ.IsAddLeftInvariant] [μ.IsNegInvariant] : ‖l2CubeContinuous μ‖ ≤ 1 :=
  MultilinearMap.mkContinuous_norm_le _ (by norm_num) _

/-- Specialization to every real torus with normalized Haar measure, in particular
the period-sixteen torus used later in the blueprint. -/
noncomputable def torusCubeContinuous (T : ℝ) [Fact (0 < T)] (d : ℕ) :
    ContinuousMultilinearMap ℝ
      (fun _ : Fin 3 → Bool => Lp ℂ 2
        (Measure.pi (fun _ : Fin d => (AddCircle.haarAddCircle : Measure (AddCircle T))))) ℂ := by
  let μ : Measure (AddCircle T) := AddCircle.haarAddCircle
  letI : (Measure.pi (fun _ : Fin d => μ)).IsNegInvariant :=
    ⟨(measurePreserving_pi (fun _ : Fin d => μ) (fun _ => μ)
      (fun _ => Measure.measurePreserving_neg μ)).map_eq⟩
  exact l2CubeContinuous _

open ClassicalMaximal

/-- The measure-preserving isometry identifying the one-coordinate Euclidean space
with the blueprint's real variable. -/
noncomputable def realLineEquiv : EuclideanSpace ℝ (Fin 1) ≃ₗᵢ[ℝ] ℝ where
  toLinearEquiv := (PiLp.equivOfUnique 2 ℝ (fun _ : Fin 1 => ℝ)).toLinearEquiv
  norm_map' := by
    intro x
    change ‖x 0‖ = ‖x‖
    simp [EuclideanSpace.norm_eq, Real.sqrt_sq_eq_abs]

theorem hlMaximal_realLine_comp {E : Type*} [NormedAddCommGroup E] (f : ℝ → E)
    (x : EuclideanSpace ℝ (Fin 1)) :
    hlMaximal volume (fun y => f (realLineEquiv y)) x =
      hlMaximal volume f (realLineEquiv x) := by
  have he := realLineEquiv.toHomeomorph.measurableEmbedding
  have hmp := realLineEquiv.measurePreserving
  unfold hlMaximal
  congr 1
  funext r
  have hpre : realLineEquiv ⁻¹' Metric.closedBall (realLineEquiv x) r =
      Metric.closedBall x r := by
    ext y
    simp only [Set.mem_preimage, Metric.mem_closedBall, realLineEquiv.isometry.dist_eq]
  simp only [hlBallAverage]
  rw [← hpre, hmp.measure_preimage_emb he,
    hmp.setLIntegral_comp_preimage_emb he (fun y => ‖f y‖ₑ)]

theorem mixedENorm_realLine_comp {Ω : Type*} [MeasurableSpace Ω]
    (ν : Measure Ω) (p s : ℝ) (u : ℝ × Ω → ℝ≥0∞) :
    mixedENorm volume ν p s (fun z => u (realLineEquiv z.1, z.2)) =
      mixedENorm volume ν p s u := by
  unfold mixedENorm
  congr 1
  have hmp : MeasurePreserving realLineEquiv
      (volume : Measure (EuclideanSpace ℝ (Fin 1))) volume := realLineEquiv.measurePreserving
  exact hmp.lintegral_comp_emb realLineEquiv.toHomeomorph.measurableEmbedding
    (fun x : ℝ => (∫⁻ ω, u (x, ω) ^ s ∂ν) ^ (p / s))

noncomputable def realMixedMaximal {Ω E : Type*} [NormedAddCommGroup E]
    (f : ℝ × Ω → E) (z : ℝ × Ω) : ℝ≥0∞ :=
  hlMaximal volume (fun y => f (y, z.2)) z.1

theorem feffermanStein_real {Ω E : Type*} [MeasurableSpace Ω]
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    (ν : Measure Ω) [IsFiniteMeasure ν] {p s : ℝ} (hp : 1 < p) (hs : 1 < s)
    {f : ℝ × Ω → E} (hf : Measurable f) :
    mixedENorm volume ν p s (realMixedMaximal f) ≤
      fsMixedConst 1 p s * mixedENorm volume ν p s (fun z => ‖f z‖ₑ) := by
  let g : EuclideanSpace ℝ (Fin 1) × Ω → E := fun z => f (realLineEquiv z.1, z.2)
  have hg : Measurable g := hf.comp
    ((realLineEquiv.continuous.measurable.comp measurable_fst).prodMk measurable_snd)
  have h := feffermanStein_mixed ν hp hs hg
  have hM : mixedMaximal g = fun z => realMixedMaximal f (realLineEquiv z.1, z.2) := by
    funext z
    exact hlMaximal_realLine_comp (fun y => f (y, z.2)) z.1
  rw [hM, mixedENorm_realLine_comp] at h
  simpa only [g, mixedENorm_realLine_comp ν p s (fun z => ‖f z‖ₑ)] using h

/-- The centered powered maximal function, used to prove the uncentered source estimate. -/
noncomputable def centeredMaximalQ {Ω : Type*} (q : ℝ) (f : ℝ × Ω → ℂ) (z : ℝ × Ω) : ℝ≥0∞ :=
  realMixedMaximal (fun z => ‖f z‖ ^ q) z ^ (1 / q)

theorem centeredMaximalQ_mixedNorm {Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω)
    [IsFiniteMeasure ν] {p q : ℝ} (hq2 : 2 < q) (hq3 : q < 3) (hpq : q < p)
    (f : ℝ × Ω → ℂ) (hf : Measurable f) :
    mixedENorm volume ν p 4 (centeredMaximalQ q f) ≤
      fsMixedConst 1 (p / q) (4 / q) ^ (1 / q) *
        mixedENorm volume ν p 4 (fun z => ‖f z‖ₑ) := by
  have hq0 : 0 < q := by linarith
  have hp0 : 0 < p := by linarith
  have hpr : 1 < p / q := (lt_div_iff₀ hq0).mpr (by simpa)
  have hsr : 1 < 4 / q := (lt_div_iff₀ hq0).mpr (by linarith)
  let g : ℝ × Ω → ℝ := fun z => ‖f z‖ ^ q
  have hg : Measurable g := hf.norm.pow_const q
  have h := feffermanStein_real ν hpr hsr hg
  have hgn (z) : ‖g z‖ₑ = ‖f z‖ₑ ^ q := by
    rw [Real.enorm_eq_ofReal (Real.rpow_nonneg (norm_nonneg _) _),
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq0.le, ofReal_norm]
  have hMq : (fun z => centeredMaximalQ q f z ^ q) = realMixedMaximal g := by
    funext z
    simp only [centeredMaximalQ, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one]
    rfl
  have hscale := mixedENorm_rpow_scale volume ν hp0 (by norm_num : (0 : ℝ) < 4)
    hq0 (centeredMaximalQ q f)
  rw [hMq] at hscale
  simp only [hgn] at h
  rw [hscale, mixedENorm_rpow_scale volume ν hp0 (by norm_num : (0 : ℝ) < 4)
    hq0 (fun z => ‖f z‖ₑ)] at h
  have hfinal := ENNReal.rpow_le_rpow h (one_div_pos.mpr hq0).le
  rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one,
    ENNReal.mul_rpow_of_nonneg _ _ (one_div_pos.mpr hq0).le,
    ← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one] at hfinal
  exact hfinal

/-- Centered prerequisite for blueprint `lem:vector-maximal`: for `2 < q < 3` and `p > q`,
`M_q` is bounded on `L^p(ℝ; L^4(Ω))`, uniformly over finite inner measure spaces. -/
theorem centeredOneMixedNorm (p q : ℝ) (hq2 : 2 < q) (hq3 : q < 3) (hpq : q < p) :
    ∃ C : NNReal, ∀ {Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω) [IsFiniteMeasure ν]
      (f : ℝ × Ω → ℂ), Measurable f →
        mixedENorm volume ν p 4 (centeredMaximalQ q f) ≤
          C * mixedENorm volume ν p 4 (fun z => ‖f z‖ₑ) := by
  have hq0 : 0 < q := by linarith
  have hpr : 1 < p / q := (lt_div_iff₀ hq0).mpr (by simpa)
  have hsr : 1 < 4 / q := (lt_div_iff₀ hq0).mpr (by linarith)
  let C := fsMixedConst 1 (p / q) (4 / q) ^ (1 / q)
  have hC : C ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by positivity)
    (fsMixedConst_ne_top 1 hpr hsr)
  refine ⟨C.toNNReal, ?_⟩
  intro Ω _ ν _ f hf
  rw [ENNReal.coe_toNNReal hC]
  exact centeredMaximalQ_mixedNorm ν hq2 hq3 hpq f hf

/-- The reduced-basis estimates imply a uniform bound on each coefficient
weighted by its basis-vector length; used in blueprint `lem:lattice-box`. -/
theorem reducedBasis_weighted_coordinate_bound {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) (i : Fin n) (x : E) :
    ‖b i‖ * |b.repr x i| ≤ (8 : ℝ) ^ n * ‖x‖ := by
  calc
    _ ≤ ((2 : ℝ) ^ n * ‖InnerProductSpace.gramSchmidt ℝ b i‖) * |b.repr x i| :=
      mul_le_mul_of_nonneg_right (reducedBasis_primal_prefix_bound b hb hr le_rfl)
        (abs_nonneg _)
    _ = (2 : ℝ) ^ n * (‖InnerProductSpace.gramSchmidt ℝ b i‖ * |b.repr x i|) := by ring
    _ ≤ (2 : ℝ) ^ n * ((4 : ℝ) ^ n * ‖x‖) :=
      mul_le_mul_of_nonneg_left (reducedBasis_coordinate_bound b hb hr i x) (by positivity)
    _ = (8 : ℝ) ^ n * ‖x‖ := by rw [← mul_assoc, ← mul_pow]; norm_num

/-- The printed floored side length; zero lengths will be discarded. -/
noncomputable def latticeBoxSideLength {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (i : Fin n) : ℤ :=
  ⌊(4 * (n : ℝ) * ‖b i‖)⁻¹⌋

/-- The part of the lattice basis retained in the coefficient box. -/
noncomputable def latticeBoxIndices {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) : Finset (Fin n) :=
  Finset.univ.filter (fun i => 0 < latticeBoxSideLength b i)

/-- An integer coefficient box on the selected part of a basis. -/
def integerCoefficientBox {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (I : Finset (Fin n)) (L : Fin n → ℤ) : Set E :=
  {x | ∃ z : Fin n → ℤ, (∀ i ∉ I, z i = 0) ∧
    (∀ i ∈ I, |z i| ≤ L i) ∧ ∑ i, z i • b i = x}

theorem latticeBoxSideLength_nonneg {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (i : Fin n) :
    0 ≤ latticeBoxSideLength b i := Int.floor_nonneg.mpr (by positivity)

theorem latticeBoxSideLength_pos {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) {i : Fin n}
    (hi : i ∈ latticeBoxIndices b) : 1 ≤ latticeBoxSideLength b i := by
  have h : 0 < latticeBoxSideLength b i := (Finset.mem_filter.mp hi).2
  omega

theorem latticeBoxSideLength_zero {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) {i : Fin n}
    (hi : i ∉ latticeBoxIndices b) : latticeBoxSideLength b i = 0 := by
  have h : ¬0 < latticeBoxSideLength b i := by simpa [latticeBoxIndices] using hi
  exact le_antisymm (le_of_not_gt h) (latticeBoxSideLength_nonneg b i)

theorem latticeBoxSideLength_weight_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (hn : 0 < n) (b : Module.Basis (Fin n) ℝ E) (i : Fin n) :
    (latticeBoxSideLength b i : ℝ) * ‖b i‖ ≤ (4 * (n : ℝ))⁻¹ := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hb : ‖b i‖ ≠ 0 := norm_ne_zero_iff.mpr (b.ne_zero i)
  calc
    _ ≤ (4 * (n : ℝ) * ‖b i‖)⁻¹ * ‖b i‖ :=
      mul_le_mul_of_nonneg_right (Int.floor_le _) (norm_nonneg _)
    _ = _ := by field_simp

/-- Blueprint `lem:lattice-box`, line 336: the total length budget is `1/4`. -/
theorem latticeBoxSideLength_sum_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (hn : 0 < n) (b : Module.Basis (Fin n) ℝ E) :
    ∑ i, (latticeBoxSideLength b i : ℝ) * ‖b i‖ ≤ (1 / 4 : ℝ) := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  calc
    _ ≤ ∑ _i : Fin n, (4 * (n : ℝ))⁻¹ :=
      Finset.sum_le_sum fun i _ => latticeBoxSideLength_weight_le hn b i
    _ = (1 / 4 : ℝ) := by simp; field_simp

/-- The explicit radius `(100d)^(-10d)` from blueprint `lem:lattice-box`. -/
noncomputable def latticeBoxRadius (n : ℕ) : ℝ := ((100 * (n : ℝ)) ^ (10 * n))⁻¹

theorem latticeBoxRadius_pos {n : ℕ} (hn : 0 < n) : 0 < latticeBoxRadius n := by
  unfold latticeBoxRadius
  have : (0 : ℝ) < n := by exact_mod_cast hn
  positivity

theorem latticeBoxRadius_scaled_le {n : ℕ} (hn : 0 < n) :
    (4 * (n : ℝ) * (8 : ℝ) ^ n) * latticeBoxRadius n ≤ 1 := by
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hbase : (1 : ℝ) ≤ 100 * n := by linarith
  have hbound : (4 * (n : ℝ)) * (8 : ℝ) ^ n ≤ (100 * (n : ℝ)) ^ (10 * n) := by
    calc
      _ ≤ (100 * (n : ℝ)) * (100 * (n : ℝ)) ^ n :=
        mul_le_mul (by linarith) (pow_le_pow_left₀ (by norm_num) (by linarith) n)
          (by positivity) (by positivity)
      _ = (100 * (n : ℝ)) ^ (n + 1) := by rw [pow_succ]; ring
      _ ≤ _ := pow_le_pow_right₀ hbase (by omega)
  rw [latticeBoxRadius, ← div_eq_mul_inv]
  exact (div_le_one (by positivity)).mpr hbound

/-- Integer coordinates in a real basis of its integer span. -/
theorem exists_integer_basis_coordinates {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) {v : E}
    (hv : v ∈ Submodule.span ℤ (Set.range b)) :
    ∃ z : Fin n → ℤ, (∀ i, (z i : ℝ) = b.repr v i) ∧ ∑ i, z i • b i = v := by
  have hcoord : ∀ i, ∃ z : ℤ, (z : ℝ) = b.repr v i :=
    (b.mem_span_iff_repr_mem ℤ v).mp hv
  choose z hz using hcoord
  refine ⟨z, hz, ?_⟩
  calc
    _ = ∑ i, b.repr v i • b i := by
      apply Finset.sum_congr rfl
      intro i _
      rw [← hz i, Int.cast_smul_eq_zsmul ℝ]
    _ = v := b.sum_repr v

/-- Blueprint `lem:lattice-box`, lines 337–342: every lattice vector with
norm at most the explicit radius belongs to the selected coefficient box. -/
theorem small_lattice_vector_mem_coefficientBox {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ} (hn : 0 < n)
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) {v : E} (hv : v ∈ Submodule.span ℤ (Set.range b))
    (hnorm : ‖v‖ ≤ latticeBoxRadius n) :
    v ∈ integerCoefficientBox b (latticeBoxIndices b) (latticeBoxSideLength b) := by
  obtain ⟨z, hz, hsum⟩ := exists_integer_basis_coordinates b hv
  have hn' : (0 : ℝ) < n := by exact_mod_cast hn
  have hcoeff (i : Fin n) : |z i| ≤ latticeBoxSideLength b i := by
    apply Int.le_floor.mpr
    rw [Int.cast_abs]
    rw [← one_div]
    have hbi : 0 < ‖b i‖ := norm_pos_iff.mpr (b.ne_zero i)
    apply (le_div_iff₀ (by positivity)).mpr
    calc
      _ = (4 * (n : ℝ)) * (‖b i‖ * |b.repr v i|) := by rw [hz i]; ring
      _ ≤ (4 * (n : ℝ)) * ((8 : ℝ) ^ n * ‖v‖) :=
        mul_le_mul_of_nonneg_left (reducedBasis_weighted_coordinate_bound b hb hr i v)
          (by positivity)
      _ ≤ (4 * (n : ℝ)) * ((8 : ℝ) ^ n * latticeBoxRadius n) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hnorm (by positivity)) (by positivity)
      _ = (4 * (n : ℝ) * (8 : ℝ) ^ n) * latticeBoxRadius n := by ring
      _ ≤ 1 := latticeBoxRadius_scaled_le hn
  refine ⟨z, ?_, fun i _ => hcoeff i, hsum⟩
  intro i hi
  exact abs_nonpos_iff.mp (by simpa only [latticeBoxSideLength_zero b hi] using hcoeff i)

/-- Every partial coordinate sum in the selected coefficient box has norm
at most `1/4`, as required in blueprint `lem:lattice-box`. -/
theorem coefficientBox_partial_sum_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (hn : 0 < n) (b : Module.Basis (Fin n) ℝ E)
    (z : Fin n → ℤ) (hz : ∀ i ∉ latticeBoxIndices b, z i = 0)
    (hbound : ∀ i ∈ latticeBoxIndices b, |z i| ≤ latticeBoxSideLength b i)
    (s : Finset (Fin n)) : ‖∑ i ∈ s, z i • b i‖ ≤ (1 / 4 : ℝ) := by
  have hcoeff (i : Fin n) : |z i| ≤ latticeBoxSideLength b i := by
    by_cases hi : i ∈ latticeBoxIndices b
    · exact hbound i hi
    · rw [hz i hi, abs_zero]
      exact latticeBoxSideLength_nonneg b i
  calc
    _ ≤ ∑ i ∈ s, |(z i : ℝ)| * ‖b i‖ := by
      simpa only [norm_zsmul ℝ, Real.norm_eq_abs] using norm_sum_le s (fun i => z i • b i)
    _ ≤ ∑ i ∈ s, (latticeBoxSideLength b i : ℝ) * ‖b i‖ := by
      apply Finset.sum_le_sum
      intro i _
      apply mul_le_mul_of_nonneg_right _ (norm_nonneg _)
      exact_mod_cast hcoeff i
    _ ≤ ∑ i, (latticeBoxSideLength b i : ℝ) * ‖b i‖ :=
      Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ s) (fun i _ _ =>
        mul_nonneg (by exact_mod_cast latticeBoxSideLength_nonneg b i) (norm_nonneg _))
    _ ≤ (1 / 4 : ℝ) := latticeBoxSideLength_sum_le hn b

theorem coefficientBox_subset_quarter_ball {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (hn : 0 < n) (b : Module.Basis (Fin n) ℝ E) :
    integerCoefficientBox b (latticeBoxIndices b) (latticeBoxSideLength b) ⊆
      Metric.closedBall (0 : E) (1 / 4) := by
  rintro x ⟨z, hz, hbound, rfl⟩
  rw [Metric.mem_closedBall, dist_zero_right]
  exact coefficientBox_partial_sum_le hn b z hz hbound Finset.univ

theorem integerCoefficientBox_empty {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (L : Fin n → ℤ) :
    integerCoefficientBox b ∅ L = {0} := by
  ext x
  constructor
  · rintro ⟨z, hz, _, hsum⟩
    have hzero : z = 0 := funext fun i => hz i (Finset.notMem_empty i)
    simpa only [hzero, Pi.zero_apply, zero_smul, Finset.sum_const_zero,
      Set.mem_singleton_iff] using hsum.symm
  · intro hx
    have hx0 : x = 0 := Set.mem_singleton_iff.mp hx
    subst x
    exact ⟨0, by simp, by simp, by simp⟩

/-- Blueprint `lem:lattice-box`, complete statement: a part of a lattice
basis with positive integer side lengths contains the closed radius
`(100d)^(-10d)` lattice ball and lies in the closed radius `1/4` ball;
every partial coordinate sum satisfies the same outer bound. -/
theorem smallBallCoefficientBox {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ} (hn : 0 < n)
    (b : Module.Basis (Fin n) ℝ E) :
    ∃ (c : Module.Basis (Fin n) ℝ E) (I : Finset (Fin n)) (L : Fin n → ℤ),
      Submodule.span ℤ (Set.range c) = Submodule.span ℤ (Set.range b) ∧
      (∀ i ∈ I, 1 ≤ L i) ∧
      (Metric.closedBall (0 : E) (latticeBoxRadius n) ∩
        (Submodule.span ℤ (Set.range b) : Set E) ⊆ integerCoefficientBox c I L) ∧
      (integerCoefficientBox c I L ⊆ Metric.closedBall 0 (1 / 4)) ∧
      ∀ z : Fin n → ℤ, (∀ i ∉ I, z i = 0) → (∀ i ∈ I, |z i| ≤ L i) →
        ∀ s : Finset (Fin n), ‖∑ i ∈ s, z i • c i‖ ≤ (1 / 4 : ℝ) := by
  obtain ⟨c, hc, hshort, hred⟩ := exists_reducedShortestProjectionBasis b
  refine ⟨c, latticeBoxIndices c, latticeBoxSideLength c, hc,
    fun _ hi => latticeBoxSideLength_pos c hi, ?_,
    coefficientBox_subset_quarter_ball hn c, coefficientBox_partial_sum_le hn c⟩
  intro v hv
  apply small_lattice_vector_mem_coefficientBox hn c hshort hred
  · rw [hc]
    exact hv.2
  · simpa only [Metric.mem_closedBall, dist_zero_right] using hv.1

/-- The coefficient-box theorem for an arbitrary full lattice in positive dimension. -/
theorem smallBallCoefficientBox_fullLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (L : Submodule ℤ E)
    [DiscreteTopology L] [IsZLattice ℝ L] (hd : 0 < Module.finrank ℝ E) :
    ∃ (b : Module.Basis (Fin (Module.finrank ℝ E)) ℝ E)
      (I : Finset (Fin (Module.finrank ℝ E))) (a : Fin (Module.finrank ℝ E) → ℤ),
      Submodule.span ℤ (Set.range b) = L ∧ (∀ i ∈ I, 1 ≤ a i) ∧
      (Metric.closedBall (0 : E) (latticeBoxRadius (Module.finrank ℝ E)) ∩
        (L : Set E) ⊆ integerCoefficientBox b I a) ∧
      (integerCoefficientBox b I a ⊆ Metric.closedBall 0 (1 / 4)) ∧
      ∀ z : Fin (Module.finrank ℝ E) → ℤ, (∀ i ∉ I, z i = 0) → (∀ i ∈ I, |z i| ≤ a i) →
        ∀ s : Finset (Fin (Module.finrank ℝ E)), ‖∑ i ∈ s, z i • b i‖ ≤ (1 / 4 : ℝ) := by
  let := ZLattice.module_finite ℝ L
  let := ZLattice.module_free ℝ L
  let b := ((Module.finBasis ℤ L).ofZLatticeBasis ℝ L).reindex (finCongr (ZLattice.rank ℝ L))
  have hb : Submodule.span ℤ (Set.range b) = L := by
    rw [Module.Basis.range_reindex, Module.Basis.ofZLatticeBasis_span]
  simpa only [hb] using smallBallCoefficientBox hd b

/-- The standard real torus used in blueprint `lem:torus-annihilator`. -/
abbrev StandardTorus (d : ℕ) := Fin d → AddCircle (1 : ℝ)

/-- Evaluation of an integer frequency at a torus point, before exponentiation. -/
noncomputable def torusEvaluation {d : ℕ} (x : StandardTorus d) :
    (Fin d → ℤ) →ₗ[ℤ] AddCircle (1 : ℝ) := (Pi.basisFun ℤ (Fin d)).constr ℤ x

noncomputable def torusPairing {d : ℕ} (n : Fin d → ℤ) (x : StandardTorus d) :
    AddCircle (1 : ℝ) := torusEvaluation x n

theorem torusPairing_eq_sum {d : ℕ} (n : Fin d → ℤ) (x : StandardTorus d) :
    torusPairing n x = ∑ i, n i • x i := by
  simp [torusPairing, torusEvaluation, Module.Basis.constr_apply_fintype]

noncomputable def torusPairingMap {d : ℕ} (n : Fin d → ℤ) :
    StandardTorus d →ₗ[ℤ] AddCircle (1 : ℝ) where
  toFun := torusPairing n
  map_add' x y := by simp [torusPairing, torusEvaluation]
  map_smul' r x := by simp [torusPairing, torusEvaluation]

theorem continuous_torusPairing {d : ℕ} (n : Fin d → ℤ) : Continuous (torusPairing n) := by
  have h : torusPairing n = fun x => ∑ i, n i • x i := funext (torusPairing_eq_sum n)
  rw [h]
  exact continuous_finsetSum _ (fun i _ => (continuous_apply i).zsmul (n i))

/-- The subgroup annihilating all frequencies in an integer submodule. -/
noncomputable def torusAnnihilator {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    Submodule ℤ (StandardTorus d) := ⨅ n : L, (torusPairingMap (n : Fin d → ℤ)).ker

theorem mem_torusAnnihilator {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) (x : StandardTorus d) :
    x ∈ torusAnnihilator L ↔ ∀ n ∈ L, torusPairing n x = 0 := by
  simp only [torusAnnihilator, Submodule.mem_iInf, LinearMap.mem_ker]
  change (∀ n : L, torusPairing n x = 0) ↔ _
  exact ⟨fun h n hn => h ⟨n, hn⟩, fun h n => h n n.property⟩

/-- An integer basis acts on the torus by evaluating its basis frequencies. -/
noncomputable def torusBasisEquiv {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ)) :
    StandardTorus d ≃ₗ[ℤ] StandardTorus d :=
  ((Pi.basisFun ℤ (Fin d)).constr ℤ).trans (b.constr ℤ).symm

theorem torusBasisEquiv_apply {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (x : StandardTorus d) (i : Fin d) : torusBasisEquiv b x i = torusPairing (b i) x := rfl

theorem torusBasisEquiv_symm_apply {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (x : StandardTorus d) (i : Fin d) :
    (torusBasisEquiv b).symm x i = ∑ j, b.repr (Pi.basisFun ℤ (Fin d) i) j • x j := by
  change (b.constr ℤ x) (Pi.basisFun ℤ (Fin d) i) = _
  exact b.constr_apply_fintype ℤ x _

theorem continuous_torusBasisEquiv {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ)) :
    Continuous (torusBasisEquiv b) := by
  apply continuous_pi
  intro i
  simpa only [torusBasisEquiv_apply] using continuous_torusPairing (b i)

theorem continuous_torusBasisEquiv_symm {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ)) :
    Continuous (torusBasisEquiv b).symm := by
  apply continuous_pi
  intro i
  simp only [torusBasisEquiv_symm_apply]
  exact continuous_finsetSum _ (fun j _ => (continuous_apply j).zsmul _)

noncomputable def torusBasisHomeomorph {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ)) :
    StandardTorus d ≃ₜ StandardTorus d where
  toEquiv := (torusBasisEquiv b).toEquiv
  continuous_toFun := continuous_torusBasisEquiv b
  continuous_invFun := continuous_torusBasisEquiv_symm b

/-- Blueprint `lem:torus-annihilator`, line 358: an adapted integer basis
turns annihilation by its first basis vectors into zero coordinate conditions. -/
theorem torusAnnihilator_basis_coordinates {d r : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (hb : Submodule.span ℤ (b '' {i | i.val < r}) = L) (x : StandardTorus d) :
    x ∈ torusAnnihilator L ↔ ∀ i : Fin d, i.val < r → torusBasisEquiv b x i = 0 := by
  rw [mem_torusAnnihilator]
  constructor
  · intro h i hi
    rw [torusBasisEquiv_apply]
    apply h
    rw [← hb]
    exact Submodule.subset_span ⟨i, hi, rfl⟩
  · intro h n hn
    have hker : L ≤ (torusEvaluation x).ker := by
      rw [← hb]
      apply Submodule.span_le.mpr
      rintro _ ⟨i, hi, rfl⟩
      exact h i hi
    exact hker hn

theorem rationalAnnihilator_coordinates {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) :
    ∃ r ≤ d, ∃ b : Module.Basis (Fin d) ℤ (Fin d → ℤ), ∀ x : StandardTorus d,
      x ∈ torusAnnihilator (rationalIntegerIntersection V) ↔
        ∀ i : Fin d, i.val < r → torusBasisEquiv b x i = 0 := by
  obtain ⟨r, hr, b, hb⟩ := saturatedAdaptedBasis (rationalIntegerIntersection V)
    (rationalIntegerIntersection_saturated V)
  exact ⟨r, hr, b, torusAnnihilator_basis_coordinates _ b hb⟩

/-- The coordinate torus with its first `r` coordinates equal to zero. -/
def coordinateTorus (d r : ℕ) : Submodule ℤ (StandardTorus d) where
  carrier := {x | ∀ i : Fin d, i.val < r → x i = 0}
  zero_mem' := by simp
  add_mem' hx hy i hi := by simp [hx i hi, hy i hi]
  smul_mem' a x hx i hi := by simp [hx i hi]

noncomputable def coordinateTorusTailEquiv (d r : ℕ) :
    coordinateTorus d r ≃ₗ[ℤ] ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ)) where
  toFun x i := x.val i.val
  invFun y := ⟨fun i => if h : r ≤ i.val then y ⟨i, h⟩ else 0, by
    intro i hi
    exact dite_eq_right (by omega)⟩
  left_inv x := by
    apply Subtype.ext
    funext i
    change (if h : r ≤ i.val then x.val (⟨i, h⟩ : {i : Fin d // r ≤ i.val}).val else 0) = x.val i
    by_cases hi : r ≤ i.val
    · simp only [dite_eq_left hi]
    · rw [dite_eq_right hi]
      exact (x.property i (by omega)).symm
  right_inv y := by
    funext i
    exact dite_eq_left i.property
  map_add' x y := rfl
  map_smul' a x := rfl

theorem continuous_coordinateTorusTailEquiv (d r : ℕ) :
    Continuous (coordinateTorusTailEquiv d r) := by
  exact continuous_pi fun i => (continuous_apply i.val).comp continuous_subtype_val

theorem continuous_coordinateTorusTailEquiv_symm (d r : ℕ) :
    Continuous (coordinateTorusTailEquiv d r).symm := by
  apply Continuous.subtype_mk
  apply continuous_pi
  intro i
  change Continuous (fun y : {i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ) =>
    if h : r ≤ i.val then y ⟨i, h⟩ else 0)
  by_cases hi : r ≤ i.val
  · simpa only [dite_eq_left hi] using continuous_apply (⟨i, hi⟩ : {i : Fin d // r ≤ i.val})
  · simpa only [dite_eq_right hi] using
      (continuous_const : Continuous (fun _ : {i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ) =>
        (0 : AddCircle (1 : ℝ))))

noncomputable def coordinateTorusTailHomeomorph (d r : ℕ) :
    coordinateTorus d r ≃ₜ ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ)) where
  toEquiv := (coordinateTorusTailEquiv d r).toEquiv
  continuous_toFun := continuous_coordinateTorusTailEquiv d r
  continuous_invFun := continuous_coordinateTorusTailEquiv_symm d r

noncomputable def torusAnnihilatorCoordinateEquiv {d r : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (hb : Submodule.span ℤ (b '' {i | i.val < r}) = L) :
    torusAnnihilator L ≃ₗ[ℤ] coordinateTorus d r where
  toFun x := ⟨torusBasisEquiv b x, (torusAnnihilator_basis_coordinates L b hb x).mp x.property⟩
  invFun y := ⟨(torusBasisEquiv b).symm y,
    (torusAnnihilator_basis_coordinates L b hb _).mpr (by
      have hy : ∀ i : Fin d, i.val < r → (y : StandardTorus d) i = 0 := y.property
      simpa only [LinearEquiv.apply_symm_apply] using hy)⟩
  left_inv x := Subtype.ext ((torusBasisEquiv b).symm_apply_apply x)
  right_inv y := Subtype.ext ((torusBasisEquiv b).apply_symm_apply y)
  map_add' x y := Subtype.ext ((torusBasisEquiv b).map_add x y)
  map_smul' a x := Subtype.ext ((torusBasisEquiv b).map_smul a x)

noncomputable def torusAnnihilatorCoordinateHomeomorph {d r : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (hb : Submodule.span ℤ (b '' {i | i.val < r}) = L) :
    torusAnnihilator L ≃ₜ coordinateTorus d r where
  toEquiv := (torusAnnihilatorCoordinateEquiv L b hb).toEquiv
  continuous_toFun := ((continuous_torusBasisEquiv b).comp continuous_subtype_val).subtype_mk _
  continuous_invFun :=
    ((continuous_torusBasisEquiv_symm b).comp continuous_subtype_val).subtype_mk _

/-- Blueprint `lem:torus-annihilator`: every saturated annihilator is
isomorphic and homeomorphic to a finite product of circles. -/
theorem saturatedAnnihilator_is_torus {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) : ∃ r ≤ d,
      Nonempty (torusAnnihilator L ≃ₗ[ℤ] ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ))) ∧
      Nonempty (torusAnnihilator L ≃ₜ ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ))) := by
  obtain ⟨r, hr, b, hb⟩ := saturatedAdaptedBasis L hL
  exact ⟨r, hr,
    ⟨(torusAnnihilatorCoordinateEquiv L b hb).trans (coordinateTorusTailEquiv d r)⟩,
    ⟨(torusAnnihilatorCoordinateHomeomorph L b hb).trans (coordinateTorusTailHomeomorph d r)⟩⟩

theorem saturatedAnnihilator_connected {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) : ConnectedSpace (torusAnnihilator L) := by
  obtain ⟨r, _, _, ⟨e⟩⟩ := saturatedAnnihilator_is_torus L hL
  exact e.symm.surjective.connectedSpace e.symm.continuous

theorem rationalAnnihilator_connected {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) :
    ConnectedSpace (torusAnnihilator (rationalIntegerIntersection V)) :=
  saturatedAnnihilator_connected _ (rationalIntegerIntersection_saturated V)

theorem torusAnnihilator_isClosed {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    IsClosed (torusAnnihilator L : Set (StandardTorus d)) := by
  have heq : (torusAnnihilator L : Set (StandardTorus d)) =
      ⋂ n : L, {x | torusPairing (n : Fin d → ℤ) x = 0} := by
    ext x
    simp only [SetLike.mem_coe, mem_torusAnnihilator, Set.mem_iInter,
      Set.mem_ofPred_eq, Subtype.forall]
  rw [heq]
  apply isClosed_iInter
  intro n
  exact isClosed_eq (continuous_torusPairing (n : Fin d → ℤ))
    (continuous_const : Continuous (fun _ : StandardTorus d => (0 : AddCircle (1 : ℝ))))

instance torusAnnihilator_compactSpace {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    CompactSpace (torusAnnihilator L) :=
  isCompact_iff_compactSpace.mp (torusAnnihilator_isClosed L).isCompact

/-- Haar probability on the compact annihilator subgroup. -/
noncomputable def torusAnnihilatorHaar {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    MeasureTheory.Measure (torusAnnihilator L) :=
  MeasureTheory.Measure.addHaarMeasure
    (⟨⟨Set.univ, isCompact_univ⟩, by simp⟩ : TopologicalSpace.PositiveCompacts (torusAnnihilator L))

instance torusAnnihilatorHaar_isAddHaar {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    (torusAnnihilatorHaar L).IsAddHaarMeasure := by
  unfold torusAnnihilatorHaar
  infer_instance

instance torusAnnihilatorHaar_probability {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) :
    MeasureTheory.IsProbabilityMeasure (torusAnnihilatorHaar L) := by
  constructor
  exact MeasureTheory.Measure.addHaarMeasure_self

/-- The character `exp(2πi n·x)` on the standard torus. -/
noncomputable def torusCharacter {d : ℕ} (n : Fin d → ℤ) (x : StandardTorus d) : ℂ :=
  fourier 1 (torusPairing n x)

theorem continuous_torusCharacter {d : ℕ} (n : Fin d → ℤ) : Continuous (torusCharacter n) :=
  (fourier 1).continuous.comp (continuous_torusPairing n)

theorem torusPairing_basis_inverse {d : ℕ} (b : Module.Basis (Fin d) ℤ (Fin d → ℤ))
    (n : Fin d → ℤ) (y : StandardTorus d) :
    torusPairing n ((torusBasisEquiv b).symm y) = ∑ i, b.repr n i • y i := by
  change ((Pi.basisFun ℤ (Fin d)).constr ℤ)
    (((Pi.basisFun ℤ (Fin d)).constr ℤ).symm ((b.constr ℤ) y)) n = _
  rw [LinearEquiv.apply_symm_apply]
  exact b.constr_apply_fintype ℤ y n

/-- A frequency outside a saturated integer submodule has a half-period
on its annihilator, giving the cancellation needed for its Haar integral. -/
theorem saturatedAnnihilator_half_period {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) {n : Fin d → ℤ} (hn : n ∉ L) :
    ∃ x : torusAnnihilator L, torusPairing n x = ((1 / 2 : ℝ) : AddCircle (1 : ℝ)) := by
  classical
  obtain ⟨r, _, b, hb⟩ := saturatedAdaptedBasis L hL
  have hex : ∃ i : Fin d, r ≤ i.val ∧ b.repr n i ≠ 0 := by
    by_contra h
    push Not at h
    apply hn
    rw [← hb, b.mem_span_image]
    intro i hi
    have hi' : b.repr n i ≠ 0 := Finsupp.mem_support_iff.mp hi
    exact lt_of_not_ge (fun hri => hi' (h i hri))
  obtain ⟨i, hi, hni⟩ := hex
  let y : StandardTorus d := Pi.single i (((1 / 2 : ℝ) / (b.repr n i : ℝ)) : AddCircle (1 : ℝ))
  have hx : (torusBasisEquiv b).symm y ∈ torusAnnihilator L := by
    apply (torusAnnihilator_basis_coordinates L b hb _).mpr
    intro j hj
    rw [LinearEquiv.apply_symm_apply]
    have hji : j ≠ i := by intro heq; subst j; omega
    simp [y, Pi.single_eq_of_ne hji]
  refine ⟨⟨(torusBasisEquiv b).symm y, hx⟩, ?_⟩
  rw [torusPairing_basis_inverse]
  simp only [y, Pi.single_apply, smul_ite, smul_zero, Finset.sum_ite_eq', Finset.mem_univ,
    ite_true]
  rw [← AddCircle.coe_zsmul]
  congr 1
  rw [zsmul_eq_mul]
  have hk : (b.repr n i : ℝ) ≠ 0 := by exact_mod_cast hni
  field_simp

theorem torusCharacter_add_half_period {d : ℕ} (n : Fin d → ℤ) {a : StandardTorus d}
    (ha : torusPairing n a = ((1 / 2 : ℝ) : AddCircle (1 : ℝ))) (x : StandardTorus d) :
    torusCharacter n (x + a) = -torusCharacter n x := by
  have hpair := (torusPairingMap n).map_add x a
  change torusPairing n (x + a) = torusPairing n x + torusPairing n a at hpair
  rw [torusCharacter, hpair, ha]
  simpa only [Int.cast_one, div_one, torusCharacter] using
    fourier_add_half_inv_index (T := (1 : ℝ)) (n := (1 : ℤ))
      one_ne_zero zero_lt_one (torusPairing n x)

open scoped Classical in
/-- Blueprint `lem:torus-annihilator`: the Haar integral of a torus character
over the annihilator of a saturated lattice is exactly its membership indicator. -/
theorem saturatedAnnihilator_character_integral {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) (n : Fin d → ℤ) :
    (∫ x : torusAnnihilator L, torusCharacter n x ∂torusAnnihilatorHaar L) =
      if n ∈ L then (1 : ℂ) else 0 := by
  classical
  by_cases hn : n ∈ L
  · rw [ite_eq_left hn]
    have hone : ∀ x : torusAnnihilator L, torusCharacter n x = 1 := by
      intro x
      have h := (mem_torusAnnihilator L x).mp x.property n hn
      simp [torusCharacter, h]
    simp only [hone, MeasureTheory.integral_const, MeasureTheory.probReal_univ, one_smul]
  · rw [ite_eq_right hn]
    obtain ⟨a, ha⟩ := saturatedAnnihilator_half_period L hL hn
    exact MeasureTheory.integral_eq_zero_of_add_right_eq_neg
      (g := a) (fun x => torusCharacter_add_half_period n ha x)

open scoped Classical in
theorem rationalAnnihilator_character_integral {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    (n : Fin d → ℤ) :
    (∫ x : torusAnnihilator (rationalIntegerIntersection V), torusCharacter n x
      ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) =
      if n ∈ rationalIntegerIntersection V then (1 : ℂ) else 0 :=
  saturatedAnnihilator_character_integral _ (rationalIntegerIntersection_saturated V) n

/-- Nonzero integer multiplication is onto every saturated annihilator torus. -/
theorem saturatedAnnihilator_zsmul_surjective {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) {k : ℤ} (hk : k ≠ 0) :
    Function.Surjective (fun x : torusAnnihilator L => k • x) := by
  obtain ⟨r, _, ⟨e⟩, _⟩ := saturatedAnnihilator_is_torus L hL
  intro y
  obtain ⟨x, hx⟩ := DivisibleBy.surjective_smul
    ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ)) ℤ hk (e y)
  refine ⟨e.symm x, ?_⟩
  apply e.injective
  rw [map_smul, e.apply_symm_apply]
  exact hx

/-- The two-coordinate progression map from blueprint `lem:torus-annihilator`. -/
def progressionPairHom (G : Type*) [AddCommGroup G] (i j l : ℤ) : (G × G) →+ (G × G) where
  toFun x := (x.1 + (i - l) • x.2, x.1 + (j - l) • x.2)
  map_zero' := by simp
  map_add' x y := by
    ext <;> simp only [Prod.fst_add, Prod.snd_add, smul_add] <;> abel

theorem progressionPairHom_surjective {G : Type*} [AddCommGroup G]
    (hdiv : ∀ k : ℤ, k ≠ 0 → Function.Surjective (fun x : G => k • x))
    {i j : ℤ} (hij : i ≠ j) (l : ℤ) : Function.Surjective (progressionPairHom G i j l) := by
  rintro ⟨a, b⟩
  obtain ⟨v, hv⟩ := hdiv (j - i) (sub_ne_zero.mpr hij.symm) (b - a)
  change (j - i) • v = b - a at hv
  refine ⟨(a - (i - l) • v, v), ?_⟩
  apply Prod.ext
  · change a - (i - l) • v + (i - l) • v = a
    abel
  · change a - (i - l) • v + (j - l) • v = b
    calc
      _ = a + (j - i) • v := by simp only [sub_smul]; abel
      _ = b := by rw [hv]; abel

theorem saturatedAnnihilator_progression_surjective {d : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (hL : IntegerSaturated L) {i j : ℤ}
    (hij : i ≠ j) (l : ℤ) :
    Function.Surjective (progressionPairHom (torusAnnihilator L) i j l) :=
  progressionPairHom_surjective (fun _ hk => saturatedAnnihilator_zsmul_surjective L hL hk) hij l

theorem rationalAnnihilator_progression_surjective {d : ℕ}
    (V : Submodule ℚ (Fin d → ℚ)) {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    Function.Surjective
      (progressionPairHom (torusAnnihilator (rationalIntegerIntersection V)) i j l) :=
  saturatedAnnihilator_progression_surjective _ (rationalIntegerIntersection_saturated V) hij l

theorem continuous_progressionPairHom {G : Type*} [AddCommGroup G] [TopologicalSpace G]
    [IsTopologicalAddGroup G] (i j l : ℤ) : Continuous (progressionPairHom G i j l) :=
  (continuous_fst.add (continuous_snd.zsmul (i - l))).prodMk
    (continuous_fst.add (continuous_snd.zsmul (j - l)))

/-- Blueprint `lem:torus-annihilator`: the progression pair map preserves
the product of the annihilator's Haar probabilities. -/
theorem saturatedAnnihilator_progression_measurePreserving {d : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (hL : IntegerSaturated L) {i j : ℤ}
    (hij : i ≠ j) (l : ℤ) :
    MeasureTheory.MeasurePreserving (progressionPairHom (torusAnnihilator L) i j l)
      ((torusAnnihilatorHaar L).prod (torusAnnihilatorHaar L))
      ((torusAnnihilatorHaar L).prod (torusAnnihilatorHaar L)) := by
  let : SecondCountableTopology (torusAnnihilator L) := inferInstance
  let : BorelSpace (torusAnnihilator L) := inferInstance
  exact AddMonoidHom.measurePreserving (continuous_progressionPairHom i j l)
    (saturatedAnnihilator_progression_surjective L hL hij l) rfl

theorem rationalAnnihilator_progression_measurePreserving {d : ℕ}
    (V : Submodule ℚ (Fin d → ℚ)) {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    MeasureTheory.MeasurePreserving
      (progressionPairHom (torusAnnihilator (rationalIntegerIntersection V)) i j l)
      ((torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V)))
      ((torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V))) :=
  saturatedAnnihilator_progression_measurePreserving _
    (rationalIntegerIntersection_saturated V) hij l

open scoped Classical in
/-- Blueprint `lem:torus-annihilator`, complete statement: a rational
annihilator is a compact connected torus; its character integrals are the
indicator of the integer lattice; and every two-distinct-slot progression
map is surjective and preserves Haar probability, including dimension zero. -/
theorem rationalAnnihilator {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) :
    ConnectedSpace (torusAnnihilator (rationalIntegerIntersection V)) ∧
    (∃ r ≤ d, Nonempty (torusAnnihilator (rationalIntegerIntersection V) ≃ₜ
      ({i : Fin d // r ≤ i.val} → AddCircle (1 : ℝ)))) ∧
    (∀ n : Fin d → ℤ,
      (∫ x : torusAnnihilator (rationalIntegerIntersection V), torusCharacter n x
        ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) =
        if n ∈ rationalIntegerIntersection V then (1 : ℂ) else 0) ∧
    ∀ i j : ℤ, i ≠ j → ∀ l : ℤ,
      Function.Surjective
        (progressionPairHom (torusAnnihilator (rationalIntegerIntersection V)) i j l) ∧
      MeasureTheory.MeasurePreserving
        (progressionPairHom (torusAnnihilator (rationalIntegerIntersection V)) i j l)
        ((torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
          (torusAnnihilatorHaar (rationalIntegerIntersection V)))
        ((torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
          (torusAnnihilatorHaar (rationalIntegerIntersection V))) := by
  refine ⟨rationalAnnihilator_connected V, ?_, rationalAnnihilator_character_integral V, ?_⟩
  · obtain ⟨r, hr, _, he⟩ :=
      saturatedAnnihilator_is_torus _ (rationalIntegerIntersection_saturated V)
    exact ⟨r, hr, he⟩
  · intro i j hij l
    exact ⟨rationalAnnihilator_progression_surjective V hij l,
      rationalAnnihilator_progression_measurePreserving V hij l⟩

/-- The reciprocal exponent polytope in blueprint `lem:absolute`, line 390. -/
def reciprocalExponentPolytope (d k : ℕ) : Set (Fin d → ℝ) :=
  {a | (∀ i, 0 ≤ a i ∧ a i ≤ 1) ∧ ∑ i, a i ≤ k}

theorem reciprocalExponentPolytope_convex (d k : ℕ) :
    Convex ℝ (reciprocalExponentPolytope d k) := by
  intro a ha b hb s t hs ht hst
  constructor
  · intro i
    change 0 ≤ s * a i + t * b i ∧ s * a i + t * b i ≤ 1
    constructor
    · exact add_nonneg (mul_nonneg hs (ha.1 i).1) (mul_nonneg ht (hb.1 i).1)
    · calc
        s * a i + t * b i ≤ s * 1 + t * 1 :=
          add_le_add (mul_le_mul_of_nonneg_left (ha.1 i).2 hs)
            (mul_le_mul_of_nonneg_left (hb.1 i).2 ht)
        _ = 1 := by nlinarith
  · change ∑ i, (s * a i + t * b i) ≤ (k : ℝ)
    rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    calc
      _ ≤ s * k + t * k := add_le_add (mul_le_mul_of_nonneg_left ha.2 hs)
        (mul_le_mul_of_nonneg_left hb.2 ht)
      _ = k := by nlinarith

theorem reciprocalExponentPolytope_compact (d k : ℕ) :
    IsCompact (reciprocalExponentPolytope d k) := by
  have he : reciprocalExponentPolytope d k =
      Set.Icc (0 : Fin d → ℝ) 1 ∩ {a | ∑ i, a i ≤ (k : ℝ)} := by
    ext a
    simp only [reciprocalExponentPolytope, Set.mem_ofPred_eq, Set.mem_inter_iff,
      Set.mem_Icc, Pi.le_def, Pi.zero_apply, Pi.one_apply, forall_and]
  rw [he]
  exact isCompact_Icc.inter_right
    (isClosed_le (continuous_finsetSum _ (fun i _ => continuous_apply i)) continuous_const)

/-- A nonzero symmetric perturbation rules out an extreme point. -/
theorem extremePoint_perturbation_eq_zero {d : ℕ} {s : Set (Fin d → ℝ)}
    {a v : Fin d → ℝ} (ha : a ∈ s.extremePoints ℝ)
    (hplus : a + v ∈ s) (hminus : a - v ∈ s) : v = 0 := by
  have h := ha.2 hplus hminus (mem_openSegment_add_sub (𝕜 := ℝ) a v)
  have : a + v = a + 0 := by simpa using h
  exact add_left_cancel this

theorem reciprocalExponentPolytope_perturb {d k : ℕ} {a v : Fin d → ℝ}
    (hv : ∀ i, |v i| ≤ min (a i) (1 - a i))
    (hs : |∑ i, v i| ≤ (k : ℝ) - ∑ i, a i) :
    a + v ∈ reciprocalExponentPolytope d k ∧
      a - v ∈ reciprocalExponentPolytope d k := by
  have hc (i) := abs_le.mp (hv i)
  have hb (i) := le_min_iff.mp (hv i)
  have hsum := abs_le.mp hs
  constructor
  · constructor
    · intro i
      change 0 ≤ a i + v i ∧ a i + v i ≤ 1
      constructor <;>
        linarith [hc i, hb i, min_le_left (a i) (1 - a i), min_le_right (a i) (1 - a i)]
    · change ∑ i, (a i + v i) ≤ (k : ℝ)
      rw [Finset.sum_add_distrib]
      linarith
  · constructor
    · intro i
      change 0 ≤ a i - v i ∧ a i - v i ≤ 1
      constructor <;>
        linarith [hc i, hb i, min_le_left (a i) (1 - a i), min_le_right (a i) (1 - a i)]
    · change ∑ i, (a i - v i) ≤ (k : ℝ)
      rw [Finset.sum_sub_distrib]
      linarith

/-- Two fractional coordinates admit opposite perturbations, as in
blueprint `lem:absolute`, line 390. -/
theorem reciprocalExponentPolytope_extreme_fractional_unique {d k : ℕ}
    {a : Fin d → ℝ} (ha : a ∈ (reciprocalExponentPolytope d k).extremePoints ℝ)
    {i j : Fin d} (hi : 0 < a i ∧ a i < 1) (hj : 0 < a j ∧ a j < 1) : i = j := by
  classical
  by_contra hij
  let e := min (min (a i) (1 - a i)) (min (a j) (1 - a j))
  have he : 0 < e := lt_min (lt_min hi.1 (sub_pos.mpr hi.2))
    (lt_min hj.1 (sub_pos.mpr hj.2))
  let v : Fin d → ℝ := Pi.single i e - Pi.single j e
  have hv (t) : |v t| ≤ min (a t) (1 - a t) := by
    by_cases hti : t = i
    · subst t
      simp [v, hij, abs_of_pos he, e]
    · by_cases htj : t = j
      · subst t
        simp [v, Ne.symm hij, abs_of_pos he, e]
      · simp only [v, Pi.sub_apply, Pi.single_apply, hti, htj, ite_false,
          sub_zero, abs_zero]
        exact le_min (ha.1.1 t).1 (sub_nonneg.mpr (ha.1.1 t).2)
  have hsum : ∑ t, v t = 0 := by simp [v, Finset.sum_sub_distrib]
  have hp := reciprocalExponentPolytope_perturb hv
    (show |∑ t, v t| ≤ (k : ℝ) - ∑ t, a t by rw [hsum, abs_zero]; exact sub_nonneg.mpr ha.1.2)
  have hz := congrFun (extremePoint_perturbation_eq_zero ha hp.1 hp.2) i
  have : e = 0 := by simpa [v, hij, Ne.symm hij] using hz
  exact he.ne' this

theorem reciprocalExponentPolytope_extreme_fractional_sum {d k : ℕ}
    {a : Fin d → ℝ} (ha : a ∈ (reciprocalExponentPolytope d k).extremePoints ℝ)
    {i : Fin d} (hi : 0 < a i ∧ a i < 1) : ∑ t, a t = k := by
  classical
  by_contra hne
  have hlt : ∑ t, a t < (k : ℝ) := lt_of_le_of_ne ha.1.2 hne
  let e := min (min (a i) (1 - a i)) ((k : ℝ) - ∑ t, a t)
  have he : 0 < e := lt_min (lt_min hi.1 (sub_pos.mpr hi.2)) (sub_pos.mpr hlt)
  let v : Fin d → ℝ := Pi.single i e
  have hv (t) : |v t| ≤ min (a t) (1 - a t) := by
    by_cases hti : t = i
    · subst t
      simp [v, abs_of_pos he, e]
    · simp only [v, Pi.single_apply, hti, ite_false, abs_zero]
      exact le_min (ha.1.1 t).1 (sub_nonneg.mpr (ha.1.1 t).2)
  have hs : |∑ t, v t| ≤ (k : ℝ) - ∑ t, a t := by
    simp [v, abs_of_pos he, e]
  have hp := reciprocalExponentPolytope_perturb hv hs
  have hz := congrFun (extremePoint_perturbation_eq_zero ha hp.1 hp.2) i
  have : e = 0 := by simpa [v] using hz
  exact he.ne' this

/-- Every extreme point of the reciprocal exponent polytope is Boolean. -/
theorem reciprocalExponentPolytope_extreme_boolean {d k : ℕ}
    {a : Fin d → ℝ} (ha : a ∈ (reciprocalExponentPolytope d k).extremePoints ℝ)
    (i : Fin d) : a i = 0 ∨ a i = 1 := by
  classical
  by_contra h
  push Not at h
  have hi : 0 < a i ∧ a i < 1 :=
    ⟨lt_of_le_of_ne (ha.1.1 i).1 h.1.symm, lt_of_le_of_ne (ha.1.1 i).2 h.2⟩
  have hj (j : Fin d) (hji : j ≠ i) : a j = 0 ∨ a j = 1 := by
    by_contra hn
    push Not at hn
    exact hji (reciprocalExponentPolytope_extreme_fractional_unique ha
      ⟨lt_of_le_of_ne (ha.1.1 j).1 hn.1.symm,
        lt_of_le_of_ne (ha.1.1 j).2 hn.2⟩ hi)
  let s := (Finset.univ.erase i).filter (fun j => a j = 1)
  have hs : ∑ j ∈ Finset.univ.erase i, a j = (s.card : ℝ) := by
    calc
      _ = ∑ j ∈ Finset.univ.erase i, if a j = 1 then (1 : ℝ) else 0 := by
        apply Finset.sum_congr rfl
        intro j hjmem
        rcases hj j (Finset.mem_erase.mp hjmem).1 with hjzero | hjone
        · simp [hjzero]
        · simp [hjone]
      _ = s.card := by simp [s]
  have hsum := Finset.sum_erase_add Finset.univ a (Finset.mem_univ i)
  rw [hs, reciprocalExponentPolytope_extreme_fractional_sum ha hi] at hsum
  have hlow : (s.card : ℝ) < k := by linarith
  have hupp : (k : ℝ) < (s.card : ℝ) + 1 := by linarith
  have hlow' : s.card < k := by exact_mod_cast hlow
  have hupp' : k < s.card + 1 := by exact_mod_cast hupp
  omega

/-- Boolean endpoint configurations with at most `k` occupied slots. -/
def reciprocalExponentEndpoints (d k : ℕ) : Set (Fin d → ℝ) :=
  {a | (∀ i, a i = 0 ∨ a i = 1) ∧ ∑ i, a i ≤ k}

theorem reciprocalExponentEndpoints_finite (d k : ℕ) :
    (reciprocalExponentEndpoints d k).Finite := by
  classical
  apply (Set.finite_range (fun b : Fin d → Bool => fun i => if b i then (1 : ℝ) else 0)).subset
  intro a ha
  refine ⟨fun i => decide (a i = 1), ?_⟩
  funext i
  rcases ha.1 i with hi | hi <;> simp [hi]

/-- Blueprint `lem:absolute`, line 390: the admissible reciprocal exponents
are precisely the convex hull of Boolean configurations with at most `k` ones.
In particular `d = 4`, `k = 2` gives the source interpolation polytope. -/
theorem reciprocalExponentPolytope_eq_convexHull (d k : ℕ) :
    reciprocalExponentPolytope d k = convexHull ℝ (reciprocalExponentEndpoints d k) := by
  have hsub : reciprocalExponentEndpoints d k ⊆ reciprocalExponentPolytope d k := by
    intro a ha
    refine ⟨fun i => ?_, ha.2⟩
    rcases ha.1 i with hi | hi <;> simp [hi]
  apply Set.Subset.antisymm
  · rw [← closure_convexHull_extremePoints (reciprocalExponentPolytope_compact d k)
      (reciprocalExponentPolytope_convex d k)]
    apply closure_minimal
    · apply convexHull_mono
      intro a ha
      exact ⟨reciprocalExponentPolytope_extreme_boolean ha, ha.1.2⟩
    · exact (reciprocalExponentEndpoints_finite d k).isClosed_convexHull ℝ
  · exact convexHull_min hsub (reciprocalExponentPolytope_convex d k)

/-- Product identity used by positive Hölder interpolation, valid also for
zero and infinite bases because every exponent is nonnegative. -/
theorem ennreal_product_convex_exponents {d : ℕ} (f : Fin d → ℝ≥0∞)
    {a b : Fin d → ℝ} (ha : ∀ i, 0 ≤ a i) (hb : ∀ i, 0 ≤ b i)
    {s t : ℝ} (hs : 0 ≤ s) (ht : 0 ≤ t) :
    (∏ i, f i ^ (s * a i + t * b i)) =
      (∏ i, f i ^ a i) ^ s * (∏ i, f i ^ b i) ^ t := by
  simp_rw [ENNReal.rpow_add_of_nonneg _ _ (mul_nonneg hs (ha _))
    (mul_nonneg ht (hb _)), mul_comm s, mul_comm t, ENNReal.rpow_mul]
  rw [Finset.prod_mul_distrib, ENNReal.prod_rpow_of_nonneg hs,
    ENNReal.prod_rpow_of_nonneg ht]

/-- Positive product-integral bounds form a convex set of nonnegative
exponents. This is the Hölder interpolation step of `lem:absolute`, line 392. -/
theorem positiveExponentBound_convex {X : Type*} [MeasurableSpace X]
    (μ : Measure X) {d : ℕ} (f : Fin d → X → ℝ≥0∞)
    (hf : ∀ i, AEMeasurable (f i) μ) (B : Fin d → ℝ≥0∞) (C : ℝ≥0∞) :
    Convex ℝ {a : Fin d → ℝ | (∀ i, 0 ≤ a i) ∧
      (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ≤ C * ∏ i, B i ^ a i} := by
  intro a ha b hb s t hs ht hst
  refine ⟨fun i => add_nonneg (mul_nonneg hs (ha.1 i)) (mul_nonneg ht (hb.1 i)), ?_⟩
  change (∫⁻ x, ∏ i, f i x ^ (s * a i + t * b i) ∂μ) ≤
    C * ∏ i, B i ^ (s * a i + t * b i)
  simp_rw [ennreal_product_convex_exponents _ ha.1 hb.1 hs ht]
  calc
    _ ≤ (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ^ s *
        (∫⁻ x, ∏ i, f i x ^ b i ∂μ) ^ t :=
      ENNReal.lintegral_mul_norm_pow_le
        (Finset.aemeasurable_fun_prod _ (fun i _ => (hf i).pow_const _))
        (Finset.aemeasurable_fun_prod _ (fun i _ => (hf i).pow_const _)) hs ht hst
    _ ≤ (C * ∏ i, B i ^ a i) ^ s * (C * ∏ i, B i ^ b i) ^ t :=
      mul_le_mul' (ENNReal.rpow_le_rpow ha.2 hs) (ENNReal.rpow_le_rpow hb.2 ht)
    _ = C * ((∏ i, B i ^ a i) ^ s * (∏ i, B i ^ b i) ^ t) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hs, ENNReal.mul_rpow_of_nonneg _ _ ht]
      calc
        _ = (C ^ s * C ^ t) *
            ((∏ i, B i ^ a i) ^ s * (∏ i, B i ^ b i) ^ t) := by ac_rfl
        _ = _ := by rw [← ENNReal.rpow_add_of_nonneg s t hs ht, hst, ENNReal.rpow_one]

/-- Blueprint `lem:absolute`, line 392: positive Boolean endpoint estimates
interpolate throughout the complete reciprocal-exponent polytope. The extended
nonnegative formulation includes zero and infinite integrals without division. -/
theorem positiveEndpointInterpolation {X : Type*} [MeasurableSpace X]
    (μ : Measure X) {d k : ℕ} (f : Fin d → X → ℝ≥0∞)
    (hf : ∀ i, AEMeasurable (f i) μ) (B : Fin d → ℝ≥0∞) (C : ℝ≥0∞)
    (hend : ∀ a ∈ reciprocalExponentEndpoints d k,
      (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ≤ C * ∏ i, B i ^ a i)
    {a : Fin d → ℝ} (ha : a ∈ reciprocalExponentPolytope d k) :
    (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ≤ C * ∏ i, B i ^ a i := by
  have hs : reciprocalExponentEndpoints d k ⊆
      {a : Fin d → ℝ | (∀ i, 0 ≤ a i) ∧
        (∫⁻ x, ∏ i, f i x ^ a i ∂μ) ≤ C * ∏ i, B i ^ a i} := by
    intro a ha
    refine ⟨fun i => ?_, hend a ha⟩
    rcases ha.1 i with hi | hi <;> simp [hi]
  have hconv := convexHull_min hs (positiveExponentBound_convex μ f hf B C)
  rw [← reciprocalExponentPolytope_eq_convexHull] at hconv
  exact (hconv ha).2

/-- Scalar affine change of variables for the real endpoint estimates in
blueprint `lem:absolute`, line 388. -/
theorem real_lintegral_affine (g : ℝ → ℝ≥0∞) (hg : Measurable g)
    {a : ℝ} (ha : a ≠ 0) (b : ℝ) :
    (∫⁻ t : ℝ, g (b + a * t)) = ENNReal.ofReal |a⁻¹| * ∫⁻ u : ℝ, g u := by
  calc
    _ = ∫⁻ u : ℝ, g (b + u) ∂Measure.map (fun t : ℝ => a * t) volume :=
      (lintegral_map (hg.comp (measurable_const.add measurable_id))
        (measurable_const.mul measurable_id)).symm
    _ = _ := by
      rw [Real.map_volume_mul_left ha, lintegral_smul_measure,
        lintegral_add_left_eq_self]
      rfl

/-- The two occupied real progression slots have Jacobian `j - i`,
as used by blueprint `lem:absolute`, line 388. -/
theorem real_progression_pair_lintegral (f g : ℝ → ℝ≥0∞)
    (hf : Measurable f) (hg : Measurable g) {i j : ℝ} (hij : i ≠ j) :
    (∫⁻ z : ℝ × ℝ, f (z.1 + i * z.2) * g (z.1 + j * z.2)) =
      ENNReal.ofReal |(j - i)⁻¹| * (∫⁻ u : ℝ, f u) * ∫⁻ v : ℝ, g v := by
  have hm : Measurable (fun z : ℝ × ℝ => f (z.1 + i * z.2) * g (z.1 + j * z.2)) :=
    (hf.comp (measurable_fst.add (measurable_const.mul measurable_snd))).mul
      (hg.comp (measurable_fst.add (measurable_const.mul measurable_snd)))
  change (∫⁻ z : ℝ × ℝ, f (z.1 + i * z.2) * g (z.1 + j * z.2)
      ∂volume.prod volume) = _
  rw [lintegral_prod _ hm.aemeasurable]
  rw [lintegral_lintegral_swap hm.aemeasurable]
  have hshift (t : ℝ) :
      (∫⁻ x : ℝ, f (x + i * t) * g (x + j * t)) =
        ∫⁻ u : ℝ, f u * g (u + (j - i) * t) := by
    convert lintegral_add_right_eq_self (μ := (volume : Measure ℝ))
      (fun u : ℝ => f u * g (u + (j - i) * t)) (i * t) using 1
    congr 1
    funext x
    congr 2
    ring
  simp_rw [hshift]
  have hinner (u : ℝ) :
      (∫⁻ t : ℝ, f u * g (u + (j - i) * t)) =
        f u * (ENNReal.ofReal |(j - i)⁻¹| * ∫⁻ v : ℝ, g v) := by
    have hgu : Measurable (fun t : ℝ => g (u + (j - i) * t)) :=
      hg.comp (measurable_const.add (measurable_const.mul measurable_id))
    rw [lintegral_const_mul _ hgu,
      real_lintegral_affine g hg (sub_ne_zero.mpr hij.symm)]
  rw [lintegral_lintegral_swap]
  · simp_rw [hinner]
    rw [lintegral_mul_const _ hf]
    ac_rfl
  · exact ((hf.comp measurable_snd).mul (hg.comp
      (measurable_snd.add (measurable_const.mul measurable_fst)))).aemeasurable

/-- The four real progression coordinates in blueprint `eq:local`. -/
def realProgressionCoordinate (j : Fin 4) (z : ℝ × ℝ) : ℝ := z.1 + (j : ℝ) * z.2

theorem continuous_realProgressionCoordinate (j : Fin 4) :
    Continuous (realProgressionCoordinate j) :=
  continuous_fst.add (continuous_const.mul continuous_snd)

/-- Blueprint `eq:local`: the scale-normalized local complex form. -/
noncomputable def localProgressionForm (r : ℝ) (w : ℝ × ℝ → ℂ)
    (f : Fin 4 → ℝ → ℂ) : ℂ :=
  (r : ℂ)⁻¹ ^ 2 * ∫ z : ℝ × ℝ, w z * ∏ j, f j (realProgressionCoordinate j z)

/-- Interval support required of the kernel in blueprint `eq:local`.
The stronger interior-support and smoothness conditions imply this condition. -/
def HasLocalProgressionSupport {E : Type*} [Zero E]
    (a r : ℝ) (w : ℝ × ℝ → E) : Prop :=
  ∀ z, w z ≠ 0 → ∀ j : Fin 4, realProgressionCoordinate j z ∈ Set.Icc a (a + r)

/-- The support of a local progression kernel has a scale-sized time fiber. -/
theorem localProgressionSupport_time {E : Type*} [Zero E] {a r : ℝ}
    (hr : 0 ≤ r) {w : ℝ × ℝ → E} (hw : HasLocalProgressionSupport a r w)
    {z : ℝ × ℝ} (hz : w z ≠ 0) : z.2 ∈ Set.Icc (-r) r := by
  have hzero := hw z hz 0
  have hthree := hw z hz 3
  norm_num [realProgressionCoordinate, Set.mem_Icc] at hzero hthree
  constructor <;> linarith

/-- Normalized Lebesgue measure on a source interval, for the local `Lp` norms. -/
noncomputable def normalizedIntervalMeasure (a r : ℝ) : Measure ℝ :=
  ENNReal.ofReal r⁻¹ • volume.restrict (Set.Icc a (a + r))

theorem normalizedIntervalMeasure_probability (a : ℝ) {r : ℝ} (hr : 0 < r) :
    IsProbabilityMeasure (normalizedIntervalMeasure a r) := by
  constructor
  simp only [normalizedIntervalMeasure, Measure.smul_apply, Measure.restrict_apply_univ,
    Real.volume_Icc, add_sub_cancel_left, smul_eq_mul]
  rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hr.le), inv_mul_cancel₀ hr.ne', ENNReal.ofReal_one]

theorem realProgression_pair_jacobian_le_one {i j : Fin 4} (hij : i ≠ j) :
    ENNReal.ofReal |((j : ℝ) - (i : ℝ))⁻¹| ≤ 1 := by
  fin_cases i <;> fin_cases j <;> norm_num at *

/-- The two-`L1` endpoint in blueprint `lem:absolute`, line 388. -/
theorem localProgression_pair_endpoint {a r : ℝ} {K : ℝ × ℝ → ℝ≥0∞}
    (hK : HasLocalProgressionSupport a r K) {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f g : ℝ → ℝ≥0∞) (hf : Measurable f) (hg : Measurable g)
    {i j : Fin 4} (hij : i ≠ j) :
    (∫⁻ z : ℝ × ℝ, K z *
      (f (realProgressionCoordinate i z) * g (realProgressionCoordinate j z))) ≤
      W * (∫⁻ u in Set.Icc a (a + r), f u) * ∫⁻ v in Set.Icc a (a + r), g v := by
  let F := (Set.Icc a (a + r)).indicator f
  let G := (Set.Icc a (a + r)).indicator g
  have hF : Measurable F := hf.indicator measurableSet_Icc
  have hG : Measurable G := hg.indicator measurableSet_Icc
  have hm : Measurable (fun z : ℝ × ℝ =>
      F (realProgressionCoordinate i z) * G (realProgressionCoordinate j z)) :=
    (hF.comp (continuous_realProgressionCoordinate i).measurable).mul
      (hG.comp (continuous_realProgressionCoordinate j).measurable)
  calc
    _ ≤ ∫⁻ z : ℝ × ℝ, W *
        (F (realProgressionCoordinate i z) * G (realProgressionCoordinate j z)) := by
      apply lintegral_mono
      intro z
      by_cases hz : K z = 0
      · simp [hz]
      · simp only [F, G, Set.indicator_of_mem (hK z hz i),
          Set.indicator_of_mem (hK z hz j)]
        exact mul_le_mul_left (hW z) _
    _ = W * (ENNReal.ofReal |((j : ℝ) - (i : ℝ))⁻¹| *
        (∫⁻ u : ℝ, F u) * ∫⁻ v : ℝ, G v) := by
      rw [lintegral_const_mul _ hm]
      exact congrArg (W * ·) (real_progression_pair_lintegral F G hF hG
        (by exact_mod_cast (show i.val ≠ j.val from fun h => hij (Fin.ext h))))
    _ ≤ W * ((∫⁻ u : ℝ, F u) * ∫⁻ v : ℝ, G v) := by
      simpa only [one_mul] using mul_le_mul_right
        (mul_le_mul_left (mul_le_mul_left
          (realProgression_pair_jacobian_le_one hij) (∫⁻ u : ℝ, F u)) (∫⁻ v : ℝ, G v)) W
    _ = _ := by
      rw [show (∫⁻ u : ℝ, F u) = ∫⁻ u in Set.Icc a (a + r), f u from
        lintegral_indicator measurableSet_Icc f,
        show (∫⁻ v : ℝ, G v) = ∫⁻ v in Set.Icc a (a + r), g v from
        lintegral_indicator measurableSet_Icc g]
      exact (mul_assoc _ _ _).symm

theorem real_progression_time_cutoff_lintegral (F : ℝ → ℝ≥0∞)
    (hF : Measurable F) (r i : ℝ) :
    (∫⁻ z : ℝ × ℝ, (Set.Icc (-r) r).indicator (fun _ => (1 : ℝ≥0∞)) z.2 *
      F (z.1 + i * z.2)) = ENNReal.ofReal (2 * r) * ∫⁻ u : ℝ, F u := by
  let χ : ℝ → ℝ≥0∞ := (Set.Icc (-r) r).indicator (fun _ => 1)
  have hχ : Measurable χ := measurable_const.indicator measurableSet_Icc
  have hm : Measurable (fun z : ℝ × ℝ => χ z.2 * F (z.1 + i * z.2)) :=
    (hχ.comp measurable_snd).mul
      (hF.comp (measurable_fst.add (measurable_const.mul measurable_snd)))
  change (∫⁻ z : ℝ × ℝ, χ z.2 * F (z.1 + i * z.2) ∂volume.prod volume) = _
  rw [lintegral_prod _ hm.aemeasurable, lintegral_lintegral_swap hm.aemeasurable]
  have hinner (t : ℝ) : (∫⁻ x : ℝ, χ t * F (x + i * t)) = χ t * ∫⁻ u : ℝ, F u := by
    have hFt : Measurable (fun x : ℝ => F (x + i * t)) :=
      hF.comp (measurable_id.add measurable_const)
    rw [lintegral_const_mul _ hFt, lintegral_add_right_eq_self]
  simp_rw [hinner]
  rw [lintegral_mul_const _ hχ]
  congr 1
  simp [χ, lintegral_indicator measurableSet_Icc, Real.volume_Icc, two_mul]

/-- The one-`L1` endpoint in blueprint `lem:absolute`, line 388. -/
theorem localProgression_single_endpoint {a r : ℝ} (hr : 0 ≤ r)
    {K : ℝ × ℝ → ℝ≥0∞} (hK : HasLocalProgressionSupport a r K)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : ℝ → ℝ≥0∞) (hf : Measurable f) (i : Fin 4) :
    (∫⁻ z : ℝ × ℝ, K z * f (realProgressionCoordinate i z)) ≤
      W * ENNReal.ofReal (2 * r) * ∫⁻ u in Set.Icc a (a + r), f u := by
  let F := (Set.Icc a (a + r)).indicator f
  let χ : ℝ → ℝ≥0∞ := (Set.Icc (-r) r).indicator (fun _ => 1)
  have hF : Measurable F := hf.indicator measurableSet_Icc
  have hχ : Measurable χ := measurable_const.indicator measurableSet_Icc
  have hm : Measurable (fun z : ℝ × ℝ => χ z.2 * F (realProgressionCoordinate i z)) :=
    (hχ.comp measurable_snd).mul
      (hF.comp (continuous_realProgressionCoordinate i).measurable)
  calc
    _ ≤ ∫⁻ z : ℝ × ℝ, W * (χ z.2 * F (realProgressionCoordinate i z)) := by
      apply lintegral_mono
      intro z
      by_cases hz : K z = 0
      · simp [hz]
      · simp only [χ, F, Set.indicator_of_mem (localProgressionSupport_time hr hK hz),
          Set.indicator_of_mem (hK z hz i), one_mul]
        exact mul_le_mul_left (hW z) _
    _ = W * (ENNReal.ofReal (2 * r) * ∫⁻ u : ℝ, F u) := by
      rw [lintegral_const_mul _ hm]
      exact congrArg (W * ·) (real_progression_time_cutoff_lintegral F hF r (i : ℝ))
    _ = _ := by
      rw [show (∫⁻ u : ℝ, F u) = ∫⁻ u in Set.Icc a (a + r), f u from
        lintegral_indicator measurableSet_Icc f]
      exact (mul_assoc _ _ _).symm

/-- The all-infinity endpoint in blueprint `lem:absolute`, line 388. -/
theorem localProgression_empty_endpoint {a r : ℝ} (hr : 0 ≤ r)
    {K : ℝ × ℝ → ℝ≥0∞} (hK : HasLocalProgressionSupport a r K)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) :
    (∫⁻ z : ℝ × ℝ, K z) ≤ W * ENNReal.ofReal (2 * r) * ENNReal.ofReal r := by
  simpa using localProgression_single_endpoint hr hK hW (fun _ => 1) measurable_const 0

/-- A two-coordinate measure-preserving map supplies a positive endpoint
bound, as in the torus argument of blueprint `lem:absolute`, line 394. -/
theorem measurePreserving_pair_endpoint {X Y Z : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] [MeasurableSpace Z]
    {μ : Measure X} {ν : Measure Y} {ρ : Measure Z} [SFinite ρ]
    {P : X → Y × Z} (hP : MeasurePreserving P μ (ν.prod ρ))
    {K : X → ℝ≥0∞} {W : ℝ≥0∞} (hW : ∀ x, K x ≤ W)
    (f : Y → ℝ≥0∞) (g : Z → ℝ≥0∞) (hf : Measurable f) (hg : Measurable g) :
    (∫⁻ x, K x * (f (P x).1 * g (P x).2) ∂μ) ≤
      W * (∫⁻ y, f y ∂ν) * ∫⁻ z, g z ∂ρ := by
  have hm : Measurable (fun z : Y × Z => f z.1 * g z.2) :=
    (hf.comp measurable_fst).mul (hg.comp measurable_snd)
  calc
    _ ≤ ∫⁻ x, W * (f (P x).1 * g (P x).2) ∂μ :=
      lintegral_mono (fun x => mul_le_mul_left (hW x) _)
    _ = W * (∫⁻ z, f z.1 * g z.2 ∂ν.prod ρ) := by
      have hmP : Measurable (fun x => f (P x).1 * g (P x).2) := hm.comp hP.measurable
      rw [lintegral_const_mul _ hmP, hP.lintegral_comp hm]
    _ = _ := by
      rw [lintegral_prod_mul hf.aemeasurable hg.aemeasurable, mul_assoc]

/-- Blueprint `lem:absolute`, torus two-slot endpoint with constant one
for a multiplier bounded by one. -/
theorem rationalTorus_pair_endpoint {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    {K : (torusAnnihilator (rationalIntegerIntersection V)) ×
      (torusAnnihilator (rationalIntegerIntersection V)) → ℝ≥0∞}
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f g : torusAnnihilator (rationalIntegerIntersection V) → ℝ≥0∞)
    (hf : Measurable f) (hg : Measurable g) {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    (∫⁻ z, K z * (f (z.1 + (i - l) • z.2) * g (z.1 + (j - l) • z.2))
      ∂(torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V))) ≤
      W * (∫⁻ u, f u ∂torusAnnihilatorHaar (rationalIntegerIntersection V)) *
        ∫⁻ v, g v ∂torusAnnihilatorHaar (rationalIntegerIntersection V) :=
  measurePreserving_pair_endpoint
    (rationalAnnihilator_progression_measurePreserving V hij l) hW f g hf hg

theorem rationalTorus_single_endpoint {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    {K : (torusAnnihilator (rationalIntegerIntersection V)) ×
      (torusAnnihilator (rationalIntegerIntersection V)) → ℝ≥0∞}
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : torusAnnihilator (rationalIntegerIntersection V) → ℝ≥0∞)
    (hf : Measurable f) (i l : ℤ) :
    (∫⁻ z, K z * f (z.1 + (i - l) • z.2)
      ∂(torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V))) ≤
      W * ∫⁻ u, f u ∂torusAnnihilatorHaar (rationalIntegerIntersection V) := by
  simpa using rationalTorus_pair_endpoint V hW f (fun _ => 1) hf measurable_const
    (i := i) (j := i + 1) (by omega) l

theorem rationalTorus_empty_endpoint {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    {K : (torusAnnihilator (rationalIntegerIntersection V)) ×
      (torusAnnihilator (rationalIntegerIntersection V)) → ℝ≥0∞}
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) :
    (∫⁻ z, K z ∂(torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
      (torusAnnihilatorHaar (rationalIntegerIntersection V))) ≤ W := by
  simpa using rationalTorus_single_endpoint V hW (fun _ => 1) measurable_const 0 0

/-- The progression pair map is injective on torsion-free groups, the
integer-lattice endpoint argument of blueprint `lem:absolute`, line 394. -/
theorem progressionPairHom_injective {G : Type*} [AddCommGroup G] [HasUniqueDiv G]
    {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    Function.Injective (progressionPairHom G i j l) := by
  intro a b hab
  have h1 : a.1 + (i - l) • a.2 = b.1 + (i - l) • b.2 := congrArg Prod.fst hab
  have h2 : a.1 + (j - l) • a.2 = b.1 + (j - l) • b.2 := congrArg Prod.snd hab
  have hv : (j - i) • a.2 = (j - i) • b.2 := by
    calc
      _ = (a.1 + (j - l) • a.2) - (a.1 + (i - l) • a.2) := by
        simp only [sub_smul]; abel
      _ = (b.1 + (j - l) • b.2) - (b.1 + (i - l) • b.2) := by rw [h1, h2]
      _ = _ := by simp only [sub_smul]; abel
  have hv' := zsmul_right_injective (sub_ne_zero.mpr hij.symm) hv
  rw [hv'] at h1
  exact Prod.ext (add_right_cancel h1) hv'

/-- Blueprint `lem:absolute`, line 394: counting over the progression image
is bounded by the full product sum, in every integer-lattice dimension. -/
theorem integerProgression_pair_endpoint {d : ℕ}
    {K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞}
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) (f g : (Fin d → ℤ) → ℝ≥0∞)
    {i j : ℤ} (hij : i ≠ j) (l : ℤ) :
    (∑' z : (Fin d → ℤ) × (Fin d → ℤ),
      K z * (f (z.1 + (i - l) • z.2) * g (z.1 + (j - l) • z.2))) ≤
      W * (∑' u, f u) * ∑' v, g v := by
  calc
    _ ≤ ∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        W * (f (z.1 + (i - l) • z.2) * g (z.1 + (j - l) • z.2)) :=
      ENNReal.tsum_le_tsum (fun z => mul_le_mul_left (hW z) _)
    _ = W * ∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        f (z.1 + (i - l) • z.2) * g (z.1 + (j - l) • z.2) := ENNReal.tsum_mul_left
    _ ≤ W * ∑' z : (Fin d → ℤ) × (Fin d → ℤ), f z.1 * g z.2 :=
      mul_le_mul_right (ENNReal.tsum_comp_le_tsum_of_injective
        (progressionPairHom_injective hij l) (fun z => f z.1 * g z.2)) W
    _ = _ := by
      rw [ENNReal.tsum_prod' (f := fun z : (Fin d → ℤ) × (Fin d → ℤ) => f z.1 * g z.2)]
      simp_rw [ENNReal.tsum_mul_left, ENNReal.tsum_mul_right]
      exact (mul_assoc _ _ _).symm

theorem integerProgression_time_cutoff_sum {d : ℕ} (T : Finset (Fin d → ℤ))
    (f : (Fin d → ℤ) → ℝ≥0∞) (i : ℤ) :
    (∑' z : (Fin d → ℤ) × (Fin d → ℤ),
      (if z.2 ∈ T then (1 : ℝ≥0∞) else 0) * f (z.1 + i • z.2)) =
      (T.card : ℝ≥0∞) * ∑' u, f u := by
  classical
  rw [ENNReal.tsum_prod' (f := fun z : (Fin d → ℤ) × (Fin d → ℤ) =>
    (if z.2 ∈ T then (1 : ℝ≥0∞) else 0) * f (z.1 + i • z.2)), ENNReal.tsum_comm]
  have hinner (v : Fin d → ℤ) :
      (∑' u, (if v ∈ T then (1 : ℝ≥0∞) else 0) * f (u + i • v)) =
        (if v ∈ T then (1 : ℝ≥0∞) else 0) * ∑' u, f u := by
    rw [ENNReal.tsum_mul_left]
    congr 1
    exact (Equiv.addRight (i • v)).tsum_eq f
  simp_rw [hinner]
  rw [ENNReal.tsum_mul_right]
  congr 1
  rw [tsum_eq_sum (s := T) (fun v hv => ite_eq_right hv)]
  simp

/-- One occupied slot for a local lattice kernel: the time support supplies
the remaining scale factor in blueprint `lem:absolute`, line 394. -/
theorem integerProgression_single_endpoint {d : ℕ} (T : Finset (Fin d → ℤ))
    {K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞}
    (hT : ∀ z, K z ≠ 0 → z.2 ∈ T) {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : (Fin d → ℤ) → ℝ≥0∞) (i l : ℤ) :
    (∑' z : (Fin d → ℤ) × (Fin d → ℤ), K z * f (z.1 + (i - l) • z.2)) ≤
      W * T.card * ∑' u, f u := by
  classical
  calc
    _ ≤ ∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        W * ((if z.2 ∈ T then (1 : ℝ≥0∞) else 0) * f (z.1 + (i - l) • z.2)) := by
      apply ENNReal.tsum_le_tsum
      intro z
      by_cases hz : K z = 0
      · simp [hz]
      · simp only [ite_eq_left (hT z hz), one_mul]
        exact mul_le_mul_left (hW z) _
    _ = _ := by
      rw [ENNReal.tsum_mul_left, integerProgression_time_cutoff_sum, mul_assoc]

/-- The empty lattice endpoint, with explicit cardinalities of the local
space and time boxes rather than an implicit scale constant. -/
theorem integerProgression_empty_endpoint {d : ℕ} (A T : Finset (Fin d → ℤ))
    {K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞}
    (hT : ∀ z, K z ≠ 0 → z.2 ∈ T) (i l : ℤ)
    (hA : ∀ z, K z ≠ 0 → z.1 + (i - l) • z.2 ∈ A)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) :
    (∑' z : (Fin d → ℤ) × (Fin d → ℤ), K z) ≤ W * T.card * A.card := by
  classical
  have hid (z : (Fin d → ℤ) × (Fin d → ℤ)) :
      K z * (if z.1 + (i - l) • z.2 ∈ A then (1 : ℝ≥0∞) else 0) = K z := by
    by_cases hz : K z = 0
    · simp [hz]
    · simp only [ite_eq_left (hA z hz), mul_one]
  have hsum : (∑' u, if u ∈ A then (1 : ℝ≥0∞) else 0) = A.card := by
    rw [tsum_eq_sum (s := A) (fun u hu => ite_eq_right hu)]
    simp
  simpa only [hid, hsum] using integerProgression_single_endpoint T hT hW
    (fun u => if u ∈ A then 1 else 0) i l

theorem reciprocalExponentEndpoints_support {d k : ℕ} {a : Fin d → ℝ}
    (ha : a ∈ reciprocalExponentEndpoints d k) :
    ∃ S : Finset (Fin d), S.card ≤ k ∧ ∀ i, a i = if i ∈ S then 1 else 0 := by
  classical
  let S := Finset.univ.filter (fun i => a i = 1)
  have he (i) : a i = if i ∈ S then 1 else 0 := by
    rcases ha.1 i with hi | hi <;> simp [S, hi]
  refine ⟨S, ?_, he⟩
  have hsum : ∑ i, a i = (S.card : ℝ) := by simp_rw [he]; simp
  have hbound := ha.2
  rw [hsum] at hbound
  exact_mod_cast hbound

/-- Abstract positive rank-two estimate obtained from the empty, singleton
and pair endpoints. This assembles the interpolation argument in `lem:absolute`. -/
theorem positivePairwise_power_bound {X Y : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] (μ : Measure X) (ν : Measure Y)
    {d : ℕ} (P : Fin d → X → Y) (hP : ∀ i, Measurable (P i))
    (C : ℝ≥0∞) (hempty : μ Set.univ ≤ C)
    (hsingle : ∀ i (f : Y → ℝ≥0∞), Measurable f →
      (∫⁻ x, f (P i x) ∂μ) ≤ C * ∫⁻ y, f y ∂ν)
    (hpair : ∀ i j, i ≠ j → ∀ (f g : Y → ℝ≥0∞), Measurable f → Measurable g →
      (∫⁻ x, f (P i x) * g (P j x) ∂μ) ≤ C * (∫⁻ y, f y ∂ν) * ∫⁻ y, g y ∂ν)
    (f : Fin d → Y → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    {a : Fin d → ℝ} (ha : a ∈ reciprocalExponentPolytope d 2) :
    (∫⁻ x, ∏ i, f i (P i x) ^ a i ∂μ) ≤ C * ∏ i, (∫⁻ y, f i y ∂ν) ^ a i := by
  apply positiveEndpointInterpolation μ (fun i x => f i (P i x))
    (fun i => ((hf i).comp (hP i)).aemeasurable) (fun i => ∫⁻ y, f i y ∂ν) C ?_ ha
  intro b hb
  obtain ⟨S, hS, he⟩ := reciprocalExponentEndpoints_support hb
  have hprod (v : Fin d → ℝ≥0∞) : (∏ i, v i ^ b i) = ∏ i ∈ S, v i := by
    simp_rw [he]
    simp only [apply_ite, ENNReal.rpow_one, ENNReal.rpow_zero, Finset.prod_ite_mem_eq]
  simp_rw [hprod]
  by_cases hzero : S.card = 0
  · have : S = ∅ := Finset.card_eq_zero.mp hzero
    simpa [this] using hempty
  by_cases hone : S.card = 1
  · obtain ⟨i, hi⟩ := Finset.card_eq_one.mp hone
    simpa [hi] using hsingle i (f i) (hf i)
  · obtain ⟨i, j, hij, hs⟩ := Finset.card_eq_two.mp (show S.card = 2 by omega)
    simpa [hs, hij, mul_assoc] using hpair i j hij (f i) (f j) (hf i) (hf j)

theorem quasiMeasurePreserving_of_positive_bound {X Y : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] {μ : Measure X} {ν : Measure Y}
    {P : X → Y} (hP : Measurable P) (C : ℝ≥0∞)
    (hbound : ∀ f : Y → ℝ≥0∞, Measurable f →
      (∫⁻ x, f (P x) ∂μ) ≤ C * ∫⁻ y, f y ∂ν) :
    QuasiMeasurePreserving P μ ν := by
  refine ⟨hP, Measure.absolutelyContinuous_of_le_smul (c := C) ?_⟩
  apply Measure.le_iff.mpr
  intro s hs
  have hm : Measurable (s.indicator (fun _ : Y => (1 : ℝ≥0∞))) :=
    measurable_const.indicator hs
  have h := hbound _ hm
  rw [← lintegral_map hm hP] at h
  simpa only [lintegral_indicator hs, lintegral_one, Measure.restrict_apply_univ,
    Measure.smul_apply, smul_eq_mul] using h

/-- The finite moment used for positive interpolation; an infinity slot
contributes the constant one and is bounded by its essential supremum. -/
noncomputable def interpolationMoment (p : ℝ≥0∞) (f : Y → ℝ≥0∞) : Y → ℝ≥0∞ :=
  fun y => if p = ∞ then 1 else f y ^ p.toReal

noncomputable def interpolationInfinityFactor [MeasurableSpace Y]
    (ν : Measure Y) (p : ℝ≥0∞) (f : Y → ℝ≥0∞) : ℝ≥0∞ :=
  if p = ∞ then eLpNorm f ∞ ν else 1

theorem measurable_interpolationMoment [MeasurableSpace Y] {f : Y → ℝ≥0∞}
    (hf : Measurable f) (p : ℝ≥0∞) : Measurable (interpolationMoment p f) := by
  classical
  change Measurable (fun y => if p = ∞ then (1 : ℝ≥0∞) else f y ^ p.toReal)
  by_cases hp : p = ∞
  · simp only [hp, ite_true]
    exact measurable_const
  · simpa only [ite_eq_right hp] using hf.pow_const p.toReal

theorem interpolationMoment_ae_bound [MeasurableSpace Y] (ν : Measure Y)
    (f : Y → ℝ≥0∞) {p : ℝ≥0∞} (hp : 1 ≤ p) :
    ∀ᵐ y ∂ν, f y ≤ interpolationInfinityFactor ν p f *
      interpolationMoment p f y ^ p.toReal⁻¹ := by
  classical
  by_cases htop : p = ∞
  · subst p
    simpa [interpolationMoment, interpolationInfinityFactor] using
      (enorm_ae_le_eLpNormEssSup f ν).mono (fun y hy =>
        hy.trans (eLpNormEssSup_le_eLpNorm_top))
  · have hpzero : p ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
    have hreal : p.toReal ≠ 0 := (ENNReal.toReal_pos hpzero htop).ne'
    exact Filter.Eventually.of_forall (fun y => by
      simp [interpolationMoment, interpolationInfinityFactor, htop,
        ← ENNReal.rpow_mul, mul_inv_cancel₀ hreal])

theorem interpolationMoment_norm_identity [MeasurableSpace Y] (ν : Measure Y)
    {f : Y → ℝ≥0∞} (hf : Measurable f) {p : ℝ≥0∞} (hp : 1 ≤ p) :
    interpolationInfinityFactor ν p f *
      (∫⁻ y, interpolationMoment p f y ∂ν) ^ p.toReal⁻¹ = eLpNorm f p ν := by
  classical
  by_cases htop : p = ∞
  · simp [interpolationMoment, interpolationInfinityFactor, htop]
  · have hpzero : p ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hpzero htop hf.aestronglyMeasurable]
    simp [interpolationMoment, interpolationInfinityFactor, htop, one_div]

/-- The full `Lp` version of positive rank-two interpolation, including
infinity exponents and zero or infinite norms, used in blueprint `eq:absolute`. -/
theorem positivePairwise_eLpNorm_bound {X Y : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] (μ : Measure X) (ν : Measure Y)
    {d : ℕ} (P : Fin d → X → Y) (hP : ∀ i, Measurable (P i))
    (C : ℝ≥0∞) (hempty : μ Set.univ ≤ C)
    (hsingle : ∀ i (f : Y → ℝ≥0∞), Measurable f →
      (∫⁻ x, f (P i x) ∂μ) ≤ C * ∫⁻ y, f y ∂ν)
    (hpair : ∀ i j, i ≠ j → ∀ (f g : Y → ℝ≥0∞), Measurable f → Measurable g →
      (∫⁻ x, f (P i x) * g (P j x) ∂μ) ≤ C * (∫⁻ y, f y ∂ν) * ∫⁻ y, g y ∂ν)
    (f : Fin d → Y → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    (p : Fin d → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    (∫⁻ x, ∏ i, f i (P i x) ∂μ) ≤ C * ∏ i, eLpNorm (f i) (p i) ν := by
  classical
  let g := fun i => interpolationMoment (p i) (f i)
  let B := fun i => interpolationInfinityFactor ν (p i) (f i)
  have hg (i) : Measurable (g i) := measurable_interpolationMoment (hf i) (p i)
  have ha : (fun i => (p i).toReal⁻¹) ∈ reciprocalExponentPolytope d 2 := by
    refine ⟨fun i => ⟨inv_nonneg.mpr ENNReal.toReal_nonneg, ?_⟩, ?_⟩
    · by_cases htop : p i = ∞
      · simp [htop]
      · have hreal : 1 ≤ (p i).toReal := by
          simpa using ENNReal.toReal_mono htop (hp i)
        exact (inv_le_one₀ (lt_of_lt_of_le zero_lt_one hreal)).mpr hreal
    · exact_mod_cast hsum
  have hpoint : ∀ᵐ x ∂μ, ∀ i, f i (P i x) ≤ B i * g i (P i x) ^ (p i).toReal⁻¹ := by
    rw [ae_all_iff]
    intro i
    exact (quasiMeasurePreserving_of_positive_bound (hP i) C (hsingle i)).ae
      (interpolationMoment_ae_bound ν (f i) (hp i))
  have hgm : Measurable (fun x => ∏ i, g i (P i x) ^ (p i).toReal⁻¹) :=
    Finset.measurable_fun_prod _ (fun i _ => ((hg i).comp (hP i)).pow_const _)
  calc
    _ ≤ ∫⁻ x, ∏ i, B i * g i (P i x) ^ (p i).toReal⁻¹ ∂μ :=
      lintegral_mono_ae (hpoint.mono (fun x hx => Finset.prod_le_prod (fun i _ => hx i)))
    _ = (∏ i, B i) * ∫⁻ x, ∏ i, g i (P i x) ^ (p i).toReal⁻¹ ∂μ := by
      simp_rw [Finset.prod_mul_distrib]
      exact lintegral_const_mul _ hgm
    _ ≤ (∏ i, B i) * (C * ∏ i, (∫⁻ y, g i y ∂ν) ^ (p i).toReal⁻¹) :=
      mul_le_mul_right (positivePairwise_power_bound μ ν P hP C hempty hsingle hpair g hg ha) _
    _ = C * ∏ i, B i * (∫⁻ y, g i y ∂ν) ^ (p i).toReal⁻¹ := by
      rw [Finset.prod_mul_distrib]
      ac_rfl
    _ = _ := by
      congr 1
      apply Finset.prod_congr rfl
      intro i _
      exact interpolationMoment_norm_identity ν (hf i) (hp i)

/-- Weighted version of the positive rank-two estimate. The three hypotheses
are precisely the endpoint integrals proved in the three source settings. -/
theorem positiveWeightedPairwise_eLpNorm_bound {X Y : Type*}
    [MeasurableSpace X] [MeasurableSpace Y] (μ : Measure X) (ν : Measure Y)
    {d : ℕ} (P : Fin d → X → Y) (hP : ∀ i, Measurable (P i))
    (K : X → ℝ≥0∞) (hK : Measurable K) (C : ℝ≥0∞)
    (hempty : (∫⁻ x, K x ∂μ) ≤ C)
    (hsingle : ∀ i (f : Y → ℝ≥0∞), Measurable f →
      (∫⁻ x, K x * f (P i x) ∂μ) ≤ C * ∫⁻ y, f y ∂ν)
    (hpair : ∀ i j, i ≠ j → ∀ (f g : Y → ℝ≥0∞), Measurable f → Measurable g →
      (∫⁻ x, K x * (f (P i x) * g (P j x)) ∂μ) ≤
        C * (∫⁻ y, f y ∂ν) * ∫⁻ y, g y ∂ν)
    (f : Fin d → Y → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    (p : Fin d → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    (∫⁻ x, K x * ∏ i, f i (P i x) ∂μ) ≤ C * ∏ i, eLpNorm (f i) (p i) ν := by
  have hwd (g : X → ℝ≥0∞) (hg : Measurable g) :
      (∫⁻ x, g x ∂μ.withDensity K) = ∫⁻ x, K x * g x ∂μ :=
    lintegral_withDensity_eq_lintegral_mul μ hK hg
  rw [← hwd (fun x => ∏ i, f i (P i x))
    (Finset.measurable_fun_prod _ (fun i _ => (hf i).comp (hP i)))]
  apply positivePairwise_eLpNorm_bound (μ.withDensity K) ν P hP C ?_ ?_ ?_ f hf p hp hsum
  · simpa only [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
      using hempty
  · intro i g hg
    rw [hwd (fun x => g (P i x)) (hg.comp (hP i))]
    exact hsingle i g hg
  · intro i j hij g h hg hh
    rw [hwd (fun x => g (P i x) * h (P j x)) ((hg.comp (hP i)).mul (hh.comp (hP j)))]
    exact hpair i j hij g h hg hh

/-- Blueprint `eq:absolute` on every rational connected subtorus, with the
exact multiplier constant and all exponents in `[1, ∞]`. -/
theorem rationalTorus_absoluteBound {d : ℕ} (V : Submodule ℚ (Fin d → ℚ))
    (K : (torusAnnihilator (rationalIntegerIntersection V)) ×
      (torusAnnihilator (rationalIntegerIntersection V)) → ℝ≥0∞)
    (hK : Measurable K) {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W) (l : ℤ)
    (f : Fin 4 → torusAnnihilator (rationalIntegerIntersection V) → ℝ≥0∞)
    (hf : ∀ i, Measurable (f i)) (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    (∫⁻ z, K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2)
      ∂(torusAnnihilatorHaar (rationalIntegerIntersection V)).prod
        (torusAnnihilatorHaar (rationalIntegerIntersection V))) ≤
      W * ∏ i, eLpNorm (f i) (p i) (torusAnnihilatorHaar (rationalIntegerIntersection V)) := by
  apply positiveWeightedPairwise_eLpNorm_bound _ _
    (fun i z => z.1 + ((i : ℤ) - l) • z.2) ?_ K hK W
    (rationalTorus_empty_endpoint V hW) ?_ ?_ f hf p hp hsum
  · intro i
    exact (continuous_fst.add (continuous_snd.zsmul ((i : ℤ) - l))).measurable
  · intro i g hg
    exact rationalTorus_single_endpoint V hW g hg (i : ℤ) l
  · intro i j hij g h hg hh
    exact rationalTorus_pair_endpoint V hW g h hg hh
      (by exact_mod_cast (show i.val ≠ j.val from fun h => hij (Fin.ext h))) l

/-- Blueprint `eq:absolute` on the real line: the normalized positive local
form is bounded for every exponent in `[1, ∞]` with reciprocal sum at most two.
Only boundedness and interval support of the kernel are needed. -/
theorem localProgression_absoluteBound {a r : ℝ} (hr : 0 < r)
    (K : ℝ × ℝ → ℝ≥0∞) (hK : Measurable K)
    (hsupport : HasLocalProgressionSupport a r K)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : Fin 4 → ℝ → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ENNReal.ofReal r⁻¹ ^ 2 *
      (∫⁻ z : ℝ × ℝ, K z * ∏ i, f i (realProgressionCoordinate i z)) ≤
      (2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) := by
  let R := ENNReal.ofReal r⁻¹
  have hcancel : R * ENNReal.ofReal r = 1 := by
    rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hr.le), inv_mul_cancel₀ hr.ne',
      ENNReal.ofReal_one]
  have htwo : ENNReal.ofReal (2 * r) = 2 * ENNReal.ofReal r := by
    rw [ENNReal.ofReal_mul (by norm_num)]
    norm_num
  have hnorm (g : ℝ → ℝ≥0∞) :
      (∫⁻ u, g u ∂normalizedIntervalMeasure a r) = R * ∫⁻ u in Set.Icc a (a + r), g u := by
    rw [normalizedIntervalMeasure, lintegral_smul_measure]
    rfl
  have hWtwo : W ≤ 2 * W := by
    simpa only [one_mul] using mul_le_mul_left (show (1 : ℝ≥0∞) ≤ 2 by norm_num) W
  suffices (∫⁻ z, K z * ∏ i, f i (realProgressionCoordinate i z)
      ∂(R ^ 2 • (volume : Measure (ℝ × ℝ)))) ≤
      (2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) by
    simpa only [lintegral_smul_measure, smul_eq_mul] using this
  apply positiveWeightedPairwise_eLpNorm_bound _ _ realProgressionCoordinate
    (fun i => (continuous_realProgressionCoordinate i).measurable) K hK (2 * W)
    ?_ ?_ ?_ f hf p hp hsum
  · rw [lintegral_smul_measure]
    change R ^ 2 * (∫⁻ z : ℝ × ℝ, K z) ≤ 2 * W
    calc
      _ ≤ R ^ 2 * (W * ENNReal.ofReal (2 * r) * ENNReal.ofReal r) :=
        mul_le_mul_right (localProgression_empty_endpoint hr.le hsupport hW) _
      _ = (2 * W) * (R * ENNReal.ofReal r) ^ 2 := by rw [htwo]; ring
      _ = 2 * W := by rw [hcancel]; simp
  · intro i g hg
    rw [lintegral_smul_measure, hnorm]
    change R ^ 2 * (∫⁻ z : ℝ × ℝ, K z * g (realProgressionCoordinate i z)) ≤ _
    calc
      _ ≤ R ^ 2 * (W * ENNReal.ofReal (2 * r) * ∫⁻ u in Set.Icc a (a + r), g u) :=
        mul_le_mul_right (localProgression_single_endpoint hr.le hsupport hW g hg i) _
      _ = (2 * W) * (R * ∫⁻ u in Set.Icc a (a + r), g u) *
          (R * ENNReal.ofReal r) := by rw [htwo]; ring
      _ = _ := by rw [hcancel, mul_one]
  · intro i j hij g h hg hh
    rw [lintegral_smul_measure, hnorm, hnorm]
    change R ^ 2 * (∫⁻ z : ℝ × ℝ, K z *
      (g (realProgressionCoordinate i z) * h (realProgressionCoordinate j z))) ≤ _
    calc
      _ ≤ R ^ 2 * (W * (∫⁻ u in Set.Icc a (a + r), g u) *
          ∫⁻ u in Set.Icc a (a + r), h u) :=
        mul_le_mul_right (localProgression_pair_endpoint hsupport hW g h hg hh hij) _
      _ = W * (R * ∫⁻ u in Set.Icc a (a + r), g u) *
          (R * ∫⁻ u in Set.Icc a (a + r), h u) := by ring
      _ ≤ _ := mul_le_mul_left (mul_le_mul_left hWtwo _) _

/-- Normalized counting measure at a positive lattice scale. -/
noncomputable def normalizedLatticeMeasure (d : ℕ) (N : ℝ) : Measure (Fin d → ℤ) :=
  ENNReal.ofReal N⁻¹ • Measure.count

/-- The scale-normalized lattice progression estimate, with explicit bounds
on the cardinalities of its space and time support boxes. -/
theorem integerProgression_absoluteBound_global {d : ℕ} {N : ℝ} (hN : 0 < N)
    (A T : Finset (Fin d → ℤ)) {B : ℝ≥0∞} (hB : 1 ≤ B)
    (hAcard : (A.card : ℝ≥0∞) ≤ B * ENNReal.ofReal N)
    (hTcard : (T.card : ℝ≥0∞) ≤ B * ENNReal.ofReal N)
    (K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞)
    (hT : ∀ z, K z ≠ 0 → z.2 ∈ T) (l : ℤ)
    (hA : ∀ z, K z ≠ 0 → z.1 + (0 - l) • z.2 ∈ A)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : Fin 4 → (Fin d → ℤ) → ℝ≥0∞) (p : Fin 4 → ℝ≥0∞)
    (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ENNReal.ofReal N⁻¹ ^ 2 *
      (∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2)) ≤
      (B ^ 2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedLatticeMeasure d N) := by
  let R := ENNReal.ofReal N⁻¹
  let Q := ENNReal.ofReal N
  have hcancel : R * Q = 1 := by
    rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hN.le), inv_mul_cancel₀ hN.ne',
      ENNReal.ofReal_one]
  have hAc : (A.card : ℝ≥0∞) ≤ B * Q := hAcard
  have hTc : (T.card : ℝ≥0∞) ≤ B * Q := hTcard
  have hBsquare : B ≤ B ^ 2 := by
    simpa only [one_mul, pow_two] using mul_le_mul_left hB B
  have hWb : W ≤ B ^ 2 * W := by
    simpa only [one_mul] using mul_le_mul_left (hB.trans hBsquare) W
  have hnorm (g : (Fin d → ℤ) → ℝ≥0∞) :
      (∫⁻ u, g u ∂normalizedLatticeMeasure d N) = R * ∑' u, g u := by
    rw [normalizedLatticeMeasure, lintegral_smul_measure, lintegral_count]
    rfl
  suffices (∫⁻ z, K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2)
      ∂(R ^ 2 • (Measure.count : Measure ((Fin d → ℤ) × (Fin d → ℤ))))) ≤
      (B ^ 2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedLatticeMeasure d N) by
    simpa only [lintegral_smul_measure, smul_eq_mul, lintegral_count] using this
  apply positiveWeightedPairwise_eLpNorm_bound _ _
    (fun i z => z.1 + ((i : ℤ) - l) • z.2) (fun _ => measurable_of_countable _)
    K (measurable_of_countable _) (B ^ 2 * W) ?_ ?_ ?_ f
    (fun _ => measurable_of_countable _) p hp hsum
  · rw [lintegral_smul_measure, lintegral_count]
    change R ^ 2 * (∑' z, K z) ≤ B ^ 2 * W
    calc
      _ ≤ R ^ 2 * (W * T.card * A.card) :=
        mul_le_mul_right (integerProgression_empty_endpoint A T hT 0 l hA hW) _
      _ ≤ R ^ 2 * (W * (B * Q) * (B * Q)) := by gcongr
      _ = (B ^ 2 * W) * (R * Q) ^ 2 := by ring
      _ = B ^ 2 * W := by rw [hcancel]; simp
  · intro i g hg
    rw [lintegral_smul_measure, lintegral_count, hnorm]
    change R ^ 2 * (∑' z, K z * g (z.1 + ((i : ℤ) - l) • z.2)) ≤
      (B ^ 2 * W) * (R * ∑' u, g u)
    calc
      _ ≤ R ^ 2 * (W * T.card * ∑' u, g u) :=
        mul_le_mul_right (integerProgression_single_endpoint T hT hW g (i : ℤ) l) _
      _ ≤ R ^ 2 * (W * (B * Q) * ∑' u, g u) := by gcongr
      _ = (B * W) * (R * ∑' u, g u) * (R * Q) := by ring
      _ = (B * W) * (R * ∑' u, g u) := by rw [hcancel, mul_one]
      _ ≤ _ := mul_le_mul_left (mul_le_mul_left hBsquare W) _
  · intro i j hij g h hg hh
    rw [lintegral_smul_measure, lintegral_count, hnorm, hnorm]
    change R ^ 2 * (∑' z, K z *
      (g (z.1 + ((i : ℤ) - l) • z.2) * h (z.1 + ((j : ℤ) - l) • z.2))) ≤ _
    calc
      _ ≤ R ^ 2 * (W * (∑' u, g u) * ∑' v, h v) :=
        mul_le_mul_right (integerProgression_pair_endpoint hW g h
          (by exact_mod_cast (show i.val ≠ j.val from fun h => hij (Fin.ext h))) l) _
      _ = W * (R * ∑' u, g u) * (R * ∑' v, h v) := by ring
      _ ≤ _ := mul_le_mul_left (mul_le_mul_left hWb _) _

/-- Blueprint `eq:absolute` for the actual complex local kernel and inputs.
The nonnegative integral gives the intended interpretation even for infinite norms. -/
theorem localProgression_absoluteNormBound {a r : ℝ} (hr : 0 < r)
    (w : ℝ × ℝ → ℂ) (hw : Measurable w) (hsupport : HasLocalProgressionSupport a r w)
    {W : ℝ≥0∞} (hW : ∀ z, ‖w z‖ₑ ≤ W)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ENNReal.ofReal r⁻¹ ^ 2 *
      (∫⁻ z : ℝ × ℝ, ‖w z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ) ≤
      (2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) := by
  have hs : HasLocalProgressionSupport a r (fun z => ‖w z‖ₑ) := by
    intro z hz
    exact hsupport z (fun h => hz (by simp [h]))
  have h := localProgression_absoluteBound hr (fun z => ‖w z‖ₑ) hw.enorm hs hW
    (fun i x => ‖f i x‖ₑ) (fun i => (hf i).enorm) p hp hsum
  have hn (i) : eLpNorm (fun x => ‖f i x‖ₑ) (p i) (normalizedIntervalMeasure a r) =
      eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) :=
    eLpNorm_enorm (f i) (hf i).aestronglyMeasurable
  simpa only [hn] using h

/-- Blueprint `eq:absolute` for local integer-lattice progressions, with
normalized local `Lp` norms and the explicit fixed-box constant `B² W`. -/
theorem integerProgression_absoluteBound {d : ℕ} {N : ℝ} (hN : 0 < N)
    (A T : Finset (Fin d → ℤ)) {B : ℝ≥0∞} (hB : 1 ≤ B)
    (hAcard : (A.card : ℝ≥0∞) ≤ B * ENNReal.ofReal N)
    (hTcard : (T.card : ℝ≥0∞) ≤ B * ENNReal.ofReal N)
    (K : (Fin d → ℤ) × (Fin d → ℤ) → ℝ≥0∞)
    (hT : ∀ z, K z ≠ 0 → z.2 ∈ T) (l : ℤ)
    (hA : ∀ z, K z ≠ 0 → ∀ i : Fin 4, z.1 + ((i : ℤ) - l) • z.2 ∈ A)
    {W : ℝ≥0∞} (hW : ∀ z, K z ≤ W)
    (f : Fin 4 → (Fin d → ℤ) → ℝ≥0∞) (p : Fin 4 → ℝ≥0∞)
    (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ENNReal.ofReal N⁻¹ ^ 2 *
      (∑' z : (Fin d → ℤ) × (Fin d → ℤ),
        K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2)) ≤
      (B ^ 2 * W) * ∏ i, eLpNorm (f i) (p i)
        ((normalizedLatticeMeasure d N).restrict (A : Set (Fin d → ℤ))) := by
  classical
  let F := fun i => (A : Set (Fin d → ℤ)).indicator (f i)
  have hid (z : (Fin d → ℤ) × (Fin d → ℤ)) :
      K z * ∏ i, F i (z.1 + ((i : ℤ) - l) • z.2) =
        K z * ∏ i, f i (z.1 + ((i : ℤ) - l) • z.2) := by
    by_cases hz : K z = 0
    · simp [hz]
    · congr 1
      apply Finset.prod_congr rfl
      intro i _
      exact Set.indicator_of_mem (hA z hz i) (f i)
  have hn (i) : eLpNorm (F i) (p i) (normalizedLatticeMeasure d N) =
      eLpNorm (f i) (p i)
        ((normalizedLatticeMeasure d N).restrict (A : Set (Fin d → ℤ))) :=
    eLpNorm_indicator_eq_eLpNorm_restrict A.measurableSet.nullMeasurableSet
  have h := integerProgression_absoluteBound_global hN A T hB hAcard hTcard K hT l
    (fun z hz => by simpa only [Fin.val_zero, Nat.cast_zero] using hA z hz 0) hW F p hp hsum
  simpa only [hid, hn] using h

/-- The complex local form is controlled by the positive local estimate.
This is the form of `lem:absolute` used in `lem:finite-CN`. -/
theorem localProgressionForm_enorm_le {a r : ℝ} (hr : 0 < r)
    (w : ℝ × ℝ → ℂ) (hw : Measurable w) (hsupport : HasLocalProgressionSupport a r w)
    {W : ℝ≥0∞} (hW : ∀ z, ‖w z‖ₑ ≤ W)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i)
    (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ‖localProgressionForm r w f‖ₑ ≤
      (2 * W) * ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) := by
  have hc : ‖(r : ℂ)⁻¹ ^ 2‖ₑ = ENNReal.ofReal r⁻¹ ^ 2 := by
    simp only [← ofReal_norm, norm_pow, norm_inv, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hr]
    exact ENNReal.ofReal_pow (inv_nonneg.mpr hr.le) 2
  have hn (z : ℝ × ℝ) : ‖w z * ∏ i, f i (realProgressionCoordinate i z)‖ₑ =
      ‖w z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ := by
    simp only [← ofReal_norm, norm_mul, norm_prod,
      ENNReal.ofReal_mul (norm_nonneg _),
      ENNReal.ofReal_prod_of_nonneg (fun _ _ => norm_nonneg _)]
  rw [localProgressionForm, enorm_mul, hc]
  calc
    _ ≤ ENNReal.ofReal r⁻¹ ^ 2 *
        ∫⁻ z : ℝ × ℝ, ‖w z * ∏ i, f i (realProgressionCoordinate i z)‖ₑ :=
      mul_le_mul_right (enorm_integral_le_lintegral_enorm _) _
    _ = ENNReal.ofReal r⁻¹ ^ 2 *
        ∫⁻ z : ℝ × ℝ, ‖w z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ := by
      simp_rw [hn]
    _ ≤ _ := localProgression_absoluteNormBound hr w hw hsupport hW f hf p hp hsum

/-- The uncentered Hardy–Littlewood maximal operator specified at blueprint
line 67, using nondegenerate intervals containing the evaluation point. -/
noncomputable def uncenteredRealMaximal {E : Type*} [NormedAddCommGroup E]
    (f : ℝ → E) (x : ℝ) : ℝ≥0∞ :=
  ⨆ (a : ℝ) (b : ℝ) (_ : a < b) (_ : x ∈ Set.Icc a b),
    (ENNReal.ofReal (b - a))⁻¹ * ∫⁻ y in Set.Icc a b, ‖f y‖ₑ

theorem real_intervalAverage_le_two_centered {E : Type*} [NormedAddCommGroup E]
    (f : ℝ → E) {a b x : ℝ} (hab : a < b) (hx : x ∈ Set.Icc a b) :
    (ENNReal.ofReal (b - a))⁻¹ * (∫⁻ y in Set.Icc a b, ‖f y‖ₑ) ≤
      2 * hlMaximal volume f x := by
  have hr : 0 < b - a := sub_pos.mpr hab
  have hsub : Set.Icc a b ⊆ Metric.closedBall x (b - a) := by
    intro y hy
    rw [Metric.mem_closedBall, Real.dist_eq]
    exact abs_le.mpr ⟨by linarith [hy.1, hx.2], by linarith [hy.2, hx.1]⟩
  have hcoeff : (ENNReal.ofReal (b - a))⁻¹ =
      2 * (ENNReal.ofReal (2 * (b - a)))⁻¹ := by
    calc
      _ = ENNReal.ofReal (b - a)⁻¹ := (ENNReal.ofReal_inv_of_pos hr).symm
      _ = ENNReal.ofReal (2 * (2 * (b - a))⁻¹) := by
        congr 1
        field_simp
      _ = _ := by
        rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_inv_of_pos (by positivity)]
        norm_num
  calc
    _ ≤ (ENNReal.ofReal (b - a))⁻¹ *
        ∫⁻ y in Metric.closedBall x (b - a), ‖f y‖ₑ :=
      mul_le_mul_right (lintegral_mono_set hsub) _
    _ = 2 * hlBallAverage volume f x (b - a) := by
      rw [hcoeff, hlBallAverage, Real.volume_closedBall, mul_assoc]
    _ ≤ _ := mul_le_mul_right (hlBallAverage_le_hlMaximal volume f x (b - a)) 2

/-- The uncentered maximal operator is at most twice the centered one. -/
theorem uncenteredRealMaximal_le_two_centered {E : Type*} [NormedAddCommGroup E]
    (f : ℝ → E) (x : ℝ) : uncenteredRealMaximal f x ≤ 2 * hlMaximal volume f x := by
  refine iSup_le (fun a => iSup_le (fun b => iSup_le (fun hab => iSup_le (fun hx => ?_))))
  exact real_intervalAverage_le_two_centered f hab hx

theorem mixedENorm_const_mul {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω]
    (μ : Measure X) (ν : Measure Ω) {p s : ℝ} (hp : 0 < p) (hs : 0 < s)
    (c : ℝ≥0∞) (hc : c ≠ ∞) (f : X × Ω → ℝ≥0∞) :
    mixedENorm μ ν p s (fun z => c * f z) = c * mixedENorm μ ν p s f := by
  have hcs : c ^ s ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg hs.le hc
  have hcsp : c ^ (s * (p / s)) ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (mul_nonneg hs.le (div_nonneg hp.le hs.le)) hc
  simp_rw [mixedENorm, ENNReal.mul_rpow_of_nonneg _ _ hs.le,
    lintegral_const_mul' _ _ hcs,
    ENNReal.mul_rpow_of_nonneg _ _ (div_nonneg hp.le hs.le), ← ENNReal.rpow_mul,
    lintegral_const_mul' _ _ hcsp,
    ENNReal.mul_rpow_of_nonneg _ _ (one_div_nonneg.mpr hp.le), ← ENNReal.rpow_mul]
  rw [show s * (p / s) * (1 / p) = 1 by field_simp, ENNReal.rpow_one]

/-- The blueprint's powered uncentered maximal function, with the convention
specified at source line 67 and used in `lem:vector-maximal` and `eq:CN`. -/
noncomputable def maximalQ {Ω : Type*} (q : ℝ) (f : ℝ × Ω → ℂ)
    (z : ℝ × Ω) : ℝ≥0∞ :=
  uncenteredRealMaximal (fun y => ‖f (y, z.2)‖ ^ q) z.1 ^ (1 / q)

theorem maximalQ_le_centered {Ω : Type*} {q : ℝ} (hq : 0 < q)
    (f : ℝ × Ω → ℂ) (z : ℝ × Ω) :
    maximalQ q f z ≤ (2 : ℝ≥0∞) ^ (1 / q) * centeredMaximalQ q f z := by
  change uncenteredRealMaximal (fun y => ‖f (y, z.2)‖ ^ q) z.1 ^ (1 / q) ≤
    (2 : ℝ≥0∞) ^ (1 / q) *
      hlMaximal volume (fun y => ‖f (y, z.2)‖ ^ q) z.1 ^ (1 / q)
  exact (ENNReal.rpow_le_rpow (uncenteredRealMaximal_le_two_centered _ _)
    (one_div_nonneg.mpr hq.le)).trans_eq
      (ENNReal.mul_rpow_of_nonneg _ _ (one_div_nonneg.mpr hq.le))

/-- Blueprint `lem:vector-maximal`, lines 240–251: the source's uncentered
`M_q` is bounded on `L^p(ℝ; L^4(Ω))`, uniformly over all finite inner measure spaces. -/
theorem oneMixedNorm (p q : ℝ) (hq2 : 2 < q) (hq3 : q < 3) (hpq : q < p) :
    ∃ C : NNReal, ∀ {Ω : Type*} [MeasurableSpace Ω] (ν : Measure Ω) [IsFiniteMeasure ν]
      (f : ℝ × Ω → ℂ), Measurable f →
        mixedENorm volume ν p 4 (maximalQ q f) ≤
          C * mixedENorm volume ν p 4 (fun z => ‖f z‖ₑ) := by
  have hq : 0 < q := by linarith
  have hp : 0 < p := hq.trans hpq
  obtain ⟨C, hC⟩ := centeredOneMixedNorm p q hq2 hq3 hpq
  let D : ℝ≥0∞ := 2 ^ (1 / q)
  have hD : D ≠ ∞ := ENNReal.rpow_ne_top_of_nonneg (by positivity) (by norm_num)
  refine ⟨D.toNNReal * C, ?_⟩
  intro Ω _ ν _ f hf
  rw [ENNReal.coe_mul, ENNReal.coe_toNNReal hD]
  calc
    _ ≤ mixedENorm volume ν p 4 (fun z => D * centeredMaximalQ q f z) :=
      mixedENorm_mono volume ν hp (by norm_num) (fun z => maximalQ_le_centered hq f z)
    _ = D * mixedENorm volume ν p 4 (centeredMaximalQ q f) :=
      mixedENorm_const_mul volume ν hp (by norm_num) D hD _
    _ ≤ D * (C * mixedENorm volume ν p 4 (fun z => ‖f z‖ₑ)) :=
      mul_le_mul_right (hC ν f hf) D
    _ = _ := (mul_assoc _ _ _).symm

/-- Fixed constants defining the admissible kernel class, blueprint line 371. -/
structure LocalKernelClass where
  margin : ℝ
  margin_pos : 0 < margin
  derivativeConstant : ℝ
  one_le_derivativeConstant : 1 ≤ derivativeConstant

/-- Coordinate partial derivative of a local kernel. This keeps the source's
total-order derivative convention rather than replacing it by an operator norm. -/
noncomputable def localKernelPartial (m n : ℕ) (w : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  iteratedDeriv m (fun x => iteratedDeriv n (fun t => w (x, t)) z.2) z.1

/-- Smoothness, interior support, four zero marginals, and the quantitative
derivative bounds in blueprint `eq:local` and `eq:marginals`, lines 371–376. -/
structure IsAdmissibleLocalKernel (κ : LocalKernelClass) (a r : ℝ)
    (w : ℝ × ℝ → ℂ) : Prop where
  smooth : ContDiff ℝ (⊤ : ℕ∞) w
  support : ∀ z, w z ≠ 0 → ∀ j : Fin 4,
    a + κ.margin * r ≤ realProgressionCoordinate j z ∧
      realProgressionCoordinate j z ≤ a + r - κ.margin * r
  marginal : ∀ (u : ℝ) (j : Fin 4), ∫ t : ℝ, w (u - (j : ℝ) * t, t) = 0
  derivativeBound : ∀ (m n : ℕ) (z : ℝ × ℝ),
    ‖localKernelPartial m n w z‖ ≤ r⁻¹ ^ (m + n) *
      (κ.derivativeConstant * ((m + n : ℕ) + 2)) ^
        (κ.derivativeConstant * ((m + n : ℕ) + 2))

noncomputable def localKernelSupBound (κ : LocalKernelClass) : ℝ :=
  (κ.derivativeConstant * 2) ^ (κ.derivativeConstant * 2)

theorem localKernelSupBound_nonneg (κ : LocalKernelClass) : 0 ≤ localKernelSupBound κ :=
  Real.rpow_nonneg (by nlinarith [κ.one_le_derivativeConstant]) _

theorem admissibleLocalKernel_norm_le {κ : LocalKernelClass} {a r : ℝ}
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w) (z : ℝ × ℝ) :
    ‖w z‖ ≤ localKernelSupBound κ := by
  simpa [localKernelPartial, localKernelSupBound] using hw.derivativeBound 0 0 z

theorem admissibleLocalKernel_support {κ : LocalKernelClass} {a r : ℝ} (hr : 0 ≤ r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w) :
    HasLocalProgressionSupport a r w := by
  intro z hz j
  have h := hw.support z hz j
  have hc := mul_nonneg κ.margin_pos.le hr
  constructor <;> linarith

/-- The scalar specialization of the source's uncentered powered maximal function. -/
noncomputable def scalarMaximalQ (q : ℝ) (f : ℝ → ℂ) (x : ℝ) : ℝ≥0∞ :=
  maximalQ q (fun z : ℝ × Unit => f z.1) (x, ())

/-- The complete finite data quantified over by blueprint `eq:CN`: one
dyadic grid, a finite collection in at most `N` consecutive depths, an admissible
kernel at every selected cell, and compactly supported measurable `Lq` inputs. -/
structure FiniteDepthLocalData (κ : LocalKernelClass) (q : ℝ) (N : ℕ) where
  grid : RealDyadicGrid
  cells : Finset (ℤ × ℤ)
  firstDepth : ℤ
  depths : ∀ c ∈ cells, firstDepth ≤ c.1 ∧ c.1 < firstDepth + N
  kernel : (ℤ × ℤ) → ℝ × ℝ → ℂ
  admissible : ∀ c ∈ cells, IsAdmissibleLocalKernel κ
    (dyadicGridLeft grid c.1 c.2) (dyadicGridLength grid c.1) (kernel c)
  input : Fin 4 → ℝ → ℂ
  measurable_input : ∀ i, Measurable (input i)
  memLp_input : ∀ i, MemLp (input i) (ENNReal.ofReal q) volume
  compact_input : ∀ i, HasCompactSupport (input i)

/-- The finite numerator in blueprint `eq:CN`. -/
noncomputable def finiteDepthNumerator {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) : ℝ :=
  ∑ c ∈ D.cells, dyadicGridLength D.grid c.1 *
    ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖

/-- The nonnegative maximal-product denominator in blueprint `eq:CN`. -/
noncomputable def finiteDepthDenominator {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) : ℝ≥0∞ :=
  ∫⁻ x : ℝ, ∏ i, scalarMaximalQ q (D.input i) x

/-- Only strictly positive finite denominators enter the real ratios in
blueprint `eq:CN`, lines 398–403. -/
def finiteDepthRatios (κ : LocalKernelClass) (q : ℝ) (N : ℕ) : Set ℝ :=
  {c | ∃ D : FiniteDepthLocalData κ q N, 0 < finiteDepthDenominator D ∧
    finiteDepthDenominator D ≠ ∞ ∧ c = finiteDepthNumerator D / (finiteDepthDenominator D).toReal}

/-- The least constant at least one from blueprint `eq:CN`. Inserting one
before the supremum includes the empty-ratio case without a division convention. -/
noncomputable def finiteDepthConstant (κ : LocalKernelClass) (q : ℝ) (N : ℕ) : ℝ :=
  sSup (insert 1 (finiteDepthRatios κ q N))

theorem finiteDepthNumerator_nonneg {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) : 0 ≤ finiteDepthNumerator D := by
  apply Finset.sum_nonneg
  intro c _
  exact mul_nonneg (dyadicGridLength_pos D.grid c.1).le (norm_nonneg _)

/-- Every normalized local `Lq` norm is bounded by the source's uncentered
`M_q` at every point of the interval, as used in `lem:finite-CN`, line 409. -/
theorem localLpNorm_le_scalarMaximalQ {a r x q : ℝ} (hr : 0 < r) (hq : 0 < q)
    (hx : x ∈ Set.Icc a (a + r)) (f : ℝ → ℂ) (hf : Measurable f) :
    eLpNorm f (ENNReal.ofReal q) (normalizedIntervalMeasure a r) ≤ scalarMaximalQ q f x := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ne_of_gt (ENNReal.ofReal_pos.mpr hq)) ENNReal.ofReal_ne_top hf.aestronglyMeasurable]
  simp only [ENNReal.toReal_ofReal hq.le, normalizedIntervalMeasure, lintegral_smul_measure,
    smul_eq_mul, scalarMaximalQ, maximalQ]
  apply ENNReal.rpow_le_rpow _ (one_div_nonneg.mpr hq.le)
  have hgn (y : ℝ) : ‖‖f y‖ ^ q‖ₑ = ‖f y‖ₑ ^ q := by
    rw [Real.enorm_eq_ofReal (Real.rpow_nonneg (norm_nonneg _) _),
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le, ofReal_norm]
  change ENNReal.ofReal r⁻¹ * (∫⁻ y in Set.Icc a (a + r), ‖f y‖ₑ ^ q) ≤
    uncenteredRealMaximal (fun y => ‖f y‖ ^ q) x
  calc
    _ = (ENNReal.ofReal ((a + r) - a))⁻¹ *
        ∫⁻ y in Set.Icc a (a + r), ‖‖f y‖ ^ q‖ₑ := by
      simp_rw [hgn]
      rw [add_sub_cancel_left, ENNReal.ofReal_inv_of_pos hr]
    _ ≤ _ := by
      unfold uncenteredRealMaximal
      refine le_iSup_of_le a ?_
      refine le_iSup_of_le (a + r) ?_
      refine le_iSup_of_le (show a < a + r by linarith) ?_
      refine le_iSup_of_le hx ?_
      exact le_rfl

/-- The uniform real constant furnished by the fixed admissible kernel class. -/
noncomputable def localFormUniformConstant (κ : LocalKernelClass) : ℝ :=
  2 * localKernelSupBound κ

theorem localFormUniformConstant_nonneg (κ : LocalKernelClass) :
    0 ≤ localFormUniformConstant κ := mul_nonneg (by norm_num) (localKernelSupBound_nonneg κ)

/-- The local `L2` estimate followed by normalized exponent monotonicity,
the first step of blueprint `lem:finite-CN`, line 409. -/
theorem admissibleLocalForm_le_localLp {κ : LocalKernelClass} {a r q : ℝ}
    (hr : 0 < r) (hq : 2 ≤ q) {w : ℝ × ℝ → ℂ}
    (hw : IsAdmissibleLocalKernel κ a r w) (f : Fin 4 → ℝ → ℂ)
    (hf : ∀ i, Measurable (f i)) :
    ‖localProgressionForm r w f‖ₑ ≤ ENNReal.ofReal (localFormUniformConstant κ) *
      ∏ i, eLpNorm (f i) (ENNReal.ofReal q) (normalizedIntervalMeasure a r) := by
  let : IsProbabilityMeasure (normalizedIntervalMeasure a r) :=
    normalizedIntervalMeasure_probability a hr
  have hW (z) : ‖w z‖ₑ ≤ ENNReal.ofReal (localKernelSupBound κ) := by
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (admissibleLocalKernel_norm_le hw z)
  have h := localProgressionForm_enorm_le hr w hw.smooth.continuous.measurable
    (admissibleLocalKernel_support hr.le hw) hW f hf (fun _ => 2)
    (by norm_num) (by norm_num [Fin.sum_univ_succ])
  have htwo : (2 : ℝ≥0∞) ≤ ENNReal.ofReal q := by
    exact_mod_cast ENNReal.ofReal_le_ofReal hq
  have hc : (2 : ℝ≥0∞) * ENNReal.ofReal (localKernelSupBound κ) =
      ENNReal.ofReal (localFormUniformConstant κ) := by
    rw [localFormUniformConstant, ENNReal.ofReal_mul (by norm_num)]
    norm_num
  rw [hc] at h
  exact h.trans (mul_le_mul_right
    (Finset.prod_le_prod (fun i _ => eLpNorm_le_eLpNorm_of_exponent_le htwo)) _)

/-- The source local form is bounded pointwise on its interval by the product
of the four uncentered maximal functions. -/
theorem admissibleLocalForm_le_maximalProduct {κ : LocalKernelClass} {a r q x : ℝ}
    (hr : 0 < r) (hq : 2 ≤ q) (hx : x ∈ Set.Icc a (a + r))
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ i, Measurable (f i)) :
    ‖localProgressionForm r w f‖ₑ ≤ ENNReal.ofReal (localFormUniformConstant κ) *
      ∏ i, scalarMaximalQ q (f i) x :=
  (admissibleLocalForm_le_localLp hr hq hw f hf).trans
    (mul_le_mul_right (Finset.prod_le_prod (fun i _ =>
      localLpNorm_le_scalarMaximalQ hr (by linarith) hx (f i) (hf i))) _)

theorem finiteDepth_cell_bound {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (hq : 2 ≤ q) {c : ℤ × ℤ} (hc : c ∈ D.cells) :
    ENNReal.ofReal (dyadicGridLength D.grid c.1) *
      ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ ≤
      ENNReal.ofReal (localFormUniformConstant κ) *
        ∫⁻ x in dyadicGridCell D.grid c.1 c.2, ∏ i, scalarMaximalQ q (D.input i) x := by
  let H := ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ
  calc
    _ = ∫⁻ _x in dyadicGridCell D.grid c.1 c.2, H := by
      rw [setLIntegral_const, dyadicGridCell_volume]
      exact mul_comm _ _
    _ ≤ ∫⁻ x in dyadicGridCell D.grid c.1 c.2,
        ENNReal.ofReal (localFormUniformConstant κ) * ∏ i, scalarMaximalQ q (D.input i) x := by
      apply setLIntegral_mono' (dyadicGridCell_measurable D.grid c.1 c.2)
      intro x hx
      exact admissibleLocalForm_le_maximalProduct (dyadicGridLength_pos D.grid c.1) hq
        ⟨hx.1, hx.2.le⟩ (D.admissible c hc) D.input D.measurable_input
    _ = _ := lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

theorem finiteDepth_one_level_bound {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (hq : 2 ≤ q) (s : ℤ) :
    (∑ c ∈ D.cells.filter (fun c => c.1 = s),
      ENNReal.ofReal (dyadicGridLength D.grid c.1) *
        ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ) ≤
      ENNReal.ofReal (localFormUniformConstant κ) * finiteDepthDenominator D := by
  classical
  let S := D.cells.filter (fun c => c.1 = s)
  have hd : Set.PairwiseDisjoint (S : Set (ℤ × ℤ))
      (fun c => dyadicGridCell D.grid c.1 c.2) := by
    intro c hc c' hc' hne
    have hcS := (Finset.mem_filter.mp hc).2
    have hcS' := (Finset.mem_filter.mp hc').2
    change Disjoint (dyadicGridCell D.grid c.1 c.2) (dyadicGridCell D.grid c'.1 c'.2)
    rw [hcS, hcS']
    apply dyadicGridCell_pairwiseDisjoint D.grid s
    intro he
    exact hne (Prod.ext (hcS.trans hcS'.symm) he)
  calc
    _ ≤ ∑ c ∈ S, ENNReal.ofReal (localFormUniformConstant κ) *
        ∫⁻ x in dyadicGridCell D.grid c.1 c.2, ∏ i, scalarMaximalQ q (D.input i) x :=
      Finset.sum_le_sum (fun c hc => finiteDepth_cell_bound D hq (Finset.mem_filter.mp hc).1)
    _ = ENNReal.ofReal (localFormUniformConstant κ) *
        ∫⁻ x in ⋃ c ∈ S, dyadicGridCell D.grid c.1 c.2,
          ∏ i, scalarMaximalQ q (D.input i) x := by
      rw [lintegral_biUnion_finset hd
        (fun c _ => dyadicGridCell_measurable D.grid c.1 c.2), Finset.mul_sum]
    _ ≤ _ := mul_le_mul_right (lintegral_mono' Measure.restrict_le_self le_rfl) _

theorem finiteDepthNumerator_ofReal {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) :
    ENNReal.ofReal (finiteDepthNumerator D) = ∑ c ∈ D.cells,
      ENNReal.ofReal (dyadicGridLength D.grid c.1) *
        ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ := by
  unfold finiteDepthNumerator
  rw [ENNReal.ofReal_sum_of_nonneg (fun c _ =>
    mul_nonneg (dyadicGridLength_pos D.grid c.1).le (norm_nonneg _))]
  apply Finset.sum_congr rfl
  intro c _
  rw [ENNReal.ofReal_mul (dyadicGridLength_pos D.grid c.1).le, ofReal_norm]

/-- Blueprint `lem:finite-CN`, line 409: disjoint depth summation gives the
uniform linear-in-depth bound before the absorption argument begins. -/
theorem finiteDepthNumerator_le {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (hq : 2 ≤ q) :
    ENNReal.ofReal (finiteDepthNumerator D) ≤
      ENNReal.ofReal (localFormUniformConstant κ * N) * finiteDepthDenominator D := by
  classical
  let T : Finset ℤ := Finset.Ico D.firstDepth (D.firstDepth + N)
  let w := fun c : ℤ × ℤ => ENNReal.ofReal (dyadicGridLength D.grid c.1) *
    ‖localProgressionForm (dyadicGridLength D.grid c.1) (D.kernel c) D.input‖ₑ
  have hmem (c) (hc : c ∈ D.cells) : c.1 ∈ T := Finset.mem_Ico.mpr (D.depths c hc)
  have hcard : T.card = N := by simp [T, Int.card_Ico]
  have hpartition : (∑ s ∈ T, ∑ c ∈ D.cells.filter (fun c => c.1 = s), w c) =
      ∑ c ∈ D.cells, w c := by
    simp_rw [Finset.sum_filter]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro c hc
    simp [hmem c hc]
  rw [finiteDepthNumerator_ofReal]
  change (∑ c ∈ D.cells, w c) ≤ _
  rw [← hpartition]
  calc
    _ ≤ ∑ _s ∈ T, ENNReal.ofReal (localFormUniformConstant κ) * finiteDepthDenominator D :=
      Finset.sum_le_sum (fun s _ => finiteDepth_one_level_bound D hq s)
    _ = (N : ℝ≥0∞) * (ENNReal.ofReal (localFormUniformConstant κ) * finiteDepthDenominator D) := by
      rw [Finset.sum_const, nsmul_eq_mul, hcard]
    _ = _ := by
      rw [ENNReal.ofReal_mul (localFormUniformConstant_nonneg κ)]
      simp only [ENNReal.ofReal_natCast]
      ac_rfl

theorem finiteDepth_ratio_le {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (D : FiniteDepthLocalData κ q N) (hq : 2 ≤ q)
    (hpos : 0 < finiteDepthDenominator D) (hfin : finiteDepthDenominator D ≠ ∞) :
    finiteDepthNumerator D / (finiteDepthDenominator D).toReal ≤
      localFormUniformConstant κ * N := by
  have hp : 0 < (finiteDepthDenominator D).toReal :=
    ENNReal.toReal_pos hpos.ne' hfin
  apply (div_le_iff₀ hp).mpr
  have h := ENNReal.toReal_mono
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hfin) (finiteDepthNumerator_le D hq)
  simpa only [ENNReal.toReal_mul,
    ENNReal.toReal_ofReal (finiteDepthNumerator_nonneg D),
    ENNReal.toReal_ofReal (mul_nonneg (localFormUniformConstant_nonneg κ)
      (Nat.cast_nonneg N))] using h

theorem finiteDepthRatios_bddAbove (κ : LocalKernelClass) {q : ℝ} (hq : 2 ≤ q)
    (N : ℕ) : BddAbove (insert 1 (finiteDepthRatios κ q N)) := by
  refine ⟨1 + localFormUniformConstant κ * N, ?_⟩
  intro c hc
  rcases Set.mem_insert_iff.mp hc with rfl | ⟨D, hp, hf, rfl⟩
  · exact le_add_of_nonneg_right (mul_nonneg (localFormUniformConstant_nonneg κ)
      (Nat.cast_nonneg N))
  · exact (finiteDepth_ratio_le D hq hp hf).trans (by linarith)

/-- Blueprint `eq:CN` and `lem:finite-CN`: the real supremum is bounded,
and the inserted value one enforces the required normalization. -/
theorem finiteDepthConstant_bounds (κ : LocalKernelClass) {q : ℝ} (hq : 2 ≤ q)
    (N : ℕ) : 1 ≤ finiteDepthConstant κ q N ∧
      finiteDepthConstant κ q N ≤ 1 + localFormUniformConstant κ * N := by
  constructor
  · exact le_csSup (finiteDepthRatios_bddAbove κ hq N) (Set.mem_insert 1 _)
  · apply csSup_le (Set.insert_nonempty 1 _)
    intro c hc
    rcases Set.mem_insert_iff.mp hc with rfl | ⟨D, hp, hf, rfl⟩
    · exact le_add_of_nonneg_right (mul_nonneg (localFormUniformConstant_nonneg κ)
        (Nat.cast_nonneg N))
    · exact (finiteDepth_ratio_le D hq hp hf).trans (by linarith)

/-- Blueprint `eq:CN`: the defining inequality holds at the real supremum,
including zero and infinite denominator cases. -/
theorem finiteDepthConstant_spec {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    (hq : 2 ≤ q) (D : FiniteDepthLocalData κ q N) :
    ENNReal.ofReal (finiteDepthNumerator D) ≤
      ENNReal.ofReal (finiteDepthConstant κ q N) * finiteDepthDenominator D := by
  have hC : 0 < finiteDepthConstant κ q N :=
    lt_of_lt_of_le zero_lt_one (finiteDepthConstant_bounds κ hq N).1
  by_cases hz : finiteDepthDenominator D = 0
  · simpa only [hz, mul_zero] using finiteDepthNumerator_le D hq
  by_cases ht : finiteDepthDenominator D = ∞
  · rw [ht, ENNReal.mul_top (ENNReal.ofReal_pos.mpr hC).ne']
    exact le_top
  have hp : 0 < (finiteDepthDenominator D).toReal := ENNReal.toReal_pos hz ht
  have hr : finiteDepthNumerator D / (finiteDepthDenominator D).toReal ≤
      finiteDepthConstant κ q N :=
    le_csSup (finiteDepthRatios_bddAbove κ hq N)
      (Set.mem_insert_of_mem 1 ⟨D, bot_lt_iff_ne_bot.mpr hz, ht, rfl⟩)
  have h := ENNReal.ofReal_le_ofReal ((div_le_iff₀ hp).mp hr)
  rwa [ENNReal.ofReal_mul hC.le, ENNReal.ofReal_toReal ht] at h

/-- Blueprint `eq:CN`: every admissible real constant at least one majorizes
the constructed constant. -/
theorem finiteDepthConstant_least {κ : LocalKernelClass} {q : ℝ} {N : ℕ}
    {c : ℝ} (hc : 1 ≤ c)
    (hbound : ∀ D : FiniteDepthLocalData κ q N,
      ENNReal.ofReal (finiteDepthNumerator D) ≤
        ENNReal.ofReal c * finiteDepthDenominator D) :
    finiteDepthConstant κ q N ≤ c := by
  apply csSup_le (Set.insert_nonempty 1 _)
  intro b hb
  rcases Set.mem_insert_iff.mp hb with rfl | ⟨D, hp, ht, rfl⟩
  · exact hc
  · apply (div_le_iff₀ (ENNReal.toReal_pos hp.ne' ht)).mpr
    have h := ENNReal.toReal_mono
      (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ht) (hbound D)
    simpa only [ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (finiteDepthNumerator_nonneg D),
      ENNReal.toReal_ofReal (le_trans zero_le_one hc)] using h

/-- Blueprint `lem:finite-CN`, lines 405–411: for every source exponent and
positive depth, the normalized least constant is finite, at most `1 + C N`,
and satisfies its defining inequality for all admissible data. -/
theorem finiteDepthConstant_finite (κ : LocalKernelClass) {q : ℝ}
    (hq : 2 < q ∧ q < 3) (N : ℕ) (_hN : 0 < N) :
    (1 ≤ finiteDepthConstant κ q N ∧
      finiteDepthConstant κ q N ≤ 1 + localFormUniformConstant κ * N) ∧
    (∀ D : FiniteDepthLocalData κ q N,
      ENNReal.ofReal (finiteDepthNumerator D) ≤
        ENNReal.ofReal (finiteDepthConstant κ q N) * finiteDepthDenominator D) ∧
    (∀ c : ℝ, 1 ≤ c →
      (∀ D : FiniteDepthLocalData κ q N, ENNReal.ofReal (finiteDepthNumerator D) ≤
        ENNReal.ofReal c * finiteDepthDenominator D) → finiteDepthConstant κ q N ≤ c) :=
  ⟨finiteDepthConstant_bounds κ hq.1.le N,
    finiteDepthConstant_spec hq.1.le, fun _ => finiteDepthConstant_least⟩

end Auto
