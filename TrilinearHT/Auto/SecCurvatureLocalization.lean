/-- The alternating form `α_C(x, y) = xᵀ C y - yᵀ C x` of a rational matrix. -/
noncomputable def chartAltForm {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) (x y : Fin d → ℝ) : ℝ :=
  chartMatrixPhase C x y - chartMatrixPhase C y x

theorem norm_euclidean_fin_one (x : EuclideanSpace ℝ (Fin 1)) : ‖x‖ = |x 0| := by
  rw [EuclideanSpace.norm_eq, Fin.sum_univ_one, Real.norm_eq_abs, sq_abs, Real.sqrt_sq_eq_abs]

theorem norm_realMatrixOperator_col {d : ℕ} (A : Matrix (Fin d) (Fin 1) ℝ) :
    ‖realMatrixOperator A‖ = ‖WithLp.toLp 2 (fun i => A i 0)‖ := by
  have happ : ∀ x : EuclideanSpace ℝ (Fin 1),
      realMatrixOperator A x = x 0 • WithLp.toLp 2 (fun i => A i 0) := by
    intro x; ext i
    simp [realMatrixOperator, Matrix.toEuclideanLin, Matrix.mulVec, dotProduct, mul_comm]
  apply le_antisymm
  · refine ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg _) fun x => ?_
    rw [happ, norm_smul, norm_euclidean_fin_one x, Real.norm_eq_abs, mul_comm]
  · have he := realMatrixOperator_basis_apply A 0
    have hn := (realMatrixOperator A).le_opNorm (EuclideanSpace.basisFun (Fin 1) ℝ 0)
    rw [he] at hn
    have h1 : ‖EuclideanSpace.basisFun (Fin 1) ℝ 0‖ = 1 := by simp
    rw [h1, mul_one] at hn
    exact hn

theorem norm_realMatrixOperator_one_one (M : Matrix (Fin 1) (Fin 1) ℝ) :
    ‖realMatrixOperator M‖ = |M 0 0| := by
  rw [norm_realMatrixOperator_col, norm_euclidean_fin_one]

theorem chartMatrixPhase_eq_sum {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) (x y : Fin d → ℝ) :
    chartMatrixPhase C x y = x ⬝ᵥ ((C.map (fun q => (q : ℝ))).mulVec y) := by
  simp only [chartMatrixPhase, dotProduct, Matrix.mulVec, Finset.mul_sum, Matrix.map_apply]
  apply Finset.sum_congr rfl; intro i _; apply Finset.sum_congr rfl; intro j _; ring

theorem inner_realMatrixOperator_alt {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (x y : EuclideanSpace ℝ (Fin d)) :
    inner ℝ y (realMatrixOperator ((C.map (fun q => (q : ℝ))) - (C.map (fun q => (q :
        ℝ))).transpose)
      x) = chartAltForm C y.ofLp x.ofLp := by
  rw [EuclideanSpace.inner_eq_star_dotProduct, star_trivial, realMatrixOperator_apply,
    chartAltForm, chartMatrixPhase_eq_sum, chartMatrixPhase_eq_sum, Matrix.sub_mulVec,
    sub_dotProduct, dotProduct_comm _ y.ofLp, Matrix.mulVec_transpose, ← Matrix.dotProduct_mulVec]

theorem chartMatrixPhase_symm_sum {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) (a b : Fin d → ℝ)
    (s : ℝ) : ∑ j, (∑ i, a i * (1 / 2 * ((C i j : ℝ) + s * (C j i : ℝ)))) * b j =
      1 / 2 * (chartMatrixPhase C a b + s * chartMatrixPhase C b a) := by
  have e1 : chartMatrixPhase C a b = ∑ j, ∑ i, a i * (C i j : ℝ) * b j := Finset.sum_comm
  have e2 : chartMatrixPhase C b a = ∑ j, ∑ i, a i * (C j i : ℝ) * b j := by
    unfold chartMatrixPhase
    apply Finset.sum_congr rfl; intro j _; apply Finset.sum_congr rfl; intro i _; ring
  rw [e1, e2]
  simp only [mul_add, Finset.mul_sum, Finset.sum_mul, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl; intro j _; apply Finset.sum_congr rfl; intro i _; ring

theorem effectiveReturnQuadratic_one_one {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (Λ : Matrix (Fin 1) (Fin 1) ℝ) (V F S : Matrix (Fin d) (Fin 1) ℝ) :
    effectiveReturnQuadratic (C.map (fun q => (q : ℝ))) Λ V F S 0 0 =
      Λ 0 0 + (1 / 2 : ℝ) * chartMatrixPhase C (fun i => V i 0) (fun i => V i 0) +
        (1 / 2 : ℝ) * (chartMatrixPhase C (fun i => F i 0) (fun i => S i 0) -
          chartMatrixPhase C (fun i => S i 0) (fun i => F i 0)) := by
  simp only [effectiveReturnQuadratic, realSymmetricPart, realSkewPart, Matrix.add_apply,
    Matrix.smul_apply, smul_eq_mul, Matrix.transpose_apply, Matrix.mul_apply,
    Matrix.sub_apply, Matrix.map_apply, Matrix.transpose_apply]
  have h1 := chartMatrixPhase_symm_sum C (fun i => V i 0) (fun i => V i 0) 1
  have h2 := chartMatrixPhase_symm_sum C (fun i => F i 0) (fun i => S i 0) (-1)
  simp only [one_mul, neg_one_mul, ← sub_eq_add_neg] at h1 h2
  rw [h1, h2]; ring

theorem chartMatrixPhase_sub_left {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) (x x' y : Fin d → ℝ) :
    chartMatrixPhase C (x - x') y = chartMatrixPhase C x y - chartMatrixPhase C x' y := by
  simp only [chartMatrixPhase_eq_sum, sub_dotProduct]

theorem chartAltForm_sub_left {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) (x x' y : Fin d → ℝ) :
    chartAltForm C (x - x') y = chartAltForm C x y - chartAltForm C x' y := by
  simp only [chartAltForm, chartMatrixPhase_sub_left, chartMatrixPhase_sub_right]; ring

theorem chartAltForm_sub_right {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) (x y y' : Fin d → ℝ) :
    chartAltForm C x (y - y') = chartAltForm C x y - chartAltForm C x y' := by
  simp only [chartAltForm, chartMatrixPhase_sub_left, chartMatrixPhase_sub_right]; ring

theorem chartAltForm_self {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) (x : Fin d → ℝ) :
    chartAltForm C x x = 0 := sub_self _

theorem chartAltForm_swap {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) (x y : Fin d → ℝ) :
    chartAltForm C x y = -chartAltForm C y x := by
  simp only [chartAltForm]; ring

theorem chartMatrixPhase_blockNeg {d e : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (D : Matrix (Fin e) (Fin e) ℚ) (z w : Fin (d + e) → ℝ) :
    chartMatrixPhase (chartBlockMatrix C (-D)) z w =
      chartMatrixPhase C (fun i => z (Fin.castAdd e i)) (fun i => w (Fin.castAdd e i)) -
      chartMatrixPhase D (fun i => z (Fin.natAdd d i)) (fun i => w (Fin.natAdd d i)) := by
  rw [chartMatrixPhase_block, chartMatrixPhase_neg]; ring

theorem chartAltForm_blockNeg {d e : ℕ} (C : Matrix (Fin d) (Fin d) ℚ)
    (D : Matrix (Fin e) (Fin e) ℚ) (z w : Fin (d + e) → ℝ) :
    chartAltForm (chartBlockMatrix C (-D)) z w =
      chartAltForm C (fun i => z (Fin.castAdd e i)) (fun i => w (Fin.castAdd e i)) -
      chartAltForm D (fun i => z (Fin.natAdd d i)) (fun i => w (Fin.natAdd d i)) := by
  simp only [chartAltForm, chartMatrixPhase_blockNeg]; ring

theorem abs_chartMatrixPhase_le {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) {K : ℝ} (hK : 0 ≤ K)
    (hC : ∀ i j, |(C i j : ℝ)| ≤ K) (x y : EuclideanSpace ℝ (Fin d)) :
    |chartMatrixPhase C x.ofLp y.ofLp| ≤ d * d * K * ‖x‖ * ‖y‖ := by
  have he : chartMatrixPhase C x.ofLp y.ofLp =
      inner ℝ x (realMatrixOperator (C.map (fun q => (q : ℝ))) y) := by
    rw [chartMatrixPhase_eq_sum, EuclideanSpace.inner_eq_star_dotProduct, star_trivial,
      realMatrixOperator_apply, dotProduct_comm]
  have hop : ‖realMatrixOperator (C.map (fun q => (q : ℝ)))‖ ≤ d * d * K :=
    realMatrixOperator_norm_le _ hK (fun i j => by simpa using hC i j)
  rw [he]
  calc _ ≤ ‖x‖ * ‖realMatrixOperator (C.map (fun q => (q : ℝ))) y‖ := abs_real_inner_le_norm _ _
    _ ≤ ‖x‖ * (d * d * K * ‖y‖) := by
        gcongr
        exact ((realMatrixOperator _).le_opNorm y).trans (by gcongr)
    _ = _ := by ring

theorem abs_chartAltForm_le {d : ℕ} (C : Matrix (Fin d) (Fin d) ℚ) {K : ℝ} (hK : 0 ≤ K)
    (hC : ∀ i j, |(C i j : ℝ)| ≤ K) (x y : EuclideanSpace ℝ (Fin d)) :
    |chartAltForm C x.ofLp y.ofLp| ≤ 2 * (d * d * K) * ‖x‖ * ‖y‖ := by
  have h1 := abs_chartMatrixPhase_le C hK hC x y
  have h2 := abs_chartMatrixPhase_le C hK hC y x
  calc _ ≤ |chartMatrixPhase C x.ofLp y.ofLp| + |chartMatrixPhase C y.ofLp x.ofLp| :=
        abs_sub _ _
    _ ≤ _ := by linarith

/-- The vector form of `WeylSplitData` in one variable. -/
theorem weylSplitData_iff {B : ℝ} {d : ℕ} (V : Matrix (Fin d) (Fin 1) ℝ)
    (C : Matrix (Fin d) (Fin d) ℚ) (Λ : Matrix (Fin 1) (Fin 1) ℝ) :
    WeylSplitData B V C Λ ↔ ∃ (U : Submodule ℝ (EuclideanSpace ℝ (Fin d)))
      (Q : Matrix (Fin d) (Fin d) ℚ),
      realMatrixOperator (Q.map (fun q => (q : ℝ))) = Uᗮ.starProjection ∧
      realMatrixOperator ((1 - Q).map (fun q => (q : ℝ))) = U.starProjection ∧
      (∀ x ∈ U, ∀ y ∈ U, chartAltForm C y.ofLp x.ofLp = 0) ∧
      (∀ i j, (rationalHeight (Q i j) : ℝ) ≤ B) ∧
      (∀ i j, (rationalHeight ((1 - Q) i j) : ℝ) ≤ B) ∧
      ‖Uᗮ.starProjection (WithLp.toLp 2 (fun i => V i 0))‖ ≤ B ∧
      |Λ 0 0 + (1 / 2 : ℝ) * chartMatrixPhase C (fun i => V i 0) (fun i => V i 0) +
        (1 / 2 : ℝ) * chartAltForm C (U.starProjection (WithLp.toLp 2 (fun i => V i 0))).ofLp
          (fun i => V i 0)| ≤ B := by
  set v : EuclideanSpace ℝ (Fin d) := WithLp.toLp 2 (fun i => V i 0) with hv
  have hcol : ∀ (A : Matrix (Fin d) (Fin d) ℝ),
      (fun i => (A * V) i 0) = (realMatrixOperator A v).ofLp := by
    intro A; funext i
    simp [realMatrixOperator_apply, hv, Matrix.mul_apply, Matrix.mulVec, dotProduct]
  have key : ∀ (U : Submodule ℝ (EuclideanSpace ℝ (Fin d))) (Q : Matrix (Fin d) (Fin d) ℚ),
      realMatrixOperator (Q.map (fun q => (q : ℝ))) = Uᗮ.starProjection →
      realMatrixOperator ((1 - Q).map (fun q => (q : ℝ))) = U.starProjection →
      ‖realMatrixOperator (Q.map (fun q => (q : ℝ)) * V)‖ = ‖Uᗮ.starProjection v‖ ∧
      ‖realMatrixOperator (effectiveReturnQuadratic (C.map (fun q => (q : ℝ))) Λ V
        ((1 - Q).map (fun q => (q : ℝ)) * V) (Q.map (fun q => (q : ℝ)) * V))‖ =
      |Λ 0 0 + (1 / 2 : ℝ) * chartMatrixPhase C (fun i => V i 0) (fun i => V i 0) +
        (1 / 2 : ℝ) * chartAltForm C (U.starProjection v).ofLp (fun i => V i 0)| := by
    intro U Q h1 h2
    constructor
    · rw [norm_realMatrixOperator_col]
      congr 1
      rw [hcol, h1, WithLp.toLp_ofLp]
    · rw [norm_realMatrixOperator_one_one, effectiveReturnQuadratic_one_one]
      have e1 := hcol ((1 - Q).map (fun q => (q : ℝ)))
      have e2 := hcol (Q.map (fun q => (q : ℝ)))
      rw [h2] at e1; rw [h1] at e2
      have hA : ∀ F S : Fin d → ℝ,
          chartMatrixPhase C F S - chartMatrixPhase C S F = chartAltForm C F S := fun _ _ => rfl
      rw [e1, e2, hA, Submodule.starProjection_orthogonal_val, WithLp.ofLp_sub,
        chartAltForm_sub_right, chartAltForm_self, sub_zero]
  constructor
  · rintro ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩
    obtain ⟨k1, k2⟩ := key U Q h1 h2
    refine ⟨U, Q, h1, h2, fun x hx y hy => ?_, h4, h5, k1 ▸ h6, k2 ▸ h7⟩
    rw [← inner_realMatrixOperator_alt]; exact h3 x hx y hy
  · rintro ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩
    obtain ⟨k1, k2⟩ := key U Q h1 h2
    refine ⟨U, Q, h1, h2, fun x hx y hy => ?_, h4, h5, k1 ▸ h6, k2 ▸ h7⟩
    rw [inner_realMatrixOperator_alt]; exact h3 x hx y hy

theorem starProjection_eq_zero_of_mem_orthogonal {n : ℕ}
    (K : Submodule ℝ (EuclideanSpace ℝ (Fin n))) {z : EuclideanSpace ℝ (Fin n)} (hz : z ∈ Kᗮ) :
    K.starProjection z = 0 := by
  have h1 := K.starProjection_orthogonal_val z
  rw [Submodule.starProjection_eq_self_iff.mpr hz] at h1
  exact sub_eq_self.mp h1.symm

theorem mem_iff_starProjection_orthogonal_eq_zero {n : ℕ}
    (U : Submodule ℝ (EuclideanSpace ℝ (Fin n))) (v : EuclideanSpace ℝ (Fin n)) :
    v ∈ U ↔ Uᗮ.starProjection v = 0 := by
  rw [Submodule.starProjection_orthogonal_val, sub_eq_zero, eq_comm,
    Submodule.starProjection_eq_self_iff]

/-- The orthogonal complement of the real row space of a rational matrix is its kernel. -/
theorem mem_orthogonal_rationalRealRowSpace {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℚ)
    (x : EuclideanSpace ℝ (Fin n)) :
    x ∈ (rationalRealRowSpace A)ᗮ ↔ realMatrixOperator (A.map (fun q => (q : ℝ))) x = 0 := by
  have htr : ∀ y, inner ℝ (realMatrixOperator (A.transpose.map (fun q => (q : ℝ))) y) x =
      inner ℝ y (realMatrixOperator (A.map (fun q => (q : ℝ))) x) := by
    intro y
    have := realMatrixOperator_transpose_inner (A.map (fun q => (q : ℝ))).transpose y x
    rwa [Matrix.transpose_transpose, ← Matrix.transpose_map] at this
  rw [Submodule.mem_orthogonal]
  constructor
  · intro h
    have := h _ (LinearMap.mem_range.mpr ⟨realMatrixOperator (A.map (fun q => (q : ℝ))) x, rfl⟩)
    simp only [ContinuousLinearMap.coe_coe] at this
    rw [htr] at this
    exact inner_self_eq_zero.mp this
  · intro h u hu
    obtain ⟨y, rfl⟩ := LinearMap.mem_range.mp hu
    change inner ℝ (realMatrixOperator (A.transpose.map (fun q => (q : ℝ))) y) x = 0
    rw [htr, h, inner_zero_right]

/-- Blueprint lem:graph, line 1704: the distance from the kernel of a rational system is
controlled by the size of the defect `A t`, through a rational right inverse. -/
theorem rational_rowSpace_projection_le {m n : ℕ} {B : ℝ} (hB : 2 ≤ B)
    (A : Matrix (Fin m) (Fin n) ℚ) (hA : ∀ i j, (rationalHeight (A i j) : ℝ) ≤ B)
    (t : EuclideanSpace ℝ (Fin n)) :
    ‖(rationalRealRowSpace A).starProjection t‖ ≤
      Real.exp (4 * (m + n + 1 : ℝ) ^ 4 * Real.log (2 * B)) *
        ‖realMatrixOperator (A.map (fun q => (q : ℝ))) t‖ := by
  obtain ⟨R, hR, -, hRn⟩ := rationalMatrix_rightInverse_bounds (d := m + n) (by omega) (by omega)
    hB A hA
  have hARA : A * R * A = A := by
    ext i k
    have := congrFun (hR _ ⟨Pi.single k 1, rfl⟩) i
    simp only [Matrix.mulVecLin_apply, Matrix.mulVec_mulVec, Matrix.mulVec_single_one] at this
    exact this
  have hARAr : (A.map (fun q => (q : ℝ))) * (R.map (fun q => (q : ℝ))) *
      (A.map (fun q => (q : ℝ))) = A.map (fun q => (q : ℝ)) := by
    have := congrArg (fun M => M.map (Rat.castHom ℝ)) hARA
    simp only [Matrix.map_mul] at this
    exact this
  set Ar := realMatrixOperator (A.map (fun q => (q : ℝ)))
  set Rr := realMatrixOperator (R.map (fun q => (q : ℝ)))
  have hz : t - Rr (Ar t) ∈ (rationalRealRowSpace A)ᗮ := by
    rw [mem_orthogonal_rationalRealRowSpace, map_sub]
    have := congrArg (fun M => realMatrixOperator M t) hARAr
    simp only [realMatrixOperator_mul_apply] at this
    change Ar t - Ar (Rr (Ar t)) = 0
    rw [this, sub_self]
  have hP : (rationalRealRowSpace A).starProjection t =
      (rationalRealRowSpace A).starProjection (Rr (Ar t)) := by
    have := starProjection_eq_zero_of_mem_orthogonal _ hz
    rw [map_sub, sub_eq_zero] at this
    exact this
  rw [hP]
  push_cast at hRn
  calc _ ≤ ‖Rr (Ar t)‖ := Submodule.norm_starProjection_apply_le _ _
    _ ≤ ‖Rr‖ * ‖Ar t‖ := Rr.le_opNorm _
    _ ≤ _ := by gcongr

/-- The row of the stacked system indexed by an edge `j` and a row `c` of `Q_j`. -/
def stackedConstraintRow {L N : ℕ} (s : Fin L → ℕ) (σ : (j : Fin L) → Fin (s j) → Fin N)
    (Q : (j : Fin L) → Matrix (Fin (s j)) (Fin (s j)) ℚ) (k : (j : Fin L) × Fin (s j))
    (q : Fin N) : ℚ :=
  ∑ b, Q k.1 k.2 b * if σ k.1 b = q then 1 else 0

/-- Rows stacked from rational systems `Q_j` acting on the coordinates selected by `σ_j`. -/
def stackedConstraint {L N : ℕ} (s : Fin L → ℕ) (σ : (j : Fin L) → Fin (s j) → Fin N)
    (Q : (j : Fin L) → Matrix (Fin (s j)) (Fin (s j)) ℚ) :
    Matrix (Fin (∑ j, s j)) (Fin N) ℚ :=
  Matrix.of fun p q => stackedConstraintRow s σ Q (finSigmaFinEquiv.symm p) q

theorem stackedConstraint_mulVec {L N : ℕ} (s : Fin L → ℕ)
    (σ : (j : Fin L) → Fin (s j) → Fin N) (Q : (j : Fin L) → Matrix (Fin (s j)) (Fin (s j)) ℚ)
    (x : Fin N → ℝ) (j : Fin L) (c : Fin (s j)) :
    ((stackedConstraint s σ Q).map (fun q => (q : ℝ))).mulVec x (finSigmaFinEquiv ⟨j, c⟩) =
      ((Q j).map (fun q => (q : ℝ))).mulVec (fun b => x (σ j b)) c := by
  have hrow : ∀ q, stackedConstraint s σ Q (finSigmaFinEquiv ⟨j, c⟩) q =
      ∑ b, Q j c b * if σ j b = q then 1 else 0 := by
    intro q
    simp only [stackedConstraint, Matrix.of_apply, Equiv.symm_apply_apply]
    rfl
  simp only [Matrix.mulVec, dotProduct, Matrix.map_apply, hrow]
  push_cast
  simp only [Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl; intro b _
  rw [Finset.sum_eq_single (σ j b)]
  · simp
  · intro q _ hq
    have : σ j b ≠ q := fun h => hq h.symm
    simp [this]
  · simp

theorem stackedConstraint_height {L N : ℕ} {B : ℝ} (hB : 1 ≤ B) (s : Fin L → ℕ)
    (σ : (j : Fin L) → Fin (s j) → Fin N) (hσ : ∀ j, Function.Injective (σ j))
    (Q : (j : Fin L) → Matrix (Fin (s j)) (Fin (s j)) ℚ)
    (hQ : ∀ j a b, (rationalHeight (Q j a b) : ℝ) ≤ B) (p : Fin (∑ j, s j)) (q : Fin N) :
    (rationalHeight (stackedConstraint s σ Q p q) : ℝ) ≤ B := by
  simp only [stackedConstraint, Matrix.of_apply, stackedConstraintRow]
  set k := finSigmaFinEquiv.symm p
  by_cases h : ∃ b, σ k.1 b = q
  · obtain ⟨b, hb⟩ := h
    rw [Finset.sum_eq_single b]
    · have h1 : (if σ k.1 b = q then (1 : ℚ) else 0) = 1 := by simp [hb]
      rw [h1, mul_one]; exact hQ _ _ _
    · intro b' _ hb'
      have hne : ¬σ k.1 b' = q := fun h' => hb' (hσ _ (h'.trans hb.symm))
      have h0 : (if σ k.1 b' = q then (1 : ℚ) else 0) = 0 := by simp [hne]
      rw [h0, mul_zero]
    · simp
  · rw [not_exists] at h
    rw [Finset.sum_eq_zero (fun b _ => by simp [h b])]
    simpa [rationalHeight] using hB

/-- The kernel of the stacked system consists of the vectors whose selected coordinates lie in
every `U_j`. -/
theorem mem_stackedConstraint_kernel {L N : ℕ} (s : Fin L → ℕ)
    (σ : (j : Fin L) → Fin (s j) → Fin N) (Q : (j : Fin L) → Matrix (Fin (s j)) (Fin (s j)) ℚ)
    (U : (j : Fin L) → Submodule ℝ (EuclideanSpace ℝ (Fin (s j))))
    (hQU : ∀ j, realMatrixOperator ((Q j).map (fun q => (q : ℝ))) = (U j)ᗮ.starProjection)
    (x : EuclideanSpace ℝ (Fin N)) :
    x ∈ (rationalRealRowSpace (stackedConstraint s σ Q))ᗮ ↔
      ∀ j, WithLp.toLp 2 (fun b => x (σ j b)) ∈ U j := by
  rw [mem_orthogonal_rationalRealRowSpace]
  have hj : ∀ j, WithLp.toLp 2 (fun b => x (σ j b)) ∈ U j ↔
      ∀ c, ((Q j).map (fun q => (q : ℝ))).mulVec (fun b => x (σ j b)) c = 0 := by
    intro j
    rw [mem_iff_starProjection_orthogonal_eq_zero, ← hQU]
    constructor
    · intro h c
      have := congrArg (fun z : EuclideanSpace ℝ (Fin (s j)) => z c) h
      simpa [realMatrixOperator_apply] using this
    · intro h
      ext c; simpa [realMatrixOperator_apply] using h c
  simp only [hj]
  constructor
  · intro h j c
    have := congrArg (fun z : EuclideanSpace ℝ (Fin (∑ j, s j)) => z (finSigmaFinEquiv ⟨j, c⟩)) h
    simp only [realMatrixOperator_apply] at this
    rw [← stackedConstraint_mulVec]
    simpa using this
  · intro h
    ext p
    obtain ⟨⟨j, c⟩, rfl⟩ := finSigmaFinEquiv.surjective p
    have := h j c
    rw [← stackedConstraint_mulVec] at this
    simpa [realMatrixOperator_apply] using this

theorem norm_toLp_comp_le {n N : ℕ} {τ : Fin n → Fin N} (hτ : Function.Injective τ)
    (x : EuclideanSpace ℝ (Fin N)) : ‖WithLp.toLp 2 (fun c => x (τ c))‖ ≤ ‖x‖ := by
  rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq]
  apply Real.sqrt_le_sqrt
  calc ∑ c, ‖x (τ c)‖ ^ 2 = ∑ q ∈ Finset.univ.image τ, ‖x q‖ ^ 2 := by
        rw [Finset.sum_image (fun a _ b _ h => hτ h)]
    _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
        (fun _ _ _ => by positivity)

theorem sum_castSucc_sub_succ {L : ℕ} (f : Fin (L + 1) → ℝ) :
    ∑ j : Fin L, (f j.castSucc - f j.succ) = f 0 - f (Fin.last L) := by
  induction L with
  | zero => simp
  | succ L ih =>
    have h := ih (fun i => f i.succ)
    simp only [Fin.succ_castSucc] at h
    rw [Fin.sum_univ_succ, h, Fin.succ_last]
    simp only [Fin.castSucc_zero, Fin.succ_zero_eq_one]
    ring

/-- Blueprint lem:graph, line 1704: the image of a rational subspace under a coordinate
restriction is again rational, with a projection of controlled height. -/
theorem rational_restrict_subspace {N n : ℕ} {E₁ : ℝ} (hE : 2 ≤ E₁)
    (P : Matrix (Fin N) (Fin N) ℚ) (W : Submodule ℝ (EuclideanSpace ℝ (Fin N)))
    (hP : realMatrixOperator ((1 - P).map (fun q => (q : ℝ))) = W.starProjection)
    (hPh : ∀ i j, (rationalHeight ((1 - P) i j) : ℝ) ≤ E₁) (τ : Fin n → Fin N) :
    ∃ (W' : Submodule ℝ (EuclideanSpace ℝ (Fin n))) (Q' : Matrix (Fin n) (Fin n) ℚ),
      realMatrixOperator (Q'.map (fun q => (q : ℝ))) = W'ᗮ.starProjection ∧
      realMatrixOperator ((1 - Q').map (fun q => (q : ℝ))) = W'.starProjection ∧
      (∀ i j, (rationalHeight (Q' i j) : ℝ) ≤
        Real.exp (8 * (n + 1 : ℝ) ^ 4 * Real.log (2 * E₁))) ∧
      (∀ i j, (rationalHeight ((1 - Q') i j) : ℝ) ≤
        Real.exp (8 * (n + 1 : ℝ) ^ 4 * Real.log (2 * E₁))) ∧
      (∀ x ∈ W, WithLp.toLp 2 (fun c => x (τ c)) ∈ W') ∧
      (∀ u ∈ W', ∃ x ∈ W, u = WithLp.toLp 2 (fun c => x (τ c))) := by
  set A' : Matrix (Fin N) (Fin n) ℚ := Matrix.of fun q c => (1 - P) (τ c) q with hA'
  have hop : ∀ z, realMatrixOperator (A'.transpose.map (fun q => (q : ℝ))) z =
      WithLp.toLp 2 (fun c => W.starProjection z (τ c)) := by
    intro z; ext c
    rw [← hP]
    simp [realMatrixOperator_apply, hA', Matrix.mulVec, dotProduct]
  obtain ⟨P', h1, h2, h3, h4, -, -⟩ := rationalMatrix_projection_bounds (d := n) le_rfl hE A'
    (fun i j => hPh _ _)
  refine ⟨rationalRealRowSpace A', 1 - P', h2, ?_, h4, ?_, ?_, ?_⟩
  · rw [sub_sub_cancel]; exact h1
  · intro i j; rw [sub_sub_cancel]; exact h3 i j
  · intro x hx
    refine LinearMap.mem_range.mpr ⟨x, ?_⟩
    change realMatrixOperator (A'.transpose.map (fun q => (q : ℝ))) x = _
    rw [hop, (Submodule.starProjection_eq_self_iff).mpr hx]
  · intro u hu
    obtain ⟨z, rfl⟩ := LinearMap.mem_range.mp hu
    refine ⟨W.starProjection z, W.starProjection_apply_mem z, ?_⟩
    change realMatrixOperator (A'.transpose.map (fun q => (q : ℝ))) z = _
    rw [hop]

theorem abs_cast_le_of_height {q : ℚ} {B : ℝ} (h : (rationalHeight q : ℝ) ≤ B) :
    |(q : ℝ)| ≤ B := by
  have h1 : |(q : ℝ)| ≤ (rationalHeight q : ℝ) := by
    have := rational_abs_le_height q
    exact_mod_cast this
  linarith

theorem abs_tagDiffC_le {v w : ChartTag} {B : ℝ} (hB : 0 ≤ B)
    (hv : ∀ a b, (rationalHeight (v.C a b) : ℝ) ≤ B)
    (hw : ∀ a b, (rationalHeight (w.C a b) : ℝ) ≤ B) (i j : Fin (v.dim + w.dim)) :
    |((tagDiffC v w i j : ℚ) : ℝ)| ≤ B := by
  unfold tagDiffC chartBlockMatrix
  induction i using Fin.addCases <;> induction j using Fin.addCases <;>
    simp [hB, abs_cast_le_of_height (hv _ _), abs_cast_le_of_height (hw _ _)]

/-- The quasipolynomial budget of the short-path assertion. -/
theorem shortPath_budget {X B D : ℝ} (hX : 1 ≤ X) (hB : 2 ≤ B) (hD : D ≤
    Real.exp (4 * (4 * X) ^ 4 * Real.log (2 * B)) * (2 * X * B)) (hD0 : 0 ≤ D) :
    D ≤ Real.exp (100000 * X ^ 8 * Real.log (2 * B)) ∧
    X * (B + (2 * X) ^ 2 * B ^ 2 * (D + B)) + (2 * X) ^ 2 * B * 2 * D ^ 2 ≤
      Real.exp (100000 * X ^ 8 * Real.log (2 * B)) ∧
    Real.exp (8 * (2 * X + 1) ^ 4 *
      Real.log (2 * Real.exp (8 * (X + 1) ^ 4 * Real.log (2 * B)))) ≤
      Real.exp (100000 * X ^ 8 * Real.log (2 * B)) := by
  set ℓ := Real.log (2 * B) with hℓ
  have hℓ1 : 1 ≤ ℓ := by
    have h2B : (0 : ℝ) < 2 * B := by linarith
    rw [hℓ, Real.le_log_iff_exp_le h2B]
    have := Real.exp_one_lt_d9
    norm_num at this
    linarith
  have hX4 : 1 ≤ X ^ 4 := one_le_pow₀ hX
  have hX48 : X ^ 4 ≤ X ^ 8 := pow_le_pow_right₀ hX (by norm_num)
  set Y := Real.exp (X ^ 4 * ℓ) with hY
  have hY1 : 1 ≤ X ^ 4 * ℓ := by nlinarith
  have hYe : 2 ≤ Y := by have := Real.add_one_le_exp (X ^ 4 * ℓ); linarith
  have hBY : B ≤ Y := by
    have h1 : 2 * B = Real.exp ℓ := (Real.exp_log (by linarith)).symm
    have h2 : Real.exp ℓ ≤ Y := Real.exp_le_exp.mpr (by nlinarith)
    linarith
  have hXY : X ≤ Y := by
    have := Real.add_one_le_exp (X ^ 4 * ℓ)
    have : X ≤ X ^ 4 := by
      calc X = X ^ 1 := (pow_one X).symm
        _ ≤ X ^ 4 := pow_le_pow_right₀ hX (by norm_num)
    nlinarith
  have hpow : ∀ k : ℕ, Real.exp (k * (X ^ 4 * ℓ)) = Y ^ k := fun k => Real.exp_nat_mul _ k
  have hE : Real.exp (4 * (4 * X) ^ 4 * ℓ) = Y ^ 1024 := by
    rw [← hpow]; congr 1; push_cast; ring
  have hB' : Y ^ 100000 ≤ Real.exp (100000 * X ^ 8 * ℓ) := by
    rw [← hpow]; apply Real.exp_le_exp.mpr; push_cast; nlinarith
  have hmono : ∀ a b : ℕ, a ≤ b → Y ^ a ≤ Y ^ b := fun a b h =>
    pow_le_pow_right₀ (by linarith) h
  have hX0 : 0 ≤ X := by linarith
  have hB0 : 0 ≤ B := by linarith
  have hD' : D ≤ 2 * Y ^ 1026 := by
    rw [hE] at hD
    calc D ≤ Y ^ 1024 * (2 * X * B) := hD
      _ ≤ Y ^ 1024 * (2 * Y * Y) := by gcongr
      _ = 2 * Y ^ 1026 := by ring
  refine ⟨?_, ?_, ?_⟩
  · calc D ≤ 2 * Y ^ 1026 := hD'
      _ ≤ Y * Y ^ 1026 := by gcongr
      _ = Y ^ 1027 := by ring
      _ ≤ Y ^ 100000 := hmono _ _ (by norm_num)
      _ ≤ _ := hB'
  · calc X * (B + (2 * X) ^ 2 * B ^ 2 * (D + B)) + (2 * X) ^ 2 * B * 2 * D ^ 2
        ≤ Y * (Y + (2 * Y) ^ 2 * Y ^ 2 * (2 * Y ^ 1026 + Y)) +
          (2 * Y) ^ 2 * Y * 2 * (2 * Y ^ 1026) ^ 2 := by gcongr
      _ = Y ^ 2 + 8 * Y ^ 1031 + 4 * Y ^ 6 + 32 * Y ^ 2055 := by ring
      _ ≤ Y ^ 2055 + 8 * Y ^ 2055 + 4 * Y ^ 2055 + 32 * Y ^ 2055 := by
          gcongr <;> linarith
      _ = 45 * Y ^ 2055 := by ring
      _ ≤ Y ^ 6 * Y ^ 2055 := by
          gcongr
          calc (45 : ℝ) ≤ 2 ^ 6 := by norm_num
            _ ≤ Y ^ 6 := by gcongr
      _ = Y ^ 2061 := by ring
      _ ≤ Y ^ 100000 := hmono _ _ (by norm_num)
      _ ≤ _ := hB'
  · apply Real.exp_le_exp.mpr
    have h16 : (X + 1) ^ 4 ≤ 16 * X ^ 4 := by
      calc (X + 1) ^ 4 ≤ (2 * X) ^ 4 := by gcongr; linarith
        _ = 16 * X ^ 4 := by ring
    have h81 : (2 * X + 1) ^ 4 ≤ 81 * X ^ 4 := by
      calc (2 * X + 1) ^ 4 ≤ (3 * X) ^ 4 := by gcongr; linarith
        _ = 81 * X ^ 4 := by ring
    have hl2 : Real.log (2 * Real.exp (8 * (X + 1) ^ 4 * ℓ)) ≤ 129 * X ^ 4 * ℓ := by
      rw [Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp]
      have : Real.log 2 ≤ ℓ := Real.log_le_log (by norm_num) (by linarith)
      nlinarith
    have hl0 : 0 ≤ Real.log (2 * Real.exp (8 * (X + 1) ^ 4 * ℓ)) := by
      rw [Real.log_mul (by norm_num) (Real.exp_pos _).ne', Real.log_exp]
      have : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
      positivity
    calc 8 * (2 * X + 1) ^ 4 * Real.log (2 * Real.exp (8 * (X + 1) ^ 4 * ℓ))
        ≤ 8 * (81 * X ^ 4) * (129 * X ^ 4 * ℓ) := by gcongr
      _ = 83592 * X ^ 8 * ℓ := by ring
      _ ≤ 100000 * X ^ 8 * ℓ := by nlinarith

/-- Coordinates of the concatenated horizontal space along a path of tags. -/
def pathIndex {L : ℕ} (v : Fin (L + 1) → ChartTag) :
    ((i : Fin (L + 1)) × Fin (v i).dim) ≃ Fin (∑ i, (v i).dim) := finSigmaFinEquiv

/-- The block of node `i` of a concatenated vector. -/
def pathNode {L : ℕ} (v : Fin (L + 1) → ChartTag)
    (x : EuclideanSpace ℝ (Fin (∑ i, (v i).dim))) (i : Fin (L + 1)) : Fin (v i).dim → ℝ :=
  fun a => x (pathIndex v ⟨i, a⟩)

/-- The coordinates of the two nodes `i, i'` of a path, as used by the edge `(v_i, v_{i'})`. -/
def pathPair {L : ℕ} (v : Fin (L + 1) → ChartTag) (i i' : Fin (L + 1)) :
    Fin ((v i).dim + (v i').dim) → Fin (∑ i, (v i).dim) :=
  Fin.append (fun a => pathIndex v ⟨i, a⟩) (fun b => pathIndex v ⟨i', b⟩)

def pathVectorAux {L : ℕ} (r : ℝ) (v : Fin (L + 1) → ChartTag)
    (k : (i : Fin (L + 1)) × Fin (v i).dim) : ℝ := r * (v k.1).θ k.2

/-- The concatenated horizontal vector `r (θ_{v_0}, …, θ_{v_L})` of a path. -/
noncomputable def pathVector {L : ℕ} (r : ℝ) (v : Fin (L + 1) → ChartTag) :
    EuclideanSpace ℝ (Fin (∑ i, (v i).dim)) :=
  WithLp.toLp 2 fun q => pathVectorAux r v ((pathIndex v).symm q)

theorem pathPair_castAdd {L : ℕ} (v : Fin (L + 1) → ChartTag) (i i' : Fin (L + 1))
    (a : Fin (v i).dim) : pathPair v i i' (Fin.castAdd _ a) = pathIndex v ⟨i, a⟩ := by
  simp [pathPair]

theorem pathPair_natAdd {L : ℕ} (v : Fin (L + 1) → ChartTag) (i i' : Fin (L + 1))
    (b : Fin (v i').dim) : pathPair v i i' (Fin.natAdd _ b) = pathIndex v ⟨i', b⟩ := by
  simp [pathPair]

theorem pathPair_injective {L : ℕ} (v : Fin (L + 1) → ChartTag) {i i' : Fin (L + 1)}
    (hii : i ≠ i') : Function.Injective (pathPair v i i') := by
  intro x x' h
  induction x using Fin.addCases <;> induction x' using Fin.addCases <;>
    simp only [pathPair_castAdd, pathPair_natAdd, EmbeddingLike.apply_eq_iff_eq,
      Sigma.mk.inj_iff] at h
  · rw [eq_of_heq h.2]
  · exact absurd h.1 hii
  · exact absurd h.1.symm hii
  · rw [eq_of_heq h.2]

theorem pathVector_index {L : ℕ} (r : ℝ) (v : Fin (L + 1) → ChartTag)
    (k : (i : Fin (L + 1)) × Fin (v i).dim) : pathVector r v (pathIndex v k) = r * (v k.1).θ
        k.2 := by
  change pathVectorAux r v ((pathIndex v).symm (pathIndex v k)) = _
  rw [Equiv.symm_apply_apply]; rfl

theorem pathVector_pair {L : ℕ} (r : ℝ) (v : Fin (L + 1) → ChartTag) (i i' : Fin (L + 1)) :
    (fun b => pathVector r v (pathPair v i i' b)) = fun c => tagDiffV r (v i) (v i') c 0 := by
  funext c
  induction c using Fin.addCases <;>
    simp [pathPair_castAdd, pathPair_natAdd, pathVector_index, tagDiffV]

theorem chartMatrixPhase_pathPair {L : ℕ} (v : Fin (L + 1) → ChartTag) (i i' : Fin (L + 1))
    (x x' : EuclideanSpace ℝ (Fin (∑ i, (v i).dim))) :
    chartMatrixPhase (tagDiffC (v i) (v i')) (fun b => x (pathPair v i i' b))
      (fun b => x' (pathPair v i i' b)) =
    chartMatrixPhase (v i).C (pathNode v x i) (pathNode v x' i) -
      chartMatrixPhase (v i').C (pathNode v x i') (pathNode v x' i') := by
  rw [tagDiffC, chartMatrixPhase_blockNeg]
  simp only [pathPair_castAdd, pathPair_natAdd]
  rfl

theorem chartAltForm_pathPair {L : ℕ} (v : Fin (L + 1) → ChartTag) (i i' : Fin (L + 1))
    (x x' : EuclideanSpace ℝ (Fin (∑ i, (v i).dim))) :
    chartAltForm (tagDiffC (v i) (v i')) (fun b => x (pathPair v i i' b))
      (fun b => x' (pathPair v i i' b)) =
    chartAltForm (v i).C (pathNode v x i) (pathNode v x' i) -
      chartAltForm (v i').C (pathNode v x i') (pathNode v x' i') := by
  rw [tagDiffC, chartAltForm_blockNeg]
  simp only [pathPair_castAdd, pathPair_natAdd]
  rfl

set_option maxHeartbeats 1600000 in
-- the single proof assembles the concatenated system, the edge telescoping and the endpoint
-- projection; elaborating it as one declaration needs more than the default budget
/-- Blueprint lem:graph, short paths (proof line 1704): if `v_0, …, v_L` are joined
consecutively by edges at length `r` with heights and sizes at most `B`, then the endpoints are
joined by an edge with logarithmic height and size polynomial in `L`, the dimensions and
`log B`. -/
theorem tagEdge_path {B r : ℝ} (hB : 2 ≤ B) {L dB : ℕ} (hL : 1 ≤ L)
    (v : Fin (L + 1) → ChartTag) (hdim : ∀ i, (v i).dim ≤ dB)
    (hC : ∀ i a b, (rationalHeight ((v i).C a b) : ℝ) ≤ B)
    (hedge : ∀ j : Fin L, tagEdge B r (v j.castSucc) (v j.succ)) :
    tagEdge (Real.exp (100000 * ((L + 1) * (dB + 1) : ℝ) ^ 8 * Real.log (2 * B))) r
      (v 0) (v (Fin.last L)) := by
  classical
  choose U Q hQ1 hQ2 hiso hh1 hh2 hdist heff using
    fun j => (weylSplitData_iff _ _ _).mp (hedge j)
  set N := ∑ i, (v i).dim with hN
  set t := pathVector r v with ht
  set s : Fin L → ℕ := fun j => (v j.castSucc).dim + (v j.succ).dim with hs
  set σ : (j : Fin L) → Fin (s j) → Fin N := fun j => pathPair v j.castSucc j.succ with hσ
  have hσi : ∀ j, Function.Injective (σ j) := fun j =>
    pathPair_injective v (show j.castSucc < j.succ from Fin.castSucc_lt_succ).ne
  have hB0 : (0 : ℝ) ≤ B := by linarith
  set M := stackedConstraint s σ Q with hM
  have hMh : ∀ p q, (rationalHeight (M p q) : ℝ) ≤ B :=
    stackedConstraint_height (by linarith) s σ hσi Q hh1
  set K := rationalRealRowSpace M with hK
  set y := Kᗮ.starProjection t with hy
  have hyW : y ∈ Kᗮ := Kᗮ.starProjection_apply_mem t
  have hyU : ∀ j, WithLp.toLp 2 (fun b => y (σ j b)) ∈ U j :=
    (mem_stackedConstraint_kernel s σ Q U hQ1 y).mp hyW
  set D := ‖t - y‖ with hD
  have hD0 : 0 ≤ D := norm_nonneg _
  -- the edge vectors are restrictions of the concatenated vector
  have hVcol : ∀ j : Fin L, (fun c => tagDiffV r (v j.castSucc) (v j.succ) c 0) =
      fun b => t (σ j b) := fun j => (pathVector_pair r v _ _).symm
  -- the defect of the concatenated vector
  have hMt : ‖realMatrixOperator (M.map (fun q => (q : ℝ))) t‖ ≤ ((∑ j, s j : ℕ) : ℝ) * B := by
    calc _ ≤ ∑ p, ‖realMatrixOperator (M.map (fun q => (q : ℝ))) t p‖ :=
          euclidean_norm_le_sum_coordinates _
      _ = ∑ k : (j : Fin L) × Fin (s j),
            ‖realMatrixOperator (M.map (fun q => (q : ℝ))) t (finSigmaFinEquiv k)‖ :=
          (Equiv.sum_comp finSigmaFinEquiv _).symm
      _ = ∑ j, ∑ c : Fin (s j),
            ‖realMatrixOperator (M.map (fun q => (q : ℝ))) t (finSigmaFinEquiv ⟨j, c⟩)‖ :=
          Fintype.sum_sigma _
      _ ≤ ∑ j, ∑ c : Fin (s j), B := by
          apply Finset.sum_le_sum; intro j _; apply Finset.sum_le_sum; intro c _
          have e1 : realMatrixOperator (M.map (fun q => (q : ℝ))) t (finSigmaFinEquiv ⟨j, c⟩) =
              (U j)ᗮ.starProjection (WithLp.toLp 2 (fun b => t (σ j b))) c := by
            rw [← hQ1]
            simp only [realMatrixOperator_apply]
            exact stackedConstraint_mulVec s σ Q t.ofLp j c
          rw [e1]
          have h2 := hdist j
          rw [hVcol j] at h2
          exact (PiLp.norm_apply_le _ c).trans h2
      _ = ((∑ j, s j : ℕ) : ℝ) * B := by
          simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
          push_cast; rw [Finset.sum_mul]
  have hDle : D ≤ Real.exp (4 * ((∑ j, s j : ℕ) + N + 1 : ℝ) ^ 4 * Real.log (2 * B)) *
      (((∑ j, s j : ℕ) : ℝ) * B) := by
    have h1 : t - y = K.starProjection t := by
      rw [hy, Submodule.starProjection_orthogonal_val]; abel
    rw [hD, h1]
    refine (rational_rowSpace_projection_le hB M hMh t).trans ?_
    gcongr
  -- dimension bookkeeping
  set X : ℝ := ((L : ℝ) + 1) * ((dB : ℝ) + 1) with hX
  have hX1 : 1 ≤ X := by
    have : (0 : ℝ) ≤ L := Nat.cast_nonneg _
    have : (0 : ℝ) ≤ dB := Nat.cast_nonneg _
    rw [hX]; nlinarith
  have hdimX : ∀ i, ((v i).dim : ℝ) ≤ X := by
    intro i
    have : ((v i).dim : ℝ) ≤ dB := by exact_mod_cast hdim i
    have : (0 : ℝ) ≤ L := Nat.cast_nonneg _
    have : (0 : ℝ) ≤ dB := Nat.cast_nonneg _
    rw [hX]; nlinarith
  have hLX : (L : ℝ) ≤ X := by
    have : (0 : ℝ) ≤ dB := Nat.cast_nonneg _
    rw [hX]; nlinarith
  have hNX : (N : ℝ) ≤ X := by
    have h1 : N ≤ (L + 1) * dB := by
      calc N = ∑ i, (v i).dim := rfl
        _ ≤ ∑ _i : Fin (L + 1), dB := Finset.sum_le_sum (fun i _ => hdim i)
        _ = (L + 1) * dB := by simp
    have h2 : ((L + 1) * dB : ℕ) ≤ ((L : ℝ) + 1) * ((dB : ℝ) + 1) := by
      push_cast; have : (0 : ℝ) ≤ L := Nat.cast_nonneg _; nlinarith
    calc (N : ℝ) ≤ ((L + 1) * dB : ℕ) := by exact_mod_cast h1
      _ ≤ X := h2
  have hsX : ∀ j, (s j : ℝ) ≤ 2 * X := by
    intro j
    have := hdimX j.castSucc; have := hdimX j.succ
    simp only [hs]; push_cast; linarith
  have hmX : ((∑ j, s j : ℕ) : ℝ) ≤ 2 * X := by
    have h1 : ∑ j, s j ≤ L * (2 * dB) := by
      calc ∑ j, s j ≤ ∑ _j : Fin L, 2 * dB := Finset.sum_le_sum (fun j _ => by
            simp only [hs]; have := hdim j.castSucc; have := hdim j.succ; omega)
        _ = L * (2 * dB) := by simp
    have h2 : ((L * (2 * dB) : ℕ) : ℝ) ≤ 2 * X := by
      push_cast; have : (0 : ℝ) ≤ L := Nat.cast_nonneg _
      have : (0 : ℝ) ≤ dB := Nat.cast_nonneg _
      rw [hX]; nlinarith
    calc ((∑ j, s j : ℕ) : ℝ) ≤ ((L * (2 * dB) : ℕ) : ℝ) := by exact_mod_cast h1
      _ ≤ 2 * X := h2
  -- the node potentials
  set ψ : Fin (L + 1) → ℝ := fun i => r ^ 2 * (v i).lam +
    1 / 2 * chartMatrixPhase (v i).C (pathNode v t i) (pathNode v t i) +
    1 / 2 * chartAltForm (v i).C (pathNode v y i) (pathNode v t i) with hψ
  have hedgeB : ∀ j : Fin L, |ψ j.castSucc - ψ j.succ| ≤ B + (2 * X) ^ 2 * B ^ 2 * (D + B) := by
    intro j
    have h1 := heff j
    have h2 := hdist j
    rw [hVcol j] at h1 h2
    set Vj : EuclideanSpace ℝ (Fin (s j)) := WithLp.toLp 2 (fun b => t (σ j b)) with hVj
    set Gj : EuclideanSpace ℝ (Fin (s j)) := WithLp.toLp 2 (fun b => y (σ j b)) with hGj
    set Fj := (U j).starProjection Vj with hFj
    have hFU : Fj ∈ U j := (U j).starProjection_apply_mem Vj
    have hGF : Gj - Fj ∈ U j := sub_mem (hyU j) hFU
    have hcorr : chartAltForm (tagDiffC (v j.castSucc) (v j.succ)) Gj.ofLp Vj.ofLp -
        chartAltForm (tagDiffC (v j.castSucc) (v j.succ)) Fj.ofLp Vj.ofLp =
        chartAltForm (tagDiffC (v j.castSucc) (v j.succ)) (Gj - Fj).ofLp (Vj - Fj).ofLp := by
      have hz := hiso j Fj hFU (Gj - Fj) hGF
      rw [WithLp.ofLp_sub] at hz
      rw [WithLp.ofLp_sub, WithLp.ofLp_sub, chartAltForm_sub_right, hz, sub_zero,
        chartAltForm_sub_left]
    have hVF : ‖Vj - Fj‖ ≤ B := by
      rw [hFj, ← Submodule.starProjection_orthogonal_val]; exact h2
    have hGV : ‖Gj - Vj‖ ≤ D := by
      have : Gj - Vj = WithLp.toLp 2 (fun b => (y - t) (σ j b)) := by ext b; simp [hGj, hVj]
      rw [this, hD, norm_sub_rev]; exact norm_toLp_comp_le (hσi j) _
    have hGF' : ‖Gj - Fj‖ ≤ D + B := by
      calc ‖Gj - Fj‖ = ‖(Gj - Vj) + (Vj - Fj)‖ := by congr 1; abel
        _ ≤ ‖Gj - Vj‖ + ‖Vj - Fj‖ := norm_add_le _ _
        _ ≤ D + B := add_le_add hGV hVF
    have hbd := abs_chartAltForm_le (tagDiffC (v j.castSucc) (v j.succ)) hB0
      (abs_tagDiffC_le hB0 (hC _) (hC _)) (Gj - Fj) (Vj - Fj)
    have hs2 : ((s j : ℕ) : ℝ) * (s j : ℕ) ≤ (2 * X) ^ 2 := by
      have := hsX j; have : (0 : ℝ) ≤ s j := Nat.cast_nonneg _; nlinarith
    have hc : |chartAltForm (tagDiffC (v j.castSucc) (v j.succ)) (Gj - Fj).ofLp (Vj - Fj).ofLp| ≤
        2 * ((2 * X) ^ 2 * B) * (D + B) * B := by
      refine hbd.trans ?_
      have : ((s j : ℕ) : ℝ) * (s j : ℕ) * B ≤ (2 * X) ^ 2 * B := by gcongr
      gcongr
    have hid : ψ j.castSucc - ψ j.succ =
        (tagDiffΛ r (v j.castSucc) (v j.succ) 0 0 +
          1 / 2 * chartMatrixPhase (tagDiffC (v j.castSucc) (v j.succ)) (fun b => t (σ j b))
            (fun b => t (σ j b)) +
          1 / 2 * chartAltForm (tagDiffC (v j.castSucc) (v j.succ)) Fj.ofLp
            (fun b => t (σ j b))) +
        1 / 2 * chartAltForm (tagDiffC (v j.castSucc) (v j.succ)) (Gj - Fj).ofLp
            (Vj - Fj).ofLp := by
      rw [← hcorr]
      rw [show chartMatrixPhase (tagDiffC (v j.castSucc) (v j.succ)) (fun b => t (σ j b))
          (fun b => t (σ j b)) = _ from chartMatrixPhase_pathPair v _ _ t t]
      rw [show chartAltForm (tagDiffC (v j.castSucc) (v j.succ)) Gj.ofLp Vj.ofLp = _ from
          chartAltForm_pathPair v _ _ y t]
      simp only [hψ, tagDiffΛ, hVj]
      ring
    rw [hid]
    calc _ ≤ |tagDiffΛ r (v j.castSucc) (v j.succ) 0 0 +
          1 / 2 * chartMatrixPhase (tagDiffC (v j.castSucc) (v j.succ)) (fun b => t (σ j b))
            (fun b => t (σ j b)) +
          1 / 2 * chartAltForm (tagDiffC (v j.castSucc) (v j.succ)) Fj.ofLp
            (fun b => t (σ j b))| +
        |1 / 2 * chartAltForm (tagDiffC (v j.castSucc) (v j.succ)) (Gj - Fj).ofLp
            (Vj - Fj).ofLp| := abs_add_le _ _
      _ ≤ B + 1 / 2 * (2 * ((2 * X) ^ 2 * B) * (D + B) * B) := by
          rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
          gcongr
      _ = B + (2 * X) ^ 2 * B ^ 2 * (D + B) := by ring
  have htel : |ψ 0 - ψ (Fin.last L)| ≤ X * (B + (2 * X) ^ 2 * B ^ 2 * (D + B)) := by
    rw [← sum_castSucc_sub_succ ψ]
    calc _ ≤ ∑ j : Fin L, |ψ j.castSucc - ψ j.succ| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _j : Fin L, (B + (2 * X) ^ 2 * B ^ 2 * (D + B)) :=
          Finset.sum_le_sum (fun j _ => hedgeB j)
      _ = L * (B + (2 * X) ^ 2 * B ^ 2 * (D + B)) := by simp; ring
      _ ≤ _ := by gcongr
  -- the endpoint subspace
  obtain ⟨P, -, hP2, -, hP4, -, -⟩ := rationalMatrix_projection_bounds (d := N) le_rfl hB M hMh
  set E₁ := Real.exp (8 * (N + 1 : ℝ) ^ 4 * Real.log (2 * B)) with hE₁
  have hlog0 : 0 ≤ Real.log (2 * B) := Real.log_nonneg (by linarith)
  have hE₁2 : 2 ≤ E₁ := by
    have h1 : (1 : ℝ) ≤ 8 * (N + 1 : ℝ) ^ 4 := by
      have : (1 : ℝ) ≤ (N + 1 : ℝ) ^ 4 := one_le_pow₀ (by
        have : (0 : ℝ) ≤ N := Nat.cast_nonneg _
        linarith)
      linarith
    calc (2 : ℝ) ≤ 2 * B := by linarith
      _ = Real.exp (Real.log (2 * B)) := (Real.exp_log (by linarith)).symm
      _ ≤ E₁ := Real.exp_le_exp.mpr (by nlinarith)
  set τ := pathPair v 0 (Fin.last L) with hτ
  have hτi : Function.Injective τ := pathPair_injective v (by
    rw [Ne, Fin.ext_iff]; simp; omega)
  obtain ⟨W', Q', h1', h2', h3', h4', hin, hout⟩ :=
    rational_restrict_subspace hE₁2 P Kᗮ hP2 hP4 τ
  have hTcol : (fun c => tagDiffV r (v 0) (v (Fin.last L)) c 0) = fun c => t (τ c) :=
    (pathVector_pair r v _ _).symm
  set T : EuclideanSpace ℝ (Fin ((v 0).dim + (v (Fin.last L)).dim)) :=
    WithLp.toLp 2 (fun c => t (τ c)) with hT
  set u : EuclideanSpace ℝ (Fin ((v 0).dim + (v (Fin.last L)).dim)) :=
    WithLp.toLp 2 (fun c => y (τ c)) with hu
  have huW : u ∈ W' := hin y hyW
  have iso' : ∀ x ∈ W', ∀ x₂ ∈ W',
      chartAltForm (tagDiffC (v 0) (v (Fin.last L))) x₂.ofLp x.ofLp = 0 := by
    intro x hx x₂ hx₂
    obtain ⟨z, hz, rfl⟩ := hout x hx
    obtain ⟨z₂, hz₂, rfl⟩ := hout x₂ hx₂
    have hzU := (mem_stackedConstraint_kernel s σ Q U hQ1 z).mp hz
    have hz₂U := (mem_stackedConstraint_kernel s σ Q U hQ1 z₂).mp hz₂
    rw [show chartAltForm (tagDiffC (v 0) (v (Fin.last L))) (WithLp.toLp 2 fun c => z₂ (τ c)).ofLp
        (WithLp.toLp 2 fun c => z (τ c)).ofLp = _ from chartAltForm_pathPair v _ _ z₂ z]
    rw [← sum_castSucc_sub_succ (fun i => chartAltForm (v i).C (pathNode v z₂ i) (pathNode v z i))]
    apply Finset.sum_eq_zero
    intro j _
    have h := hiso j _ (hzU j) _ (hz₂U j)
    simp only [hσ] at h
    rw [chartAltForm_pathPair] at h
    exact h
  have hTu : T - u = WithLp.toLp 2 (fun c => (t - y) (τ c)) := by ext c; simp [hT, hu]
  have hTuD : ‖T - u‖ ≤ D := by rw [hTu, hD]; exact norm_toLp_comp_le hτi _
  have dist' : ‖W'ᗮ.starProjection T‖ ≤ D := by
    have h0 : W'ᗮ.starProjection u = 0 := Submodule.starProjection_orthogonal_apply_eq_zero huW
    calc ‖W'ᗮ.starProjection T‖ = ‖W'ᗮ.starProjection (T - u)‖ := by
          rw [map_sub, h0, sub_zero]
      _ ≤ ‖T - u‖ := Submodule.norm_starProjection_apply_le _ _
      _ ≤ D := hTuD
  set F' := W'.starProjection T with hF'
  have hF'W : F' ∈ W' := W'.starProjection_apply_mem T
  have hFu : F' - u ∈ W' := sub_mem hF'W huW
  have hTF : ‖T - F'‖ ≤ D := by
    rw [hF', ← Submodule.starProjection_orthogonal_val]; exact dist'
  have hFuD : ‖F' - u‖ ≤ 2 * D := by
    calc ‖F' - u‖ = ‖(T - u) - (T - F')‖ := by congr 1; abel
      _ ≤ ‖T - u‖ + ‖T - F'‖ := norm_sub_le _ _
      _ ≤ 2 * D := by linarith
  have hcorr' : chartAltForm (tagDiffC (v 0) (v (Fin.last L))) F'.ofLp T.ofLp -
      chartAltForm (tagDiffC (v 0) (v (Fin.last L))) u.ofLp T.ofLp =
      chartAltForm (tagDiffC (v 0) (v (Fin.last L))) (F' - u).ofLp (T - u).ofLp := by
    have hz := iso' u huW (F' - u) hFu
    rw [WithLp.ofLp_sub] at hz
    rw [WithLp.ofLp_sub, WithLp.ofLp_sub, chartAltForm_sub_right, hz, sub_zero,
      chartAltForm_sub_left]
  have hn'X : (((v 0).dim + (v (Fin.last L)).dim : ℕ) : ℝ) ≤ 2 * X := by
    have := hdimX 0; have := hdimX (Fin.last L); push_cast; linarith
  have hc' : |chartAltForm (tagDiffC (v 0) (v (Fin.last L))) (F' - u).ofLp (T - u).ofLp| ≤
      2 * ((2 * X) ^ 2 * B) * (2 * D) * D := by
    refine (abs_chartAltForm_le _ hB0 (abs_tagDiffC_le hB0 (hC _) (hC _)) _ _).trans ?_
    have h0 : (0 : ℝ) ≤ (((v 0).dim + (v (Fin.last L)).dim : ℕ) : ℝ) := Nat.cast_nonneg _
    have : (((v 0).dim + (v (Fin.last L)).dim : ℕ) : ℝ) *
        (((v 0).dim + (v (Fin.last L)).dim : ℕ) : ℝ) * B ≤ (2 * X) ^ 2 * B := by
      gcongr; nlinarith
    gcongr
  have hid' : tagDiffΛ r (v 0) (v (Fin.last L)) 0 0 +
      1 / 2 * chartMatrixPhase (tagDiffC (v 0) (v (Fin.last L))) T.ofLp T.ofLp +
      1 / 2 * chartAltForm (tagDiffC (v 0) (v (Fin.last L))) F'.ofLp T.ofLp =
      (ψ 0 - ψ (Fin.last L)) +
        1 / 2 * chartAltForm (tagDiffC (v 0) (v (Fin.last L))) (F' - u).ofLp (T - u).ofLp := by
    rw [← hcorr']
    rw [show chartMatrixPhase (tagDiffC (v 0) (v (Fin.last L))) T.ofLp T.ofLp = _ from
      chartMatrixPhase_pathPair v _ _ t t]
