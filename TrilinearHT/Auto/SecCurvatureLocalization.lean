theorem chartBlockMatrix_smul {d e : ℕ} (c : ℚ) (C : Matrix (Fin d) (Fin d) ℚ)
    (D : Matrix (Fin e) (Fin e) ℚ) :
    chartBlockMatrix (c • C) (c • D) = c • chartBlockMatrix C D := by
  ext i j
  refine Fin.addCases (fun i => ?_) (fun i => ?_) i <;>
    refine Fin.addCases (fun j => ?_) (fun j => ?_) j <;>
    simp [chartBlockMatrix]

/-- Blueprint lem:graph (same slot): pure columns of two tags in one slot (multiplier `c ≠ 0`)
whose tags are not joined by an edge at length `r` have normalized inner product at most `τ` on
every interval of length `r`. -/
theorem graph_sameSlot_tag (c₀ : ℕ) (hc : 1 ≤ c₀) :
    ∃ D : ℕ, 1 ≤ D ∧ ∀ (H τ : ℝ), Real.exp 2 ≤ H → 0 < τ → τ ≤ 1 →
    ∀ (v w : ChartTag) (c : ℤ), c ≠ 0 →
    ∀ (A : QuadraticChartData v.dim) (B : QuadraticChartData w.dim),
    QuadraticChartComplexity c₀ H A → QuadraticChartComplexity c₀ H B →
    IsBoundedQuadraticChart A → IsBoundedQuadraticChart B →
    A.horizontal = v.θ → A.matrix = (c : ℚ) • v.C → A.quadratic = c * v.lam →
    B.horizontal = w.θ → B.matrix = (c : ℚ) • w.C → B.quadratic = c * w.lam →
    ∀ (a₀ r : ℝ), 0 < r →
    ¬ tagEdge (Real.exp (D * (1 + Real.log H + Real.log τ⁻¹) ^ D)) r v w →
    ‖∫ y, quadraticChartAtom A y * star (quadraticChartAtom B y)
      ∂(normalizedIntervalMeasure a₀ r)‖ ≤ τ := by
  obtain ⟨D, hD, hsame⟩ := graph_sameSlot c₀ hc
  refine ⟨D, hD, fun H τ hH hτ hτ1 v w c hc0 A B hA hB hAb hBb hAh hAm hAq hBh hBm hBq a₀ r hr
    hne => ?_⟩
  by_contra hlt
  have h := hsame H τ hH hτ hτ1 A B hA hB hAb hBb a₀ r hr (lt_of_not_ge hlt)
  apply hne
  rw [hAh, hBh, hAm, hBm, hAq, hBq, ← smul_neg, chartBlockMatrix_smul] at h
  refine WeylSplitData.of_smul hc0 ?_
  have e : (fun _ _ => r ^ 2 * ((c : ℝ) * v.lam - c * w.lam) : Matrix (Fin 1) (Fin 1) ℝ) =
      (c : ℝ) • tagDiffΛ r v w := by
    funext i j; simp only [tagDiffΛ, Matrix.smul_apply, smul_eq_mul]; ring
  rw [e] at h
  exact h


/-- Blueprint lem:weyl in one real variable at scale `r`: a large Fourier coefficient of
`ζ(u) Q(r u)` gives `eq:weyl-splitting` for the dilated chart data `(r θ, C, r² λ)`. -/
theorem weylSplit_of_oneVar (c₀ : ℕ) (hc : 1 ≤ c₀) (R : ℝ) (hR : 0 ≤ R) :
    ∃ Dw : ℕ, 1 ≤ Dw ∧ ∀ {d : ℕ} (H δ r : ℝ) (A : QuadraticChartData d),
      QuadraticChartComplexity c₀ H A →
      ∀ ζ : ℝ → ℂ, Measurable ζ → (∀ u, ‖ζ u‖ ≤ H) → (∀ u v, ‖ζ v - ζ u‖ ≤ H * |v - u|) →
      (∀ u, ζ u ≠ 0 → |u| ≤ R) → 0 < δ →
      (∀ s < δ, ∃ ξ : ℝ, s < ‖∫ u, (Real.fourierChar (-(u * ξ)) : ℂ) *
        (ζ u * quadraticChartAtom A (r * u))‖) →
      WeylSplitData (Real.exp (Dw * (1 + Real.log H + Real.log (max 1 δ⁻¹)) ^ Dw))
        (fun i _ => A.horizontal i * r) A.matrix (fun _ _ => A.quadratic * r ^ 2) := by
  obtain ⟨Dw, hDw, hweyl⟩ := weylSplitting c₀ hc R hR
  refine ⟨Dw, hDw, fun {d} H δ r A hA ζ hζm hζ hζL hζs hδ hsup => ?_⟩
  set A' := oneVariableChart (dilateQuadraticChart r A) with hA'
  have hA'c : MultivariableQuadraticChartComplexity c₀ H A' :=
    oneVariableChart_complexity (dilateQuadraticChart_complexity hA r)
  set θw : (Fin 1 → ℝ) → ℂ := fun z => ζ (z 0) with hθw
  have hθm : Measurable θw := hζm.comp (measurable_pi_apply 0)
  have hθb : ∀ z, ‖θw z‖ ≤ H := fun z => hζ _
  have hθL : ∀ x y, ‖θw y - θw x‖ ≤ H * ‖y - x‖ := fun x y => by
    have hH0 : 0 ≤ H := (quadraticChartComplexity_parameter_pos hA).le
    refine (hζL (x 0) (y 0)).trans (mul_le_mul_of_nonneg_left ?_ hH0)
    have := norm_le_pi_norm (y - x) 0
    rwa [Pi.sub_apply, Real.norm_eq_abs] at this
  have hθs : ∀ z, θw z ≠ 0 → ∀ i, |z i| ≤ R := fun z hz i => by
    have : i = 0 := Subsingleton.elim _ _
    subst this; exact hζs _ hz
  have hF : ∀ s < δ, ∃ ξ : EuclideanSpace ℝ (Fin 1), s < ‖𝓕 (fun z : EuclideanSpace ℝ (Fin 1) =>
      θw z.ofLp * multivariableQuadraticChartAtom A' z.ofLp) ξ‖ := by
    intro s hs
    obtain ⟨ξ, hξ⟩ := hsup s hs
    refine ⟨EuclideanSpace.single 0 ξ, ?_⟩
    have he : (fun z : EuclideanSpace ℝ (Fin 1) =>
        θw z.ofLp * multivariableQuadraticChartAtom A' z.ofLp) =
        fun z => (fun u => ζ u * quadraticChartAtom A (r * u)) (z.ofLp 0) := by
      funext z
      simp only [hθw, hA', oneVariableChart_atom, dilateQuadraticChart_atom]
    rw [he, fourier_euclidean_one (fun u => ζ u * quadraticChartAtom A (r * u))]
    simpa using hξ
  obtain ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩ :=
    hweyl (k := 1) le_rfl (by norm_num) H A' hA'c θw hθm hθb hθL hθs δ hδ hF
  exact ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩

/-- The slot multipliers `c = (-1, 3, -3, 1)` of the local form (blueprint §12.1, line 1679). -/
def slotCoeff : Fin 4 → ℤ := ![-1, 3, -3, 1]

/-- `∑ c_l l^u = 0` for `u = 0, 1, 2` gives `c_i S_i = -c_k S_k` for the time-factor coefficients
`S_l = (l - a)(l - b)` of lem:separation, and these are nonzero. -/
theorem slotCoeff_time_identity : ∀ i k a b : Fin 4, i ≠ k → a ≠ b → a ≠ i → a ≠ k → b ≠ i →
    b ≠ k → slotCoeff i * (((i : ℕ) : ℤ) - (a : ℕ)) * (((i : ℕ) : ℤ) - (b : ℕ)) =
      -(slotCoeff k * (((k : ℕ) : ℤ) - (a : ℕ)) * (((k : ℕ) : ℤ) - (b : ℕ))) ∧
      slotCoeff i * (((i : ℕ) : ℤ) - (a : ℕ)) * (((i : ℕ) : ℤ) - (b : ℕ)) ≠ 0 := by
  decide

/-- The two-sided trapezoid cutoff equal to one on `[-1, 1]` and supported in `[-2, 2]`. -/
noncomputable def plateauTwo (u : ℝ) : ℝ := max 0 (min 1 (2 - |u|))

theorem plateauTwo_continuous : Continuous plateauTwo := by unfold plateauTwo; fun_prop

theorem plateauTwo_eq_one {u : ℝ} (hu : |u| ≤ 1) : plateauTwo u = 1 := by
  unfold plateauTwo; rw [min_eq_left (by linarith), max_eq_right zero_le_one]

theorem plateauTwo_nonneg (u : ℝ) : 0 ≤ plateauTwo u := le_max_left _ _

theorem plateauTwo_le_one (u : ℝ) : plateauTwo u ≤ 1 := max_le zero_le_one (min_le_left _ _)

theorem plateauTwo_support {u : ℝ} (h : plateauTwo u ≠ 0) : |u| ≤ 2 := by
  by_contra hu
  apply h
  unfold plateauTwo
  exact le_antisymm (max_le le_rfl ((min_le_right _ _).trans (by linarith))) (le_max_left _ _)

theorem plateauTwo_lipschitz (u v : ℝ) : |plateauTwo v - plateauTwo u| ≤ |v - u| := by
  unfold plateauTwo
  refine (abs_max_sub_max_le_max _ _ _ _).trans (max_le (by simp) ?_)
  refine (abs_min_sub_min_le_max _ _ _ _).trans (max_le (by simp) ?_)
  rw [show 2 - |v| - (2 - |u|) = -(|v| - |u|) by ring, abs_neg]
  exact abs_abs_sub_abs_le_abs_sub v u

theorem plateauTwo_integrable : Integrable plateauTwo := by
  refine plateauTwo_continuous.integrable_of_hasCompactSupport ?_
  refine HasCompactSupport.intro (isCompact_Icc (a := -2) (b := 2)) fun u hu => ?_
  by_contra h
  exact hu (abs_le.mp (plateauTwo_support h))


/-- The core of the distinct-slot separation: a pair of pure columns in distinct slots with a
large form against normalized spectators has a time factor of lem:separation, of controlled
size, with a large Fourier coefficient at scale `r`. -/
theorem graph_distinct_core (κ : LocalKernelClass) (c₀ : ℕ) (hc : 1 ≤ c₀) :
    ∃ (c₁ D : ℕ), 1 ≤ c₁ ∧ 1 ≤ D ∧ ∀ (H τ : ℝ), Real.exp 2 ≤ H → 0 < τ → τ ≤ 1 →
    ∀ {d e : ℕ} (A : QuadraticChartData d) (A' : QuadraticChartData e), 1 ≤ d → 1 ≤ e →
    QuadraticChartComplexity c₀ H A → QuadraticChartComplexity c₀ H A' →
    IsBoundedQuadraticChart A → IsBoundedQuadraticChart A' →
    ∀ {a i k b : Fin 4}, a ≠ i → a ≠ k → a ≠ b → i ≠ k → i ≠ b → k ≠ b →
    ∀ {a₀ r : ℝ}, 0 < r → ∀ {w : ℝ × ℝ → ℂ}, IsAdmissibleLocalKernel κ a₀ r w →
    ¬ PairSmall a₀ r w i k (quadraticChartAtom A) (quadraticChartAtom A') τ →
    let E := Real.exp (D * (1 + Real.log H + Real.log τ⁻¹) ^ D)
    ∃ Φ : QuadraticChartData (d + e), QuadraticChartComplexity c₁ E Φ ∧
      Φ.horizontal = Fin.append A.horizontal A'.horizontal ∧
      Φ.matrix = chartBlockMatrix (((((i : ℕ) : ℤ) - (a : ℕ)) * (((i : ℕ) : ℤ) - (b : ℕ)) : ℚ) •
        A.matrix) (((((k : ℕ) : ℤ) - (a : ℕ)) * (((k : ℕ) : ℤ) - (b : ℕ)) : ℚ) • A'.matrix) ∧
      Φ.quadratic = (((((i : ℕ) : ℤ) - (a : ℕ)) * (((i : ℕ) : ℤ) - (b : ℕ)) : ℚ) : ℝ) *
          A.quadratic + (((((k : ℕ) : ℤ) - (a : ℕ)) * (((k : ℕ) : ℤ) - (b : ℕ)) : ℚ) : ℝ) *
          A'.quadratic ∧
      ∀ s < E⁻¹, ∃ ξ : ℝ, s < ‖∫ u, (Real.fourierChar (-(u * ξ)) : ℂ) *
        ((plateauTwo u : ℂ) * quadraticChartAtom Φ (r * u))‖ := by
  obtain ⟨c₁, Dp, hc₁, hDp, hsep⟩ := progressionSeparation c₀ hc
  set W' := localFormUniformConstant κ with hW'
  set K' := kernelFourierConst κ with hK'
  have hW'0 : 0 ≤ W' := localFormUniformConstant_nonneg κ
  have hK'0 : 0 ≤ K' := by
    rw [hK']; unfold kernelFourierConst
    have := kernelDerivBound_nonneg κ 0
    have := kernelDerivBound_nonneg κ 3
    positivity
  -- the exponents
  set kE : ℕ := Dp with hkE
  set kW : ℕ := ⌈W'⌉₊ with hkW
  set kK : ℕ := ⌈K' + 1⌉₊ with hkK
  set kT : ℕ := 2 + kE + kW + 1 with hkT
  set kH : ℕ := 6 * (kE + kT) + (kE + kT) with hkH
  set kδ : ℕ := 2 + kE + kK + 1 with hkδ
  refine ⟨c₁, kH + kδ, hc₁, by omega, ?_⟩
  intro H τ hH hτ hτ1 d e A A' hd he hA hA' hAb hA'b a i k b hai hak hab hik hib hkb a₀ r hr w hw
    hns E
  -- the budget variable
  have hlogH : 2 ≤ Real.log H := by
    rw [← Real.log_exp 2]; exact Real.log_le_log (Real.exp_pos 2) hH
  have hlτ : 0 ≤ Real.log τ⁻¹ := Real.log_nonneg (one_le_inv₀ hτ |>.mpr hτ1)
  set Y := 1 + Real.log H + Real.log τ⁻¹ with hY
  have hY1 : 1 ≤ Y := by linarith
  have hH1 : 1 ≤ H := by linarith [Real.add_one_le_exp (2 : ℝ)]
  set Es := Real.exp (Dp * (1 + Real.log H) ^ Dp) with hEs
  have hEs0 : 0 < Es := Real.exp_pos _
  have qEs : QPLe Y kE Es := by
    unfold QPLe
    apply Real.exp_le_exp.mpr
    exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by linarith) (by linarith) Dp)
      (Nat.cast_nonneg _)
  have qinv : QPLe Y 1 τ⁻¹ := qple_of_exp_Y (by positivity) (by linarith)
  have q2 : QPLe Y 2 (2 : ℝ) := by
    have := QPLe.const hY1 (2 : ℝ); simpa using this
  have qW : QPLe Y kW W' := QPLe.const hY1 W'
  have qK : QPLe Y kK (K' + 1) := QPLe.const hY1 (K' + 1)
  set T₀ := max 1 (2 * Es * W' * τ⁻¹) with hT₀
  have qT : QPLe Y kT T₀ := qple_max (QPLe.one_le hY1)
    (((q2.mul hY1 hEs0.le qEs).mul hY1 hW'0 qW).mul hY1 (by positivity) qinv)
  have hT₀1 : 1 ≤ T₀ := le_max_left _ _
  set H₁ := (Es * T₀) ^ 6 with hH₁
  have qH₁ : QPLe Y kH H₁ := (qEs.mul hY1 (by linarith) qT).pow hY1 (by positivity) 6
  set δ := τ / (2 * Es * (K' + 1)) with hδ
  have hδ0 : 0 < δ := by positivity
  have hδinv : δ⁻¹ = 2 * Es * (K' + 1) * τ⁻¹ := by rw [hδ]; field_simp
  have qδ : QPLe Y kδ δ⁻¹ := by
    rw [hδinv]; exact ((q2.mul hY1 hEs0.le qEs).mul hY1 (by positivity) qK).mul hY1
      (by positivity) qinv
  have hEbig : max H₁ δ⁻¹ ≤ E := by
    have := qple_max (qH₁.mono hY1 (Nat.le_add_right kH kδ))
      (qδ.mono hY1 (Nat.le_add_left kδ kH))
    exact this
  have hH₁E : H₁ ≤ E := (le_max_left _ _).trans hEbig
  have hEδ : E⁻¹ ≤ δ := by
    have h1 : δ⁻¹ ≤ E := (le_max_right _ _).trans hEbig
    calc E⁻¹ ≤ (δ⁻¹)⁻¹ := inv_anti₀ (inv_pos.mpr hδ0) h1
      _ = δ := inv_inv δ
  -- the failure of pair smallness
  simp only [PairSmall, not_forall, not_le] at hns
  obtain ⟨z, hzm, hz2, hlt⟩ := hns
  set f := slotPair z i k (quadraticChartAtom A) (quadraticChartAtom A') with hf
  have hfi : f i = quadraticChartAtom A := slotPair_left hik _ _
  have hfk : f k = quadraticChartAtom A' := slotPair_right _ _ _ _ _
  have hfa : f a = z a := slotPair_other hai hak _ _
  have hfb : f b = z b := slotPair_other (Ne.symm hib) (Ne.symm hkb) _ _
  have hza := hz2 a hai hak
  have hzb := hz2 b (Ne.symm hib) (Ne.symm hkb)
  -- the separation expansion
  have habz : ((a : ℕ) : ℤ) ≠ ((b : ℕ) : ℤ) := fun h => hab (Fin.ext (by exact_mod_cast h))
  obtain ⟨τq, hτc, cf, φa, φb, φt, size, hexp, hbdd, hsize1, hcs, hcsum, htail, hcomp, -, htag⟩ :=
