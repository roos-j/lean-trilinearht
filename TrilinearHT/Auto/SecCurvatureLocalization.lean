variable {V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [DecidableEq ι]

theorem integrable_of_bound_support {E : Type*} [NormedAddCommGroup E] {f : ℝ → E}
    (hf : AEStronglyMeasurable f volume) {C : ℝ} (hC : ∀ y, ‖f y‖ ≤ C) {S : Set ℝ}
    (hS : MeasurableSet S) (hSfin : volume S ≠ ⊤) (hsupp : ∀ y, y ∉ S → f y = 0) :
    Integrable f := by
  have hg : Integrable (S.indicator (fun _ => C)) :=
    (integrableOn_const hSfin).integrable_indicator hS
  refine hg.mono' hf (Filter.Eventually.of_forall fun y => ?_)
  by_cases hy : y ∈ S
  · rw [Set.indicator_of_mem hy]; exact hC y
  · rw [Set.indicator_of_notMem hy, hsupp y hy, norm_zero]

omit [DecidableEq ι] in
theorem norm_sq_sum_of_disjoint (z : ι → ℂ) (h : ∀ G G', G ≠ G' → z G = 0 ∨ z G' = 0) :
    ‖∑ G, z G‖ ^ 2 = ∑ G, ‖z G‖ ^ 2 := by
  classical
  by_cases hz : ∃ G, z G ≠ 0
  · obtain ⟨G₀, hG₀⟩ := hz
    have hothers : ∀ G, G ≠ G₀ → z G = 0 := fun G hG =>
      (h G G₀ hG).resolve_right hG₀
    rw [Finset.sum_eq_single G₀ (fun G _ hG => hothers G hG) (by simp),
      Finset.sum_eq_single G₀ (fun G _ hG => by rw [hothers G hG, norm_zero]; ring) (by simp)]
  · push Not at hz
    simp [hz]

omit [DecidableEq V] [DecidableEq ι] in
/-- Blueprint lem:whole-ranges, analytic core: group outputs `Z_G = Σ_v a_{v,G} Φ_v` with private
coordinates that never coincide on overlaps, cross physical pairings at most `τ ∫ |a_{v,G}|
|a_{w,G'}|`, at most `N` nonzero coefficients at each point and inverse private weights at most
`W₀²` satisfy `‖Σ_G Z_G‖² ≤ (1 + τ N W₀²) Σ_G ‖Z_G‖²`. -/
theorem wholeRanges_core (φ : V → ℝ → ℂ) (ε : V → ℝ) (hε : ∀ v, 0 < ε v) {W₀ : ℝ}
    (hW : ∀ v, 1 ≤ W₀ ^ 2 * ε v) (a : ι → V → ℝ → ℂ) {M : ℝ} {S : Set ℝ}
    (hS : MeasurableSet S) (hSfin : volume S ≠ ⊤) (ha_meas : ∀ G v, Measurable (a G v))
    (hM0 : 0 ≤ M) (ha_bd : ∀ G v y, ‖a G v y‖ ≤ M) (ha_supp : ∀ G v y, y ∉ S → a G v y = 0)
    (hφm : ∀ v, Measurable (φ v)) (hφb : ∀ v y, ‖φ v y‖ ≤ M) {τ : ℝ} (hτ : 0 ≤ τ)
    (hpair : ∀ G G', G ≠ G' → ∀ v w,
      ‖∫ y, starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)‖ ≤
        τ * ∫ y, ‖a G v y‖ * ‖a G' w y‖)
    (hpriv : ∀ G G', G ≠ G' → ∀ v y, a G v y = 0 ∨ a G' v y = 0) {N : ℕ}
    (hN : ∀ y, ((Finset.univ : Finset (ι × V)).filter (fun p => a p.1 p.2 y ≠ 0)).card ≤ N) :
    ∫ y, ‖∑ G, groupOutput φ ε (a G) y‖ ^ 2 ≤
      (1 + τ * N * W₀ ^ 2) * ∑ G, ∫ y, ‖groupOutput φ ε (a G) y‖ ^ 2 := by
  classical
  have hε0 : ∀ v, 0 ≤ ε v := fun v => (hε v).le
  set P : ι → ℝ → ℂ := fun G y => ∑ v, a G v y * φ v y with hP
  set Q : ι → ℝ → ℝ := fun G y => ∑ u, ‖a G u y‖ ^ 2 * ε u with hQ
  have hZ : ∀ G y, ‖groupOutput φ ε (a G) y‖ ^ 2 = ‖P G y‖ ^ 2 + Q G y := fun G y =>
    norm_sq_groupOutput φ ε (a G) y hε0
  have hsum : ∀ y, ‖∑ G, groupOutput φ ε (a G) y‖ ^ 2 =
      ∑ G, (‖P G y‖ ^ 2 + Q G y) +
        ∑ G, ∑ G' ∈ Finset.univ.erase G, (starRingEnd ℂ (P G y) * P G' y).re := by
    intro y
    rw [sum_groupOutput, norm_sq_groupOutput _ _ _ _ hε0]
    have e1 : ∑ v, (∑ G, a G v y) * φ v y = ∑ G, P G y := by
      simp only [hP, Finset.sum_mul]; exact Finset.sum_comm
    have e2 : ∑ u, ‖∑ G, a G u y‖ ^ 2 * ε u = ∑ G, Q G y := by
      simp only [hQ]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl; intro u _
      rw [norm_sq_sum_of_disjoint (fun G => a G u y) (fun G G' h => hpriv G G' h u y),
        Finset.sum_mul]
    rw [e1, e2, norm_sq_sum_eq, Finset.sum_add_distrib]
    ring
  -- integrability
  have hsuppP : ∀ G y, y ∉ S → P G y = 0 := fun G y hy => by
    simp only [hP]; exact Finset.sum_eq_zero fun v _ => by rw [ha_supp G v y hy, zero_mul]
  have hsuppQ : ∀ G y, y ∉ S → Q G y = 0 := fun G y hy => by
    simp only [hQ]; exact Finset.sum_eq_zero fun v _ => by rw [ha_supp G v y hy]; simp
  have hPm : ∀ G, Measurable (P G) := fun G =>
    Finset.measurable_sum _ fun v _ => (ha_meas G v).mul (hφm v)
  have hQm : ∀ G, Measurable (Q G) := fun G =>
    Finset.measurable_sum _ fun v _ => ((ha_meas G v).norm.pow_const 2).mul measurable_const
  have hPb : ∀ G y, ‖P G y‖ ≤ Fintype.card V * (M * M) := by
    intro G y
    refine (norm_sum_le _ _).trans ?_
    calc ∑ v, ‖a G v y * φ v y‖ ≤ ∑ _v : V, M * M := Finset.sum_le_sum fun v _ => by
          rw [norm_mul]; exact mul_le_mul (ha_bd G v y) (hφb v y) (norm_nonneg _) hM0
      _ = _ := by simp
  have hQb : ∀ G y, ‖Q G y‖ ≤ ∑ u, M ^ 2 * ε u := by
    intro G y
    rw [Real.norm_eq_abs, abs_of_nonneg (Finset.sum_nonneg fun u _ =>
      mul_nonneg (sq_nonneg _) (hε0 u))]
    exact Finset.sum_le_sum fun u _ => mul_le_mul_of_nonneg_right
      (pow_le_pow_left₀ (norm_nonneg _) (ha_bd G u y) 2) (hε0 u)
  have hintZ : ∀ G, Integrable (fun y => ‖P G y‖ ^ 2 + Q G y) := by
    intro G
    refine integrable_of_bound_support (((hPm G).norm.pow_const 2).add (hQm G)).aestronglyMeasurable
      (C := (Fintype.card V * (M * M)) ^ 2 + ∑ u, M ^ 2 * ε u) (fun y => ?_) hS hSfin
      (fun y hy => by rw [hsuppP G y hy, hsuppQ G y hy]; simp)
    refine (norm_add_le _ _).trans (add_le_add ?_ (hQb G y))
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    exact pow_le_pow_left₀ (norm_nonneg _) (hPb G y) 2
  have hintRe : ∀ G G', Integrable (fun y => (starRingEnd ℂ (P G y) * P G' y).re) := by
    intro G G'
    refine integrable_of_bound_support
      ((Complex.measurable_re.comp ((Complex.continuous_conj.measurable.comp (hPm G)).mul
        (hPm G'))).aestronglyMeasurable)
      (C := (Fintype.card V * (M * M)) ^ 2) (fun y => ?_) hS hSfin
      (fun y hy => by simp [hsuppP G' y hy])
    refine (Complex.abs_re_le_norm _).trans ?_
    rw [norm_mul, Complex.norm_conj, sq]
    exact mul_le_mul (hPb G y) (hPb G' y) (norm_nonneg _) (by positivity)
  have hintC : ∀ G G' v w, Integrable (fun y =>
      starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)) := by
    intro G G' v w
    refine integrable_of_bound_support
      (((Complex.continuous_conj.measurable.comp ((ha_meas G v).mul (hφm v))).mul
        ((ha_meas G' w).mul (hφm w))).aestronglyMeasurable)
      (C := (M * M) * (M * M)) (fun y => ?_) hS hSfin
      (fun y hy => by simp [ha_supp G' w y hy])
    rw [norm_mul, Complex.norm_conj, norm_mul, norm_mul]
    exact mul_le_mul (mul_le_mul (ha_bd G v y) (hφb v y) (norm_nonneg _) hM0)
      (mul_le_mul (ha_bd G' w y) (hφb w y) (norm_nonneg _) hM0) (by positivity) (by positivity)
  have hintA : ∀ G G' v w, Integrable (fun y => ‖a G v y‖ * ‖a G' w y‖) := by
    intro G G' v w
    refine integrable_of_bound_support
      (((ha_meas G v).norm.mul (ha_meas G' w).norm).aestronglyMeasurable)
      (C := M * M) (fun y => ?_) hS hSfin (fun y hy => by simp [ha_supp G' w y hy])
    rw [Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    exact mul_le_mul (ha_bd G v y) (ha_bd G' w y) (norm_nonneg _) hM0
  -- step 1: the exact expansion of the integral
  have hstep1 : ∫ y, ‖∑ G, groupOutput φ ε (a G) y‖ ^ 2 =
      (∑ G, ∫ y, (‖P G y‖ ^ 2 + Q G y)) +
        ∑ G, ∑ G' ∈ Finset.univ.erase G, ∫ y, (starRingEnd ℂ (P G y) * P G' y).re := by
    rw [show (fun y => ‖∑ G, groupOutput φ ε (a G) y‖ ^ 2) = fun y => ∑ G, (‖P G y‖ ^ 2 + Q G y) +
        ∑ G, ∑ G' ∈ Finset.univ.erase G, (starRingEnd ℂ (P G y) * P G' y).re from funext hsum]
    rw [integral_add (integrable_finsetSum _ fun G _ => hintZ G)
      (integrable_finsetSum _ fun G _ => integrable_finsetSum _ fun G' _ => hintRe G G'),
      integral_finsetSum _ fun G _ => hintZ G,
      integral_finsetSum _ fun G _ => integrable_finsetSum _ fun G' _ => hintRe G G']
    congr 1
    apply Finset.sum_congr rfl; intro G _
    rw [integral_finsetSum _ fun G' _ => hintRe G G']
  -- step 2: each cross term
  have hstep2 : ∀ G G', G ≠ G' → ∫ y, (starRingEnd ℂ (P G y) * P G' y).re ≤
      τ * ∑ v, ∑ w, ∫ y, ‖a G v y‖ * ‖a G' w y‖ := by
    intro G G' hne
    have hexp : ∀ y, starRingEnd ℂ (P G y) * P G' y = ∑ v, ∑ w,
        starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y) := by
      intro y; simp only [hP, map_sum, Finset.sum_mul_sum]
    have hintCP : Integrable (fun y => starRingEnd ℂ (P G y) * P G' y) := by
      refine integrable_of_bound_support
        (((Complex.continuous_conj.measurable.comp (hPm G)).mul (hPm G')).aestronglyMeasurable)
        (C := (Fintype.card V * (M * M)) ^ 2) (fun y => ?_) hS hSfin
        (fun y hy => by simp [hsuppP G' y hy])
      rw [norm_mul, Complex.norm_conj, sq]
      exact mul_le_mul (hPb G y) (hPb G' y) (norm_nonneg _) (by positivity)
    calc ∫ y, (starRingEnd ℂ (P G y) * P G' y).re
        = (∫ y, starRingEnd ℂ (P G y) * P G' y).re := integral_re hintCP
      _ ≤ ‖∫ y, starRingEnd ℂ (P G y) * P G' y‖ := Complex.re_le_norm _
      _ = ‖∑ v, ∑ w, ∫ y, starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)‖ := by
          rw [show (fun y => starRingEnd ℂ (P G y) * P G' y) = fun y => ∑ v, ∑ w,
            starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y) from funext hexp,
            integral_finsetSum _ fun v _ => integrable_finsetSum _ fun w _ => hintC G G' v w]
          congr 1
          apply Finset.sum_congr rfl; intro v _
          rw [integral_finsetSum _ fun w _ => hintC G G' v w]
      _ ≤ ∑ v, ∑ w, ‖∫ y, starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)‖ :=
          (norm_sum_le _ _).trans (Finset.sum_le_sum fun v _ => norm_sum_le _ _)
      _ ≤ ∑ v, ∑ w, τ * ∫ y, ‖a G v y‖ * ‖a G' w y‖ :=
          Finset.sum_le_sum fun v _ => Finset.sum_le_sum fun w _ => hpair G G' hne v w
      _ = τ * ∑ v, ∑ w, ∫ y, ‖a G v y‖ * ‖a G' w y‖ := by
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro v _; rw [Finset.mul_sum]
  -- step 3: the pointwise Cauchy–Schwarz bound
  have hpt : ∀ y, ∑ G, ∑ G' ∈ Finset.univ.erase G, ∑ v, ∑ w, ‖a G v y‖ * ‖a G' w y‖ ≤
      N * W₀ ^ 2 * ∑ G, (‖P G y‖ ^ 2 + Q G y) := by
    intro y
    set x : ι × V → ℝ := fun p => ‖a p.1 p.2 y‖
    have h1 : ∑ G, ∑ G' ∈ Finset.univ.erase G, ∑ v, ∑ w, ‖a G v y‖ * ‖a G' w y‖ ≤
        (∑ p, x p) ^ 2 := by
      calc _ ≤ ∑ G, ∑ G', ∑ v, ∑ w, ‖a G v y‖ * ‖a G' w y‖ :=
            Finset.sum_le_sum fun G _ => Finset.sum_le_sum_of_subset_of_nonneg
              (Finset.erase_subset _ _) (fun _ _ _ => Finset.sum_nonneg fun _ _ =>
                Finset.sum_nonneg fun _ _ => by positivity)
        _ = (∑ p, x p) ^ 2 := by
            rw [sq, Fintype.sum_prod_type, Finset.sum_mul_sum]
            apply Finset.sum_congr rfl; intro G _
            apply Finset.sum_congr rfl; intro G' _
            rw [Finset.sum_mul_sum]
    have h2 : (∑ p, x p) ^ 2 ≤ N * ∑ p, x p ^ 2 := by
      apply sq_sum_le_of_support
      refine le_trans (Finset.card_le_card ?_) (hN y)
      intro p hp
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, x] at hp ⊢
      exact fun h => hp (by rw [h, norm_zero])
    have h3 : ∑ p, x p ^ 2 ≤ W₀ ^ 2 * ∑ G, (‖P G y‖ ^ 2 + Q G y) := by
      rw [Fintype.sum_prod_type, Finset.mul_sum]
      apply Finset.sum_le_sum; intro G _
      have hQ' : ∑ v, x (G, v) ^ 2 ≤ W₀ ^ 2 * Q G y := by
        simp only [hQ, Finset.mul_sum, x]
        apply Finset.sum_le_sum; intro v _
        have := hW v
        have h0 : 0 ≤ ‖a G v y‖ ^ 2 := sq_nonneg _
        nlinarith
      have : 0 ≤ W₀ ^ 2 * ‖P G y‖ ^ 2 := by positivity
      linarith
    have hN0 : (0 : ℝ) ≤ N := Nat.cast_nonneg _
    calc _ ≤ (∑ p, x p) ^ 2 := h1
      _ ≤ N * ∑ p, x p ^ 2 := h2
      _ ≤ N * (W₀ ^ 2 * ∑ G, (‖P G y‖ ^ 2 + Q G y)) := mul_le_mul_of_nonneg_left h3 hN0
      _ = _ := by ring
  -- step 4: assembling
  have hZint : ∀ G, ∫ y, ‖groupOutput φ ε (a G) y‖ ^ 2 = ∫ y, (‖P G y‖ ^ 2 + Q G y) :=
    fun G => by congr 1; funext y; exact hZ G y
  have hcross : ∑ G, ∑ G' ∈ Finset.univ.erase G, ∫ y, (starRingEnd ℂ (P G y) * P G' y).re ≤
      τ * (N * W₀ ^ 2 * ∑ G, ∫ y, (‖P G y‖ ^ 2 + Q G y)) := by
    calc _ ≤ ∑ G, ∑ G' ∈ Finset.univ.erase G, τ * ∑ v, ∑ w, ∫ y, ‖a G v y‖ * ‖a G' w y‖ :=
          Finset.sum_le_sum fun G _ => Finset.sum_le_sum fun G' hG' =>
            hstep2 G G' (Finset.ne_of_mem_erase hG').symm
      _ = τ * ∫ y, ∑ G, ∑ G' ∈ Finset.univ.erase G, ∑ v, ∑ w, ‖a G v y‖ * ‖a G' w y‖ := by
          rw [integral_finsetSum _ fun G _ => integrable_finsetSum _ fun G' _ =>
            integrable_finsetSum _ fun v _ => integrable_finsetSum _ fun w _ => hintA G G' v w]
          rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intro G _
          rw [integral_finsetSum _ fun G' _ => integrable_finsetSum _ fun v _ =>
            integrable_finsetSum _ fun w _ => hintA G G' v w, Finset.mul_sum]
          apply Finset.sum_congr rfl; intro G' _
          rw [integral_finsetSum _ fun v _ => integrable_finsetSum _ fun w _ => hintA G G' v w]
          congr 1; apply Finset.sum_congr rfl; intro v _
          rw [integral_finsetSum _ fun w _ => hintA G G' v w]
      _ ≤ τ * ∫ y, N * W₀ ^ 2 * ∑ G, (‖P G y‖ ^ 2 + Q G y) := by
          apply mul_le_mul_of_nonneg_left _ hτ
          apply integral_mono (integrable_finsetSum _ fun G _ => integrable_finsetSum _
            fun G' _ => integrable_finsetSum _ fun v _ => integrable_finsetSum _
              fun w _ => hintA G G' v w)
            ((integrable_finsetSum _ fun G _ => hintZ G).const_mul _) hpt
      _ = τ * (N * W₀ ^ 2 * ∑ G, ∫ y, (‖P G y‖ ^ 2 + Q G y)) := by
          rw [integral_const_mul, integral_finsetSum _ fun G _ => hintZ G]
  rw [hstep1]
  simp only [hZint]
  nlinarith

end WholeRanges

/-- Only finitely many cells of one depth meet a bounded interval. -/
theorem cells_meeting_finite (Gd : RealDyadicGrid) (s : ℤ) (a b : ℝ) :
    ∃ 𝒦 : Finset ℤ, ∀ n, ∀ y ∈ dyadicGridCell Gd s n, a ≤ y → y ≤ b → n ∈ 𝒦 := by
  set ℓ := dyadicGridLength Gd s
  have hℓ : 0 < ℓ := dyadicGridLength_pos Gd s
  refine ⟨Finset.Icc (⌊(a - Gd.origin s) / ℓ⌋ - 1) (⌈(b - Gd.origin s) / ℓ⌉), ?_⟩
  intro n y hy hay hyb
  simp only [dyadicGridCell, dyadicGridLeft, Set.mem_Ico] at hy
  obtain ⟨h1, h2⟩ := hy
  rw [Finset.mem_Icc]
  constructor
  · have : (a - Gd.origin s) / ℓ < n + 1 := by
      rw [div_lt_iff₀ hℓ]; linarith
    have := Int.floor_le ((a - Gd.origin s) / ℓ)
    have : (⌊(a - Gd.origin s) / ℓ⌋ : ℝ) < n + 1 := by linarith
    have : ⌊(a - Gd.origin s) / ℓ⌋ < n + 1 := by exact_mod_cast this
    omega
  · have : (n : ℝ) ≤ (b - Gd.origin s) / ℓ := by
      rw [le_div_iff₀ hℓ]; linarith
    exact Int.cast_le.mp (this.trans (Int.le_ceil _)) |> fun h => by exact_mod_cast h

/-- A function constant on the cells of one depth, supported in finitely many of them, pairs
against `ψ` with the per-cell bound (the grid argument of blueprint line 1785). -/
theorem pairing_of_cellwise_constant (Gd : RealDyadicGrid) (s : ℤ) (𝒦 : Finset ℤ)
    (f ψ : ℝ → ℂ) (hψm : Measurable ψ) {M : ℝ} (hψb : ∀ y, ‖ψ y‖ ≤ M)
    (hconst : ∀ n, ∀ y ∈ dyadicGridCell Gd s n, ∀ y' ∈ dyadicGridCell Gd s n, f y = f y')
    (hsupp : ∀ y, f y ≠ 0 → ∃ n ∈ 𝒦, y ∈ dyadicGridCell Gd s n) {τ : ℝ}
    (hcell : ∀ n ∈ 𝒦, ‖∫ y in dyadicGridCell Gd s n, ψ y‖ ≤ τ * dyadicGridLength Gd s) :
    ‖∫ y, f y * ψ y‖ ≤ τ * ∫ y, ‖f y‖ := by
  classical
  set L : ℤ → ℝ := fun n => dyadicGridLeft Gd s n
  set C : ℤ → Set ℝ := fun n => dyadicGridCell Gd s n
  have hCm : ∀ n, MeasurableSet (C n) := fun n => dyadicGridCell_measurable Gd s n
  have hCvol : ∀ n, volume (C n) ≠ ⊤ := fun n => by
    simp [C, dyadicGridCell_volume]
  have hdisj : ∀ n n', n ≠ n' → Disjoint (C n) (C n') := fun n n' h =>
    dyadicGridCell_pairwiseDisjoint Gd s h
  have hL : ∀ n, L n ∈ C n := fun n => dyadicGridCell_left_mem Gd s n
  -- the cellwise decomposition
  have hdec : ∀ (g : ℂ → ℂ), g 0 = 0 → ∀ y,
      g (f y) = ∑ n ∈ 𝒦, (C n).indicator (fun _ => g (f (L n))) y := by
    intro g hg y
    by_cases hy : ∃ n ∈ 𝒦, y ∈ C n
    · obtain ⟨n₀, hn₀, hyn₀⟩ := hy
      rw [Finset.sum_eq_single n₀]
      · rw [Set.indicator_of_mem hyn₀, hconst n₀ y hyn₀ (L n₀) (hL n₀)]
      · intro n _ hn
        exact Set.indicator_of_notMem (fun hyn => (hdisj n n₀ hn).le_bot ⟨hyn, hyn₀⟩) _
      · intro h; exact absurd hn₀ h
    · have hf0 : f y = 0 := by
        by_contra h; exact hy (hsupp y h)
      rw [hf0, hg]
      symm
      exact Finset.sum_eq_zero fun n hn => Set.indicator_of_notMem
        (fun hyn => hy ⟨n, hn, hyn⟩) _
  have hψint : ∀ n, IntegrableOn ψ (C n) := fun n =>
    Measure.integrableOn_of_bounded (M := M) (hCvol n) hψm.aestronglyMeasurable
      (Filter.Eventually.of_forall hψb)
  have h1 : ∫ y, f y * ψ y = ∑ n ∈ 𝒦, f (L n) * ∫ y in C n, ψ y := by
    have : ∀ y, f y * ψ y = ∑ n ∈ 𝒦, (C n).indicator (fun y => f (L n) * ψ y) y := by
      intro y
      have h := hdec id rfl y
      simp only [id] at h
      rw [h, Finset.sum_mul]
      apply Finset.sum_congr rfl; intro n _
      by_cases hyn : y ∈ C n
      · simp [Set.indicator_of_mem hyn]
      · simp [Set.indicator_of_notMem hyn]
    rw [show (fun y => f y * ψ y) = fun y =>
        ∑ n ∈ 𝒦, (C n).indicator (fun y => f (L n) * ψ y) y from funext this]
    rw [integral_finsetSum _ fun n _ => (show IntegrableOn (fun y => f (L n) * ψ y) (C n) volume
        from
      (hψint n).const_mul _).integrable_indicator (hCm n)]
    apply Finset.sum_congr rfl; intro n _
    rw [integral_indicator (hCm n), integral_const_mul]
  have h2 : ∫ y, ‖f y‖ = ∑ n ∈ 𝒦, ‖f (L n)‖ * dyadicGridLength Gd s := by
    have : ∀ y, ((‖f y‖ : ℝ) : ℂ) =
        ∑ n ∈ 𝒦, (C n).indicator (fun _ => ((‖f (L n)‖ : ℝ) : ℂ)) y :=
      fun y => hdec (fun z => ((‖z‖ : ℝ) : ℂ)) (by simp) y
    have hreal : ∀ y, ‖f y‖ = ∑ n ∈ 𝒦, (C n).indicator (fun _ => ‖f (L n)‖) y := by
      intro y
      have := this y
      have e : ∀ n, ((C n).indicator (fun _ => ((‖f (L n)‖ : ℝ) : ℂ)) y) =
          (((C n).indicator (fun _ => ‖f (L n)‖) y : ℝ) : ℂ) := by
        intro n
        by_cases hyn : y ∈ C n
        · simp [Set.indicator_of_mem hyn]
        · simp [Set.indicator_of_notMem hyn]
      simp only [e] at this
      exact_mod_cast this
    rw [show (fun y => ‖f y‖) = fun y => ∑ n ∈ 𝒦, (C n).indicator (fun _ => ‖f (L n)‖) y from
      funext hreal]
    rw [integral_finsetSum _ fun n _ => (integrableOn_const (hCvol n)).integrable_indicator
      (hCm n)]
    apply Finset.sum_congr rfl; intro n _
    rw [integral_indicator (hCm n), setIntegral_const, smul_eq_mul, mul_comm, measureReal_def]
    simp [C, dyadicGridCell_volume, (dyadicGridLength_pos Gd s).le]
  rw [h1, h2, Finset.mul_sum]
  refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun n hn => ?_)
  rw [norm_mul]
  calc ‖f (L n)‖ * ‖∫ y in C n, ψ y‖ ≤ ‖f (L n)‖ * (τ * dyadicGridLength Gd s) :=
        mul_le_mul_of_nonneg_left (hcell n hn) (norm_nonneg _)
    _ = τ * (‖f (L n)‖ * dyadicGridLength Gd s) := by ring

section WholeRanges

variable {V ι : Type*} [Fintype V] [DecidableEq V] [Fintype ι] [DecidableEq ι]

/-- The combined coefficient `a_{v,G} = Σ_I a_{v,G,I} 1_I` of the occurrences of `v` in `G`. -/
noncomputable def occCoef (Gd : RealDyadicGrid) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) (G : ι) (v : V) (y : ℝ) : ℂ :=
  ∑ I ∈ occ G v, (dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y

omit [Fintype V] [DecidableEq V] [Fintype ι] [DecidableEq ι] in
theorem occCoef_measurable (Gd : RealDyadicGrid) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) (G : ι) (v : V) : Measurable (occCoef Gd occ c G v) :=
  Finset.measurable_sum _ fun I _ =>
    measurable_const.indicator (dyadicGridCell_measurable Gd I.1 I.2)

omit [Fintype V] [DecidableEq V] [Fintype ι] [DecidableEq ι] in
theorem norm_occCoef_le (Gd : RealDyadicGrid) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) {Mc : ℝ} (hc : ∀ G v I, ‖c G v I‖ ≤ Mc) {K₀ : ℕ}
    (hK : ∀ G v, (occ G v).card ≤ K₀) (G : ι) (v : V) (y : ℝ) :
    ‖occCoef Gd occ c G v y‖ ≤ K₀ * Mc := by
  classical
  have hMc : 0 ≤ Mc := (norm_nonneg _).trans (hc G v (0, 0))
  refine (norm_sum_le _ _).trans ?_
  calc ∑ I ∈ occ G v, ‖(dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y‖
      ≤ ∑ _I ∈ occ G v, Mc := Finset.sum_le_sum fun I _ => by
        by_cases hy : y ∈ dyadicGridCell Gd I.1 I.2
        · rw [Set.indicator_of_mem hy]; exact hc G v I
        · rw [Set.indicator_of_notMem hy, norm_zero]; exact hMc
    _ = (occ G v).card * Mc := by rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ K₀ * Mc := by gcongr; exact_mod_cast hK G v

omit [DecidableEq V] [DecidableEq ι] in
/-- Blueprint lem:whole-ranges (Declaration whole-ranges, `THT.Localization.usableRangeBessel`):
group outputs `Z_G = Σ_v a_{v,G} Φ_v` whose combined coefficients are constant on entire endpoint
cells satisfy `‖Σ_G Z_G‖² ≤ (1 + τ N W₀²) Σ_G ‖Z_G‖²` provided
(i) overlapping endpoint cells of labels in different groups have depth at most the last
separating depth `s_*(v, w)` of the two labels (lemma masks),
(ii) at that depth the physical pairing of the two pure columns is at most `τ` on every cell
(lemma graph),
(iii) private labels never coincide on an overlap, and
(iv) at most `N` group-label pairs are present at each point and inverse private weights are
at most `W₀²`. -/
theorem usableRangeBessel (Gd : RealDyadicGrid) (φ : V → ℝ → ℂ) (ε : V → ℝ)
    (hε : ∀ v, 0 < ε v) {W₀ : ℝ} (hW : ∀ v, 1 ≤ W₀ ^ 2 * ε v) (hφm : ∀ v, Measurable (φ v))
    {Mφ : ℝ} (hφb : ∀ v y, ‖φ v y‖ ≤ Mφ) (occ : ι → V → Finset (ℤ × ℤ))
    (c : ι → V → ℤ × ℤ → ℂ) {Mc : ℝ} (hMc : 0 ≤ Mc) (hc : ∀ G v I, ‖c G v I‖ ≤ Mc) {K₀ : ℕ}
    (hK : ∀ G v, (occ G v).card ≤ K₀) {ra rb : ℝ}
    (hroot : ∀ G v, ∀ I ∈ occ G v, dyadicGridCell Gd I.1 I.2 ⊆ Set.Icc ra rb)
    (sep : V → V → ℤ)
    (hsep : ∀ G G', G ≠ G' → ∀ v w, ∀ I ∈ occ G v, ∀ J ∈ occ G' w,
      (dyadicGridCell Gd I.1 I.2 ∩ dyadicGridCell Gd J.1 J.2).Nonempty →
        I.1 ≤ sep v w ∧ J.1 ≤ sep v w)
    {τ : ℝ} (hτ : 0 ≤ τ)
    (hcell : ∀ v w, ∀ n, ‖∫ y in dyadicGridCell Gd (sep v w) n,
      starRingEnd ℂ (φ v y) * φ w y‖ ≤ τ * dyadicGridLength Gd (sep v w))
    (hpriv : ∀ G G', G ≠ G' → ∀ v, ∀ I ∈ occ G v, ∀ J ∈ occ G' v,
      Disjoint (dyadicGridCell Gd I.1 I.2) (dyadicGridCell Gd J.1 J.2))
    {N : ℕ} (hN : ∀ y, ((Finset.univ : Finset (ι × V)).filter
      (fun p => occCoef Gd occ c p.1 p.2 y ≠ 0)).card ≤ N) :
    ∫ y, ‖∑ G, groupOutput φ ε (occCoef Gd occ c G) y‖ ^ 2 ≤
      (1 + τ * N * W₀ ^ 2) * ∑ G, ∫ y, ‖groupOutput φ ε (occCoef Gd occ c G) y‖ ^ 2 := by
  classical
  set a := occCoef Gd occ c with ha
  set M := max ((K₀ : ℝ) * Mc) Mφ
  have hM0 : 0 ≤ M := le_max_of_le_left (by positivity)
  have hab : ∀ G v y, ‖a G v y‖ ≤ M := fun G v y =>
    (norm_occCoef_le Gd occ c hc hK G v y).trans (le_max_left _ _)
  have hφb' : ∀ v y, ‖φ v y‖ ≤ M := fun v y => (hφb v y).trans (le_max_right _ _)
  -- a nonzero coefficient sits in one of its cells
  have hmem : ∀ G v y, a G v y ≠ 0 → ∃ I ∈ occ G v, y ∈ dyadicGridCell Gd I.1 I.2 := by
    intro G v y h
    by_contra hno
    push Not at hno
    exact h (Finset.sum_eq_zero fun I hI => Set.indicator_of_notMem (hno I hI) _)
  have hsupp : ∀ G v y, y ∉ Set.Icc ra rb → a G v y = 0 := by
    intro G v y hy
    by_contra h
    obtain ⟨I, hI, hyI⟩ := hmem G v y h
    exact hy (hroot G v I hI hyI)
  apply wholeRanges_core φ ε hε hW a measurableSet_Icc measure_Icc_lt_top.ne
    (occCoef_measurable Gd occ c) hM0 hab hsupp hφm hφb' hτ _ _ hN
  · -- the cross pairings
    intro G G' hne v w
    set s := sep v w
    obtain ⟨𝒦, h𝒦⟩ := cells_meeting_finite Gd s ra rb
    set f : ℝ → ℂ := fun y => starRingEnd ℂ (a G v y) * a G' w y
    set ψ : ℝ → ℂ := fun y => starRingEnd ℂ (φ v y) * φ w y
    have e1 : (fun y => starRingEnd ℂ (a G v y * φ v y) * (a G' w y * φ w y)) =
        fun y => f y * ψ y := by
      funext y; simp only [f, ψ, map_mul]; ring
    have e2 : (fun y => ‖a G v y‖ * ‖a G' w y‖) = fun y => ‖f y‖ := by
      funext y; simp only [f, norm_mul, Complex.norm_conj]
    rw [e1, e2]
    apply pairing_of_cellwise_constant Gd s 𝒦 f ψ
      ((Complex.continuous_conj.measurable.comp (hφm v)).mul (hφm w))
      (M := max (M * M) (Mφ * Mφ))
    · intro y
      simp only [ψ, norm_mul, Complex.norm_conj]
      have hMφ : 0 ≤ Mφ := (norm_nonneg _).trans (hφb v y)
      exact (mul_le_mul (hφb v y) (hφb w y) (norm_nonneg _) hMφ).trans (le_max_right _ _)
    · -- constancy on the cells of the separating depth
      intro n y hy y' hy'
      simp only [f, ha, occCoef, map_sum, Finset.sum_mul_sum]
      apply Finset.sum_congr rfl; intro I hI; apply Finset.sum_congr rfl; intro J hJ
      have key : ∀ x x', x ∈ dyadicGridCell Gd s n → x' ∈ dyadicGridCell Gd s n →
          x ∈ dyadicGridCell Gd I.1 I.2 → x ∈ dyadicGridCell Gd J.1 J.2 →
          x' ∈ dyadicGridCell Gd I.1 I.2 ∧ x' ∈ dyadicGridCell Gd J.1 J.2 := by
        intro x x' hx hx' hxI hxJ
        obtain ⟨hIs, hJs⟩ := hsep G G' hne v w I hI J hJ ⟨x, hxI, hxJ⟩
        rcases dyadicGridCell_nested_or_disjoint_of_le Gd hIs I.2 n with hd | hsub
        · exact absurd (hd.le_bot ⟨hxI, hx⟩) (by simp)
        rcases dyadicGridCell_nested_or_disjoint_of_le Gd hJs J.2 n with hd' | hsub'
        · exact absurd (hd'.le_bot ⟨hxJ, hx⟩) (by simp)
        exact ⟨hsub hx', hsub' hx'⟩
      by_cases h1 : y ∈ dyadicGridCell Gd I.1 I.2 ∧ y ∈ dyadicGridCell Gd J.1 J.2
      · obtain ⟨h1', h2'⟩ := key y y' hy hy' h1.1 h1.2
        rw [Set.indicator_of_mem h1.1, Set.indicator_of_mem h1.2, Set.indicator_of_mem h1',
          Set.indicator_of_mem h2']
      · have h2 : ¬ (y' ∈ dyadicGridCell Gd I.1 I.2 ∧ y' ∈ dyadicGridCell Gd J.1 J.2) :=
          fun h => h1 (key y' y hy' hy h.1 h.2)
        have z1 : starRingEnd ℂ ((dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y) *
            (dyadicGridCell Gd J.1 J.2).indicator (fun _ => c G' w J) y = 0 := by
          by_cases hyI : y ∈ dyadicGridCell Gd I.1 I.2
          · rw [Set.indicator_of_notMem (fun hyJ => h1 ⟨hyI, hyJ⟩), mul_zero]
          · rw [Set.indicator_of_notMem hyI, map_zero, zero_mul]
        have z2 : starRingEnd ℂ ((dyadicGridCell Gd I.1 I.2).indicator (fun _ => c G v I) y') *
            (dyadicGridCell Gd J.1 J.2).indicator (fun _ => c G' w J) y' = 0 := by
          by_cases hyI : y' ∈ dyadicGridCell Gd I.1 I.2
          · rw [Set.indicator_of_notMem (fun hyJ => h2 ⟨hyI, hyJ⟩), mul_zero]
          · rw [Set.indicator_of_notMem hyI, map_zero, zero_mul]
        rw [z1, z2]
    · -- support in finitely many cells
      intro y hy
      have hav : a G v y ≠ 0 := by
        intro h; apply hy; simp only [f, h, map_zero, zero_mul]
      obtain ⟨I, hI, hyI⟩ := hmem G v y hav
      have hyR := hroot G v I hI hyI
      obtain ⟨n, hn⟩ := dyadicGridCell_covers Gd s y
      exact ⟨n, h𝒦 n y hn hyR.1 hyR.2, hn⟩
    · intro n _; exact hcell v w n
  · -- private coordinates never coincide on an overlap
    intro G G' hne v y
    by_contra h
    push Not at h
    obtain ⟨I, hI, hyI⟩ := hmem G v y h.1
    obtain ⟨J, hJ, hyJ⟩ := hmem G' v y h.2
    exact (hpriv G G' hne v I hI J hJ).le_bot ⟨hyI, hyJ⟩

end WholeRanges

end Auto
