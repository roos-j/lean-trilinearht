  have hsplit := hW (d := d + e) (k := 1) le_rfl (by norm_num) HW M hMc θ hθm hθb hθL hθs (τ / 2)
    (by positivity) hsup
  dsimp only at hsplit
  obtain ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩ := hsplit
  -- the chart data of the lift
  have hV : M.horizontal = fun i _ => r * Fin.append A.horizontal B.horizontal i := by
    funext i j
    simp only [hM, liftChart, mul_one, hP_def, productQuadraticChart, dilateQuadraticChart,
      conjugateQuadraticChart, hA'h, hB'h]
    refine Fin.addCases (fun i => ?_) (fun i => ?_) i
    · simp only [Fin.append_left]; ring
    · simp only [Fin.append_right]; ring
  have hC : M.matrix = chartBlockMatrix A.matrix (-B.matrix) := by
    simp only [hM, liftChart, hP_def, productQuadraticChart, dilateQuadraticChart,
      conjugateQuadraticChart, hA'm, hB'm]
  have hΛ : M.quadratic = fun _ _ => r ^ 2 * (A.quadratic - B.quadratic) := by
    funext i j
    simp only [hM, liftChart, mul_one, hP_def, productQuadraticChart, dilateQuadraticChart,
      conjugateQuadraticChart, hA'q, hB'q]
    ring
  rw [hC] at h3
  rw [hV] at h6
  rw [hV, hC, hΛ] at h7
  refine WeylSplitData.mono ⟨U, Q, h1, h2, h3, h4, h5, h6, h7⟩ ?_
  -- the quasipolynomial bound
  apply Real.exp_le_exp.mpr
  have hlogH : 2 ≤ Real.log H := by
    rw [← Real.log_exp 2]; exact Real.log_le_log (Real.exp_pos 2) hH
  have hlτ : 0 ≤ Real.log τ⁻¹ := Real.log_nonneg (one_le_inv₀ hτ |>.mpr hτ1)
  set X := 1 + Real.log H + Real.log τ⁻¹ with hX
  have hX1 : 1 ≤ X := by linarith only [hlogH, hlτ]
  have hX3 : X ≤ X ^ 3 := by
    calc X = X ^ 1 := (pow_one X).symm
      _ ≤ X ^ 3 := pow_le_pow_right₀ hX1 (by norm_num)
  have hT1 : 1 ≤ chartTranslationBudget H ^ 6 := le_trans (by linarith [Real.add_one_le_exp (2 :
    ℝ)]) hTB
  have h4τ : 1 ≤ 4 / τ := by rw [le_div_iff₀ hτ]; linarith
  have hlogHW : Real.log HW ≤ 600 * (1 + Real.log H) ^ 3 + Real.log 4 + Real.log τ⁻¹ := by
    have hmax : HW ≤ chartTranslationBudget H ^ 6 * (4 / τ) :=
      max_le (le_mul_of_one_le_right (by linarith) h4τ) (le_mul_of_one_le_left (by linarith) hT1)
    refine (Real.log_le_log (by linarith) hmax).trans (le_of_eq ?_)
    rw [Real.log_mul (by linarith) (by linarith), Real.log_pow, chartTranslationBudget,
      Real.log_exp, logarithmicSize, div_eq_mul_inv, Real.log_mul (by norm_num) (by positivity)]
    push_cast; ring
  have hlogm : Real.log (max 1 (τ / 2)⁻¹) = Real.log 2 + Real.log τ⁻¹ := by
    have : (τ / 2)⁻¹ = 2 * τ⁻¹ := by field_simp
    rw [max_eq_right (by rw [this]; nlinarith [one_le_inv₀ hτ |>.mpr hτ1]), this,
      Real.log_mul (by norm_num) (by positivity)]
