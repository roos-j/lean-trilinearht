/-- The interval inputs with fast/random data `F_n` (blueprint line 2346):
`g(y, z) = Σ_{n ∈ T} F_n(z) 1_{|y - δ n| < c δ}`. -/
noncomputable def fastIntervalInput {Ω : Type*} (δ c : ℝ) (T : Finset ℤ) (F : ℤ → Ω → ℂ)
    (p : ℝ × Ω) : ℂ :=
  ∑ n ∈ T, F n p.2 * (if |p.1 - δ * n| < c * δ then 1 else 0)

/-- For `c ≤ 1/2` the intervals around distinct centers are disjoint. -/
theorem interval_unique {δ c y : ℝ} (hδ : 0 < δ) (hc2 : c ≤ 1 / 2) {m n : ℤ}
    (hm : |y - δ * m| < c * δ) (hn : |y - δ * n| < c * δ) : m = n := by
  by_contra hne
  have h1 : (1 : ℝ) ≤ |(m : ℝ) - n| := by
    have : (1 : ℤ) ≤ |m - n| := Int.one_le_abs (sub_ne_zero.mpr hne)
    exact_mod_cast this
  have h2 : |δ * m - δ * n| ≤ |y - δ * m| + |y - δ * n| := by
    rw [show δ * m - δ * n = (y - δ * n) - (y - δ * m) by ring]
    exact (abs_sub _ _).trans (by rw [add_comm])
  rw [show δ * (m : ℝ) - δ * n = δ * (m - n) by ring, abs_mul, abs_of_pos hδ] at h2
  nlinarith

