/-- Abel summation for averaged filters: for `Q_0 = 0`,
`Σ_{p=1}^P Q_p = Σ_{i=1}^{P+1} (P + 1 - i) (Q_i - Q_{i-1})`. -/
theorem sum_filters_eq_bands {M : Type*} [AddCommGroup M] (v : ℕ → M) (hv : v 0 = 0) (P : ℕ) :
    ∑ p ∈ Finset.range P, v (p + 1) =
      ∑ i ∈ Finset.range (P + 1), (P - i) • (v (i + 1) - v i) := by
  induction P with
  | zero => simp
  | succ P ih =>
    rw [Finset.sum_range_succ, ih, Finset.sum_range_succ _ (P + 1)]
    have hsplit : ∑ i ∈ Finset.range (P + 1), (P + 1 - i) • (v (i + 1) - v i) =
        ∑ i ∈ Finset.range (P + 1), (P - i) • (v (i + 1) - v i) +
          ∑ i ∈ Finset.range (P + 1), (v (i + 1) - v i) := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl; intro i hi
      have : P + 1 - i = (P - i) + 1 := by have := Finset.mem_range.mp hi; omega
      rw [this, add_smul, one_smul]
    rw [hsplit, Finset.sum_range_sub, hv, sub_zero]
    simp

/-- Blueprint `eq:transfer` (line 2252): for filters `Q_{l,p}` with `Q_{l,0} = 0`,
`Q_{l,P+1} = 1`, bands `A_p^l = Q_{l,p} - Q_{l,p-1}` and averages `Q̄_l = P⁻¹ Σ_{p=1}^P Q_{l,p}`,
and any form `H` bilinear in the two transferred slots (the other slots fixed),
`H(x_a, Q̄_c x_c) - H(Q̄_a x_a, x_c) = Σ_{p,q=1}^{P+1} ((p - q)/P) H(A_p^a x_a, A_q^c x_c)`. -/
theorem transfer_identity {E : Type*} [AddCommGroup E] [Module ℂ E]
    (B : E →ₗ[ℂ] E →ₗ[ℂ] ℂ) (Qa Qc : ℕ → E →ₗ[ℂ] E) {P : ℕ} (hP : 0 < P)
    (ha0 : Qa 0 = 0) (hc0 : Qc 0 = 0) (haP : Qa (P + 1) = LinearMap.id)
    (hcP : Qc (P + 1) = LinearMap.id) (xa xc : E) :
    B xa ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qc (p + 1) xc) -
        B ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range P, Qa (p + 1) xa) xc =
      ∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
        (((p : ℂ) - q) / P) * B (Qa (p + 1) xa - Qa p xa) (Qc (q + 1) xc - Qc q xc) := by
  set a : ℕ → E := fun p => Qa (p + 1) xa - Qa p xa
  set c : ℕ → E := fun q => Qc (q + 1) xc - Qc q xc
  -- telescoping: `x = Σ_p A_p x`
  have hxa : xa = ∑ p ∈ Finset.range (P + 1), a p := by
    rw [Finset.sum_range_sub (fun p => Qa p xa), haP, ha0]; simp
  have hxc : xc = ∑ q ∈ Finset.range (P + 1), c q := by
    rw [Finset.sum_range_sub (fun q => Qc q xc), hcP, hc0]; simp
  -- averages in bands
  have hQa : ∑ p ∈ Finset.range P, Qa (p + 1) xa =
      ∑ p ∈ Finset.range (P + 1), ((P - p : ℕ) : ℂ) • a p := by
    rw [sum_filters_eq_bands (fun p => Qa p xa) (by simp [ha0])]
    apply Finset.sum_congr rfl; intro p _
    rw [Nat.cast_smul_eq_nsmul]
  have hQc : ∑ q ∈ Finset.range P, Qc (q + 1) xc =
      ∑ q ∈ Finset.range (P + 1), ((P - q : ℕ) : ℂ) • c q := by
    rw [sum_filters_eq_bands (fun q => Qc q xc) (by simp [hc0])]
    apply Finset.sum_congr rfl; intro q _
    rw [Nat.cast_smul_eq_nsmul]
  rw [hQa, hQc]
  have h1 : B xa ((P : ℂ)⁻¹ • ∑ q ∈ Finset.range (P + 1), ((P - q : ℕ) : ℂ) • c q) =
      ∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
        (P : ℂ)⁻¹ * (((P - q : ℕ) : ℂ) * B (a p) (c q)) := by
    conv_lhs => rw [hxa]
    simp only [map_sum, map_smul, LinearMap.sum_apply, smul_eq_mul, Finset.mul_sum]
    exact Finset.sum_comm
  have h2 : B ((P : ℂ)⁻¹ • ∑ p ∈ Finset.range (P + 1), ((P - p : ℕ) : ℂ) • a p) xc =
      ∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
        (P : ℂ)⁻¹ * (((P - p : ℕ) : ℂ) * B (a p) (c q)) := by
    conv_lhs => rw [hxc]
    simp only [map_sum, map_smul, LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul,
      Finset.mul_sum]
    exact Finset.sum_comm
  rw [h1, h2, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl; intro p hp
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl; intro q hq
  have hpP : p ≤ P := by have := Finset.mem_range.mp hp; omega
  have hqP : q ≤ P := by have := Finset.mem_range.mp hq; omega
  have hP0 : (P : ℂ) ≠ 0 := by exact_mod_cast hP.ne'
  rw [Nat.cast_sub hpP, Nat.cast_sub hqP]
  field_simp
  ring

/-- Blueprint line 2254: only band pairs with `|p - q| ≤ 2` are retained; if every far pair term
is at most `η`, the discarded part of `eq:transfer` is at most `(P + 1)² η`. -/
theorem transfer_near_bands {P : ℕ} (hP : 0 < P) (t : ℕ → ℕ → ℂ) {η : ℝ} (hη : 0 ≤ η)
    (hfar : ∀ p < P + 1, ∀ q < P + 1, ¬(p ≤ q + 2 ∧ q ≤ p + 2) → ‖t p q‖ ≤ η) :
    ‖∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1), (((p : ℂ) - q) / P) * t p q -
        ∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1),
          (if p ≤ q + 2 ∧ q ≤ p + 2 then (((p : ℂ) - q) / P) * t p q else 0)‖ ≤
      (P + 1) ^ 2 * η := by
  rw [← Finset.sum_sub_distrib]
  simp_rw [← Finset.sum_sub_distrib]
  have hterm : ∀ p ∈ Finset.range (P + 1), ∀ q ∈ Finset.range (P + 1),
      ‖(((p : ℂ) - q) / P) * t p q -
        (if p ≤ q + 2 ∧ q ≤ p + 2 then (((p : ℂ) - q) / P) * t p q else 0)‖ ≤ η := by
    intro p hp q hq
    have hp' := Finset.mem_range.mp hp
    have hq' := Finset.mem_range.mp hq
    split_ifs with hnear
    · rw [sub_self, norm_zero]; exact hη
    · rw [sub_zero, norm_mul]
      have hw : ‖((p : ℂ) - q) / P‖ ≤ 1 := by
        rw [norm_div, Complex.norm_natCast, div_le_one (by exact_mod_cast hP)]
        rw [show ((p : ℂ) - q) = (((p : ℤ) - q : ℤ) : ℂ) by push_cast; ring,
          Complex.norm_intCast]
        have : |((p : ℤ) - q)| ≤ P := by rw [abs_le]; constructor <;> omega
        exact_mod_cast this
      calc ‖((p : ℂ) - q) / P‖ * ‖t p q‖ ≤ 1 * η :=
            mul_le_mul hw (hfar p hp' q hq' hnear) (norm_nonneg _) zero_le_one
        _ = η := one_mul η
  calc _ ≤ ∑ p ∈ Finset.range (P + 1), ∑ q ∈ Finset.range (P + 1), η := by
        refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun p hp => ?_)
        exact (norm_sum_le _ _).trans (Finset.sum_le_sum fun q hq => hterm p hp q hq)
    _ = (P + 1) ^ 2 * η := by simp [Finset.sum_const]; ring

