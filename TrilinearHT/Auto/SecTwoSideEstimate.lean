          (fun _ => ‖G m‖ₑ ^ (2 : ℝ)) y := setLIntegral_mono' hJ hpt
    _ ≤ ∫⁻ y, ∑ m ∈ TJ, (Metric.ball (δ * m) (c * δ)).indicator
