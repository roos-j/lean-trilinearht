theorem three_sides_power {ι : Type*} (s : Finset ι) (a b c : ι → ℝ) (ha : ∀ i ∈ s, 0 ≤ a i)
    (hb : ∀ i ∈ s, 0 ≤ b i) (hc : ∀ i ∈ s, 0 ≤ c i) {p : ℝ} (hp : 2 / 3 < p) :
    ∑ i ∈ s, (a i * b i * c i) ^ p ≤
      (∑ i ∈ s, a i ^ 2) ^ (p / 2) * (∑ i ∈ s, b i ^ 2) ^ (p / 2) *
        (∑ i ∈ s, c i ^ 2) ^ (p / 2) := by
  have hp0 : 0 < p := by linarith
  set x : ι → ℝ := fun i => a i ^ p
  set y : ι → ℝ := fun i => b i ^ p
  set z : ι → ℝ := fun i => c i ^ p
  have hx : ∀ i ∈ s, 0 ≤ x i := fun i hi => Real.rpow_nonneg (ha i hi) p
  have hy : ∀ i ∈ s, 0 ≤ y i := fun i hi => Real.rpow_nonneg (hb i hi) p
  have hz : ∀ i ∈ s, 0 ≤ z i := fun i hi => Real.rpow_nonneg (hc i hi) p
  have hprod : ∀ i ∈ s, (a i * b i * c i) ^ p = x i * (y i * z i) := by
    intro i hi
    rw [Real.mul_rpow (mul_nonneg (ha i hi) (hb i hi)) (hc i hi),
      Real.mul_rpow (ha i hi) (hb i hi)]
    ring
  -- Hölder with exponents `3` and `3/2`
  have hconj : (3 : ℝ).HolderConjugate (3 / 2) := by
    rw [Real.holderConjugate_iff]; norm_num
  have h1 := Real.inner_le_Lp_mul_Lq_of_nonneg s hconj hx
    (fun i hi => mul_nonneg (hy i hi) (hz i hi))
  -- Cauchy–Schwarz for `Σ y^{3/2} z^{3/2}`
  have hyz : ∑ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ) ≤
      Real.sqrt (∑ i ∈ s, y i ^ (3 : ℝ)) * Real.sqrt (∑ i ∈ s, z i ^ (3 : ℝ)) := by
    have hcs := Real.sum_mul_le_sqrt_mul_sqrt s (fun i => y i ^ (3 / 2 : ℝ))
      (fun i => z i ^ (3 / 2 : ℝ))
    have e1 : ∀ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ) = y i ^ (3 / 2 : ℝ) * z i ^ (3 / 2 : ℝ) :=
      fun i hi => Real.mul_rpow (hy i hi) (hz i hi)
    have e2 : ∀ (w : ι → ℝ), (∀ i ∈ s, 0 ≤ w i) →
        ∑ i ∈ s, (w i ^ (3 / 2 : ℝ)) ^ 2 = ∑ i ∈ s, w i ^ (3 : ℝ) := by
      intro w hw
      apply Finset.sum_congr rfl; intro i hi
      rw [← Real.rpow_natCast, ← Real.rpow_mul (hw i hi)]; norm_num
    rw [Finset.sum_congr rfl e1, ← e2 y hy, ← e2 z hz]
    exact hcs
  have hY0 : 0 ≤ ∑ i ∈ s, y i ^ (3 : ℝ) :=
    Finset.sum_nonneg fun i hi => Real.rpow_nonneg (hy i hi) _
  have hZ0 : 0 ≤ ∑ i ∈ s, z i ^ (3 : ℝ) :=
    Finset.sum_nonneg fun i hi => Real.rpow_nonneg (hz i hi) _
  have hX0 : 0 ≤ ∑ i ∈ s, x i ^ (3 : ℝ) :=
    Finset.sum_nonneg fun i hi => Real.rpow_nonneg (hx i hi) _
  have h2 : (∑ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ)) ^ (1 / (3 / 2 : ℝ)) ≤
      (∑ i ∈ s, y i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) * (∑ i ∈ s, z i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) := by
    have hL0 : 0 ≤ ∑ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ) :=
      Finset.sum_nonneg fun i hi => Real.rpow_nonneg (mul_nonneg (hy i hi) (hz i hi)) _
    calc _ ≤ (Real.sqrt (∑ i ∈ s, y i ^ (3 : ℝ)) * Real.sqrt (∑ i ∈ s, z i ^ (3 : ℝ))) ^
          (1 / (3 / 2 : ℝ)) := Real.rpow_le_rpow hL0 hyz (by norm_num)
      _ = _ := by
          rw [Real.mul_rpow (Real.sqrt_nonneg _) (Real.sqrt_nonneg _), Real.sqrt_eq_rpow,
            Real.sqrt_eq_rpow, ← Real.rpow_mul hY0, ← Real.rpow_mul hZ0]
          norm_num
  -- `ℓ^{3p} ⊆ ℓ²`
  have hmono : ∀ (w : ι → ℝ), (∀ i ∈ s, 0 ≤ w i) →
      (∑ i ∈ s, (w i ^ p) ^ (3 : ℝ)) ^ (1 / 3 : ℝ) ≤ (∑ i ∈ s, w i ^ 2) ^ (p / 2) := by
    intro w hw
    have e : ∀ i ∈ s, (w i ^ p) ^ (3 : ℝ) = w i ^ (3 * p) := fun i hi => by
      rw [← Real.rpow_mul (hw i hi)]; ring_nf
    rw [Finset.sum_congr rfl e]
    have hm := sum_rpow_le_sum_sq_rpow s w hw (r := 3 * p) (by linarith)
    have hW0 : 0 ≤ ∑ i ∈ s, w i ^ (3 * p) :=
      Finset.sum_nonneg fun i hi => Real.rpow_nonneg (hw i hi) _
    calc (∑ i ∈ s, w i ^ (3 * p)) ^ (1 / 3 : ℝ) ≤
        ((∑ i ∈ s, w i ^ 2) ^ (3 * p / 2)) ^ (1 / 3 : ℝ) :=
          Real.rpow_le_rpow hW0 hm (by norm_num)
      _ = _ := by
          rw [← Real.rpow_mul (Finset.sum_nonneg fun i _ => sq_nonneg _)]; ring_nf
  rw [Finset.sum_congr rfl hprod]
  calc ∑ i ∈ s, x i * (y i * z i) ≤ (∑ i ∈ s, x i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) *
        (∑ i ∈ s, (y i * z i) ^ (3 / 2 : ℝ)) ^ (1 / (3 / 2 : ℝ)) := h1
    _ ≤ (∑ i ∈ s, x i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) *
        ((∑ i ∈ s, y i ^ (3 : ℝ)) ^ (1 / 3 : ℝ) * (∑ i ∈ s, z i ^ (3 : ℝ)) ^ (1 / 3 : ℝ)) :=
        mul_le_mul_of_nonneg_left h2 (Real.rpow_nonneg hX0 _)
    _ ≤ (∑ i ∈ s, a i ^ 2) ^ (p / 2) * ((∑ i ∈ s, b i ^ 2) ^ (p / 2) *
        (∑ i ∈ s, c i ^ 2) ^ (p / 2)) := by
        gcongr
        · exact hmono a ha
        · exact hmono b hb
        · exact hmono c hc
    _ = _ := by ring

/-- Blueprint `eq:min-power` (line 2445): `min(η, x) ≤ η^{1-p} x^p` for `x ≥ 0`, `0 ≤ p ≤ 1`. -/
theorem min_le_rpow_mul {η x p : ℝ} (hη : 0 ≤ η) (hx : 0 ≤ x) (hp0 : 0 ≤ p) (hp1 : p ≤ 1) :
    min η x ≤ η ^ (1 - p) * x ^ p := by
  rcases le_total η x with h | h
  · rw [min_eq_left h]
    calc η = η ^ (1 - p) * η ^ p := by
          rcases hη.eq_or_lt with h0 | h0
          · rw [← h0]
            rcases hp0.eq_or_lt with hp | hp
            · rw [← hp]; simp
            · rw [Real.zero_rpow hp.ne', mul_zero]
          · rw [← Real.rpow_add h0]; simp
      _ ≤ η ^ (1 - p) * x ^ p :=
          mul_le_mul_of_nonneg_left (Real.rpow_le_rpow hη h hp0) (Real.rpow_nonneg hη _)
  · rw [min_eq_right h]
    calc x = x ^ (1 - p) * x ^ p := by
          rcases hx.eq_or_lt with h0 | h0
          · rw [← h0]
            rcases hp0.eq_or_lt with hp | hp
            · rw [← hp]; simp
            · rw [Real.zero_rpow hp.ne', mul_zero]
          · rw [← Real.rpow_add h0]; simp
      _ ≤ η ^ (1 - p) * x ^ p :=
          mul_le_mul_of_nonneg_right (Real.rpow_le_rpow hx h (by linarith))
            (Real.rpow_nonneg hx _)

/-- The chain of consecutive intervals `[b, b + l₀], [b + l₀, b + l₀ + l₁], …`. -/
def intervalChain : ℕ → List ℕ → List (ℕ × ℕ)
  | _, [] => []
  | b, l :: ls => (b, b + l) :: intervalChain (b + l) ls

theorem intervalChain_lengths (b : ℕ) (ls : List ℕ) :
    (intervalChain b ls).map (fun I => I.2 - I.1) = ls := by
  induction ls generalizing b with
  | nil => rfl
  | cons l ls ih => simp [intervalChain, ih]

theorem intervalChain_mem (b : ℕ) (ls : List ℕ) :
    ∀ I ∈ intervalChain b ls, b ≤ I.1 ∧ I.1 ≤ I.2 ∧ I.2 ≤ b + ls.sum := by
  induction ls generalizing b with
  | nil => simp [intervalChain]
  | cons l ls ih =>
    intro I hI
    simp only [intervalChain, List.mem_cons] at hI
    rcases hI with rfl | hI
    · simp only [List.sum_cons]; omega
    · have := ih (b + l) I hI
      simp only [List.sum_cons]; omega

theorem intervalChain_telescope {M : Type*} [AddCommGroup M] (W : ℕ → M) (b : ℕ)
    (ls : List ℕ) :
    W (b + ls.sum) = W b + ((intervalChain b ls).map fun I => W I.2 - W I.1).sum := by
  induction ls generalizing b with
  | nil => simp [intervalChain]
  | cons l ls ih =>
    simp only [intervalChain, List.map_cons, List.sum_cons]
    rw [← add_assoc, ih (b + l)]
    abel

/-- Blueprint lines 2409-2412 (fixed stacks): `W_s = W_b + Σ_{[r,t] ∈ 𝒫(b,s)} (W_t - W_r)` over the
binary partition of the prefix `[b, s]`, with at most one interval of each dyadic length. -/
theorem binary_prefix_expansion {M : Type*} [AddCommGroup M] (W : ℕ → M) (b n : ℕ) :
    ∃ L : List (ℕ × ℕ), (L.map fun I => I.2 - I.1).Nodup ∧
      (∀ I ∈ L, b ≤ I.1 ∧ I.1 ≤ I.2 ∧ I.2 ≤ b + n ∧ ∃ k, I.2 - I.1 = 2 ^ k) ∧
      W (b + n) = W b + (L.map fun I => W I.2 - W I.1).sum := by
  set ls := n.bitIndices.map (2 ^ ·)
  have hsum : ls.sum = n := Nat.sum_map_two_pow_bitIndices n
  refine ⟨intervalChain b ls, ?_, ?_, ?_⟩
  · rw [intervalChain_lengths]
    exact Nat.bitIndices_nodup.map (Nat.pow_right_injective le_rfl)
  · intro I hI
    obtain ⟨h1, h2, h3⟩ := intervalChain_mem b ls I hI
    refine ⟨h1, h2, hsum ▸ h3, ?_⟩
    have hlen : I.2 - I.1 ∈ ls := by
      rw [← intervalChain_lengths b ls]; exact List.mem_map_of_mem hI
    obtain ⟨k, -, hk⟩ := List.mem_map.mp hlen
    exact ⟨k, hk.symm⟩
  · have := intervalChain_telescope W b ls
    rwa [hsum] at this

/-- Blueprint lines 2433-2436: on each remainder the stopping cell gives
`a_Q b_Q ≤ √(m_a m_b)`, and pointwise Cauchy–Schwarz over the indices `ν` gives
`Σ_ν √(m_{a,ν} m_{b,ν}) ≤ √(Σ_ν m_{a,ν}) √(Σ_ν m_{b,ν})`. -/
theorem hull_maxima_cauchy_schwarz {ι : Type*} (s : Finset ι) (ma mb : ι → ℝ)
    (ha : ∀ i ∈ s, 0 ≤ ma i) (hb : ∀ i ∈ s, 0 ≤ mb i) :
    ∑ i ∈ s, Real.sqrt (ma i * mb i) ≤
      Real.sqrt (∑ i ∈ s, ma i) * Real.sqrt (∑ i ∈ s, mb i) := by
  have := Real.sum_mul_le_sqrt_mul_sqrt s (fun i => Real.sqrt (ma i)) (fun i => Real.sqrt (mb i))
  calc ∑ i ∈ s, Real.sqrt (ma i * mb i) = ∑ i ∈ s, Real.sqrt (ma i) * Real.sqrt (mb i) :=
        Finset.sum_congr rfl fun i hi => Real.sqrt_mul (ha i hi) _
    _ ≤ _ := this
    _ = _ := by
        congr 2
        · exact Finset.sum_congr rfl fun i hi => Real.sq_sqrt (ha i hi)
        · exact Finset.sum_congr rfl fun i hi => Real.sq_sqrt (hb i hi)

/-! ### Leaf-depth rectangles (lem:shortblock, blueprint lines 2290-2296) -/

/-- The rectangles partitioning four-tuples of leaf depths in the proof of `lem:shortblock`:
`rep S v` (the minimum `v` is attained exactly on the slots `S`, at least two of them) and
`uniq a S h k` (the minimum is attained only at `a`; at scale `2^(h+1)` the depths of slot `a` and
of the slots `S` share the block `k`, with `a` in the lower and `S` in the upper half; all other
slots lie above that block). -/
inductive DepthRect
  | rep (S : Finset (Fin 4)) (v : ℕ)
  | uniq (a : Fin 4) (S : Finset (Fin 4)) (h k : ℕ)
  deriving DecidableEq

namespace DepthRect

/-- Admissible rectangle parameters. -/
def Valid : DepthRect → Prop
  | rep S _ => 2 ≤ S.card
  | uniq a S _ _ => a ∉ S ∧ S.Nonempty

/-- Membership of a depth tuple; it is a product of per-slot conditions. -/
def Mem : DepthRect → (Fin 4 → ℕ) → Prop
  | rep S v, d => ∀ j, (j ∈ S → d j = v) ∧ (j ∉ S → v < d j)
  | uniq a S h k, d => d a / 2 ^ h = 2 * k ∧
      ∀ j, j ≠ a → (j ∈ S → d j / 2 ^ h = 2 * k + 1) ∧ (j ∉ S → 2 * k + 2 ≤ d j / 2 ^ h)

/-- The separating depth `t`: all slots except possibly the heavy slot have depth at least `t`. -/
def sep : DepthRect → ℕ
  | rep _ v => v
  | uniq _ _ h k => (2 * k + 1) * 2 ^ h

theorem div_pow_succ (x h : ℕ) : x / 2 ^ (h + 1) = x / 2 ^ h / 2 := by
  rw [pow_succ, Nat.div_div_eq_div_mul]

/-- Agreement of the dyadic blocks persists at coarser scales. -/
theorem div_pow_eq_of_le {x y h h' : ℕ} (hh : h ≤ h') (e : x / 2 ^ h = y / 2 ^ h) :
    x / 2 ^ h' = y / 2 ^ h' := by
  obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hh
  rw [pow_add, ← Nat.div_div_eq_div_mul, ← Nat.div_div_eq_div_mul, e]

/-- In a `uniq` rectangle the heavy slot is the strict minimum. -/
theorem uniq_lt {a : Fin 4} {S : Finset (Fin 4)} {h k : ℕ} {d : Fin 4 → ℕ}
    (hm : Mem (uniq a S h k) d) {j : Fin 4} (hj : j ≠ a) : d a < d j := by
  obtain ⟨ha, hS⟩ := hm
  have h1 : d a / 2 ^ h < d j / 2 ^ h := by
    by_cases hjS : j ∈ S
    · rw [ha, (hS j hj).1 hjS]; omega
    · have := (hS j hj).2 hjS; omega
  by_contra hle
  exact absurd (Nat.div_le_div_right (c := 2 ^ h) (not_lt.mp hle)) (not_le.mpr h1)

/-- Every tuple lies in a valid rectangle. -/
theorem exists_mem (d : Fin 4 → ℕ) : ∃ R, Valid R ∧ Mem R d := by
  classical
  obtain ⟨a, -, ha⟩ := Finset.exists_min_image Finset.univ d Finset.univ_nonempty
  set v := d a
  set S0 := Finset.univ.filter fun j => d j = v
  by_cases hS0 : 2 ≤ S0.card
  · refine ⟨rep S0 v, hS0, fun j => ⟨fun hj => (Finset.mem_filter.mp hj).2, fun hj => ?_⟩⟩
    have : d j ≠ v := fun e => hj (Finset.mem_filter.mpr ⟨Finset.mem_univ _, e⟩)
    exact lt_of_le_of_ne (ha j (Finset.mem_univ _)) (Ne.symm this)
  -- the minimum is unique
  have huniq : ∀ j, j ≠ a → v < d j := by
    intro j hj
    refine lt_of_le_of_ne (ha j (Finset.mem_univ _)) fun e => hS0 ?_
    have : ({a, j} : Finset (Fin 4)) ⊆ S0 := by
      intro i hi
      simp only [Finset.mem_insert, Finset.mem_singleton] at hi
      rcases hi with rfl | rfl
      · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, rfl⟩
      · exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, e.symm⟩
    exact (Finset.card_pair (Ne.symm hj)).symm.le.trans (Finset.card_le_card this)
  -- the second minimum
  have hne : (Finset.univ.erase a).Nonempty := Finset.card_pos.mp (by
    rw [Finset.card_erase_of_mem (Finset.mem_univ _)]; simp)
  obtain ⟨i0, hi0, hmin2⟩ := Finset.exists_min_image (Finset.univ.erase a) d hne
  have hi0a : i0 ≠ a := (Finset.mem_erase.mp hi0).1
  set w := d i0
  have hvw : v < w := huniq i0 hi0a
  have hex : ∃ h, v / 2 ^ (h + 1) = w / 2 ^ (h + 1) :=
    ⟨w, by rw [Nat.div_eq_of_lt, Nat.div_eq_of_lt] <;>
      [exact (Nat.lt_two_pow_self).trans (Nat.pow_lt_pow_right (by norm_num) (by omega));
       exact hvw.trans ((Nat.lt_two_pow_self).trans
         (Nat.pow_lt_pow_right (by norm_num) (by omega)))]⟩
  set h := Nat.find hex
  have hh : v / 2 ^ (h + 1) = w / 2 ^ (h + 1) := Nat.find_spec hex
  have hh' : v / 2 ^ h ≠ w / 2 ^ h := by
    rcases Nat.eq_zero_or_pos h with h0 | hpos
    · rw [h0]; simp only [pow_zero, Nat.div_one]; omega
    · intro e
      have := Nat.find_min hex (show h - 1 < h by omega)
      rw [show h - 1 + 1 = h by omega] at this
      exact this e
  set k := v / 2 ^ (h + 1)
  have hv : v / 2 ^ h = 2 * k ∧ w / 2 ^ h = 2 * k + 1 := by
    have e1 : v / 2 ^ h / 2 = k := (div_pow_succ v h).symm
    have e2 : w / 2 ^ h / 2 = k := by rw [← div_pow_succ]; exact hh.symm
    have hle : v / 2 ^ h ≤ w / 2 ^ h := Nat.div_le_div_right hvw.le
    omega
  set S := (Finset.univ.erase a).filter fun j => d j / 2 ^ h = 2 * k + 1
  refine ⟨uniq a S h k, ⟨fun hm => (Finset.mem_erase.mp (Finset.mem_filter.mp hm).1).1 rfl,
    ⟨i0, Finset.mem_filter.mpr ⟨hi0, hv.2⟩⟩⟩, hv.1, fun j hj => ⟨fun hjS =>
      (Finset.mem_filter.mp hjS).2, fun hjS => ?_⟩⟩
  have h1 : w ≤ d j := hmin2 j (Finset.mem_erase.mpr ⟨hj, Finset.mem_univ _⟩)
  have h2 : 2 * k + 1 ≤ d j / 2 ^ h := hv.2 ▸ Nat.div_le_div_right h1
  have h3 : d j / 2 ^ h ≠ 2 * k + 1 := fun e =>
    hjS (Finset.mem_filter.mpr ⟨Finset.mem_erase.mpr ⟨hj, Finset.mem_univ _⟩, e⟩)
  omega

/-- The rectangles partition the depth tuples: a tuple lies in exactly one valid rectangle. -/
theorem existsUnique_mem (d : Fin 4 → ℕ) : ∃! R, Valid R ∧ Mem R d := by
  classical
  obtain ⟨R, hR, hm⟩ := exists_mem d
  refine ⟨R, ⟨hR, hm⟩, ?_⟩
  -- canonical data of a valid rectangle containing `d`
  suffices key : ∀ R₁ R₂, Valid R₁ → Mem R₁ d → Valid R₂ → Mem R₂ d → R₁ = R₂ from
    fun R' ⟨hR', hm'⟩ => key R' R hR' hm' hR hm
  intro R₁ R₂ hv₁ hm₁ hv₂ hm₂
  -- a `rep` rectangle has two minimizing slots; a `uniq` rectangle has a strict minimum
  have rep_min : ∀ S v, Valid (rep S v) → Mem (rep S v) d → ∀ j, v ≤ d j ∧ (d j = v ↔ j ∈ S) := by
    intro S v _ hm j
    by_cases hj : j ∈ S
    · exact ⟨((hm j).1 hj).ge, ⟨fun _ => hj, fun _ => (hm j).1 hj⟩⟩
    · exact ⟨((hm j).2 hj).le, ⟨fun e => absurd e (ne_of_gt ((hm j).2 hj)), fun h => absurd h hj⟩⟩
  have rep_uniq : ∀ S v a S' h k, Valid (rep S v) → Mem (rep S v) d →
      Mem (uniq a S' h k) d → False := by
    intro S v a S' h k hv hm hm'
    obtain ⟨j1, hj1, j2, hj2, hj12⟩ :=
      Finset.one_lt_card.mp (show 1 < S.card by have : 2 ≤ S.card := hv; omega)
    have hva := (rep_min S v hv hm a).1
    have hj : ∃ j ∈ S, j ≠ a := by
      by_cases e : j1 = a
      · exact ⟨j2, hj2, fun e2 => hj12 (e.trans e2.symm)⟩
      · exact ⟨j1, hj1, e⟩
    obtain ⟨j, hjS, hja⟩ := hj
    have := uniq_lt hm' hja
    rw [(hm j).1 hjS] at this
    omega
  cases R₁ with
  | rep S v =>
    cases R₂ with
    | rep S' v' =>
      obtain ⟨j, hj⟩ : S.Nonempty := Finset.card_pos.mp (by have : 2 ≤ S.card := hv₁; omega)
      obtain ⟨j', hj'⟩ : S'.Nonempty := Finset.card_pos.mp (by have : 2 ≤ S'.card := hv₂; omega)
      have e1 := (hm₁ j).1 hj
      have e2 := (hm₂ j').1 hj'
      have hvv : v = v' := le_antisymm (e2 ▸ (rep_min S v hv₁ hm₁ j').1)
        (e1 ▸ (rep_min S' v' hv₂ hm₂ j).1)
      subst hvv
      have hSS : S = S' := by
        ext i
        rw [← (rep_min S v hv₁ hm₁ i).2, (rep_min S' v hv₂ hm₂ i).2]
      rw [hSS]
    | uniq a S' h k => exact (rep_uniq S v a S' h k hv₁ hm₁ hm₂).elim
  | uniq a S h k =>
    cases R₂ with
    | rep S' v' => exact (rep_uniq S' v' a S h k hv₂ hm₂ hm₁).elim
    | uniq a' S' h' k' =>
      have haa : a = a' := by
        by_contra hne
        have := uniq_lt hm₁ (Ne.symm hne)
        have := uniq_lt hm₂ hne
        omega
      subst haa
      -- the second minimum
      have hne : (Finset.univ.erase a).Nonempty := Finset.card_pos.mp (by
        rw [Finset.card_erase_of_mem (Finset.mem_univ _)]; simp)
      obtain ⟨i0, hi0, hmin2⟩ := Finset.exists_min_image (Finset.univ.erase a) d hne
      have hi0a : i0 ≠ a := (Finset.mem_erase.mp hi0).1
      -- in each rectangle, `i0` lies in the upper half
      have upper : ∀ S h k, Valid (uniq a S h k) → Mem (uniq a S h k) d →
          d i0 / 2 ^ h = 2 * k + 1 := by
        intro S h k hv hm
        obtain ⟨j, hj⟩ := hv.2
        have hja : j ≠ a := fun e => hv.1 (e ▸ hj)
        have e1 := (hm.2 j hja).1 hj
        have hle : d i0 / 2 ^ h ≤ d j / 2 ^ h :=
          Nat.div_le_div_right (hmin2 j (Finset.mem_erase.mpr ⟨hja, Finset.mem_univ _⟩))
        have hge : 2 * k + 1 ≤ d i0 / 2 ^ h := by
          by_cases hi : i0 ∈ S
          · exact ((hm.2 i0 hi0a).1 hi).ge
          · have := (hm.2 i0 hi0a).2 hi; omega
        omega
      have u1 := upper S h k hv₁ hm₁
      have u2 := upper S' h' k' hv₂ hm₂
      have l1 := hm₁.1
      have l2 := hm₂.1
      -- the scale is the first level where the two depths share a block
      have blk : ∀ h k, d a / 2 ^ h = 2 * k → d i0 / 2 ^ h = 2 * k + 1 →
          d a / 2 ^ (h + 1) = d i0 / 2 ^ (h + 1) := by
        intro h k e1 e2
        rw [div_pow_succ, div_pow_succ, e1, e2]; omega
      have hhh : h = h' := by
        by_contra hne
        rcases lt_or_gt_of_ne hne with hlt | hlt
        · have := div_pow_eq_of_le (show h + 1 ≤ h' by omega) (blk h k l1 u1)
          rw [l2, u2] at this; omega
        · have := div_pow_eq_of_le (show h' + 1 ≤ h by omega) (blk h' k' l2 u2)
          rw [l1, u1] at this; omega
      subst hhh
      have hkk : k = k' := by omega
      subst hkk
      have hSS : S = S' := by
        ext j
        by_cases hja : j = a
        · subst hja; exact ⟨fun h => absurd h hv₁.1, fun h => absurd h hv₂.1⟩
        constructor
        · intro hj
          have e := (hm₁.2 j hja).1 hj
          by_contra hj'
          have := (hm₂.2 j hja).2 hj'; omega
        · intro hj
          have e := (hm₂.2 j hja).1 hj
          by_contra hj'
          have := (hm₁.2 j hja).2 hj'; omega
      rw [hSS]

/-- All slots except the heavy one have depth at least the separating depth; in a `rep`
rectangle all slots do. -/
theorem sep_le {R : DepthRect} {d : Fin 4 → ℕ} (hm : Mem R d) (j : Fin 4) :
    (∀ a S h k, R = uniq a S h k → j ≠ a → sep R ≤ d j) ∧
      (∀ S v, R = rep S v → sep R ≤ d j) := by
  constructor
  · rintro a S h k rfl hja
    simp only [sep]
    have hq : 2 * k + 1 ≤ d j / 2 ^ h := by
      by_cases hj : j ∈ S
      · exact ((hm.2 j hja).1 hj).ge
      · have := (hm.2 j hja).2 hj; omega
    calc (2 * k + 1) * 2 ^ h ≤ d j / 2 ^ h * 2 ^ h := Nat.mul_le_mul_right _ hq
      _ ≤ d j := Nat.div_mul_le_self _ _
  · rintro S v rfl
    simp only [sep]
    by_cases hj : j ∈ S
    · exact ((hm j).1 hj).ge
    · exact ((hm j).2 hj).le

/-- Designated disjointness: at a fixed level `h` and slot assignment, distinct positions `k`
give disjoint conditions in the heavy slot `a` and in every upper-half slot. -/
theorem uniq_disjoint {a : Fin 4} {S : Finset (Fin 4)} {h k k' : ℕ} {d d' : Fin 4 → ℕ}
    (hm : Mem (uniq a S h k) d) (hm' : Mem (uniq a S h k') d') (hkk : k ≠ k') :
    d a ≠ d' a ∧ ∀ j ∈ S, j ≠ a → d j ≠ d' j := by
  refine ⟨fun e => hkk ?_, fun j hj hja e => hkk ?_⟩
  · have := hm.1; rw [e, hm'.1] at this; omega
  · have := (hm.2 j hja).1 hj; rw [e, (hm'.2 j hja).1 hj] at this; omega

/-- Positions at a level: for depths below `2^m`, a `uniq` rectangle has `h < m` and
`k < 2^(m-h-1)`; a `rep` rectangle has `v < 2^m`. -/
theorem uniq_bounds {a : Fin 4} {S : Finset (Fin 4)} {h k m : ℕ} {d : Fin 4 → ℕ}
    (hv : Valid (uniq a S h k)) (hm : Mem (uniq a S h k) d) (hd : ∀ j, d j < 2 ^ m) :
    h < m ∧ k < 2 ^ (m - h - 1) := by
  obtain ⟨j, hj⟩ := hv.2
  have hja : j ≠ a := fun e => hv.1 (e ▸ hj)
  have e := (hm.2 j hja).1 hj
  have hlt : d j / 2 ^ h < 2 ^ m / 2 ^ h :=
    Nat.div_lt_div_of_lt_of_dvd (Nat.pow_dvd_pow 2 (by
      by_contra hmh; push Not at hmh
      have : d j / 2 ^ h = 0 := Nat.div_eq_of_lt ((hd j).trans_le
        (Nat.pow_le_pow_right (by norm_num) hmh.le))
      omega)) (hd j)
  have hmh : h < m := by
    by_contra hmh; push Not at hmh
    have : d j / 2 ^ h = 0 := Nat.div_eq_of_lt ((hd j).trans_le
      (Nat.pow_le_pow_right (by norm_num) hmh))
    omega
  refine ⟨hmh, ?_⟩
  rw [Nat.pow_div hmh.le (by norm_num)] at hlt
  have : 2 ^ (m - h) = 2 * 2 ^ (m - h - 1) := by
    rw [← pow_succ']; congr 1; omega
  omega

end DepthRect

/-! ### Kernel sampling on the `δ`-lattice (lem:shortblock, blueprint lines 2298-2312) -/

/-- The first-order derivative constant of an admissible class. -/
noncomputable def admissibleLipConst (κ : LocalKernelClass) : ℝ :=
  (κ.derivativeConstant * ((1 : ℕ) + 2)) ^ (κ.derivativeConstant * ((1 : ℕ) + 2))

theorem admissibleLipConst_nonneg (κ : LocalKernelClass) : 0 ≤ admissibleLipConst κ := by
  unfold admissibleLipConst
  have := κ.one_le_derivativeConstant
  positivity

/-- An admissible kernel on a cell of length `r` is Lipschitz with constant `C_κ / r` in each
variable. -/
theorem admissible_kernel_lipschitz {κ : LocalKernelClass} {a r : ℝ}
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w) (z z' : ℝ × ℝ) :
    ‖w z - w z'‖ ≤ admissibleLipConst κ * r⁻¹ * (|z.1 - z'.1| + |z.2 - z'.2|) := by
  have hd : Differentiable ℝ w := hw.smooth.differentiable (by simp)
  have hb10 : ∀ y : ℝ × ℝ, ‖deriv (fun x => w (x, y.2)) y.1‖ ≤ admissibleLipConst κ * r⁻¹ := by
    intro y
    have := hw.derivativeBound 1 0 y
    simp only [localKernelPartial, iteratedDeriv_one, iteratedDeriv_zero] at this
    simpa [admissibleLipConst, pow_one, mul_comm] using this
  have hb01 : ∀ y : ℝ × ℝ, ‖deriv (fun t => w (y.1, t)) y.2‖ ≤ admissibleLipConst κ * r⁻¹ := by
    intro y
    have := hw.derivativeBound 0 1 y
    simp only [localKernelPartial, iteratedDeriv_one, iteratedDeriv_zero] at this
    simpa [admissibleLipConst, pow_one, mul_comm] using this
  have h1 : ‖w (z.1, z.2) - w (z'.1, z.2)‖ ≤ admissibleLipConst κ * r⁻¹ * |z.1 - z'.1| := by
    have hdx : Differentiable ℝ fun x => w (x, z.2) :=
      hd.comp (differentiable_id.prodMk (differentiable_const _))
    have := (convex_univ (𝕜 := ℝ) (E := ℝ)).norm_image_sub_le_of_norm_deriv_le
      (f := fun x => w (x, z.2)) (fun x _ => hdx x) (fun x _ => hb10 (x, z.2))
      (Set.mem_univ z'.1) (Set.mem_univ z.1)
    simpa [Real.norm_eq_abs] using this
  have h2 : ‖w (z'.1, z.2) - w (z'.1, z'.2)‖ ≤ admissibleLipConst κ * r⁻¹ * |z.2 - z'.2| := by
    have hdt : Differentiable ℝ fun t => w (z'.1, t) :=
      hd.comp ((differentiable_const _).prodMk differentiable_id)
    have := (convex_univ (𝕜 := ℝ) (E := ℝ)).norm_image_sub_le_of_norm_deriv_le
      (f := fun t => w (z'.1, t)) (fun t _ => hdt t) (fun t _ => hb01 (z'.1, t))
      (Set.mem_univ z'.2) (Set.mem_univ z.2)
    simpa [Real.norm_eq_abs] using this
  calc ‖w z - w z'‖ = ‖(w (z.1, z.2) - w (z'.1, z.2)) + (w (z'.1, z.2) - w (z'.1, z'.2))‖ := by
        congr 1; abel
    _ ≤ _ := (norm_add_le _ _).trans (by rw [mul_add]; exact add_le_add h1 h2)

/-- The kernel sampled on the `δ`-lattice: with `y₀ = x = δ(n₀ + u)` and
`y₁ = x + t = δ(n₁ + v)`, its value is `w(δ n₀, δ(n₁ - n₀))` (blueprint line 2307). -/
noncomputable def latticeSampledKernel (δ : ℝ) (w : ℝ × ℝ → ℂ) (z : ℝ × ℝ) : ℂ :=
  w (δ * ⌊z.1 / δ⌋, δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋)

theorem latticeSampled_offsets {δ : ℝ} (hδ : 0 < δ) (z : ℝ × ℝ) :
    0 ≤ z.1 - δ * ⌊z.1 / δ⌋ ∧ z.1 - δ * ⌊z.1 / δ⌋ < δ ∧
      0 ≤ (z.1 + z.2) - δ * ⌊(z.1 + z.2) / δ⌋ ∧ (z.1 + z.2) - δ * ⌊(z.1 + z.2) / δ⌋ < δ := by
  have k1 := Int.floor_le (z.1 / δ)
  have k2 := Int.lt_floor_add_one (z.1 / δ)
  have k3 := Int.floor_le ((z.1 + z.2) / δ)
  have k4 := Int.lt_floor_add_one ((z.1 + z.2) / δ)
  rw [le_div_iff₀ hδ] at k1 k3
  rw [div_lt_iff₀ hδ] at k2 k4
  refine ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩

/-- Blueprint lines 2307-2312 (first kernel-sampling error): for an admissible kernel on a cell
of length `r` and `5δ ≤ μ r`, the form with the sampling error kernel `w - w^δ` is at most
`4 C_κ (δ / r)` times the product of normalized local norms, at every exponent tuple allowed by
`eq:absolute`. -/
theorem latticeSampled_form_error {κ : LocalKernelClass} {a r : ℝ} (hr : 0 < r)
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ a r w) {δ : ℝ} (hδ : 0 < δ)
    (hδr : 5 * δ ≤ κ.margin * r)
    (f : Fin 4 → ℝ → ℂ) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ‖localProgressionForm r (fun z => w z - latticeSampledKernel δ w z) f‖ₑ ≤
      ENNReal.ofReal (4 * admissibleLipConst κ * (δ / r)) *
        ∏ i, eLpNorm (f i) (p i) (normalizedIntervalMeasure a r) := by
  set e : ℝ × ℝ → ℂ := fun z => w z - latticeSampledKernel δ w z
  have hwc : Continuous w := hw.smooth.continuous
  have hem : Measurable e := by
    have h1 : Measurable fun z : ℝ × ℝ =>
        (δ * ⌊z.1 / δ⌋, δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋) := by
      have m1 : Measurable fun z : ℝ × ℝ => (⌊z.1 / δ⌋ : ℝ) :=
        measurable_from_top.comp (Int.measurable_floor.comp (measurable_fst.div_const δ))
      have m2 : Measurable fun z : ℝ × ℝ => (⌊(z.1 + z.2) / δ⌋ : ℝ) :=
        measurable_from_top.comp (Int.measurable_floor.comp
          ((measurable_fst.add measurable_snd).div_const δ))
      exact (m1.const_mul δ).prodMk ((m2.const_mul δ).sub (m1.const_mul δ))
    exact hwc.measurable.sub (hwc.measurable.comp h1)
  -- pointwise size of the error kernel
  have hsize : ∀ z, ‖e z‖ ≤ 2 * admissibleLipConst κ * (δ / r) := by
    intro z
    obtain ⟨o1, o2, o3, o4⟩ := latticeSampled_offsets hδ z
    have := admissible_kernel_lipschitz hw z
      (δ * ⌊z.1 / δ⌋, δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋)
    simp only at this
    have hx : |z.1 - δ * ⌊z.1 / δ⌋| ≤ δ := by rw [abs_le]; constructor <;> linarith
    have ht : |z.2 - (δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋)| ≤ δ := by
      rw [abs_le]; constructor <;> linarith
    have hL := admissibleLipConst_nonneg κ
    calc ‖e z‖ ≤ _ := this
      _ ≤ admissibleLipConst κ * r⁻¹ * (δ + δ) := by gcongr
      _ = 2 * admissibleLipConst κ * (δ / r) := by ring
  -- support inside the cell
  have hsupp : HasLocalProgressionSupport a r e := by
    intro z hz j
    have hμ := κ.margin_pos
    by_cases h0 : w z ≠ 0
    · obtain ⟨h1, h2⟩ := hw.support z h0 j
      constructor <;> nlinarith [mul_pos hμ hr]
    · push Not at h0
      have h0' : latticeSampledKernel δ w z ≠ 0 := by
        intro h; apply hz; simp only [e, h0, h, sub_self]
      obtain ⟨h1, h2⟩ := hw.support _ h0' j
      obtain ⟨o1, o2, o3, o4⟩ := latticeSampled_offsets hδ z
      have hj0 : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg _
      have hj3 : (j : ℝ) ≤ 3 := by exact_mod_cast Nat.le_of_lt_succ j.isLt
      simp only [realProgressionCoordinate] at h1 h2 ⊢
      set X := z.1 - δ * ⌊z.1 / δ⌋
      set Y := (z.1 + z.2) - δ * ⌊(z.1 + z.2) / δ⌋
      have hcoord : z.1 + (j : ℝ) * z.2 = (δ * ⌊z.1 / δ⌋ + (j : ℝ) *
          (δ * ⌊(z.1 + z.2) / δ⌋ - δ * ⌊z.1 / δ⌋)) + ((1 - (j : ℝ)) * X + (j : ℝ) * Y) := by
        simp only [X, Y]; ring
      have hd1 : |(1 - (j : ℝ)) * X + (j : ℝ) * Y| ≤ 5 * δ := by
        rw [abs_le]; constructor <;> nlinarith
      rw [abs_le] at hd1
      rw [hcoord]
      constructor <;> nlinarith [mul_pos hμ hr]
  -- the form estimate
  have hW : ∀ z, ‖e z‖ₑ ≤ ENNReal.ofReal (2 * admissibleLipConst κ * (δ / r)) := fun z => by
    rw [← ofReal_norm]; exact ENNReal.ofReal_le_ofReal (hsize z)
  have habs := localProgression_absoluteNormBound hr e hem hsupp hW f hf p hp hsum
  have hform : ‖localProgressionForm r e f‖ₑ ≤ ENNReal.ofReal r⁻¹ ^ 2 *
      ∫⁻ z : ℝ × ℝ, ‖e z‖ₑ * ∏ i, ‖f i (realProgressionCoordinate i z)‖ₑ := by
    unfold localProgressionForm
    rw [enorm_mul, enorm_pow, ← ofReal_norm, norm_inv, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr]
    gcongr
    refine (enorm_integral_le_lintegral_enorm _).trans (le_of_eq ?_)
    congr 1; funext z
    rw [enorm_mul]
    simp only [enorm_eq_nnnorm, nnnorm_prod, ENNReal.ofNNReal_finsetProd]
  refine hform.trans (habs.trans (le_of_eq ?_))
  rw [← ENNReal.ofReal_ofNat 2, ← ENNReal.ofReal_mul (by norm_num)]
  congr 2; ring

/-- The `δ`-lattice cell of the integer point `n ∈ ℤ²`. -/
def latticeCell (δ : ℝ) (n : ℤ × ℤ) : Set (ℝ × ℝ) :=
  Set.Ico (δ * n.1) (δ * (n.1 + 1)) ×ˢ Set.Ico (δ * n.2) (δ * (n.2 + 1))

theorem mem_latticeCell_iff {δ : ℝ} (hδ : 0 < δ) (n : ℤ × ℤ) (z : ℝ × ℝ) :
    z ∈ latticeCell δ n ↔ ⌊z.1 / δ⌋ = n.1 ∧ ⌊z.2 / δ⌋ = n.2 := by
  simp only [latticeCell, Set.mem_prod, Set.mem_Ico, Int.floor_eq_iff, le_div_iff₀ hδ,
    div_lt_iff₀ hδ]
  constructor <;> rintro ⟨⟨h1, h2⟩, h3, h4⟩ <;> refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith

/-- Blueprint lines 2298-2305 (substitution `y = δ(n + u)`): an integrable function on `ℝ²` is the
`δ²`-weighted sum over `n ∈ ℤ²` of its integrals over the unit fast cell. -/
theorem lattice_integral_decomposition {G : ℝ × ℝ → ℂ} (hG : Integrable G) {δ : ℝ} (hδ : 0 < δ) :
    ∫ z, G z = (δ ^ 2 : ℝ) * ∑' n : ℤ × ℤ, ∫ u in Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1,
      G (δ * (n.1 + u.1), δ * (n.2 + u.2)) := by
  have hm : ∀ n, MeasurableSet (latticeCell δ n) := fun n =>
    measurableSet_Ico.prod measurableSet_Ico
  have hdis : Pairwise (Function.onFun Disjoint (latticeCell δ)) := by
    intro n n' hne
    refine Set.disjoint_left.mpr fun z h h' => hne ?_
    rw [mem_latticeCell_iff hδ] at h h'
    exact Prod.ext (h.1.symm.trans h'.1) (h.2.symm.trans h'.2)
  have hcov : (⋃ n, latticeCell δ n) = Set.univ := by
    ext z
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true]
    exact ⟨(⌊z.1 / δ⌋, ⌊z.2 / δ⌋), (mem_latticeCell_iff hδ _ z).mpr ⟨rfl, rfl⟩⟩
  have h1 : ∫ z, G z = ∑' n, ∫ z in latticeCell δ n, G z := by
    rw [← integral_iUnion hm hdis (by rw [hcov]; exact hG.integrableOn), hcov,
      Measure.restrict_univ]
  rw [h1, ← tsum_mul_left]
  congr 1; funext n
  -- rescaling and translation on one cell
  set box : Set (ℝ × ℝ) := Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1
  have hind : ∀ u : ℝ × ℝ, (latticeCell δ n).indicator G (δ • (((n.1 : ℝ), (n.2 : ℝ)) + u)) =
      box.indicator (fun u => G (δ * (n.1 + u.1), δ * (n.2 + u.2))) u := by
    intro u
    have hiv : ∀ m x : ℝ, (δ * m ≤ δ * (m + x) ∧ δ * (m + x) < δ * (m + 1)) ↔
        (0 ≤ x ∧ x < 1) := by
      intro m x
      rw [mul_le_mul_iff_right₀ hδ, mul_lt_mul_iff_right₀ hδ]
      constructor <;> rintro ⟨h1, h2⟩ <;> constructor <;> linarith
    have hmem : δ • (((n.1 : ℝ), (n.2 : ℝ)) + u) ∈ latticeCell δ n ↔ u ∈ box := by
      have e1 : (δ • (((n.1 : ℝ), (n.2 : ℝ)) + u)).1 = δ * (n.1 + u.1) := by
        simp only [Prod.smul_fst, Prod.fst_add, smul_eq_mul]
      have e2 : (δ • (((n.1 : ℝ), (n.2 : ℝ)) + u)).2 = δ * (n.2 + u.2) := by
        simp only [Prod.smul_snd, Prod.snd_add, smul_eq_mul]
      simp only [latticeCell, box, Set.mem_prod, Set.mem_Ico, e1, e2, hiv]
    by_cases hu : u ∈ box
    · rw [Set.indicator_of_mem (hmem.mpr hu), Set.indicator_of_mem hu]
      congr 1
    · rw [Set.indicator_of_notMem (fun h => hu (hmem.mp h)), Set.indicator_of_notMem hu]
  have hscale := MeasureTheory.Measure.integral_comp_smul (volume : Measure (ℝ × ℝ))
    ((latticeCell δ n).indicator G) δ
  have hfin : Module.finrank ℝ (ℝ × ℝ) = 2 := by simp
  rw [hfin] at hscale
  have htr : ∫ y : ℝ × ℝ, (latticeCell δ n).indicator G (δ • y) =
      ∫ u : ℝ × ℝ, (latticeCell δ n).indicator G (δ • (((n.1 : ℝ), (n.2 : ℝ)) + u)) :=
    (integral_add_left_eq_self (fun y => (latticeCell δ n).indicator G (δ • y))
      (((n.1 : ℝ), (n.2 : ℝ)))).symm
  have key : ∫ z, (latticeCell δ n).indicator G z =
      ((δ ^ 2 : ℝ) : ℂ) * ∫ y : ℝ × ℝ, (latticeCell δ n).indicator G (δ • y) := by
    rw [hscale, Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul,
      abs_of_pos (by positivity), mul_inv_cancel₀ (by positivity), Complex.ofReal_one, one_mul]
  rw [← integral_indicator (hm n), key, htr,
    ← integral_indicator (measurableSet_Ico.prod measurableSet_Ico)]
  simp_rw [hind]
  rfl

/-! ### The fast multipliers and the fourth moment (lem:shortblock, blueprint lines 2314-2326) -/

/-- The additive character `e(x) = exp(2πix)` of a real phase. -/
noncomputable def ePhase (x : ℝ) : ℂ := Complex.exp (2 * Real.pi * Complex.I * x)

theorem ePhase_add (x y : ℝ) : ePhase x * ePhase y = ePhase (x + y) := by
  unfold ePhase; rw [← Complex.exp_add]; congr 1; push_cast; ring

theorem ePhase_conj (x : ℝ) : (starRingEnd ℂ) (ePhase x) = ePhase (-x) := by
  unfold ePhase
  rw [← Complex.exp_conj]
  congr 1
  rw [map_mul, map_mul, map_mul, Complex.conj_ofReal, Complex.conj_ofReal, Complex.conj_I,
    map_ofNat]
  push_cast; ring

theorem norm_ePhase (x : ℝ) : ‖ePhase x‖ = 1 := by
  unfold ePhase
  rw [Complex.norm_exp]
  simp

theorem continuous_ePhase : Continuous ePhase := by unfold ePhase; fun_prop

/-- `∫₀ᴸ e(k x / L) dx = L [k = 0]` for an integer frequency `k`. -/
theorem integral_ePhase_int (k : ℤ) {L : ℝ} (hL : 0 < L) :
    ∫ x in (0 : ℝ)..L, ePhase (k * x / L) = if k = 0 then (L : ℂ) else 0 := by
  split_ifs with hk
  · subst hk; simp [ePhase]
  set c : ℂ := 2 * Real.pi * Complex.I * k / L
  have hL' : (L : ℂ) ≠ 0 := by exact_mod_cast hL.ne'
  have hk' : (k : ℂ) ≠ 0 := by exact_mod_cast hk
  have hπ : (Real.pi : ℂ) ≠ 0 := by exact_mod_cast Real.pi_pos.ne'
  have hc : c ≠ 0 := by
    simp only [c]
    exact div_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero hπ) Complex.I_ne_zero)
      hk') hL'
  have he : ∀ x : ℝ, ePhase (k * x / L) = Complex.exp (c * x) := by
    intro x; unfold ePhase; congr 1; simp only [c]; push_cast; field_simp
  simp_rw [he]
  rw [integral_exp_mul_complex hc]
  have h1 : c * (L : ℂ) = (k : ℂ) * (2 * Real.pi * Complex.I) := by
    simp only [c]; field_simp
  rw [h1, Complex.exp_int_mul_two_pi_mul_I]
  simp

/-- The fast trigonometric polynomial `Σ_m a_m e(γ m²/c + m w/16)` on the circle of length `16`
after the multiplier `e(γ m²/c)` (blueprint line 2316). -/
noncomputable def fastMultiplied (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ w : ℝ) : ℂ :=
  ∑ m ∈ s, a m * ePhase (γ * (m : ℝ) ^ 2 / c + m * w / 16)

/-- The fourth power expanded into the quadruple sum. -/
theorem fastMultiplied_norm_pow_four (s : Finset ℤ) (a : ℤ → ℂ) (c : ℤ) (γ w : ℝ) :
    ((‖fastMultiplied s a c γ w‖ ^ 4 : ℝ) : ℂ) =
      ∑ m₁ ∈ s, ∑ m₂ ∈ s, ∑ m₃ ∈ s, ∑ m₄ ∈ s,
        a m₁ * a m₂ * (starRingEnd ℂ) (a m₃) * (starRingEnd ℂ) (a m₄) *
          (ePhase (γ * ((m₁ : ℝ) ^ 2 + (m₂ : ℝ) ^ 2 - (m₃ : ℝ) ^ 2 - (m₄ : ℝ) ^ 2) / c) *
            ePhase (((m₁ + m₂ - m₃ - m₄ : ℤ) : ℝ) * w / 16)) := by
  set G := fastMultiplied s a c γ w
  have h4 : ((‖G‖ ^ 4 : ℝ) : ℂ) = (starRingEnd ℂ) G * (starRingEnd ℂ) G * G * G := by
    have : ((‖G‖ ^ 2 : ℝ) : ℂ) = G * (starRingEnd ℂ) G := by
      rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
    rw [show ‖G‖ ^ 4 = (‖G‖ ^ 2) ^ 2 by ring, Complex.ofReal_pow, this]; ring
  rw [h4]
  simp only [G, fastMultiplied, map_sum, Finset.sum_mul, Finset.mul_sum]
  refine Finset.sum_congr rfl fun m₁ _ => Finset.sum_congr rfl fun m₂ _ =>
    Finset.sum_congr rfl fun m₃ _ => Finset.sum_congr rfl fun m₄ _ => ?_
  simp only [map_mul, ePhase_conj]
  have hR : ePhase (γ * ((m₁ : ℝ) ^ 2 + (m₂ : ℝ) ^ 2 - (m₃ : ℝ) ^ 2 - (m₄ : ℝ) ^ 2) / c) *
      ePhase (((m₁ + m₂ - m₃ - m₄ : ℤ) : ℝ) * w / 16) =
        ePhase (γ * (m₁ : ℝ) ^ 2 / c + m₁ * w / 16) * ePhase (γ * (m₂ : ℝ) ^ 2 / c + m₂ * w / 16) *
          ePhase (-(γ * (m₃ : ℝ) ^ 2 / c + m₃ * w / 16)) *
          ePhase (-(γ * (m₄ : ℝ) ^ 2 / c + m₄ * w / 16)) := by
    rw [ePhase_add, ePhase_add, ePhase_add, ePhase_add]
    congr 1; push_cast; ring
  rw [hR]
  ring

/-- Interval integrals commute with quadruple finite sums of continuous functions. -/
theorem intervalIntegral_quad_sum {x₀ x₁ : ℝ} (s : Finset ℤ) (F : ℤ → ℤ → ℤ → ℤ → ℝ → ℂ)
    (hF : ∀ i j k l, Continuous (F i j k l)) :
    ∫ x in x₀..x₁, ∑ i ∈ s, ∑ j ∈ s, ∑ k ∈ s, ∑ l ∈ s, F i j k l x =
      ∑ i ∈ s, ∑ j ∈ s, ∑ k ∈ s, ∑ l ∈ s, ∫ x in x₀..x₁, F i j k l x := by
  have c1 : ∀ i j k, Continuous fun x => ∑ l ∈ s, F i j k l x := fun i j k =>
    continuous_finsetSum _ fun l _ => hF i j k l
  have c2 : ∀ i j, Continuous fun x => ∑ k ∈ s, ∑ l ∈ s, F i j k l x := fun i j =>
    continuous_finsetSum _ fun k _ => c1 i j k
  have c3 : ∀ i, Continuous fun x => ∑ j ∈ s, ∑ k ∈ s, ∑ l ∈ s, F i j k l x := fun i =>
    continuous_finsetSum _ fun j _ => c2 i j
  rw [intervalIntegral.integral_finsetSum fun i _ => (c3 i).intervalIntegrable _ _]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [intervalIntegral.integral_finsetSum fun j _ => (c2 i j).intervalIntegrable _ _]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [intervalIntegral.integral_finsetSum fun k _ => (c1 i j k).intervalIntegrable _ _]
  refine Finset.sum_congr rfl fun k _ => ?_
  exact intervalIntegral.integral_finsetSum fun l _ => (hF i j k l).intervalIntegrable _ _

/-- Blueprint `eq:fourth-moment` (lines 2318-2322) for finite Fourier sums: when `c ∣ 3`,
the average over `γ ∈ ℝ/3ℤ` of the normalized `L⁴` norm on the circle of length `16` satisfies
`E_γ ∫ |U_γ F|⁴ ≤ 2 (Σ |a_m|²)² = 2 ‖F‖₂⁴`. -/
theorem fast_fourth_moment (s : Finset ℤ) (a : ℤ → ℂ) {c : ℤ} (hc0 : c ≠ 0) (hc : c ∣ 3) :
    (1 / 3) * ∫ γ in (0 : ℝ)..3, (1 / 16) * ∫ w in (0 : ℝ)..16, ‖fastMultiplied s a c γ w‖ ^ 4 ≤
      2 * (∑ m ∈ s, ‖a m‖ ^ 2) ^ 2 := by
  classical
  obtain ⟨b, hb⟩ := hc
  have hcR : (c : ℝ) ≠ 0 := by exact_mod_cast hc0
  -- integration in `w`
  have hw : ∀ γ : ℝ, ((∫ w in (0 : ℝ)..16, ‖fastMultiplied s a c γ w‖ ^ 4 : ℝ) : ℂ) =
      16 * ∑ m₁ ∈ s, ∑ m₂ ∈ s, ∑ m₃ ∈ s, ∑ m₄ ∈ s,
        if m₁ + m₂ - m₃ - m₄ = 0 then
          a m₁ * a m₂ * (starRingEnd ℂ) (a m₃) * (starRingEnd ℂ) (a m₄) *
            ePhase (γ * ((m₁ : ℝ) ^ 2 + (m₂ : ℝ) ^ 2 - (m₃ : ℝ) ^ 2 - (m₄ : ℝ) ^ 2) / c)
        else 0 := by
    intro γ
    rw [← intervalIntegral.integral_ofReal]
    simp_rw [fastMultiplied_norm_pow_four]
    rw [intervalIntegral_quad_sum s _ fun m₁ m₂ m₃ m₄ => by
      have := continuous_ePhase; fun_prop]
    simp_rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₁ _ => Finset.sum_congr rfl fun m₂ _ =>
      Finset.sum_congr rfl fun m₃ _ => Finset.sum_congr rfl fun m₄ _ => ?_
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
      integral_ePhase_int _ (by norm_num : (0 : ℝ) < 16)]
    split_ifs <;> push_cast <;> ring
  -- integration in `γ`
  have hγ : ∀ q : ℤ, ∫ γ in (0 : ℝ)..3, ePhase (γ * q / c) = if q = 0 then (3 : ℂ) else 0 := by
    intro q
    have h := integral_ePhase_int (q * b) (L := 3) (by norm_num)
    have hq : ∀ γ : ℝ, ePhase (γ * q / c) = ePhase (((q * b : ℤ) : ℝ) * γ / 3) := by
      intro γ; congr 1
      have : (3 : ℝ) = c * b := by exact_mod_cast hb
      have hbR : (b : ℝ) ≠ 0 := by
        rintro h; rw [h, mul_zero] at this; norm_num at this
      rw [this]; push_cast; field_simp
    simp_rw [hq]
    rw [h]
    have hb0 : b ≠ 0 := by rintro rfl; simp at hb
    simp [hb0]
  set P : ℂ := ∑ m₁ ∈ s, ∑ m₂ ∈ s, ∑ m₃ ∈ s, ∑ m₄ ∈ s,
    (if m₁ + m₂ = m₃ + m₄ ∧ m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 then
      a m₁ * a m₂ * (starRingEnd ℂ) (a m₃) * (starRingEnd ℂ) (a m₄) else 0)
  have htotal : ((((1 / 3) * ∫ γ in (0 : ℝ)..3, (1 / 16) *
      ∫ w in (0 : ℝ)..16, ‖fastMultiplied s a c γ w‖ ^ 4) : ℝ) : ℂ) = P := by
    push_cast
    rw [← intervalIntegral.integral_ofReal]
    simp_rw [Complex.ofReal_mul, hw]
    simp_rw [Finset.mul_sum]
    rw [intervalIntegral_quad_sum s _ fun m₁ m₂ m₃ m₄ => by
      have := continuous_ePhase; split_ifs <;> fun_prop, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₁ _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₂ _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₃ _ => ?_
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₄ _ => ?_
    by_cases hd : m₁ + m₂ - m₃ - m₄ = 0
    · have hγq := hγ (m₁ ^ 2 + m₂ ^ 2 - m₃ ^ 2 - m₄ ^ 2)
      have hcast : ∀ γ : ℝ, γ * (((m₁ ^ 2 + m₂ ^ 2 - m₃ ^ 2 - m₄ ^ 2 : ℤ) : ℝ)) / c =
          γ * ((m₁ : ℝ) ^ 2 + (m₂ : ℝ) ^ 2 - (m₃ : ℝ) ^ 2 - (m₄ : ℝ) ^ 2) / c := by
        intro γ; push_cast; ring
      simp_rw [hcast] at hγq
      simp only [hd, ite_true]
      rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul, hγq]
      have hd' : m₁ + m₂ = m₃ + m₄ := by omega
      by_cases hq : m₁ ^ 2 + m₂ ^ 2 - m₃ ^ 2 - m₄ ^ 2 = 0
      · have hq' : m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 := by omega
        rw [ite_eq_left hq, ite_eq_left ⟨hd', hq'⟩]
        push_cast; ring
      · have hq' : ¬ m₁ ^ 2 + m₂ ^ 2 = m₃ ^ 2 + m₄ ^ 2 := by omega
        simp [hq, hq']
    · have hd' : ¬ m₁ + m₂ = m₃ + m₄ := by omega
      simp [hd, hd']
  have hreal := congrArg (‖·‖) htotal
  simp only [Complex.norm_real, Real.norm_eq_abs] at hreal
  refine (le_abs_self _).trans (hreal.le.trans ?_)
  exact fourth_moment_pairing s a

/-- The fast multiplier coefficients `c = (-1, 3, -3, 1)` (blueprint line 2314). -/
def fastSlotC : Fin 4 → ℤ := ![-1, 3, -3, 1]

theorem ePhase_prod_four (x : Fin 4 → ℝ) : ∏ j, ePhase (x j) = ePhase (∑ j, x j) := by
  simp only [Fin.prod_univ_four, Fin.sum_univ_four, ePhase_add]

theorem ePhase_zero : ePhase 0 = 1 := by simp [ePhase]

/-- `fast_form_quadratic_invariance` over `ℝ`. -/
theorem fast_quadratic_invariance_real (m : Fin 4 → ℝ) (h0 : m 0 + m 1 + m 2 + m 3 = 0)
    (h1 : m 1 + 2 * m 2 + 3 * m 3 = 0) :
    ∑ j, m j ^ 2 / (fastSlotC j : ℝ) = 0 := by
  have hm1 : m 1 = -2 * m 2 - 3 * m 3 := by linarith
  have hm0 : m 0 = m 2 + 2 * m 3 := by linarith
  simp only [Fin.sum_univ_four, fastSlotC, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
  rw [hm0, hm1]; push_cast; ring

/-- The product of the four multiplied slots on the progression `w_j = (1-j)u + jv`, expanded
over frequency tuples. -/
theorem fast_slots_product (s : Finset ℤ) (a : Fin 4 → ℤ → ℂ) (γ u v : ℝ) :
    ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) γ ((1 - (j : ℝ)) * u + j * v) =
      ∑ p ∈ Fintype.piFinset fun _ : Fin 4 => s, (∏ j, a j (p j)) *
        (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
          ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * u +
            ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * v) / 16)) := by
  simp only [fastMultiplied]
  rw [Finset.prod_univ_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [Finset.prod_mul_distrib, ePhase_prod_four, ePhase_add]
  congr 2
  simp only [Fin.sum_univ_four]
  push_cast
  ring

/-- `∫₀¹⁶ ∫₀¹⁶ e((A u + B v)/16) dv du = 16² [A = 0][B = 0]`. -/
theorem double_integral_ePhase (A B : ℤ) :
    ∫ u in (0 : ℝ)..16, ∫ v in (0 : ℝ)..16, ePhase (((A : ℝ) * u + (B : ℝ) * v) / 16) =
      if A = 0 ∧ B = 0 then (256 : ℂ) else 0 := by
  have hsplit : ∀ u v : ℝ, ePhase (((A : ℝ) * u + (B : ℝ) * v) / 16) =
      ePhase ((A : ℝ) * u / 16) * ePhase ((B : ℝ) * v / 16) := by
    intro u v; rw [ePhase_add]; congr 1; ring
  simp_rw [hsplit, intervalIntegral.integral_const_mul]
  rw [integral_ePhase_int B (by norm_num : (0 : ℝ) < 16), intervalIntegral.integral_mul_const,
    integral_ePhase_int A (by norm_num : (0 : ℝ) < 16)]
  by_cases hA : A = 0 <;> by_cases hB : B = 0 <;> simp [hA, hB]; norm_num

/-- Blueprint lines 2314-2317: the fast form of the multiplied slots does not depend on `γ`:
its Fourier support has `Σ m_j = Σ j m_j = 0`, hence `Σ m_j² / c_j = 0`. The form equals
`16² Σ_{Σ m_j = Σ j m_j = 0} Π_j a_j(m_j)`. -/
theorem fast_form_eval (s : Finset ℤ) (a : Fin 4 → ℤ → ℂ) (γ : ℝ) :
    ∫ u in (0 : ℝ)..16, ∫ v in (0 : ℝ)..16,
        ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) γ ((1 - (j : ℝ)) * u + j * v) =
      256 * ∑ p ∈ Fintype.piFinset fun _ : Fin 4 => s,
        if (∑ j : Fin 4, (1 - (j : ℤ)) * p j) = 0 ∧ (∑ j : Fin 4, (j : ℤ) * p j) = 0 then
          ∏ j, a j (p j) else 0 := by
  simp_rw [fast_slots_product]
  have hc : ∀ p : Fin 4 → ℤ, Continuous fun x : ℝ × ℝ => (∏ j, a j (p j)) *
      (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
        ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * x.1 +
          ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * x.2) / 16)) := by
    intro p; have := continuous_ePhase; fun_prop
  have hin : ∀ u : ℝ, ∫ v in (0 : ℝ)..16, ∑ p ∈ Fintype.piFinset fun _ : Fin 4 => s,
      (∏ j, a j (p j)) * (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
        ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * u +
          ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * v) / 16)) =
      ∑ p ∈ Fintype.piFinset fun _ : Fin 4 => s, ∫ v in (0 : ℝ)..16,
      (∏ j, a j (p j)) * (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
        ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * u +
          ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * v) / 16)) := fun u =>
    intervalIntegral.integral_finsetSum fun p _ =>
      ((hc p).comp (continuous_const.prodMk continuous_id)).intervalIntegrable _ _
  simp_rw [hin]
  rw [intervalIntegral.integral_finsetSum fun p _ => ?_]
  · rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => ?_
    simp_rw [intervalIntegral.integral_const_mul]
    rw [double_integral_ePhase]
    split_ifs with h
    · have e0 : p 0 - p 2 - 2 * p 3 = 0 := by
        have := h.1; simp only [Fin.sum_univ_four] at this; norm_num at this; linarith
      have e1 : p 1 + 2 * p 2 + 3 * p 3 = 0 := by
        have := h.2; simp only [Fin.sum_univ_four] at this; norm_num at this; linarith
      have hq : ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ) = 0 := by
        apply fast_quadratic_invariance_real
        · have : p 0 + p 1 + p 2 + p 3 = 0 := by linarith
          exact_mod_cast this
        · exact_mod_cast e1
      rw [hq, mul_zero, ePhase_zero]; ring
    · ring
  · have : Continuous fun u : ℝ => ∫ v in (0 : ℝ)..16,
        (∏ j, a j (p j)) * (ePhase (γ * ∑ j, ((p j : ℝ)) ^ 2 / (fastSlotC j : ℝ)) *
          ePhase ((((∑ j : Fin 4, (1 - (j : ℤ)) * p j : ℤ) : ℝ) * u +
            ((∑ j : Fin 4, (j : ℤ) * p j : ℤ) : ℝ) * v) / 16)) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (hc p) 0 16
    exact this.intervalIntegrable _ _

/-- Blueprint lines 2314-2317: the multipliers `U_{j,γ}` leave the fast form unchanged. -/
theorem fast_form_invariance (s : Finset ℤ) (a : Fin 4 → ℤ → ℂ) (γ : ℝ) :
    ∫ u in (0 : ℝ)..16, ∫ v in (0 : ℝ)..16,
        ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) γ ((1 - (j : ℝ)) * u + j * v) =
      ∫ u in (0 : ℝ)..16, ∫ v in (0 : ℝ)..16,
        ∏ j : Fin 4, fastMultiplied s (a j) (fastSlotC j) 0 ((1 - (j : ℝ)) * u + j * v) := by
  rw [fast_form_eval, fast_form_eval]

/-- Blueprint lines 2302-2307 (lift to the fast variables): with `y₀ = x = δ(n₀ + u)` and
`y₁ = x + t = δ(n₁ + v)`, the form with the lattice-sampled kernel is the `δ²`-weighted sum over
`n ∈ ℤ²` of `w(δ n₀, δ(n₁ - n₀))` times the fast integral over the unit cell of the inputs at
`δ(n_j + w_j)`, `n_j = (1-j)n₀ + j n₁`, `w_j = (1-j)u + j v`. -/
theorem latticeSampled_form_lift {w : ℝ × ℝ → ℂ} {δ : ℝ} (hδ : 0 < δ) (f : Fin 4 → ℝ → ℂ)
    (hF : Integrable fun z : ℝ × ℝ =>
      latticeSampledKernel δ w z * ∏ j, f j (realProgressionCoordinate j z)) :
    ∫ z : ℝ × ℝ, latticeSampledKernel δ w z * ∏ j, f j (realProgressionCoordinate j z) =
      (δ ^ 2 : ℝ) * ∑' n : ℤ × ℤ, w (δ * n.1, δ * n.2 - δ * n.1) *
        ∫ u in Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1, ∏ j : Fin 4,
          f j (δ * (((1 - (j : ℝ)) * n.1 + j * n.2) + ((1 - (j : ℝ)) * u.1 + j * u.2))) := by
  set F : ℝ × ℝ → ℂ := fun z =>
    latticeSampledKernel δ w z * ∏ j, f j (realProgressionCoordinate j z)
  set g : ℝ × ℝ → ℂ := fun y => F (y.1, y.2 - y.1)
  have hS : MeasurePreserving (MeasurableEquiv.shearAddRight ℝ) (volume : Measure (ℝ × ℝ))
      volume := by
    rw [Measure.volume_eq_prod]
    exact measurePreserving_prod_add volume volume
  have hgF : ∀ z, g (MeasurableEquiv.shearAddRight ℝ z) = F z := by
    intro z; simp [g, MeasurableEquiv.shearAddRight]
  have h1 : ∫ z, F z = ∫ y, g y := by
    rw [← hS.integral_comp' g]; simp_rw [hgF]
  have hgi : Integrable g := by
    have hc : Integrable (g ∘ MeasurableEquiv.shearAddRight ℝ) := by
      convert hF using 1; funext z; exact hgF z
    exact (hS.integrable_comp_emb (MeasurableEquiv.shearAddRight ℝ).measurableEmbedding).mp hc
  rw [h1, lattice_integral_decomposition hgi hδ]
  congr 1
  refine tsum_congr fun n => ?_
  rw [← integral_const_mul]
  refine setIntegral_congr_fun (measurableSet_Ico.prod measurableSet_Ico) fun u hu => ?_
  obtain ⟨⟨hu1, hu2⟩, hv1, hv2⟩ := hu
  have hfl1 : ⌊(δ * (n.1 + u.1)) / δ⌋ = n.1 := by
    rw [mul_div_cancel_left₀ _ hδ.ne', Int.floor_eq_iff]; constructor <;> linarith
  have hfl2 : ⌊(δ * (n.1 + u.1) + (δ * (n.2 + u.2) - δ * (n.1 + u.1))) / δ⌋ = n.2 := by
    rw [show δ * (n.1 + u.1) + (δ * (n.2 + u.2) - δ * (n.1 + u.1)) = δ * (n.2 + u.2) by ring,
      mul_div_cancel_left₀ _ hδ.ne', Int.floor_eq_iff]
    constructor <;> linarith
  simp only [g, F, latticeSampledKernel, hfl1, hfl2]
  congr 1
  refine Finset.prod_congr rfl fun j _ => ?_
  congr 1
  simp only [realProgressionCoordinate]
  ring

/-! ### Window masses (lem:shortblock, blueprint lines 2328-2332) -/

section WindowMass

variable {ι : Type*} (S : Finset ι) (aL lL : ι → ℝ)

/-- The leaf interval `[a_i, a_i + l_i)`. -/
def leafInterval (i : ι) : Set ℝ := Set.Ico (aL i) (aL i + lL i)

variable {S aL lL}

/-- The selected leaf union `E = ⋃_{i ∈ S} L_i`. -/
def leafUnion (S : Finset ι) (aL lL : ι → ℝ) : Set ℝ := ⋃ i ∈ S, leafInterval aL lL i

theorem leafUnion_measurableSet : MeasurableSet (leafUnion S aL lL) :=
  Finset.measurableSet_biUnion _ fun _ _ => measurableSet_Ico

open Classical in
/-- The mass of `z` on the leaves meeting a set `W` is at most the total length of those leaves. -/
theorem leaf_mass_le (hdis : (S : Set ι).PairwiseDisjoint (leafInterval aL lL))
    (z : ℝ → ℂ) (hz : ∀ i ∈ S, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (lL i))
    (W : Set ℝ) :
    ∫⁻ x in W ∩ leafUnion S aL lL, ‖z x‖ₑ ^ 2 ≤
      volume (⋃ i ∈ S.filter fun i => (W ∩ leafInterval aL lL i).Nonempty,
        leafInterval aL lL i) := by
  classical
  set T := S.filter fun i => (W ∩ leafInterval aL lL i).Nonempty
  have hsub : W ∩ leafUnion S aL lL ⊆ ⋃ i ∈ T, leafInterval aL lL i := by
    rintro x ⟨hxW, hxE⟩
    simp only [leafUnion, Set.mem_iUnion] at hxE
    obtain ⟨i, hi, hx⟩ := hxE
    exact Set.mem_biUnion (Finset.mem_filter.mpr ⟨hi, x, hxW, hx⟩) hx
  have hdisT : (T : Set ι).PairwiseDisjoint (leafInterval aL lL) :=
    hdis.subset (by intro i hi; exact (Finset.mem_filter.mp hi).1)
  calc ∫⁻ x in W ∩ leafUnion S aL lL, ‖z x‖ₑ ^ 2
      ≤ ∫⁻ x in ⋃ i ∈ T, leafInterval aL lL i, ‖z x‖ₑ ^ 2 := lintegral_mono_set hsub
    _ = ∑ i ∈ T, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 :=
        lintegral_biUnion_finset hdisT (fun _ _ => measurableSet_Ico) _
    _ ≤ ∑ i ∈ T, volume (leafInterval aL lL i) := by
        refine Finset.sum_le_sum fun i hi => (hz i (Finset.mem_filter.mp hi).1).trans ?_
        simp [leafInterval, Real.volume_Ico]
    _ = volume (⋃ i ∈ T, leafInterval aL lL i) :=
        (measure_biUnion_finset hdisT (fun _ _ => measurableSet_Ico)).symm

/-- Blueprint line 2331 (total mass): `∫_E |z|² ≤ |E|`. -/
theorem leafUnion_mass_le (hdis : (S : Set ι).PairwiseDisjoint (leafInterval aL lL))
    (z : ℝ → ℂ) (hz : ∀ i ∈ S, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (lL i)) :
    ∫⁻ x in leafUnion S aL lL, ‖z x‖ₑ ^ 2 ≤ volume (leafUnion S aL lL) := by
  have h := leaf_mass_le hdis z hz Set.univ
  rw [Set.univ_inter] at h
  refine h.trans (measure_mono ?_)
  intro x hx
  simp only [Set.mem_iUnion, Finset.mem_filter] at hx
  obtain ⟨i, ⟨hi, -⟩, hx⟩ := hx
  exact Set.mem_biUnion hi hx

/-- Blueprint lines 2332-2333 (regular slots): leaves of length at most `ρ` meeting an interval
window of length `ℓ` carry mass at most `ℓ + 2ρ`. -/
theorem leaf_window_mass_le (hdis : (S : Set ι).PairwiseDisjoint (leafInterval aL lL))
    (z : ℝ → ℂ) (hz : ∀ i ∈ S, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (lL i))
    {ρ : ℝ} (hρ : ∀ i ∈ S, lL i ≤ ρ) (x₀ ℓ : ℝ) :
    ∫⁻ x in Set.Ico x₀ (x₀ + ℓ) ∩ leafUnion S aL lL, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (ℓ + 2 * ρ) := by
  refine (leaf_mass_le hdis z hz _).trans ?_
  calc _ ≤ volume (Set.Ico (x₀ - ρ) (x₀ + ℓ + ρ)) := by
        apply measure_mono
        intro x hx
        simp only [Set.mem_iUnion, Finset.mem_filter] at hx
        obtain ⟨i, ⟨hi, y, hyW, hyL⟩, hx⟩ := hx
        simp only [leafInterval, Set.mem_Ico] at hyW hyL hx ⊢
        have := hρ i hi
        constructor <;> linarith
    _ = _ := by rw [Real.volume_Ico]; congr 1; ring

/-- Blueprint line 2334 (local bound): if every leaf meeting a set `I` lies inside `I`, the mass
on `I` is at most `|I|`. -/
theorem leaf_local_mass_le (hdis : (S : Set ι).PairwiseDisjoint (leafInterval aL lL))
    (z : ℝ → ℂ) (hz : ∀ i ∈ S, ∫⁻ x in leafInterval aL lL i, ‖z x‖ₑ ^ 2 ≤ ENNReal.ofReal (lL i))
    (I : Set ℝ) (hI : ∀ i ∈ S, (I ∩ leafInterval aL lL i).Nonempty → leafInterval aL lL i ⊆ I) :
    ∫⁻ x in I ∩ leafUnion S aL lL, ‖z x‖ₑ ^ 2 ≤ volume I := by
  refine (leaf_mass_le hdis z hz I).trans (measure_mono ?_)
  intro x hx
  simp only [Set.mem_iUnion, Finset.mem_filter] at hx
  obtain ⟨i, ⟨hi, hne⟩, hx⟩ := hx
  exact hI i hi hne hx

end WindowMass

/-- The `δ`-windows `[δ(n + c), δ(n + c + 1))`, `n ∈ ℤ`, tile the line: for every shift `c`,
`Σ_n ∫_{window n} g = ∫ g`. -/
theorem lintegral_window_tiling {δ : ℝ} (hδ : 0 < δ) (c : ℝ) (g : ℝ → ℝ≥0∞) :
    ∑' n : ℤ, ∫⁻ x in Set.Ico (δ * (n + c)) (δ * (n + c + 1)), g x = ∫⁻ x, g x := by
  have hdis : Pairwise (Function.onFun Disjoint
      fun n : ℤ => Set.Ico (δ * (n + c)) (δ * (n + c + 1))) := by
    intro n m hnm
    refine Set.disjoint_left.mpr fun x hx hx' => hnm ?_
    simp only [Set.mem_Ico] at hx hx'
    have h1 : (n : ℝ) < m + 1 := by nlinarith
    have h2 : (m : ℝ) < n + 1 := by nlinarith
    have h1' : n < m + 1 := by exact_mod_cast h1
    have h2' : m < n + 1 := by exact_mod_cast h2
    omega
  have hcov : (⋃ n : ℤ, Set.Ico (δ * (n + c)) (δ * (n + c + 1))) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_univ, iff_true, Set.mem_Ico]
    refine ⟨⌊x / δ - c⌋, ?_, ?_⟩
    · have := Int.floor_le (x / δ - c)
      have h : δ * (⌊x / δ - c⌋ + c) ≤ δ * (x / δ) := by
        apply mul_le_mul_of_nonneg_left (by linarith) hδ.le
      rwa [mul_div_cancel₀ _ hδ.ne'] at h
    · have := Int.lt_floor_add_one (x / δ - c)
      have h : δ * (x / δ) < δ * (⌊x / δ - c⌋ + c + 1) := by
        apply mul_lt_mul_of_pos_left (by linarith) hδ
      rwa [mul_div_cancel₀ _ hδ.ne'] at h
  rw [← lintegral_iUnion (fun _ => measurableSet_Ico) hdis, hcov, Measure.restrict_univ]

/-- Windows of `K` consecutive unit lengths cover every point `K` times:
`Σ_n ∫_{[δ(n+c), δ(n+c+K))} g = K ∫ g` (the lift intervals in slots `2, 3`). -/
theorem lintegral_window_sum (K : ℕ) {δ : ℝ} (hδ : 0 < δ) (c : ℝ) (g : ℝ → ℝ≥0∞) :
    ∑' n : ℤ, ∫⁻ x in Set.Ico (δ * (n + c)) (δ * (n + c + K)), g x = K * ∫⁻ x, g x := by
  induction K with
  | zero => simp
  | succ K ih =>
    have hsplit : ∀ n : ℤ, ∫⁻ x in Set.Ico (δ * (n + c)) (δ * (n + c + (K + 1 : ℕ))), g x =
        (∫⁻ x in Set.Ico (δ * (n + c)) (δ * (n + c + K)), g x) +
          ∫⁻ x in Set.Ico (δ * (n + (c + K))) (δ * (n + (c + K) + 1)), g x := by
      intro n
      rw [← lintegral_union measurableSet_Ico]
      · congr 2
        rw [show δ * ((n : ℝ) + (c + K)) = δ * (n + c + K) by ring,
          show δ * ((n : ℝ) + (c + K) + 1) = δ * (n + c + ((K + 1 : ℕ) : ℝ)) by push_cast; ring,
          Set.Ico_union_Ico_eq_Ico]
        · apply mul_le_mul_of_nonneg_left _ hδ.le
          have := (Nat.cast_nonneg K : (0 : ℝ) ≤ K)
          linarith
        · apply mul_le_mul_of_nonneg_left _ hδ.le
          push_cast; linarith
      · rw [show δ * (n + (c + K)) = δ * (n + c + K) by ring]
        exact Set.Ico_disjoint_Ico_same
    simp_rw [hsplit]
    rw [ENNReal.tsum_add, ih, lintegral_window_tiling hδ]
    push_cast; ring

/-! ### The mixed lattice-torus absolute estimate (lem:shortblock, blueprint lines 2307-2340) -/

section FastTorus

/-- The fast circle `T₀ = ℝ / 16ℤ` of blueprint line 2303. -/
abbrev FastCircle := AddCircle (16 : ℝ)

instance : Fact ((0 : ℝ) < 16) := ⟨by norm_num⟩

/-- Normalized Haar measure on the fast circle. -/
noncomputable abbrev fastHaar : Measure FastCircle := AddCircle.haarAddCircle

/-- The progression coordinate `w_j = (1 - j) u + j v` as a homomorphism `T₀² → T₀`. -/
def fastCoord (j : ℤ) : FastCircle × FastCircle →+ FastCircle where
  toFun x := (1 - j) • x.1 + j • x.2
  map_zero' := by simp
  map_add' x y := by simp only [Prod.fst_add, Prod.snd_add, smul_add]; abel

theorem continuous_fastCoord (j : ℤ) : Continuous (fastCoord j) := by
  change Continuous fun x : FastCircle × FastCircle => (1 - j) • x.1 + j • x.2
  fun_prop

theorem fastCoord_surjective (j : ℤ) : Function.Surjective (fastCoord j) := by
  intro x
  refine ⟨(x, x), ?_⟩
  change (1 - j) • x + j • x = x
  rw [← add_smul]; simp

/-- Two distinct progression coordinates `(w_i, w_j)` as a homomorphism `T₀² → T₀²`. -/
def fastPair (i j : ℤ) : FastCircle × FastCircle →+ FastCircle × FastCircle :=
  (fastCoord i).prod (fastCoord j)

theorem fastPair_surjective {i j : ℤ} (hij : i ≠ j) : Function.Surjective (fastPair i j) := by
  rintro ⟨x, y⟩
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk_surjective x
  obtain ⟨b, rfl⟩ := QuotientAddGroup.mk_surjective y
  have hd : ((j : ℝ) - i) ≠ 0 := sub_ne_zero.mpr (by exact_mod_cast hij.symm)
  set u : ℝ := (j * a - i * b) / (j - i)
  set v : ℝ := ((1 - i) * b - (1 - j) * a) / (j - i)
  refine ⟨((u : FastCircle), (v : FastCircle)), ?_⟩
  have h1 : (1 - (i : ℝ)) * u + i * v = a := by
    simp only [u, v]; field_simp; ring
  have h2 : (1 - (j : ℝ)) * u + j * v = b := by
    simp only [u, v]; field_simp; ring
  change ((1 - i) • (u : FastCircle) + i • (v : FastCircle),
    (1 - j) • (u : FastCircle) + j • (v : FastCircle)) = ((a : FastCircle), (b : FastCircle))
  simp only [← AddCircle.coe_zsmul, zsmul_eq_mul, ← AddCircle.coe_add]
  push_cast
  rw [h1, h2]

instance : IsProbabilityMeasure (fastHaar.prod fastHaar) := inferInstance

theorem map_fastCoord : Measure.map (fastCoord j) (fastHaar.prod fastHaar) = fastHaar := by
  have : Measure.IsAddHaarMeasure (Measure.map (fastCoord j) (fastHaar.prod fastHaar)) :=
    Measure.isAddHaarMeasure_map_of_isFiniteMeasure _ (fastCoord j) (continuous_fastCoord j)
      (fastCoord_surjective j)
  have : IsProbabilityMeasure (Measure.map (fastCoord j) (fastHaar.prod fastHaar)) :=
    ⟨by rw [Measure.map_apply (continuous_fastCoord j).measurable MeasurableSet.univ]; simp⟩
  exact Measure.isAddHaarMeasure_eq_of_isProbabilityMeasure _ _

theorem map_fastPair {i j : ℤ} (hij : i ≠ j) :
    Measure.map (fastPair i j) (fastHaar.prod fastHaar) = fastHaar.prod fastHaar := by
  have hc : Continuous (fastPair i j) :=
    (continuous_fastCoord i).prodMk (continuous_fastCoord j)
  have : Measure.IsAddHaarMeasure (Measure.map (fastPair i j) (fastHaar.prod fastHaar)) :=
    Measure.isAddHaarMeasure_map_of_isFiniteMeasure _ (fastPair i j) hc (fastPair_surjective hij)
  have : IsProbabilityMeasure (Measure.map (fastPair i j) (fastHaar.prod fastHaar)) :=
    ⟨by rw [Measure.map_apply hc.measurable MeasurableSet.univ]; simp⟩
  exact Measure.isAddHaarMeasure_eq_of_isProbabilityMeasure _ _

/-- The single progression coordinate pushes Haar measure on `T₀²` to Haar measure on `T₀`. -/
theorem lintegral_fastCoord (j : ℤ) {f : FastCircle → ℝ≥0∞} (hf : Measurable f) :
    ∫⁻ x, f (fastCoord j x) ∂(fastHaar.prod fastHaar) = ∫⁻ t, f t ∂fastHaar := by
  rw [← lintegral_map hf (continuous_fastCoord j).measurable, map_fastCoord]

/-- Blueprint line 394 (torus pair endpoint): two distinct progression coordinates are
independent: `∫∫ f(w_i) g(w_j) = ∫ f ∫ g`. -/
theorem lintegral_fastPair {i j : ℤ} (hij : i ≠ j) {f g : FastCircle → ℝ≥0∞}
    (hf : Measurable f) (hg : Measurable g) :
    ∫⁻ x, f (fastCoord i x) * g (fastCoord j x) ∂(fastHaar.prod fastHaar) =
      (∫⁻ t, f t ∂fastHaar) * ∫⁻ t, g t ∂fastHaar := by
  have hc : Continuous (fastPair i j) :=
    (continuous_fastCoord i).prodMk (continuous_fastCoord j)
  have hm : Measurable fun y : FastCircle × FastCircle => f y.1 * g y.2 :=
    (hf.comp measurable_fst).mul (hg.comp measurable_snd)
  have := lintegral_map hm hc.measurable (μ := fastHaar.prod fastHaar)
  rw [map_fastPair hij] at this
  rw [lintegral_prod_mul hf.aemeasurable hg.aemeasurable] at this
  exact this.symm

end FastTorus

/-- The slow progression coordinate `n_j = (1 - j) n₀ + j n₁`. -/
def latticeCoord (j : ℤ) (n : ℤ × ℤ) : ℤ := (1 - j) * n.1 + j * n.2

theorem latticeCoord_pair_injective {i j : ℤ} (hij : i ≠ j) :
    Function.Injective fun n : ℤ × ℤ => (latticeCoord i n, latticeCoord j n) := by
  intro n n' h
  simp only [latticeCoord, Prod.mk.injEq] at h
  obtain ⟨h1, h2⟩ := h
  have hd : (j - i) * (n.2 - n.1 - (n'.2 - n'.1)) = 0 := by linear_combination h2 - h1
  rcases mul_eq_zero.mp hd with h | h
  · exact absurd (by linarith : i = j) hij
  · have e : n.2 - n.1 = n'.2 - n'.1 := by linarith
    have e1 : n.1 = n'.1 := by
      have : n.1 + i * (n.2 - n.1) = n'.1 + i * (n'.2 - n'.1) := by linarith
      rw [e] at this; linarith
    exact Prod.ext e1 (by linarith)

/-- The mixed measure: weight `ε²` on the slow pairs in `B`, normalized Haar measure on `T₀²`. -/
noncomputable def latticeTorusMeasure (B : Finset (ℤ × ℤ)) (ε : ℝ≥0∞) :
    Measure ((ℤ × ℤ) × (FastCircle × FastCircle)) :=
  (∑ n ∈ B, ε ^ 2 • Measure.dirac n).prod (fastHaar.prod fastHaar)

/-- The target measure: weight `ε` on each slow point, normalized Haar measure on `T₀`. -/
noncomputable def latticeCircleMeasure (ε : ℝ≥0∞) : Measure (ℤ × FastCircle) :=
  (ε • Measure.count).prod fastHaar

/-- The progression map `(n, u, v) ↦ (n_j, w_j)`. -/
def latticeTorusProj (j : ℤ) (x : (ℤ × ℤ) × (FastCircle × FastCircle)) : ℤ × FastCircle :=
  (latticeCoord j x.1, fastCoord j x.2)

theorem measurable_latticeTorusProj (j : ℤ) : Measurable (latticeTorusProj j) :=
  ((measurable_of_countable (latticeCoord j)).comp measurable_fst).prodMk
    ((continuous_fastCoord j).measurable.comp measurable_snd)

theorem lintegral_latticeTorusMeasure (B : Finset (ℤ × ℤ)) (ε : ℝ≥0∞)
    {F : (ℤ × ℤ) × (FastCircle × FastCircle) → ℝ≥0∞} (hF : Measurable F) :
    ∫⁻ x, F x ∂latticeTorusMeasure B ε =
      ∑ n ∈ B, ε ^ 2 * ∫⁻ w, F (n, w) ∂(fastHaar.prod fastHaar) := by
  rw [latticeTorusMeasure, lintegral_prod _ hF.aemeasurable, lintegral_finsetSum_measure]
  refine Finset.sum_congr rfl fun n _ => ?_
  rw [lintegral_smul_measure, lintegral_dirac' _ (measurable_of_countable _)]
  rfl

theorem lintegral_latticeCircleMeasure (ε : ℝ≥0∞) {f : ℤ × FastCircle → ℝ≥0∞}
    (hf : Measurable f) :
    ∫⁻ y, f y ∂latticeCircleMeasure ε = ε * ∑' m, ∫⁻ t, f (m, t) ∂fastHaar := by
  rw [latticeCircleMeasure, lintegral_prod _ hf.aemeasurable, lintegral_smul_measure,
    lintegral_count, smul_eq_mul]

/-- Total mass of the mixed lattice-torus measure. -/
theorem latticeTorus_empty (B : Finset (ℤ × ℤ)) {ε C : ℝ≥0∞} (hB : ε ^ 2 * B.card ≤ C) :
    latticeTorusMeasure B ε Set.univ ≤ C := by
  rw [latticeTorusMeasure, ← Set.univ_prod_univ, Measure.prod_prod]
  simp only [Measure.coe_finsetSum, Finset.sum_apply, Measure.smul_apply,
    Measure.dirac_apply_of_mem (Set.mem_univ _), smul_eq_mul, mul_one, measure_univ,
    Finset.sum_const, nsmul_eq_mul]
  rw [mul_comm]; exact hB

/-- The single-coordinate endpoint of the mixed absolute estimate. -/
theorem latticeTorus_single (B : Finset (ℤ × ℤ)) {ε M C : ℝ≥0∞} (hM : ε * M ≤ C)
    (hfib : ∀ j : Fin 4, ∀ m, ((B.filter fun n => latticeCoord j n = m).card : ℝ≥0∞) ≤ M)
    (i : Fin 4) (g : ℤ × FastCircle → ℝ≥0∞) (hg : Measurable g) :
    ∫⁻ x, g (latticeTorusProj i x) ∂latticeTorusMeasure B ε ≤
      C * ∫⁻ y, g y ∂latticeCircleMeasure ε := by
  classical
  rw [lintegral_latticeTorusMeasure B ε (F := fun x => g (latticeTorusProj i x))
    (hg.comp (measurable_latticeTorusProj i)),
    lintegral_latticeCircleMeasure ε hg]
  set F : ℤ → ℝ≥0∞ := fun m => ∫⁻ t, g (m, t) ∂fastHaar
  have hF : ∀ n, ∫⁻ w, g (latticeTorusProj i (n, w)) ∂(fastHaar.prod fastHaar) =
      F (latticeCoord i n) := fun n =>
    lintegral_fastCoord i (f := fun t => g (latticeCoord i n, t))
      (hg.comp measurable_prodMk_left)
  simp_rw [hF]
  have hfw : ∑ n ∈ B, ε ^ 2 * F (latticeCoord i n) ≤ ε ^ 2 * (M * ∑' m, F m) := by
    rw [← Finset.mul_sum]
    gcongr
    rw [← Finset.sum_fiberwise_of_maps_to (g := latticeCoord i) (t := B.image (latticeCoord i))
      (fun n hn => Finset.mem_image_of_mem _ hn)]
    calc ∑ m ∈ B.image (latticeCoord i), ∑ n ∈ B with latticeCoord i n = m,
          F (latticeCoord i n) = ∑ m ∈ B.image (latticeCoord i),
            ((B.filter fun n => latticeCoord i n = m).card : ℝ≥0∞) * F m := by
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [Finset.sum_congr rfl fun n hn => by rw [(Finset.mem_filter.mp hn).2],
            Finset.sum_const, nsmul_eq_mul]
      _ ≤ ∑ m ∈ B.image (latticeCoord i), M * F m :=
          Finset.sum_le_sum fun m _ => by gcongr; exact hfib i m
      _ = M * ∑ m ∈ B.image (latticeCoord i), F m := by rw [Finset.mul_sum]
      _ ≤ M * ∑' m, F m := by gcongr; exact ENNReal.sum_le_tsum _
  refine hfw.trans ?_
  calc ε ^ 2 * (M * ∑' m, F m) = (ε * M) * (ε * ∑' m, F m) := by ring
    _ ≤ C * (ε * ∑' m, F m) := by gcongr

/-- The pair endpoint of the mixed absolute estimate. -/
theorem latticeTorus_pair (B : Finset (ℤ × ℤ)) {ε C : ℝ≥0∞} (hC1 : 1 ≤ C) (i j : Fin 4)
    (hij : i ≠ j) (g h : ℤ × FastCircle → ℝ≥0∞) (hg : Measurable g) (hh : Measurable h) :
    ∫⁻ x, g (latticeTorusProj i x) * h (latticeTorusProj j x) ∂latticeTorusMeasure B ε ≤
      C * (∫⁻ y, g y ∂latticeCircleMeasure ε) * ∫⁻ y, h y ∂latticeCircleMeasure ε := by
  classical
  have hij' : (i : ℤ) ≠ j := fun e => hij (Fin.ext (by exact_mod_cast e))
  rw [lintegral_latticeTorusMeasure B ε
    (F := fun x => g (latticeTorusProj i x) * h (latticeTorusProj j x))
    ((hg.comp (measurable_latticeTorusProj i)).mul
    (hh.comp (measurable_latticeTorusProj j))), lintegral_latticeCircleMeasure ε hg,
    lintegral_latticeCircleMeasure ε hh]
  set F : ℤ → ℝ≥0∞ := fun m => ∫⁻ t, g (m, t) ∂fastHaar
  set G : ℤ → ℝ≥0∞ := fun m => ∫⁻ t, h (m, t) ∂fastHaar
  have hFG : ∀ n, ∫⁻ w, g (latticeTorusProj i (n, w)) * h (latticeTorusProj j (n, w))
      ∂(fastHaar.prod fastHaar) = F (latticeCoord i n) * G (latticeCoord j n) := fun n =>
    lintegral_fastPair hij' (f := fun t => g (latticeCoord i n, t))
      (g := fun t => h (latticeCoord j n, t)) (hg.comp measurable_prodMk_left)
      (hh.comp measurable_prodMk_left)
  simp_rw [hFG]
  set K : ℤ × ℤ → ℤ × ℤ := fun n => (latticeCoord i n, latticeCoord j n)
  have hK : Function.Injective K := latticeCoord_pair_injective hij'
  have hsum : ∑ n ∈ B, F (latticeCoord i n) * G (latticeCoord j n) ≤
      (∑' m, F m) * ∑' m, G m := by
    calc ∑ n ∈ B, F (latticeCoord i n) * G (latticeCoord j n) =
          ∑ p ∈ B.image K, F p.1 * G p.2 := by
          rw [Finset.sum_image fun x _ y _ e => hK e]
      _ ≤ ∑' p : ℤ × ℤ, F p.1 * G p.2 := ENNReal.sum_le_tsum _
      _ = (∑' m, F m) * ∑' m, G m := by
          rw [ENNReal.tsum_prod']
          simp_rw [ENNReal.tsum_mul_left]
          exact ENNReal.tsum_mul_right
  calc ∑ n ∈ B, ε ^ 2 * (F (latticeCoord i n) * G (latticeCoord j n))
      = ε ^ 2 * ∑ n ∈ B, F (latticeCoord i n) * G (latticeCoord j n) := by
        rw [Finset.mul_sum]
    _ ≤ ε ^ 2 * ((∑' m, F m) * ∑' m, G m) := by gcongr
    _ = 1 * (ε * ∑' m, F m) * (ε * ∑' m, G m) := by ring
    _ ≤ C * (ε * ∑' m, F m) * (ε * ∑' m, G m) := by gcongr

/-- Blueprint `eq:absolute` on local counting measure times Haar measure (lines 2307-2340): if
`ε² |B| ≤ C`, every fiber `{n ∈ B : n_j = m}` has at most `M` points with `ε M ≤ C`, and
`1 ≤ C`, then the positive progression form on the slow pairs `B` and the fast torus is at most
`C Π_j (∫ f_j)^{a_j}` for every exponent vector in the reciprocal polytope. -/
theorem latticeTorus_power_bound (B : Finset (ℤ × ℤ)) {ε M C : ℝ≥0∞} (hC1 : 1 ≤ C)
    (hB : ε ^ 2 * B.card ≤ C) (hM : ε * M ≤ C)
    (hfib : ∀ j : Fin 4, ∀ m, ((B.filter fun n => latticeCoord j n = m).card : ℝ≥0∞) ≤ M)
    (f : Fin 4 → ℤ × FastCircle → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    {a : Fin 4 → ℝ} (ha : a ∈ reciprocalExponentPolytope 4 2) :
    ∫⁻ x, ∏ i, f i (latticeTorusProj i x) ^ a i ∂latticeTorusMeasure B ε ≤
      C * ∏ i, (∫⁻ y, f i y ∂latticeCircleMeasure ε) ^ a i :=
  positivePairwise_power_bound (latticeTorusMeasure B ε) (latticeCircleMeasure ε)
    (fun i => latticeTorusProj i) (fun i => measurable_latticeTorusProj i) C
    (latticeTorus_empty B hB) (latticeTorus_single B hM hfib)
    (fun i j hij => latticeTorus_pair B hC1 i j hij) f hf ha

/-- `eq:absolute` on local counting measure times Haar measure, in normed form: for exponents
`p_j ≥ 1` with `Σ 1/p_j ≤ 2`, the positive form is at most `C Π_j ‖f_j‖_{L^{p_j}}`. -/
theorem latticeTorus_eLpNorm_bound (B : Finset (ℤ × ℤ)) {ε M C : ℝ≥0∞} (hC1 : 1 ≤ C)
    (hB : ε ^ 2 * B.card ≤ C) (hM : ε * M ≤ C)
    (hfib : ∀ j : Fin 4, ∀ m, ((B.filter fun n => latticeCoord j n = m).card : ℝ≥0∞) ≤ M)
    (f : Fin 4 → ℤ × FastCircle → ℝ≥0∞) (hf : ∀ i, Measurable (f i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2) :
    ∫⁻ x, ∏ i, f i (latticeTorusProj i x) ∂latticeTorusMeasure B ε ≤
      C * ∏ i, eLpNorm (f i) (p i) (latticeCircleMeasure ε) :=
  positivePairwise_eLpNorm_bound (latticeTorusMeasure B ε) (latticeCircleMeasure ε)
    (fun i => latticeTorusProj i) (fun i => measurable_latticeTorusProj i) C
    (latticeTorus_empty B hB) (latticeTorus_single B hM hfib)
    (fun i j hij => latticeTorus_pair B hC1 i j hij) f hf p hp hsum

/-- Blueprint line 2337 (Chebyshev on the deleted windows): for `A > 0`,
`Σ_{e(n) > A} e(n) ≤ A⁻¹ Σ e(n)²`. -/
theorem sum_large_le_sum_sq {ι : Type*} (S : Finset ι) (e : ι → ℝ) (he : ∀ n, 0 ≤ e n)
    {A : ℝ} (hA : 0 < A) :
    ∑ n ∈ S with A < e n, e n ≤ A⁻¹ * ∑ n ∈ S, e n ^ 2 := by
  classical
  calc ∑ n ∈ S with A < e n, e n ≤ ∑ n ∈ S with A < e n, A⁻¹ * e n ^ 2 := by
        refine Finset.sum_le_sum fun n hn => ?_
        have h := (Finset.mem_filter.mp hn).2
        rw [← div_eq_inv_mul, le_div_iff₀ hA, sq]
        exact mul_le_mul_of_nonneg_left h.le (he n)
    _ ≤ ∑ n ∈ S, A⁻¹ * e n ^ 2 :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
          fun n _ _ => by have := he n; positivity
    _ = A⁻¹ * ∑ n ∈ S, e n ^ 2 := by rw [Finset.mul_sum]

/-- Parseval for fast trigonometric sums on the circle of length `16`:
`(1/16) ∫₀¹⁶ |Σ_m a_m e(m w / 16)|² dw = Σ_m |a_m|²`. -/
theorem fast_parseval (s : Finset ℤ) (a : ℤ → ℂ) :
    (1 / 16) * ∫ w in (0 : ℝ)..16, ‖∑ m ∈ s, a m * ePhase (m * w / 16)‖ ^ 2 =
      ∑ m ∈ s, ‖a m‖ ^ 2 := by
  classical
  have hsq : ∀ w : ℝ, ((‖∑ m ∈ s, a m * ePhase (m * w / 16)‖ ^ 2 : ℝ) : ℂ) =
      ∑ m₁ ∈ s, ∑ m₂ ∈ s, a m₁ * (starRingEnd ℂ) (a m₂) *
        ePhase (((m₁ - m₂ : ℤ) : ℝ) * w / 16) := by
    intro w
    rw [Complex.ofReal_pow, ← Complex.mul_conj', map_sum, Finset.sum_mul_sum]
    refine Finset.sum_congr rfl fun m₁ _ => Finset.sum_congr rfl fun m₂ _ => ?_
    rw [map_mul, ePhase_conj]
    have : ePhase (m₁ * w / 16) * ePhase (-(m₂ * w / 16)) =
        ePhase (((m₁ - m₂ : ℤ) : ℝ) * w / 16) := by
      rw [ePhase_add]; congr 1; push_cast; ring
    rw [← this]; ring
  have hc : ∀ m₁ m₂ : ℤ, Continuous fun w : ℝ =>
      a m₁ * (starRingEnd ℂ) (a m₂) * ePhase (((m₁ - m₂ : ℤ) : ℝ) * w / 16) := by
    intro m₁ m₂; have := continuous_ePhase; fun_prop
  have hint : ((∫ w in (0 : ℝ)..16, ‖∑ m ∈ s, a m * ePhase (m * w / 16)‖ ^ 2 : ℝ) : ℂ) =
      16 * ∑ m ∈ s, ((‖a m‖ ^ 2 : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    simp_rw [hsq]
    rw [intervalIntegral.integral_finsetSum fun m₁ _ =>
      (continuous_finsetSum _ fun m₂ _ => hc m₁ m₂).intervalIntegrable _ _, Finset.mul_sum]
    refine Finset.sum_congr rfl fun m₁ hm₁ => ?_
    rw [intervalIntegral.integral_finsetSum fun m₂ _ => (hc m₁ m₂).intervalIntegrable _ _]
    simp_rw [intervalIntegral.integral_const_mul,
      integral_ePhase_int _ (by norm_num : (0 : ℝ) < 16)]
    rw [Finset.sum_eq_single m₁]
    · simp only [sub_self, ↓reduceIte]
      rw [Complex.mul_conj', ← Complex.ofReal_pow]
      push_cast; ring
    · intro m₂ _ hne
      have : m₁ - m₂ ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
      simp [this]
    · intro h; exact absurd hm₁ h
  have := congrArg Complex.re hint
  simp only [Complex.ofReal_re] at this
  rw [this]
  simp only [Complex.mul_re, Complex.re_ofNat, Complex.im_ofNat, zero_mul, sub_zero]
  rw [Complex.re_sum]
  simp only [Complex.ofReal_re]
  ring

/-- Blueprint line 2330 ("Minkowski and the sign moments"): if a random function `F^σ` on a
window satisfies the pointwise moment bound `(E|F^σ(w)|^a)^{1/a} ≤ C_a Z(w)` with `a ≥ 2`, then
`(E ‖F^σ‖₂^a)^{1/a} ≤ C_a ‖Z‖₂`. -/
theorem random_L2_moment {Ω T : Type*} [MeasurableSpace Ω] [MeasurableSpace T]
    (P : Measure Ω) [SigmaFinite P] (ν : Measure T) [SFinite ν] (F : Ω → T → ℂ)
    (hF : Measurable (Function.uncurry F)) {a : ℝ} (ha : 2 ≤ a) {Z : T → ℝ≥0∞}
    (hZ : Measurable Z) {Ca : ℝ≥0∞}
    (hmom : ∀ w, (∫⁻ σ, ‖F σ w‖ₑ ^ a ∂P) ^ (1 / a) ≤ Ca * Z w) :
    (∫⁻ σ, (∫⁻ w, ‖F σ w‖ₑ ^ (2 : ℝ) ∂ν) ^ (a / 2) ∂P) ^ (1 / a) ≤
      Ca * (∫⁻ w, Z w ^ (2 : ℝ) ∂ν) ^ (1 / 2 : ℝ) := by
  have ha0 : 0 < a := by linarith
  set g : Ω → T → ℝ≥0∞ := fun σ w => ‖F σ w‖ₑ ^ (2 : ℝ)
  have hg : Measurable (Function.uncurry g) := hF.enorm.pow_const _
  have hmink := lintegral_minkowski (μ := P) (ν := ν) (p := a / 2) (by linarith) hg
  have hinner : ∀ w, (∫⁻ σ, g σ w ^ (a / 2) ∂P) ^ (1 / (a / 2)) ≤ (Ca * Z w) ^ (2 : ℝ) := by
    intro w
    have e1 : ∀ σ, g σ w ^ (a / 2) = ‖F σ w‖ₑ ^ a := fun σ => by
      simp only [g]; rw [← ENNReal.rpow_mul]; congr 1; ring
    simp_rw [e1]
    calc (∫⁻ σ, ‖F σ w‖ₑ ^ a ∂P) ^ (1 / (a / 2)) =
          ((∫⁻ σ, ‖F σ w‖ₑ ^ a ∂P) ^ (1 / a)) ^ (2 : ℝ) := by
          rw [← ENNReal.rpow_mul]; congr 1; field_simp
      _ ≤ (Ca * Z w) ^ (2 : ℝ) := ENNReal.rpow_le_rpow (hmom w) (by norm_num)
  have h2 : (∫⁻ σ, (∫⁻ w, g σ w ∂ν) ^ (a / 2) ∂P) ^ (1 / (a / 2)) ≤
      Ca ^ (2 : ℝ) * ∫⁻ w, Z w ^ (2 : ℝ) ∂ν := by
    refine hmink.trans ((lintegral_mono hinner).trans (le_of_eq ?_))
    simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 2)]
    exact lintegral_const_mul _ (hZ.pow_const _)
  calc (∫⁻ σ, (∫⁻ w, ‖F σ w‖ₑ ^ (2 : ℝ) ∂ν) ^ (a / 2) ∂P) ^ (1 / a)
      = ((∫⁻ σ, (∫⁻ w, g σ w ∂ν) ^ (a / 2) ∂P) ^ (1 / (a / 2))) ^ (1 / 2 : ℝ) := by
        rw [← ENNReal.rpow_mul]; congr 1; field_simp
    _ ≤ (Ca ^ (2 : ℝ) * ∫⁻ w, Z w ^ (2 : ℝ) ∂ν) ^ (1 / 2 : ℝ) :=
        ENNReal.rpow_le_rpow h2 (by norm_num)
    _ = Ca * (∫⁻ w, Z w ^ (2 : ℝ) ∂ν) ^ (1 / 2 : ℝ) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ← ENNReal.rpow_mul]
        norm_num

/-- Blueprint lines 2336-2340 ("Hölder in the random variables"): averaging the mixed absolute
estimate over a random parameter `ω ∈ (Ω, P)` and applying Hölder with four `L⁴(P)` factors,
`E ∫ Π_j g_j^ω(n_j, w_j) ≤ C Π_j (E ‖g_j^ω‖_{L^{p_j}}⁴)^{1/4}`. -/
theorem latticeTorus_random_holder (B : Finset (ℤ × ℤ)) {ε M C : ℝ≥0∞} (hC1 : 1 ≤ C)
    (hB : ε ^ 2 * B.card ≤ C) (hM : ε * M ≤ C)
    (hfib : ∀ j : Fin 4, ∀ m, ((B.filter fun n => latticeCoord j n = m).card : ℝ≥0∞) ≤ M)
    {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    (g : Ω → Fin 4 → ℤ × FastCircle → ℝ≥0∞) (hg : ∀ ω i, Measurable (g ω i))
    (p : Fin 4 → ℝ≥0∞) (hp : ∀ i, 1 ≤ p i) (hsum : ∑ i, (p i).toReal⁻¹ ≤ 2)
    (hgm : ∀ i, AEMeasurable (fun ω => eLpNorm (g ω i) (p i) (latticeCircleMeasure ε)) P) :
    ∫⁻ ω, ∫⁻ x, ∏ i, g ω i (latticeTorusProj i x) ∂latticeTorusMeasure B ε ∂P ≤
      C * ∏ i, (∫⁻ ω, eLpNorm (g ω i) (p i) (latticeCircleMeasure ε) ^ (4 : ℝ) ∂P) ^
        (1 / 4 : ℝ) := by
  set X : Fin 4 → Ω → ℝ≥0∞ := fun i ω => eLpNorm (g ω i) (p i) (latticeCircleMeasure ε)
  calc ∫⁻ ω, ∫⁻ x, ∏ i, g ω i (latticeTorusProj i x) ∂latticeTorusMeasure B ε ∂P
      ≤ ∫⁻ ω, C * ∏ i, X i ω ∂P := lintegral_mono fun ω =>
        latticeTorus_eLpNorm_bound B hC1 hB hM hfib (g ω) (hg ω) p hp hsum
    _ = C * ∫⁻ ω, ∏ i, X i ω ∂P := lintegral_const_mul'' _
        (Finset.aemeasurable_fun_prod _ fun i _ => hgm i)
    _ ≤ C * ∏ i, (∫⁻ ω, X i ω ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
        gcongr
        have h := ENNReal.lintegral_prod_norm_pow_le (μ := P) Finset.univ
          (f := fun i ω => X i ω ^ (4 : ℝ)) (fun i _ => (hgm i).pow_const _)
          (p := fun _ => (1 / 4 : ℝ)) (by simp) (fun _ _ => by norm_num)
        refine le_trans (le_of_eq ?_) h
        congr 1; funext ω
        refine Finset.prod_congr rfl fun i _ => ?_
        rw [← ENNReal.rpow_mul]; norm_num

/-- Cauchy–Schwarz on the normalized fast circle: `∫ h ≤ (∫ h²)^{1/2}`. -/
theorem lintegral_fastHaar_le_sqrt {h : FastCircle → ℝ≥0∞} (hh : Measurable h) :
    ∫⁻ t, h t ∂fastHaar ≤ (∫⁻ t, h t ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ) := by
  have := ENNReal.lintegral_mul_le_Lp_mul_Lq fastHaar (Real.HolderConjugate.two_two)
    hh.aemeasurable (aemeasurable_const (b := (1 : ℝ≥0∞)))
  simpa using this

/-- Blueprint lines 2336-2337 (the heavy slot, "unitarity and Minkowski"): the `L⁴(P)` norm of
the local `L¹` norm is at most `ε Σ_m (E ‖g(m, ·)‖₂⁴)^{1/4}`. -/
theorem heavy_slot_L4_le (ε : ℝ≥0∞) {Ω : Type*} [MeasurableSpace Ω] (P : Measure Ω)
    [SigmaFinite P] (g : Ω → ℤ × FastCircle → ℝ≥0∞) (hg : Measurable (Function.uncurry g)) :
    (∫⁻ ω, (∫⁻ y, g ω y ∂latticeCircleMeasure ε) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ε * ∑' m : ℤ, (∫⁻ ω, ((∫⁻ t, g ω (m, t) ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ)) ^ (4 : ℝ) ∂P) ^
        (1 / 4 : ℝ) := by
  have hgω : ∀ ω, Measurable (g ω) := fun ω => hg.comp (measurable_const.prodMk measurable_id)
  set h : Ω → ℤ → ℝ≥0∞ := fun ω m => (∫⁻ t, g ω (m, t) ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ)
  have hhm : Measurable (Function.uncurry h) := by
    apply measurable_from_prod_countable_left
    intro m
    have : Measurable fun p : Ω × FastCircle => g p.1 (m, p.2) ^ (2 : ℝ) :=
      (hg.comp (measurable_fst.prodMk (measurable_const.prodMk measurable_snd))).pow_const _
    exact (this.lintegral_prod_right').pow_const _
  have hpt : ∀ ω, ∫⁻ y, g ω y ∂latticeCircleMeasure ε ≤ ε * ∑' m, h ω m := by
    intro ω
    rw [lintegral_latticeCircleMeasure ε (hgω ω)]
    gcongr with m
    exact lintegral_fastHaar_le_sqrt ((hgω ω).comp measurable_prodMk_left)
  calc (∫⁻ ω, (∫⁻ y, g ω y ∂latticeCircleMeasure ε) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ)
      ≤ (∫⁻ ω, (ε * ∑' m, h ω m) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
        gcongr with ω; exact hpt ω
    _ = ε * (∫⁻ ω, (∑' m, h ω m) ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
        simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 4)]
        have hm : Measurable fun ω => (∑' m, h ω m) ^ (4 : ℝ) :=
          (Measurable.tsum fun m =>
            hhm.comp (measurable_id.prodMk measurable_const)).pow_const _
        rw [lintegral_const_mul _ hm, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num),
          ← ENNReal.rpow_mul]
        norm_num
    _ ≤ ε * ∑' m, (∫⁻ ω, h ω m ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) := by
        gcongr
        have := lintegral_minkowski (μ := P) (ν := (Measure.count : Measure ℤ)) (p := 4)
