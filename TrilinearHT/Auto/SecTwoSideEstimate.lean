          ∫⁻ y in Set.Icc ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).left I)
            ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).left I +
              (T.rectData κ cells hcells kernel hker z hz zσ hzσ R).len I),
            ENNReal.ofReal ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).Z
              (DepthRect.heavy R) y) ^ (2 : ℝ)) +
      ENNReal.ofReal (256 / (volume (offsetPolygon (1 / 8))).toReal) *
        (ENNReal.ofReal (finiteDepthConstant κ q Nd) * ∏ j, ((if j = DepthRect.heavy R ∨
          j = DepthRect.desig R then Cs else Cd) * ((1 / 8 : ℝ≥0∞) *
          2 ^ (pexp q R j / 4) * ENNReal.ofReal C4 ^ pexp q R j *
            (if j = DepthRect.heavy R then ENNReal.ofReal ((K : ℝ) + 2)
