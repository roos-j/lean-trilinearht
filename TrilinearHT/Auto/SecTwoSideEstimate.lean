variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K)

/-- Below the separating depth, the heavy mask misses every internal cell. -/
theorem heavy_mask_disjoint {R : DepthRect} (hv : DepthRect.Valid R) {I : ℤ × ℤ}
    (hI : I ∈ T.internal) (hs : T.first + DepthRect.sep R ≤ I.1) {y : ℝ}
    (hyI : y ∈ dyadicGridCell G I.1 I.2) : y ∉ T.mask R (DepthRect.heavy R) := by
  classical
  intro hy
  simp only [mask, leafUnion, Set.mem_iUnion] at hy
  obtain ⟨L, hL, hyL⟩ := hy
  have hLl := (Finset.mem_filter.mp hL).1
  have hle := DepthRect.side_heavy_le hv (Finset.mem_filter.mp hL).2
  have hd := T.leaf_depth L hLl
  have hlt := T.internal_leaf I hI L hLl ⟨y, hyI, hyL⟩
  unfold depth at hle
  omega

end ShortBlockTree

namespace ShortBlockTree

variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K) (κ : LocalKernelClass)
  (cells : Finset (ℤ × ℤ)) (hcells : cells ⊆ T.internal) (kernel : ℤ × ℤ → ℝ × ℝ → ℂ)
  (hker : ∀ I ∈ T.internal, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
    (dyadicGridLength G I.1) (kernel I))
  {Ω : Type*} [MeasurableSpace Ω] {E : Type*} [NormedAddCommGroup E] (z : Fin 4 → ℝ → E)
  (hz : ∀ j, Measurable fun y => ‖z j y‖) (zσ : Fin 4 → Ω → ℝ → ℂ)
  (hzσ : ∀ j, Measurable (Function.uncurry (zσ j)))

/-- Blueprint lines 2290-2296 (the rectangle decomposition of the signed sum): for inputs in
`L²` on the root, `Σ_I |I| ε_I H_I(z^σ) = Σ_R Σ_{I : depth < t_R} |I| ε_I H_I(z^σ 1_{E_R})`. -/
theorem total_decomp {m : ℕ} (hm : K < 2 ^ m) (ε : ℤ × ℤ → Ω → ℂ) (σ : Ω)
    (hL2 : ∀ j, MemLp ((dyadicGridCell G T.root.1 T.root.2).indicator (zσ j σ)) 2 volume) :
    ∑ I ∈ cells, (dyadicGridLength G I.1 : ℂ) * ε I σ *
      localProgressionForm (dyadicGridLength G I.1) (kernel I) (fun j => zσ j σ) =
    ∑ R ∈ (DepthRect.upTo m).filter DepthRect.Valid,
      (T.rectData κ cells hcells kernel hker z hz zσ hzσ R).total ε σ := by
  classical
  set root := dyadicGridCell G T.root.1 T.root.2
  have hmeas : ∀ j, Measurable (zσ j σ) := fun j => by
    have h := (hzσ j).comp (measurable_prodMk_left (x := σ)); exact h
  set f : Fin 4 → ℝ → ℂ := fun j => root.indicator (zσ j σ)
  have hf : ∀ j, Measurable (f j) := fun j => (hmeas j).indicator
    (dyadicGridCell_measurable G _ _)
  have hcell : ∀ I ∈ cells, localProgressionForm (dyadicGridLength G I.1) (kernel I)
      (fun j => zσ j σ) = ∑ R ∈ (DepthRect.upTo m).filter DepthRect.Valid,
        localProgressionForm (dyadicGridLength G I.1) (kernel I)
          ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).inp σ) := by
    intro I hI
    have hIi := hcells hI
    have hw := hker I hIi
    have hsub := T.internal_subset I hIi
    rw [localProgressionForm_congr_support (f' := f) fun w hw' j => by
      simp only [f]; rw [Set.indicator_of_mem (hsub (admissible_coord_mem_cell hw hw' j))]]
    have hint := progression_integrable (dyadicGridLength_pos G I.1)
      (admissibleLocalKernel_support (dyadicGridLength_pos G I.1).le hw)
      hw.smooth.continuous.measurable (admissibleLocalKernel_norm_le hw) f hf hL2
    rw [localProgressionForm_rect_split m T.dep T.measurable_dep (T.dep_lt hm) _ _ f hint]
    refine Finset.sum_congr rfl fun R _ => localProgressionForm_congr_support fun w hw' j => ?_
    have hy := hsub (admissible_coord_mem_cell hw hw' j)
    change root.indicator (zσ j σ) (realProgressionCoordinate j w) *
        (if DepthRect.Side R j (T.dep (realProgressionCoordinate j w)) then 1 else 0) =
      zσ j σ (realProgressionCoordinate j w) *
        (T.mask R j).indicator 1 (realProgressionCoordinate j w)
    rw [Set.indicator_of_mem hy]
    by_cases hs : DepthRect.Side R j (T.dep (realProgressionCoordinate j w))
    · rw [ite_eq_left hs, Set.indicator_of_mem ((T.mem_mask_iff hy).mpr hs)]; simp
    · rw [ite_eq_right hs, Set.indicator_of_notMem (fun h => hs ((T.mem_mask_iff hy).mp h))]
  calc ∑ I ∈ cells, (dyadicGridLength G I.1 : ℂ) * ε I σ *
        localProgressionForm (dyadicGridLength G I.1) (kernel I) (fun j => zσ j σ)
      = ∑ I ∈ cells, ∑ R ∈ (DepthRect.upTo m).filter DepthRect.Valid,
          (dyadicGridLength G I.1 : ℂ) * ε I σ * localProgressionForm (dyadicGridLength G I.1)
            (kernel I) ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).inp σ) := by
        refine Finset.sum_congr rfl fun I hI => ?_
        rw [hcell I hI, Finset.mul_sum]
    _ = ∑ R ∈ (DepthRect.upTo m).filter DepthRect.Valid, ∑ I ∈ cells,
          (dyadicGridLength G I.1 : ℂ) * ε I σ * localProgressionForm (dyadicGridLength G I.1)
            (kernel I) ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).inp σ) :=
        Finset.sum_comm
    _ = _ := by
        refine Finset.sum_congr rfl fun R hR => ?_
        have hv := (Finset.mem_filter.mp hR).2
        change _ = ∑ I ∈ cells.filter fun I => I.1 < T.first + DepthRect.sep R,
          (dyadicGridLength G I.1 : ℂ) * ε I σ * localProgressionForm (dyadicGridLength G I.1)
            (kernel I) ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).inp σ)
        rw [Finset.sum_filter]
        refine Finset.sum_congr rfl fun I hI => ?_
        split_ifs with hs
        · rfl
        · push Not at hs
          rw [localProgressionForm_eq_zero_of_cell (hker I (hcells hI)) _ (DepthRect.heavy R)
            (fun y hy => ?_), mul_zero]
          simp only [rectData, BlockData.inp]
          rw [Set.indicator_of_notMem (T.heavy_mask_disjoint hv (hcells hI) hs hy), mul_zero]

end ShortBlockTree

/-- The heavy exponent `p_* = 2q - 2`. -/
def pStar (q : ℝ) : ℝ := 2 * q - 2

/-- The regular exponent `p = 2 p_* / (p_* - 2) = (2q - 2) / (q - 2)`. -/
noncomputable def pReg (q : ℝ) : ℝ := (2 * q - 2) / (q - 2)

theorem two_le_pStar {q : ℝ} (hq : 2 < q) : 2 ≤ pStar q := by unfold pStar; linarith

theorem two_le_pReg {q : ℝ} (hq : 2 < q) : 2 ≤ pReg q := by
  unfold pReg; rw [le_div_iff₀ (by linarith)]; linarith

theorem pStar_pReg_sum {q : ℝ} (hq : 2 < q) : 2 / pStar q + 2 / pReg q = 1 := by
  unfold pStar pReg
  have h1 : (2 * q - 2) ≠ 0 := by linarith
  have h2 : q - 2 ≠ 0 := by linarith
  rw [show 2 / ((2 * q - 2) / (q - 2)) = 2 * (q - 2) / (2 * q - 2) by field_simp,
    ← add_div, div_eq_one_iff_eq h1]
  ring

namespace ShortBlockTree

variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K) (κ : LocalKernelClass)
  (cells : Finset (ℤ × ℤ)) (hcells : cells ⊆ T.internal) (kernel : ℤ × ℤ → ℝ × ℝ → ℂ)
  (hker : ∀ I ∈ T.internal, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
    (dyadicGridLength G I.1) (kernel I))
  {Ω : Type*} [MeasurableSpace Ω] {E : Type*} [NormedAddCommGroup E] (z : Fin 4 → ℝ → E)
  (hz : ∀ j, Measurable fun y => ‖z j y‖) (zσ : Fin 4 → Ω → ℝ → ℂ)
  (hzσ : ∀ j, Measurable (Function.uncurry (zσ j)))

/-- The exponents of a rectangle: `p_*` in the heavy and designated slots, `p` elsewhere. -/
noncomputable def pexp (q : ℝ) (R : DepthRect) (j : Fin 4) : ℝ := by
  classical
  exact if j = DepthRect.heavy R ∨ j = DepthRect.desig R then pStar q else pReg q

theorem sum_inv_pexp {q : ℝ} (hq : 2 < q) {R : DepthRect} (hv : DepthRect.Valid R) :
    ∑ j, 1 / pexp q R j = 1 := by
  classical
  have hab := (DepthRect.desig_ne_heavy hv).symm
  have hite : ∀ j, 1 / pexp q R j = if j = DepthRect.heavy R ∨ j = DepthRect.desig R then
      1 / pStar q else 1 / pReg q := fun j => by unfold pexp; split_ifs <;> rfl
  simp_rw [hite]
  rw [Finset.sum_ite]
  have hc1 : (Finset.univ.filter fun j : Fin 4 =>
      j = DepthRect.heavy R ∨ j = DepthRect.desig R) =
        {DepthRect.heavy R, DepthRect.desig R} := by
    ext j; simp
  have hc2 : (Finset.univ.filter fun j : Fin 4 =>
      ¬(j = DepthRect.heavy R ∨ j = DepthRect.desig R)).card = 2 := by
    have := Finset.card_filter_add_card_filter_not (s := (Finset.univ : Finset (Fin 4)))
      (fun j : Fin 4 => j = DepthRect.heavy R ∨ j = DepthRect.desig R)
    rw [hc1, Finset.card_pair hab, Finset.card_univ, Fintype.card_fin] at this
    omega
  rw [hc1, Finset.sum_const, Finset.sum_const, Finset.card_pair hab, hc2]
  have := pStar_pReg_sum hq
  simp only [nsmul_eq_mul]; push_cast
  linarith [show (2 : ℝ) * (1 / pStar q) = 2 / pStar q by ring,
    show (2 : ℝ) * (1 / pReg q) = 2 / pReg q by ring]

end ShortBlockTree

