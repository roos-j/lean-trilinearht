      (fun z => ‖D.ginFam N w j z‖ₑ) ^ p ≤ ∑ m ∈ D.T, ENNReal.ofReal (D.δ / 4) *
        (2 * ‖w j m‖ₑ ^ 4 * (ENNReal.ofReal C4 * D.ewin j m) ^ (4 : ℝ)) ^ (p / 4) := by
  have h := mixedENorm_fastIntervalInput_pow ((P.prod gammaMeasure).prod fastHaar) D.δ_pos
    (by norm_num : (1 / 8 : ℝ) ≤ 1 / 2) D.T
    (fun m z => D.multWith N w z.1.2 z.1.1 j m z.2) hp
  have e : (fun z => ‖D.ginFam N w j z‖ₑ) = fun z => ‖fastIntervalInput D.δ (1 / 8) D.T
