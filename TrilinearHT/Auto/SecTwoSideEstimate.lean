its local `L⁴` norm. -/
theorem regular_slot_L3_le_L4 (ε : ℝ≥0∞) (S : Finset ℤ) {g : ℤ × FastCircle → ℝ≥0∞}
    (hg : Measurable g) (hS : ∀ y, y.1 ∉ S → g y = 0) :
