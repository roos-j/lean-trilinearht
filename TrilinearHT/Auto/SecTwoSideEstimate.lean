                  ∂gammaMeasure ∂P + ∫⁻ σ, ∫⁻ γ, ∫⁻ x, Ep ((σ, γ), x)
                    ∂(fastHaar.prod fastHaar) ∂gammaMeasure ∂P) := by
                have h1 : Measurable fun q : Ω × ℝ => ∫⁻ x, Hp (q, x) ∂(fastHaar.prod fastHaar) :=
                  hHp.lintegral_prod_right'
                have h2 : Measurable fun σ => ∫⁻ γ, ∫⁻ x, Hp ((σ, γ), x)
                    ∂(fastHaar.prod fastHaar) ∂gammaMeasure := by
                  have h := h1.lintegral_prod_right' (ν := gammaMeasure); exact h
                have h3 : ∀ σ, Measurable fun γ => ∫⁻ x, Hp ((σ, γ), x)
                    ∂(fastHaar.prod fastHaar) := fun σ => by
                  have h := h1.comp (measurable_prodMk_left (x := σ)); exact h
                have h4 : ∀ q : Ω × ℝ, Measurable fun x => Hp (q, x) :=
                  fun q => by have h := hHp.comp (measurable_prodMk_left (x := q)); exact h
                rw [← lintegral_add_left h2, ← lintegral_const_mul' _ _ hcne]
                refine lintegral_congr fun σ => ?_
                rw [← lintegral_add_left (h3 σ), ← lintegral_const_mul' _ _ hcne]
                refine lintegral_congr fun γ => ?_
                rw [lintegral_add_left (h4 (σ, γ))]
