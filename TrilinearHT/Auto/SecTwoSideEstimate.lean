namespace BlockData

variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

open Auto.ClassicalMaximal in
/-- `lem:shortblock` at one leaf-depth rectangle (blueprint lines 2298-2369): the expected signed
sum is at most the first and second sampling errors (`≲ m_a^{1/2} m_b^{1/2}`), the deletion error
(`≲ A⁻¹ Σ_I ∫_I Z_a²`) and the main term `C_N Π_j C_j (B_j^{p_j - 2} m_j)^{1/p_j}`. -/
theorem rect_bound (P : Measure Ω) [IsProbabilityMeasure P] {C4 E2 : ℝ} (hC4 : 0 ≤ C4)
    (hmom : ∀ j y, (∫⁻ σ, ‖D.z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ENNReal.ofReal (D.Z j y))
    (ε : ℤ × ℤ → Ω → ℂ) (hε : ∀ I, Measurable (ε I)) (hε1 : ∀ I σ, ‖ε I σ‖ ≤ 1)
    {a b : Fin 4} (hab : a ≠ b) (m : Fin 4 → ℝ)
    (hm : ∀ j, ∫⁻ y, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) ≤ ENNReal.ofReal (m j))
    (hloc : ∀ I ∈ D.cells, ∀ j, ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
      ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) ≤ ENNReal.ofReal (D.len I))
    (hw : ∑ s ∈ D.cells.image Prod.fst, D.δ / dyadicGridLength D.grid s ≤ 1)
    (hreg : ∀ j, j ≠ a → ∀ n, D.ewin j n ^ (2 : ℝ) ≤ ENNReal.ofReal E2)
    {A : ℝ} (hA : 0 < A) {q : ℝ} (hq : 2 ≤ q) {Nd : ℕ} (first : ℤ)
    (hdepth : ∀ I ∈ D.cells, first ≤ I.1 ∧ I.1 < first + Nd)
    (p : Fin 4 → ℝ) (hp : ∀ j, 2 ≤ p j) (hsum : ∑ j, 1 / p j = 1) (Cm : Fin 4 → ℝ≥0∞)
    (hCm : ∀ j, ∀ f : ℝ × ((Ω × ℝ) × FastCircle) → ℂ, Measurable f →
      mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (p j) 4 (maximalQ q f) ≤
        Cm j * mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (p j) 4
          (fun z => ‖f z‖ₑ))
    (B : Fin 4 → ℝ≥0∞)
    (hB : ∀ j n, ‖wRet a {m | D.ewin a m ≤ ENNReal.ofReal A} j n‖ₑ ≠ 0 → D.ewin j n ≤ B j) :
    ∫⁻ σ, ‖D.total ε σ‖ₑ ∂P ≤
      ENNReal.ofReal (4 * admissibleLipConst κ * C4 ^ 4) * ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) *
        ENNReal.ofReal (m b) ^ (1 / 2 : ℝ) +
      (4 * ENNReal.ofReal (256 * localKernelSupBound κ) * regConst C4 E2 ^ 3 *
        ENNReal.ofReal C4 * (ENNReal.ofReal A)⁻¹ * (∑ I ∈ D.cells,
          ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) +
      ENNReal.ofReal (256 / (volume (offsetPolygon (1 / 8))).toReal) *
        (ENNReal.ofReal (finiteDepthConstant κ q Nd) * ∏ j, (Cm j * ((1 / 8 : ℝ≥0∞) *
          2 ^ (p j / 4) * ENNReal.ofReal C4 ^ p j * B j ^ (p j - 2) * ENNReal.ofReal (m j)) ^
            (1 / p j)) +
        ENNReal.ofReal (4 * admissibleLipConst κ) * err2Const C4 ^ 2 *
          (ENNReal.ofReal (m a) ^ (1 / 2 : ℝ) * ENNReal.ofReal (m b) ^ (1 / 2 : ℝ)))) := by
  have hfin : ∀ j, ∫⁻ y, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) < ⊤ := fun j =>
    (hm j).trans_lt ENNReal.ofReal_lt_top
  have hsplit : ∀ᵐ σ ∂P, ‖D.total ε σ‖ₑ ≤
      ∑ I ∈ D.cells, ENNReal.ofReal (D.len I) * ‖D.err1 I σ‖ₑ +
        ‖D.latticeSum ε σ (slotLift D.δ (D.inp σ))‖ₑ := by
    filter_upwards [D.ae_memLp P hmom hfin] with σ hσ
    rw [D.total_eq ε σ hσ]
    refine (enorm_add_le _ _).trans (add_le_add ((enorm_sum_le _ _).trans
      (Finset.sum_le_sum fun I _ => ?_)) le_rfl)
    rw [enorm_mul, enorm_mul]
    have h1 : ‖(D.len I : ℂ)‖ₑ = ENNReal.ofReal (D.len I) := by
      rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg (D.len_pos I).le]
    have h2 : ‖ε I σ‖ₑ ≤ 1 := by
      rw [← ofReal_norm, ← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (hε1 I σ)
    rw [h1]
    calc ENNReal.ofReal (D.len I) * ‖ε I σ‖ₑ * ‖D.err1 I σ‖ₑ
        ≤ ENNReal.ofReal (D.len I) * 1 * ‖D.err1 I σ‖ₑ := by gcongr
      _ = _ := by rw [mul_one]
  have hmeas : Measurable fun σ => ∑ I ∈ D.cells, ENNReal.ofReal (D.len I) * ‖D.err1 I σ‖ₑ :=
    Finset.measurable_sum _ fun I hI => measurable_const.mul (D.measurable_err1 hI).enorm
  calc ∫⁻ σ, ‖D.total ε σ‖ₑ ∂P
      ≤ ∫⁻ σ, (∑ I ∈ D.cells, ENNReal.ofReal (D.len I) * ‖D.err1 I σ‖ₑ +
          ‖D.latticeSum ε σ (slotLift D.δ (D.inp σ))‖ₑ) ∂P := lintegral_mono_ae hsplit
    _ = ∫⁻ σ, ∑ I ∈ D.cells, ENNReal.ofReal (D.len I) * ‖D.err1 I σ‖ₑ ∂P +
          ∫⁻ σ, ‖D.latticeSum ε σ (slotLift D.δ (D.inp σ))‖ₑ ∂P := lintegral_add_left hmeas _
    _ ≤ _ := by
        gcongr
        · exact D.err1_bound P hC4 hmom hab m hm hloc hw
        · refine (D.lintegral_latticeSum_le_liminf P hmom hfin ε hε).trans ?_
          refine Filter.liminf_le_of_frequently_le' (Filter.Frequently.of_forall fun N => ?_)
          exact D.partial_bound P hmom ε hε hε1 hab m hm hloc hw hreg hA hq first hdepth p hp
            hsum Cm hCm B hB N

end BlockData

/-! ### Assembly of `eq:shortblock` (lem:shortblock, blueprint lines 2272-2369) -/

namespace DepthRect

/-- The heavy slot `a` of a rectangle (for `rep`, the least attaining slot). -/
noncomputable def heavy : DepthRect → Fin 4
  | rep S _ => if h : S.Nonempty then S.min' h else 0
  | uniq a _ _ _ => a

/-- The designated slot `b` of a rectangle (blueprint line 2292). -/
noncomputable def desig : DepthRect → Fin 4
  | rep S _ => if h : (S.erase (if h : S.Nonempty then S.min' h else 0)).Nonempty then
      (S.erase (if h : S.Nonempty then S.min' h else 0)).min' h else 0
  | uniq _ S _ _ => if h : S.Nonempty then S.min' h else 0

theorem heavy_mem_rep {S : Finset (Fin 4)} {v : ℕ} (hv : Valid (rep S v)) :
    heavy (rep S v) ∈ S := by
  have hS : S.Nonempty := Finset.card_pos.mp (by have : 2 ≤ S.card := hv; omega)
  simp only [heavy, hS, ↓reduceDIte]
  exact Finset.min'_mem S hS

theorem desig_mem_rep {S : Finset (Fin 4)} {v : ℕ} (hv : Valid (rep S v)) :
    desig (rep S v) ∈ S ∧ desig (rep S v) ≠ heavy (rep S v) := by
  have hS : S.Nonempty := Finset.card_pos.mp (by have : 2 ≤ S.card := hv; omega)
  have hE : (S.erase (S.min' hS)).Nonempty := by
    rw [← Finset.card_pos, Finset.card_erase_of_mem (Finset.min'_mem S hS)]
    have : 2 ≤ S.card := hv; omega
  simp only [desig, heavy, hS, ↓reduceDIte, hE]
  have := Finset.min'_mem _ hE
  exact ⟨Finset.mem_of_mem_erase this, Finset.ne_of_mem_erase this⟩

theorem desig_mem_uniq {a : Fin 4} {S : Finset (Fin 4)} {h k : ℕ} (hv : Valid (uniq a S h k)) :
    desig (uniq a S h k) ∈ S ∧ desig (uniq a S h k) ≠ heavy (uniq a S h k) := by
  obtain ⟨haS, hS⟩ := hv
  simp only [desig, heavy, hS, ↓reduceDIte]
  have := Finset.min'_mem S hS
  exact ⟨this, fun e => haS (e ▸ this)⟩

theorem desig_ne_heavy {R : DepthRect} (hv : Valid R) : desig R ≠ heavy R := by
  cases R with
  | rep S v => exact (desig_mem_rep hv).2
  | uniq a S h k => exact (desig_mem_uniq hv).2

/-- The heavy slot has depth at most the separating depth. -/
theorem side_heavy_le {R : DepthRect} (hv : Valid R) {x : ℕ} (hx : Side R (heavy R) x) :
    x ≤ sep R := by
  cases R with
  | rep S v =>
    have := (hx.1 (heavy_mem_rep hv))
    simp only [sep]; omega
  | uniq a S h k =>
    simp only [Side, heavy, ↓reduceIte] at hx
    simp only [sep]
    have h2 : 0 < 2 ^ h := by positivity
    have hlt : x < 2 ^ h * (x / 2 ^ h + 1) := Nat.lt_mul_div_succ x h2
    rw [hx] at hlt
    nlinarith

/-- All other slots have depth at least the separating depth. -/
theorem sep_le_side {R : DepthRect} {j : Fin 4} (hj : j ≠ heavy R) {x : ℕ} (hx : Side R j x) :
    sep R ≤ x := by
  cases R with
  | rep S v =>
    simp only [sep]
    by_cases hjS : j ∈ S
    · exact (hx.1 hjS).ge
    · exact (hx.2 hjS).le
  | uniq a S h k =>
    simp only [heavy] at hj
    simp only [Side, hj, ↓reduceIte] at hx
    simp only [sep]
    have hq : 2 * k + 1 ≤ x / 2 ^ h := by
      by_cases hjS : j ∈ S
      · exact (hx.1 hjS).ge
      · have := hx.2 hjS; omega
    calc (2 * k + 1) * 2 ^ h ≤ x / 2 ^ h * 2 ^ h := Nat.mul_le_mul_right _ hq
      _ ≤ x := Nat.div_mul_le_self x _

/-- The level of a rectangle: its slot assignment and scale, forgetting the position. -/
def level : DepthRect → DepthRect
  | rep S _ => rep S 0
  | uniq a S h _ => uniq a S h 0

theorem heavy_level (R : DepthRect) : heavy (level R) = heavy R := by
  cases R <;> rfl

theorem desig_level (R : DepthRect) : desig (level R) = desig R := by
  cases R <;> rfl

/-- Within a level, the heavy masks of distinct positions are disjoint. -/
theorem heavy_disjoint {R R' : DepthRect} (hv : Valid R) (hl : level R = level R')
    (hne : R ≠ R') {x : ℕ} (h1 : Side R (heavy R) x) (h2 : Side R' (heavy R') x) : False := by
  cases R with
  | rep S v =>
    cases R' with
    | rep S' v' =>
      simp only [level, rep.injEq, and_true] at hl
      subst hl
      have hv' : Valid (rep S v') := hv
      have e1 := h1.1 (heavy_mem_rep hv)
      have e2 := h2.1 (heavy_mem_rep hv')
      exact hne (by rw [← e1, ← e2])
    | uniq => simp [level] at hl
  | uniq a S h k =>
    cases R' with
    | rep => simp [level] at hl
    | uniq a' S' h' k' =>
      simp only [level, uniq.injEq, and_true] at hl
      obtain ⟨rfl, rfl, rfl⟩ := hl
      simp only [Side, heavy, ↓reduceIte] at h1 h2
      exact hne (by congr 1; omega)

/-- Within a level, the designated masks of distinct positions are disjoint. -/
theorem desig_disjoint {R R' : DepthRect} (hv : Valid R) (hl : level R = level R')
    (hne : R ≠ R') {x : ℕ} (h1 : Side R (desig R) x) (h2 : Side R' (desig R') x) : False := by
  cases R with
  | rep S v =>
    cases R' with
    | rep S' v' =>
      simp only [level, rep.injEq, and_true] at hl
      subst hl
      have hv' : Valid (rep S v') := hv
      have e1 := h1.1 (desig_mem_rep hv).1
      have e2 := h2.1 (by
        have := (desig_mem_rep hv').1; simpa [desig] using this)
      exact hne (by rw [← e1, ← e2])
    | uniq => simp [level] at hl
  | uniq a S h k =>
    cases R' with
    | rep => simp [level] at hl
    | uniq a' S' h' k' =>
      simp only [level, uniq.injEq, and_true] at hl
      obtain ⟨rfl, rfl, rfl⟩ := hl
      have hd := desig_mem_uniq hv
      simp only [Side, (show desig (uniq a S h k) ≠ a from hd.2), ↓reduceIte] at h1
      have hd' : desig (uniq a S h k') = desig (uniq a S h k) := rfl
      rw [hd'] at h2
      simp only [Side, (show desig (uniq a S h k) ≠ a from hd.2), ↓reduceIte] at h2
      have := h1.1 hd.1
      have := h2.1 hd.1
      exact hne (by congr 1; omega)

end DepthRect

/-- A finite dyadic tree piece of `lem:shortblock` (blueprint line 2276): a root cell, internal
summation cells in the `K` consecutive depths starting at `first`, and leaves in that block or one
depth below; the leaves are disjoint cells inside the root covering it, and an internal cell
meeting a leaf is strictly coarser. -/
structure ShortBlockTree (G : RealDyadicGrid) (K : ℕ) where
  root : ℤ × ℤ
  first : ℤ
  internal : Finset (ℤ × ℤ)
  leaves : Finset (ℤ × ℤ)
  internal_depth : ∀ I ∈ internal, first ≤ I.1 ∧ I.1 < first + K
  leaf_depth : ∀ L ∈ leaves, first ≤ L.1 ∧ L.1 ≤ first + K
  internal_subset : ∀ I ∈ internal,
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G root.1 root.2
  leaf_subset : ∀ L ∈ leaves, dyadicGridCell G L.1 L.2 ⊆ dyadicGridCell G root.1 root.2
  leaf_disjoint : (leaves : Set (ℤ × ℤ)).PairwiseDisjoint fun L => dyadicGridCell G L.1 L.2
  leaf_cover : dyadicGridCell G root.1 root.2 ⊆ ⋃ L ∈ leaves, dyadicGridCell G L.1 L.2
  internal_leaf : ∀ I ∈ internal, ∀ L ∈ leaves,
    (dyadicGridCell G I.1 I.2 ∩ dyadicGridCell G L.1 L.2).Nonempty → I.1 < L.1

namespace ShortBlockTree

variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K)

/-- Left endpoints and lengths of cells. -/
noncomputable def cl (G : RealDyadicGrid) (c : ℤ × ℤ) : ℝ := dyadicGridLeft G c.1 c.2

noncomputable def cr (G : RealDyadicGrid) (c : ℤ × ℤ) : ℝ := dyadicGridLength G c.1

theorem leafInterval_eq (c : ℤ × ℤ) :
    leafInterval (cl G) (cr G) c = dyadicGridCell G c.1 c.2 := rfl

/-- Every leaf meeting an internal cell lies inside it. -/
theorem leaf_subset_internal {I L : ℤ × ℤ} (hI : I ∈ T.internal) (hL : L ∈ T.leaves)
    (h : (dyadicGridCell G I.1 I.2 ∩ dyadicGridCell G L.1 L.2).Nonempty) :
    dyadicGridCell G L.1 L.2 ⊆ dyadicGridCell G I.1 I.2 := by
  have hlt := T.internal_leaf I hI L hL h
  rcases dyadicGridCell_nested_or_disjoint_of_le G hlt.le I.2 L.2 with hd | hs
  · exact absurd h (Set.not_nonempty_iff_eq_empty.mpr (Set.disjoint_iff_inter_eq_empty.mp hd))
  · exact hs

/-- The padded depth of a leaf. -/
def depth (L : ℤ × ℤ) : ℕ := (L.1 - T.first).toNat

theorem depth_le {L : ℤ × ℤ} (hL : L ∈ T.leaves) : T.depth L ≤ K := by
  have := T.leaf_depth L hL; unfold depth; omega

/-- The leaf-depth labelling of points (zero outside the leaves). -/
noncomputable def dep (y : ℝ) : ℕ :=
  ∑ L ∈ T.leaves, (dyadicGridCell G L.1 L.2).indicator (fun _ => T.depth L) y

theorem dep_eq {L : ℤ × ℤ} (hL : L ∈ T.leaves) {y : ℝ} (hy : y ∈ dyadicGridCell G L.1 L.2) :
    T.dep y = T.depth L := by
  unfold dep
  rw [Finset.sum_eq_single L]
  · rw [Set.indicator_of_mem hy]
  · intro L' hL' hne
    refine Set.indicator_of_notMem (fun hy' => ?_) _
    exact Set.disjoint_left.mp (T.leaf_disjoint hL' hL hne) hy' hy
  · intro h; exact absurd hL h

theorem measurable_dep : Measurable T.dep := by
  unfold dep
  exact Finset.measurable_sum _ fun L _ =>
    measurable_const.indicator (dyadicGridCell_measurable G L.1 L.2)

theorem dep_lt {m : ℕ} (hm : K < 2 ^ m) (y : ℝ) : T.dep y < 2 ^ m := by
  by_cases h : ∃ L ∈ T.leaves, y ∈ dyadicGridCell G L.1 L.2
  · obtain ⟨L, hL, hy⟩ := h
    rw [T.dep_eq hL hy]
    exact (T.depth_le hL).trans_lt hm
  · push Not at h
    have : T.dep y = 0 := by
      unfold dep
      exact Finset.sum_eq_zero fun L hL => Set.indicator_of_notMem (h L hL) _
    rw [this]; positivity

/-- The leaves selected by slot `j` of a rectangle. -/
noncomputable def sel (R : DepthRect) (j : Fin 4) : Finset (ℤ × ℤ) := by
  classical
  exact T.leaves.filter fun L => DepthRect.Side R j (T.depth L)

/-- The leaf mask `E_j` of slot `j` in a rectangle. -/
def mask (R : DepthRect) (j : Fin 4) : Set ℝ := leafUnion (T.sel R j) (cl G) (cr G)

theorem measurableSet_mask (R : DepthRect) (j : Fin 4) : MeasurableSet (T.mask R j) := by
  unfold mask leafUnion
  exact Finset.measurableSet_biUnion _ fun L _ => measurableSet_Ico

theorem mask_subset_root (R : DepthRect) (j : Fin 4) :
    T.mask R j ⊆ dyadicGridCell G T.root.1 T.root.2 := by
  classical
  intro y hy
  simp only [mask, leafUnion, Set.mem_iUnion] at hy
  obtain ⟨L, hL, hy⟩ := hy
  exact T.leaf_subset L (Finset.mem_filter.mp hL).1 hy

theorem mem_mask_iff {R : DepthRect} {j : Fin 4} {y : ℝ}
    (hy : y ∈ dyadicGridCell G T.root.1 T.root.2) :
    y ∈ T.mask R j ↔ DepthRect.Side R j (T.dep y) := by
  classical
  obtain ⟨L, hL, hyL⟩ : ∃ L ∈ T.leaves, y ∈ dyadicGridCell G L.1 L.2 := by
    have := T.leaf_cover hy
    simp only [Set.mem_iUnion] at this
    obtain ⟨L, hL, h⟩ := this
    exact ⟨L, hL, h⟩
  rw [T.dep_eq hL hyL]
  simp only [mask, leafUnion, Set.mem_iUnion, sel, Finset.mem_filter]
  constructor
  · rintro ⟨L', ⟨hL', hs⟩, hy'⟩
    have : L' = L := by
      by_contra hne
      exact Set.disjoint_left.mp (T.leaf_disjoint hL' hL hne) hy' hyL
    rwa [← this]
  · intro hs
    exact ⟨L, ⟨hL, hs⟩, hyL⟩

theorem sel_pairwiseDisjoint (R : DepthRect) (j : Fin 4) :
    ((T.sel R j : Finset (ℤ × ℤ)) : Set (ℤ × ℤ)).PairwiseDisjoint (leafInterval (cl G) (cr G)) := by
  classical
  intro L hL L' hL' hne
  exact T.leaf_disjoint (Finset.mem_filter.mp hL).1 (Finset.mem_filter.mp hL').1 hne

end ShortBlockTree

namespace DepthRect

/-- The position of a rectangle within its level. -/
def pos : DepthRect → ℕ
  | rep _ v => v
  | uniq _ _ _ k => k

theorem eq_of_level_pos {R R' : DepthRect} (hl : level R = level R') (hp : pos R = pos R') :
    R = R' := by
  cases R <;> cases R' <;> simp_all [level, pos]

theorem pos_lt_of_mem_upTo {m : ℕ} {R : DepthRect} (hR : R ∈ upTo m) : pos R < 2 ^ m := by
  unfold upTo at hR
  rcases Finset.mem_union.mp hR with h | h
  · obtain ⟨⟨S, v⟩, hp, rfl⟩ := Finset.mem_image.mp h
    simp only [Finset.mem_product, Finset.mem_univ, Finset.mem_range, true_and] at hp
    exact hp
  · obtain ⟨⟨a, S, h', k⟩, hp, rfl⟩ := Finset.mem_image.mp h
    simp only [Finset.mem_product, Finset.mem_univ, Finset.mem_range, true_and] at hp
    exact hp.2

/-- At most `2^m` positions per level. -/
theorem card_level_fiber_le (m : ℕ) (F : Finset DepthRect) (hF : F ⊆ upTo m) (key : DepthRect) :
    (F.filter fun R => level R = key).card ≤ 2 ^ m := by
  classical
  calc (F.filter fun R => level R = key).card ≤ (Finset.range (2 ^ m)).card :=
        Finset.card_le_card_of_injOn pos
          (fun R hR => Finset.mem_range.mpr (pos_lt_of_mem_upTo (hF (Finset.mem_filter.mp hR).1)))
          (fun R hR R' hR' e => eq_of_level_pos
            (((Finset.mem_filter.mp hR).2).trans ((Finset.mem_filter.mp hR').2).symm) e)
    _ = 2 ^ m := Finset.card_range _

/-- At most `16 + 64 m` levels. -/
theorem card_levels_le (m : ℕ) : ((upTo m).image level).card ≤ 16 + 64 * m := by
  classical
  have hsub : (upTo m).image level ⊆
      (Finset.univ : Finset (Finset (Fin 4))).image (fun S => rep S 0) ∪
        ((Finset.univ : Finset (Fin 4)) ×ˢ (Finset.univ : Finset (Finset (Fin 4))) ×ˢ
          Finset.range m).image (fun p => uniq p.1 p.2.1 p.2.2 0) := by
    intro L hL
    obtain ⟨R, hR, rfl⟩ := Finset.mem_image.mp hL
    unfold upTo at hR
    rcases Finset.mem_union.mp hR with h | h
    · obtain ⟨⟨S, v⟩, -, rfl⟩ := Finset.mem_image.mp h
      exact Finset.mem_union_left _ (Finset.mem_image.mpr ⟨S, Finset.mem_univ _, rfl⟩)
    · obtain ⟨⟨a, S, h', k⟩, hp, rfl⟩ := Finset.mem_image.mp h
      simp only [Finset.mem_product, Finset.mem_univ, Finset.mem_range, true_and] at hp
      exact Finset.mem_union_right _ (Finset.mem_image.mpr
        ⟨(a, S, h'), by simp [hp.1], rfl⟩)
  calc ((upTo m).image level).card ≤ _ := Finset.card_le_card hsub
    _ ≤ _ := Finset.card_union_le _ _
    _ ≤ 16 + 64 * m := by
        gcongr
        · exact Finset.card_image_le.trans (by simp)
        · refine Finset.card_image_le.trans ?_
          simp [Finset.card_product]; ring_nf; omega

end DepthRect

/-- Cauchy–Schwarz for finite sums in `ℝ≥0∞`. -/
theorem ennreal_sum_sqrt_mul_le {ι : Type*} (s : Finset ι) (f g : ι → ℝ≥0∞) :
    ∑ i ∈ s, f i ^ (1 / 2 : ℝ) * g i ^ (1 / 2 : ℝ) ≤
      (∑ i ∈ s, f i) ^ (1 / 2 : ℝ) * (∑ i ∈ s, g i) ^ (1 / 2 : ℝ) := by
  refine (ENNReal.inner_le_Lp_mul_Lq s (fun i => f i ^ (1 / 2 : ℝ)) (fun i => g i ^ (1 / 2 : ℝ))
    Real.HolderConjugate.two_two).trans (le_of_eq ?_)
  simp_rw [← ENNReal.rpow_mul]
  norm_num

theorem dyadicGridLength_mul_two_pow (G : RealDyadicGrid) (s : ℤ) (n : ℕ) :
    dyadicGridLength G s = dyadicGridLength G (s + n) * 2 ^ n := by
  unfold dyadicGridLength
  rw [mul_assoc, ← zpow_natCast, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
  congr 2; ring

theorem two_mul_dyadicGridLength_le (G : RealDyadicGrid) {s t : ℤ} (h : s < t) :
    2 * dyadicGridLength G t ≤ dyadicGridLength G s := by
  obtain ⟨n, hn⟩ : ∃ n : ℕ, t = s + (n + 1 : ℕ) := ⟨(t - s - 1).toNat, by omega⟩
  rw [dyadicGridLength_mul_two_pow G s (n + 1), ← hn, pow_succ]
  have hl := dyadicGridLength_pos G t
  have : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
  nlinarith

/-- The sampling weights of the coarser depths: `Σ_{s ∈ S} r_t / r_s ≤ 1` for distinct `s < t`. -/
theorem sum_length_ratio_le (G : RealDyadicGrid) (S : Finset ℤ) {t : ℤ} (hS : ∀ s ∈ S, s < t) :
    ∑ s ∈ S, dyadicGridLength G t / dyadicGridLength G s ≤ 1 := by
  classical
  set f : ℤ → ℕ := fun s => (t - s - 1).toNat
  have hf : Set.InjOn f S := by
    intro s hs s' hs' e
    have := hS s hs; have := hS s' hs'
    simp only [f] at e; omega
  have hterm : ∀ s ∈ S, dyadicGridLength G t / dyadicGridLength G s = (1 / 2 : ℝ) ^ (f s + 1) := by
    intro s hs
    have h := hS s hs
    have ht : t = s + ((f s + 1 : ℕ) : ℤ) := by simp only [f]; omega
    rw [div_eq_iff (dyadicGridLength_pos G s).ne', dyadicGridLength_mul_two_pow G s (f s + 1),
      ← ht, mul_comm ((1 / 2 : ℝ) ^ _), mul_assoc, ← mul_pow]
    norm_num
  rw [Finset.sum_congr rfl hterm, ← Finset.sum_image (f := fun k => (1 / 2 : ℝ) ^ (k + 1)) hf]
  obtain ⟨n, hn⟩ := Finset.exists_nat_subset_range (S.image f)
  calc ∑ k ∈ S.image f, (1 / 2 : ℝ) ^ (k + 1) ≤ ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ (k + 1) :=
        Finset.sum_le_sum_of_subset_of_nonneg hn fun _ _ _ => by positivity
    _ ≤ 1 := by
        have h := sum_geometric_two_le n
        calc ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ (k + 1)
            = (1 / 2) * ∑ k ∈ Finset.range n, (1 / 2 : ℝ) ^ k := by
              rw [Finset.mul_sum]; congr 1; funext k; ring
          _ ≤ (1 / 2) * 2 := by gcongr
          _ = 1 := by norm_num

namespace ShortBlockTree

variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K)

/-- The sampling ratio `β`. -/
noncomputable def beta (κ : LocalKernelClass) : ℝ := min κ.margin 1 / 16

theorem beta_pos (κ : LocalKernelClass) : 0 < beta κ := by
  unfold beta; have := κ.margin_pos; positivity

/-- The comparison data of one leaf-depth rectangle (blueprint lines 2298-2303): the summation
cells coarser than the separating depth `t`, the sampling scale `δ = β r_t`, and the inputs
restricted to the rectangle's leaf masks. -/
noncomputable def rectData (κ : LocalKernelClass) (cells : Finset (ℤ × ℤ))
    (hcells : cells ⊆ T.internal) (kernel : ℤ × ℤ → ℝ × ℝ → ℂ)
    (hker : ∀ I ∈ T.internal, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1) (kernel I))
    {Ω : Type*} [MeasurableSpace Ω] {E : Type*} [NormedAddCommGroup E] (z : Fin 4 → ℝ → E)
    (hz : ∀ j, Measurable fun y => ‖z j y‖) (zσ : Fin 4 → Ω → ℝ → ℂ)
    (hzσ : ∀ j, Measurable (Function.uncurry (zσ j))) (R : DepthRect) : BlockData κ Ω := by
  classical
  exact
  { grid := G
    cells := cells.filter fun I => I.1 < T.first + DepthRect.sep R
    kernel := kernel
    admissible := fun I hI => hker I (hcells (Finset.mem_filter.mp hI).1)
    δ := beta κ * dyadicGridLength G (T.first + DepthRect.sep R)
    δ_pos := mul_pos (beta_pos κ) (dyadicGridLength_pos G _)
    δ_small := fun I hI => by
      have h := two_mul_dyadicGridLength_le G (Finset.mem_filter.mp hI).2
      have hl := dyadicGridLength_pos G (T.first + DepthRect.sep R)
      have hμ := κ.margin_pos
      have hm : min κ.margin 1 ≤ κ.margin := min_le_left _ _
      unfold beta
      nlinarith
    δ_le_len := fun I hI => by
      have h := two_mul_dyadicGridLength_le G (Finset.mem_filter.mp hI).2
      have hl := dyadicGridLength_pos G (T.first + DepthRect.sep R)
      have hm : min κ.margin 1 ≤ 1 := min_le_right _ _
      have hm0 : 0 < min κ.margin 1 := lt_min κ.margin_pos one_pos
      unfold beta
      nlinarith
    z := fun j σ y => zσ j σ y * (T.mask R j).indicator 1 y
    z_meas := fun j => (hzσ j).mul ((measurable_const.indicator (T.measurableSet_mask R j)).comp
      measurable_snd)
    Z := fun j y => ‖z j y‖ * (T.mask R j).indicator 1 y
    Z_meas := fun j => (hz j).mul (measurable_const.indicator (T.measurableSet_mask R j))
    Z_nonneg := fun j y => mul_nonneg (norm_nonneg _)
      (Set.indicator_nonneg (fun _ _ => zero_le_one) y)
    lo := dyadicGridLeft G T.root.1 T.root.2
    hi := dyadicGridLeft G T.root.1 T.root.2 + dyadicGridLength G T.root.1
    z_supp := fun j σ y hy => by
      have : y ∉ T.mask R j := fun h => hy (Set.Ico_subset_Icc_self (T.mask_subset_root R j h))
      simp [this] }

end ShortBlockTree

namespace ShortBlockTree

variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K) (κ : LocalKernelClass)
  (cells : Finset (ℤ × ℤ)) (hcells : cells ⊆ T.internal) (kernel : ℤ × ℤ → ℝ × ℝ → ℂ)
  (hker : ∀ I ∈ T.internal, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
    (dyadicGridLength G I.1) (kernel I))
  {Ω : Type*} [MeasurableSpace Ω] {E : Type*} [NormedAddCommGroup E] (z : Fin 4 → ℝ → E)
  (hz : ∀ j, Measurable fun y => ‖z j y‖) (zσ : Fin 4 → Ω → ℝ → ℂ)
  (hzσ : ∀ j, Measurable (Function.uncurry (zσ j)))

theorem rect_Z_sq (R : DepthRect) (j : Fin 4) (y : ℝ) :
    ENNReal.ofReal ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).Z j y) ^ (2 : ℝ) =
      (T.mask R j).indicator (fun y => ‖((‖z j y‖ : ℝ) : ℂ)‖ₑ ^ 2) y := by
  classical
  simp only [rectData]
  by_cases hy : y ∈ T.mask R j
  · simp only [hy, Set.indicator_of_mem, Pi.one_apply, mul_one]
    rw [← ofReal_norm (((‖z j y‖ : ℝ) : ℂ)), Complex.norm_real, norm_norm, ENNReal.rpow_two]
  · simp [hy, Set.indicator_of_notMem]

/-- The leaf bound in the normalized form. -/
def LeafBound (z : Fin 4 → ℝ → E) : Prop :=
  ∀ j, ∀ L ∈ T.leaves, ∫⁻ y in dyadicGridCell G L.1 L.2, ‖z j y‖ₑ ^ 2 ≤
    ENNReal.ofReal (dyadicGridLength G L.1)

theorem leafBound_zc {z : Fin 4 → ℝ → E} (hL : T.LeafBound z) (j : Fin 4) (R : DepthRect) :
    ∀ i ∈ T.sel R j, ∫⁻ x in leafInterval (cl G) (cr G) i, ‖((‖z j x‖ : ℝ) : ℂ)‖ₑ ^ 2 ≤
      ENNReal.ofReal (cr G i) := by
  classical
  intro L hL'
  have h := hL j L (Finset.mem_filter.mp hL').1
  rw [leafInterval_eq]
  refine le_trans (le_of_eq ?_) h
  refine lintegral_congr fun y => ?_
  rw [← ofReal_norm, Complex.norm_real, norm_norm, ofReal_norm]

/-- The mass hypothesis of the rectangle: `∫ Z_j² ≤ |E_j|`. -/
theorem rect_mass (hL : T.LeafBound z) (R : DepthRect) (j : Fin 4) :
    ∫⁻ y, ENNReal.ofReal ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).Z j y) ^ (2 : ℝ) ≤
      ENNReal.ofReal (volume (T.mask R j)).toReal := by
  simp_rw [T.rect_Z_sq κ cells hcells kernel hker z hz zσ hzσ R j]
  rw [lintegral_indicator (T.measurableSet_mask R j)]
  have hfin : volume (T.mask R j) ≠ ⊤ :=
    ((measure_mono (T.mask_subset_root R j)).trans_lt (by
      rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top)).ne
  rw [ENNReal.ofReal_toReal hfin]
  exact leafUnion_mass_le (T.sel_pairwiseDisjoint R j) _ (T.leafBound_zc hL j R)

/-- The local hypothesis of the rectangle: `∫_I Z_j² ≤ |I|`. -/
theorem rect_loc (hL : T.LeafBound z) (R : DepthRect) {I : ℤ × ℤ}
    (hI : I ∈ (T.rectData κ cells hcells kernel hker z hz zσ hzσ R).cells) (j : Fin 4) :
    ∫⁻ y in Set.Icc ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).left I)
      ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).left I +
        (T.rectData κ cells hcells kernel hker z hz zσ hzσ R).len I),
      ENNReal.ofReal ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).Z j y) ^ (2 : ℝ) ≤
      ENNReal.ofReal ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).len I) := by
  classical
  have hIi : I ∈ T.internal := hcells (Finset.mem_filter.mp hI).1
  simp_rw [T.rect_Z_sq κ cells hcells kernel hker z hz zσ hzσ R j]
  change ∫⁻ y in Set.Icc (dyadicGridLeft G I.1 I.2) (dyadicGridLeft G I.1 I.2 +
      dyadicGridLength G I.1), _ ≤ ENNReal.ofReal (dyadicGridLength G I.1)
  rw [setLIntegral_congr (Ico_ae_eq_Icc.symm), lintegral_indicator (T.measurableSet_mask R j),
    Measure.restrict_restrict (T.measurableSet_mask R j), Set.inter_comm]
  change ∫⁻ y in dyadicGridCell G I.1 I.2 ∩ T.mask R j, _ ≤ _
  rw [← dyadicGridCell_volume]
  exact leaf_local_mass_le (T.sel_pairwiseDisjoint R j) _ (T.leafBound_zc hL j R) _
    fun L hL' hne => T.leaf_subset_internal hIi (Finset.mem_filter.mp hL').1 hne

/-- The sampling weights of the rectangle: `Σ_s δ / r_s ≤ 1`. -/
theorem rect_weights (R : DepthRect) :
    ∑ s ∈ (T.rectData κ cells hcells kernel hker z hz zσ hzσ R).cells.image Prod.fst,
      (T.rectData κ cells hcells kernel hker z hz zσ hzσ R).δ / dyadicGridLength G s ≤ 1 := by
  classical
  change ∑ s ∈ (cells.filter fun I => I.1 < T.first + DepthRect.sep R).image Prod.fst,
    beta κ * dyadicGridLength G (T.first + DepthRect.sep R) / dyadicGridLength G s ≤ 1
  simp_rw [mul_div_assoc]
  rw [← Finset.mul_sum]
  have hb : beta κ ≤ 1 := by
    unfold beta; have := min_le_right κ.margin 1; linarith
  have hs := sum_length_ratio_le G
    ((cells.filter fun I => I.1 < T.first + DepthRect.sep R).image Prod.fst)
    (t := T.first + DepthRect.sep R) (fun s hs => by
    obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hs
    exact (Finset.mem_filter.mp hI).2)
  calc beta κ * _ ≤ beta κ * 1 := by gcongr; exact (beta_pos κ).le
    _ ≤ 1 := by linarith

/-- The regular window bound of the rectangle (blueprint lines 2331-2333):
`e_j(m)² ≤ 1/2 + 1/(8β)` for the slots other than the heavy one. -/
theorem rect_reg (hL : T.LeafBound z) (R : DepthRect) {j : Fin 4} (hj : j ≠ DepthRect.heavy R)
    (m : ℤ) :
    (T.rectData κ cells hcells kernel hker z hz zσ hzσ R).ewin j m ^ (2 : ℝ) ≤
      ENNReal.ofReal (1 / 2 + 1 / (8 * beta κ)) := by
  classical
  rw [(T.rectData κ cells hcells kernel hker z hz zσ hzσ R).ewin_sq]
  simp_rw [T.rect_Z_sq κ cells hcells kernel hker z hz zσ hzσ R j]
  set D := T.rectData κ cells hcells kernel hker z hz zσ hzσ R
  set t := T.first + DepthRect.sep R
  have hδ : D.δ = beta κ * dyadicGridLength G t := rfl
  have hβ := beta_pos κ
  have hrt := dyadicGridLength_pos G t
  rw [lintegral_indicator (T.measurableSet_mask R j),
    Measure.restrict_restrict (T.measurableSet_mask R j), Set.inter_comm]
  have hwin : D.window j m = Set.Ico (D.δ * (m + fastLiftLeft j))
      (D.δ * (m + fastLiftLeft j) + D.δ * fastLiftLen j) := by
    unfold BlockData.window; congr 1; ring
  rw [hwin]
  have hρ : ∀ L ∈ T.sel R j, cr G L ≤ dyadicGridLength G t := by
    intro L hL'
    have hs := DepthRect.sep_le_side hj (Finset.mem_filter.mp hL').2
    have hd := T.leaf_depth L (Finset.mem_filter.mp hL').1
    have hle : t ≤ L.1 := by unfold depth at hs; simp only [t]; omega
    exact (dyadicGridLength_strictAnti G).antitone hle
  have h := leaf_window_mass_le (T.sel_pairwiseDisjoint R j) _ (T.leafBound_zc hL j R) hρ
    (D.δ * (m + fastLiftLeft j)) (D.δ * fastLiftLen j)
  calc (ENNReal.ofReal (16 * D.δ))⁻¹ * ∫⁻ y in Set.Ico (D.δ * (m + fastLiftLeft j))
        (D.δ * (m + fastLiftLeft j) + D.δ * fastLiftLen j) ∩ T.mask R j,
          ‖((‖z j y‖ : ℝ) : ℂ)‖ₑ ^ 2
      ≤ (ENNReal.ofReal (16 * D.δ))⁻¹ *
          ENNReal.ofReal (D.δ * fastLiftLen j + 2 * dyadicGridLength G t) := by
        gcongr; exact h
    _ ≤ _ := by
        have hD : 0 < D.δ := D.δ_pos
        rw [← ENNReal.ofReal_inv_of_pos (by positivity), ← ENNReal.ofReal_mul (by positivity)]
        apply ENNReal.ofReal_le_ofReal
        have hL8 := fastLiftLen_le j
        rw [hδ] at hD ⊢
        rw [show (16 * (beta κ * dyadicGridLength G t))⁻¹ *
            (beta κ * dyadicGridLength G t * fastLiftLen j + 2 * dyadicGridLength G t) =
            fastLiftLen j / 16 + 1 / (8 * beta κ) by field_simp; ring]
        linarith

end ShortBlockTree

namespace BlockData

variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

theorem measurable_total (ε : ℤ × ℤ → Ω → ℂ) (hε : ∀ I, Measurable (ε I)) :
    Measurable fun σ => D.total ε σ := by
  unfold total
  refine Finset.measurable_sum _ fun I hI => (measurable_const.mul (hε I)).mul ?_
  unfold localProgressionForm
  have hk : Measurable (D.kernel I) := (D.admissible I hI).smooth.continuous.measurable
  have hF : StronglyMeasurable fun p : Ω × (ℝ × ℝ) =>
      D.kernel I p.2 * ∏ j, D.inp p.1 j (realProgressionCoordinate j p.2) :=
    ((hk.comp measurable_snd).mul (Finset.measurable_prod _ fun j _ =>
      (D.z_meas j).comp (measurable_fst.prodMk
        ((continuous_realProgressionCoordinate j).measurable.comp
          measurable_snd)))).stronglyMeasurable
  exact measurable_const.mul (hF.integral_prod_right' (ν := volume)).measurable

end BlockData

/-- The kernel of an admissible local form vanishes unless all progression coordinates lie in the
cell. -/
theorem admissible_coord_mem_cell {κ : LocalKernelClass} {G : RealDyadicGrid} {I : ℤ × ℤ}
    {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1) w) {z : ℝ × ℝ} (hz : w z ≠ 0) (j : Fin 4) :
    realProgressionCoordinate j z ∈ dyadicGridCell G I.1 I.2 := by
  have h := hw.support z hz j
  have hr := dyadicGridLength_pos G I.1
  have hc := mul_pos κ.margin_pos hr
  exact ⟨by linarith [h.1], by linarith [h.2]⟩

/-- A local form vanishes when one input vanishes on the cell. -/
theorem localProgressionForm_eq_zero_of_cell {κ : LocalKernelClass} {G : RealDyadicGrid}
    {I : ℤ × ℤ} {w : ℝ × ℝ → ℂ} (hw : IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
      (dyadicGridLength G I.1) w) (f : Fin 4 → ℝ → ℂ) (a : Fin 4)
    (ha : ∀ y ∈ dyadicGridCell G I.1 I.2, f a y = 0) (r : ℝ) :
    localProgressionForm r w f = 0 := by
  unfold localProgressionForm
  rw [show (∫ z : ℝ × ℝ, w z * ∏ j, f j (realProgressionCoordinate j z)) = ∫ _z : ℝ × ℝ, (0 : ℂ)
    from integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)]
  · simp
  · by_cases hz : w z = 0
    · simp [hz]
    · simp only
      rw [Finset.prod_eq_zero (Finset.mem_univ a) (ha _ (admissible_coord_mem_cell hw hz a)),
        mul_zero]

