    (hint : Integrable fun z : ℝ × ℝ => w z * ∏ j, f j (realProgressionCoordinate j z)) :
    localProgressionForm r w f = ∑ R ∈ (DepthRect.upTo m).filter DepthRect.Valid,
      localProgressionForm r w (fun j y => f j y *
        if DepthRect.Side R j (dep y) then 1 else 0) := by
  classical
  unfold localProgressionForm
  rw [← Finset.mul_sum]
  congr 1
  have hterm : ∀ R : DepthRect, Integrable fun z : ℝ × ℝ => w z *
      ∏ j, (f j (realProgressionCoordinate j z) *
        if DepthRect.Side R j (dep (realProgressionCoordinate j z)) then 1 else 0) := by
    intro R
    refine Integrable.mono' hint.norm ?_ (Filter.Eventually.of_forall fun z => ?_)
    · have hm : ∀ j, Measurable fun z : ℝ × ℝ =>
          (if DepthRect.Side R j (dep (realProgressionCoordinate j z)) then (1 : ℂ) else 0) :=
        fun j => Measurable.ite
          (show MeasurableSet ((dep ∘ realProgressionCoordinate j) ⁻¹'
              {x : ℕ | DepthRect.Side R j x}) from
            measurableSet_preimage (hdep.comp (continuous_realProgressionCoordinate j).measurable)
              (Set.to_countable _).measurableSet)
          measurable_const measurable_const
      refine (hint.aestronglyMeasurable.mul
        (Finset.aestronglyMeasurable_fun_prod Finset.univ fun j _ =>
        (hm j).aestronglyMeasurable)).congr (Filter.Eventually.of_forall fun z => ?_)
      simp only [Pi.mul_apply]
      rw [mul_assoc, ← Finset.prod_mul_distrib]
    · rw [norm_mul, norm_mul, norm_prod, norm_prod]
      gcongr with j
      split_ifs <;> simp
  rw [← integral_finsetSum _ fun R _ => hterm R]
  congr 1; funext z
  rw [← Finset.mul_sum]
  congr 1
  have hp := DepthRect.side_partition m (fun j => dep (realProgressionCoordinate j z))
    fun j => hd _
  symm
  rw [Finset.sum_congr rfl fun R _ => Finset.prod_mul_distrib, ← Finset.mul_sum, hp, mul_one]

/-! ### Fourier partial sums of the fast windows (limiting route of lem:shortblock) -/

/-- The symmetric Fourier partial sums of an `L²` function on the fast circle converge to it in
`L²` (Mathlib `hasSum_fourier_series_L2`). -/
theorem fast_partial_sums_tendsto (f : Lp ℂ 2 fastHaar) :
    Filter.Tendsto (fun N : ℕ => ∑ m ∈ Finset.Icc (-(N : ℤ)) N,
      fourierCoeff f m • fourierLp (T := 16) 2 m) Filter.atTop (nhds f) :=
  (hasSum_fourier_series_L2 f).comp Finset.tendsto_Icc_neg

/-- Bessel's inequality for finite sets of frequencies: `Σ_{m ∈ s} |f̂(m)|² ≤ ‖f‖₂²`. -/
theorem fast_bessel (f : Lp ℂ 2 fastHaar) (s : Finset ℤ) :
    ∑ m ∈ s, ‖fourierCoeff f m‖ ^ 2 ≤ ∫ t, ‖f t‖ ^ 2 ∂fastHaar :=
  sum_le_hasSum s (fun _ _ => by positivity) (hasSum_sq_fourierCoeff f)

/-- The partial sum, as a function, is the unmultiplied fast trigonometric polynomial. -/
theorem coeFn_fast_partial_sum (f : Lp ℂ 2 fastHaar) (s : Finset ℤ) :
    ⇑(∑ m ∈ s, fourierCoeff f m • fourierLp (T := 16) 2 m) =ᵐ[fastHaar]
      fastCircleMultiplied s (fourierCoeff f) 1 0 := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    filter_upwards [Lp.coeFn_zero ℂ 2 fastHaar] with t ht
    simp [fastCircleMultiplied]
  | insert a s ha ih =>
    rw [Finset.sum_insert ha]
    filter_upwards [Lp.coeFn_add (fourierCoeff f a • fourierLp (T := 16) 2 a)
      (∑ m ∈ s, fourierCoeff f m • fourierLp (T := 16) 2 m),
      Lp.coeFn_smul (fourierCoeff f a) (fourierLp (T := 16) 2 a), coeFn_fourierLp 2 a, ih]
      with t h1 h2 h3 h4
    rw [h1, Pi.add_apply, h2, Pi.smul_apply, h3, h4]
    simp [fastCircleMultiplied, Finset.sum_insert ha, ePhase_zero]

/-! ### The fast lift (lem:shortblock, blueprint lines 2302-2306) -/

/-- Left endpoints of the fast lift intervals: `[0, 1)` in slots `0, 1` and `[-4, 4)` in slots
`2, 3` (blueprint line 2303: "restricted to `[0,1)` in slots `0,1` and to fixed lift intervals in
`[-4,4]` containing all needed `w_j` in slots `2,3`"). -/
noncomputable def fastLiftLeft (j : Fin 4) : ℝ := if (j : ℕ) < 2 then 0 else -4

/-- Lengths of the fast lift intervals. -/
noncomputable def fastLiftLen (j : Fin 4) : ℝ := if (j : ℕ) < 2 then 1 else 8

/-- The representative of a fast point in `[ℓ_j, ℓ_j + 16)`. -/
noncomputable def fastRep (j : Fin 4) (t : FastCircle) : ℝ :=
  (AddCircle.equivIco 16 (fastLiftLeft j) t : ℝ)

theorem measurable_fastRep (j : Fin 4) : Measurable (fastRep j) :=
  measurable_subtype_coe.comp (AddCircle.measurableEquivIco 16 (fastLiftLeft j)).measurable

theorem fastRep_coe {j : Fin 4} {x : ℝ} (hx : x ∈ Set.Ico (fastLiftLeft j) (fastLiftLeft j + 16)) :
    fastRep j (x : FastCircle) = x := by
  unfold fastRep
  rw [AddCircle.equivIco_coe_eq hx]

/-- The lift of a function on the lift interval of slot `j` to the fast circle, zero elsewhere. -/
noncomputable def fastLift (j : Fin 4) (φ : ℝ → ℂ) (t : FastCircle) : ℂ :=
  if fastRep j t < fastLiftLeft j + fastLiftLen j then φ (fastRep j t) else 0

theorem measurable_fastLift (j : Fin 4) {φ : ℝ → ℂ} (hφ : Measurable φ) :
    Measurable (fastLift j φ) :=
  Measurable.ite (measurableSet_lt (measurable_fastRep j) measurable_const)
    (hφ.comp (measurable_fastRep j)) measurable_const

theorem fastLift_mul (j : Fin 4) (φ ψ : ℝ → ℂ) (t : FastCircle) :
    fastLift j (fun x => φ x * ψ x) t = fastLift j φ t * ψ (fastRep j t) := by
  unfold fastLift; split_ifs <;> simp

/-- Normalized Haar measure on `T₀²` is `1/256` times Lebesgue measure on `[0, 16)²`. -/
theorem integral_fastHaar_prod {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (h : FastCircle × FastCircle → E) (hh : AEStronglyMeasurable h (fastHaar.prod fastHaar)) :
    ∫ x, h x ∂(fastHaar.prod fastHaar) =
      (1 / 256 : ℝ) • ∫ x in Set.Ico (0 : ℝ) 16 ×ˢ Set.Ico (0 : ℝ) 16,
        h ((x.1 : FastCircle), (x.2 : FastCircle)) := by
  have hv : (volume : Measure FastCircle) = ENNReal.ofReal 16 • fastHaar :=
    AddCircle.volume_eq_smul_haarAddCircle
  have hH' : (volume : Measure FastCircle).prod (volume : Measure FastCircle) =
      (256 : ℝ≥0∞) • fastHaar.prod fastHaar := by
    rw [hv, Measure.prod_smul_left, Measure.prod_smul_right, smul_smul, ENNReal.ofReal_ofNat]
    norm_num
  have hH : fastHaar.prod fastHaar = (1 / 256 : ℝ≥0∞) •
      ((volume : Measure FastCircle).prod (volume : Measure FastCircle)) := by
    rw [hH', smul_smul, one_div, ENNReal.inv_mul_cancel (by norm_num) (by norm_num), one_smul]
  have hmp := (AddCircle.measurePreserving_mk (16 : ℝ) 0).prod
    (AddCircle.measurePreserving_mk (16 : ℝ) 0)
  rw [zero_add, Measure.restrict_congr_set (Ioc_ae_eq_Icc.trans Ico_ae_eq_Icc.symm),
    Measure.prod_restrict, ← Measure.volume_eq_prod] at hmp
  rw [hH, integral_smul_measure, ← hmp.map_eq,
    integral_map hmp.measurable.aemeasurable (by rw [hmp.map_eq, hH']; exact hh.smul_measure _)]
  congr 1
  norm_num

theorem fastLift_coe {j : Fin 4} (φ : ℝ → ℂ) {y : ℝ}
    (hy : y ∈ Set.Ico (fastLiftLeft j) (fastLiftLeft j + 16)) :
    fastLift j φ (y : FastCircle) = if y < fastLiftLeft j + fastLiftLen j then φ y else 0 := by
  unfold fastLift; rw [fastRep_coe hy]

theorem fastCoord_coe (j : ℤ) (a b : ℝ) :
    fastCoord j ((a : FastCircle), (b : FastCircle)) =
      (((1 - (j : ℝ)) * a + j * b : ℝ) : FastCircle) := by
  change (1 - j) • (a : FastCircle) + j • (b : FastCircle) = _
  rw [← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_zsmul, ← QuotientAddGroup.mk_add]
  congr 1
  simp [zsmul_eq_mul]

/-- Blueprint lines 2302-2306 ("with fixed Haar constants the fast progression integral
reproduces the original integral without wraparound"): lifting the slot functions to `T₀` on
the lift intervals, the fast progression integral over `T₀²` is `1/256` times the integral over
the unit cell `[0, 1)²`. -/
theorem fast_lift_form (φ : Fin 4 → ℝ → ℂ) (hφ : ∀ j, Measurable (φ j)) :
    ∫ x, ∏ j : Fin 4, fastLift j (φ j) (fastCoord j x) ∂(fastHaar.prod fastHaar) =
      (1 / 256 : ℝ) • ∫ u in Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1,
        ∏ j : Fin 4, φ j ((1 - (j : ℝ)) * u.1 + j * u.2) := by
  have hm : Measurable fun x : FastCircle × FastCircle =>
      ∏ j : Fin 4, fastLift j (φ j) (fastCoord j x) :=
    Finset.measurable_prod _ fun j _ =>
      (measurable_fastLift j (hφ j)).comp (continuous_fastCoord _).measurable
  rw [integral_fastHaar_prod _ hm.aestronglyMeasurable]
  congr 1
  have hpt : ∀ x ∈ Set.Ico (0 : ℝ) 16 ×ˢ Set.Ico (0 : ℝ) 16,
      ∏ j : Fin 4, fastLift j (φ j) (fastCoord j ((x.1 : FastCircle), (x.2 : FastCircle))) =
        (Set.Ico (0 : ℝ) 1 ×ˢ Set.Ico (0 : ℝ) 1).indicator
          (fun u => ∏ j : Fin 4, φ j ((1 - (j : ℝ)) * u.1 + j * u.2)) x := by
    rintro ⟨a, b⟩ ⟨⟨ha0, ha16⟩, ⟨hb0, hb16⟩⟩
    have hc : ∀ j : Fin 4, fastLift j (φ j) (fastCoord j ((a : FastCircle), (b : FastCircle))) =
        fastLift j (φ j) (((1 - (j : ℝ)) * a + j * b : ℝ) : FastCircle) := by
      intro j; rw [fastCoord_coe]; push_cast; rfl
    simp only [hc]
    by_cases hab : a < 1 ∧ b < 1
    · rw [Set.indicator_of_mem (by exact ⟨⟨ha0, hab.1⟩, ⟨hb0, hab.2⟩⟩)]
      refine Finset.prod_congr rfl fun j _ => ?_
      obtain ⟨ha1, hb1⟩ := hab
      fin_cases j <;>
      · rw [fastLift_coe _ (by simp [fastLiftLeft]; norm_num; constructor <;> linarith),
          ite_eq_left (by simp [fastLiftLeft, fastLiftLen]; norm_num; linarith)]
    · rw [Set.indicator_of_notMem (by
        rintro ⟨⟨-, h1'⟩, ⟨-, h2'⟩⟩; exact hab ⟨h1', h2'⟩)]
      rcases not_and_or.mp hab with h | h
      · refine Finset.prod_eq_zero (Finset.mem_univ 0) ?_
        rw [fastLift_coe _ (by simp [fastLiftLeft]; constructor <;> linarith),
          ite_eq_right (by simp [fastLiftLeft, fastLiftLen]; linarith)]
      · refine Finset.prod_eq_zero (Finset.mem_univ 1) ?_
        rw [fastLift_coe _ (by simp [fastLiftLeft]; constructor <;> linarith),
          ite_eq_right (by simp [fastLiftLeft, fastLiftLen]; linarith)]
  rw [setIntegral_congr_fun (measurableSet_Ico.prod measurableSet_Ico) hpt,
    integral_indicator (measurableSet_Ico.prod measurableSet_Ico), Measure.restrict_restrict
      (measurableSet_Ico.prod measurableSet_Ico)]
  congr 2
  ext ⟨a, b⟩
  simp only [Set.mem_inter_iff, Set.mem_prod, Set.mem_Ico]
  constructor
  · rintro ⟨⟨⟨h1, h2⟩, h3, h4⟩, -⟩; exact ⟨⟨h1, h2⟩, h3, h4⟩
  · rintro ⟨⟨h1, h2⟩, h3, h4⟩
    exact ⟨⟨⟨h1, h2⟩, h3, h4⟩, ⟨h1, by linarith⟩, h3, by linarith⟩

/-- The all-`L²` case of `eq:absolute` on `T₀²` for one slow tuple: pairing the slots `(0, 1)` and
`(2, 3)` and using independence of two coordinates, `∫∫ Π_j h_j(w_j) ≤ Π_j ‖h_j‖₂`. -/
theorem fast_form_L2_le (h : Fin 4 → FastCircle → ℝ≥0∞) (hh : ∀ j, Measurable (h j)) :
    ∫⁻ x, ∏ j : Fin 4, h j (fastCoord j x) ∂(fastHaar.prod fastHaar) ≤
      ∏ j : Fin 4, (∫⁻ t, h j t ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ) := by
  have hc : ∀ j : Fin 4, Measurable fun x : FastCircle × FastCircle => h j (fastCoord j x) :=
    fun j => (hh j).comp (continuous_fastCoord _).measurable
  have hA := (hc 0).mul (hc 1)
  have hB := (hc 2).mul (hc 3)
  have H := ENNReal.lintegral_mul_le_Lp_mul_Lq (fastHaar.prod fastHaar)
    Real.HolderConjugate.two_two hA.aemeasurable hB.aemeasurable
  have hpair : ∀ i j : Fin 4, i ≠ j →
      ∫⁻ x, (h i (fastCoord i x) * h j (fastCoord j x)) ^ (2 : ℝ) ∂(fastHaar.prod fastHaar) =
        (∫⁻ t, h i t ^ (2 : ℝ) ∂fastHaar) * ∫⁻ t, h j t ^ (2 : ℝ) ∂fastHaar := by
    intro i j hij
    simp_rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 2)]
    exact lintegral_fastPair (by exact_mod_cast fun e => hij (Fin.ext (by exact_mod_cast e)))
      ((hh i).pow_const _) ((hh j).pow_const _)
  simp only [Pi.mul_apply] at H
  rw [hpair 0 1 (by decide), hpair 2 3 (by decide),
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num), ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)] at H
  refine le_trans (le_of_eq ?_) (H.trans (le_of_eq ?_))
  · congr 1; funext x; rw [Fin.prod_univ_four, mul_assoc]
  · rw [Fin.prod_univ_four]; ring

theorem enorm_prod_four (f : Fin 4 → ℂ) : ‖∏ j, f j‖ₑ = ∏ j, ‖f j‖ₑ := by
  simp [Fin.prod_univ_four]

theorem eLpNorm_two_eq {g : FastCircle → ℂ} (hg : AEStronglyMeasurable g fastHaar) :
    eLpNorm g 2 fastHaar = (∫⁻ t, ‖g t‖ₑ ^ (2 : ℝ) ∂fastHaar) ^ (1 / 2 : ℝ) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hg]
  norm_num

/-- `∫∫ Π_j |g_j(w_j)| ≤ Π_j ‖g_j‖₂` for complex slot functions. -/
theorem lintegral_fast_form_le (g : Fin 4 → FastCircle → ℂ) (hg : ∀ j, Measurable (g j)) :
    ∫⁻ x, ∏ j : Fin 4, ‖g j (fastCoord j x)‖ₑ ∂(fastHaar.prod fastHaar) ≤
      ∏ j : Fin 4, eLpNorm (g j) 2 fastHaar := by
  simp_rw [fun j => eLpNorm_two_eq (hg j).aestronglyMeasurable]
  exact fast_form_L2_le (fun j t => ‖g j t‖ₑ) fun j => (hg j).enorm

theorem fast_form_integrable (g : Fin 4 → FastCircle → ℂ) (hg : ∀ j, Measurable (g j))
    (hL : ∀ j, MemLp (g j) 2 fastHaar) :
    Integrable (fun x => ∏ j : Fin 4, g j (fastCoord j x)) (fastHaar.prod fastHaar) := by
  refine ⟨(Finset.measurable_prod _ fun j _ =>
    (hg j).comp (continuous_fastCoord _).measurable).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  simp_rw [enorm_prod_four]
  exact (lintegral_fast_form_le g hg).trans_lt
    (ENNReal.prod_lt_top fun j _ => (hL j).eLpNorm_lt_top)

theorem norm_fast_form_le (g : Fin 4 → FastCircle → ℂ) (hg : ∀ j, Measurable (g j))
    (hL : ∀ j, MemLp (g j) 2 fastHaar) :
    ‖∫ x, ∏ j : Fin 4, g j (fastCoord j x) ∂(fastHaar.prod fastHaar)‖ ≤
      ∏ j : Fin 4, (eLpNorm (g j) 2 fastHaar).toReal := by
  have h1 := enorm_integral_le_lintegral_enorm (μ := fastHaar.prod fastHaar)
    (fun x => ∏ j : Fin 4, g j (fastCoord j x))
  simp_rw [enorm_prod_four] at h1
  have h2 := h1.trans (lintegral_fast_form_le g hg)
  have hfin : ∏ j : Fin 4, eLpNorm (g j) 2 fastHaar ≠ ⊤ :=
    (ENNReal.prod_lt_top fun j _ => (hL j).eLpNorm_lt_top).ne
  rw [← ENNReal.toReal_prod]
  have := ENNReal.toReal_mono hfin h2
  rwa [toReal_enorm] at this

theorem fast_prod_four (f : Fin 4 → FastCircle → ℂ) (x : FastCircle × FastCircle) :
    ∏ j : Fin 4, f j (fastCoord j x) =
      f 0 (fastCoord 0 x) * f 1 (fastCoord 1 x) * f 2 (fastCoord 2 x) * f 3 (fastCoord 3 x) := by
  rw [Fin.prod_univ_four]; rfl

theorem fast_form_integrable4 {g0 g1 g2 g3 : FastCircle → ℂ} (m0 : Measurable g0)
    (m1 : Measurable g1) (m2 : Measurable g2) (m3 : Measurable g3) (l0 : MemLp g0 2 fastHaar)
    (l1 : MemLp g1 2 fastHaar) (l2 : MemLp g2 2 fastHaar) (l3 : MemLp g3 2 fastHaar) :
    Integrable (fun x => g0 (fastCoord 0 x) * g1 (fastCoord 1 x) * g2 (fastCoord 2 x) *
      g3 (fastCoord 3 x)) (fastHaar.prod fastHaar) := by
  have := fast_form_integrable ![g0, g1, g2, g3] (fun j => by fin_cases j <;> assumption)
    (fun j => by fin_cases j <;> assumption)
  simp_rw [fast_prod_four] at this
  exact this

theorem norm_fast_form_le4 {g0 g1 g2 g3 : FastCircle → ℂ} (m0 : Measurable g0)
    (m1 : Measurable g1) (m2 : Measurable g2) (m3 : Measurable g3) (l0 : MemLp g0 2 fastHaar)
    (l1 : MemLp g1 2 fastHaar) (l2 : MemLp g2 2 fastHaar) (l3 : MemLp g3 2 fastHaar) :
    ‖∫ x, g0 (fastCoord 0 x) * g1 (fastCoord 1 x) * g2 (fastCoord 2 x) * g3 (fastCoord 3 x)
      ∂(fastHaar.prod fastHaar)‖ ≤ (eLpNorm g0 2 fastHaar).toReal *
        (eLpNorm g1 2 fastHaar).toReal * (eLpNorm g2 2 fastHaar).toReal *
          (eLpNorm g3 2 fastHaar).toReal := by
  have := norm_fast_form_le ![g0, g1, g2, g3] (fun j => by fin_cases j <;> assumption)
    (fun j => by fin_cases j <;> assumption)
  simp_rw [fast_prod_four, Fin.prod_univ_four] at this
  exact this

/-- Blueprint lines 2324-2325 ("the `L²` progression estimate passes to limits"): the fast form of
one slow tuple is continuous in `L²` of each slot. -/
theorem fast_form_tendsto (g : Fin 4 → FastCircle → ℂ) (gN : ℕ → Fin 4 → FastCircle → ℂ)
    (hg : ∀ j, Measurable (g j)) (hgN : ∀ N j, Measurable (gN N j))
    (hL : ∀ j, MemLp (g j) 2 fastHaar) (hLN : ∀ N j, MemLp (gN N j) 2 fastHaar)
    (hconv : ∀ j, Filter.Tendsto (fun N => eLpNorm (gN N j - g j) 2 fastHaar) Filter.atTop
      (nhds 0)) :
    Filter.Tendsto (fun N => ∫ x, ∏ j : Fin 4, gN N j (fastCoord j x) ∂(fastHaar.prod fastHaar))
      Filter.atTop (nhds (∫ x, ∏ j : Fin 4, g j (fastCoord j x) ∂(fastHaar.prod fastHaar))) := by
  set d : Fin 4 → ℕ → ℝ := fun j N => (eLpNorm (gN N j - g j) 2 fastHaar).toReal
  set b : Fin 4 → ℝ := fun j => (eLpNorm (g j) 2 fastHaar).toReal
  have hd : ∀ j, Filter.Tendsto (d j) Filter.atTop (nhds 0) := fun j => by
    have := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp (hconv j)
    rw [ENNReal.toReal_zero] at this
    exact this
  have hn : ∀ N j, (eLpNorm (gN N j) 2 fastHaar).toReal ≤ d j N + b j := by
    intro N j
    have e : gN N j = (gN N j - g j) + g j := by abel
    have := eLpNorm_add_le (f := gN N j - g j) (g := g j) (μ := fastHaar)
      (by norm_num : (1 : ℝ≥0∞) ≤ 2)
    rw [← e] at this
    rw [← ENNReal.toReal_add ((hLN N j).sub (hL j)).eLpNorm_ne_top (hL j).eLpNorm_ne_top]
    exact ENNReal.toReal_mono (ENNReal.add_ne_top.mpr ⟨((hLN N j).sub (hL j)).eLpNorm_ne_top,
      (hL j).eLpNorm_ne_top⟩) this
  have hb0 : ∀ j, 0 ≤ b j := fun j => ENNReal.toReal_nonneg
  have hd0 : ∀ j N, 0 ≤ d j N := fun j N => ENNReal.toReal_nonneg
  -- the four telescoping terms
  have hbound : ∀ N, ‖(∫ x, ∏ j : Fin 4, gN N j (fastCoord j x) ∂(fastHaar.prod fastHaar)) -
      ∫ x, ∏ j : Fin 4, g j (fastCoord j x) ∂(fastHaar.prod fastHaar)‖ ≤
      d 0 N * (d 1 N + b 1) * (d 2 N + b 2) * (d 3 N + b 3) +
      b 0 * d 1 N * (d 2 N + b 2) * (d 3 N + b 3) + b 0 * b 1 * d 2 N * (d 3 N + b 3) +
      b 0 * b 1 * b 2 * d 3 N := by
    intro N
    have he : ∀ j, Measurable (gN N j - g j) := fun j => (hgN N j).sub (hg j)
    have heL : ∀ j, MemLp (gN N j - g j) 2 fastHaar := fun j => (hLN N j).sub (hL j)
    simp_rw [fast_prod_four]
    have htel : ∀ x : FastCircle × FastCircle,
        gN N 0 (fastCoord 0 x) * gN N 1 (fastCoord 1 x) * gN N 2 (fastCoord 2 x) *
          gN N 3 (fastCoord 3 x) - g 0 (fastCoord 0 x) * g 1 (fastCoord 1 x) *
          g 2 (fastCoord 2 x) * g 3 (fastCoord 3 x) =
        (gN N 0 - g 0) (fastCoord 0 x) * gN N 1 (fastCoord 1 x) * gN N 2 (fastCoord 2 x) *
          gN N 3 (fastCoord 3 x) +
        g 0 (fastCoord 0 x) * (gN N 1 - g 1) (fastCoord 1 x) * gN N 2 (fastCoord 2 x) *
          gN N 3 (fastCoord 3 x) +
        g 0 (fastCoord 0 x) * g 1 (fastCoord 1 x) * (gN N 2 - g 2) (fastCoord 2 x) *
          gN N 3 (fastCoord 3 x) +
        g 0 (fastCoord 0 x) * g 1 (fastCoord 1 x) * g 2 (fastCoord 2 x) *
          (gN N 3 - g 3) (fastCoord 3 x) := by
      intro x; simp only [Pi.sub_apply]; ring
    have I0 := fast_form_integrable4 (he 0) (hgN N 1) (hgN N 2) (hgN N 3) (heL 0) (hLN N 1)
      (hLN N 2) (hLN N 3)
    have I1 := fast_form_integrable4 (hg 0) (he 1) (hgN N 2) (hgN N 3) (hL 0) (heL 1)
      (hLN N 2) (hLN N 3)
    have I2 := fast_form_integrable4 (hg 0) (hg 1) (he 2) (hgN N 3) (hL 0) (hL 1)
      (heL 2) (hLN N 3)
    have I3 := fast_form_integrable4 (hg 0) (hg 1) (hg 2) (he 3) (hL 0) (hL 1) (hL 2) (heL 3)
    rw [← integral_sub (fast_form_integrable4 (hgN N 0) (hgN N 1) (hgN N 2) (hgN N 3)
      (hLN N 0) (hLN N 1) (hLN N 2) (hLN N 3))
      (fast_form_integrable4 (hg 0) (hg 1) (hg 2) (hg 3) (hL 0) (hL 1) (hL 2) (hL 3))]
    simp_rw [htel]
    rw [integral_add ?_ I3, integral_add ?_ I2, integral_add I0 I1]
    rotate_left
    · exact I0.add I1
    · exact (I0.add I1).add I2
    have e0 := norm_fast_form_le4 (he 0) (hgN N 1) (hgN N 2) (hgN N 3) (heL 0) (hLN N 1)
      (hLN N 2) (hLN N 3)
    have e1 := norm_fast_form_le4 (hg 0) (he 1) (hgN N 2) (hgN N 3) (hL 0) (heL 1)
      (hLN N 2) (hLN N 3)
    have e2 := norm_fast_form_le4 (hg 0) (hg 1) (he 2) (hgN N 3) (hL 0) (hL 1)
      (heL 2) (hLN N 3)
    have e3 := norm_fast_form_le4 (hg 0) (hg 1) (hg 2) (he 3) (hL 0) (hL 1) (hL 2) (heL 3)
    have n1 := hn N 1; have n2 := hn N 2; have n3 := hn N 3
    have p1 : 0 ≤ (eLpNorm (gN N 1) 2 fastHaar).toReal := ENNReal.toReal_nonneg
    have p2 : 0 ≤ (eLpNorm (gN N 2) 2 fastHaar).toReal := ENNReal.toReal_nonneg
    have p3 : 0 ≤ (eLpNorm (gN N 3) 2 fastHaar).toReal := ENNReal.toReal_nonneg
    have q0 := hd0 0 N; have q1 := hd0 1 N; have q2 := hd0 2 N; have q3 := hd0 3 N
    have r0 := hb0 0; have r1 := hb0 1; have r2 := hb0 2
    have f0 : d 0 N * (eLpNorm (gN N 1) 2 fastHaar).toReal * (eLpNorm (gN N 2) 2 fastHaar).toReal *
