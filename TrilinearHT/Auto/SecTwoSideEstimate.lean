/-- Hölder over positions in `ℝ≥0∞` (blueprint line 2368): for `p > 2`,
`Σ_i x_i^{1/p} y_i^{1/p} ≤ J^{1 - 2/p} ((Σ x)^{1/2} (Σ y)^{1/2})^{2/p}`. -/
theorem ennreal_position_holder {ι : Type*} (s : Finset ι) (x y : ι → ℝ≥0∞) {p : ℝ}
    (hp : 2 < p) :
    ∑ i ∈ s, x i ^ (1 / p) * y i ^ (1 / p) ≤ (s.card : ℝ≥0∞) ^ (1 - 2 / p) *
      ((∑ i ∈ s, x i) ^ (1 / 2 : ℝ) * (∑ i ∈ s, y i) ^ (1 / 2 : ℝ)) ^ (2 / p) := by
  have hp0 : 0 < p := by linarith
  have h1 : 1 < p / 2 := by linarith
  have hH := Real.HolderConjugate.conjExponent h1
  set f : ι → ℝ≥0∞ := fun i => (x i ^ (1 / 2 : ℝ) * y i ^ (1 / 2 : ℝ)) ^ (2 / p)
  have hf : ∀ i, x i ^ (1 / p) * y i ^ (1 / p) = f i := by
    intro i
    simp only [f]
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
    congr 2 <;> field_simp
  simp_rw [hf]
  have h := ENNReal.inner_le_Lp_mul_Lq s f (fun _ => 1) hH
  simp only [mul_one, ENNReal.one_rpow, Finset.sum_const, nsmul_eq_mul] at h
  have hconj : 1 / Real.conjExponent (p / 2) = 1 - 2 / p := by
    unfold Real.conjExponent; field_simp
  have hfp : ∀ i, f i ^ (p / 2) = x i ^ (1 / 2 : ℝ) * y i ^ (1 / 2 : ℝ) := by
    intro i; simp only [f]; rw [← ENNReal.rpow_mul]; field_simp; simp
  simp_rw [hfp] at h
  rw [hconj, show 1 / (p / 2) = 2 / p by field_simp] at h
  refine h.trans ?_
  rw [mul_comm]
  gcongr
  exact ennreal_sum_sqrt_mul_le s x y

namespace ShortBlockTree

variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K)

/-- Within a level, the heavy masks of distinct valid rectangles are disjoint, so their measures
add up to at most the root length. -/
theorem sum_heavy_mask_le (F : Finset DepthRect) (hF : ∀ R ∈ F, DepthRect.Valid R)
    (key : DepthRect) :
    ∑ R ∈ F.filter (fun R => DepthRect.level R = key), volume (T.mask R (DepthRect.heavy R)) ≤
      volume (dyadicGridCell G T.root.1 T.root.2) := by
  classical
  rw [← measure_biUnion_finset (fun R hR R' hR' hne => ?_)
    (fun R _ => T.measurableSet_mask R _)]
  · exact measure_mono (Set.iUnion₂_subset fun R _ => T.mask_subset_root R _)
  · refine Set.disjoint_left.mpr fun y hy hy' => ?_
    have hr := T.mask_subset_root R _ hy
    have hRF := Finset.mem_filter.mp hR
    have hRF' := Finset.mem_filter.mp hR'
    exact DepthRect.heavy_disjoint (hF R hRF.1) (hRF.2.trans hRF'.2.symm) hne
      ((T.mem_mask_iff hr).mp hy) ((T.mem_mask_iff hr).mp hy')

/-- Within a level, the designated masks are disjoint. -/
theorem sum_desig_mask_le (F : Finset DepthRect) (hF : ∀ R ∈ F, DepthRect.Valid R)
    (key : DepthRect) :
    ∑ R ∈ F.filter (fun R => DepthRect.level R = key), volume (T.mask R (DepthRect.desig R)) ≤
      volume (dyadicGridCell G T.root.1 T.root.2) := by
  classical
  rw [← measure_biUnion_finset (fun R hR R' hR' hne => ?_)
    (fun R _ => T.measurableSet_mask R _)]
  · exact measure_mono (Set.iUnion₂_subset fun R _ => T.mask_subset_root R _)
  · refine Set.disjoint_left.mpr fun y hy hy' => ?_
    have hr := T.mask_subset_root R _ hy
    have hRF := Finset.mem_filter.mp hR
    have hRF' := Finset.mem_filter.mp hR'
    exact DepthRect.desig_disjoint (hF R hRF.1) (hRF.2.trans hRF'.2.symm) hne
      ((T.mem_mask_iff hr).mp hy) ((T.mem_mask_iff hr).mp hy')

theorem volume_mask_le_root (R : DepthRect) (j : Fin 4) :
    volume (T.mask R j) ≤ volume (dyadicGridCell G T.root.1 T.root.2) :=
  measure_mono (T.mask_subset_root R j)

theorem volume_mask_ne_top (R : DepthRect) (j : Fin 4) : volume (T.mask R j) ≠ ⊤ :=
  ((T.volume_mask_le_root R j).trans_lt (by
    rw [dyadicGridCell_volume]; exact ENNReal.ofReal_lt_top)).ne

end ShortBlockTree

namespace BlockData

variable {κ : LocalKernelClass} {Ω : Type*} [MeasurableSpace Ω] (D : BlockData κ Ω)

/-- Summing the local masses over the cells costs the number of depths:
`Σ_I ∫_I Z_j² ≤ #depths · ∫ Z_j²`. -/
theorem sum_cells_mass_le (j : Fin 4) :
    ∑ I ∈ D.cells, ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
      ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) ≤
      ((D.cells.image Prod.fst).card : ℝ≥0∞) * ∫⁻ y, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) := by
  classical
  rw [← Finset.sum_fiberwise_of_maps_to (g := Prod.fst) (t := D.cells.image Prod.fst)
    (fun I hI => Finset.mem_image_of_mem _ hI)]
  calc ∑ s ∈ D.cells.image Prod.fst, ∑ I ∈ D.cells with I.1 = s,
        ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I), ENNReal.ofReal (D.Z j y) ^ (2 : ℝ)
      ≤ ∑ _s ∈ D.cells.image Prod.fst, ∫⁻ y, ENNReal.ofReal (D.Z j y) ^ (2 : ℝ) :=
        Finset.sum_le_sum fun s _ => D.sum_depth_le s _
    _ = _ := by rw [Finset.sum_const, nsmul_eq_mul]

end BlockData

theorem main_factor_le {p : ℝ} (hp : 2 ≤ p) {Cm Cmax B M C : ℝ≥0∞} (hC : Cm ≤ Cmax) :
    Cm * ((1 / 8 : ℝ≥0∞) * 2 ^ (p / 4) * C ^ p * B ^ (p - 2) * M) ^ (1 / p) ≤
      Cmax * (2 ^ (1 / 4 : ℝ) * C) * B ^ ((p - 2) / p) * M ^ (1 / p) := by
  have hp0 : 0 < p := by linarith
  have hp1 : (0 : ℝ) ≤ 1 / p := by positivity
  rw [ENNReal.mul_rpow_of_nonneg _ _ hp1, ENNReal.mul_rpow_of_nonneg _ _ hp1,
    ENNReal.mul_rpow_of_nonneg _ _ hp1, ENNReal.mul_rpow_of_nonneg _ _ hp1,
    ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
    show p / 4 * (1 / p) = 1 / 4 by field_simp, show p * (1 / p) = 1 by field_simp,
    show (p - 2) * (1 / p) = (p - 2) / p by ring, ENNReal.rpow_one]
  have h8 : (1 / 8 : ℝ≥0∞) ^ (1 / p) ≤ 1 :=
    ENNReal.rpow_le_one (by norm_num) hp1
  calc Cm * ((1 / 8 : ℝ≥0∞) ^ (1 / p) * 2 ^ (1 / 4 : ℝ) * C * B ^ ((p - 2) / p) * M ^ (1 / p))
      ≤ Cmax * (1 * 2 ^ (1 / 4 : ℝ) * C * B ^ ((p - 2) / p) * M ^ (1 / p)) := by gcongr
    _ = _ := by ring

theorem rpow_le_self_of_one_le {E : ℝ≥0∞} (hE : 1 ≤ E) {e : ℝ} (he1 : e ≤ 1) :
    E ^ e ≤ E := by
  calc E ^ e ≤ E ^ (1 : ℝ) := ENNReal.rpow_le_rpow_of_exponent_le hE he1
    _ = E := ENNReal.rpow_one E

/-- The main-term product of a rectangle (blueprint lines 2362-2368): with exponents `p_*` in the
heavy slot `a` and designated slot `b`, `p` elsewhere, heavy window bound `A`, regular bound
`E ≥ 1` and masks of measure at most `|R|`. -/
theorem main_prod_le {a b : Fin 4} (hab : a ≠ b) (p : Fin 4 → ℝ) {ps pd : ℝ}
    (hps : 2 ≤ ps) (hpd : 2 ≤ pd) (hpa : p a = ps) (hpb : p b = ps)
    (hpo : ∀ j, j ≠ a → j ≠ b → p j = pd) (Cm : Fin 4 → ℝ≥0∞) {Cmax : ℝ≥0∞}
    (hCm : ∀ j, Cm j ≤ Cmax) (B : Fin 4 → ℝ≥0∞) {A' E : ℝ≥0∞} (hBa : B a = A') (hE : 1 ≤ E)
    (hBo : ∀ j, j ≠ a → B j = E) (M : Fin 4 → ℝ≥0∞) {Rv : ℝ≥0∞} (hM : ∀ j, M j ≤ Rv)
    (C : ℝ≥0∞) :
    ∏ j, (Cm j * ((1 / 8 : ℝ≥0∞) * 2 ^ (p j / 4) * C ^ p j * B j ^ (p j - 2) * M j) ^
      (1 / p j)) ≤
      (Cmax * (2 ^ (1 / 4 : ℝ) * C)) ^ 4 * (A' ^ ((ps - 2) / ps) * E ^ 3) *
        (M a ^ (1 / ps) * M b ^ (1 / ps) * (Rv ^ (1 / pd)) ^ 2) := by
  classical
  have hp2 : ∀ j, 2 ≤ p j := fun j => by
    by_cases ha : j = a
    · rw [ha, hpa]; exact hps
    · by_cases hb : j = b
      · rw [hb, hpb]; exact hps
      · rw [hpo j ha hb]; exact hpd
  calc ∏ j, (Cm j * ((1 / 8 : ℝ≥0∞) * 2 ^ (p j / 4) * C ^ p j * B j ^ (p j - 2) * M j) ^
        (1 / p j))
      ≤ ∏ j, (Cmax * (2 ^ (1 / 4 : ℝ) * C) * B j ^ ((p j - 2) / p j) * M j ^ (1 / p j)) :=
        Finset.prod_le_prod fun j _ => main_factor_le (hp2 j) (hCm j)
    _ = (Cmax * (2 ^ (1 / 4 : ℝ) * C)) ^ 4 * (∏ j, B j ^ ((p j - 2) / p j)) *
          ∏ j, M j ^ (1 / p j) := by
        rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ,
          Fintype.card_fin]
    _ ≤ _ := by
        gcongr
        · refine prod_ite_le_four (a := a) (le_of_eq ?_) fun j hj => ?_
          · rw [hBa, hpa]
          · rw [hBo j hj]
            have := hp2 j
            have hp0 : 0 < p j := by linarith
            exact rpow_le_self_of_one_le hE ((div_le_one hp0).mpr (by linarith))
        · rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ a),
            ← Finset.mul_prod_erase _ _ (Finset.mem_erase.mpr ⟨hab.symm, Finset.mem_univ b⟩),
            hpa, hpb, ← mul_assoc]
          gcongr
          calc ∏ j ∈ (Finset.univ.erase a).erase b, M j ^ (1 / p j)
              ≤ ∏ _j ∈ (Finset.univ.erase a).erase b, Rv ^ (1 / pd) :=
                Finset.prod_le_prod fun j hj => by
                  have hjb := Finset.ne_of_mem_erase hj
                  have hja := Finset.ne_of_mem_erase (Finset.mem_of_mem_erase hj)
                  rw [hpo j hja hjb]
                  exact ENNReal.rpow_le_rpow (hM j) (by have := hpd; positivity)
            _ = _ := by
                rw [Finset.prod_const, Finset.card_erase_of_mem
                  (Finset.mem_erase.mpr ⟨hab.symm, Finset.mem_univ b⟩),
                  Finset.card_erase_of_mem (Finset.mem_univ a), Finset.card_univ,
                  Fintype.card_fin]

namespace ShortBlockTree

variable {G : RealDyadicGrid} {K : ℕ} (T : ShortBlockTree G K) (κ : LocalKernelClass)
  (cells : Finset (ℤ × ℤ)) (hcells : cells ⊆ T.internal) (kernel : ℤ × ℤ → ℝ × ℝ → ℂ)
  (hker : ∀ I ∈ T.internal, IsAdmissibleLocalKernel κ (dyadicGridLeft G I.1 I.2)
    (dyadicGridLength G I.1) (kernel I))
  {Ω : Type*} [MeasurableSpace Ω] {E : Type*} [NormedAddCommGroup E] (z : Fin 4 → ℝ → E)
  (hz : ∀ j, Measurable fun y => ‖z j y‖) (zσ : Fin 4 → Ω → ℝ → ℂ)
  (hzσ : ∀ j, Measurable (Function.uncurry (zσ j)))

theorem one_le_regE2 : 1 ≤ regE2 κ := by
  unfold regE2
  have hb := beta_pos κ
  have hb1 : beta κ ≤ 1 / 16 := by
    unfold beta; have := min_le_right κ.margin 1; linarith
  have : 2 ≤ 1 / (8 * beta κ) := by rw [le_div_iff₀ (by positivity)]; linarith
  linarith

theorem card_rect_depths_le (R : DepthRect) :
    ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).cells.image Prod.fst).card ≤ K := by
  classical
  calc ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).cells.image Prod.fst).card
      ≤ (Finset.Ico T.first (T.first + K)).card := by
        refine Finset.card_le_card fun s hs => ?_
        obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hs
        have := T.internal_depth I (hcells (Finset.mem_filter.mp hI).1)
        exact Finset.mem_Ico.mpr this
    _ = K := by simp

open Auto.ClassicalMaximal in
/-- The bound of one leaf-depth rectangle in a form uniform over the rectangles. -/
theorem rect_simplified (hL : T.LeafBound z) (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hC4 : 0 ≤ C4) (hmom : ∀ j y, (∫⁻ σ, ‖zσ j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ‖z j y‖ₑ)
    (ε : ℤ × ℤ → Ω → ℂ) (hε : ∀ I, Measurable (ε I)) (hε1 : ∀ I σ, ‖ε I σ‖ ≤ 1)
    {q : ℝ} (hq : 2 < q) {Nd : ℕ} (hKN : K ≤ Nd) (Cs Cd : ℝ≥0∞)
    (hCs : ∀ f : ℝ × ((Ω × ℝ) × FastCircle) → ℂ, Measurable f →
      mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (pStar q) 4 (maximalQ q f) ≤
        Cs * mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (pStar q) 4
          (fun z => ‖f z‖ₑ))
    (hCd : ∀ f : ℝ × ((Ω × ℝ) × FastCircle) → ℂ, Measurable f →
      mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (pReg q) 4 (maximalQ q f) ≤
        Cd * mixedENorm volume ((P.prod gammaMeasure).prod fastHaar) (pReg q) 4
          (fun z => ‖f z‖ₑ))
    {R : DepthRect} (hv : DepthRect.Valid R) :
    ∫⁻ σ, ‖(T.rectData κ cells hcells kernel hker z hz zσ hzσ R).total ε σ‖ₑ ∂P ≤
      (ENNReal.ofReal (4 * admissibleLipConst κ * C4 ^ 4) +
        ENNReal.ofReal (256 / (volume (offsetPolygon (1 / 8))).toReal) *
          (ENNReal.ofReal (4 * admissibleLipConst κ) * BlockData.err2Const C4 ^ 2)) *
        (volume (T.mask R (DepthRect.heavy R)) ^ (1 / 2 : ℝ) *
          volume (T.mask R (DepthRect.desig R)) ^ (1 / 2 : ℝ)) +
      4 * ENNReal.ofReal (256 * localKernelSupBound κ) * BlockData.regConst C4 (regE2 κ) ^ 3 *
        ENNReal.ofReal C4 * (ENNReal.ofReal ((K : ℝ) + 2))⁻¹ *
          ((K : ℝ≥0∞) * volume (T.mask R (DepthRect.heavy R))) +
      ENNReal.ofReal (256 / (volume (offsetPolygon (1 / 8))).toReal) *
        ENNReal.ofReal (finiteDepthConstant κ q Nd) *
        ((max Cs Cd * (2 ^ (1 / 4 : ℝ) * ENNReal.ofReal C4)) ^ 4 *
          (ENNReal.ofReal ((K : ℝ) + 2) ^ ((pStar q - 2) / pStar q) *
            (ENNReal.ofReal (regE2 κ) ^ (1 / 2 : ℝ)) ^ 3)) *
        (volume (T.mask R (DepthRect.heavy R)) ^ (1 / pStar q) *
          volume (T.mask R (DepthRect.desig R)) ^ (1 / pStar q) *
          (volume (dyadicGridCell G T.root.1 T.root.2) ^ (1 / pReg q)) ^ 2) := by
  classical
  set D := T.rectData κ cells hcells kernel hker z hz zσ hzσ R
  have hab : DepthRect.heavy R ≠ DepthRect.desig R := (DepthRect.desig_ne_heavy hv).symm
  have hMj : ∀ j, ENNReal.ofReal (volume (T.mask R j)).toReal = volume (T.mask R j) :=
    fun j => ENNReal.ofReal_toReal (T.volume_mask_ne_top R j)
  have h := T.rect_apply κ cells hcells kernel hker z hz zσ hzσ hL P hC4 hmom ε hε hε1 hq hKN
    Cs Cd hCs hCd hv
  simp only [hMj] at h
  refine h.trans ?_
  have hY : ∑ I ∈ D.cells, ∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
      ENNReal.ofReal (D.Z (DepthRect.heavy R) y) ^ (2 : ℝ) ≤
      (K : ℝ≥0∞) * volume (T.mask R (DepthRect.heavy R)) := by
    refine (D.sum_cells_mass_le _).trans ?_
    gcongr
    · exact_mod_cast T.card_rect_depths_le κ cells hcells kernel hker z hz zσ hzσ R
    · have := T.rect_mass κ cells hcells kernel hker z hz zσ hzσ hL R (DepthRect.heavy R)
      rwa [hMj] at this
  have hE0 : (1 : ℝ≥0∞) ≤ ENNReal.ofReal (regE2 κ) := by
    rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal (one_le_regE2 κ)
  have hE1 : 1 ≤ ENNReal.ofReal (regE2 κ) ^ (1 / 2 : ℝ) :=
    ENNReal.one_le_rpow hE0 (by norm_num)
  have hP := main_prod_le (Cmax := max Cs Cd) (A' := ENNReal.ofReal ((K : ℝ) + 2))
    (E := ENNReal.ofReal (regE2 κ) ^ (1 / 2 : ℝ))
    (Rv := volume (dyadicGridCell G T.root.1 T.root.2)) hab (pexp q R)
    (two_le_pStar hq) (two_le_pReg hq)
    (by unfold pexp; simp) (by unfold pexp; simp)
    (fun j ha hb => by unfold pexp; simp [ha, hb])
    (fun j => if j = DepthRect.heavy R ∨ j = DepthRect.desig R then Cs else Cd)
    (fun j => by split_ifs; exacts [le_max_left _ _, le_max_right _ _])
    (fun j => if j = DepthRect.heavy R then ENNReal.ofReal ((K : ℝ) + 2)
      else ENNReal.ofReal (regE2 κ) ^ (1 / 2 : ℝ)) (by simp) hE1
    (fun j hj => by simp [hj]) (fun j => volume (T.mask R j))
    (fun j => T.volume_mask_le_root R j) (ENNReal.ofReal C4)
  calc _ ≤ ENNReal.ofReal (4 * admissibleLipConst κ * C4 ^ 4) *
        volume (T.mask R (DepthRect.heavy R)) ^ (1 / 2 : ℝ) *
        volume (T.mask R (DepthRect.desig R)) ^ (1 / 2 : ℝ) +
      (4 * ENNReal.ofReal (256 * localKernelSupBound κ) * BlockData.regConst C4 (regE2 κ) ^ 3 *
        ENNReal.ofReal C4 * (ENNReal.ofReal ((K : ℝ) + 2))⁻¹ *
          ((K : ℝ≥0∞) * volume (T.mask R (DepthRect.heavy R))) +
      ENNReal.ofReal (256 / (volume (offsetPolygon (1 / 8))).toReal) *
        (ENNReal.ofReal (finiteDepthConstant κ q Nd) *
          ((max Cs Cd * (2 ^ (1 / 4 : ℝ) * ENNReal.ofReal C4)) ^ 4 *
            (ENNReal.ofReal ((K : ℝ) + 2) ^ ((pStar q - 2) / pStar q) *
              (ENNReal.ofReal (regE2 κ) ^ (1 / 2 : ℝ)) ^ 3) *
            (volume (T.mask R (DepthRect.heavy R)) ^ (1 / pStar q) *
              volume (T.mask R (DepthRect.desig R)) ^ (1 / pStar q) *
              (volume (dyadicGridCell G T.root.1 T.root.2) ^ (1 / pReg q)) ^ 2)) +
        ENNReal.ofReal (4 * admissibleLipConst κ) * BlockData.err2Const C4 ^ 2 *
          (volume (T.mask R (DepthRect.heavy R)) ^ (1 / 2 : ℝ) *
            volume (T.mask R (DepthRect.desig R)) ^ (1 / 2 : ℝ)))) := by
        gcongr
    _ = _ := by ring

