  (hzσ : ∀ j, Measurable (Function.uncurry (zσ j)))

/-- The regular window constant `E₂ = 1/2 + 1/(8β)`. -/
noncomputable def regE2 : ℝ := 1 / 2 + 1 / (8 * beta κ)

theorem rect_mom (P : Measure Ω) {C4 : ℝ}
    (hmom : ∀ j y, (∫⁻ σ, ‖zσ j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ‖z j y‖ₑ) (R : DepthRect) (j : Fin 4) (y : ℝ) :
    (∫⁻ σ, ‖(T.rectData κ cells hcells kernel hker z hz zσ hzσ R).z j σ y‖ₑ ^ (4 : ℝ) ∂P) ^
      (1 / 4 : ℝ) ≤ ENNReal.ofReal C4 *
        ENNReal.ofReal ((T.rectData κ cells hcells kernel hker z hz zσ hzσ R).Z j y) := by
  classical
  simp only [rectData]
  by_cases hy : y ∈ T.mask R j
  · simp only [hy, Set.indicator_of_mem, Pi.one_apply, mul_one, ofReal_norm]
    exact hmom j y
  · simp only [hy, not_false_eq_true, Set.indicator_of_notMem, mul_zero, enorm_zero]
    rw [lintegral_congr fun _ => ENNReal.zero_rpow_of_pos (by norm_num), lintegral_zero,
      ENNReal.zero_rpow_of_pos (by norm_num)]
    exact zero_le

open Auto.ClassicalMaximal in
/-- `rect_bound` instantiated at a leaf-depth rectangle of the tree piece. -/
theorem rect_apply (hL : T.LeafBound z) (P : Measure Ω) [IsProbabilityMeasure P] {C4 : ℝ}
    (hC4 : 0 ≤ C4) (hmom : ∀ j y, (∫⁻ σ, ‖zσ j σ y‖ₑ ^ (4 : ℝ) ∂P) ^ (1 / 4 : ℝ) ≤
      ENNReal.ofReal C4 * ‖z j y‖ₑ)
    (ε : ℤ × ℤ → Ω → ℂ) (hε : ∀ I, Measurable (ε I)) (hε1 : ∀ I σ, ‖ε I σ‖ ≤ 1)
    {q : ℝ} (hq : 2 < q) {Nd : ℕ} (hKN : K ≤ Nd) (Cs Cd : ℝ≥0∞)
    (hCs : ∀ f : ℝ × ((Ω × ℝ) × FastCircle) → ℂ, Measurable f →
