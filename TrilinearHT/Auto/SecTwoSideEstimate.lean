theorem measurable_multWith_joint (N : ℕ) (w : Fin 4 → ℤ → ℂ) (j : Fin 4) (m : ℤ) :
    Measurable fun z : (Ω × ℝ) × FastCircle => D.multWith N w z.1.2 z.1.1 j m z.2 := by
