                · -- the second sampling error
                  have hsplit : ∫⁻ σ, ∫⁻ γ, ∫⁻ x, Ep ((σ, γ), x) ∂(fastHaar.prod fastHaar)
                      ∂gammaMeasure ∂P = ∑ I ∈ D.cells, ∫⁻ σ, ∫⁻ γ, ∫⁻ x,
                        ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N (wRet a keep) γ σ x)‖ₑ
                          ∂(fastHaar.prod fastHaar) ∂gammaMeasure ∂P := by
                    simp only [hEpdef]
                    have g1 : ∀ I ∈ D.cells, Measurable fun σ => ∫⁻ γ, ∫⁻ x,
                        ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N (wRet a keep) γ σ x)‖ₑ
                          ∂(fastHaar.prod fastHaar) ∂gammaMeasure :=
                      fun I hI => by
                        have h := ((hEp I hI).lintegral_prod_right'
                          (ν := fastHaar.prod fastHaar)).lintegral_prod_right' (ν := gammaMeasure)
                        exact h
                    have g2 : ∀ σ, ∀ I ∈ D.cells, Measurable fun γ => ∫⁻ x,
                        ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N (wRet a keep) γ σ x)‖ₑ
                          ∂(fastHaar.prod fastHaar) :=
                      fun σ I hI => by
                        have h := ((hEp I hI).lintegral_prod_right'
                          (ν := fastHaar.prod fastHaar)).comp (measurable_prodMk_left (x := σ))
                        exact h
                    have g3 : ∀ (q : Ω × ℝ), ∀ I ∈ D.cells, Measurable fun x =>
                        ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N (wRet a keep) q.2 q.1 x)‖ₑ :=
                      fun q I hI => by
                        have h := (hEp I hI).comp (measurable_prodMk_left (x := q)); exact h
                    rw [← lintegral_finsetSum _ g1]
                    refine lintegral_congr fun σ => ?_
                    rw [← lintegral_finsetSum _ (g2 σ)]
                    refine lintegral_congr fun γ => ?_
                    rw [← lintegral_finsetSum _ (g3 (σ, γ))]
                  rw [hsplit]
                  calc ∑ I ∈ D.cells, ∫⁻ σ, ∫⁻ γ, ∫⁻ x,
                        ENNReal.ofReal (D.len I) * ‖D.err2 I (D.gin N (wRet a keep) γ σ x)‖ₑ
                          ∂(fastHaar.prod fastHaar) ∂gammaMeasure ∂P
                      ≤ ∑ I ∈ D.cells, ENNReal.ofReal (4 * admissibleLipConst κ) *
                          err2Const C4 ^ 2 * (ENNReal.ofReal (D.δ / D.len I) *
                            ((∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
                              ENNReal.ofReal (D.Z a y) ^ (2 : ℝ)) ^ (1 / 2 : ℝ) *
                            (∫⁻ y in Set.Icc (D.left I) (D.left I + D.len I),
                              ENNReal.ofReal (D.Z b y) ^ (2 : ℝ)) ^ (1 / 2 : ℝ))) :=
                        Finset.sum_le_sum fun I hI => D.err2_cell_bound P hmom N _
                          (fun j m => norm_wRet_le a keep j m) hI hab (hloc I hI)
                    _ ≤ _ := by
                        rw [← Finset.mul_sum]
                        gcongr
