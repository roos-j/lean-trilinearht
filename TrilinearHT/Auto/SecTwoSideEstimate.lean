/-- The fourth power of the local `L⁴` norm: `‖g‖₄⁴ = ε Σ_m ∫ g(m, ·)⁴`. -/
theorem latticeCircle_eLpNorm_four (ε : ℝ≥0∞) {g : ℤ × FastCircle → ℝ≥0∞} (hg : Measurable g) :
    eLpNorm g 4 (latticeCircleMeasure ε) ^ (4 : ℝ) =
