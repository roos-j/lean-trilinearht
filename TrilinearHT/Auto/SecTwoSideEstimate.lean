    (h2.add_const (b 2))).mul (h3.add_const (b 3))))).add
    ((((tendsto_const_nhds (x := b 0 * b 1)).mul h2).mul (h3.add_const (b 3)))) |>.add
    ((tendsto_const_nhds (x := b 0 * b 1 * b 2)).mul h3)
