    _ = ∑ m ∈ TJ, ENNReal.ofReal (2 * (c * δ)) * ‖G m‖ₑ ^ (2 : ℝ) := by
        rw [lintegral_finsetSum _ fun m _ => measurable_const.indicator measurableSet_ball]
