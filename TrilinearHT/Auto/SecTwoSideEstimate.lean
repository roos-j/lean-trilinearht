/-- Minkowski's inequality in `L²` for finite sums of nonnegative functions. -/
theorem lintegral_finset_sum_sq_le {α ι : Type*} [MeasurableSpace α] (μ : Measure α)
    (s : Finset ι) (f : ι → α → ℝ≥0∞) (hf : ∀ i, AEMeasurable (f i) μ) :
    (∫⁻ x, (∑ i ∈ s, f i x) ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) ≤
      ∑ i ∈ s, (∫⁻ x, f i x ^ (2 : ℝ) ∂μ) ^ (1 / 2 : ℝ) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    rw [lintegral_congr fun x => ENNReal.zero_rpow_of_pos (by norm_num), lintegral_zero,
      ENNReal.zero_rpow_of_pos (by norm_num)]
  | insert i s hi ih =>
    simp_rw [Finset.sum_insert hi]
    have hs : AEMeasurable (fun x => ∑ k ∈ s, f k x) μ :=
      Finset.aemeasurable_fun_sum _ fun k _ => hf k
    have h := ENNReal.lintegral_Lp_add_le (hf i) hs (by norm_num : (1 : ℝ) ≤ 2)
    exact h.trans (add_le_add le_rfl ih)

