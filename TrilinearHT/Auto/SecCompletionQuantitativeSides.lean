      ∑ o ∈ Finset.range 5, (((2 : ℂ) - o) / P) * ∑ p ∈ (Finset.range (P + 1)).filter
        (fun p => 2 ≤ p + o ∧ p + o - 2 ≤ P),
        Λ (Function.update (Function.update (Function.update
          (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
            (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
              (st.2.2 (p + o - 2 + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
                st.2.2 (p + o - 2) (chainVal P st.1 rest (if st.1 then yc else yd)))) := by
  unfold defTerm
  have h := near_pairs_offsets (M := ℂ) P (fun p q => Λ (Function.update (Function.update
    (Function.update (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd))
      a (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
        (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
          st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd)))))
  simp only [smul_eq_mul] at h
  exact h

end NearTerm

