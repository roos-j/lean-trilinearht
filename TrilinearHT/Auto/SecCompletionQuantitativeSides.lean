/-- The glued stack over a smaller family of cells is smaller. -/
theorem gluedStack_norm_sq_mono (G : RealDyadicGrid) {V : Type*} [Fintype V] {ι : Type*}
    {U U' : Finset (ℤ × ℤ)} (hUU : U' ⊆ U) (sel : ℤ × ℤ → ι) (val : ι → ColumnL2 V) (i : ι) :
