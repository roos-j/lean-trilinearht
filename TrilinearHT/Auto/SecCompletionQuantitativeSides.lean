/-- Collapsing the block and group indices of the uses of a cell. -/
theorem sum_Ms_collapse (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (gset : Finset A.Grp)
    (Lp Jm Bn : ℕ) (C₀ : ℝ) (a b : Fin 4) {I : ℤ × ℤ} (hI : I ∈ S) (hgs : gs I ⊆ gset)
    (hBn : T.bk I < Bn) (g : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ → ℝ) :
    ∑ m ∈ nOs Lp Jm ×ˢ (gset ×ˢ Finset.range Bn), (if I ∈ S ∧ m.2.1 ∈ gs I ∧
        T.bk I = m.2.2 ∧ T.Val a b m.1.1 m.1.2.1 ∧
        ¬ T.Ucase I m.1.1 m.1.2.1 ∧ m.1.2.2.1 < (T.pe m.1.1).length ∧
        m.1.2.2.2.1 < (T.pe m.1.2.1).length ∧
        m.1.2.2.2.2.1 < (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
          (T.tOf m.1.2.1 m.1.2.2.2.1)).length ∧
        T.unfl C₀ I m.2.1 m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1)
          m.1.2.2.2.2.1 m.1.2.2.2.2.2 then g m else 0) =
      ∑ G ∈ gs I, ∑ ω ∈ nOs Lp Jm, (if T.Val a b ω.1 ω.2.1 ∧
        ¬ T.Ucase I ω.1 ω.2.1 ∧ ω.2.2.1 < (T.pe ω.1).length ∧
        ω.2.2.2.1 < (T.pe ω.2.1).length ∧
        ω.2.2.2.2.1 < (T.desc ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)).length ∧
        T.unfl C₀ I G ω.1 ω.2.1 (T.tOf ω.1 ω.2.2.1) (T.tOf ω.2.1 ω.2.2.2.1)
          ω.2.2.2.2.1 ω.2.2.2.2.2 then g (ω, G, T.bk I) else 0) := by
  rw [Finset.sum_comm (s := gs I), Finset.sum_product]
