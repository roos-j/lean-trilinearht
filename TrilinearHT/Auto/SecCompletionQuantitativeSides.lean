    (husl : ∀ l, T.D.usl l → l = T.u)
    (hdc : ∀ I ∈ S, T.D.hasDecision I → T.D.dcell I ∈ A.cells)
    {B₀ : ℝ} (hB₀ : 0 ≤ B₀)
    (hout : ∀ I ∈ S, ∀ G ∈ gs I, ∀ l, ‖T.out l G I‖ ≤ B₀ * Real.sqrt (dyadicGridLength A.G I.1))
