open Classical in
/-- Blueprint lines 2408-2409 and 2420 (the base terms of `eq:stack-energy`): the glued base
stacks (level `N`) of the bands `(A_{p+1} - A_p) S` at the block starts, where `S_b = W`, have
total square at most the energy `E_W` of the block inputs restricted to the block-start ancestors
of the uses (Bessel bands, local pads). -/
theorem baseStack_energy {γ : Type*} {V : Type*} [Fintype V] (Gs : Finset γ) {K N : ℕ}
    (hKN : K ≤ 2 ^ N) (Bs : Finset ℕ) (U : γ → ℕ → Finset (ℤ × ℤ)) (off : ℤ × ℤ → ℕ)
    (hU : ∀ g β, ∀ I ∈ U g β, I ∈ A.cells ∧ I.1 = A.R.1 + (K * β + off I : ℕ) ∧ off I < K)
    {P : ℕ} (Ah : γ → ℕ → ℤ → ColumnL2 V →L[ℂ] ColumnL2 V)
    (hbes : ∀ g h y, ∑ p ∈ Finset.range (P + 1), ‖(Ah g (p + 1) h - Ah g p h) y‖ ^ 2 ≤ ‖y‖ ^ 2)
    (hcomm : ∀ g n h (J : ℤ × ℤ), J.1 ≤ h → J.1 ≤ A.R.1 + A.treeDepth →
      (columnL2Restriction (dyadicGridCell A.G J.1 J.2)
      (dyadicGridCell_measurable A.G J.1 J.2)).comp (Ah g n h) =
        (Ah g n h).comp (columnL2Restriction (dyadicGridCell A.G J.1 J.2)
          (dyadicGridCell_measurable A.G J.1 J.2)))
    (W : γ → ℕ → ColumnL2 V) {EW : ℝ}
    (hEW : ∑ g ∈ Gs, ∑ β ∈ Bs, ‖columnL2Restriction
      (⋃ J ∈ (U g β).image (fun I => ancAt A.G I (A.R.1 + ((K * β : ℕ) : ℤ))),
        dyadicGridCell A.G J.1 J.2)
      (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
      (W g β)‖ ^ 2 ≤ EW)
    (Sa : γ → ℕ → ℤ → ColumnL2 V) (hSa : ∀ g β, Sa g β (A.R.1 + ((K * β : ℕ) : ℤ)) = W g β) :
    ∑ g ∈ Gs, ∑ β ∈ Bs, ∑ q ∈ ((U g β).filter fun I => posAct N (Fin.last N) (off I)).image
        (fun I => off I / 2 ^ (N + 1)), ∑ p ∈ Finset.range (P + 1),
      ‖gluedStack A.G ((U g β).filter fun I => posAct N (Fin.last N) (off I))
        (fun I => off I / 2 ^ (N + 1))
        (fun q => posVal (fun n => (Ah g (p + 1) (A.R.1 + (K * β + n : ℕ)) -
          Ah g p (A.R.1 + (K * β + n : ℕ))) (Sa g β (A.R.1 + (K * β + n : ℕ))))
          N (Fin.last N) q) q‖ ^ 2 ≤ EW := by
  refine le_trans (Finset.sum_le_sum fun g _ => Finset.sum_le_sum fun β _ => ?_) hEW
  set U' := (U g β).filter fun I => posAct N (Fin.last N) (off I)
  set db : ℤ := A.R.1 + ((K * β : ℕ) : ℤ)
  set Ωb := ⋃ J ∈ (U g β).image (fun I => ancAt A.G I db), dyadicGridCell A.G J.1 J.2
  have hΩb : MeasurableSet Ωb :=
    Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2
  -- every use selects the index zero
  have hsel0 : ∀ I ∈ U', off I / 2 ^ (N + 1) = 0 := by
    intro I hI
    have h := (hU g β I (Finset.mem_filter.mp hI).1).2.2
    refine Nat.div_eq_of_lt (lt_of_lt_of_le h (hKN.trans ?_))
    exact Nat.pow_le_pow_right (by norm_num) (Nat.le_succ N)
  have himg : U'.image (fun I => off I / 2 ^ (N + 1)) ⊆ {0} := by
    intro q hq
    obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hq
    rw [hsel0 I hI]; exact Finset.mem_singleton_self 0
  have hsub : ∀ q, selUnion A.G U' (fun I => off I / 2 ^ (N + 1)) q ⊆ Ωb := by
    intro q y hy
    simp only [selUnion, Set.mem_iUnion] at hy
    obtain ⟨I, hI, -, hyI⟩ := hy
    obtain ⟨hIc, hIdep, -⟩ := hU g β I (Finset.mem_filter.mp hI).1
    have hd : db ≤ I.1 := by rw [hIdep]; simp only [db]; push_cast; omega
    exact Set.mem_biUnion (Finset.mem_image_of_mem _ (Finset.mem_filter.mp hI).1)
      (subset_ancAt A.G I hd hyI)
  have hcommΩ : ∀ n, (columnL2Restriction Ωb hΩb).comp (Ah g n db) =
      (Ah g n db).comp (columnL2Restriction Ωb hΩb) := fun n =>
    union_commute A.G _ (d := db) (fun J hJ => by
      obtain ⟨I, -, rfl⟩ := Finset.mem_image.mp hJ; rfl) _ fun J hJ => by
      obtain ⟨I, hI, rfl⟩ := Finset.mem_image.mp hJ
      obtain ⟨hIc, hIdep, -⟩ := hU g β I hI
      have hd : db ≤ I.1 := by rw [hIdep]; simp only [db]; push_cast; omega
      exact hcomm g n db _ le_rfl (hd.trans ((dyadicFiniteTree_mem_iff A.G A.R I
        A.treeDepth).mp (A.cells_mem_tree hIc)).2)
  have hterm : ∀ q, ∑ p ∈ Finset.range (P + 1),
      ‖gluedStack A.G U' (fun I => off I / 2 ^ (N + 1))
        (fun q => posVal (fun n => (Ah g (p + 1) (A.R.1 + (K * β + n : ℕ)) -
          Ah g p (A.R.1 + (K * β + n : ℕ))) (Sa g β (A.R.1 + (K * β + n : ℕ))))
          N (Fin.last N) q) q‖ ^ 2 ≤ ‖columnL2Restriction Ωb hΩb (W g β)‖ ^ 2 := by
    intro q
    refine (Finset.sum_le_sum fun p _ =>
      gluedStack_norm_sq_le A.G U' _ _ q hΩb (hsub q)).trans ?_
    have e : ∀ p, posVal (fun n => (Ah g (p + 1) (A.R.1 + (K * β + n : ℕ)) -
        Ah g p (A.R.1 + (K * β + n : ℕ))) (Sa g β (A.R.1 + (K * β + n : ℕ))))
          N (Fin.last N) q =
        (Ah g (p + 1) db - Ah g p db) (W g β) := by
      intro p
      simp only [posVal, Fin.val_last, ite_true, add_zero]
      rw [hSa]
    simp only [e]
    refine le_trans (le_of_eq (Finset.sum_congr rfl fun p _ => ?_)) (hbes g db _)
    rw [sub_apply, map_sub, ← ContinuousLinearMap.comp_apply, hcommΩ,
      ContinuousLinearMap.comp_apply,
      ← ContinuousLinearMap.comp_apply (columnL2Restriction Ωb hΩb), hcommΩ,
      ContinuousLinearMap.comp_apply, ← sub_apply]
  calc _ ≤ ∑ q ∈ ({0} : Finset ℕ), ∑ p ∈ Finset.range (P + 1),
        ‖gluedStack A.G U' (fun I => off I / 2 ^ (N + 1))
          (fun q => posVal (fun n => (Ah g (p + 1) (A.R.1 + (K * β + n : ℕ)) -
            Ah g p (A.R.1 + (K * β + n : ℕ))) (Sa g β (A.R.1 + (K * β + n : ℕ))))
            N (Fin.last N) q) q‖ ^ 2 :=
        Finset.sum_le_sum_of_subset_of_nonneg himg fun _ _ _ =>
          Finset.sum_nonneg fun _ _ => by positivity
    _ ≤ _ := by rw [Finset.sum_singleton]; exact hterm 0

end ActiveSetup

/-! ### Depth stacks of a basic `U` side (blueprint lines 2407-2408) -/

section DepthStacks

variable (G : RealDyadicGrid) {V : Type*} [Fintype V]

open Classical in
/-- Blueprint line 2407 ("for a basic `U` side use each depth directly as a position"): the
depth stack of local values `v_I` on the cells of `U` of selection `m`: the sum of their
restrictions to the cells. -/
noncomputable def depthStack (U : Finset (ℤ × ℤ)) (sel : ℤ × ℤ → ℕ) (v : ℤ × ℤ → ColumnL2 V)
    (m : ℕ) : ColumnL2 V :=
  ∑ J ∈ U.filter (fun J => sel J = m), columnL2Restriction (dyadicGridCell G J.1 J.2)
    (dyadicGridCell_measurable G J.1 J.2) (v J)

/-- The restriction to one cell of the restriction to a disjoint cell vanishes. -/
theorem restrict_restrict_disjoint {I J : ℤ × ℤ}
    (h : Disjoint (dyadicGridCell G I.1 I.2) (dyadicGridCell G J.1 J.2)) (x : ColumnL2 V) :
    columnL2Restriction (dyadicGridCell G I.1 I.2) (dyadicGridCell_measurable G I.1 I.2)
      (columnL2Restriction (dyadicGridCell G J.1 J.2) (dyadicGridCell_measurable G J.1 J.2) x) =
      0 := by
  have hn : ‖columnL2Restriction (dyadicGridCell G I.1 I.2)
      (dyadicGridCell_measurable G I.1 I.2) (columnL2Restriction (dyadicGridCell G J.1 J.2)
        (dyadicGridCell_measurable G J.1 J.2) x)‖ ^ 2 = 0 := by
    rw [columnL2Restriction_norm_sq]
    refine integral_eq_zero_of_ae ?_
    rw [Filter.EventuallyEq, ae_restrict_iff' (dyadicGridCell_measurable G I.1 I.2)]
    filter_upwards [columnL2Indicator_coeFn _ (dyadicGridCell_measurable G J.1 J.2) x]
      with y hy hyI
    change ‖(columnL2Indicator (dyadicGridCell G J.1 J.2) (dyadicGridCell_measurable G J.1 J.2) x :
      ℝ → ColumnHilbert V) y‖ ^ 2 = 0
    rw [hy, Set.indicator_of_notMem (Set.disjoint_left.mp h hyI)]
    simp
  exact norm_eq_zero.mp (pow_eq_zero_iff two_ne_zero |>.mp hn)

open Classical in
/-- On a cell of `U`, the depth stack at its selection is its local value, if the cells of one
selection are pairwise disjoint. -/
theorem depthStack_restrict (U : Finset (ℤ × ℤ)) (sel : ℤ × ℤ → ℕ)
    (hdis : ∀ I ∈ U, ∀ J ∈ U, sel I = sel J → I ≠ J →
      Disjoint (dyadicGridCell G I.1 I.2) (dyadicGridCell G J.1 J.2))
    (v : ℤ × ℤ → ColumnL2 V) {I : ℤ × ℤ} (hI : I ∈ U) :
    columnL2Restriction (dyadicGridCell G I.1 I.2) (dyadicGridCell_measurable G I.1 I.2)
        (depthStack G U sel v (sel I)) =
      columnL2Restriction (dyadicGridCell G I.1 I.2) (dyadicGridCell_measurable G I.1 I.2)
        (v I) := by
  unfold depthStack
  rw [map_sum, ← Finset.add_sum_erase (U.filter fun J => sel J = sel I) _
    (Finset.mem_filter.mpr ⟨hI, rfl⟩)]
  have hz : ∑ J ∈ (U.filter fun J => sel J = sel I).erase I,
      columnL2Restriction (dyadicGridCell G I.1 I.2) (dyadicGridCell_measurable G I.1 I.2)
        (columnL2Restriction (dyadicGridCell G J.1 J.2) (dyadicGridCell_measurable G J.1 J.2)
          (v J)) = 0 := by
    refine Finset.sum_eq_zero fun J hJ => ?_
    obtain ⟨hJI, hJf⟩ := Finset.mem_erase.mp hJ
    obtain ⟨hJU, hJs⟩ := Finset.mem_filter.mp hJf
    exact restrict_restrict_disjoint G (hdis I hI J hJU hJs.symm (Ne.symm hJI)) _
  rw [hz, add_zero, ← ContinuousLinearMap.comp_apply, columnL2Restriction_idem]

open Classical in
/-- The square norm of a depth stack is the sum of the square norms of the restricted local values
of its cells (disjoint supports). -/
theorem depthStack_norm_sq (U : Finset (ℤ × ℤ)) (sel : ℤ × ℤ → ℕ)
    (hdis : ∀ I ∈ U, ∀ J ∈ U, sel I = sel J → I ≠ J →
      Disjoint (dyadicGridCell G I.1 I.2) (dyadicGridCell G J.1 J.2))
    (v : ℤ × ℤ → ColumnL2 V) (m : ℕ) :
    ‖depthStack G U sel v m‖ ^ 2 = ∑ J ∈ U.filter (fun J => sel J = m),
      ‖columnL2Restriction (dyadicGridCell G J.1 J.2) (dyadicGridCell_measurable G J.1 J.2)
        (v J)‖ ^ 2 := by
  set T := U.filter fun J => sel J = m
  set w := depthStack G U sel v m
  have hTm : MeasurableSet (⋃ J ∈ T, dyadicGridCell G J.1 J.2) :=
    Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable G J.1 J.2
  have hw : columnL2Restriction (⋃ J ∈ T, dyadicGridCell G J.1 J.2) hTm w = w := by
    simp only [w, depthStack, map_sum]
    refine Finset.sum_congr rfl fun J hJ => ?_
    rw [← ContinuousLinearMap.comp_apply, columnL2Restriction_comp_of_subset'
      (dyadicGridCell_measurable G J.1 J.2) hTm (Set.subset_biUnion_of_mem (u := fun J =>
        dyadicGridCell G J.1 J.2) hJ)]
  have hpair : Set.Pairwise (↑T)
      (Function.onFun Disjoint fun J : ℤ × ℤ => dyadicGridCell G J.1 J.2) := by
    intro I hI J hJ hIJ
    obtain ⟨hIU, hIs⟩ := Finset.mem_filter.mp hI
    obtain ⟨hJU, hJs⟩ := Finset.mem_filter.mp hJ
    exact hdis I hIU J hJU (hIs.trans hJs.symm) hIJ
  rw [← hw, columnL2Restriction_norm_sq, integral_biUnion_finset T
    (fun J _ => dyadicGridCell_measurable G J.1 J.2) hpair
    (fun J _ => ((Lp.memLp w).integrable_norm_pow two_ne_zero).integrableOn)]
  refine Finset.sum_congr rfl fun J hJ => ?_
  rw [← columnL2Restriction_norm_sq _ (dyadicGridCell_measurable G J.1 J.2)]
  obtain ⟨hJU, hJs⟩ := Finset.mem_filter.mp hJ
  have h := depthStack_restrict G U sel hdis v hJU
  rw [hJs] at h
  rw [h]

end DepthStacks

/-! ### Nested pads of one depth (blueprint line 2388, "pad bands are orthogonal at one cell") -/

section MaskNesting

variable {V : Type*} [Fintype V]

/-- The cell column ranges are monotone in the mask labels. -/
theorem cellColumnRange_mono_mask (D : ColumnTreeData V) {A₁ A₂ : InheritedColumnMask D}
    {c : ℤ × ℤ} (hc : c ∈ D.cells) (hA : A₁.labels c ⊆ A₂.labels c) :
    cellColumnRange D A₁ hc ≤ cellColumnRange D A₂ hc := by
  unfold cellColumnRange
  refine Submodule.span_mono ?_
  rintro _ ⟨v, rfl⟩
  exact ⟨⟨v.1, hA v.2⟩, rfl⟩

/-- The partition column ranges are monotone in the mask labels. -/
theorem partitionColumnRange_mono_mask (D : ColumnTreeData V) {A₁ A₂ : InheritedColumnMask D}
    (π : ColumnStoppingPartition D) (hA : ∀ c ∈ D.cells, A₁.labels c ⊆ A₂.labels c) :
    partitionColumnRange D A₁ π ≤ partitionColumnRange D A₂ π := by
  unfold partitionColumnRange
  exact iSup_mono fun c => cellColumnRange_mono_mask D (π.subset c.property)
    (hA c.1 (π.subset c.property))

/-- The depth projections with nested masks are nested. -/
theorem ColumnDepthFamily.proj_mask_nested (Ψ : ColumnDepthFamily V)
    {A₁ A₂ : InheritedColumnMask Ψ.D} (hA : ∀ c ∈ Ψ.D.cells, A₁.labels c ⊆ A₂.labels c)
    (h : ℤ) : ((Ψ.withMask A₁).proj h).comp ((Ψ.withMask A₂).proj h) =
      (Ψ.withMask A₁).proj h := by
  have hle := partitionColumnRange_mono_mask Ψ.D (Ψ.partition h) hA
  change (partitionColumnRange Ψ.D A₁ (Ψ.partition h)).starProjection.comp
      (partitionColumnRange Ψ.D A₂ (Ψ.partition h)).starProjection =
    (partitionColumnRange Ψ.D A₁ (Ψ.partition h)).starProjection
  exact Submodule.starProjection_comp_starProjection_of_le hle

end MaskNesting

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

theorem stepMask_pad_mono (G : A.Grp) (j : ℕ) (e : Option ℕ) {p p' : ℕ} (hp : p ≤ p')
    (c : ℤ × ℤ) (x : A.Vtx) (hx : ap.stepMask G j e p c x) : ap.stepMask G j e p' c x := by
  cases e with
  | none => exact ap.bmask_pad_mono hp hx
  | some m => exact ap.cmask_pad_mono hp hx

/-- The global pads of a step are nested in the pad index. -/
theorem gPad_nested (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (r : ℕ) (G : A.Grp) (j : ℕ) (e : Option ℕ)
    {p p' : ℕ} (hp : p ≤ p') (h : ℤ) :
    (((ap.cumBase catl hR hb).withMask (ap.gMask catl hR hb r (ap.stepMask G j e p)
        (ap.stepMask_mono G j e p))).proj h).comp
      (((ap.cumBase catl hR hb).withMask (ap.gMask catl hR hb r (ap.stepMask G j e p')
        (ap.stepMask_mono G j e p'))).proj h) =
      ((ap.cumBase catl hR hb).withMask (ap.gMask catl hR hb r (ap.stepMask G j e p)
        (ap.stepMask_mono G j e p))).proj h :=
  ColumnDepthFamily.proj_mask_nested _ (fun _ _ => catLabels_mono _ _ _
    fun x hx => ap.stepMask_pad_mono G j e hp _ x hx) h

