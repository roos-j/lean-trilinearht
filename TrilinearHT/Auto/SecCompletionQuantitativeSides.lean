      fun b _ => Finset.sum_nonneg fun c _ => Finset.sum_nonneg fun d _ => hth0 I G a b c d))
    (fun _ => Ts) (fun _ => Ts) (fun _ => Cc) ?_ ?_ (fun _ _ x => hCc x)
