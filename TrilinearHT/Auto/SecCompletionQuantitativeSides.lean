    · rw [ite_eq_left_of_eq_true _ _ (eq_true h)]
      exact (Finset.sum_le_sum hm).trans (hCf3 a b e h)
    · rw [ite_eq_right_of_eq_false _ _ (eq_false h)]
      refine le_of_eq (Finset.sum_eq_zero fun m _ => Finset.sum_eq_zero fun I _ => ?_)
      rw [ite_eq_right_of_eq_false _ _ (eq_false fun hI => h (T.nU_slots hI)), mul_zero]

