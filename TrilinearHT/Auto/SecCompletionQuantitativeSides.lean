    (hYcur : ∀ I ∈ S, ∀ G ∈ gs I, ∀ c d t t' j o,
      Real.sqrt (∑ p ∈ ap.uo o, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
