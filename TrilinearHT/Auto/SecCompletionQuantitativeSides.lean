      (dyadicGridCell_measurable A.G I.1 I.2) (Yc p)‖ ^ 2) /
        Real.sqrt (dyadicGridLength A.G I.1) ≤ C₀) :
    ‖ap.nearForm I a b e f z u X Yc W Fc‖ ≤
      localFormUniformConstant κ' * ((‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) W‖ / Real.sqrt (dyadicGridLength A.G I.1)) * SA *
        C₀ ^ 2) := by
  have hC := localFormUniformConstant_nonneg κ'
  have h := ap.band_sum_le I hab hae haf hbe hbf hef z u X Yc W Fc
  refine h.trans (mul_le_mul_of_nonneg_left ?_ hC)
  have hw : 0 ≤ ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) W‖ / Real.sqrt (dyadicGridLength A.G I.1) := by
    positivity
  have hSA : 0 ≤ SA := le_trans (by positivity) hX
  calc _ ≤ C₀ * (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) W‖ / Real.sqrt (dyadicGridLength A.G I.1)) *
        SA * C₀ := by gcongr
    _ = _ := by ring

end AttemptParams

end ActiveSetup

theorem posExpand_coef : ∀ (ls : List (ℕ × Bool)), ∀ t ∈ posExpand ls, ‖(t.1 : ℂ)‖ ≤ 1
  | [], t, ht => by simp only [posExpand, List.mem_singleton] at ht; subst ht; simp
  | (m, false) :: rest, t, ht => by
    simp only [posExpand, List.mem_map] at ht
    obtain ⟨t', ht', rfl⟩ := ht
    exact posExpand_coef rest t' ht'
  | (m, true) :: rest, t, ht => by
    simp only [posExpand, List.mem_append, List.mem_map] at ht
    rcases ht with ht | ⟨t', ht', rfl⟩
    · exact posExpand_coef rest t ht
    · simp only [Int.cast_neg, norm_neg]
      exact posExpand_coef rest t' ht'

/-- In four slots, a slot distinct from three of four distinct slots is the fourth. -/
theorem fin4_last : ∀ a b c d l : Fin 4, a ≠ b → a ≠ c → a ≠ d → b ≠ c → b ≠ d → c ≠ d →
    l ≠ a → l ≠ c → l ≠ d → l = b := by
  intro a b c d l h1 h2 h3 h4 h5 h6 h7 h8 h9
  omega

theorem norm_list_map_sum_le {α E : Type*} [SeminormedAddCommGroup E] (L : List α) (f : α → E) :
    ‖(L.map f).sum‖ ≤ (L.map fun x => ‖f x‖).sum := by
  induction L with
  | nil => simp
  | cons x L ih =>
    simp only [List.map_cons, List.sum_cons]
    exact (norm_add_le _ _).trans (add_le_add le_rfl ih)

theorem list_map_sum_le {α : Type*} (L : List α) {f g : α → ℝ} (h : ∀ x ∈ L, f x ≤ g x) :
    (L.map f).sum ≤ (L.map g).sum := by
  induction L with
  | nil => simp
  | cons x L ih =>
    simp only [List.map_cons, List.sum_cons]
    exact add_le_add (h x (List.mem_cons_self ..)) (ih fun y hy => h y (List.mem_cons_of_mem _ hy))

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The global objects of the band step `j` of a descriptor list at the depth `h`: the step, the
later steps and the earlier steps as pad steps. -/
noncomputable def gSt (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) (h : ℤ) : TransferStep (ColumnL2 (Fin ap.Mc)) :=
  padStep (ap.gStep cat hcat hR hbc hbh rH s c d G (D.getD j (true, 0, none)) h)

noncomputable def gRest (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) (h : ℤ) : List (TransferStep (ColumnL2 (Fin ap.Mc))) :=
  ((D.drop (j + 1)).map fun e => ap.gStep cat hcat hR hbc hbh rH s c d G e h).map padStep

noncomputable def gPre (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) (h : ℤ) : List (TransferStep (ColumnL2 (Fin ap.Mc))) :=
  ((D.take j).map fun e => ap.gStep cat hcat hR hbc hbh rH s c d G e h).map padStep

open Classical in
/-- The near band sum of the step `j` at the offset `o` of a descriptor list, with the global
steps, inputs and spectators at the depth `h`, in the cell form of `I`. -/
noncomputable def nearTermG (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (a c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {CF : ℝ} (P₁c P₂c P₁d P₂d : BasicProjection A.G A.R CF)
    (I : ℤ × ℤ) (h : ℤ) (xg : Fin 4 → ColumnL2 (Fin ap.Mc)) (xa : ColumnL2 (Fin ap.Mc))
    (j o : ℕ) : ℂ :=
  let st := ap.gSt cat hcat hR hbc hbh rH s c d G D j h
  let R := ap.gRest cat hcat hR hbc hbh rH s c d G D j h
  let H := helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j h) xa
  let V := chainVal ap.P st.1 R (if st.1 then ap.gIn P₁c P₂c h else ap.gIn P₁d P₂d h)
  ∑ p ∈ (Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o - 2 ≤ ap.P),
    ap.Λc I (Function.update (Function.update (Function.update (Function.update xg c
      (chainVal ap.P true R (ap.gIn P₁c P₂c h))) d (chainVal ap.P false R (ap.gIn P₁d P₂d h)))
        a (st.2.1 (p + 1) H - st.2.1 p H)) (if st.1 then c else d)
          (st.2.2 (p + o - 2 + 1) V - st.2.2 (p + o - 2) V))

/-- Blueprint lines 2241-2258 at one cell (two basic complements): the restored form of the whole
outputs in the complement slots is at most the sum over the pairs of positive chains of the main
term, the far band defects, and `2/P` times the near band sums of the global steps at the depth
of the cell, over the steps and the five offsets. -/
theorem restored_bound (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) {a b c d : Fin 4} (hab : a ≠ b)
    (hac : a ≠ c) (had : a ≠ d) (hbc' : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (G : A.Grp)
    {I : ℤ × ℤ} (hI : I ∈ A.cells) (x xg : Fin 4 → ColumnL2 (Fin ap.Mc))
    (hxb : columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (xg b) = columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) (x b))
    (xa : ColumnL2 (Fin ap.Mc))
    (hxa : x a = columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) xa)
    {CF : ℝ} (P₁c P₂c P₁d P₂d : BasicProjection A.G A.R CF) (hzc : ap.z I c = A.B c I)
    (hPc : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → A.B c I y = P₁c.val I y - P₂c.val I y)
    (hzd : ap.z I d = A.B d I)
    (hPd : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → A.B d I y = P₁d.val I y - P₂d.val I y) :
    ‖ap.Λc I (Function.update (Function.update x c (ap.leafOut cat s I c G)) d
        (ap.leafOut cat s I d G))‖ ≤
      ((posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers d).reverse).map fun t' =>
        ((posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers c).reverse).map fun t =>
          ‖ap.Λc I (Function.update (Function.update (Function.update x c
              (physicalColumnInput (ap.base I c))) d (physicalColumnInput (ap.base I d))) a
                (chainSide ap.P (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a)))‖ +
          ‖chainDefectSel (ap.Λc I) ap.P a c d x (physicalColumnInput (ap.base I c))
              (physicalColumnInput (ap.base I d)) (fun p q => q + 2 < p ∨ p + 2 < q)
              (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a)‖ +
          ∑ j ∈ Finset.range (ap.mergeDesc s c d t.2 t'.2).length, ∑ o ∈ Finset.range 5,
            2 / (ap.P : ℝ) * ‖ap.nearTermG cat hcat hR hbc hbh rH s a c d G
              (ap.mergeDesc s c d t.2 t'.2) P₁c P₂c P₁d P₂d I I.1 xg xa j o‖).sum).sum := by
  rw [ap.leaf_restored_transfer cat hcat rH s hac had hcd G I x]
  refine (norm_list_map_sum_le _ _).trans (list_map_sum_le _ fun t' ht' => ?_)
  refine (norm_list_map_sum_le _ _).trans (list_map_sum_le _ fun t ht => ?_)
  have hcoef : ‖((t.1 : ℂ) * t'.1)‖ ≤ 1 := by
    rw [norm_mul]
    calc ‖(t.1 : ℂ)‖ * ‖(t'.1 : ℂ)‖ ≤ 1 * 1 :=
          mul_le_mul (posExpand_coef _ t ht) (posExpand_coef _ t' ht') (norm_nonneg _) zero_le_one
      _ = 1 := one_mul 1
  set Main := ap.Λc I (Function.update (Function.update (Function.update x c
    (physicalColumnInput (ap.base I c))) d (physicalColumnInput (ap.base I d))) a
      (chainSide ap.P (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a)))
  have hsplit := chainDefect_split (ap.Λc I) ap.P a c d x (physicalColumnInput (ap.base I c))
    (physicalColumnInput (ap.base I d)) (fun p q => q + 2 < p ∨ p + 2 < q)
    (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a)
  have hx : ∀ l, l ≠ a → l ≠ c → l ≠ d →
      columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (xg l) = columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2) (x l) := by
    intro l hla hlc hld
    rw [fin4_last a b c d l hab hac had hbc' hbd hcd hla hlc hld]
    exact hxb
  have hnear := ap.defects_global cat hcat hR hbc hbh rH s G t.2 t'.2
    (fun p q => ¬ (q + 2 < p ∨ p + 2 < q)) hI x xg hx xa hxa P₁c P₂c P₁d P₂d hzc hPc hzd hPd
    (true, 0, none)
  rw [hsplit, hnear]
  have hP : (0 : ℝ) < ap.P := by exact_mod_cast ap.hP
  calc ‖(t.1 : ℂ) * t'.1 * (Main + (chainDefectSel (ap.Λc I) ap.P a c d x
        (physicalColumnInput (ap.base I c)) (physicalColumnInput (ap.base I d))
        (fun p q => q + 2 < p ∨ p + 2 < q) (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a) +
        _))‖ ≤ 1 * ‖Main + (chainDefectSel (ap.Λc I) ap.P a c d x
        (physicalColumnInput (ap.base I c)) (physicalColumnInput (ap.base I d))
        (fun p q => q + 2 < p ∨ p + 2 < q) (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a) +
        _)‖ := by rw [norm_mul]; exact mul_le_mul_of_nonneg_right hcoef (norm_nonneg _)
    _ ≤ _ := by
      rw [one_mul, ← add_assoc]
      refine (norm_add_le _ _).trans (add_le_add (norm_add_le _ _) ?_)
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => ?_)
      rw [defTerm_near]
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun o ho => ?_)
      rw [norm_mul]
      refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
      have ho5 : o < 5 := Finset.mem_range.mp ho
      rw [norm_div, Complex.norm_natCast]
      refine div_le_div_of_nonneg_right ?_ hP.le
      have : ((2 : ℂ) - o) = ((2 - (o : ℝ) : ℝ) : ℂ) := by push_cast; ring
      rw [this, Complex.norm_real, Real.norm_eq_abs, abs_le]
      have ho4 : (o : ℝ) ≤ 4 := by exact_mod_cast Nat.lt_succ_iff.mp ho5
      have ho0 : (0 : ℝ) ≤ o := Nat.cast_nonneg o
      constructor <;> linarith

end AttemptParams

