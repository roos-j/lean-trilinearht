open Classical in
/-- The frozen near band part of a slot tuple at a cell and group. -/
noncomputable def nearPart (I : ℤ × ℤ) (G : A.Grp) (a b c d : Fin 4)
    (Yb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Fb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Unfl : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → Prop) : ℝ :=
  if T.Val a b c d ∧ ¬ T.Ucase I c d then
    T.nearAbs a b c d G I 0 (Yb I G c d) (Fb I G c d) (Unfl I G c d)
  else 0

open Classical in
/-- Blueprint line 2386 (pair-small main terms and far terms, absolute): the weighted absolute parts
of a leaf are at most `6 · 256 N_p (τ + c_F) T_s |R|` plus the weighted frozen near band parts,
where `N_p` bounds the numbers of pairs of positive chains and `T_s` is the side path cap. -/
theorem abs_sum_le (S : Finset (ℤ × ℤ))
    (hroot : ∀ I ∈ S, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G A.R.1 A.R.2)
    (gs : ℤ × ℤ → Finset A.Grp) {τ cF Np Ts : ℝ} (hτ : 0 ≤ τ) (hcF : 0 ≤ cF)
    (hNp : ∀ c d, ((T.pe d).length * (T.pe c).length : ℝ) ≤ Np)
    (hTs : ∀ x, ∑ I ∈ S.filter (fun I => x ∈ dyadicGridCell A.G I.1 I.2),
      ∑ G ∈ gs I, T.s2 G I ≤ Ts)
    (Yb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Fb : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Unfl : ℤ × ℤ → A.Grp → Fin 4 → Fin 4 → List ℕ → List ℕ → ℕ → ℕ → Prop) :
    ∑ I ∈ S, dyadicGridLength A.G I.1 * (6 * ∑ G ∈ gs I, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4,
        ∑ d : Fin 4, T.absPart I G a b c d τ cF Yb Fb Unfl) ≤
      6 * 256 * Np * (τ + cF) * Ts * dyadicGridLength A.G A.R.1 +
      ∑ I ∈ S, dyadicGridLength A.G I.1 * (6 * ∑ G ∈ gs I, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4,
        ∑ d : Fin 4, T.nearPart I G a b c d Yb Fb Unfl) := by
  have hNp0 : 0 ≤ Np := le_trans (by positivity) (hNp 0 0)
  have hpt : ∀ I G a b c d, T.absPart I G a b c d τ cF Yb Fb Unfl ≤
      Np * ((τ + cF) * T.s2 G I) + T.nearPart I G a b c d Yb Fb Unfl := by
    intro I G a b c d
    unfold absPart nearPart
    have h0 : 0 ≤ Np * ((τ + cF) * T.s2 G I) := by
      have := T.s2_nonneg G I
      positivity
    split_ifs
    · have := mul_le_mul_of_nonneg_right (hNp c d)
        (mul_nonneg (add_nonneg hτ hcF) (T.s2_nonneg G I))
      linarith
    · simpa using h0
  have hcell : ∀ I ∈ S, dyadicGridLength A.G I.1 * (6 * ∑ G ∈ gs I, ∑ a : Fin 4, ∑ b : Fin 4,
      ∑ c : Fin 4, ∑ d : Fin 4, T.absPart I G a b c d τ cF Yb Fb Unfl) ≤
      6 * 256 * Np * (τ + cF) * (dyadicGridLength A.G I.1 * ∑ G ∈ gs I, T.s2 G I) +
      dyadicGridLength A.G I.1 * (6 * ∑ G ∈ gs I, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4,
        ∑ d : Fin 4, T.nearPart I G a b c d Yb Fb Unfl) := by
