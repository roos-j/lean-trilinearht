      ∑ ka, ∑ kb, if actA ka I ∧ actB kb I then T (m, ka, kb) I else 0 := by
    intro m hm I hI
    have hexp : ∀ p ∈ u m, ap.Λc I (Function.update (Function.update
        (Function.update (F m) a (va m I p)) b (vb m I)) c (Y m p)) =
        ∑ ka ∈ Finset.univ.filter (fun k => actA k I),
