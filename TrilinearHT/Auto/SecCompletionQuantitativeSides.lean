/-- The block index of a cell: `(I.1 - R.1) / K`. -/
noncomputable def bk (I : ℤ × ℤ) : ℕ := ((I.1 - A.R.1) / T.D.S.K).toNat

/-- The offset of a cell in its block: `(I.1 - R.1) mod K`. -/
noncomputable def offI (I : ℤ × ℤ) : ℕ := ((I.1 - A.R.1) % T.D.S.K).toNat

/-- Below the root, a cell depth is its block start plus its offset, the offset is less than `K`
and the block start is `blockOf`. -/
theorem bk_offI {I : ℤ × ℤ} (hK1 : 1 ≤ T.D.S.K) (hI : A.R.1 ≤ I.1) :
    I.1 = A.R.1 + ((T.D.S.K * T.bk I + T.offI I : ℕ) : ℤ) ∧ T.offI I < T.D.S.K ∧
      T.D.blockOf I.1 = A.R.1 + ((T.D.S.K * T.bk I : ℕ) : ℤ) := by
  have hK : (0 : ℤ) < T.D.S.K := by exact_mod_cast hK1
  have h1 := Int.mul_ediv_add_emod (I.1 - A.R.1) T.D.S.K
  have h2 := Int.emod_nonneg (I.1 - A.R.1) hK.ne'
  have h3 := Int.emod_lt_of_pos (I.1 - A.R.1) hK
  have h4 : 0 ≤ (I.1 - A.R.1) / T.D.S.K := Int.ediv_nonneg (by omega) hK.le
  unfold bk offI LeafSplit.blockOf
  refine ⟨?_, ?_, ?_⟩
  · push_cast
    rw [Int.toNat_of_nonneg h4, Int.toNat_of_nonneg h2]
    linarith
  · have : ((I.1 - A.R.1) % T.D.S.K).toNat < (T.D.S.K : ℤ).toNat :=
      (Int.toNat_lt_toNat hK).mpr h3
    simpa using this
  · push_cast
    rw [Int.toNat_of_nonneg h4]

/-- The offset of a cell at depth `R.1 + K β + m` with `m < K` is `m`. -/
theorem offI_eq (hK1 : 1 ≤ T.D.S.K) (J : ℤ × ℤ) (β m : ℕ) (hm : m < T.D.S.K)
    (hJ : J.1 = A.R.1 + ((T.D.S.K * β + m : ℕ) : ℤ)) : T.offI J = m := by
  unfold offI
  rw [hJ]
  have hK : (0 : ℤ) < T.D.S.K := by exact_mod_cast hK1
  have : A.R.1 + ((T.D.S.K * β + m : ℕ) : ℤ) - A.R.1 = (m : ℤ) + T.D.S.K * β := by
    push_cast; ring
  rw [this, Int.add_mul_emod_self_left, Int.emod_eq_of_lt (by omega) (by exact_mod_cast hm)]
  simp

/-- The unflagged uses (blueprint line 2393): both frozen complements at the block start have
normalized squares at most `(2 C₀)²` on every active ancestor of the use within its block. -/
def unfl (C₀ : ℝ) (I : ℤ × ℤ) (G : A.Grp) (c d : Fin 4) (t t' : List ℕ) (j o : ℕ) : Prop :=
  ∀ J ∈ A.cells, dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 →
    T.D.blockOf I.1 ≤ J.1 →
    ∑ p ∈ ap.uo o, ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2)
        (dyadicGridCell_measurable A.G J.1 J.2) (T.Y c d G t t' j o (T.D.blockOf I.1) p)‖ ^ 2 ≤
      (2 * C₀) ^ 2 * dyadicGridLength A.G J.1 ∧
    ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
        (T.F c d G t t' j (T.D.blockOf I.1))‖ ^ 2 ≤ (2 * C₀) ^ 2 * dyadicGridLength A.G J.1

/-- At an unflagged use the frozen other complement has normalized size at most `2 C₀`. -/
theorem unfl_Fb {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {I : ℤ × ℤ} (hI : I ∈ A.cells) (hK1 : 1 ≤ T.D.S.K)
    {G : A.Grp} {c d : Fin 4} {t t' : List ℕ} {j o : ℕ} (h : T.unfl C₀ I G c d t t' j o) :
    ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (T.F c d G t t' j (T.D.blockOf I.1))‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ 2 * C₀ := by
  have hL := dyadicGridLength_pos A.G I.1
  have hs := Real.sqrt_pos.mpr hL
  have h2 := (h I hI subset_rfl (T.D.blockOf_bounds hK1 I.1).1).2
  rw [div_le_iff₀ hs]
  have h3 : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (T.F c d G t t' j (T.D.blockOf I.1))‖ ≤
      Real.sqrt ((2 * C₀) ^ 2 * dyadicGridLength A.G I.1) :=
    Real.le_sqrt_of_sq_le h2
  rwa [Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (by positivity)] at h3

