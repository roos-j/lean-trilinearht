/-- `Λc_pair_small_le` for nonnegative spectator sizes. -/
theorem Λc_pair_small_le' {I : ℤ × ℤ} (hI : I ∈ A.cells) {c d a b : Fin 4} (hcd : c ≠ d)
    (hca : c ≠ a) (hcb : c ≠ b) (hda : d ≠ a) (hdb : d ≠ b) (hab : a ≠ b)
    (X : Fin 4 → ColumnL2 (Fin ap.Mc)) {Yc Yd : ℝ → ℂ}
    (hYc : MemLp Yc 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)))
    {τ : ℝ} (hτ : 0 ≤ τ) (hpair : PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1)
      (A.w I) c d Yc Yd τ)
    (hXc : X c = physicalColumnInput (cellLp A.G I Yc))
    (hXd : ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (X d) y = Yd y)
    {Sa Sb : ℝ} (hSa : 0 ≤ Sa) (hSb : 0 ≤ Sb)
    (hXa : eLpNorm (augPhys (X a)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sa)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖ap.Λc I X‖ ≤ τ * Sa * Sb := by
  have hε : ∀ ε > 0, ‖ap.Λc I X‖ ≤ τ * (Sa + ε) * (Sb + ε) := fun ε hε =>
    ap.Λc_pair_small_le hI hcd hca hcb hda hdb hab X hYc hpair hXc hXd (by positivity)
      (by positivity) (hXa.trans (ENNReal.ofReal_le_ofReal (by linarith)))
      (hXb.trans (ENNReal.ofReal_le_ofReal (by linarith)))
  refine le_of_forall_pos_le_add fun δ hδ => ?_
  set ε := min 1 (δ / (τ * (Sa + Sb + 1) + 1))
  have hε0 : 0 < ε := lt_min one_pos (div_pos hδ (by positivity))
  have hε1 : ε ≤ 1 := min_le_left _ _
  have hε2 : ε * (τ * (Sa + Sb + 1) + 1) ≤ δ := by
    have := min_le_right 1 (δ / (τ * (Sa + Sb + 1) + 1))
    rw [le_div_iff₀ (by positivity)] at this
    exact this
  refine (hε ε hε0).trans ?_
  have : τ * (Sa + ε) * (Sb + ε) = τ * Sa * Sb + ε * (τ * (Sa + Sb + ε)) := by ring
  rw [this]
  have h2 : ε * (τ * (Sa + Sb + ε)) ≤ ε * (τ * (Sa + Sb + 1) + 1) := by
    apply mul_le_mul_of_nonneg_left _ hε0.le
    nlinarith
  linarith

