    (hW : columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (T.side b G I) = columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2) W) :
    T.nf a b c d G I t t' j o = ∑ p ∈ ap.uo o, ap.Λc I (Function.update (Function.update
