    (fun _ I G => 6 * ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4, ∑ d : Fin 4,
      T.third I G a b c d Yf Yb Fb Unfl C₀ B₀)
    (fun _ _ _ => Real.sqrt_nonneg _) (fun _ _ _ => Real.sqrt_nonneg _)
