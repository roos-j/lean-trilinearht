    have hG : ∀ G, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4, ∑ d : Fin 4,
        (T.absPart I G a b c d τ cF Yb Fb Unfl + T.s2 G I * T.third I G a b c d Yf Yb Fb Unfl C₀ B₀)
