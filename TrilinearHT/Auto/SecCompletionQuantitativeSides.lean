variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- Blueprint lines 2261-2262 and 2385-2386 at one cell: the transferred main term with the bases
`b_c, b_d` is at most the pair-small bound `τ S_a S_b` of the full arguments `Y_c, Y_d` plus the
two restoration corrections `C_κ S_a S_b (‖Y_c - b_c‖ ‖Y_d‖ + ‖b_c‖ ‖Y_d - b_d‖)/s²`. -/
theorem main_bound {I : ℤ × ℤ} (hI : I ∈ A.cells) {a b c d : Fin 4} (hab : a ≠ b)
    (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (x : Fin 4 → ColumnL2 (Fin ap.Mc)) (ch bc bd : ColumnL2 (Fin ap.Mc)) {Yfc Yfd : ℝ → ℂ}
    (hYc : MemLp Yfc 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)))
    (hYd : MemLp Yfd 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)))
    {τ : ℝ} (hτ : 0 ≤ τ) (hpair : PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1)
      (A.w I) c d Yfc Yfd τ) {Sa Sb : ℝ}
    (hSa : ‖ch‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSb : ‖x b‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sb) :
    ‖ap.Λc I (Function.update (Function.update (Function.update x c bc) d bd) a ch)‖ ≤
      τ * Sa * Sb + localFormUniformConstant κ' * (Sa * Sb *
        ((‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfc) - bc)‖ / Real.sqrt
              (dyadicGridLength A.G I.1)) *
          (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
            (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfd))‖ / Real.sqrt (dyadicGridLength
                A.G I.1)) +
        (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
          bc‖ / Real.sqrt (dyadicGridLength A.G I.1)) *
          (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
            (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfd) - bd)‖ /
              Real.sqrt (dyadicGridLength A.G I.1)))) := by
  set rI := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
  set s := Real.sqrt (dyadicGridLength A.G I.1)
  have hs : 0 < s := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  have hC := localFormUniformConstant_nonneg κ'
  set Yc := physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfc)
  set Yd := physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfd)
  set X := Function.update x a ch
  have hre : Function.update (Function.update (Function.update x c bc) d bd) a ch =
      Function.update (Function.update X c (Yc - (Yc - bc))) d (Yd - (Yd - bd)) := by
    simp only [sub_sub_cancel, X]
    rw [Function.update_comm had.symm, Function.update_comm hac.symm]
  have hSa0 : 0 ≤ Sa := le_trans (by positivity) hSa
  have hSb0 : 0 ≤ Sb := le_trans (by positivity) hSb
  have hrSa : ‖rI ch‖ / s ≤ Sa :=
    le_trans (div_le_div_of_nonneg_right (columnL2Indicator_norm_le _ (dyadicGridCell_measurable A.G
        I.1 I.2) _) hs.le) hSa
  have hrSb : ‖rI (x b)‖ / s ≤ Sb :=
    le_trans (div_le_div_of_nonneg_right (columnL2Indicator_norm_le _ (dyadicGridCell_measurable A.G
        I.1 I.2) _) hs.le) hSb
  rw [hre, ap.Λc_restore hcd X Yc Yd (Yc - bc) (Yd - bd)]
  -- the pair-small term
  have h1 : ‖ap.Λc I (Function.update (Function.update X c Yc) d Yd)‖ ≤ τ * Sa * Sb := by
    refine ap.Λc_pair_small_le' hI hcd hac.symm hbc.symm had.symm hbd.symm hab _ hYc hτ hpair
      (by simp only [Function.update_of_ne hcd, Function.update_self]; rfl) ?_ hSa0 hSb0 ?_ ?_
    · simp only [Function.update_self]
      exact augPhys_cellLp hYd
    · simp only [Function.update_of_ne hac, Function.update_of_ne had, X, Function.update_self]
      exact (augPhys_normalized_le A.G I ch).trans (ENNReal.ofReal_le_ofReal hSa)
    · simp only [Function.update_of_ne hbc, Function.update_of_ne hbd, X,
        Function.update_of_ne hab.symm]
      exact (augPhys_normalized_le A.G I (x b)).trans (ENNReal.ofReal_le_ofReal hSb)
  -- the corrections
  have hprod : ∀ (v w : ColumnL2 (Fin ap.Mc)),
      ‖ap.Λc I (Function.update (Function.update X c v) d w)‖ ≤
        localFormUniformConstant κ' * (Sa * Sb * ((‖rI v‖ / s) * (‖rI w‖ / s))) := by
    intro v w
    refine (ap.norm_Λc_le_restrict I _).trans ?_
    rw [prod_fin4_distinct hab hac had hbc hbd hcd]
    simp only [Function.update_self, Function.update_of_ne hac, Function.update_of_ne had,
      Function.update_of_ne hbc, Function.update_of_ne hbd, Function.update_of_ne hab.symm, X,
      Function.update_of_ne hcd]
    refine mul_le_mul_of_nonneg_left ?_ hC
    have h0 : 0 ≤ (‖rI v‖ / s) * (‖rI w‖ / s) := by positivity
    calc _ = (‖rI ch‖ / s * (‖rI (x b)‖ / s)) * ((‖rI v‖ / s) * (‖rI w‖ / s)) := by ring
      _ ≤ _ := mul_le_mul_of_nonneg_right (mul_le_mul hrSa hrSb (by positivity) hSa0) h0
  have h2 := hprod (Yc - bc) Yd
  have h3 := hprod (Yc - (Yc - bc)) (Yd - bd)
  rw [sub_sub_cancel] at h3
  calc _ ≤ ‖ap.Λc I (Function.update (Function.update X c Yc) d Yd)‖ +
        ‖ap.Λc I (Function.update (Function.update X c (Yc - bc)) d Yd)‖ +
        ‖ap.Λc I (Function.update (Function.update X c (Yc - (Yc - bc))) d (Yd - bd))‖ :=
        (norm_sub_le _ _).trans (add_le_add (norm_sub_le _ _) le_rfl)
    _ ≤ τ * Sa * Sb + localFormUniformConstant κ' * (Sa * Sb * ((‖rI (Yc - bc)‖ / s) *
          (‖rI Yd‖ / s))) + localFormUniformConstant κ' * (Sa * Sb * ((‖rI bc‖ / s) *
          (‖rI (Yd - bd)‖ / s))) := by
        rw [sub_sub_cancel]
        exact add_le_add (add_le_add h1 h2) h3
    _ = _ := by ring

