theorem Λc_congr_restrict (I : ℤ × ℤ) {x y : Fin 4 → ColumnL2 (Fin ap.Mc)}
    (h : ∀ l, columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (x l) =
      columnL2Restriction (dyadicGridCell A.G I.1 I.2)
