    rw [Finset.sum_singleton]
  · intro I hI a b c d hab hac had hbc hbd hcd hau G hG
    have hV : T.Val a b c d := ⟨hab, hac, had, hbc, hbd, hcd, hau⟩
    by_cases hU : T.Ucase I c d
