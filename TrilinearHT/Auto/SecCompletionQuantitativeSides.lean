  obtain ⟨Cq, hCq, hns⟩ := near_band_stacks.{0} κ hq2 hq3
  refine ⟨Cq, hCq, ?_⟩
  intro c₀ A ap K Nd N hKNd hK hKN hanc M Ms U bs off hUc hUo β u a b c hab hac hbc F Y Xs Wv
