complement bands and the frozen other complement. -/
noncomputable def nf (a b c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) (j o : ℕ) : ℂ :=
  ap.nearForm I a b (eSlot c d (T.desc c d t t') j) (fSlot c d (T.desc c d t t') j) 0 (ap.uo o)
