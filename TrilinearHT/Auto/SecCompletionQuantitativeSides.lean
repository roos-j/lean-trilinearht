    {τ : ℝ} (hτ : 0 ≤ τ)
    (hpair : ∀ I ∈ S, ∀ c d, c ≠ d → ¬ T.D.usl c → ¬ T.D.usl d →
      PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) c d
        (Yf I c d c) (Yf I c d d) τ)
    {cF : ℝ} (hcF : 0 ≤ cF)
    (hfar : ∀ I ∈ S, ∀ G ∈ gs I, ∀ a b c d, T.Val a b c d → ¬ T.Ucase I c d →
