variable {ap : A.AttemptParams} (T : ap.TTData)

/-- The leaf output of slot `l` and group `G` at a cell. -/
noncomputable def out (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) : ColumnL2 (Fin ap.Mc) :=
  ap.leafOut T.cat T.s I l G

/-- The side of slot `l` and group `G` at a cell. -/
noncomputable def side (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) : ColumnL2 (Fin ap.Mc) :=
  T.D.side l G I (T.out l G I) (T.out l G (T.D.dcell I))

/-- The global side of a basic slot in the block starting at `b`. -/
noncomputable def gside (l : Fin 4) (G : A.Grp) (b h : ℤ) : ColumnL2 (Fin ap.Mc) :=
  T.D.gSide T.cat T.hR T.hbc T.s l G (T.P₁ l) (T.P₂ l) b h

/-- The merged descriptors of a pair of positive chains of the complement slots `c, d`. -/
def desc (c d : Fin 4) (t t' : List ℕ) : List (Bool × ℕ × Option ℕ) := ap.mergeDesc T.s c d t t'

/-- The complement band family of the step `j` at the offset `o` at the depth `h`. -/
noncomputable def Y (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j o : ℕ) (h : ℤ) (p : ℕ) :
    ColumnL2 (Fin ap.Mc) :=
  ap.Yfr T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G (T.desc c d t t') (T.P₁ c) (T.P₂ c)
    (T.P₁ d) (T.P₂ d) j o h p

/-- The other complement of the step `j` at the depth `h`. -/
noncomputable def F (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j : ℕ) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) :=
  ap.Ffr T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G (T.desc c d t t') (T.P₁ c) (T.P₂ c)
    (T.P₁ d) (T.P₂ d) j h

/-- The helper bands of the step `j` of a side value at the depth `h`. -/
noncomputable def X (c d : Fin 4) (G : A.Grp) (t t' : List ℕ) (j : ℕ) (h : ℤ)
    (xa : ColumnL2 (Fin ap.Mc)) (p : ℕ) : ColumnL2 (Fin ap.Mc) :=
  ap.Xband T.cat T.hcat T.hR T.hbc T.hbh T.rH T.s c d G (T.desc c d t t') j h xa p

end TTData

