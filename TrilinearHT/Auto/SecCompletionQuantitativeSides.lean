/-- Collapsing the banded slot: summing the use indicators over `e` drops the condition that the
step bands `e`. -/
theorem sum_e_nU (S : Finset (ℤ × ℤ)) (gs : ℤ × ℤ → Finset A.Grp) (C₀ : ℝ) (a b : Fin 4)
    (Ms : Finset ((Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ)) (I : ℤ × ℤ)
    (g : (Fin 4 × Fin 4 × ℕ × ℕ × ℕ × ℕ) × A.Grp × ℕ → ℝ) :
    ∑ e : Fin 4, ∑ m ∈ Ms, (if I ∈ T.nU S gs C₀ a b e m then g m else 0) =
      ∑ m ∈ Ms, (if I ∈ S ∧ m.2.1 ∈ gs I ∧ T.bk I = m.2.2 ∧ T.Val a b m.1.1 m.1.2.1 ∧
        ¬ T.Ucase I m.1.1 m.1.2.1 ∧ m.1.2.2.1 < (T.pe m.1.1).length ∧
        m.1.2.2.2.1 < (T.pe m.1.2.1).length ∧
        m.1.2.2.2.2.1 < (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
          (T.tOf m.1.2.1 m.1.2.2.2.1)).length ∧
        T.unfl C₀ I m.2.1 m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1) (T.tOf m.1.2.1 m.1.2.2.2.1)
          m.1.2.2.2.2.1 m.1.2.2.2.2.2 then g m else 0) := by
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun m _ => ?_
  rw [Finset.sum_eq_single (eSlot m.1.1 m.1.2.1 (T.desc m.1.1 m.1.2.1 (T.tOf m.1.1 m.1.2.2.1)
    (T.tOf m.1.2.1 m.1.2.2.2.1)) m.1.2.2.2.2.1)]
  · unfold nU
    simp only [Finset.mem_filter, true_and]
  · intro e _ he
    unfold nU
    split_ifs with h
    · exact absurd (Finset.mem_filter.mp h).2.2.2.2.2.2.2.2.1.symm he
    · rfl
  · intro h; exact absurd (Finset.mem_univ _) h

