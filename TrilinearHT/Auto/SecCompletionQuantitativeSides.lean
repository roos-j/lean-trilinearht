open Classical in
/-- `lem:cuts` for finitely many families of nonnegative cell weights with integrated budgets
`Σ_I |I| a_ν(I) ≤ B_ν |R|`: one first-crossing cut of total length at most `ρ |R|` makes all
retained path sums of every family at most `(Σ_ν B_ν)/ρ`. -/
theorem caps_cut (Gd : RealDyadicGrid) (S : Finset (ℤ × ℤ)) (root : ℤ × ℤ)
    (hroot : ∀ I ∈ S, dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd root.1 root.2)
    {ν : Type*} [Fintype ν] (a : ν → ℤ × ℤ → ℝ) (ha : ∀ v, ∀ I ∈ S, 0 ≤ a v I) (B : ν → ℝ)
    (hB : ∀ v, ∑ I ∈ S, dyadicGridLength Gd I.1 * a v I ≤ B v * dyadicGridLength Gd root.1)
    {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    ∃ C : Finset (ℤ × ℤ), C ⊆ S ∧ dyadicRootLength Gd C ≤ ρ * dyadicGridLength Gd root.1 ∧
      ∀ v x, ∑ I ∈ (S.filter fun I => ¬ ∃ c ∈ C,
          dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd c.1 c.2).filter
          (fun I => x ∈ dyadicGridCell Gd I.1 I.2), a v I ≤ (∑ v, B v) / ρ := by
  obtain ⟨hlen, hcap⟩ := side_caps_of_budgets Gd S a ha root hroot B hB hρ hρ1
  set T := (∑ v, B v) / ρ
  set C := dyadicFirstCrossings Gd S (fun I => ∑ v, a v I) T
  refine ⟨C, fun c hc => (Finset.mem_filter.mp (maximalDyadicCells_subset Gd _ hc)).1, hlen,
    fun v x => ?_⟩
  refine le_trans ?_ (hcap x)
  unfold dyadicRealPathSum
  refine le_trans ?_ (Finset.sum_le_sum_of_subset_of_nonneg (s := (S.filter fun I => ¬ ∃ c ∈ C,
      dyadicGridCell Gd I.1 I.2 ⊆ dyadicGridCell Gd c.1 c.2).filter
      (fun I => x ∈ dyadicGridCell Gd I.1 I.2)) (fun I hI => ?_)
    fun I hI _ => Finset.sum_nonneg fun v _ => ha v I
      (Finset.mem_filter.mp (Finset.mem_filter.mp hI).1).1)
  · refine Finset.sum_le_sum fun I hI => ?_
    have hIS := (Finset.mem_filter.mp (Finset.mem_filter.mp hI).1).1
    exact Finset.single_le_sum (f := fun v => a v I) (fun v _ => ha v I hIS) (Finset.mem_univ v)
  · have hI' := Finset.mem_filter.mp hI
    have hIS := (Finset.mem_filter.mp hI'.1).1
    have hno := (Finset.mem_filter.mp hI'.1).2
    refine Finset.mem_filter.mpr ⟨?_, hI'.2⟩
    unfold dyadicRetainedCells
    refine Finset.mem_filter.mpr ⟨hIS, ?_⟩
    by_contra hbad
    rw [not_le] at hbad
    obtain ⟨c, hc, hIc⟩ := maximalDyadicCells_covers Gd
      (dyadicBadCells Gd S (fun I => ∑ v, a v I) T) (Finset.mem_filter.mpr ⟨hIS, hbad⟩)
    exact hno ⟨c, hc, hIc⟩

/-- Cauchy-Schwarz for a sum over a finset of size at most `n`. -/
theorem sq_sum_le_of_card {ι : Type*} (s : Finset ι) (f : ι → ℝ) {n : ℝ} (hs : (s.card : ℝ) ≤ n) :
    (∑ i ∈ s, f i) ^ 2 ≤ n * ∑ i ∈ s, f i ^ 2 :=
  (sq_sum_le_card_mul_sum_sq (s := s) (f := f)).trans
    (mul_le_mul_of_nonneg_right hs (Finset.sum_nonneg fun _ _ => sq_nonneg _))

/-- `(a + b)² ≤ 2 a² + 2 b²`. -/
theorem add_sq_le_two (a b : ℝ) : (a + b) ^ 2 ≤ 2 * a ^ 2 + 2 * b ^ 2 := by
  nlinarith [sq_nonneg (a - b)]

/-- `(a + b + c)² ≤ 3 (a² + b² + c²)`. -/
theorem add3_sq_le (a b c : ℝ) : (a + b + c) ^ 2 ≤ 3 * (a ^ 2 + b ^ 2 + c ^ 2) := by
  nlinarith [sq_nonneg (a - b), sq_nonneg (b - c), sq_nonneg (a - c)]

open Classical in
/-- The square of the freeze and flag factor at a cell, times the cell length. -/
theorem theta_sq {L C₀ Cκ FY x : ℝ} (hL : 0 < L) (hFY : 0 ≤ FY) (U : Prop) :
    L * (Cκ * (4 * C₀ * (Real.sqrt FY / Real.sqrt L) + C₀ * (x / Real.sqrt L) +
      (if U then 0 else C₀ ^ 2))) ^ 2 ≤
      Cκ ^ 2 * 3 * (16 * C₀ ^ 2 * FY + C₀ ^ 2 * x ^ 2 + (if U then 0 else C₀ ^ 4 * L)) := by
  have hs := Real.sqrt_pos.mpr hL
  have h3 := add3_sq_le (4 * C₀ * (Real.sqrt FY / Real.sqrt L)) (C₀ * (x / Real.sqrt L))
    (if U then 0 else C₀ ^ 2)
  have hC : 0 ≤ Cκ ^ 2 := sq_nonneg _
  rw [mul_pow, ← mul_assoc, mul_comm L, mul_assoc]
  calc Cκ ^ 2 * (L * (4 * C₀ * (Real.sqrt FY / Real.sqrt L) + C₀ * (x / Real.sqrt L) +
        (if U then 0 else C₀ ^ 2)) ^ 2)
      ≤ Cκ ^ 2 * (L * (3 * ((4 * C₀ * (Real.sqrt FY / Real.sqrt L)) ^ 2 +
        (C₀ * (x / Real.sqrt L)) ^ 2 + (if U then 0 else C₀ ^ 2) ^ 2))) :=
        mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h3 hL.le) hC
    _ = _ := by
        simp only [mul_pow, div_pow, Real.sq_sqrt hFY, Real.sq_sqrt hL.le]
        split_ifs <;> field_simp <;> ring

/-- The square of the restoration factor at a cell, times the cell length. -/
theorem rst_sq_le {L Cκ x y u v Cy : ℝ} (hL : 0 < L) (hy0 : 0 ≤ y) (hy : y ≤ Cy) (hu0 : 0 ≤ u)
    (hu : u ≤ Cy) :
    L * (Cκ * (x / Real.sqrt L * y + u * (v / Real.sqrt L))) ^ 2 ≤
      Cκ ^ 2 * (2 * Cy ^ 2 * (x ^ 2 + v ^ 2)) := by
  have hs := Real.sqrt_pos.mpr hL
  have e1 : L * (x / Real.sqrt L) ^ 2 = x ^ 2 := by
    rw [div_pow, Real.sq_sqrt hL.le]; field_simp
  have e2 : L * (v / Real.sqrt L) ^ 2 = v ^ 2 := by
    rw [div_pow, Real.sq_sqrt hL.le]; field_simp
  have h1 := add_sq_le_two (x / Real.sqrt L * y) (u * (v / Real.sqrt L))
  have hy2 : y ^ 2 ≤ Cy ^ 2 := pow_le_pow_left₀ hy0 hy 2
  have hu2 : u ^ 2 ≤ Cy ^ 2 := pow_le_pow_left₀ hu0 hu 2
  have hx2 : 0 ≤ (x / Real.sqrt L) ^ 2 := sq_nonneg _
  have hv2 : 0 ≤ (v / Real.sqrt L) ^ 2 := sq_nonneg _
  have h2 : (x / Real.sqrt L * y + u * (v / Real.sqrt L)) ^ 2 ≤
      2 * Cy ^ 2 * ((x / Real.sqrt L) ^ 2 + (v / Real.sqrt L) ^ 2) := by
    rw [mul_pow, mul_pow] at h1
    nlinarith
  rw [mul_pow, ← mul_assoc, mul_comm L, mul_assoc]
  refine mul_le_mul_of_nonneg_left ?_ (sq_nonneg _)
  calc L * (x / Real.sqrt L * y + u * (v / Real.sqrt L)) ^ 2
      ≤ L * (2 * Cy ^ 2 * ((x / Real.sqrt L) ^ 2 + (v / Real.sqrt L) ^ 2)) :=
        mul_le_mul_of_nonneg_left h2 hL.le
    _ = 2 * Cy ^ 2 * (L * (x / Real.sqrt L) ^ 2 + L * (v / Real.sqrt L) ^ 2) := by ring
    _ = _ := by rw [e1, e2]

/-- Cauchy-Schwarz for a double sum over ranges of sizes at most `n` and `m`. -/
theorem sq_sum2_le (s : Finset ℕ) (t : ℕ → Finset ℕ) (f : ℕ → ℕ → ℝ) {n m : ℝ}
    (hs : (s.card : ℝ) ≤ n) (ht : ∀ i, ((t i).card : ℝ) ≤ m) (hn : 0 ≤ n) :
    (∑ i ∈ s, ∑ j ∈ t i, f i j) ^ 2 ≤ n * m * ∑ i ∈ s, ∑ j ∈ t i, f i j ^ 2 := by
  calc (∑ i ∈ s, ∑ j ∈ t i, f i j) ^ 2 ≤ n * ∑ i ∈ s, (∑ j ∈ t i, f i j) ^ 2 :=
        sq_sum_le_of_card s _ hs
    _ ≤ n * ∑ i ∈ s, m * ∑ j ∈ t i, f i j ^ 2 :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun i _ => sq_sum_le_of_card _ _ (ht i)) hn
    _ = _ := by rw [← Finset.mul_sum]; ring

/-- The per-pair bound of the third strong factor:
`L (a + Σ_{j,o} y)² ≤ 2 (1 + 5 J) (A + D Σ B)`. -/
theorem pair_sq_le {L a Aa D : ℝ} (J O : Finset ℕ) (y Bt : ℕ → ℕ → ℝ) {Jm : ℕ} (hL : 0 < L)
    (hJ : J.card ≤ Jm) (hO : O.card = 5) (ha : L * a ^ 2 ≤ Aa)
    (hy : ∀ j o, L * y j o ^ 2 ≤ D * Bt j o) (hD : 0 ≤ D) (hAa : 0 ≤ Aa)
    (hBt : ∀ j o, 0 ≤ Bt j o) :
    L * (a + ∑ j ∈ J, ∑ o ∈ O, y j o) ^ 2 ≤ 2 * (1 + 5 * Jm) * (Aa + D * ∑ j ∈ J, ∑ o ∈ O, Bt j o)
        := by
  have h1 := add_sq_le_two a (∑ j ∈ J, ∑ o ∈ O, y j o)
  have hJm : (J.card : ℝ) ≤ Jm := by exact_mod_cast hJ
  have h2 := sq_sum2_le J (fun _ => O) y (n := (Jm : ℝ)) (m := 5) hJm
    (fun _ => by rw [hO]; norm_num) (Nat.cast_nonneg Jm)
  have h3 : L * ∑ j ∈ J, ∑ o ∈ O, y j o ^ 2 ≤ D * ∑ j ∈ J, ∑ o ∈ O, Bt j o := by
    rw [Finset.mul_sum, Finset.mul_sum]
    refine Finset.sum_le_sum fun j _ => ?_
    rw [Finset.mul_sum, Finset.mul_sum]
    exact Finset.sum_le_sum fun o _ => hy j o
  have hB : 0 ≤ D * ∑ j ∈ J, ∑ o ∈ O, Bt j o :=
    mul_nonneg hD (Finset.sum_nonneg fun j _ => Finset.sum_nonneg fun o _ => hBt j o)
  have hJ0 : (0 : ℝ) ≤ Jm := Nat.cast_nonneg Jm
  calc L * (a + ∑ j ∈ J, ∑ o ∈ O, y j o) ^ 2
      ≤ L * (2 * a ^ 2 + 2 * (Jm * 5 * ∑ j ∈ J, ∑ o ∈ O, y j o ^ 2)) := by
        refine mul_le_mul_of_nonneg_left (h1.trans ?_) hL.le
        nlinarith
    _ = 2 * (L * a ^ 2) + 10 * Jm * (L * ∑ j ∈ J, ∑ o ∈ O, y j o ^ 2) := by ring
    _ ≤ 2 * Aa + 10 * Jm * (D * ∑ j ∈ J, ∑ o ∈ O, Bt j o) := by
        have := mul_le_mul_of_nonneg_left h3 (by positivity : (0 : ℝ) ≤ 10 * Jm)
        linarith
    _ ≤ _ := by nlinarith

/-- Assembling the per-pair bounds over the pairs of positive chains by Cauchy-Schwarz. -/
theorem pairs_sq_le {L Lp K A D : ℝ} (s : Finset ℕ) (t : ℕ → Finset ℕ) (X B : ℕ → ℕ → ℝ)
    (hL : 0 ≤ L) (hK : 0 ≤ K) (hA : 0 ≤ A) (hD : 0 ≤ D) (hLp : 0 ≤ Lp)
    (hs : (s.card : ℝ) ≤ Lp) (ht : ∀ i, ((t i).card : ℝ) ≤ Lp)
    (hX : ∀ i ∈ s, ∀ j ∈ t i, L * X i j ^ 2 ≤ K * (A + D * B i j)) (hB : ∀ i j, 0 ≤ B i j) :
    L * (∑ i ∈ s, ∑ j ∈ t i, X i j) ^ 2 ≤ Lp ^ 2 * K * (Lp ^ 2 * A + D * ∑ i ∈ s, ∑ j ∈ t i, B i j)
        := by
  have h1 := sq_sum2_le s t X hs ht hLp
  have hcnt : ∑ i ∈ s, ((t i).card : ℝ) ≤ Lp ^ 2 := by
    calc ∑ i ∈ s, ((t i).card : ℝ) ≤ ∑ _i ∈ s, Lp := Finset.sum_le_sum fun i _ => ht i
      _ = s.card * Lp := by rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ Lp * Lp := mul_le_mul_of_nonneg_right hs hLp
      _ = Lp ^ 2 := by ring
  have h2 : L * ∑ i ∈ s, ∑ j ∈ t i, X i j ^ 2 ≤
      K * (∑ i ∈ s, ((t i).card : ℝ) * A + D * ∑ i ∈ s, ∑ j ∈ t i, B i j) := by
    calc L * ∑ i ∈ s, ∑ j ∈ t i, X i j ^ 2 = ∑ i ∈ s, ∑ j ∈ t i, L * X i j ^ 2 := by
          simp only [Finset.mul_sum]
      _ ≤ ∑ i ∈ s, ∑ j ∈ t i, K * (A + D * B i j) :=
          Finset.sum_le_sum fun i hi => Finset.sum_le_sum fun j hj => hX i hi j hj
      _ = K * (∑ i ∈ s, ((t i).card : ℝ) * A + D * ∑ i ∈ s, ∑ j ∈ t i, B i j) := by
          simp only [Finset.mul_sum, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [← Finset.mul_sum, Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul]
  have hB0 : 0 ≤ D * ∑ i ∈ s, ∑ j ∈ t i, B i j :=
    mul_nonneg hD (Finset.sum_nonneg fun i _ => Finset.sum_nonneg fun j _ => hB i j)
  have hc : ∑ i ∈ s, ((t i).card : ℝ) * A ≤ Lp ^ 2 * A := by
    rw [← Finset.sum_mul]; exact mul_le_mul_of_nonneg_right hcnt hA
  calc L * (∑ i ∈ s, ∑ j ∈ t i, X i j) ^ 2 ≤ L * (Lp * Lp * ∑ i ∈ s, ∑ j ∈ t i, X i j ^ 2) :=
        mul_le_mul_of_nonneg_left h1 hL
    _ = Lp ^ 2 * (L * ∑ i ∈ s, ∑ j ∈ t i, X i j ^ 2) := by ring
    _ ≤ Lp ^ 2 * (K * (∑ i ∈ s, ((t i).card : ℝ) * A + D * ∑ i ∈ s, ∑ j ∈ t i, B i j)) :=
        mul_le_mul_of_nonneg_left h2 (sq_nonneg _)
    _ ≤ Lp ^ 2 * (K * (Lp ^ 2 * A + D * ∑ i ∈ s, ∑ j ∈ t i, B i j)) := by gcongr
    _ = _ := by ring

namespace ActiveSetup

namespace AttemptParams

namespace TTData

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (T : ap.TTData)

open Classical in
/-- The square of the third strong factor of a basic tuple, times the cell length, is bounded by
the restoration differences, and over the chains, steps and offsets by the freeze differences and
the flags. -/
theorem strTh_sq (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (Yfc Yfd : ℝ → ℂ)
    (Yb : List ℕ → List ℕ → ℕ → ℕ → ℕ → ColumnL2 (Fin ap.Mc))
    (Fb : List ℕ → List ℕ → ℕ → ColumnL2 (Fin ap.Mc)) (Unfl : List ℕ → List ℕ → ℕ → ℕ → Prop)
    {C₀ Cy : ℝ} {Lp Jm : ℕ} (hLp : ∀ l, (T.pe l).length ≤ Lp)
    (hJm : ∀ i i', (T.desc c d (T.tOf c i) (T.tOf d i')).length ≤ Jm)
    (hyd : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfd))‖ /
        Real.sqrt (dyadicGridLength A.G I.1) ≤ Cy)
    (hbc : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ /
        Real.sqrt (dyadicGridLength A.G I.1) ≤ Cy) :
    dyadicGridLength A.G I.1 * T.strTh c d G I Yfc Yfd Yb Fb Unfl C₀ ^ 2 ≤
      Lp ^ 2 * (2 * (1 + 5 * Jm)) *
        (Lp ^ 2 * (localFormUniformConstant κ' ^ 2 * (2 * Cy ^ 2 *
          (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2)
            (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfc) -
              physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ ^ 2 +
          ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2)
            (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfd) -
              physicalColumnInput (V := Fin ap.Mc) (ap.base I d))‖ ^ 2))) +
        (2 / (ap.P : ℝ) * localFormUniformConstant κ') ^ 2 * 3 *
          ∑ i' ∈ Finset.range (T.pe d).length, ∑ i ∈ Finset.range (T.pe c).length,
            ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
              ∑ o ∈ Finset.range 5, (16 * C₀ ^ 2 * ∑ p ∈ ap.uo o,
                ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
                  (dyadicGridCell_measurable A.G I.1 I.2)
                  (T.Y c d G (T.tOf c i) (T.tOf d i') j o I.1 p -
                    Yb (T.tOf c i) (T.tOf d i') j o p)‖ ^ 2 +
                C₀ ^ 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
                  (dyadicGridCell_measurable A.G I.1 I.2)
                  (T.F c d G (T.tOf c i) (T.tOf d i') j I.1 - Fb (T.tOf c i) (T.tOf d i') j)‖ ^ 2 +
                (if Unfl (T.tOf c i) (T.tOf d i') j o then 0 else
                  C₀ ^ 4 * dyadicGridLength A.G I.1))) := by
  have hL := dyadicGridLength_pos A.G I.1
  have hCκ := localFormUniformConstant_nonneg κ'
  have hP2 : (0 : ℝ) ≤ 2 / (ap.P : ℝ) := by positivity
  have hA : dyadicGridLength A.G I.1 *
      (localFormUniformConstant κ' * ap.rstF I c d Yfc Yfd) ^ 2 ≤
      localFormUniformConstant κ' ^ 2 * (2 * Cy ^ 2 *
          (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2)
            (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfc) -
              physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ ^ 2 +
          ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2)
            (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfd) -
              physicalColumnInput (V := Fin ap.Mc) (ap.base I d))‖ ^ 2)) := by
    unfold rstF
    exact rst_sq_le hL (by positivity) hyd (by positivity) hbc
  have hA0 : 0 ≤ localFormUniformConstant κ' ^ 2 * (2 * Cy ^ 2 *
          (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2)
            (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfc) -
              physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ ^ 2 +
          ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2)
            (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfd) -
              physicalColumnInput (V := Fin ap.Mc) (ap.base I d))‖ ^ 2)) := by positivity
  unfold strTh
  rw [list_map_sum_range _ (0, [])]
  simp only [list_map_sum_range _ ((0 : ℤ), ([] : List ℕ))]
  have hLp0 : (0 : ℝ) ≤ Lp := Nat.cast_nonneg Lp
  have hcard : ∀ l, ((Finset.range (T.pe l).length).card : ℝ) ≤ Lp := fun l => by
    rw [Finset.card_range]; exact_mod_cast hLp l
  have hD : (0 : ℝ) ≤ (2 / (ap.P : ℝ) * localFormUniformConstant κ') ^ 2 * 3 := by positivity
  refine (pairs_sq_le (Finset.range (T.pe d).length) (fun _ => Finset.range (T.pe c).length) _
    (fun i' i => ∑ j ∈ Finset.range (T.desc c d (T.tOf c i) (T.tOf d i')).length,
      ∑ o ∈ Finset.range 5, (16 * C₀ ^ 2 * ∑ p ∈ ap.uo o,
        ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2)
          (T.Y c d G (T.tOf c i) (T.tOf d i') j o I.1 p -
            Yb (T.tOf c i) (T.tOf d i') j o p)‖ ^ 2 +
        C₀ ^ 2 * ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2)
          (T.F c d G (T.tOf c i) (T.tOf d i') j I.1 - Fb (T.tOf c i) (T.tOf d i') j)‖ ^ 2 +
        (if Unfl (T.tOf c i) (T.tOf d i') j o then 0 else
          C₀ ^ 4 * dyadicGridLength A.G I.1)))
    hL.le (by positivity) hA0 hD hLp0 (hcard d) (fun _ => hcard c) ?_ ?_).trans (le_of_eq rfl)
  · intro i' _ i _
    refine pair_sq_le _ _ _ _ hL (by rw [Finset.card_range]; exact hJm i i')
      (Finset.card_range 5) hA (fun j o => ?_) hD hA0 (fun j o => ?_)
    · have h := theta_sq (Cκ := localFormUniformConstant κ') (C₀ := C₀) hL
        (FY := ∑ p ∈ ap.uo o, ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2)
          (T.Y c d G (T.tOf c i) (T.tOf d i') j o I.1 p -
            Yb (T.tOf c i) (T.tOf d i') j o p)‖ ^ 2) (Finset.sum_nonneg fun _ _ => sq_nonneg _)
        (x := ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
          (dyadicGridCell_measurable A.G I.1 I.2)
          (T.F c d G (T.tOf c i) (T.tOf d i') j I.1 - Fb (T.tOf c i) (T.tOf d i') j)‖)
        (Unfl (T.tOf c i) (T.tOf d i') j o)
      have hP2' : (0 : ℝ) ≤ (2 / (ap.P : ℝ)) ^ 2 := sq_nonneg _
      rw [mul_pow, mul_left_comm]
      exact (mul_le_mul_of_nonneg_left h hP2').trans (le_of_eq (by ring))
