theorem nf_eq {a b c d e : Fin 4} (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) {j : ℕ} (o : ℕ)
    (hj : j < (T.desc c d t t').length) (he : eSlot c d (T.desc c d t t') j = e)
