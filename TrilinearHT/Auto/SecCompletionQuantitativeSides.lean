section FreezeFour

variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- Blueprint lines 2388-2393 (freezing both complements and splitting the unbounded frozen one):
`Λ(Y, F) = Λ(Y_b, F_b) + Λ(Y - Y_b, F) + Λ(Y, F - F_b) - Λ(Y - Y_b, F - F_b)` in two slots. -/
theorem freeze_four (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {e f : Fin 4} (hef : e ≠ f)
    (x : Fin 4 → E) (Yc Yb Fc Fb : E) :
    Λ (Function.update (Function.update x e Yc) f Fc) =
      Λ (Function.update (Function.update x e Yb) f Fb) +
        Λ (Function.update (Function.update x e (Yc - Yb)) f Fc) +
        Λ (Function.update (Function.update x e Yc) f (Fc - Fb)) -
        Λ (Function.update (Function.update x e (Yc - Yb)) f (Fc - Fb)) := by
  have hc : ∀ A B : E, Λ (Function.update (Function.update x e A) f B) =
      Λ (Function.update (Function.update x f B) e A) := fun A B => by
    rw [Function.update_comm hef]
  rw [Λ.map_update_sub, Λ.map_update_sub, hc (Yc - Yb), hc (Yc - Yb), Λ.map_update_sub,
    Λ.map_update_sub, ← hc Yc, ← hc Yb, ← hc Yc, ← hc Yb]
  ring

end FreezeFour

section BandCellBound

/-- Cauchy-Schwarz for a finite sum of products of norms. -/
theorem sum_mul_le_sqrt_mul_sqrt {β : Type*} (u : Finset β) (a b : β → ℝ) :
    ∑ p ∈ u, a p * b p ≤ Real.sqrt (∑ p ∈ u, a p ^ 2) * Real.sqrt (∑ p ∈ u, b p ^ 2) := by
  rw [← Real.sqrt_mul (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
  exact Real.le_sqrt_of_sq_le (Finset.sum_mul_sq_le_sq_mul_sq u a b)

/-- A product over the four slots, for four distinct slots. -/
theorem prod_fin4_distinct {a b e f : Fin 4} (hab : a ≠ b) (hae : a ≠ e) (haf : a ≠ f)
    (hbe : b ≠ e) (hbf : b ≠ f) (hef : e ≠ f) (g : Fin 4 → ℝ) :
    ∏ l, g l = g a * g b * g e * g f := by
  have hu : ({a, b, e, f} : Finset (Fin 4)) = Finset.univ := by
    refine Finset.eq_univ_of_card _ ?_
    rw [Finset.card_insert_of_notMem (by simp [hab, hae, haf]),
      Finset.card_insert_of_notMem (by simp [hbe, hbf]), Finset.card_pair hef]
    rfl
  rw [← hu, Finset.prod_insert (by simp [hab, hae, haf]),
    Finset.prod_insert (by simp [hbe, hbf]), Finset.prod_pair hef]
  ring

/-- Blueprint line 2393 (flags): if the current values `Y_c, F_c` have squares at most `C₀² L`
and one frozen value `Y_b` or `F_b` has square more than `4 C₀² L`, the squared differences are at
least `C₀² L`. -/
theorem flag_band_one {E : Type*} [SeminormedAddCommGroup E] {β : Type*} (u : Finset β)
    (Yb Yc : β → E) (Fb Fc : E) {C₀ L : ℝ} (hC₀L : 0 < C₀ ^ 2 * L)
    (hYc : ∑ p ∈ u, ‖Yc p‖ ^ 2 ≤ C₀ ^ 2 * L) (hFc : ‖Fc‖ ^ 2 ≤ C₀ ^ 2 * L)
    (hflag : 4 * (C₀ ^ 2 * L) < ∑ p ∈ u, ‖Yb p‖ ^ 2 ∨ 4 * (C₀ ^ 2 * L) < ‖Fb‖ ^ 2) :
    1 ≤ (∑ p ∈ u, ‖Yb p - Yc p‖ ^ 2 + ‖Fb - Fc‖ ^ 2) / (C₀ ^ 2 * L) := by
  rw [le_div_iff₀ hC₀L, one_mul]
  have hY : ∑ p ∈ u, ‖Yb p‖ ^ 2 ≤ 2 * ∑ p ∈ u, ‖Yb p - Yc p‖ ^ 2 + 2 * ∑ p ∈ u, ‖Yc p‖ ^ 2 := by
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_le_sum fun p _ => ?_
    have := norm_add_sq_le_two_mul (Yb p - Yc p) (Yc p)
    rwa [sub_add_cancel] at this
  have hF : ‖Fb‖ ^ 2 ≤ 2 * ‖Fb - Fc‖ ^ 2 + 2 * ‖Fc‖ ^ 2 := by
    have := norm_add_sq_le_two_mul (Fb - Fc) Fc
    rwa [sub_add_cancel] at this
  have h1 : 0 ≤ ∑ p ∈ u, ‖Yb p - Yc p‖ ^ 2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
  have h2 : 0 ≤ ‖Fb - Fc‖ ^ 2 := sq_nonneg _
  rcases hflag with h | h <;> linarith

end BandCellBound

/-- The energy average of a physical square sum on a cell is at most the restricted square norms
divided by the length. -/
theorem energyAverage_band_le (G : RealDyadicGrid) {V : Type*} [Fintype V] {β : Type*}
    (u : Finset β) (Y : β → ColumnL2 V) (d : ℤ × ℤ) :
    dyadicEnergyAverage G (fun r => ENNReal.ofReal (∑ p ∈ u, ‖augPhys (Y p) r‖ ^ 2)) d ≤
      ENNReal.ofReal ((∑ p ∈ u, ‖columnL2Restriction (dyadicGridCell G d.1 d.2)
        (dyadicGridCell_measurable G d.1 d.2) (Y p)‖ ^ 2) / dyadicGridLength G d.1) := by
  have hr := dyadicGridLength_pos G d.1
  unfold dyadicEnergyAverage
  rw [ENNReal.ofReal_div_of_pos hr]
  refine ENNReal.div_le_div_right ?_ _
  have hm : ∀ p, Measurable fun y => ENNReal.ofReal (‖augPhys (Y p) y‖ ^ 2) := fun p =>
    ENNReal.measurable_ofReal.comp ((columnPhys_measurable (Y p)).norm.pow_const 2)
  calc ∫⁻ x in dyadicGridCell G d.1 d.2, ENNReal.ofReal (∑ p ∈ u, ‖augPhys (Y p) x‖ ^ 2)
      = ∑ p ∈ u, ∫⁻ x in dyadicGridCell G d.1 d.2, ENNReal.ofReal (‖augPhys (Y p) x‖ ^ 2) := by
        rw [← lintegral_finsetSum _ fun p _ => hm p]
        exact lintegral_congr fun x =>
          ENNReal.ofReal_sum_of_nonneg fun p _ => by positivity
    _ ≤ ∑ p ∈ u, ENNReal.ofReal (‖columnL2Restriction (dyadicGridCell G d.1 d.2)
          (dyadicGridCell_measurable G d.1 d.2) (Y p)‖ ^ 2) := by
        refine Finset.sum_le_sum fun p _ => ?_
        rw [columnL2Restriction_norm_sq, ofReal_integral_eq_lintegral_ofReal
          ((Lp.memLp (Y p)).integrable_norm_pow two_ne_zero).integrableOn
          (Filter.Eventually.of_forall fun _ => by positivity)]
        refine lintegral_mono fun y => ENNReal.ofReal_le_ofReal
          (pow_le_pow_left₀ (norm_nonneg _) ?_ 2)
        unfold augPhys
        rw [EuclideanSpace.norm_eq]
        exact Real.le_sqrt_of_sq_le (Finset.single_le_sum
          (f := fun i => ‖(Y p : ℝ → ColumnHilbert V) y i‖ ^ 2) (fun _ _ => by positivity)
          (Finset.mem_univ none))
    _ = ENNReal.ofReal (∑ p ∈ u, ‖columnL2Restriction (dyadicGridCell G d.1 d.2)
          (dyadicGridCell_measurable G d.1 d.2) (Y p)‖ ^ 2) :=
        (ENNReal.ofReal_sum_of_nonneg fun p _ => by positivity).symm

/-- The energy average of one physical square on a cell is at most the restricted square norm
divided by the length. -/
theorem energyAverage_single_le (G : RealDyadicGrid) {V : Type*} [Fintype V] (F : ColumnL2 V)
    (d : ℤ × ℤ) :
    dyadicEnergyAverage G (fun r => ‖augPhys F r‖ₑ ^ 2) d ≤
      ENNReal.ofReal (‖columnL2Restriction (dyadicGridCell G d.1 d.2)
        (dyadicGridCell_measurable G d.1 d.2) F‖ ^ 2 / dyadicGridLength G d.1) := by
  have h := energyAverage_band_le G ({()} : Finset Unit) (fun _ => F) d
  simp only [Finset.sum_singleton] at h
  refine le_trans (le_of_eq ?_) h
  congr 1
  funext r
  rw [← ofReal_norm, ← ENNReal.ofReal_pow (norm_nonneg _)]

