theorem gSt_fst (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) (j : ℕ) (h : ℤ) :
