variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

open Classical in
/-- Blueprint lines 2386-2394 at one use: the global near band sum of the step `j` at the offset
`o` is at most, if the use is unflagged, the near band form with the frozen band family `Y_b` and
frozen complement `F_b`, plus `C_κ (‖W‖/s)(‖x_a‖/s)(4 C₀ δ_Y + C₀ δ_F + [flagged] C₀²)`. -/
theorem near_use (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) {a b c d : Fin 4} (hab : a ≠ b)
    (hac : a ≠ c) (had : a ≠ d) (hbc' : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {CF : ℝ} (P₁c P₂c P₁d P₂d : BasicProjection A.G A.R CF)
    {I : ℤ × ℤ} (hI : I ∈ A.cells) (xg : Fin 4 → ColumnL2 (Fin ap.Mc)) (xa : ColumnL2 (Fin ap.Mc))
    {j : ℕ} (hj : j < D.length) (o : ℕ) (z : Fin 4 → ColumnL2 (Fin ap.Mc))
    (Yb : ℕ → ColumnL2 (Fin ap.Mc)) (Fb : ColumnL2 (Fin ap.Mc)) (Unfl : Prop) {C₀ : ℝ}
    (hC₀ : 0 ≤ C₀)
    (hFc : ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (chainVal ap.P (!(ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1) (ap.gRest cat hcat hR
        hbc hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then
        ap.gIn P₁d P₂d I.1 else ap.gIn P₁c P₂c I.1))‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ C₀)
    (hYc : Real.sqrt (∑ p ∈ ((Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o - 2 ≤
        ap.P)), ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1
        I.2) ((fun p => (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.2 (p + o - 2 + 1)
        (chainVal ap.P (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 (ap.gRest cat hcat hR hbc
        hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then ap.gIn
        P₁c P₂c I.1 else ap.gIn P₁d P₂d I.1)) - (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.2
        (p + o - 2) (chainVal ap.P (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 (ap.gRest cat
        hcat hR hbc hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1
        then ap.gIn P₁c P₂c I.1 else ap.gIn P₁d P₂d I.1))) p)‖ ^ 2) / Real.sqrt (dyadicGridLength
        A.G I.1) ≤ C₀)
    (hFb : Unfl → ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G
        I.1 I.2) Fb‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ 2 * C₀) :
    ‖ap.nearTermG cat hcat hR hbc hbh rH s a c d G D P₁c P₂c P₁d P₂d I I.1 xg xa j o‖ ≤
      (if Unfl then ‖ap.nearForm I a b (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then c
          else d) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then d else c) z
          ((Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o - 2 ≤ ap.P)) (fun p =>
          (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.1 (p + 1) (helpPre ap.P (ap.gPre cat
          hcat hR hbc hbh rH s c d G D j I.1) xa) - (ap.gSt cat hcat hR hbc hbh rH s c d G D j
          I.1).2.1 p (helpPre ap.P (ap.gPre cat hcat hR hbc hbh rH s c d G D j I.1) xa)) Yb (xg b)
          Fb‖ else 0) +
        localFormUniformConstant κ' * ((‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
            (dyadicGridCell_measurable A.G I.1 I.2) (xg b)‖ / Real.sqrt (dyadicGridLength A.G I.1))
            * (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1
            I.2) xa‖ / Real.sqrt (dyadicGridLength A.G I.1)) *
          (4 * C₀ * (Real.sqrt (∑ p ∈ ((Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o
              - 2 ≤ ap.P)), ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
              (dyadicGridCell_measurable A.G I.1 I.2) ((fun p => (ap.gSt cat hcat hR hbc hbh rH s c
              d G D j I.1).2.2 (p + o - 2 + 1) (chainVal ap.P (ap.gSt cat hcat hR hbc hbh rH s c d G
              D j I.1).1 (ap.gRest cat hcat hR hbc hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR
              hbc hbh rH s c d G D j I.1).1 then ap.gIn P₁c P₂c I.1 else ap.gIn P₁d P₂d I.1)) -
              (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).2.2 (p + o - 2) (chainVal ap.P (ap.gSt
              cat hcat hR hbc hbh rH s c d G D j I.1).1 (ap.gRest cat hcat hR hbc hbh rH s c d G D j
              I.1) (if (ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1 then ap.gIn P₁c P₂c I.1
              else ap.gIn P₁d P₂d I.1))) p - Yb p)‖ ^ 2) / Real.sqrt (dyadicGridLength A.G I.1)) +
            C₀ * (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G
                I.1 I.2) ((chainVal ap.P (!(ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1).1)
                (ap.gRest cat hcat hR hbc hbh rH s c d G D j I.1) (if (ap.gSt cat hcat hR hbc hbh rH
                s c d G D j I.1).1 then ap.gIn P₁d P₂d I.1 else ap.gIn P₁c P₂c I.1)) - Fb)‖ /
                Real.sqrt (dyadicGridLength A.G I.1)) + (if Unfl then 0 else C₀ ^ 2))) := by
  rw [ap.nearTermG_eq cat hcat hR hbc hbh rH s hab hac had hbc' hbd hcd G D P₁c P₂c P₁d P₂d I I.1
    xg xa j o z]
  have hC := localFormUniformConstant_nonneg κ'
  have hs : 0 < Real.sqrt (dyadicGridLength A.G I.1) := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G
      I.1)
  -- the helper bands are bounded by the side value
  set st := ap.gSt cat hcat hR hbc hbh rH s c d G D j I.1
  have hu : (Finset.range (ap.P + 1)).filter (fun p => 2 ≤ p + o ∧ p + o - 2 ≤ ap.P) ⊆
      Finset.range (ap.P + 1) := Finset.filter_subset _ _
  have hX := (Real.sqrt_le_sqrt (ap.help_bands_bessel cat hcat hR hbc hbh rH s c d G D hj hI xa
    _ hu)).trans (le_of_eq (Real.sqrt_sq (norm_nonneg _)))
  have hX' := div_le_div_of_nonneg_right hX hs.le
  have hae : a ≠ (if st.1 then c else d) := by split_ifs <;> assumption
