/-! ### The pad families of a band step after its helper prefix (blueprint lines 2408-2420) -/

section PadFamC

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- The pad family `Q_0 = 0`, `Q_p` for `1 ≤ p ≤ P`, `Q_p = 1` beyond, as continuous maps. -/
noncomputable def padFamC {P : ℕ} (Q : Fin P → E →L[ℂ] E) (n : ℕ) : E →L[ℂ] E :=
  if n = 0 then 0 else if h : n - 1 < P then Q ⟨n - 1, h⟩ else ContinuousLinearMap.id ℂ E

theorem padFam_apply_eq {P : ℕ} (Q : Fin P → E →L[ℂ] E) (n : ℕ) (y : E) :
    padFam Q n y = padFamC Q n y := by
  unfold padFam padFamC
  split_ifs <;> rfl

/-- The pad family of nested star projections is a nested family of star projections, so its
bands are Bessel. -/
theorem padFamC_bessel [CompleteSpace E] {P : ℕ} (Q : Fin P → E →L[ℂ] E)
    (hQ : ∀ p, IsStarProjection (Q p))
    (hnest : ∀ p p' : Fin P, p ≤ p' → (Q p).comp (Q p') = Q p) (y : E) :
    ∑ p ∈ Finset.range (P + 1), ‖(padFamC Q (p + 1) - padFamC Q p) y‖ ^ 2 ≤ ‖y‖ ^ 2 := by
  refine bands_bessel (padFamC Q) (P + 1) (fun n _ => ?_) (fun i hi j hj hij => ?_) y
  · unfold padFamC
    split_ifs
    · exact IsStarProjection.zero _
    · exact hQ _
    · rw [← ContinuousLinearMap.one_def]; exact IsStarProjection.one _
  · unfold padFamC
    by_cases hi0 : i = 0
    · simp [hi0]
    · have hj0 : j ≠ 0 := by omega
      simp only [hi0, hj0, ite_false]
      by_cases hiP : i - 1 < P
      · by_cases hjP : j - 1 < P
        · simp only [hiP, hjP, ↓reduceDIte]
          exact hnest _ _ (Fin.mk_le_mk.mpr (by omega))
        · simp only [hiP, hjP, ↓reduceDIte]
          exact ContinuousLinearMap.comp_id _
      · have hjP : ¬ j - 1 < P := by omega
        simp only [hiP, hjP, ↓reduceDIte]
        exact ContinuousLinearMap.id_comp _

end PadFamC

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The pad families of the step `j` after the helper prefix of the steps before it, on one
catalog family with the masks `Am i p` of the steps: `A_n(h) = Q_n(h) ∘ T_j(h)`. -/
noncomputable def bandPads (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (j n : ℕ) (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  (padFamC (fun p => ((ap.cumBase catl hR hb).withMask (Am j p)).proj h) n).comp
    (globHist (ap.cumBase catl hR hb) Am ((List.range j).map fun i => (i, false)) h)

theorem bandPads_bessel (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (j : ℕ)
    (hnest : ∀ p p' : Fin ap.P, p ≤ p' →
      ∀ c ∈ (ap.cumBase catl hR hb).D.cells, (Am j p).labels c ⊆ (Am j p').labels c)
    (h : ℤ) (y : ColumnL2 (Fin ap.Mc)) :
    ∑ p ∈ Finset.range (ap.P + 1),
      ‖(ap.bandPads catl hR hb Am j (p + 1) h - ap.bandPads catl hR hb Am j p h) y‖ ^ 2 ≤
        ‖y‖ ^ 2 := by
  have hb' := padFamC_bessel (fun p => ((ap.cumBase catl hR hb).withMask (Am j p)).proj h)
    (fun p => ColumnDepthFamily.isStarProjection_proj _ _)
    (fun p p' hpp => ColumnDepthFamily.proj_mask_nested _ (hnest p p' hpp) h)
    (globHist (ap.cumBase catl hR hb) Am ((List.range j).map fun i => (i, false)) h y)
  refine le_trans (le_of_eq ?_) (hb'.trans (pow_le_pow_left₀ (norm_nonneg _)
    (globHist_norm_le _ ap.hP _ _ _ _) 2))
  refine Finset.sum_congr rfl fun p _ => ?_
  simp only [bandPads, sub_apply, ContinuousLinearMap.comp_apply]

theorem bandPads_comm (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (j n : ℕ) (h : ℤ)
    (J : ℤ × ℤ) (hJ : J.1 ≤ h) (hJN : J.1 ≤ A.R.1 + A.treeDepth) :
    (columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)).comp
      (ap.bandPads catl hR hb Am j n h) = (ap.bandPads catl hR hb Am j n h).comp
        (columnL2Restriction (dyadicGridCell A.G J.1 J.2)
          (dyadicGridCell_measurable A.G J.1 J.2)) := by
  set rJ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G J.1 J.2)
    (dyadicGridCell_measurable A.G J.1 J.2)
  have hd : ∀ M : InheritedColumnMask (ap.cumBase catl hR hb).D,
      J.1 ≤ ((ap.cumBase catl hR hb).withMask M).depth h := fun M => by
    change J.1 ≤ max (ap.cumBase catl hR hb).D.root.1 (min h (A.R.1 + A.treeDepth))
    exact le_max_of_le_right (le_min hJ hJN)
  have hpad : ∀ M : InheritedColumnMask (ap.cumBase catl hR hb).D,
      (((ap.cumBase catl hR hb).withMask M).proj h).comp rJ =
        rJ.comp (((ap.cumBase catl hR hb).withMask M).proj h) := fun M =>
    (((ap.cumBase catl hR hb).withMask M).proj_commute_restrict h (hd M)).symm
  have hQ : (padFamC (fun p => ((ap.cumBase catl hR hb).withMask (Am j p)).proj h) n).comp rJ =
      rJ.comp (padFamC (fun p => ((ap.cumBase catl hR hb).withMask (Am j p)).proj h) n) := by
    unfold padFamC
    split_ifs
    · simp
    · exact hpad _
    · simp
  have hhist := layerOp_commute
    (fun m => opAvg fun p : Fin ap.P => ((ap.cumBase catl hR hb).withMask (Am m p)).proj h) rJ
    (fun m => opAvg_commute _ _ fun p => hpad (Am m p)) ((List.range j).map fun i => (i, false))
  unfold bandPads globHist
  rw [← ContinuousLinearMap.comp_assoc, ← hQ, ContinuousLinearMap.comp_assoc,
    ContinuousLinearMap.comp_assoc, hhist]

/-- The fixed-input jump constant of the band pads of a step after `j` helper layers. -/
noncomputable def bandJumpC (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (j : ℕ) : ℝ :=
  2 * 1 * (compressionC (ap.cumBase catl hR hb).D j ^ 2 +
    j * (∑ m ∈ Finset.range j, compressionC (ap.cumBase catl hR hb).D m ^ 2))

theorem bandJumpC_nonneg (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (j : ℕ) : 0 ≤ ap.bandJumpC catl hR hb j := by
  unfold bandJumpC
  have : 0 ≤ ∑ m ∈ Finset.range j, compressionC (ap.cumBase catl hR hb).D m ^ 2 :=
    Finset.sum_nonneg fun _ _ => sq_nonneg _
  positivity

/-- Blueprint lines 2416-2420 (the product-jump estimate on a fixed input for the band pads):
the pad families of a step after its helper prefix have fixed-input jumps over disjoint depth
intervals, restricted to unions of active cells, bounded by `bandJumpC`. -/
theorem bandPads_jump (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (j n : ℕ)
    {ι : Type} [Fintype ι] (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (Ec : ι → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ J ∈ Ec i, J ∈ A.cells) (x : ColumnL2 (Fin ap.Mc)) :
    ∑ i, ‖columnL2Restriction (⋃ J ∈ Ec i, dyadicGridCell A.G J.1 J.2)
        (Finset.measurableSet_biUnion _ fun J _ => dyadicGridCell_measurable A.G J.1 J.2)
        ((ap.bandPads catl hR hb Am j n (A.R.1 + t i) -
          ap.bandPads catl hR hb Am j n (A.R.1 + r i)) x)‖ ^ 2 ≤
      ap.bandJumpC catl hR hb j * ‖x‖ ^ 2 := by
  set ls := (List.range j).map fun i => (i, false)
  have hls : ls.length = j := by simp [ls]
  have hC := ap.bandJumpC_nonneg catl hR hb j
  by_cases hn0 : n = 0
  · subst hn0
    simp only [bandPads, padFamC, ite_true, ContinuousLinearMap.zero_comp, sub_self,
      zero_apply, map_zero, norm_zero]
    simp only [ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow, Finset.sum_const_zero]
    positivity
  by_cases hnP : n - 1 < ap.P
  · have h := ap.padHist_jump catl hR hb (Am j ⟨n - 1, hnP⟩) Am ls r t hrt hdis Ec hEc x
    refine le_trans (le_of_eq (Finset.sum_congr rfl fun i _ => ?_)) (h.trans (le_of_eq ?_))
    · simp only [bandPads, padFamC, hn0, ite_false, hnP, ↓reduceDIte, padHistL, sub_apply]
      rfl
    · simp only [bandJumpC, hls]; ring
  · have h := globHist_jump (ap.cumBase catl hR hb) ap.hP Am ls r t hrt hdis x
    refine le_trans (Finset.sum_le_sum fun i _ => ?_) (h.trans ?_)
    · refine (columnL2Restriction_norm_sq_le _ _ _).trans (le_of_eq ?_)
      simp only [bandPads, padFamC, hn0, ite_false, hnP, ↓reduceDIte,
        ContinuousLinearMap.id_comp, sub_apply]
      rfl
    · rw [hls]
      unfold bandJumpC
      set S0 := ∑ m ∈ Finset.range j, compressionC (ap.cumBase catl hR hb).D m ^ 2
      have hS0 : 0 ≤ S0 := Finset.sum_nonneg fun _ _ => sq_nonneg _
      have h0 : 0 ≤ compressionC (ap.cumBase catl hR hb).D j ^ 2 * ‖x‖ ^ 2 := by positivity
      have h1 : 0 ≤ (j : ℝ) * S0 * ‖x‖ ^ 2 := by positivity
      have e : 2 * 1 * (compressionC (ap.cumBase catl hR hb).D j ^ 2 + j * S0) * ‖x‖ ^ 2 =
          2 * (compressionC (ap.cumBase catl hR hb).D j ^ 2 * ‖x‖ ^ 2) +
            2 * ((j : ℝ) * S0 * ‖x‖ ^ 2) := by ring
      rw [e]
      linarith

