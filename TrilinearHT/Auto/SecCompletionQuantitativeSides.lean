variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} {ap : A.AttemptParams}
  (D : ap.LeafSplit)

open Classical in
/-- Blueprint lines 2446-2456 at one cell: the restored `2+2` patterns (whole outputs in the core
slots, sides in the side slots) are at most six times the sum over the groups and slot tuples of
bounds of the restored forms with the helper side `a` not the slot `u`. -/
theorem two_two_cell (I : ℤ × ℤ) (gs : Finset A.Grp)
    (Zout ZU : Fin 4 → A.Grp → ColumnL2 (Fin ap.Mc)) (u : Fin 4)
    (Bnd : Fin 4 → Fin 4 → Fin 4 → Fin 4 → A.Grp → ℝ) (hB0 : ∀ a b c d G, 0 ≤ Bnd a b c d G)
    (hB : ∀ a b c d, a ≠ b → a ≠ c → a ≠ d → b ≠ c → b ≠ d → c ≠ d → a ≠ u → ∀ G ∈ gs,
      ‖ap.Λc I (Function.update (Function.update
        (fun l => D.side l G I (Zout l G) (ZU l G)) c (Zout c G)) d (Zout d G))‖ ≤
          Bnd a b c d G) :
    ‖∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        patternCount σ 0 = 2 ∧ patternCount σ 1 = 2),
      ∑ G ∈ gs, ap.Λc I (fun l => if σ l = 0 then
        π (D.core l G (I) (ZU l G)) + π (D.side l G I (Zout l G) (ZU l G)) +
          π (D.err l G I (ZU l G)) else π (D.side l G I (Zout l G) (ZU l G)))‖ ≤
      6 * ∑ G ∈ gs, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4, ∑ d : Fin 4, Bnd a b c d G := by
  set T := ∑ G ∈ gs, ∑ a : Fin 4, ∑ b : Fin 4, ∑ c : Fin 4, ∑ d : Fin 4, Bnd a b c d G
  have hσ : ∀ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
      patternCount σ 0 = 2 ∧ patternCount σ 1 = 2), ‖∑ G ∈ gs, ap.Λc I (fun l => if σ l = 0 then
        π (D.core l G (I) (ZU l G)) + π (D.side l G I (Zout l G) (ZU l G)) +
          π (D.err l G I (ZU l G)) else π (D.side l G I (Zout l G) (ZU l G)))‖ ≤ T := by
    intro σ hσ
    obtain ⟨a, b, c, d, hab, hac, had, hbc, hbd, hcd, hc0, hd0, ha1, hb1, hau⟩ :=
      two_two_tuple σ (Finset.mem_filter.mp hσ).2 u
    refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun G hG => ?_)
    have hT : ap.Λc I (fun l => if σ l = 0 then
        π (D.core l G (I) (ZU l G)) + π (D.side l G I (Zout l G) (ZU l G)) +
          π (D.err l G I (ZU l G)) else π (D.side l G I (Zout l G) (ZU l G))) =
        ap.Λc I (Function.update (Function.update
          (fun l => D.side l G I (Zout l G) (ZU l G)) c (Zout c G)) d (Zout d G)) := by
      rw [ap.Λc_phys I (Function.update (Function.update
          (fun l => D.side l G I (Zout l G) (ZU l G)) c (Zout c G)) d (Zout d G))]
      congr 1
      funext l
      have hl := fin4_last a b c d l hab hac had hbc hbd hcd
      by_cases hlc : l = c
      · subst hlc
        simp only [hc0, ite_true, Function.update_of_ne hcd, Function.update_self]
        rw [← map_add, ← map_add, D.core_add_side_add_err]
      by_cases hld : l = d
      · subst hld
        simp only [hd0, ite_true, Function.update_self]
        rw [← map_add, ← map_add, D.core_add_side_add_err]
      have hl0 : σ l ≠ 0 := by
        by_cases hla : l = a
        · rw [hla, ha1]; decide
        · rw [hl hla hlc hld, hb1]; decide
      simp only [hl0, ite_false, Function.update_of_ne hlc, Function.update_of_ne hld]
    rw [hT]
    refine (hB a b c d hab hac had hbc hbd hcd hau G hG).trans ?_
    calc Bnd a b c d G ≤ ∑ d' : Fin 4, Bnd a b c d' G :=
          Finset.single_le_sum (f := fun d' => Bnd a b c d' G) (fun _ _ => hB0 _ _ _ _ _)
            (Finset.mem_univ d)
      _ ≤ ∑ c' : Fin 4, ∑ d' : Fin 4, Bnd a b c' d' G :=
          Finset.single_le_sum (f := fun c' => ∑ d' : Fin 4, Bnd a b c' d' G)
            (fun _ _ => Finset.sum_nonneg fun _ _ => hB0 _ _ _ _ _) (Finset.mem_univ c)
      _ ≤ ∑ b' : Fin 4, ∑ c' : Fin 4, ∑ d' : Fin 4, Bnd a b' c' d' G :=
          Finset.single_le_sum (f := fun b' => ∑ c' : Fin 4, ∑ d' : Fin 4, Bnd a b' c' d' G)
            (fun _ _ => Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => hB0 _ _ _ _ _)
            (Finset.mem_univ b)
      _ ≤ _ := Finset.single_le_sum (f := fun a' => ∑ b' : Fin 4, ∑ c' : Fin 4, ∑ d' : Fin 4,
            Bnd a' b' c' d' G) (fun _ _ => Finset.sum_nonneg fun _ _ => Finset.sum_nonneg
              fun _ _ => Finset.sum_nonneg fun _ _ => hB0 _ _ _ _ _) (Finset.mem_univ a)
  calc _ ≤ ∑ σ ∈ Finset.univ.filter (fun σ : Fin 4 → Fin 3 => (∀ l, σ l ≠ 2) ∧
        patternCount σ 0 = 2 ∧ patternCount σ 1 = 2), T :=
        (norm_sum_le _ _).trans (Finset.sum_le_sum hσ)
    _ = 6 * T := by
        rw [Finset.sum_const, nsmul_eq_mul]
        congr 1

