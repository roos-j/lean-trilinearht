  set T : M × Ka × Kb → ℤ × ℤ → ℝ≥0∞ := fun n I =>
    ‖(dyadicGridLength A.G I.1 : ℂ) * ∑ p ∈ u n.1, ap.Λc I (Function.update (Function.update
      (Function.update (F n.1) a (X n (selA n.2.1 I) p)) b (W n (selB n.2.2 I))) c (Y n.1 p))‖ₑ
  have hre : ∀ (x : Fin 4 → ColumnL2 (Fin ap.Mc)) (v₁ v₂ v₃ : ColumnL2 (Fin ap.Mc)),
