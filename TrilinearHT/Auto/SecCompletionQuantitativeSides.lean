/-- Summing over the range `L` the terms with index below `n ≤ L`. -/
theorem sum_range_ite_lt {M : Type*} [AddCommMonoid M] {n L : ℕ} (hnL : n ≤ L) (f : ℕ → M) :
    ∑ i ∈ Finset.range L, (if i < n then f i else 0) = ∑ i ∈ Finset.range n, f i := by
  rw [← Finset.sum_filter]
  congr 1
  ext i
  simp only [Finset.mem_filter, Finset.mem_range]
  omega

