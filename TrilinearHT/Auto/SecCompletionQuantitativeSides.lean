/-- The restoration factor of the main term at a cell: the normalized restoration differences of
the two complements times the normalized sizes of the other ones. -/
noncomputable def rstF (I : ℤ × ℤ) (c d : Fin 4) (Yfc Yfd : ℝ → ℂ) : ℝ :=
  (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfc) -
        physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ /
      Real.sqrt (dyadicGridLength A.G I.1)) *
    (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfd))‖ /
      Real.sqrt (dyadicGridLength A.G I.1)) +
  (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ /
      Real.sqrt (dyadicGridLength A.G I.1)) *
    (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I Yfd) -
        physicalColumnInput (V := Fin ap.Mc) (ap.base I d))‖ /
      Real.sqrt (dyadicGridLength A.G I.1))

theorem rstF_nonneg (I : ℤ × ℤ) (c d : Fin 4) (Yfc Yfd : ℝ → ℂ) : 0 ≤ ap.rstF I c d Yfc Yfd := by
  unfold rstF; positivity

