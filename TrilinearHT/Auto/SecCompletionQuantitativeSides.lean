/-- Blueprint line 2393 (flags as strong factors): if the current complements are bounded by `C₀`
on the active cells, the flagged uses of one step and offset have length-weighted flag cost
`C₀⁴ |I|` at most `C₀² K` times the freeze differences at the cells of their blocks (the
propagation of a flag through its block costs at most `K`). -/
theorem flag_budget {C₀ : ℝ} (hC₀ : 0 < C₀) (hK1 : 1 ≤ T.D.S.K) (S : Finset (ℤ × ℤ))
    (G : A.Grp) (c d : Fin 4) (t t' : List ℕ) (j o : ℕ)
    (hcur : ∀ J ∈ A.cells, ∑ p ∈ ap.uo o, ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2)
        (dyadicGridCell_measurable A.G J.1 J.2) (T.Y c d G t t' j o J.1 p)‖ ^ 2 ≤
          C₀ ^ 2 * dyadicGridLength A.G J.1 ∧
      ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
        (T.F c d G t t' j J.1)‖ ^ 2 ≤ C₀ ^ 2 * dyadicGridLength A.G J.1)
    (Sc : Finset (ℤ × ℤ)) (hSc : ∀ I ∈ S, ∀ J ∈ A.cells,
      dyadicGridCell A.G I.1 I.2 ⊆ dyadicGridCell A.G J.1 J.2 → T.D.blockOf I.1 ≤ J.1 → J ∈ Sc) :
    ∑ I ∈ S, (if T.unfl C₀ I G c d t t' j o then 0 else C₀ ^ 4 * dyadicGridLength A.G I.1) ≤
      C₀ ^ 2 * T.D.S.K * ∑ J ∈ Sc, (∑ p ∈ ap.uo o,
        ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
          (T.Y c d G t t' j o J.1 p - T.Y c d G t t' j o (T.D.blockOf J.1) p)‖ ^ 2 +
        ‖columnL2Restriction (dyadicGridCell A.G J.1 J.2) (dyadicGridCell_measurable A.G J.1 J.2)
          (T.F c d G t t' j J.1 - T.F c d G t t' j (T.D.blockOf J.1))‖ ^ 2) := by
  set Dj : ℤ × ℤ → ℝ := fun J => ∑ p ∈ ap.uo o,
