/-! ### Binary position configurations of a varying side (blueprint lines 2400-2411) -/

section PositionConfigs

variable {E : Type*} [AddCommGroup E]

/-- The component of level `k ≤ N` at the position index `q` of a sequence on offsets: the base
value at level `N`, otherwise the jump over the aligned interval `[q 2^(k+1), q 2^(k+1) + 2^k]`. -/
def posVal (W : ℕ → E) (N : ℕ) (k : Fin (N + 1)) (q : ℕ) : E :=
  if (k : ℕ) = N then W 0 else W (q * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ)) - W (q * 2 ^ ((k : ℕ) + 1))

/-- The level `k` is active at the offset `n`: the base level, or the bit `k` of `n` is set. -/
def posAct (N : ℕ) (k : Fin (N + 1)) (n : ℕ) : Prop := (k : ℕ) = N ∨ n.testBit k = true

instance (N : ℕ) (k : Fin (N + 1)) (n : ℕ) : Decidable (posAct N k n) := by
  unfold posAct; infer_instance

theorem posComp_eq (W : ℕ → E) (n N : ℕ) (k : Fin (N + 1)) :
    posComp W 0 n N k = if posAct N k n then posVal W N k (n / 2 ^ ((k : ℕ) + 1)) else 0 := by
  unfold posComp posAct posVal posInt bitPrefix
  by_cases hk : (k : ℕ) = N
  · simp [hk]
  · by_cases hb : n.testBit k = true
    · simp [hk, hb]
    · simp [hk, hb]

/-- Blueprint lines 2400-2402: a sequence at an offset `n < 2^N` is the sum of the components of
its active levels at their position indices. -/
theorem pos_rep (W : ℕ → E) {n N : ℕ} (hn : n < 2 ^ N) :
    W n = ∑ k ∈ Finset.univ.filter (fun k : Fin (N + 1) => posAct N k n),
      posVal W N k (n / 2 ^ ((k : ℕ) + 1)) := by
  have h := sum_posComp W 0 n N hn
  rw [zero_add] at h
  rw [← h, Finset.sum_filter]
  exact Finset.sum_congr rfl fun k _ => posComp_eq W n N k

/-- The right end of the position of an active level below the base lies at or before the
offset. -/
theorem posEnd_le {n N : ℕ} {k : Fin (N + 1)} (hk : (k : ℕ) ≠ N) (ha : posAct N k n) :
    n / 2 ^ ((k : ℕ) + 1) * 2 ^ ((k : ℕ) + 1) + 2 ^ (k : ℕ) ≤ n := by
  have hb : n.testBit k = true := ha.resolve_left hk
  have h := bitPrefix_succ n k
  simp only [hb, ite_true] at h
  have h0 : bitPrefix n k ≤ n := Nat.div_mul_le_self n _
  unfold bitPrefix at h h0
  omega

end PositionConfigs

/-- The union of the cells selecting an index lies in the union of their ancestors at any depth
at most theirs. -/
theorem selUnion_sub_anc (G : RealDyadicGrid) {ι : Type*} [DecidableEq ι] (U : Finset (ℤ × ℤ))
    (sel : ℤ × ℤ → ι) (d : ι → ℤ) (hd : ∀ I ∈ U, d (sel I) ≤ I.1) (q : ι) :
    selUnion G U sel q ⊆ ⋃ J ∈ (U.filter (fun I => sel I = q)).image (fun I => ancAt G I (d q)),
      dyadicGridCell G J.1 J.2 := by
  intro y hy
  simp only [selUnion, Set.mem_iUnion] at hy
  obtain ⟨I, hI, hq, hyI⟩ := hy
  subst hq
  exact Set.mem_biUnion (Finset.mem_image_of_mem _ (Finset.mem_filter.mpr ⟨hI, rfl⟩))
    (subset_ancAt G I (hd I hI) hyI)

/-! ### Global pads of the transfer steps (blueprint lines 2386-2391, 2412-2420) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The inherited catalog mask of rank `r` and cell masks `M` on the complete catalog tree. -/
noncomputable def gMask (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (r : ℕ) (M : ℤ × ℤ → A.Vtx → Prop)
    (hM : ∀ c ∈ A.cells, ∀ d ∈ A.cells, dyadicGridCell A.G c.1 c.2 ⊆ dyadicGridCell A.G d.1 d.2 →
      ∀ x, M d x → M c x) : InheritedColumnMask (ap.cumBase catl hR hb).D :=
  (catDepthFamily (G := A.G) (S := A.cells) (Nd := A.treeDepth) (Mc := ap.Mc) hR catl
    (births_tree hb) r M hM).A

/-- On an active cell the global pad of `gMask` intertwines with the restriction to the cell as
the catalog projection of the cell. -/
theorem gMask_restrict (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (r : ℕ) (M : ℤ × ℤ → A.Vtx → Prop)
    (hM : ∀ c ∈ A.cells, ∀ d ∈ A.cells, dyadicGridCell A.G c.1 c.2 ⊆ dyadicGridCell A.G d.1 d.2 →
      ∀ x, M d x → M c x) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)).comp
      (((ap.cumBase catl hR hb).withMask (ap.gMask catl hR hb r M hM)).proj I.1) =
      (catProj A.G ap.Mc catl I r (M I)).comp (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)) := by
  have h := catDepthFamily_restrict (G := A.G) (S := A.cells) (Nd := A.treeDepth) (Mc := ap.Mc)
    hR catl (births_tree hb) r M hM hI (A.cells_mem_tree hI)
  rw [(catProj_restrict A.G ap.Mc catl I r (M I)).1]
  exact h

/-- The cell masks of a transfer step: the ball masks of the group at level `j` (`none`) or the
cumulative masks of the layer `m` (`some m`), at the pad index `p`. -/
def stepMask (G : A.Grp) (j : ℕ) : Option ℕ → ℕ → ℤ × ℤ → A.Vtx → Prop
  | none, p => fun c => ap.bmask c G j p
  | some m, p => fun c => ap.cmask c m p

theorem stepMask_mono (G : A.Grp) (j : ℕ) (e : Option ℕ) (p : ℕ) :
    ∀ c ∈ A.cells, ∀ d ∈ A.cells, dyadicGridCell A.G c.1 c.2 ⊆ dyadicGridCell A.G d.1 d.2 →
      ∀ x, ap.stepMask G j e p d x → ap.stepMask G j e p c x := by
  intro c hc d hd hcd x hx
  cases e with
  | none => exact ap.bmask_mono hc hd hcd G j p x hx
  | some m => exact ap.cmask_mono hc hd hcd m p x hx

/-- The cell-independent descriptors of the positive filters of slot `l` of the leaf `s` along the
positive chain `t`: the ball filter, then the cumulative layers, each with its rank. -/
def slotDesc (s : ℕ) (l : Fin 4) (t : List ℕ) : List (ℕ × Option ℕ) :=
  (ap.leafR s l, none) :: t.map fun m => (ap.Lc - m + 1, some m)

/-- The slot filters of a cell are the descriptors with their cell masks. -/
theorem slotFilt_eq (s : ℕ) (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t : List ℕ) :
    ap.slotFilt s l G I t = (ap.slotDesc s l t).map fun e =>
      (e.1, fun p : Fin ap.P => ap.stepMask G (ap.leafJ s l) e.2 p I) := by
  unfold slotFilt slotDesc
  simp only [List.map_cons, List.map_map]
  rfl

end AttemptParams

end ActiveSetup

section RankMergeMap

variable {α β : Type*}

/-- Mapping both lists by key-preserving maps commutes with the rank merge. -/
theorem rankMerge_map (key : α → ℕ) (key' : β → ℕ) (f g : α → β) (hf : ∀ x, key' (f x) = key x)
    (hg : ∀ x, key' (g x) = key x) :
    ∀ xs ys : List α, rankMerge key' (xs.map f) (ys.map g) =
      (rankMerge key xs ys).map fun e => (e.1, if e.1 then f e.2 else g e.2)
  | [], ys => by simp [rankMerge, List.map_map, Function.comp_def]
  | x :: xs, [] => by simp [rankMerge, List.map_map, Function.comp_def]
  | x :: xs, y :: ys => by
    simp only [List.map_cons]
    rw [rankMerge, rankMerge, hf, hg]
    split_ifs
    · rw [List.map_cons, ← List.map_cons, rankMerge_map key key' f g hf hg xs (y :: ys)]
      simp
    · rw [List.map_cons, ← List.map_cons, rankMerge_map key key' f g hf hg (x :: xs) ys]
      simp
termination_by xs ys => xs.length + ys.length

end RankMergeMap

/-! ### Intertwining transfer steps with a restriction (blueprint line 2386) -/

section StepIntertwine

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- Two raw transfer steps (slot flag, helper pads, complement pads) are intertwined by `r` when
their flags agree and `r` intertwines all their pads. -/
def StepRel {P : ℕ} (r : E →L[ℂ] E) (sg sl : Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E)) :
    Prop :=
  sg.1 = sl.1 ∧ (∀ p, r.comp (sg.2.1 p) = (sl.2.1 p).comp r) ∧
    ∀ p, r.comp (sg.2.2 p) = (sl.2.2 p).comp r

/-- The pad step of a raw step. -/
noncomputable def padStep {P : ℕ} (st : Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E)) :
    TransferStep E :=
  (st.1, padFam st.2.1, padFam st.2.2)

theorem padFam_intertwine {P : ℕ} (r : E →L[ℂ] E) (Qg Ql : Fin P → E →L[ℂ] E)
    (h : ∀ p, r.comp (Qg p) = (Ql p).comp r) (n : ℕ) (y : E) :
    r (padFam Qg n y) = padFam Ql n (r y) := by
  unfold padFam
  split_ifs with h0 h1
  · simp
  · exact DFunLike.congr_fun (h _) y
  · rfl

theorem filterAvg_intertwine {P : ℕ} (r : E →L[ℂ] E) (Qg Ql : Fin P → E →L[ℂ] E)
    (h : ∀ p, r.comp (Qg p) = (Ql p).comp r) (y : E) :
    r (filterAvg P (padFam Qg) y) = filterAvg P (padFam Ql) (r y) := by
  rw [filterAvg_padFam, filterAvg_padFam]
  exact DFunLike.congr_fun (opAvg_intertwine Qg Ql r h) y

/-- The complement values of intertwined step lists are intertwined. -/
theorem chainVal_intertwine {P : ℕ} (r : E →L[ℂ] E) (v : Bool) :
    ∀ (gs ls : List (Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E))),
      List.Forall₂ (StepRel r) gs ls → ∀ y : E,
      r (chainVal P v (gs.map padStep) y) = chainVal P v (ls.map padStep) (r y)
  | [], [], _, y => rfl
  | sg :: gs, sl :: ls, List.Forall₂.cons hs hrest, y => by
    obtain ⟨h1, -, h3⟩ := hs
    simp only [List.map_cons, chainVal, padStep]
    rw [h1]
    split_ifs
    · rw [filterAvg_intertwine r _ _ h3, chainVal_intertwine r v gs ls hrest y]
    · exact chainVal_intertwine r v gs ls hrest y

/-- The helper prefix of a step list: the helper averages applied in step order. -/
noncomputable def helpPre (P : ℕ) : List (TransferStep E) → E → E
  | [], x => x
  | st :: rest, x => helpPre P rest (filterAvg P st.2.1 x)

theorem helpPre_intertwine {P : ℕ} (r : E →L[ℂ] E) :
    ∀ (gs ls : List (Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E))),
      List.Forall₂ (StepRel r) gs ls → ∀ x : E,
      r (helpPre P (gs.map padStep) x) = helpPre P (ls.map padStep) (r x)
  | [], [], _, x => rfl
  | sg :: gs, sl :: ls, List.Forall₂.cons hs hrest, x => by
    obtain ⟨-, h2, -⟩ := hs
    simp only [List.map_cons, helpPre, padStep]
    rw [helpPre_intertwine r gs ls hrest, filterAvg_intertwine r _ _ h2]

end StepIntertwine

/-! ### The band defects as a sum over the steps (blueprint lines 2252-2258) -/

section DefectSteps

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- The selected band defect of one step `st`, with the later steps `rest` and the helper input
`xa` of the step. -/
noncomputable def defTerm (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel]
    (st : TransferStep E) (rest : List (TransferStep E)) (xa : E) : ℂ :=
  ∑ p ∈ Finset.range (P + 1), ∑ q ∈ (Finset.range (P + 1)).filter (sel p),
    (((p : ℂ) - q) / P) * Λ (Function.update (Function.update (Function.update
      (Function.update x c (chainVal P true rest yc)) d (chainVal P false rest yd)) a
        (st.2.1 (p + 1) xa - st.2.1 p xa)) (if st.1 then c else d)
          (st.2.2 (q + 1) (chainVal P st.1 rest (if st.1 then yc else yd)) -
            st.2.2 q (chainVal P st.1 rest (if st.1 then yc else yd))))

/-- The selected band defects are the sum over the steps of their defects at the helper prefix
of the earlier steps. -/
theorem chainDefectSel_eq_sum (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) (P : ℕ)
    (a c d : Fin 4) (x : Fin 4 → E) (yc yd : E) (sel : ℕ → ℕ → Prop) [DecidableRel sel] :
    ∀ (steps : List (TransferStep E)) (xa : E),
      chainDefectSel Λ P a c d x yc yd sel steps xa =
        ∑ j : Fin steps.length, defTerm Λ P a c d x yc yd sel steps[j] (steps.drop (j + 1))
          (helpPre P (steps.take j) xa)
  | [], xa => by simp [chainDefectSel]
  | st :: rest, xa => by
    rw [chainDefectSel, chainDefectSel_eq_sum Λ P a c d x yc yd sel rest (filterAvg P st.2.1 xa)]
    have e : ∀ f : Fin (st :: rest).length → ℂ, ∑ j, f j = f ⟨0, by simp⟩ +
        ∑ j : Fin rest.length, f ⟨j + 1, by simp⟩ := fun f =>
      Fin.sum_univ_succ (n := rest.length) f
    rw [e]
    simp only [zero_add, List.take_zero, helpPre, List.drop_succ_cons, List.take_succ_cons]
    rfl

end DefectSteps

/-! ### Global transfer steps of a pair of positive chains (blueprint lines 2386-2391) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The merged cell-independent descriptors of the filters of a pair of positive chains. -/
def mergeDesc (s : ℕ) (c d : Fin 4) (t t' : List ℕ) : List (Bool × ℕ × Option ℕ) :=
  rankMerge Prod.fst (ap.slotDesc s c t) (ap.slotDesc s d t')

/-- The raw transfer step of a descriptor at a cell. -/
noncomputable def cellStep (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (e : Bool × ℕ × Option ℕ) :
    Bool × (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) ×
      (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) :=
  ap.toStep (cat c) (cat d) hcat rH I
    (e.1, e.2.1, fun p : Fin ap.P => ap.stepMask G (ap.leafJ s (if e.1 then c else d)) e.2.2 p I)

/-- The transfer steps of a pair of positive chains at a cell are the pad steps of the cell steps
of the merged descriptors. -/
theorem chainSteps_eq_desc (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) :
    ap.chainSteps cat hcat rH s c d G I t t' =
      (ap.mergeDesc s c d t t').map fun e => padStep (ap.cellStep cat hcat rH s c d G I e) := by
  unfold chainSteps mergeDesc
  rw [ap.slotFilt_eq, ap.slotFilt_eq, rankMerge_map Prod.fst Prod.fst
    (fun e => (e.1, fun p : Fin ap.P => ap.stepMask G (ap.leafJ s c) e.2 p I))
    (fun e => (e.1, fun p : Fin ap.P => ap.stepMask G (ap.leafJ s d) e.2 p I))
    (fun _ => rfl) (fun _ => rfl), List.map_map, List.map_map]
  refine List.map_congr_left fun e _ => ?_
  simp only [Function.comp_apply, cellStep, padStep]
  cases e.1 <;> rfl

/-- The global raw transfer step of a descriptor at the depth `h`: helper pads on the helper
catalog of rank `r_H` and complement pads on the catalog of its slot, all with the inherited
masks of the step. -/
noncomputable def gStep (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (e : Bool × ℕ × Option ℕ) (h : ℤ) :
    Bool × (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) ×
      (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) :=
  (e.1, fun p => ((ap.cumBase hcat hR hbh).withMask (ap.gMask hcat hR hbh rH
      (ap.stepMask G (ap.leafJ s (if e.1 then c else d)) e.2.2 p)
      (ap.stepMask_mono G _ e.2.2 p))).proj h,
    fun p => ((ap.cumBase (cat (if e.1 then c else d)) hR (hbc _)).withMask
      (ap.gMask (cat (if e.1 then c else d)) hR (hbc _) e.2.1
        (ap.stepMask G (ap.leafJ s (if e.1 then c else d)) e.2.2 p)
        (ap.stepMask_mono G _ e.2.2 p))).proj h)

/-- On an active cell the global step at its depth is intertwined with the cell step by the
restriction to the cell. -/
theorem gStep_rel (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (e : Bool × ℕ × Option ℕ) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    StepRel (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2))
      (ap.gStep cat hcat hR hbc hbh rH s c d G e I.1) (ap.cellStep cat hcat rH s c d G I e) := by
  refine ⟨rfl, fun p => ?_, fun p => ?_⟩
  · exact ap.gMask_restrict hcat hR hbh rH _ _ hI
  · have h := ap.gMask_restrict (cat (if e.1 then c else d)) hR (hbc _) e.2.1
      (ap.stepMask G (ap.leafJ s (if e.1 then c else d)) e.2.2 p)
      (ap.stepMask_mono G _ e.2.2 p) hI
    refine h.trans ?_
    unfold cellStep toStep
    cases e.1 <;> rfl

theorem gSteps_rel (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (hR : A.R ∈ A.cells) (hbc : ∀ l, ∀ x ∈ cat l, x.birth ∈ A.cells)
    (hbh : ∀ x ∈ hcat, x.birth ∈ A.cells) (rH s : ℕ) (c d : Fin 4) (G : A.Grp)
    (D : List (Bool × ℕ × Option ℕ)) {I : ℤ × ℤ} (hI : I ∈ A.cells) :
    List.Forall₂ (StepRel (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2)))
      (D.map fun e => ap.gStep cat hcat hR hbc hbh rH s c d G e I.1)
      (D.map fun e => ap.cellStep cat hcat rH s c d G I e) := by
  induction D with
  | nil => exact List.Forall₂.nil
  | cons e D ih =>
    exact List.Forall₂.cons (ap.gStep_rel cat hcat hR hbc hbh rH s c d G e hI) ih

end AttemptParams

end ActiveSetup

section DefectIntertwine

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

/-- A selected band defect of cell steps on restricted global inputs is the defect of the global
steps, for a form that sees only the restrictions. -/
theorem defTerm_intertwine (Λ : MultilinearMap ℂ (fun _ : Fin 4 => E) ℂ) {P : ℕ}
    (r : E →L[ℂ] E) (hr2 : ∀ y, r (r y) = r y)
    (hloc : ∀ x y : Fin 4 → E, (∀ l, r (x l) = r (y l)) → Λ x = Λ y)
    {a c d : Fin 4} (sel : ℕ → ℕ → Prop)
    [DecidableRel sel] (sg sl : Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E))
    (hs : StepRel r sg sl) (gr lr gp lp : List (Bool × (Fin P → E →L[ℂ] E) × (Fin P → E →L[ℂ] E)))
    (hrr : List.Forall₂ (StepRel r) gr lr) (hpp : List.Forall₂ (StepRel r) gp lp)
    (xg xl : Fin 4 → E) (hx : ∀ l, l ≠ a → l ≠ c → l ≠ d → r (xg l) = r (xl l))
    (yc yd xa : E) :
    defTerm Λ P a c d xl (r yc) (r yd) sel (padStep sl) (lr.map padStep)
        (helpPre P (lp.map padStep) (r xa)) =
      defTerm Λ P a c d xg yc yd sel (padStep sg) (gr.map padStep)
        (helpPre P (gp.map padStep) xa) := by
  obtain ⟨vg, Ag, Bg⟩ := sg
  obtain ⟨vl, Al, Bl⟩ := sl
  obtain ⟨hs1, hs2, hs3⟩ := hs
  simp only at hs1 hs2 hs3
  subst hs1
  have hc : ∀ v (y : E), r (chainVal P v (gr.map padStep) y) =
      chainVal P v (lr.map padStep) (r y) := fun v y => chainVal_intertwine r v gr lr hrr y
  have hA : ∀ n, r (padFam Ag n (helpPre P (gp.map padStep) xa)) =
      padFam Al n (r (helpPre P (gp.map padStep) xa)) := fun n =>
    padFam_intertwine r _ _ hs2 n _
  have hB : ∀ n y, r (padFam Bg n y) = padFam Bl n (r y) := fun n y =>
    padFam_intertwine r _ _ hs3 n y
  unfold defTerm
  rw [← helpPre_intertwine r gp lp hpp xa]
  refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
  congr 1
  refine hloc _ _ fun l => ?_
  simp only [padStep]
  cases vg <;>
  · simp only [Bool.false_eq_true, ite_true, ite_false, Function.update_apply]
    split_ifs <;> (try simp only [map_sub, ← hc, ← hB, ← hA, hr2])
    exact (hx l (by assumption) (by assumption) (by assumption)).symm

end DefectIntertwine

/-! ### Single pads after global histories on any catalog (blueprint lines 2390-2391, 2414-2420) -/

namespace ActiveSetup

namespace AttemptParams

variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- A single pad projection composed with a global averaged history on a catalog family. -/
noncomputable def padHistL (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (ls : List (ℕ × Bool))
    (h : ℤ) :
    ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc) :=
  (((ap.cumBase catl hR hb).withMask M).proj h).comp
    (globHist (ap.cumBase catl hR hb) Am ls h)

/-- The rows of a single pad jump split over the partition of its left depth. -/
theorem padHist_blk (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    {hr ht : ℤ}
    (hrt : hr ≤ ht) (Ec : Finset (ℤ × ℤ)) (hEc : ∀ I ∈ Ec, I ∈ A.cells)
    (x : ColumnL2 (Fin ap.Mc)) :
    ‖((columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        (((ap.cumBase catl hR hb).withMask M).proj ht -
          ((ap.cumBase catl hR hb).withMask M).proj hr)) x‖ ^ 2
      = ∑ Q : {Q // Q ∈ ((ap.cumBase catl hR hb).partition hr).cells},
        ‖((columnL2Restriction (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
          (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
          (((ap.cumBase catl hR hb).withMask M).proj ht -
            ((ap.cumBase catl hR hb).withMask M).proj hr))
          (columnL2Restriction (dyadicGridCell A.G Q.1.1 Q.1.2)
            (dyadicGridCell_measurable A.G Q.1.1 Q.1.2) x)‖ ^ 2 := by
  set Ψ := (ap.cumBase catl hR hb).withMask M
  set Ψ0 := ap.cumBase catl hR hb
  set E := columnL2Restriction (V := Fin ap.Mc) (⋃ I ∈ Ec, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hv := ap.restrict_union_vanish Ec hEc ((Ψ.proj ht - Ψ.proj hr) x)
  rw [ContinuousLinearMap.comp_apply, Ψ0.norm_sq_partition hr _ hv]
  refine Finset.sum_congr rfl fun Q _ => ?_
  have h1 := Ψ.proj_comm_restrict (h' := hr) (h := ht) hrt (Q := Q.1) Q.2
  have h2 := Ψ.proj_comm_restrict (h' := hr) (h := hr) le_rfl (Q := Q.1) Q.2
  have h3 := columnL2Restriction_comm (V := Fin ap.Mc)
    (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)
    (Finset.measurableSet_biUnion Ec fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  congr 2
  rw [ContinuousLinearMap.comp_apply, sub_apply, sub_apply, map_sub, map_sub]
  change (columnL2Restriction _ (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)).comp E
      (Ψ.proj ht x) - (columnL2Restriction _ (dyadicGridCell_measurable A.G Q.1.1 Q.1.2)).comp E
      (Ψ.proj hr x) = _
  rw [h3, ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
    ← ContinuousLinearMap.comp_apply _ (Ψ.proj ht), ← ContinuousLinearMap.comp_apply _ (Ψ.proj hr)]
  change E (((columnL2Restriction _ (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2)).comp
    (Ψ.proj ht)) x) - E (((columnL2Restriction _
      (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2)).comp (Ψ.proj hr)) x) = _
  rw [← h1, ← h2, ← map_sub]
  rfl

/-- Blueprint lem:variation for one single pad (shared by the groups): the single-pad outputs,
restricted at the right endpoints to unions of active cells, have square-summable variation over
disjoint depth intervals. -/
theorem padHist_jump (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D)
    {ι' : Type*} [Fintype ι']
    (ls : List (ℕ × Bool)) (r t : ι' → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (Ec : ι' → Finset (ℤ × ℤ)) (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells)
    (z : ColumnL2 (Fin ap.Mc)) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.padHistL catl hR hb M Am ls (A.R.1 + t i) z -
          ap.padHistL catl hR hb M Am ls (A.R.1 + r i) z)‖ ^ 2 ≤
      2 * 1 * (compressionC (ap.cumBase catl hR hb).D ls.length ^ 2 * ‖z‖ ^ 2 +
          ls.length * (∑ m ∈ Finset.range ls.length,
            compressionC (ap.cumBase catl hR hb).D m ^ 2) * ‖z‖ ^ 2) := by
  classical
  set T := Finset.univ.sup t
  have ht : ∀ i, t i ≤ T := fun i => Finset.le_sup (f := t) (Finset.mem_univ i)
  have hone : ∀ (f : Unit × ι' → ColumnL2 (Fin ap.Mc)),
      ‖∑ k, f k‖ ^ 2 ≤ 1 * ∑ G : Unit, ‖∑ k ∈ (Finset.univ : Finset (Unit × ι')).filter
        (fun k => k.1 = G), f k‖ ^ 2 := fun f => by
    simp
  have hone' : ∀ (f : Unit → ColumnL2 (Fin ap.Mc)),
      ‖∑ G, f G‖ ^ 2 ≤ 1 * ∑ G : Unit, ‖∑ G' ∈ (Finset.univ : Finset Unit).filter
        (fun G' => G' = G), f G'‖ ^ 2 := fun f => by
    simp
  have key := certifiedVariation_gen (γ := Unit) T
    (fun _ n => ((ap.cumBase catl hR hb).withMask M).proj (A.R.1 + n))
    (fun _ n _ => ColumnDepthFamily.isStarProjection_proj _ _)
    (fun _ a _ b _ hab => ColumnDepthFamily.proj_nested _ (by omega))
    (fun _ i => columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
      (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2))
    (fun _ i y => columnL2Indicator_norm_le _ (Finset.measurableSet_biUnion _ fun I _ =>
      dyadicGridCell_measurable A.G I.1 I.2) y) r t hrt ht hdis
    (fun i => globHist (ap.cumBase catl hR hb) Am ls (A.R.1 + t i) z)
    (fun i => globHist (ap.cumBase catl hR hb) Am ls (A.R.1 + r i) z) z
    (G₀ := compressionC (ap.cumBase catl hR hb).D ls.length ^ 2)
    (J := ls.length * (∑ m ∈ Finset.range ls.length,
      compressionC (ap.cumBase catl hR hb).D m ^ 2) * ‖z‖ ^ 2)
    zero_le_one (fun x => hone _) ?_ (fun i x => hone' _)
    (globHist_jump (ap.cumBase catl hR hb) ap.hP Am ls r t hrt hdis z)
  · refine le_trans (le_of_eq ?_) (key.trans (le_of_eq (by ring)))
    rw [Fintype.sum_prod_type, show (Finset.univ : Finset Unit) = {()} from rfl,
      Finset.sum_singleton]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp only [padHistL, ContinuousLinearMap.comp_apply, map_sub]
  · intro c hc hB
    have h := globHist_compression (ap.cumBase catl hR hb) ap.hP Am ls
      (fun q : Unit × ι' => A.R.1 + r q.2)
      (fun q => (columnL2Restriction (⋃ I ∈ Ec q.2, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)).comp
        (((ap.cumBase catl hR hb).withMask M).proj (A.R.1 + t q.2) -
          ((ap.cumBase catl hR hb).withMask M).proj (A.R.1 + r q.2))) hc hB
      (fun q x => ap.padHist_blk catl hR hb M (by have := hrt q.2; omega) (Ec q.2) (hEc q.2) x) z
    refine h.trans (le_of_eq ?_)
    ring


/-- The cumulative single-pad output commutes with the restrictions to cells at most as deep as
its depth. -/
theorem padHistL_commute (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (ls : List (ℕ × Bool))
    (h : ℤ)
    {Q : ℤ × ℤ} (hQ : Q.1 ≤ (ap.cumBase catl hR hb).depth h) :
    (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)).comp (ap.padHistL catl hR hb M Am ls h) =
    (ap.padHistL catl hR hb M Am ls h).comp (columnL2Restriction (dyadicGridCell A.G Q.1 Q.2)
      (dyadicGridCell_measurable A.G Q.1 Q.2)) := by
  set rQ := columnL2Restriction (V := Fin ap.Mc) (dyadicGridCell A.G Q.1 Q.2)
    (dyadicGridCell_measurable A.G Q.1 Q.2)
  have hpad : (((ap.cumBase catl hR hb).withMask M).proj h).comp rQ =
      rQ.comp (((ap.cumBase catl hR hb).withMask M).proj h) :=
    (((ap.cumBase catl hR hb).withMask M).proj_commute_restrict h
      hQ).symm
  have hcum : ∀ m, (opAvg fun p : Fin ap.P =>
      ((ap.cumBase catl hR hb).withMask (Am m p)).proj h).comp rQ =
      rQ.comp (opAvg fun p : Fin ap.P =>
        ((ap.cumBase catl hR hb).withMask (Am m p)).proj h) := fun m =>
    opAvg_commute _ _ fun p =>
      (((ap.cumBase catl hR hb).withMask (Am m p)).proj_commute_restrict h hQ).symm
  have hhist := layerOp_commute _ rQ hcum ls
  unfold padHistL globHist
  rw [← ContinuousLinearMap.comp_assoc, ← hpad, ContinuousLinearMap.comp_assoc,
    ContinuousLinearMap.comp_assoc, hhist]

/-- Blueprint lem:variation for one single pad acting on a basic projection (shared by the
groups). -/
theorem padHist_variation_basic (catl : List (CatCol A.Vtx)) (hR : A.R ∈ A.cells)
    (hb : ∀ d ∈ catl, d.birth ∈ A.cells) (M : InheritedColumnMask (ap.cumBase catl hR hb).D)
    (Am : ℕ → Fin ap.P → InheritedColumnMask (ap.cumBase catl hR hb).D) (ls : List (ℕ × Bool))
    {ι : Type*} [Fintype ι] (r t : ι → ℕ) (hrt : ∀ i, r i ≤ t i)
    (hdis : ∀ i i', i ≠ i' → Disjoint (Finset.Ioc (r i) (t i)) (Finset.Ioc (r i') (t i')))
    (htd : ∀ i, t i ≤ A.treeDepth) (Ec : ι → Finset (ℤ × ℤ))
    (hEc : ∀ i, ∀ I ∈ Ec i, I ∈ A.cells) {V : Type*} [Fintype V] (Ψ : ColumnDepthFamily V)
    (hΨG : Ψ.D.grid = A.G)
    (hΨR : dyadicGridCell A.G A.R.1 A.R.2 ⊆ dyadicGridCell A.G Ψ.D.root.1 Ψ.D.root.2)
    (hΨr : Ψ.D.root.1 ≤ A.R.1) (Z : ColumnL2 V) :
    ∑ i, ‖columnL2Restriction (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
        (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
        (ap.padHistL catl hR hb M Am ls (A.R.1 + t i)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + t i) Z)) -
          ap.padHistL catl hR hb M Am ls (A.R.1 + r i)
            (physEmbed V (Fin ap.Mc) (Ψ.proj (A.R.1 + r i) Z)))‖ ^ 2 ≤
      2 * (2 * 1 * (compressionC (ap.cumBase catl hR hb).D ls.length ^ 2 +
            ls.length * (∑ m ∈ Finset.range ls.length,
              compressionC (ap.cumBase catl hR hb).D m ^ 2)) *
          compressionC Ψ.D 1 ^ 2 * ‖Z‖ ^ 2) + 2 * ‖Z‖ ^ 2 := by
  set B := 2 * 1 * (compressionC (ap.cumBase catl hR hb).D ls.length ^ 2 +
    ls.length * (∑ m ∈ Finset.range ls.length, compressionC (ap.cumBase catl hR hb).D m ^ 2))
  have hB : 0 ≤ B := by
    have : 0 ≤ ∑ m ∈ Finset.range ls.length, compressionC (ap.cumBase catl hR hb).D m ^ 2 :=
      Finset.sum_nonneg fun _ _ => sq_nonneg _
    positivity
  set E := fun i => columnL2Restriction (V := Fin ap.Mc) (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2)
    (Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2)
  have hEm : ∀ i, MeasurableSet (⋃ I ∈ Ec i, dyadicGridCell A.G I.1 I.2) := fun i =>
    Finset.measurableSet_biUnion _ fun I _ => dyadicGridCell_measurable A.G I.1 I.2
  have hrows : ∀ x, ∑ i, ‖E i ((ap.padHistL catl hR hb M Am ls (A.R.1 + t i) -
      ap.padHistL catl hR hb M Am ls (A.R.1 + r i)) x)‖ ^ 2 ≤ B * ‖x‖ ^ 2 := by
    intro x
    have h := ap.padHist_jump catl hR hb M Am ls r t hrt hdis Ec hEc x
    refine le_trans (le_of_eq ?_) (h.trans (le_of_eq (by simp only [B]; ring)))
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [sub_apply]
  have hblk : ∀ i x, ‖E i ((ap.padHistL catl hR hb M Am ls (A.R.1 + t i) -
      ap.padHistL catl hR hb M Am ls (A.R.1 + r i)) x)‖ ^ 2 =
      ∑ Q : {Q // Q ∈ (Ψ.partition (A.R.1 + r i)).cells},
        ‖E i ((ap.padHistL catl hR hb M Am ls (A.R.1 + t i) -
          ap.padHistL catl hR hb M Am ls (A.R.1 + r i))
          (columnL2Restriction (dyadicGridCell Ψ.D.grid Q.1.1 Q.1.2)
            (dyadicGridCell_measurable Ψ.D.grid Q.1.1 Q.1.2) x))‖ ^ 2 := by
    intro i x
    have hdepth : ∀ Q ∈ (Ψ.partition (A.R.1 + r i)).cells, ∀ h : ℤ, A.R.1 + r i ≤ h →
        h ≤ A.R.1 + t i → Q.1 ≤ (ap.cumBase catl hR hb).depth h := by
      intro Q hQ h h1 h2
      have hQ1 := ((Ψ.mem_partition _ Q).mp hQ).1
      have hle : Ψ.depth (A.R.1 + r i) ≤ A.R.1 + r i := by
        unfold ColumnDepthFamily.depth
        exact max_le (by omega) (min_le_left _ _)
      change Q.1 ≤ max A.R.1 (min h (A.R.1 + A.treeDepth))
      rw [hQ1]
      have := htd i
      exact le_trans hle (le_trans (le_min h1 (by have := hrt i; omega)) (le_max_right _ _))
    have h := Ψ.blk_of_commute (A.R.1 + r i) ((E i).comp
      (ap.padHistL catl hR hb M Am ls (A.R.1 + t i) - ap.padHistL catl hR hb M Am ls (A.R.1 + r i)))
      (fun y => ?_) (fun Q hQ => ?_) x
    · exact h
    · filter_upwards [columnL2Restriction_vanish _ (hEm i)
        ((ap.padHistL catl hR hb M Am ls (A.R.1 + t i) -
          ap.padHistL catl hR hb M Am ls (A.R.1 + r i)) y)] with z hz hzR
      refine hz fun hzE => hzR ?_
      rw [Set.mem_iUnion₂] at hzE
      obtain ⟨I, hI, hzI⟩ := hzE
      rw [hΨG]
      exact hΨR (A.sub I (hEc i I hI) hzI)
    · have h1 := ap.padHistL_commute catl hR hb M Am ls (A.R.1 + t i) (Q := Q)
        (hdepth Q hQ _ (by have := hrt i; omega) le_rfl)
