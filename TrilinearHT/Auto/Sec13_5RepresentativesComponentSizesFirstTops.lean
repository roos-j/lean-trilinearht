namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0) (SP : SideParams)

/-- The predecessor of a node `(b, J)` with chosen mode `m`: its PRE component at `h - Δ`, as a set
of modes. -/
noncomputable def predOf (Δ h : ℕ)
    (mOf : ∀ c : ℤ × (ℤ × ℤ), Ms.alive (ancAt Gd c.2 (c.1 - 4 * S.K)))
    (c : ℤ × (ℤ × ℤ)) : Finset Ms.Md :=
  ((Ms.blockComps S hA c.1 c.2).E (h - Δ) (mOf c)).map ⟨Subtype.val, Subtype.val_injective⟩

/-- The comparability of nodes: a later block on a descendant pre-cell. -/
def nodeLt (Nd : Finset (ℤ × (ℤ × ℤ))) (c c' : ℤ × (ℤ × ℤ)) : Prop :=
  c ∈ Nd ∧ c' ∈ Nd ∧ dyadicGridCell Gd c'.2.1 c'.2.2 ⊆ dyadicGridCell Gd c.2.1 c.2.2 ∧ c.1 < c'.1

theorem ancAt_block_subset {b b' : ℤ} {J J' : ℤ × ℤ} (hJ : J.1 = b - 2 * S.K) (hbb : b ≤ b')
    (hsub : dyadicGridCell Gd J'.1 J'.2 ⊆ dyadicGridCell Gd J.1 J.2) :
    dyadicGridCell Gd (ancAt Gd J' (b' - 4 * S.K)).1 (ancAt Gd J' (b' - 4 * S.K)).2 ⊆
      dyadicGridCell Gd (ancAt Gd J (b - 4 * S.K)).1 (ancAt Gd J (b - 4 * S.K)).2 := by
  have hK : (0 : ℤ) ≤ S.K := Nat.cast_nonneg _
  have hJU : dyadicGridCell Gd J.1 J.2 ⊆
      dyadicGridCell Gd (ancAt Gd J (b - 4 * S.K)).1 (ancAt Gd J (b - 4 * S.K)).2 :=
    subset_ancAt Gd J (by rw [hJ]; omega)
  exact ancAt_subset (hsub.trans hJU) (by simp only [ancAt]; omega)

theorem blockComps_π (b : ℤ) (J : ℤ × ℤ) (x : Ms.alive (ancAt Gd J (b - 4 * S.K))) :
    (Ms.blockComps S hA b J).π x = Ms.keyOf x.1 := by
  unfold blockComps; split_ifs <;> rfl

open Classical in
/-- Blueprint lines 2172-2191 (`THT.Modes.hereditaryRepresentatives`) for one height, role, group
and type: for successful components on pre-cells `(b, J)` with good modes `m_c` at `h`, whose
predecessors `E_{h-Δ}` have equal type `(⌊log₂ |π(E)|⌋, ⌊log₂ |E|⌋)`, the chronological
representatives lie in their predecessors, are inherited under predecessor inclusion along
paths, and different representatives on comparable pre-cells have disjoint predecessors lying in
different later CURRENT components (no shared or adjacent cross modes, line 2183). -/
theorem attempt_representatives (Nd : Finset (ℤ × (ℤ × ℤ)))
    (hNd : ∀ c ∈ Nd, c.2.1 = c.1 - 2 * S.K) {Bmin : ℤ} (hBmin : ∀ c ∈ Nd, Bmin ≤ c.1)
    (Δ h : ℕ) (mOf : ∀ c : ℤ × (ℤ × ℤ), Ms.alive (ancAt Gd c.2 (c.1 - 4 * S.K)))
    (hgood : ∀ c ∈ Nd, (Ms.blockComps S hA c.1 c.2).Good Δ (Ms.goodP S SP c.1) h (mOf c))
    (hstab : ∀ c ∈ Nd, ∀ h' z z', Ms.goodP S SP c.1 h' ((Ms.blockComps S hA c.1 c.2).π z) →
      (Ms.blockComps S hA c.1 c.2).π z' = (Ms.blockComps S hA c.1 c.2).π z →
      z' ∈ (Ms.blockComps S hA c.1 c.2).F h' z → z' ∈ (Ms.blockComps S hA c.1 c.2).E (h' - Δ) z)
    {k1 k2 : ℕ}
    (htype1 : ∀ c ∈ Nd, Nat.log 2 ((Ms.blockComps S hA c.1 c.2).labels
      ((Ms.blockComps S hA c.1 c.2).E (h - Δ) (mOf c))).card = k1)
    (htype2 : ∀ c ∈ Nd, Nat.log 2 (Ms.predOf S hA Δ h mOf c).card = k2) (dflt : Ms.Md) :
    ∃ rep : ℤ × (ℤ × ℤ) → Ms.Md,
      (∀ c, rep c ∈ Ms.predOf S hA Δ h mOf c) ∧
      (∀ c c', nodeLt (Gd := Gd) Nd c c' →
        Ms.predOf S hA Δ h mOf c ⊆ Ms.predOf S hA Δ h mOf c' → rep c' = rep c) ∧
      (∀ c c', nodeLt (Gd := Gd) Nd c c' → rep c ≠ rep c' →
        Disjoint (Ms.predOf S hA Δ h mOf c) (Ms.predOf S hA Δ h mOf c')) ∧
      (∀ c c', nodeLt (Gd := Gd) Nd c c' → rep c ≠ rep c' →
        ∀ z z' : Ms.alive (ancAt Gd c'.2 (c'.1 - 4 * S.K)), z.1 ∈ Ms.predOf S hA Δ h mOf c →
          z'.1 ∈ Ms.predOf S hA Δ h mOf c' → z ∉ (Ms.blockComps S hA c'.1 c'.2).F h z') := by
  set lt := nodeLt (Gd := Gd) Nd
  set d : ℤ × (ℤ × ℤ) → ℕ := fun c => (c.1 - Bmin).toNat
  have hd : ∀ c c', lt c c' → d c < d c' := by
    intro c c' hcc'
    obtain ⟨hc, hc', -, hlt⟩ := hcc'
    have := hBmin c hc
    have := hBmin c' hc'
    simp only [d]
    omega
  have hK : (0 : ℤ) ≤ S.K := Nat.cast_nonneg _
  set E := Ms.predOf S hA Δ h mOf
  have hne : ∀ c, (E c).Nonempty := fun c =>
    ⟨(mOf c).1, Finset.mem_map.mpr ⟨mOf c, ModeComponents.E_self _ _ _, rfl⟩⟩
  -- ancestors of a node are comparable
  have hpath : ∀ a b c, lt a c → lt b c → a = b ∨ lt a b ∨ lt b a := by
    intro a b c hac hbc
    obtain ⟨ha, hc, hca, hlt⟩ := hac
    obtain ⟨hb, -, hcb, hlt'⟩ := hbc
    have hda := hNd a ha
    have hdb := hNd b hb
    rcases lt_trichotomy a.1 b.1 with h1 | h1 | h1
    · refine Or.inr (Or.inl ⟨ha, hb, ?_, h1⟩)
      exact dyadicGridCell_subset_of_common Gd hcb hca (by omega)
    · left
      have hJ : a.2 = b.2 := dyadicGridCell_eq_of_meet Gd (by omega)
        ⟨_, hca (dyadicGridCell_left_mem Gd c.2.1 c.2.2), hcb (dyadicGridCell_left_mem Gd _ _)⟩
      exact Prod.ext h1 hJ
    · refine Or.inr (Or.inr ⟨hb, ha, ?_, h1⟩)
      exact dyadicGridCell_subset_of_common Gd hca hcb (by omega)
  -- linked predecessors along a path are nested
  have hlinked : ∀ c c', lt c c' → ∀ z z' : Ms.alive (ancAt Gd c'.2 (c'.1 - 4 * S.K)),
      z.1 ∈ E c → z'.1 ∈ E c' → z ∈ (Ms.blockComps S hA c'.1 c'.2).F h z' → E c ⊆ E c' := by
    intro c c' hcc' z z' hz hz' hzF
    obtain ⟨hc, hc', hsub, hlt⟩ := hcc'
    have hUU := ancAt_block_subset S (hNd c hc) hlt.le hsub
    have hper := fun h' {x y : Ms.alive (ancAt Gd c.2 (c.1 - 4 * S.K))} =>
      Ms.blockComps_persist S hA (hNd c hc) (hNd c' hc') hlt.le hsub h' hUU (x := x) (y := y)
    set C := Ms.blockComps S hA c.1 c.2
    set C' := Ms.blockComps S hA c'.1 c'.2
    obtain ⟨y1, hy1E, hy1⟩ := Finset.mem_map.mp hz
    obtain ⟨y2, hy2E, hy2⟩ := Finset.mem_map.mp hz'
    have hfy : Ms.aliveMap hUU y1 = z := Subtype.ext hy1
    have hy2z : y2 = z' := Subtype.ext hy2
    subst hy2z
    -- the link: the earlier mode lies in the later CURRENT component
    have hlink : Ms.aliveMap hUU (mOf c) ∈ C'.F h (mOf c') := by
      have h1 : z ∈ C'.E (h - Δ) (Ms.aliveMap hUU (mOf c)) := by
        rw [← hfy]; exact (hper (h - Δ)).1 hy1E
      have h1' : Ms.aliveMap hUU (mOf c) ∈ C'.F h z := by
        have : Ms.aliveMap hUU (mOf c) ∈ C'.E (h - Δ) z := by
          rw [C'.E_comp _ _ z h1]; exact C'.E_self _ _
        exact C'.F_mono _ h _ (Nat.sub_le _ _) (C'.E_le_F _ _ this)
      have h2 : C'.F h z = C'.F h (mOf c') := by
        rw [C'.F_comp h y2 z hzF]
        exact C'.F_comp h (mOf c') y2
          (C'.F_mono _ h _ (Nat.sub_le _ _) (C'.E_le_F _ _ hy2E))
      rw [← h2]; exact h1'
    have htype : (C'.labels (C'.E (h - Δ) (mOf c'))).card <
        2 * (C.labels (C.E (h - Δ) (mOf c))).card := by
      refine ModeComponents.card_lt_two_mul_of_log2_eq ?_
        ((htype1 c hc).trans (htype1 c' hc').symm)
      exact Finset.card_pos.mpr ⟨_, Finset.mem_image_of_mem _ (C.E_self _ _)⟩
    have hnest' := ModeComponents.predecessor_nesting C C' (Ms.aliveMap hUU)
      (fun x => by simp only [C, C', blockComps_π]; rfl)
      (fun h' x y hy => (hper h').1 hy) (fun h' x y hy => (hper h').2 hy) Δ (Ms.goodP S SP c'.1)
      (hstab c' hc') (hgood c' hc') hlink htype
    intro y hy
    obtain ⟨y1, hy1, rfl⟩ := Finset.mem_map.mp hy
    exact Finset.mem_map.mpr ⟨Ms.aliveMap hUU y1,
      hnest' (Finset.mem_image_of_mem _ hy1), rfl⟩
  -- predecessors meeting along a path are nested
  have hnest : ∀ c c', lt c c' → (E c ∩ E c').Nonempty → E c ⊆ E c' := by
    intro c c' hcc' hmeet
    obtain ⟨y, hy⟩ := hmeet
    obtain ⟨hy1, hy2⟩ := Finset.mem_inter.mp hy
    obtain ⟨y2, hy2E, rfl⟩ := Finset.mem_map.mp hy2
    exact hlinked c c' hcc' y2 y2 hy1 (Finset.mem_map_of_mem _ hy2E)
      ((Ms.blockComps S hA c'.1 c'.2).E_le_F h y2 (ModeComponents.E_self _ h y2))
  have hmaj : ∀ c c', lt c c' → E c ⊆ E c' → (E c').card < 2 * (E c).card := by
    intro c c' hcc' _
    exact ModeComponents.card_lt_two_mul_of_log2_eq (Finset.card_pos.mpr (hne c))
      ((htype2 c hcc'.1).trans (htype2 c' hcc'.2.1).symm)
  refine ⟨hereditaryRep E lt d hd dflt, ?_⟩
  exact ⟨hereditaryRep_mem E lt d hd dflt hne,
    hereditaryRep_inherit E lt d hd dflt hpath hnest hmaj,
    fun c c' hcc' hrep => hereditaryRep_disjoint E lt d hd dflt hpath hnest hmaj hcc' hrep,
    fun c c' hcc' hrep z z' hz hz' hzF => hrep (hereditaryRep_inherit E lt d hd dflt hpath hnest
      hmaj c c' hcc' (hlinked c c' hcc' z z' hz hz' hzF)).symm⟩

end ModeSystem

namespace ModeComponents
variable {Mode P : Type*} [Fintype Mode] [DecidableEq Mode] [DecidableEq P]

/-! ### Separation of representative frequencies (`eq:representative-separation`, 2184-2192) -/

theorem ofEdges_F_of_cur (pre cur : ℕ → Mode → Mode → Prop) (π : Mode → P)
    (hle : ∀ h m m', pre h m m' → cur h m m')
    (hpre : ∀ h h' m m', h ≤ h' → pre h m m' → pre h' m m')
    (hcur : ∀ h h' m m', h ≤ h' → cur h m m' → cur h' m m') {h : ℕ} {m m' : Mode}
    (hmm' : cur h m m') : m' ∈ (ofEdges pre cur π hle hpre hcur).F h m := by
  classical
  by_cases he : m = m'
  · subst he
    exact (ofEdges pre cur π hle hpre hcur).E_le_F h m
      ((ofEdges pre cur π hle hpre hcur).E_self h m)
  · simp only [ofEdges, Finset.mem_filter, Finset.mem_univ, true_and]
    exact SimpleGraph.Adj.reachable (by simp [SimpleGraph.fromRel_adj, he, hmm'])

end ModeComponents

namespace ModeSchedule
variable (S : ModeSchedule)

/-- Blueprint line 2192: without a gap edge at height `h`, every allowed shift leaves the affine
frequency difference above `θ` at some point, hence above `θ/2` on the whole cell when its
variation over the cell is at most `θ/2` (`eq:slope-variation`). -/
theorem sep_of_not_gapEdge {Mode : Type*} {dz : ℕ} (ω : Mode → ℝ → ℝ) (ϑ : Fin dz → ℝ)
    (a r θr : ℝ) {h : ℕ} {m m' : Mode} (hne : ¬ S.gapEdge ω ϑ a r θr h m m') {lam γ : ℝ}
    (haff : ∀ x, ω m x - ω m' x = 2 * lam * x + γ) (hvar : 2 * |lam| * r ≤ θr / 2)
    (n : Fin dz → ℤ) (hn : ∀ i, |(n i : ℝ)| ≤ S.Eh h) :
    ∀ x ∈ Set.Icc a (a + r), θr / 2 < |ω m x - ω m' x + (∑ i, (n i : ℝ) * ϑ i) / Lh h| := by
  have hx0 : ∃ x₀ ∈ Set.Icc a (a + r),
      θr < |ω m x₀ - ω m' x₀ + (∑ i, (n i : ℝ) * ϑ i) / Lh h| := by
    by_contra hno
    push Not at hno
    exact hne ⟨n, hn, hno⟩
  obtain ⟨x₀, hx₀, hlarge⟩ := hx0
  set c := (∑ i, (n i : ℝ) * ϑ i) / Lh h
  have hsep := affine_separation_on_cell (lam := lam) (γ := γ + c) hx₀ (by
    rw [haff] at hlarge; rwa [add_assoc] at hlarge) hvar
  intro x hx
  have := hsep x hx
  rw [haff, add_assoc]
  exact this

end ModeSchedule

namespace ModeSystem
variable {Gd : RealDyadicGrid} {Mc : ℕ} (Ms : ModeSystem Gd Mc) (S : ModeSchedule)
  (hA : 6 ≤ S.A0)

/-- Blueprint `eq:representative-separation` (lines 2184-2192): two modes alive on the pre-cell
`J'` of block `b'` that lie in different CURRENT components at height `h` have, for every allowed
shift `n`, frequency difference above `Ξ / (2 r_{t_{b'}})` on the whole pre-cell, when the
curvature difference obeys `eq:slope-variation`; on actual cells `I, I'` of length at least
`r_{t_{b'}}` this is at least `(Ξ/2) max(|I|⁻¹, |I'|⁻¹)`. -/
theorem representative_separation {b' : ℤ} {J' : ℤ × ℤ} (hJ' : J'.1 = b' - 2 * S.K) {h : ℕ}
    {z z' : Ms.alive (ancAt Gd J' (b' - 4 * S.K))}
    (hzF : z ∉ (Ms.blockComps S hA b' J').F h z')
    (hvar : 2 * |Ms.lamOf z'.1 - Ms.lamOf z.1| * dyadicGridLength Gd J'.1 ≤
      S.Ξ / dyadicGridLength Gd (b' + S.K) / 2)
    (n : Fin Ms.zc.dim → ℤ) (hn : ∀ i, |(n i : ℝ)| ≤ S.Eh h) {rI rI' : ℝ}
    (hrI : dyadicGridLength Gd (b' + S.K) ≤ rI) (hrI' : dyadicGridLength Gd (b' + S.K) ≤ rI') :
    ∀ x ∈ Set.Icc (dyadicGridLeft Gd J'.1 J'.2) (dyadicGridLeft Gd J'.1 J'.2 +
        dyadicGridLength Gd J'.1),
      S.Ξ / 2 * max rI⁻¹ rI'⁻¹ < |Ms.slope z'.1 x - Ms.slope z.1 x +
        (∑ i, (n i : ℝ) * (Ms.zc.θ i / S.Q0)) / ModeSchedule.Lh h| := by
  have hK : (0 : ℤ) ≤ S.K := Nat.cast_nonneg _
  have h1 : J'.1 ≤ b' + S.K := by rw [hJ']; omega
  have hrt := dyadicGridLength_pos Gd (b' + S.K)
  -- no CURRENT edge between the two modes
  have hne : ¬ S.gapEdge
      (fun (x : Ms.alive (ancAt Gd J' (b' - 4 * S.K))) (y : ℝ) => Ms.slope x.1 y)
      (fun l => Ms.zc.θ l / S.Q0)
      (dyadicGridLeft Gd J'.1 J'.2) (dyadicGridLength Gd J'.1)
      (S.Ξ / dyadicGridLength Gd (b' + S.K)) h z' z := by
    intro hedge
    apply hzF
    rw [Ms.blockComps_eq S hA h1]
    unfold preComps ModeSchedule.preCurrent
    exact ModeComponents.ofEdges_F_of_cur _ _ _ _ _ _ hedge
  have hsep := S.sep_of_not_gapEdge
    (fun (x : Ms.alive (ancAt Gd J' (b' - 4 * S.K))) (y : ℝ) => Ms.slope x.1 y)
    (fun l => Ms.zc.θ l / S.Q0)
    (dyadicGridLeft Gd J'.1 J'.2) (dyadicGridLength Gd J'.1)
    (S.Ξ / dyadicGridLength Gd (b' + S.K)) hne (lam := Ms.lamOf z'.1 - Ms.lamOf z.1)
    (γ := -2 * Ms.lamOf z'.1 * dyadicGridLeft Gd (Ms.cellOf z'.1).1 (Ms.cellOf z'.1).2 +
      Ms.γOf z'.1 + 2 * Ms.lamOf z.1 * dyadicGridLeft Gd (Ms.cellOf z.1).1 (Ms.cellOf z.1).2 -
      Ms.γOf z.1) (fun x : ℝ => by simp only [slope]; ring) hvar n hn
  intro x hx
  refine lt_of_le_of_lt ?_ (hsep x hx)
  have hΞ := Ξ_nonneg S
  have hmax : max rI⁻¹ rI'⁻¹ ≤ (dyadicGridLength Gd (b' + S.K))⁻¹ :=
    max_le (inv_anti₀ hrt hrI) (inv_anti₀ hrt hrI')
  calc S.Ξ / 2 * max rI⁻¹ rI'⁻¹ ≤ S.Ξ / 2 * (dyadicGridLength Gd (b' + S.K))⁻¹ :=
        mul_le_mul_of_nonneg_left hmax (div_nonneg hΞ (by norm_num))
    _ = S.Ξ / dyadicGridLength Gd (b' + S.K) / 2 := by ring

end ModeSystem

section LowerAlmostOrthogonal
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-! ### Component sizes (blueprint lines 2193-2209, `eq:size-comparison`) -/

/-- The lower half of `almost_orthogonal_synthesis` (blueprint line 2201, "two-sided almost
orthogonality"): `(1 - η D³) Σ ‖v_e‖² ≤ ‖Σ v_e‖²`. -/
theorem almost_orthogonal_synthesis_lower {κ : Type*} (s : Finset κ) (v : κ → H)
    (b ℓ : κ → ℝ) (w : κ → κ → ℝ) {D η : ℝ} (hη : 0 ≤ η) (hD : 0 ≤ D)
    (hw0 : ∀ e e', 0 ≤ w e e') (hws : ∀ e e', w e e' = w e' e)
    (hcross : ∀ e ∈ s, ∀ e' ∈ s, e ≠ e' → ‖inner ℂ (v e) (v e')‖ ≤ η * w e e' * b e * b e')
    (hmult : ∀ e ∈ s, ∑ e' ∈ s, w e e' ≤ D * ℓ e)
    (hdiag : ∀ e ∈ s, ℓ e * b e ^ 2 ≤ D ^ 2 * ‖v e‖ ^ 2) :
    (1 - η * D ^ 3) * ∑ e ∈ s, ‖v e‖ ^ 2 ≤ ‖∑ e ∈ s, v e‖ ^ 2 := by
  classical
  have hexp : ‖∑ e ∈ s, v e‖ ^ 2 =
      ∑ e ∈ s, ∑ e' ∈ s, RCLike.re (inner ℂ (v e) (v e')) := by
    rw [@norm_sq_eq_re_inner ℂ, sum_inner]
    simp only [inner_sum, map_sum]
  have hpt : ∀ e ∈ s, ∀ e' ∈ s,
      (if e = e' then ‖v e‖ ^ 2 else 0) - η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2)) ≤
        RCLike.re (inner ℂ (v e) (v e')) := by
    intro e he e' he'
    have hw2 : 0 ≤ η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2)) := by
      have := hw0 e e'; positivity
    split_ifs with hee
    · subst hee
      rw [← @norm_sq_eq_re_inner ℂ]
      linarith
    · have h1 := (neg_le_of_abs_le (RCLike.abs_re_le_norm (inner ℂ (v e) (v e')))).trans'
        (neg_le_neg (hcross e he e' he' hee))
      have h2 : b e * b e' ≤ (b e ^ 2 + b e' ^ 2) / 2 := by nlinarith [sq_nonneg (b e - b e')]
      have h3 : η * w e e' * b e * b e' ≤ η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2)) := by
        have := mul_le_mul_of_nonneg_left h2 (mul_nonneg hη (hw0 e e'))
        linarith
      linarith
  have hsym : ∑ e ∈ s, ∑ e' ∈ s, w e e' * ((b e ^ 2 + b e' ^ 2) / 2) =
      ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 := by
    have hswap : ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e' ^ 2 = ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl; intro e _
      apply Finset.sum_congr rfl; intro e' _
      rw [hws]
    have hsplit : ∑ e ∈ s, ∑ e' ∈ s, w e e' * ((b e ^ 2 + b e' ^ 2) / 2) =
        (∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 + ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e' ^ 2) / 2 := by
      rw [← Finset.sum_add_distrib, Finset.sum_div]
      apply Finset.sum_congr rfl; intro e _
      rw [← Finset.sum_add_distrib, Finset.sum_div]
      apply Finset.sum_congr rfl; intro e' _
      ring
    rw [hsplit, hswap]; ring
  have hmain : ∑ e ∈ s, ∑ e' ∈ s, w e e' * b e ^ 2 ≤ D ^ 3 * ∑ e ∈ s, ‖v e‖ ^ 2 := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum; intro e he
    rw [← Finset.sum_mul]
    calc (∑ e' ∈ s, w e e') * b e ^ 2 ≤ D * ℓ e * b e ^ 2 :=
          mul_le_mul_of_nonneg_right (hmult e he) (sq_nonneg _)
      _ = D * (ℓ e * b e ^ 2) := by ring
      _ ≤ D * (D ^ 2 * ‖v e‖ ^ 2) := mul_le_mul_of_nonneg_left (hdiag e he) hD
      _ = D ^ 3 * ‖v e‖ ^ 2 := by ring
  calc (1 - η * D ^ 3) * ∑ e ∈ s, ‖v e‖ ^ 2 ≤
      ∑ e ∈ s, ‖v e‖ ^ 2 - η * ∑ e ∈ s, ∑ e' ∈ s, w e e' * ((b e ^ 2 + b e' ^ 2) / 2) := by
        rw [hsym]
        nlinarith [mul_le_mul_of_nonneg_left hmain hη]
    _ = ∑ e ∈ s, ∑ e' ∈ s,
        ((if e = e' then ‖v e‖ ^ 2 else 0) - η * (w e e' * ((b e ^ 2 + b e' ^ 2) / 2))) := by
        simp only [Finset.sum_sub_distrib, Finset.sum_ite_eq, Finset.mul_sum]
        congr 1
        apply Finset.sum_congr rfl; intro e he
        simp [he]
    _ ≤ ‖∑ e ∈ s, v e‖ ^ 2 := by
        rw [hexp]
        exact Finset.sum_le_sum fun e he => Finset.sum_le_sum fun e' he' => hpt e he e' he'

/-- The lower half of `subtotals_almost_orthogonal`: subtotals over disjoint components with
small mutual pairings satisfy `(1 - η D³) Σ_j ‖T_j‖² ≤ ‖Σ_j T_j‖²`. -/
theorem subtotals_almost_orthogonal_lower {μ ι : Type*} (s : Finset ι) (E : ι → Finset μ)
    (Ψ : μ → H) (β : μ → ℂ) {η L ε D : ℝ} (hη : 0 ≤ η) (hL : 0 ≤ L) (hε : 0 < ε) (hD : 0 ≤ D)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → ∀ m ∈ E i, ∀ m' ∈ E j,
      ‖inner ℂ (Ψ m) (Ψ m')‖ ≤ η * L)
    (hpriv : ∀ i ∈ s, ε * L * ∑ m ∈ E i, ‖β m‖ ^ 2 ≤ ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2)
    (hnum : (s.card : ℝ) ≤ D) (hcard : ∀ i ∈ s, ((E i).card : ℝ) ≤ ε * D ^ 2) :
    (1 - η * D ^ 3) * ∑ i ∈ s, ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 ≤
      ‖∑ i ∈ s, ∑ m ∈ E i, β m • Ψ m‖ ^ 2 := by
  classical
  set b : ι → ℝ := fun i => Real.sqrt (E i).card * Real.sqrt (∑ m ∈ E i, ‖β m‖ ^ 2)
  refine almost_orthogonal_synthesis_lower s (fun i => ∑ m ∈ E i, β m • Ψ m) b (fun _ => L)
    (fun _ _ => L) hη hD (fun _ _ => hL) (fun _ _ => rfl) (fun i hi j hj hij => ?_)
    (fun i _ => ?_) (fun i hi => ?_)
  · have hin : inner ℂ (∑ m ∈ E i, β m • Ψ m) (∑ m ∈ E j, β m • Ψ m) =
        ∑ m ∈ E i, ∑ m' ∈ E j, (starRingEnd ℂ) (β m) * β m' * inner ℂ (Ψ m) (Ψ m') := by
      rw [sum_inner]
      refine Finset.sum_congr rfl fun m _ => ?_
      rw [inner_sum]
      refine Finset.sum_congr rfl fun m' _ => ?_
      rw [inner_smul_left, inner_smul_right]; ring
    rw [hin]
    have h := mode_combination_cross_le (E i) (E j) (fun m => (starRingEnd ℂ) (β m)) β
      (fun m m' => inner ℂ (Ψ m) (Ψ m')) (mul_nonneg hη hL) (hpair i hi j hj hij)
    simp only [RCLike.norm_conj] at h
    refine h.trans (le_of_eq ?_)
    simp only [b]
  · rw [Finset.sum_const, nsmul_eq_mul]
    exact mul_le_mul_of_nonneg_right hnum hL
  · have h1 := hpriv i hi
    have hs0 : 0 ≤ ∑ m ∈ E i, ‖β m‖ ^ 2 := Finset.sum_nonneg fun _ _ => sq_nonneg _
    have hb2 : b i ^ 2 = (E i).card * ∑ m ∈ E i, ‖β m‖ ^ 2 := by
      simp only [b]; rw [mul_pow, Real.sq_sqrt (Nat.cast_nonneg _), Real.sq_sqrt hs0]
    rw [hb2]
    have hc0 : (0 : ℝ) ≤ (E i).card := Nat.cast_nonneg _
    have h3 : L * ∑ m ∈ E i, ‖β m‖ ^ 2 ≤ ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 / ε := by
      rw [le_div_iff₀ hε]; linarith
    calc L * ((E i).card * ∑ m ∈ E i, ‖β m‖ ^ 2) =
        (E i).card * (L * ∑ m ∈ E i, ‖β m‖ ^ 2) := by ring
      _ ≤ (E i).card * (‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 / ε) := mul_le_mul_of_nonneg_left h3 hc0
      _ ≤ ε * D ^ 2 * (‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 / ε) :=
          mul_le_mul_of_nonneg_right (hcard i hi) (div_nonneg (sq_nonneg _) hε.le)
      _ = D ^ 2 * ‖∑ m ∈ E i, β m • Ψ m‖ ^ 2 := by field_simp

end LowerAlmostOrthogonal

section ComponentSizes
variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]

/-- Blueprint `eq:size-comparison` (lines 2196-2209), first assertion, at one actual cell: the core
subtotals `A_D = Σ_{m core in D} α_m Ψ_m` of the minimal CURRENT components `D ⊆ F` (pairwise
almost orthogonal, `η D³ ≤ 1/2`) with coefficient floors `y_D` (`Σ y_D² ≤ η_f`) satisfy
`σ_F² = Σ_D (‖A_D‖ + y_D)² ≤ 12 (‖P_F Z̃‖² + ε² + ‖V_F‖²) + 2 η_f`, when the full subtotal is
`T_F = V_F + Σ_D A_D` and `‖P_F Z̃ - T_F‖ ≤ ε`. -/
theorem component_sizes {μ ι : Type*} (s : Finset ι) (Dc : ι → Finset μ) (Ψ : μ → H)
    (α : μ → ℂ) {η L ε D : ℝ} (hη : 0 ≤ η) (hL : 0 ≤ L) (hε : 0 < ε) (hD : 0 ≤ D)
    (hpair : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → ∀ m ∈ Dc i, ∀ m' ∈ Dc j,
      ‖inner ℂ (Ψ m) (Ψ m')‖ ≤ η * L)
    (hpriv : ∀ i ∈ s, ε * L * ∑ m ∈ Dc i, ‖α m‖ ^ 2 ≤ ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2)
    (hnum : (s.card : ℝ) ≤ D) (hcard : ∀ i ∈ s, ((Dc i).card : ℝ) ≤ ε * D ^ 2)
    (hηD : η * D ^ 3 ≤ 1 / 2) (y : ι → ℝ) {ηf : ℝ} (hy : ∑ i ∈ s, y i ^ 2 ≤ ηf)
    {TF VF PZ : H} {εc : ℝ} (hεc : 0 ≤ εc)
    (hT : TF - VF = ∑ i ∈ s, ∑ m ∈ Dc i, α m • Ψ m) (hclose : ‖PZ - TF‖ ≤ εc) :
    ∑ i ∈ s, (‖∑ m ∈ Dc i, α m • Ψ m‖ + y i) ^ 2 ≤
      12 * (‖PZ‖ ^ 2 + εc ^ 2 + ‖VF‖ ^ 2) + 2 * ηf := by
  have hlow := subtotals_almost_orthogonal_lower s Dc Ψ α hη hL hε hD hpair hpriv hnum hcard
  rw [← hT] at hlow
  have ha : ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 ≤ 2 * ‖TF - VF‖ ^ 2 := by
    have h0 : 0 ≤ ∑ i ∈ s, ‖∑ m ∈ Dc i, α m • Ψ m‖ ^ 2 := Finset.sum_nonneg fun _ _ => by positivity
    nlinarith
  have hTn : |‖TF - VF‖| ≤ ‖PZ‖ + εc + ‖VF‖ := by
    rw [abs_of_nonneg (norm_nonneg _)]
