    intro e he
    refine (sum_measureReal_inter_le s Ms.evCell
      (fun e => dyadicGridCell_measurable Gd e.2.1.1 e.2.1.2)
      (fun e => dyadicGridCell_volume_ne_top Gd e.2.1) e (N := Fintype.card Ms.Md)
