theorem top_measure_absorb {σ2 S W ε : ℝ} (hσ : 0 < σ2) (hS : 0 ≤ S)
    (h : σ2 * S ≤ W + ε * S) (hε : ε ≤ σ2 / 2) : S ≤ 2 * W / σ2 := by
