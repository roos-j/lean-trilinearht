/-- Blueprint lines 2176-2180: with `F = π(F_late)`, the later predecessor labels `B` carrying
nine tenths of `F`, the earlier ones `A` more than half of `B`, and good primaries `G` nine tenths
of `F`, the three label sets share a primary (more than `7|F|/20` of `A ∩ B`, minus the bad ones).
-/
theorem early_late_good_common {P : Type*} [DecidableEq P] (Fs A B G : Finset P) (hA : A ⊆ Fs)
    (hB : B ⊆ Fs) (hG : G ⊆ Fs) (hBF : 9 * Fs.card ≤ 10 * B.card) (hAB : B.card < 2 * A.card)
    (hGF : 9 * Fs.card ≤ 10 * G.card) : (A ∩ B ∩ G).Nonempty := by
  have h3 := card_inter_three_ge Fs A B G hA hB hG
  apply Finset.card_pos.mp
  omega

/-- Blueprint lines 2180-2181: by stabilization, the joined witnesses of a common later
nonexceptional height-good primary nest the earlier PRE predecessor inside the later one. -/
theorem early_predecessor_nested {Mode P : Type*} [DecidableEq P]
    (π : Mode → P) (Fl El Ee : Finset Mode) (goodP : P → Prop) [DecidablePred goodP]
    (hEe : Ee ⊆ Fl) (hEl : El ⊆ Fl)
    (hBF : 9 * (Fl.image π).card ≤ 10 * (El.image π).card)
    (hAB : (El.image π).card < 2 * (Ee.image π).card)
    (hGF : 9 * (Fl.image π).card ≤ 10 * ((Fl.image π).filter goodP).card)
    (hjoin : ∀ x ∈ Ee, ∀ x' ∈ El, π x = π x' → goodP (π x) → Ee ⊆ El) : Ee ⊆ El := by
  obtain ⟨p, hp⟩ := early_late_good_common (Fl.image π) (Ee.image π) (El.image π)
    ((Fl.image π).filter goodP) (Finset.image_subset_image hEe) (Finset.image_subset_image hEl)
    (Finset.filter_subset _ _) hBF hAB hGF
  obtain ⟨⟨hpA, hpB⟩, hpG⟩ := Finset.mem_inter.mp hp |>.imp_left Finset.mem_inter.mp
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hpA
  obtain ⟨x', hx', hxx'⟩ := Finset.mem_image.mp hpB
  exact hjoin x hx x' hx' hxx'.symm (Finset.mem_filter.mp hpG).2

/-- Blueprint lines 2181-2182: two subsets of `C`, each with more than half of its elements,
intersect. -/
theorem majority_subsets_inter {α : Type*} [DecidableEq α] (A B C : Finset α) (hA : A ⊆ C)
    (hB : B ⊆ C) (hAC : C.card < 2 * A.card) (hBC : C.card < 2 * B.card) :
    (A ∩ B).Nonempty := by
  have e := Finset.card_union_add_card_inter A B
  have c := Finset.card_le_card (Finset.union_subset hA hB)
  apply Finset.card_pos.mp
  omega

/-- Blueprint `eq:representative-separation` (lines 2184-2190): if the affine frequency
difference `2λx + γ` exceeds `θ` at one point of a cell of length `r` and `2|λ| r ≤ θ/2`, it
exceeds `θ/2` everywhere on the cell. -/
theorem affine_separation_on_cell {lam γ a r θ x₀ : ℝ} (hx₀ : x₀ ∈ Set.Icc a (a + r))
    (hlarge : θ < |2 * lam * x₀ + γ|) (hvar : 2 * |lam| * r ≤ θ / 2) :
    ∀ x ∈ Set.Icc a (a + r), θ / 2 < |2 * lam * x + γ| := by
  intro x hx
  have hxx : |x - x₀| ≤ r := by
    rw [abs_le]; constructor <;> linarith [hx.1, hx.2, hx₀.1, hx₀.2]
  have hd : |(2 * lam * x + γ) - (2 * lam * x₀ + γ)| ≤ θ / 2 := by
    rw [show (2 * lam * x + γ) - (2 * lam * x₀ + γ) = 2 * lam * (x - x₀) by ring, abs_mul,
      abs_mul, abs_two]
    calc 2 * |lam| * |x - x₀| ≤ 2 * |lam| * r := by gcongr
      _ ≤ θ / 2 := hvar
  have := abs_sub_abs_le_abs_sub (2 * lam * x₀ + γ) (2 * lam * x + γ)
  rw [abs_sub_comm] at this
  linarith

/-- Blueprint `eq:size-comparison` (lines 2196-2209): with
`σ² = Σ_D (‖A_D‖ + y_D)²`, `Σ_D ‖A_D‖² ≤ c ‖T_F - V_F‖²`, coefficient floors `Σ_D y_D² ≤ η`,
and `‖P_F Z̃ - T_F‖ ≤ ε`, one has `σ² ≤ 6c (‖P_F Z̃‖² + ε² + ‖V_F‖²) + 2η`. -/
theorem component_size_comparison {ι : Type*} (s : Finset ι) (a y : ι → ℝ) {c η : ℝ}
    {T V PZ : ℝ} (hc : 0 ≤ c) (ha : ∑ D ∈ s, a D ^ 2 ≤ c * T ^ 2) (hy : ∑ D ∈ s, y D ^ 2 ≤ η)
    {ε : ℝ} (hT : |T| ≤ PZ + ε + V) (hPZ : 0 ≤ PZ) (hε : 0 ≤ ε) (hV : 0 ≤ V) :
    ∑ D ∈ s, (a D + y D) ^ 2 ≤ 6 * c * (PZ ^ 2 + ε ^ 2 + V ^ 2) + 2 * η := by
  have h1 : ∑ D ∈ s, (a D + y D) ^ 2 ≤ ∑ D ∈ s, (2 * a D ^ 2 + 2 * y D ^ 2) :=
    Finset.sum_le_sum fun D _ => by nlinarith [sq_nonneg (a D - y D)]
  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum] at h1
  have hT2 : T ^ 2 ≤ 3 * (PZ ^ 2 + ε ^ 2 + V ^ 2) := by
    have h0 : 0 ≤ PZ + ε + V := by positivity
    have : T ^ 2 ≤ (PZ + ε + V) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hT 2
    nlinarith [sq_nonneg (PZ - ε), sq_nonneg (PZ - V), sq_nonneg (ε - V)]
  nlinarith [mul_le_mul_of_nonneg_left hT2 hc]

/-- Blueprint lines 2222-2226 (`prop:tops`, absorption): from
