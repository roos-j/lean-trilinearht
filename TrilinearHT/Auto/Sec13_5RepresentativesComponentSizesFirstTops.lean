      ∃ c : ℤ × ℤ, Ms.evCell e ∩ Ms.evCell e' = dyadicGridCell Gd c.1 c.2 ∧
        Disjoint e.2.2 e'.2.2 ∧ ∀ m ∈ e.2.2, ∀ m' ∈ e'.2.2,
