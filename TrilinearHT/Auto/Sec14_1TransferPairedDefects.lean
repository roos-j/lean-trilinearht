theorem sideState_restrict_base (fp : bf.FamParams) {n : ℕ} (Ms : ModeSystem A.G n) (l : Fin 4)
    (s : List (CatCol bf.Vtx)) (mb : bf.MainBudget s) (G : bf.Grp) (j : ℕ) (ls : List (ℕ × Bool))
    (S : ModeSchedule) (hA : 6 ≤ S.A0) (SP : SideParams) (c : ℤ × ℤ → Ms.Md → ℂ) (b h : ℤ)
    (nf : ℕ) (I : ℤ × ℤ) :
    MainFresh fp.Mc nf (columnL2Restriction (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (fp.sideState Ms l s mb G j ls S hA SP c b h)) ∧
    ∀ᵐ y ∂volume, y ∉ dyadicGridCell A.G I.1 I.2 →
      (columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (fp.sideState Ms l s mb G j ls S hA SP c b h) : ℝ → ColumnHilbert (bf.Lab ⊕ Fin fp.Mc))
          y = 0 := by
  constructor
  · unfold sideState
    rw [map_add, map_sub]
    exact ((fp.sideState_base _ nf I).1.sub (fp.sideState_base _ nf I).1).add
      (fp.sideState_base _ nf I).1
  · filter_upwards [columnL2Restriction_coeFn (dyadicGridCell A.G I.1 I.2)
      (dyadicGridCell_measurable A.G I.1 I.2) (fp.sideState Ms l s mb G j ls S hA SP c b h)]
      with y hy hyI
    rw [hy, Set.indicator_of_notMem hyI]

open Classical in
/-- Blueprint lines 2236-2237 ("construct the helper rank reserved in Lemma `lem:closure`, on these
whole states and the specified histories. Their number on a path is within the main budget, and
