/-- The vertex chart of an available vertex is a pure source of its tag in its slot. -/
theorem vchart_source {x : A.Vtx} (hx : A.occAvail x.2.1 x.1) :
    QuadraticChartComplexity A.csrc A.Hsrc (A.vchart x).2 ∧
      IsBoundedQuadraticChart (A.vchart x).2 ∧
      (A.vchart x).2.horizontal = (A.vtag x).θ ∧
      (A.vchart x).2.matrix = (slotCoeff x.1.1 : ℚ) • (A.vtag x).C ∧
      (A.vchart x).2.quadratic = slotCoeff x.1.1 * (A.vtag x).lam := by
  obtain ⟨hc, hb, -⟩ := A.vchart_spec x hx
  obtain ⟨h1, h2, h3⟩ := A.vtag_chart x
  exact ⟨quadraticChartComplexity_mono hc A.Hm_le_Hsrc, hb, h1, h2, h3⟩

