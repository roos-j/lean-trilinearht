/-! ## The filters of a leaf and their passes on the main columns (blueprint lines 2240-2256) -/

namespace ActiveSetup.BasicFamilies.FamParams
variable {κ : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ c₀} {bf : A.BasicFamilies}
  (fp : bf.FamParams)

/-- The positive filters of a slot for the group `G` at the ball level `j` on the cell `I` along
the positive chain `t` (outermost first): the ball filter, then the cumulative layers of the
chain, each as its rank and its pad masks. -/
def slotFiltM (G : bf.Grp) (j : ℕ) (I : ℤ × ℤ) (t : List ℕ) :
    List (ℕ × (Fin fp.P → bf.Vtx → Prop)) :=
  (fp.brank j, fun p : Fin fp.P => fp.bmask I G j (p + 1)) ::
    t.map fun m => (fp.crank m, fun p : Fin fp.P => fp.cmask I m (p + 1))

/-- The cumulative layers of a positive chain are the averages of their pad families. -/
theorem applyAll_cumM (l : Fin 4) (s : List (CatCol bf.Vtx)) (I : ℤ × ℤ) :
    ∀ (t : List ℕ) (y : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)),
      applyAll ((t.map fun m => (fp.crank m, fun p : Fin fp.P => fp.cmask I m (p + 1))).map
        (fp.filtAvgM l s I)) y = chainOp (fun m => fp.cumFilt l s I m) t y
  | [], y => rfl
  | m :: t, y => by
    simp only [List.map_cons, applyAll]
    rw [applyAll_cumM l s I t y, fp.filtAvgM_apply]
    rfl

/-- The filters of a slot along a positive chain compose to the ball filter of the chain
output. -/
theorem applyAll_slotFiltM (l : Fin 4) (s : List (CatCol bf.Vtx)) (G : bf.Grp) (j : ℕ)
    (I : ℤ × ℤ) (t : List ℕ) (y : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) :
    applyAll ((fp.slotFiltM G j I t).map (fp.filtAvgM l s I)) y =
      fp.ballFilt l s I G j (chainOp (fun m => fp.cumFilt l s I m) t y) := by
  unfold slotFiltM
  rw [List.map_cons, applyAll, fp.applyAll_cumM, fp.filtAvgM_apply]
  rfl

/-- A suffix of the filters of a slot along a chain, headed by a filter, is the whole list (the
ball filter first) or a cumulative layer of the chain followed by the inner layers. -/
theorem slotFiltM_suffix_cons (G : bf.Grp) (j : ℕ) (I : ℤ × ℤ) (t : List ℕ)
    {f : ℕ × (Fin fp.P → bf.Vtx → Prop)} {xs' : List (ℕ × (Fin fp.P → bf.Vtx → Prop))}
    (h : (f :: xs') <:+ fp.slotFiltM G j I t) :
    (f = (fp.brank j, fun p : Fin fp.P => fp.bmask I G j (p + 1)) ∧
      xs' = t.map fun m => (fp.crank m, fun p : Fin fp.P => fp.cmask I m (p + 1))) ∨
    ∃ k < t.length,
      f = (fp.crank (t.getD k 0), fun p : Fin fp.P => fp.cmask I (t.getD k 0) (p + 1)) ∧
      xs' = (t.drop (k + 1)).map fun m =>
        (fp.crank m, fun p : Fin fp.P => fp.cmask I m (p + 1)) := by
  obtain ⟨pre, hpre⟩ := h
  unfold slotFiltM at hpre
  rcases pre with _ | ⟨g, pre⟩
  · simp only [List.nil_append, List.cons.injEq] at hpre
    exact Or.inl ⟨hpre.1, hpre.2⟩
  · simp only [List.cons_append, List.cons.injEq] at hpre
    obtain ⟨-, hpre⟩ := hpre
    right
    have hk : pre.length < t.length := by
      have := congrArg List.length hpre
      simp only [List.length_append, List.length_cons, List.length_map] at this
      omega
    refine ⟨pre.length, hk, ?_⟩
    have hd := congrArg (List.drop pre.length) hpre
    rw [List.drop_left, ← List.map_drop, List.drop_eq_getElem_cons hk, List.map_cons] at hd
    simp only [List.cons.injEq] at hd
    obtain ⟨hf, hx⟩ := hd
    exact ⟨by rw [hf, List.getD_eq_getElem _ _ hk], hx⟩

/-- A suffix of the filters of a slot along a chain is empty, the whole list, or a tail of
cumulative layers. -/
theorem slotFiltM_suffix (G : bf.Grp) (j : ℕ) (I : ℤ × ℤ) (t : List ℕ)
    {ys' : List (ℕ × (Fin fp.P → bf.Vtx → Prop))} (h : ys' <:+ fp.slotFiltM G j I t) :
    ys' = [] ∨ ys' = fp.slotFiltM G j I t ∨
      ∃ k < t.length, ys' = (t.drop k).map fun m =>
        (fp.crank m, fun p : Fin fp.P => fp.cmask I m (p + 1)) := by
  rcases ys' with _ | ⟨f, ys'⟩
  · exact Or.inl rfl
  · rcases fp.slotFiltM_suffix_cons G j I t h with ⟨hf, hx⟩ | ⟨k, hk, hf, hx⟩
    · right; left
      rw [hf, hx]
      rfl
    · right; right
      refine ⟨k, hk, ?_⟩
      rw [hf, hx, List.drop_eq_getElem_cons hk, List.map_cons, List.getD_eq_getElem _ _ hk]

open Classical in
/-- Blueprint line 2256 ("cumulative masks have neighbor closure by the triangle inequality"):
the filters of cumulative layers have the mask conditions. -/
theorem filtOK_cum (I : ℤ × ℤ) (m : ℕ) :
    fp.FiltOK I (fp.crank m, fun p : Fin fp.P => fp.cmask I m (p + 1)) := by
  refine ⟨fun i j hij x hx => fp.cmask_pad_mono I m (by
    have : (i : ℕ) ≤ j := hij
    omega) x hx, fun k hk w y hw hy hd => ?_⟩
  exact ColorSetup.cumMask_neighbor hw hy hd

open Classical in
/-- Blueprint line 2256 ("ball masks have it at actual uses by Lemma masks"): the ball filter of
the group of a successful present vertex has the mask conditions. -/
theorem filtOK_ball (I : ℤ × ℤ) {v₀ : bf.Vtx} (hv₀ : v₀ ∈ bf.admT.X (bf.admAt I))
    (hs₀ : fp.K.Success (fp.K.colorData (bf.admT.st (bf.admAt I)) v₀)) {j : ℕ} (hj : j ≤ 4) :
    fp.FiltOK I (fp.brank j, fun p : Fin fp.P =>
      fp.bmask I (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀) j (p + 1)) := by
  refine ⟨fun i j' hij x hx => fp.bmask_pad_mono I _ j (by
    have : (i : ℕ) ≤ j' := hij
    omega) x hx, fun k hk w y hw hy hd => ?_⟩
  have hH : fp.bbase j + ((k : ℕ) + 1) < fp.Hmax := by
    have := fp.bbase_le (p := (k : ℕ) + 1) hj (by omega)
    omega
  exact (bf.masks fp.Hed fp.Hmax fp.ωp fp.ωh).2.1 (bf.admAt I) v₀ hv₀ hs₀ _ hH w y hw hy hd

open Classical in
theorem cmask_present {I : ℤ × ℤ} {m p : ℕ} {x : bf.Vtx} (hx : fp.cmask I m p x) :
    x ∈ bf.admT.X (bf.admAt I) := hx.1

open Classical in
theorem bmask_present {I : ℤ × ℤ} {G : bf.Grp} {j p : ℕ} {x : bf.Vtx}
    (hx : fp.bmask I G j p x) : x ∈ bf.admT.X (bf.admAt I) := hx.1

open Classical in
/-- Blueprint line 2254 ("expand instead the lower-rank primal source"): an averaged main filter
of a slot with masks of present vertices, applied to a value of size at most `S √|I|`, is a
combination of bounded pure sources of present vertices with coefficient sum at most `D √N S`
when the masked main labels number at most `N`. -/
theorem srcDataM_filt (o : Fin 4) (s : List (CatCol bf.Vtx))
    (hT : ∀ e ∈ s, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) o R γ e.birth e.rank e.tag)
    (htag : ∀ e ∈ s, bf.occAvail e.tag.2.1 e.tag.1) (I : ℤ × ℤ)
    (g : ℕ × (Fin fp.P → bf.Vtx → Prop)) (hg : ∀ k x, g.2 k x → x ∈ bf.admT.X (bf.admAt I))
    (d₀ : bf.Vtx) (z : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {S N Co : ℝ}
    (hz : ‖z‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ S)
    (hN : ((mainLabelsM A.G fp.Mc (bf.origCols o) s I g.1 (fun y => ∃ p, g.2 p y) d₀).card : ℝ) ≤
      N)
    (hCo : A.colBudget * Real.sqrt N * S ≤ Co) :
    fp.SrcDataM o I (fp.filtAvgM o s I g z) Co := by
  set F := mainLabelsM A.G fp.Mc (bf.origCols o) s I g.1 (fun y => ∃ p, g.2 p y) d₀
  obtain ⟨co, hval, hsum⟩ := bf.avg_expansion o s I g.1 fp.hP g.2 (fun y => ∃ p, g.2 p y)
    (fun p y h => ⟨p, h⟩) d₀ z
  have hsrc := fun v : {v // v ∈ F} => bf.mainLabel_source o s hT htag I g.1 _ d₀ v.2
  refine ⟨{v // v ∈ F}, Finset.univ, fun v => co v.1,
    fun v => mainCol A.G fp.Mc (bf.origCols o) s I v.1,
    fun v => labelTag (bf.origCols o) s I d₀ v.1, ?_, ?_, fun v _ => ?_, fun v _ => (hsrc v).2⟩
  · rw [fp.filtAvgM_apply, hval,
      Finset.sum_coe_sort F (fun v => co v • mainCol A.G fp.Mc (bf.origCols o) s I v)]
  · rw [Finset.sum_coe_sort F (fun v => ‖co v‖)]
    refine hsum.trans (le_trans ?_ hCo)
    have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
    have hcb : (0 : ℝ) ≤ A.colBudget := by linarith [A.two_le_colBudget]
    have hN0 : 0 ≤ N := le_trans (Nat.cast_nonneg _) hN
    have hS0 : 0 ≤ S := le_trans (by positivity) hz
    rw [mul_div_assoc]
    exact mul_le_mul (mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hN) hcb) hz (by positivity)
      (by positivity)
  · obtain ⟨p, hp⟩ := (hsrc v).1
    exact hg p _ hp

open Classical in
/-- Blueprint line 2254 ("using its basic columns when it is unfiltered"): the basic input of a
slot at an active cell is a combination of bounded pure sources of present vertices (its
available original columns) with coefficient sum at most `D √(2D) S`. -/
theorem srcDataM_basic (o : Fin 4) (s : List (CatCol bf.Vtx))
    (hT : ∀ e ∈ s, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) o R γ e.birth e.rank e.tag)
    (htag : ∀ e ∈ s, bf.occAvail e.tag.2.1 e.tag.1) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    (d₀ : bf.Vtx) {S Co : ℝ}
    (hz : ‖bf.basicIn fp.Mc o I‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ S)
    (hCo : A.colBudget * Real.sqrt (2 * A.colBudget) * S ≤ Co) :
    fp.SrcDataM o I (bf.basicIn fp.Mc o I) Co := by
  obtain ⟨cb, hcbx⟩ := bf.basicIn_comb fp.Mc s o hI
  set Fb := Finset.univ.filter (fun v => (bf.origCols o).avail I v)
  have hsrc : ∀ v ∈ Fb, ∃ Ay : QuadraticChartData (bf.vtag (bf.vtxAt I v)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc Ay ∧ IsBoundedQuadraticChart Ay ∧
      Ay.horizontal = (bf.vtag (bf.vtxAt I v)).θ ∧
      Ay.matrix = (slotCoeff o : ℚ) • (bf.vtag (bf.vtxAt I v)).C ∧
      Ay.quadratic = slotCoeff o * (bf.vtag (bf.vtxAt I v)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (mainCol A.G fp.Mc (bf.origCols o) s I (Sum.inl v)) y =
          quadraticChartAtom Ay y := fun v hv => by
    have hav : (bf.origCols o).avail I v := (Finset.mem_filter.mp hv).2
    have hmem : (Sum.inl v : bf.Lab ⊕ Fin fp.Mc) ∈
        mainLabelsM A.G fp.Mc (bf.origCols o) s I 0 (fun _ => True) d₀ :=
      mem_mainLabelsM.mpr ⟨mem_mainLabels.mpr hav, trivial⟩
    exact (bf.mainLabel_source o s hT htag I 0 _ d₀ hmem).2
  refine ⟨bf.Lab, Fb, cb, fun v => mainCol A.G fp.Mc (bf.origCols o) s I (Sum.inl v),
    fun v => bf.vtxAt I v, hcbx, ?_, fun v hv => bf.vtxAt_mem (Finset.mem_filter.mp hv).2.2,
    hsrc⟩
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  set F' : Finset (bf.Lab ⊕ Fin fp.Mc) := Fb.map ⟨Sum.inl, Sum.inl_injective⟩
  set c' : bf.Lab ⊕ Fin fp.Mc → ℂ := Sum.elim cb 0
  have hmemF : ∀ v ∈ F', v ∈ mainLabels A.G fp.Mc (bf.origCols o) s I 0 := by
    intro w hw
    obtain ⟨v, hv, rfl⟩ := Finset.mem_map.mp hw
    exact mem_mainLabels.mpr (Finset.mem_filter.mp hv).2
  have hcb0 : (0 : ℝ) ≤ A.colBudget := by linarith [A.two_le_colBudget]
  have hc := mainCoeff_sum_le s I F' c' (fun v hv => bf.mainLabel_memLp o s I 0 (hmemF v hv))
    hcb0 (fun v _ => bf.inv_mainWeight_le o v)
  have e1 : ∑ v ∈ F', ‖c' v‖ = ∑ v ∈ Fb, ‖cb v‖ := by
    rw [Finset.sum_map]; rfl
  have e2 : ∑ v ∈ F', c' v • mainCol A.G fp.Mc (bf.origCols o) s I v = bf.basicIn fp.Mc o I := by
    rw [Finset.sum_map, hcbx]; rfl
  have e3 : F'.card = Fb.card := Finset.card_map _
  rw [e1, e2, e3] at hc
  refine hc.trans (le_trans ?_ hCo)
  have hFb : (Fb.card : ℝ) ≤ 2 * A.colBudget := bf.card_avail_le o I
  have hS0 : 0 ≤ S := le_trans (by positivity) hz
  rw [mul_div_assoc]
  calc Real.sqrt Fb.card * A.colBudget *
        (‖bf.basicIn fp.Mc o I‖ / Real.sqrt (dyadicGridLength A.G I.1))
      ≤ Real.sqrt (2 * A.colBudget) * A.colBudget * S := by
        gcongr
    _ = A.colBudget * Real.sqrt (2 * A.colBudget) * S := by ring

open Classical in
/-- Blueprint lines 1807-1811 and 2254 on a positive chain (the main test of a transfer step):
if the named main tests of the slot pass, the residual of a single named target projection of
rank `r + 1` on the chain value of the basic argument passes at level `τ_{r+1} ‖z‖_{2,I}`. -/
theorem chain_passM (l : Fin 4) (s : List (CatCol bf.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    (z : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {τ : ℕ → ℝ}
    (hpass : ∀ w : fp.TestName I Unit, (fp.testOf l I (fun _ => z) w).Pass A.G (bf.origCols l) I
      A.csrc A.Hsrc bf.vtag (A.w I) (τ (fp.testOf l I (fun _ => z) w).r) fp.mH s)
    (ch : List ℕ) (hch : ∀ m ∈ ch, m ≤ fp.Lc) (hlen : ch.length ≤ fp.mH)
    (r : Fin (fp.Lc + 5)) (Mt : fp.MaskName I) :
    CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag l (fp.maskOf I Mt)
      (chainOp (fun m => fp.cumFilt l s I m) ch z -
        mainProj A.G fp.Mc (bf.origCols l) s I ((r : ℕ) + 1) (fp.maskOf I Mt)
          (chainOp (fun m => fp.cumFilt l s I m) ch z))
      (τ ((r : ℕ) + 1) * cellNorm A.G I z) := by
  have hls : ∀ e ∈ ActiveSetup.AttemptParams.chainHist ch 0, e.1 ≤ fp.Lc := by
    intro e he
    simp only [ActiveSetup.AttemptParams.chainHist, List.drop_zero, List.mem_map,
      List.mem_reverse] at he
    obtain ⟨m, hm, rfl⟩ := he
    exact hch m hm
  have hlen' : (ActiveSetup.AttemptParams.chainHist ch 0).length ≤ fp.mH := by
    simp only [ActiveSetup.AttemptParams.chainHist, List.drop_zero, List.length_map,
      List.length_reverse]
    exact hlen
  have h := fp.layer_residOK (A.adm I hI) l s z (ActiveSetup.AttemptParams.chainHist ch 0) hls
    hlen' r (fun _ => Mt) (τ := τ ((r : ℕ) + 1)) (fun pc => hpass _)
  rw [opAvg_const fp.hP, layerOp_chainHist, List.drop_zero] at h
  refine ResidPass.cellPass (A.adm I hI) ?_
  exact h.mono (fun x hx _ => hx) le_rfl

open Classical in
/-- Blueprint lines 2253 and 1810-1811 (the helper test of a transfer step): if the named helper
tests of the slot pass on the base `base b₀` at threshold `τ_H`, the residual of a single named
helper target projection on the side value after `k` averaged helper factors with named pad
masks passes at level `τ_H ‖base b₀‖_{2,I}`. -/
theorem helper_stepPass (l : Fin 4) (s : List (CatCol bf.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    {Bh : Type} (base : Bh → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (b₀ : Bh) {τH : ℝ}
    (hpass : ∀ w : fp.HelperName I Bh, (fp.helperOf l I base w).Pass A.G (bf.origCols l) I
      A.csrc A.Hsrc bf.vtag (A.w I) τH fp.mH s)
    (k : ℕ) (hk : k ≤ fp.mH) (Mst : ℕ → Fin fp.P → bf.Vtx → Prop)
    (hMst : ∀ i < k, ∀ p, ∃ M : fp.MaskName I, fp.maskOf I M = Mst i p)
    (Mt : fp.MaskName I) :
    CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag l (fp.maskOf I Mt)
      (operatorComplementProduct (fun i => opAvg fun p =>
          mainProj A.G fp.Mc (bf.origCols l) s I (fp.Lc + 5) (Mst i p)) (fun _ => false) k
          (base b₀) -
        mainProj A.G fp.Mc (bf.origCols l) s I (fp.Lc + 5) (fp.maskOf I Mt)
          (operatorComplementProduct (fun i => opAvg fun p =>
            mainProj A.G fp.Mc (bf.origCols l) s I (fp.Lc + 5) (Mst i p)) (fun _ => false) k
            (base b₀)))
      (τH * cellNorm A.G I (base b₀)) := by
  choose nm hnm using fun (i : Fin k) p => hMst i i.2 p
  refine ResidPass.cellPass (A.adm I hI) ?_
  have key := avg_history_pass (A.adm I hI) (c₀ := A.csrc) (H := A.Hsrc) (tagOf := bf.vtag)
    (t := l) (M := fp.maskOf I Mt) fp.hP
    (fun i p => mainProj A.G fp.Mc (bf.origCols l) s I (fp.Lc + 5) (Mst i p)) (fun _ => false) k
    (fun _ => mainProj A.G fp.Mc (bf.origCols l) s I (fp.Lc + 5) (fp.maskOf I Mt)) (base b₀)
    (β := τH * cellNorm A.G I (base b₀)) fun pc => ?_
  · rw [opAvg_const fp.hP] at key
    exact key
  · have h := (MainTest.pass_iff _ _ _ _ _ _ _ _ _ _ _).mp (hpass
      (Mt, ⟨⟨k, Nat.lt_succ_of_le hk⟩, fun i => (⟨fp.Lc + 5, by omega⟩, nm i (pc.2 i), false)⟩,
        b₀))
    set w : fp.HelperName I Bh :=
      (Mt, ⟨⟨k, Nat.lt_succ_of_le hk⟩, fun i => (⟨fp.Lc + 5, by omega⟩, nm i (pc.2 i), false)⟩,
        b₀) with hw
    have hm : (fp.helperOf l I base w).m = k := rfl
    have hop : operatorComplementProduct
        (fun i => (fp.helperOf l I base w).Q A.G fp.Mc (bf.origCols l) I s i)
        (fp.helperOf l I base w).θ fp.mH =
        operatorComplementProduct (fun i => mainProj A.G fp.Mc (bf.origCols l) s I (fp.Lc + 5)
          (Mst i (choiceExt fp.hP pc.2 i))) (fun _ => false) k := by
      have htail := operatorComplementProduct_id_tail
        (fun i => (fp.helperOf l I base w).Q A.G fp.Mc (bf.origCols l) I s i)
        (fp.helperOf l I base w).θ k
        (fun i hi => by
          unfold MainTest.Q
          rw [ite_eq_right_of_eq_false _ _ (eq_false (by rw [hm]; omega))])
        (fun i hi => by
          change (if h : i < k then _ else false) = false
          rw [dite_eq_right_of_eq_false (eq_false (by omega))])
        (fp.mH - k)
      rw [show fp.mH = k + (fp.mH - k) by omega, htail]
      refine operatorComplementProduct_congr₂ k fun i hi => ⟨?_, ?_⟩
      · unfold MainTest.Q
        rw [ite_eq_left_of_eq_true _ _ (eq_true (by rw [hm]; exact hi))]
        change mainProj A.G fp.Mc (bf.origCols l) s I
            (if h : i < k then fp.Lc + 5 else 0)
            (if h : i < k then fp.maskOf I (nm ⟨i, h⟩ (pc.2 ⟨i, h⟩)) else fun _ => False) = _
        rw [dite_eq_left_of_eq_true (eq_true hi), dite_eq_left_of_eq_true (eq_true hi)]
        have hc : choiceExt fp.hP pc.2 i = pc.2 ⟨i, hi⟩ := by
          unfold choiceExt; rw [dite_eq_left_of_eq_true (eq_true hi)]
        rw [hc, hnm]
      · change (if h : i < k then false else false) = false
        split <;> rfl
    unfold MainTest.resid MainTest.hist at h
    rw [hop] at h
    exact h

end ActiveSetup.BasicFamilies.FamParams

section RankMerge3
variable {α : Type*}

/-- The entries of a merge come from the two lists. -/
theorem rankMerge_mem (key : α → ℕ) (xs ys : List α) {e : Bool × α}
    (he : e ∈ rankMerge key xs ys) : e.2 ∈ xs ∨ e.2 ∈ ys := by
  rcases Bool.eq_false_or_eq_true e.1 with h | h
  · left
    have hm : e ∈ (rankMerge key xs ys).filter (fun e => decide (e.1 = true)) :=
      List.mem_filter.mpr ⟨he, by simp [h]⟩
    rw [rankMerge_filter_c] at hm
    obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hm
    exact hx
  · right
    have hm : e ∈ (rankMerge key xs ys).filter (fun e => decide (e.1 = false)) :=
      List.mem_filter.mpr ⟨he, by simp [h]⟩
    rw [rankMerge_filter_d] at hm
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp hm
    exact hy

/-- A merge has the total length of the two lists. -/
theorem rankMerge_length (key : α → ℕ) :
    ∀ xs ys : List α, (rankMerge key xs ys).length = xs.length + ys.length
  | [], ys => by simp [rankMerge]
  | x :: xs, [] => by simp [rankMerge]
  | x :: xs, y :: ys => by
    unfold rankMerge
    split_ifs
    · rw [List.length_cons, rankMerge_length key xs (y :: ys)]
      simp only [List.length_cons]
      omega
    · rw [List.length_cons, rankMerge_length key (x :: xs) ys]
      simp only [List.length_cons]
      omega
termination_by xs ys => xs.length + ys.length

end RankMerge3

