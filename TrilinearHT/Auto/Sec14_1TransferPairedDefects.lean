open Classical in
/-- Blueprint lines 2252-2258 for one transfer step on the main columns: the step moves a filter
with pad masks `M` (monotone in the pad, consisting of present vertices, with neighbor closure)
of rank `r` from the complement slot `u` to helper projections of rank `r_H` on the identical masks
in the side slot `a`; the remaining other complement in slot `o` is a combination of pure sources
of present vertices with coefficient sum at most `C_o`. Then every far band pair `|p - q| > 2` of
the step has form at most `D √N_u S_v (2 β_H) S_o S_b + C_o (2 β_m) S_a S_b +
τ₂ S_v S_b C_o D √N_H S_a`, where `β_m`, `β_H` are the levels of the main and helper residuals and
`N_u`, `N_H` bound the labels of the masks. -/
theorem far_term_main {I : ℤ × ℤ} (hI : I ∈ A.cells) {a u o b : Fin 4} (hua : u ≠ a)
    (huo : u ≠ o) (hub : u ≠ b) (hao : a ≠ o) (hab : a ≠ b) (hob : o ≠ b)
    (catu : List (CatCol bf.Vtx))
    (hTu : ∀ e ∈ catu, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) u R γ e.birth e.rank e.tag)
    (htagu : ∀ e ∈ catu, bf.occAvail e.tag.2.1 e.tag.1)
    (cata : List (CatCol bf.Vtx))
    (hTa : ∀ e ∈ cata, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) a R γ e.birth e.rank e.tag)
    (htaga : ∀ e ∈ cata, bf.occAvail e.tag.2.1 e.tag.1)
    (r rH : ℕ) (M : Fin fp.P → bf.Vtx → Prop)
    (hMm : ∀ i j : Fin fp.P, i ≤ j → ∀ x, M i x → M j x)
    (hMn : ∀ (k : Fin fp.P) (hk : (k : ℕ) + 1 < fp.P) (w y : bf.Vtx), M k w →
      y ∈ bf.admT.X (bf.admAt I) →
      (bf.tagDist fp.Hed).d (bf.admT.depth (bf.admAt I)) w y ≤ 1 → M ⟨k + 1, hk⟩ y)
    (v xa : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {βm βH : ℝ} (hβm : 0 ≤ βm) (hβH : 0 ≤ βH)
    (hmain : ∀ k : Fin fp.P, CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag u (M k)
      (v - mainProj A.G fp.Mc (bf.origCols u) catu I r (M k) v) βm)
    (hhelp : ∀ k : Fin fp.P, CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag a (M k)
      (xa - mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k) xa) βH)
    {ι : Type*} (Fo : Finset ι) (co : ι → ℂ) (src : ι → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (tago : ι → bf.Vtx) (hpres : ∀ m ∈ Fo, tago m ∈ bf.admT.X (bf.admAt I))
    (hsrc : ∀ m ∈ Fo, ∃ Ay : QuadraticChartData (bf.vtag (tago m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc Ay ∧ IsBoundedQuadraticChart Ay ∧
      Ay.horizontal = (bf.vtag (tago m)).θ ∧ Ay.matrix = (slotCoeff o : ℚ) • (bf.vtag (tago m)).C ∧
      Ay.quadratic = slotCoeff o * (bf.vtag (tago m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = quadraticChartAtom Ay y)
    {Co : ℝ} (hCo : ∑ m ∈ Fo, ‖co m‖ ≤ Co)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ fp.Hed)
    (d : bf.Vtx) {Nu NH : ℝ}
    (hNu : ∀ k, ((mainLabelsM A.G fp.Mc (bf.origCols u) catu I r (M k) d).card : ℝ) ≤ Nu)
    (hNH : ∀ k, ((mainLabelsM A.G fp.Mc (bf.origCols a) cata I rH (M k) d).card : ℝ) ≤ NH)
    {p q : ℕ} (hp : p ≤ fp.P) (hq : q ≤ fp.P) (hfar : q + 2 < p ∨ p + 2 < q)
    (X : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc))
    (hXa : X a = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k))
        (p + 1) xa -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols a) cata I rH (M k)) p xa)
    (hXu : X u = padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) catu I r (M k))
        (q + 1) v -
      padFam (fun k : Fin fp.P => mainProj A.G fp.Mc (bf.origCols u) catu I r (M k)) q v)
    (hXo : X o = ∑ m ∈ Fo, co m • src m)
    {So Sa Sv Sb : ℝ} (hSo : 0 < So) (hSa : 0 < Sa) (hSv : 0 < Sv) (hSb : 0 < Sb)
    (hSa' : 2 * ‖xa‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSv' : 2 * ‖v‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sv)
    (hXo' : eLpNorm (augPhys (X o)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal So)
    (hXb : eLpNorm (augPhys (X b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖fp.Λc I X‖ ≤ A.colBudget * Real.sqrt Nu * Sv * ((βH + βH) * So * Sb) +
      (Co * ((βm + βm) * Sa * Sb) + τ₂ * Sv * Sb * Co * (A.colBudget * Real.sqrt NH * Sa)) := by
  have hNu0 : 0 ≤ Nu := le_trans (Nat.cast_nonneg _) (hNu ⟨0, fp.hP⟩)
  have hNH0 : 0 ≤ NH := le_trans (Nat.cast_nonneg _) (hNH ⟨0, fp.hP⟩)
  have hCo0 : 0 ≤ Co := le_trans (Finset.sum_nonneg fun _ _ => norm_nonneg _) hCo
  have hcb : (0 : ℝ) ≤ A.colBudget := by linarith [A.two_le_colBudget]
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  have hA : 0 ≤ A.colBudget * Real.sqrt Nu * Sv * ((βH + βH) * So * Sb) := by positivity
  have hB : 0 ≤ Co * ((βm + βm) * Sa * Sb) +
      τ₂ * Sv * Sb * Co * (A.colBudget * Real.sqrt NH * Sa) := by positivity
  rcases hfar with hpq | hpq
  · -- the helper band is higher
    have h := fp.far_helper_main hI hua huo hub hao hab hob catu hTu htagu r M hMm cata rH xa v
      hhelp hβH hpq hp X hXa hXu hSo hSb hXo' hXb d
    refine (h.trans ?_).trans (le_add_of_nonneg_right hB)
    have hs := Real.sqrt_le_sqrt (hNu ⟨q, by omega⟩)
    have hv : A.colBudget * Real.sqrt (mainLabelsM A.G fp.Mc (bf.origCols u) catu I r
        (M ⟨q, by omega⟩) d).card * (2 * ‖v‖) / Real.sqrt (dyadicGridLength A.G I.1) ≤
        A.colBudget * Real.sqrt Nu * Sv := by
      rw [mul_div_assoc]
      exact mul_le_mul (mul_le_mul_of_nonneg_left hs hcb) hSv' (by positivity) (by positivity)
    exact mul_le_mul_of_nonneg_right hv (by positivity)
  · -- the complement band is higher
    have hpP : p + 1 < fp.P := by omega
    set Ys : ι → ℝ → ℂ := fun m => if h : m ∈ Fo then quadraticChartAtom (hsrc m h).choose else 0
    have hYs_eq : ∀ m (h : m ∈ Fo), Ys m = quadraticChartAtom (hsrc m h).choose := fun m h =>
      dite_eq_left_of_eq_true (eq_true h)
    have hsrc' : ∀ m ∈ Fo, ∃ A' : QuadraticChartData (bf.vtag (tago m)).dim,
        QuadraticChartComplexity A.csrc A.Hsrc A' ∧ A'.horizontal = (bf.vtag (tago m)).θ ∧
        A'.matrix = (slotCoeff o : ℚ) • (bf.vtag (tago m)).C ∧
        A'.quadratic = slotCoeff o * (bf.vtag (tago m)).lam ∧
        ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
          augPhys (src m) y = quadraticChartAtom A' y := fun m hm => by
      obtain ⟨Ay, h1, -, h3, h4, h5, h6⟩ := hsrc m hm
      exact ⟨Ay, h1, h3, h4, h5, h6⟩
    have hYs : ∀ m ∈ Fo, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (src m) y = Ys m y := fun m hm => by
      rw [hYs_eq m hm]
      exact (hsrc m hm).choose_spec.2.2.2.2.2
    -- the helper columns of the lower band and their charts
    set Fa := mainLabelsM A.G fp.Mc (bf.origCols a) cata I rH (M ⟨p, by omega⟩) d
    have hlab := fun n (hn : n ∈ Fa) =>
      bf.mainLabel_source a cata hTa htaga I rH (M ⟨p, by omega⟩) d hn
    set Yh : bf.Lab ⊕ Fin fp.Mc → ℝ → ℂ := fun n =>
      if h : n ∈ Fa then quadraticChartAtom (hlab n h).2.choose else 0
    have hYh_eq : ∀ n (h : n ∈ Fa), Yh n = quadraticChartAtom (hlab n h).2.choose := fun n h =>
      dite_eq_left_of_eq_true (eq_true h)
    have hYh : ∀ n ∈ Fa, ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (mainCol A.G fp.Mc (bf.origCols a) cata I n) y = Yh n y := fun n hn => by
      rw [hYh_eq n hn]
      exact (hlab n hn).2.choose_spec.2.2.2.2.2
    set near : ι → Prop := fun m => ∃ w, M ⟨p, by omega⟩ w ∧
      (bf.tagDist fp.Hed).d (bf.admT.depth (bf.admAt I)) w (tago m) ≤ 1
    have hnear : ∀ m ∈ Fo, near m → ∀ k : Fin fp.P, q - 1 ≤ k → M k (tago m) := by
      intro m hm ⟨w, hw, hd⟩ k hk
      have h1 := hMn ⟨p, by omega⟩ hpP w (tago m) hw (hpres m hm) hd
      exact hMm _ _ (Fin.mk_le_mk.mpr (by simp only at hk ⊢; omega)) _ h1
    have hfar' : ∀ m ∈ Fo, ¬ near m → ∀ n ∈ Fa,
        PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) o a (Ys m)
          (Yh n) τ₂ := by
      intro m hm hnm n hn
      have hMw := (hlab n hn).1
      have hfd : ¬ (bf.tagDist fp.Hed).d (bf.admT.depth (bf.admAt I)) (tago m)
          (labelTag (bf.origCols a) cata I d n) ≤ 1 := fun hd' => hnm ⟨_, hMw, by
        rw [(bf.tagDist fp.Hed).symm]; exact hd'⟩
      obtain ⟨h1, h2, h3, h4, h5, -⟩ := (hsrc m hm).choose_spec
      obtain ⟨g1, g2, g3, g4, g5, -⟩ := (hlab n hn).2.choose_spec
      rw [hYs_eq m hm, hYh_eq n hn]
      exact fp.far_pair_main hI hao.symm hfd (hsrc m hm).choose h1 h2 h3 h4 h5
        (hlab n hn).2.choose g1 g2 g3 g4 g5 hτ₂ hτ₂1 hHed
    have h := fp.far_main_main hI hua huo hub hao hab hob catu r M hMm v hmain hβm cata rH xa Fo
      co src tago Ys hsrc' hYs hpq hq near hnear d Yh hYh hτ₂.le hfar' X hXa hXu hXo hSa hSv hSb
      hSa' hSv' hXb
    refine (h.trans ?_).trans (le_add_of_nonneg_left hA)
    have hs := Real.sqrt_le_sqrt (hNH ⟨p, by omega⟩)
    gcongr

