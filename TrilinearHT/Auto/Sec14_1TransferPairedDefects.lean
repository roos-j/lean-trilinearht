variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-! ### Sources of the other complement (blueprint lines 2254-2255) -/

open Classical in
/-- Blueprint line 2254 ("expand instead the lower-rank primal source in position `d`"), for an
outer positive filter: the averaged catalog filter of a slot, with masks of present vertices, is a
combination of pure sources of the slot whose tags lie in the masks, with coefficients at most
`‖x‖ / √|I|` (private-coordinate recovery). -/
theorem outer_filter_sources (cat : Fin 4 → List (CatCol A.Vtx)) (o : Fin 4)
    (hT : ∀ d ∈ cat o, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) o R γ d.birth d.rank d.tag)
    (I : ℤ × ℤ) (r : ℕ) (M : Fin ap.P → A.Vtx → Prop)
    (hM : ∀ p x, M p x → x ∈ A.admT.X (A.admAt I)) (x : ColumnL2 (Fin ap.Mc)) :
    ∃ co : Fin ap.Mc → ℂ,
      ∑ n ∈ catLabels A.G ap.Mc (cat o) I r (fun y => ∃ p, M p y), ‖co n‖ ≤
        Real.sqrt (catLabels A.G ap.Mc (cat o) I r (fun y => ∃ p, M p y)).card *
          (‖x‖ / Real.sqrt (dyadicGridLength A.G I.1)) ∧
      opAvg (fun p => catProj A.G ap.Mc (cat o) I r (M p)) x =
        ∑ n ∈ catLabels A.G ap.Mc (cat o) I r (fun y => ∃ p, M p y),
          co n • fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom (cat o) n) n ∧
      ∀ n ∈ catLabels A.G ap.Mc (cat o) I r (fun y => ∃ p, M p y), ∃ y : A.Vtx,
        (∃ p, M p y) ∧ (ap.filters cat I).IsSource A.csrc A.Hsrc A.vtag o y
          (fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom (cat o) n) n) := by
  obtain ⟨co, -, he⟩ := opAvg_catProj_l2 (G := A.G) (cat o) I r M
    (fun y => ∃ p, M p y) (fun p y h => ⟨p, h⟩) x
  have hco := catCoeff_l1_le (G := A.G) (cat o) I
    (catLabels A.G ap.Mc (cat o) I r (fun y => ∃ p, M p y)) co
  rw [← he] at hco
  refine ⟨co, hco.trans (mul_le_mul_of_nonneg_left (div_le_div_of_nonneg_right
    (norm_opAvg_apply_le _ (fun _ y => norm_catProj_le _ _ _ _ _ _ y) x) (Real.sqrt_nonneg _))
      (Real.sqrt_nonneg _)), he, fun n hn => ?_⟩
  obtain ⟨y, hy, hs⟩ := ap.catColumn_source cat o hT I (fun y ⟨p, hp⟩ => hM p y hp) hn
  exact ⟨y, hy, hs⟩

/-- Blueprint line 2254 ("using its basic columns when it is unfiltered"): the basic argument of a
slot on a cell is a combination, with coefficients at most `D_c`, of pure sources of the slot
whose vertices are present at the cell. -/
theorem basic_sources (cat : Fin 4 → List (CatCol A.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    (o : Fin 4) :
    physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.B o I)) =
        ∑ v ∈ Finset.univ.filter (fun v => A.coef o I v ≠ 0),
          A.coef o I v • physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.φ I v)) ∧
      ∀ v ∈ Finset.univ.filter (fun v => A.coef o I v ≠ 0),
        ‖A.coef o I v‖ ≤ A.Dc ∧ A.basicVtx hI o v ∈ A.admT.X (A.admAt I) ∧
        (ap.filters cat I).IsSource A.csrc A.Hsrc A.vtag o (A.basicVtx hI o v)
          (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.φ I v))) := by
  refine ⟨A.basic_expansion ap.Mc I o, fun v hv => ?_⟩
  have hv' := (Finset.mem_filter.mp hv).2
  exact ⟨A.coef_le o I v, A.basicVtx_mem hI hv', A.basic_source ap cat hI hv'⟩

/-! ### Near and far tags of the far-band sources (blueprint lines 1805, 2254-2256) -/

open Classical in
/-- Blueprint line 2256 ("cumulative masks have neighbor closure by the triangle inequality"):
a present vertex within one edge of the pad-`p` cumulative mask lies in the pad-`(p+1)` mask. -/
theorem near_cmask {I : ℤ × ℤ} {m p : ℕ} {w y : A.Vtx} (hw : ap.cmask I m p w)
    (hy : y ∈ A.admT.X (A.admAt I))
    (hd : (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) w y ≤ 1) :
    ap.cmask I m (p + 1) y :=
  ColorSetup.cumMask_neighbor (K := ap.K) hw hy hd

open Classical in
/-- Blueprint line 2256 ("ball masks have it at actual uses by Lemma masks"): for a successful
current group, a present vertex within one edge of the pad-`p` ball mask lies in the pad-`(p+1)`
ball mask, below the maximal pad. -/
theorem near_bmask {I : ℤ × ℤ} {G : A.Grp}
    (hG : ∃ v ∈ A.admT.X (A.admAt I), ap.K.Success (ap.K.colorData (A.admT.st (A.admAt I)) v) ∧
      ap.K.grp A.admT A.vtxBound (A.admAt I) v = G)
    {j p : ℕ} (hjp : ap.bbase j + p + 1 < ap.Hmax) {w y : A.Vtx} (hw : ap.bmask I G j p w)
    (hy : y ∈ A.admT.X (A.admAt I))
    (hd : (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) w y ≤ 1) :
    ap.bmask I G j (p + 1) y := by
  obtain ⟨v, hv, hs, rfl⟩ := hG
  have h := (A.masks ap.Hed ap.Hmax ap.ωp ap.ωh).2.1 (A.admAt I) v hv hs
    (ap.bbase j + p + 1) hjp w y hw hy hd
  exact h

/-- Blueprint lines 2255-2256 ("for a far source ... use the different-tag pair estimate"): a pure
source of a present vertex in slot `o`, with a bounded chart, is pair-separated (`PairSmall` with
`τ₂`) in the slots `o, a` from a template column of slot `a` whose present tag is more than one
edge away. -/
theorem far_pair {I : ℤ × ℤ} (hI : I ∈ A.cells) {o a : Fin 4} (hoa : o ≠ a) {y : A.Vtx}
    (Ay : QuadraticChartData (A.vtag y).dim) (hAy : QuadraticChartComplexity A.csrc A.Hsrc Ay)
    (hAb : IsBoundedQuadraticChart Ay) (hθ : Ay.horizontal = (A.vtag y).θ)
    (hM : Ay.matrix = (slotCoeff o : ℚ) • (A.vtag y).C)
    (hq : Ay.quadratic = slotCoeff o * (A.vtag y).lam)
    (cat : List (CatCol A.Vtx))
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) a R γ d.birth d.rank d.tag)
    {n : Fin ap.Mc} (hnl : (n : ℕ) < cat.length)
    (hw : (cat[(n : ℕ)]).tag ∈ A.admT.X (A.admAt I))
    (hfar : ¬ (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) (cat[(n : ℕ)]).tag y ≤ 1)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ ap.Hed) :
    PairSmall (dyadicGridLeft A.G I.1 I.2) (dyadicGridLength A.G I.1) (A.w I) o a
      (quadraticChartAtom Ay) (catAtom cat n) τ₂ := by
  set x := (cat[(n : ℕ)]).tag
  have hav : A.occAvail x.2.1 x.1 := A.occAvail_of_mem hw
  obtain ⟨A', hA', hA'b, hθ', hM', hq', he⟩ := catAtom_chart cat a hT hnl hav
  rw [he]
  have hfar' : ¬ (A.tagDist ap.Hed).d (A.admT.depth (A.admAt I)) y x ≤ 1 := by
    rwa [(A.tagDist ap.Hed).symm]
  have hnE := A.not_tagEdge_of_dist ap.Hed hfar'
  rw [A.depth_admAt hI] at hnE
  obtain ⟨b₁, b₂, hb, hb₁o, hb₁a, hb₂o, hb₂a, -⟩ := fin4_other_two o a hoa
  exact A.Dg_sep A.Hsrc τ₂ A.exp_two_le_Hsrc hτ₂ hτ₂1 (A.vtag y) (A.vtag x)
    hb₁o hb₁a hb hoa hb₂o.symm hb₂a.symm (A.vchart_dim y) (A.vchart_dim x) Ay A'
    (quadraticChartComplexity_mono_order hAy (by omega))
    (quadraticChartComplexity_mono_order hA' (by omega)) hAb hA'b hθ hM hq hθ' hM' hq'
    (dyadicGridLength_pos A.G I.1) (A.adm I hI) (fun hE => hnE (tagEdge_mono hE hHed))

end AttemptParams

