/-- The square integrable correction of the full argument `Y` over the basic argument. -/
theorem Y_corr_memLp (I : ℤ × ℤ) (c : Fin 4) :
    MemLp (if c = A.a ∨ c = A.b then A.U c I else 0) 2 (A.μ I) := by
  split_ifs
  · exact A.U_L2 c I
  · exact MemLp.zero

/-- Blueprint line 2262 (restoration corrections): on a basic slot the restored full argument `Y`
differs from the base input by the physical embedding of a `U` side, so the restriction of the
difference has square at most `|I| ‖U‖²`. -/
theorem restore_cell (I : ℤ × ℤ) (c : Fin 4) (hz : ap.z I c = A.B c I) :
    ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.Y I c)) -
        physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ ^ 2 ≤
      dyadicGridLength A.G I.1 * (eLpNorm (A.U c I) 2 (A.μ I)).toReal ^ 2 := by
  have hL := dyadicGridLength_pos A.G I.1
  have hY : A.Y I c = A.B c I + (if c = A.a ∨ c = A.b then A.U c I else 0) := rfl
  have hb : ap.base I c = cellLp A.G I (A.B c I) := by unfold base; rw [hz]
  rw [hY, hb, cellLp_add (A.B_memLp c I) (Y_corr_memLp I c), physicalColumnInput_add,
    add_sub_cancel_left]
  have hV : (eLpNorm (if c = A.a ∨ c = A.b then A.U c I else 0) 2 (A.μ I)).toReal ≤
      (eLpNorm (A.U c I) 2 (A.μ I)).toReal := by
    split_ifs
    · exact le_rfl
    · simp
  have h := norm_cellLp_div_le (Mc := ap.Mc) (Y_corr_memLp I c) ENNReal.toReal_nonneg hV
  rw [div_le_iff₀ (Real.sqrt_pos.mpr hL)] at h
  have h2 := columnL2Restriction_norm_sq_le (dyadicGridCell A.G I.1 I.2)
    (dyadicGridCell_measurable A.G I.1 I.2)
    (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (if c = A.a ∨ c = A.b then A.U c I else 0)))
  refine h2.trans ?_
  calc ‖physicalColumnInput (V := Fin ap.Mc)
        (cellLp A.G I (if c = A.a ∨ c = A.b then A.U c I else 0))‖ ^ 2
      ≤ ((eLpNorm (A.U c I) 2 (A.μ I)).toReal * Real.sqrt (dyadicGridLength A.G I.1)) ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) h 2
    _ = _ := by rw [mul_pow, Real.sq_sqrt hL.le]; ring

/-- The normalized restricted size of the physical embedding of a cell input is at most its
normalized `L²` size. -/
theorem restr_cellLp_le (I : ℤ × ℤ) {f : ℝ → ℂ} (hf : MemLp f 2 (A.μ I)) {S : ℝ} (hS : 0 ≤ S)
    (hfS : (eLpNorm f 2 (A.μ I)).toReal ≤ S) :
    ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I f))‖ /
        Real.sqrt (dyadicGridLength A.G I.1) ≤ S :=
  (div_le_div_of_nonneg_right ((pow_le_pow_iff_left₀ (norm_nonneg _) (norm_nonneg _)
    two_ne_zero).mp (columnL2Restriction_norm_sq_le _ _ _)) (Real.sqrt_nonneg _)).trans
    (norm_cellLp_div_le hf hS hfS)

/-- The sizes in the restoration factor (`hy` of `leaf_two_two_bound`): with `‖Y‖ ≤ 2` and
`‖U‖ ≤ 2`, the full arguments and the basic inputs of basic slots have normalized restricted sizes
at most `4`. -/
theorem restore_sizes (I : ℤ × ℤ) (hY : ∀ l, (eLpNorm (A.Y I l) 2 (A.μ I)).toReal ≤ 2)
    (hU : ∀ l, (eLpNorm (A.U l I) 2 (A.μ I)).toReal ≤ 2) (c d : Fin 4)
    (hz : ap.z I c = A.B c I) :
    ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.Y I d)))‖ /
        Real.sqrt (dyadicGridLength A.G I.1) ≤ 4 ∧
    ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
      (physicalColumnInput (V := Fin ap.Mc) (ap.base I c))‖ /
        Real.sqrt (dyadicGridLength A.G I.1) ≤ 4 := by
  have hYm : ∀ l, MemLp (A.Y I l) 2 (A.μ I) := fun l =>
    (A.B_memLp l I).add (Y_corr_memLp I l)
  refine ⟨(ap.restr_cellLp_le I (hYm d) (by norm_num) (hY d)).trans (by norm_num), ?_⟩
  have hL := dyadicGridLength_pos A.G I.1
  have hs := Real.sqrt_pos.mpr hL
  have hb : ap.base I c = cellLp A.G I (A.B c I) := by unfold base; rw [hz]
  have hsum : cellLp A.G I (A.Y I c) = cellLp A.G I (A.B c I) +
      cellLp A.G I (if c = A.a ∨ c = A.b then A.U c I else 0) :=
    cellLp_add (A.B_memLp c I) (Y_corr_memLp I c)
  have hV : (eLpNorm (if c = A.a ∨ c = A.b then A.U c I else 0) 2 (A.μ I)).toReal ≤ 2 := by
    split_ifs
    · exact hU c
    · simp
  have e : physicalColumnInput (V := Fin ap.Mc) (ap.base I c) =
      physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.Y I c)) -
        physicalColumnInput (V := Fin ap.Mc)
          (cellLp A.G I (if c = A.a ∨ c = A.b then A.U c I else 0)) := by
    rw [hb, hsum, physicalColumnInput_add, add_sub_cancel_right]
  rw [e, map_sub]
  have h1 := ap.restr_cellLp_le I (hYm c) (by norm_num) (hY c)
  have h2 := ap.restr_cellLp_le I (Y_corr_memLp I c) (by norm_num) hV
  calc _ ≤ (‖columnL2Restriction (dyadicGridCell A.G I.1 I.2)
        (dyadicGridCell_measurable A.G I.1 I.2)
        (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.Y I c)))‖ +
      ‖columnL2Restriction (dyadicGridCell A.G I.1 I.2) (dyadicGridCell_measurable A.G I.1 I.2)
        (physicalColumnInput (V := Fin ap.Mc)
          (cellLp A.G I (if c = A.a ∨ c = A.b then A.U c I else 0)))‖) /
        Real.sqrt (dyadicGridLength A.G I.1) :=
        div_le_div_of_nonneg_right (norm_sub_le _ _) hs.le
    _ = _ := add_div _ _ _
    _ ≤ 2 + 2 := add_le_add h1 h2
    _ = 4 := by norm_num

