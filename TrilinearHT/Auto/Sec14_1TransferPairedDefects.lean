section RankMerge
variable {α : Type*}

/-! ### Rank-ordered transfer steps (blueprint lines 2240-2252) -/

/-- Blueprint line 2241 ("in each product remove the larger rank among the two current outermost
positive filters"): the merge of the filter lists of the two complement slots (outermost first),
taking at each step the outermost filter of larger rank (`true` for slot `c`, `false` for `d`). -/
def rankMerge (key : α → ℕ) : List α → List α → List (Bool × α)
  | [], ys => ys.map fun y => (false, y)
  | x :: xs, [] => (x :: xs).map fun x => (true, x)
  | x :: xs, y :: ys =>
      if key y < key x then (true, x) :: rankMerge key xs (y :: ys)
      else (false, y) :: rankMerge key (x :: xs) ys
termination_by xs ys => xs.length + ys.length

/-- The `true` entries of a merge are the first list. -/
theorem rankMerge_filter_true (key : α → ℕ) :
    ∀ xs ys : List α, ((rankMerge key xs ys).filter fun e => e.1).map Prod.snd = xs
  | [], ys => by simp [rankMerge]
  | x :: xs, [] => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, y :: ys => by
    unfold rankMerge
    split_ifs
    · simp only [List.filter_cons_of_pos, List.map_cons]
      rw [rankMerge_filter_true key xs (y :: ys)]
    · rw [List.filter_cons_of_neg (by simp)]
      exact rankMerge_filter_true key (x :: xs) ys
termination_by xs ys => xs.length + ys.length

/-- The `false` entries of a merge are the second list. -/
theorem rankMerge_filter_false (key : α → ℕ) :
    ∀ xs ys : List α, ((rankMerge key xs ys).filter fun e => !e.1).map Prod.snd = ys
  | [], ys => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, [] => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, y :: ys => by
    unfold rankMerge
    split_ifs
    · rw [List.filter_cons_of_neg (by simp)]
      exact rankMerge_filter_false key xs (y :: ys)
    · simp only [List.filter_cons_of_pos, List.map_cons, Bool.not_false]
      rw [rankMerge_filter_false key (x :: xs) ys]
termination_by xs ys => xs.length + ys.length

end RankMerge

section ApplyAll
variable {E : Type*} [AddCommGroup E] [Module ℂ E]

/-- The composition of a list of operators, outermost first. -/
def applyAll : List (E →ₗ[ℂ] E) → E → E
  | [], y => y
  | T :: Ts, y => T (applyAll Ts y)

/-- The complement value of a slot depends only on the steps of that slot. -/
theorem chainVal_eq_applyAll (P : ℕ) (v : Bool) :
    ∀ steps : List (TransferStep E), ∀ y : E,
      chainVal P v steps y =
        applyAll ((steps.filter fun st => st.1 = v).map fun st => filterAvg P st.2.2) y
  | [], y => rfl
  | st :: rest, y => by
    by_cases h : st.1 = v
    · rw [chainVal, ite_eq_left_of_eq_true _ _ (eq_true h),
        List.filter_cons_of_pos (by simpa using h), List.map_cons, applyAll,
        chainVal_eq_applyAll P v rest y]
    · rw [chainVal, ite_eq_right_of_eq_false _ _ (eq_false h),
        List.filter_cons_of_neg (by simpa using h), chainVal_eq_applyAll P v rest y]

end ApplyAll

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The positive filters of slot `l` of the leaf `s` at the cell `I` for the group `G` along the
positive chain `t` (outermost first): the ball filter, then the cumulative layers of the chain,
each as its catalog rank and its pad masks. -/
def slotFilt (s : ℕ) (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t : List ℕ) :
    List (ℕ × (Fin ap.P → A.Vtx → Prop)) :=
  (ap.leafR s l, fun p => ap.bmask I G (ap.leafJ s l) p) ::
    t.map fun m => (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p)

/-- The transfer step of a merged filter: helper pads of rank `r_H` on the helper catalog and
catalog pads of the filter rank on the catalog of its slot (`c` for `true`, `d` for `false`). -/
noncomputable def toStep (catc catd hcat : List (CatCol A.Vtx)) (rH : ℕ) (I : ℤ × ℤ)
    (e : Bool × (ℕ × (Fin ap.P → A.Vtx → Prop))) :
    Bool × (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) ×
      (Fin ap.P → ColumnL2 (Fin ap.Mc) →L[ℂ] ColumnL2 (Fin ap.Mc)) :=
  (e.1, fun p => catProj A.G ap.Mc hcat I rH (e.2.2 p),
    fun p => catProj A.G ap.Mc (if e.1 then catc else catd) I e.2.1 (e.2.2 p))

/-- The cumulative layers of a positive chain are the averages of their pad families. -/
theorem applyAll_cum (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ) :
    ∀ (t : List ℕ) (y : ColumnL2 (Fin ap.Mc)),
      applyAll ((t.map fun m => (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p)).map
        fun f : ℕ × (Fin ap.P → A.Vtx → Prop) => filterAvg ap.P
          (padFam fun p => catProj A.G ap.Mc cat I f.1 (f.2 p))) y =
        chainOp (ap.cumAt cat I) t y
  | [], y => rfl
  | m :: t, y => by
    simp only [List.map_cons, applyAll]
    rw [applyAll_cum cat I t y, filterAvg_padFam]
    rfl

/-- The filters of a slot along a positive chain compose to the ball filter of the chain output. -/
theorem applyAll_slotFilt (cat : List (CatCol A.Vtx)) (s : ℕ) (l : Fin 4) (G : A.Grp)
    (I : ℤ × ℤ) (t : List ℕ) (y : ColumnL2 (Fin ap.Mc)) :
    applyAll ((ap.slotFilt s l G I t).map fun f => filterAvg ap.P
        (padFam fun p => catProj A.G ap.Mc cat I f.1 (f.2 p))) y =
      ap.ballAt cat (ap.leafR s l) (ap.leafJ s l) G I (chainOp (ap.cumAt cat I) t y) := by
  unfold slotFilt
  rw [List.map_cons, applyAll, List.map_map]
  have h := ap.applyAll_cum cat I t y
  rw [List.map_map] at h
  rw [h, ap.ballAt_eq_filterAvg]

end AttemptParams

end ActiveSetup

section RankMerge2
variable {α : Type*}

/-- The `c` entries of a merge, as steps. -/
theorem rankMerge_filter_c (key : α → ℕ) :
    ∀ xs ys : List α, (rankMerge key xs ys).filter (fun e => decide (e.1 = true)) =
      xs.map fun x => (true, x)
  | [], ys => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, [] => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, y :: ys => by
    unfold rankMerge
    split_ifs
    · rw [List.filter_cons_of_pos (by simp), rankMerge_filter_c key xs (y :: ys), List.map_cons]
    · rw [List.filter_cons_of_neg (by simp)]
      exact rankMerge_filter_c key (x :: xs) ys
termination_by xs ys => xs.length + ys.length

/-- The `d` entries of a merge, as steps. -/
theorem rankMerge_filter_d (key : α → ℕ) :
    ∀ xs ys : List α, (rankMerge key xs ys).filter (fun e => decide (e.1 = false)) =
      ys.map fun y => (false, y)
  | [], ys => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, [] => by simp [rankMerge, List.filter_map, Function.comp_def]
  | x :: xs, y :: ys => by
    unfold rankMerge
    split_ifs
    · rw [List.filter_cons_of_neg (by simp)]
      exact rankMerge_filter_d key xs (y :: ys)
    · rw [List.filter_cons_of_pos (by simp), rankMerge_filter_d key (x :: xs) ys, List.map_cons]
termination_by xs ys => xs.length + ys.length

end RankMerge2

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-- The transfer steps of a pair of positive chains `t` (slot `c`) and `t'` (slot `d`): the merged
slot filters, larger rank first, as pad-family steps. -/
noncomputable def chainSteps (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) :
    List (TransferStep (ColumnL2 (Fin ap.Mc))) :=
  ((rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).map
    (ap.toStep (cat c) (cat d) hcat rH I)).map
      fun st => (st.1, padFam st.2.1, padFam st.2.2)

/-- The slot `c` value of the chain steps is the ball filter of the chain output. -/
theorem chainVal_chainSteps_c (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) (y : ColumnL2 (Fin ap.Mc)) :
    chainVal ap.P true (ap.chainSteps cat hcat rH s c d G I t t') y =
      ap.ballAt (cat c) (ap.leafR s c) (ap.leafJ s c) G I (chainOp (ap.cumAt (cat c) I) t y) := by
  rw [chainVal_eq_applyAll, ← ap.applyAll_slotFilt]
  unfold chainSteps
  rw [List.filter_map, List.filter_map, List.map_map, List.map_map]
  have h := rankMerge_filter_c Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')
  have e : ((rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).filter
      (((fun st : TransferStep (ColumnL2 (Fin ap.Mc)) => decide (st.1 = true)) ∘
        (fun st => (st.1, padFam st.2.1, padFam st.2.2))) ∘
          ap.toStep (cat c) (cat d) hcat rH I)) =
      (rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).filter
        (fun e => decide (e.1 = true)) := by
    congr 1
  rw [e, h, List.map_map]
  rfl

/-- The slot `d` value of the chain steps is the ball filter of the chain output. -/
theorem chainVal_chainSteps_d (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t t' : List ℕ) (y : ColumnL2 (Fin ap.Mc)) :
    chainVal ap.P false (ap.chainSteps cat hcat rH s c d G I t t') y =
      ap.ballAt (cat d) (ap.leafR s d) (ap.leafJ s d) G I (chainOp (ap.cumAt (cat d) I) t' y) := by
  rw [chainVal_eq_applyAll, ← ap.applyAll_slotFilt]
  unfold chainSteps
  rw [List.filter_map, List.filter_map, List.map_map, List.map_map]
  have h := rankMerge_filter_d Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')
  have e : ((rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).filter
      (((fun st : TransferStep (ColumnL2 (Fin ap.Mc)) => decide (st.1 = false)) ∘
        (fun st => (st.1, padFam st.2.1, padFam st.2.2))) ∘
          ap.toStep (cat c) (cat d) hcat rH I)) =
      (rankMerge Prod.fst (ap.slotFilt s c G I t) (ap.slotFilt s d G I t')).filter
        (fun e => decide (e.1 = false)) := by
    congr 1
  rw [e, h, List.map_map]
  rfl

/-- Blueprint lines 2240-2252 (transfer and its paired defects) on a leaf at one cell and group:
with sides in slots `a, b` and whole leaf outputs in slots `c, d`, the form is the signed sum over
the pairs of positive chains of the two complement histories of the transferred main term (helper
averages on the side `a`, the bases in `c, d`) plus the band defects of the rank-ordered steps. -/
theorem leaf_restored_transfer (cat : Fin 4 → List (CatCol A.Vtx)) (hcat : List (CatCol A.Vtx))
    (rH s : ℕ) {a c d : Fin 4} (hac : a ≠ c) (had : a ≠ d) (hcd : c ≠ d) (G : A.Grp)
    (I : ℤ × ℤ) (x : Fin 4 → ColumnL2 (Fin ap.Mc)) :
    ap.Λc I (Function.update (Function.update x c (ap.leafOut cat s I c G)) d
        (ap.leafOut cat s I d G)) =
      ((posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers d).reverse).map fun t' =>
        ((posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers c).reverse).map fun t =>
          ((t.1 : ℂ) * t'.1) *
            (ap.Λc I (Function.update (Function.update (Function.update x c
                (physicalColumnInput (ap.base I c))) d (physicalColumnInput (ap.base I d))) a
                  (chainSide ap.P (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a))) +
              chainDefect (ap.Λc I) ap.P a c d x (physicalColumnInput (ap.base I c))
                (physicalColumnInput (ap.base I d))
                (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (x a))).sum).sum := by
  unfold leafOut leafIn
  rw [form_layer_chains (ap.Λc I) hcd x]
  refine congrArg List.sum (List.map_congr_left fun t' _ => ?_)
  refine congrArg List.sum (List.map_congr_left fun t _ => ?_)
  congr 1
  rw [← ap.chainVal_chainSteps_c cat hcat rH s c d G I t.2 t'.2,
    ← ap.chainVal_chainSteps_d cat hcat rH s c d G I t.2 t'.2]
  have hxa : Function.update (Function.update x c (chainVal ap.P true
      (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (physicalColumnInput (ap.base I c)))) d
        (chainVal ap.P false (ap.chainSteps cat hcat rH s c d G I t.2 t'.2)
          (physicalColumnInput (ap.base I d))) =
      Function.update (Function.update (Function.update x c (chainVal ap.P true
        (ap.chainSteps cat hcat rH s c d G I t.2 t'.2) (physicalColumnInput (ap.base I c)))) d
          (chainVal ap.P false (ap.chainSteps cat hcat rH s c d G I t.2 t'.2)
            (physicalColumnInput (ap.base I d)))) a (x a) := by
    symm
    rw [Function.update_eq_self_iff, Function.update_of_ne had, Function.update_of_ne hac]
  rw [hxa]
  exact pad_transfer_chain (ap.Λc I) ap.hP hac had hcd x _ _
    ((rankMerge Prod.fst (ap.slotFilt s c G I t.2) (ap.slotFilt s d G I t'.2)).map
      (ap.toStep (cat c) (cat d) hcat rH I)) (x a)

/-- Blueprint lines 2261-2262 ("restoring `B_c, B_d` to `Y_c, Y_d`; each correction has an
additional basic side `U`"), at one cell: with `z = Y - V` in two slots, the form is the form of
the full pair minus the two corrections carrying `V_c` or `V_d`. -/
theorem Λc_restore {I : ℤ × ℤ} {c d : Fin 4} (hcd : c ≠ d) (X : Fin 4 → ColumnL2 (Fin ap.Mc))
    (Yc Yd Vc Vd : ColumnL2 (Fin ap.Mc)) :
    ap.Λc I (Function.update (Function.update X c (Yc - Vc)) d (Yd - Vd)) =
      ap.Λc I (Function.update (Function.update X c Yc) d Yd) -
        ap.Λc I (Function.update (Function.update X c Vc) d Yd) -
        ap.Λc I (Function.update (Function.update X c (Yc - Vc)) d Vd) := by
  rw [(ap.Λc I).map_update_sub, Function.update_comm hcd, (ap.Λc I).map_update_sub,
    Function.update_comm hcd.symm]
  rw [← Function.update_comm hcd Vc Yd X]

