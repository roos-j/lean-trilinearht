open Classical in
/-- `chain_passM` with the target rank `R`, `1 ≤ R ≤ L + 5`. -/
theorem chain_passR (l : Fin 4) (s : List (CatCol bf.Vtx)) {I : ℤ × ℤ} (hI : I ∈ A.cells)
    (z : ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) {τ : ℕ → ℝ}
    (hpass : ∀ w : fp.TestName I Unit, (fp.testOf l I (fun _ => z) w).Pass A.G (bf.origCols l) I
      A.csrc A.Hsrc bf.vtag (A.w I) (τ (fp.testOf l I (fun _ => z) w).r) fp.mH s)
    (ch : List ℕ) (hch : ∀ m ∈ ch, m ≤ fp.Lc) (hlen : ch.length ≤ fp.mH)
    {R : ℕ} (hR1 : 1 ≤ R) (hR : R ≤ fp.Lc + 5) (Mt : fp.MaskName I) :
    CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag l (fp.maskOf I Mt)
      (chainOp (fun m => fp.cumFilt l s I m) ch z -
        mainProj A.G fp.Mc (bf.origCols l) s I R (fp.maskOf I Mt)
          (chainOp (fun m => fp.cumFilt l s I m) ch z))
      (τ R * cellNorm A.G I z) := by
  obtain ⟨R', rfl⟩ : ∃ R', R = R' + 1 := ⟨R - 1, by omega⟩
  exact fp.chain_passM l s hI z hpass ch hch hlen ⟨R', by omega⟩ Mt

/-- The far step bound with canceled thresholds: if the helper threshold cancels the main
expansion of the removed filter, the main threshold of the removed rank cancels the expansion of
the strictly lower-rank other complement, and `τ₂` absorbs the pair-mismatch budgets, the step
bound is at most `8 τ₃ S_z² S_a S_b`. -/
theorem far_numeric {X1 X2 X3 Sz Sa Sb τH τf τ₂ τ₃ : ℝ} (hSa : 0 ≤ Sa) (hSb : 0 ≤ Sb)
    (h1 : τH * X1 ≤ τ₃) (h2 : τf * X2 ≤ τ₃) (h3 : τ₂ * (X2 * X3) ≤ τ₃) :
    X1 * (2 * Sz) * ((τH * Sa + τH * Sa) * Sz * Sb) +
      (X2 * Sz * ((τf * Sz + τf * Sz) * Sa * Sb) +
        τ₂ * (2 * Sz) * Sb * (X2 * Sz) * (X3 * Sa)) ≤ 8 * τ₃ * Sz ^ 2 * Sa * Sb := by
  have hP : 0 ≤ Sz ^ 2 * Sa * Sb := by positivity
  have e : X1 * (2 * Sz) * ((τH * Sa + τH * Sa) * Sz * Sb) +
      (X2 * Sz * ((τf * Sz + τf * Sz) * Sa * Sb) +
        τ₂ * (2 * Sz) * Sb * (X2 * Sz) * (X3 * Sa)) =
      4 * ((τH * X1) * (Sz ^ 2 * Sa * Sb)) + 2 * ((τf * X2) * (Sz ^ 2 * Sa * Sb)) +
        2 * ((τ₂ * (X2 * X3)) * (Sz ^ 2 * Sa * Sb)) := by ring
  rw [e]
  have g1 := mul_le_mul_of_nonneg_right h1 hP
  have g2 := mul_le_mul_of_nonneg_right h2 hP
  have g3 := mul_le_mul_of_nonneg_right h3 hP
  have e2 : 8 * τ₃ * Sz ^ 2 * Sa * Sb = 8 * (τ₃ * (Sz ^ 2 * Sa * Sb)) := by ring
  rw [e2]
  linarith

open Classical in
/-- Blueprint lines 2252-2258 ("the main source coefficient factor is canceled by the denominator
in eq:catalog-test ... their fixed powers of the main and helper budgets were included before
choosing `τ₂`. The `O(P²)` band pairs and the polynomial number of transfer steps are also
included. Thus the far terms cost at most `D^{-C₃} ‖S_a‖_{2,I} ‖S_b‖_{2,I}` per cell and group")
at one leaf output pair on the main columns: with the sides in the slots `a, b`, the whole outputs
of the complement slots `c, d` expanded into the positive chains `t, t'` (distinct splits in
`[1, L]`, distinct ball levels `j_c, j_d` of the group of a successful present vertex), the main
tests of the slots passing on the basic arguments at thresholds `τ_r` with
`τ_r D √n_{r-1} ≤ τ₃` (`n` bounding the main labels of rank `r`), the helper tests of rank
`L + 5` passing on the side state of the slot `a` at a threshold `τ_H` with
`τ_H D √n_{L+4} ≤ τ₃`, and `τ₂ D² √n_{L+4} √N_H ≤ τ₃`, the far band defects of the rank-ordered
transfer steps are at most `#steps (P + 1)² 8 τ₃ S_z² S_a S_b`. -/
theorem leaf_farM (cat : Fin 4 → List (CatCol bf.Vtx))
    (hT : ∀ l, ∀ e ∈ cat l, ∃ R ∈ residueBox (bf.vtag e.tag).dim 9, ∃ γ : ℝ,
      e = templateCol (bf.vtag e.tag) l R γ e.birth e.rank e.tag)
    (htag : ∀ l, ∀ e ∈ cat l, bf.occAvail e.tag.2.1 e.tag.1)
    {I : ℤ × ℤ} (hI : I ∈ A.cells) {a b c d : Fin 4} (hca : c ≠ a) (hcd : c ≠ d) (hcb : c ≠ b)
    (hda : d ≠ a) (hdb : d ≠ b) (hab : a ≠ b) {τ : ℕ → ℝ}
    (hpass : ∀ l (w : fp.TestName I Unit),
      (fp.testOf l I (fun _ => bf.basicIn fp.Mc l I) w).Pass A.G (bf.origCols l) I A.csrc A.Hsrc
        bf.vtag (A.w I) (τ (fp.testOf l I (fun _ => bf.basicIn fp.Mc l I) w).r) fp.mH (cat l))
    {Bh : Type} (base : Bh → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (b₀ : Bh) {τH : ℝ} (hτH : 0 ≤ τH)
    (hhpass : ∀ w : fp.HelperName I Bh, (fp.helperOf a I base w).Pass A.G (bf.origCols a) I
      A.csrc A.Hsrc bf.vtag (A.w I) τH fp.mH (cat a))
    (x : Fin 4 → ColumnL2 (bf.Lab ⊕ Fin fp.Mc)) (hxa : x a = base b₀)
    {v₀ : bf.Vtx} (hv₀ : v₀ ∈ bf.admT.X (bf.admAt I))
    (hs₀ : fp.K.Success (fp.K.colorData (bf.admT.st (bf.admAt I)) v₀))
    {jc jd : ℕ} (hjc : 1 ≤ jc) (hjc4 : jc ≤ 4) (hjd : 1 ≤ jd) (hjd4 : jd ≤ 4) (hjcd : jc ≠ jd)
    (t t' : List ℕ) (ht : ∀ m ∈ t, 1 ≤ m ∧ m ≤ fp.Lc) (ht' : ∀ m ∈ t', 1 ≤ m ∧ m ≤ fp.Lc)
    (htt' : ∀ m ∈ t, m ∉ t') (hlen : t.length + t'.length + 2 ≤ fp.mH)
    {τ₃ Sz : ℝ} (hτ0 : ∀ R, 0 ≤ τ R) (n : ℕ → ℝ) (hn : Monotone n)
    (hn0 : 2 * A.colBudget ≤ n 0)
    (hτ : ∀ R, 1 ≤ R → R ≤ fp.Lc + 4 → τ R * (A.colBudget * Real.sqrt (n (R - 1))) ≤ τ₃)
    (hτH' : τH * (A.colBudget * Real.sqrt (n (fp.Lc + 4))) ≤ τ₃) (hSz : 0 < Sz)
    (hSzl : ∀ l, ‖bf.basicIn fp.Mc l I‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sz)
    (d₀ : bf.Vtx) {NH : ℝ}
    (hNl : ∀ l, ∀ r ≤ fp.Lc + 4, ∀ M : bf.Vtx → Prop,
      ((mainLabelsM A.G fp.Mc (bf.origCols l) (cat l) I r M d₀).card : ℝ) ≤ n r)
    (hNH : ∀ M : bf.Vtx → Prop,
      ((mainLabelsM A.G fp.Mc (bf.origCols a) (cat a) I (fp.Lc + 5) M d₀).card : ℝ) ≤ NH)
    {τ₂ : ℝ} (hτ₂ : 0 < τ₂) (hτ₂1 : τ₂ ≤ 1)
    (hτ₂' : τ₂ * (A.colBudget * Real.sqrt (n (fp.Lc + 4)) * (A.colBudget * Real.sqrt NH)) ≤ τ₃)
    (hHed : Real.exp (A.Dg * (1 + Real.log A.Hsrc + Real.log τ₂⁻¹) ^ A.Dg) ≤ fp.Hed)
    {Sa Sb : ℝ} (hSa : 0 < Sa) (hSa' : 2 * ‖x a‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ Sa)
    (hSb : 0 < Sb)
    (hXb : eLpNorm (augPhys (x b)) 2 (normalizedIntervalMeasure (dyadicGridLeft A.G I.1 I.2)
      (dyadicGridLength A.G I.1)) ≤ ENNReal.ofReal Sb) :
    ‖chainDefectSel (fp.Λc I) fp.P a c d x (bf.basicIn fp.Mc c I) (bf.basicIn fp.Mc d I)
        (fun p q => q + 2 < p ∨ p + 2 < q)
        (fp.mergeStepsM cat a c d (fp.Lc + 5) I
          (fp.slotFiltM (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀) jc I t)
          (fp.slotFiltM (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀) jd I t')) (x a)‖ ≤
      (fp.mergeStepsM cat a c d (fp.Lc + 5) I
          (fp.slotFiltM (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀) jc I t)
          (fp.slotFiltM (fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀) jd I t')).length *
        ((fp.P + 1) ^ 2 * (8 * τ₃ * Sz ^ 2 * Sa * Sb)) := by
  set G := fp.K.grp bf.admT A.famVtxBound (bf.admAt I) v₀ with hGdef
  have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
  have hcb0 : (0 : ℝ) ≤ A.colBudget := by linarith [A.two_le_colBudget]
  have hτ₃0 : 0 ≤ τ₃ := le_trans (by positivity) hτH'
  -- the entries of the slot filters: named masks of present vertices, ranks in `[1, L + 4]`
  have hnamed : ∀ j : ℕ, j ≤ 4 → ∀ u : List ℕ, (∀ m ∈ u, 1 ≤ m ∧ m ≤ fp.Lc) →
      ∀ f ∈ fp.slotFiltM G j I u, ∀ p : Fin fp.P, ∃ M : fp.MaskName I, fp.maskOf I M = f.2 p := by
    intro j hj u hu f hf p
    simp only [slotFiltM, List.mem_cons, List.mem_map] at hf
    rcases hf with rfl | ⟨m, hm, rfl⟩
    · exact fp.bmask_named I hv₀ hj (by have := p.2; omega)
    · exact fp.cmask_named I (hu m hm).2 (by have := p.2; omega)
  have hpres : ∀ (j : ℕ) (u : List ℕ), ∀ f ∈ fp.slotFiltM G j I u, ∀ k x, f.2 k x →
      x ∈ bf.admT.X (bf.admAt I) := by
    intro j u f hf k x hx
    simp only [slotFiltM, List.mem_cons, List.mem_map] at hf
    rcases hf with rfl | ⟨m, hm, rfl⟩
    · exact fp.bmask_present hx
    · exact fp.cmask_present hx
  have hrank : ∀ j : ℕ, 1 ≤ j → j ≤ 4 → ∀ u : List ℕ, (∀ m ∈ u, 1 ≤ m ∧ m ≤ fp.Lc) →
      ∀ f ∈ fp.slotFiltM G j I u, 1 ≤ f.1 ∧ f.1 ≤ fp.Lc + 4 := by
    intro j hj1 hj4 u hu f hf
    simp only [slotFiltM, List.mem_cons, List.mem_map] at hf
    rcases hf with rfl | ⟨m, hm, rfl⟩
    · simp only [brank]; omega
    · have := hu m hm; simp only [crank]; omega
  -- the ranks of the two slots are distinct
  have hdist : ∀ f ∈ fp.slotFiltM G jc I t, ∀ g ∈ fp.slotFiltM G jd I t', f.1 ≠ g.1 := by
    intro f hf g hg
    simp only [slotFiltM, List.mem_cons, List.mem_map] at hf hg
    rcases hf with rfl | ⟨m, hm, rfl⟩ <;> rcases hg with rfl | ⟨m', hm', rfl⟩
    · simp only [brank]; omega
    · have := ht' m' hm'; simp only [brank, crank]; omega
    · have := ht m hm; simp only [brank, crank]; omega
    · have h1 := ht m hm
      have h2 := ht' m' hm'
      simp only [crank]
      intro he
      have hmm : m = m' := by omega
      exact htt' m hm (hmm ▸ hm')
  -- the main tests of the removed filters
  have hmainL : ∀ (l : Fin 4) (j : ℕ), 1 ≤ j → j ≤ 4 → ∀ u : List ℕ,
      (∀ m ∈ u, 1 ≤ m ∧ m ≤ fp.Lc) → u.length ≤ fp.mH → ∀ f xs',
      (f :: xs') <:+ fp.slotFiltM G j I u → fp.FiltOK I f ∧
        ∀ k : Fin fp.P, CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag l (f.2 k)
          (applyAll (xs'.map (fp.filtAvgM l (cat l) I)) (bf.basicIn fp.Mc l I) -
            mainProj A.G fp.Mc (bf.origCols l) (cat l) I f.1 (f.2 k)
              (applyAll (xs'.map (fp.filtAvgM l (cat l) I)) (bf.basicIn fp.Mc l I)))
          (τ f.1 * Sz) := by
    intro l j hj1 hj4 u hu hul f xs' hf
    have hlev : ∀ R, τ R * cellNorm A.G I (bf.basicIn fp.Mc l I) ≤ τ R * Sz := fun R =>
      mul_le_mul_of_nonneg_left ((cellNorm_le A.G I _).trans (hSzl l)) (hτ0 R)
    have hu' : ∀ m ∈ u, m ≤ fp.Lc := fun m hm => (hu m hm).2
    rcases fp.slotFiltM_suffix_cons G j I u hf with ⟨rfl, rfl⟩ | ⟨k, hk, rfl, rfl⟩
    · refine ⟨fp.filtOK_ball I hv₀ hs₀ hj4, fun p => ?_⟩
      rw [fp.applyAll_cumM]
      obtain ⟨Mt, hMt⟩ := fp.bmask_named I hv₀ hj4 (p := (p : ℕ) + 1) (by have := p.2; omega)
      have h := fp.chain_passR l (cat l) hI _ (hpass l) u hu' hul (R := fp.brank j)
        (by unfold brank; omega) (by unfold brank; omega) Mt
      rw [hMt] at h
      exact h.mono (hlev _)
    · have hmem : u.getD k 0 ∈ u := by
        rw [List.getD_eq_getElem _ _ hk]; exact List.getElem_mem _
      refine ⟨fp.filtOK_cum I _, fun p => ?_⟩
      rw [fp.applyAll_cumM]
      obtain ⟨Mt, hMt⟩ := fp.cmask_named I (m := u.getD k 0) (p := (p : ℕ) + 1) (hu' _ hmem)
        (by have := p.2; omega)
      have h := fp.chain_passR l (cat l) hI _ (hpass l) (u.drop (k + 1))
        (fun m hm => hu' m (List.mem_of_mem_drop hm))
        (by rw [List.length_drop]; omega) (R := fp.crank (u.getD k 0))
        (by unfold crank; omega) (by unfold crank; omega) Mt
      rw [hMt] at h
      exact h.mono (hlev _)
  -- the source data of the remaining complements
  have hsrcL : ∀ (l : Fin 4) (j : ℕ), 1 ≤ j → j ≤ 4 → ∀ u : List ℕ,
      (∀ m ∈ u, 1 ≤ m ∧ m ≤ fp.Lc) → ∀ xs' : List (ℕ × (Fin fp.P → bf.Vtx → Prop)),
      xs' <:+ fp.slotFiltM G j I u →
      fp.SrcDataM l I (applyAll (xs'.map (fp.filtAvgM l (cat l) I)) (bf.basicIn fp.Mc l I))
        ((fun R => A.colBudget * Real.sqrt (n R) * Sz) (headRank xs')) := by
    intro l j hj1 hj4 u hu xs' hxs'
    rcases xs' with _ | ⟨g, rest⟩
    · refine fp.srcDataM_basic l (cat l) (hT l) (htag l) hI d₀ (hSzl l) ?_
      change A.colBudget * Real.sqrt (2 * A.colBudget) * Sz ≤
        A.colBudget * Real.sqrt (n 0) * Sz
      gcongr
    · rw [List.map_cons, applyAll]
      have hgm : g ∈ fp.slotFiltM G j I u := hxs'.subset (by simp)
      have hg := hpres j u g hgm
      exact fp.srcDataM_filt l (cat l) (hT l) (htag l) I g hg d₀ _
        ((div_le_div_of_nonneg_right (fp.norm_applyAll_filtAvgM_le l (cat l) I rest _)
          hsq.le).trans (hSzl l)) (hNl l g.1 (hrank j hj1 hj4 u hu g hgm).2 _) le_rfl
  -- the helper tests of the steps
  have hmerge_named : ∀ e ∈ rankMerge Prod.fst (fp.slotFiltM G jc I t) (fp.slotFiltM G jd I t'),
      ∀ p, ∃ M : fp.MaskName I, fp.maskOf I M = e.2.2 p := by
    intro e he p
    rcases rankMerge_mem Prod.fst _ _ he with h | h
    · exact hnamed jc hjc4 t ht _ h p
    · exact hnamed jd hjd4 t' ht' _ h p
  have hhelp : ∀ preM e restM, rankMerge Prod.fst (fp.slotFiltM G jc I t)
      (fp.slotFiltM G jd I t') = preM ++ e :: restM → ∀ k : Fin fp.P,
      CellPass (A.adm I hI) A.csrc A.Hsrc bf.vtag a (e.2.2 k)
        (operatorComplementProduct (fun l => opAvg fun p =>
            mainProj A.G fp.Mc (bf.origCols a) (cat a) I (fp.Lc + 5)
              ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length
              (x a) -
          mainProj A.G fp.Mc (bf.origCols a) (cat a) I (fp.Lc + 5) (e.2.2 k)
            (operatorComplementProduct (fun l => opAvg fun p =>
              mainProj A.G fp.Mc (bf.origCols a) (cat a) I (fp.Lc + 5)
                ((preM.getD l (true, 0, fun _ _ => False)).2.2 p)) (fun _ => false) preM.length
                (x a))) (τH * Sa) := by
    intro preM e restM hrm k
    have hpre : ∀ i < preM.length, ∀ p, ∃ M : fp.MaskName I,
        fp.maskOf I M = (preM.getD i (true, 0, fun _ _ => False)).2.2 p := by
      intro i hi p
      refine hmerge_named _ ?_ p
      rw [hrm, List.getD_eq_getElem _ _ hi]
      exact List.mem_append_left _ (List.getElem_mem _)
    have hk : preM.length ≤ fp.mH := by
      have := congrArg List.length hrm
      rw [rankMerge_length] at this
      simp only [slotFiltM, List.length_cons, List.length_map, List.length_append] at this
      omega
    obtain ⟨Mt, hMt⟩ := hmerge_named e (by rw [hrm]; simp) k
    have h := fp.helper_stepPass a (cat a) hI base b₀ hhpass preM.length hk
      (fun i p => (preM.getD i (true, 0, fun _ _ => False)).2.2 p) hpre Mt
    rw [hMt, ← hxa] at h
    refine h.mono (mul_le_mul_of_nonneg_left ((cellNorm_le A.G I (x a)).trans ?_) hτH)
    have h0 : 0 ≤ ‖x a‖ / Real.sqrt (dyadicGridLength A.G I.1) := by positivity
    have e2 : 2 * ‖x a‖ / Real.sqrt (dyadicGridLength A.G I.1) =
        2 * (‖x a‖ / Real.sqrt (dyadicGridLength A.G I.1)) := mul_div_assoc _ _ _
    linarith
  refine fp.chainPair_farM cat hT htag hI hca hcd hcb hda hdb hab (fp.Lc + 5) _ _ _ _
    (fun R => τ R * Sz) (fun R => mul_nonneg (hτ0 R) hSz.le)
    (hmainL c jc hjc hjc4 t ht (by omega)) (hmainL d jd hjd hjd4 t' ht' (by omega)) hdist
    (fun f hf => (hrank jc hjc hjc4 t ht f hf).1) (fun g hg => (hrank jd hjd hjd4 t' ht' g hg).1)
    (fun R => A.colBudget * Real.sqrt (n R) * Sz) hSz (hsrcL c jc hjc hjc4 t ht)
    (hsrcL d jd hjd hjd4 t' ht') (hSzl c) (hSzl d) x (by positivity) hhelp d₀
    (Nm := n (fp.Lc + 4))
    (fun f hf M => (hNl c f.1 (hrank jc hjc hjc4 t ht f hf).2 M).trans
      (hn (hrank jc hjc hjc4 t ht f hf).2))
    (fun g hg M => (hNl d g.1 (hrank jd hjd hjd4 t' ht' g hg).2 M).trans
      (hn (hrank jd hjd hjd4 t' ht' g hg).2))
    hNH hτ₂ hτ₂1 hHed hSa hSa' hSb hXb (by positivity) ?_
  intro Rf hRf Ro hRo
  have hR : 1 ≤ Rf ∧ Rf ≤ fp.Lc + 4 := by
    rcases hRf with ⟨f, hf, rfl⟩ | ⟨g, hg, rfl⟩
    · exact hrank jc hjc hjc4 t ht f hf
    · exact hrank jd hjd hjd4 t' ht' g hg
  have hnR : n Ro ≤ n (Rf - 1) := hn (by omega)
  have hnL : n Ro ≤ n (fp.Lc + 4) := hn (by omega)
  have h2 : τ Rf * (A.colBudget * Real.sqrt (n Ro)) ≤ τ₃ := by
    refine le_trans ?_ (hτ Rf hR.1 hR.2)
    gcongr
    exact hτ0 Rf
  have h3 : τ₂ * (A.colBudget * Real.sqrt (n Ro) * (A.colBudget * Real.sqrt NH)) ≤ τ₃ := by
    refine le_trans ?_ hτ₂'
    gcongr
  exact far_numeric hSa.le hSb.le hτH' h2 h3

/-- The thresholds of eq:catalog-test satisfy the cancellation hypotheses of `leaf_farM`: the
threshold of rank `r` times the expansion cost `D √n_{r-1}` of a lower-rank primal is at most `τ₃`
(blueprint lines 1835 and 2256). -/
theorem catThreshold_cancel {τ₃ : ℝ} (hτ₃ : 0 ≤ τ₃) {n : ℕ → ℝ} {r : ℕ} (hn : 0 < n (r - 1)) :
    catThreshold A.famVtxBound τ₃ n r * (A.colBudget * Real.sqrt (n (r - 1))) ≤ τ₃ := by
  have h := catThreshold_mul_cost A.one_le_famVtxBound τ₃ hn
  have h0 : 0 ≤ catThreshold A.famVtxBound τ₃ n r := by
    unfold catThreshold
    exact div_nonneg hτ₃ (by positivity)
  calc _ ≤ catThreshold A.famVtxBound τ₃ n r * (A.famVtxBound * Real.sqrt (n (r - 1))) := by
        gcongr
        exact A.colBudget_le_famVtxBound
    _ = τ₃ := h

