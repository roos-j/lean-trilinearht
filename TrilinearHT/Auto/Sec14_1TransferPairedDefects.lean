/-! ### The helper test family of an attempt (blueprint lines 1812-1817, 2236-2238) -/

/-- The merged filters of a chain pair of the slots `c, d` of the leaf `s` at the cell `I`. -/
def mergeAt (s : ℕ) (c d : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (ic id : ℕ) :
    List (Bool × (ℕ × (Fin ap.P → A.Vtx → Prop))) :=
  rankMerge Prod.fst (ap.slotFilt s c G I (ap.chainOf s c ic))
    (ap.slotFilt s d G I (ap.chainOf s d id))

/-- The helper tests of a cell (blueprint lines 2236-2238: "construct the helper rank reserved in
Lemma closure, on these whole states and the specified histories"): for every leaf, current group,
side slot `a` with complement slots `c, d`, pair of positive chains, transfer step `n`, target pad
and pad choice of the earlier helper averages. -/
abbrev HelperIdx (I : ℤ × ℤ) : Type :=
  Σ s : Fin ap.leaves.length, Σ _G : {G // G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k},
    Σ σ : Fin 4 × Fin 4 × Fin 4,
      Σ _ic : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers σ.2.1).reverse).length,
        Σ _id : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers σ.2.2).reverse).length,
          Σ n : Fin (2 * ap.fuel + 3), Fin ap.P × (Fin n → Fin ap.P)

/-- The helper test of an index, on the side states `base s G a I` of the leaves. -/
noncomputable def helperTest (base : ℕ → A.Grp → Fin 4 → ℤ × ℤ → ColumnL2 (Fin ap.Mc))
    (rH : ℕ) (I : ℤ × ℤ) : ap.HelperIdx I → VTest A.Vtx ap.Mc
  | ⟨s, G, σ, ic, id, n, pp, ch⟩ =>
      VTest.ofSteps ap.hP σ.1 rH
        (((ap.mergeAt s σ.2.1 σ.2.2 G.1 I ic id).getD n (true, 0, fun _ _ => False)).2.2 pp)
        (fun l => ((ap.mergeAt s σ.2.1 σ.2.2 G.1 I ic id).getD l
          (true, 0, fun _ _ => False)).2.2) n ch (base s G.1 σ.1 I)

theorem helperTest_r (base : ℕ → A.Grp → Fin 4 → ℤ × ℤ → ColumnL2 (Fin ap.Mc)) (rH : ℕ)
    (I : ℤ × ℤ) (w : ap.HelperIdx I) : (ap.helperTest base rH I w).r = rH := by
  rcases w with ⟨s, G, σ, ic, id, n, pp, ch⟩; rfl

theorem helperTest_t (base : ℕ → A.Grp → Fin 4 → ℤ × ℤ → ColumnL2 (Fin ap.Mc)) (rH : ℕ)
    (I : ℤ × ℤ) (w : ap.HelperIdx I) : (ap.helperTest base rH I w).t = w.2.2.1.1 := by
  rcases w with ⟨s, G, σ, ic, id, n, pp, ch⟩; rfl

/-- The number of helper tests of a cell is at most
`2^fuel D 64 4^fuel (2 fuel + 3) P^(2 fuel + 3)`, uniformly in the cell. -/
theorem card_HelperIdx_le (I : ℤ × ℤ) :
    Fintype.card (ap.HelperIdx I) ≤ 2 ^ ap.fuel * (A.vtxBound * (64 * (2 ^ ap.fuel *
      (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3)))))) := by
  classical
  have hP := ap.hP
  have hlen : ∀ (s : Fin ap.leaves.length) l,
      ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).length ≤ ap.fuel := fun s l => by
    have := searchLeaves_layers_length ap.fuel 1 ap.Lc ap.up₀ none (fun _ => [])
      (leafAt ap.fuel ap.Lc ap.up₀ s) (leafAt_mem s.2) l
    simpa using this
  have hch : ∀ (s : Fin ap.leaves.length) l,
      (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers l).reverse).length ≤ 2 ^ ap.fuel :=
    fun s l => (posExpand_length_le _).trans (by
      rw [List.length_reverse]; exact Nat.pow_le_pow_right two_pos (hlen s l))
  have hn : Fintype.card (Σ n : Fin (2 * ap.fuel + 3), Fin ap.P × (Fin n → Fin ap.P)) ≤
      (2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3) := by
    rw [Fintype.card_sigma]
    calc ∑ n : Fin (2 * ap.fuel + 3), Fintype.card (Fin ap.P × (Fin n → Fin ap.P))
        ≤ ∑ _n : Fin (2 * ap.fuel + 3), ap.P ^ (2 * ap.fuel + 3) := by
          refine Finset.sum_le_sum fun n _ => ?_
          rw [Fintype.card_prod, Fintype.card_fin, Fintype.card_fun, Fintype.card_fin,
            Fintype.card_fin, ← pow_succ']
          exact Nat.pow_le_pow_right hP (by omega)
      _ = _ := by rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
  have hσ : ∀ (s : Fin ap.leaves.length) (σ : Fin 4 × Fin 4 × Fin 4),
      Fintype.card (Σ _ic : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers
        σ.2.1).reverse).length, Σ _id : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers
          σ.2.2).reverse).length, Σ n : Fin (2 * ap.fuel + 3), Fin ap.P × (Fin n → Fin ap.P)) ≤
      2 ^ ap.fuel * (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3))) := by
    intro s σ
    rw [Fintype.card_sigma, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul,
      Fintype.card_sigma, Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
    exact Nat.mul_le_mul (hch s _) (Nat.mul_le_mul (hch s _) hn)
  have hG : ∀ s : Fin ap.leaves.length,
      Fintype.card (Σ _G : {G // G ∈ ap.groupsAt I (leafAt ap.fuel ap.Lc ap.up₀ s).k},
        Σ σ : Fin 4 × Fin 4 × Fin 4,
          Σ _ic : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers σ.2.1).reverse).length,
            Σ _id : Fin (posExpand ((leafAt ap.fuel ap.Lc ap.up₀ s).layers σ.2.2).reverse).length,
              Σ n : Fin (2 * ap.fuel + 3), Fin ap.P × (Fin n → Fin ap.P)) ≤
      A.vtxBound * (64 * (2 ^ ap.fuel *
        (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3))))) := by
    intro s
    rw [Fintype.card_sigma, Finset.sum_const, Finset.card_univ, Fintype.card_coe, smul_eq_mul]
    refine Nat.mul_le_mul (ap.card_groupsAt_le I _) ?_
    rw [Fintype.card_sigma]
    calc ∑ σ : Fin 4 × Fin 4 × Fin 4, _ ≤ ∑ _σ : Fin 4 × Fin 4 × Fin 4,
          2 ^ ap.fuel * (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3))) :=
          Finset.sum_le_sum fun σ _ => hσ s σ
      _ = _ := by rw [Finset.sum_const, Finset.card_univ]; simp
  rw [Fintype.card_sigma]
  calc ∑ s : Fin ap.leaves.length, _ ≤ ∑ _s : Fin ap.leaves.length, A.vtxBound * (64 *
        (2 ^ ap.fuel * (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3))))) :=
        Finset.sum_le_sum fun s _ => hG s
    _ = ap.leaves.length * (A.vtxBound * (64 * (2 ^ ap.fuel *
          (2 ^ ap.fuel * ((2 * ap.fuel + 3) * ap.P ^ (2 * ap.fuel + 3)))))) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
    _ ≤ _ := Nat.mul_le_mul_right _ (searchLeaves_length_le _ _ _ _ _ _)

