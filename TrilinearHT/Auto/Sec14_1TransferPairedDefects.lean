section RankMergeSteps
variable {α : Type*}

/-! ### Steps of a rank merge (blueprint line 2241) -/

/-- Blueprint line 2241 ("remove the larger rank among the two current outermost positive
filters ... the other complementary argument always has a strictly lower-rank outer primal
source"): every step of a rank merge takes the head of a suffix of one list, the remaining steps
are the merge of the remaining suffixes, and the head of the other remaining suffix has smaller
(for a `c` step: strictly smaller) rank. -/
theorem rankMerge_decomp (key : α → ℕ) :
    ∀ (xs ys : List α) (pre : List (Bool × α)) (e : Bool × α) (rest : List (Bool × α)),
      rankMerge key xs ys = pre ++ e :: rest →
      ∃ xs' ys' : List α, rest = rankMerge key xs' ys' ∧
        ((e.1 = true ∧ (e.2 :: xs') <:+ xs ∧ ys' <:+ ys ∧ ∀ y ∈ ys'.head?, key y < key e.2) ∨
         (e.1 = false ∧ xs' <:+ xs ∧ (e.2 :: ys') <:+ ys ∧
            ∀ x ∈ xs'.head?, key x ≤ key e.2))
  | [], ys, pre, e, rest, h => by
    simp only [rankMerge] at h
    obtain ⟨ys₁, y, ys₂, rfl, hpre, he, hrest⟩ : ∃ ys₁ y ys₂, ys = ys₁ ++ y :: ys₂ ∧
        pre = ys₁.map (fun y => (false, y)) ∧ e = (false, y) ∧
        rest = ys₂.map (fun y => (false, y)) := by
      obtain ⟨l₁, l₂, hl, hpre', hrest'⟩ := List.map_eq_append_iff.mp h
      obtain ⟨y, ys₂, rfl, he', hr'⟩ := List.map_eq_cons_iff.mp hrest'
      exact ⟨l₁, y, ys₂, hl, hpre'.symm, he'.symm, hr'.symm⟩
    refine ⟨[], ys₂, by rw [hrest]; simp [rankMerge], Or.inr ⟨by rw [he], List.nil_suffix,
      by rw [he]; exact List.suffix_append _ _, by simp⟩⟩
  | x :: xs, [], pre, e, rest, h => by
    simp only [rankMerge] at h
    obtain ⟨l₁, l₂, hl, hpre', hrest'⟩ := List.map_eq_append_iff.mp h
    obtain ⟨z, zs, rfl, he', hr'⟩ := List.map_eq_cons_iff.mp hrest'
    refine ⟨zs, [], by rw [← hr']; cases zs <;> simp [rankMerge], Or.inl ⟨by rw [← he'],
      by rw [← he']; simp only; rw [hl]; exact List.suffix_append _ _, List.nil_suffix,
      by simp⟩⟩
  | x :: xs, y :: ys, pre, e, rest, h => by
    unfold rankMerge at h
    split_ifs at h with hk
    · rcases pre with _ | ⟨e₀, pre⟩
      · simp only [List.nil_append, List.cons.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        exact ⟨xs, y :: ys, rfl, Or.inl ⟨rfl, List.suffix_refl _, List.suffix_refl _,
          by simpa using hk⟩⟩
      · simp only [List.cons_append, List.cons.injEq] at h
        obtain ⟨xs', ys', hr, h'⟩ := rankMerge_decomp key xs (y :: ys) pre e rest h.2
        refine ⟨xs', ys', hr, ?_⟩
        rcases h' with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩
        · exact Or.inl ⟨h1, h2.trans (List.suffix_cons _ _), h3, h4⟩
        · exact Or.inr ⟨h1, h2.trans (List.suffix_cons _ _), h3, h4⟩
    · rcases pre with _ | ⟨e₀, pre⟩
      · simp only [List.nil_append, List.cons.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        exact ⟨x :: xs, ys, rfl, Or.inr ⟨rfl, List.suffix_refl _, List.suffix_refl _,
          by simpa using hk⟩⟩
      · simp only [List.cons_append, List.cons.injEq] at h
        obtain ⟨xs', ys', hr, h'⟩ := rankMerge_decomp key (x :: xs) ys pre e rest h.2
        refine ⟨xs', ys', hr, ?_⟩
        rcases h' with ⟨h1, h2, h3, h4⟩ | ⟨h1, h2, h3, h4⟩
        · exact Or.inl ⟨h1, h2, h3.trans (List.suffix_cons _ _), h4⟩
        · exact Or.inr ⟨h1, h2, h3.trans (List.suffix_cons _ _), h4⟩
termination_by xs ys => xs.length + ys.length

end RankMergeSteps

namespace ActiveSetup

namespace AttemptParams
variable {κ' : LocalKernelClass} {c₀ : ℕ} {A : ActiveSetup κ' c₀} (ap : A.AttemptParams)

/-! ### Values along the transfer steps (blueprint lines 2241-2252) -/

/-- The averaged catalog filter of a slot filter entry. -/
noncomputable def filtAvg (cat : List (CatCol A.Vtx)) (I : ℤ × ℤ)
    (f : ℕ × (Fin ap.P → A.Vtx → Prop)) :
    ColumnL2 (Fin ap.Mc) →ₗ[ℂ] ColumnL2 (Fin ap.Mc) :=
  filterAvg ap.P (padFam fun p => catProj A.G ap.Mc cat I f.1 (f.2 p))

/-- A suffix of the filters of a slot along a chain, headed by a filter, is the whole list (the
ball filter first) or a cumulative layer of the chain followed by the inner layers. -/
theorem slotFilt_suffix_cons (s : ℕ) (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t : List ℕ)
    {f : ℕ × (Fin ap.P → A.Vtx → Prop)} {xs' : List (ℕ × (Fin ap.P → A.Vtx → Prop))}
    (h : (f :: xs') <:+ ap.slotFilt s l G I t) :
    (f = (ap.leafR s l, fun p : Fin ap.P => ap.bmask I G (ap.leafJ s l) p) ∧
      xs' = t.map fun m => (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p)) ∨
    ∃ k < t.length, f = (ap.Lc - t.getD k 0 + 1, fun p : Fin ap.P => ap.cmask I (t.getD k 0) p) ∧
      xs' = (t.drop (k + 1)).map fun m => (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p) := by
  obtain ⟨pre, hpre⟩ := h
  unfold slotFilt at hpre
  rcases pre with _ | ⟨g, pre⟩
  · simp only [List.nil_append, List.cons.injEq] at hpre
    exact Or.inl ⟨hpre.1, hpre.2⟩
  · simp only [List.cons_append, List.cons.injEq] at hpre
    obtain ⟨-, hpre⟩ := hpre
    right
    refine ⟨pre.length, ?_, ?_⟩
    · have := congrArg List.length hpre
      simp only [List.length_append, List.length_cons, List.length_map] at this
      omega
    · have hd := congrArg (List.drop pre.length) hpre
      rw [List.drop_left] at hd
      rw [← List.map_drop] at hd
      have hk : pre.length < t.length := by
        have := congrArg List.length hpre
        simp only [List.length_append, List.length_cons, List.length_map] at this
        omega
      rw [List.drop_eq_getElem_cons hk, List.map_cons] at hd
      simp only [List.cons.injEq] at hd
      obtain ⟨hf, hx⟩ := hd
      exact ⟨by rw [hf, List.getD_eq_getElem _ _ hk], hx⟩

/-- A suffix of the filters of a slot along a chain is empty, the whole list, or a tail of
cumulative layers. -/
theorem slotFilt_suffix (s : ℕ) (l : Fin 4) (G : A.Grp) (I : ℤ × ℤ) (t : List ℕ)
    {ys' : List (ℕ × (Fin ap.P → A.Vtx → Prop))} (h : ys' <:+ ap.slotFilt s l G I t) :
    ys' = [] ∨ ys' = ap.slotFilt s l G I t ∨
      ∃ k < t.length, ys' = (t.drop k).map fun m =>
        (ap.Lc - m + 1, fun p : Fin ap.P => ap.cmask I m p) := by
  rcases ys' with _ | ⟨f, ys'⟩
  · exact Or.inl rfl
  · rcases ap.slotFilt_suffix_cons s l G I t h with ⟨hf, hx⟩ | ⟨k, hk, hf, hx⟩
    · right; left
      rw [hf, hx]
      rfl
    · right; right
      refine ⟨k, hk, ?_⟩
      rw [hf, hx, List.drop_eq_getElem_cons hk, List.map_cons, List.getD_eq_getElem _ _ hk]

/-- A selected template column of a slot is a bounded pure source of its present tag. -/
theorem catColumn_bdd (catl : List (CatCol A.Vtx)) (l : Fin 4)
    (hT : ∀ d ∈ catl, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) l R γ d.birth d.rank d.tag)
    (I : ℤ × ℤ) {n : Fin ap.Mc} (hnl : (n : ℕ) < catl.length)
    (hp : (catl[(n : ℕ)]).tag ∈ A.admT.X (A.admAt I)) :
    ∃ Ay : QuadraticChartData (A.vtag (catl[(n : ℕ)]).tag).dim,
      QuadraticChartComplexity A.csrc A.Hsrc Ay ∧ IsBoundedQuadraticChart Ay ∧
      Ay.horizontal = (A.vtag (catl[(n : ℕ)]).tag).θ ∧
      Ay.matrix = (slotCoeff l : ℚ) • (A.vtag (catl[(n : ℕ)]).tag).C ∧
      Ay.quadratic = slotCoeff l * (A.vtag (catl[(n : ℕ)]).tag).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom catl n) n) y =
          quadraticChartAtom Ay y := by
  obtain ⟨A', hA', hb, hθ, hM, hq, he⟩ := catAtom_chart catl l hT hnl (A.occAvail_of_mem hp)
  refine ⟨A', hA', hb, hθ, hM, hq, ?_⟩
  rw [← he]
  exact augPhys_fitColumn_ae (catAtom_admissible catl n I) n

/-- The chart input of a basic occurrence is a bounded pure source of its vertex. -/
theorem basic_bdd {I : ℤ × ℤ} (hI : I ∈ A.cells) {l : Fin 4} {v : A.L}
    (hv : A.coef l I v ≠ 0) :
    ∃ Ay : QuadraticChartData (A.vtag (A.basicVtx hI l v)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc Ay ∧ IsBoundedQuadraticChart Ay ∧
      Ay.horizontal = (A.vtag (A.basicVtx hI l v)).θ ∧
      Ay.matrix = (slotCoeff l : ℚ) • (A.vtag (A.basicVtx hI l v)).C ∧
      Ay.quadratic = slotCoeff l * (A.vtag (A.basicVtx hI l v)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 →
        augPhys (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.φ I v))) y =
          quadraticChartAtom Ay y := by
  obtain ⟨-, hsub, hav⟩ := A.basicVtx_anc hI hv
  obtain ⟨hc, -, hθ, hM, hq⟩ := A.vchart_source (x := A.basicVtx hI l v) hav
  obtain ⟨-, hb, he⟩ := A.vchart_spec (A.basicVtx hI l v) hav
  have hφ : A.φ I v = A.φ (A.basicVtx hI l v).2.1 v :=
    A.nested_cons I hI _ hav.1 hsub v ⟨l, hv⟩ ⟨l, hav.2⟩
  refine ⟨(A.vchart (A.basicVtx hI l v)).2, hc, hb, hθ, hM, hq, ?_⟩
  filter_upwards [augPhys_cellLp (Mc := ap.Mc) (A.φ_memLp I v)] with y hy hyI
  exact (hy hyI).trans (by rw [hφ]; exact congrFun he y)

/-- The source data of a slot value used by the far band estimate. -/
def SrcData (o : Fin 4) (I : ℤ × ℤ) (w : ColumnL2 (Fin ap.Mc)) (Co : ℝ) : Prop :=
  ∃ (ι : Type) (Fo : Finset ι) (co : ι → ℂ) (src : ι → ColumnL2 (Fin ap.Mc))
    (tago : ι → A.Vtx), w = ∑ m ∈ Fo, co m • src m ∧ ∑ m ∈ Fo, ‖co m‖ ≤ Co ∧
    (∀ m ∈ Fo, tago m ∈ A.admT.X (A.admAt I)) ∧
    ∀ m ∈ Fo, ∃ Ay : QuadraticChartData (A.vtag (tago m)).dim,
      QuadraticChartComplexity A.csrc A.Hsrc Ay ∧ IsBoundedQuadraticChart Ay ∧
      Ay.horizontal = (A.vtag (tago m)).θ ∧ Ay.matrix = (slotCoeff o : ℚ) • (A.vtag (tago m)).C ∧
      Ay.quadratic = slotCoeff o * (A.vtag (tago m)).lam ∧
      ∀ᵐ y ∂volume, y ∈ dyadicGridCell A.G I.1 I.2 → augPhys (src m) y = quadraticChartAtom Ay y

/-- Blueprint line 2254 ("using its basic columns when it is unfiltered"): the basic argument of a
slot is a combination of bounded pure sources with coefficient sum at most `|L| D_c`. -/
theorem srcData_basic {I : ℤ × ℤ} (hI : I ∈ A.cells) (o : Fin 4) {Co : ℝ}
    (hCo : Fintype.card A.L * A.Dc ≤ Co) :
    ap.SrcData o I (physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.B o I))) Co := by
  classical
  refine ⟨A.L, Finset.univ.filter (fun v => A.coef o I v ≠ 0), A.coef o I,
    fun v => physicalColumnInput (V := Fin ap.Mc) (cellLp A.G I (A.φ I v)),
    fun v => A.basicVtx hI o v,
    A.basic_expansion ap.Mc I o, ?_, fun v hv => ?_, fun v hv => ?_⟩
  · calc ∑ v ∈ Finset.univ.filter (fun v => A.coef o I v ≠ 0), ‖A.coef o I v‖
        ≤ ∑ v : A.L, ‖A.coef o I v‖ :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)
            fun _ _ _ => norm_nonneg _
      _ ≤ ∑ _v : A.L, A.Dc := Finset.sum_le_sum fun v _ => A.coef_le o I v
      _ = Fintype.card A.L * A.Dc := by rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
      _ ≤ Co := hCo
  · exact A.basicVtx_mem hI (Finset.mem_filter.mp hv).2
  · exact ap.basic_bdd hI (Finset.mem_filter.mp hv).2

/-- Blueprint line 2254 ("expand instead the lower-rank primal source"): an averaged catalog
filter of a slot with masks of present vertices, applied to a value of size at most `S √|I|`, is a
combination of bounded pure sources with coefficient sum at most `√N S` when the slot catalog has at
most `N` labels at the cell. -/
theorem srcData_filt (cat : List (CatCol A.Vtx)) (o : Fin 4)
    (hT : ∀ d ∈ cat, ∃ R ∈ residueBox (A.vtag d.tag).dim 9, ∃ γ : ℝ,
      d = templateCol (A.vtag d.tag) o R γ d.birth d.rank d.tag)
    (I : ℤ × ℤ) (g : ℕ × (Fin ap.P → A.Vtx → Prop))
    (hg : ∀ k x, g.2 k x → x ∈ A.admT.X (A.admAt I)) (x : ColumnL2 (Fin ap.Mc)) {S N Co : ℝ}
    (hx : ‖x‖ / Real.sqrt (dyadicGridLength A.G I.1) ≤ S)
    (hN : ((catLabels A.G ap.Mc cat I g.1 (fun y => ∃ p, g.2 p y)).card : ℝ) ≤ N)
    (hCo : Real.sqrt N * S ≤ Co) :
    ap.SrcData o I (ap.filtAvg cat I g x) Co := by
  classical
  set F := catLabels A.G ap.Mc cat I g.1 (fun y => ∃ p, g.2 p y)
  obtain ⟨co, -, he⟩ := opAvg_catProj_l2 (G := A.G) cat I g.1 g.2 (fun y => ∃ p, g.2 p y)
    (fun p y h => ⟨p, h⟩) x
  have hmem : ∀ n ∈ F, ∃ h : (n : ℕ) < cat.length, (cat[(n : ℕ)]).tag ∈ A.admT.X (A.admAt I) := by
    intro n hn
    simp only [F, catLabels, Finset.mem_filter, Finset.mem_univ, true_and] at hn
    obtain ⟨h, -, -, p, hp⟩ := hn
    exact ⟨h, hg p _ hp⟩
  have hval : ap.filtAvg cat I g x =
      ∑ n ∈ F, co n • fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom cat n) n := by
    change filterAvg ap.P (padFam fun p => catProj A.G ap.Mc cat I g.1 (g.2 p)) x = _
    rw [filterAvg_padFam, he]
  refine ⟨{n // n ∈ F}, Finset.univ, fun n => co n.1,
    fun n => fitColumn (dyadicGridCell A.G I.1 I.2) (catAtom cat n.1) n.1,
    fun n => (cat[(n.1 : ℕ)]'(hmem n.1 n.2).1).tag, ?_, ?_, fun n _ => (hmem n.1 n.2).2,
    fun n _ => ap.catColumn_bdd cat o hT I (hmem n.1 n.2).1 (hmem n.1 n.2).2⟩
  · rw [hval, Finset.sum_coe_sort F (fun n => co n • fitColumn (dyadicGridCell A.G I.1 I.2)
      (catAtom cat n) n)]
  · rw [Finset.sum_coe_sort F (fun n => ‖co n‖)]
    have h1 := catCoeff_l1_le (G := A.G) cat I F co
    rw [← he] at h1
    have h2 : ‖opAvg (fun p => catProj A.G ap.Mc cat I g.1 (g.2 p)) x‖ ≤ ‖x‖ :=
      norm_opAvg_apply_le _ (fun _ z => norm_catProj_le _ _ _ _ _ _ z) x
    have hsq := Real.sqrt_pos.mpr (dyadicGridLength_pos A.G I.1)
    refine h1.trans (le_trans ?_ hCo)
    have hS0 : 0 ≤ S := le_trans (by positivity) hx
    calc Real.sqrt F.card * (‖opAvg (fun p => catProj A.G ap.Mc cat I g.1 (g.2 p)) x‖ /
          Real.sqrt (dyadicGridLength A.G I.1))
        ≤ Real.sqrt N * S := by
          gcongr
          exact (div_le_div_of_nonneg_right h2 hsq.le).trans hx

