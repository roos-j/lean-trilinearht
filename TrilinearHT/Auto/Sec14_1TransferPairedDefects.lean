      (fun k => hNmc e2 he2 _) (fun k => hNH _) hτ₂ hτ₂1 hHed _ hp hq hsel
      (by rw [Function.update_of_ne hca.symm, Function.update_self])
      (Function.update_self _ _ _)
      (by rw [Function.update_of_ne hcd.symm, Function.update_of_ne hda,
