/-- A catalog of columns born at the cells of `L` has at most the number of its columns born at
cells of `L` containing `I`, with rank at most `r`, as labels of rank at most `r` at `I`. -/
theorem card_catLabels_le {Tg : Type*} (G : RealDyadicGrid) (Mc : ℕ) (s : List (CatCol Tg))
    (I : ℤ × ℤ) (r : ℕ) (M : Tg → Prop) (L : Finset (ℤ × ℤ)) (hL : ∀ d ∈ s, d.birth ∈ L) :
    (catLabels G Mc s I r M).card ≤
      ∑ b ∈ (L.filter fun I' => dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G I'.1 I'.2) ×ˢ
          Finset.range (r + 1),
        (s.filter (fun d => decide (d.birth = b.1 ∧ d.rank = b.2))).length := by
  set P : CatCol Tg → Prop := fun d =>
    dyadicGridCell G I.1 I.2 ⊆ dyadicGridCell G d.birth.1 d.birth.2 ∧ d.rank ≤ r
  have h1 : (catLabels G Mc s I r M).card ≤
      ((Finset.range s.length).filter (fun j => ∃ hj : j < s.length, P s[j])).card := by
    refine Finset.card_le_card_of_injOn (fun n => (n : ℕ)) (fun n hn => ?_)
      (fun a _ b _ h => Fin.ext h)
    simp only [catLabels, Finset.coe_filter, Finset.mem_univ, true_and] at hn
    obtain ⟨hn, h1, h2, -⟩ := hn
    simp only [Finset.coe_filter, Finset.mem_range]
    exact ⟨hn, hn, h1, h2⟩
  rw [card_range_filter_getElem] at h1
  refine h1.trans ((length_filter_le_sum s (fun d => (d.birth, d.rank)) _ (fun d => decide (P d))
    fun d hd hP => ?_).trans (le_of_eq (Finset.sum_congr rfl fun b hb => ?_)))
  · simp only [decide_eq_true_eq] at hP
    simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_range]
    exact ⟨⟨hL d hd, hP.1⟩, by have := hP.2; omega⟩
  · congr 1
    refine List.filter_congr fun d _ => ?_
    simp only [Finset.mem_product, Finset.mem_filter, Finset.mem_range] at hb
    simp only [P, Prod.ext_iff, Bool.decide_and]
    by_cases h1 : d.birth = b.1 <;> by_cases h2 : d.rank = b.2 <;> simp only [h1, h2] <;>
      simp_all

theorem CatTest.pass_mono_order {Tg : Type*} (w : CatTest Tg) {G : RealDyadicGrid} {Mc : ℕ}
    {I : ℤ × ℤ} {c₀ c₁ : ℕ} {H : ℝ} {tagOf : Tg → ChartTag} {wI : ℝ × ℝ → ℂ} {τ : ℝ}
    {mH : ℕ} {cat : List (CatCol Tg)} (h : w.Pass G Mc I c₁ H tagOf wI τ mH cat) (hc : c₀ ≤ c₁) :
    w.Pass G Mc I c₀ H tagOf wI τ mH cat :=
  fun x hx _ _ _ hut hua hub hta htb hab A hA hAθ hAM hAq z hzu hzt hza hzb hza2 hzb2 =>
    h x hx hut hua hub hta htb hab A (quadraticChartComplexity_mono_order hA hc) hAθ hAM hAq z
      hzu hzt hza hzb hza2 hzb2

theorem sqrt_div_sq {K E n : ℝ} (hK : 0 ≤ K) (hn : 0 < n) :
    (Real.sqrt (K / n) / E) ^ 2 = K / n / E ^ 2 := by
  rw [div_pow, Real.sq_sqrt (div_nonneg hK hn.le)]

