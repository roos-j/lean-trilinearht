/-- A primitive vector is one whose coordinates have gcd one. -/
def PrimitiveIntegerVector {d : ℕ} (v : Fin d → ℤ) : Prop := Finset.univ.gcd v = 1

theorem primitiveIntegerVector_isUnimodular {d : ℕ} (v : Fin d → ℤ)
    (hv : PrimitiveIntegerVector v) : Module.IsUnimodular ℤ v := by
  classical
  let I : Ideal ℤ := Ideal.span (Set.range v)
  let g := Submodule.IsPrincipal.generator I
  have hg (i : Fin d) : g ∣ v i := by
    apply Ideal.mem_span_singleton.mp
    change v i ∈ Ideal.span {Submodule.IsPrincipal.generator I}
    rw [Ideal.span_singleton_generator]
    exact Ideal.subset_span ⟨i, rfl⟩
  have hgu : IsUnit g := isUnit_of_dvd_one (by
    rw [← hv]
    exact Finset.dvd_gcd (fun i _ => hg i))
  have hI : I = ⊤ := by
    rw [← Submodule.IsPrincipal.span_singleton_generator I]
    exact Ideal.span_singleton_eq_top.mpr hgu
  apply (Module.Basis.isUnimodular_iff_span_repr_eq_top
    (b := Pi.basisFun ℤ (Fin d))).mpr
  have hre : ((Pi.basisFun ℤ (Fin d)).repr v : Fin d → ℤ) = v :=
    funext (Pi.basisFun_repr ℤ (Fin d) v)
  rw [hre]
  exact hI

/-- Splitting off a vector on which an integral linear functional takes value one. -/
noncomputable def integerFunctionalSplit {d : ℕ} (v : Fin d → ℤ)
    (f : (Fin d → ℤ) →ₗ[ℤ] ℤ) (hf : f v = 1) :
    (ℤ × LinearMap.ker f) ≃ₗ[ℤ] (Fin d → ℤ) where
  toFun z := z.1 • v + z.2
  invFun x := (f x, ⟨x - f x • v, by
    rw [LinearMap.mem_ker, map_sub, map_smul, hf]
    simp⟩)
  left_inv := by
    rintro ⟨a, x⟩
    apply Prod.ext
    · simp only [map_add, map_smul, hf, LinearMap.mem_ker.mp x.property,
        smul_eq_mul, mul_one, add_zero]
    · apply Subtype.ext
      simp only [map_add, map_smul, hf, LinearMap.mem_ker.mp x.property,
        smul_eq_mul, mul_one, add_zero]
      abel
  right_inv := by intro x; simp
  map_add' := by
    rintro ⟨a, x⟩ ⟨b, y⟩
    simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, add_smul]
    abel
  map_smul' := by
    intro a z
    simp [smul_add, mul_assoc]

/-- Blueprint `lem:integer-basis`, primitive-vector assertion: every primitive vector
belongs to an integer basis of `ℤ^d`. -/
theorem primitiveIntegerVector_extends_basis {d : ℕ} (v : Fin d → ℤ)
    (hv : PrimitiveIntegerVector v) :
    ∃ b : Module.Basis (Fin d) ℤ (Fin d → ℤ), ∃ i, b i = v := by
  classical
  obtain ⟨f, hf⟩ := Module.isUnimodular_iff.mp (primitiveIntegerVector_isUnimodular v hv)
  let b := ((Module.Basis.singleton Unit ℤ).prod (Module.finBasis ℤ (LinearMap.ker f))).map
    (integerFunctionalSplit v f hf)
  have hcard : Fintype.card (Unit ⊕ Fin (Module.finrank ℤ (LinearMap.ker f))) = d := by
    rw [← Module.finrank_eq_card_basis b]
    simp
  let e := Fintype.equivFinOfCardEq hcard
  refine ⟨b.reindex e, e (Sum.inl ()), ?_⟩
  simp [b, integerFunctionalSplit, Module.Basis.prod_apply]

/-- Saturation in the integer lattice, as in `lem:integer-basis`. -/
def IntegerSaturated {d : ℕ} (L : Submodule ℤ (Fin d → ℤ)) : Prop :=
  ∀ n : ℤ, n ≠ 0 → ∀ v, n • v ∈ L → v ∈ L

theorem integerSaturated_quotient_torsionFree {d : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (hL : IntegerSaturated L) :
    Module.IsTorsionFree ℤ ((Fin d → ℤ) ⧸ L) := by
  apply Module.IsTorsionFree.of_smul_eq_zero
  intro n x hx
  by_cases hn : n = 0
  · exact Or.inl hn
  right
  obtain ⟨v, rfl⟩ := L.mkQ_surjective x
  apply (Submodule.Quotient.mk_eq_zero L).mpr
  apply hL n hn v
  apply (Submodule.Quotient.mk_eq_zero L).mp
  change L.mkQ (n • v) = 0
  rw [map_smul]
  exact hx

/-- The quotient of a saturated integer subgroup is free. -/
theorem integerSaturated_quotient_free {d : ℕ}
    (L : Submodule ℤ (Fin d → ℤ)) (hL : IntegerSaturated L) :
    Module.Free ℤ ((Fin d → ℤ) ⧸ L) := by
  let := integerSaturated_quotient_torsionFree L hL
  infer_instance

/-- A section of the quotient map splits an integer submodule from its quotient. -/
noncomputable def integerQuotientSplit {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (s : ((Fin d → ℤ) ⧸ L) →ₗ[ℤ] (Fin d → ℤ))
    (hs : L.mkQ ∘ₗ s = LinearMap.id) :
    (L × ((Fin d → ℤ) ⧸ L)) ≃ₗ[ℤ] (Fin d → ℤ) := by
  have hs' (x) : L.mkQ (s x) = x := LinearMap.congr_fun hs x
  exact
    { toFun := fun z => (z.1 : Fin d → ℤ) + s z.2
      invFun := fun x => (⟨x - s (L.mkQ x), by
        apply (Submodule.Quotient.mk_eq_zero L).mp
        change L.mkQ (x - s (L.mkQ x)) = 0
        rw [map_sub, hs', sub_self]⟩, L.mkQ x)
      left_inv := by
        rintro ⟨x, y⟩
        have hx : L.mkQ x = 0 := (Submodule.Quotient.mk_eq_zero L).mpr x.property
        apply Prod.ext
        · apply Subtype.ext
          simp [map_add, hx, hs']
        · simp [map_add, hx, hs']
      right_inv := by intro x; simp
      map_add' := by
        rintro ⟨x, y⟩ ⟨x', y'⟩
        simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, map_add]
        abel
      map_smul' := by
        intro a z
        simp only [Prod.smul_fst, Prod.smul_snd, Submodule.coe_smul, map_smul, smul_add,
          RingHom.id_apply] }

/-- Blueprint `lem:integer-basis`: a saturated subgroup is spanned by an initial
part of an integer basis. -/
theorem saturatedAdaptedBasis {d : ℕ} (L : Submodule ℤ (Fin d → ℤ))
    (hL : IntegerSaturated L) :
    ∃ r ≤ d, ∃ b : Module.Basis (Fin d) ℤ (Fin d → ℤ),
      Submodule.span ℤ (b '' {i | i.val < r}) = L := by
  classical
  let := integerSaturated_quotient_free L hL
  obtain ⟨s, hs⟩ := L.mkQ.exists_rightInverse_of_surjective
    (LinearMap.range_eq_top.mpr L.mkQ_surjective)
  let bL := Module.finBasis ℤ L
  let bQ := Module.finBasis ℤ ((Fin d → ℤ) ⧸ L)
  let b := (bL.prod bQ).map (integerQuotientSplit L s hs)
  have hdim : Module.finrank ℤ L + Module.finrank ℤ ((Fin d → ℤ) ⧸ L) = d := by
    have h := Module.finrank_eq_card_basis b
    simpa using h.symm
  let e : (Fin (Module.finrank ℤ L) ⊕ Fin (Module.finrank ℤ ((Fin d → ℤ) ⧸ L))) ≃
      Fin d := finSumFinEquiv.trans (finCongr hdim)
  have heL (i : Fin (Module.finrank ℤ L)) : (e (Sum.inl i)).val = i.val := by
    simp [e]
  have heQ (i : Fin (Module.finrank ℤ ((Fin d → ℤ) ⧸ L))) :
      (e (Sum.inr i)).val = Module.finrank ℤ L + i.val := by
    simp [e]
  refine ⟨Module.finrank ℤ L, by omega, b.reindex e, ?_⟩
  have hset : (b.reindex e) '' {i | i.val < Module.finrank ℤ L} =
      Set.range (fun i => (bL i : Fin d → ℤ)) := by
    ext x
    constructor
    · rintro ⟨i, hi, rfl⟩
      obtain ⟨j, rfl⟩ := e.surjective i
      cases j with
      | inl j =>
        exact ⟨j, by simp [b, integerQuotientSplit, Module.Basis.prod_apply]⟩
      | inr j =>
        have := heQ j
        simp only [Set.mem_ofPred_eq] at hi
        omega
    · rintro ⟨i, rfl⟩
      refine ⟨e (Sum.inl i), ?_, ?_⟩
      · simpa only [Set.mem_ofPred_eq, heL] using i.isLt
      · simp [b, integerQuotientSplit, Module.Basis.prod_apply]
  rw [hset]
  have hspan := (Submodule.span_val_image_eq_iff L (Set.range bL)).mpr bL.span_eq
  simpa only [← Set.range_comp, Function.comp_def] using hspan

/-- The coordinate inclusion of the integer lattice in its rational vector space. -/
def integerRationalMap (d : ℕ) : (Fin d → ℤ) →ₗ[ℤ] (Fin d → ℚ) where
  toFun v i := v i
  map_add' := by intros; ext; simp
  map_smul' := by intros; ext; simp

/-- Integer points of a rational subspace. -/
def rationalIntegerIntersection {d : ℕ} (V : Submodule ℚ (Fin d → ℚ)) :
    Submodule ℤ (Fin d → ℤ) :=
  (V.restrictScalars ℤ).comap (integerRationalMap d)

/-- Blueprint `lem:integer-basis`, last assertion: integer points in a rational
subspace form a saturated subgroup. -/
theorem rationalIntegerIntersection_saturated {d : ℕ}
    (V : Submodule ℚ (Fin d → ℚ)) : IntegerSaturated (rationalIntegerIntersection V) := by
  intro n hn v hv
  change integerRationalMap d (n • v) ∈ V at hv
  change integerRationalMap d v ∈ V
  have hnq : (n : ℚ) ≠ 0 := by exact_mod_cast hn
  have he : integerRationalMap d (n • v) = (n : ℚ) • integerRationalMap d v := by
    ext i
    simp [integerRationalMap]
  rw [he] at hv
  have h := V.smul_mem (n : ℚ)⁻¹ hv
  simpa only [smul_smul, inv_mul_cancel₀ hnq, one_smul] using h

/-- Blueprint `lem:reduced-basis`: bounded sets meet a discrete integer lattice
in finitely many points. -/
theorem lattice_bounded_inter_finite {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    (L : Submodule ℤ E) [DiscreteTopology L] {S : Set E}
    (hS : Bornology.IsBounded S) : (S ∩ (L : Set E)).Finite := by
  change (S ∩ L.toAddSubgroup).Finite
  have : DiscreteTopology L.toAddSubgroup := (inferInstance : DiscreteTopology L)
  exact Metric.finite_isBounded_inter_isClosed DiscreteTopology.isDiscrete hS inferInstance

/-- Blueprint `lem:reduced-basis`: every nonzero discrete lattice has a shortest
nonzero vector. -/
theorem lattice_exists_shortest {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E]
    (L : Submodule ℤ E) [DiscreteTopology L] (hL : L ≠ ⊥) :
    ∃ v ∈ L, v ≠ 0 ∧ ∀ w ∈ L, w ≠ 0 → ‖v‖ ≤ ‖w‖ := by
  classical
  obtain ⟨u, huL, hu⟩ := L.ne_bot_iff.mp hL
  let S : Set E := (Metric.closedBall 0 ‖u‖ ∩ (L : Set E)) \ {0}
  have hS : S.Finite := (lattice_bounded_inter_finite L
    (Metric.isBounded_closedBall (x := (0 : E)) (r := ‖u‖))).sdiff
  have huS : u ∈ S := by simp [S, huL, hu, Metric.mem_closedBall, dist_zero_right]
  obtain ⟨v, hv, hmin⟩ := Set.exists_min_image S (fun x => ‖x‖) hS ⟨u, huS⟩
  refine ⟨v, hv.1.2, ?_, ?_⟩
  · simpa only [Set.mem_singleton_iff] using hv.2
  · intro w hwL hw
    by_cases hwB : ‖w‖ ≤ ‖u‖
    · apply hmin w
      simp [S, hwL, hw, Metric.mem_closedBall, dist_zero_right, hwB]
    · exact (hmin u huS).trans (le_of_not_ge hwB)

/-- A shortest nonzero lattice vector has primitive coordinates in every
integer basis (`lem:reduced-basis`, first proof paragraph). -/
theorem lattice_shortest_coordinates_primitive {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {L : Submodule ℤ E} {d : ℕ}
    (b : Module.Basis (Fin d) ℤ L) (v : L) (hv : v ≠ 0)
    (hshort : ∀ w : L, w ≠ 0 → ‖(v : E)‖ ≤ ‖(w : E)‖) :
    PrimitiveIntegerVector (b.equivFun v) := by
  classical
  have hc : b.equivFun v ≠ 0 := by simpa using hv
  obtain ⟨i, hi⟩ := Function.ne_iff.mp hc
  let g := Finset.univ.gcd (b.equivFun v)
  obtain ⟨w, hw, _⟩ := Finset.extract_gcd (s := Finset.univ) (b.equivFun v)
    ⟨i, Finset.mem_univ i⟩
  let u := b.equivFun.symm w
  have hvu : v = g • u := by
    apply b.equivFun.injective
    rw [map_smul]
    change b.equivFun v = g • b.equivFun (b.equivFun.symm w)
    rw [LinearEquiv.apply_symm_apply]
    ext j
    exact hw j (Finset.mem_univ j)
  have hu : u ≠ 0 := by intro h; apply hv; simpa only [h, smul_zero] using hvu
  have hg0 : g ≠ 0 := by intro h; apply hv; simpa only [h, zero_smul] using hvu
  have huE : (u : E) ≠ 0 := by exact_mod_cast hu
  have hnorm : ‖(v : E)‖ = |(g : ℝ)| * ‖(u : E)‖ := by
    rw [hvu, Submodule.coe_smul, norm_zsmul ℝ, Real.norm_eq_abs]
  have hgle : |(g : ℝ)| ≤ 1 := by
    have h := hshort u hu
    rw [hnorm] at h
    nlinarith [norm_pos_iff.mpr huE]
  have habsle : |g| ≤ 1 := by exact_mod_cast hgle
  have habs : |g| = 1 := by
    have := abs_pos.mpr hg0
    omega
  change g = 1
  calc g = |g| := (Int.abs_eq_normalize g |>.trans Finset.normalize_gcd).symm
       _ = 1 := habs

/-- A shortest nonzero lattice vector belongs to an integer basis. -/
theorem lattice_shortest_extends_basis {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {L : Submodule ℤ E} {d : ℕ}
    (b : Module.Basis (Fin d) ℤ L) (v : L) (hv : v ≠ 0)
    (hshort : ∀ w : L, w ≠ 0 → ‖(v : E)‖ ≤ ‖(w : E)‖) :
    ∃ c : Module.Basis (Fin d) ℤ L, ∃ i, c i = v := by
  obtain ⟨c, i, hi⟩ := primitiveIntegerVector_extends_basis (b.equivFun v)
    (lattice_shortest_coordinates_primitive b v hv hshort)
  refine ⟨c.map b.equivFun.symm, i, ?_⟩
  simp [hi]

/-- The span of all but the first vector of a finite basis. -/
abbrev basisTailSpan {E : Type*} [AddCommGroup E] [Module ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) : Submodule ℝ E :=
  Submodule.span ℝ (Set.range (fun i : Fin n => b i.succ))

theorem basisTailSpan_isCompl {E : Type*} [AddCommGroup E] [Module ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) :
    IsCompl (Submodule.span ℝ {b 0}) (basisTailSpan b) := by
  classical
  have hset : b '' ({0}ᶜ : Set (Fin (n + 1))) =
      Set.range (fun i : Fin n => b i.succ) := by
    ext x
    constructor
    · rintro ⟨i, hi, rfl⟩
      obtain ⟨j, rfl⟩ := Fin.exists_succ_eq_of_ne_zero (by simpa using hi)
      exact ⟨j, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨i.succ, by simp, rfl⟩
  have h := b.linearIndependent.isCompl_span_image b.span_eq
    (isCompl_compl : IsCompl ({0} : Set (Fin (n + 1))) {0}ᶜ)
  simpa only [Set.image_singleton, hset, basisTailSpan] using h

/-- The tail-span complement is linearly equivalent to the perpendicular space
by orthogonal projection. -/
noncomputable def basisTailOrthogonalEquiv {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) :
    basisTailSpan b ≃ₗ[ℝ] (Submodule.span ℝ {b 0})ᗮ :=
  ((Submodule.span ℝ {b 0}).quotientEquivOfIsCompl (basisTailSpan b)
    (basisTailSpan_isCompl b)).symm.trans
      (Submodule.span ℝ {b 0}).quotientEquivOrthogonal.toLinearEquiv

theorem basisTailOrthogonalEquiv_apply {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) (x : basisTailSpan b) :
    basisTailOrthogonalEquiv b x =
      (Submodule.span ℝ {b 0})ᗮ.orthogonalProjectionOnto x := by
  apply Subtype.ext
  simp [basisTailOrthogonalEquiv, Submodule.orthogonalProjectionOnto, Submodule.projectionOntoL,
    Submodule.orthogonal_orthogonal]

/-- The projected tail of a real basis is a basis of the perpendicular space. -/
noncomputable def projectedTailBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) :
    Module.Basis (Fin n) ℝ (Submodule.span ℝ {b 0})ᗮ :=
  (Module.Basis.span (b.linearIndependent.comp Fin.succ (Fin.succ_injective n))).map
    (basisTailOrthogonalEquiv b)

theorem projectedTailBasis_apply {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) (i : Fin n) :
    projectedTailBasis b i = (Submodule.span ℝ {b 0})ᗮ.orthogonalProjectionOnto (b i.succ) := by
  simpa only [projectedTailBasis, Module.Basis.map_apply, Module.Basis.span_apply,
    Function.comp_apply] using basisTailOrthogonalEquiv_apply b
      ⟨b i.succ, Submodule.subset_span ⟨i, rfl⟩⟩

/-- The full lattice generated by the projected tail basis. -/
noncomputable abbrev projectedLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) :
    Submodule ℤ (Submodule.span ℝ {b 0})ᗮ :=
  Submodule.span ℤ (Set.range (projectedTailBasis b))

instance projectedLattice_discrete {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) : DiscreteTopology (projectedLattice b) := by
  unfold projectedLattice
  infer_instance

instance projectedLattice_isZLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) : IsZLattice ℝ (projectedLattice b) := by
  unfold projectedLattice
  infer_instance

/-- Blueprint `lem:reduced-basis`: projecting off the first basis vector gives
exactly the full lattice generated by the projected remaining vectors. -/
theorem projectedLattice_eq_map {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) :
    (Submodule.span ℤ (Set.range b)).map
      ((Submodule.span ℝ {b 0})ᗮ.orthogonalProjectionOnto.toLinearMap.restrictScalars ℤ) =
      projectedLattice b := by
  let P := Submodule.span ℝ {b 0}
  let f := Pᗮ.orthogonalProjectionOnto.toLinearMap.restrictScalars ℤ
  have hf0 : f (b 0) = 0 := by
    change Pᗮ.orthogonalProjectionOnto (b 0) = 0
    apply Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr
    rw [Submodule.orthogonal_orthogonal]
    exact Submodule.subset_span (Set.mem_singleton _)
  change (Submodule.span ℤ (Set.range b)).map f = _
  rw [Submodule.map_span]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨_, ⟨i, rfl⟩, rfl⟩
    refine Fin.cases ?_ (fun j => ?_) i
    · rw [hf0]
      exact Submodule.zero_mem _
    · change f (b j.succ) ∈ Submodule.span ℤ (Set.range (projectedTailBasis b))
      rw [show f (b j.succ) = projectedTailBasis b j from (projectedTailBasis_apply b j).symm]
      exact Submodule.subset_span ⟨j, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    apply Submodule.subset_span
    exact ⟨b i.succ, ⟨i.succ, rfl⟩, (projectedTailBasis_apply b i).symm⟩

/-- Integer coordinates split into the first coordinate and the projected lattice. -/
noncomputable def latticeLiftEquiv {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) :
    (ℤ × projectedLattice b) ≃ₗ[ℤ] Submodule.span ℤ (Set.range b) :=
  ((LinearEquiv.refl ℤ ℤ).prodCongr
    ((projectedTailBasis b).restrictScalars ℤ).equivFun).trans
      ((Fin.consLinearEquiv ℤ (fun _ : Fin (n + 1) => ℤ)).trans
        (b.restrictScalars ℤ).equivFun.symm)

theorem latticeLiftEquiv_coe {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) (a : ℤ) (x : projectedLattice b) :
    (latticeLiftEquiv b (a, x) : E) = a • b 0 +
      ∑ i : Fin n, ((projectedTailBasis b).restrictScalars ℤ).repr x i • b i.succ := by
  simp [latticeLiftEquiv, Fin.sum_univ_succ, Module.Basis.restrictScalars_apply]

theorem latticeLiftEquiv_projection {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) (a : ℤ) (x : projectedLattice b) :
    (Submodule.span ℝ {b 0})ᗮ.orthogonalProjectionOnto (latticeLiftEquiv b (a, x) : E) = x := by
  let P := Submodule.span ℝ {b 0}
  have h0 : Pᗮ.orthogonalProjectionOnto (b 0) = 0 := by
    apply Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr
    rw [Submodule.orthogonal_orthogonal]
    exact Submodule.subset_span (Set.mem_singleton _)
  rw [latticeLiftEquiv_coe, map_add, map_zsmul, h0, smul_zero, zero_add, map_sum]
  simp only [map_zsmul, ← projectedTailBasis_apply]
  have h := congrArg (fun y : projectedLattice b => (y : Pᗮ))
    (((projectedTailBasis b).restrictScalars ℤ).sum_repr x)
  simpa only [Submodule.coe_sum, Submodule.coe_smul, Module.Basis.restrictScalars_apply] using h

def headTailIndex (n : ℕ) : Fin 1 ⊕ Fin n ≃ Fin (n + 1) :=
  finSumFinEquiv.trans (finCongr (Nat.add_comm 1 n))

theorem headTailIndex_zero (n : ℕ) : headTailIndex n (Sum.inl 0) = 0 := by
  apply Fin.ext
  simp [headTailIndex]

theorem headTailIndex_succ {n : ℕ} (i : Fin n) : headTailIndex n (Sum.inr i) = i.succ := by
  apply Fin.ext
  simp [headTailIndex]

/-- Lift any integer basis of the projected lattice, keeping the original first vector. -/
noncomputable def liftedIntegerBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) :
    Module.Basis (Fin (n + 1)) ℤ (Submodule.span ℤ (Set.range b)) :=
  (((Module.Basis.singleton (Fin 1) ℤ).prod c).map (latticeLiftEquiv b)).reindex
    (headTailIndex n)

theorem liftedIntegerBasis_zero {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) :
    (liftedIntegerBasis b c 0 : E) = b 0 := by
  conv_lhs => rw [← headTailIndex_zero n]
  simp [liftedIntegerBasis, Module.Basis.prod_apply, latticeLiftEquiv_coe]

theorem liftedIntegerBasis_projection {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (i : Fin n) :
    (Submodule.span ℝ {b 0})ᗮ.orthogonalProjectionOnto
      (liftedIntegerBasis b c i.succ : E) = c i := by
  rw [← headTailIndex_succ i]
  simp [liftedIntegerBasis, Module.Basis.prod_apply, latticeLiftEquiv_projection]

/-- Choose a lattice basis whose first vector is shortest nonzero. -/
theorem exists_shortest_first_basis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) :
    ∃ c : Module.Basis (Fin (n + 1)) ℝ E,
      Submodule.span ℤ (Set.range c) = Submodule.span ℤ (Set.range b) ∧
      ∀ w ∈ Submodule.span ℤ (Set.range b), w ≠ 0 → ‖c 0‖ ≤ ‖w‖ := by
  classical
  let L := Submodule.span ℤ (Set.range b)
  have hL : L ≠ ⊥ := L.ne_bot_iff.mpr
    ⟨b 0, Submodule.subset_span ⟨0, rfl⟩, b.ne_zero 0⟩
  obtain ⟨v, hvL, hv, hshort⟩ := lattice_exists_shortest L hL
  have hv' : (⟨v, hvL⟩ : L) ≠ 0 := by
    intro h
    exact hv (congrArg (fun x : L => (x : E)) h)
  obtain ⟨c, i, hi⟩ := lattice_shortest_extends_basis (b.restrictScalars ℤ)
    ⟨v, hvL⟩ hv' (fun w hw => hshort w w.property (by exact_mod_cast hw))
  let c' := c.reindex (Equiv.swap 0 i)
  have hc0 : c' 0 = ⟨v, hvL⟩ := by simpa [c'] using hi
  refine ⟨c'.ofZLatticeBasis ℝ L, c'.ofZLatticeBasis_span ℝ, ?_⟩
  intro w hw hw0
  simpa only [Module.Basis.ofZLatticeBasis_apply, hc0] using hshort w hw hw0

/-- The real span of the vectors preceding an index. -/
abbrev basisPrefixSpan {E : Type*} [AddCommGroup E] [Module ℝ E] {n : ℕ}
    (f : Fin n → E) (i : Fin n) : Submodule ℝ E :=
  Submodule.span ℝ (f '' Set.Iio i)

/-- Orthogonal projection off the preceding vectors. -/
noncomputable def basisRemainder {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (f : Fin n → E) (i : Fin n) : E →L[ℝ] E :=
  (basisPrefixSpan f i)ᗮ.starProjection

theorem gramSchmidt_eq_basisRemainder {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (f : Fin n → E) (i : Fin n) :
    InnerProductSpace.gramSchmidt ℝ f i = basisRemainder f i (f i) := by
  apply Eq.symm
  apply Submodule.eq_starProjection_of_mem_orthogonal
  · apply (Submodule.mem_orthogonal' _ _).mpr
    intro x hx
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨j, hj, rfl⟩ := hx
      exact InnerProductSpace.gramSchmidt_inv_triangular ℝ f hj
    | zero => simp
    | add x y _ _ hx hy => simp [inner_add_right, hx, hy]
    | smul a x _ hx => simp [inner_smul_right, hx]
  · rw [Submodule.orthogonal_orthogonal]
    rw [InnerProductSpace.gramSchmidt_def, sub_sub_cancel]
    apply Submodule.sum_mem
    intro j hj
    rw [Submodule.starProjection_singleton]
    apply Submodule.smul_mem
    have hji : j < i := Finset.mem_Iio.mp hj
    exact Submodule.span_mono (Set.image_mono (Set.Iic_subset_Iio.mpr hji))
      (InnerProductSpace.gramSchmidt_mem_span ℝ f (le_refl j))

/-- Every Gram–Schmidt vector is shortest nonzero in its projected lattice. -/
def IsShortestProjectionBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) : Prop :=
  ∀ i, ∀ x ∈ Submodule.span ℤ (Set.range b), basisRemainder b i x ≠ 0 →
    ‖basisRemainder b i (b i)‖ ≤ ‖basisRemainder b i x‖

/-- Projecting off a subspace and then off a subspace of its perpendicular
space agrees with the corresponding single orthogonal projection. -/
theorem starProjection_sup_subtype {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (P : Submodule ℝ E) (S : Submodule ℝ Pᗮ) (x : E) :
    (P ⊔ S.map Pᗮ.subtype)ᗮ.starProjection x =
      ((Sᗮ.starProjection (Pᗮ.orthogonalProjectionOnto x) : Pᗮ) : E) := by
  let px := Pᗮ.orthogonalProjectionOnto x
  let y := Sᗮ.starProjection px
  have hyS : y ∈ Sᗮ := Submodule.starProjection_apply_mem _ _
  have hxp : x - (px : E) ∈ P := by
    simpa only [Submodule.orthogonal_orthogonal, Submodule.starProjection_apply, px] using
      (Submodule.sub_starProjection_mem_orthogonal (K := Pᗮ) x)
  have hpy : px - y ∈ S := by
    simpa only [Submodule.orthogonal_orthogonal] using
      (Submodule.sub_starProjection_mem_orthogonal (K := Sᗮ) px)
  apply Submodule.eq_starProjection_of_mem_orthogonal
  · apply (Submodule.mem_orthogonal' _ _).mpr
    intro z hz
    obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.mp hz
    obtain ⟨v, hvS, rfl⟩ := Submodule.mem_map.mp hv
    rw [inner_add_right]
    have h₁ : inner ℝ (y : E) u = 0 := Submodule.inner_left_of_mem_orthogonal hu y.property
    have h₂ : inner ℝ (y : E) (v : E) = 0 :=
      (Submodule.mem_orthogonal' S y).mp hyS v hvS
    exact (congrArg₂ (· + ·) h₁ h₂).trans (zero_add 0)
  · rw [Submodule.orthogonal_orthogonal]
    exact Submodule.mem_sup.mpr ⟨x - (px : E), hxp, (px : E) - (y : E),
      Submodule.mem_map.mpr ⟨px - y, hpy, rfl⟩, by abel⟩

theorem basisPrefixSpan_succ {E : Type*} [AddCommGroup E] [Module ℝ E] {n : ℕ}
    (f : Fin (n + 1) → E) (i : Fin n) :
    basisPrefixSpan f i.succ = Submodule.span ℝ {f 0} ⊔
      basisPrefixSpan (fun j => f j.succ) i := by
  have hset : f '' Set.Iio i.succ = {f 0} ∪ (fun j => f j.succ) '' Set.Iio i := by
    ext x
    constructor
    · rintro ⟨j, hj, rfl⟩
      obtain rfl | ⟨j, rfl⟩ := Fin.eq_zero_or_eq_succ j
      · exact Or.inl rfl
      · exact Or.inr ⟨j, Fin.succ_lt_succ_iff.mp hj, rfl⟩
    · rintro (h | ⟨j, hj, rfl⟩)
      · exact ⟨0, Fin.succ_pos i, h.symm⟩
      · exact ⟨j.succ, Fin.succ_lt_succ_iff.mpr hj, rfl⟩
  change Submodule.span ℝ (f '' Set.Iio i.succ) = _
  rw [hset, Submodule.span_union]

theorem sup_eq_sup_projected {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (P R : Submodule ℝ E) :
    P ⊔ R = P ⊔ (R.map Pᗮ.orthogonalProjectionOnto.toLinearMap).map Pᗮ.subtype := by
  have hdiff (x : E) : x - (Pᗮ.orthogonalProjectionOnto x : E) ∈ P := by
    simpa only [Submodule.orthogonal_orthogonal, Submodule.starProjection_apply] using
      (Submodule.sub_starProjection_mem_orthogonal (K := Pᗮ) x)
  apply le_antisymm
  · refine sup_le le_sup_left ?_
    intro x hx
    exact Submodule.mem_sup.mpr ⟨x - (Pᗮ.orthogonalProjectionOnto x : E), hdiff x,
      (Pᗮ.orthogonalProjectionOnto x : E),
      Submodule.mem_map.mpr ⟨Pᗮ.orthogonalProjectionOnto x,
        Submodule.mem_map.mpr ⟨x, hx, rfl⟩, rfl⟩, sub_add_cancel _ _⟩
  · refine sup_le le_sup_left ?_
    rintro x ⟨y, ⟨z, hz, rfl⟩, rfl⟩
    have h := (P ⊔ R).sub_mem ((show R ≤ P ⊔ R from le_sup_right) hz)
      ((show P ≤ P ⊔ R from le_sup_left) (hdiff z))
    simpa only [sub_sub_cancel, Submodule.subtype_apply,
      ContinuousLinearMap.coe_coe] using h

theorem basisRemainder_succ {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (f : Fin (n + 1) → E) (P : Submodule ℝ E) (hP : Submodule.span ℝ {f 0} = P)
    (i : Fin n) (x : E) :
    basisRemainder f i.succ x =
      ((basisRemainder (fun j => Pᗮ.orthogonalProjectionOnto (f j.succ)) i
        (Pᗮ.orthogonalProjectionOnto x) : Pᗮ) : E) := by
  have hmap : (basisPrefixSpan (fun j : Fin n => f j.succ) i).map
      Pᗮ.orthogonalProjectionOnto.toLinearMap =
      basisPrefixSpan (fun j => Pᗮ.orthogonalProjectionOnto (f j.succ)) i := by
    rw [Submodule.map_span]
    congr 1
    exact Set.image_image _ _ _
  have hspan : basisPrefixSpan f i.succ = P ⊔
      (basisPrefixSpan (fun j => Pᗮ.orthogonalProjectionOnto (f j.succ)) i).map Pᗮ.subtype := by
    rw [basisPrefixSpan_succ, hP, sup_eq_sup_projected P, hmap]
  simpa only [basisRemainder, hspan] using starProjection_sup_subtype P
    (basisPrefixSpan (fun j => Pᗮ.orthogonalProjectionOnto (f j.succ)) i) x

@[simp] theorem basisRemainder_zero {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (f : Fin (n + 1) → E) (x : E) : basisRemainder f 0 x = x := by
  simp only [basisRemainder, basisPrefixSpan, show (0 : Fin (n + 1)) = ⊥ from rfl,
    Set.Iio_bot, Set.image_empty, Submodule.span_empty]
  apply Submodule.starProjection_eq_self_iff.mpr
  simp

/-- Blueprint `lem:reduced-basis`, shortest-projection construction before size
reduction: every full lattice admits a basis shortest at every projection stage. -/
theorem exists_shortestProjectionBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    ∃ c : Module.Basis (Fin n) ℝ E,
      Submodule.span ℤ (Set.range c) = Submodule.span ℤ (Set.range b) ∧
      IsShortestProjectionBasis c := by
  classical
  induction n generalizing E with
  | zero => exact ⟨b, rfl, fun i => Fin.elim0 i⟩
  | succ n ih =>
    obtain ⟨b₁, hb₁, hshort⟩ := exists_shortest_first_basis b
    let P := Submodule.span ℝ {b₁ 0}
    obtain ⟨d, hd, hdshort⟩ := ih (projectedTailBasis b₁)
    let dZ := (d.restrictScalars ℤ).map (LinearEquiv.ofEq _ _ hd)
    let cZ := liftedIntegerBasis b₁ dZ
    let c := cZ.ofZLatticeBasis ℝ (Submodule.span ℤ (Set.range b₁))
    have hcspan : Submodule.span ℤ (Set.range c) = Submodule.span ℤ (Set.range b₁) :=
      cZ.ofZLatticeBasis_span ℝ
    have hc0 : c 0 = b₁ 0 := by
      change cZ.ofZLatticeBasis ℝ (Submodule.span ℤ (Set.range b₁)) 0 = b₁ 0
      rw [Module.Basis.ofZLatticeBasis_apply]
      exact liftedIntegerBasis_zero b₁ dZ
    have hcproj (i : Fin n) : Pᗮ.orthogonalProjectionOnto (c i.succ) = d i := by
      change Pᗮ.orthogonalProjectionOnto
        (cZ.ofZLatticeBasis ℝ (Submodule.span ℤ (Set.range b₁)) i.succ) = d i
      rw [Module.Basis.ofZLatticeBasis_apply]
      rw [liftedIntegerBasis_projection]
      simp [dZ, Module.Basis.map_apply, Module.Basis.restrictScalars_apply]
    refine ⟨c, hcspan.trans hb₁, ?_⟩
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · intro x hx hx0
      simp only [basisRemainder_zero] at hx0 ⊢
      rw [hc0]
      exact hshort x (by simpa only [hcspan, hb₁] using hx) hx0
    · intro x hx hx0
      have hrem (y : E) : basisRemainder c j.succ y =
          ((basisRemainder d j (Pᗮ.orthogonalProjectionOnto y) : Pᗮ) : E) := by
        have h := basisRemainder_succ c P (by rw [hc0]) j y
        simpa only [hcproj] using h
      have hxP : Pᗮ.orthogonalProjectionOnto x ∈ Submodule.span ℤ (Set.range d) := by
        rw [hd]
        change Pᗮ.orthogonalProjectionOnto x ∈ projectedLattice b₁
        rw [← projectedLattice_eq_map b₁]
        exact Submodule.mem_map.mpr ⟨x, hcspan ▸ hx, rfl⟩
      have hxP0 : basisRemainder d j (Pᗮ.orthogonalProjectionOnto x) ≠ 0 := by
        intro h
        apply hx0
        rw [hrem, h, Submodule.coe_zero]
      have h := hdshort j _ hxP hxP0
      simpa only [hrem, hcproj, Submodule.norm_coe] using h

/-- An integral shear subtracting a linear functional from the first coordinate. -/
def integerUpperShear {M : Type*} [AddCommGroup M] (f : M →ₗ[ℤ] ℤ) :
    (ℤ × M) ≃ₗ[ℤ] (ℤ × M) :=
  ((LinearEquiv.prodComm ℤ ℤ M).trans
    ((LinearEquiv.refl ℤ M).skewProd (LinearEquiv.refl ℤ ℤ) (-f))).trans
      (LinearEquiv.prodComm ℤ M ℤ)

@[simp] theorem integerUpperShear_apply {M : Type*} [AddCommGroup M]
    (f : M →ₗ[ℤ] ℤ) (a : ℤ) (x : M) : integerUpperShear f (a, x) = (a - f x, x) := by
  simp [integerUpperShear, sub_eq_add_neg]

noncomputable def shiftedLatticeLiftEquiv {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (k : Fin n → ℤ) :
    (ℤ × projectedLattice b) ≃ₗ[ℤ] Submodule.span ℤ (Set.range b) :=
  (integerUpperShear (c.constr ℤ k)).trans (latticeLiftEquiv b)

/-- Integral changes of the first coefficients of the lifted basis. -/
noncomputable def shiftedIntegerBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (k : Fin n → ℤ) :
    Module.Basis (Fin (n + 1)) ℤ (Submodule.span ℤ (Set.range b)) :=
  (((Module.Basis.singleton (Fin 1) ℤ).prod c).map
    (shiftedLatticeLiftEquiv b c k)).reindex (headTailIndex n)

theorem shiftedIntegerBasis_zero {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (k : Fin n → ℤ) :
    (shiftedIntegerBasis b c k 0 : E) = b 0 := by
  conv_lhs => rw [← headTailIndex_zero n]
  simp [shiftedIntegerBasis, Module.Basis.prod_apply, shiftedLatticeLiftEquiv,
    latticeLiftEquiv_coe]

theorem shiftedIntegerBasis_succ {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (k : Fin n → ℤ) (i : Fin n) :
    (shiftedIntegerBasis b c k i.succ : E) =
      (liftedIntegerBasis b c i.succ : E) - k i • b 0 := by
  rw [← headTailIndex_succ i]
  simp [shiftedIntegerBasis, liftedIntegerBasis, Module.Basis.prod_apply,
    shiftedLatticeLiftEquiv, latticeLiftEquiv_coe, sub_eq_add_neg, add_comm]

theorem shiftedIntegerBasis_projection {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (k : Fin n → ℤ) (i : Fin n) :
    (Submodule.span ℝ {b 0})ᗮ.orthogonalProjectionOnto
      (shiftedIntegerBasis b c k i.succ : E) = c i := by
  rw [shiftedIntegerBasis_succ, map_sub, map_zsmul,
    Submodule.orthogonalProjectionOnto_orthogonalComplement_singleton_eq_zero,
    smul_zero, sub_zero, liftedIntegerBasis_projection]

/-- The Gram–Schmidt coefficient used in the size-reduction step. -/
noncomputable def gramCoefficient {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (f : Fin n → E) (i j : Fin n) : ℝ :=
  inner ℝ (InnerProductSpace.gramSchmidt ℝ f i) (f j) /
    ‖InnerProductSpace.gramSchmidt ℝ f i‖ ^ 2

def IsSizeReducedBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) : Prop :=
  ∀ i j, i < j → |gramCoefficient b i j| ≤ 1 / 2

theorem gramSchmidt_succ_of_projection {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (f : Fin (n + 1) → E) (P : Submodule ℝ E) (hP : Submodule.span ℝ {f 0} = P)
    (g : Fin n → Pᗮ) (hg : ∀ j, Pᗮ.orthogonalProjectionOnto (f j.succ) = g j) (i : Fin n) :
    InnerProductSpace.gramSchmidt ℝ f i.succ =
      ((InnerProductSpace.gramSchmidt ℝ g i : Pᗮ) : E) := by
  rw [gramSchmidt_eq_basisRemainder, gramSchmidt_eq_basisRemainder]
  simpa only [hg] using basisRemainder_succ f P hP i (f i.succ)

theorem gramCoefficient_succ_of_projection {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (f : Fin (n + 1) → E) (P : Submodule ℝ E) (hP : Submodule.span ℝ {f 0} = P)
    (g : Fin n → Pᗮ) (hg : ∀ j, Pᗮ.orthogonalProjectionOnto (f j.succ) = g j) (i j : Fin n) :
    gramCoefficient f i.succ j.succ = gramCoefficient g i j := by
  unfold gramCoefficient
  rw [gramSchmidt_succ_of_projection f P hP g hg i, Submodule.norm_coe,
    ← Submodule.inner_orthogonalProjectionOnto_eq_of_mem_left, hg]

noncomputable def roundedLiftShift {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (i : Fin n) : ℤ :=
  round (inner ℝ (b 0) (liftedIntegerBasis b c i.succ : E) / ‖b 0‖ ^ 2)

/-- Lift a projected lattice basis and reduce its first Gram–Schmidt coefficients
by subtracting nearest integer multiples of the first vector. -/
noncomputable def roundedLiftBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) :
    Module.Basis (Fin (n + 1)) ℝ E :=
  (shiftedIntegerBasis b c (roundedLiftShift b c)).ofZLatticeBasis ℝ
    (Submodule.span ℤ (Set.range b))

theorem roundedLiftBasis_span {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) :
    Submodule.span ℤ (Set.range (roundedLiftBasis b c)) =
      Submodule.span ℤ (Set.range b) :=
  (shiftedIntegerBasis b c (roundedLiftShift b c)).ofZLatticeBasis_span ℝ

theorem roundedLiftBasis_zero {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) : roundedLiftBasis b c 0 = b 0 := by
  simp only [roundedLiftBasis, Module.Basis.ofZLatticeBasis_apply, shiftedIntegerBasis_zero]

theorem roundedLiftBasis_projection {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (i : Fin n) :
    (Submodule.span ℝ {b 0})ᗮ.orthogonalProjectionOnto (roundedLiftBasis b c i.succ) = c i := by
  simp only [roundedLiftBasis, Module.Basis.ofZLatticeBasis_apply, shiftedIntegerBasis_projection]

theorem roundedLiftBasis_coefficient_zero {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (i : Fin n) :
    |gramCoefficient (roundedLiftBasis b c) 0 i.succ| ≤ 1 / 2 := by
  have hgs : InnerProductSpace.gramSchmidt ℝ (roundedLiftBasis b c) 0 = b 0 := by
    rw [show (0 : Fin (n + 1)) = ⊥ from rfl, InnerProductSpace.gramSchmidt_bot]
    exact roundedLiftBasis_zero b c
  have hnorm : ‖b 0‖ ^ 2 ≠ 0 := pow_ne_zero _ (norm_ne_zero_iff.mpr (b.ne_zero 0))
  unfold gramCoefficient
  rw [hgs]
  simp only [roundedLiftBasis, Module.Basis.ofZLatticeBasis_apply, shiftedIntegerBasis_succ,
    inner_sub_right, ← Int.cast_smul_eq_zsmul ℝ, real_inner_smul_right,
    real_inner_self_eq_norm_sq, sub_div]
  rw [mul_div_cancel_right₀ _ hnorm]
  exact abs_sub_round _

theorem projectedTailBasis_isShortest {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E) (hb : IsShortestProjectionBasis b) :
    IsShortestProjectionBasis (projectedTailBasis b) := by
  let P := Submodule.span ℝ {b 0}
  have hrem (i : Fin n) (y : E) : basisRemainder b i.succ y =
      ((basisRemainder (projectedTailBasis b) i (Pᗮ.orthogonalProjectionOnto y) : Pᗮ) : E) := by
    have he : (fun j : Fin n => Pᗮ.orthogonalProjectionOnto (b j.succ)) =
        projectedTailBasis b := funext fun j => (projectedTailBasis_apply b j).symm
    simpa only [he] using basisRemainder_succ b P rfl i y
  intro i x hx hx0
  change x ∈ projectedLattice b at hx
  rw [← projectedLattice_eq_map b] at hx
  obtain ⟨y, hy, hxy⟩ := Submodule.mem_map.mp hx
  have hxy' : Pᗮ.orthogonalProjectionOnto y = x := hxy
  have hy0 : basisRemainder b i.succ y ≠ 0 := by
    rw [hrem, hxy']
    exact_mod_cast hx0
  have h := hb i.succ y hy hy0
  simpa only [hrem, projectedTailBasis_apply, hxy', Submodule.norm_coe] using h

/-- Recursive integer size reduction retains shortestness in every projected
lattice and places all earlier Gram–Schmidt coefficients in `[-1/2,1/2]`. -/
theorem exists_sizeReducedShortestBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b) :
    ∃ c : Module.Basis (Fin n) ℝ E,
      Submodule.span ℤ (Set.range c) = Submodule.span ℤ (Set.range b) ∧
      IsShortestProjectionBasis c ∧ IsSizeReducedBasis c := by
  classical
  induction n generalizing E with
  | zero => exact ⟨b, rfl, hb, fun i => Fin.elim0 i⟩
  | succ n ih =>
    let P := Submodule.span ℝ {b 0}
    obtain ⟨d, hd, hdshort, hdsize⟩ := ih (projectedTailBasis b)
      (projectedTailBasis_isShortest b hb)
    let dZ := (d.restrictScalars ℤ).map (LinearEquiv.ofEq _ _ hd)
    let c := roundedLiftBasis b dZ
    have hcspan : Submodule.span ℤ (Set.range c) = Submodule.span ℤ (Set.range b) :=
      roundedLiftBasis_span b dZ
    have hc0 : c 0 = b 0 := roundedLiftBasis_zero b dZ
    have hcproj (i : Fin n) : Pᗮ.orthogonalProjectionOnto (c i.succ) = d i := by
      rw [roundedLiftBasis_projection]
      simp [dZ, Module.Basis.map_apply, Module.Basis.restrictScalars_apply]
    refine ⟨c, hcspan, ?_, ?_⟩
    · intro i
      refine Fin.cases ?_ (fun j => ?_) i
      · intro x hx hx0
        have h := hb 0 x (hcspan ▸ hx)
        simp only [basisRemainder_zero] at hx0 h ⊢
        rw [hc0]
        exact h hx0
      · intro x hx hx0
        have hrem (y : E) : basisRemainder c j.succ y =
            ((basisRemainder d j (Pᗮ.orthogonalProjectionOnto y) : Pᗮ) : E) := by
          simpa only [hcproj] using basisRemainder_succ c P (by rw [hc0]) j y
        have hxP : Pᗮ.orthogonalProjectionOnto x ∈ Submodule.span ℤ (Set.range d) := by
          rw [hd]
          change Pᗮ.orthogonalProjectionOnto x ∈ projectedLattice b
          rw [← projectedLattice_eq_map b]
          exact Submodule.mem_map.mpr ⟨x, hcspan ▸ hx, rfl⟩
        have hxP0 : basisRemainder d j (Pᗮ.orthogonalProjectionOnto x) ≠ 0 := by
          intro h
          apply hx0
          rw [hrem, h, Submodule.coe_zero]
        have h := hdshort j _ hxP hxP0
        simpa only [hrem, hcproj, Submodule.norm_coe] using h
    · intro i j hij
      obtain rfl | ⟨i, rfl⟩ := Fin.eq_zero_or_eq_succ i
      · obtain rfl | ⟨j, rfl⟩ := Fin.eq_zero_or_eq_succ j
        · exact False.elim (lt_irrefl _ hij)
        · exact roundedLiftBasis_coefficient_zero b dZ j
      · obtain rfl | ⟨j, rfl⟩ := Fin.eq_zero_or_eq_succ j
        · exact False.elim (not_lt_of_ge (Fin.zero_le _) hij)
        · rw [gramCoefficient_succ_of_projection c P (by rw [hc0]) d hcproj]
          exact hdsize i j (Fin.succ_lt_succ_iff.mp hij)

/-- Blueprint `lem:reduced-basis`: existence of a size-reduced shortest-projection
basis, before the quantitative primal and dual norm estimates. -/
theorem exists_reducedShortestProjectionBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    ∃ c : Module.Basis (Fin n) ℝ E,
      Submodule.span ℤ (Set.range c) = Submodule.span ℤ (Set.range b) ∧
      IsShortestProjectionBasis c ∧ IsSizeReducedBasis c := by
  obtain ⟨c, hc, hcshort⟩ := exists_shortestProjectionBasis b
  obtain ⟨d, hd, hdshort, hdsize⟩ := exists_sizeReducedShortestBasis c hcshort
  exact ⟨d, hd.trans hc, hdshort, hdsize⟩

/-- Subtracting integer multiples of the first vector from later lifts leaves
every later orthogonal projection unchanged (`lem:reduced-basis`). -/
theorem shiftedIntegerBasis_later_remainder {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (c : Module.Basis (Fin n) ℤ (projectedLattice b)) (k : Fin n → ℤ)
    (j : Fin n) (x : E) :
    basisRemainder ((shiftedIntegerBasis b c k).ofZLatticeBasis ℝ
      (Submodule.span ℤ (Set.range b))) j.succ x =
    basisRemainder ((liftedIntegerBasis b c).ofZLatticeBasis ℝ
      (Submodule.span ℤ (Set.range b))) j.succ x := by
  let P := Submodule.span ℝ {b 0}
  let f₁ := (shiftedIntegerBasis b c k).ofZLatticeBasis ℝ
    (Submodule.span ℤ (Set.range b))
  let f₀ := (liftedIntegerBasis b c).ofZLatticeBasis ℝ
    (Submodule.span ℤ (Set.range b))
  let g : Fin n → Pᗮ := fun i => c i
  have h₁0 : f₁ 0 = b 0 := by
    simp only [f₁, Module.Basis.ofZLatticeBasis_apply, shiftedIntegerBasis_zero]
  have h₀0 : f₀ 0 = b 0 := by
    simp only [f₀, Module.Basis.ofZLatticeBasis_apply, liftedIntegerBasis_zero]
  have h₁p (i : Fin n) : Pᗮ.orthogonalProjectionOnto (f₁ i.succ) = g i := by
    simpa only [f₁, Module.Basis.ofZLatticeBasis_apply, g] using
      shiftedIntegerBasis_projection b c k i
  have h₀p (i : Fin n) : Pᗮ.orthogonalProjectionOnto (f₀ i.succ) = g i := by
    simpa only [f₀, Module.Basis.ofZLatticeBasis_apply, g] using liftedIntegerBasis_projection b c i
  change basisRemainder f₁ j.succ x = basisRemainder f₀ j.succ x
  calc
    _ = ((basisRemainder g j (Pᗮ.orthogonalProjectionOnto x) : Pᗮ) : E) := by
      simpa only [h₁p] using basisRemainder_succ f₁ P (by rw [h₁0]) j x
    _ = _ := by
      symm
      simpa only [h₀p] using basisRemainder_succ f₀ P (by rw [h₀0]) j x

theorem basisRemainder_gramSchmidt_of_lt {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (f : Fin n → E) {i k : Fin n} (hki : k < i) :
    basisRemainder f i (InnerProductSpace.gramSchmidt ℝ f k) = 0 := by
  apply Submodule.starProjection_orthogonal_apply_eq_zero
  exact Submodule.span_mono (Set.image_mono (Set.Iic_subset_Iio.mpr hki))
    (InnerProductSpace.gramSchmidt_mem_span ℝ f (le_refl k))

theorem basisRemainder_gramSchmidt_of_le {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (f : Fin n → E) {i k : Fin n} (hik : i ≤ k) :
    basisRemainder f i (InnerProductSpace.gramSchmidt ℝ f k) =
      InnerProductSpace.gramSchmidt ℝ f k := by
  apply Submodule.starProjection_eq_self_iff.mpr
  apply (Submodule.mem_orthogonal' _ _).mpr
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨j, hj, rfl⟩ := hx
    exact InnerProductSpace.gramSchmidt_inv_triangular ℝ f (hj.trans_le hik)
  | zero => simp
  | add x y _ _ hx hy => simp [inner_add_right, hx, hy]
  | smul a x _ hx => simp [inner_smul_right, hx]

theorem basisRemainder_next {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (f : Fin (n + 1) → E) (i : Fin n) :
    basisRemainder f i.castSucc (f i.succ) = InnerProductSpace.gramSchmidt ℝ f i.succ +
      gramCoefficient f i.castSucc i.succ • InnerProductSpace.gramSchmidt ℝ f i.castSucc := by
  have hij : i.castSucc < i.succ := by
    simp only [Fin.lt_def, Fin.val_castSucc, Fin.val_succ]
    omega
  calc
    _ = InnerProductSpace.gramSchmidt ℝ f i.succ +
        ∑ k ∈ Finset.Iio i.succ, gramCoefficient f k i.succ •
          basisRemainder f i.castSucc (InnerProductSpace.gramSchmidt ℝ f k) := by
      conv_lhs => rw [InnerProductSpace.gramSchmidt_def'' ℝ f i.succ]
      simp only [map_add, map_sum, map_smul, basisRemainder_gramSchmidt_of_le f hij.le,
        gramCoefficient, RCLike.ofReal_real_eq_id, id_eq]
    _ = _ := by
      congr 1
      rw [Finset.sum_eq_single_of_mem i.castSucc (Finset.mem_Iio.mpr hij)]
      · rw [basisRemainder_gramSchmidt_of_le f le_rfl]
      · intro k hk hki
        have hlt : k < i.castSucc := by
          have := Finset.mem_Iio.mp hk
          have hne : k.val ≠ i.val := by
            intro h
            apply hki
            exact Fin.ext h
          simp only [Fin.lt_def, Fin.val_castSucc, Fin.val_succ] at *
          omega
        rw [basisRemainder_gramSchmidt_of_lt f hlt, smul_zero]

/-- Blueprint `lem:reduced-basis`: shortness in the projected lattice and size
reduction imply the squared adjacent Gram–Schmidt length bound. -/
theorem reducedBasis_adjacent_sq {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (hb : IsShortestProjectionBasis b) (hr : IsSizeReducedBasis b) (i : Fin n) :
    (3 / 4 : ℝ) * ‖InnerProductSpace.gramSchmidt ℝ b i.castSucc‖ ^ 2 ≤
      ‖InnerProductSpace.gramSchmidt ℝ b i.succ‖ ^ 2 := by
  let a := InnerProductSpace.gramSchmidt ℝ b i.castSucc
  let v := InnerProductSpace.gramSchmidt ℝ b i.succ
  let μ := gramCoefficient b i.castSucc i.succ
  let w := basisRemainder b i.castSucc (b i.succ)
  have hij : i.castSucc < i.succ := by
    simp only [Fin.lt_def, Fin.val_castSucc, Fin.val_succ]
    omega
  have horth : inner ℝ v a = 0 := InnerProductSpace.gramSchmidt_orthogonal ℝ b hij.ne'
  have hw : ‖w‖ ^ 2 = ‖v‖ ^ 2 + μ ^ 2 * ‖a‖ ^ 2 := by
    change ‖basisRemainder b i.castSucc (b i.succ)‖ ^ 2 = _
    rw [basisRemainder_next, norm_add_sq_real, inner_smul_right, horth, mul_zero,
      mul_zero, add_zero, norm_smul, Real.norm_eq_abs, mul_pow, sq_abs]
  have hv : v ≠ 0 := InnerProductSpace.gramSchmidt_ne_zero i.succ b.linearIndependent
  have hw0 : w ≠ 0 := by
    intro h
    have hp := sq_pos_of_pos (norm_pos_iff.mpr hv)
    rw [h, norm_zero, zero_pow (by decide : 2 ≠ 0)] at hw
    nlinarith [sq_nonneg μ, sq_nonneg ‖a‖, mul_nonneg (sq_nonneg μ) (sq_nonneg ‖a‖)]
  have hshort := hb i.castSucc (b i.succ) (Submodule.subset_span ⟨i.succ, rfl⟩) hw0
  rw [← gramSchmidt_eq_basisRemainder] at hshort
  have hshortsq := pow_le_pow_left₀ (norm_nonneg _) hshort 2
  have hμ := pow_le_pow_left₀ (abs_nonneg μ) (hr _ _ hij) 2
  rw [sq_abs] at hμ
  have hmul := mul_le_mul_of_nonneg_right hμ (sq_nonneg ‖a‖)
  change (3 / 4 : ℝ) * ‖a‖ ^ 2 ≤ ‖v‖ ^ 2
  change ‖a‖ ^ 2 ≤ ‖w‖ ^ 2 at hshortsq
  nlinarith

/-- Blueprint `lem:reduced-basis`: adjacent Gram–Schmidt lengths obey
`aᵢ₊₁ ≥ (√3 / 2) aᵢ`. -/
theorem reducedBasis_adjacent_length {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin (n + 1)) ℝ E)
    (hb : IsShortestProjectionBasis b) (hr : IsSizeReducedBasis b) (i : Fin n) :
    (Real.sqrt 3 / 2) * ‖InnerProductSpace.gramSchmidt ℝ b i.castSucc‖ ≤
      ‖InnerProductSpace.gramSchmidt ℝ b i.succ‖ := by
  apply (sq_le_sq₀ (by positivity) (norm_nonneg _)).mp
  calc
    _ = (3 / 4 : ℝ) * ‖InnerProductSpace.gramSchmidt ℝ b i.castSucc‖ ^ 2 := by
      rw [mul_pow, div_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]
      norm_num
    _ ≤ _ := reducedBasis_adjacent_sq b hb hr i

theorem norm_sq_sum_of_pairwise_orthogonal {E ι : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (s : Finset ι) (f : ι → E)
    (hf : Pairwise (fun i j => inner ℝ (f i) (f j) = 0)) :
    ‖∑ i ∈ s, f i‖ ^ 2 = ∑ i ∈ s, ‖f i‖ ^ 2 := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    have hinner : inner ℝ (f a) (∑ i ∈ s, f i) = 0 := by
      rw [inner_sum]
      apply Finset.sum_eq_zero
      intro i hi
      exact hf (by intro h; subst i; exact ha hi)
    rw [Finset.sum_insert ha, Finset.sum_insert ha, norm_add_sq_real, hinner, ih]
    ring

theorem basis_norm_sq_gramSchmidt {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (f : Fin n → E) (j : Fin n) :
    ‖f j‖ ^ 2 = ‖InnerProductSpace.gramSchmidt ℝ f j‖ ^ 2 +
      ∑ i ∈ Finset.Iio j, gramCoefficient f i j ^ 2 *
        ‖InnerProductSpace.gramSchmidt ℝ f i‖ ^ 2 := by
  let g := InnerProductSpace.gramSchmidt ℝ f
  have hdecomp : f j = g j + ∑ i ∈ Finset.Iio j, gramCoefficient f i j • g i := by
    simpa only [g, gramCoefficient, RCLike.ofReal_real_eq_id, id_eq] using
      InnerProductSpace.gramSchmidt_def'' ℝ f j
  have horth : Pairwise (fun i k => inner ℝ
      (gramCoefficient f i j • g i) (gramCoefficient f k j • g k) = 0) := by
    intro i k hik
    simp [inner_smul_left, inner_smul_right, g,
      InnerProductSpace.gramSchmidt_orthogonal ℝ f hik]
  have hinner : inner ℝ (g j) (∑ i ∈ Finset.Iio j, gramCoefficient f i j • g i) = 0 := by
    rw [inner_sum]
    apply Finset.sum_eq_zero
    intro i hi
    have hij := Finset.mem_Iio.mp hi
    simp only [inner_smul_right, g, InnerProductSpace.gramSchmidt_orthogonal ℝ f hij.ne',
      mul_zero]
  calc
    ‖f j‖ ^ 2 = ‖g j + ∑ i ∈ Finset.Iio j, gramCoefficient f i j • g i‖ ^ 2 :=
      congrArg (fun x : E => ‖x‖ ^ 2) hdecomp
    _ = ‖g j‖ ^ 2 + ∑ i ∈ Finset.Iio j, gramCoefficient f i j ^ 2 * ‖g i‖ ^ 2 := by
      rw [norm_add_sq_real, hinner, mul_zero, add_zero,
        norm_sq_sum_of_pairwise_orthogonal _ _ horth]
      simp only [norm_smul, Real.norm_eq_abs, mul_pow, sq_abs, g]

/-- The finite geometric majorant for squared Gram–Schmidt lengths in the
primal norm estimate of `lem:reduced-basis`. -/
theorem adjacent_prefix_sum_bound {n : ℕ} (a : Fin (n + 1) → ℝ)
    (hadj : ∀ i : Fin n, (3 / 4 : ℝ) * a i.castSucc ≤ a i.succ)
    (j : Fin (n + 1)) :
    ∑ i ∈ Finset.Iio j, a i ≤ 4 * ((4 / 3 : ℝ) ^ j.val - 1) * a j := by
  classical
  refine Fin.induction ?_ (fun i hi => ?_) j
  · have hz : Finset.Iio (0 : Fin (n + 1)) = ∅ := by ext k; simp
    simp only [hz, Finset.sum_empty, Fin.val_zero, pow_zero, sub_self, mul_zero, zero_mul,
      le_refl]
  · have hset : Finset.Iio i.succ = insert i.castSucc (Finset.Iio i.castSucc) := by
      ext k
      simp only [Finset.mem_Iio, Finset.mem_insert, Fin.lt_def, Fin.val_succ, Fin.val_castSucc]
      constructor
      · intro h
        by_cases he : k.val = i.val
        · exact Or.inl (Fin.ext he)
        · exact Or.inr (by omega)
      · rintro (rfl | h)
        · simp
        · omega
    rw [hset, Finset.sum_insert (by simp), Fin.val_succ, pow_succ]
    have hp : (1 : ℝ) ≤ (4 / 3 : ℝ) ^ i.val := one_le_pow₀ (by norm_num)
    have hc : 0 ≤ 4 * (4 / 3 : ℝ) ^ i.val - 3 := by linarith
    have hadj' : a i.castSucc ≤ (4 / 3 : ℝ) * a i.succ := by linarith [hadj i]
    have hmul := mul_le_mul_of_nonneg_left hadj' hc
    simp only [Fin.val_castSucc] at hi
    nlinarith

/-- Blueprint `lem:reduced-basis`: the squared primal norm estimate. -/
theorem reducedBasis_norm_sq {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) (j : Fin n) :
    ‖b j‖ ^ 2 ≤ (4 / 3 : ℝ) ^ j.val * ‖InnerProductSpace.gramSchmidt ℝ b j‖ ^ 2 := by
  cases n with
  | zero => exact Fin.elim0 j
  | succ n =>
    have hp := adjacent_prefix_sum_bound
      (fun i => ‖InnerProductSpace.gramSchmidt ℝ b i‖ ^ 2)
      (reducedBasis_adjacent_sq b hb hr) j
    calc
      _ = ‖InnerProductSpace.gramSchmidt ℝ b j‖ ^ 2 +
          ∑ i ∈ Finset.Iio j, gramCoefficient b i j ^ 2 *
            ‖InnerProductSpace.gramSchmidt ℝ b i‖ ^ 2 := basis_norm_sq_gramSchmidt b j
      _ ≤ ‖InnerProductSpace.gramSchmidt ℝ b j‖ ^ 2 +
          (1 / 4 : ℝ) * ∑ i ∈ Finset.Iio j, ‖InnerProductSpace.gramSchmidt ℝ b i‖ ^ 2 := by
        rw [Finset.mul_sum]
        apply add_le_add_right
        apply Finset.sum_le_sum
        intro i hi
        have h := pow_le_pow_left₀ (abs_nonneg (gramCoefficient b i j))
          (hr i j (Finset.mem_Iio.mp hi)) 2
        rw [sq_abs] at h
        apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
        norm_num at h ⊢
        exact h
      _ ≤ ‖InnerProductSpace.gramSchmidt ℝ b j‖ ^ 2 +
          (1 / 4 : ℝ) * (4 * ((4 / 3 : ℝ) ^ j.val - 1) *
            ‖InnerProductSpace.gramSchmidt ℝ b j‖ ^ 2) := by gcongr
      _ = _ := by ring

/-- Blueprint `lem:reduced-basis`: with zero-based indices,
`‖bⱼ‖ ≤ (2 / √3)^j ‖bⱼ*‖`. -/
theorem reducedBasis_norm {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) (j : Fin n) :
    ‖b j‖ ≤ (2 / Real.sqrt 3) ^ j.val * ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
  have hc : (2 / Real.sqrt 3) ^ 2 = (4 / 3 : ℝ) := by
    rw [div_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]
    norm_num
  apply (sq_le_sq₀ (norm_nonneg _) (by positivity)).mp
  calc
    _ ≤ (4 / 3 : ℝ) ^ j.val * ‖InnerProductSpace.gramSchmidt ℝ b j‖ ^ 2 :=
      reducedBasis_norm_sq b hb hr j
    _ = _ := by rw [mul_pow, ← pow_mul, Nat.mul_comm j.val 2, pow_mul, hc]

/-- Coordinates of the Gram–Schmidt vectors in the original basis: these are
the entries of the inverse unit upper triangular matrix in `lem:reduced-basis`. -/
noncomputable def inverseGramCoefficient {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (i j : Fin n) : ℝ :=
  b.repr (InnerProductSpace.gramSchmidt ℝ b j) i

theorem inverseGramCoefficient_zero {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E)
    {i j : Fin n} (hji : j < i) : inverseGramCoefficient b i j = 0 :=
  InnerProductSpace.gramSchmidt_triangular hji b

theorem inverseGramCoefficient_recurrence {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (i j : Fin n) :
    inverseGramCoefficient b i j = (if i = j then 1 else 0) -
      ∑ k ∈ Finset.Iio j, gramCoefficient b k j * inverseGramCoefficient b i k := by
  classical
  have he : InnerProductSpace.gramSchmidt ℝ b j = b j -
      ∑ k ∈ Finset.Iio j, gramCoefficient b k j • InnerProductSpace.gramSchmidt ℝ b k := by
    simpa only [gramCoefficient, RCLike.ofReal_real_eq_id, id_eq,
      Submodule.starProjection_singleton] using InnerProductSpace.gramSchmidt_def ℝ b j
  unfold inverseGramCoefficient
  rw [he]
  simp [map_sub, map_sum, map_smul, gramCoefficient, Finsupp.single_apply, eq_comm]

theorem inverseGramCoefficient_self {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (i : Fin n) :
    inverseGramCoefficient b i i = 1 := by
  rw [inverseGramCoefficient_recurrence, ite_eq_left rfl]
  have hs : ∑ k ∈ Finset.Iio i, gramCoefficient b k i * inverseGramCoefficient b i k = 0 := by
    apply Finset.sum_eq_zero
    intro k hk
    rw [inverseGramCoefficient_zero b (Finset.mem_Iio.mp hk), mul_zero]
  rw [hs, sub_zero]

theorem inverseGramCoefficient_abs_recurrence {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E)
    (hb : IsSizeReducedBasis b) {i j : Fin n} (hij : i < j) :
    |inverseGramCoefficient b i j| ≤
      (1 / 2 : ℝ) * ∑ k ∈ Finset.Iio j, |inverseGramCoefficient b i k| := by
  rw [inverseGramCoefficient_recurrence, ite_eq_right hij.ne, zero_sub, abs_neg, Finset.mul_sum]
  apply (Finset.abs_sum_le_sum_abs _ _).trans
  apply Finset.sum_le_sum
  intro k hk
  rw [abs_mul]
  exact mul_le_mul_of_nonneg_right (hb k j (Finset.mem_Iio.mp hk)) (abs_nonneg _)

/-- A triangular recurrence with off-diagonal coefficients bounded by one half
has geometric prefix sums bounded by powers of three halves. -/
theorem triangular_prefix_bound {n : ℕ} (a : Fin (n + 1) → ℝ) (i : Fin (n + 1))
    (hzero : ∀ k, k < i → a k = 0) (hself : a i = 1)
    (hrec : ∀ j, i < j → a j ≤ (1 / 2 : ℝ) * ∑ k ∈ Finset.Iio j, a k)
    (j : Fin (n + 1)) (hij : i ≤ j) :
    ∑ k ∈ Finset.Iic j, a k ≤ (3 / 2 : ℝ) ^ (j.val - i.val) := by
  classical
  have hsumself : ∑ k ∈ Finset.Iic i, a k = 1 := by
    rw [Finset.sum_eq_single_of_mem i (Finset.mem_Iic.mpr le_rfl)]
    · exact hself
    · intro k hk hki
      exact hzero k (lt_of_le_of_ne (Finset.mem_Iic.mp hk) hki)
  induction j using Fin.induction with
  | zero =>
    have hi : i = 0 := le_antisymm hij (Fin.zero_le _)
    subst i
    simpa using hsumself.le
  | succ j ih =>
    by_cases he : i = j.succ
    · subst i
      simpa using hsumself.le
    have hip : i ≤ j.castSucc := by
      have hne : i.val ≠ j.val + 1 := by
        intro h
        apply he
        exact Fin.ext h
      simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ] at hij ⊢
      omega
    have hprev := ih hip
    have hnext := hrec j.succ (lt_of_le_of_ne hij he)
    have hIio : Finset.Iio j.succ = Finset.Iic j.castSucc := by
      ext k
      simp only [Finset.mem_Iio, Finset.mem_Iic, Fin.lt_def, Fin.le_def,
        Fin.val_succ, Fin.val_castSucc]
      omega
    have hIic : Finset.Iic j.succ = insert j.succ (Finset.Iic j.castSucc) := by
      ext k
      simp only [Finset.mem_Iic, Finset.mem_insert, Fin.le_def, Fin.val_succ, Fin.val_castSucc]
      constructor
      · intro h
        by_cases heq : k.val = j.val + 1
        · exact Or.inl (Fin.ext heq)
        · exact Or.inr (by omega)
      · rintro (rfl | h)
        · simp
        · omega
    rw [hIio] at hnext
    rw [hIic, Finset.sum_insert (by simp)]
    have hexp : j.succ.val - i.val = (j.castSucc.val - i.val) + 1 := by
      simp only [Fin.le_def, Fin.val_castSucc] at hip
      simp only [Fin.val_succ, Fin.val_castSucc]
      omega
    rw [hexp, pow_succ]
    nlinarith

/-- The upper triangular inverse bound in `lem:reduced-basis`, obtained by
the equivalent forward substitution recurrence. -/
theorem inverseGramCoefficient_abs_bound {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E)
    (hb : IsSizeReducedBasis b) {i j : Fin n} (hij : i < j) :
    |inverseGramCoefficient b i j| ≤
      (1 / 2 : ℝ) * (3 / 2 : ℝ) ^ (j.val - i.val - 1) := by
  cases n with
  | zero => exact Fin.elim0 j
  | succ n =>
    obtain rfl | ⟨k, rfl⟩ := Fin.eq_zero_or_eq_succ j
    · exact False.elim (not_lt_of_ge (Fin.zero_le _) hij)
    have hik : i ≤ k.castSucc := by
      simp only [Fin.lt_def, Fin.le_def, Fin.val_succ, Fin.val_castSucc] at hij ⊢
      omega
    have hp := triangular_prefix_bound (fun j => |inverseGramCoefficient b i j|) i
      (fun j hj => by rw [inverseGramCoefficient_zero b hj, abs_zero])
      (by rw [inverseGramCoefficient_self, abs_one])
      (fun j hj => inverseGramCoefficient_abs_recurrence b hb hj) k.castSucc hik
    have hIio : Finset.Iio k.succ = Finset.Iic k.castSucc := by
      ext l
      simp only [Finset.mem_Iio, Finset.mem_Iic, Fin.lt_def, Fin.le_def,
        Fin.val_succ, Fin.val_castSucc]
      omega
    have he : k.succ.val - i.val - 1 = k.castSucc.val - i.val := by
      simp only [Fin.le_def, Fin.val_castSucc] at hik
      simp only [Fin.val_succ, Fin.val_castSucc]
      omega
    rw [he]
    exact (inverseGramCoefficient_abs_recurrence b hb hij).trans
      (by rw [hIio]; gcongr)

theorem adjacent_chain_bound {n : ℕ} (a : Fin (n + 1) → ℝ) (r : ℝ) (hr : 0 ≤ r)
    (ha : ∀ k : Fin n, a k.castSucc ≤ r * a k.succ)
    (i j : Fin (n + 1)) (hij : i ≤ j) : a i ≤ r ^ (j.val - i.val) * a j := by
  induction j using Fin.induction generalizing i with
  | zero =>
    have hi : i = 0 := le_antisymm hij (Fin.zero_le _)
    subst i
    simp
  | succ j ih =>
    by_cases he : i = j.succ
    · subst i
      simp
    have hip : i ≤ j.castSucc := by
      have hne : i.val ≠ j.val + 1 := by intro h; exact he (Fin.ext h)
      simp only [Fin.le_def, Fin.val_castSucc, Fin.val_succ] at hij ⊢
      omega
    have hexp : j.succ.val - i.val = (j.castSucc.val - i.val) + 1 := by
      simp only [Fin.le_def, Fin.val_castSucc] at hip
      simp only [Fin.val_succ, Fin.val_castSucc]
      omega
    calc
      a i ≤ r ^ (j.castSucc.val - i.val) * a j.castSucc := ih i hip
      _ ≤ r ^ (j.castSucc.val - i.val) * (r * a j.succ) :=
        mul_le_mul_of_nonneg_left (ha j) (pow_nonneg hr _)
      _ = _ := by rw [hexp, pow_succ, mul_assoc]

theorem reducedBasis_length_ratio_coarse {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) {i j : Fin n} (hij : i ≤ j) :
    ‖InnerProductSpace.gramSchmidt ℝ b i‖ ≤
      (4 / 3 : ℝ) ^ (j.val - i.val) * ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
  cases n with
  | zero => exact Fin.elim0 i
  | succ n =>
    apply adjacent_chain_bound _ _ (by norm_num) _ i j hij
    intro k
    apply (sq_le_sq₀ (norm_nonneg _) (by positivity)).mp
    have h := reducedBasis_adjacent_sq b hb hr k
    nlinarith [sq_nonneg ‖InnerProductSpace.gramSchmidt ℝ b k.succ‖]

theorem inverseGramCoefficient_abs_coarse {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E)
    (hb : IsSizeReducedBasis b) {i j : Fin n} (hij : i ≤ j) :
    |inverseGramCoefficient b i j| ≤ (3 / 2 : ℝ) ^ (j.val - i.val) := by
  by_cases he : i = j
  · subst j
    simp [inverseGramCoefficient_self]
  have hlt : i < j := lt_of_le_of_ne hij he
  calc
    _ ≤ (1 / 2 : ℝ) * (3 / 2 : ℝ) ^ (j.val - i.val - 1) :=
      inverseGramCoefficient_abs_bound b hb hlt
    _ ≤ (3 / 2 : ℝ) ^ (j.val - i.val - 1) := by
      nlinarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 3 / 2) (j.val - i.val - 1)]
    _ ≤ _ := pow_le_pow_right₀ (by norm_num) (Nat.sub_le _ _)

theorem reducedBasis_weighted_inverse_bound {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) (i j : Fin n) :
    ‖InnerProductSpace.gramSchmidt ℝ b i‖ * |inverseGramCoefficient b i j| ≤
      (2 : ℝ) ^ n * ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
  by_cases hij : i ≤ j
  · have h₁ := reducedBasis_length_ratio_coarse b hb hr hij
    have h₂ := inverseGramCoefficient_abs_coarse b hr hij
    calc
      _ ≤ ((4 / 3 : ℝ) ^ (j.val - i.val) * ‖InnerProductSpace.gramSchmidt ℝ b j‖) *
          (3 / 2 : ℝ) ^ (j.val - i.val) :=
        mul_le_mul h₁ h₂ (abs_nonneg _) (mul_nonneg (by positivity) (norm_nonneg _))
      _ = (2 : ℝ) ^ (j.val - i.val) * ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
        rw [mul_right_comm, ← mul_pow]
        norm_num
      _ ≤ _ := mul_le_mul_of_nonneg_right
        (pow_le_pow_right₀ (by norm_num) (by omega)) (norm_nonneg _)
  · rw [inverseGramCoefficient_zero b (lt_of_not_ge hij), abs_zero, mul_zero]
    positivity

/-- Euclidean dual basis, obtained from the algebraic dual basis by Riesz duality. -/
noncomputable def euclideanDualBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) : Module.Basis (Fin n) ℝ E :=
  b.dualBasis.map (LinearMap.toContinuousLinearMap.trans
    (InnerProductSpace.toDual ℝ E).symm.toLinearEquiv)

theorem euclideanDualBasis_inner {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (i : Fin n) (x : E) :
    inner ℝ (euclideanDualBasis b i) x = b.repr x i := by
  simp [euclideanDualBasis, Module.Basis.map_apply, InnerProductSpace.toDual_symm_apply]

theorem gramSchmidtBasis_coordinate_norm {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (x : E) (j : Fin n) :
    |(InnerProductSpace.gramSchmidtBasis b).repr x j| *
      ‖InnerProductSpace.gramSchmidt ℝ b j‖ ≤ ‖x‖ := by
  classical
  let g := InnerProductSpace.gramSchmidtBasis b
  have hg (k : Fin n) : g k = InnerProductSpace.gramSchmidt ℝ b k :=
    congrFun (InnerProductSpace.coe_gramSchmidtBasis b) k
  have hinner : inner ℝ (g j) x = g.repr x j * ‖g j‖ ^ 2 := by
    conv_lhs => rw [← g.sum_repr x]
    rw [inner_sum, Finset.sum_eq_single j]
    · rw [inner_smul_right, real_inner_self_eq_norm_sq]
    · intro k _ hkj
      rw [inner_smul_right, hg, hg,
        InnerProductSpace.gramSchmidt_orthogonal ℝ b hkj.symm, mul_zero]
    · simp
  have h := abs_real_inner_le_norm (g j) x
  rw [hinner, abs_mul, abs_of_nonneg (sq_nonneg ‖g j‖)] at h
  have hscaled : ‖g j‖ * (|g.repr x j| * ‖g j‖) ≤ ‖g j‖ * ‖x‖ := by nlinarith
  have hfinal := le_of_mul_le_mul_left hscaled (norm_pos_iff.mpr (g.ne_zero j))
  simpa only [hg] using hfinal

/-- The coordinate functional bound implying the dual-vector estimate in
`lem:reduced-basis`. -/
theorem reducedBasis_coordinate_bound {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) (i : Fin n) (x : E) :
    ‖InnerProductSpace.gramSchmidt ℝ b i‖ * |b.repr x i| ≤ (4 : ℝ) ^ n * ‖x‖ := by
  classical
  let g := InnerProductSpace.gramSchmidtBasis b
  have hg (j : Fin n) : g j = InnerProductSpace.gramSchmidt ℝ b j :=
    congrFun (InnerProductSpace.coe_gramSchmidtBasis b) j
  have hcoord : b.repr x i = ∑ j, g.repr x j * inverseGramCoefficient b i j := by
    have h := congrArg (b.coord i) (g.sum_repr x)
    simpa only [map_sum, map_smul, Module.Basis.coord_apply, smul_eq_mul,
      hg, inverseGramCoefficient] using h.symm
  rw [hcoord]
  calc
    _ ≤ ‖InnerProductSpace.gramSchmidt ℝ b i‖ *
        ∑ j, |g.repr x j * inverseGramCoefficient b i j| :=
      mul_le_mul_of_nonneg_left (Finset.abs_sum_le_sum_abs _ _) (norm_nonneg _)
    _ = ∑ j, (‖InnerProductSpace.gramSchmidt ℝ b i‖ *
        |inverseGramCoefficient b i j|) * |g.repr x j| := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [abs_mul]
      ring
    _ ≤ ∑ _j : Fin n, (2 : ℝ) ^ n * ‖x‖ := by
      apply Finset.sum_le_sum
      intro j _
      calc
        _ ≤ ((2 : ℝ) ^ n * ‖InnerProductSpace.gramSchmidt ℝ b j‖) * |g.repr x j| :=
          mul_le_mul_of_nonneg_right (reducedBasis_weighted_inverse_bound b hb hr i j)
            (abs_nonneg _)
        _ = (2 : ℝ) ^ n * (|g.repr x j| * ‖InnerProductSpace.gramSchmidt ℝ b j‖) := by ring
        _ ≤ _ := mul_le_mul_of_nonneg_left (gramSchmidtBasis_coordinate_norm b x j) (by positivity)
    _ = (n : ℝ) * (2 : ℝ) ^ n * ‖x‖ := by simp [mul_assoc]
    _ ≤ (4 : ℝ) ^ n * ‖x‖ := by
      have hn : (n : ℝ) ≤ (2 : ℝ) ^ n := by exact_mod_cast (Nat.lt_two_pow_self (n := n)).le
      have hp : (n : ℝ) * (2 : ℝ) ^ n ≤ (4 : ℝ) ^ n := by
        calc
          _ ≤ (2 : ℝ) ^ n * (2 : ℝ) ^ n := mul_le_mul_of_nonneg_right hn (by positivity)
          _ = _ := by rw [← mul_pow]; norm_num
      exact mul_le_mul_of_nonneg_right hp (norm_nonneg _)

/-- Blueprint `lem:reduced-basis`: the Euclidean dual basis satisfies
`‖qᵢ‖ ≤ 4^d / aᵢ`. -/
theorem reducedBasis_dual_norm {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) (i : Fin n) :
    ‖euclideanDualBasis b i‖ ≤ (4 : ℝ) ^ n / ‖InnerProductSpace.gramSchmidt ℝ b i‖ := by
  have h := reducedBasis_coordinate_bound b hb hr i (euclideanDualBasis b i)
  rw [← euclideanDualBasis_inner b i, real_inner_self_eq_norm_sq,
    abs_of_nonneg (sq_nonneg _)] at h
  have hq : 0 < ‖euclideanDualBasis b i‖ := norm_pos_iff.mpr ((euclideanDualBasis b).ne_zero i)
  have ha : 0 < ‖InnerProductSpace.gramSchmidt ℝ b i‖ :=
    norm_pos_iff.mpr (InnerProductSpace.gramSchmidt_ne_zero i b.linearIndependent)
  have hmul : ‖InnerProductSpace.gramSchmidt ℝ b i‖ * ‖euclideanDualBasis b i‖ ≤ (4 : ℝ) ^ n :=
    le_of_mul_le_mul_right (by nlinarith [h]) hq
  exact (le_div_iff₀ ha).mpr (by simpa only [mul_comm] using hmul)

theorem euclideanDualBasis_inner_basis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (i j : Fin n) :
    inner ℝ (euclideanDualBasis b i) (b j) = if i = j then 1 else 0 := by
  rw [euclideanDualBasis_inner]
  simp [Finsupp.single_apply, eq_comm]

theorem reducedBasis_adjacent_length_of_succ {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) (i j : Fin n) (hij : j.val = i.val + 1) :
    (Real.sqrt 3 / 2) * ‖InnerProductSpace.gramSchmidt ℝ b i‖ ≤
      ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
  cases n with
  | zero => exact Fin.elim0 i
  | succ n =>
    let k : Fin n := ⟨i.val, by have := j.isLt; omega⟩
    have hi : k.castSucc = i := Fin.ext rfl
    have hj : k.succ = j := Fin.ext hij.symm
    simpa only [hi, hj] using reducedBasis_adjacent_length b hb hr k

/-- Blueprint `lem:reduced-basis`, complete statement: a full Euclidean lattice
has a size-reduced shortest-projection basis with positive Gram–Schmidt lengths,
adjacent factor `√3/2`, primal bound `(2/√3)^i aᵢ`, and dual bound `4^d/aᵢ`. -/
theorem shortestProjectionBasis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    ∃ c : Module.Basis (Fin n) ℝ E,
      Submodule.span ℤ (Set.range c) = Submodule.span ℤ (Set.range b) ∧
      IsShortestProjectionBasis c ∧ IsSizeReducedBasis c ∧
      (∀ i, 0 < ‖InnerProductSpace.gramSchmidt ℝ c i‖) ∧
      (∀ j, c j = InnerProductSpace.gramSchmidt ℝ c j +
        ∑ i ∈ Finset.Iio j, gramCoefficient c i j • InnerProductSpace.gramSchmidt ℝ c i) ∧
      (∀ i j, j.val = i.val + 1 → (Real.sqrt 3 / 2) *
        ‖InnerProductSpace.gramSchmidt ℝ c i‖ ≤ ‖InnerProductSpace.gramSchmidt ℝ c j‖) ∧
      (∀ i, ‖c i‖ ≤ (2 / Real.sqrt 3) ^ i.val * ‖InnerProductSpace.gramSchmidt ℝ c i‖) ∧
      (∀ i, ‖euclideanDualBasis c i‖ ≤ (4 : ℝ) ^ n / ‖InnerProductSpace.gramSchmidt ℝ c i‖) := by
  obtain ⟨c, hc, hshort, hred⟩ := exists_reducedShortestProjectionBasis b
  refine ⟨c, hc, hshort, hred, ?_, ?_, ?_, ?_, ?_⟩
  · intro i
    exact norm_pos_iff.mpr (InnerProductSpace.gramSchmidt_ne_zero i c.linearIndependent)
  · intro j
    simpa only [gramCoefficient, RCLike.ofReal_real_eq_id, id_eq] using
      InnerProductSpace.gramSchmidt_def'' ℝ c j
  · exact reducedBasis_adjacent_length_of_succ c hshort hred
  · exact reducedBasis_norm c hshort hred
  · exact reducedBasis_dual_norm c hshort hred

/-- The integer dual with respect to the Euclidean inner product. -/
noncomputable def euclideanDualLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (L : Submodule ℤ E) : Submodule ℤ E :=
  LinearMap.BilinForm.dualSubmodule (innerₗ E) L

theorem mem_euclideanDualLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (L : Submodule ℤ E) (x : E) :
    x ∈ euclideanDualLattice L ↔ ∀ y ∈ L, ∃ m : ℤ, (m : ℝ) = inner ℝ x y := by
  simp [euclideanDualLattice, LinearMap.BilinForm.mem_dualSubmodule,
    Submodule.mem_one]

theorem euclideanInner_nondegenerate {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] : (innerₗ E).Nondegenerate := by
  constructor
  · intro x hx
    exact (inner_self_eq_zero.mp (hx x))
  · intro x hx
    exact (inner_self_eq_zero.mp (hx x))

theorem euclideanDualBasis_eq_bilinDual {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    LinearMap.BilinForm.dualBasis (innerₗ E) euclideanInner_nondegenerate b =
      euclideanDualBasis b := by
  apply DFunLike.coe_injective
  have h := (LinearMap.BilinForm.dualBasis_eq_iff euclideanInner_nondegenerate b
    (euclideanDualBasis b)).mpr (fun i j => by
      simpa only [innerₗ_apply_apply, eq_comm] using euclideanDualBasis_inner_basis b i j)
  exact h

/-- Blueprint `lem:transference`: the integer dual lattice is generated by the
Euclidean dual basis, hence is again a full lattice. -/
theorem euclideanDualLattice_span {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    euclideanDualLattice (Submodule.span ℤ (Set.range b)) =
      Submodule.span ℤ (Set.range (euclideanDualBasis b)) := by
  rw [euclideanDualLattice, LinearMap.BilinForm.dualSubmodule_span_of_basis _
    euclideanInner_nondegenerate, euclideanDualBasis_eq_bilinDual]

instance euclideanDualLattice_span_discrete {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    DiscreteTopology (euclideanDualLattice (Submodule.span ℤ (Set.range b))) := by
  rw [euclideanDualLattice_span]
  infer_instance

instance euclideanDualLattice_span_isZLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    IsZLattice ℝ (euclideanDualLattice (Submodule.span ℤ (Set.range b))) := by
  constructor
  simpa only [euclideanDualLattice_span] using
    (IsZLattice.span_top (K := ℝ) (L := Submodule.span ℤ (Set.range (euclideanDualBasis b))))

theorem euclideanDualLattice_involutive {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) :
    euclideanDualLattice (euclideanDualLattice (Submodule.span ℤ (Set.range b))) =
      Submodule.span ℤ (Set.range b) :=
  LinearMap.BilinForm.dualSubmodule_dualSubmodule_of_basis (innerₗ E)
    euclideanInner_nondegenerate ⟨fun x y => real_inner_comm y x⟩ b

/-- A nonzero pairing between a lattice vector and a dual lattice vector
has absolute value at least one (blueprint `lem:transference`, line 305). -/
theorem lattice_pairing_abs_ge_one {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {L : Submodule ℤ E} {x y : E}
    (hx : x ∈ euclideanDualLattice L) (hy : y ∈ L)
    (hxy : inner ℝ x y ≠ 0) : 1 ≤ |inner ℝ x y| := by
  obtain ⟨m, hm⟩ := (mem_euclideanDualLattice L x).mp hx y hy
  rw [← hm] at hxy ⊢
  have hm0 : m ≠ 0 := by exact_mod_cast hxy
  exact_mod_cast (Int.one_le_abs hm0)

/-- The compact, origin-symmetric convex bodies used in
blueprint `lem:transference`; the interior is required to be nonempty. -/
structure IsSymmetricConvexBody {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (K : Set E) : Prop where
  compact : IsCompact K
  convex : Convex ℝ K
  neg_mem : ∀ x ∈ K, -x ∈ K
  interior_nonempty : (interior K).Nonempty

open scoped Pointwise

theorem symmetricConvexBody_zero_interior {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : IsSymmetricConvexBody K) :
    (0 : E) ∈ interior K := by
  obtain ⟨x, hx⟩ := hK.interior_nonempty
  have heq : (fun y : E => -y) ⁻¹' K = K := by
    ext y
    exact ⟨fun hy => by simpa using hK.neg_mem (-y) hy, hK.neg_mem y⟩
  have hnx : -x ∈ interior K := by
    rw [mem_interior_iff_mem_nhds]
    have hc : ContinuousAt (fun y : E => -y) (-x) := continuous_neg.continuousAt
    have h := hc.preimage_mem_nhds (by simpa using mem_interior_iff_mem_nhds.mp hx)
    simpa only [heq] using h
  have h := hK.convex.interior hx hnx (a := (1 / 2 : ℝ)) (b := (1 / 2 : ℝ))
    (by norm_num) (by norm_num) (by norm_num)
  simpa only [← smul_add, add_neg_cancel, smul_zero] using h

theorem symmetricConvexBody_gauge_pos {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : IsSymmetricConvexBody K) {x : E}
    (hx : x ≠ 0) : 0 < gauge K x := by
  exact (gauge_pos (absorbent_nhds_zero (mem_interior_iff_mem_nhds.mp
    (symmetricConvexBody_zero_interior hK)))
    (NormedSpace.isVonNBounded_of_isBounded ℝ hK.compact.isBounded)).mpr hx

theorem symmetricConvexBody_gauge_le_one {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : IsSymmetricConvexBody K) (x : E) :
    gauge K x ≤ 1 ↔ x ∈ K := by
  simpa only [hK.compact.isClosed.closure_eq] using
    (gauge_le_one_iff_mem_closure hK.convex (mem_interior_iff_mem_nhds.mp
      (symmetricConvexBody_zero_interior hK)) (x := x))

/-- Positive gauge sublevel sets are exactly dilates of the original body. -/
theorem symmetricConvexBody_gauge_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : IsSymmetricConvexBody K)
    (x : E) {t : ℝ} (ht : 0 < t) : gauge K x ≤ t ↔ x ∈ t • K := by
  rw [Set.mem_smul_set_iff_inv_smul_mem₀ ht.ne',
    ← symmetricConvexBody_gauge_le_one hK, gauge_smul_of_nonneg (inv_nonneg.mpr ht.le),
    smul_eq_mul, inv_mul_le_iff₀ ht, mul_one]

theorem symmetricConvexBody_gauge_sublevel_compact {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : IsSymmetricConvexBody K)
    {t : ℝ} (ht : 0 < t) : IsCompact {x : E | gauge K x ≤ t} := by
  have heq : {x : E | gauge K x ≤ t} = t • K :=
    Set.ext fun x => symmetricConvexBody_gauge_le hK x ht
  rw [heq]
  exact hK.compact.image (continuous_const_smul t)

/-- The absolute Euclidean polar from blueprint `lem:transference`. -/
def euclideanPolar {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (K : Set E) : Set E := (innerₗ E).polar K

theorem mem_euclideanPolar {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (K : Set E) (y : E) : y ∈ euclideanPolar K ↔ ∀ x ∈ K, |inner ℝ x y| ≤ 1 := by
  simp [euclideanPolar, LinearMap.polar, Real.norm_eq_abs]

theorem euclideanPolar_closed {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (K : Set E) : IsClosed (euclideanPolar K) := by
  rw [euclideanPolar, LinearMap.polar_eq_biInter_preimage]
  exact isClosed_biInter fun x _ => Metric.isClosed_closedBall.preimage
    (continuous_const.inner continuous_id)

theorem euclideanPolar_convex {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (K : Set E) : Convex ℝ (euclideanPolar K) :=
  (LinearMap.polar_AbsConvex (B := innerₗ E) K).2

theorem euclideanPolar_bounded {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {K : Set E} (hK : K ∈ 𝓝 (0 : E)) :
    Bornology.IsBounded (euclideanPolar K) := by
  obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp hK
  apply isBounded_iff_forall_norm_le.mpr
  refine ⟨2 / r, fun y hy => ?_⟩
  by_cases hy0 : y = 0
  · simp only [hy0, norm_zero]
    positivity
  have hn : 0 < ‖y‖ := norm_pos_iff.mpr hy0
  let t : ℝ := r / (2 * ‖y‖)
  have ht : 0 < t := div_pos hr (by positivity)
  have htn : t * ‖y‖ = r / 2 := by dsimp [t]; field_simp
  have hx : t • y ∈ K := hball (by
    rw [Metric.mem_ball, dist_zero_right, norm_smul, Real.norm_eq_abs, abs_of_pos ht, htn]
    linarith)
  have hpair := (mem_euclideanPolar K y).mp hy (t • y) hx
  rw [real_inner_smul_left, real_inner_self_eq_norm_sq,
    abs_of_nonneg (mul_nonneg ht.le (sq_nonneg _))] at hpair
  apply (le_div_iff₀ hr).mpr
  nlinarith [mul_nonneg (norm_nonneg y) ht.le]

theorem euclideanPolar_zero_interior {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {K : Set E} (hK : Bornology.IsBounded K) :
    (0 : E) ∈ interior (euclideanPolar K) := by
  obtain ⟨R, hR, hbound⟩ := hK.exists_pos_norm_le
  rw [mem_interior_iff_mem_nhds, Metric.mem_nhds_iff]
  refine ⟨R⁻¹, inv_pos.mpr hR, fun y hy => ?_⟩
  rw [Metric.mem_ball, dist_zero_right] at hy
  apply (mem_euclideanPolar K y).mpr
  intro x hx
  calc
    |inner ℝ x y| ≤ ‖x‖ * ‖y‖ := abs_real_inner_le_norm x y
    _ ≤ R * ‖y‖ := mul_le_mul_of_nonneg_right (hbound x hx) (norm_nonneg _)
    _ ≤ 1 := by
      have h := mul_lt_mul_of_pos_left hy hR
      simpa only [mul_inv_cancel₀ hR.ne'] using h.le

/-- The polar again satisfies all convex-body hypotheses needed to define
and attain its successive minima. -/
theorem symmetricConvexBody_polar {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) : IsSymmetricConvexBody (euclideanPolar K) := by
  refine ⟨?_, euclideanPolar_convex K, ?_, ?_⟩
  · exact Metric.isCompact_iff_isClosed_bounded.mpr ⟨euclideanPolar_closed K,
      euclideanPolar_bounded
        (mem_interior_iff_mem_nhds.mp (symmetricConvexBody_zero_interior hK))⟩
  · intro y hy
    apply (mem_euclideanPolar K (-y)).mpr
    intro x hx
    simpa only [inner_neg_right, abs_neg] using (mem_euclideanPolar K y).mp hy x hx
  · exact ⟨0, euclideanPolar_zero_interior hK.compact.isBounded⟩

/-- The least nonnegative gauge radius containing a finite tuple. -/
noncomputable def latticeTupleRadius {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {j : ℕ} (K : Set E) (v : Fin j → E) : ℝ :=
  (Finset.univ.sup (fun i => (⟨gauge K (v i), gauge_nonneg _⟩ : NNReal)) : NNReal)

theorem latticeTupleRadius_nonneg {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {j : ℕ} (K : Set E) (v : Fin j → E) :
    0 ≤ latticeTupleRadius K v := NNReal.coe_nonneg _

theorem gauge_le_latticeTupleRadius {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {j : ℕ} (K : Set E) (v : Fin j → E) (i : Fin j) :
    gauge K (v i) ≤ latticeTupleRadius K v := by
  exact_mod_cast (Finset.le_sup (f := fun k =>
    (⟨gauge K (v k), gauge_nonneg _⟩ : NNReal)) (Finset.mem_univ i))

theorem latticeTupleRadius_le_iff {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {j : ℕ} (K : Set E) (v : Fin j → E)
    {r : ℝ} (hr : 0 ≤ r) : latticeTupleRadius K v ≤ r ↔ ∀ i, gauge K (v i) ≤ r := by
  change Finset.univ.sup (fun i => (⟨gauge K (v i), gauge_nonneg _⟩ : NNReal)) ≤
    (⟨r, hr⟩ : NNReal) ↔ _
  simp only [Finset.sup_le_iff, Finset.mem_univ, forall_const]
  rfl

/-- Independent lattice tuples are the witnesses in the successive-minimum definition. -/
def IndependentLatticeTuple {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (L : Submodule ℤ E) {j : ℕ} (v : Fin j → E) : Prop :=
  LinearIndependent ℝ v ∧ ∀ i, v i ∈ L

/-- Blueprint `lem:transference`, line 305: among independent tuples of a fixed
length, a tuple of least gauge radius exists as soon as one tuple exists. -/
theorem exists_minimal_lattice_tuple {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    {j : ℕ} (v : Fin j → E) (hv : IndependentLatticeTuple L v) :
    ∃ w : Fin j → E, IndependentLatticeTuple L w ∧
      ∀ u : Fin j → E, IndependentLatticeTuple L u →
        latticeTupleRadius K w ≤ latticeTupleRadius K u := by
  let R := latticeTupleRadius K v + 1
  have hR : 0 < R := by dsimp [R]; linarith [latticeTupleRadius_nonneg K v]
  let S : Set (Fin j → E) := {w | IndependentLatticeTuple L w ∧ latticeTupleRadius K w ≤ R}
  have hpoints : ({x : E | gauge K x ≤ R} ∩ (L : Set E)).Finite :=
    lattice_bounded_inter_finite L (symmetricConvexBody_gauge_sublevel_compact hK hR).isBounded
  have hfinite : S.Finite := (Set.Finite.pi' (fun _ : Fin j => hpoints)).subset (by
    intro w hw i
    exact ⟨(gauge_le_latticeTupleRadius K w i).trans hw.2, hw.1.2 i⟩)
  have hvS : v ∈ S := ⟨hv, by dsimp [R]; linarith⟩
  obtain ⟨w, hw, hmin⟩ := Set.exists_min_image S (latticeTupleRadius K) hfinite ⟨v, hvS⟩
  refine ⟨w, hw.1, fun u hu => ?_⟩
  by_cases huR : latticeTupleRadius K u ≤ R
  · exact hmin u ⟨hu, huR⟩
  · exact hw.2.trans (le_of_not_ge huR)

/-- The dilation parameters containing `j` real-linearly independent lattice
vectors, exactly as in blueprint `lem:transference`. -/
def successiveDilationSet {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (K : Set E) (L : Submodule ℤ E) (j : ℕ) : Set ℝ :=
  {t | 0 < t ∧ ∃ v : Fin j → E, IndependentLatticeTuple L v ∧ ∀ i, v i ∈ t • K}

/-- The `j`th successive minimum of the body `K` and lattice `L`. -/
noncomputable def successiveMinimum {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (K : Set E) (L : Submodule ℤ E) (j : ℕ) : ℝ := sInf (successiveDilationSet K L j)

theorem successiveDilationSet_bddBelow {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (K : Set E) (L : Submodule ℤ E) (j : ℕ) :
    BddBelow (successiveDilationSet K L j) := ⟨0, fun _ ht => ht.1.le⟩

theorem successiveMinimum_le_of_tuple {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} {L : Submodule ℤ E} {j : ℕ} {t : ℝ}
    (ht : 0 < t) (v : Fin j → E) (hv : IndependentLatticeTuple L v)
    (hmem : ∀ i, v i ∈ t • K) : successiveMinimum K L j ≤ t :=
  csInf_le (successiveDilationSet_bddBelow K L j) ⟨ht, v, hv, hmem⟩

/-- Blueprint `lem:transference`, line 305: the positive successive minimum
is attained by an independent tuple whenever a tuple of that length exists. -/
theorem successiveMinimum_attained_of_tuple {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    {j : ℕ} (hj : 0 < j) (v : Fin j → E) (hv : IndependentLatticeTuple L v) :
    0 < successiveMinimum K L j ∧ ∃ w : Fin j → E,
      IndependentLatticeTuple L w ∧ ∀ i, w i ∈ successiveMinimum K L j • K := by
  obtain ⟨w, hw, hmin⟩ := exists_minimal_lattice_tuple hK L v hv
  have hpos : 0 < latticeTupleRadius K w :=
    (symmetricConvexBody_gauge_pos hK (hw.1.ne_zero ⟨0, hj⟩)).trans_le
      (gauge_le_latticeTupleRadius K w ⟨0, hj⟩)
  have hwmem : ∀ i, w i ∈ latticeTupleRadius K w • K := fun i =>
    (symmetricConvexBody_gauge_le hK (w i) hpos).mp (gauge_le_latticeTupleRadius K w i)
  have hleast : IsLeast (successiveDilationSet K L j) (latticeTupleRadius K w) := by
    refine ⟨⟨hpos, w, hw, hwmem⟩, ?_⟩
    rintro t ⟨ht, u, hu, humem⟩
    exact (hmin u hu).trans ((latticeTupleRadius_le_iff K u ht.le).mpr (fun i =>
      (symmetricConvexBody_gauge_le hK (u i) ht).mpr (humem i)))
  have heq : successiveMinimum K L j = latticeTupleRadius K w := hleast.csInf_eq
  rw [heq]
  exact ⟨hpos, w, hw, hwmem⟩

/-- Every admissible initial segment of a lattice basis supplies an independent
tuple, so all successive minima from one through the dimension are attained. -/
theorem successiveMinimum_attained {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) {n : ℕ} (b : Module.Basis (Fin n) ℝ E)
    {j : ℕ} (hj : 0 < j) (hjn : j ≤ n) :
    0 < successiveMinimum K (Submodule.span ℤ (Set.range b)) j ∧ ∃ w : Fin j → E,
      IndependentLatticeTuple (Submodule.span ℤ (Set.range b)) w ∧
        ∀ i, w i ∈ successiveMinimum K (Submodule.span ℤ (Set.range b)) j • K := by
  apply successiveMinimum_attained_of_tuple hK _ hj (fun i => b (Fin.castLE hjn i))
  exact ⟨b.linearIndependent.comp _ (Fin.castLE_injective hjn),
    fun i => Submodule.subset_span ⟨Fin.castLE hjn i, rfl⟩⟩

/-- Basis-free version of attainment for every full lattice. -/
theorem successiveMinimum_attained_fullLattice {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] {j : ℕ} (hj : 0 < j) (hjn : j ≤ Module.finrank ℝ E) :
    0 < successiveMinimum K L j ∧ ∃ w : Fin j → E,
      IndependentLatticeTuple L w ∧ ∀ i, w i ∈ successiveMinimum K L j • K := by
  let := ZLattice.module_finite ℝ L
  let := ZLattice.module_free ℝ L
  let b := (Module.finBasis ℤ L).ofZLatticeBasis ℝ L
  have hjb : j ≤ Module.finrank ℤ L := by rwa [ZLattice.rank ℝ L]
  have h := successiveMinimum_attained hK b hj hjb
  simpa only [b, Module.Basis.ofZLatticeBasis_span] using h

/-- Two independent lists whose lengths sum to more than the ambient
dimension cannot have all their cross inner products zero. -/
theorem independent_lists_nonzero_pairing {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {j k : ℕ}
    (v : Fin j → E) (w : Fin k → E) (hv : LinearIndependent ℝ v)
    (hw : LinearIndependent ℝ w) (hdim : Module.finrank ℝ E < j + k) :
    ∃ i l, inner ℝ (v i) (w l) ≠ 0 := by
  by_contra h
  push Not at h
  let P := Submodule.span ℝ (Set.range v)
  let Q := Submodule.span ℝ (Set.range w)
  have hQP : Q ≤ Pᗮ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨l, rfl⟩
    apply (P.mem_orthogonal' (w l)).mpr
    have hker : P ≤ (innerₗ E (w l)).ker := by
      apply Submodule.span_le.mpr
      rintro _ ⟨i, rfl⟩
      change inner ℝ (w l) (v i) = 0
      rw [real_inner_comm]
      exact h i l
    exact fun x hx => hker hx
  have hP : Module.finrank ℝ P = j := by
    simpa only [P, Fintype.card_fin] using finrank_span_eq_card hv
  have hQ : Module.finrank ℝ Q = k := by
    simpa only [Q, Fintype.card_fin] using finrank_span_eq_card hw
  have hle := Submodule.finrank_mono hQP
  have heq := P.finrank_add_finrank_orthogonal
  omega

theorem inner_le_of_mem_dilate_polar {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {K : Set E} {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b)
    {x y : E} (hx : x ∈ a • K) (hy : y ∈ b • euclideanPolar K) :
    |inner ℝ x y| ≤ a * b := by
  obtain ⟨u, hu, rfl⟩ := Set.mem_smul_set.mp hx
  obtain ⟨v, hv, rfl⟩ := Set.mem_smul_set.mp hy
  have h := (mem_euclideanPolar K v).mp hv u hu
  calc
    |inner ℝ (a • u) (b • v)| = a * b * |inner ℝ u v| := by
      rw [real_inner_smul_left, inner_smul_right, abs_mul, abs_mul,
        abs_of_nonneg ha, abs_of_nonneg hb]
      ring
    _ ≤ a * b * 1 := mul_le_mul_of_nonneg_left h (mul_nonneg ha hb)
    _ = a * b := mul_one _

/-- Blueprint `lem:transference`, line 305: the product of complementary
successive minima of a body and its dual lattice polar is at least one. -/
theorem successiveMinimum_product_lower {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) {n : ℕ} (b : Module.Basis (Fin n) ℝ E)
    {j : ℕ} (hj : 0 < j) (hjn : j ≤ n) :
    1 ≤ successiveMinimum K (Submodule.span ℤ (Set.range b)) j *
      successiveMinimum (euclideanPolar K)
        (euclideanDualLattice (Submodule.span ℤ (Set.range b))) (n + 1 - j) := by
  obtain ⟨hp, v, hv, hvmem⟩ := successiveMinimum_attained hK b hj hjn
  have hk : 0 < n + 1 - j := by omega
  have hkn : n + 1 - j ≤ n := by omega
  have hdual := successiveMinimum_attained (symmetricConvexBody_polar hK)
    (euclideanDualBasis b) hk hkn
  rw [← euclideanDualLattice_span b] at hdual
  obtain ⟨hq, w, hw, hwmem⟩ := hdual
  have hdim : Module.finrank ℝ E = n := by
    simpa only [Fintype.card_fin] using Module.finrank_eq_card_basis b
  obtain ⟨i, l, hil⟩ := independent_lists_nonzero_pairing v w hv.1 hw.1 (by omega)
  have hlower := lattice_pairing_abs_ge_one (hw.2 l) (hv.2 i)
    (by simpa only [real_inner_comm] using hil)
  have hupper := inner_le_of_mem_dilate_polar hp.le hq.le (hvmem i) (hwmem l)
  rw [real_inner_comm (w l) (v i)] at hupper
  exact hlower.trans hupper

theorem successiveMinimum_product_lower_fullLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] {j : ℕ} (hj : 0 < j) (hjn : j ≤ Module.finrank ℝ E) :
    1 ≤ successiveMinimum K L j * successiveMinimum (euclideanPolar K)
      (euclideanDualLattice L) (Module.finrank ℝ E + 1 - j) := by
  let := ZLattice.module_finite ℝ L
  let := ZLattice.module_free ℝ L
  let b := (Module.finBasis ℤ L).ofZLatticeBasis ℝ L
  have hjb : j ≤ Module.finrank ℤ L := by rwa [ZLattice.rank ℝ L]
  have h := successiveMinimum_product_lower hK b hj hjb
  simpa only [b, Module.Basis.ofZLatticeBasis_span, ZLattice.rank ℝ L] using h

theorem unitBall_symmetricConvexBody {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] :
    IsSymmetricConvexBody (Metric.closedBall (0 : E) 1) := by
  refine ⟨isCompact_closedBall _ _, convex_closedBall _ _, ?_, ?_⟩
  · intro x hx
    simpa only [Metric.mem_closedBall, dist_zero_right, norm_neg] using hx
  · exact ⟨0, mem_interior_iff_mem_nhds.mpr (Metric.closedBall_mem_nhds 0 zero_lt_one)⟩

theorem euclideanPolar_unitBall {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] :
    euclideanPolar (Metric.closedBall (0 : E) 1) = Metric.closedBall 0 1 := by
  ext y
  rw [mem_euclideanPolar, Metric.mem_closedBall, dist_zero_right]
  constructor
  · intro hy
    by_cases hy0 : y = 0
    · simp [hy0]
    have hn : 0 < ‖y‖ := norm_pos_iff.mpr hy0
    have hx : ‖y‖⁻¹ • y ∈ Metric.closedBall (0 : E) 1 := by
      simp only [Metric.mem_closedBall, dist_zero_right, norm_smul,
        Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hn), inv_mul_cancel₀ hn.ne', le_refl]
    have h := hy _ hx
    rw [real_inner_smul_left, real_inner_self_eq_norm_sq,
      abs_of_nonneg (mul_nonneg (inv_nonneg.mpr hn.le) (sq_nonneg _))] at h
    simpa only [pow_two, ← mul_assoc, inv_mul_cancel₀ hn.ne', one_mul] using h
  · intro hy x hx
    rw [Metric.mem_closedBall, dist_zero_right] at hx
    exact (abs_real_inner_le_norm x y).trans
      ((mul_le_mul hx hy (norm_nonneg _) zero_le_one).trans_eq (one_mul 1))

theorem reducedBasis_length_ratio_two {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) {i j : Fin n} (hij : i ≤ j) :
    ‖InnerProductSpace.gramSchmidt ℝ b i‖ ≤
      (2 : ℝ) ^ (j.val - i.val) * ‖InnerProductSpace.gramSchmidt ℝ b j‖ :=
  (reducedBasis_length_ratio_coarse b hb hr hij).trans
    (mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (by norm_num) (by norm_num) _)
      (norm_nonneg _))

theorem reducedBasis_primal_prefix_bound {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) {i j : Fin n} (hij : i ≤ j) :
    ‖b i‖ ≤ (2 : ℝ) ^ n * ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
  have hs : 0 < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  have hc : 2 / Real.sqrt 3 ≤ (2 : ℝ) := by
    apply (div_le_iff₀ hs).mpr
    have := Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)
    nlinarith
  calc
    _ ≤ (2 / Real.sqrt 3) ^ i.val * ‖InnerProductSpace.gramSchmidt ℝ b i‖ :=
      reducedBasis_norm b hb hr i
    _ ≤ (2 : ℝ) ^ i.val * ((2 : ℝ) ^ (j.val - i.val) *
        ‖InnerProductSpace.gramSchmidt ℝ b j‖) :=
      mul_le_mul (pow_le_pow_left₀ (by positivity) hc _)
        (reducedBasis_length_ratio_two b hb hr hij) (norm_nonneg _) (by positivity)
    _ = (2 : ℝ) ^ j.val * ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
      rw [← mul_assoc, ← pow_add, Nat.add_sub_of_le (Fin.le_def.mp hij)]
    _ ≤ _ := mul_le_mul_of_nonneg_right
      (pow_le_pow_right₀ (by norm_num) j.isLt.le) (norm_nonneg _)

theorem reducedBasis_dual_suffix_bound {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (hb : IsShortestProjectionBasis b)
    (hr : IsSizeReducedBasis b) {i j : Fin n} (hij : j ≤ i) :
    ‖euclideanDualBasis b i‖ ≤ (8 : ℝ) ^ n / ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
  have hi : 0 < ‖InnerProductSpace.gramSchmidt ℝ b i‖ :=
    norm_pos_iff.mpr (InnerProductSpace.gramSchmidt_ne_zero i b.linearIndependent)
  have hj : 0 < ‖InnerProductSpace.gramSchmidt ℝ b j‖ :=
    norm_pos_iff.mpr (InnerProductSpace.gramSchmidt_ne_zero j b.linearIndependent)
  calc
    _ ≤ (4 : ℝ) ^ n / ‖InnerProductSpace.gramSchmidt ℝ b i‖ := reducedBasis_dual_norm b hb hr i
    _ ≤ ((4 : ℝ) ^ n * (2 : ℝ) ^ (i.val - j.val)) /
        ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
      apply (div_le_div_iff₀ hi hj).mpr
      simpa only [mul_assoc] using mul_le_mul_of_nonneg_left
        (reducedBasis_length_ratio_two b hb hr hij) (by positivity : 0 ≤ (4 : ℝ) ^ n)
    _ ≤ ((4 : ℝ) ^ n * (2 : ℝ) ^ n) / ‖InnerProductSpace.gramSchmidt ℝ b j‖ := by
      apply div_le_div_of_nonneg_right _ hj.le
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_right₀ (by norm_num) ((Nat.sub_le _ _).trans i.isLt.le)) (by positivity)
    _ = _ := by rw [← mul_pow]; norm_num

/-- Blueprint `lem:transference`, line 307: for the Euclidean unit ball the
product of complementary successive minima is bounded by `16^d`. -/
theorem successiveMinimum_ball_product_upper {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) {j : ℕ} (hj : 0 < j) (hjn : j ≤ n) :
    successiveMinimum (Metric.closedBall (0 : E) 1) (Submodule.span ℤ (Set.range b)) j *
      successiveMinimum (Metric.closedBall (0 : E) 1)
        (euclideanDualLattice (Submodule.span ℤ (Set.range b))) (n + 1 - j) ≤ (16 : ℝ) ^ n := by
  obtain ⟨c, hc, hshort, hred⟩ := exists_reducedShortestProjectionBasis b
  rw [← hc, euclideanDualLattice_span c]
  let p : Fin n := ⟨j - 1, by omega⟩
  let a := ‖InnerProductSpace.gramSchmidt ℝ c p‖
  have ha : 0 < a := norm_pos_iff.mpr
    (InnerProductSpace.gramSchmidt_ne_zero p c.linearIndependent)
  let v : Fin j → E := fun i => c (Fin.castLE hjn i)
  have hv : IndependentLatticeTuple (Submodule.span ℤ (Set.range c)) v :=
    ⟨c.linearIndependent.comp _ (Fin.castLE_injective hjn),
      fun i => Submodule.subset_span ⟨_, rfl⟩⟩
  have hvnorm (i : Fin j) : ‖v i‖ ≤ (2 : ℝ) ^ n * a := by
    apply reducedBasis_primal_prefix_bound c hshort hred
    change i.val ≤ j - 1
    have := i.isLt
    omega
  have hp : 0 < (2 : ℝ) ^ n * a := mul_pos (by positivity) ha
  have hmin₁ := successiveMinimum_le_of_tuple (K := Metric.closedBall (0 : E) 1) hp v hv
    (fun i => (symmetricConvexBody_gauge_le unitBall_symmetricConvexBody (v i) hp).mp (by
      simpa only [gauge_closedBall zero_le_one, div_one] using hvnorm i))
  let t : Fin (n + 1 - j) → Fin n := fun i => ⟨j - 1 + i.val, by have := i.isLt; omega⟩
  have ht : Function.Injective t := by
    intro i l h
    apply Fin.ext
    have hval := congrArg Fin.val h
    dsimp [t] at hval
    omega
  let w : Fin (n + 1 - j) → E := fun i => euclideanDualBasis c (t i)
  have hw : IndependentLatticeTuple (Submodule.span ℤ (Set.range (euclideanDualBasis c))) w :=
    ⟨(euclideanDualBasis c).linearIndependent.comp t ht,
      fun i => Submodule.subset_span ⟨_, rfl⟩⟩
  have hwnorm (i : Fin (n + 1 - j)) : ‖w i‖ ≤ (8 : ℝ) ^ n / a := by
    apply reducedBasis_dual_suffix_bound c hshort hred
    change j - 1 ≤ j - 1 + i.val
    omega
  have hq : 0 < (8 : ℝ) ^ n / a := div_pos (by positivity) ha
  have hmin₂ := successiveMinimum_le_of_tuple (K := Metric.closedBall (0 : E) 1) hq w hw
    (fun i => (symmetricConvexBody_gauge_le unitBall_symmetricConvexBody (w i) hq).mp (by
      simpa only [gauge_closedBall zero_le_one, div_one] using hwnorm i))
  have hnonneg := (successiveMinimum_attained unitBall_symmetricConvexBody
    (euclideanDualBasis c) (j := n + 1 - j) (by omega) (by omega)).1.le
  calc
    _ ≤ ((2 : ℝ) ^ n * a) * ((8 : ℝ) ^ n / a) :=
      mul_le_mul hmin₁ hmin₂ hnonneg hp.le
    _ = (2 : ℝ) ^ n * (8 : ℝ) ^ n := by field_simp
    _ = (16 : ℝ) ^ n := by rw [← mul_pow]; norm_num

theorem successiveMinimum_ball_product_upper_fullLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (L : Submodule ℤ E)
    [DiscreteTopology L] [IsZLattice ℝ L] {j : ℕ}
    (hj : 0 < j) (hjn : j ≤ Module.finrank ℝ E) :
    successiveMinimum (Metric.closedBall (0 : E) 1) L j *
      successiveMinimum (Metric.closedBall (0 : E) 1) (euclideanDualLattice L)
        (Module.finrank ℝ E + 1 - j) ≤ (16 : ℝ) ^ Module.finrank ℝ E := by
  let := ZLattice.module_finite ℝ L
  let := ZLattice.module_free ℝ L
  let b := (Module.finBasis ℤ L).ofZLatticeBasis ℝ L
  have hjb : j ≤ Module.finrank ℤ L := by rwa [ZLattice.rank ℝ L]
  have h := successiveMinimum_ball_product_upper b hj hjb
  simpa only [b, Module.Basis.ofZLatticeBasis_span, ZLattice.rank ℝ L] using h

theorem symmetricConvexBody_exists_basis_mem {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : IsSymmetricConvexBody K) {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) : ∃ c : Module.Basis (Fin n) ℝ E, ∀ i, c i ∈ K := by
  let R := latticeTupleRadius K b + 1
  have hR : 0 < R := by dsimp [R]; linarith [latticeTupleRadius_nonneg K b]
  let u : ℝˣ := Units.mk0 R⁻¹ (inv_ne_zero hR.ne')
  refine ⟨b.unitsSMul (fun _ => u), fun i => ?_⟩
  rw [Module.Basis.unitsSMul_apply]
  change R⁻¹ • b i ∈ K
  apply (symmetricConvexBody_gauge_le_one hK _).mp
  rw [gauge_smul_of_nonneg (inv_nonneg.mpr hR.le), smul_eq_mul]
  have hle : gauge K (b i) ≤ R := (gauge_le_latticeTupleRadius K b i).trans (by
    dsimp [R]; linarith)
  have h := mul_le_mul_of_nonneg_left hle (inv_nonneg.mpr hR.le)
  simpa only [inv_mul_cancel₀ hR.ne'] using h

/-- Blueprint `lem:transference`, line 309: a maximum-determinant basis has
all its vectors in the body and all coordinates of body points bounded by one. -/
theorem symmetricConvexBody_maxDetBasis {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) {n : ℕ} (b : Module.Basis (Fin n) ℝ E) :
    ∃ c : Module.Basis (Fin n) ℝ E, (∀ i, c i ∈ K) ∧
      (∀ v : Fin n → E, (∀ i, v i ∈ K) → |b.det v| ≤ |b.det c|) ∧
      ∀ x ∈ K, ∀ i, |c.repr x i| ≤ 1 := by
  classical
  obtain ⟨c₀, hc₀⟩ := symmetricConvexBody_exists_basis_mem hK b
  let S : Set (Fin n → E) := {v | ∀ i, v i ∈ K}
  have hcompact : IsCompact S := isCompact_pi_infinite (fun _ => hK.compact)
  have hcont : Continuous (fun v : Fin n → E => |b.det v|) := by
    simpa only [Module.Basis.det_apply] using b.continuous_toMatrix.matrix_det.abs
  obtain ⟨v, hv, hmax⟩ := hcompact.exists_isMaxOn ⟨c₀, hc₀⟩ hcont.continuousOn
  have hpos : 0 < |b.det v| :=
    (abs_pos.mpr (b.isUnit_det c₀).ne_zero).trans_le (hmax hc₀)
  have hbasis := (b.is_basis_iff_det).mpr (isUnit_iff_ne_zero.mpr (abs_pos.mp hpos))
  let c : Module.Basis (Fin n) ℝ E := Module.Basis.mk hbasis.1 hbasis.2.ge
  have hc : (c : Fin n → E) = v := Module.Basis.coe_mk _ _
  refine ⟨c, ?_, ?_, ?_⟩
  · simpa only [hc, S, Set.mem_ofPred_eq] using hv
  · intro w hw
    simpa only [hc, Set.mem_ofPred_eq] using hmax hw
  intro x hx i
  have hupdate : Function.update v i x ∈ S := by
    intro l
    by_cases hl : l = i
    · subst l; simpa using hx
    · simpa [Function.update_of_ne hl] using hv l
  have hcoord := congrArg (fun f : E →ₗ[ℝ] ℝ => f x)
    (b.det_smul_mk_coord_eq_det_update hbasis.1 hbasis.2.ge i)
  change b.det v * c.repr x i = b.det (Function.update v i x) at hcoord
  have hbound : |b.det v| * |c.repr x i| ≤ |b.det v| * 1 := by
    rw [← abs_mul, hcoord, mul_one]
    exact hmax hupdate
  exact le_of_mul_le_mul_left hbound hpos

theorem symmetricConvexBody_gauge_smul_le {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : IsSymmetricConvexBody K)
    {x : E} (hx : x ∈ K) (r : ℝ) : gauge K (r • x) ≤ |r| := by
  by_cases hr : 0 ≤ r
  · rw [gauge_smul_of_nonneg hr, smul_eq_mul, abs_of_nonneg hr]
    exact (mul_le_mul_of_nonneg_left (gauge_le_one_of_mem hx) hr).trans_eq (mul_one _)
  · have hr' : 0 ≤ -r := neg_nonneg.mpr (le_of_not_ge hr)
    have heq : r • x = (-r) • (-x) := by simp
    rw [heq, gauge_smul_of_nonneg hr', smul_eq_mul, abs_of_nonpos (le_of_not_ge hr)]
    exact (mul_le_mul_of_nonneg_left
      (gauge_le_one_of_mem (hK.neg_mem x hx)) hr').trans_eq (mul_one _)

/-- The image of the coefficient ℓ1 unit ball lies in the body whenever
the basis vectors lie in the body (blueprint `lem:transference`, line 309). -/
theorem symmetricConvexBody_sum_mem {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : IsSymmetricConvexBody K) {n : ℕ}
    (v : Fin n → E) (hv : ∀ i, v i ∈ K) (u : Fin n → ℝ) (hu : ∑ i, |u i| ≤ 1) :
    (∑ i, u i • v i) ∈ K := by
  apply (symmetricConvexBody_gauge_le_one hK _).mp
  calc
    _ ≤ ∑ i, gauge K (u i • v i) := gauge_sum_le hK.convex
      (absorbent_nhds_zero (mem_interior_iff_mem_nhds.mp (symmetricConvexBody_zero_interior hK)))
      Finset.univ _
    _ ≤ ∑ i, |u i| := Finset.sum_le_sum fun i _ => symmetricConvexBody_gauge_smul_le hK (hv i) _
    _ ≤ 1 := hu

/-- Coordinates in a basis, with the Euclidean rather than supremum norm. -/
noncomputable def basisEuclideanEquiv {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) :
    E ≃ₗ[ℝ] EuclideanSpace ℝ (Fin n) :=
  b.equivFun.trans (WithLp.linearEquiv 2 ℝ (Fin n → ℝ)).symm

@[simp] theorem basisEuclideanEquiv_apply {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (x : E) (i : Fin n) :
    basisEuclideanEquiv b x i = b.repr x i := rfl

theorem euclidean_sum_abs_le {n : ℕ} (x : EuclideanSpace ℝ (Fin n)) :
    ∑ i, |x i| ≤ Real.sqrt n * ‖x‖ := by
  have h := Real.sum_mul_le_sqrt_mul_sqrt Finset.univ (fun _ : Fin n => (1 : ℝ))
    (fun i => |x i|)
  simpa only [one_mul, one_pow, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    nsmul_eq_mul, mul_one, sq_abs, ← EuclideanSpace.real_norm_sq_eq,
    Real.sqrt_sq (norm_nonneg x)] using h

theorem basisEuclideanEquiv_norm_le_sqrt {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (x : E)
    (hx : ∀ i, |b.repr x i| ≤ 1) : ‖basisEuclideanEquiv b x‖ ≤ Real.sqrt n := by
  apply (sq_le_sq₀ (norm_nonneg _) (Real.sqrt_nonneg _)).mp
  rw [Real.sq_sqrt (Nat.cast_nonneg n), EuclideanSpace.real_norm_sq_eq]
  calc
    _ ≤ ∑ _i : Fin n, (1 : ℝ) := Finset.sum_le_sum fun i _ => by
      simpa only [basisEuclideanEquiv_apply, one_pow, sq_abs] using
        pow_le_pow_left₀ (abs_nonneg (b.repr x i)) (hx i) 2
    _ = _ := by simp

theorem symmetricConvexBody_mem_of_coordinate_norm {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K : Set E} (hK : IsSymmetricConvexBody K) {n : ℕ}
    (hn : 0 < n) (b : Module.Basis (Fin n) ℝ E) (hb : ∀ i, b i ∈ K) (x : E)
    (hx : ‖basisEuclideanEquiv b x‖ ≤ (Real.sqrt n)⁻¹) : x ∈ K := by
  have hs : 0 < Real.sqrt n := Real.sqrt_pos.mpr (by exact_mod_cast hn)
  have hsum : ∑ i, |b.repr x i| ≤ 1 := by
    calc
      _ ≤ Real.sqrt n * ‖basisEuclideanEquiv b x‖ := euclidean_sum_abs_le _
      _ ≤ Real.sqrt n * (Real.sqrt n)⁻¹ := mul_le_mul_of_nonneg_left hx hs.le
      _ = 1 := mul_inv_cancel₀ hs.ne'
  simpa only [b.sum_repr] using symmetricConvexBody_sum_mem hK b hb (b.repr x) hsum

/-- The ellipsoid obtained by mapping the Euclidean unit ball through a basis. -/
def basisEllipsoid {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) : Set E := {x | ‖basisEuclideanEquiv b x‖ ≤ 1}

theorem basisEllipsoid_eq_image {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) :
    basisEllipsoid b = (basisEuclideanEquiv b).symm '' Metric.closedBall 0 1 := by
  ext x
  constructor
  · intro hx
    exact ⟨basisEuclideanEquiv b x, by
      simpa only [Metric.mem_closedBall, dist_zero_right, basisEllipsoid,
        Set.mem_ofPred_eq] using hx,
      (basisEuclideanEquiv b).symm_apply_apply x⟩
  · rintro ⟨y, hy, rfl⟩
    simpa only [basisEllipsoid, Set.mem_ofPred_eq, LinearEquiv.apply_symm_apply,
      Metric.mem_closedBall, dist_zero_right] using hy

theorem mem_smul_basisEllipsoid {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {n : ℕ} (b : Module.Basis (Fin n) ℝ E) (x : E)
    {t : ℝ} (ht : 0 < t) : x ∈ t • basisEllipsoid b ↔ ‖basisEuclideanEquiv b x‖ ≤ t := by
  rw [Set.mem_smul_set_iff_inv_smul_mem₀ ht.ne']
  change ‖basisEuclideanEquiv b (t⁻¹ • x)‖ ≤ 1 ↔ _
  rw [map_smul, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ht),
    inv_mul_le_iff₀ ht, mul_one]

theorem euclideanPolar_antitone {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] {K H : Set E} (h : K ⊆ H) :
    euclideanPolar H ⊆ euclideanPolar K := by
  intro y hy
  exact (mem_euclideanPolar K y).mpr fun x hx => (mem_euclideanPolar H y).mp hy x (h hx)

theorem euclideanPolar_smul {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (K : Set E) {t : ℝ} (ht : 0 < t) :
    euclideanPolar (t • K) = t⁻¹ • euclideanPolar K := by
  ext y
  rw [Set.mem_smul_set_iff_inv_smul_mem₀ (inv_ne_zero ht.ne'), inv_inv,
    mem_euclideanPolar, mem_euclideanPolar]
  constructor
  · intro hy x hx
    simpa only [real_inner_smul_left, inner_smul_right] using
      hy (t • x) (Set.smul_mem_smul_set hx)
  · intro hy z hz
    obtain ⟨x, hx, rfl⟩ := Set.mem_smul_set.mp hz
    simpa only [real_inner_smul_left, inner_smul_right] using hy x hx

/-- Blueprint `lem:transference`, lines 309–313: a maximum-determinant
ellipsoid and its polar approximate the body and its polar within `√d`. -/
theorem symmetricConvexBody_ellipsoidComparison {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) {n : ℕ} (hn : 0 < n)
    (b : Module.Basis (Fin n) ℝ E) :
    ∃ c : Module.Basis (Fin n) ℝ E,
      (Real.sqrt n)⁻¹ • basisEllipsoid c ⊆ K ∧
      K ⊆ Real.sqrt n • basisEllipsoid c ∧
      (Real.sqrt n)⁻¹ • euclideanPolar (basisEllipsoid c) ⊆ euclideanPolar K ∧
      euclideanPolar K ⊆ Real.sqrt n • euclideanPolar (basisEllipsoid c) := by
  obtain ⟨c, hc, _, hcoord⟩ := symmetricConvexBody_maxDetBasis hK b
  have hs : 0 < Real.sqrt n := Real.sqrt_pos.mpr (by exact_mod_cast hn)
  have hinner : (Real.sqrt n)⁻¹ • basisEllipsoid c ⊆ K := by
    intro x hx
    exact symmetricConvexBody_mem_of_coordinate_norm hK hn c hc x
      ((mem_smul_basisEllipsoid c x (inv_pos.mpr hs)).mp hx)
  have houter : K ⊆ Real.sqrt n • basisEllipsoid c := by
    intro x hx
    exact (mem_smul_basisEllipsoid c x hs).mpr
      (basisEuclideanEquiv_norm_le_sqrt c x (hcoord x hx))
  refine ⟨c, hinner, houter, ?_, ?_⟩
  · simpa only [euclideanPolar_smul _ hs] using euclideanPolar_antitone houter
  · simpa only [euclideanPolar_smul _ (inv_pos.mpr hs), inv_inv] using
      euclideanPolar_antitone hinner

/-- The transpose of an invertible real map, bundled as an equivalence. -/
noncomputable def euclideanAdjointEquiv {E F : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] [FiniteDimensional ℝ F] (A : E ≃ₗ[ℝ] F) : F ≃ₗ[ℝ] E where
  toLinearMap := A.toLinearMap.adjoint
  invFun := A.symm.toLinearMap.adjoint
  left_inv x := by
    apply ext_inner_right ℝ
    intro y
    calc
      _ = inner ℝ (A.toLinearMap.adjoint x) (A.symm y) :=
        LinearMap.adjoint_inner_left A.symm.toLinearMap y (A.toLinearMap.adjoint x)
      _ = inner ℝ x (A (A.symm y)) := LinearMap.adjoint_inner_left A.toLinearMap (A.symm y) x
      _ = _ := by rw [A.apply_symm_apply]
  right_inv x := by
    apply ext_inner_right ℝ
    intro y
    calc
      _ = inner ℝ (A.symm.toLinearMap.adjoint x) (A y) :=
        LinearMap.adjoint_inner_left A.toLinearMap y (A.symm.toLinearMap.adjoint x)
      _ = inner ℝ x (A.symm (A y)) := LinearMap.adjoint_inner_left A.symm.toLinearMap (A y) x
      _ = _ := by rw [A.symm_apply_apply]

theorem euclideanAdjointEquiv_inner {E F : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] [FiniteDimensional ℝ F] (A : E ≃ₗ[ℝ] F) (x : E) (y : F) :
    inner ℝ x (euclideanAdjointEquiv A y) = inner ℝ (A x) y :=
  LinearMap.adjoint_inner_right A.toLinearMap x y

theorem basis_map_span_mem_iff {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] {n : ℕ} (b : Module.Basis (Fin n) ℝ E)
    (A : E ≃ₗ[ℝ] F) (x : F) :
    x ∈ Submodule.span ℤ (Set.range (b.map A)) ↔ A.symm x ∈ Submodule.span ℤ (Set.range b) := by
  have heq : Submodule.span ℤ (Set.range (b.map A)) =
      (Submodule.span ℤ (Set.range b)).map (A.toLinearMap.restrictScalars ℤ) := by
    rw [Submodule.map_span, Module.Basis.coe_map, Set.range_comp]
    rfl
  rw [heq, Submodule.mem_map]
  constructor
  · rintro ⟨y, hy, rfl⟩
    simpa using hy
  · intro hx
    exact ⟨A.symm x, hx, A.apply_symm_apply x⟩

theorem adjoint_mem_dual_lattice {E F : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] [FiniteDimensional ℝ F] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (A : E ≃ₗ[ℝ] F) {y : F}
    (hy : y ∈ euclideanDualLattice (Submodule.span ℤ (Set.range (b.map A)))) :
    euclideanAdjointEquiv A y ∈ euclideanDualLattice (Submodule.span ℤ (Set.range b)) := by
  apply (mem_euclideanDualLattice _ _).mpr
  intro x hx
  have hAx : A x ∈ Submodule.span ℤ (Set.range (b.map A)) :=
    (basis_map_span_mem_iff b A (A x)).mpr (by simpa using hx)
  obtain ⟨m, hm⟩ := (mem_euclideanDualLattice _ _).mp hy (A x) hAx
  refine ⟨m, ?_⟩
  rw [real_inner_comm x, euclideanAdjointEquiv_inner, real_inner_comm y]
  exact hm

/-- Transport an attained minimum through an invertible linear map when
the image of the source body lies in a fixed dilation of the target body. -/
theorem successiveMinimum_le_transport {E F : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F] [FiniteDimensional ℝ F]
    {K : Set E} {H : Set F} (hH : IsSymmetricConvexBody H) {n : ℕ}
    (b : Module.Basis (Fin n) ℝ F) (T : F ≃ₗ[ℝ] E) (L : Submodule ℤ E)
    (hL : ∀ x ∈ Submodule.span ℤ (Set.range b), T x ∈ L)
    {c : ℝ} (hc : 0 < c) (hcover : ∀ x ∈ H, T x ∈ c • K)
    {j : ℕ} (hj : 0 < j) (hjn : j ≤ n) :
    successiveMinimum K L j ≤ c * successiveMinimum H (Submodule.span ℤ (Set.range b)) j := by
  obtain ⟨hp, v, hv, hmem⟩ := successiveMinimum_attained hH b hj hjn
  apply successiveMinimum_le_of_tuple (mul_pos hc hp) (fun i => T (v i))
    ⟨hv.1.map' T.toLinearMap (LinearMap.ker_eq_bot.mpr T.injective), fun i => hL _ (hv.2 i)⟩
  intro i
  obtain ⟨u, hu, heq⟩ := Set.mem_smul_set.mp (hmem i)
  obtain ⟨z, hz, hzeq⟩ := Set.mem_smul_set.mp (hcover u hu)
  apply Set.mem_smul_set.mpr
  refine ⟨z, hz, ?_⟩
  rw [← heq, map_smul, ← hzeq, smul_smul, mul_comm]

theorem mem_smul_of_inv_smul_subset {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] {K H : Set E} {r : ℝ} (hr : r ≠ 0)
    (h : r⁻¹ • H ⊆ K) {x : E} (hx : x ∈ H) : x ∈ r • K := by
  refine Set.mem_smul_set.mpr ⟨r⁻¹ • x, h (Set.smul_mem_smul_set hx), ?_⟩
  simp only [smul_smul, mul_inv_cancel₀ hr, one_smul]

theorem adjoint_mem_dual_lattice_iff {E F : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] [NormedAddCommGroup F]
    [InnerProductSpace ℝ F] [FiniteDimensional ℝ F] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) (A : E ≃ₗ[ℝ] F) (y : F) :
    euclideanAdjointEquiv A y ∈ euclideanDualLattice (Submodule.span ℤ (Set.range b)) ↔
      y ∈ euclideanDualLattice (Submodule.span ℤ (Set.range (b.map A))) := by
  refine ⟨?_, adjoint_mem_dual_lattice b A⟩
  intro hy
  apply (mem_euclideanDualLattice _ _).mpr
  intro x hx
  obtain ⟨m, hm⟩ := (mem_euclideanDualLattice _ _).mp hy (A.symm x)
    ((basis_map_span_mem_iff b A x).mp hx)
  refine ⟨m, ?_⟩
  rw [real_inner_comm (A.symm x), euclideanAdjointEquiv_inner, A.apply_symm_apply,
    real_inner_comm y] at hm
  exact hm

/-- A unit vector, transported by the transpose coordinate map, belongs to
the polar of the corresponding ellipsoid. -/
theorem adjoint_unitBall_mem_polar_ellipsoid {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {n : ℕ}
    (b : Module.Basis (Fin n) ℝ E) {y : EuclideanSpace ℝ (Fin n)}
    (hy : y ∈ Metric.closedBall 0 1) :
    euclideanAdjointEquiv (basisEuclideanEquiv b) y ∈ euclideanPolar (basisEllipsoid b) := by
  apply (mem_euclideanPolar _ _).mpr
  intro x hx
  rw [euclideanAdjointEquiv_inner]
  have hx' : ‖basisEuclideanEquiv b x‖ ≤ 1 := hx
  have hy' : ‖y‖ ≤ 1 := by simpa only [Metric.mem_closedBall, dist_zero_right] using hy
  exact (abs_real_inner_le_norm _ _).trans
    ((mul_le_mul hx' hy' (norm_nonneg _) zero_le_one).trans_eq (one_mul 1))

/-- Blueprint `lem:transference`, line 314: general symmetric convex bodies
satisfy the upper complementary-minima bound `d * 16^d`. -/
theorem successiveMinimum_product_upper {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) {n : ℕ} (b : Module.Basis (Fin n) ℝ E)
    {j : ℕ} (hj : 0 < j) (hjn : j ≤ n) :
    successiveMinimum K (Submodule.span ℤ (Set.range b)) j *
      successiveMinimum (euclideanPolar K)
        (euclideanDualLattice (Submodule.span ℤ (Set.range b))) (n + 1 - j) ≤
          (n : ℝ) * (16 : ℝ) ^ n := by
  have hn : 0 < n := hj.trans_le hjn
  have hr : 0 < Real.sqrt n := Real.sqrt_pos.mpr (by exact_mod_cast hn)
  obtain ⟨c, hinner, _, hpolar, _⟩ := symmetricConvexBody_ellipsoidComparison hK hn b
  let A := basisEuclideanEquiv c
  let b' := b.map A
  let U := Metric.closedBall (0 : EuclideanSpace ℝ (Fin n)) 1
  have hcover₁ : ∀ x ∈ U, A.symm x ∈ Real.sqrt n • K := by
    intro x hx
    apply mem_smul_of_inv_smul_subset hr.ne' hinner
    change ‖A (A.symm x)‖ ≤ 1
    simpa only [LinearEquiv.apply_symm_apply, U, Metric.mem_closedBall, dist_zero_right] using hx
  have h₁ := successiveMinimum_le_transport unitBall_symmetricConvexBody b' A.symm
    (Submodule.span ℤ (Set.range b)) (fun x hx => (basis_map_span_mem_iff b A x).mp hx)
    hr hcover₁ hj hjn
  have hcover₂ : ∀ x ∈ U, euclideanAdjointEquiv A x ∈ Real.sqrt n • euclideanPolar K := by
    intro x hx
    exact mem_smul_of_inv_smul_subset hr.ne' hpolar (adjoint_unitBall_mem_polar_ellipsoid c hx)
  have hk : 0 < n + 1 - j := by omega
  have hkn : n + 1 - j ≤ n := by omega
  have h₂ := successiveMinimum_le_transport unitBall_symmetricConvexBody (euclideanDualBasis b')
    (euclideanAdjointEquiv A) (euclideanDualLattice (Submodule.span ℤ (Set.range b)))
    (fun x hx => adjoint_mem_dual_lattice b A
      (by simpa only [euclideanDualLattice_span] using hx)) hr hcover₂ hk hkn
  rw [← euclideanDualLattice_span b'] at h₂
  have hnonneg := (successiveMinimum_attained (symmetricConvexBody_polar hK)
    (euclideanDualBasis b) hk hkn).1.le
  rw [← euclideanDualLattice_span b] at hnonneg
  have hpos := (successiveMinimum_attained unitBall_symmetricConvexBody b' hj hjn).1.le
  have hball := successiveMinimum_ball_product_upper b' hj hjn
  calc
    _ ≤ (Real.sqrt n * successiveMinimum U (Submodule.span ℤ (Set.range b')) j) *
        (Real.sqrt n * successiveMinimum U
          (euclideanDualLattice (Submodule.span ℤ (Set.range b'))) (n + 1 - j)) :=
      mul_le_mul h₁ h₂ hnonneg (mul_nonneg hr.le hpos)
    _ = (n : ℝ) * (successiveMinimum U (Submodule.span ℤ (Set.range b')) j *
        successiveMinimum U (euclideanDualLattice (Submodule.span ℤ (Set.range b')))
          (n + 1 - j)) := by
      rw [show ∀ a d : ℝ, (Real.sqrt n * a) * (Real.sqrt n * d) =
        (Real.sqrt n) ^ 2 * (a * d) from fun a d => by ring, Real.sq_sqrt (Nat.cast_nonneg n)]
    _ ≤ _ := mul_le_mul_of_nonneg_left hball (Nat.cast_nonneg n)

theorem successiveMinimum_product_upper_fullLattice {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] {j : ℕ} (hj : 0 < j) (hjn : j ≤ Module.finrank ℝ E) :
    successiveMinimum K L j * successiveMinimum (euclideanPolar K)
      (euclideanDualLattice L) (Module.finrank ℝ E + 1 - j) ≤
        (Module.finrank ℝ E : ℝ) * (16 : ℝ) ^ Module.finrank ℝ E := by
  let := ZLattice.module_finite ℝ L
  let := ZLattice.module_free ℝ L
  let b := (Module.finBasis ℤ L).ofZLatticeBasis ℝ L
  have hjb : j ≤ Module.finrank ℤ L := by rwa [ZLattice.rank ℝ L]
  have h := successiveMinimum_product_upper hK b hj hjb
  simpa only [b, Module.Basis.ofZLatticeBasis_span, ZLattice.rank ℝ L] using h

theorem transference_constant_bound {n : ℕ} (hn : 0 < n) :
    (n : ℝ) * (16 : ℝ) ^ n ≤ (100 * (n : ℝ)) ^ (10 * n) := by
  have hn1 : (1 : ℝ) ≤ n := by exact_mod_cast hn
  have hbase : (1 : ℝ) ≤ 100 * n := by linarith
  calc
    _ ≤ (100 * (n : ℝ)) * (100 * (n : ℝ)) ^ n :=
      mul_le_mul (by nlinarith) (pow_le_pow_left₀ (by norm_num) (by linarith) n)
        (by positivity) (by positivity)
    _ = (100 * (n : ℝ)) ^ (n + 1) := by rw [pow_succ]; ring
    _ ≤ _ := pow_le_pow_right₀ hbase (by omega)

/-- Blueprint `lem:transference`, complete statement: for every compact symmetric
convex body with nonempty interior and every full lattice, complementary
successive minima have product between one and `d * 16^d`, hence at most
`(100d)^(10d)`. No form of Minkowski's second theorem is assumed. -/
theorem successiveMinimaProduct {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] {j : ℕ} (hj : 0 < j) (hjn : j ≤ Module.finrank ℝ E) :
    1 ≤ successiveMinimum K L j * successiveMinimum (euclideanPolar K)
      (euclideanDualLattice L) (Module.finrank ℝ E + 1 - j) ∧
    successiveMinimum K L j * successiveMinimum (euclideanPolar K)
      (euclideanDualLattice L) (Module.finrank ℝ E + 1 - j) ≤
        (Module.finrank ℝ E : ℝ) * (16 : ℝ) ^ Module.finrank ℝ E ∧
    (Module.finrank ℝ E : ℝ) * (16 : ℝ) ^ Module.finrank ℝ E ≤
      (100 * (Module.finrank ℝ E : ℝ)) ^ (10 * Module.finrank ℝ E) :=
  ⟨successiveMinimum_product_lower_fullLattice hK L hj hjn,
    successiveMinimum_product_upper_fullLattice hK L hj hjn,
    transference_constant_bound (hj.trans_le hjn)⟩

/-! ### Cyclic rational lattices -/

/-- A triangular coordinate change whose distinguished basis vector has denominator `q`.
 It provides the full lattice used in blueprint `lem:local-chart`, lines 1035-1039. -/
noncomputable def cyclicCoordinateEquiv {ι : Type*} [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) : (ι → ℝ) ≃ₗ[ℝ] (ι → ℝ) where
  toFun x j := if j = i₀ then x i₀ / q else x j + (a j : ℝ) * x i₀ / q
  invFun y j := if j = i₀ then q * y i₀ else y j - (a j : ℝ) * y i₀
  left_inv x := by
    have hq : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne q)
    funext j
    by_cases hj : j = i₀
    · subst j
      simp
      field_simp
    · simp [hj]
      field_simp
      ring
  right_inv y := by
    have hq : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne q)
    funext j
    by_cases hj : j = i₀
    · subst j
      simp [hq]
    · simp [hj]
      field_simp
      ring
  map_add' x y := by
    funext j
    by_cases hj : j = i₀ <;> simp [hj] <;> ring
  map_smul' c x := by
    funext j
    by_cases hj : j = i₀ <;> simp [hj] <;> ring

/-- A Euclidean full basis for the cyclic lift lattice. -/
noncomputable def cyclicLiftBasis {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) :
    Module.Basis ι ℝ (EuclideanSpace ℝ ι) :=
  (Pi.basisFun ℝ ι).map
    ((cyclicCoordinateEquiv q a i₀).trans (WithLp.linearEquiv 2 ℝ (ι → ℝ)).symm)

/-- The integer span of the rational cyclic basis, automatically a full discrete lattice. -/
noncomputable abbrev cyclicLiftLattice {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) : Submodule ℤ (EuclideanSpace ℝ ι) :=
  Submodule.span ℤ (Set.range (cyclicLiftBasis q a i₀))

instance cyclicLiftLattice_discrete {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) : DiscreteTopology (cyclicLiftLattice q a i₀) := by
  unfold cyclicLiftLattice
  infer_instance

instance cyclicLiftLattice_full {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) : IsZLattice ℝ (cyclicLiftLattice q a i₀) := by
  unfold cyclicLiftLattice
  infer_instance

/-- Real coordinates in the cyclic basis have a triangular explicit formula. -/
theorem cyclicLiftBasis_repr {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x : EuclideanSpace ℝ ι) (i : ι) :
    (cyclicLiftBasis q a i₀).repr x i =
      if i = i₀ then (q : ℝ) * x i₀ else x i - (a i : ℝ) * x i₀ := by
  rfl

/-- The integer coordinates of a lattice point agree with its real basis coordinates. -/
theorem cyclicLiftLattice_integer_coordinates {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x : cyclicLiftLattice q a i₀) (i : ι) :
    (((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x i : ℝ) =
      if i = i₀ then (q : ℝ) * (x : EuclideanSpace ℝ ι) i₀
      else (x : EuclideanSpace ℝ ι) i - (a i : ℝ) * (x : EuclideanSpace ℝ ι) i₀ := by
  exact (cyclicLiftBasis q a i₀).restrictScalars_repr_apply ℤ x i

/-- Every integer vector belongs to the cyclic lift lattice. -/
theorem integerVector_mem_cyclicLiftLattice {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (z : ι → ℤ) :
    WithLp.toLp 2 (fun i => (z i : ℝ)) ∈ cyclicLiftLattice q a i₀ := by
  apply ((cyclicLiftBasis q a i₀).mem_span_iff_repr_mem ℤ _).mpr
  intro i
  rw [cyclicLiftBasis_repr]
  by_cases hi : i = i₀
  · refine ⟨(q : ℤ) * z i₀, ?_⟩
    simp [hi]
  · refine ⟨z i - a i * z i₀, ?_⟩
    simp [hi]

/-- The cyclic quotient is the distinguished integer basis coefficient modulo `q`. -/
noncomputable def cyclicLiftProjection {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) : cyclicLiftLattice q a i₀ →+ ZMod q where
  toFun x := (((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x i₀ : ZMod q)
  map_zero' := by simp only [map_zero, Finsupp.zero_apply, Int.cast_zero]
  map_add' x y := by simp only [map_add, Finsupp.add_apply, Int.cast_add]

theorem cyclicLiftProjection_basis {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ i : ι) :
    cyclicLiftProjection q a i₀ ((cyclicLiftBasis q a i₀).restrictScalars ℤ i) =
      if i = i₀ then 1 else 0 := by
  change ((((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr
    ((cyclicLiftBasis q a i₀).restrictScalars ℤ i)) i₀ : ZMod q) = _
  rw [Module.Basis.repr_self]
  by_cases hi : i = i₀ <;> simp [hi]

theorem cyclicLiftProjection_surjective {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) :
    Function.Surjective (cyclicLiftProjection q a i₀) := by
  intro z
  refine ⟨z.val • (cyclicLiftBasis q a i₀).restrictScalars ℤ i₀, ?_⟩
  rw [map_nsmul, cyclicLiftProjection_basis]
  simp

/-- The kernel consists exactly of the vectors with integer coordinates. -/
theorem cyclicLiftProjection_eq_zero_iff {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x : cyclicLiftLattice q a i₀) :
    cyclicLiftProjection q a i₀ x = 0 ↔
      ∀ i, ∃ z : ℤ, (x : EuclideanSpace ℝ ι) i = z := by
  let n := ((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x i₀
  have hn : (n : ℝ) = (q : ℝ) * (x : EuclideanSpace ℝ ι) i₀ := by
    simpa only [ite_true] using cyclicLiftLattice_integer_coordinates q a i₀ x i₀
  have hq : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne q)
  change (n : ZMod q) = 0 ↔ _
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd]
  constructor
  · rintro ⟨k, hk⟩ i
    have hx0 : (x : EuclideanSpace ℝ ι) i₀ = (k : ℝ) := by
      have hkR : (n : ℝ) = (q : ℝ) * k := by exact_mod_cast hk
      exact mul_left_cancel₀ hq (hn.symm.trans hkR)
    by_cases hi : i = i₀
    · exact ⟨k, by simpa only [hi] using hx0⟩
    · refine ⟨((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x i + a i * k, ?_⟩
      have h := cyclicLiftLattice_integer_coordinates q a i₀ x i
      rw [ite_eq_right hi, hx0] at h
      push_cast
      linarith
  · intro hx
    obtain ⟨k, hk⟩ := hx i₀
    refine ⟨k, ?_⟩
    have h : (n : ℝ) = (q : ℝ) * k := by rw [hn, hk]
    exact_mod_cast h

/-- The frequency associated to each cyclic lift coordinate, with distinguished frequency one. -/
def cyclicLiftFrequency {ι : Type*} [DecidableEq ι] (q : ℕ)
    (a : ι → ℤ) (i₀ i : ι) : ZMod q := if i = i₀ then 1 else a i

/-- Reduction modulo the integer lattice recovers every specified cyclic character. -/
theorem cyclicLiftProjection_character {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x : cyclicLiftLattice q a i₀) (i : ι) :
    ((x : EuclideanSpace ℝ ι) i : UnitAddCircle) =
      ZMod.toAddCircle (cyclicLiftFrequency q a i₀ i * cyclicLiftProjection q a i₀ x) := by
  let z := ((cyclicLiftBasis q a i₀).restrictScalars ℤ).repr x
  have hq : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (NeZero.ne q)
  have h0 : (x : EuclideanSpace ℝ ι) i₀ = (z i₀ : ℝ) / q := by
    have h := cyclicLiftLattice_integer_coordinates q a i₀ x i₀
    simp only [ite_true] at h
    apply (eq_div_iff hq).mpr
    nlinarith only [h]
  by_cases hi : i = i₀
  · subst i
    simp only [cyclicLiftFrequency, ite_true, one_mul]
    change ((x : EuclideanSpace ℝ ι) i₀ : UnitAddCircle) = ZMod.toAddCircle (z i₀ : ZMod q)
    rw [ZMod.toAddCircle_intCast, h0]
  · have hx : (x : EuclideanSpace ℝ ι) i =
        (z i : ℝ) + ((a i * z i₀ : ℤ) : ℝ) / q := by
      have h := cyclicLiftLattice_integer_coordinates q a i₀ x i
      rw [ite_eq_right hi, h0] at h
      rw [← mul_div_assoc] at h
      push_cast
      dsimp only [z] at *
      linarith only [h]
    simp only [cyclicLiftFrequency, ite_eq_right hi]
    change ((x : EuclideanSpace ℝ ι) i : UnitAddCircle) =
      ZMod.toAddCircle ((a i : ZMod q) * (z i₀ : ZMod q))
    rw [← Int.cast_mul, ZMod.toAddCircle_intCast, hx, AddCircle.coe_add]
    simp

/-- Containment of the integer lattice makes every vector in the dual lattice integral. -/
theorem cyclicLiftDual_integer {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (u : EuclideanSpace ℝ ι)
    (hu : u ∈ euclideanDualLattice (cyclicLiftLattice q a i₀)) (i : ι) :
    ∃ z : ℤ, u i = z := by
  have he : EuclideanSpace.single i (1 : ℝ) ∈ cyclicLiftLattice q a i₀ := by
    convert integerVector_mem_cyclicLiftLattice q a i₀ (Pi.single i 1) using 1
    ext j
    simp [Pi.single_apply]
  obtain ⟨z, hz⟩ := (mem_euclideanDualLattice _ _).mp hu _ he
  refine ⟨z, ?_⟩
  simpa only [EuclideanSpace.inner_single_right, one_mul, conj_trivial] using hz.symm

/-- Two cyclic lifts less than one apart cannot have the same projection unless equal. -/
theorem cyclicLiftProjection_injective_near {ι : Type*} [Fintype ι] [DecidableEq ι]
    (q : ℕ) [NeZero q] (a : ι → ℤ) (i₀ : ι) (x y : cyclicLiftLattice q a i₀)
    (hsmall : ‖(x : EuclideanSpace ℝ ι) - (y : EuclideanSpace ℝ ι)‖ < 1)
    (heq : cyclicLiftProjection q a i₀ x = cyclicLiftProjection q a i₀ y) : x = y := by
  have hz : cyclicLiftProjection q a i₀ (x - y) = 0 := by rw [map_sub, heq, sub_self]
  have hint := (cyclicLiftProjection_eq_zero_iff q a i₀ (x - y)).mp hz
  apply Subtype.ext
  apply sub_eq_zero.mp
  ext i
  obtain ⟨z, hz⟩ := hint i
  have hcoord := PiLp.norm_apply_le ((x : EuclideanSpace ℝ ι) - (y : EuclideanSpace ℝ ι)) i
  have hreal : |(z : ℝ)| < 1 := by
    rw [← hz]
    exact hcoord.trans_lt hsmall
  have hint : |z| < (1 : ℤ) := by exact_mod_cast hreal
  have hz0 : z = 0 := by have := abs_lt.mp hint; omega
  change (x : EuclideanSpace ℝ ι) i - (y : EuclideanSpace ℝ ι) i = 0
  change (x : EuclideanSpace ℝ ι) i - (y : EuclideanSpace ℝ ι) i = (z : ℝ) at hz
  simpa only [hz0, Int.cast_zero] using hz

/-- A full lattice containing the integer lattice has integral dual coordinates. For a
 lattice vector `θ`, its basis-coordinate forms on `n θ - k` have integer coefficients;
 blueprint `lem:local-chart`, lines 1054-1057. -/
theorem integer_lattice_dual_coordinates {ι : Type*} [Fintype ι] {n : ℕ}
    (L : Submodule ℤ (EuclideanSpace ℝ ι))
    (hZ : ∀ z : ι → ℤ, WithLp.toLp 2 (fun j => (z j : ℝ)) ∈ L)
    (b : Module.Basis (Fin n) ℝ (EuclideanSpace ℝ ι))
    (hb : Submodule.span ℤ (Set.range b) = L) (θ : EuclideanSpace ℝ ι) (hθ : θ ∈ L) :
    ∃ (U : Fin n → ι → ℤ) (t : Fin n → ℤ),
      (∀ i j, euclideanDualBasis b i j = (U i j : ℝ)) ∧
      (∀ i, inner ℝ (euclideanDualBasis b i) θ = (t i : ℝ)) ∧
      (∀ (x : EuclideanSpace ℝ ι) i, b.repr x i = ∑ j, (U i j : ℝ) * x j) ∧
      ∀ (m : ℤ) (k : ι → ℤ) i,
        b.repr (m • θ - WithLp.toLp 2 (fun j => (k j : ℝ))) i =
          ((t i * m - ∑ j, U i j * k j : ℤ) : ℝ) := by
  classical
  have hdual (i : Fin n) : euclideanDualBasis b i ∈ euclideanDualLattice L := by
    rw [← hb, euclideanDualLattice_span]
    exact Submodule.subset_span (Set.mem_range_self i)
  have hcoord (i : Fin n) (j : ι) : ∃ z : ℤ, euclideanDualBasis b i j = (z : ℝ) := by
    have hj : EuclideanSpace.single j (1 : ℝ) ∈ L := by
      convert hZ (Pi.single j 1) using 1
      ext k
      simp [Pi.single_apply]
    obtain ⟨z, hz⟩ := (mem_euclideanDualLattice L _).mp (hdual i) _ hj
    exact ⟨z, by
      simpa only [EuclideanSpace.inner_single_right, one_mul, conj_trivial] using hz.symm⟩
  choose U hU using hcoord
  have htheta (i : Fin n) : ∃ z : ℤ, inner ℝ (euclideanDualBasis b i) θ = (z : ℝ) := by
    obtain ⟨z, hz⟩ := (mem_euclideanDualLattice L _).mp (hdual i) θ hθ
    exact ⟨z, hz.symm⟩
  choose t ht using htheta
  have hrepr (x : EuclideanSpace ℝ ι) (i : Fin n) :
      b.repr x i = ∑ j, (U i j : ℝ) * x j := by
    rw [← euclideanDualBasis_inner, EuclideanSpace.inner_eq_star_dotProduct]
    simp [dotProduct, hU, mul_comm]
  refine ⟨U, t, hU, ht, hrepr, ?_⟩
  intro m k i
  have hsumθ : (∑ j, (U i j : ℝ) * θ j) = (t i : ℝ) := by
    rw [← hrepr, ← euclideanDualBasis_inner]
    exact ht i
  rw [hrepr, ← Int.cast_smul_eq_zsmul ℝ]
  change (∑ j, (U i j : ℝ) * ((m : ℝ) * θ j - (k j : ℝ))) = _
  calc
    _ = (m : ℝ) * (∑ j, (U i j : ℝ) * θ j) - ∑ j, (U i j : ℝ) * (k j : ℝ) := by
      simp only [mul_sub, Finset.sum_sub_distrib, Finset.mul_sum]
      congr 1
      apply Finset.sum_congr rfl
      intro j _
      ring
    _ = _ := by rw [hsumθ]; push_cast; ring

def euclideanCoordinateCube (d : ℕ) : Set (EuclideanSpace ℝ (Fin d)) :=
  WithLp.toLp 2 '' Set.Icc (fun _ : Fin d => (-1 : ℝ)) (fun _ => 1)

theorem mem_euclideanCoordinateCube {d : ℕ} (x : EuclideanSpace ℝ (Fin d)) :
    x ∈ euclideanCoordinateCube d ↔ ∀ i, |x i| ≤ 1 := by
  constructor
  · rintro ⟨v, hv, rfl⟩ i
    exact abs_le.mpr ⟨hv.1 i, hv.2 i⟩
  · intro hx
    exact ⟨x.ofLp, ⟨fun i => (abs_le.mp (hx i)).1, fun i => (abs_le.mp (hx i)).2⟩, rfl⟩

theorem euclideanCoordinateCube_compact (d : ℕ) :
    IsCompact (euclideanCoordinateCube d) :=
  isCompact_Icc.image (PiLp.continuous_toLp 2 (fun _ : Fin d => ℝ))

theorem euclideanCoordinateCube_convex (d : ℕ) :
    Convex ℝ (euclideanCoordinateCube d) :=
  (convex_Icc (fun _ : Fin d => (-1 : ℝ)) (fun _ => 1)).linear_image
    (WithLp.linearEquiv 2 ℝ (Fin d → ℝ)).symm.toLinearMap

theorem euclideanCoordinateCube_zero (d : ℕ) : 0 ∈ euclideanCoordinateCube d := by
  rw [mem_euclideanCoordinateCube]
  simp

theorem euclideanCoordinateCube_neg {d : ℕ} {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ euclideanCoordinateCube d) : -x ∈ euclideanCoordinateCube d := by
  rw [mem_euclideanCoordinateCube] at hx ⊢
  simpa only [PiLp.neg_apply, abs_neg] using hx

theorem euclideanCoordinateCube_zero_interior (d : ℕ) :
    (0 : EuclideanSpace ℝ (Fin d)) ∈ interior (euclideanCoordinateCube d) := by
  have hs : Metric.ball (0 : EuclideanSpace ℝ (Fin d)) 1 ⊆ euclideanCoordinateCube d := by
    intro x hx
    rw [mem_euclideanCoordinateCube]
    intro i
    have hxi := PiLp.norm_apply_le x i
    have hn : ‖x‖ < 1 := by simpa only [Metric.mem_ball, dist_zero_right] using hx
    simpa only [Real.norm_eq_abs] using hxi.trans hn.le
  exact mem_interior_iff_mem_nhds.mpr
    (Filter.mem_of_superset (Metric.ball_mem_nhds 0 (by norm_num : (0 : ℝ) < 1)) hs)
noncomputable def shortReturnBody {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P : ℝ) :
    Set (EuclideanSpace ℝ (Fin d)) :=
  ((P⁻¹ • V) '' euclideanCoordinateCube k) + euclideanCoordinateCube d

theorem shortReturnBody_cube_subset {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P : ℝ) :
    euclideanCoordinateCube d ⊆ shortReturnBody V P := by
  intro w hw
  exact ⟨0, ⟨0, euclideanCoordinateCube_zero k, map_zero _⟩, w, hw, zero_add _⟩

/-- Blueprint lem:return-splitting, lines 1271-1275: the sum of the image
of the coordinate cube and the ambient coordinate cube is a symmetric
compact convex body with the origin in its interior. -/
theorem shortReturnBody_symmetricConvexBody {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P : ℝ) :
    IsSymmetricConvexBody (shortReturnBody V P) where
  compact := ((euclideanCoordinateCube_compact k).image (P⁻¹ • V).continuous).add
    (euclideanCoordinateCube_compact d)
  convex := ((euclideanCoordinateCube_convex k).linear_image
    (P⁻¹ • V).toLinearMap).add (euclideanCoordinateCube_convex d)
  neg_mem := by
    rintro z ⟨x, ⟨h, hh, rfl⟩, w, hw, rfl⟩
    refine ⟨(P⁻¹ • V) (-h), ⟨-h, euclideanCoordinateCube_neg hh, rfl⟩,
      -w, euclideanCoordinateCube_neg hw, ?_⟩
    simp [add_comm]
  interior_nonempty := ⟨0, interior_mono (shortReturnBody_cube_subset V P)
    (euclideanCoordinateCube_zero_interior d)⟩

theorem mem_shortReturnBody {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P : ℝ)
    (x : EuclideanSpace ℝ (Fin d)) :
    x ∈ shortReturnBody V P ↔
      ∃ (h : EuclideanSpace ℝ (Fin k)) (w : EuclideanSpace ℝ (Fin d)),
        (∀ j, |h j| ≤ 1) ∧ (∀ i, |w i| ≤ 1) ∧ P⁻¹ • V h + w = x := by
  constructor
  · rintro ⟨z, ⟨h, hh, rfl⟩, w, hw, he⟩
    exact ⟨h, w, (mem_euclideanCoordinateCube h).mp hh,
      (mem_euclideanCoordinateCube w).mp hw, he⟩
  · rintro ⟨h, w, hh, hw, he⟩
    exact ⟨(P⁻¹ • V) h, ⟨h, (mem_euclideanCoordinateCube h).mpr hh, rfl⟩,
      w, (mem_euclideanCoordinateCube w).mpr hw, he⟩

theorem finite_list_interval_gap {d : ℕ} (x : Fin d → ℝ) (b : ℕ → ℝ)
    (hb : Antitone b) :
    ∃ j : Fin (d + 1), ∀ i, x i ∉ Set.Ioc (b (j.val + 1)) (b j.val) := by
  classical
  by_contra hn
  push Not at hn
  choose f hf using hn
  have hcard : Fintype.card (Fin d) < Fintype.card (Fin (d + 1)) := by simp
  obtain ⟨j, j', hne, he⟩ := Fintype.exists_ne_map_eq_of_card_lt f hcard
  have hsep (u v : Fin (d + 1)) (huv : u < v) (heq : f u = f v) : False := by
    have hv := (hf v).2
    have hu := (hf u).1
    have hle := hb (show u.val + 1 ≤ v.val by omega)
    rw [← heq] at hv
    linarith only [hv, hu, hle]
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · exact hsep j j' hlt he
  · exact hsep j' j hgt he.symm

theorem geometric_interval_gap {d : ℕ} (x : Fin d → ℝ) {B L : ℝ}
    (hB : 0 < B) (hL : 1 < L) :
    ∃ b : ℝ, 0 < b ∧ b ≤ B ∧ b⁻¹ ≤ B⁻¹ * L ^ (d + 1) ∧
      ∀ i, x i ≤ b ∨ L * b < x i := by
  have hLp : 0 < L := lt_trans zero_lt_one hL
  have hanti : Antitone (fun j : ℕ => B / L ^ j) := by
    intro i j hij
    exact div_le_div_of_nonneg_left hB.le (pow_pos hLp i)
      (pow_le_pow_right₀ hL.le hij)
  obtain ⟨j, hj⟩ := finite_list_interval_gap x (fun j => B / L ^ j) hanti
  refine ⟨B / L ^ (j.val + 1), div_pos hB (pow_pos hLp _), ?_, ?_, ?_⟩
  · exact (div_le_self hB.le (one_le_pow₀ hL.le)).trans le_rfl
  · rw [inv_div]
    have hp : L ^ (j.val + 1) ≤ L ^ (d + 1) :=
      pow_le_pow_right₀ hL.le (by omega)
    have hh := mul_le_mul_of_nonneg_left hp (inv_nonneg.mpr hB.le)
    simpa only [div_eq_mul_inv, mul_comm] using hh
  · intro i
    have he : L * (B / L ^ (j.val + 1)) = B / L ^ j.val := by
      rw [pow_succ]
      field_simp
    have hn := hj i
    rw [Set.mem_Ioc, not_and_or, not_lt, not_le] at hn
    simpa only [he] using hn

/-- Blueprint lem:return-splitting, lines 1275-1279: one geometric interval
avoids all successive minima up to index d, with a controlled reciprocal scale. -/
theorem successiveMinimum_geometric_gap {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] (K : Set E) (Λ : Submodule ℤ E) (d : ℕ)
    {B L : ℝ} (hB : 0 < B) (hL : 1 < L) :
    ∃ b : ℝ, 0 < b ∧ b ≤ B ∧ b⁻¹ ≤ B⁻¹ * L ^ (d + 1) ∧
      ∀ j : ℕ, 0 < j → j ≤ d →
        successiveMinimum K Λ j ≤ b ∨ L * b < successiveMinimum K Λ j := by
  obtain ⟨b, hb, hbB, hrecip, hgap⟩ :=
    geometric_interval_gap (fun i : Fin d => successiveMinimum K Λ (i.val + 1)) hB hL
  refine ⟨b, hb, hbB, hrecip, ?_⟩
  intro j hj hjd
  have hh := hgap ⟨j - 1, by omega⟩
  simpa only [show j - 1 + 1 = j by omega] using hh

theorem mem_smul_shortReturnBody_representation {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (P : ℝ) {s : ℝ} (hs : 0 ≤ s) {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ s • shortReturnBody V P) :
    ∃ (h : EuclideanSpace ℝ (Fin k)) (w : EuclideanSpace ℝ (Fin d)),
      (∀ j, |h j| ≤ s) ∧ (∀ i, |w i| ≤ s) ∧ P⁻¹ • V h + w = x := by
  obtain ⟨y, hy, rfl⟩ := Set.mem_smul_set.mp hx
  obtain ⟨h, w, hh, hw, rfl⟩ := (mem_shortReturnBody V P y).mp hy
  refine ⟨s • h, s • w, ?_, ?_, ?_⟩
  · intro j
    simp only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_nonneg hs]
    exact mul_le_of_le_one_right hs (hh j)
  · intro i
    simp only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_nonneg hs]
    exact mul_le_of_le_one_right hs (hw i)
  · rw [map_smul, smul_add, smul_comm P⁻¹ s]

theorem euclidean_norm_le_coordinate_bound {d : ℕ} (x : EuclideanSpace ℝ (Fin d))
    {s : ℝ} (hx : ∀ i, |x i| ≤ s) : ‖x‖ ≤ (d : ℝ) * s := by
  calc
    ‖x‖ ≤ ∑ i, ‖x i‖ := euclidean_norm_le_sum_coordinates x
    _ ≤ ∑ _i : Fin d, s := Finset.sum_le_sum fun i _ => by simpa only [Real.norm_eq_abs] using hx i
    _ = _ := by simp

theorem scaled_shortReturnBody_gives_return {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    {P s : ℝ} (hP : 0 < P) (hs : 0 ≤ s) {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ s • shortReturnBody V P) :
    ∃ h : EuclideanSpace ℝ (Fin k),
      ‖h‖ + ‖V h - P • x‖ ≤ ((k : ℝ) + P * d) * s := by
  obtain ⟨h, w, hh, hw, he⟩ := mem_smul_shortReturnBody_representation V P hs hx
  have hd : V h - P • x = -(P • w) := by
    rw [← he, smul_add, smul_smul, mul_inv_cancel₀ hP.ne', one_smul]
    abel
  have hhn := euclidean_norm_le_coordinate_bound h hh
  have hwn := euclidean_norm_le_coordinate_bound w hw
  refine ⟨h, ?_⟩
  rw [hd, norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos hP]
  have hm := mul_le_mul_of_nonneg_left hwn hP.le
  nlinarith only [hhn, hm]
noncomputable def coordinateIntegerLattice (d : ℕ) : Submodule ℤ (EuclideanSpace ℝ (Fin d)) :=
  Submodule.span ℤ (Set.range (EuclideanSpace.basisFun (Fin d) ℝ).toBasis)

instance coordinateIntegerLattice_discrete (d : ℕ) :
    DiscreteTopology (coordinateIntegerLattice d) := by
  unfold coordinateIntegerLattice
  infer_instance

instance coordinateIntegerLattice_full (d : ℕ) :
    IsZLattice ℝ (coordinateIntegerLattice d) := by
  unfold coordinateIntegerLattice
  infer_instance

theorem mem_coordinateIntegerLattice {d : ℕ} (x : EuclideanSpace ℝ (Fin d)) :
    x ∈ coordinateIntegerLattice d ↔ ∀ i, ∃ n : ℤ, (n : ℝ) = x i := by
  simpa [coordinateIntegerLattice, OrthonormalBasis.coe_toBasis_repr_apply,
    EuclideanSpace.basisFun_repr, Set.mem_range] using
      (EuclideanSpace.basisFun (Fin d) ℝ).toBasis.mem_span_iff_repr_mem ℤ x

theorem coordinateIntegerLattice_coordinates {d : ℕ} {x : EuclideanSpace ℝ (Fin d)}
    (hx : x ∈ coordinateIntegerLattice d) :
    ∃ n : Fin d → ℤ, x = WithLp.toLp 2 (fun i => (n i : ℝ)) := by
  classical
  choose n hn using (mem_coordinateIntegerLattice x).mp hx
  refine ⟨n, ?_⟩
  ext i
  exact (hn i).symm

theorem bilinear_vanishes_on_span {E : Type*} [AddCommGroup E] [Module ℝ E]
    (B : E →ₗ[ℝ] E →ₗ[ℝ] ℝ) (S : Set E)
    (hB : ∀ x ∈ S, ∀ y ∈ S, B x y = 0) :
    ∀ x ∈ Submodule.span ℝ S, ∀ y ∈ Submodule.span ℝ S, B x y = 0 := by
  have hl (y : E) (hy : y ∈ S) : Submodule.span ℝ S ≤ LinearMap.ker (B.flip y) :=
    Submodule.span_le.mpr (fun x hx => hB x hx y hy)
  intro x hx
  have hr : Submodule.span ℝ S ≤ LinearMap.ker (B x) :=
    Submodule.span_le.mpr (fun y hy => hl y hy hx)
  exact fun y hy => hr hy

noncomputable def shortReturnLatticeSpan {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d)) (P s : ℝ) :
    Submodule ℝ (EuclideanSpace ℝ (Fin d)) :=
  Submodule.span ℝ ((coordinateIntegerLattice d : Set (EuclideanSpace ℝ (Fin d))) ∩
    s • shortReturnBody V P)

theorem shortReturnLatticeSpan_isotropic_of_returns {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (B : EuclideanSpace ℝ (Fin d) →ₗ[ℝ] EuclideanSpace ℝ (Fin d) →ₗ[ℝ] ℝ)
    {P s r : ℝ} (hP : 0 < P) (hs : 0 ≤ s)
    (hscale : ((k : ℝ) + P * d) * s ≤ r)
    (hiso : ∀ (h h' : EuclideanSpace ℝ (Fin k)) (n n' : Fin d → ℤ),
      ‖h‖ + ‖V h - P • WithLp.toLp 2 (fun i => (n i : ℝ))‖ ≤ r →
      ‖h'‖ + ‖V h' - P • WithLp.toLp 2 (fun i => (n' i : ℝ))‖ ≤ r →
      B (P • WithLp.toLp 2 (fun i => (n i : ℝ)))
        (P • WithLp.toLp 2 (fun i => (n' i : ℝ))) = 0) :
    ∀ x ∈ shortReturnLatticeSpan V P s, ∀ y ∈ shortReturnLatticeSpan V P s,
      B x y = 0 := by
  apply bilinear_vanishes_on_span
  intro x hx y hy
  obtain ⟨h, hh⟩ := scaled_shortReturnBody_gives_return V hP hs hx.2
  obtain ⟨h', hh'⟩ := scaled_shortReturnBody_gives_return V hP hs hy.2
  obtain ⟨n, rfl⟩ := coordinateIntegerLattice_coordinates hx.1
  obtain ⟨n', rfl⟩ := coordinateIntegerLattice_coordinates hy.1
  have hb := hiso h h' n n' (hh.trans hscale) (hh'.trans hscale)
  simpa only [map_smul, LinearMap.smul_apply, smul_eq_mul, mul_eq_zero,
    hP.ne', false_or] using hb

theorem shortReturn_scale_bound (d k : ℕ) {P s r : ℝ} (hP : 1 ≤ P) (hs : 0 ≤ s)
    (hb : s ≤ r / (100 * P * (d + k + 1))) :
    ((k : ℝ) + P * d) * s ≤ r := by
  have hden : 0 < 100 * P * (d + k + 1 : ℝ) := by positivity
  have hm := (le_div_iff₀ hden).mp hb
  have hcoef : (k : ℝ) + P * d ≤ 100 * P * (d + k + 1) := by
    have hk := mul_nonneg (sub_nonneg.mpr hP) (Nat.cast_nonneg k)
    have hd := mul_nonneg (show 0 ≤ P by linarith) (Nat.cast_nonneg d)
    nlinarith only [hk, hd, hP]
  exact (mul_le_mul_of_nonneg_right hcoef hs).trans (by simpa only [mul_comm] using hm)

/-- Blueprint lem:return-splitting, lines 1279-1281: the real span of the
integer points in the chosen return body is isotropic for C-C^T. -/
theorem shortReturnLatticeSpan_isotropic {d k : ℕ}
    (C : Matrix (Fin d) (Fin d) ℝ) (V : Matrix (Fin d) (Fin k) ℝ)
    (Λ : Matrix (Fin k) (Fin k) ℝ) (hΛ : Λ.IsSymm)
    (P : ℤ) (hP : 1 ≤ P) (hC : ∀ i j, ∃ z : ℤ, (P : ℝ) * C i j = z)
    {a M s : ℝ} (ha : 0 < a) (hM : 0 ≤ M) (hs : 0 ≤ s)
    (hΩ : ∀ (h : Fin k → ℝ) (n : Fin d → ℤ),
      ‖WithLp.toLp 2 h‖ +
        ‖WithLp.toLp 2 (V.mulVec h - fun i => (P : ℝ) * n i)‖ ≤ a →
      ‖WithLp.toLp 2 ((2 • Λ + V.transpose * C * V).mulVec h -
        (V.transpose * (C - C.transpose)).mulVec (fun i => (P : ℝ) * n i))‖ ≤ M) :
    let r := min a
      (100 * (M + ‖(Matrix.toEuclideanLin (C - C.transpose)).toContinuousLinearMap‖ + 1))⁻¹
    s ≤ r / (100 * (P : ℝ) * (d + k + 1)) →
    ∀ x ∈ shortReturnLatticeSpan (Matrix.toEuclideanLin V).toContinuousLinearMap P s,
      ∀ y ∈ shortReturnLatticeSpan (Matrix.toEuclideanLin V).toContinuousLinearMap P s,
        dotProduct y.ofLp ((C - C.transpose).mulVec x.ofLp) = 0 := by
  intro r hsmall
  let W := (Matrix.toEuclideanLin V).toContinuousLinearMap
  let B := (innerₗ (EuclideanSpace ℝ (Fin d))).comp (Matrix.toEuclideanLin (C - C.transpose))
  have hPr : (1 : ℝ) ≤ P := by exact_mod_cast hP
  have hPpos : (0 : ℝ) < P := by linarith only [hPr]
  have hret := quadratic_short_returns_isotropic C V Λ hΛ P hC ha hM hΩ
  have hiso : ∀ x ∈ shortReturnLatticeSpan W P s,
      ∀ y ∈ shortReturnLatticeSpan W P s, B x y = 0 := by
    apply shortReturnLatticeSpan_isotropic_of_returns W B hPpos hs
      (shortReturn_scale_bound d k hPr hs hsmall)
    intro h h' n n' hh hh'
    have ht := hret h.ofLp h'.ofLp n n' hh hh'
    simp only [B, LinearMap.comp_apply, innerₗ_apply_apply,
      EuclideanSpace.inner_eq_star_dotProduct, star_trivial] at ⊢
    exact ht
  intro x hx y hy
  have ht := hiso x hx y hy
  simp only [B, LinearMap.comp_apply, innerₗ_apply_apply,
    EuclideanSpace.inner_eq_star_dotProduct, star_trivial] at ht
  exact ht

noncomputable def latticeBodySpan {E : Type*} [AddCommGroup E] [Module ℝ E]
    (K : Set E) (L : Submodule ℤ E) (b : ℝ) : Submodule ℝ E :=
  Submodule.span ℝ ((L : Set E) ∩ b • K)

theorem latticeBodySpan_successiveMinimum_gt {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] {b : ℝ} (hb : 0 < b)
    (hr : Module.finrank ℝ (latticeBodySpan K L b) < Module.finrank ℝ E) :
    b < successiveMinimum K L (Module.finrank ℝ (latticeBodySpan K L b) + 1) := by
  let U := latticeBodySpan K L b
  obtain ⟨hp, v, hv, hvmem⟩ := successiveMinimum_attained_fullLattice hK L
    (Nat.succ_pos (Module.finrank ℝ U)) (by dsimp [U]; omega)
  by_contra hn
  have hle := le_of_not_gt hn
  have hsub : Submodule.span ℝ (Set.range v) ≤ U := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    apply Submodule.subset_span
    refine ⟨hv.2 i, ?_⟩
    exact (symmetricConvexBody_gauge_le hK (v i) hb).mp
      (((symmetricConvexBody_gauge_le hK (v i) hp).mpr (hvmem i)).trans hle)
  have hd := Submodule.finrank_mono hsub
  have he : Module.finrank ℝ (Submodule.span ℝ (Set.range v)) =
      Module.finrank ℝ U + 1 := by
    simpa only [Fintype.card_fin] using finrank_span_eq_card hv.1
  omega

theorem latticeBodySpan_rank_gap {E : Type*} [NormedAddCommGroup E]
    [NormedSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) (L : Submodule ℤ E) [DiscreteTopology L]
    [IsZLattice ℝ L] {b A : ℝ} (hb : 0 < b)
    (hgap : ∀ j : ℕ, 0 < j → j ≤ Module.finrank ℝ E →
      successiveMinimum K L j ≤ b ∨ A * b < successiveMinimum K L j)
    (hr : Module.finrank ℝ (latticeBodySpan K L b) < Module.finrank ℝ E) :
    A * b < successiveMinimum K L (Module.finrank ℝ (latticeBodySpan K L b) + 1) := by
  have hgt := latticeBodySpan_successiveMinimum_gt hK L hb hr
  exact (hgap _ (by omega) (by omega)).resolve_left (not_le_of_gt hgt)

theorem short_dual_vector_mem_orthogonal {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] (K : Set E) (L : Submodule ℤ E) {b t : ℝ}
    (hb : 0 ≤ b) (ht : 0 ≤ t) (hbt : b * t < 1) {q : E}
    (hq : q ∈ euclideanDualLattice L) (hqt : q ∈ t • euclideanPolar K) :
    q ∈ (latticeBodySpan K L b)ᗮ := by
  apply ((latticeBodySpan K L b).mem_orthogonal' q).mpr
  have hker : latticeBodySpan K L b ≤ (innerₗ E q).ker := by
    apply Submodule.span_le.mpr
    rintro x ⟨hxL, hxb⟩
    obtain ⟨z, hz⟩ := (mem_euclideanDualLattice L q).mp hq x hxL
    have hbound := (inner_le_of_mem_dilate_polar hb ht hxb hqt).trans_lt hbt
    rw [real_inner_comm, ← hz] at hbound
    have hz0 : z = 0 := by
      have hh := abs_lt.mp hbound
      have hlo : (-1 : ℤ) < z := by exact_mod_cast hh.1
      have hhi : z < (1 : ℤ) := by exact_mod_cast hh.2
      omega
    change inner ℝ q x = 0
    rw [← hz, hz0, Int.cast_zero]
  exact fun x hx => hker hx

/-- A gap in the primal minima produces a short dual basis for the orthogonal
complement of the span of the small primal lattice points. -/
theorem latticeBodySpan_small_dual_basis {E : Type*} [NormedAddCommGroup E]
    [InnerProductSpace ℝ E] [FiniteDimensional ℝ E] {K : Set E}
    (hK : IsSymmetricConvexBody K) {n : ℕ} (v : Module.Basis (Fin n) ℝ E)
    {b C A : ℝ} (hb : 0 < b)
    (hC : (n : ℝ) * (16 : ℝ) ^ n ≤ C) (hCA : C < A)
    (hgap : ∀ j : ℕ, 0 < j → j ≤ n →
      successiveMinimum K (Submodule.span ℤ (Set.range v)) j ≤ b ∨
        A * b < successiveMinimum K (Submodule.span ℤ (Set.range v)) j)
    (hr : Module.finrank ℝ (latticeBodySpan K (Submodule.span ℤ (Set.range v)) b) < n) :
    let U := latticeBodySpan K (Submodule.span ℤ (Set.range v)) b
    ∃ q : Fin (n - Module.finrank ℝ U) → E,
      LinearIndependent ℝ q ∧
      (∀ i, q i ∈ euclideanDualLattice (Submodule.span ℤ (Set.range v))) ∧
      (∀ i, q i ∈ (C / (A * b)) • euclideanPolar K) ∧
      Submodule.span ℝ (Set.range q) = Uᗮ := by
  intro U
  let L := Submodule.span ℤ (Set.range v)
  let r := Module.finrank ℝ U
  have hdim : Module.finrank ℝ E = n := by
    simpa only [Fintype.card_fin] using Module.finrank_eq_card_basis v
  have hn : 0 < n := by omega
  have hCp : 0 < C := lt_of_lt_of_le (by positivity) hC
  have hAp : 0 < A := hCp.trans hCA
  have hAb : 0 < A * b := mul_pos hAp hb
  have hgt : A * b < successiveMinimum K L (r + 1) := by
    apply latticeBodySpan_rank_gap hK L hb
    · simpa only [hdim] using hgap
    · simpa only [hdim] using hr
  obtain ⟨hp, q, hq, hqm⟩ := successiveMinimum_attained_fullLattice
    (symmetricConvexBody_polar hK) (euclideanDualLattice L)
    (show 0 < n - r by dsimp [r, U]; omega) (by rw [hdim]; omega)
  have hprod := (successiveMinimum_product_upper hK v
    (show 0 < r + 1 by omega) (show r + 1 ≤ n by dsimp [r, U]; omega)).trans hC
  have he : n + 1 - (r + 1) = n - r := by omega
  rw [he] at hprod
  have hscale : successiveMinimum (euclideanPolar K) (euclideanDualLattice L) (n-r) ≤
      C / (A * b) := by
    apply (le_div_iff₀ hAb).mpr
    have hm := (mul_le_mul_of_nonneg_right hgt.le hp.le).trans hprod
    simpa only [mul_comm] using hm
  have ht : 0 < C / (A * b) := div_pos hCp hAb
  have hqt : ∀ i, q i ∈ (C / (A * b)) • euclideanPolar K := by
    intro i
    exact (symmetricConvexBody_gauge_le (symmetricConvexBody_polar hK) (q i) ht).mp
      (((symmetricConvexBody_gauge_le (symmetricConvexBody_polar hK) (q i) hp).mpr
        (hqm i)).trans hscale)
  have hbt : b * (C / (A * b)) < 1 := by
    have heq : b * (C / (A * b)) = C / A := by field_simp
    rw [heq]
    exact (div_lt_one hAp).mpr hCA
  have hsub : Submodule.span ℝ (Set.range q) ≤ Uᗮ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact short_dual_vector_mem_orthogonal K L hb.le ht.le hbt (hq.2 i) (hqt i)
  refine ⟨q, hq.1, hq.2, hqt, Submodule.eq_of_le_of_finrank_eq hsub ?_⟩
  have hqdim : Module.finrank ℝ (Submodule.span ℝ (Set.range q)) = n - r := by
    simpa only [Fintype.card_fin] using finrank_span_eq_card hq.1
  have hu := U.finrank_add_finrank_orthogonal
  rw [hdim] at hu
  dsimp [r] at hqdim
  omega

theorem coordinateIntegerLattice_dual (d : ℕ) :
    euclideanDualLattice (coordinateIntegerLattice d) = coordinateIntegerLattice d := by
  apply le_antisymm
  · intro x hx
    apply (mem_coordinateIntegerLattice x).mpr
    intro i
    have hi : (EuclideanSpace.basisFun (Fin d) ℝ) i ∈ coordinateIntegerLattice d :=
      Submodule.subset_span ⟨i, rfl⟩
    obtain ⟨z, hz⟩ := (mem_euclideanDualLattice _ x).mp hx _ hi
    exact ⟨z, by simpa only [EuclideanSpace.inner_basisFun_real] using hz⟩
  · intro x hx
    apply (mem_euclideanDualLattice _ x).mpr
    intro y hy
    obtain ⟨n, rfl⟩ := coordinateIntegerLattice_coordinates hx
    obtain ⟨m, rfl⟩ := coordinateIntegerLattice_coordinates hy
    refine ⟨∑ i, m i * n i, ?_⟩
    simp [EuclideanSpace.inner_eq_star_dotProduct, dotProduct]

/-- The short dual vectors in the return-splitting proof span precisely the
orthogonal complement of the short-return subspace. -/
theorem shortReturnLatticeSpan_dual_basis {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (P : ℝ) {b : ℝ} (hb : 0 < b)
    (hgap : ∀ j : ℕ, 0 < j → j ≤ d →
      successiveMinimum (shortReturnBody V P) (coordinateIntegerLattice d) j ≤ b ∨
        (16 * (100 * (d : ℝ)) ^ (10 * d)) * b <
          successiveMinimum (shortReturnBody V P) (coordinateIntegerLattice d) j)
    (hr : Module.finrank ℝ (shortReturnLatticeSpan V P b) < d) :
    ∃ q : Fin (d - Module.finrank ℝ (shortReturnLatticeSpan V P b)) →
        EuclideanSpace ℝ (Fin d),
      LinearIndependent ℝ q ∧
      (∀ i, q i ∈ coordinateIntegerLattice d) ∧
      (∀ i, q i ∈ ((100 * (d : ℝ)) ^ (10 * d) /
        ((16 * (100 * (d : ℝ)) ^ (10 * d)) * b)) • euclideanPolar (shortReturnBody V P)) ∧
      Submodule.span ℝ (Set.range q) = (shortReturnLatticeSpan V P b)ᗮ := by
  have hd : 0 < d := by omega
  have hC : 0 < (100 * (d : ℝ)) ^ (10 * d) := by positivity
  have hh := latticeBodySpan_small_dual_basis (shortReturnBody_symmetricConvexBody V P)
    (EuclideanSpace.basisFun (Fin d) ℝ).toBasis hb (transference_constant_bound hd)
    (show (100 * (d : ℝ)) ^ (10 * d) < 16 * (100 * (d : ℝ)) ^ (10 * d) by linarith only [hC])
    hgap hr
  obtain ⟨q, hq, hqL, hqt, hspan⟩ := hh
  refine ⟨q, hq, ?_, hqt, hspan⟩
  intro i
  have hi : q i ∈ euclideanDualLattice (coordinateIntegerLattice d) := hqL i
  rwa [coordinateIntegerLattice_dual] at hi

theorem euclideanCoordinateCube_basis_mem {d : ℕ} (i : Fin d) :
    EuclideanSpace.basisFun (Fin d) ℝ i ∈ euclideanCoordinateCube d := by
  apply (mem_euclideanCoordinateCube _).mpr
  intro j
  simp [EuclideanSpace.basisFun_apply]
  split_ifs <;> norm_num

theorem shortReturnBody_scaled_image_mem {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (P : ℝ) {h : EuclideanSpace ℝ (Fin k)} (hh : h ∈ euclideanCoordinateCube k) :
    P⁻¹ • V h ∈ shortReturnBody V P := by
  exact ⟨P⁻¹ • V h, ⟨h, hh, rfl⟩, 0, euclideanCoordinateCube_zero d, add_zero _⟩

theorem shortReturnBody_polar_coordinates {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    {P t : ℝ} (hP : 0 < P) (ht : 0 ≤ t) {q : EuclideanSpace ℝ (Fin d)}
    (hq : q ∈ t • euclideanPolar (shortReturnBody V P)) :
    (∀ i, |q i| ≤ t) ∧
    (∀ j, |inner ℝ q (V (EuclideanSpace.basisFun (Fin k) ℝ j))| ≤ P * t) := by
  constructor
  · intro i
    have hx := shortReturnBody_cube_subset V P (euclideanCoordinateCube_basis_mem i)
    have hh := inner_le_of_mem_dilate_polar (show (0 : ℝ) ≤ 1 by norm_num) ht
      (show EuclideanSpace.basisFun (Fin d) ℝ i ∈ (1 : ℝ) • shortReturnBody V P by
        simpa using hx) hq
    simpa only [one_mul, EuclideanSpace.basisFun_inner] using hh
  · intro j
    have hx := shortReturnBody_scaled_image_mem V P (euclideanCoordinateCube_basis_mem j)
    have hh := inner_le_of_mem_dilate_polar (show (0 : ℝ) ≤ 1 by norm_num) ht
      (show P⁻¹ • V (EuclideanSpace.basisFun (Fin k) ℝ j) ∈
        (1 : ℝ) • shortReturnBody V P by simpa using hx) hq
    rw [one_mul, real_inner_smul_left, abs_mul, abs_of_pos (inv_pos.mpr hP),
      real_inner_comm] at hh
    have hm := mul_le_mul_of_nonneg_left hh hP.le
    simpa only [← mul_assoc, mul_inv_cancel₀ hP.ne', one_mul] using hm

/-- Finite torus pigeonholing with an explicit cubical grid. -/
theorem finite_torus_close_pair {d N : ℕ} (hN : 0 < N)
    (x : Fin (N ^ d + 1) → Fin d → ℝ) :
    ∃ i j : Fin (N ^ d + 1), i < j ∧
      ∀ l, |Int.fract (x j l) - Int.fract (x i l)| ≤ 1 / (N : ℝ) := by
  classical
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  let box : Fin (N ^ d + 1) → Fin d → Fin N := fun i l =>
    ⟨⌊(N : ℝ) * Int.fract (x i l)⌋₊, (Nat.floor_lt (by positivity)).mpr
      (by nlinarith only [Int.fract_lt_one (x i l), hNr])⟩
  have hcard : Fintype.card (Fin d → Fin N) < Fintype.card (Fin (N ^ d + 1)) := by
    simp
  obtain ⟨i, j, hij, hbox⟩ := Fintype.exists_ne_map_eq_of_card_lt box hcard
  have hclose (u v : Fin (N ^ d + 1)) (he : box u = box v) (l : Fin d) :
      |Int.fract (x v l) - Int.fract (x u l)| ≤ 1 / (N : ℝ) := by
    have heq := congrArg Fin.val (congrFun he l)
    change ⌊(N : ℝ) * Int.fract (x u l)⌋₊ = ⌊(N : ℝ) * Int.fract (x v l)⌋₊ at heq
    have hul := Nat.floor_le (show 0 ≤ (N : ℝ) * Int.fract (x u l) by positivity)
    have huv := Nat.lt_floor_add_one ((N : ℝ) * Int.fract (x u l))
    have hvl := Nat.floor_le (show 0 ≤ (N : ℝ) * Int.fract (x v l) by positivity)
    have hvv := Nat.lt_floor_add_one ((N : ℝ) * Int.fract (x v l))
    rw [heq] at hul huv
    apply abs_le.mpr
    constructor
    · have hh : (Int.fract (x v l) - Int.fract (x u l)) * N ≥ -1 := by
        nlinarith only [huv, hvl]
      have hd := (le_div_iff₀ hNr).mpr (show
        (-(Int.fract (x v l) - Int.fract (x u l))) * N ≤ 1 by linarith only [hh])
      linarith only [hd]
    · apply (le_div_iff₀ hNr).mpr
      nlinarith only [hvv, hul]
  rcases lt_or_gt_of_ne hij with hlt | hgt
  · exact ⟨i, j, hlt, hclose i j hbox⟩
  · exact ⟨j, i, hgt, hclose j i hbox.symm⟩

theorem finite_grid_line_return {d N : ℕ} (hN : 0 < N)
    (v : Fin d → ℝ) {b : ℝ} (hb : 0 < b) :
    ∃ (t : ℝ) (n : Fin d → ℤ),
      b / (N : ℝ) ^ d ≤ t ∧ t ≤ b ∧
      ∀ l, |t * v l - (n l : ℝ)| ≤ 1 / (N : ℝ) := by
  let x : Fin (N ^ d + 1) → Fin d → ℝ :=
    fun i l => (b / (N : ℝ) ^ d) * (i.val : ℝ) * v l
  obtain ⟨i, j, hij, hclose⟩ := finite_torus_close_pair hN x
  let t := (b / (N : ℝ) ^ d) * ((j.val : ℝ) - i.val)
  let n : Fin d → ℤ := fun l => ⌊x j l⌋ - ⌊x i l⌋
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  have hpow : 0 < (N : ℝ) ^ d := pow_pos hNr d
  have hstep : 0 < b / (N : ℝ) ^ d := div_pos hb hpow
  have hlo : (1 : ℝ) ≤ (j.val : ℝ) - i.val := by
    have hh : (i.val : ℝ) + 1 ≤ j.val := by exact_mod_cast hij
    linarith only [hh]
  have hhi : (j.val : ℝ) - i.val ≤ (N : ℝ) ^ d := by
    have hj : (j.val : ℝ) ≤ (N : ℝ) ^ d := by
      exact_mod_cast (show j.val ≤ N ^ d by omega)
    linarith only [hj, Nat.cast_nonneg (α := ℝ) i.val]
  refine ⟨t, n, ?_, ?_, ?_⟩
  · exact le_mul_of_one_le_right hstep.le hlo
  · calc
      t ≤ (b / (N : ℝ) ^ d) * (N : ℝ) ^ d :=
        mul_le_mul_of_nonneg_left hhi hstep.le
      _ = b := div_mul_cancel₀ b hpow.ne'
  · intro l
    have he : t * v l - (n l : ℝ) = Int.fract (x j l) - Int.fract (x i l) := by
      simp only [Int.fract, n, Int.cast_sub, t, x]
      ring
    rw [he]
    exact hclose l

theorem small_line_lattice_return {d : ℕ} (v : Fin d → ℝ) {b : ℝ} (hb : 0 < b) :
    ∃ (M : ℕ) (t : ℝ) (n : Fin d → ℤ), 0 < M ∧
      (M : ℝ) ≤ (1 + 4 / b) ^ d ∧ b / M ≤ t ∧ t ≤ b ∧
      ∀ l, |t * v l - (n l : ℝ)| ≤ b / 4 := by
  let N := ⌈4 / b⌉₊
  have hfrac : 0 < 4 / b := div_pos (by norm_num) hb
  have hN : 0 < N := Nat.one_le_ceil_iff.mpr hfrac
  have hNr : (0 : ℝ) < N := by exact_mod_cast hN
  obtain ⟨t, n, htlo, hthi, hn⟩ := finite_grid_line_return hN v hb
  refine ⟨N ^ d, t, n, pow_pos hN d, ?_, ?_, hthi, ?_⟩
  · have hceil : (N : ℝ) ≤ 1 + 4 / b := by
      simpa only [add_comm] using (Nat.ceil_lt_add_one hfrac.le).le
    simpa only [Nat.cast_pow] using pow_le_pow_left₀ hNr.le hceil d
  · simpa only [Nat.cast_pow] using htlo
  · intro l
    apply (hn l).trans
    have hceil : 4 / b ≤ (N : ℝ) := Nat.le_ceil _
    have hm : 4 ≤ (N : ℝ) * b := (div_le_iff₀ hb).mp hceil
    apply (div_le_iff₀ hNr).mpr
    nlinarith only [hm]

theorem mem_smul_shortReturnBody_of_representation {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    (P : ℝ) {b : ℝ} (hb : 0 < b) {x : EuclideanSpace ℝ (Fin d)}
    (h : EuclideanSpace ℝ (Fin k)) (w : EuclideanSpace ℝ (Fin d))
    (hh : ∀ j, |h j| ≤ b) (hw : ∀ i, |w i| ≤ b)
    (he : P⁻¹ • V h + w = x) :
    x ∈ b • shortReturnBody V P := by
  apply Set.mem_smul_set.mpr
  refine ⟨b⁻¹ • x, ?_, ?_⟩
  · apply (mem_shortReturnBody V P _).mpr
    refine ⟨b⁻¹ • h, b⁻¹ • w, ?_, ?_, ?_⟩
    · intro j
      have hm := mul_le_mul_of_nonneg_left (hh j) (inv_nonneg.mpr hb.le)
      simpa only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hb),
        inv_mul_cancel₀ hb.ne'] using hm
    · intro i
      have hm := mul_le_mul_of_nonneg_left (hw i) (inv_nonneg.mpr hb.le)
      simpa only [PiLp.smul_apply, smul_eq_mul, abs_mul, abs_of_pos (inv_pos.mpr hb),
        inv_mul_cancel₀ hb.ne'] using hm
    · rw [map_smul, smul_comm P⁻¹ b⁻¹, ← smul_add, he]
  · rw [smul_smul, mul_inv_cancel₀ hb.ne', one_smul]

/-- Quantitative returns along every coordinate axis, with the returning
integer vector in the short-return span. -/
theorem shortReturnBody_coordinate_return {d k : ℕ}
    (V : EuclideanSpace ℝ (Fin k) →L[ℝ] EuclideanSpace ℝ (Fin d))
    {P b : ℝ} (hP : 0 < P) (hb : 0 < b) (j : Fin k) :
    ∃ (M : ℕ) (t : ℝ) (n : Fin d → ℤ),
      0 < M ∧ (M : ℝ) ≤ (1 + 4 / b) ^ d ∧ b / M ≤ t ∧ t ≤ b ∧
      WithLp.toLp 2 (fun i => (n i : ℝ)) ∈ b • shortReturnBody V P ∧
      P • WithLp.toLp 2 (fun i => (n i : ℝ)) ∈ shortReturnLatticeSpan V P b ∧
      (∀ i, |(V (t • EuclideanSpace.basisFun (Fin k) ℝ j) -
        P • WithLp.toLp 2 (fun i => (n i : ℝ))) i| ≤ P * b / 4) ∧
      ‖t • EuclideanSpace.basisFun (Fin k) ℝ j‖ +
        ‖V (t • EuclideanSpace.basisFun (Fin k) ℝ j) -
          P • WithLp.toLp 2 (fun i => (n i : ℝ))‖ ≤ (1 + P * d) * b := by
  let e := EuclideanSpace.basisFun (Fin k) ℝ j
  let v := P⁻¹ • V e
  obtain ⟨M, t, n, hM, hMb, htlo, hthi, hn⟩ := small_line_lattice_return v.ofLp hb
  have hMr : (0 : ℝ) < M := by exact_mod_cast hM
  have ht : 0 < t := (div_pos hb hMr).trans_le htlo
  let h := t • e
  let z : EuclideanSpace ℝ (Fin d) := WithLp.toLp 2 (fun i => (n i : ℝ))
  let w := z - P⁻¹ • V h
  have hw (i : Fin d) : |w i| ≤ b / 4 := by
    have he : w i = -(t * v i - (n i : ℝ)) := by
      simp only [w, z, h, v, map_smul, PiLp.sub_apply, PiLp.smul_apply,
        smul_eq_mul]
      ring
    rw [he, abs_neg]
    exact hn i
  have hcoord : ∀ l, |h l| ≤ b := by
    intro l
    have he := (mem_euclideanCoordinateCube e).mp (euclideanCoordinateCube_basis_mem j) l
    calc
      |h l| = t * |e l| := by simp only [h, PiLp.smul_apply, smul_eq_mul, abs_mul,
        abs_of_pos ht]
      _ ≤ t := mul_le_of_le_one_right ht.le he
      _ ≤ b := hthi
  have hz : z ∈ b • shortReturnBody V P := by
    apply mem_smul_shortReturnBody_of_representation V P hb h w hcoord
      (fun i => (hw i).trans (by linarith only [hb]))
    dsimp [w]
    abel
  have hzL : z ∈ coordinateIntegerLattice d :=
    (mem_coordinateIntegerLattice z).mpr (fun i => ⟨n i, rfl⟩)
  have hzU : P • z ∈ shortReturnLatticeSpan V P b :=
    Submodule.smul_mem _ P (Submodule.subset_span ⟨hzL, hz⟩)
  have hd : V h - P • z = -(P • w) := by
    simp only [w, smul_sub, smul_smul, mul_inv_cancel₀ hP.ne', one_smul]
    abel
  have hdef (i : Fin d) : |(V h - P • z) i| ≤ P * b / 4 := by
    rw [hd]
    simp only [PiLp.neg_apply, PiLp.smul_apply, smul_eq_mul, abs_neg, abs_mul,
      abs_of_pos hP]
    have hh := mul_le_mul_of_nonneg_left (hw i) hP.le
    simpa only [mul_div_assoc] using hh
  refine ⟨M, t, n, hM, hMb, htlo, hthi, hz, hzU, hdef, ?_⟩
  have hhn : ‖h‖ = t := by
    simp [h, e, norm_smul, abs_of_pos ht, EuclideanSpace.basisFun_apply]
  have hdn := euclidean_norm_le_coordinate_bound (V h - P • z) hdef
  change ‖h‖ + ‖V h - P • z‖ ≤ _
  rw [hhn]
  have hnonneg : 0 ≤ P * (d : ℝ) * b := by positivity
  nlinarith only [hdn, hthi, hnonneg]

end Auto
