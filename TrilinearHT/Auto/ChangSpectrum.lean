/-- The source Bohr condition, expressed through the quotient-circle norm. -/
noncomputable def finiteBohrSet {G ι : Type*} [Fintype G] [AddCommGroup G]
    (phase : ι → G →+ UnitAddCircle) (ρ : ℝ) : Finset G := by
  classical
  exact Finset.univ.filter (fun x => ∀ i, ‖phase i x‖ < ρ)

theorem mem_finiteBohrSet {G ι : Type*} [Fintype G] [AddCommGroup G]
    (phase : ι → G →+ UnitAddCircle) (ρ : ℝ) (x : G) :
    x ∈ finiteBohrSet phase ρ ↔ ∀ i, ‖phase i x‖ < ρ := by
  classical
  simp [finiteBohrSet]

/-- A half-open equal-length partition of the unit circle. -/
noncomputable def unitCircleBin (N : ℕ) (hN : 0 < N) (x : UnitAddCircle) : Fin N :=
  ⟨⌊(N : ℝ) * (AddCircle.equivIco (1 : ℝ) 0 x : ℝ)⌋₊, by
    have hx := (AddCircle.equivIco (1 : ℝ) 0 x).property
    have hn : (0 : ℝ) < N := by exact_mod_cast hN
    apply (Nat.floor_lt (mul_nonneg hn.le hx.1)).mpr
    nlinarith [hx.2]⟩

/-- Points in one partition interval differ by less than `1/N` in circle norm. -/
theorem unitCircleBin_norm_sub_lt {N : ℕ} (hN : 0 < N) {x y : UnitAddCircle}
    (hbin : unitCircleBin N hN x = unitCircleBin N hN y) :
    ‖x - y‖ < (1 : ℝ) / N := by
  let a : ℝ := AddCircle.equivIco (1 : ℝ) 0 x
  let b : ℝ := AddCircle.equivIco (1 : ℝ) 0 y
  have ha : 0 ≤ a := (AddCircle.equivIco (1 : ℝ) 0 x).property.1
  have hb : 0 ≤ b := (AddCircle.equivIco (1 : ℝ) 0 y).property.1
  have hn : (0 : ℝ) < N := by exact_mod_cast hN
  have he : ⌊(N : ℝ) * a⌋₊ = ⌊(N : ℝ) * b⌋₊ := congrArg Fin.val hbin
  have ha0 := Nat.floor_le (mul_nonneg hn.le ha)
  have hb0 := Nat.floor_le (mul_nonneg hn.le hb)
  have ha1 := Nat.lt_floor_add_one ((N : ℝ) * a)
  have hb1 := Nat.lt_floor_add_one ((N : ℝ) * b)
  rw [he] at ha0 ha1
  have hab : |a - b| < (1 : ℝ) / N := by
    rw [abs_lt]
    constructor
    · have ht : b - a < (1 : ℝ) / N := (lt_div_iff₀ hn).mpr (by nlinarith)
      linarith
    · exact (lt_div_iff₀ hn).mpr (by nlinarith)
  have hcoe : ((a - b : ℝ) : UnitAddCircle) = x - y := by
    rw [AddCircle.coe_sub, AddCircle.coe_equivIco, AddCircle.coe_equivIco]
  rw [← hcoe]
  exact (QuotientAddGroup.norm_mk_le_norm (m := a - b)).trans_lt (by simpa using hab)

/-- The source partition size `ceil(2/rho)` has mesh at most `rho/2`
and at most `3/rho` intervals. -/
theorem bohr_partition_size {ρ : ℝ} (hρ : 0 < ρ) (hρ1 : ρ < 1) :
    0 < ⌈2 / ρ⌉₊ ∧ (1 : ℝ) / ⌈2 / ρ⌉₊ ≤ ρ / 2 ∧ (⌈2 / ρ⌉₊ : ℝ) ≤ 3 / ρ := by
  have hpos : 0 < 2 / ρ := by positivity
  have hn : 0 < ⌈2 / ρ⌉₊ := Nat.ceil_pos.mpr hpos
  have hnr : (0 : ℝ) < ⌈2 / ρ⌉₊ := by exact_mod_cast hn
  have hlo := Nat.le_ceil (2 / ρ)
  have hhi := Nat.ceil_lt_add_one hpos.le
  refine ⟨hn, ?_, ?_⟩
  · apply (div_le_iff₀ hnr).mpr
    have h := (div_le_iff₀ hρ).mp hlo
    nlinarith
  · apply (le_div_iff₀ hρ).mpr
    have h := (mul_lt_mul_iff_left₀ hρ).mpr hhi
    have hid : (2 / ρ + 1) * ρ = 2 + ρ := by field_simp
    rw [hid] at h
    linarith

/-- Blueprint `lem:Chang`, lines 735-748: a Bohr set defined by `d` circle
coordinates has at least `(rho/3)^d` of the group elements. The zero-coordinate
case and repeated or zero homomorphisms are included. -/
theorem finiteBohrSet_card_lower {G ι : Type*} [Fintype G] [AddCommGroup G] [Fintype ι]
    (phase : ι → G →+ UnitAddCircle) {ρ : ℝ} (hρ : 0 < ρ) (hρhalf : ρ < 1 / 2) :
    (ρ / 3) ^ Fintype.card ι * Fintype.card G ≤ ((finiteBohrSet phase ρ).card : ℝ) := by
  classical
  let N : ℕ := ⌈2 / ρ⌉₊
  obtain ⟨hN, hmesh, hsize⟩ := bohr_partition_size hρ (by linarith)
  change 0 < N at hN
  let : NeZero N := ⟨Nat.ne_of_gt hN⟩
  have hn : (0 : ℝ) < N := by exact_mod_cast hN
  have hp : (0 : ℝ) < (N : ℝ) ^ Fintype.card ι := by positivity
  have hg : (0 : ℝ) < Fintype.card G := by exact_mod_cast Fintype.card_pos
  let bins : G → ι → Fin N := fun x i => unitCircleBin N hN (phase i x)
  obtain ⟨b, hb⟩ := Fintype.exists_le_card_fiber_of_nsmul_le_card (M := ℝ) bins
    (b := (Fintype.card G : ℝ) / (N : ℝ) ^ Fintype.card ι) (by
      simp only [nsmul_eq_mul, Fintype.card_fun, Fintype.card_fin, Nat.cast_pow]
      field_simp
      rfl)
  let Y : Finset G := Finset.univ.filter (fun x => bins x = b)
  have hY : (Fintype.card G : ℝ) / (N : ℝ) ^ Fintype.card ι ≤ Y.card := hb
  have hYpos : 0 < Y.card := by exact_mod_cast (div_pos hg hp).trans_le hY
  obtain ⟨x₀, hx₀⟩ := Finset.card_pos.mp hYpos
  have hmaps : Set.MapsTo (fun x => x - x₀) Y (finiteBohrSet phase ρ) := by
    intro x hx
    apply (mem_finiteBohrSet phase ρ _).mpr
    intro i
    rw [map_sub]
    have he : bins x = bins x₀ :=
      (Finset.mem_filter.mp hx).2.trans (Finset.mem_filter.mp hx₀).2.symm
    have hd := unitCircleBin_norm_sub_lt hN (congrFun he i)
    exact hd.trans_le (hmesh.trans (by linarith))
  have hcard : Y.card ≤ (finiteBohrSet phase ρ).card :=
    Finset.card_le_card_of_injOn (fun x => x - x₀) hmaps
      (fun _ _ _ _ he => sub_left_inj.mp he)
  have hbase : ρ / 3 ≤ (1 : ℝ) / N := by
    apply (le_div_iff₀ hn).mpr
    have h := (le_div_iff₀ hρ).mp hsize
    change (N : ℝ) * ρ ≤ 3 at h
    nlinarith
  calc
    _ ≤ ((1 : ℝ) / N) ^ Fintype.card ι * Fintype.card G := by gcongr
    _ = (Fintype.card G : ℝ) / (N : ℝ) ^ Fintype.card ι := by rw [div_pow]; ring
    _ ≤ (Y.card : ℝ) := hY
    _ ≤ _ := by exact_mod_cast hcard

/-! ### Aligned characters and positive Riesz products -/

/-- The probability-normalized average of a character on a finite set. -/
noncomputable def characterMean {G : Type*} [AddCommGroup G]
    (X : Finset G) (ψ : AddChar G ℂ) : ℂ := 𝔼 x ∈ X, ψ x

/-- Rotate a Fourier coefficient so its real part is its norm. -/
theorem characterMean_phase {G : Type*} [AddCommGroup G]
    (X : Finset G) (ψ : AddChar G ℂ) :
    ∃ ω : ℂ, ‖ω‖ = 1 ∧ (𝔼 x ∈ X, (ω * ψ x).re) = ‖characterMean X ψ‖ := by
  obtain ⟨ω, hω, he⟩ := Complex.exists_norm_eq_mul_self (characterMean X ψ)
  refine ⟨ω, hω, ?_⟩
  have hm := map_expect (Complex.reCLM.toLinearMap.restrictScalars ℚ≥0)
    (fun x => ω * ψ x) X
  change (𝔼 x ∈ X, ω * ψ x).re = (𝔼 x ∈ X, (ω * ψ x).re) at hm
  rw [← hm, ← Finset.mul_expect]
  change (ω * characterMean X ψ).re = _
  rw [← he, Complex.ofReal_re]

/-- The real Riesz product for finitely many additive characters. -/
noncomputable def finiteRieszProduct {G : Type*} [AddCommGroup G]
    (Λ : Finset (AddChar G ℂ)) (ω : AddChar G ℂ → ℂ) (t : ℝ) (x : G) : ℝ :=
  ∏ ψ ∈ Λ, (1 + t * (ω ψ * ψ x).re)

theorem character_rotated_re_abs_le {G : Type*} [Finite G] [AddCommGroup G]
    (ψ : AddChar G ℂ) {ω : ℂ} (hω : ‖ω‖ = 1) (x : G) : |(ω * ψ x).re| ≤ 1 := by
  calc
    _ ≤ ‖ω * ψ x‖ := Complex.abs_re_le_norm _
    _ = 1 := by rw [norm_mul, hω, ψ.norm_apply, mul_one]

/-- Every factor in the source product is strictly positive for `0 <= t <= 1/2`. -/
theorem finiteRieszProduct_pos {G : Type*} [Finite G] [AddCommGroup G]
    (Λ : Finset (AddChar G ℂ)) (ω : AddChar G ℂ → ℂ)
    (hω : ∀ ψ ∈ Λ, ‖ω ψ‖ = 1) {t : ℝ} (ht : 0 ≤ t) (ht1 : t ≤ 1 / 2) (x : G) :
    0 < finiteRieszProduct Λ ω t x := by
  apply Finset.prod_pos
  intro ψ hψ
  have h := (abs_le.mp (character_rotated_re_abs_le ψ (hω ψ hψ) x)).1
  nlinarith [mul_nonneg ht (show 0 ≤ (ω ψ * ψ x).re + 1 by linarith)]

/-- Blueprint `lem:Chang`, lines 749-757: dissociation annihilates all
nonconstant terms, so the finite Riesz product has normalized mean one. -/
theorem finiteRieszProduct_mean_one {G : Type*} [Fintype G] [AddCommGroup G]
    (Λ : Finset (AddChar G ℂ)) (hΛ : AddDissociated (Λ : Set (AddChar G ℂ)))
    (ω : AddChar G ℂ → ℂ) (t : ℝ) : (𝔼 x, finiteRieszProduct Λ ω t x) = 1 := by
  classical
  let d : AddChar G ℂ → ℂ := fun ψ => if ψ ∈ Λ then (t : ℂ) * ω ψ else 0
  have hsupport : {ψ | d ψ ≠ 0} ⊆ (Λ : Set (AddChar G ℂ)) := by
    intro ψ hψ
    by_contra hn
    change ψ ∉ Λ at hn
    exact hψ (by simp [d, hn])
  have hd := AddDissociated.subset hsupport hΛ
  have hm := AddDissociated.randomisation (fun _ : AddChar G ℂ => (1 : ℝ)) d hd
  have he (x : G) : (∏ ψ, (1 + (d ψ * ψ x).re)) = finiteRieszProduct Λ ω t x := by
    calc
      _ = ∏ ψ ∈ Λ, (1 + (d ψ * ψ x).re) := by
        symm
        apply Finset.prod_subset (Finset.subset_univ _)
        intro ψ _ hψ
        simp [d, hψ]
      _ = _ := by
        apply Finset.prod_congr rfl
        intro ψ hψ
        simp [d, hψ, mul_assoc]
  simpa only [he, Finset.prod_const_one] using hm

/-! ### The logarithmic estimate and entropy bound -/

/-- The elementary logarithm estimate on the entire source interval. -/
theorem log_one_add_quadratic_lower {v : ℝ} (hv : |v| ≤ 1 / 2) :
    v - v ^ 2 ≤ Real.log (1 + v) := by
  let f : ℝ → ℝ := fun x => Real.log (1 + x) - x + x ^ 2
  have hd (x : ℝ) (hx : -(1 / 2) ≤ x) :
      HasDerivAt f (x * (1 + 2 * x) / (1 + x)) x := by
    have hp : 1 + x ≠ 0 := by linarith
    have h := (((hasDerivAt_id x).const_add 1).log hp).sub (hasDerivAt_id x)
    convert! h.add ((hasDerivAt_id x).pow 2) using 1
    dsimp
    field_simp
    ring
  have hm : MonotoneOn f (Set.Icc (0 : ℝ) (1 / 2)) := by
    apply monotoneOn_of_hasDerivWithinAt_nonneg (f' := fun x => x * (1 + 2 * x) / (1 + x))
      (convex_Icc _ _)
    · intro x hx
      exact (hd x (by linarith [hx.1])).continuousAt.continuousWithinAt
    · intro x hx
      exact (hd x (by linarith [(interior_subset hx).1])).hasDerivWithinAt
    · intro x hx
      have hx0 := (interior_subset hx).1
      positivity
  have ha : AntitoneOn f (Set.Icc (-(1 / 2) : ℝ) 0) := by
    apply antitoneOn_of_hasDerivWithinAt_nonpos (f' := fun x => x * (1 + 2 * x) / (1 + x))
      (convex_Icc _ _)
    · intro x hx
      exact (hd x hx.1).continuousAt.continuousWithinAt
    · intro x hx
      exact (hd x (interior_subset hx).1).hasDerivWithinAt
    · intro x hx
      have hx' := interior_subset hx
      exact div_nonpos_of_nonpos_of_nonneg
        (mul_nonpos_of_nonpos_of_nonneg hx'.2 (by linarith [hx'.1])) (by linarith [hx'.1])
  have hf : 0 ≤ f v := by
    rcases le_total 0 v with hpos | hneg
    · have h := hm (show (0 : ℝ) ∈ Set.Icc 0 (1 / 2) by constructor <;> norm_num)
        ⟨hpos, (abs_le.mp hv).2⟩ hpos
      simpa [f] using h
    · have h := ha ⟨(abs_le.mp hv).1, hneg⟩
        (show (0 : ℝ) ∈ Set.Icc (-(1 / 2)) 0 by constructor <;> norm_num) hneg
      simpa [f] using h
  dsimp [f] at hf
  linarith

/-- Blueprint `lem:Chang`, line 758: `log(1+t*u) >= t*u-t^2`
for `|u| <= 1` and `0 <= t <= 1/2`. -/
theorem log_riesz_factor_lower {u t : ℝ} (hu : |u| ≤ 1) (ht : 0 ≤ t) (ht1 : t ≤ 1 / 2) :
    t * u - t ^ 2 ≤ Real.log (1 + t * u) := by
  have hab : |t * u| ≤ t := by rw [abs_mul, abs_of_nonneg ht]; nlinarith
  have h := log_one_add_quadratic_lower (hab.trans ht1)
  have hs : (t * u) ^ 2 ≤ t ^ 2 := by
    simpa only [sq_abs] using (sq_le_sq₀ (abs_nonneg (t * u)) ht).mpr hab
  linarith

/-- Averaging the source logarithm estimate over a nonempty set. -/
theorem finiteRieszProduct_log_mean_lower {G : Type*} [Finite G] [AddCommGroup G]
    (X : Finset G) (hX : X.Nonempty) (Λ : Finset (AddChar G ℂ))
    (ω : AddChar G ℂ → ℂ) (hω : ∀ ψ ∈ Λ, ‖ω ψ‖ = 1)
    {η : ℝ} (hη : 0 < η) (hη1 : η ≤ 1)
    (halign : ∀ ψ ∈ Λ, η ≤ 𝔼 x ∈ X, (ω ψ * ψ x).re) :
    (Λ.card : ℝ) * η ^ 2 / 4 ≤ 𝔼 x ∈ X, Real.log (finiteRieszProduct Λ ω (η / 2) x) := by
  have ht : 0 ≤ η / 2 := by positivity
  have ht1 : η / 2 ≤ 1 / 2 := by linarith
  have hfactor (ψ : AddChar G ℂ) (hψ : ψ ∈ Λ) (x : G) :
      0 < 1 + η / 2 * (ω ψ * ψ x).re := by
    have hr := (abs_le.mp (character_rotated_re_abs_le ψ (hω ψ hψ) x)).1
    nlinarith [mul_nonneg ht (show 0 ≤ (ω ψ * ψ x).re + 1 by linarith)]
  have hpoint (x : G) :
      (∑ ψ ∈ Λ, (η / 2 * (ω ψ * ψ x).re - (η / 2) ^ 2)) ≤
        Real.log (finiteRieszProduct Λ ω (η / 2) x) := by
    rw [finiteRieszProduct, Real.log_prod (fun ψ hψ => (hfactor ψ hψ x).ne')]
    apply Finset.sum_le_sum
    intro ψ hψ
    exact log_riesz_factor_lower (character_rotated_re_abs_le ψ (hω ψ hψ) x) ht ht1
  calc
    _ = ∑ _ψ ∈ Λ, (η / 2 * η - (η / 2) ^ 2) := by simp; ring
    _ ≤ ∑ ψ ∈ Λ, (𝔼 x ∈ X, (η / 2 * (ω ψ * ψ x).re - (η / 2) ^ 2)) := by
      apply Finset.sum_le_sum
      intro ψ hψ
      rw [Finset.expect_sub_distrib, ← Finset.mul_expect, Finset.expect_const hX]
      exact sub_le_sub_right (mul_le_mul_of_nonneg_left (halign ψ hψ) ht) _
    _ = 𝔼 x ∈ X, (∑ ψ ∈ Λ, (η / 2 * (ω ψ * ψ x).re - (η / 2) ^ 2)) :=
      (Finset.expect_sum_comm _ _ _).symm
    _ ≤ _ := Finset.expect_le_expect (fun x _ => hpoint x)

/-- Finite Jensen in the logarithmic form used by the entropy argument. -/
theorem finite_log_mean_le_log_mean {α : Type*} (X : Finset α) (hX : X.Nonempty)
    (F : α → ℝ) (hF : ∀ x ∈ X, 0 < F x) :
    (𝔼 x ∈ X, Real.log (F x)) ≤ Real.log (𝔼 x ∈ X, F x) := by
  have hn : (0 : ℝ) < X.card := by exact_mod_cast hX.card_pos
  have hj := strictConcaveOn_log_Ioi.concaveOn.le_map_sum
    (t := X) (w := fun _ => (X.card : ℝ)⁻¹) (p := F)
    (fun _ _ => inv_nonneg.mpr hn.le) (by simp [hn.ne']) (fun x hx => hF x hx)
  simpa only [Finset.expect_eq_sum_div_card, div_eq_inv_mul, smul_eq_mul,
    ← Finset.mul_sum] using hj

/-- A positive function of global mean one has mean logarithm on `X` at most
the logarithm of the reciprocal density of `X`. -/
theorem finite_log_mean_le_log_density_inv {G : Type*} [Fintype G]
    (X : Finset G) (hX : X.Nonempty) (F : G → ℝ) (hF : ∀ x, 0 < F x)
    (hmean : (𝔼 x, F x) = 1) :
    (𝔼 x ∈ X, Real.log (F x)) ≤ Real.log ((Fintype.card G : ℝ) / X.card) := by
  have hn : (0 : ℝ) < X.card := by exact_mod_cast hX.card_pos
  have hng : (0 : ℝ) < Fintype.card G := by
    exact_mod_cast hX.card_pos.trans_le (Finset.card_le_univ X)
  have hsum : ∑ x, F x = (Fintype.card G : ℝ) := by
    rw [Fintype.expect_eq_sum_div_card, div_eq_iff hng.ne'] at hmean
    simpa using hmean
  have hbound : (𝔼 x ∈ X, F x) ≤ (Fintype.card G : ℝ) / X.card := by
    rw [Finset.expect_eq_sum_div_card]
    apply div_le_div_of_nonneg_right _ hn.le
    rw [← hsum]
    exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun x _ _ => (hF x).le)
  exact (finite_log_mean_le_log_mean X hX F (fun x _ => hF x)).trans
    (Real.log_le_log (Finset.expect_pos (fun x _ => hF x) hX) hbound)

/-- Blueprint `lem:Chang`, lines 749-763: every dissociated family of
characters with average norm at least `eta` has cardinality at most
`4 eta^(-2) log(1/beta)`, where `beta = |X|/|G|`. -/
theorem dissociated_spectrum_card_bound {G : Type*} [Fintype G] [AddCommGroup G]
    (X : Finset G) (hX : X.Nonempty) (Λ : Finset (AddChar G ℂ))
    (hΛ : AddDissociated (Λ : Set (AddChar G ℂ))) {η : ℝ} (hη : 0 < η) (hη1 : η ≤ 1)
    (hlarge : ∀ ψ ∈ Λ, η ≤ ‖characterMean X ψ‖) :
    (Λ.card : ℝ) ≤ 4 / η ^ 2 * Real.log ((Fintype.card G : ℝ) / X.card) := by
  choose ω hω halign using (fun ψ : AddChar G ℂ => characterMean_phase X ψ)
  have hlower := finiteRieszProduct_log_mean_lower X hX Λ ω (fun ψ _ => hω ψ) hη hη1
    (fun ψ hψ => by rw [halign ψ]; exact hlarge ψ hψ)
  have hupper := finite_log_mean_le_log_density_inv X hX (finiteRieszProduct Λ ω (η / 2))
    (finiteRieszProduct_pos Λ ω (fun ψ _ => hω ψ) (by positivity) (by linarith))
    (finiteRieszProduct_mean_one Λ hΛ ω (η / 2))
  apply (mul_le_mul_iff_left₀ (sq_pos_of_pos hη)).mp
  calc
    _ ≤ 4 * Real.log ((Fintype.card G : ℝ) / X.card) := by linarith
    _ = _ := by field_simp

/-! ### Generating the large spectrum -/

/-- The large spectrum of a uniform finite-set measure, in the character dual. -/
noncomputable def largeCharacterSpectrum {G : Type*} [Fintype G] [AddCommGroup G]
    (X : Finset G) (η : ℝ) : Finset (AddChar G ℂ) := by
  classical
  exact Finset.univ.filter (fun ψ => η ≤ ‖characterMean X ψ‖)

theorem mem_largeCharacterSpectrum {G : Type*} [Fintype G] [AddCommGroup G]
    (X : Finset G) (η : ℝ) (ψ : AddChar G ℂ) :
    ψ ∈ largeCharacterSpectrum X η ↔ η ≤ ‖characterMean X ψ‖ := by
  classical
  simp [largeCharacterSpectrum]

/-- Chang's spectrum-generating conclusion for an arbitrary finite abelian
group. The span is Mathlib's signed span with coefficients in `{-1,0,1}`. -/
theorem characterSpectrum_generators {G : Type*} [Fintype G] [AddCommGroup G]
    (X : Finset G) (hX : X.Nonempty) {η : ℝ} (hη : 0 < η) (hη1 : η ≤ 1) :
    ∃ Λ : Finset (AddChar G ℂ), Λ ⊆ largeCharacterSpectrum X η ∧
      (Λ.card : ℝ) ≤ 4 / η ^ 2 * Real.log ((Fintype.card G : ℝ) / X.card) ∧
      largeCharacterSpectrum X η ⊆ Λ.addSpan := by
  classical
  let B : ℝ := 4 / η ^ 2 * Real.log ((Fintype.card G : ℝ) / X.card)
  have hn : (0 : ℝ) < X.card := by exact_mod_cast hX.card_pos
  have hratio : (1 : ℝ) ≤ (Fintype.card G : ℝ) / X.card := by
    apply (le_div_iff₀ hn).mpr
    simpa using (Nat.cast_le (α := ℝ)).mpr (Finset.card_le_univ X)
  have hB : 0 ≤ B := mul_nonneg (by positivity) (Real.log_nonneg hratio)
  obtain ⟨Λ, hΛS, hΛcard, hspan⟩ :=
    Finset.exists_subset_addSpan_card_le_of_forall_addDissociated
      (s := largeCharacterSpectrum X η) (d := ⌊B⌋₊) (by
        intro Λ hsub hdiss
        apply (Nat.le_floor_iff hB).mpr
        exact dissociated_spectrum_card_bound X hX Λ hdiss hη hη1
          (fun ψ hψ => (mem_largeCharacterSpectrum X η ψ).mp (hsub hψ)))
  refine ⟨Λ, hΛS, ?_, hspan⟩
  exact (show (Λ.card : ℝ) ≤ ⌊B⌋₊ by exact_mod_cast hΛcard).trans (Nat.floor_le hB)

/-- At full density the large spectrum consists exactly of the zero character. -/
theorem largeCharacterSpectrum_univ {G : Type*} [Fintype G] [AddCommGroup G]
    {η : ℝ} (hη : 0 < η) (hη1 : η ≤ 1) :
    largeCharacterSpectrum (Finset.univ : Finset G) η = {0} := by
  classical
  ext ψ
  rw [mem_largeCharacterSpectrum, Finset.mem_singleton]
  unfold characterMean
  rw [AddChar.expect_eq_ite]
  by_cases hψ : ψ = 0
  · simp [hψ, hη1]
  · simp [hψ, not_le.mpr hη]

open scoped Pointwise in
/-- Signed spans commute with an additive equivalence. -/
theorem addSpan_image_equiv {G H : Type*} [AddCommGroup G] [AddCommGroup H]
    [Fintype G] [Fintype H] [DecidableEq G] [DecidableEq H]
    (e : G ≃+ H) (S : Finset G) : (S.image e).addSpan = S.addSpan.image e := by
  ext b
  constructor
  · intro hb
    obtain ⟨ε, hε, he⟩ := Finset.mem_addSpan.mp hb
    apply Finset.mem_image.mpr
    refine ⟨∑ a ∈ S, ε (e a) • a, ?_, ?_⟩
    · exact Finset.mem_addSpan.mpr ⟨fun a => ε (e a), fun a => hε (e a), rfl⟩
    · rw [map_sum]
      simp only [map_zsmul]
      rw [Finset.sum_image (fun a _ b _ h => e.injective h)] at he
      exact he
  · rintro hb
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hb
    obtain ⟨ε, hε, rfl⟩ := Finset.mem_addSpan.mp ha
    apply Finset.mem_addSpan.mpr
    refine ⟨fun b => ε (e.symm b), fun b => hε (e.symm b), ?_⟩
    rw [Finset.sum_image (fun a _ b _ h => e.injective h), map_sum]
    simp only [e.symm_apply_apply, map_zsmul]

/-! ### Cyclic frequencies and Bohr sets -/

/-- Identify a cyclic frequency with its negative-exponent Fourier character. -/
noncomputable def cyclicFrequencyEquiv (q : ℕ) [NeZero q] :
    ZMod q ≃+ AddChar (ZMod q) ℂ := by
  let f : ZMod q →+ AddChar (ZMod q) ℂ :=
    { toFun := fun ξ => ZMod.stdAddChar.mulShift (-ξ)
      map_zero' := by ext x; simp
      map_add' := by
        intro ξ ζ
        ext x
        simp only [AddChar.mulShift_apply, AddChar.add_apply, neg_add, add_mul,
          AddChar.map_add_eq_mul] }
  apply AddEquiv.ofBijective f
  apply (Fintype.bijective_iff_injective_and_card _).mpr
  refine ⟨?_, by simp⟩
  intro ξ ζ h
  have he := congrArg (fun ψ : AddChar (ZMod q) ℂ => ψ 1) h
  change ZMod.stdAddChar ((-ξ) * 1) = ZMod.stdAddChar ((-ζ) * 1) at he
  apply neg_injective
  apply ZMod.injective_stdAddChar
  simpa only [mul_one] using he

theorem cyclicFrequencyEquiv_apply (q : ℕ) [NeZero q] (ξ x : ZMod q) :
    cyclicFrequencyEquiv q ξ x = ZMod.stdAddChar (-(ξ * x)) := by
  change ZMod.stdAddChar ((-ξ) * x) = ZMod.stdAddChar (-(ξ * x))
  rw [neg_mul]

/-- The source cyclic Bohr set, using the exact quotient-circle norm of `s*x/q`. -/
noncomputable def cyclicBohrSet {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (ρ : ℝ) :
    Finset (ZMod q) :=
  finiteBohrSet (fun s : S => ZMod.toAddCircle.comp (AddMonoidHom.mulLeft (s : ZMod q))) ρ

theorem mem_cyclicBohrSet {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (ρ : ℝ) (x : ZMod q) :
    x ∈ cyclicBohrSet S ρ ↔ ∀ s ∈ S, ‖ZMod.toAddCircle (s * x)‖ < ρ := by
  rw [cyclicBohrSet, mem_finiteBohrSet]
  change (∀ s : S, ‖ZMod.toAddCircle ((s : ZMod q) * x)‖ < ρ) ↔ _
  simp only [Subtype.forall]

/-- Blueprint `lem:Chang`, first conclusion in its cyclic form. -/
theorem cyclicBohrSet_card_lower {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    {ρ : ℝ} (hρ : 0 < ρ) (hρhalf : ρ < 1 / 2) :
    (ρ / 3) ^ S.card * q ≤ ((cyclicBohrSet S ρ).card : ℝ) := by
  simpa only [cyclicBohrSet, Fintype.card_coe, ZMod.card] using
    finiteBohrSet_card_lower
      (fun s : S => ZMod.toAddCircle.comp (AddMonoidHom.mulLeft (s : ZMod q))) hρ hρhalf

/-! ### Separating a finite set of nonzero cyclic frequencies -/

/-- Every point of the unit additive circle has a representative realizing its quotient norm. -/
theorem unitCircle_norm_representative (x : UnitAddCircle) :
    ∃ r : ℝ, (r : UnitAddCircle) = x ∧ |r| = ‖x‖ := by
  obtain ⟨y, rfl⟩ := QuotientAddGroup.mk_surjective x
  refine ⟨y - round y, ?_, UnitAddCircle.norm_eq.symm⟩
  have hi : ((round y : ℝ) : UnitAddCircle) = 0 := by
    simpa only [zsmul_eq_mul, mul_one, AddCircle.coe_period, smul_zero] using
      (AddCircle.coe_zsmul (p := (1 : ℝ)) (n := round y) (x := (1 : ℝ)))
  rw [AddCircle.coe_sub, hi, sub_zero]

/-- A nonzero point of the circle has an integer multiple at distance at least one quarter. -/
theorem unitCircle_exists_large_multiple (x : UnitAddCircle) (hx : x ≠ 0) :
    ∃ n : ℕ, (1 / 4 : ℝ) ≤ ‖n • x‖ := by
  by_cases hlarge : (1 / 4 : ℝ) ≤ ‖x‖
  · exact ⟨1, by simpa only [one_nsmul] using hlarge⟩
  have hsmall : ‖x‖ < 1 / 4 := lt_of_not_ge hlarge
  have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
  obtain ⟨r, hr, habs⟩ := unitCircle_norm_representative x
  let n : ℕ := ⌈(1 / 4 : ℝ) / ‖x‖⌉₊
  have hnlow : (1 / 4 : ℝ) ≤ (n : ℝ) * ‖x‖ :=
    (div_le_iff₀ hxpos).mp (Nat.le_ceil _)
  have hnup : (n : ℝ) * ‖x‖ < 1 / 2 := by
    have h := mul_lt_mul_of_pos_right
      (Nat.ceil_lt_add_one (by positivity : 0 ≤ (1 / 4 : ℝ) / ‖x‖)) hxpos
    rw [add_mul, div_mul_cancel₀ _ hxpos.ne', one_mul] at h
    change (n : ℝ) * ‖x‖ < _ at h
    linarith
  have hprod : |(n : ℝ) * r| = (n : ℝ) * ‖x‖ := by
    rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg n), habs]
  have hcoe : (((n : ℝ) * r : ℝ) : UnitAddCircle) = n • x := by
    rw [← nsmul_eq_mul, AddCircle.coe_nsmul, hr]
  have hnorm : ‖(((n : ℝ) * r : ℝ) : UnitAddCircle)‖ = |(n : ℝ) * r| := by
    apply (AddCircle.norm_coe_eq_abs_iff (p := (1 : ℝ)) one_ne_zero).mpr
    simpa only [abs_one, hprod] using hnup.le
  refine ⟨n, ?_⟩
  rw [← hcoe, hnorm, hprod]
  exact hnlow

/-- A nonzero cyclic frequency passes the one-eighth character test on at most half the group. -/
theorem cyclic_nonzero_character_test_card {q : ℕ} [NeZero q] (χ : ZMod q)
    (hχ : χ ≠ 0) :
    ((cyclicBohrSet {χ} (1 / 8)).card : ℝ) ≤ (q : ℝ) / 2 := by
  classical
  have hx : ZMod.toAddCircle χ ≠ 0 := by
    exact ZMod.toAddCircle_eq_zero.not.mpr hχ
  obtain ⟨n, hn⟩ := unitCircle_exists_large_multiple (ZMod.toAddCircle χ) hx
  let g : ZMod q := n • 1
  let S := cyclicBohrSet {χ} (1 / 8)
  have hg : (1 / 4 : ℝ) ≤ ‖ZMod.toAddCircle (χ * g)‖ := by
    change (1 / 4 : ℝ) ≤ ‖ZMod.toAddCircle (χ * (n • (1 : ZMod q)))‖
    have he : χ * (n • (1 : ZMod q)) = n • χ := by
      simp only [nsmul_eq_mul, mul_one]
      ring
    rw [he, map_nsmul]
    exact hn
  have hS (x : ZMod q) (hx : x ∈ S) : ‖ZMod.toAddCircle (χ * x)‖ < 1 / 8 := by
    exact (mem_cyclicBohrSet {χ} (1 / 8) x).mp hx χ (Finset.mem_singleton_self χ)
  have hd : Disjoint S (S.image (fun x => x + g)) := by
    apply Finset.disjoint_left.mpr
    intro y hy hy'
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hy'
    have he : ZMod.toAddCircle (χ * g) =
        ZMod.toAddCircle (χ * (x + g)) - ZMod.toAddCircle (χ * x) := by
      rw [← map_sub]
      congr 1
      ring
    have hle := norm_sub_le (ZMod.toAddCircle (χ * (x + g)))
      (ZMod.toAddCircle (χ * x))
    rw [← he] at hle
    have h1 := hS x hx
    have h2 := hS (x + g) hy
    linarith
  have hc : (S.image (fun x => x + g)).card = S.card :=
    Finset.card_image_of_injective S (fun _ _ h => add_right_cancel h)
  have hu := Finset.card_le_univ (S ∪ S.image (fun x => x + g))
  rw [Finset.card_union_of_disjoint hd, hc, ZMod.card] at hu
  have hr : (S.card : ℝ) + S.card ≤ q := by exact_mod_cast hu
  change (S.card : ℝ) ≤ (q : ℝ) / 2
  linarith

/-- One character test eliminates at least half of any finite set of nonzero frequencies. -/
theorem cyclic_character_test_halving {q : ℕ} [NeZero q] (D : Finset (ZMod q))
    (hD : ∀ χ ∈ D, χ ≠ 0) :
    ∃ g : ZMod q, 2 * (D.filter (fun χ => ‖ZMod.toAddCircle (χ * g)‖ < 1 / 8)).card
      ≤ D.card := by
  classical
  let r : ZMod q → ZMod q → Prop := fun g χ => ‖ZMod.toAddCircle (χ * g)‖ < 1 / 8
  have hcount : (∑ g : ZMod q, (D.filter (r g)).card) =
      ∑ χ ∈ D, (cyclicBohrSet {χ} (1 / 8)).card := by
    have he (χ : ZMod q) : Finset.univ.bipartiteBelow r χ =
        cyclicBohrSet {χ} (1 / 8) := by
      ext g
      simp [Finset.bipartiteBelow, mem_cyclicBohrSet, r]
    simpa only [Finset.bipartiteAbove, he] using
      (Finset.sum_card_bipartiteAbove_eq_sum_card_bipartiteBelow
        (s := Finset.univ) (t := D) r)
  have hbound : (∑ g : ZMod q, 2 * (D.filter (r g)).card) ≤
      ∑ _g : ZMod q, D.card := by
    rw [← Finset.mul_sum, hcount, Finset.mul_sum]
    calc
      (∑ χ ∈ D, 2 * (cyclicBohrSet {χ} (1 / 8)).card) ≤ ∑ _χ ∈ D, q := by
        apply Finset.sum_le_sum
        intro χ hχ
        have h := cyclic_nonzero_character_test_card χ (hD χ hχ)
        have hr : (2 : ℝ) * (cyclicBohrSet {χ} (1 / 8)).card ≤ q := by linarith
        exact_mod_cast hr
      _ = ∑ _g : ZMod q, D.card := by simp [mul_comm]
  obtain ⟨g, _, hg⟩ := Finset.exists_le_of_sum_le Finset.univ_nonempty hbound
  exact ⟨g, hg⟩

/-- Frequencies surviving all tests in a finite tuple. -/
noncomputable def cyclicTestSurvivors {q d : ℕ} [NeZero q]
    (D : Finset (ZMod q)) (g : Fin d → ZMod q) : Finset (ZMod q) :=
  D.filter (fun χ => ∀ j, ‖ZMod.toAddCircle (χ * g j)‖ < 1 / 8)

theorem mem_cyclicTestSurvivors {q d : ℕ} [NeZero q]
    (D : Finset (ZMod q)) (g : Fin d → ZMod q) (χ : ZMod q) :
    χ ∈ cyclicTestSurvivors D g ↔ χ ∈ D ∧ ∀ j, ‖ZMod.toAddCircle (χ * g j)‖ < 1 / 8 := by
  classical
  exact Finset.mem_filter

/-- Repeated character tests reduce the surviving cardinality by a factor of two at each step. -/
theorem cyclic_character_tests_card {q : ℕ} [NeZero q] (D : Finset (ZMod q))
    (hD : ∀ χ ∈ D, χ ≠ 0) (d : ℕ) :
    ∃ g : Fin d → ZMod q, 2 ^ d * (cyclicTestSurvivors D g).card ≤ D.card := by
  classical
  induction d generalizing D with
  | zero =>
      refine ⟨Fin.elim0, ?_⟩
      simp [cyclicTestSurvivors]
  | succ d ih =>
      obtain ⟨a, ha⟩ := cyclic_character_test_halving D hD
      let E := D.filter (fun χ => ‖ZMod.toAddCircle (χ * a)‖ < 1 / 8)
      obtain ⟨g, hg⟩ := ih E (fun χ hχ => hD χ (Finset.mem_filter.mp hχ).1)
      refine ⟨Fin.cons a g, ?_⟩
      have he : cyclicTestSurvivors D (Fin.cons a g) = cyclicTestSurvivors E g := by
        ext χ
        simp [mem_cyclicTestSurvivors, E, Fin.forall_fin_succ, and_assoc]
      rw [he, pow_succ]
      change 2 * E.card ≤ D.card at ha
      calc
        2 ^ d * 2 * (cyclicTestSurvivors E g).card =
            2 * (2 ^ d * (cyclicTestSurvivors E g).card) := by ring
        _ ≤ 2 * E.card := Nat.mul_le_mul_left 2 hg
        _ ≤ D.card := ha

/-- The source logarithmic number of one-eighth tests separates every nonzero frequency in `D`. -/
theorem cyclic_logarithmic_separating_family {q : ℕ} [NeZero q]
    (D : Finset (ZMod q)) (hD : D.Nonempty) :
    ∃ g : Fin ⌈Real.log (2 * (D.card : ℝ)) / Real.log 2⌉₊ → ZMod q,
      ∀ χ ∈ D, χ ≠ 0 → ∃ j, (1 / 8 : ℝ) ≤ ‖ZMod.toAddCircle (χ * g j)‖ := by
  classical
  let d := ⌈Real.log (2 * (D.card : ℝ)) / Real.log 2⌉₊
  have hcard : 0 < (D.card : ℝ) := by exact_mod_cast hD.card_pos
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlog : Real.log (2 * (D.card : ℝ)) ≤ (d : ℝ) * Real.log 2 :=
    (div_le_iff₀ hlogtwo).mp (Nat.le_ceil _)
  have hpower : 2 * (D.card : ℝ) ≤ (2 : ℝ) ^ d := by
    calc
      2 * (D.card : ℝ) = Real.exp (Real.log (2 * (D.card : ℝ))) :=
        (Real.exp_log (by positivity)).symm
      _ ≤ Real.exp ((d : ℝ) * Real.log 2) := Real.exp_le_exp.mpr hlog
      _ = (2 : ℝ) ^ d := by
        rw [mul_comm, Real.exp_mul, Real.exp_log (by norm_num : (0 : ℝ) < 2),
          Real.rpow_natCast]
  have hnat : 2 * D.card ≤ 2 ^ d := by exact_mod_cast hpower
  have herase : (D.erase 0).card < 2 ^ d := by
    have hle := Finset.card_le_card (Finset.erase_subset (0 : ZMod q) D)
    have hp := hD.card_pos
    omega
  obtain ⟨g, hg⟩ := cyclic_character_tests_card (D.erase 0)
    (fun χ hχ => (Finset.mem_erase.mp hχ).1) d
  have hempty : cyclicTestSurvivors (D.erase 0) g = ∅ := by
    apply Finset.card_eq_zero.mp
    by_contra hn
    have hp : 0 < (cyclicTestSurvivors (D.erase 0) g).card := Nat.pos_of_ne_zero hn
    have hle : 2 ^ d ≤ 2 ^ d * (cyclicTestSurvivors (D.erase 0) g).card :=
      Nat.le_mul_of_pos_right _ hp
    omega
  refine ⟨g, ?_⟩
  intro χ hχ hχzero
  by_contra hn
  push Not at hn
  have hm : χ ∈ cyclicTestSurvivors (D.erase 0) g :=
    (mem_cyclicTestSurvivors _ _ _).mpr ⟨Finset.mem_erase.mpr ⟨hχzero, hχ⟩, hn⟩
  rw [hempty] at hm
  exact Finset.notMem_empty χ hm

/-- A finite set of points in a torus has a dense subset in one cube of mesh `1/N`. -/
theorem finite_torus_dense_cube {α ι : Type*} [Fintype ι]
    (A : Finset α) (hA : A.Nonempty) (phase : α → ι → UnitAddCircle)
    (N : ℕ) (hN : 0 < N) :
    ∃ B : Finset α, B ⊆ A ∧ B.Nonempty ∧
      (A.card : ℝ) / (N : ℝ) ^ Fintype.card ι ≤ B.card ∧
      ∀ x ∈ B, ∀ y ∈ B, ∀ i, ‖phase x i - phase y i‖ < (1 : ℝ) / N := by
  classical
  let : NeZero N := ⟨hN.ne'⟩
  let bins : α → ι → Fin N := fun x i => unitCircleBin N hN (phase x i)
  have hn : (0 : ℝ) < N := by exact_mod_cast hN
  have hp : (0 : ℝ) < (N : ℝ) ^ Fintype.card ι := by positivity
  obtain ⟨b, _, hb⟩ := Finset.exists_le_card_fiber_of_nsmul_le_card_of_maps_to
    (M := ℝ) (s := A) (t := (Finset.univ : Finset (ι → Fin N))) (f := bins)
    (fun _ _ => Finset.mem_univ _) Finset.univ_nonempty
    (b := (A.card : ℝ) / (N : ℝ) ^ Fintype.card ι) (by
      simp only [Finset.card_univ, Fintype.card_fun, Fintype.card_fin,
        nsmul_eq_mul, Nat.cast_pow]
      field_simp
      rfl)
  let B := A.filter (fun x => bins x = b)
  have hB : (A.card : ℝ) / (N : ℝ) ^ Fintype.card ι ≤ B.card := hb
  have hBpos : 0 < B.card := by
    have ha : 0 < (A.card : ℝ) := by exact_mod_cast hA.card_pos
    exact_mod_cast (div_pos ha hp).trans_le hB
  refine ⟨B, Finset.filter_subset _ _, Finset.card_pos.mp hBpos, hB, ?_⟩
  intro x hx y hy i
  have he : bins x = bins y :=
    (Finset.mem_filter.mp hx).2.trans (Finset.mem_filter.mp hy).2.symm
  exact unitCircleBin_norm_sub_lt hN (congrFun he i)

/-- A common cube retains the source fraction of a graph's domain
and controls all frequency differences. -/
theorem cyclic_frequency_dense_cube {q d : ℕ} [NeZero q]
    (H : Finset (ZMod q)) (hH : H.Nonempty) (ξ : ZMod q → ZMod q)
    (g : Fin d → ZMod q) :
    ∃ H' : Finset (ZMod q), H' ⊆ H ∧ H'.Nonempty ∧
      (H.card : ℝ) / (256 : ℝ) ^ d ≤ H'.card ∧
      ∀ h ∈ H', ∀ h' ∈ H', ∀ j,
        ‖ZMod.toAddCircle ((ξ h - ξ h') * g j)‖ < (1 : ℝ) / 256 := by
  obtain ⟨H', hsub, hne, hcard, hphase⟩ := finite_torus_dense_cube H hH
    (fun h j => ZMod.toAddCircle (ξ h * g j)) 256 (by norm_num)
  refine ⟨H', hsub, hne, by simpa using hcard, ?_⟩
  intro h hh h' hh' j
  rw [sub_mul, map_sub]
  exact hphase h hh h' hh' j

/-! ### Smooth finite Bohr weights -/

/-- The source centered representative in `[-1/2,1/2)`. -/
noncomputable def unitCircleCentered (x : UnitAddCircle) : ℝ :=
  AddCircle.equivIco (1 : ℝ) (-(1 / 2)) x

theorem unitCircleCentered_mem (x : UnitAddCircle) :
    -(1 / 2 : ℝ) ≤ unitCircleCentered x ∧ unitCircleCentered x < 1 / 2 := by
  have h := (AddCircle.equivIco (1 : ℝ) (-(1 / 2)) x).property
  change -(1 / 2 : ℝ) ≤ unitCircleCentered x ∧ unitCircleCentered x < -(1 / 2) + 1 at h
  constructor
  · exact h.1
  · linarith [h.2]

theorem unitCircleCentered_coe (x : UnitAddCircle) :
    (unitCircleCentered x : UnitAddCircle) = x := AddCircle.coe_equivIco

theorem unitCircleCentered_abs (x : UnitAddCircle) : |unitCircleCentered x| = ‖x‖ := by
  have hx := unitCircleCentered_mem x
  have ha : |unitCircleCentered x| ≤ (1 : ℝ) / 2 := abs_le.mpr ⟨hx.1, hx.2.le⟩
  have hn := (AddCircle.norm_coe_eq_abs_iff (p := (1 : ℝ)) one_ne_zero).mpr
    (by simpa only [abs_one] using ha)
  rw [unitCircleCentered_coe] at hn
  exact hn.symm

/-- Periodic extension of the cutoff in the centered coordinate. -/
noncomputable def circleCutoff (b : ℝ → ℝ) (r : ℝ) (x : UnitAddCircle) : ℝ :=
  b (unitCircleCentered x / r)

/-- The source periodic product weight. -/
noncomputable def cyclicBohrWeight {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) : ℝ :=
  ∏ s ∈ S, circleCutoff b r (ZMod.toAddCircle (s * x))

/-- Uniform mass of the smooth weight. -/
noncomputable def cyclicBohrMass {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) : ℝ := 𝔼 x, cyclicBohrWeight b S r x

/-- The weight normalized to have uniform mean one. -/
noncomputable def cyclicBohrMeasure {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) : ℝ :=
  cyclicBohrWeight b S r x / cyclicBohrMass b S r

theorem cyclicBohrWeight_nonneg {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) :
    0 ≤ cyclicBohrWeight b S r x := Finset.prod_nonneg (fun _ _ => hb _)

theorem cyclicBohrWeight_le_one {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (S : Finset (ZMod q)) (r : ℝ) (x : ZMod q) : cyclicBohrWeight b S r x ≤ 1 :=
  Finset.prod_le_one₀ (fun _ _ => hb _) (fun _ _ => hb1 _)

theorem cyclicBohrWeight_eq_one {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, |x| ≤ 1 / 2 → b x = 1) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (x : ZMod q) (hx : x ∈ cyclicBohrSet S (r / 2)) :
    cyclicBohrWeight b S r x = 1 := by
  apply Finset.prod_eq_one
  intro s hs
  apply hb
  rw [abs_div, abs_of_pos hr, unitCircleCentered_abs]
  apply (div_le_iff₀ hr).mpr
  have h := (mem_cyclicBohrSet S (r / 2) x).mp hx s hs
  linarith

theorem cyclicBohrWeight_eq_zero_of_notMem {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 1 ≤ |x| → b x = 0) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (x : ZMod q) (hx : x ∉ cyclicBohrSet S r) :
    cyclicBohrWeight b S r x = 0 := by
  classical
  rw [mem_cyclicBohrSet] at hx
  push Not at hx
  obtain ⟨s, hs, hnorm⟩ := hx
  apply Finset.prod_eq_zero hs
  apply hb
  rw [abs_div, abs_of_pos hr, unitCircleCentered_abs]
  exact (one_le_div hr).mpr hnorm

/-- The smooth weight has at least the source Bohr-volume mass and at most unit mass. -/
theorem cyclicBohrMass_bounds {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → b x = 1) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) :
    (r / 6) ^ S.card ≤ cyclicBohrMass b S r ∧ cyclicBohrMass b S r ≤ 1 := by
  classical
  have hq : (0 : ℝ) < q := Nat.cast_pos.mpr (NeZero.pos q)
  have hpoint (x : ZMod q) :
      (if x ∈ cyclicBohrSet S (r / 2) then (1 : ℝ) else 0) ≤ cyclicBohrWeight b S r x := by
    by_cases hx : x ∈ cyclicBohrSet S (r / 2)
    · rw [ite_eq_left hx, cyclicBohrWeight_eq_one b hbone S hr x hx]
    · rw [ite_eq_right hx]
      exact cyclicBohrWeight_nonneg b hb S r x
  have hmass : ((cyclicBohrSet S (r / 2)).card : ℝ) / q ≤ cyclicBohrMass b S r := by
    have he := Finset.expect_le_expect (s := (Finset.univ : Finset (ZMod q)))
      (fun x _ => hpoint x)
    have hsum : (∑ x : ZMod q, if x ∈ cyclicBohrSet S (r / 2) then (1 : ℝ) else 0) =
        ((cyclicBohrSet S (r / 2)).card : ℝ) := by simp
    simpa only [cyclicBohrMass, Finset.expect_eq_sum_div_card, Finset.card_univ,
      ZMod.card, hsum] using he
  have hbohr := cyclicBohrSet_card_lower S (by positivity : 0 < r / 2) (by linarith)
  have heq : r / 2 / 3 = r / 6 := by ring
  rw [heq] at hbohr
  refine ⟨((le_div_iff₀ hq).mpr hbohr).trans hmass, ?_⟩
  exact Finset.expect_le Finset.univ_nonempty (fun x _ => cyclicBohrWeight_le_one b hb hb1 S r x)

theorem cyclicBohrMass_pos {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (hb1 : ∀ x, b x ≤ 1)
    (hbone : ∀ x, |x| ≤ 1 / 2 → b x = 1) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) : 0 < cyclicBohrMass b S r :=
  (by positivity : 0 < (r / 6) ^ S.card).trans_le
    (cyclicBohrMass_bounds b hb hb1 hbone S hr hrsmall).1

theorem cyclicBohrMeasure_mean_one {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (S : Finset (ZMod q)) (r : ℝ) (hβ : 0 < cyclicBohrMass b S r) :
    (𝔼 x, cyclicBohrMeasure b S r x) = 1 := by
  change (𝔼 x, cyclicBohrWeight b S r x / cyclicBohrMass b S r) = 1
  rw [← Finset.expect_div]
  exact div_self hβ.ne'

theorem cyclicBohrMeasure_nonneg {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    (hb : ∀ x, 0 ≤ b x) (S : Finset (ZMod q)) (r : ℝ)
    (hβ : 0 < cyclicBohrMass b S r) (x : ZMod q) : 0 ≤ cyclicBohrMeasure b S r x :=
  div_nonneg (cyclicBohrWeight_nonneg b hb S r x) hβ.le

theorem unitCircleCentered_coe_of_mem {a : ℝ}
    (ha : -(1 / 2 : ℝ) ≤ a ∧ a < 1 / 2) :
    unitCircleCentered (a : UnitAddCircle) = a := by
  have hi : a ∈ Set.Ico (-(1 / 2 : ℝ)) (-(1 / 2) + 1) := by
    exact ⟨ha.1, by linarith [ha.2]⟩
  exact congrArg Subtype.val (AddCircle.equivIco_coe_eq hi)

/-- A nearby point can be lifted in the same centered coordinate whenever a cutoff is active. -/
theorem circleCutoff_local_difference (b : ℝ → ℝ) {L : ℝ≥0} (hLip : LipschitzWith L b)
    (hsupp : ∀ a, 1 ≤ |a| → b a = 0) {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8)
    (x y : UnitAddCircle) (hx : circleCutoff b r x ≠ 0) (hxy : ‖x - y‖ < r) :
    |circleCutoff b r x - circleCutoff b r y| ≤ (L : ℝ) / r * ‖x - y‖ := by
  have ha : |unitCircleCentered x| < r := by
    have hh : |unitCircleCentered x / r| < 1 := by
      by_contra hn
      exact hx (hsupp _ (le_of_not_gt hn))
    rw [abs_div, abs_of_pos hr] at hh
    exact (div_lt_one hr).mp hh
  obtain ⟨t, ht, htabs⟩ := unitCircle_norm_representative (x - y)
  have htlt : |t| < r := htabs.trans_lt hxy
  have hvabs : |unitCircleCentered x - t| < 2 * r := by
    exact (abs_sub _ _).trans_lt (by linarith)
  have hv : -(1 / 2 : ℝ) ≤ unitCircleCentered x - t ∧
      unitCircleCentered x - t < 1 / 2 := by
    have hh := abs_lt.mp hvabs
    constructor <;> linarith
  have hcoe : ((unitCircleCentered x - t : ℝ) : UnitAddCircle) = y := by
    rw [AddCircle.coe_sub, unitCircleCentered_coe, ht]
    abel
  have hy : unitCircleCentered y = unitCircleCentered x - t := by
    rw [← hcoe]
    exact unitCircleCentered_coe_of_mem hv
  have h := hLip.norm_sub_le (unitCircleCentered x / r) (unitCircleCentered y / r)
  simp only [Real.norm_eq_abs] at h
  change |circleCutoff b r x - circleCutoff b r y| ≤ _ at h
  rw [hy] at h
  have hid : unitCircleCentered x / r - (unitCircleCentered x - t) / r = t / r := by ring
  rw [hid, abs_div, abs_of_pos hr, htabs] at h
  convert h using 1; ring

/-- The periodically extended cutoff is globally Lipschitz, including across the coordinate cut. -/
theorem circleCutoff_difference (b : ℝ → ℝ) {L : ℝ≥0} (hLip : LipschitzWith L b)
    (hb : ∀ a, 0 ≤ b a) (hb1 : ∀ a, b a ≤ 1) (hsupp : ∀ a, 1 ≤ |a| → b a = 0)
    {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) (x y : UnitAddCircle) :
    |circleCutoff b r x - circleCutoff b r y| ≤ max (L : ℝ) 1 / r * ‖x - y‖ := by
  have hmax : 0 ≤ max (L : ℝ) 1 := le_trans zero_le_one (le_max_right _ _)
  by_cases hnear : ‖x - y‖ < r
  · by_cases hx : circleCutoff b r x = 0
    · by_cases hy : circleCutoff b r y = 0
      · rw [hx, hy, sub_zero, abs_zero]
        positivity
      · have h := circleCutoff_local_difference b hLip hsupp hr hrsmall y x hy
          (by simpa only [norm_sub_rev] using hnear)
        rw [abs_sub_comm, norm_sub_rev] at h
        apply h.trans
        gcongr
        exact le_max_left _ _
    · apply (circleCutoff_local_difference b hLip hsupp hr hrsmall x y hx hnear).trans
      gcongr
      exact le_max_left _ _
  · have habs : |circleCutoff b r x - circleCutoff b r y| ≤ 1 := by
      apply abs_le.mpr
      constructor <;> dsimp [circleCutoff] <;> linarith [hb (unitCircleCentered x / r),
        hb (unitCircleCentered y / r), hb1 (unitCircleCentered x / r),
        hb1 (unitCircleCentered y / r)]
    apply habs.trans
    have hn : r ≤ ‖x - y‖ := le_of_not_gt hnear
    have hm := mul_le_mul_of_nonneg_right (le_max_right (L : ℝ) 1) (norm_nonneg (x - y))
    have hbound : r ≤ max (L : ℝ) 1 * ‖x - y‖ := by linarith
    have hd := (one_le_div hr).mpr hbound
    convert hd using 1; ring

/-- A telescoping product estimate for factors in the real unit ball. -/
theorem real_product_difference_bound {ι : Type*} (s : Finset ι) (f g : ι → ℝ)
    (hf : ∀ i ∈ s, |f i| ≤ 1) (hg : ∀ i ∈ s, |g i| ≤ 1) :
    |(∏ i ∈ s, f i) - ∏ i ∈ s, g i| ≤ ∑ i ∈ s, |f i - g i| := by
  classical
  revert hf hg
  induction s using Finset.induction_on with
  | empty => intro _ _; simp
  | @insert a s ha ih =>
      intro hf hg
      have hga := hg a (Finset.mem_insert_self _ _)
      have hfs : ∀ i ∈ s, |f i| ≤ 1 := fun i hi => hf i (Finset.mem_insert_of_mem hi)
      have hgs : ∀ i ∈ s, |g i| ≤ 1 := fun i hi => hg i (Finset.mem_insert_of_mem hi)
      have hpf : |∏ i ∈ s, f i| ≤ 1 := by
        rw [Finset.abs_prod]
        exact Finset.prod_le_one₀ (fun _ _ => abs_nonneg _) hfs
      rw [Finset.prod_insert ha, Finset.prod_insert ha, Finset.sum_insert ha]
      have he : f a * (∏ i ∈ s, f i) - g a * (∏ i ∈ s, g i) =
          (f a - g a) * (∏ i ∈ s, f i) +
            g a * ((∏ i ∈ s, f i) - ∏ i ∈ s, g i) := by ring
      rw [he]
      calc
        _ ≤ |(f a - g a) * (∏ i ∈ s, f i)| +
            |g a * ((∏ i ∈ s, f i) - ∏ i ∈ s, g i)| := abs_add_le _ _
        _ = |f a - g a| * |∏ i ∈ s, f i| +
            |g a| * |(∏ i ∈ s, f i) - ∏ i ∈ s, g i| := by rw [abs_mul, abs_mul]
        _ ≤ |f a - g a| * 1 + 1 * (∑ i ∈ s, |f i - g i|) :=
          add_le_add (mul_le_mul_of_nonneg_left hpf (abs_nonneg _))
            (mul_le_mul hga (ih hfs hgs) (abs_nonneg _) zero_le_one)
        _ = _ := by ring

/-- The maximum quotient-circle norm of the selected cyclic coordinates. -/
noncomputable def cyclicBohrNorm {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (x : ZMod q) : ℝ :=
  (S.sup (fun s => ‖ZMod.toAddCircle (s * x)‖₊) : ℝ≥0)

theorem cyclicBohrNorm_nonneg {q : ℕ} [NeZero q] (S : Finset (ZMod q)) (x : ZMod q) :
    0 ≤ cyclicBohrNorm S x := NNReal.coe_nonneg _

theorem norm_le_cyclicBohrNorm {q : ℕ} [NeZero q] (S : Finset (ZMod q))
    (x s : ZMod q) (hs : s ∈ S) : ‖ZMod.toAddCircle (s * x)‖ ≤ cyclicBohrNorm S x := by
  exact_mod_cast (Finset.le_sup (f := fun s => ‖ZMod.toAddCircle (s * x)‖₊) hs)

/-- The source uniform translation bound for smooth Bohr weights. -/
theorem cyclicBohrWeight_translation {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L b) (hb : ∀ a, 0 ≤ b a) (hb1 : ∀ a, b a ≤ 1)
    (hsupp : ∀ a, 1 ≤ |a| → b a = 0) (S : Finset (ZMod q))
    {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8) (x t : ZMod q) :
    |cyclicBohrWeight b S r (x + t) - cyclicBohrWeight b S r x| ≤
      max (L : ℝ) 1 * S.card * cyclicBohrNorm S t / r := by
  have hfactor (z : UnitAddCircle) : |circleCutoff b r z| ≤ 1 := by
    change |b (unitCircleCentered z / r)| ≤ 1
    rw [abs_of_nonneg (hb _)]
    exact hb1 _
  have hprod := real_product_difference_bound S
    (fun s => circleCutoff b r (ZMod.toAddCircle (s * (x + t))))
    (fun s => circleCutoff b r (ZMod.toAddCircle (s * x)))
    (fun _ _ => hfactor _) (fun _ _ => hfactor _)
  apply hprod.trans
  calc
    _ ≤ ∑ _s ∈ S, max (L : ℝ) 1 / r * cyclicBohrNorm S t := by
      apply Finset.sum_le_sum
      intro s hs
      have h := circleCutoff_difference b hLip hb hb1 hsupp hr hrsmall
        (ZMod.toAddCircle (s * (x + t))) (ZMod.toAddCircle (s * x))
      rw [mul_add, map_add, add_sub_cancel_left] at h
      simpa only [mul_add, map_add] using h.trans
        (mul_le_mul_of_nonneg_left (norm_le_cyclicBohrNorm S t s hs)
        (div_nonneg (le_trans zero_le_one (le_max_right _ _)) hr.le))
    _ = max (L : ℝ) 1 * S.card * cyclicBohrNorm S t / r := by
      simp only [Finset.sum_const, nsmul_eq_mul]
      ring

/-- The unit-circle chord controls four times the quotient-circle distance. -/
theorem unitCircle_chord_lower (x : UnitAddCircle) :
    4 * ‖x‖ ≤ ‖(AddCircle.toCircle x : ℂ) - 1‖ := by
  let a := unitCircleCentered x
  have ha : |a| ≤ (1 : ℝ) / 2 :=
    abs_le.mpr ⟨(unitCircleCentered_mem x).1, (unitCircleCentered_mem x).2.le⟩
  have hπ : |Real.pi * a| ≤ Real.pi / 2 := by
    rw [abs_mul, abs_of_pos Real.pi_pos]
    nlinarith [Real.pi_pos]
  have hsin := Real.mul_abs_le_abs_sin hπ
  rw [abs_mul, abs_of_pos Real.pi_pos] at hsin
  have he : 2 / Real.pi * (Real.pi * |a|) = 2 * |a| := by field_simp
  rw [he] at hsin
  have hchord : ‖(AddCircle.toCircle x : ℂ) - 1‖ = 2 * |Real.sin (Real.pi * a)| := by
    rw [← unitCircleCentered_coe x, AddCircle.toCircle_apply_mk, Circle.coe_exp]
    simp only [div_one]
    rw [mul_comm _ Complex.I, Complex.norm_exp_I_mul_ofReal_sub_one]
    have hh : 2 * Real.pi * unitCircleCentered x / 2 = Real.pi * a := by dsimp [a]; ring
    rw [hh, Real.norm_eq_abs, abs_mul]
    norm_num
  rw [hchord, ← unitCircleCentered_abs x]
  change 4 * |a| ≤ _
  linarith

/-- Weighted uniform average of a circle-valued phase. -/
noncomputable def weightedCircleAverage {G : Type*} [Fintype G]
    (w : G → ℝ) (φ : G → UnitAddCircle) : ℂ :=
  𝔼 x, (w x : ℂ) * (AddCircle.toCircle (φ x) : ℂ)

theorem weightedCircleAverage_sub {G : Type*} [Fintype G]
    (w v : G → ℝ) (φ : G → UnitAddCircle) :
    weightedCircleAverage (fun x => w x - v x) φ =
      weightedCircleAverage w φ - weightedCircleAverage v φ := by
  simp only [weightedCircleAverage, Complex.ofReal_sub, sub_mul, Finset.expect_sub_distrib]

theorem weightedCircleAverage_div {G : Type*} [Fintype G]
    (w : G → ℝ) (φ : G → UnitAddCircle) (c : ℝ) :
    weightedCircleAverage (fun x => w x / c) φ = weightedCircleAverage w φ / (c : ℂ) := by
  simp only [weightedCircleAverage, Complex.ofReal_div, div_mul_eq_mul_div,
    Finset.expect_div]

theorem weightedCircleAverage_norm_le {G : Type*} [Fintype G]
    (w : G → ℝ) (φ : G → UnitAddCircle) : ‖weightedCircleAverage w φ‖ ≤ 𝔼 x, |w x| := by
  apply (RCLike.norm_expect_le (K := ℂ)).trans_eq
  apply Finset.expect_congr rfl
  intro x _
  simp only [norm_mul, Circle.norm_coe, mul_one, Complex.norm_real, Real.norm_eq_abs]

/-- Weighted translation uses phase additivity only at points carrying nonzero weight. -/
theorem weightedCircleAverage_translate {G : Type*} [Fintype G] [AddCommGroup G]
    (w : G → ℝ) (φ : G → UnitAddCircle) (t : G)
    (hadd : ∀ x, w x ≠ 0 → φ (x + t) = φ x + φ t) :
    weightedCircleAverage (fun x => w (x - t)) φ =
      (AddCircle.toCircle (φ t) : ℂ) * weightedCircleAverage w φ := by
  classical
  have he : (𝔼 x, (w x : ℂ) * (AddCircle.toCircle (φ (x + t)) : ℂ)) =
      weightedCircleAverage (fun x => w (x - t)) φ := by
    exact Fintype.expect_equiv (Equiv.addRight t) _ _ (fun x => by simp)
  rw [← he, weightedCircleAverage, Finset.mul_expect]
  apply Finset.expect_congr rfl
  intro x _
  by_cases hx : w x = 0
  · simp [hx]
  · rw [hadd x hx, AddCircle.toCircle_add, Circle.coe_mul]
    ring

/-- Local Fourier decay for any weight whose translated difference is uniformly small. -/
theorem weighted_local_character_decay {G : Type*} [Fintype G] [AddCommGroup G]
    (w : G → ℝ) (φ : G → UnitAddCircle) (t : G) {β τ A : ℝ}
    (hβ : 0 < β) (hτ : 0 < τ)
    (hcorr : τ ≤ ‖weightedCircleAverage (fun x => w x / β) φ‖)
    (hadd : ∀ x, w x ≠ 0 → φ (x + t) = φ x + φ t)
    (htrans : ∀ x, |w (x - t) - w x| ≤ A) : ‖φ t‖ ≤ A / (β * τ) := by
  have hmass : β * τ ≤ ‖weightedCircleAverage w φ‖ := by
    rw [weightedCircleAverage_div, norm_div, Complex.norm_real,
      Real.norm_of_nonneg hβ.le] at hcorr
    have h := (le_div_iff₀ hβ).mp hcorr
    simpa only [mul_comm] using h
  have he : ((AddCircle.toCircle (φ t) : ℂ) - 1) * weightedCircleAverage w φ =
      weightedCircleAverage (fun x => w (x - t) - w x) φ := by
    rw [weightedCircleAverage_sub, weightedCircleAverage_translate w φ t hadd]
    ring
  have herror : ‖((AddCircle.toCircle (φ t) : ℂ) - 1) * weightedCircleAverage w φ‖ ≤ A := by
    rw [he]
    exact (weightedCircleAverage_norm_le _ _).trans
      (Finset.expect_le Finset.univ_nonempty (fun x _ => htrans x))
  have hchord : ‖φ t‖ ≤ ‖(AddCircle.toCircle (φ t) : ℂ) - 1‖ := by
    have h := unitCircle_chord_lower (φ t)
    linarith [norm_nonneg (φ t)]
  apply (le_div_iff₀ (mul_pos hβ hτ)).mpr
  rw [norm_mul] at herror
  exact (mul_le_mul hchord hmass (mul_nonneg hβ.le hτ.le) (norm_nonneg _)).trans herror

/-- The source local Fourier decay bound, requiring additivity only on the larger Bohr domain. -/
theorem cyclicBohrWeight_local_fourier_decay {q : ℕ} [NeZero q] (b : ℝ → ℝ)
    {L : ℝ≥0} (hLip : LipschitzWith L b) (hb : ∀ a, 0 ≤ b a) (hb1 : ∀ a, b a ≤ 1)
    (hbone : ∀ a, |a| ≤ 1 / 2 → b a = 1) (hsupp : ∀ a, 1 ≤ |a| → b a = 0)
    (S : Finset (ZMod q)) {r : ℝ} (hr : 0 < r) (hrsmall : r < 1 / 8)
    (φ : ZMod q → UnitAddCircle)
    (hadd : ∀ x ∈ cyclicBohrSet S (3 * r), ∀ y ∈ cyclicBohrSet S (3 * r),
      x + y ∈ cyclicBohrSet S (3 * r) → φ (x + y) = φ x + φ y)
    {τ : ℝ} (hτ : 0 < τ) (hcorr : τ ≤ ‖weightedCircleAverage (cyclicBohrMeasure b S r) φ‖)
    (t : ZMod q) (ht : t ∈ cyclicBohrSet S r) :
    ‖φ t‖ ≤ max (L : ℝ) 1 * S.card * cyclicBohrNorm S t /
      (r * cyclicBohrMass b S r * τ) := by
  have hβ := cyclicBohrMass_pos b hb hb1 hbone S hr hrsmall
  have hadd' (x : ZMod q) (hx : cyclicBohrWeight b S r x ≠ 0) :
      φ (x + t) = φ x + φ t := by
    have hxB : x ∈ cyclicBohrSet S r := by
      by_contra hn
      exact hx (cyclicBohrWeight_eq_zero_of_notMem b hsupp S hr x hn)
    have hx3 : x ∈ cyclicBohrSet S (3 * r) := by
      rw [mem_cyclicBohrSet]
      intro s hs
      have h := (mem_cyclicBohrSet S r x).mp hxB s hs
      linarith
    have ht3 : t ∈ cyclicBohrSet S (3 * r) := by
      rw [mem_cyclicBohrSet]
      intro s hs
      have h := (mem_cyclicBohrSet S r t).mp ht s hs
      linarith
    have hxt : x + t ∈ cyclicBohrSet S (3 * r) := by
      rw [mem_cyclicBohrSet]
      intro s hs
      rw [mul_add, map_add]
      have h1 := (mem_cyclicBohrSet S r x).mp hxB s hs
      have h2 := (mem_cyclicBohrSet S r t).mp ht s hs
      exact (norm_add_le _ _).trans_lt (by linarith)
    exact hadd x hx3 t ht3 hxt
  have htrans (x : ZMod q) :
      |cyclicBohrWeight b S r (x - t) - cyclicBohrWeight b S r x| ≤
        max (L : ℝ) 1 * S.card * cyclicBohrNorm S t / r := by
    have h := cyclicBohrWeight_translation b hLip hb hb1 hsupp S hr hrsmall (x - t) t
    simpa only [sub_add_cancel, abs_sub_comm] using h
  have h := weighted_local_character_decay (cyclicBohrWeight b S r) φ t hβ hτ hcorr hadd' htrans
  simpa only [div_div, mul_assoc] using h

/-- A cutoff vanishing outside the unit interval has compact topological support. -/
theorem unit_cutoff_hasCompactSupport (b : ℝ → ℝ) (hsupp : ∀ a, 1 ≤ |a| → b a = 0) :
    HasCompactSupport b := by
  apply isCompact_Icc.of_isClosed_subset (isClosed_tsupport b)
  change closure (Function.support b) ⊆ Set.Icc (-1 : ℝ) 1
  apply closure_minimal _ isClosed_Icc
  intro a ha
  have hlt : |a| < 1 := by
    by_contra hn
    exact ha (hsupp a (le_of_not_gt hn))
  exact ⟨(abs_lt.mp hlt).1.le, (abs_lt.mp hlt).2.le⟩

/-- Blueprint `lem:Bohr-weight`: all three estimates hold with one fixed positive constant.
The conclusion holds already for C1 cutoffs, and in particular for the fixed Gevrey cutoff. -/
theorem smooth_bohr_weight (b : ℝ → ℝ) (hcont : ContDiff ℝ 1 b)
    (hb : ∀ a, 0 ≤ b a) (hb1 : ∀ a, b a ≤ 1)
    (hbone : ∀ a, |a| ≤ 1 / 2 → b a = 1) (hsupp : ∀ a, 1 ≤ |a| → b a = 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ (q : ℕ) [NeZero q] (S : Finset (ZMod q))
      (r : ℝ), 0 < r → r < 1 / 8 →
      ((r / 6) ^ S.card ≤ cyclicBohrMass b S r ∧ cyclicBohrMass b S r ≤ 1) ∧
      (∀ x t : ZMod q, |cyclicBohrWeight b S r (x + t) - cyclicBohrWeight b S r x| ≤
        C * S.card * cyclicBohrNorm S t / r) ∧
      ∀ φ : ZMod q → UnitAddCircle,
        (∀ x ∈ cyclicBohrSet S (3 * r), ∀ y ∈ cyclicBohrSet S (3 * r),
          x + y ∈ cyclicBohrSet S (3 * r) → φ (x + y) = φ x + φ y) →
        ∀ τ : ℝ, 0 < τ → τ ≤ ‖weightedCircleAverage (cyclicBohrMeasure b S r) φ‖ →
        ∀ t ∈ cyclicBohrSet S r,
          ‖φ t‖ ≤ C * S.card * cyclicBohrNorm S t / (r * cyclicBohrMass b S r * τ) := by
  obtain ⟨L, hLip⟩ := ContDiff.lipschitzWith_of_hasCompactSupport
    (unit_cutoff_hasCompactSupport b hsupp) hcont (by norm_num)
  refine ⟨max (L : ℝ) 1, lt_of_lt_of_le zero_lt_one (le_max_right _ _), ?_⟩
  intro q hq S r hr hrsmall
  refine ⟨cyclicBohrMass_bounds b hb hb1 hbone S hr hrsmall,
    cyclicBohrWeight_translation b hLip hb hb1 hsupp S hr hrsmall, ?_⟩
  intro φ hadd τ hτ hcorr t ht
  exact cyclicBohrWeight_local_fourier_decay b hLip hb hb1 hbone hsupp S hr hrsmall
    φ hadd hτ hcorr t ht

end Auto
